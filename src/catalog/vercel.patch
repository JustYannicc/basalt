+import { defineProvider, oauth2, toolAnnotations, withApprovals, type AccountOf, type AppCache } from "apps";
+import { mcpHealth, mcpRouter } from "apps/mcp";
+import { always } from "apps/operations/approval";
+
+const url = "https://mcp.vercel.com/";
+const headers = (account: { fields: { access_token: string } }) => ({
+  Authorization: `Bearer ${account.fields.access_token}`,
+});
+
+// A separate requirement keeps existing API-token accounts on their original provider identity.
+export const vercelSignIn = defineProvider({
+  name: "Vercel",
+  hosts: ["mcp.vercel.com"],
+  auth: { oauth: oauth2({ discover: url }) },
+  health: (check) => mcpHealth(check, { url, headers: headers(check.account) }),
+});
+
+export const signedInRouter = async (
+  account: AccountOf<typeof vercelSignIn>,
+  context: { cache: AppCache; signal: AbortSignal },
+) =>
+  withApprovals(
+    await mcpRouter({ url, account, headers: headers(account), ...context }),
+    (tool) => (toolAnnotations(tool)?.destructiveHint === true ? always() : undefined),
+  );
