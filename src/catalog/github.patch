diff --git a/results.ts b/results.ts
new file mode 100644
--- /dev/null
+++ b/results.ts
@@ -0,0 +1,115 @@
+// Tool results land in agent transcripts, so they never carry a credential GitHub puts in a
+// response unless the tool exists to mint it. REST and MCP results go through the same filter.
+
+/** Short-lived credentials GitHub adds to ordinary reads, dropped from every result. */
+const incidental = new Set(["temp_clone_token", "temp_download_token"]);
+
+/**
+ * The REST tools, named under `api`, that mint a credential because a person asked for one, and
+ * the fields that carry it. Only these tools return those fields; every other result drops them.
+ */
+export const mintingTools: Readonly<Record<string, readonly string[]>> = {
+  "actions.createRegistrationTokenForOrg": ["token"],
+  "actions.createRegistrationTokenForRepo": ["token"],
+  "actions.createRemoveTokenForOrg": ["token"],
+  "actions.createRemoveTokenForRepo": ["token"],
+  "actions.generateRunnerJitconfigForOrg": ["encoded_jit_config"],
+  "actions.generateRunnerJitconfigForRepo": ["encoded_jit_config"],
+  "apps.createFromManifest": ["client_secret", "pem", "webhook_secret"],
+  "apps.createInstallationAccessToken": ["token"],
+};
+const minted = new Set(Object.values(mintingTools).flat());
+const none: ReadonlySet<string> = new Set();
+
+// A link to a private file's raw content carries a `token` that reads the file without the
+// account: a file's `download_url`, or the link GitHub's MCP server writes for a large file.
+const contentLink = /https:\/\/[\w-]+\.githubusercontent\.com\/[^\s"'<>\\]*/g;
+
+/**
+ * `link` without its `token` query parameters. It is edited as text, so nothing else in it
+ * changes and no link can fail to parse; a `#` or `)` ends the query, as in a Markdown link.
+ */
+const withoutToken = (link: string) => {
+  const start = link.indexOf("?");
+  if (start < 0) return link;
+  const tail = link.slice(start + 1);
+  const end = tail.search(/[#)]/);
+  const parameters = (end < 0 ? tail : tail.slice(0, end)).split("&");
+  const kept = parameters.filter((parameter) => !parameter.startsWith("token="));
+  if (kept.length === parameters.length) return link;
+  return `${link.slice(0, start)}${kept.length ? `?${kept.join("&")}` : ""}${end < 0 ? "" : tail.slice(end)}`;
+};
+const withoutLinkTokens = (text: string) =>
+  text.includes("token=") ? text.replace(contentLink, withoutToken) : text;
+
+/** `value` without credentials, other than the minted fields in `keep`; `value` itself if none. */
+const clean = (value: unknown, keep: ReadonlySet<string>): unknown => {
+  if (typeof value !== "object" || value === null) return value;
+  if (Array.isArray(value)) {
+    const items = value.map((item) => clean(item, keep));
+    return items.every((item, index) => item === value[index]) ? value : items;
+  }
+  // A secret-scanning alert's `secret` is the leaked credential itself.
+  const alert = "secret_type" in value;
+  let changed = false;
+  const entries = Object.entries(value).flatMap(([key, item]) => {
+    if (incidental.has(key) || (minted.has(key) && !keep.has(key)) || (alert && key === "secret")) {
+      changed = true;
+      return [];
+    }
+    // Other text, such as file contents and issue bodies, stays as GitHub sent it.
+    const cleaned =
+      key === "download_url" && typeof item === "string"
+        ? withoutLinkTokens(item)
+        : clean(item, keep);
+    if (cleaned !== item) changed = true;
+    return [[key, cleaned] as const];
+  });
+  return changed ? Object.fromEntries(entries) : value;
+};
+
+/** A REST tool's result, keeping only the credential the tool mints, if it is listed. */
+export const restResult = (result: unknown, tool: string) =>
+  clean(result, Object.hasOwn(mintingTools, tool) ? new Set(mintingTools[tool]) : none);
+
+const isMcpResult = (value: unknown): value is { readonly content: readonly unknown[] } =>
+  typeof value === "object" && value !== null && "content" in value && Array.isArray(value.content);
+
+const isText = (block: unknown): block is { readonly type: "text"; readonly text: string } =>
+  typeof block === "object" &&
+  block !== null &&
+  "type" in block &&
+  block.type === "text" &&
+  "text" in block &&
+  typeof block.text === "string";
+
+const json = (text: string): unknown => {
+  try {
+    return JSON.parse(text);
+  } catch {
+    return undefined;
+  }
+};
+
+/**
+ * GitHub's MCP server writes GitHub's objects as JSON text, so a text block that is JSON is
+ * filtered as that value and rewritten only if that changed it. Any other text block is the
+ * server's own message, such as a large file's download link. A file's contents arrive in a
+ * resource block, which stays as sent.
+ */
+const textBlock = (block: { readonly type: "text"; readonly text: string }) => {
+  const parsed = json(block.text);
+  if (parsed === undefined) return { ...block, text: withoutLinkTokens(block.text) };
+  const cleaned = clean(parsed, none);
+  return cleaned === parsed ? block : { ...block, text: JSON.stringify(cleaned) };
+};
+
+/** An MCP tool's result. No MCP tool mints a credential. */
+export const mcpResult = (result: unknown) => {
+  if (!isMcpResult(result)) return clean(result, none);
+  const { content, ...rest } = result;
+  return {
+    ...Object.fromEntries(Object.entries(rest).map(([key, value]) => [key, clean(value, none)])),
+    content: content.map((block) => (isText(block) ? textBlock(block) : clean(block, none))),
+  };
+};
