@@ -67,6 +67,71 @@ type Account =
 
 const token = (account: Account) => (account.method === "oauth" ? account.fields.access_token : account.fields.token);
 
+type Fetch = (input: string | URL | Request, init?: RequestInit) => Promise<Response>;
+
+// GitHub puts short-lived credentials in some read responses: `temp_clone_token` on every
+// repository shape, which GitHub's description says to keep out of logs, and the
+// `temp_download_token` bearer token on runner downloads. Tool results land in agent transcripts,
+// so the REST tools drop every field with either name.
+const credentialFields = ["temp_clone_token", "temp_download_token"];
+// The router reads at most this much of a body and refuses the rest; a larger body passes through
+// unread so the router refuses it as before, instead of being held in memory here.
+const routerBodyLimit = 16_777_216;
+
+const withoutCredentialFields =
+  (fetch: Fetch): Fetch =>
+  async (input, init) => {
+    const response = await fetch(input, init);
+    const url = typeof input === "string" ? input : input instanceof URL ? input.href : input.url;
+    const type = response.headers.get("content-type")?.split(";")[0]?.trim() ?? "";
+    if (
+      !response.ok ||
+      response.body === null ||
+      new URL(url).origin !== "https://api.github.com" ||
+      !/^application\/(?:[\w.-]+\+)?json$/i.test(type) ||
+      Number(response.headers.get("content-length")) > routerBodyLimit
+    )
+      return response;
+    const { status, statusText } = response;
+    const reader = response.body.getReader();
+    const decoder = new TextDecoder();
+    const chunks: Uint8Array[] = [];
+    let size = 0;
+    let text = "";
+    for (let read = await reader.read(); !read.done; read = await reader.read()) {
+      chunks.push(read.value);
+      size += read.value.byteLength;
+      if (size > routerBodyLimit) {
+        const unread = new ReadableStream<Uint8Array>({
+          start: (controller) => chunks.forEach((chunk) => controller.enqueue(chunk)),
+          pull: async (controller) => {
+            const next = await reader.read();
+            if (next.done) controller.close();
+            else controller.enqueue(next.value);
+          },
+          cancel: (reason) => reader.cancel(reason),
+        });
+        return new Response(unread, { status, statusText, headers: response.headers });
+      }
+      text += decoder.decode(read.value, { stream: true });
+    }
+    text += decoder.decode();
+    let body = text;
+    if (credentialFields.some((field) => text.includes(`"${field}"`)))
+      try {
+        body = JSON.stringify(
+          JSON.parse(text, (key, value) => (credentialFields.includes(key) ? undefined : value)),
+        );
+      } catch {
+        // Not JSON after all: the router reports the unreadable body as it would have.
+      }
+    const headers = new Headers(response.headers);
+    // The body is already decoded and may be shorter now.
+    headers.delete("content-encoding");
+    headers.delete("content-length");
+    return new Response(body, { status, statusText, headers });
+  };
