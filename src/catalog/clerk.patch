diff --git a/mcp.ts b/mcp.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4d57e5afd4073a8fb7955bc874965f04c433a881
--- /dev/null
+++ b/mcp.ts
@@ -0,0 +1,24 @@
+import { defineProvider, oauth2, withApprovals, type AccountOf, type AppCache } from "apps";
+import { mcpHealth, mcpRouter } from "apps/mcp";
+import { always } from "apps/operations/approval";
+
+const url = "https://mcp.clerk.com/mcp";
+const headers = (account: { fields: { access_token: string } }) => ({
+  Authorization: `Bearer ${account.fields.access_token}`,
+});
+
+// A separate provider preserves existing API-key accounts and their links.
+export const clerkSignIn = defineProvider({
+  name: "Clerk",
+  hosts: ["mcp.clerk.com"],
+  auth: { oauth: oauth2({ discover: url, scopes: ["user:org:read","applications:read","applications:manage","users:read","users:manage","application_domains:read","application_domains:manage"] }) },
+  health: (check) => mcpHealth(check, { url, headers: headers(check.account) }),
+});
+
+export const signedInRouter = async (
+  account: AccountOf<typeof clerkSignIn>,
+  context: { cache: AppCache; signal: AbortSignal },
+) => withApprovals(
+  await mcpRouter({ url, account, headers: headers(account), ...context }),
+  (tool) => tool.kind === "mutation" ? always() : undefined,
+);
