+-- One row per scheduled send, so people and agents can list what waits. The run is the schedule;
+-- its status says whether it is waiting, sent, failed or cancelled.
+CREATE TABLE scheduled_sends (
+  run_id TEXT PRIMARY KEY NOT NULL,
+  account_id TEXT NOT NULL,
+  account TEXT NOT NULL,
+  draft_id TEXT NOT NULL,
+  send_at INTEGER NOT NULL,
+  subject TEXT NOT NULL,
+  recipients TEXT NOT NULL,
+  created_at INTEGER NOT NULL
+);
+CREATE INDEX scheduled_sends_draft ON scheduled_sends (account_id, draft_id);
+CREATE INDEX scheduled_sends_time ON scheduled_sends (account_id, send_at);
