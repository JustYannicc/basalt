+/** The workflow, for a package whose linked Google accounts `accounts` reads from a step. */
+export const sendLater = <Requirements extends AppRequirements>(
+  accounts: (step: WorkflowStepContext<Requirements>) => readonly Account[],
+) =>
+  workflow(
+    {
+      description:
+        "Sends a scheduled Gmail draft at its time from the account that scheduled it. A draft already sent or deleted by hand ends the run quietly; if Gmail refuses the send, the person is asked in Human in the loop whether to send it again or keep it as a draft.",
+      input: object({
+        accountId: string({ minLength: 1 }),
+        draftId: string({ minLength: 1 }),
+        sendAt: number(),
+        subject: string(),
+        to: string(),
+      }),
+    },
+    async (ctx: WorkflowContext<Requirements>, input) => {
+      await ctx.step.sleepUntil("wait for the send time", input.sendAt);
+      const send = (name: string) =>
+        ctx.step.do(name, { retries: { limit: 3, delay: "1 minute", backoff: "exponential" }, timeout: "2 minutes" }, async (step) => {
+          const linked = accounts(step).find((candidate) => candidate.id === input.accountId);
+          if (!linked) throw new NonRetryableError("The Gmail account that scheduled this email is no longer linked to the app.");
+          const response = await step.fetch(`${base}/drafts/send`, {
+            method: "POST",
+            signal: step.signal,
+            headers: { Authorization: `Bearer ${linked.fields.access_token}`, "content-type": "application/json" },
+            body: JSON.stringify({ id: input.draftId }),
+          });
