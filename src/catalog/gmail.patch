+    [...headers, "MIME-Version: 1.0", ...(files.length ? [`Content-Type: multipart/mixed; boundary="${boundary}"`, "", `--${boundary}`] : [])].join("\r\n") +
+      "\r\n" +
+      bodyType +
+      "\r\n",
+  );
+  const bodyBytes = text.encode(body);
+  const parts = files.map((file) => {
+    const name = encodeHeader(file.filename);
+    return text.encode(
+      `--${boundary}\r\nContent-Type: ${file.mimeType}; name="${name}"\r\nContent-Disposition: attachment; filename="${name}"\r\nContent-Transfer-Encoding: base64\r\n\r\n`,
+    );
+  });
+  const close = text.encode(files.length ? `--${boundary}--\r\n` : "");
+  const size =
+    head.length + base64Length(bodyBytes.length) + parts.reduce((sum, part, i) => sum + part.length + base64Length(files[i]!.bytes.length), 0) + close.length;
+  const out = new Uint8Array(size);
+  out.set(head, 0);
+  let at = writeBase64(bodyBytes, out, head.length);
+  parts.forEach((part, i) => {
+    out.set(part, at);
+    at = writeBase64(files[i]!.bytes, out, at + part.length);
+  });
+  out.set(close, at);
+  return out;
+};
