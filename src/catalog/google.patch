+// Attachments and delivery for Gmail writes. Files come inline, from a link or from another
+// message; the message is a multipart/mixed RFC 2822 document built straight into bytes, sent as
+// JSON `raw` while small and by Gmail's resumable upload above that.
+import { array, decodeJson, json, object, string } from "apps";
+import { encodeHeader, google, type Base, type Target } from "./shared.js";
+
+const base = "https://gmail.googleapis.com/gmail/v1/users/me";
+const upload = "https://gmail.googleapis.com/upload/gmail/v1/users/me";
+
+/** Gmail refuses mail whose attachments add up to more than 25 MB. */
+export const attachmentLimit = 25 * 1024 * 1024;
+/** Google documents its JSON and simple-upload paths for 5 MB or less; larger messages are uploaded resumably. */
+export const uploadThreshold = 5 * 1024 * 1024;
+
+export const Attachment = object({
+  filename: string().optional(),
+  mimeType: string().optional(),
+  contentBase64: string().optional(),
+  url: string().optional(),
+  messageId: string().optional(),
+  attachmentId: string().optional(),
+});
+export const Attachments = array(Attachment).optional();
+
+export type AttachmentInput = {
+  readonly filename?: string;
+  readonly mimeType?: string;
+  readonly contentBase64?: string;
+  readonly url?: string;
+  readonly messageId?: string;
+  readonly attachmentId?: string;
+};
+
+export const attachmentsHelp =
+  "attachments: files to attach, each from exactly one source: `contentBase64` (the file's bytes as base64, such as an uploaded file or one the agent has open; needs `filename`), `url` (an https link the file downloads from without signing in; nothing but the request is sent to it) or `messageId` with `attachmentId` (an attachment of another message, as readMessage lists it). `filename` and `mimeType` are read from the source when left out. Together the files may total 25 MB, Gmail's limit; pass files over a few MB by `url`, since inline content travels inside the tool call.";
+
+interface File {
+  readonly filename: string;
+  readonly mimeType: string;
+  readonly bytes: Uint8Array;
+}
+
+const types: Record<string, string> = {
+  pdf: "application/pdf",
+  png: "image/png",
+  jpg: "image/jpeg",
+  jpeg: "image/jpeg",
+  gif: "image/gif",
+  webp: "image/webp",
+  svg: "image/svg+xml",
+  txt: "text/plain",
+  md: "text/markdown",
+  csv: "text/csv",
+  html: "text/html",
+  json: "application/json",
+  ics: "text/calendar",
+  zip: "application/zip",
+  doc: "application/msword",
+  docx: "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
+  xls: "application/vnd.ms-excel",
+  xlsx: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
+  ppt: "application/vnd.ms-powerpoint",
+  pptx: "application/vnd.openxmlformats-officedocument.presentationml.presentation",
+  mp3: "audio/mpeg",
+  mp4: "video/mp4",
+  mov: "video/quicktime",
+};
+const generic = "application/octet-stream";
+const guess = (filename: string) => types[/\.([a-z0-9]+)$/i.exec(filename)?.[1]?.toLowerCase() ?? ""] ?? generic;
+/** A MIME type that cannot break the part's headers, else the generic one. */
+const mimeType = (value: string | undefined) => {
+  const type = value?.split(";")[0]?.trim().toLowerCase();
+  return type && /^[a-z0-9!#$&^_.+-]+\/[a-z0-9!#$&^_.+-]+$/.test(type) ? type : undefined;
+};
+/** A file name without line breaks, quotes or path separators, so it stays one header parameter. */
+const filename = (value: string) => value.replace(/[\r\n"\\/]+/g, " ").trim().slice(0, 255) || "attachment";
+
+const tooBig = () =>
+  new Error(`Attachments add up to more than 25 MB, Gmail's limit. Share a link to large files in the body instead.`);
+
+const decodeBase64 = (value: string) => {
+  const text = value.replace(/^data:[^,]*;base64,/i, "").replace(/\s+/g, "").replaceAll("-", "+").replaceAll("_", "/");
+  let binary: string;
+  try {
+    binary = atob(text);
+  } catch {
+    throw new Error("contentBase64 is not valid base64.");
+  }
+  return Uint8Array.from(binary, (char) => char.charCodeAt(0));
+};
+
+const decoded = (value: string) => {
+  try {
+    return decodeURIComponent(value);
+  } catch {
+    return value;
+  }
+};
+
+/** Reads a link's body, stopping as soon as it passes the remaining budget. */
+const download = async (ctx: Base, url: URL, remaining: number) => {
+  // No credentials go with the request: the link alone must grant the file.
+  const response = await ctx.fetch(url.toString(), { signal: ctx.signal, redirect: "follow" });
+  if (!response.ok) throw new Error(`Downloading ${url.hostname} answered ${response.status}.`);
+  if (response.redirected && new URL(response.url).protocol !== "https:") throw new Error(`${url.hostname} redirected the download away from https.`);
+  if (Number(response.headers.get("content-length") ?? 0) > remaining) throw tooBig();
+  const chunks: Uint8Array[] = [];
+  let size = 0;
+  const reader = response.body?.getReader();
+  for (;;) {
+    const next = await reader?.read();
+    if (!next || next.done) break;
+    size += next.value.byteLength;
+    if (size > remaining) {
+      await reader?.cancel();
+      throw tooBig();
+    }
+    chunks.push(next.value);
+  }
+  const bytes = new Uint8Array(size);
+  let at = 0;
+  for (const chunk of chunks) {
+    bytes.set(chunk, at);
