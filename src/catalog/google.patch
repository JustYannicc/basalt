+  const size =
+    head.length + base64Length(bodyBytes.length) + parts.reduce((sum, part, i) => sum + part.length + base64Length(files[i]!.bytes.length), 0) + close.length;
+  const out = new Uint8Array(size);
+  out.set(head, 0);
+  let at = writeBase64(bodyBytes, out, head.length);
+  parts.forEach((part, i) => {
+    out.set(part, at);
+    at = writeBase64(files[i]!.bytes, out, at + part.length);
+  });
+  out.set(close, at);
+  return out;
+};
