+    const a = bytes[i]!;
+    const b = bytes[i + 1];
+    const c = bytes[i + 2];
+    out[at++] = alphabet[a >> 2]!;
+    out[at++] = alphabet[((a & 3) << 4) | ((b ?? 0) >> 4)]!;
+    out[at++] = b === undefined ? 61 : alphabet[((b & 15) << 2) | ((c ?? 0) >> 6)]!;
+    out[at++] = c === undefined ? 61 : alphabet[c & 63]!;
+    column += 4;
+    if (column === 76) {
+      out.set(crlf, at);
+      at += 2;
+      column = 0;
+    }
+  }
