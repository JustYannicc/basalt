+          timeoutMs: 7 * day,
+          display: { kind: "choice" },
+          form: {
+            mode: "form",
+            message: `Your scheduled email "${input.subject}" to ${input.to} was not sent: ${reason}. It is still in your Gmail drafts.`,
+            requestedSchema: {
