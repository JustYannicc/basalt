+// New sign-ins use a separate provider so changing the requested scopes and projecting the
+// returned grant cannot invalidate accounts saved under `planetscale`.
+const planetscaleSignIn = defineProvider({
+  name: "PlanetScale",
+  hosts: ["api.planetscale.com", "app.planetscale.com", "auth.planetscale.com"],
+  auth: {
+    signIn: oauth2({
+      discover: "https://api.planetscale.com",
+    }),
+  },
+  async health({ account, fetch, signal }) {
+    const response = await fetch("https://api.planetscale.com/v1/organizations?per_page=1", {
+      signal,
+      headers: { Authorization: `Bearer ${account.fields.access_token}`, Accept: "application/json" },
+    });
+    const list = await decodeJson(
+      response,
+      object({ data: array(object({ id: string(), name: string() })) }),
+    );
+    const organization = list.data[0];
+    if (!organization) throw new Error("PlanetScale credential has access to no organizations");
+    return { accountInfo: { externalId: organization.id, username: organization.name } };
+  },
+});
+
+type LegacyAccount = AccountOf<typeof planetscale>;
+type SignInAccount = AccountOf<typeof planetscaleSignIn>;
+type Account = LegacyAccount | SignInAccount;
+
+/** Expand the aliases PlanetScale advertises so either spelling is checked against an operation. */
+const grantOf = (account: Account) => {
+  const value = account.oauthScopes;
+  if (value === undefined) return undefined;
+  const scopes = new Set(value);
+  for (const [short, long] of Object.entries(scopeAliases)) {
+    if (scopes.has(short)) scopes.add(long);
+    if (scopes.has(long)) scopes.add(short);
+  }
+  return scopes;
+};
+
+/** Known grant metadata reports capabilities independently of legacy discovery compatibility. */
+const scopeAllows = (account: Account, name: string) => {
+  const grant = grantOf(account);
+  if (grant === undefined) return true;
+  return operationScopes[name]?.some((scope) => grant.has(scope)) ?? false;
+};
+
+/** Unknown legacy and DCR grants keep the old listing; PlanetScale still authorizes each call. */
+const offers = (account: Account, grantAware: boolean, name: string) =>
+  !grantAware || account.method !== "signIn" || scopeAllows(account, name);
