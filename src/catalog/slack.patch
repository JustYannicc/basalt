+// Slack reports authentication and permission failures in HTTP 200 envelopes.
+function rejectSlack(body: unknown, status: number) {
+  if (typeof body !== "object" || body === null || !("ok" in body) || body.ok !== false) return;
+  const error = "error" in body ? body.error : undefined;
+  switch (error) {
+    case "invalid_auth":
+    case "token_revoked":
+    case "token_expired":
+    case "not_authed":
+    case "account_inactive":
+      throw new ProviderError({ reason: "unauthorized", status });
+    case "missing_scope":
+    case "no_permission":
+    case "access_denied":
+    case "team_access_not_granted":
+    case "not_allowed_token_type":
+      throw new ProviderError({ reason: "forbidden", status });
+    case "ratelimited":
+      throw new ProviderError({ reason: "rate_limited", status });
+    case "internal_error":
+    case "fatal_error":
+    case "service_unavailable":
+      throw new ProviderError({ reason: "unavailable", status });
+    default:
+      throw new Error("Slack could not verify this account. Try checking again.");
+  }
+}
+
+function record(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+// Omit missing or malformed display fields without rejecting valid credentials.
+function text(value: unknown) {
+  return typeof value === "string" && value.trim().length > 0 && value.length <= 255
+    ? value.trim()
+    : undefined;
+}
+
+function httpUrl(value: unknown) {
+  if (typeof value !== "string") return undefined;
+  try {
+    const url = new URL(value);
+    return url.protocol === "https:" || url.protocol === "http:" ? url.href : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+async function slackRead(
+  fetch: typeof globalThis.fetch,
+  url: string,
+  token: string,
+  signal: AbortSignal,
+  method: "GET" | "POST",
+): Promise<Record<string, unknown>> {
+  const response = await fetch(url, {
+    method,
+    signal,
+    headers: { Authorization: `Bearer ${token}` },
+  });
+  // A bare 403 does not prove a scope gap. Only Slack's explicit code does.
+  if (response.status === 403)
+    rejectSlack(
+      await response
+        .clone()
+        .json()
+        .catch(() => null),
+      403,
+    );
+  const body = await decodeJson(response, json());
+  rejectSlack(body, response.status);
+  if (!record(body) || body.ok !== true)
+    throw new Error("Slack returned an invalid account check. Try checking again.");
+  return body;
+}
 
