                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "resource"
                        ],
                        "type": "object"
                      },
                      {
                        "additionalProperties": false,
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "size": {
                            "description": "File size in bytes.",
                            "type": [
                              "null",
                              "integer"
                            ]
                          },
                          "title": {
                            "type": "string"
                          },
                          "type": {
                            "const": "resource_link",
                            "type": "string"
                          },
                          "uri": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "uri",
                          "name"
                        ],
                        "type": "object"
                      }
                    ]
                  },
                  "type": "array"
                }
              },
              "required": [
                "content"
              ],
              "type": "object"
            }
          ]
        }
      }
    ]
  },
