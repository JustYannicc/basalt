--- /dev/null
+++ b/health.ts
@@ -0,0 +1,84 @@
+import { decodeJson, json, object, string, type AccountCheckContext, type AuthMethods } from "apps";
+import { Client } from "@modelcontextprotocol/sdk/client/index.js";
+import { CallToolResultSchema } from "@modelcontextprotocol/sdk/types.js";
+import { StreamableHTTPClientTransport } from "@modelcontextprotocol/sdk/client/streamableHttp.js";
+
+const botUser = object({
+  id: string(),
+  bot: json().optional(),
+});
+
+/** Both Notion account methods report the workspace rather than the bot's name. */
+export async function botAccountInfo(response: Response) {
+  const me = await decodeJson(response, botUser);
+  const bot = me.bot;
+  const name =
+    bot !== null && typeof bot === "object" && !Array.isArray(bot) && "workspace_name" in bot
+      ? bot.workspace_name
+      : undefined;
+  const displayName = typeof name === "string" ? name.trim().slice(0, 255) : undefined;
+  return { externalId: me.id, ...(displayName ? { displayName } : {}) };
+}
+
+/** The optional identity read shares the check's cancellation and remaining deadline. */
+export async function readMcpSelf(
+  check: {
+    fetch: AccountCheckContext<AuthMethods>["fetch"];
+    signal: AbortSignal;
+    deadline?: number;
+  },
+  url: string,
+  headers: Record<string, string>,
+) {
+  check.signal.throwIfAborted();
+  const remaining = Math.min(5_000, (check.deadline ?? Date.now() + 5_250) - Date.now() - 250);
+  if (remaining <= 0) return;
+  const signal = AbortSignal.any([check.signal, AbortSignal.timeout(Math.floor(remaining))]);
+  const client = new Client({ name: "notion-account-check", version: "1.0.0" });
+  const transport = new StreamableHTTPClientTransport(new URL(url), {
+    requestInit: { headers },
+    fetch: (input, init) =>
+      check.fetch(input, {
+        ...init,
+        signal:
+          init?.method === "DELETE"
+            ? AbortSignal.timeout(100)
+            : AbortSignal.any([signal, ...(init?.signal ? [init.signal] : [])]),
+      }),
+  });
+  try {
+    await client.connect(transport, { signal, timeout: remaining });
+    const result = CallToolResultSchema.parse(
+      await client.callTool({ name: "notion-get-self", arguments: {} }, undefined, {
+        signal,
+        timeout: remaining,
+      }),
+    );
+    if (result.isError) return;
+    const values: unknown[] = [
+      result.structuredContent,
+      ...result.content.flatMap((item) => {
+        if (item.type !== "text") return [];
+        try {
+          return [JSON.parse(item.text)];
+        } catch {
+          return [];
+        }
+      }),
+    ];
+    for (const value of values) {
+      try {
+        return await botAccountInfo(Response.json(value));
+      } catch {
+        /* Try the next text block. */
+      }
+    }
+  } catch {
+    // Credential verification already passed; a naming failure is not an unhealthy account.
+  } finally {
+    // DELETE has its own short signal so an expired lookup can still close its session.
+    await transport.terminateSession().catch(() => {});
+    await client.close().catch(() => {});
+  }
+  check.signal.throwIfAborted();
+}
