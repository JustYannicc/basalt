+/**
+ * A key may only be sent to the hosts its provider listed when it was saved, so a key saved
+ * before both providers listed both hosts is refused for the other one before anything is sent.
+ * The check asks the other host without reading its answer and, on that refusal, the account's
+ * row says to reconnect. The ask shares the check's cancellation and at most five seconds of what
+ * is left of its deadline, so a slow host never fails a check whose own read passed.
+ */
+async function otherHostStatus(
+  fetch: (input: string, init?: RequestInit) => Promise<Response>,
+  {
+    url,
+    token,
+    signal,
+    deadline,
+    tools,
+  }: { url: string; token: string; signal: AbortSignal; deadline?: number; tools: string },
+) {
+  const remaining = Math.min(5_000, (deadline ?? Date.now() + 5_250) - Date.now() - 250);
+  if (remaining <= 0) return undefined;
+  try {
+    await fetch(url, {
+      method: "HEAD",
+      signal: AbortSignal.any([signal, AbortSignal.timeout(Math.floor(remaining))]),
+      headers: { Authorization: `Bearer ${token}` },
+    });
+  } catch (error) {
+    // Any other failure says nothing about this key's hosts, and the check's own read passed.
+    if (error instanceof NetworkRefused && error.refusal.reason === "credential_host")
+      return {
+        status: {
+          badges: [{ label: `Reconnect to use this key for the ${tools}`, tone: "warning" as const }],
+          meters: [],
+          stats: [],
+        },
+      };
+  }
+  return undefined;
+}
