+++ b/approvals.ts
@@ -0,0 +1,50 @@
+import { always } from "apps/operations/approval";
+import { options } from "./openapi.js";
+
+// Browser actions that only read the page. Any other action (click, write, press,
+// executeJavascript) can act on the target site, for example as a signed-in user.
+const passiveActions = new Set(["wait", "screenshot", "scroll", "scrape", "pdf"]);
+
+const record = (value: unknown): Record<string, unknown> | undefined =>
+  typeof value === "object" && value !== null ? (value as Record<string, unknown>) : undefined;
+
+/** Scrape options that can act on a site or persist state, so the read is not side-effect free. */
+const actsOrPersists = (value: unknown): boolean => {
+  const options = record(value);
+  if (options === undefined) return false;
+  const actions = Array.isArray(options.actions) ? options.actions : [];
+  if (actions.some((action) => !passiveActions.has(String(record(action)?.type)))) return true;
+  const formats = Array.isArray(options.formats) ? options.formats : [];
+  // Change tracking stores a persistent baseline snapshot for the URL.
+  if (formats.some((format) => (record(format)?.type ?? format) === "changeTracking")) return true;
+  // A profile saves browser state back unless the caller opts out.
+  const profile = record(options.profile);
+  if (profile !== undefined && profile.saveChanges !== false) return true;
+  // Alexandria runs catalogued provider tools instead of reading a page.
+  return options.alexandria !== undefined;
+};
+
+const sideEffectReads = new Set(["scrapeAndExtractFromUrl", "searchAndScrape"]);
+const reads = Object.keys(options.kinds);
+
+/**
+ * Mutations always ask. Scrape and search are reads, but ask when their options can act on a
+ * site or persist state; a dependency call that would ask is refused rather than run.
+ */
+export const approvalFor = (tool: { readonly kind: "query" | "mutation" }, name: string) => {
+  if (tool.kind === "mutation") return always();
+  const leaf = name.slice(name.lastIndexOf(".") + 1);
+  // Kinds are keyed by operationId and the framework lengthens colliding tool names, so a copy of
+  // a reviewed read's operationId under the same tag is a query named like
+  // scrapeAndExtractFromUrlExecute, as is a reviewed read renamed beside a new operation. Neither
+  // was reviewed under that name, so each asks like a mutation. A copy elsewhere can keep the
+  // reviewed name; the read-kinds check refuses any repeated operationId in the fast lane.
+  if (reads.some((read) => leaf !== read && leaf.startsWith(read))) return always();
+  if (!sideEffectReads.has(leaf)) return undefined;
+  return ({ toolInput }: { readonly toolInput: unknown }) => {
+    const body = record(record(toolInput)?.body);
+    return actsOrPersists(body) || actsOrPersists(body?.scrapeOptions)
+      ? ("user-approval" as const)
+      : ("approved" as const);
+  };
+};
