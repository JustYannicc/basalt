{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2024", "DOM"],
    "typeRoots": [
      "./.upstream/node_modules/@types",
      "./.upstream/apps/hosted/cloud/node_modules/@types"
    ],
    "paths": {
      "@sqlite.org/sqlite-wasm": [
        "./.upstream/node_modules/@sqlite.org/sqlite-wasm/dist/index.d.mts"
      ]
    }
  },
  "include": ["brand.ts", "scripts/**/*.ts", "src/**/*.ts", "e2e/**/*.ts"],
  "exclude": [
    "src/pool/worker.ts",
    "src/pool/runtime.worker.ts",
    "src/pool/runtime-do.worker.ts",
    "src/pool/forward.worker.ts",
    "src/pool/native-response.worker.ts",
    "scripts/preview/stack",
    "scripts/scale-test/stack.ts",
    "scripts/scale-test/worker.ts"
  ]
}
