@@ -1,16 +1,68 @@
-/** Setup runs before case Evidence exists. These records contain no response values. */
+/** Setup runs before case Evidence exists, so its failures and records carry closed fields, never response values. */
 import { Cause, Effect, Exit, Schema } from "effect";
-import { RequestFailed } from "./api.ts";
+import { RequestFailed, body } from "./api.ts";
 import type { Response } from "./platform.ts";
 
-type Step = "prepare" | "session" | "provisioning" | "inventory";
+const requests = {
+  prepare: { method: "POST", route: "/api/onboarding/prepare" },
+  session: { method: "GET", route: "/api/auth/get-session" },
+  provisioning: { method: "POST", route: "/management-provisioned" },
+  inventory: { method: "GET", route: "/api/organizations/:organization/inventory" },
+} as const;
+type Step = keyof typeof requests;
+
+/** A failed setup status names its fixed operation only: no IDs, URLs, bodies or headers. */
+export class SetupRequestFailed extends Schema.TaggedError<SetupRequestFailed>()(
+  "SetupRequestFailed",
+  {
+    operation: Schema.Literals(["prepare", "session", "inventory"]),
+    method: Schema.Literals(["GET", "POST"]),
+    status: Schema.Number,
+  },
+) {
+  override get message() {
+    return `setup ${this.method} ${this.operation} → ${this.status}`;
+  }
+}
+
+const succeeded = (status: number) => status >= 200 && status < 300;
+
+/** Check a setup response's status before any schema sees its body. */
+export const setupBody =
+  <A>(operation: SetupRequestFailed["operation"], schema: Schema.ConstraintDecoder<A, never>) =>
+  <E, R>(response: Effect.Effect<Response, E, R>) => {
+    const failed = (status: number) =>
+      new SetupRequestFailed({ operation, method: requests[operation].method, status });
+    return response.pipe(
+      // A non-JSON error page fails in the client with its status; name the same closed fields.
+      Effect.mapError((error) =>
+        Schema.is(RequestFailed)(error) && error.status !== undefined && !succeeded(error.status)
+          ? failed(error.status)
+          : error,
+      ),
+      Effect.filterOrFail(
+        (value) => succeeded(value.status),
+        (value) => failed(value.status),
+      ),
+      Effect.flatMap((value) => body(schema, value)),
+    );
+  };
+
 export interface ManagementSetupRecord {
