diff --git a/e2e/support/app-activation-observer.ts b/e2e/support/app-activation-observer.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/app-activation-observer.ts
@@ -0,0 +1,132 @@
+import { errors, type Page, type Request, type Response } from "playwright";
+
+/**
+ * The active versions an answer names for one app. Dashboard batch answers are ndjson lines whose
+ * `text` holds each endpoint's body as a string, so nested JSON strings are opened too.
+ */
+const appVersions = (text: string, app: string | undefined) => {
+  const found = new Set<string>();
+  const visit = (value: unknown): void => {
+    if (typeof value === "string") {
+      if (!/^\s*[[{]/u.test(value)) return;
+      try {
+        visit(JSON.parse(value));
+      } catch {}
+      return;
+    }
+    if (Array.isArray(value)) return value.forEach(visit);
+    if (value === null || typeof value !== "object") return;
+    const record = value as Record<string, unknown>;
+    if (typeof record["activeVersion"] === "string" && (app === undefined || record["id"] === app))
+      found.add(record["activeVersion"]);
+    Object.values(record).forEach(visit);
+  };
+  for (const line of text.split("\n")) visit(line);
+  return found;
+};
+
+/** Arm before deployment: either the version body or both location reads confirms activation. */
+export const observeAppActivation = (
+  page: Page,
+  appRead: (response: Response) => boolean,
+  locationReads: (request: Request) => number,
+  // Scopes the record's versions to this app's own reads; the confirmation rule ignores it.
+  app?: string,
+) => {
+  const bodies: string[] = [];
+  // What each matched answer said, kept past dispose as counts and flags, never the body.
+  const armed = Date.now();
+  let waitBegan: number | undefined;
+  const answers: {
+    at: number;
+    read: "batch" | "app";
+    completed: boolean;
+    versions: ReadonlySet<string>;
+    // The same test the wait applies, when the version was already known on arrival.
+    includedExpected?: boolean;
+  }[] = [];
+  let reads = 0;
+  let expected: string | undefined;
+  let confirm: (() => void) | undefined;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  let disposed = false;
+  const check = () => {
+    const version = expected;
+    if (reads >= 2 || (version !== undefined && bodies.some((body) => body.includes(version))))
+      confirm?.();
+  };
+  const count = (request: Request) => {
+    reads += locationReads(request);
+    check();
+  };
+  const body = (response: Response) => {
+    if (!appRead(response)) return;
+    // Recorded when the answer starts, so a body that never completes still shows.
+    const answer: (typeof answers)[number] = {
+      at: Date.now(),
+      read: new URL(response.url()).pathname.includes("/batch") ? "batch" : "app",
+      completed: false,
+      versions: new Set(),
+    };
+    answers.push(answer);
+    void response.text().then(
+      (text) => {
+        answer.completed = true;
+        if (expected !== undefined) answer.includedExpected = text.includes(expected);
+        answer.versions = appVersions(text, app);
+        if (disposed) return;
+        bodies.push(text);
+        check();
+      },
+      () => {},
+    );
+  };
+  const dispose = () => {
+    disposed = true;
+    clearTimeout(timer);
+    page.off("request", count);
+    page.off("response", body);
+    bodies.length = 0;
+  };
+  page.on("request", count);
+  page.on("response", body);
+  return {
+    dispose,
+    /** Each matched answer since arming: when, which read, and whether it carried the version. */
+    answers: () =>
+      answers.map((answer) => ({
+        afterArmedMs: answer.at - armed,
+        afterWaitBeganMs: waitBegan === undefined ? null : answer.at - waitBegan,
+        read: answer.read,
+        bodyCompleted: answer.completed,
+        carriedExpectedVersion:
+          !answer.completed || expected === undefined
+            ? null
+            : (answer.includedExpected ?? answer.versions.has(expected)),
+        otherVersions: [...answer.versions].filter((version) => version !== expected).length,
+      })),
+    waitForVersion: (version: string) => {
+      expected = version;
+      waitBegan = Date.now();
+      // The fallback counts only the returning-tab window, not earlier deployment traffic.
+      reads = 0;
+      const ready = new Promise<void>((resolve, reject) => {
+        confirm = resolve;
+        // Match Browser's existing operation deadline, including the response-body fallback.
+        timer = setTimeout(
+          () => reject(new errors.TimeoutError("Dashboard activation was not observed")),
+          15_000,
+        );
+        check();
+      });
+      return Promise.all([
+        ready,
+        page.evaluate(() =>
+          document.dispatchEvent(new Event("visibilitychange", { bubbles: true })),
+        ),
+      ])
+        .then(() => undefined)
+        .finally(dispose);
+    },
+  };
+};
