diff --git a/e2e/support/app-activation-observer.ts b/e2e/support/app-activation-observer.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/app-activation-observer.ts
@@ -0,0 +1,67 @@
+import { errors, type Page, type Request, type Response } from "playwright";
+
+/** Arm before deployment: either the version body or both location reads confirms activation. */
+export const observeAppActivation = (
+  page: Page,
+  appRead: (response: Response) => boolean,
+  locationReads: (request: Request) => number,
+) => {
+  const bodies: string[] = [];
+  let reads = 0;
+  let expected: string | undefined;
+  let confirm: (() => void) | undefined;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  let disposed = false;
+  const check = () => {
+    const version = expected;
+    if (reads >= 2 || (version !== undefined && bodies.some((body) => body.includes(version))))
+      confirm?.();
+  };
+  const count = (request: Request) => {
+    reads += locationReads(request);
+    check();
+  };
+  const body = (response: Response) => {
+    if (!appRead(response)) return;
+    void response.text().then(
+      (text) => {
+        if (disposed) return;
+        bodies.push(text);
+        check();
+      },
+      () => {},
+    );
+  };
+  const dispose = () => {
+    disposed = true;
+    clearTimeout(timer);
+    page.off("request", count);
+    page.off("response", body);
+    bodies.length = 0;
+  };
+  page.on("request", count);
+  page.on("response", body);
+  return {
+    dispose,
+    waitForVersion: (version: string) => {
+      expected = version;
+      const ready = new Promise<void>((resolve, reject) => {
+        confirm = resolve;
+        // Match Browser's existing operation deadline, including the response-body fallback.
+        timer = setTimeout(
+          () => reject(new errors.TimeoutError("Dashboard activation was not observed")),
+          15_000,
+        );
+        check();
+      });
+      return Promise.all([
+        ready,
+        page.evaluate(() =>
+          document.dispatchEvent(new Event("visibilitychange", { bubbles: true })),
+        ),
+      ])
+        .then(() => undefined)
+        .finally(dispose);
+    },
+  };
+};
