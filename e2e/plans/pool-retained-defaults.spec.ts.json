{
  "scenarios": {
    "cloudPoolRetainedDefaults": {
      "fixtures": "actors",
      "deferOnboarding": true,
      "title": "Cloud default reconciliation retains legacy versions and recovery policy and refuses unknown declarations",
      "targets": {
        "self-host": {
          "status": "not-applicable",
          "reason": "The Cloud host owns automatic pool defaults."
        },
        "cloud": {
          "status": "scheduled",
          "runtime": "manual-cron"
        },
        "local": {
          "status": "not-applicable",
          "reason": "Uses hosted pool defaults."
        }
      }
    }
  },
