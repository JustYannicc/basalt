{
  "scenarios": {
    "embeddedAppUi": {
      "fixtures": "actors",
      "appOrigin": true,
      "title": "embedded app screens sign in on isolated opaque origins and refuse foreign frames",
      "serverEnvironment": {
        "EXECUTOR_PRODUCT_NAME": "Signalbox",
        "BETTER_AUTH_URL": "http://app.fixture.localhost:0",
        "EXECUTOR_APP_UI_BASE_URL": "http://fixture.localhost:0",
        "EXECUTOR_APP_UI_ADDRESS_SCHEME": "opaque",
        "EXECUTOR_APP_UI_EMBEDDED": "true"
      },
      "targets": {
        "self-host": {
          "status": "scheduled"
        },
        "cloud": {
          "status": "not-applicable",
          "reason": "This scenario owns a self-host process with opaque addressing and embedding enabled."
        },
        "local": {
          "status": "not-applicable",
          "reason": "Local does not host app origins."
        }
      }
    }
  },
  "runs": {
    "embeddedAppUi": ["declared:self-host"]
  },
  "inputs": [
    ".upstream/apps/hosted/cloud/alchemy.run.ts",
    ".upstream/apps/hosted/cloud/src/app-domains.ts",
