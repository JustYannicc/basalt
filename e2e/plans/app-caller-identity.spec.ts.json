{
  "scenarios": {
    "appCallerIdentity": {
      "fixtures": "actors",
      "title": "shared app handlers and cached dynamic tools retain each caller's stable identity",
      "targets": {
        "self-host": {
          "status": "scheduled"
        },
        "cloud": {
          "status": "scheduled"
        },
        "local": {
          "status": "not-applicable",
          "reason": "Local has no hosted organization members to share an app with."
        }
      }
    }
  },
  "runs": {
    "appCallerIdentity": [
      "declared:self-host",
      "declared:cloud"
