  "scenarios": {
    "accountStatusStorage": {
      "fixtures": "actors",
      "appOrigin": true,
      "legacyStorage": true,
      "title": "account status preserves selected sites and retained identity through a reporting upgrade and restarts",
      "targets": {
        "self-host": {
          "status": "scheduled"
        },
        "cloud": {
          "status": "not-applicable",
          "reason": "Uses isolated PGlite metadata."
        },
        "local": {
          "status": "not-applicable",
          "reason": "Uses hosted HTTP endpoints."
        }
      }
    },
    "accountStatusRecoveryStorage": {
      "fixtures": "actors",
      "legacyStorage": true,
      "title": "account status preserves identity and clears failed check metadata after restart and recovery",
      "targets": {
        "self-host": {
          "status": "scheduled"
        },
        "cloud": {
          "status": "not-applicable",
          "reason": "Uses isolated PGlite metadata."
        },
        "local": {
          "status": "not-applicable",
          "reason": "Uses hosted HTTP endpoints."
        }
      }
    }
  },
