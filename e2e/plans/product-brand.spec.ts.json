{
  "scenarios": {
    "productBrand": {
      "fixtures": "actors",
      "managementApps": [
        "owner"
      ],
      "title": "a configured product name and logo replace Executor's in pages, consent, metadata and MCP",
      "serverEnvironment": {
        "EXECUTOR_PRODUCT_NAME": "Acme Tools",
        "EXECUTOR_PRODUCT_LOGO_URL": "/acme-tools.png",
        "EXECUTOR_PRODUCT_DOCS_URL": "https://acme.example/docs",
        "EXECUTOR_PRODUCT_PRIVACY_URL": "https://acme.example/privacy",
        "EXECUTOR_PRODUCT_SOURCE_URL": "https://github.com/acme/tools",
        "EXECUTOR_PRODUCT_FEEDBACK_URL": "/acme-feedback"
      },
      "targets": {
        "self-host": {
          "status": "scheduled"
        },
        "cloud": {
          "status": "not-applicable",
          "reason": "Managed local Cloud serves every scenario from one Worker, so it cannot start under another brand. Self-host runs the same shared pages, metadata and MCP server."
        },
        "local": {
          "status": "not-applicable",
          "reason": "Local always presents Executor; it has no brand settings."
        }
      }
    }
  },
  "runs": {
    "productBrand": [
      "host-managed-accounts:host-managed-visibility-and-existing-account-behavior"
    ]
  },
