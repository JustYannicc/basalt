{
  "scenarios": {
    "poolCreation": {
      "fixtures": "actors",
      "legacyStorage": true,
      "title": "Pool creation preserves retained pools and creates independent instances",
      "targets": {
        "self-host": {
          "status": "scheduled"
        },
        "cloud": {
          "status": "not-applicable",
          "reason": "Uses the full hosted product with runner-owned retained metadata and a signed loopback pool peer."
        },
        "local": {
          "status": "not-applicable",
          "reason": "Pool provisioning belongs to the hosted product."
        }
      }
    }
  },
