{
  "scenarios": {
    "workflowDependencyToolPolicy": {
      "fixtures": "actors",
      "title": "a workflow-scoped rule applies to a dependency call made by that workflow",
      "targets": {
        "self-host": {
          "status": "scheduled"
        },
        "cloud": {
          "status": "scheduled",
          "runtime": "managed"
        },
        "local": {
          "status": "not-applicable",
          "reason": "Uses hosted policy evaluation; managed Cloud exercises WorkflowHost.execute."
        }
      }
    }
  },
