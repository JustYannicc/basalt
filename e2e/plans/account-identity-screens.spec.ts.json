{
  "scenarios": {
    "googleIdentityRecipe": {
      "title": "Existing Google declarations gain verified identity consent without changing app scopes or provider IDs",
      "targets": {
        "local": {
          "status": "scheduled"
        },
        "self-host": {
          "status": "not-applicable",
          "reason": "Shared provider recipe is exercised through local public APIs."
        },
        "cloud": {
          "status": "not-applicable",
          "reason": "No real vendor authorization is performed."
        }
      }
    },
    "accountIdentityRows": {
      "legacyStorage": true,
      "title": "Verified account rows retain five app bindings and add a covered app without consent",
      "targets": {
        "local": {
          "status": "scheduled"
        },
        "self-host": {
          "status": "not-applicable",
          "reason": "Local browser proves the shared identity rows; hosted policy is covered separately."
        },
        "cloud": {
          "status": "not-applicable",
          "reason": "Synthetic OAuth issuer uses loopback."
        }
      }
    },
    "accountIdentityConsentScreen": {
      "title": "An existing identity batches additional app permissions and retains the own-client path",
      "targets": {
        "local": {
          "status": "scheduled"
        },
        "self-host": {
          "status": "not-applicable",
          "reason": "Local browser proves shared consent controls; hosted policy is covered separately."
        },
        "cloud": {
          "status": "not-applicable",
          "reason": "Synthetic OAuth issuer uses loopback."
        }
      }
    },
    "accountIdentityFamilyMarks": {
      "legacyStorage": true,
      "title": "An identity shared by several apps shows its family mark; single-app rows keep theirs",
      "targets": {
        "local": {
          "status": "scheduled"
        },
        "self-host": {
          "status": "not-applicable",
          "reason": "Local browser proves the row marks; hosted policy is covered separately."
        },
        "cloud": {
          "status": "not-applicable",
          "reason": "Synthetic OAuth issuer uses loopback."
        }
      }
    }
  },
  "runs": {
    "googleIdentityRecipe": [
      "host-managed-accounts-local:shared-identities-and-incremental-consent"
    ],
    "accountIdentityRows": [
      "host-managed-accounts-local:shared-identities-and-incremental-consent"
    ],
    "accountIdentityConsentScreen": [
      "host-managed-accounts-local:shared-identities-and-incremental-consent"
