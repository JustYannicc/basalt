{
  "scenarios": {
    "nativeSubscriptionHealth": {
      "fixtures": "actors",
      "legacyStorage": true,
      "title": "native subscriptions check current credentials through the production registration",
      "targets": {
        "self-host": {
          "status": "scheduled"
        },
        "local": {
          "status": "not-applicable",
          "reason": "Uses hosted production provider registrations and authorization."
        },
        "cloud": {
          "status": "not-applicable",
          "reason": "Uses a process-owned registration and loopback credential custodian."
        }
      }
    }
  },
