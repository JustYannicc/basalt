{
  "scenarios": {
    "credentialHostsRefused": {
      "fixtures": "actors",
      "title": "secret fields reach app code as handles that neither undeclared hosts nor other apps can use",
      "targets": {
        "self-host": {
          "status": "scheduled"
        },
        "cloud": {
          "status": "scheduled"
        },
        "local": {
          "status": "not-applicable",
          "reason": "Local runs apps through the same workerd runner and outbound as self-host."
        }
      }
    },
    "credentialHostsRefusedData": {
      "fixtures": "actors",
      "title": "a data facet's secret fields are handles that undeclared hosts cannot use",
      "targets": {
        "self-host": {
          "status": "scheduled"
        },
        "cloud": {
          "status": "scheduled"
        },
        "local": {
          "status": "not-applicable",
          "reason": "Local runs apps through the same workerd runner and outbound as self-host."
        }
      }
    },
    "credentialHostsGranted": {
      "fixtures": "actors",
      "title": "an account sends its secrets only to the hosts it was connected for, in every app that links it",
      "targets": {
        "self-host": {
          "status": "scheduled"
        },
        "cloud": {
          "status": "not-applicable",
          "reason": "Uses a loopback service; Cloud app Workers reach only public addresses."
        },
        "local": {
          "status": "not-applicable",
          "reason": "Local runs apps through the same workerd runner and outbound as self-host."
        }
      }
    },
    "credentialHostsProduct": {
      "fixtures": "actors",
      "title": "a sealed API key reaches the product's own API through the app's outbound network",
      "targets": {
        "self-host": {
          "status": "scheduled"
        },
        "cloud": {
          "status": "scheduled",
          "runtime": "attached"
        },
        "local": {
          "status": "not-applicable",
          "reason": "Local runs apps through the same workerd runner and outbound as self-host."
        }
      }
    },
    "credentialHostsSubstituted": {
      "fixtures": "actors",
      "title": "the outbound network substitutes secret fields for declared hosts and hides echoed values",
      "targets": {
        "self-host": {
          "status": "scheduled"
        },
        "cloud": {
          "status": "not-applicable",
          "reason": "Uses a loopback service; Cloud app Workers reach only public addresses."
        },
        "local": {
          "status": "not-applicable",
          "reason": "Local runs apps through the same workerd runner and outbound as self-host."
        }
      }
    },
    "credentialHostsUnderscore": {
      "fixtures": "actors",
      "title": "a provider may declare a host with an underscore, as Docker names containers, and its credentials reach it",
      "targets": {
        "self-host": {
          "status": "scheduled"
        },
        "cloud": {
          "status": "not-applicable",
          "reason": "Uses a loopback service; Cloud app Workers reach only public addresses."
        },
        "local": {
          "status": "not-applicable",
          "reason": "Local runs apps through the same workerd runner and outbound as self-host."
        }
      }
    },
    "credentialHostsRestart": {
      "fixtures": "actors",
      "title": "a credential handle app code keeps still opens after a restart with the same encryption key",
      "targets": {
        "self-host": {
          "status": "scheduled"
        },
        "cloud": {
          "status": "not-applicable",
          "reason": "Restarts a runner-owned product; Cloud keeps its handle secret across deploys."
        },
        "local": {
          "status": "not-applicable",
          "reason": "Local derives the handle key the same way through the same workerd runner."
        }
      }
    }
  },
