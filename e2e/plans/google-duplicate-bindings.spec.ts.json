          "reason": "Hosted production operations own this migration."
        },
        "self-host": {
          "status": "not-applicable",
          "reason": "The signed operator endpoint is Cloud-only."
        },
        "cloud": {
          "status": "scheduled"
        }
      }
    }
  },
  "runs": {
    "googleDuplicateBindings": [
      "google-account-recovery:google-recovery-through-signed-cloud-operations"
    ]
  },
  "inputs": [
    ".upstream/apps/hosted/cloud/src/infrastructure/production-ops/backup.ts",
    ".upstream/apps/hosted/cloud/src/infrastructure/production-ops/migrations.ts",
    ".upstream/apps/hosted/cloud/src/infrastructure/production-ops/migrations/duplicate-binding-rows.ts",
    ".upstream/apps/hosted/cloud/src/infrastructure/production-ops/migrations/google-duplicate-bindings-v1.ts",
