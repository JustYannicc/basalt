{
  "scenarios": {
    "accountAcquisitionObservations": {
      "fixtures": "actors",
      "title": "driver observations coalesce, redact references and retain readings while a registration is unavailable",
      "targets": {
        "self-host": {
          "status": "scheduled"
        },
        "local": {
          "status": "not-applicable",
          "reason": "The local driver lifecycle scenario covers retained readings across a process restart."
        },
        "cloud": {
          "status": "not-applicable",
          "reason": "Requires process-owned registration and a loopback credential service."
        }
      }
    },
    "accountAcquisitionOptional": {
      "fixtures": "actors",
      "title": "missing driver hooks do not create health success and a present void check does",
      "targets": {
        "self-host": {
          "status": "scheduled"
        },
        "local": {
          "status": "not-applicable",
          "reason": "Exercises shared SDK capability handling through the hosted product."
        },
        "cloud": {
          "status": "not-applicable",
          "reason": "Requires process-owned registration and a loopback credential service."
        }
      }
    }
  },
  "runs": {
