{
  "scenarios": {
    "interactiveAccountVersionRemoval": {
      "fixtures": "actors",
      "title": "interactive account removal uses current backend credentials after a provider change",
      "targets": {
        "self-host": {
          "status": "scheduled"
        },
        "cloud": {
          "status": "not-applicable",
          "reason": "Uses a loopback backend through the shared hosted server."
        },
        "local": {
          "status": "not-applicable",
          "reason": "Uses hosted account deletion authority and links."
        }
      }
    },
    "interactiveAccountAcquiringVersionRemoval": {
