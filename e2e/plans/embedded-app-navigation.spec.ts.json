{
  "scenarios": {
    "embeddedAppTabDirectEntry": {
      "fixtures": "actors",
      "appOrigin": true,
      "title": "a directly opened app holds its App tab's place until access answers, then opens on App; explicit views and tool-only apps keep their view",
      "serverEnvironment": {
        "EXECUTOR_PRODUCT_NAME": "Signalbox",
        "BETTER_AUTH_URL": "http://app.fixture.localhost:0",
        "EXECUTOR_APP_UI_BASE_URL": "http://fixture.localhost:0",
        "EXECUTOR_APP_UI_ADDRESS_SCHEME": "opaque",
        "EXECUTOR_APP_UI_EMBEDDED": "true"
      },
      "targets": {
        "self-host": {
          "status": "scheduled"
        },
        "cloud": {
          "status": "not-applicable",
          "reason": "This scenario owns a self-host process with opaque addressing and embedding enabled."
        },
        "local": {
          "status": "not-applicable",
          "reason": "Local does not host app origins."
        }
      }
    },
    "embeddedAppHiddenPolling": {
      "fixtures": "actors",
      "appOrigin": true,
