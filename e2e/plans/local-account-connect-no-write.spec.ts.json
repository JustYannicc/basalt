{
  "scenarios": {
    "localAccountConnectNoWrite": {
      "title": "opening and closing the local dashboard's account forms, including a saved identity's reuse plan, saves nothing",
      "targets": {
        "local": {
          "status": "scheduled"
        },
        "self-host": {
          "status": "not-applicable",
          "reason": "Hosted forms are covered by the account connect writes scenario."
        },
        "cloud": {
          "status": "not-applicable",
          "reason": "Synthetic OAuth issuer uses loopback."
        }
      }
    }
  },
  "runs": {
    "localAccountConnectNoWrite": [
      "declared:local"
    ]
  },
  "inputs": [
    ".upstream/apps/local/server/src/contracts/dashboard.ts",
    ".upstream/apps/local/server/src/implementation/app-accounts.ts",
    ".upstream/apps/local/server/src/implementation/dashboard-oauth-connections.ts",
    ".upstream/apps/local/server/src/implementation/dashboard.ts",
    ".upstream/apps/local/web/src/contracts/identity-consent.ts",
    ".upstream/apps/local/web/src/implementation/pages/account-form.tsx",
    ".upstream/apps/local/web/src/implementation/pages/oauth-fields.tsx",
    ".upstream/packages/sdk/src/implementation/oauth-connection-plan.ts",
    ".upstream/packages/ui/src/implementation/dashboard/identity-consent-client.tsx"
  ]
}
