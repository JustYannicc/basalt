{
  "scenarios": {
    "navigationIntentReads": {
      "fixtures": "actors",
      "title": "Hovering an app link reads the app and its tools before the click, and opening it reuses that read",
      "targets": {
        "self-host": {
          "status": "scheduled"
        },
        "cloud": {
          "status": "scheduled",
          "runtime": "attached"
        },
        "local": {
          "status": "not-applicable",
          "reason": "Local pages are not organization routes, which declare these reads."
        }
      }
    }
  },
  "runs": {
    "navigationIntentReads": [
      "declared:self-host"
    ]
  },
  "inputs": [
