{
  "scenarios": {
    "accountHealth": {
      "fixtures": "actors",
      "title": "Apps check a shared account their own way and report its identity",
      "targets": {
        "self-host": {
          "status": "scheduled"
        },
        "cloud": {
          "status": "not-applicable",
          "reason": "Uses a controlled loopback service through the shared runtime contract."
        },
        "local": {
          "status": "not-applicable",
          "reason": "The shared SDK and account view are exercised through hosted APIs."
        }
      }
    }
  },
  "runs": {
    "accountHealth": ["host-managed-accounts:host-managed-visibility-and-existing-account-behavior"]
  },
  "inputs": [
    ".upstream/apps/hosted/server/src/contracts/resource-access.ts",
    ".upstream/apps/hosted/server/src/implementation/resource-access.ts",
    ".upstream/apps/hosted/web/src/contracts/resource-access.ts",
    ".upstream/apps/local/server/src/contracts/dashboard.ts",
    ".upstream/apps/local/server/src/implementation/dashboard.ts",
    ".upstream/packages/ui/src/contracts/dashboard.ts",
    ".upstream/packages/ui/src/implementation/dashboard/accounts.tsx",
    ".upstream/packages/ui/src/implementation/dashboard/apps.tsx"
  ]
}
