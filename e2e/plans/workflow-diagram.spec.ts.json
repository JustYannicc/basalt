{
  "scenarios": {
    "workflowDiagram": {
      "fixtures": "actors",
      "title": "Workflows are drawn from the deployed code for people who can read it, and steps lead to the workflows they start",
      "targets": {
        "self-host": {
          "status": "scheduled"
        },
        "cloud": {
          "status": "scheduled"
        },
        "local": {
          "status": "not-applicable",
          "reason": "Local has its own scenario: one person, who can always read the source."
        }
      }
    }
  },
  "runs": {
    "workflowDiagram": ["declared:self-host", "declared:cloud"]
  },
  "inputs": [
    ".upstream/apps/hosted/web/src/contracts/apps.ts",
    ".upstream/apps/hosted/web/src/implementation/pages/app-detail.tsx",
    ".upstream/apps/hosted/web/src/implementation/pages/app-resources.tsx",
    ".upstream/apps/local/web/src/contracts/api.ts",
    ".upstream/apps/local/web/src/implementation/pages/app-resources.tsx",
    ".upstream/bun.lock",
    ".upstream/packages/ui/package.json",
    ".upstream/packages/ui/src/contracts/app-browser.ts",
    ".upstream/packages/ui/src/implementation/dashboard/app-browser-loading.tsx",
    ".upstream/packages/ui/src/implementation/dashboard/app-workflows.tsx",
    ".upstream/packages/ui/src/implementation/dashboard/workflow-actions.tsx",
    ".upstream/packages/ui/src/implementation/dashboard/workflow-diagram-canvas.tsx",
    ".upstream/packages/ui/src/implementation/dashboard/workflow-diagram-cards.tsx",
    ".upstream/packages/ui/src/implementation/dashboard/workflow-diagram-details.tsx",
    ".upstream/packages/ui/src/implementation/dashboard/workflow-diagram-excerpt.tsx",
    ".upstream/packages/ui/src/implementation/dashboard/workflow-diagram-references.tsx",
    ".upstream/packages/ui/src/implementation/dashboard/workflow-diagram-section.tsx",
    ".upstream/packages/ui/src/implementation/dashboard/workflow-diagram-viewport.ts",
    ".upstream/packages/ui/src/implementation/dashboard/workflow-diagram.tsx",
    ".upstream/packages/workflow-graph/package.json",
    ".upstream/packages/workflow-graph/src/contracts/graph.ts",
    ".upstream/packages/workflow-graph/src/implementation/derive.ts",
