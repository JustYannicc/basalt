{
  "scenarios": {
    "cloudPoolAccountRecovery": {
      "fixtures": "actors",
      "deferOnboarding": true,
      "title": "Cloud pool account recovery queues one owner job and preserves permissions and backoff",
      "targets": {
        "self-host": {
          "status": "not-applicable",
          "reason": "The Cloud host owns automatic pool setup."
        },
        "cloud": {
          "status": "scheduled",
          "runtime": "manual-cron"
        },
        "local": {
          "status": "not-applicable",
          "reason": "The Cloud host owns automatic pool setup."
        }
      }
    }
  },
  "runs": {
    "cloudPoolAccountRecovery": [
      "pool-account-recovery:recovery-through-cloud-s-real-provisioning-queue"
    ]
  },
  "inputs": [
    ".upstream/apps/hosted/cloud/alchemy.run.ts",
    ".upstream/apps/hosted/cloud/src/infrastructure/product-services.ts",
    ".upstream/apps/hosted/server/src/contracts/app-accounts.ts",
    ".upstream/apps/hosted/server/src/contracts/host-managed-accounts.ts",
    ".upstream/apps/hosted/server/src/contracts/resource-access.ts",
    ".upstream/apps/hosted/server/src/implementation/account-sign-in.ts",
    ".upstream/apps/hosted/server/src/implementation/app-account-links.ts",
    ".upstream/apps/hosted/server/src/implementation/host-managed-accounts.ts",
    ".upstream/apps/hosted/server/src/implementation/pool-access-provenance.ts",
    ".upstream/apps/hosted/server/src/implementation/pool-account-recovery.ts",
    ".upstream/apps/hosted/server/src/implementation/pool-defaults.ts",
    ".upstream/apps/hosted/server/src/implementation/pool-records.ts",
    ".upstream/apps/hosted/server/src/implementation/resource-access.ts",
    ".upstream/apps/local/server/src/contracts/dashboard.ts",
    ".upstream/apps/local/server/src/implementation/dashboard.ts",
    ".upstream/packages/ui/src/contracts/app-accounts.ts",
    ".upstream/packages/ui/src/contracts/dashboard.ts",
    ".upstream/packages/ui/src/implementation/dashboard/app-accounts.tsx",
    ".upstream/packages/ui/src/implementation/dashboard/apps.tsx",
    "apps/pool/**",
    "src/pool/**"
  ]
}
