{
  "scenarios": {
    "mcpProtocol": {
      "fixtures": "actors",
      "title": "MCP OAuth grants support discovery, execution, refresh and revocation",
      "targets": {
        "self-host": {
          "status": "scheduled"
        },
        "cloud": {
          "status": "scheduled"
        },
        "local": {
          "status": "not-applicable",
          "reason": "This scenario tests hosted organization consent, which Local does not have."
        }
      }
    },
    "mcpOAuthWithoutResource": {
      "fixtures": "actors",
      "title": "MCP OAuth without a resource parameter grants the plain /mcp URL",
      "targets": {
        "self-host": {
          "status": "scheduled"
        },
        "cloud": {
          "status": "scheduled"
        },
        "local": {
          "status": "not-applicable",
          "reason": "Local's consent is covered by localMcpOAuthWithoutResource."
        }
      }
    }
  },
  "runs": {
