@@ -0,0 +1,82 @@
+import type { Page, Request } from "playwright";
+
+export type RequestEvent = "request" | "requestfinished" | "requestfailed";
+export interface RequestEvents {
+  mainFrame: Page["mainFrame"];
+  on(event: "request", listener: (request: Request) => void): unknown;
+  on(event: "requestfinished", listener: (request: Request) => void): unknown;
+  on(event: "requestfailed", listener: (request: Request) => void): unknown;
+  off(event: "request", listener: (request: Request) => void): unknown;
+  off(event: "requestfinished", listener: (request: Request) => void): unknown;
+  off(event: "requestfailed", listener: (request: Request) => void): unknown;
+}
+
+type Waiter = (error?: Error) => void;
+type Generation = {
+  pending: Set<Request>;
+  waiters: Set<Waiter>;
+  failure?: Error;
+};
+const generation = (): Generation => ({
+  pending: new Set<Request>(),
+  waiters: new Set<Waiter>(),
+});
+
+/** Network events can outlive a document, especially when a test route holds the old request. */
+export const documentRequests = (page: RequestEvents, matches: (request: Request) => boolean) => {
+  let current = generation();
+  const notify = () => {
+    if (current.pending.size > 0 && current.failure === undefined) return;
+    for (const waiter of current.waiters) waiter(current.failure);
+  };
+  const close = (error: Error) => {
+    for (const waiter of current.waiters) waiter(error);
+    current.pending.clear();
+  };
+  const requested = (request: Request) => {
+    // A history change stays in this document; only a main-frame document request replaces it.
+    if (request.isNavigationRequest() && request.frame() === page.mainFrame()) {
+      close(new Error("The document changed before its requests settled"));
+      current = generation();
+    }
+    if (matches(request)) current.pending.add(request);
+  };
+  const finished = (request: Request) => {
+    if (current.pending.delete(request)) notify();
+  };
+  const failed = (request: Request) => {
+    if (!current.pending.delete(request)) return;
+    current.failure = new Error("A current-document request failed");
+    notify();
+  };
+  page.on("request", requested);
+  page.on("requestfinished", finished);
+  page.on("requestfailed", failed);
+  return {
+    wait: () => {
+      const observed = current;
+      if (observed.failure !== undefined) return Promise.reject(observed.failure);
+      if (observed.pending.size === 0) return Promise.resolve();
+      return new Promise<void>((resolve, reject) => {
+        const settled: Waiter = (error) => {
+          clearTimeout(timeout);
+          observed.waiters.delete(settled);
+          if (error === undefined) resolve();
+          else reject(error);
+        };
+        // Keep Browser's 15 second operation deadline on the driver clock, not the page's fake clock.
+        const timeout = setTimeout(
+          () => settled(new Error("Document requests did not settle within 15000ms")),
+          15_000,
+        );
+        observed.waiters.add(settled);
+      });
+    },
+    close: () => {
+      page.off("request", requested);
+      page.off("requestfinished", finished);
+      page.off("requestfailed", failed);
+      close(new Error("The request observer closed before its requests settled"));
+    },
+  };
+};
