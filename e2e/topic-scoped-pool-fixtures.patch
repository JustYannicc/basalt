+++ b/e2e/support/pool-usage-change.ts
@@ -0,0 +1,39 @@
+/** Deliver the loopback pool's committed usage change through the real signed host ingress. */
+import { Effect } from "effect";
+import { createHmac } from "node:crypto";
+import { Api } from "./api.ts";
+import { Actors } from "./actors.ts";
+
+const publishChange = (app: string, topic: "pool-usage" | "pool-readings", revision: string) =>
+  Effect.gen(function* () {
+    const api = yield* Api;
+    const actors = yield* Actors;
+    const at = Date.now();
+    const payload = Buffer.from(
+      JSON.stringify({
+        action: "publish-changes",
+        at,
+        expiresAt: at + 30_000,
+        changes: [
+          {
+            scope: `pool:${app}`,
+            hint: { topic, resource: app, revision },
+          },
+        ],
+      }),
+    ).toString("base64url");
+    const signature = createHmac("sha256", Buffer.from("ab".repeat(32), "hex"))
+      .update(`sbcr1.${payload}`)
+      .digest("base64url");
+    const response = yield* api.request(actors.owner, "POST", "/api/internal/change-revisions", {
+      envelope: `sbcr1.${payload}.${signature}`,
+    });
+    if (response.status !== 204)
+      return yield* Effect.die(`Pool fixture change returned ${response.status}`);
+  });
+
+export const publishUsageChange = (app: string, revision = "1") =>
+  publishChange(app, "pool-usage", revision);
+
+export const publishReadingChange = (app: string, revision = "1") =>
+  publishChange(app, "pool-readings", revision);
