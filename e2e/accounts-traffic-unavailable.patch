+                  .locator("[data-account-requests]")
+                  .getAttribute("data-account-requests"),
+                page.locator("[data-account-requests-unavailable]").count(),
+              ]),
+            ),
+        );
+        expect(restored, "counts after the pool answers again").toEqual(["3", "0", 0]);
+
