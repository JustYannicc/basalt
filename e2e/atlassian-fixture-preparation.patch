+import { expect } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { FetchHttpClient, HttpClient } from "effect/http";
+import { Actors } from "./actors.ts";
+import { Api, body } from "./api.ts";
+import { connectionsPath } from "./app-accounts.ts";
+import { deployFamilyApps, type FamilyApp } from "./atlassian-family-fixture.ts";
+import { Resource } from "./contracts.ts";
+
+/** Row tests use real OAuth over HTTP; separate browser cases cover the consent form. */
+export const connectFamilyApps = (
+  fixture: Effect.Success<ReturnType<typeof deployFamilyApps>>,
+  primary: FamilyApp,
+  companions: readonly FamilyApp[],
+  issuer: string,
+) =>
+  Effect.gen(function* () {
+    const api = yield* Api,
+      actors = yield* Actors,
+      http = yield* HttpClient.HttpClient;
+    const pending = yield* Effect.forEach([primary, ...companions], (key) =>
+      Effect.gen(function* () {
+        const response = yield* api.request(
+          actors.owner,
+          "POST",
+          connectionsPath(fixture.apps[key].path, "user", "service"),
+          {},
+        );
+        expect(response.status, JSON.stringify(response.body)).toBe(200);
+        return yield* body(Resource, response);
+      }),
+    );
+    const connection = pending[0]!;
+    const started = yield* api.request(
+      actors.owner,
+      "POST",
+      `${fixture.prefix}/connections/${connection.id}/oauth/start`,
+      {
+        method: "oauth",
+        additionalConnections: pending
+          .slice(1)
+          .map(({ id }) => ({ connection: id, method: "oauth" })),
+      },
+    );
+    expect(started.status, JSON.stringify(started.body)).toBe(200);
+    const { authorizationUrl } = yield* body(
+      Schema.Struct({ status: Schema.Literal("redirect"), authorizationUrl: Schema.String }),
+      started,
+    );
+    // Substitute only the external consent host, preserving the product's PKCE and callback.
+    const consent = new URL("/authorize", issuer);
+    consent.search = new URL(authorizationUrl).search;
+    const callbackUrl = yield* Effect.scoped(
+      Effect.gen(function* () {
+        const response = yield* HttpClient.withScope(http).get(consent.href);
+        expect(response.status).toBe(302);
+        if (response.headers.location === undefined)
+          return yield* Effect.die("Issuer omitted callback");
+        return response.headers.location;
+      }),
+    ).pipe(Effect.provideService(FetchHttpClient.RequestInit, { redirect: "manual" }));
+    const completed = yield* api.request(
+      actors.owner,
+      "POST",
+      `${fixture.prefix}/connections/${connection.id}/oauth/complete`,
+      { callbackUrl },
+    );
+    expect(completed.status, JSON.stringify(completed.body)).toBe(200);
+  });
diff --git a/e2e/tests/atlassian-family-consent.spec.ts b/e2e/tests/atlassian-family-consent.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/atlassian-family-consent.spec.ts
@@ -0,0 +1,162 @@
+/** Consent UI coverage stays separate from the saved family row and reuse checks. */
+import { expect, layer } from "@effect/vitest";
+import { Effect } from "effect";
+import type { Page } from "playwright";
+import { Browser } from "../support/browser.ts";
+import { Evidence } from "../support/evidence.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { atlassianFamilyClients } from "../support/atlassian-family-product.ts";
+import { finishAppSignIn, finishInNewTab } from "../support/atlassian-family-fixture.ts";
+import {
+  allFamilyApps,
+  captureFamilyScreen as capture,
+  familyIdentity,
+  familySetup,
+  openBrowser,
+} from "../support/atlassian-family-screens.ts";
+import { openInApp } from "../support/in-app-navigation.ts";
+import { scenarios } from "../test-plan.ts";
+
+const consentApps = (page: Page) => {
+  const boxes = page
+    .getByRole("group", { name: "Connect more apps in this sign-in" })
+    .getByRole("checkbox");
+  return page
+    .getByRole("button", { name: /^(Connect (Gmail|Jira)|Continue with (Google|Atlassian))$/ })
+    .waitFor()
+    .then(() =>
+      boxes.evaluateAll((items) =>
+        items.map((box) => box.closest("label")?.textContent?.trim() ?? "").sort(),
+      ),
+    );
+};
+
+const fits = (page: Page) =>
+  page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth);
+
+layer(HostedLive, { excludeTestServices: true })("Family consent screens", (it) => {
+  it.effect(scenarios.googleFamilyConsentScreens.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const browser = yield* Browser,
+          evidence = yield* Evidence;
+        const { atlassian, google, fixture } = yield* evidence.step(
+          "Deploy family apps and restart product",
+          familySetup(allFamilyApps),
+        );
+        const urls = yield* openBrowser({ atlassian: atlassian.origin, google: google.origin });
+        yield* browser.use("Use desktop width", (page) =>
+          page.setViewportSize({ width: 1280, height: 900 }),
+        );
+        const identityOf = familyIdentity(fixture);
+        // Google is the reference: one sign-in offers the other Google app, nothing else.
+        const gmail = fixture.apps.gmail;
+        const googleTargets = yield* browser.use("Open a fresh Gmail connection", (page) =>
+          page
+            .goto(urls.app(gmail.id).url)
+            .then(() =>
+              page.getByRole("button", { name: "Connect new account", exact: true }).click(),
+            )
+            .then(() => consentApps(page)),
+        );
+        yield* capture("google-consent-1280.png");
+        expect(googleTargets).toEqual(["Google Calendar"]);
+        yield* browser.use("Connect Gmail and Google Calendar in one Google sign-in", (page) =>
+          finishAppSignIn(page, gmail.id, "Gmail", ["Google Calendar"]),
+        );
+        expect((yield* google.metrics).authorizations).toBe(1);
+
+        const gmailAccount = yield* identityOf("gmail");
+        expect(gmailAccount.identity?.id).toBeDefined();
+        expect((yield* identityOf("calendar")).identity?.id).toBe(gmailAccount.identity?.id);
+      }),
+    ),
+  );
+  it.effect(scenarios.atlassianFamilyConsentScreens.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const browser = yield* Browser,
+          evidence = yield* Evidence;
+        const { atlassian, google, fixture } = yield* evidence.step(
+          "Deploy family apps and restart product",
+          familySetup(allFamilyApps),
+        );
+        const urls = yield* openBrowser({ atlassian: atlassian.origin, google: google.origin });
+        yield* browser.use("Use desktop width", (page) =>
+          page.setViewportSize({ width: 1280, height: 900 }),
+        );
+        const identityOf = familyIdentity(fixture);
+        // Jira gets the same consent, offering exactly the Atlassian apps.
+        const jira = fixture.apps.jira;
+        yield* browser.use("Open Jira", (page) => page.goto(urls.app(jira.id).url));
+        const atlassianTargets = yield* browser.use("Open a fresh Jira connection", (page) =>
+          page
+            .getByRole("button", { name: "Connect new account", exact: true })
+            .click()
+            .then(() => consentApps(page)),
+        );
+        yield* capture("atlassian-consent-1280.png");
+        yield* browser.use("Use phone width for the Atlassian form", (page) =>
+          page.setViewportSize({ width: 390, height: 844 }),
+        );
+        yield* capture("atlassian-consent-390.png");
+        expect(yield* browser.use("Check the phone sign-in form fits", fits)).toBe(true);
+        yield* browser.use("Restore desktop width", (page) =>
+          page.setViewportSize({ width: 1280, height: 900 }),
+        );
+        expect(
+          atlassianTargets,
+          "Trello and Google apps are not Atlassian sign-in consumers",
+        ).toEqual(["Confluence", "Jira Service Management"]);
+        yield* browser.use("Connect Jira and Confluence in one Atlassian sign-in", (page) =>
+          finishAppSignIn(page, jira.id, "Jira", ["Confluence"]),
+        );
+        expect((yield* atlassian.metrics).authorizations, "one Atlassian sign-in").toBe(1);
+        const jiraAccount = yield* identityOf("jira");
+        const confluenceAccount = yield* identityOf("confluence");
+        expect(jiraAccount.identity?.id).toBeDefined();
+        expect(confluenceAccount.identity?.id).toBe(jiraAccount.identity?.id);
+        // Trello uses Atlassian's authorization server for another audience: its own sign-in.
+        yield* atlassian.configure({ subject: "trello-member" });
+        const trello = fixture.apps.trello;
+        yield* openInApp("Open Trello in the running dashboard", urls.app(trello.id).url);
+        const trelloTargets = yield* browser.use("Open a fresh Trello connection", (page) =>
+          page
+            .getByRole("button", { name: "Connect new account", exact: true })
+            .click()
+            .then(() => page.getByRole("button", { name: "Connect Trello", exact: true }).waitFor())
+            .then(() =>
+              page.getByRole("group", { name: "Connect more apps in this sign-in" }).count(),
+            ),
+        );
+        expect(trelloTargets, "Trello offers no Atlassian consumers").toBe(0);
+        yield* browser.use("Connect Trello with its own sign-in", (page) => {
+          const client = page.getByRole("textbox", { name: "Client ID", exact: true });
+          return client
+            .count()
+            .then((shown) =>
+              shown === 0
+                ? undefined
+                : client
+                    .fill(atlassianFamilyClients.atlassian.id)
+                    .then(() =>
+                      page
+                        .getByLabel("Client secret", { exact: true })
+                        .fill(atlassianFamilyClients.atlassian.secret),
+                    ),
+            )
+            .then(() =>
+              finishInNewTab(page, trello.id, () =>
+                page.getByRole("button", { name: "Connect Trello", exact: true }).click(),
+              ),
+            );
+        });
+        const trelloAccount = yield* identityOf("trello");
+        expect(trelloAccount.id).not.toBe(jiraAccount.id);
+        expect(trelloAccount.identity?.id).not.toBe(jiraAccount.identity?.id);
+      }),
+    ),
+  );
+});
