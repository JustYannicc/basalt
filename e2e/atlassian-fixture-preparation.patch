+import { expect } from "@effect/vitest";
+import { Effect } from "effect";
+import { Actors } from "./actors.ts";
+import { accountIdentityIssuer } from "./account-identity-issuer.ts";
+import { atlassianFamilyProduct } from "./atlassian-family-product.ts";
+import {
+  deployFamilyApps,
+  routeFamilyMarks,
+  routeProviderConsent,
+} from "./atlassian-family-fixture.ts";
+import { linkedAccountIds } from "./app-accounts.ts";
+import { Browser } from "./browser.ts";
+import { Evidence } from "./evidence.ts";
+
+export const allFamilyApps = [
+  "jira",
+  "confluence",
+  "serviceManagement",
+  "trello",
+  "gmail",
+  "calendar",
+] as const;
+
+/** Two synthetic issuers behind the shipped endpoints, the product restarted on that transport. */
+export const familySetup = (names: Parameters<typeof deployFamilyApps>[0]) =>
+  Effect.gen(function* () {
+    const atlassian = yield* accountIdentityIssuer,
+      google = yield* accountIdentityIssuer;
+    // Prepare the transport and independent apps before restarting the product.
+    const [transport, fixture] = yield* Effect.all(
+      [
+        atlassianFamilyProduct({ atlassian: atlassian.origin, google: google.origin }),
+        deployFamilyApps(names),
+      ],
+      { concurrency: 2 },
+    );
+    yield* transport.start;
+    return { atlassian, google, transport, fixture };
+  });
+
+export const openBrowser = (issuers: { atlassian: string; google: string }) =>
+  Effect.gen(function* () {
+    const browser = yield* Browser,
+      actors = yield* Actors;
+    yield* browser.omitNetworkTrace;
+    yield* browser.login(actors.owner);
+    yield* browser.use("Answer provider consent and family marks on loopback", (page) =>
+      Promise.all([
+        routeProviderConsent(page.context(), issuers),
+        routeFamilyMarks(page.context()),
+      ]),
+    );
+    return {
+      accounts: `/org/${actors.organization.slug}/accounts`,
+      app: (id: string) => ({
+        id,
+        url: `/org/${actors.organization.slug}/apps/${id}?view=accounts`,
+      }),
+    };
+  });
+
+export const captureFamilyScreen = (name: string) =>
+  Effect.gen(function* () {
+    const browser = yield* Browser,
+      evidence = yield* Evidence;
+    const png = yield* browser.use(`Capture ${name}`, (page) =>
+      page.screenshot({ fullPage: true }),
+    );
+    yield* evidence.attach(name, "image/png", png);
+  });
+
+export const familyIdentity =
+  (fixture: Effect.Success<ReturnType<typeof deployFamilyApps>>) =>
+  (app: "jira" | "confluence" | "trello" | "gmail" | "calendar") =>
+    Effect.gen(function* () {
+      const actors = yield* Actors;
+      const links = yield* linkedAccountIds(actors.owner, fixture.apps[app].path);
+      expect(links, `${app} has one saved account`).toHaveLength(1);
+      return yield* fixture.account(links[0]!);
+    });
