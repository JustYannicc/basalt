{
  "description": "Cutover step P2-pre: the new controller code alone, with the fleet classes still absent. Rollbackable with a Worker rollback.",
  "check": {
    "mode": "code-only",
    "protected": {
      "fqns": [
        "PoolContainer",
        "PoolRuntimeBlue",
        "PoolRuntimeGreen",
        "PoolRuntime",
        "VaultAttachments",
        "PublicSiteWaitlist",
        "PoolObservationSecrets",
        "PoolProviderObservationToken",
        "ArtifactsCredentials"
      ],
      "types": [
        "Cloudflare.Hyperdrive",
        "Planetscale.*",
        "Cloudflare.R2.Bucket",
        "Cloudflare.D1Database",
        "Cloudflare.SecretsStore"
      ]
    },
    "removals": [],
    "poolContainer": {
      "fqn": "PoolContainer",
      "image": ""
    },
    "poolWorker": "PoolWorker",
    "artifactsCredentials": "ArtifactsCredentials",
    "allow": [
      {
        "fqn": "PoolDatabase",
        "action": "update"
      }
    ]
  },
  "include": [
    "PoolWorker",
    "PoolBackendBudgetRuntimeReady"
  ],
  "wire": {
    "sqliteClasses": {}
  },
  "env": {
    "POOL_FLEET_CLASSES": "absent"
  }
}
