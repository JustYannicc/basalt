{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "categories": {
    "correctness": "off"
  },
  "jsPlugins": [
    {
      "name": "basalt",
      "specifier": "./plugin/basalt.mjs"
    },
    {
      "name": "landmines-testing",
      "specifier": "@interfere/landmines/testing"
    },
    {
      "name": "landmines-structure",
      "specifier": "@interfere/landmines/structure"
    }
  ],
  "rules": {
    "basalt/no-direct-cloudflare-api": "error",
    "basalt/no-spread-into-provider-request": "error",
    "basalt/no-strict-provider-decode": "error",
    "basalt/no-exact-readback-compare": [
      "error",
      {
        "comparators": [
          "sameProvisioningValue"
        ]
      }
    ],
    "basalt/no-echo-stub": "error",
    "basalt/no-handwritten-provider-response": "error",
    "basalt/no-discarded-child-output": "error",
    "basalt/no-node-test-doubles": "error",
    "basalt/no-node-test-flake-masking": "error",
    "basalt/no-alchemy-auto-approve": "error",
    "landmines-testing/no-test-doubles": "error",
    "landmines-testing/no-fixed-sleep": [
      "error",
      {
