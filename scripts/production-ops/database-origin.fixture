import * as Redacted from "effect/Redacted";

/** Declared-origin changes are independent of the actual SQL binding below. */
export const databaseOriginFixture = (value: Redacted.Redacted<string>) => {
  const url = new URL(Redacted.value(value));
  const variant = process.env.BASALT_E2E_DATABASE_ORIGIN;
  if (variant === "host") url.hostname = "another-database.invalid";
  if (variant === "database") url.pathname = "/another_database";
  url.searchParams.set("invocation", "synthetic-per-request-query-secret");
  return Redacted.make(url.toString());
};

export const runtimeDatabaseOriginFixture = <A extends { user: string; port: number }>(value: A): A => {
  const variant = process.env.BASALT_E2E_DATABASE_ORIGIN;
  return {
    ...value,
    ...(variant === "role" || variant === "without-server" ? { user: "executor_ops_other" } : {}),
    ...(variant === "target" ? { port: Number(process.env.BASALT_E2E_DATABASE_TARGET_PORT) } : {}),
  };
};
