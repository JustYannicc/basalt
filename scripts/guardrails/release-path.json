{
  "about": "Globs for the files that decide how a production release is made: release code, its workflows, the stack declarations it applies and every carry that patches Alchemy. A change here needs a rehearsal, ships alone and counts against the release tooling budget. Entries for the Alchemy release path match nothing until it lands.",
  "paths": [
    "alchemy.run.ts",
    "infrastructure/**",
    "src/pool/deployment.ts",
    "src/pool/fleet-deployment.ts",
    "src/pool/placement.ts",
    "src/pool/database.ts",
    "release-declarations.json",
    "patches/*alchemy*",
    "patches/0003-eu-durable-objects.*",
    "patches/0170-container-image-drift.*",
    "patches/0309-normalized-container-resources.*",
    "patches/0311-container-publication-outputs.*",
    "patches/0329-declared-container-instances.*",
    "scripts/release/**",
    "scripts/pool-fleet/**",
    "scripts/release-barrier/**",
    "scripts/release-phases/**",
    "scripts/deploy-safety/**",
    "scripts/deploy-main/**",
    "scripts/deploy.ts",
    "scripts/guardrails/**",
    ".github/workflows/release.yml",
    ".github/workflows/pool-fleet.yml",
    ".github/workflows/deploy.yml",
    ".github/workflows/release-main.yml",
    ".github/workflows/release-manual.yml",
    ".github/workflows/release-rollback.yml",
    ".github/workflows/pool-runtime-provision.yml",
    ".github/workflows/guardrails.yml"
  ]
}
