+package home
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/dispatchtiming"
+)
+
+func TestBasaltNodeDispatchTimingHeaderSyntheticProvider(t *testing.T) {
+	trailer := `[{"stage":"authenticate","duration_ms":2,"outcome":"ok"},{"stage":"selection","duration_ms":3,"outcome":"ok"},{"stage":"admission","duration_ms":4,"outcome":"ok"},{"stage":"reply_write","duration_ms":5,"outcome":"ok"}]`
+	for _, legacy := range []bool{false, true} {
+		client, commands := newRedisCommandTestClient(t, func(args []string) string {
+			if strings.EqualFold(args[0], "RPOP") {
+				var request map[string]any
+				if json.Unmarshal([]byte(args[1]), &request) != nil || request["dispatch_timing"] != true {
+					t.Error("dispatch did not opt in")
+				}
+				primary := `{"credential":"synthetic"}`
+				wire := fmt.Sprintf("$%d\r\n%s\r\n", len(primary), primary)
+				if legacy {
+					return wire
+				}
+				return "*2\r\n" + wire + fmt.Sprintf("$%d\r\n%s\r\n", len(trailer), trailer)
+			}
+			return balanceTestRedisReply(args)
+		})
+		providerCalls := 0
+		provider := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			providerCalls++
+			w.Header().Set("Content-Type", "text/event-stream")
+			_, _ = io.WriteString(w, "data: synthetic-provider-terminal\n\n")
+		}))
+		engine := gin.New()
+		engine.Use(dispatchtiming.Middleware())
+		engine.POST("/v1/messages", func(c *gin.Context) {
+			ctx := dispatchtiming.Inherit(context.Background(), c.Request.Context())
+			raw, err := client.RPopAuth(ctx, "synthetic-model", "synthetic-session", nil, 1)
+			if err != nil || string(raw) != `{"credential":"synthetic"}` {
+				t.Errorf("primary changed: %s, %v", raw, err)
+				c.Status(500)
+				return
+			}
+			response, err := http.Get(provider.URL)
+			if err != nil {
+				t.Error(err)
+				c.Status(500)
+				return
+			}
+			defer response.Body.Close()
+			c.Status(response.StatusCode)
+			_, _ = io.Copy(c.Writer, response.Body)
+		})
+		recorder := httptest.NewRecorder()
+		engine.ServeHTTP(recorder, httptest.NewRequest(http.MethodPost, "/v1/messages", nil))
+		provider.Close()
+		if recorder.Code != 200 || recorder.Body.String() != "data: synthetic-provider-terminal\n\n" || providerCalls != 1 {
+			t.Fatal("provider response or call count changed")
+		}
+		var metrics []dispatchtiming.Metric
+		if json.Unmarshal([]byte(recorder.Header().Get(dispatchtiming.Header)), &metrics) != nil {
+			t.Fatal("missing timing header")
+		}
+		want := 6
+		if legacy {
+			want = 2
+		}
+		if len(metrics) != want {
+			t.Fatalf("stages=%v, want %d", metrics, want)
+		}
+		count := 0
+		for _, command := range commands.All() {
+			if strings.EqualFold(command[0], "RPOP") {
+				count++
+			}
+		}
+		if count != 1 {
+			t.Fatal("dispatch replayed")
+		}
+	}
+}
+
+func TestBasaltNodeDispatchTimingInvalidTrailerPreservesPrimary(t *testing.T) {
+	for _, trailer := range []string{"private-sentinel", `[{"stage":"selection","duration_ms":1,"outcome":"ok","private":"sentinel"}]`, `[{"stage":"selection","outcome":"ok"}]`, `[{"stage":"selection","duration_ms":null,"outcome":"ok"}]`, `[{"stage":"private-stage","duration_ms":1,"outcome":"ok"}]`, `[{"stage":"selection","duration_ms":1,"outcome":"ok"},{"stage":"selection","duration_ms":1,"outcome":"ok"}]`, strings.Repeat("x", 2049)} {
+		ctx, collector := dispatchtiming.WithCollector(context.Background())
+		raw, err := dispatchtiming.DecodeReply(ctx, []any{"primary", trailer})
+		if err != nil || string(raw) != "primary" || len(collector.JSON()) != 0 {
+			t.Fatal("invalid diagnostic altered dispatch or escaped projection")
+		}
+	}
+}
