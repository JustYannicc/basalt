+)
+
+func TestBasaltNodeDispatchTimingHeaderHandlerContext(t *testing.T) {
+	server := newTestServer(t)
+	server.engine.POST("/synthetic-timing", func(c *gin.Context) {
+		ctx, cancel := server.handlers.GetContextWithCancel(nil, c, context.Background())
+		defer cancel()
+		dispatchtiming.Observe(ctx, dispatchtiming.Ping, time.Now(), nil)
+		c.Header(dispatchtiming.Header, "private-provider-sentinel")
+		c.String(200, "synthetic-provider-response")
+	})
+	response := httptest.NewRecorder()
+	server.engine.ServeHTTP(response, httptest.NewRequest(http.MethodPost, "/synthetic-timing", nil))
+	value := response.Header().Get(dispatchtiming.Header)
+	if response.Code != 200 || response.Body.String() != "synthetic-provider-response" || !strings.Contains(value, `"stage":"ping"`) || strings.Contains(value, "private-") {
+		t.Fatalf("timing context/header handoff failed: %q", value)
+	}
+}
