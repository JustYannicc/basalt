diff --git a/internal/dispatchtiming/header.go b/internal/dispatchtiming/header.go
new file mode 100644
--- /dev/null
+++ b/internal/dispatchtiming/header.go
@@ -0,0 +1,205 @@
+package dispatchtiming
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"sync"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/redis/go-redis/v9"
+)
+
+const Header = "X-Signalbox-Pool-Dispatch-Timing"
+
+type Metric struct {
+	Stage      Stage  `json:"stage"`
+	DurationMS int64  `json:"duration_ms"`
+	Outcome    string `json:"outcome"`
+}
+type collectorKey struct{}
+type Collector struct {
+	mu      sync.Mutex
+	metrics map[Stage]Metric
+}
+
+var stages = []Stage{"authenticate", "selection", "admission", "reply_write", Ping, RPop}
+
+func WithCollector(ctx context.Context) (context.Context, *Collector) {
+	c := &Collector{metrics: make(map[Stage]Metric)}
+	return context.WithValue(ctx, collectorKey{}, c), c
+}
+func FromContext(ctx context.Context) *Collector {
+	if ctx == nil {
+		return nil
+	}
+	c, _ := ctx.Value(collectorKey{}).(*Collector)
+	return c
+}
+func Inherit(ctx, source context.Context) context.Context {
+	if c := FromContext(source); c != nil {
+		return context.WithValue(ctx, collectorKey{}, c)
+	}
+	return ctx
+}
+func (c *Collector) Record(stage Stage, duration time.Duration, err error) {
+	if c == nil {
+		return
+	}
+	outcome := "ok"
+	if err != nil {
+		outcome = "error"
+		var timeout net.Error
+		if errors.Is(err, context.DeadlineExceeded) || errors.As(err, &timeout) && timeout.Timeout() {
+			outcome = "timeout"
+		} else if errors.Is(err, context.Canceled) {
+			outcome = "cancelled"
+		}
+	}
+	ms := duration.Milliseconds()
+	if ms < 0 {
+		ms = 0
+	}
+	if ms > 86400000 {
+		ms = 86400000
+	}
+	c.add(Metric{stage, ms, outcome})
+}
+func (c *Collector) add(metric Metric) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	previous := c.metrics[metric.Stage]
+	metric.DurationMS += previous.DurationMS
+	if metric.DurationMS > 86400000 {
+		metric.DurationMS = 86400000
+	}
+	if previous.Outcome != "" && previous.Outcome != "ok" {
+		metric.Outcome = previous.Outcome
+	}
+	c.metrics[metric.Stage] = metric
+}
+func (c *Collector) JSON() []byte {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	metrics := make([]Metric, 0, 6)
+	for _, stage := range stages {
+		if metric, ok := c.metrics[stage]; ok {
+			metrics = append(metrics, metric)
+		}
+	}
+	if len(metrics) == 0 {
+		return nil
+	}
+	payload, _ := json.Marshal(metrics)
+	return payload
+}
+func Observe(ctx context.Context, stage Stage, started time.Time, err error) {
+	FromContext(ctx).Record(stage, time.Since(started), err)
+	Record(stage, started, err)
+}
+func collectTrailer(ctx context.Context, raw string) {
+	c := FromContext(ctx)
+	if c == nil || len(raw) > 2048 {
+		return
+	}
+	var records []struct {
+		Stage      Stage  `json:"stage"`
+		DurationMS *int64 `json:"duration_ms"`
+		Outcome    string `json:"outcome"`
+	}
+	decoder := json.NewDecoder(bytes.NewBufferString(raw))
+	decoder.DisallowUnknownFields()
+	if decoder.Decode(&records) != nil || len(records) > 4 || decoder.Decode(new(any)) != io.EOF {
+		return
+	}
+	seen := make(map[Stage]bool)
+	metrics := make([]Metric, 0, len(records))
+	for _, record := range records {
+		if record.DurationMS == nil {
+			return
+		}
+		metric := Metric{record.Stage, *record.DurationMS, record.Outcome}
+		switch metric.Stage {
+		case "authenticate", "selection", "admission", "reply_write":
+		default:
+			return
+		}
+		switch metric.Outcome {
+		case "ok", "error", "timeout", "cancelled":
+		default:
+			return
+		}
+		if seen[metric.Stage] || metric.DurationMS < 0 || metric.DurationMS > 86400000 {
+			return
+		}
+		seen[metric.Stage] = true
+		metrics = append(metrics, metric)
+	}
+	for _, metric := range metrics {
+		c.add(metric)
+	}
+}
+
+// Legacy Home replies have no envelope. Diagnostics never turn a complete primary reply into a retry.
+func DecodeReply(ctx context.Context, value any) ([]byte, error) {
+	if reply, ok := value.([]any); ok {
+		if len(reply) != 2 {
+			return nil, errors.New("home: invalid dispatch timing envelope")
+		}
+		if trailer, ok := reply[1].(string); ok {
+			collectTrailer(ctx, trailer)
+		}
+		value = reply[0]
+	}
+	switch reply := value.(type) {
+	case string:
+		return []byte(reply), nil
+	case []byte:
+		return reply, nil
+	case nil:
+		return nil, redis.Nil
+	case error:
+		return nil, reply
+	default:
+		return nil, errors.New("home: invalid dispatch response")
+	}
+}
+
+type responseWriter struct {
+	gin.ResponseWriter
+	collector *Collector
+	prepared  bool
+}
+
+func (w *responseWriter) prepare() {
+	if w.prepared {
+		return
+	}
+	w.prepared = true
+	w.Header().Del(Header)
+	if value := w.collector.JSON(); len(value) > 0 {
+		w.Header().Set(Header, string(value))
+	}
+}
+func (w *responseWriter) WriteHeaderNow()             { w.prepare(); w.ResponseWriter.WriteHeaderNow() }
+func (w *responseWriter) Write(p []byte) (int, error) { w.prepare(); return w.ResponseWriter.Write(p) }
+func (w *responseWriter) WriteString(p string) (int, error) {
+	w.prepare()
+	return w.ResponseWriter.WriteString(p)
+}
+func (w *responseWriter) Flush() { w.prepare(); w.ResponseWriter.Flush() }
+func Middleware() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		ctx, collector := WithCollector(c.Request.Context())
+		c.Request = c.Request.WithContext(ctx)
+		c.Writer = &responseWriter{ResponseWriter: c.Writer, collector: collector}
+		c.Next()
+		if !c.Writer.Written() {
+			c.Writer.WriteHeaderNow()
+		}
+	}
+}
