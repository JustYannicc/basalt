+package logging
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/diagnostics"
+	log "github.com/sirupsen/logrus"
+)
+
+type privateAppLogFormatter struct{ calls int }
+
+func (f *privateAppLogFormatter) Format(entry *log.Entry) ([]byte, error) {
+	f.calls++
+	return []byte(entry.Message + " formatted-private-sentinel"), nil
+}
+
+func TestMetadataOnlyAppLogForwarderProjectsBeforeQueueAndFormatting(t *testing.T) {
+	t.Setenv(diagnostics.MetadataOnlyEnv, "1")
+	client := &stubHomeAppLogClient{heartbeatOK: true}
+	formatter := &privateAppLogFormatter{}
+	forwarder := &HomeAppLogForwarder{formatter: formatter, queue: make(chan homeAppLogPayload, 1)}
+	forwarder.enabled.Store(true)
+	forwarder.bind(client)
+	entry := log.NewEntry(log.New())
+	entry.Time = time.Date(2026, 10, 29, 12, 0, 0, 0, time.UTC)
+	entry.Level = log.WarnLevel
+	// This is the response-bearing warning shape used by the Devin stream path.
+	entry.Message = "devin executor: trailer error (7): private-response-sentinel"
+	entry.Data = log.Fields{"request_id": "private-token-sentinel", "error": "private-header-sentinel"}
+	if errFire := forwarder.Fire(entry); errFire != nil {
+		t.Fatal(errFire)
+	}
+	var queued homeAppLogPayload
+	select {
+	case queued = <-forwarder.queue:
+	default:
+		t.Fatal("application log count was dropped")
+	}
+	if queued.Line != `POOL_APP_LOG {"count":1}` || queued.Level != "warn" || queued.RequestID != "" {
+		t.Fatal("queued app log was not a closed metadata projection")
+	}
+	if formatter.calls != 0 {
+		t.Fatal("private-mode logging invoked the response-bearing formatter")
+	}
+	forwarder.forward(queued)
+	if client.pushedCount() != 1 {
+		t.Fatal("metadata count did not reach the Home client")
+	}
+	wire := client.pushedAt(0)
+	if strings.Contains(string(wire), "sentinel") {
+		t.Fatal("app-log forwarding retained private response or credential text")
+	}
+	var fields map[string]any
+	if errDecode := json.Unmarshal(wire, &fields); errDecode != nil || len(fields) != 3 || fields["timestamp"] != "2026-10-29T12:00:00Z" {
+		t.Fatal("app-log wire metadata has unexpected fields")
+	}
+	entry.Data["request_id"] = "a1b2c3d4"
+	if errFire := forwarder.Fire(entry); errFire != nil {
+		t.Fatal(errFire)
+	}
+	if correlated := <-forwarder.queue; correlated.RequestID != "a1b2c3d4" {
+		t.Fatal("generated request correlation was lost")
+	}
+}
