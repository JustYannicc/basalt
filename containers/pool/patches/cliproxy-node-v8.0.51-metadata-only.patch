diff --git a/internal/diagnostics/metadata_only.go b/internal/diagnostics/metadata_only.go
new file mode 100644
index 00000000..44e006db
--- /dev/null
+++ b/internal/diagnostics/metadata_only.go
@@ -0,0 +1,90 @@
+package diagnostics
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"os"
+	"strings"
+
+	"github.com/google/uuid"
+)
+
+// MetadataOnlyEnv opts the process into metadata-only diagnostics when set to 1.
+const MetadataOnlyEnv = "CLIPROXY_DIAGNOSTICS_METADATA_ONLY"
+
+// MetadataOnlyEnabled reads the opt-in each time so callers can use it before
+// configuration is loaded and config reloads cannot bypass the mode.
+func MetadataOnlyEnabled() bool {
+	return strings.TrimSpace(os.Getenv(MetadataOnlyEnv)) == "1"
+}
+
+// FingerprintAPIKey returns a stable fingerprint without retaining the raw key.
+func FingerprintAPIKey(apiKey string) string {
+	apiKey = strings.TrimSpace(apiKey)
+	if apiKey == "" {
+		return ""
+	}
+	sum := sha256.Sum256([]byte(apiKey))
+	return "sha256:" + hex.EncodeToString(sum[:])
+}
+
+// FailureClassification maps HTTP status to a closed diagnostic vocabulary.
+func FailureClassification(status int) (string, string) {
+	switch status {
+	case 400:
+		return "invalid_request", "http_400"
+	case 401:
+		return "unauthorized", "http_401"
+	case 403:
+		return "permission_denied", "http_403"
+	case 404:
+		return "not_found", "http_404"
+	case 408:
+		return "timeout", "http_408"
+	case 429:
+		return "rate_limit", "http_429"
+	case 504:
+		return "timeout", "http_504"
+	default:
+		if status >= 500 && status <= 599 {
+			return "upstream", "http_5xx"
+		}
+		return "unknown", "unknown"
+	}
+}
+
+// SafeRequestID accepts only canonical UUIDs, which are the generated IDs used
+// by execution and inbound request paths.
+func SafeRequestID(value string) string {
+	value = strings.TrimSpace(value)
+	id, err := uuid.Parse(value)
+	if err != nil || id.String() != value || id.Version() != 4 {
+		return ""
+	}
+	return value
+}
+
+// SafeTraceID accepts generated UUIDs and the legacy eight-character hex trace.
+func SafeTraceID(value string) string {
+	value = strings.TrimSpace(value)
+	if id, err := uuid.Parse(value); err == nil && id.String() == value && id.Version() == 7 {
+		return value
+	}
+	if len(value) != 8 {
+		return ""
+	}
+	if _, err := hex.DecodeString(value); err != nil {
+		return ""
+	}
+	return strings.ToLower(value)
+}
+
+// SafeServiceTier keeps the finite billing tiers without retaining client text.
+func SafeServiceTier(value string) string {
+	switch strings.ToLower(strings.TrimSpace(value)) {
+	case "auto", "default", "standard", "flex", "priority", "fast":
+		return strings.ToLower(strings.TrimSpace(value))
+	default:
+		return ""
+	}
+}
diff --git a/internal/diagnostics/metadata_only_test.go b/internal/diagnostics/metadata_only_test.go
