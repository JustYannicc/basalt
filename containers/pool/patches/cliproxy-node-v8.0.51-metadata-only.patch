+func TestMetadataOnlyPreservesCanonicalSessionCorrelation(t *testing.T) {
+	for _, sessionID := range []string{
+		"7c9a1f40-209d-1b83-8f9c-eaef07268439",
+		"7c9a1f40-209d-3b83-8f9c-eaef07268439",
+		"7c9a1f40-209d-4b83-8f9c-eaef07268439",
+		"7c9a1f40-209d-5b83-8f9c-eaef07268439",
+		"7c9a1f40-209d-6b83-8f9c-eaef07268439",
+		"7c9a1f40-209d-7b83-8f9c-eaef07268439",
+		"7c9a1f40-209d-8b83-8f9c-eaef07268439",
+		"00000000-0000-0000-0000-000000000000",
+	} {
+		t.Run(sessionID, func(t *testing.T) {
+			ctx := internallogging.WithClientRequestMetadata(context.Background(), internallogging.ClientRequestMetadata{SessionID: "header:" + sessionID})
+			clean, record := RedactForMetadataOnly(ctx, Record{})
+			if record.SessionID != sessionID {
+				t.Fatal("canonical session was lost before the queue")
+			}
+			if internallogging.GetClientRequestMetadata(clean).SessionID != "" {
+				t.Fatal("original request metadata survived queue detachment")
+			}
+			_, repeated := RedactForMetadataOnly(clean, record)
+			if repeated.SessionID != sessionID {
+				t.Fatal("repeat projection lost the canonical session")
+			}
+		})
+	}
+	_, projected := RedactForMetadataOnly(context.Background(), Record{SessionID: "private-session-content-629"})
+	if projected.SessionID == "" || projected.SessionID == "private-session-content-629" {
+		t.Fatal("custom session was not projected to an opaque identifier")
+	}
+}
