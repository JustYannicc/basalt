+package middleware
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/diagnostics"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/logging"
+)
+
+func TestMetadataOnlyModeSkipsErrorOnlyRequestBodyFiles(t *testing.T) {
+	t.Setenv(diagnostics.MetadataOnlyEnv, "1")
+	gin.SetMode(gin.TestMode)
+	logsDir := t.TempDir()
+	logger := logging.NewFileRequestLogger(false, logsDir, "", 0)
+	engine := gin.New()
+	engine.Use(RequestLoggingMiddleware(logger))
+	engine.POST("/v1/chat/completions", func(c *gin.Context) {
+		c.Status(http.StatusBadRequest)
+	})
+
+	request := httptest.NewRequest(http.MethodPost, "/v1/chat/completions", strings.NewReader("sentinel-prompt-body-173"))
+	request.Header.Set("Authorization", "sentinel-auth-header-284")
+	response := httptest.NewRecorder()
+	engine.ServeHTTP(response, request)
+	if response.Code != http.StatusBadRequest {
+		t.Fatalf("response status = %d, want %d", response.Code, http.StatusBadRequest)
+	}
+	entries, err := os.ReadDir(logsDir)
+	if err != nil {
+		t.Fatalf("read request log directory: %v", err)
+	}
+	if len(entries) != 0 {
+		t.Fatalf("metadata-only request created diagnostic files: %s", filepath.Join(logsDir, entries[0].Name()))
+	}
+}
