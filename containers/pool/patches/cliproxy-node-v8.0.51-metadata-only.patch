+	received chan metadataOnlyCapture
+}
+
+func (p metadataOnlyCapturePlugin) HandleUsage(ctx context.Context, record Record) {
+	p.received <- metadataOnlyCapture{ctx: ctx, record: record}
+}
+
+func TestMetadataOnlyPublishDetachesContextAndKeepsSafeFields(t *testing.T) {
+	t.Setenv(diagnostics.MetadataOnlyEnv, "1")
+	gin.SetMode(gin.TestMode)
+
+	const (
+		clientID       = "metadata-only-account-1"
+		modelID        = "gpt-safe-diagnostic"
+		requestSecret  = "sentinel-request-body-984"
+		responseSecret = "sentinel-response-body-216"
+		headerSecret   = "sentinel-header-value-317"
+		authSecret     = "sentinel-auth-token-428"
+		freeTextSecret = "sentinel-provider-error-539"
+		rawAPIKey      = "  client-key-secret-640  "
+	)
+
+	modelRegistry := registry.GetGlobalRegistry()
+	modelRegistry.RegisterClient(clientID, "openai", []*registry.ModelInfo{{ID: modelID}})
+	t.Cleanup(func() { modelRegistry.UnregisterClient(clientID) })
+
+	requestID := "7c9a1f40-209d-4b83-8f9c-eaef07268439"
+	traceID := "018f3a5b-1234-7abc-def0-12345678abcd"
+	ginCtx, _ := gin.CreateTestContext(httptest.NewRecorder())
+	ginCtx.Request = httptest.NewRequest(http.MethodPost, "https://proxy.invalid/v1/chat/completions", strings.NewReader(requestSecret))
+	ginCtx.Request.Header.Set("Authorization", authSecret)
+	ginCtx.Request.Header.Set("X-Sentinel", headerSecret)
+	ginCtx.Set("userApiKey", rawAPIKey)
+	ctx := context.WithValue(context.Background(), "gin", ginCtx)
+	ctx = context.WithValue(ctx, metadataOnlyContextKey{}, freeTextSecret)
+	ctx = internallogging.WithRequestID(ctx, traceID)
+	ctx = WithExecutionRequestID(ctx, requestID)
+	ctx = WithAPIKey(ctx, rawAPIKey)
+	ctx = WithAccessProvider(ctx, freeTextSecret)
+	ctx = internallogging.WithEndpoint(ctx, requestSecret)
+	ctx = internallogging.WithClientRequestMetadata(ctx, internallogging.ClientRequestMetadata{
+		ClientIP: requestSecret, ResolvedClientIP: requestSecret, XForwardedFor: requestSecret,
+		UserAgent: requestSecret, SessionID: requestSecret, ParentSessionID: requestSecret,
+	})
+	ctx = internallogging.WithResponseStatusHolder(ctx)
+	internallogging.SetResponseStatus(ctx, http.StatusUnauthorized)
+	ctx = internallogging.WithResponseHeadersHolder(ctx)
+	internallogging.SetResponseHeaders(ctx, http.Header{"X-Sentinel": {headerSecret}, "Authorization": {authSecret}})
+
+	requestedAt := time.Date(2026, 10, 29, 10, 11, 12, 0, time.UTC)
+	responseHeaders := http.Header{"X-Sentinel": {headerSecret}, "Authorization": {authSecret}}
+	record := Record{
+		RequestID: requestID, TraceID: traceID, Provider: "openai", BaseURL: requestSecret,
+		ExecutorType: "OpenAIExecutor", Model: modelID, Alias: requestSecret,
+		APIKey: rawAPIKey, IsNativeKey: true, AccessProvider: freeTextSecret,
+		SessionID: requestSecret, ParentSessionID: requestSecret, AuthID: clientID,
+		AuthIndex: "account-42", AccessTokenSHA256: authSecret, AuthType: freeTextSecret,
+		Source: authSecret, ReasoningEffort: freeTextSecret, ServiceTier: freeTextSecret,
+		EffectiveServiceTier: freeTextSecret, RequestServiceTier: freeTextSecret,
+		ResponseServiceTier: freeTextSecret, ResponseModel: freeTextSecret,
+		Generate: GenerateFlag(true), Stream: true, RequestedAt: requestedAt,
+		Latency: 1350 * time.Millisecond, TTFT: 250 * time.Millisecond, Failed: true,
+		Fail:            Failure{StatusCode: http.StatusUnauthorized, Body: responseSecret, Type: requestSecret, Code: authSecret},
+		Detail:          Detail{InputTokens: 11, OutputTokens: 7, TotalTokens: 18, ResponseServiceTier: freeTextSecret},
+		ResponseHeaders: responseHeaders,
+	}
+
+	manager := NewManager(1)
+	defer manager.Stop()
+	received := make(chan metadataOnlyCapture, 1)
+	manager.Register(metadataOnlyCapturePlugin{received: received})
+	manager.Publish(ctx, record)
+
+	var got metadataOnlyCapture
+	select {
+	case got = <-received:
+	case <-time.After(time.Second):
+		t.Fatal("timed out waiting for sanitized usage record")
+	}
+
+	sum := sha256.Sum256([]byte(strings.TrimSpace(rawAPIKey)))
+	wantAPIKey := "sha256:" + hex.EncodeToString(sum[:])
+	if got.record.APIKey != wantAPIKey {
+		t.Fatalf("APIKey = %q, want fingerprint %q", got.record.APIKey, wantAPIKey)
+	}
+	if got.record.RequestID != requestID || got.record.TraceID != traceID {
+		t.Fatalf("request identifiers = %q/%q, want %q/%q", got.record.RequestID, got.record.TraceID, requestID, traceID)
+	}
+	if got.record.Provider != "openai" || got.record.Model != modelID || got.record.AuthID != clientID || got.record.AuthIndex != "account-42" {
+		t.Fatalf("trusted identities were not preserved: provider=%q model=%q auth=%q index=%q", got.record.Provider, got.record.Model, got.record.AuthID, got.record.AuthIndex)
+	}
+	if !got.record.RequestedAt.Equal(requestedAt) || got.record.Latency != 1350*time.Millisecond || got.record.TTFT != 250*time.Millisecond {
+		t.Fatalf("time and latency metadata changed: requested=%s latency=%s ttft=%s", got.record.RequestedAt, got.record.Latency, got.record.TTFT)
+	}
+	if got.record.Detail.InputTokens != 11 || got.record.Detail.OutputTokens != 7 || got.record.Detail.TotalTokens != 18 {
+		t.Fatalf("token counts changed: %+v", got.record.Detail)
+	}
+	if got.record.Fail.StatusCode != http.StatusUnauthorized || got.record.Fail.Type != "unauthorized" || got.record.Fail.Code != "http_401" || got.record.Fail.Body != "" {
+		t.Fatalf("failure metadata = %+v", got.record.Fail)
+	}
+	if got.record.BaseURL != "" || got.record.Alias != "" || got.record.Source != "" || got.record.AccessTokenSHA256 != "" || got.record.ResponseHeaders != nil || got.record.ResponseModel != "" || got.record.ResponseServiceTier != "" || got.record.Detail.ResponseServiceTier != "" {
+		t.Fatalf("sensitive record fields survived: %+v", got.record)
+	}
+	if got.ctx.Value(metadataOnlyContextKey{}) != nil || got.ctx.Value("gin") != nil || APIKeyFromContext(got.ctx) != "" || AccessProviderFromContext(got.ctx) != "" {
+		t.Fatal("original context values survived metadata-only publication")
+	}
+	if internallogging.GetEndpoint(got.ctx) != "" || internallogging.GetResponseHeaders(got.ctx) != nil || internallogging.GetClientRequestMetadata(got.ctx) != (internallogging.ClientRequestMetadata{}) {
+		t.Fatal("request or response metadata survived in detached context")
+	}
+	if internallogging.GetRequestID(got.ctx) != traceID || ExecutionRequestIDFromContext(got.ctx) != requestID {
+		t.Fatal("detached context lost safe generated identifiers")
+	}
+	_, redactedAgain := RedactForMetadataOnly(got.ctx, got.record)
+	if redactedAgain.APIKey != got.record.APIKey {
+		t.Fatalf("repeated queue-boundary sanitization changed client fingerprint from %q to %q", got.record.APIKey, redactedAgain.APIKey)
+	}
+	encoded, err := json.Marshal(got.record)
+	if err != nil {
+		t.Fatalf("marshal sanitized record: %v", err)
+	}
+	for _, secret := range []string{requestSecret, responseSecret, headerSecret, authSecret, freeTextSecret, rawAPIKey} {
+		if strings.Contains(string(encoded), secret) {
+			t.Fatalf("sanitized record contains %q: %s", secret, encoded)
+		}
+	}
+
+	_, unknownModel := RedactForMetadataOnly(context.Background(), Record{
+		RequestID: requestID, Provider: "openai", AuthID: clientID, Model: requestSecret,
+	})
+	if unknownModel.Model != "" {
+		t.Fatalf("unregistered model survived sanitization: %q", unknownModel.Model)
+	}
+}
