--- /dev/null
+++ b/internal/diagnostics/metadata_only_test.go
@@ -0,0 +1,75 @@
+package diagnostics
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"testing"
+)
+
+func TestMetadataOnlyEnabledUsesExplicitOptIn(t *testing.T) {
+	for _, value := range []string{"", "true", "0"} {
+		t.Setenv(MetadataOnlyEnv, value)
+		if MetadataOnlyEnabled() {
+			t.Fatalf("MetadataOnlyEnabled() = true for %q", value)
+		}
+	}
+	t.Setenv(MetadataOnlyEnv, "1")
+	if !MetadataOnlyEnabled() {
+		t.Fatal("MetadataOnlyEnabled() = false for opt-in value")
+	}
+}
+
+func TestFingerprintAPIKeyHashesTrimmedValueWithoutTrustingPrefixes(t *testing.T) {
+	key := "  raw-client-key  "
+	sum := sha256.Sum256([]byte("raw-client-key"))
+	want := "sha256:" + hex.EncodeToString(sum[:])
+	if got := FingerprintAPIKey(key); got != want {
+		t.Fatalf("FingerprintAPIKey() = %q, want %q", got, want)
+	}
+	prefixedKeySum := sha256.Sum256([]byte(want))
+	wantPrefixedKey := "sha256:" + hex.EncodeToString(prefixedKeySum[:])
+	if got := FingerprintAPIKey(" " + want + " "); got != wantPrefixedKey {
+		t.Fatalf("FingerprintAPIKey() on raw key with a fingerprint-like prefix = %q, want %q", got, wantPrefixedKey)
+	}
+}
+
+func TestFailureClassificationIsClosed(t *testing.T) {
+	tests := []struct {
+		status int
+		typ    string
+		code   string
+	}{
+		{400, "invalid_request", "http_400"},
+		{401, "unauthorized", "http_401"},
+		{403, "permission_denied", "http_403"},
+		{404, "not_found", "http_404"},
+		{408, "timeout", "http_408"},
+		{429, "rate_limit", "http_429"},
+		{504, "timeout", "http_504"},
+		{503, "upstream", "http_5xx"},
+		{422, "unknown", "unknown"},
+	}
+	for _, test := range tests {
+		typ, code := FailureClassification(test.status)
+		if typ != test.typ || code != test.code {
+			t.Errorf("FailureClassification(%d) = %q/%q, want %q/%q", test.status, typ, code, test.typ, test.code)
+		}
+	}
+}
+
+func TestSafeIDsAcceptGeneratedVersionsOnly(t *testing.T) {
+	requestID := "7c9a1f40-209d-4b83-8f9c-eaef07268439"
+	traceID := "018f3a5b-1234-7abc-def0-12345678abcd"
+	if got := SafeRequestID(requestID); got != requestID {
+		t.Fatalf("SafeRequestID() = %q, want %q", got, requestID)
+	}
+	if got := SafeTraceID(traceID); got != traceID {
+		t.Fatalf("SafeTraceID() = %q, want %q", got, traceID)
+	}
+	if got := SafeRequestID(traceID); got != "" {
+		t.Fatalf("SafeRequestID() accepted non-execution UUID: %q", got)
+	}
+	if got := SafeTraceID("not-a-generated-id"); got != "" {
+		t.Fatalf("SafeTraceID() accepted arbitrary text: %q", got)
+	}
+}
