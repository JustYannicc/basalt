@@ -0,0 +1,36 @@
+package logging
+
+import (
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/diagnostics"
+	log "github.com/sirupsen/logrus"
+)
+
+func (f *HomeAppLogForwarder) entryPayload(entry *log.Entry) (homeAppLogPayload, error) {
+	payload := homeAppLogPayload{
+		Level: entry.Level.String(), Timestamp: entry.Time.Format(time.RFC3339Nano),
+		RequestID: appLogRequestID(entry),
+	}
+	if !diagnostics.MetadataOnlyEnabled() {
+		line, errFormat := f.formatEntry(entry)
+		payload.Line = line
+		return payload, errFormat
+	}
+	// Never format the response-bearing message or copy its attached fields.
+	payload.Line = `POOL_APP_LOG {"count":1}`
+	switch entry.Level {
+	case log.PanicLevel, log.FatalLevel, log.ErrorLevel, log.InfoLevel, log.DebugLevel, log.TraceLevel:
+		payload.Level = entry.Level.String()
+	case log.WarnLevel:
+		payload.Level = "warn"
+	default:
+		payload.Level = "unknown"
+	}
+	requestID := diagnostics.SafeRequestID(payload.RequestID)
+	if requestID == "" {
+		requestID = diagnostics.SafeTraceID(payload.RequestID)
+	}
+	payload.RequestID = requestID
+	return payload, nil
+}
