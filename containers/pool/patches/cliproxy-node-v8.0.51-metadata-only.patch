@@ -0,0 +1,34 @@
+package usage
+
+import "github.com/router-for-me/CLIProxyAPI/v8/internal/diagnostics"
+
+// Provider detail objects can contain free-form strings and map keys alongside counters.
+func metadataOnlyDetail(detail Detail) Detail {
+	detail.ResponseServiceTier = diagnostics.SafeServiceTier(detail.ResponseServiceTier)
+	detail.UpstreamServiceTier = diagnostics.SafeServiceTier(detail.UpstreamServiceTier)
+	detail.Speed = ""
+	detail.InferenceGeo = ""
+	detail.RequestedImageDetails = nil
+	detail.ImageDetails = nil
+	detail.Iterations = nil
+	if detail.CacheDetails != nil {
+		cache := detail.CacheDetails.Clone()
+		cache.Mode, cache.TTL, cache.Retention = "", "", ""
+		cache.ByTTL = nil
+		for _, ttl := range []string{"5m", "30m", "1h", "12h"} {
+			if count, ok := detail.CacheDetails.ByTTL[ttl]; ok {
+				if cache.ByTTL == nil {
+					cache.ByTTL = make(map[string]int64)
+				}
+				cache.ByTTL[ttl] = count
+			}
+		}
+		detail.CacheDetails = cache
+	}
+	if detail.ToolUsageDetails != nil {
+		tools := detail.ToolUsageDetails.Clone()
+		tools.Extra = nil
+		detail.ToolUsageDetails = tools
+	}
+	return detail
+}
