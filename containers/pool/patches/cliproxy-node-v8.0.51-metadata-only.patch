diff --git a/sdk/cliproxy/usage/metadata_only.go b/sdk/cliproxy/usage/metadata_only.go
new file mode 100644
index 00000000..0b1f50d2
--- /dev/null
+++ b/sdk/cliproxy/usage/metadata_only.go
@@ -0,0 +1,212 @@
+package usage
+
+import (
+	"context"
+	"math"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/diagnostics"
+	internallogging "github.com/router-for-me/CLIProxyAPI/v8/internal/logging"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/session"
+)
+
+type metadataOnlySanitizedContextKey struct{}
+
+// DiagnosticSessionID keeps only the canonical opaque identity used by usage lookup.
+func DiagnosticSessionID(value string) string {
+	return session.NormalizeToCanonicalUUID(value)
+}
+
+type selectedModelContextKey struct{}
+
+type selectedModel struct {
+	accountID string
+	model     string
+}
+
+// WithSelectedModel binds the model authorized by Home's credential selection.
+// Callers must supply the selected upstream model, never the client model text.
+func WithSelectedModel(ctx context.Context, accountID, model string) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	return context.WithValue(ctx, selectedModelContextKey{}, selectedModel{strings.TrimSpace(accountID), strings.TrimSpace(model)})
+}
+
+// DiagnosticModelAllowed accepts a local model or the model selected by Home.
+func DiagnosticModelAllowed(ctx context.Context, provider, accountID, model string) bool {
+	if ctx != nil {
+		if selected, ok := ctx.Value(selectedModelContextKey{}).(selectedModel); ok && selected.accountID != "" &&
+			selected.accountID == strings.TrimSpace(accountID) && selected.model != "" && strings.EqualFold(selected.model, strings.TrimSpace(model)) {
+			return true
+		}
+	}
+	return RegisteredModel(provider, accountID, model)
+}
+
+// RegisteredModel reports whether model is present in the live registry for
+// this account or provider. User supplied model text is omitted when it is not.
+func RegisteredModel(provider, accountID, model string) bool {
+	model = strings.TrimSpace(model)
+	if model == "" {
+		return false
+	}
+	models := registry.GetGlobalRegistry()
+	if strings.TrimSpace(accountID) != "" && models.ClientSupportsModel(accountID, model) {
+		return true
+	}
+	for _, info := range models.GetAvailableModelsByProvider(provider) {
+		if info != nil && strings.EqualFold(strings.TrimSpace(info.ID), model) {
+			return true
+		}
+	}
+	return false
+}
+
+// RedactForMetadataOnly copies only the fields needed by usage diagnostics and
+// returns a detached context containing generated request IDs only.
+func RedactForMetadataOnly(ctx context.Context, record Record) (context.Context, Record) {
+	if ctx != nil {
+		if sanitized, _ := ctx.Value(metadataOnlySanitizedContextKey{}).(bool); sanitized {
+			return ctx, record
+		}
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if strings.TrimSpace(record.APIKey) == "" {
+		record.APIKey = APIKeyFromContext(ctx)
+	}
+	record.APIKey = diagnostics.FingerprintAPIKey(record.APIKey)
+
+	if diagnostics.SafeRequestID(record.RequestID) == "" {
+		record.RequestID = diagnostics.SafeRequestID(ExecutionRequestIDFromContext(ctx))
+	}
+	if record.RequestID == "" {
+		record.RequestID = uuid.NewString()
+	}
+	record.TraceID = diagnostics.SafeTraceID(record.TraceID)
+	if record.TraceID == "" {
+		record.TraceID = diagnostics.SafeTraceID(TraceIDFromContext(ctx))
+	}
+	if record.TraceID == "" {
+		record.TraceID = diagnostics.SafeTraceID(internallogging.GetRequestID(ctx))
+	}
+	if record.TraceID == "" {
+		record.TraceID = record.RequestID
+	}
+	if record.RequestedAt.IsZero() {
+		record.RequestedAt = time.Now()
+	}
+
+	contextStatus := internallogging.GetResponseStatus(ctx)
+	if contextStatus >= 400 {
+		record.Failed = true
+		if record.Fail.StatusCode < 400 {
+			record.Fail.StatusCode = contextStatus
+		}
+	}
+	if record.Fail.StatusCode >= 400 {
+		record.Failed = true
+	}
+	if record.Failed {
+		status := record.Fail.StatusCode
+		if status < 400 {
+			status = contextStatus
+		}
+		if status < 400 {
+			status = 500
+		}
+		failureType, failureCode := diagnostics.FailureClassification(status)
+		if record.Fail.Code == FailureStreamTruncatedCode {
+			failureCode = FailureStreamTruncatedCode
+		}
+		record.Fail = Failure{StatusCode: status, Type: failureType, Code: failureCode}
+	} else {
+		record.Fail = Failure{}
+	}
+
+	record.Provider = strings.TrimSpace(record.Provider)
+	record.ExecutorType = strings.TrimSpace(record.ExecutorType)
+	if DiagnosticModelAllowed(ctx, record.Provider, record.AuthID, record.Model) {
+		record.Model = strings.TrimSpace(record.Model)
+	} else {
+		record.Model = ""
+	}
+	record.Alias = ""
+	record.BaseURL = ""
+	record.Source = ""
+	record.AuthType = safeAuthType(record.AuthType)
+	record.AccessProvider = ""
+	record.AccessTokenSHA256 = ""
+	if record.SessionID == "" {
+		record.SessionID = internallogging.GetClientRequestMetadata(ctx).SessionID
+	}
+	record.SessionID = DiagnosticSessionID(record.SessionID)
+	record.ParentSessionID = ""
+	record.ReasoningEffort = ""
+	record.ServiceTier = diagnostics.SafeServiceTier(record.ServiceTier)
+	record.EffectiveServiceTier = diagnostics.SafeServiceTier(record.EffectiveServiceTier)
+	record.RequestServiceTier = ""
+	record.ResponseServiceTier = diagnostics.SafeServiceTier(record.ResponseServiceTier)
+	record.ResponseModel = ""
+	record.ResponseHeaders = safeQuotaHeaders(record.Provider, record.ResponseHeaders)
+	record.Detail = metadataOnlyDetail(record.Detail)
+	record.Detail = EnsureTokenBreakdownForProvider(record.Detail, record.Provider, record.ExecutorType)
+	record.IsNativeKey = false
+	if record.Generate != nil {
+		generate := *record.Generate
+		record.Generate = &generate
+	}
+
+	cleanCtx := context.WithValue(context.Background(), metadataOnlySanitizedContextKey{}, true)
+	cleanCtx = internallogging.WithRequestID(cleanCtx, record.TraceID)
+	cleanCtx = WithExecutionRequestID(cleanCtx, record.RequestID)
+	return cleanCtx, record
+}
+
+// Keep only numeric Codex quota measurements. Labels and arbitrary headers are omitted.
+func safeQuotaHeaders(provider string, headers http.Header) http.Header {
+	if provider != "codex" {
+		return nil
+	}
+	out := make(http.Header)
+	for key, values := range headers {
+		key = http.CanonicalHeaderKey(key)
+		if !strings.HasPrefix(key, "X-Codex-Primary-") && !strings.HasPrefix(key, "X-Codex-Secondary-") {
+			continue
+		}
+		numeric := false
+		for _, suffix := range []string{"-Used-Percent", "-Window-Minutes", "-Reset-At", "-Reset-After-Seconds"} {
+			if key == "X-Codex-Primary"+suffix || key == "X-Codex-Secondary"+suffix {
+				numeric = true
+			}
+		}
+		if !numeric || len(values) != 1 || len(values[0]) > 32 {
+			continue
+		}
+		value, err := strconv.ParseFloat(values[0], 64)
+		if err != nil || math.IsNaN(value) || math.IsInf(value, 0) || value < 0 {
+			continue
+		}
+		out.Set(key, strconv.FormatFloat(value, 'f', -1, 64))
+	}
+	if len(out) == 0 {
+		return nil
+	}
+	return out
+}
+
+func safeAuthType(value string) string {
+	switch value {
+	case "oauth", "api_key", "provider_api_key", "file_auth", "vertex":
+		return value
+	default:
+		return ""
+	}
+}
diff --git a/sdk/cliproxy/usage/metadata_only_detail.go b/sdk/cliproxy/usage/metadata_only_detail.go
