+package api
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	proxyconfig "github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/diagnostics"
+	sdkaccess "github.com/router-for-me/CLIProxyAPI/v8/sdk/access"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	sdkconfig "github.com/router-for-me/CLIProxyAPI/v8/sdk/config"
+)
+
+func TestMetadataOnlyConfigIsForcedAtStartupAndReload(t *testing.T) {
+	t.Setenv(diagnostics.MetadataOnlyEnv, "1")
+	gin.SetMode(gin.TestMode)
+
+	tmpDir := t.TempDir()
+	authDir := filepath.Join(tmpDir, "auth")
+	if err := os.MkdirAll(authDir, 0700); err != nil {
+		t.Fatalf("create auth dir: %v", err)
+	}
+	newConfig := func() *proxyconfig.Config {
+		return &proxyconfig.Config{
+			SDKConfig:      sdkconfig.SDKConfig{APIKeys: []string{"test-key"}, RequestLog: true},
+			AuthDir:        authDir,
+			Debug:          true,
+			CommercialMode: false,
+			LoggingToFile:  true,
+		}
+	}
+
+	server := NewServer(newConfig(), auth.NewManager(nil, nil, nil), sdkaccess.NewManager(), filepath.Join(tmpDir, "config.yaml"))
+	assertMetadataOnlyServerConfig(t, server)
+	if server.requestLogger != nil {
+		t.Fatal("metadata-only startup created a request logger")
+	}
+	if !server.UpdateClientsContext(context.Background(), newConfig()) {
+		t.Fatal("UpdateClientsContext() rejected metadata-only reload")
+	}
+	assertMetadataOnlyServerConfig(t, server)
+}
+
+func assertMetadataOnlyServerConfig(t *testing.T, server *Server) {
+	t.Helper()
+	server.cfgMu.RLock()
+	cfg := server.cfg
+	server.cfgMu.RUnlock()
+	if cfg == nil || !cfg.CommercialMode || cfg.RequestLog || cfg.Debug || cfg.LoggingToFile {
+		t.Fatalf("effective server config = %+v, want metadata-only settings", cfg)
+	}
+}
