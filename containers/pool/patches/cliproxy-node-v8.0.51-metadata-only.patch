+func TestMetadataOnlyRedactsExpandedUsageDetails(t *testing.T) {
+	const secret = "expanded-provider-response-sentinel"
+	detail := Detail{
+		InputTokens: 13, OutputTokens: 5, TotalTokens: 18,
+		ResponseServiceTier: "priority", UpstreamServiceTier: secret,
+		Speed: secret, InferenceGeo: secret,
+		CacheDetails: &CacheDetails{Mode: secret, TTL: secret, Retention: secret,
+			Ephemeral5mInputTokens: Int64Ptr(7), ByTTL: map[string]int64{secret: 9, "5m": 7}},
+		ImageDetails: &ImageDetails{Size: secret}, RequestedImageDetails: &ImageDetails{MimeType: secret},
+		ToolUsageDetails: &ToolUsageDetails{WebSearchCalls: Int64Ptr(2), Extra: map[string]int64{secret: 3}},
+		Iterations:       &[]IterationUsage{{Type: secret, Model: secret}},
+	}
+	_, record := RedactForMetadataOnly(context.Background(), Record{Detail: detail})
+	raw, errMarshal := json.Marshal(record)
+	if errMarshal != nil {
+		t.Fatal(errMarshal)
+	}
+	if strings.Contains(string(raw), secret) {
+		t.Fatal("expanded usage details retained provider response text")
+	}
+	if record.Detail.InputTokens != 13 || record.Detail.OutputTokens != 5 || record.Detail.TotalTokens != 18 ||
+		record.Detail.ResponseServiceTier != "priority" || record.Detail.CacheDetails.ByTTL["5m"] != 7 ||
+		*record.Detail.CacheDetails.Ephemeral5mInputTokens != 7 || *record.Detail.ToolUsageDetails.WebSearchCalls != 2 {
+		t.Fatal("metadata projection lost counters or the closed billing tier")
+	}
+	if detail.CacheDetails.ByTTL[secret] != 9 || detail.ToolUsageDetails.Extra[secret] != 3 {
+		t.Fatal("metadata projection mutated the provider's original usage detail")
+	}
+}
