+package cluster
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"sync"
+	"testing"
+	"time"
+
+	"gorm.io/gorm"
+	"gorm.io/gorm/logger"
+)
+
+func TestUsageCreditFundingReadSQLBudgetAndParity(t *testing.T) {
+	for _, backend := range []struct {
+		name string
+		open func(*testing.T) *Repository
+	}{
+		{"sqlite", newCredentialFoundationTestRepository},
+		{"postgres", newPostgresQuiescenceRepository},
+	} {
+		t.Run(backend.name, func(t *testing.T) {
+			repo := backend.open(t)
+			now := time.Date(2026, 11, 12, 0, 0, 0, 0, time.UTC)
+			seedFundingReadFixture(t, repo, now)
+			for _, ids := range []map[string]struct{}{nil, {}, {"funding-plan": {}}, {"funding-missing": {}, "funding-absent": {}}, {"funding-deleted": {}}} {
+				old, errOld := repo.loadQuotaCredentials(t.Context(), now, ids, true)
+				if errOld != nil {
+					t.Fatal(errOld)
+				}
+				counter := &lifecycleSQLCounter{Interface: logger.Default.LogMode(logger.Silent)}
+				counted := NewRepository(repo.db.Session(&gorm.Session{Logger: counter}))
+				got, errRead := counted.loadFundingCredentials(t.Context(), now, ids)
+				if errRead != nil {
+					t.Fatal(errRead)
+				}
+				if count := counter.statements.Load(); count != 1 {
+					t.Fatalf("funding read SQL statements=%d, want 1", count)
+				}
+				if !reflect.DeepEqual(got, old) {
+					t.Fatalf("joined funding snapshot differs from existing loader: got %d, want %d", len(got), len(old))
+				}
+				for index, item := range got {
+					for _, model := range []string{"claude-opus-5-5", "claude-sonnet-5-5", "gpt-6.1-sol", "gpt-6.1-spark"} {
+						if usageCreditFundingTier(item, model, now) != usageCreditFundingTier(old[index], model, now) {
+							t.Fatal("funding tier changed")
+						}
+					}
+				}
+			}
+		})
+	}
+}
+
+func seedFundingReadFixture(t *testing.T, repo *Repository, now time.Time) {
+	t.Helper()
+	before, after := now.Add(-time.Minute), now.Add(time.Minute)
+	positive, zero := .5, 0.0
+	for _, id := range []string{"funding-plan", "funding-stale", "funding-missing", "funding-credits", "funding-disabled", "funding-deleted", "funding-legacy", "funding-no-windows"} {
+		seedQuotaSnapshotAuth(t, repo, id, "claude", id, map[string]any{"type": "claude", "auth_kind": "oauth"})
+		if id == "funding-missing" {
+			continue
+		}
+		snapshot := QuotaSnapshotRecord{CredentialID: id, QuotaStatus: "healthy", CollectionStatus: "success", Source: "active_probe", ObservedAt: &before, ExpiresAt: &after, ParserVersion: 1, CollectorVersion: 1}
+		if id == "funding-stale" {
+			snapshot.ExpiresAt = &before
+		}
+		if id == "funding-credits" {
+			snapshot.UsageCredits = JSONB(`{"state":"available","observed_at":"2026-11-11T23:59:00Z","expires_at":"2026-11-12T00:01:00Z","balance":"4"}`)
+		}
+		if errCreate := repo.db.Create(&snapshot).Error; errCreate != nil {
+			t.Fatal(errCreate)
+		}
+		if id == "funding-no-windows" {
+			continue
+		}
+		for index, w := range []struct {
+			id, scope, scopeID string
+			ratio              *float64
+		}{{"claude-five-hour", "account", "", &positive}, {"claude-seven-day-opus", "model", "opus", &zero}, {"claude-seven-day-sonnet", "model", "sonnet", &positive}} {
+			window := QuotaWindowRecord{CredentialID: id, WindowID: w.id, Priority: index, Scope: w.scope, ScopeID: w.scopeID, Mode: "window", Status: "healthy", Unit: "percent", RemainingRatio: w.ratio, ObservedAt: before, ExpiresAt: &after, Source: "active_probe", PeriodUnit: "hour"}
+			if errCreate := repo.db.Create(&window).Error; errCreate != nil {
+				t.Fatal(errCreate)
+			}
+		}
+	}
+	if errUpdate := repo.db.Model(&AuthRecord{}).Where("uuid = ?", "funding-disabled").Update("disabled", true).Error; errUpdate != nil {
+		t.Fatal(errUpdate)
+	}
+	if errDelete := repo.db.Where("uuid = ?", "funding-deleted").Delete(&AuthRecord{}).Error; errDelete != nil {
+		t.Fatal(errDelete)
+	}
+}
+
+func TestUsageCreditFundingReadPostgresConcurrentCommit(t *testing.T) {
+	for _, mutation := range []string{"quota-and-identity", "delete"} {
+		t.Run(mutation, func(t *testing.T) {
+			repo := newPostgresQuiescenceRepository(t)
+			now := time.Date(2026, 11, 12, 0, 0, 0, 0, time.UTC)
+			seedFundingReadFixture(t, repo, now)
+			ids := map[string]struct{}{"funding-plan": {}}
+			before, errBefore := repo.loadQuotaCredentials(t.Context(), now, ids, true)
+			if errBefore != nil {
+				t.Fatal(errBefore)
+			}
+			if len(before) != 1 {
+				t.Fatal("missing initial funding credential")
+			}
+			// QueryContext has established the statement's snapshot before Scan
+			// consumes rows. Commit another connection's complete state change here.
+			var once sync.Once
+			var errCommit error
+			callback := "test:funding-commit-after-query"
+			if errRegister := repo.db.Callback().Row().After("gorm:row").Register(callback, func(tx *gorm.DB) {
+				once.Do(func() {
+					errCommit = repo.db.Transaction(func(writer *gorm.DB) error {
+						if mutation == "delete" {
+							return writer.Where("uuid = ?", "funding-plan").Delete(&AuthRecord{}).Error
+						}
+						if errUpdate := writer.Model(&AuthRecord{}).Where("uuid = ?", "funding-plan").Update("disabled", true).Error; errUpdate != nil {
+							return errUpdate
+						}
+						if errUpdate := writer.Model(&QuotaSnapshotRecord{}).Where("credential_id = ?", "funding-plan").Update("expires_at", now.Add(-time.Minute)).Error; errUpdate != nil {
+							return errUpdate
+						}
+						return writer.Model(&QuotaWindowRecord{}).Where("credential_id = ?", "funding-plan").Update("remaining_ratio", 0).Error
+					})
+				})
+			}); errRegister != nil {
+				t.Fatal(errRegister)
+			}
+			t.Cleanup(func() { _ = repo.db.Callback().Row().Remove(callback) })
+			during, errDuring := repo.loadFundingCredentials(t.Context(), now, ids)
+			if errDuring != nil || errCommit != nil {
+				t.Fatalf("read=%v commit=%v", errDuring, errCommit)
+			}
+			if !reflect.DeepEqual(during, before) {
+				t.Fatal("one funding read mixed snapshots across a concurrent committed update")
+			}
+			if errRemove := repo.db.Callback().Row().Remove(callback); errRemove != nil {
+				t.Fatal(errRemove)
+			}
+			after, errAfter := repo.loadFundingCredentials(t.Context(), now, ids)
+			if errAfter != nil {
+				t.Fatal(errAfter)
+			}
+			expected, errExpected := repo.loadQuotaCredentials(t.Context(), now, ids, true)
+			if errExpected != nil {
+				t.Fatal(errExpected)
+			}
+			if !reflect.DeepEqual(after, expected) || reflect.DeepEqual(after, before) {
+				t.Fatal("next funding read did not observe the committed state")
+			}
+		})
+	}
+}
+
+func TestUsageCreditFundingReadCancellationAndInvalidAuth(t *testing.T) {
+	repo := newCredentialFoundationTestRepository(t)
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	if _, errRead := repo.loadFundingCredentials(ctx, time.Now(), nil); !errors.Is(errRead, context.Canceled) {
+		t.Fatalf("cancelled read=%v", errRead)
+	}
+	seedQuotaSnapshotAuth(t, repo, "invalid-funding", "claude", "synthetic", nil)
+	if errUpdate := repo.db.Model(&AuthRecord{}).Where("uuid = ?", "invalid-funding").Update("auth_json", JSONB(`[]`)).Error; errUpdate != nil {
+		t.Fatal(errUpdate)
+	}
+	if _, errRead := repo.loadFundingCredentials(t.Context(), time.Now(), nil); errRead == nil {
+		t.Fatal("malformed auth did not fail closed")
+	}
+}
+
+func TestUsageCreditFundingReadAdapterBudget(t *testing.T) {
+	repo := newCredentialFoundationTestRepository(t)
+	now := time.Now().UTC()
+	seedFundingReadFixture(t, repo, now)
+	if _, errKey := repo.CreateAPIKey(t.Context(), APIKeyEntryUpdate{APIKey: "synthetic-funding-key"}); errKey != nil {
+		t.Fatal(errKey)
+	}
+	counter := &lifecycleSQLCounter{Interface: logger.Default.LogMode(logger.Silent)}
+	counted := NewRepository(repo.db.Session(&gorm.Session{Logger: counter}))
+	adapter := &RuntimeAdapter{repo: counted}
+	tiers, errTiers := adapter.UsageCreditTiersForAPIKey(t.Context(), "synthetic-funding-key", "claude-opus-5-5", map[string]string{"funding-plan": "claude-opus-5-5", "funding-disabled": "claude-opus-5-5", "absent": "claude-opus-5-5"})
+	if errTiers != nil {
+		t.Fatal(errTiers)
+	}
+	if count := counter.statements.Load(); count != 2 {
+		t.Fatalf("adapter SQL statements=%d, want key lookup + one funding read", count)
+	}
+	if tiers["funding-disabled"] != 3 || tiers["absent"] != 2 {
+		t.Fatal("disabled or absent funding state changed")
+	}
+}
