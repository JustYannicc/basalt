@@ -0,0 +1,127 @@
+package cluster
+
+import (
+	"context"
+	"time"
+)
+
+type fundingQuotaRow struct {
+	Auth     AuthRecord          `gorm:"embedded;embeddedPrefix:auth_"`
+	Snapshot QuotaSnapshotRecord `gorm:"embedded;embeddedPrefix:snapshot_"`
+	Window   QuotaWindowRecord   `gorm:"embedded;embeddedPrefix:window_"`
+}
+
+// A single statement observes credentials, quota and windows in the same database
+// snapshot. Funding checks remain fresh without serial per-table round trips.
+func (r *Repository) loadFundingCredentials(ctx context.Context, now time.Time, ids map[string]struct{}) ([]QuotaCredentialSnapshot, error) {
+	db, errDB := r.database()
+	if errDB != nil {
+		return nil, errDB
+	}
+	if now.IsZero() {
+		now = time.Now().UTC()
+	} else {
+		now = now.UTC()
+	}
+	var rows []fundingQuotaRow
+	query := db.WithContext(contextOrBackground(ctx)).Model(&AuthRecord{}).
+		Table("auth AS funding_auth").
+		Select([]string{
+			"funding_auth.\"uuid\" AS auth_uuid",
+			"funding_auth.\"auth_json\" AS auth_auth_json",
+			"funding_auth.\"index\" AS auth_index",
+			"funding_auth.\"provider\" AS auth_provider",
+			"funding_auth.\"label\" AS auth_label",
+			"funding_auth.\"status\" AS auth_status",
+			"funding_auth.\"disabled\" AS auth_disabled",
+			"funding_auth.\"unavailable\" AS auth_unavailable",
+			"funding_auth.\"next_retry_after\" AS auth_next_retry_after",
+			"funding_snapshot.\"usage_credits\" AS snapshot_usage_credits",
+			"funding_snapshot.\"credential_id\" AS snapshot_credential_id",
+			"funding_snapshot.\"quota_status\" AS snapshot_quota_status",
+			"funding_snapshot.\"collection_status\" AS snapshot_collection_status",
+			"funding_snapshot.\"source\" AS snapshot_source",
+			"funding_snapshot.\"observed_at\" AS snapshot_observed_at",
+			"funding_snapshot.\"expires_at\" AS snapshot_expires_at",
+			"funding_snapshot.\"last_attempt_at\" AS snapshot_last_attempt_at",
+			"funding_snapshot.\"last_success_at\" AS snapshot_last_success_at",
+			"funding_snapshot.\"next_probe_at\" AS snapshot_next_probe_at",
+			"funding_snapshot.\"last_active_probe_at\" AS snapshot_last_active_probe_at",
+			"funding_snapshot.\"probe_activity_at\" AS snapshot_probe_activity_at",
+			"funding_snapshot.\"consecutive_failures\" AS snapshot_consecutive_failures",
+			"funding_snapshot.\"error_code\" AS snapshot_error_code",
+			"funding_snapshot.\"error_message\" AS snapshot_error_message",
+			"funding_snapshot.\"error_retryable\" AS snapshot_error_retryable",
+			"funding_snapshot.\"error_occurred_at\" AS snapshot_error_occurred_at",
+			"funding_snapshot.\"error_status_code\" AS snapshot_error_status_code",
+			"funding_snapshot.\"error_request_id\" AS snapshot_error_request_id",
+			"funding_snapshot.\"home_id\" AS snapshot_home_id",
+			"funding_snapshot.\"home_label\" AS snapshot_home_label",
+			"funding_snapshot.\"cpa_node_id\" AS snapshot_cpa_node_id",
+			"funding_snapshot.\"cpa_node_label\" AS snapshot_cpa_node_label",
+			"funding_snapshot.\"plan_name\" AS snapshot_plan_name",
+			"funding_snapshot.\"plan_premium\" AS snapshot_plan_premium",
+			"funding_snapshot.\"reset_credits\" AS snapshot_reset_credits",
+			"funding_snapshot.\"probe_lease_owner\" AS snapshot_probe_lease_owner",
+			"funding_snapshot.\"probe_lease_expires_at\" AS snapshot_probe_lease_expires_at",
+			"funding_snapshot.\"parser_version\" AS snapshot_parser_version",
+			"funding_snapshot.\"collector_version\" AS snapshot_collector_version",
+			"funding_snapshot.\"created_at\" AS snapshot_created_at",
+			"funding_snapshot.\"updated_at\" AS snapshot_updated_at",
+			"funding_window.\"credential_id\" AS window_credential_id",
+			"funding_window.\"window_id\" AS window_window_id",
+			"funding_window.\"priority\" AS window_priority",
+			"funding_window.\"label\" AS window_label",
+			"funding_window.\"scope\" AS window_scope",
+			"funding_window.\"scope_id\" AS window_scope_id",
+			"funding_window.\"mode\" AS window_mode",
+			"funding_window.\"status\" AS window_status",
+			"funding_window.\"unit\" AS window_unit",
+			"funding_window.\"currency\" AS window_currency",
+			"funding_window.\"used\" AS window_used",
+			"funding_window.\"remaining\" AS window_remaining",
+			"funding_window.\"limit_value\" AS window_limit_value",
+			"funding_window.\"used_ratio\" AS window_used_ratio",
+			"funding_window.\"remaining_ratio\" AS window_remaining_ratio",
+			"funding_window.\"is_unlimited\" AS window_is_unlimited",
+			"funding_window.\"reset_at\" AS window_reset_at",
+			"funding_window.\"window_seconds\" AS window_window_seconds",
+			"funding_window.\"period_unit\" AS window_period_unit",
+			"funding_window.\"period_value\" AS window_period_value",
+			"funding_window.\"source\" AS window_source",
+			"funding_window.\"observed_at\" AS window_observed_at",
+			"funding_window.\"expires_at\" AS window_expires_at",
+			"funding_window.\"created_at\" AS window_created_at",
+			"funding_window.\"updated_at\" AS window_updated_at",
+		}).
+		Joins("LEFT JOIN quota_snapshot AS funding_snapshot ON funding_snapshot.credential_id = funding_auth.uuid").
+		Joins("LEFT JOIN quota_window AS funding_window ON funding_window.credential_id = funding_auth.uuid").
+		Order("funding_auth.uuid ASC, funding_window.priority ASC, funding_window.window_id ASC")
+	// Match the existing loader: nil and empty selections both mean all accounts.
+	if values := quotaExactSetValues(ids); len(values) > 0 {
+		query = query.Where("funding_auth.uuid IN ?", values)
+	}
+	if errRead := query.Scan(&rows).Error; errRead != nil {
+		return nil, errRead
+	}
+
+	items := make([]QuotaCredentialSnapshot, 0)
+	for index := 0; index < len(rows); {
+		first := rows[index]
+		auth, errAuth := quotaAuthFromRecord(&first.Auth)
+		if errAuth != nil {
+			return nil, errAuth
+		}
+		windows := make([]QuotaWindow, 0)
+		next := index
+		for next < len(rows) && rows[next].Auth.UUID == first.Auth.UUID {
+			if rows[next].Window.WindowID != "" {
+				windows = append(windows, quotaWindowDTO(rows[next].Window))
+			}
+			next++
+		}
+		items = append(items, quotaCredentialFromAuth(first.Auth, auth, first.Snapshot, windows, now))
+		index = next
+	}
+	return items, nil
+}
