+package quota
+
+import (
+	"context"
+	"strings"
+	"testing"
+	"time"
+
+	coreauth "github.com/router-for-me/CLIProxyAPIHome/internal/cliproxy/auth"
+)
+
+// Field presence matches the retained diagnostic; amounts are synthetic, not a vendor body.
+func xaiOptionalFixture() xaiProbeFixture {
+	return xaiProbeFixture{
+		profile: `{"subscriptionTier":"SuperGrokPlus"}`,
+		monthly: `{"config":{"monthlyLimit":15000,"used":4200,"onDemandCap":5000}}`,
+		weekly:  `{"config":{"currentPeriod":{}}}`,
+	}
+}
+
+func TestXAIOptionalFieldsKeepMonthlyHealthyWithoutInventingUsage(t *testing.T) {
+	now := time.Date(2026, 11, 11, 7, 33, 23, 0, time.UTC)
+	fixture := xaiOptionalFixture()
+	server := serveXAIProbeFixture(t, func() xaiProbeFixture { return fixture })
+	repo := newCollectorTestRepository(t)
+	seedCollectorProviderAuth(t, repo, "xai-optional", "xai", map[string]any{"type": "xai", "access_token": "fixture"})
+	collector := NewCollector(repo, Options{Owner: "xai-optional", XAIBillingURL: server.URL + "/v1/billing", Now: func() time.Time { return now }})
+	collector.collectCredential(context.Background(), &coreauth.Auth{ID: "xai-optional", Provider: "xai"}, true)
+	item, errGet := repo.GetQuotaCredential(context.Background(), "xai-optional", now)
+	if errGet != nil || item.CollectionStatus != "success" || item.Error != nil {
+		t.Fatalf("valid monthly response became unavailable: item=%+v error=%v", item, errGet)
+	}
+	if len(item.Windows) != 2 {
+		t.Fatalf("want monthly and unmeasured weekly only: %+v", item.Windows)
+	}
+	for _, window := range item.Windows {
+		switch window.ID {
+		case "xai-weekly-usage":
+			if window.Used != nil || window.Remaining != nil || window.Limit != nil || window.UsedRatio != nil || window.RemainingRatio != nil || window.Status != "unknown" {
+				t.Fatalf("omitted weekly amount became a fabricated reading: %+v", window)
+			}
+		case "xai-monthly-spend":
+			if window.Used == nil || *window.Used != 42 || window.Remaining == nil || *window.Remaining != 108 {
+				t.Fatalf("monthly figures were lost: %+v", window)
+			}
+		default:
+			t.Fatalf("unreported on-demand usage must be hidden: %+v", window)
+		}
+	}
+}
+
+func TestXAIOptionalWeeklyOmissionNeverMeansZero(t *testing.T) {
+	now := time.Date(2026, 11, 11, 7, 33, 23, 0, time.UTC)
+	fixture := xaiPaidFixture(now)
+	fixture.monthly = xaiOptionalFixture().monthly
+	server := serveXAIProbeFixture(t, func() xaiProbeFixture { return fixture })
+	collector := NewCollector(newCollectorTestRepository(t), Options{Owner: "xai-optional-period", XAIBillingURL: server.URL + "/v1/billing", Now: func() time.Time { return now }})
+	result, failure := collector.probeXAI(context.Background(), &coreauth.Auth{Metadata: map[string]any{"access_token": "fixture"}})
+	if failure != nil || result.partial || len(result.windows) != 2 || result.windows[0].Used != nil || result.windows[0].Remaining != nil || result.windows[0].Limit != nil {
+		t.Fatalf("omission in a current paid week fabricated zero: result=%+v failure=%v", result, failure)
+	}
+}
+
+func TestXAIOptionalMalformedFieldsStillNameTheirStage(t *testing.T) {
+	now := time.Date(2026, 11, 11, 7, 33, 23, 0, time.UTC)
+	for _, field := range []string{"creditUsagePercent", "credit_usage_percent", "onDemandUsed", "on_demand_used"} {
+		for _, value := range []string{`null`, `"bad"`, `false`, `{"val":{"val":1}}`} {
+			t.Run(field+value, func(t *testing.T) {
+				fixture := xaiOptionalFixture()
+				message := "xAI weekly quota response could not be parsed."
+				if strings.HasPrefix(field, "on") {
+					fixture.monthly = strings.Replace(fixture.monthly, `"config":{`, `"config":{"`+field+`":`+value+`,`, 1)
+					message = "xAI monthly billing response could not be parsed."
+				} else {
+					fixture.weekly = strings.Replace(fixture.weekly, `"config":{`, `"config":{"`+field+`":`+value+`,`, 1)
+				}
+				server := serveXAIProbeFixture(t, func() xaiProbeFixture { return fixture })
+				collector := NewCollector(newCollectorTestRepository(t), Options{Owner: "xai-optional-invalid", XAIBillingURL: server.URL + "/v1/billing", Now: func() time.Time { return now }})
+				result, failure := collector.probeXAI(context.Background(), &coreauth.Auth{Metadata: map[string]any{"access_token": "fixture"}})
+				code, detail := "", ""
+				if failure != nil {
+					code, detail = failure.code, failure.message
+				} else if result.collectionError != nil {
+					code, detail = result.collectionError.Code, result.collectionError.Message
+				}
+				if code != "UPSTREAM_RESPONSE_INVALID" || detail != message {
+					t.Fatalf("invalid optional value lost its named failure: result=%+v failure=%v", result, failure)
+				}
+			})
+		}
+	}
+}
+
+func TestXAIOptionalExplicitZeroStillReportsMeasuredUsage(t *testing.T) {
+	now := time.Date(2026, 11, 11, 7, 33, 23, 0, time.UTC)
+	fixture := xaiOptionalFixture()
+	fixture.monthly = strings.Replace(fixture.monthly, `"config":{`, `"config":{"onDemandUsed":0,`, 1)
+	fixture.weekly = strings.Replace(fixture.weekly, `"config":{`, `"config":{"creditUsagePercent":0,`, 1)
+	server := serveXAIProbeFixture(t, func() xaiProbeFixture { return fixture })
+	collector := NewCollector(newCollectorTestRepository(t), Options{Owner: "xai-explicit-zero", XAIBillingURL: server.URL + "/v1/billing", Now: func() time.Time { return now }})
+	result, failure := collector.probeXAI(context.Background(), &coreauth.Auth{Metadata: map[string]any{"access_token": "fixture"}})
+	if failure != nil || result.partial || len(result.windows) != 3 {
+		t.Fatalf("explicit zero did not produce measured windows: result=%+v failure=%v", result, failure)
+	}
+	for _, index := range []int{0, 2} {
+		if result.windows[index].Used == nil || *result.windows[index].Used != 0 || result.windows[index].Remaining == nil {
+			t.Fatalf("a real zero was mistaken for an omitted amount: %+v", result.windows[index])
+		}
+	}
+}
+
+func TestXAIOptionalOmissionReplacesPriorAmounts(t *testing.T) {
+	now := time.Date(2026, 11, 11, 7, 33, 23, 0, time.UTC)
+	fixture := xaiOptionalFixture()
+	fixture.monthly = strings.Replace(fixture.monthly, `"config":{`, `"config":{"onDemandUsed":100,`, 1)
+	fixture.weekly = strings.Replace(fixture.weekly, `"config":{`, `"config":{"creditUsagePercent":12,`, 1)
+	server := serveXAIProbeFixture(t, func() xaiProbeFixture { return fixture })
+	repo := newCollectorTestRepository(t)
+	seedCollectorProviderAuth(t, repo, "xai-optional-replacement", "xai", map[string]any{"type": "xai", "access_token": "fixture"})
+	collector := NewCollector(repo, Options{Owner: "xai-optional-replacement", XAIBillingURL: server.URL + "/v1/billing", Now: func() time.Time { return now }})
+	auth := &coreauth.Auth{ID: "xai-optional-replacement", Provider: "xai"}
+	collector.collectCredential(context.Background(), auth, true)
+	first, errFirst := repo.GetQuotaCredential(context.Background(), auth.ID, now)
+	if errFirst != nil || len(first.Windows) != 3 || first.Windows[0].Used == nil {
+		t.Fatalf("initial reported usage missing: item=%+v error=%v", first, errFirst)
+	}
+	fixture = xaiOptionalFixture()
+	now = now.Add(time.Minute)
+	collector.collectCredential(context.Background(), auth, true)
+	next, errNext := repo.GetQuotaCredential(context.Background(), auth.ID, now)
+	if errNext != nil || next.CollectionStatus != "success" || next.Error != nil || len(next.Windows) != 2 || next.Windows[0].Used != nil || next.Windows[0].Remaining != nil || next.Windows[0].Limit != nil {
+		t.Fatalf("old amounts survived a later omission: item=%+v error=%v", next, errNext)
+	}
+}
+
+func TestXAIOptionalOnDemandAliasesPreserveZeroAndRejectConflict(t *testing.T) {
+	now := time.Date(2026, 11, 11, 7, 33, 23, 0, time.UTC)
+	for _, tc := range []struct {
+		fields  string
+		invalid bool
+	}{
+		{`"onDemandUsed":0`, false},
+		{`"on_demand_used":"0"`, false},
+		{`"onDemandUsed":{"val":0},"on_demand_used":0`, false},
+		{`"onDemandUsed":0,"on_demand_used":1`, true},
+		{`"onDemandUsed":0,"on_demand_used":null`, true},
+		{`"onDemandUsed":-1`, true},
+	} {
+		body := strings.Replace(xaiOptionalFixture().monthly, `"config":{`, `"config":{`+tc.fields+`,`, 1)
+		windows, _, errParse := parseXAIUsageWindows([]byte(body), now)
+		if tc.invalid {
+			if errParse == nil {
+				t.Fatalf("invalid on-demand amount accepted: %s", tc.fields)
+			}
+		} else if errParse != nil || len(windows) != 2 || windows[1].Used == nil || *windows[1].Used != 0 {
+			t.Fatalf("valid zero alias lost: windows=%+v error=%v", windows, errParse)
+		}
+	}
+}
