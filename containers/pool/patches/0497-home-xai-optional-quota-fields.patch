new file mode 100644
--- /dev/null
+++ b/internal/quota/xai_optional.go
@@ -0,0 +1,26 @@
+package quota
+
+// Optional amounts distinguish omission from a present value that cannot be read.
+type xaiOptionalFloat struct {
+	number  flexFloat
+	present bool
+}
+
+func (f *xaiOptionalFloat) UnmarshalJSON(data []byte) error {
+	f.present = true
+	return f.number.UnmarshalJSON(data)
+}
+
+func xaiOptionalFloatValue(primary, alternate xaiOptionalFloat) (*float64, bool) {
+	left, right := flexFloatValue(primary.number), flexFloatValue(alternate.number)
+	if primary.present && (left == nil || *left < 0) || alternate.present && (right == nil || *right < 0) {
+		return nil, false
+	}
+	if primary.present && alternate.present && *left != *right {
+		return nil, false
+	}
+	if primary.present {
+		return left, true
+	}
+	return right, true
+}
