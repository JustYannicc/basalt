@@ -0,0 +1,132 @@
+package xai
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPIHome/internal/auth/oautherror"
+)
+
+var ErrDeviceCodeExpired = errors.New("xai device code expired")
+var ErrDeviceAccessDenied = errors.New("xai device authorization declined")
+
+// The device secret stays in Home; only the verification URL and user code leave it.
+type DeviceCodeResponse struct {
+	DeviceCode              string    `json:"device_code"`
+	UserCode                string    `json:"user_code"`
+	VerificationURI         string    `json:"verification_uri"`
+	VerificationURIComplete string    `json:"verification_uri_complete"`
+	ExpiresIn               int       `json:"expires_in"`
+	Interval                int       `json:"interval"`
+	TokenEndpoint           string    `json:"-"`
+	ExpiresAt               time.Time `json:"-"`
+}
+
+// StartDeviceFlow follows the device grant used by current CPA xAI authentication.
+func (a *XAIAuth) StartDeviceFlow(ctx context.Context) (*DeviceCodeResponse, error) {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	discovery, err := a.Discover(ctx)
+	if err != nil {
+		return nil, err
+	}
+	if discovery.DeviceAuthorizationEndpoint == "" {
+		return nil, errors.New("xai device authorization is unavailable")
+	}
+	form := url.Values{"client_id": {ClientID}, "scope": {Scope}}
+	req, err := http.NewRequestWithContext(ctx, "POST", discovery.DeviceAuthorizationEndpoint, strings.NewReader(form.Encode()))
+	if err != nil {
+		return nil, errors.New("xai device request could not be prepared")
+	}
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	req.Header.Set("Accept", "application/json")
+	response, err := a.httpClient.Do(req)
+	if err != nil {
+		return nil, errors.New("xai device authorization could not be reached")
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("xai device authorization returned HTTP %d", response.StatusCode)
+	}
+	body, err := io.ReadAll(response.Body)
+	if err != nil {
+		return nil, errors.New("xai device authorization response could not be read")
+	}
+	var code DeviceCodeResponse
+	if json.Unmarshal(body, &code) != nil || strings.TrimSpace(code.DeviceCode) == "" || strings.TrimSpace(code.UserCode) == "" || code.ExpiresIn <= 0 {
+		return nil, errors.New("xai device authorization response is incomplete")
+	}
+	verification := code.VerificationURIComplete
+	if verification == "" {
+		verification = code.VerificationURI
+	}
+	if _, err := ValidateOAuthEndpoint(verification, "verification_uri"); err != nil {
+		return nil, errors.New("xai device verification address is invalid")
+	}
+	code.TokenEndpoint = discovery.TokenEndpoint
+	code.ExpiresAt = time.Now().Add(time.Duration(code.ExpiresIn) * time.Second)
+	return &code, nil
+}
+
+// WaitForAuthorization handles RFC 8628 pending, slow-down, expiry and cancellation.
+func (a *XAIAuth) WaitForAuthorization(ctx context.Context, code *DeviceCodeResponse) (*AuthBundle, error) {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if code == nil || code.DeviceCode == "" || code.TokenEndpoint == "" {
+		return nil, errors.New("xai device authorization is incomplete")
+	}
+	ctx, cancel := context.WithDeadline(ctx, code.ExpiresAt)
+	defer cancel()
+	interval := time.Duration(code.Interval) * time.Second
+	if interval < 5*time.Second {
+		interval = 5 * time.Second
+	}
+	form := url.Values{"grant_type": {"urn:ietf:params:oauth:grant-type:device_code"}, "client_id": {ClientID}, "device_code": {code.DeviceCode}}
+	for {
+		if ctx.Err() != nil {
+			if errors.Is(ctx.Err(), context.DeadlineExceeded) {
+				return nil, ErrDeviceCodeExpired
+			}
+			return nil, ctx.Err()
+		}
+		request, finish := context.WithTimeout(ctx, 30*time.Second)
+		token, err := a.postTokenForm(request, code.TokenEndpoint, form)
+		finish()
+		if err == nil {
+			return &AuthBundle{TokenData: *token, LastRefresh: time.Now().UTC().Format(time.RFC3339), BaseURL: DefaultAPIBaseURL, TokenEndpoint: code.TokenEndpoint}, nil
+		}
+		if ctx.Err() != nil {
+			continue
+		}
+		var rejected *oautherror.ResponseError
+		if !errors.As(err, &rejected) {
+			return nil, errors.New("xai device token exchange could not finish")
+		}
+		switch rejected.OAuthError() {
+		case "authorization_pending":
+		case "slow_down":
+			interval += 5 * time.Second
+		case "expired_token":
+			return nil, ErrDeviceCodeExpired
+		case "access_denied":
+			return nil, ErrDeviceAccessDenied
+		default:
+			return nil, errors.New("xai device token exchange was rejected")
+		}
+		timer := time.NewTimer(interval)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+		case <-timer.C:
+		}
+	}
+}
