+package xai
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestXAIDeviceErrorsAndCancellation(t *testing.T) {
+	for _, tc := range []struct {
+		code     string
+		expected error
+	}{
+		{"expired_token", ErrDeviceCodeExpired},
+		{"access_denied", ErrDeviceAccessDenied},
+		{"authorization_pending", context.Canceled},
+		{"slow_down", context.Canceled},
+		{"unexpected_error", nil},
+	} {
+		t.Run(tc.code, func(t *testing.T) {
+			calls := 0
+			seen := make(chan struct{}, 1)
+			auth := &XAIAuth{httpClient: &http.Client{Transport: refreshRoundTripperFunc(func(r *http.Request) (*http.Response, error) {
+				calls++
+				seen <- struct{}{}
+				return &http.Response{StatusCode: 400, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(`{"error":"` + tc.code + `","error_description":"private-provider-sentinel"}`)), Request: r}, nil
+			})}}
+			ctx, cancel := context.WithCancel(t.Context())
+			defer cancel()
+			result := make(chan error, 1)
+			go func() {
+				_, err := auth.WaitForAuthorization(ctx, &DeviceCodeResponse{DeviceCode: "fixture-device", TokenEndpoint: "https://auth.x.ai/token", ExpiresAt: time.Now().Add(time.Minute), Interval: 5})
+				result <- err
+			}()
+			<-seen
+			if errors.Is(tc.expected, context.Canceled) {
+				cancel()
+			}
+			var err error
+			select {
+			case err = <-result:
+			case <-time.After(5 * time.Second):
+				t.Fatal("device cancellation did not finish")
+			}
+			if err == nil || calls != 1 || strings.Contains(err.Error(), "private-provider-sentinel") {
+				t.Fatal("device error was retried immediately or exposed provider response content")
+			}
+			if tc.expected != nil && !errors.Is(err, tc.expected) {
+				t.Fatalf("error = %v, want %v", err, tc.expected)
+			}
+		})
+	}
+	auth := &XAIAuth{httpClient: &http.Client{Transport: refreshRoundTripperFunc(func(r *http.Request) (*http.Response, error) {
+		t.Fatal("an expired code reached the token endpoint")
+		return nil, nil
+	})}}
+	_, err := auth.WaitForAuthorization(t.Context(), &DeviceCodeResponse{DeviceCode: "expired", TokenEndpoint: "https://auth.x.ai/token", ExpiresAt: time.Now().Add(-time.Second)})
+	if !errors.Is(err, ErrDeviceCodeExpired) {
+		t.Fatal("expired device code did not fail before exchange")
+	}
+}
+
+func TestXAIDeviceDiscoveryDoesNotRequireABrowserRedirect(t *testing.T) {
+	auth := &XAIAuth{httpClient: &http.Client{Transport: refreshRoundTripperFunc(func(r *http.Request) (*http.Response, error) {
+		body := `{"device_authorization_endpoint":"https://auth.x.ai/device/code","token_endpoint":"https://auth.x.ai/token"}`
+		if r.Method == "POST" {
+			body = `{"device_code":"private-device","user_code":"USER-CODE","verification_uri":"https://accounts.x.ai/oauth2/device","expires_in":1800,"interval":5}`
+		}
+		return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(body)), Request: r}, nil
+	})}}
+	code, err := auth.StartDeviceFlow(t.Context())
+	if err != nil || code.UserCode != "USER-CODE" || code.DeviceCode != "private-device" || code.TokenEndpoint != "https://auth.x.ai/token" || code.ExpiresAt.IsZero() {
+		t.Fatal("device discovery still depends on the removed browser callback")
+	}
+}
