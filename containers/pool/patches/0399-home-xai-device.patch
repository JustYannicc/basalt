+++ b/internal/cluster/management/oauth_xai_device.go
@@ -0,0 +1,73 @@
+package management
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	xaiauth "github.com/router-for-me/CLIProxyAPIHome/internal/auth/xai"
+	"github.com/router-for-me/CLIProxyAPIHome/internal/cluster"
+)
+
+// RequestXAIToken uses device authorization because xAI no longer redirects the old CLI flow.
+func (h *Handler) RequestXAIToken(c *gin.Context) {
+	ctx, cancel := context.WithTimeout(requestContextOrBackground(c), 30*time.Second)
+	defer cancel()
+	auth := xaiauth.NewXAIAuth(h.oauthConfig())
+	code, err := auth.StartDeviceFlow(ctx)
+	if err != nil {
+		c.JSON(http.StatusBadGateway, gin.H{"error": "xai_device_authorization_unavailable"})
+		return
+	}
+	state, err := generateOAuthState("xai")
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"error": "oauth_state_failed"})
+		return
+	}
+	record, err := cluster.NewOAuthSessionRecord("xai", state, map[string]any{
+		"device_code": code.DeviceCode, "user_code": code.UserCode,
+		"token_endpoint": code.TokenEndpoint, "flow": "device",
+	}, time.Now().UTC())
+	if err == nil {
+		if code.ExpiresAt.Before(record.ExpiresAt) {
+			record.ExpiresAt = code.ExpiresAt
+		} else {
+			code.ExpiresAt = record.ExpiresAt
+			code.ExpiresIn = int(cluster.OAuthSessionTTL / time.Second)
+		}
+		err = h.repo.UpsertOAuthSession(ctx, record)
+	}
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"error": "oauth_session_failed"})
+		return
+	}
+	verification := code.VerificationURIComplete
+	if verification == "" {
+		verification = code.VerificationURI
+	}
+	go h.waitForXAIAuthorization(state, auth, code)
+	c.JSON(http.StatusOK, gin.H{"status": "ok", "state": state, "flow": "device", "url": verification, "user_code": code.UserCode, "expires_in": code.ExpiresIn})
+}
+
+func (h *Handler) waitForXAIAuthorization(state string, auth *xaiauth.XAIAuth, code *xaiauth.DeviceCodeResponse) {
+	ctx, cancel := h.oauthSessionContext(context.Background(), state, time.Until(code.ExpiresAt))
+	defer cancel()
+	bundle, err := auth.WaitForAuthorization(ctx, code)
+	if err == nil {
+		err = h.storeXAIBundle(ctx, bundle)
+	}
+	if err == nil || errors.Is(ctx.Err(), context.Canceled) {
+		return
+	}
+	message := "xAI sign-in could not finish. Start again."
+	if errors.Is(err, xaiauth.ErrDeviceCodeExpired) || errors.Is(ctx.Err(), context.DeadlineExceeded) {
+		message = "xAI sign-in expired. Start again to get a new code."
+	} else if errors.Is(err, xaiauth.ErrDeviceAccessDenied) {
+		message = "xAI sign-in was declined. Start again to try another code."
+	}
+	saved, finish := context.WithTimeout(context.Background(), 30*time.Second)
+	defer finish()
+	_ = h.repo.SetOAuthSessionError(saved, state, message)
+}
