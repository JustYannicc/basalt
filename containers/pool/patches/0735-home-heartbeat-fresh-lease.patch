@@ -0,0 +1,109 @@
+package cluster
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+// newElectedPair returns two coordinators on one database after one locked election: older is the
+// master, newer a follower.
+func newElectedPair(t *testing.T) (*gorm.DB, *Coordinator, *Coordinator) {
+	t.Helper()
+	db, older := newCoordinationPoolFixture(t, 4, 0)
+	newer := NewCoordinator(NewRepository(db), NodeIdentity{IP: "127.0.0.1", Port: 18318, StartedAt: time.Now().Add(time.Second)},
+		CoordinatorOptions{HeartbeatInterval: time.Second, HeartbeatTimeout: 20 * time.Second})
+	if errInitialize := newer.Initialize(context.Background()); errInitialize != nil {
+		t.Fatal(errInitialize)
+	}
+	for _, c := range []*Coordinator{older, newer, older} {
+		home, _ := c.HomeIncarnation()
+		if errBeat := c.heartbeatAndElect(context.Background(), home); errBeat != nil {
+			t.Fatal(errBeat)
+		}
+	}
+	if !older.IsMaster() || newer.IsMaster() {
+		t.Fatalf("setup: older master %v, newer master %v", older.IsMaster(), newer.IsMaster())
+	}
+	return db, older, newer
+}
+
+func readGate(t *testing.T, db *gorm.DB) ClusterMasterGateRecord {
+	t.Helper()
+	var gate ClusterMasterGateRecord
+	if errGate := db.First(&gate, "id = ?", 1).Error; errGate != nil {
+		t.Fatal(errGate)
+	}
+	return gate
+}
+
+// holdGate keeps the election gate's row lock in an open transaction, as a rebalance pass or a
+// slow election does, until the returned release runs.
+func holdGate(t *testing.T, db *gorm.DB) func() {
+	t.Helper()
+	tx := db.Begin()
+	var gate ClusterMasterGateRecord
+	if errLock := tx.Clauses(clause.Locking{Strength: "UPDATE"}).First(&gate, "id = ?", 1).Error; errLock != nil {
+		t.Fatal(errLock)
+	}
+	return func() { _ = tx.Rollback().Error }
+}
+
+func TestHomeDBPoolHeartbeatOfAFollowerNeverWaitsOnTheGate(t *testing.T) {
+	db, _, follower := newElectedPair(t)
+	release := holdGate(t, db)
+	defer release()
+	home, _ := follower.HomeIncarnation()
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	started := time.Now()
+	if errBeat := follower.heartbeatAndElect(ctx, home); errBeat != nil {
+		t.Fatalf("a follower's heartbeat waited on the gate held by another transaction: %v after %s", errBeat, time.Since(started))
+	}
+	if follower.IsMaster() {
+		t.Fatal("the follower became master")
+	}
+}
+
+func TestHomeDBPoolHeartbeatOfTheMasterRenewsItsLeaseWithoutANewTerm(t *testing.T) {
+	db, master, _ := newElectedPair(t)
+	before := readGate(t, db)
+	time.Sleep(20 * time.Millisecond)
+	home, _ := master.HomeIncarnation()
+	if errBeat := master.heartbeatAndElect(context.Background(), home); errBeat != nil {
+		t.Fatal(errBeat)
+	}
+	after := readGate(t, db)
+	if after.Term != before.Term || after.MasterKey != before.MasterKey {
+		t.Fatalf("a steady heartbeat changed the election: term %d -> %d", before.Term, after.Term)
+	}
+	if !after.LeaseUntil.After(before.LeaseUntil) {
+		t.Fatalf("the master's lease was not renewed: %s -> %s", before.LeaseUntil, after.LeaseUntil)
+	}
+	if !master.IsMaster() {
+		t.Fatal("the master lost its role on a steady heartbeat")
+	}
+}
+
+func TestHomeDBPoolHeartbeatElectsAFollowerOnceTheMastersLeaseRunsOut(t *testing.T) {
+	db, master, follower := newElectedPair(t)
+	before := readGate(t, db)
+	if errUpdate := db.Exec("UPDATE cluster_master_gate SET lease_until = now() - interval '1 minute' WHERE id = 1").Error; errUpdate != nil {
+		t.Fatal(errUpdate)
+	}
+	if errUpdate := db.Model(&ClusterNodeRecord{}).Where("ip = ? AND port = ?", master.node.IP, master.node.Port).
+		Update("last_seen_at", time.Now().UTC().Add(-time.Hour)).Error; errUpdate != nil {
+		t.Fatal(errUpdate)
+	}
+	home, _ := follower.HomeIncarnation()
+	if errBeat := follower.heartbeatAndElect(context.Background(), home); errBeat != nil {
+		t.Fatal(errBeat)
+	}
+	after := readGate(t, db)
+	if !follower.IsMaster() || after.Term != before.Term+1 {
+		t.Fatalf("follower master %v, term %d -> %d", follower.IsMaster(), before.Term, after.Term)
+	}
+}
