+// heartbeatWithFreshLease records this node's heartbeat without the election gate's row lock while
+// the election cannot change: the gate names the oldest live node, that node holds the master flag,
+// and its lease is fresh. A follower then only writes its own row; the master renews its lease with
+// one conditional update. Every Home locking the gate on every heartbeat queued them behind each
+// other and behind rebalance passes, each waiter holding a pooled server connection. Anything else
+// returns false and the locked election runs.
+func (c *Coordinator) heartbeatWithFreshLease(ctx context.Context, db *gorm.DB) (bool, error) {
+	db = db.WithContext(contextOrBackground(ctx))
+	now, errNow := DatabaseNow(ctx, db)
+	if errNow != nil {
+		return false, errNow
+	}
+	record := ClusterNodeRecord{
+		IP:          c.node.IP,
+		Port:        c.node.Port,
+		SecretHash:  nodeSecretHash(c.node.Secret),
+		ClientCount: node.GlobalRegistry().TotalCount(),
+		StartedAt:   c.node.StartedAt,
+		LastSeenAt:  now,
+	}
+	if errUpsert := db.Clauses(clause.OnConflict{
+		Columns: []clause.Column{{Name: "ip"}, {Name: "port"}},
+		DoUpdates: clause.Assignments(map[string]any{
+			"started_at":   record.StartedAt,
+			"last_seen_at": record.LastSeenAt,
+			"secret_hash":  record.SecretHash,
+			"client_count": record.ClientCount,
+		}),
+	}).Create(&record).Error; errUpsert != nil {
+		return false, errUpsert
+	}
+	var gate ClusterMasterGateRecord
+	errGate := db.First(&gate, "id = ?", 1).Error
+	if errors.Is(errGate, gorm.ErrRecordNotFound) {
+		return false, nil
+	}
+	if errGate != nil {
+		return false, errGate
+	}
+	if gate.Term <= 0 || !now.Before(gate.LeaseUntil) {
+		return false, nil
+	}
+	var liveNodes []ClusterNodeRecord
+	if errFind := db.Where("last_seen_at >= ?", now.Add(-c.heartbeatTimeout)).Find(&liveNodes).Error; errFind != nil {
+		return false, errFind
+	}
+	if len(liveNodes) == 0 {
+		return false, nil
+	}
+	sortClusterNodes(liveNodes)
+	elected := liveNodes[0]
+	if !elected.IsMaster || gate.MasterKey != rebalanceHomeKey(HomeIncarnationID{IP: elected.IP, Port: elected.Port, StartedAt: elected.StartedAt}) {
+		return false, nil
+	}
+	self := clusterNodeMatches(elected, c.node.IP, c.node.Port)
+	if self {
+		renewed := db.Model(&ClusterMasterGateRecord{}).
+			Where("id = ? AND term = ? AND master_key = ?", 1, gate.Term, gate.MasterKey).
+			Update("lease_until", now.Add(c.heartbeatTimeout))
+		if renewed.Error != nil {
+			return false, renewed.Error
+		}
+		if renewed.RowsAffected != 1 {
+			return false, nil
+		}
+	}
+	c.setMaster(self)
+	return true, nil
+}
