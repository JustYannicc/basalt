diff --git a/internal/cluster/schema_owner.go b/internal/cluster/schema_owner.go
new file mode 100644
index 0000000..4fbf834
--- /dev/null
+++ b/internal/cluster/schema_owner.go
@@ -0,0 +1,26 @@
+package cluster
+
+import (
+	"strings"
+
+	"gorm.io/gorm"
+)
+
+const schemaOwnerSetting = "home:schema-owner"
+
+// A pooled backend belongs to another caller after commit, so owner changes stay
+// inside the transaction that creates schema objects.
+func schemaTransaction(db *gorm.DB, run func(*gorm.DB) error) error {
+	return db.Transaction(func(tx *gorm.DB) error {
+		value, configured := tx.Get(schemaOwnerSetting)
+		if configured {
+			if owner, ok := value.(string); ok && owner != "" {
+				quoted := `"` + strings.ReplaceAll(owner, `"`, `""`) + `"`
+				if err := tx.Exec("SET LOCAL ROLE " + quoted).Error; err != nil {
+					return err
+				}
+			}
+		}
+		return run(tx)
+	})
+}
