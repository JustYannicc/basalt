+func TestXAIUnmeteredReplacesOldMeasurementsAndClearsFailure(t *testing.T) {
+	now := time.Date(2026, 11, 11, 12, 2, 24, 0, time.UTC)
+	fixture := xaiProbeFixture{profile: `{"subscriptionTier":"SuperGrokPlus"}`, monthly: `{"config":{"monthlyLimit":15000,"used":4200,"onDemandCap":5000,"onDemandUsed":12}}`, weekly: `{"config":{"creditUsagePercent":25}}`}
+	server := serveXAIProbeFixture(t, func() xaiProbeFixture { return fixture })
+	repo := newCollectorTestRepository(t)
+	seedCollectorProviderAuth(t, repo, "unmetered-recovery", "xai", map[string]any{"type": "xai", "access_token": "fixture"})
+	collector := NewCollector(repo, Options{Owner: "unmetered-recovery", XAIBillingURL: server.URL + "/v1/billing", Now: func() time.Time { return now }})
+	auth := &coreauth.Auth{ID: "unmetered-recovery", Provider: "xai"}
+	collector.collectCredential(context.Background(), auth, true)
+	first, errFirst := repo.GetQuotaCredential(context.Background(), auth.ID, now)
+	if errFirst != nil || len(first.Windows) != 3 || first.Windows[0].Used == nil {
+		t.Fatalf("missing initial measurements: %+v, %v", first, errFirst)
+	}
+	fixture.monthlyStatus = 503
+	fixture.weeklyStatus = 503
+	now = now.Add(time.Minute)
+	collector.collectCredential(context.Background(), auth, true)
+	failed, errFailed := repo.GetQuotaCredential(context.Background(), auth.ID, now)
+	if errFailed != nil || failed.CollectionStatus != "failed" || failed.Error == nil {
+		t.Fatalf("outage was hidden: %+v, %v", failed, errFailed)
+	}
+	fixture = xaiProbeFixture{profile: `{"subscriptionTier":"SuperGrokPlus"}`, monthly: `{"config":{"monthlyLimit":15000}}`, weekly: `{"config":{"currentPeriod":{"type":"monthly"}}}`}
+	now = now.Add(time.Minute)
+	collector.collectCredential(context.Background(), auth, true)
+	next, errNext := repo.GetQuotaCredential(context.Background(), auth.ID, now)
+	if errNext != nil || next.CollectionStatus != "success" || next.Error != nil || next.ObservedAt == nil || !next.ObservedAt.Equal(now) || len(next.Windows) != 2 {
+		t.Fatalf("unmetered recovery kept failure: %+v, %v", next, errNext)
+	}
+	for _, window := range next.Windows {
+		if window.ID == "xai-on-demand" || window.Used != nil || window.Remaining != nil || window.UsedRatio != nil || window.RemainingRatio != nil {
+			t.Fatalf("previous amounts survived omission: %+v", window)
+		}
+	}
+}
