+func TestXAIUnmeteredMonthlyZeroAndAliasesRemainMeasured(t *testing.T) {
+	now := time.Date(2026, 11, 11, 12, 2, 24, 0, time.UTC)
+	for _, monthly := range []string{
+		`{"config":{"monthlyLimit":15000,"used":0}}`,
+		`{"config":{"monthly_limit":"15000","used":{"val":0}}}`,
+		`{"config":{"monthlyLimit":15000,"monthly_limit":15000,"used":0}}`,
+	} {
+		windows, _, errParse := parseXAIUsageWindows([]byte(monthly), now)
+		if errParse != nil || len(windows) != 1 || windows[0].Used == nil || *windows[0].Used != 0 || windows[0].Remaining == nil || *windows[0].Remaining != 150 {
+			t.Fatalf("explicit zero was lost: %+v, %v", windows, errParse)
+		}
+	}
+	for _, monthly := range []string{
+		`{"config":{"monthlyLimit":15000,"monthly_limit":15001}}`,
+		`{"config":{"onDemandCap":5000,"on_demand_cap":5001}}`,
+	} {
+		if _, _, errParse := parseXAIUsageWindows([]byte(monthly), now); errParse == nil {
+			t.Fatal("conflicting monthly aliases accepted")
+		}
+	}
+}
