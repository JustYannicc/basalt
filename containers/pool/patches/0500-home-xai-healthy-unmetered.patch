+				switch target {
+				case "monthly":
+					fixture.monthlyStatus = tc.status
+				case "weekly":
+					fixture.weeklyStatus = tc.status
+				case "profile":
+					fixture.profileStatus = tc.status
+				}
+				server := serveXAIProbeFixture(t, func() xaiProbeFixture { return fixture })
+				collector := NewCollector(newCollectorTestRepository(t), Options{XAIBillingURL: server.URL + "/v1/billing", Now: func() time.Time { return now }})
