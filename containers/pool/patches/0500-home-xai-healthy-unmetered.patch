new file mode 100644
--- /dev/null
+++ b/internal/quota/xai_unmetered.go
@@ -0,0 +1,65 @@
+package quota
+
+import (
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPIHome/internal/cluster"
+)
+
+func xaiUnmeasuredWeeklyWindow(observedAt time.Time) cluster.QuotaWindow {
+	return cluster.QuotaWindow{ID: "xai-weekly-usage", Label: quotaStringPtr("Weekly Limit"), Scope: "account", Mode: "fixed", Status: "unknown", Unit: "percentage", PeriodUnit: "week", PeriodValue: quotaFloatPtr(1), Source: "active_probe", ObservedAt: observedAt, Priority: -10}
+}
+
+// A valid period can describe no current weekly quota. Invalid supplied fields remain errors.
+func xaiWeeklyConfigValid(config *xaiBillingConfig) bool {
+	if (config.CreditUsagePercent.present || config.CreditUsagePercentSnake.present) && xaiPercentageValue(config.CreditUsagePercent, config.CreditUsagePercentSnake) == nil {
+		return false
+	}
+	if config.CurrentPeriod != nil && config.CurrentPeriodSnake != nil && *config.CurrentPeriod != *config.CurrentPeriodSnake {
+		return false
+	}
+	if !xaiBillingResetValid(config) {
+		return false
+	}
+	if period := xaiCurrentWeeklyPeriod(config); period != nil {
+		var start, end *time.Time
+		if period.Start != "" {
+			start = parseProviderTime(period.Start)
+			if start == nil {
+				return false
+			}
+		}
+		if period.End != "" {
+			end = parseProviderTime(period.End)
+			if end == nil {
+				return false
+			}
+		}
+		if start != nil && end != nil && !start.Before(*end) {
+			return false
+		}
+	}
+	for _, products := range [][]xaiBillingProductUsage{config.ProductUsage, config.ProductUsageSnake} {
+		for _, product := range products {
+			if (product.UsagePercent.present || product.UsagePercentSnake.present) && xaiPercentageValue(product.UsagePercent, product.UsagePercentSnake) == nil {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func xaiBillingResetValid(config *xaiBillingConfig) bool {
+	var reset *time.Time
+	for _, value := range []string{config.BillingPeriodEnd, config.BillingEndSnake} {
+		if value == "" {
+			continue
+		}
+		parsed := parseProviderTime(value)
+		if parsed == nil || reset != nil && !reset.Equal(*parsed) {
+			return false
+		}
+		reset = parsed
+	}
+	return true
+}
