+package logging
+
+import (
+	"strings"
+	"testing"
+
+	log "github.com/sirupsen/logrus"
+)
+
+func TestDiagnosticsPrivacyLogFormatterSinglePhysicalRecord(t *testing.T) {
+	header := "[CLIProxyAPIHome] [2026-11-04 12:00:00] [--------] [error] [main.go:500] "
+	for _, separator := range []string{"\n", "\r", "\r\n"} {
+		entry := log.NewEntry(log.New())
+		entry.Level = log.ErrorLevel
+		entry.Message = "failed to start HTTPS server: open /run/fixture" + separator +
+			header + "failed to open database: connection refused" + separator +
+			"trailer: no such file or directory"
+		entry.Data["error"] = separator + header + "http server error: EOF"
+		entry.Data["request_id"] = separator + header
+		raw, err := (&LogFormatter{}).Format(entry)
+		if err != nil {
+			t.Fatal(err)
+		}
+		formatted := string(raw)
+		if strings.Count(formatted, "\n") != 1 || !strings.HasSuffix(formatted, "\n") || strings.Contains(formatted, "\r") {
+			t.Fatalf("expected one terminated physical record: %q", formatted)
+		}
+		escaped := strings.NewReplacer("\r", "\\r", "\n", "\\n").Replace(entry.Message)
+		if !strings.Contains(formatted, escaped) {
+			t.Fatalf("embedded slot delimiters were not escaped whole: %q", formatted)
+		}
+	}
+}
