+func TestPostgresSinglePartFastPathChecksCurrentMembership(t *testing.T) {
+	for _, scenario := range []string{"canceling", "node-changed"} {
+		t.Run(scenario, func(t *testing.T) {
+			repo, ctx, lifetime := newPostgresLifecycleFixture(t)
+			identity := InFlightIngestIdentity{CertificateFingerprint: lifetime.Fingerprint, NodeID: "node-a", MembershipConnectedAt: lifetime.ConnectedAt}
+			publishInFlightSnapshot(t, repo, identity, 1, nil)
+			column, value := "state", "canceling"
+			if scenario == "node-changed" {
+				column, value = "node_id", "different-node"
+			}
+			if errUpdate := repo.db.Model(&CPANodeMembershipRecord{}).Where("certificate_fingerprint = ?", identity.CertificateFingerprint).Update(column, value).Error; errUpdate != nil {
+				t.Fatal(errUpdate)
+			}
+			if _, errIngest := repo.IngestInFlightFrame(ctx, identity, mustInFlightJSON(t, inFlightPart(2, 0, 1, nil, nil)), DefaultInFlightLimits()); !errors.Is(errIngest, ErrInFlightLifetimeMismatch) {
+				t.Fatalf("closed lifetime error=%v", errIngest)
+			}
+			if attempt := loadInFlightAttempt(t, repo); attempt.HighestSeenRevision != 1 {
+				t.Fatalf("closed lifetime advanced=%#v", attempt)
+			}
+		})
+	}
+}
