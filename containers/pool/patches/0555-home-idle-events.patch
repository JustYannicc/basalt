@@ -0,0 +1,45 @@
+package cluster
+
+import (
+	"testing"
+
+	"gorm.io/gorm"
+)
+
+func TestPostgresSinglePartObservationUsesOneStatement(t *testing.T) {
+	repo, ctx, lifetime := newPostgresLifecycleFixture(t)
+	identity := InFlightIngestIdentity{CertificateFingerprint: lifetime.Fingerprint, NodeID: "node-a", MembershipConnectedAt: lifetime.ConnectedAt}
+	publishInFlightSnapshot(t, repo, identity, 1, nil)
+	counter := &lifecycleSQLCounter{Interface: repo.db.Logger}
+	repo.db = repo.db.Session(&gorm.Session{Logger: counter})
+	for revision := int64(2); revision <= 31; revision++ {
+		counter.statements.Store(0)
+		result, errIngest := repo.IngestInFlightFrame(ctx, identity, mustInFlightJSON(t, inFlightPart(revision, 0, 1, nil, nil)), DefaultInFlightLimits())
+		if errIngest != nil || !result.Published || !result.Accepted || result.State != "complete" {
+			t.Fatalf("revision %d: result=%#v error=%v", revision, result, errIngest)
+		}
+		if got := counter.statements.Load(); got != 1 {
+			t.Fatalf("revision %d used %d business SQL statements, want 1", revision, got)
+		}
+	}
+	attempt := loadInFlightAttempt(t, repo)
+	if attempt.HighestSeenRevision != 31 || attempt.ReceivedPartCount != 1 || attempt.State != "complete" {
+		t.Fatalf("attempt=%#v", attempt)
+	}
+	var visible CPAInFlightSnapshotRecord
+	if errFind := repo.db.First(&visible).Error; errFind != nil || visible.Revision != 31 {
+		t.Fatalf("visible=%#v error=%v", visible, errFind)
+	}
+}
+
+func TestPostgresHomeHeartbeatUsesOneStatement(t *testing.T) {
+	repo, ctx, lifetime := newPostgresLifecycleFixture(t)
+	counter := &lifecycleSQLCounter{Interface: repo.db.Logger}
+	repo.db = repo.db.Session(&gorm.Session{Logger: counter})
+	if errHeartbeat := repo.HeartbeatHomeIncarnation(ctx, lifetime.Home); errHeartbeat != nil {
+		t.Fatal(errHeartbeat)
+	}
+	if got := counter.statements.Load(); got != 1 {
+		t.Fatalf("Home heartbeat used %d business SQL statements, want 1", got)
+	}
+}
