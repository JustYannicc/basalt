+package cluster
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPIHome/internal/node"
+	"gorm.io/gorm"
+)
+
+func TestCoordinatorUnchangedSnapshotBatchesRetentionRefresh(t *testing.T) {
+	registry := node.GlobalRegistry()
+	const ip, id = "192.0.2.225", "idle-snapshot-node"
+	registry.AddWithNodeID(ip, id, time.Now())
+	t.Cleanup(func() { registry.RemoveWithNodeID(ip, id) })
+	repo := newCredentialFoundationTestRepository(t)
+	coordinator := newSnapshotTestCoordinator(t, repo)
+	startedAt := time.Now()
+	scheduler := cpaNodeSnapshotScheduler{coordinator: coordinator, lastSuccess: startedAt.Add(-time.Minute)}
+	scheduler.refresh(context.Background(), startedAt)
+	deletes := snapshotDeleteCounter(t, repo)
+	for second := 1; second < 60; second++ {
+		scheduler.refresh(context.Background(), startedAt.Add(time.Duration(second)*time.Second))
+	}
+	if got := deletes.Load(); got != 0 {
+		t.Fatalf("unchanged topology replaced %d times before retention refresh, want 0", got)
+	}
+	scheduler.refresh(context.Background(), startedAt.Add(time.Minute))
+	if got := deletes.Load(); got != 1 {
+		t.Fatalf("bounded retention refreshes=%d, want 1", got)
+	}
+}
+
+func TestCoordinatorEmptySnapshotDoesNoPeriodicSQL(t *testing.T) {
+	repo := newCredentialFoundationTestRepository(t)
+	coordinator := newSnapshotTestCoordinator(t, repo)
+	startedAt := time.Now()
+	scheduler := cpaNodeSnapshotScheduler{coordinator: coordinator, lastSuccess: startedAt.Add(-time.Minute)}
+	scheduler.refresh(context.Background(), startedAt)
+	counter := &lifecycleSQLCounter{Interface: repo.db.Logger}
+	repo.db = repo.db.Session(&gorm.Session{Logger: counter})
+	for second := 1; second <= 180; second++ {
+		scheduler.refresh(context.Background(), startedAt.Add(time.Duration(second)*time.Second))
+	}
+	if got := counter.statements.Load(); got != 0 {
+		t.Fatalf("empty unchanged topology used %d periodic SQL statements, want 0", got)
+	}
+}
+
+func TestCoordinatorSnapshotPersistsHandlerAndFenceChangesWithoutNotification(t *testing.T) {
+	registry := node.GlobalRegistry()
+	const fingerprint, id, ip = "idle-snapshot-fingerprint", "idle-draining-node", "192.0.2.227"
+	registry.UpdateFingerprintState(fingerprint, id, ip, 1, 0, 0)
+	t.Cleanup(func() { registry.UpdateFingerprintState(fingerprint, id, ip, -1, -1, 2) })
+	repo := newCredentialFoundationTestRepository(t)
+	coordinator := newSnapshotTestCoordinator(t, repo)
+	startedAt := time.Now()
+	scheduler := cpaNodeSnapshotScheduler{coordinator: coordinator, lastSuccess: startedAt.Add(-time.Minute)}
+	scheduler.refresh(context.Background(), startedAt)
+	registry.UpdateFingerprintState(fingerprint, id, ip, -1, 1, 2)
+	scheduler.refresh(context.Background(), startedAt.Add(time.Second))
+	var record CPANodeRecord
+	if errFind := repo.db.First(&record, "certificate_fingerprint = ?", fingerprint).Error; errFind != nil {
+		t.Fatal(errFind)
+	}
+	if record.OpenConnections != 0 || record.ActiveHandlers != 1 || record.LatestCancelRevision != 2 {
+		t.Fatalf("held-draining state=%#v", record)
+	}
+	registry.UpdateFingerprintState(fingerprint, id, ip, 0, -1, 2)
+	scheduler.refresh(context.Background(), startedAt.Add(2*time.Second))
+	var count int64
+	if errCount := repo.db.Model(&CPANodeRecord{}).Where("certificate_fingerprint = ?", fingerprint).Count(&count).Error; errCount != nil || count != 0 {
+		t.Fatalf("closed snapshot count=%d error=%v", count, errCount)
+	}
+}
