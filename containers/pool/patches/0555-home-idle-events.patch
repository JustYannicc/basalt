diff --git a/internal/cluster/liveness_postgres.go b/internal/cluster/liveness_postgres.go
index 61d07fe..5a189c5 100644
--- a/internal/cluster/liveness_postgres.go
+++ b/internal/cluster/liveness_postgres.go
@@ -2,6 +2,7 @@ package cluster
 
 import (
 	"context"
+	"errors"
 	"strings"
 
 	"gorm.io/gorm"
@@ -65,3 +66,44 @@ func refreshPostgresCPALiveness(ctx context.Context, db *gorm.DB, lifetime Conne
 	}
 	return ErrHomeIncarnationInactive
 }
+
+// Lock before reading the clock so time spent waiting cannot extend an old heartbeat.
+const refreshPostgresHomeLivenessSQL = `
+WITH home AS MATERIALIZED (
+ SELECT home_ip, home_port, started_at, state FROM home_process_incarnation
+ WHERE home_ip = ? AND home_port = ? AND started_at = ?
+ FOR NO KEY UPDATE
+), beat AS MATERIALIZED (
+ SELECT clock_timestamp() AS observed_at FROM home WHERE state = 'active'
+), renewed AS (
+ UPDATE home_process_incarnation h SET last_seen_at = beat.observed_at
+ FROM home, beat
+ WHERE h.home_ip = home.home_ip AND h.home_port = home.home_port AND h.started_at = home.started_at
+ RETURNING h.home_ip
+)
+SELECT COALESCE((SELECT state FROM home), '') AS state,
+ EXISTS(SELECT 1 FROM renewed) AS renewed`
+
+func refreshPostgresHomeLiveness(ctx context.Context, db *gorm.DB, id HomeIncarnationID) error {
+	var result struct {
+		State   string
+		Renewed bool
+	}
+	errRenew := db.WithContext(ctx).Connection(func(conn *gorm.DB) error {
+		return conn.Raw(refreshPostgresHomeLivenessSQL, strings.TrimSpace(id.IP), id.Port, id.StartedAt).Scan(&result).Error
+	})
+	if errRenew != nil {
+		return errors.Join(errRenew, ctx.Err())
+	}
+	switch result.State {
+	case "":
+		return ErrHomeIncarnationNotFound
+	case HomeIncarnationFenced:
+		return ErrHomeIncarnationFenced
+	case HomeIncarnationActive:
+		if result.Renewed {
+			return nil
+		}
+	}
+	return ErrHomeIncarnationInactive
+}
