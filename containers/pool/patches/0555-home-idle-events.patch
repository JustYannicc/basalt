+++ b/internal/cluster/in_flight_single_postgres_test.go
@@ -0,0 +1,151 @@
+package cluster
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"testing"
+
+	"gorm.io/gorm/clause"
+)
+
+func TestPostgresSinglePartRestartsAfterConcurrentAttemptChange(t *testing.T) {
+	for _, scenario := range []string{"complete", "multipart", "rejected", "newer"} {
+		t.Run(scenario, func(t *testing.T) {
+			repo, ctx, lifetime := newPostgresLifecycleFixture(t)
+			identity := InFlightIngestIdentity{CertificateFingerprint: lifetime.Fingerprint, NodeID: "node-a", MembershipConnectedAt: lifetime.ConnectedAt}
+			publishInFlightSnapshot(t, repo, identity, 1, nil)
+			holder := beginTimestampLockHolder(t, ctx, repo)
+			var attempt CPAInFlightSnapshotAttemptRecord
+			if errLock := holder.Clauses(clause.Locking{Strength: "UPDATE"}).First(&attempt).Error; errLock != nil {
+				t.Fatal(errLock)
+			}
+			observeLifecycleTransitionPID(t, repo)
+			observer := &lifecycleTransitionPIDObserver{results: make(chan postgresBackendPIDResult, 1)}
+			contenderCtx := context.WithValue(ctx, lifecycleTransitionPIDContextKey{}, observer)
+			done := make(chan error, 1)
+			go func() {
+				_, errIngest := repo.IngestInFlightFrame(contenderCtx, identity, mustInFlightJSON(t, inFlightPart(3, 0, 1, nil, nil)), DefaultInFlightLimits())
+				done <- errIngest
+			}()
+			holderPID := make(chan postgresBackendPIDResult, 1)
+			if errPID := postgresContenderBackendPIDHook(holderPID)(holder); errPID != nil {
+				t.Fatal(errPID)
+			}
+			waitForPostgresContendersBlockedByHolder(t, ctx, repo, holderPID, observer.results)
+			// The contender already has its statement snapshot. Commit parts it cannot see.
+			frame := inFlightPart(2, 0, 1, nil, nil)
+			if scenario == "multipart" {
+				frame = inFlightPart(2, 0, 2, nil, nil)
+			}
+			if scenario == "newer" {
+				frame = inFlightPart(4, 0, 1, nil, nil)
+			}
+			var result InFlightIngestResult
+			if scenario == "rejected" {
+				if errReject := repo.markInFlightRejected(ctx, holder, identity, 2, &result); errReject != nil {
+					t.Fatal(errReject)
+				}
+			} else if errStage := repo.stageInFlightFrame(ctx, holder, identity, frame, mustInFlightJSON(t, frame), DefaultInFlightLimits(), &result); errStage != nil {
+				t.Fatal(errStage)
+			}
+			if errCommit := holder.Commit().Error; errCommit != nil {
+				t.Fatal(errCommit)
+			}
+			select {
+			case errIngest := <-done:
+				if scenario == "newer" {
+					if !errors.Is(errIngest, ErrInFlightRevisionStale) {
+						t.Fatalf("error=%v, want stale revision", errIngest)
+					}
+				} else if errIngest != nil {
+					t.Fatal(errIngest)
+				}
+			case <-ctx.Done():
+				t.Fatal(ctx.Err())
+			}
+			wantRevision := int64(3)
+			if scenario == "newer" {
+				wantRevision = 4
+			}
+			var parts []CPAInFlightSnapshotPartRecord
+			if errFind := repo.db.Find(&parts).Error; errFind != nil {
+				t.Fatal(errFind)
+			}
+			if len(parts) != 1 || parts[0].Revision != wantRevision {
+				t.Fatalf("stale or missing parts after restart: %#v", parts)
+			}
+			final := loadInFlightAttempt(t, repo)
+			if final.HighestSeenRevision != wantRevision || final.State != "complete" || final.ReceivedPartCount != 1 {
+				t.Fatalf("attempt=%#v", final)
+			}
+			var visible CPAInFlightSnapshotRecord
+			if errFind := repo.db.First(&visible).Error; errFind != nil || visible.Revision != wantRevision {
+				t.Fatalf("snapshot=%#v error=%v", visible, errFind)
+			}
+		})
+	}
+}
+
+func TestPostgresSinglePartPreservesReplayAndPayload(t *testing.T) {
+	repo, ctx, lifetime := newPostgresLifecycleFixture(t)
+	identity := InFlightIngestIdentity{CertificateFingerprint: lifetime.Fingerprint, NodeID: "node-a", MembershipConnectedAt: lifetime.ConnectedAt}
+	publishInFlightSnapshot(t, repo, identity, 1, nil)
+	frame := inFlightPart(2, 0, 1, []InFlightAggregate{{CredentialID: "fixture-credential", Model: "fixture-model", Status: InFlightAccounted, Count: 1}}, []InFlightRequestDetail{{RequestID: "fixture-request", CredentialID: "fixture-credential", Model: "fixture-model", RequestKind: "responses", StartedAt: databaseTestTime}})
+	frame.BarrierRevision = 7
+	frame.DetailsTruncated = true
+	raw := mustInFlightJSON(t, frame)
+	result, errIngest := repo.IngestInFlightFrame(ctx, identity, raw, DefaultInFlightLimits())
+	if errIngest != nil || !result.Published {
+		t.Fatalf("publish=%#v error=%v", result, errIngest)
+	}
+	var visible CPAInFlightSnapshotRecord
+	if errFind := repo.db.First(&visible).Error; errFind != nil {
+		t.Fatal(errFind)
+	}
+	var payload InFlightSnapshotPayload
+	if errDecode := json.Unmarshal(visible.Payload, &payload); errDecode != nil {
+		t.Fatal(errDecode)
+	}
+	if visible.BarrierRevision != 7 || !visible.DetailsTruncated || !visible.ObservedAt.Equal(frame.ObservedAt) || len(payload.Aggregates) != 1 || payload.Aggregates[0] != frame.Aggregates[0] || len(payload.Details) != 1 || payload.Details[0] != frame.Details[0] {
+		t.Fatalf("snapshot=%#v payload=%#v", visible, payload)
+	}
+	replay, errReplay := repo.IngestInFlightFrame(ctx, identity, raw, DefaultInFlightLimits())
+	if errReplay != nil || !replay.Accepted || replay.Published {
+		t.Fatalf("replay=%#v error=%v", replay, errReplay)
+	}
+	frame.BarrierRevision++
+	if _, errConflict := repo.IngestInFlightFrame(ctx, identity, mustInFlightJSON(t, frame), DefaultInFlightLimits()); !errors.Is(errConflict, ErrInFlightRevisionConflict) {
+		t.Fatalf("conflict=%v", errConflict)
+	}
+	var after CPAInFlightSnapshotRecord
+	if errFind := repo.db.First(&after).Error; errFind != nil {
+		t.Fatal(errFind)
+	}
+	if after.Revision != visible.Revision || after.BarrierRevision != visible.BarrierRevision || !after.UpdatedAt.Equal(visible.UpdatedAt) || string(after.Payload) != string(visible.Payload) {
+		t.Fatal("replay changed the published observation or freshness")
+	}
+}
