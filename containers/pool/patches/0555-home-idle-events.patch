diff --git a/internal/cluster/in_flight_single_postgres.go b/internal/cluster/in_flight_single_postgres.go
new file mode 100644
index 0000000..9ffd44e
--- /dev/null
+++ b/internal/cluster/in_flight_single_postgres.go
@@ -0,0 +1,130 @@
+package cluster
+
+import (
+	"context"
+	"encoding/json"
+	"time"
+
+	"gorm.io/gorm"
+)
+
+// The unlocked prior revision detects changes committed while FOR UPDATE waits.
+// PostgreSQL's statement snapshot cannot see their parts, so only an unchanged
+// completed attempt may use this path. All other cases restart in the general
+// transaction with a fresh snapshot and its existing replay/conflict checks.
+const publishPostgresSingleInFlightSQL = `
+WITH input AS MATERIALIZED (
+ SELECT ?::text AS fingerprint, ?::timestamptz AS connected_at, ?::text AS node_id,
+   ?::bigint AS revision, ?::timestamptz AS observed_at, ?::bigint AS barrier_revision,
+   ?::boolean AS details_truncated, ?::bytea AS raw, ?::integer AS encoded_bytes, ?::jsonb AS payload
+), member AS MATERIALIZED (
+ SELECT m.certificate_fingerprint FROM cpa_node_membership m CROSS JOIN input i
+ WHERE m.certificate_fingerprint = i.fingerprint AND m.connected_at = i.connected_at
+   AND m.node_id = i.node_id AND m.state = 'active'
+ FOR KEY SHARE OF m
+), prior AS MATERIALIZED (
+ SELECT a.certificate_fingerprint, a.membership_connected_at, a.highest_seen_revision, a.state
+ FROM cpa_in_flight_snapshot_attempts a JOIN member m USING (certificate_fingerprint) CROSS JOIN input i
+ WHERE a.membership_connected_at = i.connected_at AND a.state = 'complete' AND a.highest_seen_revision < i.revision
+), locked AS MATERIALIZED (
+ SELECT a.certificate_fingerprint, a.membership_connected_at
+ FROM cpa_in_flight_snapshot_attempts a JOIN prior p
+ ON a.certificate_fingerprint = p.certificate_fingerprint AND a.membership_connected_at = p.membership_connected_at
+ WHERE a.highest_seen_revision = p.highest_seen_revision AND a.state = p.state
+ FOR UPDATE OF a
+), ready AS MATERIALIZED (
+ SELECT i.*, clock_timestamp() AS written_at FROM input i CROSS JOIN locked
+), removed AS (
+ DELETE FROM cpa_in_flight_snapshot_parts p USING ready r
+ WHERE p.certificate_fingerprint = r.fingerprint AND p.membership_connected_at = r.connected_at
+ RETURNING p.revision
+), inserted AS (
+ INSERT INTO cpa_in_flight_snapshot_parts
+ (certificate_fingerprint, membership_connected_at, revision, part_index, payload, encoded_bytes, created_at, updated_at)
+ SELECT fingerprint, connected_at, revision, 0, raw, encoded_bytes, written_at, written_at FROM ready
+ WHERE (SELECT count(*) FROM removed) >= 0
+ RETURNING certificate_fingerprint
+), completed AS (
+ UPDATE cpa_in_flight_snapshot_attempts a
+ SET highest_seen_revision = r.revision, state = 'complete', observed_at = r.observed_at,
+   barrier_revision = r.barrier_revision, part_count = 1, received_part_count = 1,
+   encoded_bytes = r.encoded_bytes, aggregate_group_count = 0,
+   details_truncated = r.details_truncated, updated_at = r.written_at
+ FROM ready r JOIN inserted p ON p.certificate_fingerprint = r.fingerprint
+ WHERE a.certificate_fingerprint = r.fingerprint AND a.membership_connected_at = r.connected_at
+ RETURNING a.certificate_fingerprint
+), published AS (
+ INSERT INTO cpa_in_flight_snapshots
+ (certificate_fingerprint, node_id, membership_connected_at, revision, observed_at, barrier_revision, details_truncated, payload, updated_at)
+ SELECT r.fingerprint, r.node_id, r.connected_at, r.revision, r.observed_at,
+   r.barrier_revision, r.details_truncated, r.payload, r.written_at
+ FROM ready r JOIN completed a ON a.certificate_fingerprint = r.fingerprint
+ ON CONFLICT (certificate_fingerprint) DO UPDATE SET
+ node_id = EXCLUDED.node_id, membership_connected_at = EXCLUDED.membership_connected_at,
+ revision = EXCLUDED.revision, observed_at = EXCLUDED.observed_at, barrier_revision = EXCLUDED.barrier_revision,
+ details_truncated = EXCLUDED.details_truncated, payload = EXCLUDED.payload, updated_at = EXCLUDED.updated_at
+ RETURNING certificate_fingerprint
+)
+SELECT EXISTS(SELECT 1 FROM member) AS membership_active,
+ EXISTS(SELECT 1 FROM published) AS published`
+
+func publishPostgresSingleInFlight(ctx context.Context, db *gorm.DB, identity InFlightIngestIdentity, frame InFlightSnapshotFrame, raw []byte, limits InFlightLimits) (bool, error) {
+	payload := InFlightSnapshotPayload{Aggregates: frame.Aggregates, Details: frame.Details, DetailsTruncated: frame.DetailsTruncated}
+	if payload.Aggregates == nil {
+		payload.Aggregates = []InFlightAggregate{}
+	}
+	if payload.Details == nil {
+		payload.Details = []InFlightRequestDetail{}
+	}
+	if errValidate := validateCompleteInFlightPayload(payload, limits); errValidate != nil {
+		return false, nil
+	}
+	encoded, errEncode := json.Marshal(payload)
+	if errEncode != nil {
+		return false, errEncode
+	}
+	var result struct {
+		MembershipActive bool
+		Published        bool
+	}
+	errPublish := db.WithContext(ctx).Connection(func(conn *gorm.DB) error {
+		return conn.Raw(publishPostgresSingleInFlightSQL,
+			identity.CertificateFingerprint, identity.MembershipConnectedAt, identity.NodeID,
+			frame.Revision, frame.ObservedAt, frame.BarrierRevision, frame.DetailsTruncated,
+			raw, len(raw), string(encoded)).Scan(&result).Error
+	})
+	if errPublish != nil {
+		return false, errPublish
+	}
+	if !result.MembershipActive {
+		return false, ErrInFlightLifetimeMismatch
+	}
+	return result.Published, nil
+}
+
+// This bounded hint only avoids an extra database probe on cold lifetimes.
+// It grants no authority: the fast statement locks and checks the live rows.
+type inFlightLifetime struct {
+	fingerprint string
+	connectedAt time.Time
+}
+
+func (r *Repository) hasPublishedInFlight(identity InFlightIngestIdentity) bool {
+	r.inFlightFastPathMu.Lock()
+	defer r.inFlightFastPathMu.Unlock()
+	_, found := r.inFlightFastPaths[inFlightLifetime{identity.CertificateFingerprint, identity.MembershipConnectedAt.UTC()}]
+	return found
+}
+
+func (r *Repository) rememberPublishedInFlight(identity InFlightIngestIdentity) {
+	r.inFlightFastPathMu.Lock()
+	defer r.inFlightFastPathMu.Unlock()
+	key := inFlightLifetime{identity.CertificateFingerprint, identity.MembershipConnectedAt.UTC()}
+	if _, found := r.inFlightFastPaths[key]; found {
+		return
+	}
+	if r.inFlightFastPaths == nil || len(r.inFlightFastPaths) >= 1024 {
+		r.inFlightFastPaths = make(map[inFlightLifetime]struct{})
+	}
+	r.inFlightFastPaths[key] = struct{}{}
+}
