+package redisqueue
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/diagnostics"
+	internallogging "github.com/router-for-me/CLIProxyAPI/v8/internal/logging"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	coreusage "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/usage"
+)
+
+func TestUsageQueueMetadataOnlyDropsSensitiveValuesAndKeepsDiagnostics(t *testing.T) {
+	t.Setenv(diagnostics.MetadataOnlyEnv, "1")
+	gin.SetMode(gin.TestMode)
+
+	const (
+		clientID       = "metadata-only-queue-account-1"
+		modelID        = "gpt-safe-queue-diagnostic"
+		requestSecret  = "queue-sentinel-request-984"
+		responseSecret = "queue-sentinel-response-216"
+		headerSecret   = "queue-sentinel-header-317"
+		authSecret     = "queue-sentinel-auth-428"
+		freeTextSecret = "queue-sentinel-error-539"
+		rawAPIKey      = "  queue-client-key-secret-640  "
+	)
+
+	modelRegistry := registry.GetGlobalRegistry()
+	modelRegistry.RegisterClient(clientID, "openai", []*registry.ModelInfo{{ID: modelID}})
+	t.Cleanup(func() { modelRegistry.UnregisterClient(clientID) })
+
+	traceID := "018f3a5b-1234-7abc-def0-12345678abcd"
+	executionID := "7c9a1f40-209d-4b83-8f9c-eaef07268439"
+	ginCtx, _ := gin.CreateTestContext(httptest.NewRecorder())
+	ginCtx.Request = httptest.NewRequest(http.MethodPost, "https://proxy.invalid/v1/responses", strings.NewReader(requestSecret))
+	ginCtx.Request.Header.Set("Authorization", authSecret)
+	ginCtx.Request.Header.Set("X-Sentinel", headerSecret)
+	ginCtx.Set("userApiKey", rawAPIKey)
+	ctx := context.WithValue(context.Background(), "gin", ginCtx)
+	ctx = internallogging.WithRequestID(ctx, traceID)
+	ctx = coreusage.WithExecutionRequestID(ctx, executionID)
+	ctx = coreusage.WithAPIKey(ctx, rawAPIKey)
+	ctx = coreusage.WithAccessProvider(ctx, freeTextSecret)
+	ctx = internallogging.WithEndpoint(ctx, requestSecret)
+	ctx = internallogging.WithClientRequestMetadata(ctx, internallogging.ClientRequestMetadata{
+		ClientIP: requestSecret, ResolvedClientIP: requestSecret, XForwardedFor: requestSecret,
+		UserAgent: requestSecret, SessionID: requestSecret, ParentSessionID: requestSecret,
+	})
+	ctx = internallogging.WithResponseStatusHolder(ctx)
+	internallogging.SetResponseStatus(ctx, http.StatusServiceUnavailable)
+	ctx = internallogging.WithResponseHeadersHolder(ctx)
+	internallogging.SetResponseHeaders(ctx, http.Header{"X-Sentinel": {headerSecret}, "Authorization": {authSecret}})
+
+	withEnabledQueue(t, func() {
+		(&usageQueuePlugin{}).HandleUsage(ctx, coreusage.Record{
+			RequestID: executionID, TraceID: traceID, Provider: "openai", ExecutorType: "OpenAIExecutor",
+			Model: modelID, Alias: requestSecret, APIKey: rawAPIKey, AuthID: clientID,
+			AuthIndex: "account-73", AccessTokenSHA256: authSecret, AuthType: freeTextSecret,
+			BaseURL: requestSecret, Source: authSecret, AccessProvider: freeTextSecret,
+			SessionID: requestSecret, ParentSessionID: requestSecret, ReasoningEffort: freeTextSecret,
+			ServiceTier: freeTextSecret, EffectiveServiceTier: freeTextSecret,
+			ResponseServiceTier: freeTextSecret, ResponseModel: freeTextSecret,
+			RequestedAt: time.Date(2026, 10, 29, 10, 11, 12, 0, time.UTC),
+			Latency:     1250 * time.Millisecond, TTFT: 200 * time.Millisecond, Failed: true,
+			Fail:            coreusage.Failure{StatusCode: http.StatusServiceUnavailable, Body: responseSecret, Type: requestSecret, Code: authSecret},
+			Detail:          coreusage.Detail{InputTokens: 13, OutputTokens: 5, TotalTokens: 18, ResponseServiceTier: freeTextSecret},
+			ResponseHeaders: http.Header{"X-Sentinel": {headerSecret}, "Authorization": {authSecret}},
+		})
+
+		payload := popSinglePayload(t)
+		requireStringField(t, payload, "provider", "openai")
+		requireStringField(t, payload, "model", modelID)
+		requireStringField(t, payload, "auth_index", "account-73")
+		requireStringField(t, payload, "request_id", traceID)
+		requireStringField(t, payload, "execution_id", executionID)
+		requireIntField(t, payload, "latency_ms", 1250)
+		requireBoolField(t, payload, "failed", true)
+		tokens := requireTokensPayload(t, payload)
+		requireIntField(t, tokens, "input_tokens", 13)
+		requireIntField(t, tokens, "output_tokens", 5)
+		requireIntField(t, tokens, "total_tokens", 18)
+
+		var gotAPIKey string
+		if err := json.Unmarshal(payload["api_key"], &gotAPIKey); err != nil {
+			t.Fatalf("unmarshal api_key: %v", err)
+		}
+		sum := sha256.Sum256([]byte(strings.TrimSpace(rawAPIKey)))
+		wantAPIKey := "sha256:" + hex.EncodeToString(sum[:])
+		var marker string
+		if err := json.Unmarshal(payload["api_key_fingerprint"], &marker); err != nil || marker != wantAPIKey {
+			t.Fatal("explicit identity fingerprint missing")
+		}
+		if gotAPIKey != wantAPIKey {
+			t.Fatalf("api_key = %q, want fingerprint %q", gotAPIKey, wantAPIKey)
+		}
+
+		var fail struct {
+			StatusCode int    `json:"status_code"`
+			Body       string `json:"body"`
+			Type       string `json:"type"`
+			Code       string `json:"code"`
+		}
+		if err := json.Unmarshal(payload["fail"], &fail); err != nil {
+			t.Fatalf("unmarshal fail: %v", err)
+		}
+		if fail.StatusCode != http.StatusServiceUnavailable || fail.Body != "" || fail.Type != "upstream" || fail.Code != "http_5xx" {
+			t.Fatalf("fail metadata = %+v", fail)
+		}
+		for _, field := range []string{"response_headers", "access_token_sha256", "response_model", "response_service_tier"} {
+			if _, ok := payload[field]; ok {
+				t.Fatalf("payload unexpectedly contains %q", field)
+			}
+		}
+		for _, field := range []string{"source", "endpoint", "client_ip", "resolved_client_ip", "x_forwarded_for", "user_agent"} {
+			requireStringField(t, payload, field, "")
+		}
+		requireStringField(t, payload, "auth_type", "unknown")
+		requireStringField(t, payload, "session_id", coreusage.DiagnosticSessionID(requestSecret))
+		requireMissingField(t, payload, "parent_session_id")
+		encoded, err := json.Marshal(payload)
+		if err != nil {
+			t.Fatalf("marshal payload for sentinel scan: %v", err)
+		}
+		for _, secret := range []string{requestSecret, responseSecret, headerSecret, authSecret, freeTextSecret, rawAPIKey} {
