@@ -0,0 +1,15 @@
+package config
+
+import "github.com/router-for-me/CLIProxyAPI/v8/internal/diagnostics"
+
+// ApplyMetadataOnlyDiagnostics keeps request and application logging disabled
+// whenever metadata-only diagnostics are opted in.
+func (cfg *Config) ApplyMetadataOnlyDiagnostics() {
+	if cfg == nil || !diagnostics.MetadataOnlyEnabled() {
+		return
+	}
+	cfg.CommercialMode = true
+	cfg.RequestLog = false
+	cfg.Debug = false
+	cfg.LoggingToFile = false
+}
