+func TestMetadataOnlyPreservesBillingTierAndNumericQuotaOnly(t *testing.T) {
+	_, got := RedactForMetadataOnly(context.Background(), Record{
+		Provider: "codex", ServiceTier: "priority", EffectiveServiceTier: "priority", ResponseServiceTier: "priority",
+		ResponseHeaders: http.Header{
+			"X-Codex-Primary-Used-Percent":          {"12.5"},
+			"X-Codex-Secondary-Reset-After-Seconds": {"30"},
+			"X-Codex-Primary-Window-Minutes":        {"secret"},
+			"X-Codex-Private-Used-Percent":          {"1"},
+			"Authorization":                         {"Bearer secret"},
+		},
+	})
+	if got.ServiceTier != "priority" || got.EffectiveServiceTier != "priority" || got.ResponseServiceTier != "priority" {
+		t.Fatal("billing tiers lost")
+	}
+	if len(got.ResponseHeaders) != 2 || got.ResponseHeaders.Get("X-Codex-Primary-Used-Percent") != "12.5" {
+		t.Fatal("safe quota fields lost or unsafe fields kept")
+	}
+	_, bad := RedactForMetadataOnly(context.Background(), Record{ServiceTier: "private", ResponseServiceTier: "private"})
+	if bad.ServiceTier != "" || bad.ResponseServiceTier != "" {
+		t.Fatal("arbitrary tier retained")
+	}
