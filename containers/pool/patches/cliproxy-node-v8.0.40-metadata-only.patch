+func TestMetadataOnlyHomeDispatchPreservesSelectedModel(t *testing.T) {
+	t.Setenv("CLIPROXY_DIAGNOSTICS_METADATA_ONLY", "1")
+	registry := executionregistry.New()
+	pending, errBegin := registry.BeginDispatch()
+	if errBegin != nil {
+		t.Fatal(errBegin)
+	}
+	scope, errInstall := registry.Install(pending, executionregistry.ScopeSpec{CredentialID: "home-only-credential", Model: "fixture-home-only-model"})
+	if errInstall != nil {
+		t.Fatal(errInstall)
+	}
+	selectedAuth := &Auth{ID: "home-only-credential", Provider: "home-only-provider", Attributes: map[string]string{homeUpstreamModelAttributeKey: "fixture-home-only-model"}}
+	selection, errSelection := newHomeDispatchSelection(selectedAuth, nil, "home-only-provider", scope)
+	if errSelection != nil {
+		t.Fatal(errSelection)
+	}
+	defer selection.End("test_finished")
+	ctx, release, errBind := homeExecutionAttemptContext(context.Background(), selection)
+	if errBind != nil {
+		t.Fatal(errBind)
+	}
+	defer release()
+	clean, record := coreusage.RedactForMetadataOnly(ctx, coreusage.Record{Provider: selection.Provider, AuthID: selectedAuth.ID, Model: "fixture-home-only-model"})
+	if record.Model != "fixture-home-only-model" {
