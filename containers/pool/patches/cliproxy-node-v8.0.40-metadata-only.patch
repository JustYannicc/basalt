+package config
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/diagnostics"
+)
+
+func TestMetadataOnlyDiagnosticsForcesLoadedAndParsedConfig(t *testing.T) {
+	t.Setenv(diagnostics.MetadataOnlyEnv, "1")
+	data := []byte("debug: true\ncommercial-mode: false\nlogging-to-file: true\nrequest-log: true\n")
+
+	parsed, err := ParseConfigBytes(data)
+	if err != nil {
+		t.Fatalf("ParseConfigBytes(): %v", err)
+	}
+	assertMetadataOnlyConfig(t, parsed)
+
+	path := filepath.Join(t.TempDir(), "config.yaml")
+	if err := os.WriteFile(path, data, 0600); err != nil {
+		t.Fatalf("write config: %v", err)
+	}
+	loaded, err := LoadConfigOptional(path, false)
+	if err != nil {
+		t.Fatalf("LoadConfigOptional(): %v", err)
+	}
+	assertMetadataOnlyConfig(t, loaded)
+
+	missing, err := LoadConfigOptional(filepath.Join(t.TempDir(), "missing.yaml"), true)
+	if err != nil {
+		t.Fatalf("LoadConfigOptional(missing optional config): %v", err)
+	}
+	assertMetadataOnlyConfig(t, missing)
+}
+
+func TestMetadataOnlyDiagnosticsLeavesOrdinaryConfigUnchanged(t *testing.T) {
+	t.Setenv(diagnostics.MetadataOnlyEnv, "")
+	cfg := &Config{SDKConfig: SDKConfig{RequestLog: true}, Debug: true, CommercialMode: false, LoggingToFile: true}
+	cfg.ApplyMetadataOnlyDiagnostics()
+	if !cfg.RequestLog || !cfg.Debug || cfg.CommercialMode || !cfg.LoggingToFile {
+		t.Fatalf("ordinary config changed: %+v", cfg)
+	}
+}
+
+func assertMetadataOnlyConfig(t *testing.T, cfg *Config) {
+	t.Helper()
+	if cfg == nil || !cfg.CommercialMode || cfg.RequestLog || cfg.Debug || cfg.LoggingToFile {
+		t.Fatalf("metadata-only config = %+v, want commercial mode with request, debug, and file logging off", cfg)
+	}
+}
