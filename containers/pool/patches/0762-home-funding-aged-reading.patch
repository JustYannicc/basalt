diff --git a/internal/home/usage_credits_stale_test.go b/internal/home/usage_credits_stale_test.go
new file mode 100644
index 0000000..05d14c3
--- /dev/null
+++ b/internal/home/usage_credits_stale_test.go
@@ -0,0 +1,173 @@
+package home
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	coreauth "github.com/router-for-me/CLIProxyAPIHome/internal/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPIHome/internal/registry"
+)
+
+// agingTierStore answers the tiers of the reading the collector last wrote.
+type agingTierStore struct {
+	ClusterAdapter
+	mu    sync.Mutex
+	tiers map[string]int
+	reads int
+}
+
+func (s *agingTierStore) UsageCreditRoutingForAPIKey(context.Context, string, string, map[string]string) (map[string]int, coreauth.AccountSelection, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.reads++
+	tiers := make(map[string]int, len(s.tiers))
+	for id, tier := range s.tiers {
+		tiers[id] = tier
+	}
+	return tiers, coreauth.AccountSelection{Policy: "reset_aware"}, nil
+}
+
+func (s *agingTierStore) set(id string, tier int) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.tiers[id] = tier
+}
+
+// probingCollector stands for the quota collector: a probe writes a fresh reading.
+type probingCollector struct {
+	store    *agingTierStore
+	fresh    map[string]int
+	block    chan struct{}
+	fail     error
+	mu       sync.Mutex
+	waited   int
+	triggers int
+}
+
+func (c *probingCollector) TriggerCollection(context.Context, map[string]struct{}, map[string]struct{}) (int, error) {
+	c.mu.Lock()
+	c.triggers++
+	c.mu.Unlock()
+	return 0, nil
+}
+
+func (c *probingCollector) CollectNow(ctx context.Context, ids map[string]struct{}) error {
+	c.mu.Lock()
+	c.waited++
+	c.mu.Unlock()
+	if c.fail != nil {
+		return c.fail
+	}
+	if c.block != nil {
+		select {
+		case <-c.block:
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+	}
+	for id := range ids {
+		if tier, ok := c.fresh[id]; ok {
+			c.store.set(id, tier)
+		}
+	}
+	return nil
+}
+
+func registerFundingAuth(t *testing.T, manager *coreauth.Manager, id string) {
+	t.Helper()
+	auth := &coreauth.Auth{ID: id, Provider: "claude", Status: coreauth.StatusActive, Attributes: map[string]string{"auth_kind": "oauth"}}
+	registry.GetGlobalRegistry().RegisterClient(id, "claude", []*registry.ModelInfo{{ID: "claude-opus-5-5"}})
+	t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(id) })
+	if _, errRegister := manager.Register(context.Background(), auth); errRegister != nil {
+		t.Fatal(errRegister)
+	}
+}
+
+// The production refusal: the only usable account's reading had aged out after 30 idle minutes.
+// The call must wait for the bounded collection and be served on the fresh reading.
+func TestUsageCreditAgedReadingIsRefreshedBeforeTheCallIsRefused(t *testing.T) {
+	manager := coreauth.NewManager(nil, &creditStickySelector{}, nil)
+	registerFundingAuth(t, manager, "only")
+	store := &agingTierStore{tiers: map[string]int{"only": 3}}
+	collector := &probingCollector{store: store, fresh: map[string]int{"only": 0}}
+	runtime := &Runtime{coreManager: manager, clusterAdapter: store}
+	runtime.SetUsageCreditCollector(collector)
+	result, errDispatch := runtime.DispatchForAPIKeyWithConcurrency(t.Context(), "claude-opus-5-5", nil, "pool-key", "", nil, "", DispatchConcurrencyContext{})
+	if errDispatch != nil || result == nil || result.AuthID != "only" {
+		t.Fatalf("an account whose fresh reading has quota was refused: %v", errDispatch)
+	}
+	if collector.waited != 1 {
+		t.Fatalf("waited for %d collections, want one", collector.waited)
+	}
+}
+
+// A collection that can't finish within the bound never holds the call past it, and a reading
+// that is still unusable after the refresh is refused as before.
+func TestUsageCreditRefreshIsBoundedAndAStillEmptyReadingIsRefused(t *testing.T) {
+	store := &agingTierStore{tiers: map[string]int{"empty": 3}}
+	collector := &probingCollector{store: store, fresh: map[string]int{"empty": 3}}
+	runtime := &Runtime{clusterAdapter: store}
+	runtime.SetUsageCreditCollector(collector)
+	var opts coreauth.Options
+	if !runtime.installUsageCreditFilter(t.Context(), "pool-key", "claude-opus-5-5", "", &opts) {
+		t.Fatal("filter unavailable")
+	}
+	selected, errFilter := opts.CandidateFilter([]*coreauth.Auth{{ID: "empty"}}, map[string]string{"empty": "claude-opus-5-5"})
+	if errFilter != nil || len(selected) != 0 {
+		t.Fatalf("a reading still empty after the refresh was admitted: %v", errFilter)
+	}
+	if store.reads != 2 {
+		t.Fatalf("read the funding %d times, want once before and once after the refresh", store.reads)
+	}
+
+	slow := &agingTierStore{tiers: map[string]int{"slow": 3}}
+	blocked := &probingCollector{store: slow, fresh: map[string]int{"slow": 0}, block: make(chan struct{})}
+	defer close(blocked.block)
+	slowRuntime := &Runtime{clusterAdapter: slow}
+	slowRuntime.SetUsageCreditCollector(blocked)
+	// The bound alone limits the wait: the caller's context has no deadline.
+	bound := usageCreditRefreshWait
+	usageCreditRefreshWait = 100 * time.Millisecond
+	t.Cleanup(func() { usageCreditRefreshWait = bound })
+	var slowOpts coreauth.Options
+	if !slowRuntime.installUsageCreditFilter(t.Context(), "pool-key", "claude-opus-5-5", "", &slowOpts) {
+		t.Fatal("filter unavailable")
+	}
+	started := time.Now()
+	selected, errFilter = slowOpts.CandidateFilter([]*coreauth.Auth{{ID: "slow"}}, map[string]string{"slow": "claude-opus-5-5"})
+	if elapsed := time.Since(started); elapsed > time.Second {
+		t.Fatalf("the refusal waited %s for a collection that never finished", elapsed)
+	}
+	if errFilter != nil || len(selected) != 0 {
+		t.Fatalf("an unrefreshed reading was admitted: %v", errFilter)
+	}
+	if blocked.waited != 1 {
+		t.Fatalf("waited for %d collections, want one", blocked.waited)
+	}
+}
+
+// A collection that could not start never blocks the next refusal from trying again.
+func TestUsageCreditFailedRefreshIsRetriedByTheNextRefusal(t *testing.T) {
+	store := &agingTierStore{tiers: map[string]int{"only": 3}}
+	collector := &probingCollector{store: store, fresh: map[string]int{"only": 0}, fail: errors.New("credentials unavailable")}
+	runtime := &Runtime{clusterAdapter: store}
+	runtime.SetUsageCreditCollector(collector)
+	var opts coreauth.Options
+	if !runtime.installUsageCreditFilter(t.Context(), "pool-key", "claude-opus-5-5", "", &opts) {
+		t.Fatal("filter unavailable")
+	}
+	if _, errFilter := opts.CandidateFilter([]*coreauth.Auth{{ID: "only"}}, map[string]string{"only": "claude-opus-5-5"}); errFilter == nil {
+		t.Fatal("a collection that could not start was reported as a funding decision")
+	}
+	collector.fail = nil
+	selected, errFilter := opts.CandidateFilter([]*coreauth.Auth{{ID: "only"}}, map[string]string{"only": "claude-opus-5-5"})
+	if errFilter != nil || len(selected) != 1 {
+		t.Fatalf("the next refusal did not retry the collection: %v", errFilter)
+	}
+	if collector.waited != 2 {
+		t.Fatalf("collections tried %d, want 2", collector.waited)
+	}
+}
