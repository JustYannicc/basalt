+)
+
+// A funding refusal waits on CollectNow: it must return only once the reading is written, and a
+// credential another round is already probing is waited for instead of probed twice.
+func TestCollectNowWaitsForTheProbeAndNeverProbesTwice(t *testing.T) {
+	repo := newCollectorTestRepository(t)
+	seedCollectorProviderAuth(t, repo, "codex-a", "codex", map[string]any{"type": "codex", "access_token": "probe-secret"})
+	var requests atomic.Int32
+	release := make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, request *http.Request) {
+		if request.URL.Path != "/codex" {
+			http.NotFound(w, request)
+			return
+		}
+		requests.Add(1)
+		<-release
+		_, _ = w.Write([]byte(`{"plan_type":"plus","rate_limit":{"primary_window":{"used_percent":10,"limit_window_seconds":18000,"reset_after_seconds":600,"reset_at":1784160600}}}`))
+	}))
+	defer server.Close()
+	collector := NewCollector(repo, Options{Owner: "home-a", CodexUsageURL: server.URL + "/codex", Now: func() time.Time { return time.Now().UTC() }})
+	defer collector.Wait()
+
+	if accepted, errTrigger := collector.TriggerCollection(context.Background(), map[string]struct{}{"codex-a": {}}, nil); errTrigger != nil || accepted != 1 {
+		t.Fatalf("TriggerCollection() = %d, %v", accepted, errTrigger)
+	}
+	waitForProbeRequests(t, &requests, 1)
+
+	done := make(chan error, 1)
+	go func() { done <- collector.CollectNow(context.Background(), map[string]struct{}{"codex-a": {}}) }()
+	select {
+	case errCollect := <-done:
+		t.Fatalf("CollectNow returned before the probe finished: %v", errCollect)
+	case <-time.After(100 * time.Millisecond):
+	}
+	close(release)
+	select {
+	case errCollect := <-done:
+		if errCollect != nil {
+			t.Fatalf("CollectNow() error = %v", errCollect)
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatal("CollectNow never returned")
+	}
+	if got := requests.Load(); got != 1 {
+		t.Fatalf("probed %d times, want the one in-flight probe", got)
+	}
+	snapshot, errSnapshot := repo.GetQuotaCredential(context.Background(), "codex-a", time.Now().UTC())
+	if errSnapshot != nil || snapshot == nil || snapshot.Freshness != "fresh" {
+		t.Fatalf("CollectNow returned without a fresh reading: %+v, %v", snapshot, errSnapshot)
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), 50*time.Millisecond)
+	defer cancel()
+	slow := make(chan struct{})
+	slowServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) { <-slow }))
+	defer slowServer.Close()
+	defer close(slow)
+	slowCollector := NewCollector(repo, Options{Owner: "home-b", CodexUsageURL: slowServer.URL, Now: func() time.Time { return time.Now().UTC() }})
+	if errCollect := slowCollector.CollectNow(ctx, map[string]struct{}{"codex-a": {}}); errCollect == nil {
+		t.Fatal("CollectNow outlived its deadline")
+	}
+}
