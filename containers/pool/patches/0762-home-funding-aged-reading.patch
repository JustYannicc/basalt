+// CollectNow runs a forced collection of the given credentials and returns once each has
+// finished, or when ctx ends. A credential another on-demand round is already collecting is
+// waited for, not collected twice. The collection itself outlives ctx.
+func (c *Collector) CollectNow(ctx context.Context, credentialIDs map[string]struct{}) error {
+	if c == nil || c.repo == nil {
+		return fmt.Errorf("quota collector is unavailable")
+	}
+	if len(credentialIDs) == 0 {
+		return nil
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	auths, errAuths := c.repo.ListAuths(ctx)
+	if errAuths != nil {
+		return errAuths
+	}
+	accepted := make([]*coreauth.Auth, 0, len(credentialIDs))
+	waits := make([]chan struct{}, 0, len(credentialIDs))
+	c.onDemandMu.Lock()
+	for _, auth := range auths {
+		if !quotaProbeEligible(auth) {
+			continue
+		}
+		credentialID := strings.TrimSpace(auth.ID)
+		if _, ok := credentialIDs[credentialID]; !ok {
+			continue
+		}
+		if done, exists := c.onDemandJobs[credentialID]; exists {
+			waits = append(waits, done)
+			continue
+		}
+		done := make(chan struct{})
+		c.onDemandJobs[credentialID] = done
+		waits = append(waits, done)
+		accepted = append(accepted, auth)
+	}
+	c.onDemandMu.Unlock()
+	c.startOnDemand(ctx, accepted)
+	for _, done := range waits {
+		select {
+		case <-done:
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+	}
+	return nil
+}
+
+func (c *Collector) startOnDemand(ctx context.Context, accepted []*coreauth.Auth) {
+	if len(accepted) == 0 {
+		return
+	}
+	c.background.Add(1)
+	go func() {
+		defer c.background.Done()
+		c.collectCredentials(context.WithoutCancel(ctx), accepted, true)
+	}()
+}
+
 // Wait waits for asynchronous on-demand collection rounds to finish. It is
 // primarily useful for deterministic tests.
 func (c *Collector) Wait() {
@@ -311,7 +365,11 @@ func (c *Collector) releaseOnDemandJob(auth *coreauth.Auth) {
 		return
 	}
