@@ -0,0 +1,58 @@
+package cluster
+
+import (
+	"testing"
+	"time"
+)
+
+// An idle account's readings age out 30 minutes after their last probe. How such an account is
+// classified decides whether the pool serves it or refuses the call outright.
+func TestUsageCreditAgedPlanReadingWithCreditsOff(t *testing.T) {
+	now := time.Unix(100_000, 0).UTC()
+	observed := now.Add(-31 * time.Minute)
+	aged := observed.Add(30 * time.Minute)
+	fresh := now.Add(29 * time.Minute)
+	reset := now.Add(72 * time.Hour)
+	remaining, empty := .72, 0.0
+	reading := func(freshness string, windowExpires time.Time, ratio *float64, creditsExpire time.Time) QuotaCredentialSnapshot {
+		return QuotaCredentialSnapshot{
+			Provider: "claude", CredentialType: "oauth", CredentialStatus: "enabled", Freshness: freshness, ObservedAt: &observed,
+			Windows: []QuotaWindow{{ID: "claude-seven-day", Scope: "account", RemainingRatio: ratio, ObservedAt: observed, ExpiresAt: &windowExpires, ResetAt: &reset}},
+			// Extra usage off at the vendor: the collector reads it as disabled and blocked.
+			UsageCredits: &QuotaUsageCredits{State: "disabled", CreditBlocked: true, ObservedAt: observed, ExpiresAt: creditsExpire},
+		}
+	}
+	cases := []struct {
+		name string
+		item QuotaCredentialSnapshot
+		want int
+	}{
+		{"an aged plan reading that left quota, with credits known off, stays on its plan", reading("stale", aged, &remaining, fresh), 0},
+		{"an aged plan reading with an aged credits reading is unknown, never refused outright", reading("stale", aged, &remaining, aged), 2},
+		{"a plan last seen empty before its reset stays out, credits known off", reading("stale", aged, &empty, fresh), 3},
+		{"a plan last seen empty before its reset stays out, credits aged", reading("stale", aged, &empty, aged), 3},
+		{"a fresh empty plan with credits off stays out", reading("fresh", fresh, &empty, fresh), 3},
+		{"a fresh plan with quota is on its plan", reading("fresh", fresh, &remaining, fresh), 0},
+	}
+	for _, c := range cases {
+		if got := usageCreditFundingTier(c.item, "claude-opus-5-5", now); got != c.want {
+			t.Errorf("%s: tier %d, want %d", c.name, got, c.want)
+		}
+	}
+	past := now.Add(-time.Minute)
+	reopened := reading("stale", aged, &empty, fresh)
+	reopened.Windows[0].ResetAt = &past
+	if got := usageCreditFundingTier(reopened, "claude-opus-5-5", now); got != 2 {
+		t.Errorf("a plan whose empty window has since reset must be unknown, neither refused nor proven: tier %d", got)
+	}
+	unproven := reading("fresh", fresh, nil, fresh)
+	if got := usageCreditFundingTier(unproven, "claude-opus-5-5", now); got != 2 {
+		t.Errorf("credits off without any plan reading proved the plan: tier %d", got)
+	}
+	// A blocked flag on a reading of another state contradicts itself: it only ever refuses.
+	contradictory := reading("stale", aged, &remaining, fresh)
+	contradictory.UsageCredits.State = "unknown"
+	if got := usageCreditFundingTier(contradictory, "gpt-5.5", now); got != 3 {
+		t.Errorf("a contradictory credits reading admitted the account: tier %d", got)
+	}
+}
