@@ -0,0 +1,69 @@
+package cluster
+
+import (
+	"encoding/json"
+	"testing"
+	"time"
+
+	coreauth "github.com/router-for-me/CLIProxyAPIHome/internal/cliproxy/auth"
+)
+
+func TestRoutingOutlookRequiresMatchingForecastAndOwnsBytes(t *testing.T) {
+	now := time.Date(2026, 11, 13, 0, 0, 0, 0, time.UTC)
+	model := "opus"
+	input := coreauth.RoutingDemandInput{ModelFamily: &model, Provider: "claude", Revision: "test", Source: "history-forecast", CalculatedAt: now, ValidUntil: now.Add(time.Minute)}
+	payload, _ := json.Marshal(map[string]any{"provider": "claude", "modelFamily": "opus", "from": now, "through": now.Add(24 * time.Hour), "evidence": map[string]any{"source": input.Source, "revision": input.Revision, "calculatedAt": now, "validUntil": input.ValidUntil}})
+	result, err := validatedRoutingOutlooks([]json.RawMessage{payload}, []coreauth.RoutingDemandInput{input}, now)
+	if err != nil || len(result) != 1 {
+		t.Fatalf("valid: %v", err)
+	}
+	before := string(result[0].payload)
+	payload[0] = '!'
+	if string(result[0].payload) != before {
+		t.Fatal("caller retained mutable cache bytes")
+	}
+	for _, inputs := range [][]coreauth.RoutingDemandInput{nil, {{Provider: "claude", Revision: "other", Source: input.Source, CalculatedAt: now, ValidUntil: input.ValidUntil}}} {
+		if _, err = validatedRoutingOutlooks([]json.RawMessage{json.RawMessage(before)}, inputs, now); err == nil {
+			t.Fatal("unmatched forecast admitted")
+		}
+	}
+}
+
+func TestRoutingDecisionRetentionDoesNotServeExpiredIdleHistory(t *testing.T) {
+	now := time.Date(2026, 11, 13, 0, 0, 0, 0, time.UTC)
+	repo := &Repository{}
+	adapter := &RuntimeAdapter{repo: repo}
+	selection := &coreauth.AccountSelection{Groups: []uint{7}, Decision: &coreauth.RoutingDecision{At: now}}
+	adapter.RecordRoutingDecision(nil, selection)
+	if len(repo.RoutingDecisions(7, 0, 20, now).Decisions) != 1 {
+		t.Fatal("missing current decision")
+	}
+	if len(repo.RoutingDecisions(8, 0, 20, now).Decisions) != 0 {
+		t.Fatal("cross-group history")
+	}
+	expired := repo.RoutingDecisions(7, 0, 20, now.Add(25*time.Hour))
+	if !expired.Retention.Truncated || !expired.Retention.From.Equal(now.Add(time.Hour)) {
+		t.Fatal("idle expiry hid the retention gap", expired.Retention)
+	}
+	if len(expired.Decisions) != 0 {
+		t.Fatal("expired idle history returned")
+	}
+}
+
+func TestRoutingOutlookRequiresExactNullableModelScope(t *testing.T) {
+	now := time.Date(2026, 11, 13, 0, 0, 0, 0, time.UTC)
+	providerWide := coreauth.RoutingDemandInput{Provider: "claude", Revision: "test", Source: "history-forecast", CalculatedAt: now, ValidUntil: now.Add(time.Minute)}
+	payload := func(model any) json.RawMessage {
+		bytes, errEncode := json.Marshal(map[string]any{"provider": "claude", "modelFamily": model, "from": now, "through": now.Add(24 * time.Hour), "evidence": map[string]any{"source": providerWide.Source, "revision": providerWide.Revision, "calculatedAt": now, "validUntil": providerWide.ValidUntil}})
+		if errEncode != nil {
+			t.Fatal(errEncode)
+		}
+		return bytes
+	}
+	if _, errScope := validatedRoutingOutlooks([]json.RawMessage{payload("opus")}, []coreauth.RoutingDemandInput{providerWide}, now); errScope == nil {
+		t.Fatal("provider-wide input authorized a model-specific capacity claim")
+	}
+	if _, errScope := validatedRoutingOutlooks([]json.RawMessage{payload(nil)}, []coreauth.RoutingDemandInput{providerWide}, now); errScope != nil {
+		t.Fatal(errScope)
+	}
+}
diff --git a/internal/cluster/routing_scope.go b/internal/cluster/routing_scope.go
new file mode 100644
index 0000000..b730190
--- /dev/null
+++ b/internal/cluster/routing_scope.go
@@ -0,0 +1,77 @@
+package cluster
+
+import (
+	"context"
+	"fmt"
+	"sort"
+)
+
+type routingScope struct {
+	key     string
+	groups  []ChannelGroupRecord
+	members map[string]bool
+}
+
+func routingScopeIDs(groups []uint) []uint {
+	unique := make(map[uint]bool, len(groups))
+	ids := make([]uint, 0, len(groups))
+	for _, id := range groups {
+		if !unique[id] {
+			unique[id] = true
+			ids = append(ids, id)
+		}
+	}
+	sort.Slice(ids, func(i, j int) bool { return ids[i] < ids[j] })
+	return ids
+}
+func routingScopeKey(groups []uint) string { return fmt.Sprint(routingScopeIDs(groups)) }
+
+// Duplicate channel groups for one pool are one scheduling scope. A profile may
+// never combine unrelated pools or validate a full pool against one partial group.
+func (r *Repository) loadRoutingScope(ctx context.Context, groups []uint) (routingScope, error) {
+	ids := routingScopeIDs(groups)
+	result := routingScope{key: routingScopeKey(ids), members: make(map[string]bool)}
+	if len(ids) == 0 || len(ids) > 32 || ids[0] == 0 {
+		return result, fmt.Errorf("routing scope needs one to thirty-two channel groups")
+	}
+	name := ""
+	for _, id := range ids {
+		record, errGroup := r.GetChannelGroup(ctx, id)
+		if errGroup != nil {
+			return result, errGroup
+		}
+		if record.Disabled || name != "" && record.ChannelName != name {
+			return result, fmt.Errorf("routing scope groups must be enabled parts of one pool")
+		}
+		name = record.ChannelName
+		result.groups = append(result.groups, *record)
+		details, errDetails := r.ListChannelGroupDetails(ctx, ChannelGroupDetailFilter{ChannelGroupID: &id})
+		if errDetails != nil {
+			return result, errDetails
+		}
+		for _, detail := range details {
+			result.members[detail.AuthID] = true
+		}
+	}
+	return result, nil
+}
+
+func (r *Repository) ResolveRoutingGroups(ctx context.Context, anchor uint, groups []uint) ([]uint, error) {
+	if len(groups) == 0 {
+		groups = []uint{anchor}
+	}
+	ids := routingScopeIDs(groups)
+	found := false
+	for _, id := range ids {
+		if id == anchor {
+			found = true
+		}
+	}
+	if !found {
+		return nil, fmt.Errorf("routing scope must include the route's channel group")
+	}
+	if _, errScope := r.loadRoutingScope(ctx, ids); errScope != nil {
+		return nil, errScope
+	}
+	return ids, nil
+}
diff --git a/internal/cluster/routing_state.go b/internal/cluster/routing_state.go
new file mode 100644
index 0000000..128e3aa
--- /dev/null
+++ b/internal/cluster/routing_state.go
@@ -0,0 +1,267 @@
+package cluster
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"strconv"
+	"time"
+
+	coreauth "github.com/router-for-me/CLIProxyAPIHome/internal/cliproxy/auth"
+)
+
+type routingStoredDecision struct {
+	groups   []uint
+	sequence uint64
+	at       time.Time
+	bytes    []byte
+}
+
+type routingState struct {
+	outlooks  map[string][]routingOutlook
+	inputs    map[string][]coreauth.RoutingDemandInput
+	decisions []routingStoredDecision
+	bytes     int
+	sequence  uint64
+	started   time.Time
+	truncated bool
+}
+
+type RoutingDecisionPage struct {
+	Capacity  []json.RawMessage          `json:"capacity"`
+	Current   []coreauth.RoutingCurrent  `json:"current"`
+	Decisions []coreauth.RoutingDecision `json:"decisions"`
+	Next      *string                    `json:"next"`
+	Retention RoutingRetention           `json:"retention"`
+}
+
+type RoutingRetention struct {
+	From        time.Time `json:"from"`
+	Through     time.Time `json:"through"`
+	Truncated   bool      `json:"truncated"`
+	Persistence string    `json:"persistence"`
+}
+
+func (r *Repository) routingStateLocked(now time.Time) *routingState {
+	if r.routing == nil {
+		r.routing = &routingState{inputs: make(map[string][]coreauth.RoutingDemandInput), outlooks: make(map[string][]routingOutlook), started: now}
+	}
+	return r.routing
+}
+
+func (r *Repository) SetRoutingDemand(ctx context.Context, group uint, inputs []coreauth.RoutingDemandInput, replaceSources []string, now time.Time, payloads ...json.RawMessage) error {
+	return r.SetRoutingDemandForGroups(ctx, []uint{group}, inputs, replaceSources, now, payloads...)
+}
+
+func (r *Repository) SetRoutingDemandForGroups(ctx context.Context, groups []uint, inputs []coreauth.RoutingDemandInput, replaceSources []string, now time.Time, payloads ...json.RawMessage) error {
+	if len(inputs) > 12 || len(inputs) == 0 && len(replaceSources) == 0 || len(replaceSources) > 2 {
+		return fmt.Errorf("one to twelve routing demand inputs required")
+	}
+	for _, source := range replaceSources {
+		if source != "history-forecast" && source != "observed-quota-burn" {
+			return fmt.Errorf("unsupported routing demand replacement source")
+		}
+	}
+	scope, errScope := r.loadRoutingScope(ctx, groups)
+	if errScope != nil {
+		return errScope
+	}
+	group, members := scope.key, scope.members
+	if errValid := validateRoutingDemand(inputs, members, now); errValid != nil {
+		return errValid
+	}
+	outlooks, errOutlooks := validatedRoutingOutlooks(payloads, inputs, now)
+	if errOutlooks != nil {
+		return errOutlooks
+	}
+	bytes, errEncode := json.Marshal(inputs)
+	if errEncode != nil || len(bytes) > 512*1024 {
+		return fmt.Errorf("routing demand exceeds its bounded representation")
+	}
+	var owned []coreauth.RoutingDemandInput
+	if errDecode := json.Unmarshal(bytes, &owned); errDecode != nil {
+		return errDecode
+	}
+	r.routingMu.Lock()
+	defer r.routingMu.Unlock()
+	state := r.routingStateLocked(now)
+	if len(state.inputs) >= 4096 && state.inputs[group] == nil {
+		for id, entries := range state.inputs {
+			expired := true
+			for _, entry := range entries {
+				if entry.ValidUntil.After(now) {
+					expired = false
+				}
+			}
+			if expired {
+				delete(state.inputs, id)
+				delete(state.outlooks, id)
+			}
+		}
+		if len(state.inputs) >= 4096 {
+			return fmt.Errorf("routing demand cache at capacity")
+		}
+	}
+	merged := make([]coreauth.RoutingDemandInput, 0, len(state.inputs[group]))
+	for _, old := range state.inputs[group] {
+		if !old.ValidUntil.After(now) {
+			continue
+		}
+		replaced := false
+		for _, source := range replaceSources {
+			if old.Source == source {
+				replaced = true
+			}
+		}
+		for _, input := range owned {
+			sameModel := old.ModelFamily == nil && input.ModelFamily == nil || old.ModelFamily != nil && input.ModelFamily != nil && *old.ModelFamily == *input.ModelFamily
+			if old.Provider == input.Provider && old.Source == input.Source && sameModel {
+				if old.CalculatedAt.After(input.CalculatedAt) {
+					return fmt.Errorf("routing demand update is older than the retained input")
+				}
+				replaced = true
+			}
+		}
+		if !replaced {
+			merged = append(merged, old)
+		}
+	}
+	if len(merged)+len(owned) > 24 {
+		return fmt.Errorf("routing demand cohort limit exceeded")
+	}
+	state.inputs[group] = append(merged, owned...)
+	for _, source := range replaceSources {
+		if source == "history-forecast" {
+			state.outlooks[group] = outlooks
+		}
+	}
+	return nil
+}
+
+func (r *Repository) routingDemandForGroups(groups []uint, now time.Time) []coreauth.RoutingDemandInput {
+	if len(groups) == 0 || len(groups) > 32 {
+		return nil
+	}
+	r.routingMu.Lock()
+	defer r.routingMu.Unlock()
+	if r.routing == nil {
+		return nil
+	}
+	// Validated inputs are immutable after publication. Selection owns the outer
+	// slice but only reads the shared profile, avoiding JSON work per request.
+	return append([]coreauth.RoutingDemandInput{}, r.routing.inputs[routingScopeKey(groups)]...)
+}
+
+func (a *RuntimeAdapter) RecordRoutingDecision(_ context.Context, selection *coreauth.AccountSelection) {
+	if selection == nil || selection.Decision == nil || len(selection.Groups) == 0 {
+		return
+	}
+	a.repo.routingMu.Lock()
+	defer a.repo.routingMu.Unlock()
+	now := selection.Decision.At
+	state := a.repo.routingStateLocked(now)
+	state.sequence++
+	selection.Decision.ID = state.started.UTC().Format("20060102T150405.000000000") + "." + strconv.FormatUint(state.sequence, 10)
+	bytes, errEncode := json.Marshal(selection.Decision)
+	if errEncode != nil || len(bytes) > 1024*1024 {
+		return
+	}
+	state.decisions = append(state.decisions, routingStoredDecision{groups: append([]uint{}, selection.Groups...), sequence: state.sequence, at: now, bytes: bytes})
+	state.bytes += len(bytes)
+	pruneRoutingDecisions(state, now)
+}
+
+func (r *Repository) RoutingDecisions(group uint, before uint64, limit int, now time.Time) RoutingDecisionPage {
+	return r.RoutingDecisionsForGroups([]uint{group}, before, limit, now)
+}
+func (r *Repository) RoutingDecisionsForGroups(groups []uint, before uint64, limit int, now time.Time) RoutingDecisionPage {
+	group := routingScopeKey(groups)
+	r.routingMu.Lock()
+	defer r.routingMu.Unlock()
+	state := r.routingStateLocked(now)
+	pruneRoutingDecisions(state, now)
+	page := RoutingDecisionPage{Capacity: []json.RawMessage{}, Decisions: []coreauth.RoutingDecision{}, Retention: RoutingRetention{From: state.started, Through: now, Truncated: state.truncated, Persistence: "runtime"}}
+	for _, outlook := range state.outlooks[group] {
+		if outlook.expires.After(now) {
+			page.Capacity = append(page.Capacity, append(json.RawMessage(nil), outlook.payload...))
+		}
+	}
+	if state.truncated {
+		if len(state.decisions) > 0 {
+			page.Retention.From = state.decisions[0].at
+		} else if cutoff := now.Add(-24 * time.Hour); cutoff.After(state.started) {
+			page.Retention.From = cutoff
+		}
+	}
+	if limit < 1 || limit > 50 {
+		limit = 20
+	}
+	lastSequence := uint64(0)
+	for index := len(state.decisions) - 1; index >= 0; index-- {
+		stored := state.decisions[index]
+		if now.Sub(stored.at) > 24*time.Hour {
+			continue
+		}
+		if before > 0 && stored.sequence >= before {
+			continue
+		}
+		matches := false
+		for _, id := range stored.groups {
+			for _, wanted := range groups {
+				if id == wanted {
+					matches = true
+					break
+				}
+			}
+		}
+		if !matches {
+			continue
+		}
+		if len(page.Decisions) == limit {
+			cursor := strconv.FormatUint(lastSequence, 10)
+			page.Next = &cursor
+			break
+		}
+		var decision coreauth.RoutingDecision
+		if json.Unmarshal(stored.bytes, &decision) == nil {
+			page.Decisions = append(page.Decisions, decision)
+			lastSequence = stored.sequence
+		}
+	}
+	return page
+}
+
+func (r *Repository) DeleteRoutingDemand(group uint, source string) {
+	r.DeleteRoutingDemandForGroups([]uint{group}, source)
+}
+func (r *Repository) DeleteRoutingDemandForGroups(groups []uint, source string) {
+	group := routingScopeKey(groups)
+	r.routingMu.Lock()
+	defer r.routingMu.Unlock()
+	if r.routing == nil {
+		return
+	}
+	if source == "history-forecast" {
+		delete(r.routing.outlooks, group)
+	}
+	kept := make([]coreauth.RoutingDemandInput, 0, len(r.routing.inputs[group]))
+	for _, input := range r.routing.inputs[group] {
+		if input.Source != source {
+			kept = append(kept, input)
+		}
+	}
+	if len(kept) == 0 {
+		delete(r.routing.inputs, group)
+	} else {
+		r.routing.inputs[group] = kept
+	}
+}
+
+func pruneRoutingDecisions(state *routingState, now time.Time) {
+	for len(state.decisions) > 256 || state.bytes > 4*1024*1024 || len(state.decisions) > 0 && now.Sub(state.decisions[0].at) > 24*time.Hour {
+		state.bytes -= len(state.decisions[0].bytes)
+		state.decisions[0] = routingStoredDecision{}
+		state.decisions = state.decisions[1:]
+		state.truncated = true
+	}
+}
