index 0000000..1d89a87
--- /dev/null
+++ b/internal/home/quota_deadline_dispatch_test.go
@@ -0,0 +1,77 @@
+package home
+
+import (
+	"context"
+	"net/http"
+	"testing"
+	"time"
+
+	coreauth "github.com/router-for-me/CLIProxyAPIHome/internal/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPIHome/internal/config"
+	"github.com/router-for-me/CLIProxyAPIHome/internal/registry"
+)
+
+type routingDispatchStore struct {
+	selectionStore
+	decisions []*coreauth.RoutingDecision
+}
+
+func (s *routingDispatchStore) RecordRoutingDecision(_ context.Context, selection *coreauth.AccountSelection) {
+	s.decisions = append(s.decisions, selection.Decision)
+}
+
+func TestQuotaDeadlinePublicDispatchUsesEligibleProviderWithTwoInstalledProviders(t *testing.T) {
+	now := time.Now().UTC()
+	store := &routingDispatchStore{selectionStore: selectionStore{tiers: map[string]int{"forecast-a": 0, "forecast-b": 0, "other-provider": 0}, selection: coreauth.AccountSelection{Policy: "reset_aware", Ranks: map[string]coreauth.QuotaResetRank{}}}}
+	for index, id := range []string{"forecast-a", "forecast-b"} {
+		store.selection.Ranks[id] = coreauth.QuotaResetRank{ResetAt: now.Add(time.Duration(1+3*index) * 24 * time.Hour), ExpiresAt: now.Add(time.Hour), ObservedAt: now, Headroom: .8, WindowSeconds: 604800}
+	}
+	store.selection.Demand = []coreauth.RoutingDemandInput{{Provider: "claude", Revision: "forecast", Source: "history-forecast", CalculatedAt: now, ValidUntil: now.Add(time.Hour), History: coreauth.RoutingDemandHistory{CoverageRatio: 1}, Windows: []coreauth.RoutingDemandWindow{{Seconds: 604800, Accounts: []coreauth.RoutingDemandAccount{{Account: "forecast-a", Full: 100, Known: true}, {Account: "forecast-b", Full: 100, Known: true}}, Intervals: []coreauth.RoutingDemandInterval{{From: now, To: now.Add(24 * time.Hour), Demand: coreauth.RoutingDemandRange{Median: 40}}}}}}}
+	manager := coreauth.NewManager(nil, selectorFromConfig(&config.Config{}, nil), nil)
+	for _, entry := range []struct{ id, provider, model string }{{"forecast-a", "claude", "opus"}, {"forecast-b", "claude", "opus"}, {"other-provider", "codex", "gpt"}} {
+		auth := &coreauth.Auth{ID: entry.id, Provider: entry.provider, Status: coreauth.StatusActive, Attributes: map[string]string{"auth_kind": "oauth"}}
+		registry.GetGlobalRegistry().RegisterClient(entry.id, entry.provider, []*registry.ModelInfo{{ID: entry.model}})
+		t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(entry.id) })
+		if _, errRegister := manager.Register(t.Context(), auth); errRegister != nil {
+			t.Fatal(errRegister)
+		}
+	}
+	runtime := &Runtime{coreManager: manager, clusterAdapter: store}
+	for range 100 {
+		result, errDispatch := runtime.DispatchForAPIKeyWithConcurrency(t.Context(), "opus", nil, "fixture-key", "", nil, "", DispatchConcurrencyContext{})
+		if errDispatch != nil || result.AuthID != "forecast-a" {
+			t.Fatalf("mixed provider label lost forecast: result=%+v err=%v", result, errDispatch)
+		}
+	}
+	if len(store.decisions) != 100 || store.decisions[0].Mode != "forecast-paced" {
+		t.Fatalf("forecast trace disagrees with dispatch: %+v", store.decisions)
+	}
+}
+
+func TestConfigBuiltWeightedAffinityReleasesZeroWeightAccount(t *testing.T) {
+	for _, policy := range []string{"", "weighted"} {
+		t.Run(policy, func(t *testing.T) {
+			cfg := &config.Config{}
+			cfg.Routing.Strategy = "weighted-round-robin"
+			cfg.Routing.SessionAffinity = true
+			selector := selectorFromConfig(cfg, nil)
+			if stoppable, ok := selector.(interface{ Stop() }); ok {
+				t.Cleanup(stoppable.Stop)
+			}
+			accounts := []*coreauth.Auth{{ID: "weighted-a", Provider: "codex", Status: coreauth.StatusActive, Attributes: map[string]string{"weight": "3"}}, {ID: "weighted-b", Provider: "codex", Status: coreauth.StatusActive, Attributes: map[string]string{"weight": "1"}}}
+			opts := coreauth.Options{Headers: http.Header{"X-Session-Id": []string{"fixture-weighted-session"}}}
+			if policy != "" {
+				opts.AccountSelection = &coreauth.AccountSelection{Policy: policy}
+			}
+			first, errFirst := selector.Pick(t.Context(), "codex", "gpt", opts, accounts)
+			if errFirst != nil || first.ID != "weighted-a" {
+				t.Fatalf("initial: %v %v", first, errFirst)
+			}
+			accounts[0].Attributes["weight"] = "0"
+			next, errNext := selector.Pick(t.Context(), "codex", "gpt", opts, accounts)
+			if errNext != nil || next.ID != "weighted-b" {
+				t.Fatalf("zero-weight binding survived wrapper: %v %v", next, errNext)
+			}
+		})
+	}
+}
