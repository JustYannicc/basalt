+package auth
+
+import (
+	"math"
+	"testing"
+	"time"
+)
+
+func TestIdleRoutingSnapshotKeepsDeadlineWeightsAndIsReadOnly(t *testing.T) {
+	now := time.Date(2026, 11, 13, 0, 0, 0, 0, time.UTC)
+	accounts := []*Auth{{ID: "a"}, {ID: "b"}}
+	selection := &AccountSelection{Policy: "reset_aware", PlanFunded: true, Ranks: map[string]QuotaResetRank{}}
+	for index, account := range accounts {
+		selection.Ranks[account.ID] = QuotaResetRank{ResetAt: now.Add(time.Duration(1+3*index) * 24 * time.Hour), ExpiresAt: now.Add(5 * time.Minute), ObservedAt: now, Headroom: .8, WindowSeconds: 604800}
+	}
+	first := ComputeRoutingCurrent(selection, "claude", accounts, now)
+	for i := 0; i < 100; i++ {
+		current := ComputeRoutingCurrent(selection, "claude", accounts, now)
+		if current.Plan.Candidates[0].Weight == nil || math.Abs(*current.Plan.Candidates[0].Weight-.8) > 1e-9 {
+			t.Fatalf("expected 80/20 without traffic: %+v", current)
+		}
+	}
+	if first.Plan.Mode != "deadline-rate" || selection.Decision != nil || !first.ValidUntil.Equal(now.Add(time.Minute)) {
+		t.Fatalf("snapshot mutated selection or lied: %+v", first)
+	}
+	stale := ComputeRoutingCurrent(selection, "claude", accounts, now.Add(6*time.Minute))
+	if stale.Status != "unavailable" || stale.Plan.Mode != "balanced-fallback" {
+		t.Fatalf("stale snapshot claimed current weights: %+v", stale)
+	}
+}
+
+func TestRoutingForecastFamilyMatchesCanonicalModelTokens(t *testing.T) {
+	for _, example := range []struct {
+		family, model string
+		want          bool
+	}{
+		{"opus", "claude-opus-5-5-thinking", true}, {"gpt-5.2", "gpt-5.2-codex", true},
+		{"opus", "octopus", false}, {"gpt-5", "gpt-50", false}, {"opus", "", false},
+	} {
+		if got := routingModelFamilyMatches(example.family, example.model); got != example.want {
+			t.Fatalf("%s %s: %v", example.family, example.model, got)
+		}
+	}
+}
+
+func TestCurrentSnapshotExpiresAtEveryPacingReset(t *testing.T) {
+	now := time.Date(2026, 11, 13, 0, 0, 0, 0, time.UTC)
+	main := now.Add(10 * time.Second)
+	short := now.Add(5 * time.Second)
+	rank := QuotaResetRank{Headroom: .8, ResetAt: main, ExpiresAt: now.Add(time.Hour), ObservedAt: now, WindowSeconds: 604800, Short: &QuotaGateRank{Headroom: .8, ResetAt: &short, Mode: "fixed"}}
+	selection := &AccountSelection{Policy: "reset_aware", PlanFunded: true, Ranks: map[string]QuotaResetRank{"a": rank}}
+	current := ComputeRoutingCurrent(selection, "claude", []*Auth{{ID: "a", Provider: "claude"}}, now)
+	if !current.ValidUntil.Equal(short) {
+		t.Fatalf("valid beyond short refill: %v", current.ValidUntil)
+	}
+	rank.Short = nil
+	selection.Ranks["a"] = rank
+	current = ComputeRoutingCurrent(selection, "claude", []*Auth{{ID: "a", Provider: "claude"}}, now)
+	if !current.ValidUntil.Equal(main) {
+		t.Fatalf("valid beyond main refill: %v", current.ValidUntil)
+	}
+}
diff --git a/internal/cliproxy/auth/routing_trace.go b/internal/cliproxy/auth/routing_trace.go
new file mode 100644
index 0000000..45e9003
--- /dev/null
+++ b/internal/cliproxy/auth/routing_trace.go
@@ -0,0 +1,182 @@
+package auth
+
+import (
+	"sort"
+	"time"
+)
+
+type RoutingAttempt struct {
+	Account string `json:"account"`
+	Outcome string `json:"outcome"`
+}
+
+type RoutingEvidence struct {
+	Revision     string               `json:"revision"`
+	Source       string               `json:"source"`
+	Confidence   string               `json:"confidence"`
+	CalculatedAt time.Time            `json:"calculatedAt"`
+	ValidUntil   time.Time            `json:"validUntil"`
+	History      RoutingDemandHistory `json:"history"`
+	Unit         *RoutingUnit         `json:"unit"`
+}
+
+type RoutingCandidate struct {
+	Account          string          `json:"account"`
+	Eligible         bool            `json:"eligible"`
+	Funding          string          `json:"funding"`
+	Reason           string          `json:"reason"`
+	Quota            *QuotaResetRank `json:"quota"`
+	ProjectedEmptyAt *time.Time      `json:"projectedEmptyAt"`
+	EmptyProjection  string          `json:"emptyProjection"`
+	TargetBurnRate   *float64        `json:"targetBurnRate"`
+	Weight           *float64        `json:"weight"`
+}
+
+type RoutingDecision struct {
+	ID                 string             `json:"id"`
+	At                 time.Time          `json:"at"`
+	Model              string             `json:"model"`
+	ConfiguredStrategy string             `json:"configuredStrategy"`
+	EffectiveStrategy  string             `json:"effectiveStrategy"`
+	Mode               string             `json:"mode"`
+	Reason             string             `json:"reason"`
+	Forecast           *RoutingEvidence   `json:"forecast"`
+	TargetThrough      *time.Time         `json:"targetThrough"`
+	Candidates         []RoutingCandidate `json:"candidates"`
+	ChosenAccount      *string            `json:"chosenAccount"`
+	Outcome            string             `json:"outcome"`
+	Attempts           []RoutingAttempt   `json:"attempts"`
+}
+
+func RoutingStrategy(policy string) string {
+	switch policy {
+	case "balanced":
+		return "round-robin"
+	case "fill_first":
+		return "fill-first"
+	case "weighted":
+		return "weighted-round-robin"
+	default:
+		return "quota-deadline"
+	}
+}
+
+func routingTrace(selection *AccountSelection, available []*Auth, model string, now time.Time, weights map[string]float64, input *RoutingDemandInput, through *time.Time) *RoutingDecision {
+	trace := &RoutingDecision{At: now, Model: model, ConfiguredStrategy: RoutingStrategy(selection.Policy), EffectiveStrategy: "quota-deadline", Mode: "deadline-rate", Reason: "uncalibrated-demand", TargetThrough: through, Candidates: []RoutingCandidate{}, Attempts: []RoutingAttempt{}, Outcome: "refused"}
+	if input != nil {
+		trace.Mode = "forecast-paced"
+		trace.Reason = "deadline-budget"
+		if input.Source == "observed-quota-burn" {
+			trace.Mode = "observed-paced"
+			trace.Reason = "observed-burn-target"
+		}
+		trace.Forecast = &RoutingEvidence{Revision: input.Revision, Source: input.Source, Confidence: input.Confidence, CalculatedAt: input.CalculatedAt, ValidUntil: input.ValidUntil, History: input.History}
+	}
+	eligible := make(map[string]bool, len(available))
+	ids := make(map[string]bool, len(selection.Funding)+len(available))
+	for id := range selection.Funding {
+		ids[id] = true
+	}
+	for _, account := range available {
+		eligible[account.ID] = true
+		ids[account.ID] = true
+	}
+	ordered := make([]string, 0, len(ids))
+	for id := range ids {
+		ordered = append(ordered, id)
+	}
+	sort.Strings(ordered)
+	for _, id := range ordered {
+		candidate := RoutingCandidate{Account: id, Eligible: eligible[id], Funding: "plan", Reason: "unavailable", EmptyProjection: "unavailable"}
+		if tier, exists := selection.Funding[id]; exists {
+			switch tier {
+			case 1:
+				candidate.Funding = "credits"
+			case 2:
+				candidate.Funding = "unknown"
+			case 3:
+				candidate.Funding = "blocked"
+			}
+		}
+		if rank, ok := selection.Ranks[id]; ok {
+			candidate.Quota = &rank
+		}
+		if eligible[id] {
+			candidate.Reason = "target-share"
+			if weight, ok := weights[id]; ok {
+				candidate.Weight = &weight
+			}
+			if input != nil && through != nil {
+				rank := selection.Ranks[id]
+				_, window := routingDemand(selection, input.Provider, model, rank.WindowSeconds, now)
+				if window != nil {
+					trace.Forecast.Unit = &window.Unit
+					demand, ok := demandUntil(window, now, *through)
+					if ok && candidate.Weight != nil {
+						rate := demand * *candidate.Weight / through.Sub(now).Hours()
+						candidate.TargetBurnRate = &rate
+						if full, known := quotaFull(window, id); known && rate > 0 {
+							hours := rank.Headroom * full / rate
+							if hours <= rank.ResetAt.Sub(now).Hours()+1.0/3600 && hours <= through.Sub(now).Hours()+1.0/3600 {
+								empty := now.Add(time.Duration(hours * float64(time.Hour)))
+								candidate.ProjectedEmptyAt = &empty
+								candidate.EmptyProjection = "estimated"
+							} else if !through.Before(rank.ResetAt) {
+								candidate.EmptyProjection = "not-before-reset"
+							}
+						}
+					}
+				}
+			}
+		}
+		trace.Candidates = append(trace.Candidates, candidate)
+	}
+	return trace
+}
+
+// FinalizeRoutingSelection records the final admitted account, including paths
+// that bypass weighted selection for an existing affinity or pinned check.
+func FinalizeRoutingSelection(selection *AccountSelection, model, chosen string, admitted bool, now time.Time) {
+	if selection == nil {
+		return
+	}
+	if selection.Decision == nil {
+		selection.Decision = routingTrace(selection, nil, model, now, nil, nil, nil)
+	}
+	trace := selection.Decision
+	trace.At = now
+	switch selection.Reason {
+	case "no-eligible-account":
+		trace.Mode = "refused"
+		trace.Reason = "no-eligible-account"
+	case "affinity", "parent_affinity", "pinned":
+		trace.Mode = "affinity"
+		trace.Reason = "existing-affinity"
+		if selection.Reason == "parent_affinity" {
+			trace.Reason = "parent-affinity"
+		}
+		if selection.Reason == "pinned" {
+			trace.Mode = "pinned"
+			trace.Reason = "pinned-account"
+		}
+		trace.EffectiveStrategy = trace.ConfiguredStrategy
+		trace.Forecast = nil
+		trace.TargetThrough = nil
+		for i := range trace.Candidates {
+			candidate := &trace.Candidates[i]
+			candidate.Weight = nil
+			candidate.TargetBurnRate = nil
+			candidate.ProjectedEmptyAt = nil
+			candidate.EmptyProjection = "unavailable"
+			if candidate.Account == chosen {
+				candidate.Eligible = true
+				candidate.Reason = trace.Reason
+			}
+		}
+	}
+	trace.Attempts = append([]RoutingAttempt{}, selection.Attempts...)
+	if admitted {
+		trace.ChosenAccount = &chosen
+		trace.Outcome = "admitted"
+	}
+}
