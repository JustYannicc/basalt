+package cluster
+
+import (
+	"testing"
+	"time"
+
+	coreauth "github.com/router-for-me/CLIProxyAPIHome/internal/cliproxy/auth"
+)
+
+func observedDemandFixture(now time.Time) coreauth.RoutingDemandInput {
+	return coreauth.RoutingDemandInput{
+		Provider: "claude", Revision: "test", Source: "observed-quota-burn", Confidence: "low", CalculatedAt: now, ValidUntil: now.Add(15 * time.Minute),
+		History: coreauth.RoutingDemandHistory{From: now.Add(-2 * time.Hour), Through: now, CoverageRatio: 1},
+		Windows: []coreauth.RoutingDemandWindow{{Seconds: 604800, Mode: "fixed", Calibration: "quota-observed", CalibrationRevision: "test", Unit: coreauth.RoutingUnit{ID: "weekly", Label: "weekly", Revision: "test"},
+			Accounts:  []coreauth.RoutingDemandAccount{{Account: "a", Full: 100, Known: true, WeightRevision: "test"}},
+			Intervals: []coreauth.RoutingDemandInterval{{From: now, To: now.Add(7 * 24 * time.Hour), Demand: coreauth.RoutingDemandRange{Median: 100}}},
+		}},
+	}
+}
+
+func TestRoutingDemandPublicationOwnsSnapshotAndRejectsInvalidReplacement(t *testing.T) {
+	repo, ctx := newTestKVRepository(t)
+	if _, err := repo.UpsertAuth(ctx, &coreauth.Auth{ID: "a", Index: "a", Provider: "claude"}, "test"); err != nil {
+		t.Fatal(err)
+	}
+	group, err := repo.CreateChannelGroup(ctx, "test", false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = repo.CreateChannelGroupDetail(ctx, group.ID, "a"); err != nil {
+		t.Fatal(err)
+	}
+	now := time.Date(2026, 11, 13, 0, 0, 0, 0, time.UTC)
+	input := observedDemandFixture(now)
+	if err = repo.SetRoutingDemand(ctx, group.ID, []coreauth.RoutingDemandInput{input}, []string{input.Source}, now); err != nil {
+		t.Fatal(err)
+	}
+	input.Windows[0].Accounts[0].Full = 999
+	stored := repo.routingDemandForGroups([]uint{group.ID}, now)
+	if len(stored) != 1 || stored[0].Windows[0].Accounts[0].Full != 100 {
+		t.Fatal("publication retained caller's mutable data")
+	}
+	invalid := observedDemandFixture(now)
+	invalid.Windows[0].Accounts[0].Account = "outside-group"
+	if err = repo.SetRoutingDemand(ctx, group.ID, []coreauth.RoutingDemandInput{invalid}, []string{invalid.Source}, now); err == nil {
+		t.Fatal("outside membership accepted")
+	}
+	if len(repo.routingDemandForGroups([]uint{group.ID}, now)) != 1 {
+		t.Fatal("invalid replacement cleared accepted state")
+	}
+	if err = repo.SetRoutingDemand(ctx, group.ID, nil, []string{input.Source}, now); err != nil {
+		t.Fatal(err)
+	}
+	if len(repo.routingDemandForGroups([]uint{group.ID}, now)) != 0 {
+		t.Fatal("empty replacement did not clear producer")
+	}
+}
+
+func TestRoutingDemandValidationRejectsDuplicateCohorts(t *testing.T) {
+	now := time.Date(2026, 11, 13, 0, 0, 0, 0, time.UTC)
+	input := observedDemandFixture(now)
+	if err := validateRoutingDemand([]coreauth.RoutingDemandInput{input, input}, map[string]bool{"a": true}, now); err == nil {
+		t.Fatal("duplicate cohort silently hides a window")
+	}
+}
+
+func TestRoutingDemandPublishesDuplicateGroupsAsTheActualDispatchScope(t *testing.T) {
+	repo, ctx := newTestKVRepository(t)
+	now := time.Date(2026, 11, 13, 0, 0, 0, 0, time.UTC)
+	groups := []uint{}
+	for _, id := range []string{"a", "b"} {
+		if _, errUpsert := repo.UpsertAuth(ctx, &coreauth.Auth{ID: id, Index: id, Provider: "claude"}, "test"); errUpsert != nil {
+			t.Fatal(errUpsert)
+		}
+		group, errGroup := repo.CreateChannelGroup(ctx, "same-pool", false)
+		if errGroup != nil {
+			t.Fatal(errGroup)
+		}
+		if _, errDetail := repo.CreateChannelGroupDetail(ctx, group.ID, id); errDetail != nil {
+			t.Fatal(errDetail)
+		}
+		groups = append(groups, group.ID)
+	}
+	input := observedDemandFixture(now)
+	input.Windows[0].Accounts = append(input.Windows[0].Accounts, coreauth.RoutingDemandAccount{Account: "b", Full: 100, Known: true, WeightRevision: "test"})
+	if errStore := repo.SetRoutingDemand(ctx, groups[0], []coreauth.RoutingDemandInput{input}, []string{input.Source}, now); errStore == nil {
+		t.Fatal("whole demand accepted against partial membership")
+	}
+	if errStore := repo.SetRoutingDemandForGroups(ctx, groups, []coreauth.RoutingDemandInput{input}, []string{input.Source}, now); errStore != nil {
+		t.Fatal(errStore)
+	}
+	if got := repo.routingDemandForGroups([]uint{groups[1], groups[0]}, now); len(got) != 1 || len(got[0].Windows[0].Accounts) != 2 {
+		t.Fatal("dispatch scope did not read full profile")
+	}
+	if got := repo.routingDemandForGroups(groups[:1], now); len(got) != 0 {
+		t.Fatal("partial group consumed whole-pool demand")
+	}
+	other, errOther := repo.CreateChannelGroup(ctx, "other-pool", false)
+	if errOther != nil {
+		t.Fatal(errOther)
+	}
+	if _, errScope := repo.ResolveRoutingGroups(ctx, groups[0], []uint{groups[0], other.ID}); errScope == nil {
+		t.Fatal("unrelated pools merged")
+	}
+	repo.DeleteRoutingDemandForGroups(groups, input.Source)
+	if len(repo.routingDemandForGroups(groups, now)) != 0 {
+		t.Fatal("scope deletion failed")
+	}
+}
diff --git a/internal/cluster/routing_demand_validation.go b/internal/cluster/routing_demand_validation.go
new file mode 100644
index 0000000..31e91ae
--- /dev/null
+++ b/internal/cluster/routing_demand_validation.go
@@ -0,0 +1,86 @@
+package cluster
+
+import (
+	"fmt"
+	"math"
+	"time"
+
+	coreauth "github.com/router-for-me/CLIProxyAPIHome/internal/cliproxy/auth"
+)
+
+func routingFinite(value float64) bool {
+	return !math.IsNaN(value) && !math.IsInf(value, 0) && value >= 0
+}
+func routingText(value string) bool { return len(value) > 0 && len(value) <= 256 }
+
+func validateRoutingDemand(inputs []coreauth.RoutingDemandInput, members map[string]bool, now time.Time) error {
+	cohorts := make(map[string]bool, len(inputs))
+	for _, input := range inputs {
+		if !routingText(input.Revision) || !routingText(input.Provider) || input.ModelFamily != nil && !routingText(*input.ModelFamily) || input.CalculatedAt.After(now) || now.Sub(input.CalculatedAt) > time.Hour || !input.ValidUntil.After(now) || input.ValidUntil.Sub(now) > time.Hour {
+			return fmt.Errorf("routing demand identity or validity interval is invalid")
+		}
+		if input.Source != "history-forecast" && input.Source != "observed-quota-burn" {
+			return fmt.Errorf("unsupported routing demand source")
+		}
+		if input.Confidence != "low" && input.Confidence != "medium" && input.Confidence != "high" {
+			return fmt.Errorf("unsupported routing demand confidence")
+		}
+		model := ""
+		if input.ModelFamily != nil {
+			model = *input.ModelFamily
+		}
+		key := input.Provider + "\x00" + input.Source + "\x00" + model
+		if cohorts[key] {
+			return fmt.Errorf("duplicate routing demand cohort")
+		}
+		cohorts[key] = true
+		history := input.History
+		if history.From.IsZero() || !history.Through.After(history.From) || history.Through.After(now) || !routingFinite(history.CoverageRatio) || history.CoverageRatio < .9 || history.CoverageRatio > 1 || history.Censored || history.HeldOutPeriods < 0 || history.HeldOutPeriods > 10000 || history.RelativeError != nil && !routingFinite(*history.RelativeError) {
+			return fmt.Errorf("routing demand evidence is incomplete")
+		}
+		if input.Source == "observed-quota-burn" && (history.Through.Sub(history.From) < 2*time.Hour || now.Sub(history.Through) > 2*time.Hour || input.Confidence != "low") {
+			return fmt.Errorf("observed burn needs recent comparable hours and low confidence")
+		}
+		if len(input.Windows) == 0 || len(input.Windows) > 2 {
+			return fmt.Errorf("routing demand needs one or two quota windows")
+		}
+		windows := make(map[int64]bool)
+		for _, window := range input.Windows {
+			if window.Seconds != 604800 && window.Seconds != 18000 || windows[window.Seconds] || window.Mode != "fixed" && window.Mode != "rolling" || !routingText(window.Unit.ID) || !routingText(window.Unit.Label) || !routingText(window.Unit.Revision) || !routingText(window.CalibrationRevision) || window.Calibration != "quota-observed" && window.Calibration != "history-calibrated" {
+				return fmt.Errorf("routing demand window is invalid")
+			}
+			if input.Source == "observed-quota-burn" && window.Calibration != "quota-observed" || input.Source == "history-forecast" && window.Calibration != "history-calibrated" {
+				return fmt.Errorf("routing demand calibration does not match its source")
+			}
+			windows[window.Seconds] = true
+			if len(window.Accounts) == 0 || len(window.Accounts) > 500 || len(window.Intervals) == 0 || len(window.Intervals) > 336 || len(window.CandidatePlans) > 16 {
+				return fmt.Errorf("routing demand window exceeds its bounds")
+			}
+			accounts := make(map[string]bool, len(window.Accounts))
+			for _, account := range window.Accounts {
+				if !members[account.Account] || accounts[account.Account] || !routingFinite(account.Full) || account.Full <= 0 || !routingText(account.WeightRevision) || len(account.RollingReleases) > 336 || account.Plan != nil && !routingText(*account.Plan) {
+					return fmt.Errorf("routing demand account is invalid or outside this group")
+				}
+				accounts[account.Account] = true
+				for _, release := range account.RollingReleases {
+					if release.At.IsZero() || !routingFinite(release.Amount) {
+						return fmt.Errorf("routing demand rolling release is invalid")
+					}
+				}
+			}
+			end := time.Time{}
+			for _, interval := range window.Intervals {
+				if !interval.To.After(interval.From) || !end.IsZero() && !interval.From.Equal(end) || interval.To.Sub(input.CalculatedAt) > 8*24*time.Hour || !routingFinite(interval.Demand.Median) || interval.Demand.Upper80 == nil && input.Source != "observed-quota-burn" || interval.Demand.Upper80 != nil && (!routingFinite(*interval.Demand.Upper80) || *interval.Demand.Upper80 < interval.Demand.Median) {
+					return fmt.Errorf("routing demand profile is invalid or has gaps")
+				}
+				end = interval.To
+			}
+			for _, plan := range window.CandidatePlans {
+				if !routingText(plan.Plan) || !routingText(plan.WeightRevision) || !routingFinite(plan.Full) || plan.Full <= 0 || plan.ResetEverySeconds <= 0 {
+					return fmt.Errorf("routing demand candidate plan is invalid")
+				}
+			}
+		}
+	}
+	return nil
+}
diff --git a/internal/cluster/routing_outlook.go b/internal/cluster/routing_outlook.go
new file mode 100644
index 0000000..4582fdc
--- /dev/null
+++ b/internal/cluster/routing_outlook.go
@@ -0,0 +1,72 @@
+package cluster
+
+import (
+	"encoding/json"
+	"fmt"
+	"time"
+
+	coreauth "github.com/router-for-me/CLIProxyAPIHome/internal/cliproxy/auth"
+)
+
+type routingOutlook struct {
+	payload json.RawMessage
+	expires time.Time
+}
+
+// Home retains the trusted producer's replay result. Public projection owns its
+// closed schema; inference never recalculates forecasts or account advice.
+func validatedRoutingOutlooks(payloads []json.RawMessage, inputs []coreauth.RoutingDemandInput, now time.Time) ([]routingOutlook, error) {
+	if len(payloads) > 12 {
+		return nil, fmt.Errorf("routing outlook cohort limit exceeded")
+	}
+	result := make([]routingOutlook, 0, len(payloads))
+	seen := map[string]bool{}
+	for _, payload := range payloads {
+		var envelope struct {
+			Provider       string          `json:"provider"`
+			ModelFamily    *string         `json:"modelFamily"`
+			From           time.Time       `json:"from"`
+			Through        time.Time       `json:"through"`
+			Status         string          `json:"status"`
+			Recommendation json.RawMessage `json:"recommendation"`
+			Attention      struct {
+				Notice     string `json:"notice"`
+				InboxNudge string `json:"inboxNudge"`
+			} `json:"attention"`
+			Evidence struct {
+				Status       string     `json:"status"`
+				Source       string     `json:"source"`
+				Revision     string     `json:"revision"`
+				CalculatedAt time.Time  `json:"calculatedAt"`
+				ValidUntil   *time.Time `json:"validUntil"`
+			} `json:"evidence"`
+		}
+		if len(payload) > 64*1024 || json.Unmarshal(payload, &envelope) != nil {
+			return nil, fmt.Errorf("routing outlook representation is invalid")
+		}
+		model := ""
+		if envelope.ModelFamily != nil {
+			model = *envelope.ModelFamily
+		}
+		key := envelope.Provider + "\x00" + model
+		if seen[key] || !routingText(envelope.Provider) || envelope.ModelFamily != nil && !routingText(*envelope.ModelFamily) || !envelope.Through.After(envelope.From) || envelope.Through.Sub(envelope.From) > 7*24*time.Hour {
+			return nil, fmt.Errorf("routing outlook horizon is invalid")
+		}
+		seen[key] = true
+		expires := now.Add(6 * time.Minute)
+		uncertain := envelope.Status == "uncertain" && string(envelope.Recommendation) == "null" && envelope.Attention.Notice == "none" && envelope.Attention.InboxNudge == "none" && envelope.Evidence.Status != "calibrated" && !envelope.Evidence.CalculatedAt.IsZero() && !envelope.Evidence.CalculatedAt.After(now) && now.Sub(envelope.Evidence.CalculatedAt) <= time.Hour
+		matched := uncertain
+		for _, input := range inputs {
+			modelMatches := input.ModelFamily == nil && envelope.ModelFamily == nil || input.ModelFamily != nil && envelope.ModelFamily != nil && *input.ModelFamily == *envelope.ModelFamily
+			if input.Provider == envelope.Provider && modelMatches && input.Source == "history-forecast" && envelope.Evidence.Source == input.Source && envelope.Evidence.Revision == input.Revision && envelope.Evidence.CalculatedAt.Equal(input.CalculatedAt) && envelope.Evidence.ValidUntil != nil && envelope.Evidence.ValidUntil.Equal(input.ValidUntil) && input.ValidUntil.After(now) {
+				matched = true
+				expires = input.ValidUntil
+			}
+		}
+		if !matched {
+			return nil, fmt.Errorf("routing outlook must match a fresh published forecast revision")
+		}
+		result = append(result, routingOutlook{payload: append(json.RawMessage(nil), payload...), expires: expires})
+	}
+	return result, nil
+}
