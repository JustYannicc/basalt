--- /dev/null
+++ b/internal/cluster/routing_current.go
@@ -0,0 +1,83 @@
+package cluster
+
+import (
+	"context"
+	"sort"
+	"time"
+
+	coreauth "github.com/router-for-me/CLIProxyAPIHome/internal/cliproxy/auth"
+)
+
+func (r *Repository) CurrentRouting(ctx context.Context, group uint, now time.Time) ([]coreauth.RoutingCurrent, error) {
+	return r.CurrentRoutingForGroups(ctx, []uint{group}, now)
+}
+func (r *Repository) CurrentRoutingForGroups(ctx context.Context, groups []uint, now time.Time) ([]coreauth.RoutingCurrent, error) {
+	scope, errScope := r.loadRoutingScope(ctx, groups)
+	if errScope != nil {
+		return nil, errScope
+	}
+	ids := make(map[string]struct{}, len(scope.members))
+	for id := range scope.members {
+		ids[id] = struct{}{}
+	}
+	items, errItems := r.loadFundingCredentials(ctx, now, ids)
+	if errItems != nil {
+		return nil, errItems
+	}
+	policy, credits := "reset_aware", "last_resort"
+	policies := map[string]bool{}
+	for _, saved := range scope.groups {
+		value, errPolicy := NormalizeAccountSelectionPolicy(saved.AccountSelectionPolicy)
+		if errPolicy != nil {
+			return nil, errPolicy
+		}
+		policy = value
+		policies[value] = true
+		if saved.UsageCreditPolicy != "" && saved.UsageCreditPolicy != "last_resort" {
+			credits = "never"
+		}
+	}
+	if len(policies) > 1 {
+		policy = "balanced"
+	}
+	byProvider := make(map[string][]QuotaCredentialSnapshot)
+	for _, item := range items {
+		byProvider[item.Provider] = append(byProvider[item.Provider], item)
+	}
+	providers := make([]string, 0, len(byProvider))
+	for provider := range byProvider {
+		providers = append(providers, provider)
+	}
+	sort.Strings(providers)
+	current := make([]coreauth.RoutingCurrent, 0, len(providers))
+	for _, provider := range providers {
+		selection := &coreauth.AccountSelection{Policy: policy, Groups: routingScopeIDs(groups), Scope: scope.key, Ranks: make(map[string]coreauth.QuotaResetRank), Funding: make(map[string]int), Demand: r.routingDemandForGroups(groups, now)}
+		best := 3
+		for _, item := range byProvider[provider] {
+			tier := usageCreditFundingTier(item, "", now)
+			if item.CredentialStatus != "" && item.CredentialStatus != "enabled" && item.CredentialStatus != "active" && item.CredentialStatus != "available" {
+				tier = 3
+			}
+			if credits == "never" && tier > 0 {
+				tier = 3
+			}
+			selection.Funding[item.CredentialID] = tier
+			if tier < best {
+				best = tier
+			}
+			if rank, ok := quotaSelectionRank(item, "", now); ok {
+				selection.Ranks[item.CredentialID] = rank
+			}
+		}
+		available := make([]*coreauth.Auth, 0, len(byProvider[provider]))
+		for _, item := range byProvider[provider] {
+			if selection.Funding[item.CredentialID] == best && best < 3 {
+				available = append(available, &coreauth.Auth{ID: item.CredentialID, Provider: provider, Status: coreauth.StatusActive})
+			}
+		}
+		sort.Slice(available, func(i, j int) bool { return available[i].ID < available[j].ID })
+		selection.PlanFunded = best == 0
+		current = append(current, coreauth.ComputeRoutingCurrent(selection, provider, available, now))
+	}
+	return current, nil
+}
