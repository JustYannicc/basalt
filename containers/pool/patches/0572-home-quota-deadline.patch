+package management
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	coreauth "github.com/router-for-me/CLIProxyAPIHome/internal/cliproxy/auth"
+)
+
+func TestRoutingManagementPublishesReadsAndClearsOneDuplicateScope(t *testing.T) {
+	handler, closeRepo := newUsageObservabilityTestHandler(t)
+	defer closeRepo()
+	groups := []uint{}
+	ctx := t.Context()
+	now := time.Now().UTC()
+	for _, id := range []string{"routing-a", "routing-b"} {
+		if _, errUpsert := handler.repo.UpsertAuth(ctx, &coreauth.Auth{ID: id, Index: id, Provider: "claude"}, "test"); errUpsert != nil {
+			t.Fatal(errUpsert)
+		}
+		group, errGroup := handler.repo.CreateChannelGroup(ctx, "routing-same-pool", false)
+		if errGroup != nil {
+			t.Fatal(errGroup)
+		}
+		if _, errDetail := handler.repo.CreateChannelGroupDetail(ctx, group.ID, id); errDetail != nil {
+			t.Fatal(errDetail)
+		}
+		groups = append(groups, group.ID)
+	}
+	gin.SetMode(gin.TestMode)
+	engine := gin.New()
+	engine.PUT("/channel-groups/:id/routing-demand", handler.PutChannelGroupRoutingDemand)
+	engine.GET("/channel-groups/:id/routing-decisions", handler.GetChannelGroupRoutingDecisions)
+	engine.DELETE("/channel-groups/:id/routing-demand", handler.DeleteChannelGroupRoutingDemand)
+	publish := map[string]any{"groups": groups, "inputs": []any{}, "replaceSources": []string{"history-forecast"}, "capacity": []any{map[string]any{
+		"provider": "claude", "modelFamily": nil, "from": now, "through": now.Add(24 * time.Hour), "status": "uncertain", "recommendation": nil,
+		"attention": map[string]any{"notice": "none", "inboxNudge": "none"}, "evidence": map[string]any{"status": "uncalibrated", "source": "none", "calculatedAt": now, "validUntil": nil},
+	}}}
+	body, errEncode := json.Marshal(publish)
+	if errEncode != nil {
+		t.Fatal(errEncode)
+	}
+	query := fmt.Sprintf("groups=%d,%d", groups[0], groups[1])
+	base := fmt.Sprintf("/channel-groups/%d", groups[0])
+	call := func(method, path string, body []byte) *httptest.ResponseRecorder {
+		response := httptest.NewRecorder()
+		request := httptest.NewRequest(method, path, bytes.NewReader(body))
+		request.Header.Set("Content-Type", "application/json")
+		engine.ServeHTTP(response, request)
+		return response
+	}
+	if response := call(http.MethodPut, base+"/routing-demand", body); response.Code != 200 {
+		t.Fatalf("publish: %d %s", response.Code, response.Body.String())
+	}
+	response := call(http.MethodGet, base+"/routing-decisions?"+query, nil)
+	var page struct {
+		Capacity []json.RawMessage         `json:"capacity"`
+		Current  []coreauth.RoutingCurrent `json:"current"`
+	}
+	if response.Code != 200 || json.Unmarshal(response.Body.Bytes(), &page) != nil || len(page.Capacity) != 1 || len(page.Current) != 1 || len(page.Current[0].Plan.Candidates) != 2 {
+		t.Fatalf("scope read: %d %s", response.Code, response.Body.String())
+	}
+	if response := call(http.MethodDelete, base+"/routing-demand?"+query+"&source=history-forecast", nil); response.Code != 200 {
+		t.Fatalf("clear: %d", response.Code)
+	}
+	response = call(http.MethodGet, base+"/routing-decisions?"+query, nil)
+	if json.Unmarshal(response.Body.Bytes(), &page) != nil || len(page.Capacity) != 0 {
+		t.Fatal("deleted outlook remained visible")
+	}
+	if response := call(http.MethodGet, base+"/routing-decisions?groups=0", nil); response.Code != 400 {
+		t.Fatal("invalid scope accepted")
+	}
+}
