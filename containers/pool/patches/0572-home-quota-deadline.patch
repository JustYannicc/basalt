diff --git a/internal/cliproxy/auth/quota_deadline_plan.go b/internal/cliproxy/auth/quota_deadline_plan.go
new file mode 100644
index 0000000..1c8f2fe
--- /dev/null
+++ b/internal/cliproxy/auth/quota_deadline_plan.go
@@ -0,0 +1,271 @@
+package auth
+
+import (
+	"math"
+	"strings"
+	"time"
+	"unicode"
+)
+
+func validPositive(value float64) bool {
+	return value > 0 && !math.IsNaN(value) && !math.IsInf(value, 0)
+}
+
+func quotaRankReason(rank QuotaResetRank, exists bool, now time.Time) string {
+	if !exists {
+		return "unknown-rank"
+	}
+	if !validPositive(rank.Headroom) || rank.Headroom > 1 {
+		return "invalid-rank"
+	}
+	if !rank.ExpiresAt.After(now) || !rank.ResetAt.After(now) || rank.ObservedAt.After(now) {
+		return "expired-rank"
+	}
+	return ""
+}
+
+func routingDemand(selection *AccountSelection, provider, model string, seconds int64, now time.Time) (*RoutingDemandInput, *RoutingDemandWindow) {
+	var chosen *RoutingDemandInput
+	var window *RoutingDemandWindow
+	for index := range selection.Demand {
+		input := &selection.Demand[index]
+		if input.Provider != provider || input.CalculatedAt.After(now) || !input.ValidUntil.After(now) || input.History.Censored || input.History.CoverageRatio < .9 {
+			continue
+		}
+		if input.ModelFamily != nil && *input.ModelFamily != "" && !routingModelFamilyMatches(*input.ModelFamily, model) {
+			continue
+		}
+		if input.Source != "history-forecast" && input.Source != "observed-quota-burn" {
+			continue
+		}
+		if chosen != nil && (chosen.Source == "history-forecast" && input.Source != "history-forecast" || chosen.Source == input.Source && !input.CalculatedAt.After(chosen.CalculatedAt)) {
+			continue
+		}
+		for wi := range input.Windows {
+			candidate := &input.Windows[wi]
+			if candidate.Seconds == seconds {
+				chosen = input
+				window = candidate
+				break
+			}
+		}
+	}
+	return chosen, window
+}
+
+func demandUntil(window *RoutingDemandWindow, now, end time.Time) (float64, bool) {
+	if window == nil || !end.After(now) {
+		return 0, false
+	}
+	at, total := now, 0.0
+	for _, interval := range window.Intervals {
+		if !interval.To.After(at) {
+			continue
+		}
+		if interval.From.After(at) || !interval.To.After(interval.From) || interval.Demand.Median < 0 || math.IsNaN(interval.Demand.Median) || math.IsInf(interval.Demand.Median, 0) {
+			return 0, false
+		}
+		through := interval.To
+		if through.After(end) {
+			through = end
+		}
+		total += interval.Demand.Median * through.Sub(at).Seconds() / interval.To.Sub(interval.From).Seconds()
+		at = through
+		if !at.Before(end) {
+			return total, true
+		}
+	}
+	return 0, false
+}
+
+func quotaFull(window *RoutingDemandWindow, id string) (float64, bool) {
+	if window == nil {
+		return 0, false
+	}
+	for _, account := range window.Accounts {
+		if account.Account == id {
+			return account.Full, account.Known && validPositive(account.Full)
+		}
+	}
+	return 0, false
+}
+
+// Targets are soft shares. Neither demand estimates nor pacing caps are an
+// admission gate; an excluded preferred account must not strand usable quota.
+func quotaDeadlineShares(available []*Auth, selection *AccountSelection, provider, model string, now time.Time) (map[string]float64, *RoutingDemandInput, *time.Time) {
+	weights := make(map[string]float64, len(available))
+	deadline := selection.Ranks[available[0].ID].ResetAt
+	seconds := selection.Ranks[available[0].ID].WindowSeconds
+	if seconds == 0 {
+		seconds = 604800
+	}
+	for _, account := range available {
+		rank := selection.Ranks[account.ID]
+		if rank.ResetAt.Before(deadline) {
+			deadline = rank.ResetAt
+		}
+		current := rank.WindowSeconds
+		if current == 0 {
+			current = 604800
+		}
+		if current != seconds {
+			seconds = 0
+		}
+		weights[account.ID] = rank.Headroom / math.Max(rank.ResetAt.Sub(now).Seconds(), 60)
+	}
+	input, window := routingDemand(selection, provider, model, seconds, now)
+	predicted, covered := demandUntil(window, now, deadline)
+	due := 0.0
+	if input != nil && covered && validPositive(predicted) {
+		for _, account := range available {
+			full, known := quotaFull(window, account.ID)
+			if !known {
+				input = nil
+				break
+			}
+			rank := selection.Ranks[account.ID]
+
+			if rank.ResetAt.Equal(deadline) {
+				due += rank.Headroom * full
+			}
+		}
+	} else {
+		input = nil
+	}
+	if input != nil {
+		for _, account := range available {
+			full, _ := quotaFull(window, account.ID)
+			weights[account.ID] *= full
+		}
+		early := math.Min(1, due/predicted)
+		later := 0.0
+		for _, account := range available {
+			if !selection.Ranks[account.ID].ResetAt.Equal(deadline) {
+				later += weights[account.ID]
+			}
+		}
+		for _, account := range available {
+			rank := selection.Ranks[account.ID]
+			if rank.ResetAt.Equal(deadline) {
+				full, _ := quotaFull(window, account.ID)
+				share := early
+				if later == 0 {
+					share = 1
+				}
+				weights[account.ID] = share * rank.Headroom * full / due
+			} else {
+				weights[account.ID] = (1 - early) * weights[account.ID] / later
+			}
+		}
+		paceShortWindows(weights, available, selection, provider, model, now, deadline)
+	}
+	normalizeShares(weights)
+	if input == nil {
+		return weights, nil, nil
+	}
+	return weights, input, &deadline
+}
+
+func normalizeShares(weights map[string]float64) {
+	total := 0.0
+	for _, weight := range weights {
+		total += weight
+	}
+	if total <= 0 {
+		return
+	}
+	for id, weight := range weights {
+		weights[id] = weight / total
+	}
+}
+
+func paceShortWindows(weights map[string]float64, available []*Auth, selection *AccountSelection, provider, model string, now, deadline time.Time) {
+	_, window := routingDemand(selection, provider, model, 18000, now)
+	if window == nil {
+		return
+	}
+	caps, totalCaps := make(map[string]float64, len(available)), 0.0
+	for _, account := range available {
+		short := selection.Ranks[account.ID].Short
+		if short == nil || short.Mode != "fixed" || short.ResetAt == nil || !short.ResetAt.After(now) {
+			return
+		}
+		end := *short.ResetAt
+		if deadline.Before(end) {
+			end = deadline
+		}
+		demand, ok := demandUntil(window, now, end)
+		full, known := quotaFull(window, account.ID)
+		if !ok || !known || !validPositive(demand) {
+			return
+		}
+		cap := math.Min(1, short.Headroom*full/demand)
+		if cap < 0 || math.IsNaN(cap) {
+			return
+		}
+		caps[account.ID] = cap
+		totalCaps += cap
+	}
+	if totalCaps < 1-1e-9 {
+		return
+	}
+	pending := make(map[string]bool, len(available))
+	for _, account := range available {
+		pending[account.ID] = true
+	}
+	left := 1.0
+	for len(pending) > 0 {
+		total := 0.0
+		for id := range pending {
+			total += weights[id]
+		}
+		over := make([]string, 0)
+		for id := range pending {
+			proposed := left / float64(len(pending))
+			if total > 0 {
+				proposed = left * weights[id] / total
+			}
+			if proposed > caps[id]+1e-9 {
+				over = append(over, id)
+			}
+		}
+		if len(over) == 0 {
+			for id := range pending {
+				proposed := left / float64(len(pending))
+				if total > 0 {
+					proposed = left * weights[id] / total
+				}
+				weights[id] = proposed
+			}
+			return
+		}
+		for _, id := range over {
+			weights[id] = caps[id]
+			left -= caps[id]
+			delete(pending, id)
+		}
+	}
+}
+
+func routingModelFamilyMatches(family, model string) bool {
+	tokens := func(value string) []string {
+		return strings.FieldsFunc(strings.ToLower(value), func(r rune) bool { return !unicode.IsLetter(r) && !unicode.IsDigit(r) })
+	}
+	expected, actual := tokens(family), tokens(model)
+	if len(expected) == 0 || len(expected) > len(actual) {
+		return false
+	}
+	for start := 0; start <= len(actual)-len(expected); start++ {
+		matches := true
+		for index, part := range expected {
+			if actual[start+index] != part {
+				matches = false
+				break
+			}
+		}
+		if matches {
+			return true
+		}
+	}
+	return false
+}
diff --git a/internal/cliproxy/auth/quota_deadline_selector.go b/internal/cliproxy/auth/quota_deadline_selector.go
new file mode 100644
index 0000000..83bd081
--- /dev/null
+++ b/internal/cliproxy/auth/quota_deadline_selector.go
@@ -0,0 +1,177 @@
+package auth
+
+import (
+	"context"
+	"strings"
+	"sync"
+	"time"
+)
+
+// QuotaDeadlineSelector paces account-wide quota toward its deadline, then uses
+// smooth weighted round robin. Dynamic targets never reset accumulated credit.
+type QuotaDeadlineSelector struct {
+	mu       sync.Mutex
+	states   map[string]*quotaDeadlineState
+	Fallback RoundRobinSelector
+	Now      func() time.Time
+}
+
+type quotaDeadlineState struct {
+	current map[string]float64
+	touched time.Time
+}
+
+func (s *QuotaDeadlineSelector) Pick(ctx context.Context, provider, model string, opts Options, auths []*Auth) (*Auth, error) {
+	now := time.Now()
+	if s.Now != nil {
+		now = s.Now()
+	}
+	available, errAvailable := getAvailableAuths(filterConcurrencyExcludedAuths(auths, model, opts), provider, model, now)
+	if errAvailable != nil {
+		return nil, errAvailable
+	}
+	selection := opts.AccountSelection
+	if selection == nil {
+		return s.Fallback.Pick(ctx, provider, model, opts, auths)
+	}
+	reason := ""
+	actualProvider, knownProvider := routingProviderCohort(provider, available)
+	if !knownProvider {
+		reason = "mixed-provider-cohort"
+	} else {
+		provider = actualProvider
+	}
+	if !selection.PlanFunded {
+		reason = "credits-only"
+	}
+	for _, account := range available {
+		rank, ok := selection.Ranks[account.ID]
+		if invalid := quotaRankReason(rank, ok, now); invalid != "" && reason == "" {
+			reason = invalid
+		}
+	}
+	if reason != "" {
+		selection.Reason = reason
+		selection.Decision = routingTrace(selection, available, model, now, nil, nil, nil)
+		selection.Decision.EffectiveStrategy = "round-robin"
+		selection.Decision.Mode = "balanced-fallback"
+		selection.Decision.Reason = reason
+		for i := range selection.Decision.Candidates {
+			if selection.Decision.Candidates[i].Eligible {
+				selection.Decision.Candidates[i].Reason = "balanced-fallback"
+			}
+		}
+		return s.Fallback.Pick(ctx, provider, model, opts, auths)
+	}
+	weights, input, through := quotaDeadlineShares(available, selection, provider, model, now)
+	selection.Reason = "reset_deadline"
+	selection.Decision = routingTrace(selection, available, model, now, weights, input, through)
+	key := selection.Scope + ":" + provider
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.states == nil {
+		s.states = make(map[string]*quotaDeadlineState)
+	}
+	state := s.states[key]
+	if state == nil {
+		if len(s.states) >= 4096 {
+			oldest := ""
+			for id, candidate := range s.states {
+				if oldest == "" || candidate.touched.Before(s.states[oldest].touched) {
+					oldest = id
+				}
+			}
+			delete(s.states, oldest)
+		}
+		state = &quotaDeadlineState{current: make(map[string]float64)}
+		s.states[key] = state
+	}
+	state.touched = now
+	if len(state.current) > 1024 {
+		present := make(map[string]bool, len(available))
+		for _, account := range available {
+			present[account.ID] = true
+		}
+		for id := range state.current {
+			if !present[id] {
+				delete(state.current, id)
+			}
+		}
+	}
+	var chosen *Auth
+	best := 0.0
+	for _, account := range available {
+		weight := weights[account.ID]
+		if weight <= 0 {
+			continue
+		}
+		state.current[account.ID] += weight
+		if chosen == nil || state.current[account.ID] > best {
+			chosen = account
+			best = state.current[account.ID]
+		}
+	}
+	if chosen == nil {
+		return s.Fallback.Pick(ctx, provider, model, opts, auths)
+	}
+	state.current[chosen.ID] -= 1
+	return chosen, nil
+}
+
+// AccountRoutingSelector keeps pool policy at the selector boundary. Existing
+// strategies remain independently selectable and retain their own algorithms.
+type AccountRoutingSelector struct {
+	Fallback Selector
+	Quota    QuotaDeadlineSelector
+	Balanced RoundRobinSelector
+	Fill     FillFirstSelector
+	Weighted WeightedRoundRobinSelector
+}
+
+func (s *AccountRoutingSelector) Pick(ctx context.Context, provider, model string, opts Options, auths []*Auth) (*Auth, error) {
+	selection := opts.AccountSelection
+	if selection == nil {
+		if s.Fallback != nil {
+			return s.Fallback.Pick(ctx, provider, model, opts, auths)
+		}
+		return s.Balanced.Pick(ctx, provider, model, opts, auths)
+	}
+	selection.Decision = nil
+	if selection.Reason == "pinned" {
+		return s.Balanced.Pick(ctx, provider, model, opts, auths)
+	}
+	if selection.Policy == "reset_aware" || selection.Policy == "" {
+		return s.Quota.Pick(ctx, provider, model, opts, auths)
+	}
+	var selector Selector = &s.Balanced
+	switch selection.Policy {
+	case "fill_first":
+		selector = &s.Fill
+	case "weighted":
+		selector = &s.Weighted
+	}
+	available, errAvailable := getAvailableAuths(filterConcurrencyExcludedAuths(auths, model, opts), provider, model, time.Now())
+	if errAvailable != nil {
+		return nil, errAvailable
+	}
+	selection.Decision = routingTrace(selection, available, model, time.Now(), nil, nil, nil)
+	selection.Decision.EffectiveStrategy = RoutingStrategy(selection.Policy)
+	selection.Decision.Mode = "configured-strategy"
+	selection.Decision.Reason = "configured-strategy"
+	return selector.Pick(ctx, provider, model, opts, auths)
+}
+
+func routingProviderCohort(requested string, accounts []*Auth) (string, bool) {
+	provider := ""
+	for _, account := range accounts {
+		actual := strings.ToLower(strings.TrimSpace(account.Provider))
+		if actual == "" && requested != "mixed" {
+			actual = requested
+		}
+		if actual == "" || actual == "mixed" || provider != "" && provider != actual {
+			return "", false
+		}
+		provider = actual
+	}
+	return provider, provider != ""
+}
diff --git a/internal/cliproxy/auth/quota_deadline_simulation_test.go b/internal/cliproxy/auth/quota_deadline_simulation_test.go
new file mode 100644
index 0000000..9e0d90c
--- /dev/null
+++ b/internal/cliproxy/auth/quota_deadline_simulation_test.go
@@ -0,0 +1,169 @@
+package auth
+
+import (
+	"math"
+	"testing"
+	"time"
+)
+
+type deadlineSimulationAccount struct {
+	remaining, full           float64
+	reset                     time.Duration
+	shortRemaining, shortFull float64
+	shortReset                time.Duration
+	unknown                   bool
+}
+
+type deadlineSimulationDemand struct {
+	from, to time.Duration
+	amount   float64
+}
+type deadlineSimulationResult struct {
+	served, missed, wasted float64
+	first                  []float64
+}
+
+func simulateQuotaDeadline(t *testing.T, accounts []deadlineSimulationAccount, demand, estimate []deadlineSimulationDemand, mode string) deadlineSimulationResult {
+	t.Helper()
+	start := time.Date(2026, 11, 13, 0, 0, 0, 0, time.UTC)
+	current := start
+	selector := &QuotaDeadlineSelector{Now: func() time.Time { return current }}
+	result := deadlineSimulationResult{first: make([]float64, len(accounts))}
+	if estimate == nil {
+		estimate = demand
+	}
+	accounts = append([]deadlineSimulationAccount{}, accounts...)
+	for i := range accounts {
+		if accounts[i].full == 0 {
+			accounts[i].full = 100
+		}
+		if accounts[i].shortFull == 0 {
+			accounts[i].shortFull = 100000
+			accounts[i].shortRemaining = 100000
+			accounts[i].shortReset = 5 * time.Hour
+		}
+	}
+	const cost = .01
+	for _, segment := range demand {
+		count := int(math.Round(segment.amount / cost))
+		for index := 0; index < count; index++ {
+			elapsed := segment.from + time.Duration(float64(segment.to-segment.from)*(float64(index)+.5)/float64(count))
+			current = start.Add(elapsed)
+			available := []*Auth{}
+			selection := &AccountSelection{Policy: "reset_aware", PlanFunded: true, Scope: "synthetic-pool", Ranks: map[string]QuotaResetRank{}, Funding: map[string]int{}}
+			window := RoutingDemandWindow{Seconds: 604800, Mode: "fixed", Unit: RoutingUnit{ID: "synthetic-weekly", Label: "weekly units", Revision: "fixture"}}
+			shortWindow := RoutingDemandWindow{Seconds: 18000, Mode: "fixed", Unit: RoutingUnit{ID: "synthetic-short", Label: "short units", Revision: "fixture"}}
+			for i := range accounts {
+				account := &accounts[i]
+				for elapsed >= account.reset {
+					result.wasted += math.Max(0, account.remaining)
+					account.remaining = account.full
+					account.reset += 7 * 24 * time.Hour
+				}
+				for elapsed >= account.shortReset {
+					account.shortRemaining = account.shortFull
+					account.shortReset += 5 * time.Hour
+				}
+				id := string(rune('a' + i))
+				selection.Funding[id] = 0
+				window.Accounts = append(window.Accounts, RoutingDemandAccount{Account: id, Full: account.full, Known: true})
+				shortWindow.Accounts = append(shortWindow.Accounts, RoutingDemandAccount{Account: id, Full: account.shortFull, Known: true})
+				if account.remaining < cost/2 || account.shortRemaining < cost/2 {
+					continue
+				}
+				available = append(available, &Auth{ID: id, Status: StatusActive})
+				if account.unknown {
+					continue
+				}
+				shortReset := start.Add(account.shortReset)
+				selection.Ranks[id] = QuotaResetRank{Headroom: account.remaining / account.full, ResetAt: start.Add(account.reset), ExpiresAt: current.Add(time.Hour), ObservedAt: current, WindowSeconds: 604800, Short: &QuotaGateRank{Headroom: account.shortRemaining / account.shortFull, ResetAt: &shortReset, Mode: "fixed"}}
+			}
+			for _, prediction := range estimate {
+				interval := RoutingDemandInterval{From: start.Add(prediction.from), To: start.Add(prediction.to), Demand: RoutingDemandRange{Median: prediction.amount, Upper80: &prediction.amount}}
+				window.Intervals = append(window.Intervals, interval)
+				shortWindow.Intervals = append(shortWindow.Intervals, interval)
+			}
+			if mode == "paced" {
+				selection.Demand = []RoutingDemandInput{{Provider: "claude", Source: "history-forecast", Revision: "synthetic-profile", CalculatedAt: current, ValidUntil: current.Add(15 * time.Minute), Confidence: "medium", History: RoutingDemandHistory{CoverageRatio: 1}, Windows: []RoutingDemandWindow{window, shortWindow}}}
+			}
+			if len(available) == 0 {
+				result.missed += cost
+				continue
+			}
+			picked, errPick := selector.Pick(t.Context(), "claude", "opus", Options{AccountSelection: selection}, available)
+			if errPick != nil {
+				t.Fatal(errPick)
+			}
+			chosen := int(picked.ID[0] - 'a')
+			accounts[chosen].remaining -= cost
+			accounts[chosen].shortRemaining -= cost
+			result.served += cost
+			if elapsed < 24*time.Hour {
+				result.first[chosen] += cost
+			}
+		}
+	}
+	return result
+}
+
+func TestQuotaDeadlineSimulationCases(t *testing.T) {
+	day := 24 * time.Hour
+	base := []deadlineSimulationAccount{{remaining: 80, reset: day}, {remaining: 80, reset: 4 * day}}
+	tests := []struct {
+		name                   string
+		accounts               []deadlineSimulationAccount
+		demand                 []deadlineSimulationDemand
+		wantServed, wantMissed float64
+		wantFirst              []float64
+	}{
+		{"one-day-and-four-day", base, []deadlineSimulationDemand{{0, day, 100}}, 100, 0, []float64{80, 20}},
+		{"equal-resets", []deadlineSimulationAccount{{remaining: 80, reset: day}, {remaining: 80, reset: day}}, []deadlineSimulationDemand{{0, day, 100}}, 100, 0, []float64{50, 50}},
+		{"ten-percent-tomorrow", []deadlineSimulationAccount{{remaining: 10, reset: day}, {remaining: 80, reset: 4 * day}}, []deadlineSimulationDemand{{0, day, 40}}, 40, 0, []float64{10, 30}},
+		{"near-empty", []deadlineSimulationAccount{{remaining: .1, reset: day}, {remaining: 80, reset: 4 * day}}, []deadlineSimulationDemand{{0, day, 40}}, 40, 0, []float64{.1, 39.9}},
+		{"staggered-available", base, []deadlineSimulationDemand{{0, day, 100}, {day, 4 * day, 150}}, 250, 0, []float64{80, 20}},
+		{"rate-only-counterexample", base, []deadlineSimulationDemand{{0, day, 40}, {day, 4 * day, 180}}, 220, 0, []float64{40, 0}},
+		{"genuine-over-demand", base, []deadlineSimulationDemand{{0, day, 100}, {day, 4 * day, 240}}, 260, 80, []float64{80, 20}},
+		{"five-hour-nearly-empty", []deadlineSimulationAccount{{remaining: 80, reset: day, shortRemaining: 1, shortFull: 20, shortReset: 2 * time.Hour}, {remaining: 80, reset: 4 * day, shortRemaining: 20, shortFull: 20, shortReset: 5 * time.Hour}}, []deadlineSimulationDemand{{0, 2 * time.Hour, 8}}, 8, 0, []float64{1, 7}},
+		{"spike-never-strands-current-demand", base, []deadlineSimulationDemand{{0, time.Hour, 150}}, 150, 0, []float64{80, 70}},
+		{"unknown-rank-balances", []deadlineSimulationAccount{{remaining: 80, reset: day, unknown: true}, {remaining: 80, reset: 4 * day}}, []deadlineSimulationDemand{{0, day, 40}}, 40, 0, []float64{20, 20}},
+		{"single-account", base[:1], []deadlineSimulationDemand{{0, day, 40}}, 40, 0, []float64{40}},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			got := simulateQuotaDeadline(t, test.accounts, test.demand, nil, "paced")
+			if math.Abs(got.served-test.wantServed) > .03 || math.Abs(got.missed-test.wantMissed) > .03 {
+				t.Fatalf("served/missed=%g/%g, want %g/%g", got.served, got.missed, test.wantServed, test.wantMissed)
+			}
+			for i, want := range test.wantFirst {
+				if math.Abs(got.first[i]-want) > .03 {
+					t.Fatalf("first-day account%d=%g, want %g", i, got.first[i], want)
+				}
+			}
+		})
+	}
+}
+
+func TestQuotaDeadlineObservedErrorDoesNotThrottle(t *testing.T) {
+	day := 24 * time.Hour
+	accounts := []deadlineSimulationAccount{{remaining: 80, reset: day}, {remaining: 80, reset: 4 * day}}
+	actual := []deadlineSimulationDemand{{0, day, 40}, {day, 4 * day, 180}}
+	for _, scale := range []float64{.5, 2, 4} {
+		estimate := []deadlineSimulationDemand{{0, day, 40 * scale}, {day, 4 * day, 180 * scale}}
+		got := simulateQuotaDeadline(t, accounts, actual, estimate, "paced")
+		if got.served+got.missed < 219.99 {
+			t.Fatalf("demand vanished under scale%g: %+v", scale, got)
+		}
+		// A frozen 4x overestimate is intentionally fallible, not a hidden guarantee.
+		if scale == 4 && (got.missed < 7 || got.missed > 9) {
+			t.Fatalf("expected visible forecast-error shortage, got %+v", got)
+		}
+		if scale < 4 && got.missed > .03 {
+			t.Fatalf("avoidable shortage at scale%g: %+v", scale, got)
+		}
+	}
+	// Under a sudden spike, estimates remain soft even when they predicted little use.
+	spike := simulateQuotaDeadline(t, accounts, []deadlineSimulationDemand{{0, time.Hour, 150}}, []deadlineSimulationDemand{{0, day, 1}}, "paced")
+	if spike.missed > .01 {
+		t.Fatalf("forecast throttled eligible capacity: %+v", spike)
+	}
+}
