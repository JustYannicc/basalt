diff --git a/internal/cluster/management/routing_decisions.go b/internal/cluster/management/routing_decisions.go
new file mode 100644
index 0000000..69c74d2
--- /dev/null
+++ b/internal/cluster/management/routing_decisions.go
@@ -0,0 +1,143 @@
+package management
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	coreauth "github.com/router-for-me/CLIProxyAPIHome/internal/cliproxy/auth"
+)
+
+func (h *Handler) PutChannelGroupRoutingDemand(c *gin.Context) {
+	id, ok := channelIDFromParam(c)
+	if !ok {
+		return
+	}
+	var body struct {
+		Groups         []uint                        `json:"groups"`
+		Capacity       []json.RawMessage             `json:"capacity"`
+		Inputs         []coreauth.RoutingDemandInput `json:"inputs"`
+		ReplaceSources []string                      `json:"replaceSources"`
+	}
+	c.Request.Body = http.MaxBytesReader(c.Writer, c.Request.Body, 512*1024)
+	if errBind := c.ShouldBindJSON(&body); errBind != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid_routing_demand"})
+		return
+	}
+	ctx, cancel := h.requestContext(c)
+	defer cancel()
+	groups, errGroups := h.repo.ResolveRoutingGroups(ctx, id, body.Groups)
+	if errGroups != nil {
+		respondError(c, http.StatusBadRequest, "invalid_routing_scope", errGroups)
+		return
+	}
+	if errStore := h.repo.SetRoutingDemandForGroups(ctx, groups, body.Inputs, body.ReplaceSources, time.Now().UTC(), body.Capacity...); errStore != nil {
+		respondError(c, http.StatusBadRequest, "invalid_routing_demand", errStore)
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"success": true})
+}
+
+func (h *Handler) GetChannelGroupRoutingDecisions(c *gin.Context) {
+	id, ok := channelIDFromParam(c)
+	if !ok {
+		return
+	}
+	ctx, cancel := h.requestContext(c)
+	defer cancel()
+	if _, errGroup := h.repo.GetChannelGroup(ctx, id); errGroup != nil {
+		respondChannelRecordError(c, "channel_group_load_failed", errGroup)
+		return
+	}
+	before := uint64(0)
+	if raw := c.Query("before"); raw != "" {
+		parsed, errParse := strconv.ParseUint(raw, 10, 64)
+		if errParse != nil || parsed == 0 {
+			c.JSON(http.StatusBadRequest, gin.H{"error": "invalid_routing_cursor"})
+			return
+		}
+		before = parsed
+	}
+	limit := 20
+	if raw := c.Query("limit"); raw != "" {
+		parsed, errParse := strconv.Atoi(raw)
+		if errParse != nil || parsed < 1 || parsed > 50 {
+			c.JSON(http.StatusBadRequest, gin.H{"error": "invalid_routing_limit"})
+			return
+		}
+		limit = parsed
+	}
+	groups, errGroups := routingQueryGroups(c)
+	if errGroups != nil {
+		respondError(c, http.StatusBadRequest, "invalid_routing_scope", errGroups)
+		return
+	}
+	groups, errGroups = h.repo.ResolveRoutingGroups(ctx, id, groups)
+	if errGroups != nil {
+		respondError(c, http.StatusBadRequest, "invalid_routing_scope", errGroups)
+		return
+	}
+	now := time.Now().UTC()
+	page := h.repo.RoutingDecisionsForGroups(groups, before, limit, now)
+	current, errCurrent := h.repo.CurrentRoutingForGroups(ctx, groups, now)
+	if errCurrent != nil {
+		respondError(c, http.StatusServiceUnavailable, "routing_state_unavailable", errCurrent)
+		return
+	}
+	page.Current = current
+	c.JSON(http.StatusOK, page)
+}
+
+func (h *Handler) DeleteChannelGroupRoutingDemand(c *gin.Context) {
+	id, ok := channelIDFromParam(c)
+	if !ok {
+		return
+	}
+	source := c.Query("source")
+	if source != "history-forecast" && source != "observed-quota-burn" {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid_routing_source"})
+		return
+	}
+	ctx, cancel := h.requestContext(c)
+	defer cancel()
+	if _, errGroup := h.repo.GetChannelGroup(ctx, id); errGroup != nil {
+		respondChannelRecordError(c, "channel_group_load_failed", errGroup)
+		return
+	}
+	groups, errGroups := routingQueryGroups(c)
+	if errGroups != nil {
+		respondError(c, http.StatusBadRequest, "invalid_routing_scope", errGroups)
+		return
+	}
+	groups, errGroups = h.repo.ResolveRoutingGroups(ctx, id, groups)
+	if errGroups != nil {
+		respondError(c, http.StatusBadRequest, "invalid_routing_scope", errGroups)
+		return
+	}
+	h.repo.DeleteRoutingDemandForGroups(groups, source)
+	c.JSON(http.StatusOK, gin.H{"success": true})
+}
+
+func routingQueryGroups(c *gin.Context) ([]uint, error) {
+	raw := c.Query("groups")
+	if raw == "" {
+		return nil, nil
+	}
+	parts := strings.Split(raw, ",")
+	if len(parts) > 32 {
+		return nil, fmt.Errorf("too many routing groups")
+	}
+	ids := make([]uint, 0, len(parts))
+	for _, part := range parts {
+		id, errParse := strconv.ParseUint(part, 10, 32)
+		if errParse != nil || id == 0 {
+			return nil, fmt.Errorf("invalid routing group")
+		}
+		ids = append(ids, uint(id))
+	}
+	return ids, nil
+}
