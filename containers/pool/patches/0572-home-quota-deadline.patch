diff --git a/internal/cliproxy/auth/routing_current.go b/internal/cliproxy/auth/routing_current.go
new file mode 100644
index 0000000..99e03ef
--- /dev/null
+++ b/internal/cliproxy/auth/routing_current.go
@@ -0,0 +1,73 @@
+package auth
+
+import "time"
+
+type RoutingCurrent struct {
+	Provider    string           `json:"provider"`
+	ModelFamily *string          `json:"modelFamily"`
+	Scope       string           `json:"scope"`
+	ComputedAt  time.Time        `json:"computedAt"`
+	ValidUntil  time.Time        `json:"validUntil"`
+	Status      string           `json:"status"`
+	Plan        *RoutingDecision `json:"plan"`
+}
+
+// ComputeRoutingCurrent evaluates targets without choosing a winner or touching
+// any selector accumulator. No inference traffic is needed for a current view.
+func ComputeRoutingCurrent(selection *AccountSelection, provider string, available []*Auth, now time.Time) RoutingCurrent {
+	result := RoutingCurrent{Provider: provider, Scope: "account-windows", ComputedAt: now, ValidUntil: now.Add(time.Minute), Status: "available"}
+	if len(available) == 0 {
+		result.Status = "unavailable"
+		result.Plan = routingTrace(selection, nil, "", now, nil, nil, nil)
+		result.Plan.Reason = "no-eligible-account"
+		result.Plan.Mode = "refused"
+		return result
+	}
+	reason := ""
+	if !selection.PlanFunded {
+		reason = "credits-only"
+	}
+	for _, account := range available {
+		rank, exists := selection.Ranks[account.ID]
+		if invalid := quotaRankReason(rank, exists, now); invalid != "" && reason == "" {
+			reason = invalid
+		}
+		if exists && rank.ResetAt.Before(result.ValidUntil) {
+			result.ValidUntil = rank.ResetAt
+		}
+		if exists && rank.Short != nil && rank.Short.ResetAt != nil && rank.Short.ResetAt.Before(result.ValidUntil) {
+			result.ValidUntil = *rank.Short.ResetAt
+		}
+		if exists && rank.ExpiresAt.Before(result.ValidUntil) {
+			result.ValidUntil = rank.ExpiresAt
+		}
+	}
+	if selection.Policy != "reset_aware" && selection.Policy != "" {
+		weights := make(map[string]float64, len(available))
+		for _, account := range available {
+			weights[account.ID] = 1 / float64(len(available))
+		}
+		result.Plan = routingTrace(selection, available, "", now, weights, nil, nil)
+		result.Plan.EffectiveStrategy = RoutingStrategy(selection.Policy)
+		result.Plan.Mode = "configured-strategy"
+		result.Plan.Reason = "configured-strategy"
+		return result
+	}
+	if reason != "" {
+		result.Plan = routingTrace(selection, available, "", now, nil, nil, nil)
+		result.Plan.EffectiveStrategy = "round-robin"
+		result.Plan.Mode = "balanced-fallback"
+		result.Plan.Reason = reason
+		if !result.ValidUntil.After(now) {
+			result.ValidUntil = now
+			result.Status = "unavailable"
+		}
+		return result
+	}
+	weights, input, through := quotaDeadlineShares(available, selection, provider, "", now)
+	result.Plan = routingTrace(selection, available, "", now, weights, input, through)
+	if input != nil && input.ValidUntil.Before(result.ValidUntil) {
+		result.ValidUntil = input.ValidUntil
+	}
+	return result
+}
