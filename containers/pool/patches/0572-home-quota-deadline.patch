+func TestQuotaDeadlinePublicStrategySpreadsNewSelections(t *testing.T) {
+	now := time.Now()
+	selection := &coreauth.AccountSelection{Policy: "reset_aware", PlanFunded: true, Ranks: map[string]coreauth.QuotaResetRank{
+		"a": {ResetAt: now.Add(24 * time.Hour), ExpiresAt: now.Add(time.Hour), Headroom: .8},
+		"b": {ResetAt: now.Add(96 * time.Hour), ExpiresAt: now.Add(time.Hour), Headroom: .8},
+	}}
+	selector := selectorFromConfig(&config.Config{}, nil)
+	accounts := []*coreauth.Auth{{ID: "a", Status: coreauth.StatusActive}, {ID: "b", Status: coreauth.StatusActive}}
+	counts := map[string]int{}
+	for i := 0; i < 1000; i++ {
+		selected, errPick := selector.Pick(t.Context(), "claude", "opus", coreauth.Options{AccountSelection: selection}, accounts)
+		if errPick != nil {
+			t.Fatal(errPick)
+		}
+		counts[selected.ID]++
+	}
+	if counts["a"] < 790 || counts["a"] > 810 || counts["b"] < 190 || counts["b"] > 210 {
+		t.Fatalf("reset-aware selection must spread about 80/20, got %v", counts)
+	}
+}
