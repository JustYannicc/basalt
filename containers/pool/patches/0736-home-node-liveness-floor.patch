+package cluster
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+// staleOwnNode subscribes a node with the cluster's default 3 s liveness and backdates its last
+// liveness refresh by age.
+func staleOwnNode(t *testing.T, age time.Duration) (*Repository, HomeIncarnationID, CPANodeMembershipRecord) {
+	t.Helper()
+	ctx := context.Background()
+	repo, home, member := newQuiescenceMembership(t, ctx, "fp-liveness-floor")
+	if errUpdate := repo.db.Model(&CPANodeMembershipRecord{}).Where("certificate_fingerprint = ?", member.CertificateFingerprint).
+		Update("last_seen_at", time.Now().UTC().Add(-age)).Error; errUpdate != nil {
+		t.Fatal(errUpdate)
+	}
+	return repo, home, member
+}
+
+func TestNodeLivenessFloorIsStoredOnEveryNewMembership(t *testing.T) {
+	_, _, member := staleOwnNode(t, 0)
+	if member.CPAHeartbeatTimeout != nodeLivenessFloor {
+		t.Fatalf("membership stored %s, want the %s floor over the cluster's 3 s", member.CPAHeartbeatTimeout, nodeLivenessFloor)
+	}
+}
+
+func TestNodeLivenessFloorKeepsAShortStallFromFencingTheNode(t *testing.T) {
+	repo, home, member := staleOwnNode(t, nodeLivenessFloor/2)
+	if errCleanup := repo.CleanupStaleMemberships(context.Background(), home); errCleanup != nil {
+		t.Fatal(errCleanup)
+	}
+	if state := membershipState(t, repo, member.CertificateFingerprint); state != MembershipStateActive {
+		t.Fatalf("a node stale for half the floor was fenced: state %q", state)
+	}
+}
+
+func TestNodeLivenessFloorStillFencesANodeStalePastIt(t *testing.T) {
+	repo, home, member := staleOwnNode(t, nodeLivenessFloor+5*time.Second)
+	if errCleanup := repo.CleanupStaleMemberships(context.Background(), home); errCleanup != nil {
+		t.Fatal(errCleanup)
+	}
+	if state := membershipState(t, repo, member.CertificateFingerprint); state != MembershipStateCanceling {
+		t.Fatalf("a node stale past the floor was left active: state %q", state)
+	}
+}
