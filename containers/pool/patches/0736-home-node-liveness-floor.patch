@@ -0,0 +1,22 @@
+package cluster
+
+import (
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPIHome/internal/config"
+)
+
+// nodeLivenessFloor is the shortest liveness timeout this Home stores on its own nodes'
+// memberships. Every Home's cleanup, including older Homes in the same cluster, fences a node by
+// the timeout stored on its membership. With the cluster default of 3 s, a few seconds of database
+// stall on this Home let any Home fence a node that is still serving. The cluster-wide setting
+// cannot change while nodes are connected, so this Home raises only its own memberships.
+const nodeLivenessFloor = 15 * time.Second
+
+// nodeLivenessTimeout is the timeout stored on a new membership: the cluster's own, raised toward
+// nodeLivenessFloor but kept one second inside Home's lifecycle rule, which requires the Home
+// heartbeat timeout plus reclaim grace to outlast the stored timeout plus the cancel bound.
+func nodeLivenessTimeout(cfg config.CredentialConcurrencyConfig, nodeHeartbeatTimeout time.Duration) time.Duration {
+	ceiling := nodeHeartbeatTimeout + cfg.ReclaimGrace - cfg.CPACancelBound - time.Second
+	return max(cfg.CPAHeartbeatTimeout, min(nodeLivenessFloor, ceiling))
+}
