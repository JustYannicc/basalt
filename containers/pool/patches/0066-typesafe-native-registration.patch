+
+// Native model contracts reuse Home's existing provider metadata without a catalog registry in the edge.
+func nativeProtocolFromHomeModel(model map[string]any) string {
+	value := homeModelString(model, "type")
+	if !strings.HasPrefix(value, "native:") {
+		return ""
+	}
+	return strings.TrimPrefix(value, "native:")
+}
+func homeModelString(model map[string]any, key string) string {
+	value, _ := model[key].(string)
+	return value
+}
+func nativeEndpointsFromHomeModel(model map[string]any) []string {
+	result := []string{}
+	if values, ok := model["supportedGenerationMethods"].([]any); ok {
+		for _, raw := range values {
+			if value, ok := raw.(string); ok && strings.HasPrefix(value, "/v1/") {
+				result = append(result, value)
+			}
+		}
+	}
+	return result
+}
