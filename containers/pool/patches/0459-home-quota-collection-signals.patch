diff --git a/internal/quota/basalt_collection_signal.go b/internal/quota/basalt_collection_signal.go
new file mode 100644
index 0000000..159123f
--- /dev/null
+++ b/internal/quota/basalt_collection_signal.go
@@ -0,0 +1,210 @@
+package quota
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"strings"
+
+	"github.com/google/uuid"
+	log "github.com/sirupsen/logrus"
+)
+
+const collectionSignalMarker = "POOL_QUOTA_COLLECTION "
+const maxSignalWindows = 32
+
+type collectionSignalKey struct{}
+type returnedWindow struct {
+	ID      string `json:"id"`
+	Seconds *int64 `json:"seconds"`
+}
+type returnedResponse struct {
+	Source  string           `json:"source"`
+	Valid   bool             `json:"valid"`
+	Windows []returnedWindow `json:"windows"`
+}
+type collectionSignal struct {
+	AccountRef string             `json:"account_ref"`
+	Provider   string             `json:"provider"`
+	ProbeOK    bool               `json:"probe_ok"`
+	Responses  []returnedResponse `json:"responses"`
+	Truncated  bool               `json:"truncated"`
+	count      int
+}
+
+func newCollectionSignal(id, provider string) *collectionSignal {
+	// Native IDs correlate with Home inventory. Legacy labels may contain secrets.
+	ref := fmt.Sprintf("sha256:%x", sha256.Sum256([]byte(id)))
+	if parsed, err := uuid.Parse(id); err == nil && parsed.String() == id {
+		ref = id
+	}
+	switch provider {
+	case "codex", "claude", "antigravity", "kimi", "xai", "meta":
+	default:
+		provider = "unknown"
+	}
+	return &collectionSignal{AccountRef: ref, Provider: provider, Responses: []returnedResponse{}}
+}
+
+func (s *collectionSignal) emit() {
+	encoded, err := json.Marshal(s)
+	if err == nil {
+		log.Info(collectionSignalMarker + string(encoded))
+	}
+}
+
+type signalObject map[string]json.RawMessage
+
+func signalMap(raw json.RawMessage) signalObject {
+	var value signalObject
+	_ = json.Unmarshal(raw, &value)
+	return value
+}
+func signalArray(raw json.RawMessage) []json.RawMessage {
+	var value []json.RawMessage
+	_ = json.Unmarshal(raw, &value)
+	return value
+}
+func signalPresent(raw json.RawMessage) bool { return len(raw) > 0 }
+func signalSeconds(raw json.RawMessage, multiplier int64) *int64 {
+	var duration flexInt64
+	_ = json.Unmarshal(raw, &duration)
+	if !duration.set {
+		return nil
+	}
+	seconds, ok := checkedPeriodSeconds(duration.value, multiplier)
+	if !ok || seconds > 315360000 {
+		return nil
+	}
+	return &seconds
+}
+func signalPeriod(m signalObject) *int64 {
+	var unit string
+	_ = json.Unmarshal(m["timeUnit"], &unit)
+	var duration flexInt64
+	_ = json.Unmarshal(m["duration"], &duration)
+	if !duration.set {
+		return nil
+	}
+	_, _, seconds := structuredPeriod(duration.value, unit)
+	if seconds != nil && *seconds > 315360000 {
+		return nil
+	}
+	return seconds
+}
+
+// Inspect field presence before quota parsing can discard an unusable quantity.
+// Only schema paths and durations leave this function; the payload is not retained.
+func recordReturnedWindows(ctx context.Context, source string, body []byte) {
+	s, _ := ctx.Value(collectionSignalKey{}).(*collectionSignal)
+	if s == nil {
+		return
+	}
+	if len(s.Responses) >= 8 {
+		s.Truncated = true
+		return
+	}
+	response := returnedResponse{Source: source, Windows: []returnedWindow{}}
+	var root signalObject
+	response.Valid = json.Unmarshal(body, &root) == nil && root != nil
+	add := func(id string, raw json.RawMessage, seconds *int64) {
+		if !signalPresent(raw) {
+			return
+		}
+		if s.count >= maxSignalWindows {
+			s.Truncated = true
+			return
+		}
+		response.Windows = append(response.Windows, returnedWindow{ID: id, Seconds: seconds})
+		s.count++
+	}
+	if response.Valid {
+		switch source {
+		case "claude":
+			for _, key := range []string{"five_hour", "seven_day", "seven_day_oauth_apps", "seven_day_opus", "seven_day_sonnet", "seven_day_cowork", "iguana_necktie", "extra_usage"} {
+				var seconds *int64
+				if key == "five_hour" {
+					seconds = quotaInt64Ptr(18000)
+				} else if strings.HasPrefix(key, "seven_day") {
+					seconds = quotaInt64Ptr(604800)
+				}
+				add(key, root[key], seconds)
+			}
+		case "codex":
+			limits := func(prefix string, m signalObject) {
+				for _, key := range []string{"primary_window", "secondary_window"} {
+					raw := m[key]
+					add(prefix+"."+key, raw, signalSeconds(signalMap(raw)["limit_window_seconds"], 1))
+				}
+			}
+			limits("rate_limit", signalMap(root["rate_limit"]))
+			limits("code_review_rate_limit", signalMap(root["code_review_rate_limit"]))
+			for i, raw := range signalArray(root["additional_rate_limits"]) {
+				if i >= 32 {
+					s.Truncated = true
+					break
+				}
+				limits(fmt.Sprintf("additional_rate_limits[%d].rate_limit", i), signalMap(signalMap(raw)["rate_limit"]))
+			}
+		case "meta":
+			m := signalMap(root["subs_usage"])
+			add("subs_usage.window", m["window"], signalSeconds(signalMap(m["window"])["window_duration_mins"], 60))
+			add("subs_usage.weekly", m["weekly"], quotaInt64Ptr(604800))
+		case "kimi":
+			add("usage", root["usage"], signalPeriod(signalMap(root["usage"])))
+			for i, raw := range signalArray(root["limits"]) {
+				if i >= 32 {
+					s.Truncated = true
+					break
+				}
+				m := signalMap(raw)
+				period := signalPeriod(m)
+				if window := signalMap(m["window"]); window != nil {
+					period = signalPeriod(window)
+				} else if detail := signalMap(m["detail"]); period == nil && detail != nil {
+					period = signalPeriod(detail)
+				}
+				add(fmt.Sprintf("limits[%d]", i), raw, period)
+			}
+		case "antigravity":
+			for i, raw := range signalArray(root["groups"]) {
+				if i >= 32 {
+					s.Truncated = true
+					break
+				}
+				for j, bucket := range signalArray(signalMap(raw)["buckets"]) {
+					if j >= 32 {
+						s.Truncated = true
+						break
+					}
+					var id string
+					_ = json.Unmarshal(signalMap(bucket)["bucketId"], &id)
+					var seconds *int64
+					if spec, ok := antigravityQuotaBucketSpec(id); ok {
+						seconds = periodSeconds(spec.periodUnit, spec.periodValue)
+					}
+					add(fmt.Sprintf("groups[%d].buckets[%d]", i, j), bucket, seconds)
+				}
+			}
+		case "xai-monthly", "xai-weekly":
+			m := signalMap(root["config"])
+			var seconds *int64
+			var periodType string
+			period := signalMap(m["currentPeriod"])
+			if period == nil {
+				period = signalMap(m["current_period"])
+			}
+			_ = json.Unmarshal(period["type"], &periodType)
+			if strings.EqualFold(periodType, "weekly") || strings.EqualFold(periodType, "week") {
+				seconds = quotaInt64Ptr(604800)
+			}
+			add("config.currentPeriod", m["currentPeriod"], seconds)
+			add("config.current_period", m["current_period"], seconds)
+			for _, key := range []string{"monthlyLimit", "monthly_limit", "creditUsagePercent", "credit_usage_percent"} {
+				add("config."+key, m[key], nil)
+			}
+		}
+	}
+	s.Responses = append(s.Responses, response)
+}
diff --git a/internal/quota/basalt_collection_signal_test.go b/internal/quota/basalt_collection_signal_test.go
