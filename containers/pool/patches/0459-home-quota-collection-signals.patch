index 0000000..83e7a8f
--- /dev/null
+++ b/internal/quota/basalt_collection_signal_test.go
@@ -0,0 +1,142 @@
+package quota
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"github.com/router-for-me/CLIProxyAPIHome/internal/logging"
+	log "github.com/sirupsen/logrus"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestQuotaCollectionSignalActualCollector(t *testing.T) {
+	for _, tc := range []struct {
+		name, body string
+		status     int
+		wantIDs    []string
+		ok         bool
+	}{
+		{"weekly-only", `{"rate_limit":{"secondary_window":{"used_percent":10,"limit_window_seconds":604800}}}`, 200, []string{"rate_limit.secondary_window"}, true},
+		{"returned-invalid-five-hour", `{"rate_limit":{"primary_window":{"used_percent":"private-value","limit_window_seconds":18000},"secondary_window":{"used_percent":10,"limit_window_seconds":604800}},"token":"private-token"}`, 200, []string{"rate_limit.primary_window", "rate_limit.secondary_window"}, false},
+		{"transport-failure", `{"token":"private-token"}`, 429, nil, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			repo := newCollectorTestRepository(t)
+			const id = "11111111-2222-4333-8444-555555555555"
+			seedCollectorAuth(t, repo, id, map[string]any{"type": "codex", "access_token": "private-token"})
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(tc.status)
+				_, _ = w.Write([]byte(tc.body))
+			}))
+			defer server.Close()
+			var output bytes.Buffer
+			oldOut, oldFmt, oldLevel := log.StandardLogger().Out, log.StandardLogger().Formatter, log.GetLevel()
+			log.SetOutput(&output)
+			log.SetFormatter(&logging.LogFormatter{})
+			log.SetLevel(log.InfoLevel)
+			defer func() { log.SetOutput(oldOut); log.SetFormatter(oldFmt); log.SetLevel(oldLevel) }()
+			now := time.Date(2026, 11, 9, 22, 0, 0, 0, time.UTC)
+			NewCollector(repo, Options{Owner: "signal-test", CodexUsageURL: server.URL, Now: func() time.Time { return now }}).collect(context.Background())
+			const marker = "POOL_QUOTA_COLLECTION "
+			var events []map[string]any
+			for _, line := range strings.Split(output.String(), "\n") {
+				if i := strings.Index(line, marker); i >= 0 {
+					var event map[string]any
+					if err := json.Unmarshal([]byte(line[i+len(marker):]), &event); err != nil {
+						t.Fatal(err)
+					}
+					events = append(events, event)
+				}
+			}
+			if len(events) != 1 {
+				t.Fatalf("collection signals=%d, want 1", len(events))
+			}
+			event := events[0]
+			if event["account_ref"] != id || event["probe_ok"] != tc.ok {
+				t.Fatalf("wrong identity/status: %v", event)
+			}
+			encoded, _ := json.Marshal(event)
+			if strings.Contains(string(encoded), "private-") || strings.Contains(string(encoded), "used_percent") {
+				t.Fatal("private quota data escaped")
+			}
+			var ids []string
+			for _, response := range event["responses"].([]any) {
+				for _, window := range response.(map[string]any)["windows"].([]any) {
+					ids = append(ids, window.(map[string]any)["id"].(string))
+				}
+			}
+			if strings.Join(ids, ",") != strings.Join(tc.wantIDs, ",") {
+				t.Fatalf("returned windows=%v, want %v", ids, tc.wantIDs)
+			}
+			if tc.name == "returned-invalid-five-hour" {
+				t.Log(strings.TrimSpace(output.String()))
+			}
+		})
+	}
+}
+
+func TestQuotaCollectionSignalReturnedSchemas(t *testing.T) {
+	for _, tc := range []struct {
+		provider, source, body, id string
+		seconds                    int64
+	}{
+		{"claude", "claude", `{"five_hour":{"utilization":"private-value"},"token":"private-token"}`, "five_hour", 18000},
+		{"claude", "claude", `{"seven_day":{"utilization":10}}`, "seven_day", 604800},
+		{"claude", "claude", `{"five_hour":null}`, "five_hour", 18000},
+		{"codex", "codex", `{"rate_limit":{"primary_window":{"used_percent":"bad","limit_window_seconds":18000}}}`, "rate_limit.primary_window", 18000},
+		{"antigravity", "antigravity", `{"groups":[{"buckets":[{"bucketId":"gemini-5h","remainingFraction":"bad"}]}]}`, "groups[0].buckets[0]", 18000},
+		{"kimi", "kimi", `{"limits":[{"window":{"duration":5,"timeUnit":"TIME_UNIT_HOUR"},"used":"bad"}]}`, "limits[0]", 18000},
+		{"meta", "meta", `{"subs_usage":{"window":{"window_duration_mins":300,"used_percent":"bad"}}}`, "subs_usage.window", 18000},
+		{"xai", "xai-weekly", `{"config":{"currentPeriod":{"type":"weekly"},"creditUsagePercent":"bad"}}`, "config.currentPeriod", 604800},
+	} {
+		t.Run(tc.source+tc.id, func(t *testing.T) {
+			signal := newCollectionSignal("private@email.example", tc.provider)
+			ctx := context.WithValue(context.Background(), collectionSignalKey{}, signal)
+			recordReturnedWindows(ctx, tc.source, []byte(tc.body))
+			if len(signal.Responses) != 1 || !signal.Responses[0].Valid || len(signal.Responses[0].Windows) == 0 {
+				t.Fatal("missing response metadata")
+			}
+			window := signal.Responses[0].Windows[0]
+			if window.ID != tc.id || window.Seconds == nil || *window.Seconds != tc.seconds {
+				t.Fatalf("wrong window: %+v", window)
+			}
+			data, _ := json.Marshal(signal)
+			if strings.Contains(string(data), "private") || strings.Contains(string(data), "utilization") {
+				t.Fatal("private data escaped")
+			}
+		})
+	}
+	signal := newCollectionSignal("legacy-label", "codex")
+	ctx := context.WithValue(context.Background(), collectionSignalKey{}, signal)
+	recordReturnedWindows(ctx, "codex", []byte(`{"rate_limit":`))
+	if signal.Responses[0].Valid || len(signal.Responses[0].Windows) != 0 {
+		t.Fatal("invalid JSON looked like an omission")
+	}
+	for i := 0; i < 20; i++ {
+		recordReturnedWindows(ctx, "codex", []byte(`{"rate_limit":{"primary_window":{"limit_window_seconds":18000}}}`))
+	}
+	if !signal.Truncated || len(signal.Responses) != 8 {
+		t.Fatal("unbounded signal")
+	}
+}
+
+func TestQuotaCollectionSignalBoundedRecord(t *testing.T) {
+	signal := newCollectionSignal("legacy-label", "codex")
+	ctx := context.WithValue(context.Background(), collectionSignalKey{}, signal)
+	var limits []string
+	for i := 0; i < 100; i++ {
+		limits = append(limits, `{"rate_limit":{"primary_window":{"limit_window_seconds":18000},"secondary_window":{"limit_window_seconds":604800}},"limit_name":"private-label"}`)
+	}
+	body := []byte(`{"additional_rate_limits":[` + strings.Join(limits, ",") + `]}`)
+	for i := 0; i < 9; i++ {
+		recordReturnedWindows(ctx, "codex", body)
+	}
+	encoded, _ := json.Marshal(signal)
+	if !signal.Truncated || signal.count != 32 || len(encoded) > 7000 || strings.Contains(string(encoded), "private-label") {
+		t.Fatalf("unbounded/private signal: bytes=%d count=%d", len(encoded), signal.count)
+	}
+}
