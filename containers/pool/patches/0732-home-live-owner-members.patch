@@ -0,0 +1,86 @@
+package cluster
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+// staleNodeOfPeer seeds two live Homes and a node of the peer whose liveness has expired, as when
+// the peer's own database pool is too busy to refresh it.
+func staleNodeOfPeer(t *testing.T, ctx context.Context) (*Repository, HomeIncarnationID, HomeIncarnationID, CPANodeMembershipRecord) {
+	t.Helper()
+	repo, peer, member := newQuiescenceMembership(t, ctx, "fp-peer-owned")
+	self, errSelf := repo.RegisterHomeIncarnation(ctx, "10.0.0.2", 8317, []string{"credential_concurrency_foundation_v1"})
+	if errSelf != nil {
+		t.Fatal(errSelf)
+	}
+	if errUpdate := repo.db.Model(&CPANodeMembershipRecord{}).Where("certificate_fingerprint = ?", member.CertificateFingerprint).
+		Update("last_seen_at", time.Now().UTC().Add(-time.Minute)).Error; errUpdate != nil {
+		t.Fatal(errUpdate)
+	}
+	return repo, self, peer, member
+}
+
+func membershipState(t *testing.T, repo *Repository, fingerprint string) string {
+	t.Helper()
+	var record CPANodeMembershipRecord
+	if errFind := repo.db.First(&record, "certificate_fingerprint = ?", fingerprint).Error; errFind != nil {
+		t.Fatal(errFind)
+	}
+	return record.State
+}
+
+func TestLiveHomeOwnsMembersPeerLeavesItsStaleNode(t *testing.T) {
+	ctx := context.Background()
+	repo, self, _, member := staleNodeOfPeer(t, ctx)
+	if errCleanup := repo.CleanupStaleMemberships(ctx, self); errCleanup != nil {
+		t.Fatal(errCleanup)
+	}
+	if state := membershipState(t, repo, member.CertificateFingerprint); state != MembershipStateActive {
+		t.Fatalf("a peer cancelled the node of a Home that still heartbeats: state %q", state)
+	}
+}
+
+func TestLiveHomeOwnsMembersPeerFencesASilentHomesNode(t *testing.T) {
+	ctx := context.Background()
+	repo, self, peer, member := staleNodeOfPeer(t, ctx)
+	if errUpdate := repo.db.Model(&HomeProcessIncarnationRecord{}).
+		Where("home_ip = ? AND home_port = ? AND started_at = ?", peer.IP, peer.Port, peer.StartedAt).
+		Update("last_seen_at", time.Now().UTC().Add(-time.Hour)).Error; errUpdate != nil {
+		t.Fatal(errUpdate)
+	}
+	if errCleanup := repo.CleanupStaleMemberships(ctx, self); errCleanup != nil {
+		t.Fatal(errCleanup)
+	}
+	if state := membershipState(t, repo, member.CertificateFingerprint); state != MembershipStateCanceling {
+		t.Fatalf("the node of a dead Home was left active: state %q", state)
+	}
+}
+
+func TestLiveHomeOwnsMembersHomeFencesItsOwnStaleNode(t *testing.T) {
+	ctx := context.Background()
+	repo, _, peer, member := staleNodeOfPeer(t, ctx)
+	if errCleanup := repo.CleanupStaleMemberships(ctx, peer); errCleanup != nil {
+		t.Fatal(errCleanup)
+	}
+	if state := membershipState(t, repo, member.CertificateFingerprint); state != MembershipStateCanceling {
+		t.Fatalf("a Home left its own stale node active: state %q", state)
+	}
+}
+
+func TestLiveHomeOwnsMembersPeerFencesAnExpiredHomesNode(t *testing.T) {
+	ctx := context.Background()
+	repo, self, peer, member := staleNodeOfPeer(t, ctx)
+	if errUpdate := repo.db.Model(&HomeProcessIncarnationRecord{}).
+		Where("home_ip = ? AND home_port = ? AND started_at = ?", peer.IP, peer.Port, peer.StartedAt).
+		Update("state", HomeIncarnationExpired).Error; errUpdate != nil {
+		t.Fatal(errUpdate)
+	}
+	if errCleanup := repo.CleanupStaleMemberships(ctx, self); errCleanup != nil {
+		t.Fatal(errCleanup)
+	}
+	if state := membershipState(t, repo, member.CertificateFingerprint); state != MembershipStateCanceling {
+		t.Fatalf("the node of an expired Home was left active: state %q", state)
+	}
+}
