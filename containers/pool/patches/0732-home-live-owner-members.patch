+// homeIncarnationLiveTx reports whether a Home is active and heartbeated within the node heartbeat
+// timeout. It reads the lifecycle row without locking it.
+func homeIncarnationLiveTx(tx *gorm.DB, ip string, port int, startedAt time.Time, now time.Time) (bool, error) {
+	timeout := DefaultHeartbeatTimeout()
+	lifecycle := LifecycleConfigRecord{}
+	errLifecycle := tx.First(&lifecycle, "id = ?", 1).Error
+	if errLifecycle != nil && !errors.Is(errLifecycle, gorm.ErrRecordNotFound) {
+		return false, errLifecycle
+	}
+	if errLifecycle == nil && lifecycle.NodeHeartbeatTimeout > 0 {
+		timeout = lifecycle.NodeHeartbeatTimeout
+	}
+	var live int64
+	errCount := tx.Model(&HomeProcessIncarnationRecord{}).
+		Where("home_ip = ? AND home_port = ? AND started_at = ? AND state = ? AND last_seen_at >= ?", strings.TrimSpace(ip), port, startedAt, HomeIncarnationActive, now.Add(-timeout)).
+		Count(&live).Error
+	return live > 0, errCount
+}
