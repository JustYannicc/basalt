diff --git a/internal/managementhttp/health_test.go b/internal/managementhttp/health_test.go
new file mode 100644
index 0000000..12d132d
--- /dev/null
+++ b/internal/managementhttp/health_test.go
@@ -0,0 +1,63 @@
+package managementhttp
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPIHome/internal/cluster"
+	"github.com/router-for-me/CLIProxyAPIHome/internal/config"
+	"github.com/router-for-me/CLIProxyAPIHome/internal/home"
+	"gorm.io/gorm"
+	gormlogger "gorm.io/gorm/logger"
+)
+
+type healthSQLCounter struct {
+	gormlogger.Interface
+	statements atomic.Int64
+}
+
+func (l *healthSQLCounter) Trace(ctx context.Context, begin time.Time, query func() (string, int64), err error) {
+	l.statements.Add(1)
+	l.Interface.Trace(ctx, begin, query, err)
+}
+
+func TestHealthRouteRemainsDatabaseFreeWithClosedDatabase(t *testing.T) {
+	db, errOpen := cluster.OpenSQLite(context.Background(), filepath.Join(t.TempDir(), "health.db"))
+	if errOpen != nil {
+		t.Fatal(errOpen)
+	}
+	counter := &healthSQLCounter{Interface: db.Logger}
+	db = db.Session(&gorm.Session{Logger: counter})
+	sqlDB, errDB := db.DB()
+	if errDB != nil {
+		t.Fatal(errDB)
+	}
+	if errClose := sqlDB.Close(); errClose != nil {
+		t.Fatal(errClose)
+	}
+	runtime, errRuntime := home.NewRuntime(&config.Config{AuthDir: t.TempDir()})
+	if errRuntime != nil {
+		t.Fatal(errRuntime)
+	}
+	server, errBuild := Build(filepath.Join(t.TempDir(), "unused.yaml"), WithDatabaseManagement(DatabaseManagementOption{
+		Enabled: true, Repository: cluster.NewRepository(db), Runtime: runtime,
+	}))
+	if errBuild != nil {
+		t.Fatal(errBuild)
+	}
+	for range 30 {
+		response := httptest.NewRecorder()
+		server.Engine.ServeHTTP(response, httptest.NewRequest(http.MethodGet, "/healthz", nil))
+		if response.Code != http.StatusOK || response.Body.String() != `{"status":"ok"}` {
+			t.Fatalf("health response = %d %s", response.Code, response.Body.String())
+		}
+	}
+	if count := counter.statements.Load(); count != 0 {
+		t.Fatalf("health SQL statements = %d, want 0", count)
+	}
+}
