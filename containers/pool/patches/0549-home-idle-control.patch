diff --git a/internal/cluster/liveness_postgres.go b/internal/cluster/liveness_postgres.go
new file mode 100644
index 0000000..61d07fe
--- /dev/null
+++ b/internal/cluster/liveness_postgres.go
@@ -0,0 +1,67 @@
+package cluster
+
+import (
+	"context"
+	"strings"
+
+	"gorm.io/gorm"
+)
+
+// Keep membership-before-Home lock order and evaluate database time after both
+// locks. A statement snapshot taken before a lock wait must not renew a stale
+// lifetime or stamp its heartbeat with the time the wait began.
+const refreshPostgresCPALivenessSQL = `
+WITH member AS MATERIALIZED (
+ SELECT certificate_fingerprint FROM cpa_node_membership
+ WHERE certificate_fingerprint = ? AND connected_at = ? AND state = 'active'
+   AND home_ip = ? AND home_port = ? AND home_started_at = ?
+ FOR NO KEY UPDATE
+), home AS MATERIALIZED (
+ SELECT h.state FROM home_process_incarnation h CROSS JOIN member
+ WHERE h.home_ip = ? AND h.home_port = ? AND h.started_at = ?
+ FOR KEY SHARE OF h
+), beat AS MATERIALIZED (
+ SELECT clock_timestamp() AS observed_at FROM home WHERE state = 'active'
+), renewed AS (
+ UPDATE cpa_node_membership m
+ SET last_seen_at = beat.observed_at, updated_at = beat.observed_at
+ FROM member, beat WHERE m.certificate_fingerprint = member.certificate_fingerprint
+ RETURNING m.certificate_fingerprint
+)
+SELECT EXISTS(SELECT 1 FROM member) AS membership_active,
+ COALESCE((SELECT state FROM home), '') AS home_state,
+ EXISTS(SELECT 1 FROM renewed) AS renewed`
+
+func refreshPostgresCPALiveness(ctx context.Context, db *gorm.DB, lifetime ConnectionLifetime) error {
+	var result struct {
+		MembershipActive bool
+		HomeState        string
+		Renewed          bool
+	}
+	// Pin one checkout without BEGIN/COMMIT. The statement owns its row locks
+	// through its implicit commit, before the caller can publish PONG.
+	errRenew := db.WithContext(ctx).Connection(func(conn *gorm.DB) error {
+		return conn.Raw(refreshPostgresCPALivenessSQL,
+			strings.TrimSpace(lifetime.Fingerprint), lifetime.ConnectedAt,
+			strings.TrimSpace(lifetime.Home.IP), lifetime.Home.Port, lifetime.Home.StartedAt,
+			strings.TrimSpace(lifetime.Home.IP), lifetime.Home.Port, lifetime.Home.StartedAt,
+		).Scan(&result).Error
+	})
+	if errRenew != nil {
+		return errRenew
+	}
+	if !result.MembershipActive {
+		return ErrMembershipNotActive
+	}
+	switch result.HomeState {
+	case "":
+		return ErrHomeIncarnationNotFound
+	case HomeIncarnationFenced:
+		return ErrHomeIncarnationFenced
+	case HomeIncarnationActive:
+		if result.Renewed {
+			return nil
+		}
+	}
+	return ErrHomeIncarnationInactive
+}
