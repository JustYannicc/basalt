+package cluster
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"gorm.io/gorm/clause"
+)
+
+func TestPostgresAtomicHeartbeatRefusesInactiveLifetimesWithoutWriting(t *testing.T) {
+	for _, scenario := range []string{"connected-at", "home-identity", "canceling", "closed", "fenced", "retired", "expired", "missing-home"} {
+		t.Run(scenario, func(t *testing.T) {
+			repo, ctx, lifetime := newPostgresLifecycleFixture(t)
+			wantErr := ErrMembershipNotActive
+			switch scenario {
+			case "connected-at":
+				lifetime.ConnectedAt = lifetime.ConnectedAt.Add(time.Second)
+			case "home-identity":
+				lifetime.Home.StartedAt = lifetime.Home.StartedAt.Add(time.Second)
+			case "canceling", "closed":
+				if errUpdate := repo.db.Model(&CPANodeMembershipRecord{}).Where("certificate_fingerprint = ?", lifetime.Fingerprint).Update("state", scenario).Error; errUpdate != nil {
+					t.Fatal(errUpdate)
+				}
+			case "missing-home":
+				wantErr = ErrHomeIncarnationNotFound
+				if errDelete := repo.db.Where("home_ip = ?", lifetime.Home.IP).Delete(&HomeProcessIncarnationRecord{}).Error; errDelete != nil {
+					t.Fatal(errDelete)
+				}
+			default:
+				wantErr = ErrHomeIncarnationInactive
+				if scenario == "fenced" {
+					wantErr = ErrHomeIncarnationFenced
+				}
+				if errUpdate := repo.db.Model(&HomeProcessIncarnationRecord{}).Where("home_ip = ?", lifetime.Home.IP).Update("state", scenario).Error; errUpdate != nil {
+					t.Fatal(errUpdate)
+				}
+			}
+			var before, after CPANodeMembershipRecord
+			if errRead := repo.db.First(&before, "certificate_fingerprint = ?", lifetime.Fingerprint).Error; errRead != nil {
+				t.Fatal(errRead)
+			}
+			if errHeartbeat := repo.RefreshCPALiveness(ctx, lifetime); !errors.Is(errHeartbeat, wantErr) {
+				t.Fatalf("heartbeat error = %v, want %v", errHeartbeat, wantErr)
+			}
+			if errRead := repo.db.First(&after, "certificate_fingerprint = ?", lifetime.Fingerprint).Error; errRead != nil {
+				t.Fatal(errRead)
+			}
+			if !before.LastSeenAt.Equal(after.LastSeenAt) || !before.UpdatedAt.Equal(after.UpdatedAt) {
+				t.Fatal("refused heartbeat changed membership timestamps")
+			}
+		})
+	}
+}
+
+func TestPostgresAtomicHeartbeatRechecksHomeAfterMembershipLockWait(t *testing.T) {
+	repo, ctx, lifetime := newPostgresLifecycleFixture(t)
+	holder := beginTimestampLockHolder(t, ctx, repo)
+	var member CPANodeMembershipRecord
+	if errLock := holder.Clauses(clause.Locking{Strength: "NO KEY UPDATE"}).First(&member, "certificate_fingerprint = ?", lifetime.Fingerprint).Error; errLock != nil {
+		t.Fatal(errLock)
+	}
+	observeLifecycleTransitionPID(t, repo)
+	observer := &lifecycleTransitionPIDObserver{results: make(chan postgresBackendPIDResult, 1)}
+	heartbeatCtx := context.WithValue(ctx, lifecycleTransitionPIDContextKey{}, observer)
+	done := make(chan error, 1)
+	go func() { done <- repo.RefreshCPALiveness(heartbeatCtx, lifetime) }()
+	holderPID := make(chan postgresBackendPIDResult, 1)
+	if errPID := postgresContenderBackendPIDHook(holderPID)(holder); errPID != nil {
+		t.Fatal(errPID)
+	}
+	waitForPostgresContendersBlockedByHolder(t, ctx, repo, holderPID, observer.results)
+	if errFence := repo.FenceHomeIncarnation(ctx, lifetime.Home, "fixture"); errFence != nil {
+		t.Fatal(errFence)
+	}
+	if errCommit := holder.Commit().Error; errCommit != nil {
+		t.Fatal(errCommit)
+	}
+	select {
+	case errHeartbeat := <-done:
+		if !errors.Is(errHeartbeat, ErrHomeIncarnationFenced) {
+			t.Fatalf("heartbeat after concurrent fence = %v", errHeartbeat)
+		}
+	case <-ctx.Done():
+		t.Fatal(ctx.Err())
+	}
+	var after CPANodeMembershipRecord
+	if errRead := repo.db.First(&after, "certificate_fingerprint = ?", lifetime.Fingerprint).Error; errRead != nil {
+		t.Fatal(errRead)
+	}
+	if !member.LastSeenAt.Equal(after.LastSeenAt) || !member.UpdatedAt.Equal(after.UpdatedAt) {
+		t.Fatal("heartbeat renewed after Home was fenced during its lock wait")
+	}
+}
