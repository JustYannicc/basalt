+package quota
+
+import (
+	"encoding/json"
+	"github.com/router-for-me/CLIProxyAPIHome/internal/cluster"
+	log "github.com/sirupsen/logrus"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestQuotaFieldDiagnosticStoredCollector(t *testing.T) {
+	for _, tc := range []struct {
+		name, provider, body       string
+		present, null, valid, five bool
+		status                     int
+	}{
+		{"claude-zero", "claude", `{"five_hour":{"utilization":0,"resets_at":null},"seven_day":{"utilization":30}}`, true, false, true, true, 200},
+		{"claude-null-quantity", "claude", `{"five_hour":{"utilization":null,"resets_at":null},"seven_day":{"utilization":30}}`, true, false, false, true, 200},
+		{"claude-null-window", "claude", `{"five_hour":null,"seven_day":{"utilization":30}}`, true, true, false, false, 200},
+		{"claude-absent", "claude", `{"seven_day":{"utilization":30}}`, false, false, false, false, 200},
+		{"codex-zero", "codex", `{"rate_limit":{"primary_window":{"used_percent":0,"limit_window_seconds":18000}}}`, true, false, true, true, 200},
+		{"codex-null", "codex", `{"rate_limit":{"primary_window":null,"secondary_window":{"used_percent":30,"limit_window_seconds":604800}}}`, true, true, false, false, 200},
+		{"codex-absent", "codex", `{"rate_limit":{"secondary_window":{"used_percent":30,"limit_window_seconds":604800}}}`, false, false, false, false, 200},
+		{"codex-bad-quantity", "codex", `{"rate_limit":{"primary_window":{"used_percent":"private-token","limit_window_seconds":18000}}}`, true, false, false, true, 200},
+		{"transport-failed", "codex", `{"private-token":"never-retained"}`, false, false, false, false, 429},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			repo := newCollectorTestRepository(t)
+			id := "diag-" + tc.name
+			seedCollectorProviderAuth(t, repo, id, tc.provider, map[string]any{"type": tc.provider, "access_token": "private-token"})
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(tc.status)
+				_, _ = w.Write([]byte(tc.body))
+			}))
+			defer server.Close()
+			at := time.Date(2026, 11, 10, 13, 0, 0, 0, time.UTC)
+			c := NewCollector(repo, Options{Owner: "diagnostic", Now: func() time.Time { return at }, ClaudeUsageURL: server.URL, ClaudeProfileURL: server.URL, CodexUsageURL: server.URL, CodexResetCreditsURL: server.URL})
+			auth, _, err := repo.GetAuth(t.Context(), id)
+			if err != nil {
+				t.Fatal(err)
+			}
+			c.collectCredential(t.Context(), auth, true)
+			item, err := repo.GetQuotaCredential(t.Context(), id, at)
+			if err != nil {
+				t.Fatal(err)
+			}
+			d := item.CollectionDiagnostic
+			if d == nil {
+				t.Fatal("collection diagnostic not stored")
+			}
+			f := d.FiveHour
+			if tc.provider == "codex" {
+				f = d.PrimaryWindow
+			}
+			if f == nil || f.Present != tc.present || f.Null != tc.null || f.QuantityValid != tc.valid || f.FiveHour != tc.five {
+				t.Fatalf("wrong field flags: %+v", f)
+			}
+			if (tc.name == "claude-null-quantity") != f.QuantityNull {
+				t.Fatal("null quantity lost")
+			}
+			if d.ResponseReceived != (tc.status == 200) || !d.AttemptedAt.Equal(at) {
+				t.Fatal("wrong collection context")
+			}
+			raw, _ := json.Marshal(d)
+			if strings.Contains(string(raw), "private-") || strings.Contains(string(raw), "utilization") || strings.Contains(string(raw), "used_percent") {
+				t.Fatal("private quantity/body retained")
+			}
+			// A stale deferred writer must not overwrite a newer collection's evidence.
+			newer := *d
+			newer.AttemptedAt = at.Add(time.Minute)
+			newer.JSONValid = false
+			if err := repo.RememberQuotaCollectionDiagnostic(id, newer); err != nil {
+				t.Fatal(err)
+			}
+			if err := repo.RememberQuotaCollectionDiagnostic(id, *d); err != nil {
+				t.Fatal(err)
+			}
+			retained, err := repo.GetQuotaCredential(t.Context(), id, at)
+			if err != nil || retained.CollectionDiagnostic.JSONValid {
+				t.Fatal("old diagnostic replaced newer evidence")
+			}
+			// Normal snapshot writes retain the diagnostic until a new collection replaces it.
+			when := at.Add(2 * time.Minute)
+			_, err = repo.UpsertQuotaSnapshot(t.Context(), cluster.QuotaSnapshotWrite{CredentialID: id, Source: "active_probe", QuotaStatus: "unknown", CollectionStatus: "success", ObservedAt: &when, ReplaceWindows: true})
+			if err != nil {
+				t.Fatal(err)
+			}
+			retained, err = repo.GetQuotaCredential(t.Context(), id, when)
+			if err != nil || retained.CollectionDiagnostic == nil || !retained.CollectionDiagnostic.AttemptedAt.Equal(newer.AttemptedAt) {
+				t.Fatal("snapshot write lost diagnostic")
+			}
+		})
+	}
+}
+
+type blockedQuotaOutput struct{ entered, release chan struct{} }
+
+func (w *blockedQuotaOutput) Write(p []byte) (int, error) {
+	if strings.Contains(string(p), collectionSignalMarker) {
+		close(w.entered)
+		<-w.release
+	}
+	return len(p), nil
+}
+func TestQuotaFieldDiagnosticIndependentOfBlockedStdout(t *testing.T) {
+	repo := newCollectorTestRepository(t)
+	const id = "blocked-output-fixture"
+	seedCollectorProviderAuth(t, repo, id, "codex", map[string]any{"type": "codex", "access_token": "private-token"})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = w.Write([]byte(`{"rate_limit":{"primary_window":{"used_percent":0,"limit_window_seconds":18000}}}`))
+	}))
+	defer server.Close()
+	at := time.Date(2026, 11, 10, 13, 0, 0, 0, time.UTC)
+	c := NewCollector(repo, Options{Owner: "blocked-output", Now: func() time.Time { return at }, CodexUsageURL: server.URL, CodexResetCreditsURL: server.URL})
+	auth, _, err := repo.GetAuth(t.Context(), id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	output := &blockedQuotaOutput{make(chan struct{}), make(chan struct{})}
+	previous := log.StandardLogger().Out
+	log.SetOutput(output)
+	defer log.SetOutput(previous)
+	done := make(chan struct{})
+	go func() { defer close(done); c.collectCredential(t.Context(), auth, true) }()
+	select {
+	case <-output.entered:
+	case <-done:
+		t.Fatal("collector did not reach stdout")
+	}
+	item, err := repo.GetQuotaCredential(t.Context(), id, at)
+	close(output.release)
+	<-done
+	if err != nil || item.CollectionDiagnostic == nil || !item.CollectionDiagnostic.PrimaryWindow.QuantityValid {
+		t.Fatal("stdout blocked diagnostic handoff")
+	}
+}
