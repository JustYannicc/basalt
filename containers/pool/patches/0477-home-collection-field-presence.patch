+package management
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/gin-gonic/gin"
+	coreauth "github.com/router-for-me/CLIProxyAPIHome/internal/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPIHome/internal/cluster"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestQuotaFieldDiagnosticDetailHTTP(t *testing.T) {
+	h, closeRepo := newUsageObservabilityTestHandler(t)
+	defer closeRepo()
+	at := time.Date(2026, 11, 10, 13, 0, 0, 0, time.UTC)
+	auth := &coreauth.Auth{ID: "field-fixture", Index: "field-fixture", Provider: "claude", Status: coreauth.StatusActive, Metadata: map[string]any{"type": "claude", "access_token": "private-token"}, CreatedAt: at, UpdatedAt: at}
+	if _, err := h.repo.UpsertAuth(context.Background(), auth, "test"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := h.repo.UpsertQuotaSnapshot(t.Context(), cluster.QuotaSnapshotWrite{CredentialID: auth.ID, QuotaStatus: "unknown", CollectionStatus: "failed", Source: "active_probe", ObservedAt: &at}); err != nil {
+		t.Fatal(err)
+	}
+	expected := cluster.QuotaCollectionDiagnostic{AttemptedAt: at, Provider: "claude", ResponseReceived: true, JSONValid: true, FiveHour: &cluster.QuotaFieldPresence{Present: true, QuantityNull: true, FiveHour: true}}
+	if err := h.repo.RememberQuotaCollectionDiagnostic(auth.ID, expected); err != nil {
+		t.Fatal(err)
+	}
+	gin.SetMode(gin.TestMode)
+	engine := gin.New()
+	engine.GET("/quota/credentials/:credential_id", h.GetQuotaCredential)
+	response := httptest.NewRecorder()
+	engine.ServeHTTP(response, httptest.NewRequest(http.MethodGet, "/quota/credentials/field-fixture", nil))
+	if response.Code != 200 {
+		t.Fatalf("HTTP %d", response.Code)
+	}
+	var body struct {
+		Collection struct {
+			Diagnostic *cluster.QuotaCollectionDiagnostic `json:"diagnostic"`
+		} `json:"collection"`
+	}
+	if json.Unmarshal(response.Body.Bytes(), &body) != nil || body.Collection.Diagnostic == nil || *body.Collection.Diagnostic.FiveHour != *expected.FiveHour {
+		t.Fatal("stored field flags not readable in detail HTTP")
+	}
+	if strings.Contains(response.Body.String(), "private-token") {
+		t.Fatal("credential leaked")
+	}
+	raw, _ := json.Marshal(body.Collection.Diagnostic)
+	t.Log("FIELD_DIAGNOSTIC_HTTP " + string(raw))
+}
diff --git a/internal/quota/basalt_field_diagnostic.go b/internal/quota/basalt_field_diagnostic.go
--- /dev/null
+++ b/internal/quota/basalt_field_diagnostic.go
@@ -0,0 +1,79 @@
+package quota
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"github.com/router-for-me/CLIProxyAPIHome/internal/cluster"
+	"math"
+	"time"
+)
+
+type fieldDiagnosticKey struct{}
+
+func newFieldDiagnostic(provider string, at time.Time) *cluster.QuotaCollectionDiagnostic {
+	d := &cluster.QuotaCollectionDiagnostic{Provider: provider, AttemptedAt: at.UTC()}
+	switch provider {
+	case "claude":
+		d.FiveHour = &cluster.QuotaFieldPresence{}
+	case "codex":
+		d.PrimaryWindow = &cluster.QuotaFieldPresence{}
+		d.SecondaryWindow = &cluster.QuotaFieldPresence{}
+	default:
+		return nil
+	}
+	return d
+}
+func recordFieldDiagnostic(ctx context.Context, source string, body []byte) {
+	d, _ := ctx.Value(fieldDiagnosticKey{}).(*cluster.QuotaCollectionDiagnostic)
+	if d == nil || d.Provider != source {
+		return
+	}
+	d.ResponseReceived = true
+	var root map[string]json.RawMessage
+	d.JSONValid = json.Unmarshal(body, &root) == nil && root != nil
+	if !d.JSONValid {
+		return
+	}
+	if source == "claude" {
+		*d.FiveHour = fieldPresence(root["five_hour"], true)
+		return
+	}
+	var limits map[string]json.RawMessage
+	_ = json.Unmarshal(root["rate_limit"], &limits)
+	*d.PrimaryWindow = fieldPresence(limits["primary_window"], false)
+	*d.SecondaryWindow = fieldPresence(limits["secondary_window"], false)
+}
+func fieldPresence(raw json.RawMessage, claude bool) cluster.QuotaFieldPresence {
+	f := cluster.QuotaFieldPresence{Present: len(raw) > 0, Null: bytes.Equal(bytes.TrimSpace(raw), []byte("null"))}
+	if !f.Present || f.Null {
+		return f
+	}
+	var fields map[string]json.RawMessage
+	if json.Unmarshal(raw, &fields) != nil || fields == nil {
+		return f
+	}
+	key := "used_percent"
+	if claude {
+		key = "utilization"
+	}
+	quantity := fields[key]
+	f.QuantityNull = bytes.Equal(bytes.TrimSpace(quantity), []byte("null"))
+	var amount float64
+	f.QuantityValid = len(quantity) > 0 && !f.QuantityNull && json.Unmarshal(quantity, &amount) == nil && finiteQuantity(amount)
+	if claude {
+		f.FiveHour = true
+	} else {
+		var seconds int64
+		if json.Unmarshal(fields["limit_window_seconds"], &seconds) == nil {
+			f.FiveHour = seconds == 18000
+			f.QuantityValid = f.QuantityValid && seconds > 0
+		} else {
+			f.QuantityValid = false
+		}
+	}
+	return f
+}
+func finiteQuantity(value float64) bool {
+	return !math.IsNaN(value) && !math.IsInf(value, 0) && value >= 0
+}
diff --git a/internal/quota/basalt_field_diagnostic_test.go b/internal/quota/basalt_field_diagnostic_test.go
