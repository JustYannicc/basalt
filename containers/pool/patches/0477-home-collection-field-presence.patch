+package quota
+
+import (
+	"testing"
+	"time"
+)
+
+func TestQuotaFieldDiagnosticIdleShapes(t *testing.T) {
+	now := time.Date(2026, 11, 10, 13, 0, 0, 0, time.UTC)
+	for _, tc := range []struct {
+		name, provider, body string
+		wantFive             bool
+	}{
+		{"claude-zero-no-reset", "claude", `{"five_hour":{"utilization":0,"resets_at":null},"seven_day":{"utilization":30}}`, true},
+		{"claude-null-unknown", "claude", `{"five_hour":{"utilization":null,"resets_at":null},"seven_day":{"utilization":30}}`, false},
+		{"codex-zero-no-reset", "codex", `{"rate_limit":{"primary_window":{"used_percent":0,"limit_window_seconds":18000},"secondary_window":{"used_percent":30,"limit_window_seconds":604800}}}`, true},
+		{"codex-missing-primary-unknown", "codex", `{"rate_limit":{"secondary_window":{"used_percent":30,"limit_window_seconds":604800}}}`, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			windows, err := parseClaudeUsageWindows([]byte(tc.body), now)
+			if tc.provider == "codex" {
+				windows, err = parseCodexUsageWindows([]byte(tc.body), now)
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			found := false
+			for _, w := range windows {
+				if w.WindowSeconds != nil && *w.WindowSeconds == 18000 {
+					found = true
+					if w.Used == nil || *w.Used != 0 || w.RemainingRatio == nil || *w.RemainingRatio != 1 || w.ResetAt != nil {
+						t.Fatal("zero without reset changed")
+					}
+				}
+			}
+			if found != tc.wantFive {
+				t.Fatalf("five-hour present=%v want=%v", found, tc.wantFive)
+			}
+			t.Logf("five-hour=%v, explicit zero preserved; absent/null remain unknown", found)
+		})
+	}
+}
