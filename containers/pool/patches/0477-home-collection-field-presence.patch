@@ -0,0 +1,79 @@
+package cluster
+
+import (
+	"fmt"
+	"time"
+)
+
+type QuotaFieldPresence struct {
+	Present       bool `json:"present"`
+	Null          bool `json:"null"`
+	QuantityNull  bool `json:"quantity_null"`
+	QuantityValid bool `json:"quantity_valid"`
+	FiveHour      bool `json:"five_hour"`
+}
+
+// A closed projection of the source shape, independent of quota quantities and stdout.
+type QuotaCollectionDiagnostic struct {
+	AttemptedAt      time.Time           `json:"attempted_at"`
+	Provider         string              `json:"provider"`
+	ResponseReceived bool                `json:"response_received"`
+	JSONValid        bool                `json:"json_valid"`
+	FiveHour         *QuotaFieldPresence `json:"five_hour,omitempty"`
+	PrimaryWindow    *QuotaFieldPresence `json:"primary_window,omitempty"`
+	SecondaryWindow  *QuotaFieldPresence `json:"secondary_window,omitempty"`
+}
+
+// The pool owns durable storage; Home only hands off its latest bounded result.
+func (r *Repository) RememberQuotaCollectionDiagnostic(id string, diagnostic QuotaCollectionDiagnostic) error {
+	if diagnostic.AttemptedAt.IsZero() || (diagnostic.Provider != "claude" && diagnostic.Provider != "codex") {
+		return fmt.Errorf("invalid collection diagnostic")
+	}
+	r.quotaDiagnosticMu.Lock()
+	defer r.quotaDiagnosticMu.Unlock()
+	if r.quotaDiagnostics == nil {
+		r.quotaDiagnostics = make(map[string]QuotaCollectionDiagnostic)
+	}
+	previous, exists := r.quotaDiagnostics[id]
+	if exists && previous.AttemptedAt.After(diagnostic.AttemptedAt) {
+		return nil
+	}
+	if !exists && len(r.quotaDiagnostics) >= 512 {
+		oldest := ""
+		var at time.Time
+		for key, value := range r.quotaDiagnostics {
+			if oldest == "" || value.AttemptedAt.Before(at) {
+				oldest = key
+				at = value.AttemptedAt
+			}
+		}
+		delete(r.quotaDiagnostics, oldest)
+	}
+	r.quotaDiagnostics[id] = copyCollectionDiagnostic(diagnostic)
+	return nil
+}
+func (r *Repository) collectionDiagnostic(id string) *QuotaCollectionDiagnostic {
+	r.quotaDiagnosticMu.Lock()
+	defer r.quotaDiagnosticMu.Unlock()
+	value, ok := r.quotaDiagnostics[id]
+	if !ok {
+		return nil
+	}
+	result := copyCollectionDiagnostic(value)
+	return &result
+}
+func copyCollectionDiagnostic(value QuotaCollectionDiagnostic) QuotaCollectionDiagnostic {
+	if value.FiveHour != nil {
+		field := *value.FiveHour
+		value.FiveHour = &field
+	}
+	if value.PrimaryWindow != nil {
+		field := *value.PrimaryWindow
+		value.PrimaryWindow = &field
+	}
+	if value.SecondaryWindow != nil {
+		field := *value.SecondaryWindow
+		value.SecondaryWindow = &field
+	}
+	return value
+}
