@@ -0,0 +1,34 @@
+package cluster
+
+import (
+	"fmt"
+	"testing"
+	"time"
+)
+
+func TestQuotaFieldDiagnosticBoundedHandoff(t *testing.T) {
+	repo := &Repository{}
+	at := time.Date(2026, 11, 10, 13, 0, 0, 0, time.UTC)
+	value := QuotaCollectionDiagnostic{AttemptedAt: at, Provider: "claude", FiveHour: &QuotaFieldPresence{Present: true, QuantityValid: true, FiveHour: true}}
+	if err := repo.RememberQuotaCollectionDiagnostic("first", value); err != nil {
+		t.Fatal(err)
+	}
+	value.FiveHour.QuantityValid = false
+	read := repo.collectionDiagnostic("first")
+	if !read.FiveHour.QuantityValid {
+		t.Fatal("producer mutated published handoff")
+	}
+	read.FiveHour.QuantityValid = false
+	if !repo.collectionDiagnostic("first").FiveHour.QuantityValid {
+		t.Fatal("reader mutated handoff")
+	}
+	for i := 1; i <= 512; i++ {
+		value.AttemptedAt = at.Add(time.Duration(i) * time.Second)
+		if err := repo.RememberQuotaCollectionDiagnostic(fmt.Sprint(i), value); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if len(repo.quotaDiagnostics) != 512 || repo.collectionDiagnostic("first") != nil {
+		t.Fatal("handoff cache is not bounded or did not evict oldest")
+	}
+}
