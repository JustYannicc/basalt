+package openai
+
+import (
+	"errors"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gorilla/websocket"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+// basaltTerminalCloseHangGuard only fails a test that would otherwise hang; no ordering depends on it.
+const basaltTerminalCloseHangGuard = 5 * time.Second
+
+// basaltTerminalCloseRead runs serve on one server socket and returns the client's first read.
+func basaltTerminalCloseRead(t *testing.T, serve func(*responsesWebsocketWriter, *websocket.Conn)) ([]byte, error) {
+	t.Helper()
+	served := make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		defer close(served)
+		conn, errUpgrade := responsesWebsocketUpgrader.Upgrade(w, r, nil)
+		if errUpgrade != nil {
+			t.Error(errUpgrade)
+			return
+		}
+		serve(newResponsesWebsocketWriter(conn), conn)
+	}))
+	defer server.Close()
+	conn, _, errDial := websocket.DefaultDialer.Dial("ws"+strings.TrimPrefix(server.URL, "http"), nil)
+	if errDial != nil {
+		t.Fatalf("dial: %v", errDial)
+	}
+	defer func() { _ = conn.Close() }()
+	_ = conn.SetReadDeadline(time.Now().Add(basaltTerminalCloseHangGuard))
+	_, frame, errRead := conn.ReadMessage()
+	<-served
+	return frame, errRead
+}
+
+// basaltCloseWaits reports each time a close on w starts waiting on another write.
+func basaltCloseWaits(w *responsesWebsocketWriter) <-chan struct{} {
+	waits := make(chan struct{}, 4)
+	w.onCloseWait = func() { waits <- struct{}{} }
+	return waits
+}
+
+func basaltAwaitSignal(t *testing.T, ch <-chan struct{}, what string) {
+	t.Helper()
+	select {
+	case <-ch:
+	case <-time.After(basaltTerminalCloseHangGuard):
+		t.Errorf("timed out waiting for %s", what)
+	}
+}
+
+// basaltReleaseWhenCloseWaits releases a held writeMu once a close is waiting behind it.
+func basaltReleaseWhenCloseWaits(t *testing.T, w *responsesWebsocketWriter, waits <-chan struct{}) {
+	go func() {
+		basaltAwaitSignal(t, waits, "the terminal close to wait for the active write")
+		w.writeMu.Unlock()
+	}()
+}
+
+// A terminal error that lands while another write is finishing still reaches the client,
+// instead of the socket closing under it with no reason (1006).
+func TestBasaltTerminalErrorFrameWaitsForAFinishingWriter(t *testing.T) {
+	payload := []byte(`{"type":"error","status":429}`)
+	frame, errRead := basaltTerminalCloseRead(t, func(w *responsesWebsocketWriter, _ *websocket.Conn) {
+		waits := basaltCloseWaits(w)
+		w.writeMu.Lock()
+		basaltReleaseWhenCloseWaits(t, w, waits)
+		_, _ = w.closeWithPayload(payload)
+	})
+	if errRead != nil || string(frame) != string(payload) {
+		t.Fatalf("client read %q, err=%v; want the terminal error frame", frame, errRead)
+	}
+}
+
+// The replay-required close (1012) is not degraded to a bare disconnect behind a finishing write.
+func TestBasaltReplayCloseWaitsForAFinishingWriter(t *testing.T) {
+	_, errRead := basaltTerminalCloseRead(t, func(w *responsesWebsocketWriter, _ *websocket.Conn) {
+		waits := basaltCloseWaits(w)
+		w.writeMu.Lock()
+		basaltReleaseWhenCloseWaits(t, w, waits)
+		_, _ = w.closeForUpstreamError(cliproxyexecutor.NewUpstreamWebsocketReplayRequiredError())
+	})
+	var closeErr *websocket.CloseError
+	if !errors.As(errRead, &closeErr) || closeErr.Code != websocket.CloseServiceRestart {
+		t.Fatalf("client read err=%v; want close %d", errRead, websocket.CloseServiceRestart)
+	}
+}
+
+// The session's own teardown (closeWithoutError, then the socket) waits for a terminal frame
+// another goroutine is already writing, instead of closing the socket under it.
+func TestBasaltSessionTeardownWaitsForAnInFlightTerminalFrame(t *testing.T) {
+	payload := []byte(`{"type":"error","status":429}`)
+	frame, errRead := basaltTerminalCloseRead(t, func(w *responsesWebsocketWriter, conn *websocket.Conn) {
+		waits := basaltCloseWaits(w)
+		w.writeMu.Lock()
+		terminalDone := make(chan struct{})
+		go func() {
+			defer close(terminalDone)
+			_, _ = w.closeWithPayload(payload)
+		}()
+		basaltAwaitSignal(t, waits, "the terminal close to wait for the active write")
+		teardownDone := make(chan struct{})
+		go func() {
+			defer close(teardownDone)
+			_, _ = w.closeWithoutError()
+			_ = conn.Close()
+		}()
+		basaltAwaitSignal(t, waits, "the teardown to wait for the terminal close")
+		w.writeMu.Unlock()
+		basaltAwaitSignal(t, teardownDone, "the teardown")
+		basaltAwaitSignal(t, terminalDone, "the terminal close")
+	})
+	if errRead != nil || string(frame) != string(payload) {
+		t.Fatalf("client read %q, err=%v; want the terminal error frame", frame, errRead)
+	}
+}
+
+// A writer that never finishes is still cut off: the close gives up within its bound.
+func TestBasaltTerminalCloseStillCutsOffABlockedWriter(t *testing.T) {
+	var took time.Duration
+	_, errRead := basaltTerminalCloseRead(t, func(w *responsesWebsocketWriter, _ *websocket.Conn) {
+		w.writeMu.Lock()
+		defer w.writeMu.Unlock()
+		started := time.Now()
+		_, _ = w.closeWithPayload([]byte(`{"type":"error","status":429}`))
+		took = time.Since(started)
+	})
+	if errRead == nil {
+		t.Fatal("client read a frame behind a blocked writer; want the connection closed")
+	}
+	if took < responsesWebsocketCloseWait || took > responsesWebsocketCloseWait+time.Second {
+		t.Fatalf("close behind a blocked writer took %s; want about %s", took, responsesWebsocketCloseWait)
+	}
+}
+
+// basaltBlockingTerminalCloseConn returns a server socket whose writes can be made to block,
+// like a client that stopped reading.
+func basaltBlockingTerminalCloseConn(t *testing.T) (*websocket.Conn, *blockingWebsocketWriteConn) {
+	t.Helper()
+	clientRaw, serverRaw := net.Pipe()
+	t.Cleanup(func() { _ = clientRaw.Close() })
+	blocking := newBlockingWebsocketWriteConn(serverRaw)
+	t.Cleanup(func() { _ = blocking.Close() })
+
+	type upgraded struct {
+		conn *websocket.Conn
+		err  error
+	}
+	result := make(chan upgraded, 1)
+	go func() {
+		req, errReq := http.NewRequest(http.MethodGet, "http://example.com/v1/responses", nil)
+		if errReq != nil {
+			result <- upgraded{err: errReq}
+			return
+		}
+		req.Header.Set("Connection", "Upgrade")
+		req.Header.Set("Upgrade", "websocket")
+		req.Header.Set("Sec-WebSocket-Version", "13")
+		req.Header.Set("Sec-WebSocket-Key", "dGhlIHNhbXBsZSBub25jZQ==")
+		conn, errUpgrade := responsesWebsocketUpgrader.Upgrade(newHijackableWebsocketResponseWriter(blocking), req, nil)
+		result <- upgraded{conn: conn, err: errUpgrade}
+	}()
+	// Drain the HTTP 101 Switching Protocols response on the client side of the pipe.
+	buf := make([]byte, 512)
+	if _, errRead := clientRaw.Read(buf); errRead != nil {
+		t.Fatalf("read upgrade response: %v", errRead)
+	}
+	got := <-result
+	if got.err != nil {
+		t.Fatalf("upgrade websocket: %v", got.err)
+	}
+	return got.conn, blocking
+}
+
+// A terminal frame stuck on a client that stopped reading cannot hold the session open: the
+// handler's teardown (closeWithoutError, the socket, then waiting for the disconnect watcher)
+// still closes the socket and unblocks the write, without any network deadline.
+func TestBasaltSessionTeardownWaitsForAnInFlightTerminalFrameButAbortsAStuckWrite(t *testing.T) {
+	cases := map[string]func(*responsesWebsocketWriter){
+		"closeWithPayload": func(w *responsesWebsocketWriter) {
+			_, _ = w.closeWithPayload([]byte(`{"type":"error","status":429}`))
+		},
+		"closeForUpstreamError": func(w *responsesWebsocketWriter) {
+			_, _ = w.closeForUpstreamError(cliproxyexecutor.NewUpstreamWebsocketReplayRequiredError())
+		},
+	}
+	for name, terminalClose := range cases {
+		t.Run(name, func(t *testing.T) {
+			conn, blocking := basaltBlockingTerminalCloseConn(t)
+			w := newResponsesWebsocketWriter(conn)
+			blocking.blockWrites.Store(true)
+
+			terminalDone := make(chan struct{})
+			go func() {
+				defer close(terminalDone)
+				terminalClose(w)
+			}()
+			basaltAwaitSignal(t, blocking.writeBlock, "the terminal frame to block in the network write")
+
+			teardownDone := make(chan struct{})
+			go func() {
+				defer close(teardownDone)
+				_, _ = w.closeWithoutError()
+				_ = conn.Close()
+				<-terminalDone
+			}()
+			select {
+			case <-teardownDone:
+			case <-time.After(basaltTerminalCloseHangGuard):
+				_ = blocking.Close()
+				t.Fatal("teardown hung behind a stuck terminal write")
+			}
+		})
+	}
+}
+
+// basaltSilentClientConn returns a server socket whose client never reads, so a server write
+// blocks the way it does on a client that stopped reading, and honours write deadlines.
+func basaltSilentClientConn(t *testing.T) *websocket.Conn {
+	t.Helper()
+	clientRaw, serverRaw := net.Pipe()
+	t.Cleanup(func() { _ = clientRaw.Close(); _ = serverRaw.Close() })
+	type upgraded struct {
+		conn *websocket.Conn
+		err  error
+	}
+	result := make(chan upgraded, 1)
+	go func() {
+		req, errReq := http.NewRequest(http.MethodGet, "http://example.com/v1/responses", nil)
+		if errReq != nil {
+			result <- upgraded{err: errReq}
+			return
+		}
+		req.Header.Set("Connection", "Upgrade")
+		req.Header.Set("Upgrade", "websocket")
+		req.Header.Set("Sec-WebSocket-Version", "13")
+		req.Header.Set("Sec-WebSocket-Key", "dGhlIHNhbXBsZSBub25jZQ==")
+		conn, errUpgrade := responsesWebsocketUpgrader.Upgrade(newHijackableWebsocketResponseWriter(serverRaw), req, nil)
+		result <- upgraded{conn: conn, err: errUpgrade}
+	}()
+	buf := make([]byte, 512)
+	if _, errRead := clientRaw.Read(buf); errRead != nil {
+		t.Fatalf("read upgrade response: %v", errRead)
+	}
+	got := <-result
+	if got.err != nil {
+		t.Fatalf("upgrade websocket: %v", got.err)
+	}
+	return got.conn
+}
+
+// A client that stops reading during the terminal frame is cut within the frame's write bound.
+// The handler writes the terminal frame on the goroutine that later tears the connection down,
+// so no concurrent teardown can end the write; only the write's own deadline does.
+func TestBasaltTerminalCloseStillCutsOffABlockedWriterWhenTheClientStopsReading(t *testing.T) {
+	cases := map[string]func(*responsesWebsocketWriter){
+		"closeWithPayload": func(w *responsesWebsocketWriter) {
+			_, _ = w.closeWithPayload([]byte(`{"type":"error","status":429}`))
+		},
+		"closeForUpstreamError": func(w *responsesWebsocketWriter) {
+			_, _ = w.closeForUpstreamError(cliproxyexecutor.NewUpstreamWebsocketReplayRequiredError())
+		},
+	}
+	for name, terminalClose := range cases {
+		t.Run(name, func(t *testing.T) {
+			conn := basaltSilentClientConn(t)
+			w := newResponsesWebsocketWriter(conn)
+			started := time.Now()
+			done := make(chan struct{})
+			go func() {
+				defer close(done)
+				terminalClose(w)
+				_, _ = w.closeWithoutError()
+				_ = conn.Close()
+			}()
+			select {
+			case <-done:
+			case <-time.After(basaltTerminalCloseHangGuard):
+				_ = conn.Close()
+				t.Fatal("a terminal frame to a client that stopped reading held the connection past its bound")
+			}
+			if took := time.Since(started); took > responsesWebsocketCloseWriteTimeout+time.Second {
+				t.Fatalf("terminal close and teardown took %s; want within about %s", took, responsesWebsocketCloseWriteTimeout)
+			}
+		})
+	}
+}
