+package quota
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+	"time"
+
+	coreauth "github.com/router-for-me/CLIProxyAPIHome/internal/cliproxy/auth"
+)
+
+func TestXAIEligibilityFailureRetainsClosedReasonAndShape(t *testing.T) {
+	for _, tc := range []struct {
+		name, profile, reason                              string
+		jsonValid, camelPresent, camelString, snakePresent bool
+	}{
+		{name: "malformed", profile: `{`, reason: "malformed"},
+		{name: "missing", profile: `{"private-field":"private-value"}`, reason: "missing", jsonValid: true},
+		{name: "ambiguous", profile: `{"subscriptionTier":"SuperGrokPlus","subscription_tier":"SuperGrokPlus","private-field":"private-value"}`, reason: "ambiguous", jsonValid: true, camelPresent: true, camelString: true, snakePresent: true},
+		{name: "non-string", profile: `{"subscriptionTier":{"private-field":"private-value"}}`, reason: "non-string", jsonValid: true, camelPresent: true},
+		{name: "unknown-tier", profile: `{"subscriptionTier":"private-unknown-tier"}`, reason: "unknown-tier", jsonValid: true, camelPresent: true, camelString: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			at := time.Date(2030, 1, 1, 0, 0, 0, 0, time.UTC)
+			server := serveXAIProbeFixture(t, func() xaiProbeFixture {
+				return xaiProbeFixture{profile: tc.profile, monthly: `{"config":{"monthlyLimit":15000,"used":300}}`, weekly: `{"config":{"creditUsagePercent":4,"currentPeriod":{"type":"weekly","end":"2030-01-08T00:00:00Z"}}}`}
+			})
+			repo := newCollectorTestRepository(t)
+			seedCollectorProviderAuth(t, repo, "profile-reason", "xai", map[string]any{"type": "xai", "access_token": "private-token"})
+			c := NewCollector(repo, Options{Owner: "profile-reason", Now: func() time.Time { return at }, XAIBillingURL: server.URL + "/v1/billing"})
+			c.collectCredential(context.Background(), &coreauth.Auth{ID: "profile-reason", Provider: "xai"}, true)
+			item, errGet := repo.GetQuotaCredential(context.Background(), "profile-reason", at)
+			if errGet != nil || item.Error == nil || item.Error.Message != "xAI subscription eligibility could not be confirmed." {
+				t.Fatalf("eligibility fixture failed: %+v %v", item.Error, errGet)
+			}
+			encoded, errEncode := json.Marshal(item.CollectionDiagnostic)
+			if errEncode != nil {
+				t.Fatal(errEncode)
+			}
+			var diagnostic struct {
+				AttemptedAt time.Time `json:"attempted_at"`
+				XAI         struct {
+					Profile *struct {
+						ResponseReceived bool                                            `json:"response_received"`
+						HTTPOK           bool                                            `json:"http_ok"`
+						JSONValid        bool                                            `json:"json_valid"`
+						FailureReason    string                                          `json:"failure_reason"`
+						Fields           map[string]struct{ Present, Null, String bool } `json:"fields"`
+					} `json:"profile"`
+				} `json:"xai"`
+			}
+			if json.Unmarshal(encoded, &diagnostic) != nil || diagnostic.XAI.Profile == nil {
+				t.Fatalf("eligibility reason missing from collector handoff: %s", encoded)
+			}
+			d := diagnostic.XAI.Profile
+			if !diagnostic.AttemptedAt.Equal(at) || d.FailureReason != tc.reason || !d.ResponseReceived || !d.HTTPOK || d.JSONValid != tc.jsonValid {
+				t.Fatalf("wrong eligibility branch: %s", encoded)
+			}
+			camel, snake := d.Fields["subscriptionTier"], d.Fields["subscription_tier"]
+			if len(d.Fields) != 2 || camel.Present != tc.camelPresent || camel.String != tc.camelString || camel.Null || snake.Present != tc.snakePresent {
+				t.Fatalf("wrong profile field shape: %s", encoded)
+			}
+			for _, secret := range []string{"private-field", "private-value", "private-token", "private-unknown-tier", "15000", "SuperGrokPlus"} {
+				if strings.Contains(string(encoded), secret) {
+					t.Fatalf("profile payload leaked into diagnostic: %s", secret)
+				}
+			}
+		})
+	}
+}
