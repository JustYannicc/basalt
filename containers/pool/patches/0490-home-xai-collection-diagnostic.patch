diff --git a/internal/cluster/basalt_xai_diagnostic.go b/internal/cluster/basalt_xai_diagnostic.go
new file mode 100644
--- /dev/null
+++ b/internal/cluster/basalt_xai_diagnostic.go
@@ -0,0 +1,74 @@
+package cluster
+
+type XAIFieldPresence struct {
+	Present bool `json:"present"`
+	Null    bool `json:"null"`
+	Numeric bool `json:"numeric"`
+}
+
+type XAIResponseDiagnostic struct {
+	ResponseReceived bool                        `json:"response_received"`
+	HTTPOK           bool                        `json:"http_ok"`
+	JSONValid        bool                        `json:"json_valid"`
+	Fields           map[string]XAIFieldPresence `json:"fields"`
+}
+
+type XAICollectionDiagnostic struct {
+	Phase                  string                `json:"phase"`
+	VendorCallStarted      bool                  `json:"vendor_call_started"`
+	ProbeFinished          bool                  `json:"probe_finished"`
+	SnapshotWriteAttempted bool                  `json:"snapshot_write_attempted"`
+	SnapshotPersisted      bool                  `json:"snapshot_persisted"`
+	Monthly                XAIResponseDiagnostic `json:"monthly"`
+	Weekly                 XAIResponseDiagnostic `json:"weekly"`
+}
+
+func validXAIPhase(phase string) bool {
+	switch phase {
+	case "claimed", "claim_failed", "claim_not_acquired", "failure_persisted", "snapshot_persisted", "snapshot_write_failed", "lease_lost":
+		return true
+	default:
+		return false
+	}
+}
+
+var xaiMonthlyFields = []string{
+	"config", "config.monthlyLimit", "config.monthly_limit", "config.used",
+	"config.onDemandCap", "config.on_demand_cap", "config.onDemandUsed", "config.on_demand_used",
+}
+var xaiWeeklyFields = []string{
+	"config", "config.creditUsagePercent", "config.credit_usage_percent",
+	"config.currentPeriod", "config.current_period", "config.productUsage", "config.product_usage",
+	"config.productUsage[].usagePercent", "config.productUsage[].usage_percent",
+	"config.product_usage[].usagePercent", "config.product_usage[].usage_percent",
+}
+
+func NewXAIMonthlyDiagnostic() XAIResponseDiagnostic { return xaiResponseFields(xaiMonthlyFields) }
+func NewXAIWeeklyDiagnostic() XAIResponseDiagnostic  { return xaiResponseFields(xaiWeeklyFields) }
+
+func xaiResponseFields(paths []string) XAIResponseDiagnostic {
+	fields := make(map[string]XAIFieldPresence, len(paths))
+	for _, path := range paths {
+		fields[path] = XAIFieldPresence{}
+	}
+	return XAIResponseDiagnostic{Fields: fields}
+}
+
+func copyXAIDiagnostic(value *XAICollectionDiagnostic) *XAICollectionDiagnostic {
+	if value == nil {
+		return nil
+	}
+	copy := *value
+	copy.Monthly = copyXAIResponse(value.Monthly, xaiMonthlyFields)
+	copy.Weekly = copyXAIResponse(value.Weekly, xaiWeeklyFields)
+	return &copy
+}
+
+func copyXAIResponse(value XAIResponseDiagnostic, paths []string) XAIResponseDiagnostic {
+	copy := value
+	copy.Fields = make(map[string]XAIFieldPresence, len(paths))
+	for _, path := range paths {
+		copy.Fields[path] = value.Fields[path]
+	}
+	return copy
+}
