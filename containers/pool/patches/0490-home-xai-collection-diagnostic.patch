+func TestXAIForcedClaimRefusalNamesNoVendorCall(t *testing.T) {
+	for _, phase := range []string{"claim_not_acquired", "claim_failed"} {
+		t.Run(phase, func(t *testing.T) {
+			repo, db := newCollectorTestRepositoryAndDB(t)
+			id := "xai-claim"
+			seedCollectorProviderAuth(t, repo, id, "xai", map[string]any{"type": "xai", "access_token": "private-token"})
+			at := time.Date(2030, 1, 1, 1, 0, 0, 0, time.UTC)
+			claimed, err := repo.ForceClaimEligibleQuotaProbe(t.Context(), id, "other", at, time.Minute)
+			if err != nil || !claimed {
+				t.Fatal("claim fixture failed", err)
+			}
+			if phase == "claim_failed" {
+				if err := db.Exec("DROP TABLE quota_snapshot").Error; err != nil {
+					t.Fatal(err)
+				}
+			}
+			var calls atomic.Int32
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) { calls.Add(1) }))
+			defer server.Close()
+			c := NewCollector(repo, Options{Owner: "diagnostic", Now: func() time.Time { return at }, XAIBillingURL: server.URL})
+			auth, _, err := repo.GetAuth(t.Context(), id)
+			if err != nil {
+				t.Fatal(err)
+			}
+			c.collectCredential(t.Context(), auth, true)
+			if calls.Load() != 0 {
+				t.Fatal("claim refusal called the vendor")
+			}
+			if phase == "claim_failed" {
+				if err := db.AutoMigrate(&cluster.QuotaSnapshotRecord{}); err != nil {
+					t.Fatal(err)
+				}
+			}
+			item, err := repo.GetQuotaCredential(t.Context(), id, at)
+			if err != nil {
+				t.Fatal(err)
+			}
+			d := item.CollectionDiagnostic
+			if d == nil || d.XAI == nil || d.XAI.Phase != phase || d.XAI.VendorCallStarted || d.XAI.ProbeFinished || d.XAI.SnapshotWriteAttempted {
+				t.Fatalf("claim refusal hidden: %+v", d)
+			}
+		})
+	}
+}
