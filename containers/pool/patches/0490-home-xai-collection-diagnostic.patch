+package cluster
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestXAIDiagnosticCopiesOnlyFixedFieldFlags(t *testing.T) {
+	original := &XAICollectionDiagnostic{Phase: "claimed", Monthly: NewXAIMonthlyDiagnostic(), Weekly: NewXAIWeeklyDiagnostic()}
+	original.Monthly.Fields["private-secret"] = XAIFieldPresence{Present: true}
+	original.Monthly.Fields["config.used"] = XAIFieldPresence{Present: true, Numeric: true}
+	copy := copyXAIDiagnostic(original)
+	original.Monthly.Fields["config.used"] = XAIFieldPresence{}
+	if !copy.Monthly.Fields["config.used"].Numeric {
+		t.Fatal("writer mutation changed the retained flags")
+	}
+	copy.Weekly.Fields["config.creditUsagePercent"] = XAIFieldPresence{Present: true}
+	if original.Weekly.Fields["config.creditUsagePercent"].Present {
+		t.Fatal("reader mutation changed the source flags")
+	}
+	raw, _ := json.Marshal(copy)
+	if strings.Contains(string(raw), "private-secret") {
+		t.Fatal("unknown field name escaped the fixed projection")
+	}
+	if validXAIPhase("private-secret") || !validXAIPhase("snapshot_write_failed") {
+		t.Fatal("phase projection is not closed")
+	}
+}
