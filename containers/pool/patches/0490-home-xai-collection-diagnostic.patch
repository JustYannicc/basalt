+func TestXAIFieldPresenceDistinguishesAbsentNullAndNumeric(t *testing.T) {
+	for _, tc := range []struct {
+		name, body, path       string
+		present, null, numeric bool
+	}{
+		{"absent", `{"config":{}}`, "config.used", false, false, false},
+		{"null", `{"config":{"used":null}}`, "config.used", true, true, false},
+		{"zero", `{"config":{"used":0}}`, "config.used", true, false, true},
+		{"numeric string", `{"config":{"used":"0"}}`, "config.used", true, false, true},
+		{"wrapped number", `{"config":{"used":{"val":12}}}`, "config.used", true, false, true},
+		{"nested wrapper", `{"config":{"used":{"val":{"val":12}}}}`, "config.used", true, false, false},
+		{"invalid", `{"config":{"used":"private-token"}}`, "config.used", true, false, false},
+		{"snake percentage", `{"config":{"credit_usage_percent":"0"}}`, "config.credit_usage_percent", true, false, true},
+		{"null config", `{"config":null}`, "config", true, true, false},
+		{"product numeric", `{"config":{"productUsage":[{"usagePercent":0}]}}`, "config.productUsage[].usagePercent", true, false, true},
+		{"product missing", `{"config":{"productUsage":[{"usagePercent":0},{}]}}`, "config.productUsage[].usagePercent", true, false, false},
+		{"product null", `{"config":{"productUsage":[{"usagePercent":0},{"usagePercent":null}]}}`, "config.productUsage[].usagePercent", true, true, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var root map[string]json.RawMessage
+			if err := json.Unmarshal([]byte(tc.body), &root); err != nil {
+				t.Fatal(err)
+			}
+			f := xaiFieldPresence(root, tc.path)
+			if f.Present != tc.present || f.Null != tc.null || f.Numeric != tc.numeric {
+				t.Fatalf("wrong field flags: %+v", f)
+			}
+		})
+	}
+}
