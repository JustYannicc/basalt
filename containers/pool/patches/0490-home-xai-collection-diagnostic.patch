diff --git a/internal/quota/basalt_xai_diagnostic.go b/internal/quota/basalt_xai_diagnostic.go
new file mode 100644
--- /dev/null
+++ b/internal/quota/basalt_xai_diagnostic.go
@@ -0,0 +1,112 @@
+package quota
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"math"
+	"strings"
+	"time"
+
+	coreauth "github.com/router-for-me/CLIProxyAPIHome/internal/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPIHome/internal/cluster"
+)
+
+type xaiRequestMarkerKey struct{}
+type xaiRequestMarker struct{ started, received bool }
+
+func (c *Collector) rememberXAIClaim(auth *coreauth.Auth, at time.Time, force bool, phase string) {
+	// Scheduled scans that find a fresh snapshot must not erase a completed probe's fields.
+	if !force || normalizedQuotaProvider(auth.Provider) != "xai" {
+		return
+	}
+	d := newFieldDiagnostic("xai", at)
+	d.XAI.Phase = phase
+	_ = c.repo.RememberQuotaCollectionDiagnostic(auth.ID, *d)
+}
+
+func xaiDiagnostic(ctx context.Context) *cluster.QuotaCollectionDiagnostic {
+	d, _ := ctx.Value(fieldDiagnosticKey{}).(*cluster.QuotaCollectionDiagnostic)
+	if d == nil || d.XAI == nil {
+		return nil
+	}
+	return d
+}
+
+func recordXAIPersistence(ctx context.Context, phase string, persisted bool) {
+	if d := xaiDiagnostic(ctx); d != nil {
+		d.XAI.Phase = phase
+		d.XAI.SnapshotWriteAttempted = true
+		d.XAI.SnapshotPersisted = persisted
+	}
+}
+
+func recordXAIResponse(ctx context.Context, index int, marker xaiRequestMarker, ok bool, body []byte) {
+	d := xaiDiagnostic(ctx)
+	if d == nil {
+		return
+	}
+	d.XAI.VendorCallStarted = d.XAI.VendorCallStarted || marker.started
+	d.ResponseReceived = d.ResponseReceived || marker.received
+	if index > 1 {
+		return
+	}
+	r := &d.XAI.Monthly
+	if index == 1 {
+		r = &d.XAI.Weekly
+	}
+	r.ResponseReceived, r.HTTPOK = marker.received, ok
+	if !ok {
+		return
+	}
+	var root map[string]json.RawMessage
+	r.JSONValid = json.Unmarshal(body, &root) == nil && root != nil
+	if r.JSONValid {
+		for path := range r.Fields {
+			r.Fields[path] = xaiFieldPresence(root, path)
+		}
+	}
+	d.JSONValid = d.XAI.Monthly.JSONValid && d.XAI.Weekly.JSONValid
+}
+
+func xaiFieldPresence(root map[string]json.RawMessage, path string) cluster.XAIFieldPresence {
+	parent, leaf, wildcard := strings.Cut(path, "[].")
+	values := []json.RawMessage{xaiField(root, path)}
+	if wildcard {
+		var products []map[string]json.RawMessage
+		if json.Unmarshal(xaiField(root, parent), &products) != nil {
+			return cluster.XAIFieldPresence{}
+		}
+		values = nil
+		for _, product := range products {
+			values = append(values, product[leaf])
+		}
+	}
+	f := cluster.XAIFieldPresence{Numeric: len(values) > 0}
+	for _, raw := range values {
+		f.Present = f.Present || len(raw) > 0
+		f.Null = f.Null || bytes.Equal(bytes.TrimSpace(raw), []byte("null"))
+		var number flexFloat
+		if len(raw) == 0 || json.Unmarshal(raw, &number) != nil {
+			f.Numeric = false
+			continue
+		}
+		value := flexFloatValue(number)
+		if value == nil || math.IsNaN(*value) || math.IsInf(*value, 0) {
+			f.Numeric = false
+		}
+	}
+	return f
+}
+
+func xaiField(root map[string]json.RawMessage, path string) json.RawMessage {
+	parts := strings.Split(path, ".")
+	for _, part := range parts[:len(parts)-1] {
+		var next map[string]json.RawMessage
+		if json.Unmarshal(root[part], &next) != nil || next == nil {
+			return nil
+		}
+		root = next
+	}
+	return root[parts[len(parts)-1]]
+}
