+func TestXAICompletedProbeDiagnosticSurvivesFailureWriteAndLeaseLoss(t *testing.T) {
+	for _, phase := range []string{"failure_persisted", "snapshot_write_failed", "lease_lost"} {
+		t.Run(phase, func(t *testing.T) {
+			repo, db := newCollectorTestRepositoryAndDB(t)
+			id := "xai-persistence"
+			seedCollectorProviderAuth(t, repo, id, "xai", map[string]any{"type": "xai", "access_token": "private-token"})
+			old := time.Date(2030, 1, 1, 0, 0, 0, 0, time.UTC)
+			at := old.Add(time.Hour)
+			if _, err := repo.UpsertQuotaSnapshot(t.Context(), cluster.QuotaSnapshotWrite{
+				CredentialID: id, CollectionStatus: "failed", QuotaStatus: "error", Source: "active_probe", LastAttemptAt: &old,
+				Error: &cluster.QuotaCollectionError{Code: "UPSTREAM_RESPONSE_INVALID", Message: "Old safe failure.", OccurredAt: &old},
+			}); err != nil {
+				t.Fatal(err)
+			}
+			if phase == "snapshot_write_failed" {
+				if err := db.Exec(`CREATE TRIGGER fail_xai_completion BEFORE UPDATE ON quota_snapshot WHEN NEW.collection_status = 'failed' BEGIN SELECT RAISE(ABORT, 'synthetic completion failure'); END`).Error; err != nil {
+					t.Fatal(err)
+				}
+			}
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if phase == "lease_lost" && r.URL.Path == "/v1/billing" && r.URL.Query().Get("format") == "" {
+					if err := db.Exec("UPDATE quota_snapshot SET probe_lease_owner = ? WHERE credential_id = ?", "other", id).Error; err != nil {
+						t.Error(err)
+					}
+				}
+				body := `{"config":{"monthlyLimit":15000}}`
+				if r.URL.Path == "/v1/user" {
+					body = `{"subscriptionTier":"SuperGrokPlus"}`
+				}
+				if r.URL.Query().Get("format") == "credits" {
+					body = `{"config":{}}`
+				}
+				_, _ = w.Write([]byte(body))
+			}))
+			defer server.Close()
+			c := NewCollector(repo, Options{Owner: "diagnostic", Now: func() time.Time { return at }, XAIBillingURL: server.URL + "/v1/billing", XAIProfileURL: server.URL + "/v1/user"})
+			auth, _, err := repo.GetAuth(t.Context(), id)
+			if err != nil {
+				t.Fatal(err)
+			}
+			c.collectCredential(t.Context(), auth, true)
+			item, err := repo.GetQuotaCredential(t.Context(), id, at)
+			if err != nil {
+				t.Fatal(err)
+			}
+			d := item.CollectionDiagnostic
+			if d == nil || d.XAI == nil || d.XAI.Phase != phase || !d.AttemptedAt.Equal(at) || !d.XAI.VendorCallStarted || !d.XAI.ProbeFinished || !d.XAI.SnapshotWriteAttempted || d.XAI.SnapshotPersisted != (phase == "failure_persisted") {
+				t.Fatalf("completion visibility lost: %+v", d)
+			}
+			if item.Error == nil || item.Error.OccurredAt == nil {
+				t.Fatal("failure fixture missing")
+			}
+			expected := old
+			if phase == "failure_persisted" {
+				expected = at
+			}
+			if !item.Error.OccurredAt.Equal(expected) {
+				t.Fatalf("wrong saved failure time: %+v", item.Error)
+			}
+			if d.XAI.Monthly.Fields["config.used"].Present {
+				t.Fatal("missing monthly amount became present")
+			}
+		})
+	}
+}
