+)
+
+func TestXAIDiagnosticDetailHTTP(t *testing.T) {
+	h, closeRepo := newUsageObservabilityTestHandler(t)
+	defer closeRepo()
+	at := time.Date(2026, 11, 10, 13, 0, 0, 0, time.UTC)
+	auth := &coreauth.Auth{ID: "field-fixture", Index: "field-fixture", Provider: "xai", Status: coreauth.StatusActive, Metadata: map[string]any{"type": "xai", "access_token": "private-token"}, CreatedAt: at, UpdatedAt: at}
+	if _, err := h.repo.UpsertAuth(context.Background(), auth, "test"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := h.repo.UpsertQuotaSnapshot(t.Context(), cluster.QuotaSnapshotWrite{CredentialID: auth.ID, QuotaStatus: "unknown", CollectionStatus: "failed", Source: "active_probe", ObservedAt: &at}); err != nil {
+		t.Fatal(err)
+	}
+	expected := cluster.QuotaCollectionDiagnostic{AttemptedAt: at, Provider: "xai", XAI: &cluster.XAICollectionDiagnostic{Phase: "snapshot_write_failed", VendorCallStarted: true, ProbeFinished: true, SnapshotWriteAttempted: true, Monthly: cluster.NewXAIMonthlyDiagnostic(), Weekly: cluster.NewXAIWeeklyDiagnostic()}}
+	expected.XAI.Monthly.ResponseReceived = true
+	expected.XAI.Monthly.HTTPOK = true
+	expected.XAI.Monthly.JSONValid = true
+	expected.XAI.Monthly.Fields["config.used"] = cluster.XAIFieldPresence{Present: true, Null: true}
+	if err := h.repo.RememberQuotaCollectionDiagnostic(auth.ID, expected); err != nil {
+		t.Fatal(err)
+	}
+	gin.SetMode(gin.TestMode)
+	engine := gin.New()
+	engine.GET("/quota/credentials/:credential_id", h.GetQuotaCredential)
+	response := httptest.NewRecorder()
+	engine.ServeHTTP(response, httptest.NewRequest(http.MethodGet, "/quota/credentials/field-fixture", nil))
+	if response.Code != 200 {
+		t.Fatalf("HTTP %d", response.Code)
+	}
+	var body struct {
+		Collection struct {
+			Diagnostic *cluster.QuotaCollectionDiagnostic `json:"diagnostic"`
+		} `json:"collection"`
+	}
+	if json.Unmarshal(response.Body.Bytes(), &body) != nil || body.Collection.Diagnostic == nil || body.Collection.Diagnostic.XAI == nil || body.Collection.Diagnostic.XAI.Monthly.Fields["config.used"] != expected.XAI.Monthly.Fields["config.used"] {
+		t.Fatal("stored field flags not readable in detail HTTP")
+	}
+	if strings.Contains(response.Body.String(), "private-token") {
+		t.Fatal("credential leaked")
+	}
+	raw, _ := json.Marshal(body.Collection.Diagnostic)
+	t.Log("XAI_DIAGNOSTIC_HTTP " + string(raw))
+}
