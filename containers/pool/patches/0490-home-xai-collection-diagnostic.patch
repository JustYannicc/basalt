+
+func TestXAIDiagnosticNamesFieldsOnRealCollection(t *testing.T) {
+	repo := newCollectorTestRepository(t)
+	seedCollectorProviderAuth(t, repo, "xai-fields", "xai", map[string]any{"type": "xai", "access_token": "private-token"})
+	at := time.Date(2030, 1, 1, 0, 0, 0, 0, time.UTC)
+	var calls atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		body := `{"config":{"monthlyLimit":15000,"used":null,"private-token":"never-copy"}}`
+		if r.URL.Path == "/v1/user" {
+			body = `{"subscriptionTier":"SuperGrokPlus"}`
+		} else if r.URL.Query().Get("format") == "credits" {
+			body = `{"config":{"creditUsagePercent":12,"currentPeriod":{"type":"weekly","end":"2030-01-08T00:00:00Z"}}}`
+		}
+		_, _ = w.Write([]byte(body))
+	}))
+	defer server.Close()
+	c := NewCollector(repo, Options{Owner: "xai-fields", Now: func() time.Time { return at }, XAIBillingURL: server.URL + "/v1/billing", XAIProfileURL: server.URL + "/v1/user"})
+	auth, _, err := repo.GetAuth(t.Context(), "xai-fields")
+	if err != nil {
+		t.Fatal(err)
+	}
+	c.collectCredential(t.Context(), auth, true)
+	item, err := repo.GetQuotaCredential(t.Context(), auth.ID, at)
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw, _ := json.Marshal(item.CollectionDiagnostic)
+	var d struct {
+		AttemptedAt time.Time `json:"attempted_at"`
+		XAI         *struct {
+			Phase             string `json:"phase"`
+			VendorCallStarted bool   `json:"vendor_call_started"`
+			SnapshotPersisted bool   `json:"snapshot_persisted"`
+			Monthly           struct {
+				Fields map[string]struct{ Present, Null, Numeric bool } `json:"fields"`
+			} `json:"monthly"`
+		} `json:"xai"`
+	}
+	if json.Unmarshal(raw, &d) != nil || d.XAI == nil {
+		t.Fatal("xAI collection has no field-presence handoff")
+	}
+	used := d.XAI.Monthly.Fields["config.used"]
+	if !d.AttemptedAt.Equal(at) || !used.Present || !used.Null || used.Numeric {
+		t.Fatalf("missing or null amount lost its exact field and attempt: %s", raw)
+	}
+	if calls.Load() != 3 || !d.XAI.VendorCallStarted || !d.XAI.SnapshotPersisted {
+		t.Fatalf("vendor/persistence outcome is hidden: %s", raw)
+	}
+	if strings.Contains(string(raw), "private-token") || strings.Contains(string(raw), "never-copy") || strings.Contains(string(raw), "15000") {
+		t.Fatal("response data escaped the closed diagnostic")
+	}
+}
