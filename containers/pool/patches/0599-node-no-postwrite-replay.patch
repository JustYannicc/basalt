diff --git a/sdk/httptransport/submission.go b/sdk/httptransport/submission.go
new file mode 100644
--- /dev/null
+++ b/sdk/httptransport/submission.go
@@ -0,0 +1,184 @@
+package httptransport
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"net/http/httptrace"
+	"strings"
+	"sync/atomic"
+
+	"github.com/MoeForge/moego/ojson"
+)
+
+type submissionKey struct{}
+type submissionState struct {
+	accepted   atomic.Bool
+	redirected atomic.Bool
+	terminal   atomic.Pointer[OutcomeUnknownError]
+}
+
+func (s *submissionState) fail(err error) error {
+	unknown := &OutcomeUnknownError{Cause: err}
+	s.terminal.CompareAndSwap(nil, unknown)
+	return s.terminal.Load()
+}
+
+// WithSubmissionTracking starts one provider attempt. Explicit HTTP refusals do
+// not make later attempts ambiguous; a successful response does.
+func WithSubmissionTracking(ctx context.Context) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	return context.WithValue(ctx, submissionKey{}, &submissionState{})
+}
+
+// WithoutSubmissionTracking keeps side-effect-free operations replayable even
+// when their context came from a generation attempt.
+func WithoutSubmissionTracking(ctx context.Context) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	return context.WithValue(ctx, submissionKey{}, (*submissionState)(nil))
+}
+
+// OutcomeUnknownError means the provider may have executed the request. Its
+// transport cause is available to operators, never included in the public body.
+type OutcomeUnknownError struct{ Cause error }
+
+func (*OutcomeUnknownError) Error() string {
+	doc := ojson.NewDoc([]byte(`{}`))
+	_ = doc.Set("error.message", "Upstream disconnected after submission. The request was not replayed and its outcome is unknown.")
+	_ = doc.Set("error.type", "server_error")
+	_ = doc.Set("error.code", "upstream_outcome_unknown")
+	_ = doc.Set("error.retryable", false)
+	return doc.String()
+}
+func (e *OutcomeUnknownError) Unwrap() error       { return e.Cause }
+func (*OutcomeUnknownError) StatusCode() int       { return http.StatusBadGateway }
+func (*OutcomeUnknownError) IsRequestScoped() bool { return true }
+
+// IsOutcomeUnknown reports an attempt that must never be replayed, even when a
+// configured error rule would otherwise select another model or credential.
+func IsOutcomeUnknown(err error) bool {
+	var unknown *OutcomeUnknownError
+	return errors.As(err, &unknown)
+}
+
+// ClassifySubmissionError preserves observed transport failures and classifies
+// incomplete responses. A definitive provider error can still allow failover.
+func ClassifySubmissionError(ctx context.Context, err error) error {
+	var truncated interface{ IsStreamTruncated() bool }
+	var malformed interface{ IsResponseIncomplete() bool }
+	incomplete := errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) ||
+		(errors.As(err, &truncated) && truncated.IsStreamTruncated()) ||
+		(errors.As(err, &malformed) && malformed.IsResponseIncomplete())
+	return classifySubmissionError(ctx, err, incomplete)
+}
+
+// ClassifyIncompleteResponse marks a protocol failure that left an accepted
+// request without a known outcome, such as a stream with no payload or terminal.
+func ClassifyIncompleteResponse(ctx context.Context, err error) error {
+	return classifySubmissionError(ctx, err, true)
+}
+
+func classifySubmissionError(ctx context.Context, err error, incomplete bool) error {
+	if err == nil || IsOutcomeUnknown(err) || ctx == nil {
+		return err
+	}
+	state, _ := ctx.Value(submissionKey{}).(*submissionState)
+	if state == nil {
+		return err
+	}
+	if terminal := state.terminal.Load(); terminal != nil {
+		return terminal
+	}
+	if !state.accepted.Load() || (!incomplete && !state.redirected.Load()) {
+		return err
+	}
+	return state.fail(err)
+}
+
+type submissionTransport struct {
+	next  http.RoundTripper
+	state *submissionState
+}
+
+func (s *submissionTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	if terminal := s.state.terminal.Load(); terminal != nil {
+		if req.Body != nil {
+			_ = req.Body.Close()
+		}
+		return nil, terminal
+	}
+	switch req.Method {
+	case http.MethodGet, http.MethodHead, http.MethodOptions, http.MethodTrace:
+		if !s.state.accepted.Load() {
+			return s.next.RoundTrip(req)
+		}
+	}
+	var written, responseStarted atomic.Bool
+	trace := &httptrace.ClientTrace{
+		// Even a partial body can be accepted by an upstream that replies early.
+		WroteHeaders: func() { written.Store(true) },
+		WroteRequest: func(info httptrace.WroteRequestInfo) {
+			if info.Err == nil {
+				written.Store(true)
+			}
+		},
+		GotFirstResponseByte: func() { responseStarted.Store(true) },
+	}
+	cloned := req.Clone(httptrace.WithClientTrace(req.Context(), trace))
+	// A replayable body lets net/http repeat a POST with an Idempotency-Key inside
+	// RoundTrip, before the manager can inspect the failed attempt.
+	cloned.GetBody = nil
+	if cloned.Body == nil || cloned.Body == http.NoBody {
+		// net/http treats canonical idempotency map keys as permission to replay an
+		// empty mutation. HTTP field names are case-insensitive: recasing the cloned
+		// keys preserves their wire values and Content-Length: 0 without that opt-in.
+		for _, key := range []string{"Idempotency-Key", "X-Idempotency-Key"} {
+			if values, ok := cloned.Header[key]; ok {
+				lower := strings.ToLower(key)
+				cloned.Header[lower] = append(cloned.Header[lower], values...)
+				delete(cloned.Header, key)
+			}
+		}
+	}
+	response, err := s.next.RoundTrip(cloned)
+	if err != nil {
+		if s.state.accepted.Load() || written.Load() || responseStarted.Load() {
+			return nil, s.state.fail(err)
+		}
+		return response, err
+	}
+	if response != nil {
+		switch response.StatusCode {
+		case http.StatusMovedPermanently, http.StatusFound, http.StatusSeeOther:
+			if req.Method != http.MethodGet && req.Method != http.MethodHead {
+				s.state.redirected.Store(true)
+				s.state.accepted.Store(true)
+			}
+		}
+		if response.StatusCode >= 200 && response.StatusCode < 300 {
+			s.state.accepted.Store(true)
+		}
+		if s.state.accepted.Load() && response.Body != nil {
+			response.Body = &submissionBody{ReadCloser: response.Body, state: s.state}
+		}
+	}
+	return response, nil
+}
+
+type submissionBody struct {
+	io.ReadCloser
+	state *submissionState
+}
+
+func (b *submissionBody) Read(p []byte) (int, error) {
+	n, err := b.ReadCloser.Read(p)
+	if err != nil && !errors.Is(err, io.EOF) {
+		err = b.state.fail(err)
+	}
+	return n, err
+}
diff --git a/sdk/httptransport/submission_lifecycle_test.go b/sdk/httptransport/submission_lifecycle_test.go
new file mode 100644
--- /dev/null
+++ b/sdk/httptransport/submission_lifecycle_test.go
@@ -0,0 +1,34 @@
+package httptransport
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"sync/atomic"
+	"testing"
+)
+
+type terminalCloseBody struct {
+	io.Reader
+	closed atomic.Bool
+}
+
+func (b *terminalCloseBody) Close() error { b.closed.Store(true); return nil }
+
+func TestSubmissionGuardTerminalClosesNextBody(t *testing.T) {
+	ctx := WithSubmissionTracking(context.Background())
+	state, _ := ctx.Value(submissionKey{}).(*submissionState)
+	state.fail(errors.New("accepted disconnect"))
+	body := &terminalCloseBody{Reader: strings.NewReader("fallback")}
+	request, errNew := http.NewRequestWithContext(ctx, http.MethodPost, "https://example.invalid", body)
+	if errNew != nil {
+		t.Fatal(errNew)
+	}
+	transport := &submissionTransport{state: state}
+	_, errRoundTrip := transport.RoundTrip(request)
+	if !IsOutcomeUnknown(errRoundTrip) || !body.closed.Load() {
+		t.Fatalf("error=%v bodyClosed=%t", errRoundTrip, body.closed.Load())
+	}
+}
diff --git a/sdk/httptransport/submission_test.go b/sdk/httptransport/submission_test.go
new file mode 100644
--- /dev/null
+++ b/sdk/httptransport/submission_test.go
@@ -0,0 +1,139 @@
+package httptransport
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"net/http/httptrace"
+	"strings"
+	"sync/atomic"
+	"testing"
+)
+
+func TestSubmissionGuardPreventsInternalPOSTReplay(t *testing.T) {
+	for _, method := range []string{http.MethodPost, http.MethodPatch} {
+		for _, tc := range []struct {
+			name   string
+			body   func() io.Reader
+			header string
+		}{
+			{"payload", func() io.Reader { return strings.NewReader("non-idempotent operation") }, "Idempotency-Key"},
+			{"nil", func() io.Reader { return nil }, "Idempotency-Key"},
+			{"no-body", func() io.Reader { return http.NoBody }, "Idempotency-Key"},
+			{"nil-x-key", func() io.Reader { return nil }, "X-Idempotency-Key"},
+			{"no-body-x-key", func() io.Reader { return http.NoBody }, "X-Idempotency-Key"},
+		} {
+			t.Run(method+"/"+tc.name, func(t *testing.T) {
+				var calls atomic.Int32
+				server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					bodyBytes, _ := io.Copy(io.Discard, r.Body)
+					if calls.Add(1) == 1 {
+						w.WriteHeader(http.StatusNoContent)
+						return
+					}
+					if tc.name != "payload" && (r.ContentLength != 0 || len(r.TransferEncoding) != 0) {
+						t.Errorf("zero framing changed: length=%d transfer=%v", r.ContentLength, r.TransferEncoding)
+					}
+					if tc.name != "payload" && bodyBytes != 0 {
+						t.Errorf("empty request acquired a payload: bytes=%d", bodyBytes)
+					}
+					if r.Header.Get(tc.header) != "synthetic-key" {
+						t.Errorf("idempotency header lost: %q", r.Header.Get(tc.header))
+					}
+					conn, _, errHijack := w.(http.Hijacker).Hijack()
+					if errHijack != nil {
+						t.Error(errHijack)
+						return
+					}
+					_ = conn.Close()
+				}))
+				defer server.Close()
+				client := Decorate(WithSubmissionTracking(context.Background()), server.Client())
+				warm, errWarm := client.Get(server.URL)
+				if errWarm != nil {
+					t.Fatal(errWarm)
+				}
+				_, _ = io.Copy(io.Discard, warm.Body)
+				_ = warm.Body.Close()
+				var reused, wrote atomic.Bool
+				trace := &httptrace.ClientTrace{GotConn: func(info httptrace.GotConnInfo) { reused.Store(info.Reused) }, WroteRequest: func(info httptrace.WroteRequestInfo) { wrote.Store(info.Err == nil) }}
+				request, errRequest := http.NewRequestWithContext(httptrace.WithClientTrace(context.Background(), trace), method, server.URL, tc.body())
+				if errRequest != nil {
+					t.Fatal(errRequest)
+				}
+				request.Header.Set(tc.header, "synthetic-key")
+				originalBody := request.Body
+				_, errDo := client.Do(request)
+				if request.Header.Get(tc.header) != "synthetic-key" {
+					t.Fatal("original request header changed")
+				}
+				if request.Body != originalBody {
+					t.Fatal("original request body changed")
+				}
+				if !IsOutcomeUnknown(errDo) {
+					t.Fatalf("error=%v, want unknown outcome", errDo)
+				}
+				t.Logf("upstream requests including warm GET=%d, reused=%t", calls.Load(), reused.Load())
+				if got := calls.Load(); got != 2 {
+					t.Fatalf("requests=%d, want warm GET plus one POST", got)
+				}
+				if !reused.Load() || !wrote.Load() {
+					t.Fatalf("existing trace lost or warm connection not reused: reused=%v wrote=%v", reused.Load(), wrote.Load())
+				}
+				// An executor's internal fallback must not bypass the manager's terminal decision.
+				_, errRetry := client.Post(server.URL, "text/plain", strings.NewReader("same operation"))
+				if !IsOutcomeUnknown(errRetry) || calls.Load() != 2 {
+					t.Fatalf("internal retry: error=%v requests=%d", errRetry, calls.Load())
+				}
+			})
+		}
+	}
+}
+
+func TestSubmissionGuardHTTPRefusalIsNotAcceptance(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusServiceUnavailable) }))
+	defer server.Close()
+	ctx := WithSubmissionTracking(context.Background())
+	client := Decorate(ctx, server.Client())
+	response, errDo := client.Post(server.URL, "text/plain", strings.NewReader("request"))
+	if errDo != nil {
+		t.Fatal(errDo)
+	}
+	_ = response.Body.Close()
+	if response.StatusCode != http.StatusServiceUnavailable {
+		t.Fatal(response.StatusCode)
+	}
+	if err := ClassifySubmissionError(ctx, io.EOF); IsOutcomeUnknown(err) {
+		t.Fatal("explicit refusal marked accepted")
+	}
+}
+
+func TestSubmissionGuardPreservesSafeEmptyRequestRetry(t *testing.T) {
+	var calls atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if calls.Add(1) != 2 {
+			w.WriteHeader(http.StatusNoContent)
+			return
+		}
+		conn, _, errHijack := w.(http.Hijacker).Hijack()
+		if errHijack != nil {
+			t.Error(errHijack)
+			return
+		}
+		_ = conn.Close()
+	}))
+	defer server.Close()
+	client := Decorate(WithSubmissionTracking(context.Background()), server.Client())
+	for range 2 {
+		response, errGet := client.Get(server.URL)
+		if errGet != nil {
+			t.Fatal(errGet)
+		}
+		_, _ = io.Copy(io.Discard, response.Body)
+		_ = response.Body.Close()
+	}
+	if calls.Load() != 3 {
+		t.Fatalf("safe request not retried: calls=%d", calls.Load())
+	}
+}
