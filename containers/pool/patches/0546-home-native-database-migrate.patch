+package main
+
+import (
+	"encoding/json"
+	"flag"
+	"io"
+	"os"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPIHome/internal/cluster"
+)
+
+func runDatabaseCommand(t *testing.T, args ...string) (int, []byte) {
+	t.Helper()
+	oldArgs, oldFlags, oldStdout := os.Args, flag.CommandLine, os.Stdout
+	reader, writer, errPipe := os.Pipe()
+	if errPipe != nil {
+		t.Fatal(errPipe)
+	}
+	os.Args = append([]string{"home"}, args...)
+	flag.CommandLine = flag.NewFlagSet("home", flag.ContinueOnError)
+	os.Stdout = writer
+	defer func() { os.Args, flag.CommandLine, os.Stdout = oldArgs, oldFlags, oldStdout }()
+	code := run()
+	if errClose := writer.Close(); errClose != nil {
+		t.Fatal(errClose)
+	}
+	output, errRead := io.ReadAll(reader)
+	if errRead != nil {
+		t.Fatal(errRead)
+	}
+	if errClose := reader.Close(); errClose != nil {
+		t.Fatal(errClose)
+	}
+	return code, output
+}
+
+func TestDatabaseMigrateSchemaInfoDoesNotReadConfigOrOpenDatabase(t *testing.T) {
+	t.Chdir(t.TempDir())
+	if errWrite := os.WriteFile("cluster.yaml", []byte("not: [valid YAML"), 0600); errWrite != nil {
+		t.Fatal(errWrite)
+	}
+	code, output := runDatabaseCommand(t, "-db-schema-info")
+	var result cluster.DatabaseSchemaInformation
+	if errDecode := json.Unmarshal(output, &result); errDecode != nil {
+		t.Fatal(errDecode)
+	}
+	if code != 0 || result.FormatVersion != 1 || result.TargetVersion != cluster.DatabaseSchemaVersion() || len(result.RequiredIndexes) == 0 {
+		t.Fatalf("code=%d output=%s", code, output)
+	}
+	if _, errStat := os.Stat("home.db"); !os.IsNotExist(errStat) {
+		t.Fatalf("database fallback opened: %v", errStat)
+	}
+}
+
+func TestDatabaseMigrateRefusesEveryOtherOneTimeMode(t *testing.T) {
+	for _, other := range [][]string{{"-import"}, {"-export"}, {"-db-import", "snapshot"}, {"-db-export", "snapshot"}, {"-db-schema-info"}, {"-db-schema-check"}} {
+		code, output := runDatabaseCommand(t, append([]string{"-db-migrate"}, other...)...)
+		var receipt cluster.DatabaseMigrationReceipt
+		if errDecode := json.Unmarshal(output, &receipt); errDecode != nil {
+			t.Fatal(errDecode)
+		}
+		if code == 0 || receipt.Status != "refused" || receipt.Reason != "invalid_mode" {
+			t.Fatalf("code=%d output=%s", code, output)
+		}
+	}
+}
+
+func TestDatabaseMigrateMissingConfigurationNeverCreatesFallback(t *testing.T) {
+	t.Chdir(t.TempDir())
+	for _, mode := range []string{"-db-migrate", "-db-schema-check"} {
+		code, output := runDatabaseCommand(t, mode)
+		var receipt cluster.DatabaseMigrationReceipt
+		if errDecode := json.Unmarshal(output, &receipt); errDecode != nil {
+			t.Fatal(errDecode)
+		}
+		if code == 0 || receipt.Status != "refused" || receipt.Reason != "postgres_configuration_required" {
+			t.Fatalf("code=%d output=%s", code, output)
+		}
+		if _, errStat := os.Stat("home.db"); !os.IsNotExist(errStat) {
+			t.Fatalf("database fallback opened: %v", errStat)
+		}
+	}
+}
+
+func TestDatabaseMigrateMalformedConfigurationReturnsClosedFailure(t *testing.T) {
+	t.Chdir(t.TempDir())
+	if errWrite := os.WriteFile("cluster.yaml", []byte("private-password: [invalid YAML"), 0600); errWrite != nil {
+		t.Fatal(errWrite)
+	}
+	code, output := runDatabaseCommand(t, "-db-migrate")
+	var receipt cluster.DatabaseMigrationReceipt
+	if errDecode := json.Unmarshal(output, &receipt); errDecode != nil {
+		t.Fatal(errDecode)
+	}
+	if code == 0 || receipt.Status != "failed" || receipt.Reason != "configuration_failed" || receipt.AppliedVersion != nil {
+		t.Fatalf("code=%d output=%s", code, output)
+	}
+}
