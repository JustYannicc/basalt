diff --git a/internal/cluster/database_migrate.go b/internal/cluster/database_migrate.go
new file mode 100644
--- /dev/null
+++ b/internal/cluster/database_migrate.go
@@ -0,0 +1,253 @@
+package cluster
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+
+	"gorm.io/gorm"
+)
+
+// DatabaseSchemaVersion returns this binary's native schema target without database access.
+func DatabaseSchemaVersion() int64 { return currentDatabaseVersion }
+
+// DatabaseSchemaInformation identifies the native work checked by schema readiness.
+type DatabaseSchemaInformation struct {
+	FormatVersion   int      `json:"format_version"`
+	TargetVersion   int64    `json:"target_version"`
+	RequiredIndexes []string `json:"required_indexes"`
+}
+
+// DatabaseSchemaInfo reports the target and required index names without database access.
+func DatabaseSchemaInfo() DatabaseSchemaInformation {
+	names := make([]string, 0, len(reportingIndexes))
+	for _, index := range reportingIndexes {
+		names = append(names, index.name)
+	}
+	return DatabaseSchemaInformation{1, currentDatabaseVersion, names}
+}
+
+// DatabaseMigrationReceipt contains only bounded migration metadata, never driver diagnostics.
+type DatabaseMigrationReceipt struct {
+	FormatVersion   int      `json:"format_version"`
+	TargetVersion   int64    `json:"target_version"`
+	PreviousVersion *int64   `json:"previous_version"`
+	AppliedVersion  *int64   `json:"applied_version"`
+	Status          string   `json:"status"`
+	IndexesChecked  bool     `json:"indexes_checked"`
+	PendingIndexes  []string `json:"pending_indexes"`
+	Reason          string   `json:"reason,omitempty"`
+}
+
+type databaseSchemaObservation struct {
+	state          schemaMigrationState
+	indexesChecked bool
+	pendingIndexes []string
+}
+
+type databaseMigrationOnlyKey struct{}
+type databaseMigrationOnly struct{ committed bool }
+
+var errDatabaseSchemaAhead = errors.New("schema_ahead")
+var errDatabaseSchemaUninitialized = errors.New("schema_uninitialized")
+var errDatabaseSchemaRead = errors.New("schema_read_failed")
+var errDatabaseIndexRead = errors.New("index_read_failed")
+var errDatabaseIndexDefinition = errors.New("index_definition_mismatch")
+
+func exactDatabaseMigrationState(state schemaMigrationState) error {
+	if !state.Initialized || state.Version <= 0 {
+		return errDatabaseSchemaUninitialized
+	}
+	if state.Version > currentDatabaseVersion {
+		return errDatabaseSchemaAhead
+	}
+	return nil
+}
+
+func observeDatabaseSchema(ctx context.Context, db *gorm.DB) (databaseSchemaObservation, error) {
+	observation := databaseSchemaObservation{pendingIndexes: []string{}}
+	state, errRead := readPostgresSchemaMigrationState(ctx, db)
+	observation.state = state
+	if errRead != nil {
+		return observation, errDatabaseSchemaRead
+	}
+	// Earlier layouts may not have the tables required by this candidate's indexes.
+	if !state.Initialized || state.Version != currentDatabaseVersion {
+		return observation, nil
+	}
+	observation.indexesChecked = true
+	var errObservation error
+	for _, index := range reportingIndexes {
+		exists, ready, errIndex := reportingIndexState(db.WithContext(ctx), index)
+		if errIndex != nil || !exists || !ready {
+			observation.pendingIndexes = append(observation.pendingIndexes, index.name)
+		}
+		if errIndex != nil {
+			if errors.Is(errIndex, errReportingIndexDefinition) {
+				if errObservation == nil {
+					errObservation = errDatabaseIndexDefinition
+				}
+			} else {
+				errObservation = errDatabaseIndexRead
+			}
+		}
+	}
+	return observation, errObservation
+}
+
+func observeDatabaseSchemaReadOnly(ctx context.Context, db *gorm.DB) (databaseSchemaObservation, error) {
+	observation := databaseSchemaObservation{pendingIndexes: []string{}}
+	errTransaction := db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var errRead error
+		observation, errRead = observeDatabaseSchema(ctx, tx)
+		return errRead
+	}, &sql.TxOptions{Isolation: sql.LevelRepeatableRead, ReadOnly: true})
+	if errTransaction != nil {
+		if errors.Is(errTransaction, errDatabaseIndexRead) || errors.Is(errTransaction, errDatabaseIndexDefinition) {
+			return observation, errTransaction
+		}
+		return observation, errDatabaseSchemaRead
+	}
+	return observation, nil
+}
+
+func newDatabaseMigrationReceipt() DatabaseMigrationReceipt {
+	return DatabaseMigrationReceipt{FormatVersion: 1, TargetVersion: currentDatabaseVersion, Status: "failed", PendingIndexes: []string{}}
+}
+
+func recordDatabaseObservation(receipt *DatabaseMigrationReceipt, observation databaseSchemaObservation) {
+	if observation.state.Initialized {
+		version := observation.state.Version
+		receipt.AppliedVersion = &version
+	}
+	receipt.IndexesChecked = observation.indexesChecked
+	receipt.PendingIndexes = observation.pendingIndexes
+	if receipt.PendingIndexes == nil {
+		receipt.PendingIndexes = []string{}
+	}
+}
+
+func databaseSchemaReadiness(observation databaseSchemaObservation, errRead error) DatabaseMigrationReceipt {
+	receipt := newDatabaseMigrationReceipt()
+	recordDatabaseObservation(&receipt, observation)
+	if errRead != nil {
+		receipt.Reason = "schema_read_failed"
+		if errors.Is(errRead, errDatabaseIndexRead) {
+			receipt.Reason = "index_read_failed"
+		}
+		if errors.Is(errRead, errDatabaseIndexDefinition) {
+			receipt.Status, receipt.Reason = "refused", "index_definition_mismatch"
+		}
+		return receipt
+	}
+	if errState := exactDatabaseMigrationState(observation.state); errState != nil {
+		receipt.Status, receipt.Reason = "refused", errState.Error()
+		return receipt
+	}
+	if observation.state.Version < currentDatabaseVersion {
+		receipt.Status, receipt.Reason = "pending", "schema_pending"
+		return receipt
+	}
+	if !observation.indexesChecked || len(observation.pendingIndexes) != 0 {
+		receipt.Status, receipt.Reason = "pending", "indexes_pending"
+		return receipt
+	}
+	receipt.Status = "ready"
+	return receipt
+}
+
+// CheckDatabaseSchemaContext reads the native schema marker and every required online index.
+func CheckDatabaseSchemaContext(ctx context.Context, db *gorm.DB) DatabaseMigrationReceipt {
+	if db == nil || db.Dialector == nil || db.Dialector.Name() != "postgres" {
+		receipt := newDatabaseMigrationReceipt()
+		receipt.Status, receipt.Reason = "refused", "postgres_required"
+		return receipt
+	}
+	return databaseSchemaReadiness(observeDatabaseSchemaReadOnly(contextOrBackground(ctx), db))
+}
+
+// MigrateDatabaseContext runs the native migrator once and verifies all native schema work.
+// Compatibility with a serving older binary remains the deployment caller's responsibility.
+func MigrateDatabaseContext(ctx context.Context, db *gorm.DB) DatabaseMigrationReceipt {
+	if db == nil || db.Dialector == nil || db.Dialector.Name() != "postgres" {
+		receipt := newDatabaseMigrationReceipt()
+		receipt.Status, receipt.Reason = "refused", "postgres_required"
+		return receipt
+	}
+	return migrateDatabaseContext(ctx,
+		func(readCtx context.Context) (databaseSchemaObservation, error) {
+			return observeDatabaseSchemaReadOnly(readCtx, db)
+		},
+		func(migrateCtx context.Context) error { return AutoMigrateContext(migrateCtx, db) })
+}
+
+func migrateDatabaseContext(ctx context.Context, read func(context.Context) (databaseSchemaObservation, error), migrate func(context.Context) error) DatabaseMigrationReceipt {
+	ctx = contextOrBackground(ctx)
+	initial, errRead := read(ctx)
+	receipt := databaseSchemaReadiness(initial, errRead)
+	if initial.state.Initialized {
+		version := initial.state.Version
+		receipt.PreviousVersion = &version
+	}
+	if receipt.Status == "ready" {
+		receipt.Status = "noop"
+		return receipt
+	}
+	if receipt.Status != "pending" {
+		return receipt
+	}
+	mode := &databaseMigrationOnly{}
+	ctx = context.WithValue(ctx, databaseMigrationOnlyKey{}, mode)
+	if errMigrate := migrate(ctx); errMigrate != nil {
+		// A native attempt may have committed its version before an online step failed.
+		// Reconcile when readable, while retaining failure even if another process finishes.
+		observed, _ := read(ctx)
+		receipt.AppliedVersion = nil
+		recordDatabaseObservation(&receipt, observed)
+		receipt.Status, receipt.Reason = "failed", "migration_failed"
+		if errors.Is(errMigrate, errDatabaseSchemaAhead) {
+			receipt.Status, receipt.Reason = "refused", "schema_ahead"
+		}
+		if errors.Is(errMigrate, errDatabaseSchemaUninitialized) {
+			receipt.Status, receipt.Reason = "refused", "schema_uninitialized"
+		}
+		return receipt
+	}
+	finalState, errFinal := read(ctx)
+	finalReceipt := databaseSchemaReadiness(finalState, errFinal)
+	finalReceipt.PreviousVersion = receipt.PreviousVersion
+	if finalReceipt.Status != "ready" {
+		if finalReceipt.Status == "pending" {
+			finalReceipt.Status = "refused"
+		}
+		return finalReceipt
+	}
+	finalReceipt.Status = "noop"
+	if mode.committed || len(initial.pendingIndexes) != 0 {
+		finalReceipt.Status = "migrated"
+	}
+	return finalReceipt
+}
+
+// exactMigrationOperations checks every native observation, including the locked re-read.
+// It adds no lock or transaction around the existing migration coordinator.
+func exactMigrationOperations(operations schemaMigrationOperations) schemaMigrationOperations {
+	checkedRead := func(read func(context.Context) (schemaMigrationState, error)) func(context.Context) (schemaMigrationState, error) {
+		return func(ctx context.Context) (schemaMigrationState, error) {
+			state, errRead := read(ctx)
+			if errRead != nil {
+				return state, errRead
+			}
+			return state, exactDatabaseMigrationState(state)
+		}
+	}
+	return schemaMigrationOperations{
+		currentVersion: checkedRead(operations.currentVersion),
+		tryLock: func(ctx context.Context, run func(lockedSchemaMigrationOperations) error) (bool, error) {
+			return operations.tryLock(ctx, func(locked lockedSchemaMigrationOperations) error {
+				locked.currentVersion = checkedRead(locked.currentVersion)
+				return run(locked)
+			})
+		},
+	}
+}
