diff --git a/cmd/home/database_migrate.go b/cmd/home/database_migrate.go
new file mode 100644
--- /dev/null
+++ b/cmd/home/database_migrate.go
@@ -0,0 +1,69 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"os"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPIHome/internal/cluster"
+	log "github.com/sirupsen/logrus"
+)
+
+func writeDatabaseSchemaInfo() int {
+	if errEncode := json.NewEncoder(os.Stdout).Encode(cluster.DatabaseSchemaInfo()); errEncode != nil {
+		return 1
+	}
+	return 0
+}
+
+func databaseMigrationFailure(status, reason string) cluster.DatabaseMigrationReceipt {
+	return cluster.DatabaseMigrationReceipt{FormatVersion: 1, TargetVersion: cluster.DatabaseSchemaVersion(), Status: status, Reason: reason, PendingIndexes: []string{}}
+}
+
+func writeDatabaseMigrationReceipt(receipt cluster.DatabaseMigrationReceipt) int {
+	if errEncode := json.NewEncoder(os.Stdout).Encode(receipt); errEncode != nil {
+		return 1
+	}
+	if receipt.Status != "migrated" && receipt.Status != "noop" && receipt.Status != "ready" {
+		return 1
+	}
+	return 0
+}
+
+func runDatabaseMigration(ctx context.Context, checkOnly bool) int {
+	// One-shot callers receive only a closed receipt, including on native driver errors.
+	previousOutput := log.StandardLogger().Out
+	log.SetOutput(io.Discard)
+	defer log.SetOutput(previousOutput)
+	ctx, cancel := context.WithTimeout(ctx, 10*time.Minute)
+	defer cancel()
+	cfg, exists, errConfig := cluster.LoadConfigOptional("")
+	if errConfig != nil {
+		return writeDatabaseMigrationReceipt(databaseMigrationFailure("failed", "configuration_failed"))
+	}
+	// Never create an implicit local database when deployment configuration is missing.
+	if !exists || cfg == nil || cfg.DatabaseBackend() != cluster.DatabaseBackendPostgres {
+		return writeDatabaseMigrationReceipt(databaseMigrationFailure("refused", "postgres_configuration_required"))
+	}
+	db, _, errOpen := openRuntimeDatabase(ctx, cfg, true, "")
+	if errOpen != nil {
+		return writeDatabaseMigrationReceipt(databaseMigrationFailure("failed", "database_open_failed"))
+	}
+	sqlDB, errHandle := db.DB()
+	if errHandle != nil {
+		return writeDatabaseMigrationReceipt(databaseMigrationFailure("failed", "database_handle_failed"))
+	}
+	var receipt cluster.DatabaseMigrationReceipt
+	if checkOnly {
+		receipt = cluster.CheckDatabaseSchemaContext(ctx, db)
+	} else {
+		receipt = cluster.MigrateDatabaseContext(ctx, db)
+	}
+	// Successful closure is part of completion; do not publish success before it.
+	if errClose := sqlDB.Close(); errClose != nil {
+		receipt.Status, receipt.Reason = "failed", "database_close_failed"
+	}
+	return writeDatabaseMigrationReceipt(receipt)
+}
