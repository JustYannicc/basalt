+func TestDatabaseMigrateObservationRequiresReadonlyRepeatableReadTransaction(t *testing.T) {
+	var options driver.TxOptions
+	sqlDB := sql.OpenDB(migrationObservationConnector{options: &options})
+	defer func() {
+		if errClose := sqlDB.Close(); errClose != nil {
+			t.Error(errClose)
+		}
+	}()
+	db, errOpen := gorm.Open(postgres.New(postgres.Config{Conn: sqlDB}), &gorm.Config{DisableAutomaticPing: true})
+	if errOpen != nil {
+		t.Fatal(errOpen)
+	}
+	receipt := CheckDatabaseSchemaContext(context.Background(), db)
+	if !options.ReadOnly || options.Isolation != driver.IsolationLevel(sql.LevelRepeatableRead) {
+		t.Fatalf("transaction options=%+v", options)
+	}
+	if receipt.Status != "failed" || receipt.Reason != "schema_read_failed" || receipt.AppliedVersion != nil {
+		t.Fatalf("receipt=%+v", receipt)
+	}
+}
