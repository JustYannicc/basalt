+func TestDatabaseMigrateRechecksFutureVersionInsideNativeLock(t *testing.T) {
+	migrated := false
+	operations := exactMigrationOperations(schemaMigrationOperations{
+		currentVersion: func(context.Context) (schemaMigrationState, error) {
+			return schemaMigrationState{Version: currentDatabaseVersion - 1, Initialized: true}, nil
+		},
+		tryLock: func(ctx context.Context, run func(lockedSchemaMigrationOperations) error) (bool, error) {
+			return true, run(lockedSchemaMigrationOperations{
+				currentVersion: func(context.Context) (schemaMigrationState, error) {
+					return schemaMigrationState{Version: currentDatabaseVersion + 1, Initialized: true}, nil
+				},
+				migrateToVersion: func(context.Context, int64, int64) error { migrated = true; return nil },
+			})
+		},
+	})
+	_, errMigrate := coordinateSchemaMigration(context.Background(), currentDatabaseVersion, time.Millisecond, time.Second, false, operations)
+	if !errors.Is(errMigrate, errDatabaseSchemaAhead) || migrated {
+		t.Fatalf("migrated=%v error=%v", migrated, errMigrate)
+	}
