@@ -0,0 +1,43 @@
+package quota
+
+import (
+    "context"
+    "fmt"
+    "net/http"
+    "net/http/httptest"
+    "testing"
+    "time"
+)
+
+// Fixture from upstream Home #186's xaiPaidFixture: proto3 omits a zero percentage.
+func TestBasaltXAIPaidOmittedZeroStoresReading(t *testing.T) {
+    now := time.Date(2026, 11, 6, 0, 0, 0, 0, time.UTC)
+    profile := `{"subscriptionTier":"SuperGrokPlus"}`
+    monthly := `{"config":{"monthlyLimit":0,"used":0,"onDemandCap":0}}`
+    weekly := fmt.Sprintf(`{"config":{"currentPeriod":{"type":"USAGE_PERIOD_TYPE_WEEKLY","start":%q,"end":%q}}}`,
+        now.Add(-time.Hour).Format(time.RFC3339), now.Add(6*24*time.Hour).Format(time.RFC3339))
+    server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+        body := monthly
+        if r.URL.Path == "/v1/user" {
+            if r.URL.Query().Get("include") != "subscription" { t.Error("profile request lacks subscription metadata") }
+            body = profile
+        } else if r.URL.Query().Get("format") == "credits" { body = weekly }
+        w.Header().Set("Content-Type", "application/json")
+        _, _ = w.Write([]byte(body))
+    }))
+    defer server.Close()
+    repo := newCollectorTestRepository(t)
+    seedCollectorProviderAuth(t, repo, "xai-paid-omitted", "xai", map[string]any{"type":"xai", "access_token":"fixture"})
+    collector := NewCollector(repo, Options{Owner:"omitted-zero", XAIBillingURL:server.URL+"/v1/billing", Now:func() time.Time { return now }})
+    collector.collect(context.Background())
+    item, errGet := repo.GetQuotaCredential(context.Background(), "xai-paid-omitted", now)
+    if errGet != nil { t.Fatalf("reading: %v", errGet) }
+    if item.CollectionStatus != "success" || item.Error != nil || len(item.Windows) != 1 {
+        t.Fatalf("paid omitted-zero response did not store usage: status=%s error=%+v windows=%d", item.CollectionStatus, item.Error, len(item.Windows))
+    }
+    window := item.Windows[0]
+    if window.ID != "xai-weekly-usage" || window.Used == nil || *window.Used != 0 || window.Remaining == nil || *window.Remaining != 100 || window.ResetAt == nil || !window.ResetAt.Equal(now.Add(6*24*time.Hour)) {
+        t.Fatalf("incorrect stored weekly usage: %+v", window)
+    }
+    if item.Plan == nil || item.Plan.Name != "SuperGrok Plus" { t.Fatalf("incorrect paid plan: %+v", item.Plan) }
+}
