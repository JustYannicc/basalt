+
+func (*basaltAccountedDispatcher) HeartbeatOK() bool { return true }
+
+func (d *basaltAccountedDispatcher) RPopAuth(ctx context.Context, model string, sessionID string, headers http.Header, count int) ([]byte, error) {
+	return d.RPopAuthWithConstraints(ctx, model, sessionID, headers, count, nil, "")
+}
+
+func (d *basaltAccountedDispatcher) RPopAuthWithConstraints(_ context.Context, model string, _ string, _ http.Header, _ int, excludedAuthIDs []string, _ string) ([]byte, error) {
+	d.mu.Lock()
+	d.calls++
+	call := d.calls
+	d.excluded = append(d.excluded, append([]string(nil), excludedAuthIDs...))
+	d.mu.Unlock()
+	if d.fail != nil {
+		if errFail := d.fail(call); errFail != nil {
+			return nil, errFail
+		}
+	}
+	excluded := make(map[string]struct{}, len(excludedAuthIDs))
+	for _, authID := range excludedAuthIDs {
+		excluded[authID] = struct{}{}
+	}
+	for _, authID := range d.authIDs {
+		if _, skip := excluded[authID]; skip {
+			continue
+		}
+		return json.Marshal(struct {
+			Concurrency homeConcurrencyTuple `json:"concurrency"`
+			Model       string               `json:"model"`
+			AuthIndex   string               `json:"auth_index"`
+			Auth        Auth                 `json:"auth"`
+		}{
+			Concurrency: homeConcurrencyTuple{Accounted: true, CredentialID: authID, Model: model},
+			Model:       model,
+			AuthIndex:   authID,
+			Auth:        Auth{ID: authID, Provider: "home-retry-contract", Status: StatusActive},
+		})
+	}
+	return nil, home.ErrAuthNotFound
+}
+
+func (*basaltAccountedDispatcher) AbortAmbiguousDispatch() {}
+
+func (d *basaltAccountedDispatcher) Calls() int {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	return d.calls
+}
+
+func (d *basaltAccountedDispatcher) Excluded() [][]string {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	result := make([][]string, len(d.excluded))
+	for index := range d.excluded {
+		result[index] = append([]string(nil), d.excluded[index]...)
+	}
+	return result
+}
+
+// basaltReleaseSink acknowledges every release at once except the ones for
+// blockedCredential, which complete only when ack closes (nil: never).
+func basaltReleaseSink(blockedCredential string, ack <-chan struct{}, blocked *atomic.Int32) executionregistry.ReleaseSink {
+	acknowledged := make(chan struct{})
+	close(acknowledged)
+	if ack == nil {
+		// A ticket with a nil done channel counts as acknowledged.
+		ack = make(chan struct{})
+	}
+	return func(group executionregistry.ReleaseGroup, sequence int64) *executionregistry.ReleaseTicket {
+		done := (<-chan struct{})(acknowledged)
+		if group.CredentialID == blockedCredential {
+			blocked.Add(1)
+			done = ack
+		}
+		return executionregistry.NewReleaseTicket(group, sequence, done)
+	}
+}
+
+func newBasaltRedispatchManager(dispatcher homeAuthDispatcher, executor *retryContractHomeExecutor, sink executionregistry.ReleaseSink) (*Manager, *executionregistry.Registry) {
+	registry := executionregistry.New()
+	registry.SetReleaseSink(sink)
+	manager := NewManager(nil, nil, nil)
+	manager.SetConfig(&internalconfig.Config{
+		Home:                  internalconfig.HomeConfig{Enabled: true},
+		CredentialConcurrency: internalconfig.CredentialConcurrencyConfig{CPACancelBound: 10 * time.Millisecond},
+	})
+	// No extra request rounds: everything below must resolve inside one round.
+	manager.SetRetryConfig(0, time.Second, 0)
+	manager.PublishHomeDispatch(dispatcher, registry, 1)
+	manager.RegisterExecutor(executor)
+	return manager, registry
+}
+
+func newBasaltRateLimitedExecutor(streamBootstrap bool) *retryContractHomeExecutor {
+	return &retryContractHomeExecutor{
+		failures:        map[string]error{basaltAccountA: retryContractRateLimitError{retryAfter: basaltRetryTime}},
+		streamBootstrap: streamBootstrap,
+	}
+}
+
+// basaltStreamOutcome drains a stream and returns its payloads and the first
+// error, whether it came back from ExecuteStream or as an in-stream chunk.
+func basaltStreamOutcome(result *cliproxyexecutor.StreamResult, errStream error) ([]string, error) {
+	if errStream != nil {
+		return nil, errStream
+	}
+	if result == nil || result.Chunks == nil {
+		return nil, errors.New("nil stream result")
+	}
+	var payloads []string
+	var firstErr error
+	for chunk := range result.Chunks {
+		if chunk.Err != nil {
+			if firstErr == nil {
+				firstErr = chunk.Err
+			}
+			continue
+		}
+		payloads = append(payloads, string(chunk.Payload))
+	}
+	return payloads, firstErr
+}
+
+func basaltIsHomeUnavailable(err error) bool {
+	var homeErr *Error
+	return errors.As(err, &homeErr) && homeErr != nil && homeErr.Code == "home_unavailable"
+}
+
+func basaltRun(manager *Manager, stream bool) ([]string, error) {
+	if stream {
+		result, errStream := manager.ExecuteStream(context.Background(), []string{"home-retry-contract"}, cliproxyexecutor.Request{Model: "gpt"}, cliproxyexecutor.Options{Stream: true})
+		return basaltStreamOutcome(result, errStream)
+	}
+	response, errExecute := manager.Execute(context.Background(), []string{"home-retry-contract"}, cliproxyexecutor.Request{Model: "gpt"}, cliproxyexecutor.Options{})
+	if errExecute != nil {
+		return nil, errExecute
+	}
+	return []string{string(response.Payload)}, nil
+}
