+// Item 6: account a answers 429 and Home never acknowledges a's release. a is
+// excluded from the redispatch, so the call is served by b instead of 503.
+func TestBasaltHomeRedispatchSkipsAckWaitForExcludedCredential(t *testing.T) {
+	tests := []struct {
+		name            string
+		stream          bool
+		streamBootstrap bool
+	}{
+		{name: "stream start error", stream: true},
+		{name: "stream bootstrap error chunk", stream: true, streamBootstrap: true},
+		{name: "nonstream", stream: false},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			var blocked atomic.Int32
+			dispatcher := &basaltAccountedDispatcher{authIDs: []string{basaltAccountA, basaltAccountB}}
+			executor := newBasaltRateLimitedExecutor(test.streamBootstrap)
+			manager, registry := newBasaltRedispatchManager(dispatcher, executor, basaltReleaseSink(basaltAccountA, nil, &blocked))
+
+			payloads, errRun := basaltRun(manager, test.stream)
+			if errRun != nil {
+				t.Fatalf("call error = %T %v, want b to serve it (home_unavailable=%v)", errRun, errRun, basaltIsHomeUnavailable(errRun))
+			}
+			if !reflect.DeepEqual(payloads, []string{basaltAccountB}) {
+				t.Fatalf("payloads = %q, want only account b", payloads)
+			}
+			if blocked.Load() != 1 {
+				t.Fatalf("unacknowledged releases of a = %d, want 1", blocked.Load())
+			}
+			if calls := executor.Calls(); !reflect.DeepEqual(calls, []string{basaltAccountA, basaltAccountB}) {
+				t.Fatalf("executor calls = %v, want a then b", calls)
+			}
+			if excluded := dispatcher.Excluded(); len(excluded) != 2 || !reflect.DeepEqual(excluded[1], []string{basaltAccountA}) {
+				t.Fatalf("dispatch exclusions = %v, want the redispatch to exclude a", excluded)
+			}
+			if active := registry.FreezeInFlight(time.Time{}).Executions; len(active) != 0 {
+				t.Fatalf("execution scopes leaked: %v", active)
+			}
+		})
+	}
+}
+
+// Item 7: after a's 429, one dispatch fails with home_unavailable. One more
+// dispatch inside the bound serves the call; if that also fails, the caller
+// gets a's 429 with its retry time, and any other lastErr keeps today's 503.
+func TestBasaltHomeRedispatchAfterHomeUnavailable(t *testing.T) {
+	errDispatch := errors.New("home connection reset")
+	for _, stream := range []bool{true, false} {
+		mode := map[bool]string{true: "stream", false: "nonstream"}[stream]
+
+		t.Run(mode+"/second dispatch serves b", func(t *testing.T) {
+			var blocked atomic.Int32
+			dispatcher := &basaltAccountedDispatcher{
+				authIDs: []string{basaltAccountA, basaltAccountB},
+				fail: func(call int) error {
+					if call == 2 {
+						return errDispatch
+					}
+					return nil
+				},
+			}
+			executor := newBasaltRateLimitedExecutor(false)
+			manager, _ := newBasaltRedispatchManager(dispatcher, executor, basaltReleaseSink("", nil, &blocked))
+
+			payloads, errRun := basaltRun(manager, stream)
+			if errRun != nil {
+				t.Fatalf("call error = %T %v, want b to serve it", errRun, errRun)
+			}
+			if !reflect.DeepEqual(payloads, []string{basaltAccountB}) {
+				t.Fatalf("payloads = %q, want only account b", payloads)
+			}
+			if got := dispatcher.Calls(); got != 3 {
+				t.Fatalf("dispatch calls = %d, want a, the failed dispatch, and exactly one more", got)
+			}
+		})
+
+		t.Run(mode+"/second dispatch fails returns a's 429", func(t *testing.T) {
+			var blocked atomic.Int32
+			dispatcher := &basaltAccountedDispatcher{
+				authIDs: []string{basaltAccountA, basaltAccountB},
+				fail: func(call int) error {
+					if call >= 2 {
+						return errDispatch
+					}
+					return nil
+				},
+			}
+			executor := newBasaltRateLimitedExecutor(false)
+			manager, _ := newBasaltRedispatchManager(dispatcher, executor, basaltReleaseSink("", nil, &blocked))
+
+			_, errRun := basaltRun(manager, stream)
+			if errRun == nil {
+				t.Fatal("call error = nil, want a's 429")
+			}
+			if basaltIsHomeUnavailable(errRun) {
+				t.Fatalf("call error = %v, want a's 429 instead of home_unavailable", errRun)
+			}
+			if status := statusCodeFromError(errRun); status != http.StatusTooManyRequests {
+				t.Fatalf("status = %d (%T %v), want 429", status, errRun, errRun)
+			}
+			// The stream path turns a's retry time into a local deadline, so it reports what is left of it.
+			if retryAfter := retryAfterFromError(errRun); retryAfter == nil || *retryAfter > basaltRetryTime || *retryAfter <= basaltRetryTime-time.Second {
+				t.Fatalf("retry after = %v, want what is left of a's %v", retryAfter, basaltRetryTime)
+			}
+			if got := dispatcher.Calls(); got != 3 {
+				t.Fatalf("dispatch calls = %d, want exactly one extra dispatch", got)
+			}
+			if calls := executor.Calls(); !reflect.DeepEqual(calls, []string{basaltAccountA}) {
+				t.Fatalf("executor calls = %v, want only a", calls)
+			}
+		})
+
+		t.Run(mode+"/non-429 last error keeps home_unavailable", func(t *testing.T) {
+			var blocked atomic.Int32
+			dispatcher := &basaltAccountedDispatcher{
+				authIDs: []string{basaltAccountA, basaltAccountB},
+				fail: func(call int) error {
+					if call >= 2 {
+						return errDispatch
+					}
+					return nil
+				},
+			}
+			executor := &retryContractHomeExecutor{failures: map[string]error{
+				basaltAccountA: &Error{HTTPStatus: http.StatusBadGateway, Message: "upstream unavailable"},
+			}}
+			manager, _ := newBasaltRedispatchManager(dispatcher, executor, basaltReleaseSink("", nil, &blocked))
+
+			_, errRun := basaltRun(manager, stream)
+			if !basaltIsHomeUnavailable(errRun) {
+				t.Fatalf("call error = %T %v, want today's home_unavailable", errRun, errRun)
+			}
+			if got := dispatcher.Calls(); got != 3 {
+				t.Fatalf("dispatch calls = %d, want exactly one extra dispatch", got)
+			}
+		})
+	}
+}
