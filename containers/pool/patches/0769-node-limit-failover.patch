+// A plugin refuses account a for this request and Home never acknowledges a's
+// release. a is excluded from the redispatch, so b serves the call.
+func TestBasaltHomeRedispatchSkipsAckWaitForARefusedCredential(t *testing.T) {
+	for _, stream := range []bool{true, false} {
+		t.Run(map[bool]string{true: "stream", false: "nonstream"}[stream], func(t *testing.T) {
+			var blocked atomic.Int32
+			dispatcher := &basaltAccountedDispatcher{authIDs: []string{basaltAccountA, basaltAccountB}}
+			executor := &retryContractHomeExecutor{}
+			manager, _ := newBasaltRedispatchManager(dispatcher, executor, basaltReleaseSink(basaltAccountA, nil, &blocked))
+			opts := cliproxyexecutor.Options{
+				Stream: stream,
+				RequestAfterAuthInterceptor: func(_ context.Context, req cliproxyexecutor.RequestAfterAuthInterceptRequest) cliproxyexecutor.RequestAfterAuthInterceptResponse {
+					if authID, _ := req.Metadata[cliproxyexecutor.SelectedAuthMetadataKey].(string); authID == basaltAccountA {
+						return cliproxyexecutor.RequestAfterAuthInterceptResponse{Terminate: true, TerminateScope: "credential", StatusCode: http.StatusForbidden, ResponseBody: []byte("a refused")}
+					}
+					return cliproxyexecutor.RequestAfterAuthInterceptResponse{}
+				},
+			}
+			var payloads []string
+			var errRun error
+			if stream {
+				result, errStream := manager.ExecuteStream(context.Background(), []string{"home-retry-contract"}, cliproxyexecutor.Request{Model: "gpt"}, opts)
+				payloads, errRun = basaltStreamOutcome(result, errStream)
+			} else {
+				response, errExecute := manager.Execute(context.Background(), []string{"home-retry-contract"}, cliproxyexecutor.Request{Model: "gpt"}, opts)
+				errRun = errExecute
+				if errExecute == nil {
+					payloads = []string{string(response.Payload)}
+				}
+			}
+			if errRun != nil {
+				t.Fatalf("call error = %T %v, want b to serve it (home_unavailable=%v)", errRun, errRun, basaltIsHomeUnavailable(errRun))
+			}
+			if !reflect.DeepEqual(payloads, []string{basaltAccountB}) {
+				t.Fatalf("payloads = %q, want only account b", payloads)
+			}
+			if blocked.Load() != 1 {
+				t.Fatalf("unacknowledged releases of a = %d, want 1", blocked.Load())
+			}
+		})
+	}
+}
