+// Item 8: 25 concurrent requests all land on a, which answers 429 to each;
+// Home acknowledges a's releases only long after CPACancelBound. Every request
+// is served by b and none fails.
+func TestBasaltHomeRedispatchBurstServedByB(t *testing.T) {
+	const requests = 25
+	var blocked atomic.Int32
+	lateAck := make(chan struct{})
+	dispatcher := &basaltAccountedDispatcher{authIDs: []string{basaltAccountA, basaltAccountB}}
+	executor := newBasaltRateLimitedExecutor(false)
+	manager, registry := newBasaltRedispatchManager(dispatcher, executor, basaltReleaseSink(basaltAccountA, lateAck, &blocked))
+
+	var wg sync.WaitGroup
+	failures := make(chan error, requests)
+	for range requests {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			payloads, errRun := basaltRun(manager, true)
+			if errRun != nil {
+				failures <- errRun
+				return
+			}
+			if !reflect.DeepEqual(payloads, []string{basaltAccountB}) {
+				failures <- fmt.Errorf("payloads = %q, want only account b", payloads)
+			}
+		}()
+	}
+	wg.Wait()
+	close(lateAck)
+	close(failures)
+	for errRun := range failures {
+		t.Errorf("request failed: %T %v (home_unavailable=%v)", errRun, errRun, basaltIsHomeUnavailable(errRun))
+	}
+	if got := blocked.Load(); got != requests {
+		t.Fatalf("unacknowledged releases of a = %d, want %d", got, requests)
+	}
+	calls := executor.Calls()
+	counts := map[string]int{}
+	for _, authID := range calls {
+		counts[authID]++
+	}
+	if counts[basaltAccountA] != requests || counts[basaltAccountB] != requests || len(calls) != 2*requests {
+		t.Fatalf("executor calls = %v, want %d on a and %d on b", counts, requests, requests)
+	}
+	if got := dispatcher.Calls(); got != 2*requests {
+		t.Fatalf("dispatch calls = %d, want %d", got, 2*requests)
+	}
+	if active := registry.FreezeInFlight(time.Time{}).Executions; len(active) != 0 {
+		t.Fatalf("execution scopes leaked: %v", active)
+	}
+}
