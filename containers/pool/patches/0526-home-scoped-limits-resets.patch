@@ -0,0 +1,48 @@
+package cluster
+
+// Opt-in discovery metadata. No vendor response, credential or grant identifier is retained.
+type ClaudeQuotaShape struct {
+	LimitsPresent bool               `json:"limits_present"`
+	Limits        []ClaudeLimitShape `json:"limits"`
+	GrantsPresent bool               `json:"grants_present"`
+	Grants        []ClaudeGrantShape `json:"grants"`
+	Truncated     bool               `json:"truncated"`
+}
+type ClaudeLimitShape struct {
+	Kind     string   `json:"kind"`
+	Model    string   `json:"model,omitempty"`
+	Percent  *float64 `json:"percent,omitempty"`
+	ResetsAt string   `json:"resets_at,omitempty"`
+}
+type ClaudeGrantShape struct {
+	Type            string   `json:"type,omitempty"`
+	Remaining       *int     `json:"remaining,omitempty"`
+	Clears          []string `json:"clears"`
+	GivesBackWeekly bool     `json:"gives_back_weekly"`
+	StartsAt        string   `json:"starts_at,omitempty"`
+	EndsAt          string   `json:"ends_at,omitempty"`
+	Paused          bool     `json:"paused"`
+}
+
+func copyClaudeShape(value *ClaudeQuotaShape) *ClaudeQuotaShape {
+	if value == nil {
+		return nil
+	}
+	copy := *value
+	copy.Limits = append([]ClaudeLimitShape{}, value.Limits...)
+	copy.Grants = append([]ClaudeGrantShape{}, value.Grants...)
+	for index := range copy.Limits {
+		if copy.Limits[index].Percent != nil {
+			number := *copy.Limits[index].Percent
+			copy.Limits[index].Percent = &number
+		}
+	}
+	for index := range copy.Grants {
+		copy.Grants[index].Clears = append([]string{}, value.Grants[index].Clears...)
+		if copy.Grants[index].Remaining != nil {
+			number := *copy.Grants[index].Remaining
+			copy.Grants[index].Remaining = &number
+		}
+	}
+	return &copy
+}
