@@ -0,0 +1,99 @@
+package quota
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"regexp"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPIHome/internal/cluster"
+)
+
+var claudeShapeName = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9 ._-]{0,63}$`)
+
+func shapeName(value string) string {
+	if claudeShapeName.MatchString(value) {
+		return value
+	}
+	return "unknown"
+}
+func shapeTime(value string) string {
+	if at := parseProviderTime(value); at != nil {
+		return at.UTC().Format(time.RFC3339Nano)
+	}
+	return ""
+}
+func recordClaudeShape(ctx context.Context, body []byte, grants bool) {
+	if os.Getenv("POOL_CLAUDE_QUOTA_DIAGNOSTIC") != "true" {
+		return
+	}
+	d, _ := ctx.Value(fieldDiagnosticKey{}).(*cluster.QuotaCollectionDiagnostic)
+	if d == nil || d.Provider != "claude" {
+		return
+	}
+	if d.Claude == nil {
+		d.Claude = &cluster.ClaudeQuotaShape{Limits: []cluster.ClaudeLimitShape{}, Grants: []cluster.ClaudeGrantShape{}}
+	}
+	var root map[string]json.RawMessage
+	if json.Unmarshal(body, &root) != nil {
+		return
+	}
+	if !grants {
+		_, d.Claude.LimitsPresent = root["limits"]
+		var limits []claudeLimit
+		if json.Unmarshal(root["limits"], &limits) != nil {
+			return
+		}
+		for index, limit := range limits {
+			if index >= 32 {
+				d.Claude.Truncated = true
+				break
+			}
+			row := cluster.ClaudeLimitShape{Kind: shapeName(limit.Kind), ResetsAt: shapeTime(limit.ResetsAt)}
+			if limit.Scope.Model != nil {
+				row.Model = shapeName(limit.Scope.Model.DisplayName)
+			}
+			if limit.Percent != nil && finiteQuantity(*limit.Percent) && *limit.Percent <= 100 {
+				row.Percent = limit.Percent
+			}
+			d.Claude.Limits = append(d.Claude.Limits, row)
+		}
+		return
+	}
+	var status map[string]json.RawMessage
+	if json.Unmarshal(root["cedar_ember"], &status) != nil {
+		return
+	}
+	_, d.Claude.GrantsPresent = status["grants"]
+	var rows []struct {
+		Type            string   `json:"type"`
+		Remaining       *int     `json:"resets_left"`
+		Clears          []string `json:"clears"`
+		GivesBackWeekly bool     `json:"gives_back_weekly"`
+		StartsAt        string   `json:"starts_at"`
+		EndsAt          string   `json:"ends_at"`
+		Paused          bool     `json:"paused"`
+	}
+	if json.Unmarshal(status["grants"], &rows) != nil {
+		return
+	}
+	for index, grant := range rows {
+		if index >= 32 {
+			d.Claude.Truncated = true
+			break
+		}
+		row := cluster.ClaudeGrantShape{Type: shapeName(grant.Type), Clears: []string{}, GivesBackWeekly: grant.GivesBackWeekly, StartsAt: shapeTime(grant.StartsAt), EndsAt: shapeTime(grant.EndsAt), Paused: grant.Paused}
+		if grant.Remaining != nil && *grant.Remaining >= 0 && *grant.Remaining <= 1_000_000 {
+			row.Remaining = grant.Remaining
+		}
+		for i, window := range grant.Clears {
+			if i >= 16 {
+				d.Claude.Truncated = true
+				break
+			}
+			row.Clears = append(row.Clears, shapeName(window))
+		}
+		d.Claude.Grants = append(d.Claude.Grants, row)
+	}
+}
