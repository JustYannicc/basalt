+func TestClaudeModernScopedLimitsBoundProducerRows(t *testing.T) {
+	at := time.Date(2026, 11, 12, 9, 0, 0, 0, time.UTC)
+	limits := make([]map[string]any, 64)
+	grants := make([]map[string]any, 64)
+	for i := range limits {
+		limits[i] = map[string]any{"kind": "weekly_scoped", "percent": 10, "scope": map[string]any{"model": map[string]any{"display_name": fmt.Sprintf("Model %d", i)}}}
+		grants[i] = map[string]any{"id": fmt.Sprintf("grant-%d", i), "resets_left": 1, "type": "weekly"}
+	}
+	usage, _ := json.Marshal(map[string]any{"limits": limits})
+	windows, err := parseClaudeUsageWindows(usage, at)
+	if err != nil || len(windows) != 64 {
+		t.Fatalf("64 windows lost: %d %v", len(windows), err)
+	}
+	// Legacy windows are part of the same output budget as modern model limits.
+	usage, _ = json.Marshal(map[string]any{"five_hour": map[string]any{"utilization": 10}, "limits": limits})
+	if _, err := parseClaudeUsageWindows(usage, at); err == nil {
+		t.Fatal("65 combined windows accepted")
+	}
+	resetBody := func(rows []map[string]any) []byte {
+		body, _ := json.Marshal(map[string]any{"cedar_ember": map[string]any{"eligible": true, "grants": rows}})
+		return body
+	}
+	credits, err := parseClaudeResetCredits(resetBody(grants), at)
+	if err != nil || len(credits.Credits) != 64 || *credits.AvailableCount != 64 {
+		t.Fatalf("64 balances lost: %+v %v", credits, err)
+	}
+	grants = append(grants, map[string]any{"id": "extra", "resets_left": 1})
+	if _, err := parseClaudeResetCredits(resetBody(grants), at); err == nil {
+		t.Fatal("65 balances accepted")
+	}
+}
