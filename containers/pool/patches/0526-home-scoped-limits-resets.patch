diff --git a/internal/cluster/basalt_reset_metadata.go b/internal/cluster/basalt_reset_metadata.go
new file mode 100644
index 0000000..b0dc041
--- /dev/null
+++ b/internal/cluster/basalt_reset_metadata.go
@@ -0,0 +1,39 @@
+package cluster
+
+import (
+	"fmt"
+	"strings"
+)
+
+func normalizeResetMetadata(credit *QuotaResetCredit) (int, error) {
+	remaining := 1 // Older stored Codex entries represent one credit each.
+	if credit.Remaining != nil {
+		remaining = *credit.Remaining
+		if remaining < 1 || remaining > 1_000_000 {
+			return 0, fmt.Errorf("invalid reset remaining count")
+		}
+	}
+	if credit.Kind != "" && !quotaAllowed(credit.Kind, "session", "weekly", "full", "model", "unknown") {
+		return 0, fmt.Errorf("invalid reset kind")
+	}
+	if credit.Scope != "" && !quotaAllowed(credit.Scope, "account", "model", "unknown") {
+		return 0, fmt.Errorf("invalid reset scope")
+	}
+	if credit.Scope == "model" && (credit.ScopeID == nil || strings.TrimSpace(*credit.ScopeID) == "" || len(*credit.ScopeID) > 64) {
+		return 0, fmt.Errorf("model reset scope is missing")
+	}
+	if len(credit.Clears) > 16 {
+		return 0, fmt.Errorf("too many reset windows")
+	}
+	for _, id := range credit.Clears {
+		if id == "" || len(id) > 64 {
+			return 0, fmt.Errorf("invalid reset window")
+		}
+		for _, char := range id {
+			if !(char >= 'a' && char <= 'z' || char >= '0' && char <= '9' || char == '_' || char == '-') {
+				return 0, fmt.Errorf("invalid reset window")
+			}
+		}
+	}
+	return remaining, nil
+}
