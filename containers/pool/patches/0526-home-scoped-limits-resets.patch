diff --git a/internal/quota/basalt_claude_limits.go b/internal/quota/basalt_claude_limits.go
new file mode 100644
index 0000000..b179cff
--- /dev/null
+++ b/internal/quota/basalt_claude_limits.go
@@ -0,0 +1,155 @@
+package quota
+
+import (
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPIHome/internal/cluster"
+)
+
+// Claude Code 2.1.322 reads model families from limits, rather than the retired
+// seven_day_<model> fields. is_active describes severity, not whether a cap exists.
+type claudeLimit struct {
+	Kind     string   `json:"kind"`
+	Percent  *float64 `json:"percent"`
+	ResetsAt string   `json:"resets_at"`
+	Scope    struct {
+		Model *struct {
+			DisplayName string `json:"display_name"`
+		} `json:"model"`
+	} `json:"scope"`
+}
+
+func appendClaudeLimits(windows []cluster.QuotaWindow, limits []claudeLimit, observedAt time.Time) ([]cluster.QuotaWindow, error) {
+	if len(limits) > 64 {
+		return nil, fmt.Errorf("too many Claude limits")
+	}
+	seen := make(map[string]bool)
+	for _, limit := range limits {
+		id, label, scope, scopeID, unit, amount := "", (*string)(nil), "account", (*string)(nil), "week", float64(1)
+		switch limit.Kind {
+		case "session":
+			id, unit, amount = "claude-five-hour", "hour", 5
+		case "weekly_all":
+			id = "claude-seven-day"
+		case "weekly_scoped":
+			if limit.Scope.Model == nil {
+				continue
+			}
+			name := strings.TrimSpace(limit.Scope.Model.DisplayName)
+			key := quotaIDSlug(name)
+			if key == "" || len(key) > 64 || len(name) > 64 {
+				continue
+			}
+			id, label, scope, scopeID = "claude-seven-day-"+key, quotaStringPtr(name+" weekly"), "model", quotaStringPtr(key)
+		default:
+			continue
+		}
+		if seen[id] {
+			return nil, fmt.Errorf("duplicate Claude limit")
+		}
+		seen[id] = true
+		current := appendClaudeWindow(nil, id, label, scope, scopeID, &claudeUsageWindow{Utilization: limit.Percent, ResetsAt: limit.ResetsAt}, unit, amount, len(windows), observedAt)
+		if limit.Percent == nil {
+			current = []cluster.QuotaWindow{{ID: id, Label: label, Scope: scope, ScopeID: scopeID, Unit: "percentage", Mode: "rolling", Status: "unknown", WindowSeconds: periodSeconds(unit, amount), PeriodUnit: unit, PeriodValue: quotaFloatPtr(amount), ResetAt: parseProviderTime(limit.ResetsAt), ObservedAt: observedAt, Source: "active_probe", Priority: len(windows)}}
+		} else if !finiteQuantity(*limit.Percent) {
+			return nil, fmt.Errorf("invalid Claude limit amount")
+		}
+		// A present but unreadable modern limit must not resurrect an older alias.
+		kept := windows[:0]
+		for _, window := range windows {
+			if window.ID != id {
+				kept = append(kept, window)
+			}
+		}
+		windows = append(kept, current...)
+	}
+	if len(windows) > 64 {
+		return nil, fmt.Errorf("too many Claude quota windows")
+	}
+	return windows, nil
+}
+
+func claudeResetScope(kind string, givesBackWeekly bool, clears []string) (string, string, *string) {
+	if givesBackWeekly {
+		return "model", "model", quotaStringPtr("fable")
+	}
+	if kind != "" && kind != "session" && kind != "weekly" && kind != "full" {
+		return "unknown", "unknown", nil
+	}
+	if len(clears) == 0 {
+		if kind != "" {
+			return kind, "account", nil
+		}
+		return "unknown", "unknown", nil
+	}
+	session, weekly := false, false
+	var model *string
+	for _, window := range clears {
+		switch window {
+		case "five_hour":
+			session = true
+		case "seven_day", "seven_day_overage_included":
+			weekly = true
+		default:
+			if strings.HasPrefix(window, "seven_day_") {
+				key := quotaIDSlug(strings.TrimPrefix(window, "seven_day_"))
+				if key == "" || model != nil && *model != key {
+					return "unknown", "unknown", nil
+				}
+				model = &key
+			} else {
+				return "unknown", "unknown", nil
+			}
+		}
+	}
+	if model != nil {
+		if weekly {
+			return "unknown", "unknown", nil
+		}
+		return "model", "model", model
+	}
+	if kind != "" {
+		return kind, "account", nil
+	}
+	if session && weekly {
+		return "full", "account", nil
+	}
+	if weekly {
+		return "weekly", "account", nil
+	}
+	if session {
+		return "session", "account", nil
+	}
+	return "unknown", "unknown", nil
+}
+
+// Expose effects using the same window IDs as quota reads, so every UI can
+// describe ancillary refills without another provider-specific mapping.
+func claudeResetWindows(clears []string, givesBackWeekly bool) []string {
+	result := make([]string, 0, len(clears))
+	for _, key := range clears {
+		var id string
+		switch key {
+		case "five_hour":
+			id = "claude-five-hour"
+		case "seven_day":
+			id = "claude-seven-day"
+		case "seven_day_overage_included":
+			if givesBackWeekly {
+				id = "claude-seven-day-fable"
+			} else {
+				id = "claude-seven-day"
+			}
+		default:
+			if strings.HasPrefix(key, "seven_day_") {
+				id = "claude-seven-day-" + quotaIDSlug(strings.TrimPrefix(key, "seven_day_"))
+			}
+		}
+		if id != "" {
+			result = append(result, id)
+		}
+	}
+	return result
+}
diff --git a/internal/quota/basalt_claude_limits_test.go b/internal/quota/basalt_claude_limits_test.go
new file mode 100644
index 0000000..0df9c51
--- /dev/null
+++ b/internal/quota/basalt_claude_limits_test.go
@@ -0,0 +1,146 @@
+package quota
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPIHome/internal/cluster"
+)
+
+// Schema fixture from official Claude Code 2.1.322. Account values are synthetic;
+// production discovery must confirm the current vendor shape independently.
+func TestClaudeModernScopedLimits(t *testing.T) {
+	at := time.Date(2026, 11, 12, 9, 0, 0, 0, time.UTC)
+	body := `{"seven_day":{"utilization":20},"seven_day_opus":{"utilization":90},"limits":[{"kind":"weekly_all","percent":25,"resets_at":"2026-11-14T12:00:00Z"},{"kind":"weekly_scoped","percent":100,"is_active":false,"resets_at":"2026-11-14T12:00:00Z","scope":{"model":{"display_name":"Fable"}}},{"kind":"weekly_scoped","percent":30,"scope":{"model":{"display_name":"Opus"}}},{"kind":"weekly_scoped","percent":0,"scope":{"model":{"display_name":"New Model"}}},{"kind":"weekly_scoped","percent":10,"scope":{"surface":{"display_name":"Research"}}} ]}`
+	windows, err := parseClaudeUsageWindows([]byte(body), at)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(windows) != 4 {
+		t.Fatalf("windows=%+v", windows)
+	}
+	byID := make(map[string]cluster.QuotaWindow)
+	for _, window := range windows {
+		byID[window.ID] = window
+	}
+	for _, item := range []struct {
+		id, scope, model string
+		remaining        float64
+	}{
+		{"claude-seven-day", "account", "", .75},
+		{"claude-seven-day-fable", "model", "fable", 0},
+		{"claude-seven-day-opus", "model", "opus", .7},
+		{"claude-seven-day-new-model", "model", "new-model", 1},
+	} {
+		window := byID[item.id]
+		if window.Scope != item.scope || window.WindowSeconds == nil || *window.WindowSeconds != 604800 || window.RemainingRatio == nil || *window.RemainingRatio != item.remaining {
+			t.Fatalf("wrong window: %+v", window)
+		}
+		if item.model != "" && (window.ScopeID == nil || *window.ScopeID != item.model) {
+			t.Fatal("model scope lost")
+		}
+	}
+	if byID["claude-seven-day-fable"].ResetAt == nil {
+		t.Fatal("model reset deadline lost")
+	}
+	if _, err := parseClaudeUsageWindows([]byte(`{"limits":[{"kind":"weekly_scoped","percent":1,"scope":{"model":{"display_name":"Fable"}}},{"kind":"weekly_scoped","percent":2,"scope":{"model":{"display_name":"Fable"}}}]}`), at); err == nil {
+		t.Fatal("duplicate model limits accepted")
+	}
+}
+
+func TestClaudeScopedResetGrants(t *testing.T) {
+	at := time.Date(2026, 11, 12, 9, 0, 0, 0, time.UTC)
