+func TestClaudeScopedResetSnapshotHTTP(t *testing.T) {
+	handler, closeRepo := newUsageObservabilityTestHandler(t)
+	defer closeRepo()
+	now := time.Now().UTC().Truncate(time.Second)
+	expiry := now.Add(time.Hour)
+	reset := now.Add(24 * time.Hour)
+	auth := &coreauth.Auth{ID: "scoped-account", Index: "scoped-account", Provider: "claude", Status: coreauth.StatusActive, Metadata: map[string]any{"type": "claude", "access_token": "secret-scoped-sentinel"}, CreatedAt: now, UpdatedAt: now}
+	if _, err := handler.repo.UpsertAuth(context.Background(), auth, "test"); err != nil {
+		t.Fatal(err)
+	}
+	all, fableCount, weeklyCount := 4, 3, 1
+	family := "fable"
+	ratio := .25
+	seconds := int64(604800)
+	_, err := handler.repo.UpsertQuotaSnapshot(context.Background(), cluster.QuotaSnapshotWrite{
+		CredentialID: auth.ID, QuotaStatus: "healthy", CollectionStatus: "success", Source: "active_probe", ObservedAt: &now, ExpiresAt: &expiry, LastAttemptAt: &now, LastSuccessAt: &now, ReplaceWindows: true, ReplaceResetCredits: true,
+		Windows: []cluster.QuotaWindow{{ID: "claude-seven-day-fable", Scope: "model", ScopeID: &family, Mode: "rolling", Status: "healthy", Unit: "percentage", RemainingRatio: &ratio, WindowSeconds: &seconds, ObservedAt: now, ResetAt: &reset}},
+		ResetCredits: &cluster.QuotaResetCredits{AvailableCount: &all, ObservedAt: now, Credits: []cluster.QuotaResetCredit{
+			{ID: "fable-secret-id", Status: "available", GrantedAt: now, ExpiresAt: &reset, Kind: "model", Scope: "model", ScopeID: &family, Remaining: &fableCount, Clears: []string{"seven_day_overage_included"}, GivesBackWeekly: true},
+			{ID: "weekly-secret-id", Status: "available", GrantedAt: now, ExpiresAt: &expiry, Kind: "weekly", Scope: "account", Remaining: &weeklyCount, Clears: []string{"seven_day"}},
+		}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	gin.SetMode(gin.TestMode)
+	engine := gin.New()
+	engine.GET("/quota/credentials/:credential_id", handler.GetQuotaCredential)
+	response := httptest.NewRecorder()
+	engine.ServeHTTP(response, httptest.NewRequest(http.MethodGet, "/quota/credentials/"+auth.ID, nil))
+	if response.Code != 200 {
+		t.Fatalf("HTTP status %d", response.Code)
+	}
+	var result struct {
+		Resets struct {
+			Available int `json:"available_count"`
+			Credits   []struct {
+				Remaining int       `json:"remaining"`
+				Kind      string    `json:"kind"`
+				Scope     string    `json:"scope"`
+				ScopeID   string    `json:"scope_id"`
+				Gives     bool      `json:"gives_back_weekly"`
+				ExpiresAt time.Time `json:"expires_at"`
+			} `json:"credits"`
+		} `json:"reset_credits"`
+		Windows []struct {
+			Scope   string `json:"scope"`
+			ScopeID string `json:"scope_id"`
+		} `json:"windows"`
+	}
+	if err := json.Unmarshal(response.Body.Bytes(), &result); err != nil {
+		t.Fatal(err)
+	}
+	if result.Resets.Available != 4 || len(result.Resets.Credits) != 2 || len(result.Windows) != 1 || result.Windows[0].Scope != "model" || result.Windows[0].ScopeID != "fable" {
+		t.Fatalf("normalized metadata lost: %+v", result)
+	}
+	var fable, weekly bool
+	for _, credit := range result.Resets.Credits {
+		if credit.Kind == "model" {
+			fable = credit.Scope == "model" && credit.ScopeID == "fable" && credit.Remaining == 3 && credit.Gives && credit.ExpiresAt.Equal(reset)
+		}
+		if credit.Kind == "weekly" {
+			weekly = credit.Scope == "account" && credit.Remaining == 1 && credit.ExpiresAt.Equal(expiry)
+		}
+	}
+	if !fable || !weekly {
+		t.Fatalf("reset kinds/counts/expiry lost: %+v", result.Resets)
+	}
+	for _, secret := range []string{"secret-scoped-sentinel", "fable-secret-id", "weekly-secret-id"} {
+		if strings.Contains(response.Body.String(), secret) {
+			t.Fatal("private identifier escaped")
+		}
+	}
+}
