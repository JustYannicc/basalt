+	if fable.Kind != "model" || fable.Scope != "model" || fable.ScopeID == nil || *fable.ScopeID != "fable" || !fable.GivesBackWeekly || *fable.Remaining != 3 || fable.ExpiresAt == nil || fable.ExpiresAt.Format(time.RFC3339) != "2027-03-09T07:59:00Z" {
+		t.Fatalf("wrong model reset: %+v", fable)
+	}
+	if len(fable.Clears) != 1 || fable.Clears[0] != "claude-seven-day-fable" {
+		t.Fatal("reset effects do not reference quota windows")
+	}
+	if weekly.Kind != "weekly" || weekly.Scope != "account" || weekly.ScopeID != nil || *weekly.Remaining != 1 || weekly.ExpiresAt == nil || weekly.ExpiresAt.Format(time.RFC3339) != "2026-12-10T22:00:00Z" {
+		t.Fatalf("wrong weekly reset: %+v", weekly)
+	}
+	for _, item := range []struct {
+		kind               string
+		gives              bool
+		clears             []string
+		want, scope, model string
+	}{
+		{"", false, nil, "unknown", "unknown", ""},
+		{"session", false, []string{"five_hour"}, "session", "account", ""},
+		{"", false, []string{"seven_day"}, "weekly", "account", ""},
+		{"", false, []string{"five_hour", "seven_day"}, "full", "account", ""},
+		{"weekly", false, []string{"seven_day_new_model"}, "model", "model", "new-model"},
+	} {
