+func TestClaudeShapeDiagnosticIsOptInAndClosed(t *testing.T) {
+	at := time.Date(2026, 11, 12, 9, 0, 0, 0, time.UTC)
+	body := []byte(`{"token":"secret-sentinel","email":"private@example.invalid","limits":[{"kind":"weekly_scoped","percent":88,"scope":{"model":{"display_name":"Fable"}},"resets_at":"2026-12-01T00:00:00Z"}],"cedar_ember":{"grants":[{"id":"grant-secret-sentinel","type":"weekly","resets_left":3,"clears":["seven_day_overage_included"],"gives_back_weekly":true,"ends_at":"2027-03-09T07:59:00Z"}]}}`)
