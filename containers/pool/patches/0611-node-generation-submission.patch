new file mode 100644
index 0000000000..7431c46e57
--- /dev/null
+++ b/internal/pluginhost/submission_boundary_test.go
@@ -0,0 +1,147 @@
+package pluginhost
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
