+package quota
+
+import (
+	"testing"
+	"time"
+)
+
+func TestUsageCreditsCodex(t *testing.T) {
+	for _, test := range []struct {
+		body, state, balance string
+		blocked              bool
+	}{
+		{`{}`, "unknown", "", false},
+		{`{"credits":{"has_credits":true,"balance":"12.50","unlimited":false}}`, "available", "12.50", false},
+		{`{"credits":{"has_credits":true,"unlimited":true}}`, "unlimited", "", false},
+		{`{"credits":{"has_credits":false}}`, "none", "", true},
+		{`{"credits":{"balance":0}}`, "none", "0", true},
+		{`{"credits":{"balance":"-3"}}`, "unknown", "", false},
+		{`{"credits":{"balance":"NaN"}}`, "unknown", "", false},
+		{`{"credits":{"balance":null}}`, "unknown", "", false},
+		{`{"credits":{"has_credits":true}}`, "unknown", "", false},
+		{`{"credits":{"has_credits":false,"balance":"9"}}`, "unknown", "", true},
+	} {
+		value := parseCodexUsageCredits([]byte(test.body), time.Unix(100, 0))
+		balance := ""
+		if value.Balance != nil {
+			balance = *value.Balance
+		}
+		if value.State != test.state || balance != test.balance || value.CreditBlocked != test.blocked {
+			t.Fatalf("body %s produced state=%s balance=%s blocked=%v", test.body, value.State, balance, value.CreditBlocked)
+		}
+	}
+	value := parseCodexUsageCredits([]byte(`{"rate_limit":{"allowed":false,"limit_reached":true}}`), time.Unix(100, 0))
+	if value.Allowed == nil || *value.Allowed || value.LimitReached == nil || !*value.LimitReached {
+		t.Fatal("rate-limit flags lost")
+	}
+}
+func TestUsageCreditsClaude(t *testing.T) {
+	for _, test := range []struct {
+		body, state, cap string
+		blocked          bool
+	}{
+		{`{"extra_usage":{"is_enabled":true,"monthly_limit":null,"used_credits":42}}`, "unknown", "unlimited", false},
+		{`{"extra_usage":{"is_enabled":true}}`, "unknown", "unknown", false},
+		{`{"extra_usage":{"is_enabled":false,"monthly_limit":100,"used_credits":42}}`, "disabled", "limited", true},
+		{`{"extra_usage":{"is_enabled":true,"monthly_limit":100,"utilization":100}}`, "none", "limited", true},
+		{`{"extra_usage":{"is_enabled":true,"monthly_limit":100,"used_credits":100}}`, "none", "limited", true},
+		{`{"extra_usage":{"is_enabled":true,"monthly_limit":"100.01","used_credits":"100.010"}}`, "none", "limited", true},
+		{`{"extra_usage":{"is_enabled":true,"monthly_limit":100,"used_credits":99}}`, "unknown", "limited", false},
+		{`{"extra_usage":{"is_enabled":false,"monthly_limit":0,"utilization":100,"used_credits":100}}`, "disabled", "limited", true},
+	} {
+		value := parseClaudeUsageCredits([]byte(test.body), time.Unix(100, 0))
+		if value.State != test.state || value.ExtraUsage.MonthlyCap != test.cap || value.CreditBlocked != test.blocked || value.Balance != nil {
+			t.Fatalf("wrong extra-usage projection for %s: %+v", test.body, value)
+		}
+	}
+}
