@@ -0,0 +1,83 @@
+package cluster
+
+import (
+	"context"
+	"os"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"gorm.io/driver/postgres"
+	"gorm.io/gorm"
+)
+
+func TestUsageCreditPostgresV13ToV14PreservesRows(t *testing.T) {
+	dsn := strings.TrimSpace(os.Getenv("CLIPROXY_HOME_TEST_POSTGRES_DSN"))
+	if dsn == "" {
+		t.Skip("CLIPROXY_HOME_TEST_POSTGRES_DSN is not configured")
+	}
+	admin, errOpen := gorm.Open(postgres.Open(dsn), databaseGORMConfig(defaultDatabaseSlowQueryThreshold))
+	if errOpen != nil {
+		t.Fatal("open isolated postgres", errOpen)
+	}
+	adminSQL, errSQL := admin.DB()
+	if errSQL != nil {
+		t.Fatal(errSQL)
+	}
+	t.Cleanup(func() { _ = adminSQL.Close() })
+	schema := "usage_credits_" + strconv.FormatInt(time.Now().UnixNano(), 10)
+	if errCreate := admin.Exec("CREATE SCHEMA " + schema).Error; errCreate != nil {
+		t.Fatal(errCreate)
+	}
+	t.Cleanup(func() {
+		if errDrop := admin.Exec("DROP SCHEMA " + schema + " CASCADE").Error; errDrop != nil {
+			t.Error(errDrop)
+		}
+	})
+	db, errSchema := gorm.Open(postgres.Open(postgresDSNWithSearchPath(dsn, schema)), databaseGORMConfig(defaultDatabaseSlowQueryThreshold))
+	if errSchema != nil {
+		t.Fatal(errSchema)
+	}
+	sqlDB, errDB := db.DB()
+	if errDB != nil {
+		t.Fatal(errDB)
+	}
+	t.Cleanup(func() { _ = sqlDB.Close() })
+	if errMigrate := AutoMigrateContext(context.Background(), db); errMigrate != nil {
+		t.Fatal(errMigrate)
+	}
+	// Construct the previous schema, then add existing rows before the upgrade.
+	for _, statement := range []string{
+		"ALTER TABLE quota_snapshot DROP COLUMN usage_credits",
+		"ALTER TABLE channel_group DROP COLUMN usage_credit_policy",
+		"UPDATE home_schema_migration SET version = 13",
+		"INSERT INTO channel_group (id,channel_name,disabled) VALUES (47,'synthetic-pool',false)",
+		"INSERT INTO quota_snapshot (credential_id,quota_status,collection_status,source,plan_name,reset_credits) VALUES ('retained-account','healthy','success','active_probe','Plus','{\"available_count\":3}')",
+	} {
+		if errStatement := db.Exec(statement).Error; errStatement != nil {
+			t.Fatal(errStatement)
+		}
+	}
+	if errMigrate := AutoMigrateContext(context.Background(), db); errMigrate != nil {
+		t.Fatal(errMigrate)
+	}
+	assertPostgresSchemaMigrationVersion(t, db, 14)
+	var group ChannelGroupRecord
+	if errRead := db.First(&group, 47).Error; errRead != nil {
+		t.Fatal(errRead)
+	}
+	if group.ChannelName != "synthetic-pool" || group.Disabled || group.UsageCreditPolicy != "last_resort" {
+		t.Fatalf("existing group changed: %+v", group)
+	}
+	var snapshot QuotaSnapshotRecord
+	if errRead := db.Where("credential_id = ?", "retained-account").First(&snapshot).Error; errRead != nil {
+		t.Fatal(errRead)
+	}
+	if snapshot.PlanName != "Plus" || snapshot.QuotaStatus != "healthy" || !strings.Contains(string(snapshot.ResetCredits), "3") || len(snapshot.UsageCredits) != 0 {
+		t.Fatal("existing quota observation changed")
+	}
+	if errMigrate := AutoMigrateContext(context.Background(), db); errMigrate != nil {
+		t.Fatal("idempotent migration", errMigrate)
+	}
+}
