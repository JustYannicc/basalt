+package home
+
+import (
+	"context"
+	"testing"
+
+	coreauth "github.com/router-for-me/CLIProxyAPIHome/internal/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPIHome/internal/registry"
+)
+
+type creditTierStore struct {
+	ClusterAdapter
+	tiers map[string]int
+}
+
+func (s *creditTierStore) UsageCreditTiersForAPIKey(context.Context, string, string, map[string]string) (map[string]int, error) {
+	return s.tiers, nil
+}
+
+type creditStickySelector struct{}
+
+func (*creditStickySelector) Pick(_ context.Context, _ string, _ string, _ coreauth.Options, auths []*coreauth.Auth) (*coreauth.Auth, error) {
+	for _, auth := range auths {
+		if auth.ID == "paid" {
+			return auth, nil
+		}
+	}
+	if len(auths) == 0 {
+		return nil, nil
+	}
+	return auths[0], nil
+}
+func TestUsageCreditPlanPreemptsAffinityAndNeverRefuses(t *testing.T) {
+	ctx := context.Background()
+	manager := coreauth.NewManager(nil, &creditStickySelector{}, nil)
+	for _, id := range []string{"plan", "paid", "unknown"} {
+		auth := &coreauth.Auth{ID: id, Provider: "codex", Status: coreauth.StatusActive, Attributes: map[string]string{"auth_kind": "oauth"}}
+		registry.GetGlobalRegistry().RegisterClient(id, "codex", []*registry.ModelInfo{{ID: "gpt"}})
+		t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(id) })
+		if _, errRegister := manager.Register(ctx, auth); errRegister != nil {
+			t.Fatal(errRegister)
+		}
+	}
+	store := &creditTierStore{tiers: map[string]int{"plan": 0, "paid": 1, "unknown": 2}}
+	runtime := &Runtime{coreManager: manager, clusterAdapter: store}
+	result, errDispatch := runtime.DispatchForAPIKeyWithConcurrency(ctx, "gpt", nil, "pool-key", "", nil, "", DispatchConcurrencyContext{})
+	if errDispatch != nil || result.AuthID != "plan" {
+		t.Fatal("plan failed to preempt sticky credits", errDispatch)
+	}
+	if _, errDispatch := runtime.DispatchForAPIKeyWithConcurrency(ctx, "gpt", nil, "pool-key", "", nil, "paid", DispatchConcurrencyContext{}); errDispatch == nil {
+		t.Fatal("hard pinned credits bypassed recovered plan")
+	}
+	store.tiers["plan"] = 3
+	result, errDispatch = runtime.DispatchForAPIKeyWithConcurrency(ctx, "gpt", nil, "pool-key", "", nil, "", DispatchConcurrencyContext{})
+	if errDispatch != nil || result.AuthID != "paid" {
+		t.Fatal("confirmed credits must precede unknown", errDispatch)
+	}
+	store.tiers = map[string]int{"plan": 3, "paid": 3, "unknown": 3}
+	if _, errDispatch := runtime.DispatchForAPIKeyWithConcurrency(ctx, "gpt", nil, "never-key", "", nil, "", DispatchConcurrencyContext{}); errDispatch == nil {
+		t.Fatal("never dispatched a paid or unknown account")
+	}
+}
+func TestUsageCreditRetainedCheckDoesNotAdmitAgain(t *testing.T) {
+	manager := coreauth.NewManager(nil, &creditStickySelector{}, nil)
+	auth := &coreauth.Auth{ID: "paid", Provider: "codex", Status: coreauth.StatusActive, Attributes: map[string]string{"auth_kind": "oauth"}}
+	registry.GetGlobalRegistry().RegisterClient(auth.ID, "codex", []*registry.ModelInfo{{ID: "gpt"}})
+	t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(auth.ID) })
+	if _, errRegister := manager.Register(context.Background(), auth); errRegister != nil {
+		t.Fatal(errRegister)
+	}
+	store := &creditTierStore{tiers: map[string]int{"paid": 1}}
+	runtime := &Runtime{coreManager: manager, clusterAdapter: store}
+	runtime.SetConcurrencyAdmitter(ConcurrencyAdmitterFunc(func(context.Context, ConcurrencyAdmissionRequest) (ConcurrencyAdmissionResult, error) {
+		t.Fatal("validation acquired another admission")
+		return ConcurrencyAdmissionResult{}, nil
+	}))
+	result, errCheck := runtime.DispatchForAPIKeyWithConcurrency(context.Background(), "gpt", nil, "key", "", nil, "paid", DispatchConcurrencyContext{FundingCheck: true})
+	if errCheck != nil || result.AuthID != "paid" || result.Concurrency.Accounted {
+		t.Fatal("funding check failed", errCheck)
+	}
+}
+
+type creditRefreshCollector struct {
+	calls int
+	ids   map[string]struct{}
+}
+
+func (c *creditRefreshCollector) TriggerCollection(_ context.Context, ids, _ map[string]struct{}) (int, error) {
+	c.calls++
+	c.ids = ids
+	return len(ids), nil
+}
+func TestUsageCreditRefusalQueuesOneBoundedRefresh(t *testing.T) {
+	runtime := &Runtime{clusterAdapter: &creditTierStore{tiers: map[string]int{"unknown": 3}}}
+	collector := &creditRefreshCollector{}
+	runtime.SetUsageCreditCollector(collector)
+	var opts coreauth.Options
+	if !runtime.installUsageCreditFilter(t.Context(), "pool-key", "gpt", "", &opts) {
+		t.Fatal("filter unavailable")
+	}
+	for range 2 {
+		selected, errFilter := opts.CandidateFilter([]*coreauth.Auth{{ID: "unknown"}}, map[string]string{"unknown": "gpt"})
+		if errFilter != nil || len(selected) != 0 {
+			t.Fatal("refusal changed", errFilter)
+		}
+	}
+	if collector.calls != 1 {
+		t.Fatalf("collector calls %d, want one coalesced refresh", collector.calls)
+	}
+	if _, ok := collector.ids["unknown"]; !ok {
+		t.Fatal("refused account was not queued")
+	}
+}
