diff --git a/internal/home/usage_credits.go b/internal/home/usage_credits.go
new file mode 100644
index 0000000..b90c342
--- /dev/null
+++ b/internal/home/usage_credits.go
@@ -0,0 +1,105 @@
+package home
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"time"
+
+	coreauth "github.com/router-for-me/CLIProxyAPIHome/internal/cliproxy/auth"
+)
+
+type usageCreditStore interface {
+	UsageCreditTiersForAPIKey(context.Context, string, string, map[string]string) (map[string]int, error)
+}
+
+type usageCreditCollector interface {
+	TriggerCollection(context.Context, map[string]struct{}, map[string]struct{}) (int, error)
+}
+
+// SetUsageCreditCollector connects funding refusals to the existing bounded collector.
+func (r *Runtime) SetUsageCreditCollector(collector usageCreditCollector) {
+	r.cfgMu.Lock()
+	defer r.cfgMu.Unlock()
+	r.usageCreditCollector = collector
+}
+
+func (r *Runtime) requestUsageCreditRefresh(ctx context.Context, ids []string) error {
+	r.cfgMu.RLock()
+	collector := r.usageCreditCollector
+	r.cfgMu.RUnlock()
+	if collector == nil {
+		return errors.New("quota collector is unavailable")
+	}
+	now := time.Now()
+	selected := make(map[string]struct{})
+	r.usageCreditRefreshMu.Lock()
+	if r.usageCreditRefreshAt == nil {
+		r.usageCreditRefreshAt = make(map[string]time.Time)
+	}
+	for id, at := range r.usageCreditRefreshAt {
+		if now.Sub(at) >= 30*time.Second {
+			delete(r.usageCreditRefreshAt, id)
+		}
+	}
+	for _, id := range ids {
+		if len(selected) >= 500 {
+			break
+		}
+		if _, queued := r.usageCreditRefreshAt[id]; !queued {
+			selected[id] = struct{}{}
+			r.usageCreditRefreshAt[id] = now
+		}
+	}
+	r.usageCreditRefreshMu.Unlock()
+	if len(selected) > 0 {
+		_, errTrigger := collector.TriggerCollection(ctx, selected, nil)
+		return errTrigger
+	}
+	return nil
+}
+
+func (r *Runtime) installUsageCreditFilter(ctx context.Context, apiKey, model, pinned string, opts *coreauth.Options) bool {
+	store, ok := r.clusterAdapter.(usageCreditStore)
+	if !ok || strings.TrimSpace(apiKey) == "" {
+		return false
+	}
+	opts.CandidateFilter = func(candidates []*coreauth.Auth, models map[string]string) ([]*coreauth.Auth, error) {
+		ids := make([]string, 0, len(candidates))
+		for _, auth := range candidates {
+			ids = append(ids, auth.ID)
+		}
+		tiers, errTiers := store.UsageCreditTiersForAPIKey(ctx, apiKey, model, models)
+		if errTiers != nil {
+			return nil, &coreauth.Error{Code: "usage_credit_policy_unavailable", Message: "Pool funding policy could not be read.", HTTPStatus: 503, Retryable: true}
+		}
+		best := 3
+		for _, id := range ids {
+			tier, exists := tiers[id]
+			if exists && tier < best {
+				best = tier
+			}
+		}
+		if best >= 3 {
+			if errRefresh := r.requestUsageCreditRefresh(ctx, ids); errRefresh != nil {
+				return nil, &coreauth.Error{Code: "usage_credit_policy_unavailable", Message: "A fresh pool funding reading could not be queued.", HTTPStatus: 503, Retryable: true}
+			}
+		}
+		eligible := make([]*coreauth.Auth, 0, len(candidates))
+		for _, auth := range candidates {
+			if tier, exists := tiers[auth.ID]; exists && tier == best && tier < 3 {
+				eligible = append(eligible, auth)
+			}
+		}
+		if pinned == "" {
+			return eligible, nil
+		}
+		for _, auth := range eligible {
+			if auth.ID == pinned {
+				return []*coreauth.Auth{auth}, nil
+			}
+		}
+		return nil, &coreauth.Error{Code: "continuity_requires_reconnect", Message: "This session must reconnect before another turn. Its account no longer satisfies the pool funding policy.", HTTPStatus: 409, Retryable: true}
+	}
+	return true
+}
