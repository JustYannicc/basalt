+package dynamic
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPIHome/internal/cluster"
+	"github.com/router-for-me/CLIProxyAPIHome/internal/respserver/dispatch"
+)
+
+func TestUsageCreditOldHomeRegistryRejectsBeforeDispatch(t *testing.T) {
+	registry := dispatch.NewRegistry()
+	dispatched := 0
+	legacyDispatch := func(context.Context, dispatch.Env, []string) dispatch.Reply {
+		dispatched++
+		return dispatch.BulkString([]byte(`{"auth_id":"paid"}`))
+	}
+	if errRegister := registry.RegisterDynamic("RPOP", "auth", legacyDispatch); errRegister != nil {
+		t.Fatal(errRegister)
+	}
+	if errDefault := registry.SetDynamicDefault("RPOP", legacyDispatch); errDefault != nil {
+		t.Fatal(errDefault)
+	}
+	env := dispatch.Env{ConnectionLifetime: cluster.ConnectionLifetime{Controlled: true}}
+	payload := `{"type":"usage-credit-check","model":"gpt","pinned_auth_id":"paid"}`
+	reply := registry.Execute(t.Context(), env, []string{"RPOP", payload})
+	if reply.Kind != dispatch.ReplyKindRedisError || !strings.Contains(reply.RedisError, "unsupported type") || dispatched != 0 {
+		t.Fatal("unknown funding check entered old Home dispatch")
+	}
+	registry.Execute(t.Context(), env, []string{"RPOP", `{"type":"auth","model":"gpt"}`})
+	if dispatched != 1 {
+		t.Fatal("legacy auth fixture did not dispatch")
+	}
+}
