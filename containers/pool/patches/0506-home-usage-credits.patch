--- /dev/null
+++ b/internal/cluster/management/usage_credits.go
@@ -0,0 +1,32 @@
+package management
+
+import (
+	"net/http"
+	"time"
+
+	"github.com/gin-gonic/gin"
+)
+
+func (h *Handler) GetChannelGroupCreditRouting(c *gin.Context) {
+	id, ok := channelIDFromParam(c)
+	if !ok {
+		return
+	}
+	ctx, cancel := h.requestContext(c)
+	defer cancel()
+	group, errGroup := h.repo.GetChannelGroup(ctx, id)
+	if errGroup != nil {
+		respondChannelRecordError(c, "channel_group_load_failed", errGroup)
+		return
+	}
+	routing, errRouting := h.repo.ChannelGroupCreditRouting(ctx, id, c.Query("model"), time.Now().UTC())
+	if errRouting != nil {
+		respondError(c, http.StatusServiceUnavailable, "usage_credit_policy_unavailable", errRouting)
+		return
+	}
+	policy := group.UsageCreditPolicy
+	if policy == "" {
+		policy = "last_resort"
+	}
+	c.JSON(http.StatusOK, gin.H{"usageCreditPolicy": policy, "accounts": routing})
+}
