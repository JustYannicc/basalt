diff --git a/internal/cluster/usage_credits.go b/internal/cluster/usage_credits.go
new file mode 100644
index 0000000..2137a0d
--- /dev/null
+++ b/internal/cluster/usage_credits.go
@@ -0,0 +1,256 @@
+package cluster
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"time"
+)
+
+// Usage-credit observations retain their own deadline across passive quota updates.
+type QuotaUsageCredits struct {
+	State         string           `json:"state"`
+	Balance       *string          `json:"balance"`
+	ObservedAt    time.Time        `json:"observed_at"`
+	ExpiresAt     time.Time        `json:"expires_at"`
+	Allowed       *bool            `json:"allowed"`
+	LimitReached  *bool            `json:"limit_reached"`
+	HasCredits    *bool            `json:"has_credits"`
+	Unlimited     *bool            `json:"unlimited"`
+	CreditBlocked bool             `json:"credit_blocked"`
+	ExtraUsage    *QuotaExtraUsage `json:"extra_usage"`
+}
+type QuotaExtraUsage struct {
+	Enabled    *bool    `json:"enabled"`
+	MonthlyCap string   `json:"monthly_cap"`
+	UsedRatio  *float64 `json:"used_ratio"`
+}
+
+func usageCreditsFromJSON(raw JSONB) *QuotaUsageCredits {
+	if len(raw) == 0 || len(raw) > 2048 {
+		return nil
+	}
+	var value QuotaUsageCredits
+	if json.Unmarshal(raw, &value) != nil {
+		return nil
+	}
+	switch value.State {
+	case "available", "unlimited", "none", "disabled", "unknown":
+	default:
+		return nil
+	}
+	return &value
+}
+
+// A client key inherits the strictest policy of its server-owned channel groups.
+func (r *Repository) usageCreditPolicyForAPIKey(ctx context.Context, apiKey, model string) (string, error) {
+	db, errDB := r.database()
+	if errDB != nil {
+		return "", errDB
+	}
+	key, errKey := r.findAPIKeyForAccess(ctx, db, apiKey)
+	if errKey != nil {
+		return "", errKey
+	}
+	channels, errChannels := apiKeyChannelsFromJSON(key.Channels)
+	if errChannels != nil {
+		return "", errChannels
+	}
+	modelDetails, _, errDetails := allowedModelGroupDetailsForAPIKeyRecord(ctx, db, &key)
+	if errDetails != nil {
+		return "", errDetails
+	}
+	modelChannels, restricted, errModel := modelChannelGroupIDsFromDetails(modelDetails, model)
+	if errModel != nil {
+		return "", errModel
+	}
+	if restricted {
+		channels = append(channels, modelChannels...)
+	}
+	if len(channels) == 0 {
+		return "last_resort", nil
+	}
+	var groups []ChannelGroupRecord
+	if errGroups := db.WithContext(ctx).Where("id IN ? AND disabled = ?", channels, false).Find(&groups).Error; errGroups != nil {
+		return "", errGroups
+	}
+	for _, group := range groups {
+		if group.UsageCreditPolicy != "" && group.UsageCreditPolicy != "last_resort" {
+			return "never", nil
+		}
+	}
+	return "last_resort", nil
+}
+
+func (a *RuntimeAdapter) UsageCreditTiersForAPIKey(ctx context.Context, apiKey, model string, models map[string]string) (map[string]int, error) {
+	policy, errPolicy := a.repo.usageCreditPolicyForAPIKey(ctx, apiKey, model)
+	if errPolicy != nil {
+		return nil, errPolicy
+	}
+	selected := make(map[string]struct{}, len(models))
+	for id := range models {
+		selected[id] = struct{}{}
+	}
+	now := time.Now().UTC()
+	items, errItems := a.repo.loadQuotaCredentials(ctx, now, selected, true)
+	if errItems != nil {
+		return nil, errItems
+	}
+	tiers := make(map[string]int, len(models))
+	for _, item := range items {
+		tier := usageCreditFundingTier(item, models[item.CredentialID], now)
+		if policy == "never" && tier > 0 {
+			tier = 3
+		}
+		tiers[item.CredentialID] = tier
+	}
+	// A missing subscription observation is unknown, never proof of plan quota.
+	for id := range models {
+		if _, ok := tiers[id]; !ok {
+			if policy == "never" {
+				tiers[id] = 3
+			} else {
+				tiers[id] = 2
+			}
+		}
+	}
+	return tiers, nil
+}
+
+// 0 = included plan, 1 = confirmed credits, 2 = unknown funding, 3 = unavailable.
+func usageCreditFundingTier(item QuotaCredentialSnapshot, model string, now time.Time) int {
+	if (item.Provider != "codex" && item.Provider != "claude") || item.CredentialType == "provider_api_key" {
+		return 0
+	}
+	if item.CredentialStatus != "enabled" && item.CredentialStatus != "active" && item.CredentialStatus != "available" && item.CredentialStatus != "" {
+		return 3
+	}
+	credits := item.UsageCredits
+	if item.Error != nil && item.Error.OccurredAt != nil && (credits == nil || !item.Error.OccurredAt.Before(credits.ObservedAt)) {
+		if item.Error.Code == "UPSTREAM_AUTH_REJECTED" || item.Error.Code == "UPSTREAM_RATE_LIMITED" {
+			return 3
+		}
+	}
+	plan := item.Freshness == "fresh" && item.ObservedAt != nil && !item.ObservedAt.After(now)
+	known := false
+	exhausted := false
+	for _, window := range item.Windows {
+		if !usageCreditWindowApplies(window, model) {
+			continue
+		}
+		if window.ExpiresAt != nil && !now.Before(*window.ExpiresAt) || window.ObservedAt.After(now) {
+			plan = false
+			continue
+		}
+		if window.IsUnlimited {
+			known = true
+			continue
+		}
+		if window.RemainingRatio == nil {
+			plan = false
+			continue
+		}
+		known = true
+		if *window.RemainingRatio <= 0 {
+			exhausted = true
+		}
+	}
+	freshCredits := credits != nil && !credits.ObservedAt.After(now) && now.Before(credits.ExpiresAt)
+	if freshCredits && (credits.Allowed != nil && !*credits.Allowed || credits.LimitReached != nil && *credits.LimitReached) {
+		exhausted = true
+	}
+	if plan && known && !exhausted {
+		return 0
+	}
+	if freshCredits && !credits.CreditBlocked && (credits.State == "available" || credits.State == "unlimited") {
+		return 1
+	}
+	if credits != nil && (credits.CreditBlocked || credits.State == "none" || credits.State == "disabled") {
+		return 3
+	}
+	return 2
+}
+
+func usageCreditWindowApplies(window QuotaWindow, model string) bool {
+	if window.ID == "claude-extra-usage" || strings.Contains(window.ID, "code-review") {
+		return false
+	}
+	if window.Scope == "account" {
+		return window.ID != "claude-seven-day-cowork"
+	}
+	if window.Scope != "model" || window.ScopeID == nil {
+		return false
+	}
+	scope := strings.TrimPrefix(strings.ToLower(*window.ScopeID), "codex_")
+	normalized := strings.NewReplacer("-", "_", ".", "_").Replace(strings.ToLower(model))
+	return scope == normalized || scope == "spark" && strings.HasSuffix(normalized, "_spark") || (scope == "opus" || scope == "sonnet") && strings.Contains(normalized, scope)
+}
+
+type AccountUsageRouting struct {
+	Use      string `json:"use"`
+	Eligible bool   `json:"eligible"`
+	Reason   string `json:"reason"`
+	Policy   string `json:"policy"`
+}
+
+func (r *Repository) ChannelGroupCreditRouting(ctx context.Context, id uint, model string, now time.Time) (map[string]AccountUsageRouting, error) {
+	group, errGroup := r.GetChannelGroup(ctx, id)
+	if errGroup != nil {
+		return nil, errGroup
+	}
+	db, errDB := r.database()
+	if errDB != nil {
+		return nil, errDB
+	}
+	var details []ChannelGroupDetailRecord
+	if errDetails := db.WithContext(ctx).Where("channel_group_id = ?", id).Find(&details).Error; errDetails != nil {
+		return nil, errDetails
+	}
+	ids := make(map[string]struct{}, len(details))
+	for _, detail := range details {
+		ids[detail.AuthID] = struct{}{}
+	}
+	result := make(map[string]AccountUsageRouting, len(ids))
+	if len(ids) == 0 {
+		return result, nil
+	}
+	items, errItems := r.loadQuotaCredentials(ctx, now, ids, true)
+	if errItems != nil {
+		return nil, errItems
+	}
+	policy := group.UsageCreditPolicy
+	if policy == "" {
+		policy = "last_resort"
+	}
+	for _, item := range items {
+		tier := usageCreditFundingTier(item, model, now)
+		value := AccountUsageRouting{Policy: policy, Eligible: tier < 3}
+		switch tier {
+		case 0:
+			value.Use = "plan"
+			value.Reason = "plan_available"
+		case 1:
+			value.Use = "credits"
+			value.Reason = "credits_only"
+		case 2:
+			value.Use = "unknown"
+			value.Reason = "usage_unknown"
+		default:
+			value.Use = "exhausted"
+			value.Reason = "quota_exhausted"
+			if item.UsageCredits != nil && item.UsageCredits.State == "disabled" {
+				value.Reason = "credits_disabled"
+			}
+			if item.CredentialStatus != "enabled" {
+				value.Use = "blocked"
+				value.Reason = "credential_unavailable"
+			}
+		}
+		if policy == "never" && tier > 0 && tier < 3 {
+			value.Eligible = false
+			value.Reason = "credit_policy_never"
+		}
+		result[item.CredentialID] = value
+	}
+	return result, nil
+}
