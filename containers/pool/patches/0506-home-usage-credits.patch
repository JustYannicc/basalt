@@ -0,0 +1,109 @@
+package cluster
+
+import (
+	"testing"
+	"time"
+)
+
+func TestUsageCreditFundingTiers(t *testing.T) {
+	now := time.Unix(200, 0).UTC()
+	before := now.Add(-time.Minute)
+	after := now.Add(time.Minute)
+	positive, zero := .5, 0.0
+	balance := "25"
+	plan := QuotaCredentialSnapshot{Provider: "codex", CredentialType: "oauth", CredentialStatus: "enabled", Freshness: "fresh", ObservedAt: &before, Windows: []QuotaWindow{{ID: "codex-5-hour", Scope: "account", RemainingRatio: &positive, ObservedAt: before, ExpiresAt: &after}}, UsageCredits: &QuotaUsageCredits{State: "available", Balance: &balance, ObservedAt: before, ExpiresAt: after}}
+	if usageCreditFundingTier(plan, "gpt-5.5", now) != 0 {
+		t.Fatal("plan must win even when credits available")
+	}
+	plan.Windows[0].RemainingRatio = &zero
+	if usageCreditFundingTier(plan, "gpt-5.5", now) != 1 {
+		t.Fatal("exhausted plan with fresh credits must use credits")
+	}
+	plan.UsageCredits.ExpiresAt = before
+	if usageCreditFundingTier(plan, "gpt-5.5", now) != 2 {
+		t.Fatal("stale funding must be unknown")
+	}
+	plan.UsageCredits.State = "none"
+	if usageCreditFundingTier(plan, "gpt-5.5", now) != 3 {
+		t.Fatal("explicit zero cannot become unknown fallback")
+	}
+	plan.CredentialType = "provider_api_key"
+	if usageCreditFundingTier(plan, "gpt-5.5", now) != 0 {
+		t.Fatal("subscription credit policy changed API-key billing")
+	}
+}
+
+func TestUsageCreditPoolPolicyIsolationAndModelGroups(t *testing.T) {
+	repo := newCredentialFoundationTestRepository(t)
+	ctx := t.Context()
+	allow, errAllow := repo.CreateChannelGroup(ctx, "allow", false)
+	if errAllow != nil {
+		t.Fatal(errAllow)
+	}
+	deny, errDeny := repo.CreateChannelGroup(ctx, "deny", false)
+	if errDeny != nil {
+		t.Fatal(errDeny)
+	}
+	never := "never"
+	if _, errUpdate := repo.UpdateChannelGroup(ctx, deny.ID, ChannelGroupUpdate{UsageCreditPolicy: &never}); errUpdate != nil {
+		t.Fatal(errUpdate)
+	}
+	for name, channels := range map[string][]uint{"allow-key": {allow.ID}, "deny-key": {deny.ID}, "mixed-key": {allow.ID, deny.ID}} {
+		if _, errKey := repo.CreateAPIKey(ctx, APIKeyEntryUpdate{APIKey: name, Channels: &channels}); errKey != nil {
+			t.Fatal(errKey)
+		}
+	}
+	for key, want := range map[string]string{"allow-key": "last_resort", "deny-key": "never", "mixed-key": "never"} {
+		got, errPolicy := repo.usageCreditPolicyForAPIKey(ctx, key, "gpt")
+		if errPolicy != nil || got != want {
+			t.Fatalf("%s policy=(%s,%v), want %s", key, got, errPolicy, want)
+		}
+	}
+	models, errModels := repo.CreateModelGroup(ctx, "restricted-models", false)
+	if errModels != nil {
+		t.Fatal(errModels)
+	}
+	if _, errDetail := repo.CreateModelGroupDetail(ctx, models.ID, "gpt", []uint{deny.ID}); errDetail != nil {
+		t.Fatal(errDetail)
+	}
+	groups, channels := []uint{models.ID}, []uint{allow.ID}
+	if _, errKey := repo.CreateAPIKey(ctx, APIKeyEntryUpdate{APIKey: "model-key", Channels: &channels, ModelGroups: &groups}); errKey != nil {
+		t.Fatal(errKey)
+	}
+	for model, want := range map[string]string{"gpt": "never", "other": "last_resort"} {
+		got, errPolicy := repo.usageCreditPolicyForAPIKey(ctx, "model-key", model)
+		if errPolicy != nil || got != want {
+			t.Fatalf("%s policy=(%s,%v), want %s", model, got, errPolicy, want)
+		}
+	}
+}
+
+func TestUsageCreditFundingUsesApplicableFreshWindows(t *testing.T) {
+	now := time.Unix(200, 0).UTC()
+	before, after := now.Add(-time.Minute), now.Add(time.Minute)
+	positive, zero := .5, 0.0
+	sonnet, opus, spark := "sonnet", "opus", "codex_spark"
+	item := QuotaCredentialSnapshot{Provider: "claude", CredentialType: "oauth", CredentialStatus: "enabled", Freshness: "fresh", ObservedAt: &before, Windows: []QuotaWindow{
+		{ID: "claude-five-hour", Scope: "account", RemainingRatio: &positive, ObservedAt: before, ExpiresAt: &after},
+		{ID: "claude-seven-day-sonnet", Scope: "model", ScopeID: &sonnet, RemainingRatio: &zero, ObservedAt: before, ExpiresAt: &after},
+		{ID: "claude-seven-day-opus", Scope: "model", ScopeID: &opus, RemainingRatio: &positive, ObservedAt: before, ExpiresAt: &after},
+	}}
+	if got := usageCreditFundingTier(item, "claude-sonnet-4-6", now); got != 2 {
+		t.Fatalf("Sonnet exhausted plan classified %d", got)
+	}
+	if got := usageCreditFundingTier(item, "claude-opus-4-7", now); got != 0 {
+		t.Fatalf("Sonnet exhaustion affected Opus: %d", got)
+	}
+	item.Windows[2].ExpiresAt = &before
+	if got := usageCreditFundingTier(item, "claude-opus-4-7", now); got != 2 {
+		t.Fatalf("stale Opus window proved plan: %d", got)
+	}
+	item.Provider = "codex"
+	item.Windows = []QuotaWindow{{ID: "codex-5-hour", Scope: "account", RemainingRatio: &positive, ObservedAt: before, ExpiresAt: &after}, {ID: "codex-spark-weekly", Scope: "model", ScopeID: &spark, RemainingRatio: &zero, ObservedAt: before, ExpiresAt: &after}}
+	if got := usageCreditFundingTier(item, "gpt-5.5-spark", now); got != 2 {
+		t.Fatalf("Spark exhaustion ignored: %d", got)
+	}
+	if got := usageCreditFundingTier(item, "gpt-5.5", now); got != 0 {
+		t.Fatalf("Spark exhaustion affected ordinary model: %d", got)
+	}
+}
