new file mode 100644
index 0000000..177ef38
--- /dev/null
+++ b/internal/quota/usage_credits.go
@@ -0,0 +1,123 @@
+package quota
+
+import (
+	"bytes"
+	"encoding/json"
+	"math"
+	"math/big"
+	"regexp"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPIHome/internal/cluster"
+)
+
+var usageCreditDecimal = regexp.MustCompile(`^(0|[1-9][0-9]*)(\.[0-9]+)?$`)
+
+func creditBool(value json.RawMessage) *bool {
+	var parsed bool
+	if len(value) == 0 || bytes.Equal(value, []byte("null")) || json.Unmarshal(value, &parsed) != nil {
+		return nil
+	}
+	return &parsed
+}
+func creditDecimal(value json.RawMessage) *string {
+	var text string
+	if len(value) > 82 {
+		return nil
+	}
+	if json.Unmarshal(value, &text) != nil {
+		text = string(value)
+	}
+	if len(text) > 80 || !usageCreditDecimal.MatchString(text) {
+		return nil
+	}
+	return &text
+}
+func creditPositive(value string) bool {
+	for _, char := range value {
+		if char >= '1' && char <= '9' {
+			return true
+		}
+	}
+	return false
+}
+func creditAtLeast(value, limit *string) bool {
+	if value == nil || limit == nil {
+		return false
+	}
+	amount, amountOK := new(big.Rat).SetString(*value)
+	cap, capOK := new(big.Rat).SetString(*limit)
+	return amountOK && capOK && amount.Cmp(cap) >= 0
+}
+func creditRatio(value json.RawMessage) *float64 {
+	var parsed float64
+	if len(value) == 0 || bytes.Equal(value, []byte("null")) || json.Unmarshal(value, &parsed) != nil || math.IsNaN(parsed) || math.IsInf(parsed, 0) || parsed < 0 {
+		return nil
+	}
+	parsed = math.Min(1, parsed/100)
+	return &parsed
+}
+func parseCodexUsageCredits(body []byte, observedAt time.Time) *cluster.QuotaUsageCredits {
+	value := &cluster.QuotaUsageCredits{State: "unknown", ObservedAt: observedAt}
+	var payload struct {
+		Credits   map[string]json.RawMessage `json:"credits"`
+		RateLimit map[string]json.RawMessage `json:"rate_limit"`
+	}
+	if json.Unmarshal(body, &payload) != nil {
+		return value
+	}
+	value.Allowed = creditBool(payload.RateLimit["allowed"])
+	value.LimitReached = creditBool(payload.RateLimit["limit_reached"])
+	value.HasCredits = creditBool(payload.Credits["has_credits"])
+	value.Unlimited = creditBool(payload.Credits["unlimited"])
+	balance := creditDecimal(payload.Credits["balance"])
+	zero := balance != nil && !creditPositive(*balance)
+	off := value.HasCredits != nil && !*value.HasCredits
+	value.CreditBlocked = zero || off
+	unlimited := value.Unlimited != nil && *value.Unlimited
+	switch {
+	case off && (unlimited || balance != nil && !zero):
+		return value
+	case unlimited && !off:
+		value.State = "unlimited"
+	case balance != nil && !zero && !off:
+		value.State = "available"
+		value.Balance = balance
+	case off || zero:
+		value.State = "none"
+		value.Balance = balance
+	}
+	return value
+}
+func parseClaudeUsageCredits(body []byte, observedAt time.Time) *cluster.QuotaUsageCredits {
+	value := &cluster.QuotaUsageCredits{State: "unknown", ObservedAt: observedAt}
+	var payload struct {
+		Extra map[string]json.RawMessage `json:"extra_usage"`
+	}
+	if json.Unmarshal(body, &payload) != nil || payload.Extra == nil {
+		return value
+	}
+	enabled := creditBool(payload.Extra["is_enabled"])
+	extra := &cluster.QuotaExtraUsage{Enabled: enabled, MonthlyCap: "unknown", UsedRatio: creditRatio(payload.Extra["utilization"])}
+	value.ExtraUsage = extra
+	limit, present := payload.Extra["monthly_limit"]
+	if present && bytes.Equal(limit, []byte("null")) {
+		extra.MonthlyCap = "unlimited"
+	} else if creditDecimal(limit) != nil {
+		extra.MonthlyCap = "limited"
+	}
+	if enabled != nil && !*enabled {
+		value.State = "disabled"
+		value.CreditBlocked = true
+		return value
+	}
+	if extra.MonthlyCap == "limited" {
+		cap := creditDecimal(limit)
+		if extra.UsedRatio != nil && *extra.UsedRatio >= 1 || cap != nil && !creditPositive(*cap) || creditAtLeast(creditDecimal(payload.Extra["used_credits"]), cap) {
+			value.CreditBlocked = true
+			value.State = "none"
+		}
+	}
+	// A monthly spending cap is not a prepaid wallet. Currency and scale are unproven.
+	return value
+}
