diff --git a/internal/cluster/management/oauth_session_proxy.go b/internal/cluster/management/oauth_session_proxy.go
new file mode 100644
index 0000000..db32609
--- /dev/null
+++ b/internal/cluster/management/oauth_session_proxy.go
@@ -0,0 +1,156 @@
+package management
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPIHome/internal/auth/claude"
+	"github.com/router-for-me/CLIProxyAPIHome/internal/proxyutil"
+)
+
+// A sign-in may name its own proxy. Every call that sign-in makes then goes through it or fails,
+// never through Home's own proxy or direct, and the credential it creates keeps it.
+const (
+	oauthSessionProxyField = "proxy_url"
+	oauthProxyUnavailable  = "proxy_unavailable"
+)
+
+var errOAuthSessionProxy = errors.New("oauth session proxy cannot be used")
+
+type oauthSessionProxyKey struct{}
+
+// oauthSessionProxyRequested reports whether the request names a proxy, even a blank one.
+func oauthSessionProxyRequested(c *gin.Context) bool {
+	return c != nil && c.Request != nil && c.Request.URL != nil && c.Request.URL.Query().Has(oauthSessionProxyField)
+}
+
+// parseOAuthSessionProxy reads a sign-in's optional proxy. It answers the request itself and
+// returns false for one Home could not route that sign-in through.
+func parseOAuthSessionProxy(c *gin.Context, provider string) (string, bool) {
+	if !oauthSessionProxyRequested(c) {
+		return "", true
+	}
+	raw := strings.TrimSpace(c.Query(oauthSessionProxyField))
+	if validateOAuthSessionProxy(raw) != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid_proxy_url"})
+		return "", false
+	}
+	if provider == "anthropic" && validateAnthropicSessionProxy(raw) != nil {
+		// Home's Anthropic TLS client dials only through SOCKS and connects direct otherwise, at
+		// this exchange and at every later refresh of the credential.
+		c.JSON(http.StatusBadRequest, gin.H{"error": "proxy_unsupported"})
+		return "", false
+	}
+	return raw, true
+}
+
+// validateOAuthSessionProxy accepts only a proxy URL Home's transport builder routes through. The
+// provider clients build from the same function, so their direct fallback on a bad proxy can't
+// apply to a URL that passed here. The host and port must be explicit: an empty host dials this
+// machine, and a SOCKS URL without a port never dials.
+func validateOAuthSessionProxy(raw string) error {
+	setting, errParse := proxyutil.Parse(raw)
+	if errParse != nil || setting.Mode != proxyutil.ModeProxy || setting.URL.Hostname() == "" || setting.URL.Port() == "" {
+		return errOAuthSessionProxy
+	}
+	transport, mode, errBuild := proxyutil.BuildHTTPTransport(raw)
+	if errBuild != nil || mode != proxyutil.ModeProxy || transport == nil {
+		return errOAuthSessionProxy
+	}
+	return nil
+}
+
+func validateAnthropicSessionProxy(raw string) error {
+	dialer, mode, errDial := proxyutil.BuildDialer(raw)
+	if errDial != nil || mode != proxyutil.ModeProxy || dialer == nil {
+		return errOAuthSessionProxy
+	}
+	return nil
+}
+
+// withOAuthSessionProxyData stores the sign-in's proxy with its session.
+func withOAuthSessionProxyData(data map[string]any, proxyURL string) map[string]any {
+	if proxyURL != "" {
+		data[oauthSessionProxyField] = proxyURL
+	}
+	return data
+}
+
+func withOAuthSessionProxy(ctx context.Context, proxyURL string) context.Context {
+	if proxyURL == "" {
+		return ctx
+	}
+	return context.WithValue(ctx, oauthSessionProxyKey{}, proxyURL)
+}
+
+func oauthSessionProxy(ctx context.Context) string {
+	proxyURL, _ := ctx.Value(oauthSessionProxyKey{}).(string)
+	return proxyURL
+}
+
+// oauthHTTPClientFor is oauthHTTPClient for a sign-in without its own proxy. With one, the
+// transport is built here, never through util.SetProxy, which keeps the default transport when
+// a proxy can't be built.
+func (h *Handler) oauthHTTPClientFor(ctx context.Context) *http.Client {
+	proxyURL := oauthSessionProxy(ctx)
+	if proxyURL == "" {
+		return h.oauthHTTPClient()
+	}
+	transport, mode, errBuild := proxyutil.BuildHTTPTransport(proxyURL)
+	if errBuild != nil || mode != proxyutil.ModeProxy || transport == nil {
+		return &http.Client{Timeout: 60 * time.Second, Transport: refusedTransport{}}
+	}
+	return &http.Client{Timeout: 60 * time.Second, Transport: transport}
+}
+
+func (h *Handler) anthropicHTTPClientFor(ctx context.Context) *http.Client {
+	proxyURL := oauthSessionProxy(ctx)
+	if proxyURL == "" {
+		return claude.NewAnthropicHttpClient(&h.oauthConfig().SDKConfig)
+	}
+	if validateAnthropicSessionProxy(proxyURL) != nil {
+		return &http.Client{Transport: refusedTransport{}}
+	}
+	sdkCfg := h.oauthConfig().SDKConfig
+	sdkCfg.ProxyURL = proxyURL
+	return claude.NewAnthropicHttpClient(&sdkCfg)
+}
+
+type refusedTransport struct{}
+
+func (refusedTransport) RoundTrip(*http.Request) (*http.Response, error) {
+	return nil, errOAuthSessionProxy
+}
+
+// oauthSessionFailure reports a sign-in through its own proxy that got no answer as the fixed
+// proxy_unavailable, and anything else as fallback.
+func oauthSessionFailure(ctx context.Context, err error, fallback string) string {
+	if oauthSessionProxy(ctx) != "" && oauthRouteFailed(err) {
+		return oauthProxyUnavailable
+	}
+	return fallback
+}
+
+// oauthRouteFailed reports a call that got no answer: http.Client wraps every such error in a
+// url.Error. A cancelled sign-in is not a route failure.
+func oauthRouteFailed(err error) bool {
+	var transport *url.Error
+	return errors.As(err, &transport) && !errors.Is(err, context.Canceled)
+}
+
+// oauthSessionProxyFromData restores a stored sign-in's proxy, or fails it closed.
+func oauthSessionProxyFromData(ctx context.Context, data map[string]any) (context.Context, bool) {
+	proxyURL := stringFromAny(data[oauthSessionProxyField])
+	if proxyURL == "" {
+		return ctx, true
+	}
+	if validateOAuthSessionProxy(proxyURL) != nil {
+		return ctx, false
+	}
+	return withOAuthSessionProxy(ctx, proxyURL), true
+}
