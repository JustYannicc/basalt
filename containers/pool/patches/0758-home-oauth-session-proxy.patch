+// startSessionProxyProvider answers as each provider's real host, over TLS this process trusts.
+func startSessionProxyProvider(t *testing.T) string {
+	t.Helper()
+	hosts := []string{}
+	for route := range sessionProxyAnswers {
+		host, _, _ := strings.Cut(route, "/")
+		if !slices.Contains(hosts, host) {
+			hosts = append(hosts, host)
+		}
+	}
+	key, errKey := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if errKey != nil {
+		t.Fatal(errKey)
+	}
+	template := &x509.Certificate{
+		SerialNumber: big.NewInt(758), Subject: pkix.Name{CommonName: "OAuth session proxy fixture"},
+		DNSNames: hosts, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour),
+		IsCA: true, BasicConstraintsValid: true, KeyUsage: x509.KeyUsageCertSign | x509.KeyUsageDigitalSignature,
+		ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
+	}
+	der, errCert := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+	if errCert != nil {
+		t.Fatal(errCert)
+	}
+	cert, errParse := x509.ParseCertificate(der)
+	if errParse != nil {
+		t.Fatal(errParse)
+	}
+	roots := x509.NewCertPool()
+	roots.AddCert(cert)
+	t.Setenv("GODEBUG", "x509usefallbackroots=1")
+	x509.SetFallbackRoots(roots)
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		answer, ok := sessionProxyAnswers[r.Host+r.URL.Path]
+		if !ok {
+			w.WriteHeader(http.StatusNotFound)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = io.WriteString(w, answer)
+	}))
+	server.EnableHTTP2 = true
+	server.TLS = &tls.Config{Certificates: []tls.Certificate{{Certificate: [][]byte{der}, PrivateKey: key}}}
+	server.StartTLS()
+	t.Cleanup(server.Close)
+	return server.Listener.Addr().String()
+}
+
+// recordingSOCKS is a SOCKS5 proxy that records each destination and connects it to the provider
+// stand-in, except a destination it was told to refuse.
+type recordingSOCKS struct {
+	listener net.Listener
+	mu       sync.Mutex
+	seen     []string
+	refused  map[string]bool
+	open     map[net.Conn]string
+}
+
+func startRecordingSOCKS(t *testing.T, provider string) *recordingSOCKS {
+	t.Helper()
+	listener, errListen := net.Listen("tcp", "127.0.0.1:0")
+	if errListen != nil {
+		t.Fatal(errListen)
+	}
+	proxy := &recordingSOCKS{listener: listener, refused: map[string]bool{}, open: map[net.Conn]string{}}
+	t.Cleanup(func() { _ = listener.Close() })
+	go func() {
+		for {
+			conn, errAccept := listener.Accept()
+			if errAccept != nil {
+				return
+			}
+			go proxy.serve(conn, provider)
+		}
+	}()
+	return proxy
+}
+
+func (p *recordingSOCKS) addr() string { return p.listener.Addr().String() }
+
+func (p *recordingSOCKS) destinations() []string {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return append([]string(nil), p.seen...)
+}
+
+// refuse fails every later connection to host and drops the ones already open.
+func (p *recordingSOCKS) refuse(host string) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.refused[host] = true
+	for conn, destination := range p.open {
+		if destination == host {
+			_ = conn.Close()
+		}
+	}
+}
+
+func (p *recordingSOCKS) serve(conn net.Conn, provider string) {
+	defer conn.Close()
+	greeting := make([]byte, 2)
+	if _, errRead := io.ReadFull(conn, greeting); errRead != nil {
+		return
+	}
+	if _, errRead := io.ReadFull(conn, make([]byte, int(greeting[1]))); errRead != nil {
+		return
+	}
+	_, _ = conn.Write([]byte{5, 0})
+	header := make([]byte, 4)
+	if _, errRead := io.ReadFull(conn, header); errRead != nil {
+		return
+	}
+	var host string
+	switch header[3] {
+	case 1:
+		address := make([]byte, 4)
+		if _, errRead := io.ReadFull(conn, address); errRead != nil {
+			return
+		}
+		host = net.IP(address).String()
+	case 3:
+		size := make([]byte, 1)
+		if _, errRead := io.ReadFull(conn, size); errRead != nil {
+			return
+		}
+		name := make([]byte, int(size[0]))
+		if _, errRead := io.ReadFull(conn, name); errRead != nil {
+			return
+		}
+		host = string(name)
+	default:
+		return
+	}
+	port := make([]byte, 2)
+	if _, errRead := io.ReadFull(conn, port); errRead != nil || binary.BigEndian.Uint16(port) != 443 {
+		return
+	}
+	p.mu.Lock()
+	p.seen = append(p.seen, host)
+	refused := p.refused[host]
+	if !refused {
+		p.open[conn] = host
+	}
+	p.mu.Unlock()
+	if refused {
+		_, _ = conn.Write([]byte{5, 5, 0, 1, 0, 0, 0, 0, 0, 0})
+		return
+	}
+	defer func() {
+		p.mu.Lock()
+		delete(p.open, conn)
+		p.mu.Unlock()
+	}()
+	upstream, errDial := net.Dial("tcp", provider)
+	if errDial != nil {
+		return
+	}
+	defer upstream.Close()
+	_, _ = conn.Write([]byte{5, 0, 0, 1, 127, 0, 0, 1, 0, 0})
+	done := make(chan struct{})
+	go func() { _, _ = io.Copy(upstream, conn); _ = upstream.Close(); close(done) }()
+	_, _ = io.Copy(conn, upstream)
+	_ = conn.Close()
+	<-done
+}
+
+// closedAddress is a local port nothing listens on.
+func closedAddress(t *testing.T) string {
+	t.Helper()
+	listener, errListen := net.Listen("tcp", "127.0.0.1:0")
+	if errListen != nil {
+		t.Fatal(errListen)
+	}
+	address := listener.Addr().String()
+	if errClose := listener.Close(); errClose != nil && !errors.Is(errClose, net.ErrClosed) {
+		t.Fatal(errClose)
+	}
+	return address
+}
+
+func distinct(hosts []string) []string {
+	out := []string{}
+	for _, host := range hosts {
+		if !slices.Contains(out, host) {
+			out = append(out, host)
+		}
+	}
+	slices.Sort(out)
+	return out
+}
+
+// sessionProxyPlugin stands for a Home-loaded plugin that owns a provider's sign-in.
+type sessionProxyPlugin struct{ provider string }
+
+func (p sessionProxyPlugin) HasPluginAuthProvider(provider string) bool {
+	return provider == p.provider
+}
+
+func (sessionProxyPlugin) PollPluginLogin(context.Context, string, string, map[string]any) (pluginapi.AuthLoginPollResponse, bool, error) {
+	return pluginapi.AuthLoginPollResponse{}, false, nil
+}
+
+func (sessionProxyPlugin) PluginLoginAuths(pluginapi.AuthLoginPollResponse) ([]*coreauth.Auth, error) {
+	return nil, nil
+}
