+// catchDirectLookups counts every name lookup Home makes itself. Through a proxy the proxy
+// resolves names, so a lookup means a call that went around it.
+func catchDirectLookups(t *testing.T) *atomic.Int64 {
+	t.Helper()
+	lookups := &atomic.Int64{}
+	net.DefaultResolver = &net.Resolver{PreferGo: true, Dial: func(context.Context, string, string) (net.Conn, error) {
+		lookups.Add(1)
+		return nil, errors.New("direct lookup refused")
+	}}
+	if _, errLookup := net.DefaultResolver.LookupHost(t.Context(), "lookup-probe.invalid"); errLookup == nil || lookups.Load() == 0 {
+		t.Fatal("the lookup catcher does not see Go's resolver")
+	}
+	return lookups
+}
