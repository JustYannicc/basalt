+func selectionWindow(id, scope, family string, seconds int64, remaining float64, reset, observed, expires time.Time) QuotaWindow {
+	window := QuotaWindow{ID: id, Scope: scope, WindowSeconds: &seconds, RemainingRatio: &remaining, ResetAt: &reset, ObservedAt: observed, ExpiresAt: &expires}
+	if family != "" {
+		window.ScopeID = &family
+	}
+	return window
+}
+
+func TestQuotaSelectionWeeklyOrderAndEveryWindowGate(t *testing.T) {
+	now := time.Date(2026, 11, 12, 10, 0, 0, 0, time.UTC)
+	observed, expires := now.Add(-time.Minute), now.Add(time.Minute)
