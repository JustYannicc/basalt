diff --git a/internal/cluster/quota_selection.go b/internal/cluster/quota_selection.go
new file mode 100644
--- /dev/null
+++ b/internal/cluster/quota_selection.go
@@ -0,0 +1,99 @@
+package cluster
+
+import (
+	"fmt"
+	"math"
+	"strings"
+	"time"
+	"unicode"
+
+	coreauth "github.com/router-for-me/CLIProxyAPIHome/internal/cliproxy/auth"
+)
+
+func NormalizeAccountSelectionPolicy(policy string) (string, error) {
+	switch policy {
+	case "", "reset_aware":
+		return "reset_aware", nil
+	case "balanced":
+		return policy, nil
+	default:
+		return "", fmt.Errorf("invalid account selection policy")
+	}
+}
+
+// Only an account-wide weekly refill replaces the pool's weekly capacity.
+// Model-specific windows still gate funding through usageCreditWindowApplies.
+func quotaSelectionRank(item QuotaCredentialSnapshot, model string, now time.Time) (coreauth.QuotaResetRank, bool) {
+	if item.Provider != "codex" && item.Provider != "claude" || item.CredentialType == "provider_api_key" || usageCreditFundingTier(item, model, now) != 0 || item.ExpiresAt == nil || !item.ExpiresAt.After(now) {
+		return coreauth.QuotaResetRank{}, false
+	}
+	deadline := *item.ExpiresAt
+	headroom := 1.0
+	var weekly, short *QuotaWindow
+	for index := range item.Windows {
+		window := &item.Windows[index]
+		if !usageCreditWindowApplies(*window, model) || window.IsUnlimited {
+			continue
+		}
+		if window.ObservedAt.After(now) || window.ExpiresAt != nil && !window.ExpiresAt.After(now) || window.RemainingRatio == nil || *window.RemainingRatio <= 0 || *window.RemainingRatio > 1 || math.IsNaN(*window.RemainingRatio) || math.IsInf(*window.RemainingRatio, 0) {
+			return coreauth.QuotaResetRank{}, false
+		}
+		if *window.RemainingRatio < headroom {
+			headroom = *window.RemainingRatio
+		}
+		if window.ExpiresAt != nil && window.ExpiresAt.Before(deadline) {
+			deadline = *window.ExpiresAt
+		}
+		if window.Scope != "account" {
+			continue
+		}
+		switch quotaWindowDurationRank(*window) {
+		case 7 * 24 * 60 * 60:
+			if weekly == nil || earlierQuotaReset(window, weekly) {
+				weekly = window
+			}
+		case 5 * 60 * 60:
+			if short == nil || earlierQuotaReset(window, short) {
+				short = window
+			}
+		}
+	}
+	window := weekly
+	if window == nil {
+		window = short
+	}
+	if window == nil || window.ResetAt == nil || !window.ResetAt.After(now) {
+		return coreauth.QuotaResetRank{}, false
+	}
+	return coreauth.QuotaResetRank{ResetAt: *window.ResetAt, ExpiresAt: deadline, Headroom: headroom, WindowID: window.ID}, true
+}
+
+func earlierQuotaReset(left, right *QuotaWindow) bool {
+	// Missing reset data invalidates ordering rather than hiding an unknown bucket.
+	return left.ResetAt == nil || right.ResetAt != nil && left.ResetAt.Before(*right.ResetAt)
+}
+
+func quotaModelScopeApplies(scope, model string) bool {
+	tokens := func(value string) []string {
+		return strings.FieldsFunc(strings.ToLower(value), func(r rune) bool {
+			return !unicode.IsLetter(r) && !unicode.IsDigit(r)
+		})
+	}
+	family, requested := tokens(scope), tokens(model)
+	if len(family) == 0 || len(family) > len(requested) {
+		return false
+	}
+	for start := 0; start <= len(requested)-len(family); start++ {
+		matched := true
+		for index, part := range family {
+			if requested[start+index] != part {
+				matched = false
+				break
+			}
+		}
+		if matched {
+			return true
+		}
+	}
+	return false
+}
