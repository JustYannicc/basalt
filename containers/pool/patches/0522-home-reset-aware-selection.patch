+		return QuotaCredentialSnapshot{Provider: "claude", CredentialType: "oauth", CredentialStatus: "enabled", Freshness: "fresh", ObservedAt: &observed, ExpiresAt: &expires,
+			Windows: []QuotaWindow{
+				selectionWindow("claude-seven-day", "account", "", 604800, .8, weekReset, observed, expires),
+				selectionWindow("claude-five-hour", "account", "", 18000, .5, shortReset, observed, expires),
+				selectionWindow("claude-seven-day-fable", "model", "fable", 604800, .3, modelReset, observed, expires),
+			}}
+	}
+	for _, test := range []struct {
+		name     string
+		change   func(*QuotaCredentialSnapshot)
+		valid    bool
+		deadline time.Time
+	}{
+		{"weekly-beats-short-and-model-reset", func(*QuotaCredentialSnapshot) {}, true, weekReset},
+		{"short-exhaustion-gates", func(s *QuotaCredentialSnapshot) { s.Windows[1].RemainingRatio = float64Ptr(0) }, false, time.Time{}},
+		{"model-exhaustion-gates", func(s *QuotaCredentialSnapshot) { s.Windows[2].RemainingRatio = float64Ptr(0) }, false, time.Time{}},
+		{"unrelated-model-does-not-gate", func(s *QuotaCredentialSnapshot) {
+			family := "other"
+			s.Windows[2].ScopeID = &family
+			s.Windows[2].RemainingRatio = float64Ptr(0)
+		}, true, weekReset},
+		{"only-short-window", func(s *QuotaCredentialSnapshot) { s.Windows = s.Windows[1:2] }, true, shortReset},
+		{"model-weekly-is-never-account-weekly", func(s *QuotaCredentialSnapshot) { s.Windows = s.Windows[1:] }, true, shortReset},
+		{"only-model-windows-have-no-ordering-deadline", func(s *QuotaCredentialSnapshot) { s.Windows = s.Windows[2:] }, false, time.Time{}},
+		{"unknown-weekly-does-not-use-short-reset", func(s *QuotaCredentialSnapshot) { s.Windows[0].ResetAt = nil }, false, time.Time{}},
+		{"expired-weekly-reset", func(s *QuotaCredentialSnapshot) { s.Windows[0].ResetAt = &observed }, false, time.Time{}},
+		{"stale-window", func(s *QuotaCredentialSnapshot) { s.Windows[1].ExpiresAt = &observed }, false, time.Time{}},
+		{"stale-snapshot", func(s *QuotaCredentialSnapshot) { s.Freshness = "stale" }, false, time.Time{}},
+		{"future-snapshot", func(s *QuotaCredentialSnapshot) { s.ObservedAt = &expires }, false, time.Time{}},
+		{"banked-reset-expiry-does-not-order", func(s *QuotaCredentialSnapshot) {
+			s.ResetCredits = &QuotaResetCredits{ObservedAt: observed, Credits: []QuotaResetCredit{{ID: "model-reset", ExpiresAt: &shortReset}}}
+		}, true, weekReset},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			item := fixture()
+			test.change(&item)
+			rank, valid := quotaSelectionRank(item, "claude-fable-5", now)
+			if valid != test.valid || valid && !rank.ResetAt.Equal(test.deadline) {
+				t.Fatalf("rank=(%v,%t), want deadline=%v valid=%t", rank, valid, test.deadline, test.valid)
+			}
+		})
+	}
+	rank, ok := quotaSelectionRank(fixture(), "claude-fable-5", now)
+	if !ok || rank.Headroom != .3 || !rank.ExpiresAt.Equal(expires) {
+		t.Fatal("all applicable windows must constrain headroom and freshness")
+	}
+}
+
+func TestUsageCreditModelScopeTokenBoundaries(t *testing.T) {
+	for _, test := range []struct {
+		scope, model string
+		want         bool
+	}{
+		{"fable", "claude-fable-5", true},
