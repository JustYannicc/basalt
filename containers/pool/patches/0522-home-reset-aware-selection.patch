+}
+
+func TestAccountSelectionPolicyIsolationAndModelBindings(t *testing.T) {
+	repo := newCredentialFoundationTestRepository(t)
+	ctx := t.Context()
+	reset, errReset := repo.CreateChannelGroup(ctx, "reset", false)
+	if errReset != nil {
+		t.Fatal(errReset)
+	}
+	balanced, errBalanced := repo.CreateChannelGroup(ctx, "balanced", false)
+	if errBalanced != nil {
+		t.Fatal(errBalanced)
+	}
+	if reset.AccountSelectionPolicy != "reset_aware" {
+		t.Fatal("default must be reset-aware")
+	}
+	policy := "balanced"
+	if _, errUpdate := repo.UpdateChannelGroup(ctx, balanced.ID, ChannelGroupUpdate{AccountSelectionPolicy: &policy}); errUpdate != nil {
+		t.Fatal(errUpdate)
+	}
+	for key, channels := range map[string][]uint{"reset-key": {reset.ID}, "balanced-key": {balanced.ID}, "mixed-key": {reset.ID, balanced.ID}} {
+		if _, errKey := repo.CreateAPIKey(ctx, APIKeyEntryUpdate{APIKey: key, Channels: &channels}); errKey != nil {
+			t.Fatal(errKey)
+		}
+	}
+	for key, want := range map[string]string{"reset-key": "reset_aware", "balanced-key": "balanced", "mixed-key": "balanced"} {
+		credit, selection, errRead := repo.accountRoutingPoliciesForAPIKey(ctx, key, "model")
