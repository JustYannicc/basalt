diff --git a/internal/home/account_selection.go b/internal/home/account_selection.go
new file mode 100644
--- /dev/null
+++ b/internal/home/account_selection.go
@@ -0,0 +1,29 @@
+package home
+
+import (
+	"context"
+	"time"
+
+	coreauth "github.com/router-for-me/CLIProxyAPIHome/internal/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPIHome/internal/logging"
+	log "github.com/sirupsen/logrus"
+)
+
+func recordAccountSelection(ctx context.Context, credential string, selection *coreauth.AccountSelection) {
+	if selection == nil {
+		return
+	}
+	fields := log.Fields{
+		"account_selection_policy": selection.Policy,
+		"account_selection_reason": selection.Reason,
+		"credential_id":            credential,
+		"request_id":               logging.GetRequestID(ctx),
+	}
+	if selection.PlanFunded {
+		if rank, ok := selection.Ranks[credential]; ok {
+			fields["quota_window_id"] = rank.WindowID
+			fields["quota_reset_at"] = rank.ResetAt.UTC().Format(time.RFC3339Nano)
+		}
+	}
+	log.WithFields(fields).Info("pool account selected")
+}
