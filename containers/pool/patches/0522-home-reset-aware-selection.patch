@@ -0,0 +1,97 @@
+package cluster
+
+import (
+	"context"
+	"time"
+
+	coreauth "github.com/router-for-me/CLIProxyAPIHome/internal/cliproxy/auth"
+)
+
+func (r *Repository) accountRoutingPoliciesForAPIKey(ctx context.Context, apiKey, model string) (string, string, error) {
+	db, errDB := r.database()
+	if errDB != nil {
+		return "", "", errDB
+	}
+	key, errKey := r.findAPIKeyForAccess(ctx, db, apiKey)
+	if errKey != nil {
+		return "", "", errKey
+	}
+	channels, errChannels := apiKeyChannelsFromJSON(key.Channels)
+	if errChannels != nil {
+		return "", "", errChannels
+	}
+	modelDetails, _, errDetails := allowedModelGroupDetailsForAPIKeyRecord(ctx, db, &key)
+	if errDetails != nil {
+		return "", "", errDetails
+	}
+	modelChannels, restricted, errModel := modelChannelGroupIDsFromDetails(modelDetails, model)
+	if errModel != nil {
+		return "", "", errModel
+	}
+	if restricted {
+		channels = append(channels, modelChannels...)
+	}
+	credits, selection := "last_resort", "reset_aware"
+	if len(channels) == 0 {
+		return credits, selection, nil
+	}
+	var groups []ChannelGroupRecord
+	if errGroups := db.WithContext(ctx).Where("id IN ? AND disabled = ?", channels, false).Find(&groups).Error; errGroups != nil {
+		return "", "", errGroups
+	}
+	for _, group := range groups {
+		if group.UsageCreditPolicy != "" && group.UsageCreditPolicy != "last_resort" {
+			credits = "never"
+		}
+		policy, errPolicy := NormalizeAccountSelectionPolicy(group.AccountSelectionPolicy)
+		if errPolicy != nil {
+			return "", "", errPolicy
+		}
+		if policy == "balanced" {
+			selection = policy
+		}
+	}
+	return credits, selection, nil
+}
+
+func (a *RuntimeAdapter) UsageCreditRoutingForAPIKey(ctx context.Context, apiKey, model string, models map[string]string) (map[string]int, coreauth.AccountSelection, error) {
+	selection := coreauth.AccountSelection{}
+	policy, ordering, errPolicy := a.repo.accountRoutingPoliciesForAPIKey(ctx, apiKey, model)
+	if errPolicy != nil {
+		return nil, selection, errPolicy
+	}
+	selected := make(map[string]struct{}, len(models))
+	for id := range models {
+		selected[id] = struct{}{}
+	}
+	now := time.Now().UTC()
+	items, errItems := a.repo.loadFundingCredentials(ctx, now, selected)
+	if errItems != nil {
+		return nil, selection, errItems
+	}
+	selection.Policy = ordering
+	selection.Ranks = make(map[string]coreauth.QuotaResetRank, len(items))
+	tiers := make(map[string]int, len(models))
+	for _, item := range items {
+		tier := usageCreditFundingTier(item, models[item.CredentialID], now)
+		if policy == "never" && tier > 0 {
+			tier = 3
+		}
+		tiers[item.CredentialID] = tier
+		if tier == 0 {
+			if rank, ok := quotaSelectionRank(item, models[item.CredentialID], now); ok {
+				selection.Ranks[item.CredentialID] = rank
+			}
+		}
+	}
+	for id := range models {
+		if _, ok := tiers[id]; !ok {
+			if policy == "never" {
+				tiers[id] = 3
+			} else {
+				tiers[id] = 2
+			}
+		}
+	}
+	return tiers, selection, nil
+}
