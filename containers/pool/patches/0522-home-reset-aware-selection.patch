@@ -0,0 +1,143 @@
+package home
+
+import (
+	"context"
+	"net/http"
+	"reflect"
+	"testing"
+	"time"
+
+	log "github.com/sirupsen/logrus"
+
+	coreauth "github.com/router-for-me/CLIProxyAPIHome/internal/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPIHome/internal/registry"
+)
+
+type selectionStore struct {
+	ClusterAdapter
+	tiers     map[string]int
+	selection coreauth.AccountSelection
+}
+
+func (s *selectionStore) UsageCreditRoutingForAPIKey(context.Context, string, string, map[string]string) (map[string]int, coreauth.AccountSelection, error) {
+	return s.tiers, s.selection, nil
+}
+
+type selectionReceiptHook struct{ entries []log.Fields }
+
+func (h *selectionReceiptHook) Levels() []log.Level { return log.AllLevels }
+func (h *selectionReceiptHook) Fire(entry *log.Entry) error {
+	if entry.Message == "pool account selected" {
+		h.entries = append(h.entries, entry.Data)
+	}
+	return nil
+}
+
+type selectionAdmissionFull struct{}
+
+func (selectionAdmissionFull) Error() string           { return "synthetic account full" }
+func (selectionAdmissionFull) ConcurrencyType() string { return "credential_concurrency_exceeded" }
+
+func TestAccountSelectionRechecksAdmissionAndKeepsCreditsLast(t *testing.T) {
+	hook := &selectionReceiptHook{}
+	logger := log.StandardLogger()
+	oldHooks := logger.ReplaceHooks(make(log.LevelHooks))
+	logger.AddHook(hook)
+	t.Cleanup(func() { logger.ReplaceHooks(oldHooks) })
+	now := time.Now()
+	store := &selectionStore{tiers: map[string]int{"plan-a": 0, "plan-b": 0, "credits": 1}, selection: coreauth.AccountSelection{Policy: "reset_aware", Ranks: map[string]coreauth.QuotaResetRank{
+		"plan-a":  {ResetAt: now.Add(4 * time.Hour), ExpiresAt: now.Add(time.Minute), Headroom: .6},
+		"plan-b":  {ResetAt: now.Add(time.Hour), ExpiresAt: now.Add(time.Minute), Headroom: .6},
+		"credits": {ResetAt: now.Add(time.Second), ExpiresAt: now.Add(time.Minute), Headroom: .6},
+	}}}
+	manager := coreauth.NewManager(nil, &coreauth.RoundRobinSelector{}, nil)
+	for _, id := range []string{"plan-a", "plan-b", "credits"} {
+		auth := &coreauth.Auth{ID: id, Provider: "codex", Status: coreauth.StatusActive, Attributes: map[string]string{"auth_kind": "oauth"}}
+		registry.GetGlobalRegistry().RegisterClient(id, "codex", []*registry.ModelInfo{{ID: "gpt"}})
+		t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(id) })
+		if _, errRegister := manager.Register(t.Context(), auth); errRegister != nil {
+			t.Fatal(errRegister)
+		}
+	}
+	runtime := &Runtime{coreManager: manager, clusterAdapter: store}
+	var attempted []string
+	runtime.SetConcurrencyAdmitter(ConcurrencyAdmitterFunc(func(_ context.Context, request ConcurrencyAdmissionRequest) (ConcurrencyAdmissionResult, error) {
+		attempted = append(attempted, request.CredentialID)
+		if request.CredentialID == "plan-b" {
+			return ConcurrencyAdmissionResult{}, selectionAdmissionFull{}
+		}
+		return ConcurrencyAdmissionResult{CredentialID: request.CredentialID, Model: request.Model}, nil
+	}))
+	result, errDispatch := runtime.DispatchForAPIKeyWithConcurrency(t.Context(), "gpt", nil, "synthetic-pool-key", "", nil, "", DispatchConcurrencyContext{})
+	if errDispatch != nil || result.AuthID != "plan-a" || !reflect.DeepEqual(attempted, []string{"plan-b", "plan-a"}) {
+		t.Fatalf("admission attempts=%v result=%v error=%v", attempted, result, errDispatch)
+	}
+	store.tiers["plan-a"], store.tiers["plan-b"] = 3, 3
+	result, errDispatch = runtime.DispatchForAPIKeyWithConcurrency(t.Context(), "gpt", nil, "synthetic-pool-key", "", nil, "", DispatchConcurrencyContext{})
+	if errDispatch != nil || result.AuthID != "credits" {
+		t.Fatal("credits unavailable after plans exhausted", errDispatch)
+	}
+	store.selection.Policy = "balanced"
+	result, errDispatch = runtime.DispatchForAPIKeyWithConcurrency(t.Context(), "gpt", nil, "synthetic-pool-key", "", nil, "", DispatchConcurrencyContext{})
+	if errDispatch != nil || result.AuthID != "credits" {
+		t.Fatal("balanced changed funding priority", errDispatch)
+	}
+	if len(hook.entries) != 3 {
+		t.Fatalf("want one receipt per successful admission: %v", hook.entries)
+	}
+	for _, fields := range hook.entries {
+		for key := range fields {
+			switch key {
+			case "account_selection_policy", "account_selection_reason", "credential_id", "request_id", "quota_window_id", "quota_reset_at":
+			default:
+				t.Fatalf("unexpected receipt field %s", key)
+			}
+		}
+		if fields["credential_id"] == "plan-b" {
+			t.Fatal("refused admission emitted a selection receipt")
+		}
+	}
+	if hook.entries[0]["account_selection_reason"] != "reset_deadline" || hook.entries[0]["credential_id"] != "plan-a" {
+		t.Fatal("successful fallback receipt has wrong reason or account", hook.entries[0])
+	}
+}
+
+func TestAccountSelectionPublicDispatchPreservesEligibleStickyAndPinned(t *testing.T) {
+	now := time.Now()
+	selector := coreauth.NewSessionAffinitySelectorWithConfig(coreauth.SessionAffinityConfig{Fallback: &coreauth.RoundRobinSelector{}})
+	t.Cleanup(selector.Stop)
+	manager := coreauth.NewManager(nil, selector, nil)
+	store := &selectionStore{tiers: map[string]int{"sticky-a": 0, "sticky-b": 0}, selection: coreauth.AccountSelection{Policy: "reset_aware", Ranks: map[string]coreauth.QuotaResetRank{
+		"sticky-a": {ResetAt: now.Add(time.Hour), ExpiresAt: now.Add(time.Minute), Headroom: .5},
+		"sticky-b": {ResetAt: now.Add(2 * time.Hour), ExpiresAt: now.Add(time.Minute), Headroom: .5},
+	}}}
+	for _, id := range []string{"sticky-a", "sticky-b"} {
+		registry.GetGlobalRegistry().RegisterClient(id, "codex", []*registry.ModelInfo{{ID: "gpt"}})
+		t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(id) })
+		if _, errRegister := manager.Register(t.Context(), &coreauth.Auth{ID: id, Provider: "codex", Status: coreauth.StatusActive, Attributes: map[string]string{"auth_kind": "oauth"}}); errRegister != nil {
+			t.Fatal(errRegister)
+		}
+	}
+	runtime := &Runtime{coreManager: manager, clusterAdapter: store}
+	headers := http.Header{"X-Session-Id": []string{"synthetic-existing"}}
+	first, errFirst := runtime.DispatchForAPIKeyWithConcurrency(t.Context(), "gpt", headers, "synthetic-pool-key", "", nil, "", DispatchConcurrencyContext{})
+	if errFirst != nil || first.AuthID != "sticky-a" {
+		t.Fatal("initial selection failed", errFirst)
+	}
+	rank := store.selection.Ranks["sticky-b"]
+	rank.ResetAt = now.Add(30 * time.Minute)
+	store.selection.Ranks["sticky-b"] = rank
+	second, errSecond := runtime.DispatchForAPIKeyWithConcurrency(t.Context(), "gpt", headers, "synthetic-pool-key", "", nil, "", DispatchConcurrencyContext{})
+	if errSecond != nil || second.AuthID != "sticky-a" {
+		t.Fatal("existing sticky account moved", errSecond)
+	}
+	pinned, errPinned := runtime.DispatchForAPIKeyWithConcurrency(t.Context(), "gpt", nil, "synthetic-pool-key", "", nil, "sticky-a", DispatchConcurrencyContext{FundingCheck: true})
+	if errPinned != nil || pinned.AuthID != "sticky-a" || pinned.Concurrency.Accounted {
+		t.Fatal("retained funding check moved or readmitted", errPinned)
+	}
+	headers.Set("X-Session-Id", "synthetic-new")
+	third, errThird := runtime.DispatchForAPIKeyWithConcurrency(t.Context(), "gpt", headers, "synthetic-pool-key", "", nil, "", DispatchConcurrencyContext{})
+	if errThird != nil || third.AuthID != "sticky-b" {
+		t.Fatal("new session did not use earlier reset", errThird)
+	}
+}
