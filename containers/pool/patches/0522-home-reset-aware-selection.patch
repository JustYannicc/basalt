+package cluster
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"path/filepath"
+	"testing"
+)
+
+func TestAccountSelectionRestoresPreV15Snapshots(t *testing.T) {
+	for _, version := range []int{13, 14, 15} {
+		t.Run(fmt.Sprintf("v%d", version), func(t *testing.T) {
+			ctx := t.Context()
+			source := openDatabaseSnapshotSQLiteTestDB(t, filepath.Join(t.TempDir(), "source.db"))
+			group := ChannelGroupRecord{ID: 47, ChannelName: "retained-pool", Disabled: true, UsageCreditPolicy: "never", AccountSelectionPolicy: "balanced"}
+			if err := source.Create(&group).Error; err != nil {
+				t.Fatal(err)
+			}
+			current := filepath.Join(t.TempDir(), "current.zip")
+			if _, err := exportDatabaseSnapshotVersion(ctx, source, current, currentDatabaseVersion); err != nil {
+				t.Fatal(err)
+			}
+			input := current
+			if version < 15 {
+				legacyRows := filepath.Join(t.TempDir(), "old-rows.zip")
+				// The old exporter did not have the added column. Keep every other field
+				// and the real archive checksum/row-count validation intact.
+				rewriteDatabaseSnapshotTable(t, current, legacyRows, "channel_group", func(raw []byte) []byte {
+					var output bytes.Buffer
+					for _, line := range bytes.Split(bytes.TrimSpace(raw), []byte{'\n'}) {
+						var record map[string]json.RawMessage
+						if err := json.Unmarshal(line, &record); err != nil {
+							t.Fatal(err)
+						}
+						delete(record, "AccountSelectionPolicy")
+						encoded, err := json.Marshal(record)
+						if err != nil {
+							t.Fatal(err)
+						}
+						output.Write(encoded)
+						output.WriteByte('\n')
+					}
+					return output.Bytes()
+				})
+				input = filepath.Join(t.TempDir(), "legacy.zip")
+				rewriteDatabaseSnapshotZIP(t, legacyRows, input, func(name string, raw []byte) []byte {
+					if name != databaseSnapshotManifestName {
+						return raw
+					}
+					var manifest DatabaseSnapshotManifest
+					if err := json.Unmarshal(raw, &manifest); err != nil {
+						t.Fatal(err)
+					}
+					manifest.FormatVersion = version
+					encoded, err := json.Marshal(manifest)
+					if err != nil {
+						t.Fatal(err)
+					}
+					return encoded
+				}, "")
+			}
+			snapshot, err := OpenDatabaseSnapshot(ctx, input)
+			if err != nil {
+				t.Fatal("open portable snapshot", err)
+			}
+			defer snapshot.Close()
+			target := openDatabaseSnapshotSQLiteRawTestDB(t, filepath.Join(t.TempDir(), "target.db"))
+			if _, err := ImportDatabaseSnapshot(ctx, target, snapshot, nil); err != nil {
+				t.Fatal("restore portable snapshot", err)
+			}
+			repo := NewRepository(target)
+			expected := "reset_aware"
+			if version == 15 {
+				expected = "balanced"
+			}
+			for range 2 {
+				if err := AutoMigrateContext(ctx, target); err != nil {
+					t.Fatal(err)
+				}
+				restored, err := repo.GetChannelGroup(ctx, 47)
+				if err != nil || restored.ChannelName != group.ChannelName || !restored.Disabled || restored.UsageCreditPolicy != "never" || restored.AccountSelectionPolicy != expected {
+					t.Fatalf("restored=%+v error=%v", restored, err)
+				}
+			}
+		})
+	}
+}
