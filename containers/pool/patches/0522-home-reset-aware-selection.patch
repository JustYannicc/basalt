+package cluster
+
+import (
+	"context"
+	"os"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"gorm.io/driver/postgres"
+	"gorm.io/gorm"
+)
+
+func TestAccountSelectionPostgresV14ToV15RetainsRowsAndChoice(t *testing.T) {
+	dsn := strings.TrimSpace(os.Getenv("CLIPROXY_HOME_TEST_POSTGRES_DSN"))
+	if dsn == "" {
+		t.Skip("CLIPROXY_HOME_TEST_POSTGRES_DSN is not configured")
+	}
+	admin, errOpen := gorm.Open(postgres.Open(dsn), databaseGORMConfig(defaultDatabaseSlowQueryThreshold))
+	if errOpen != nil {
+		t.Fatal(errOpen)
+	}
+	adminSQL, errSQL := admin.DB()
+	if errSQL != nil {
+		t.Fatal(errSQL)
+	}
+	t.Cleanup(func() { _ = adminSQL.Close() })
+	schema := "account_selection_" + strconv.FormatInt(time.Now().UnixNano(), 10)
+	if errCreate := admin.Exec("CREATE SCHEMA " + schema).Error; errCreate != nil {
+		t.Fatal(errCreate)
+	}
+	t.Cleanup(func() {
+		if errDrop := admin.Exec("DROP SCHEMA " + schema + " CASCADE").Error; errDrop != nil {
+			t.Error(errDrop)
+		}
+	})
+	db, errSchema := gorm.Open(postgres.Open(postgresDSNWithSearchPath(dsn, schema)), databaseGORMConfig(defaultDatabaseSlowQueryThreshold))
+	if errSchema != nil {
+		t.Fatal(errSchema)
+	}
+	sqlDB, errDB := db.DB()
+	if errDB != nil {
+		t.Fatal(errDB)
+	}
+	t.Cleanup(func() { _ = sqlDB.Close() })
+	if errMigrate := AutoMigrateContext(t.Context(), db); errMigrate != nil {
+		t.Fatal(errMigrate)
+	}
+	repo := NewRepository(db)
+	seedQuotaSnapshotAuth(t, repo, "retained-selection-account", "claude", "synthetic", map[string]any{"type": "claude", "auth_kind": "oauth"})
+	for _, statement := range []string{
+		"ALTER TABLE channel_group DROP COLUMN account_selection_policy",
+		"UPDATE home_schema_migration SET version = 14",
+		"INSERT INTO channel_group (id,channel_name,disabled,usage_credit_policy) VALUES (47,'retained-pool',false,'never'), (48,'disabled-pool',true,'last_resort')",
+		"INSERT INTO channel_group_detail (channel_group_id,auth_id) VALUES (47,'retained-selection-account')",
+		"INSERT INTO quota_snapshot (credential_id,quota_status,collection_status,source,plan_name,reset_credits,usage_credits) VALUES ('retained-selection-account','healthy','success','active_probe','synthetic-plan','{\"available_count\":3}','{\"state\":\"disabled\"}')",
+	} {
+		if errStatement := db.Exec(statement).Error; errStatement != nil {
+			t.Fatal(errStatement)
+		}
+	}
+	if errMigrate := AutoMigrateContext(context.Background(), db); errMigrate != nil {
+		t.Fatal(errMigrate)
+	}
+	assertPostgresSchemaMigrationVersion(t, db, 15)
+	for id, disabled := range map[uint]bool{47: false, 48: true} {
+		group, errRead := repo.GetChannelGroup(t.Context(), id)
+		if errRead != nil || group.Disabled != disabled || group.AccountSelectionPolicy != "reset_aware" {
+			t.Fatalf("retained group %d=%v error=%v", id, group, errRead)
+		}
+		if id == 47 && (group.ChannelName != "retained-pool" || group.UsageCreditPolicy != "never") {
+			t.Fatal("retained credit policy or name changed")
+		}
+	}
+	var snapshot QuotaSnapshotRecord
+	if errRead := db.Where("credential_id = ?", "retained-selection-account").First(&snapshot).Error; errRead != nil {
+		t.Fatal(errRead)
+	}
+	if snapshot.PlanName != "synthetic-plan" || !strings.Contains(string(snapshot.ResetCredits), "3") || string(snapshot.UsageCredits) != `{"state": "disabled"}` && string(snapshot.UsageCredits) != `{"state":"disabled"}` {
+		t.Fatal("retained quota/credit/reset data changed")
+	}
+	var count int64
+	if errCount := db.Model(&ChannelGroupDetailRecord{}).Where("channel_group_id = ? AND auth_id = ?", 47, "retained-selection-account").Count(&count).Error; errCount != nil || count != 1 {
+		t.Fatal("membership changed", errCount)
+	}
+	choice := "balanced"
+	if _, errUpdate := repo.UpdateChannelGroup(t.Context(), 47, ChannelGroupUpdate{AccountSelectionPolicy: &choice}); errUpdate != nil {
+		t.Fatal(errUpdate)
+	}
+	for range 2 {
+		if errMigrate := AutoMigrateContext(t.Context(), db); errMigrate != nil {
+			t.Fatal("repeated boot", errMigrate)
+		}
+		group, errRead := repo.GetChannelGroup(t.Context(), 47)
+		if errRead != nil || group.AccountSelectionPolicy != "balanced" || group.UsageCreditPolicy != "never" {
+			t.Fatal("repeated boot reset saved choice", errRead)
+		}
+	}
+	// Existing servers update their known fields without deleting the added policy.
+	if errOldWrite := db.Model(&ChannelGroupRecord{}).Where("id = ?", 47).Update("channel_name", "old-server-write").Error; errOldWrite != nil {
+		t.Fatal(errOldWrite)
+	}
+	group, errRead := repo.GetChannelGroup(t.Context(), 47)
+	if errRead != nil || group.AccountSelectionPolicy != "balanced" {
+		t.Fatal("existing field write lost policy", errRead)
+	}
+}
diff --git a/internal/cluster/account_selection_snapshot.go b/internal/cluster/account_selection_snapshot.go
new file mode 100644
--- /dev/null
+++ b/internal/cluster/account_selection_snapshot.go
@@ -0,0 +1,32 @@
+package cluster
+
+import (
+	"gorm.io/gorm"
+	"time"
+)
+
+// Pre-v15 archives omit the new non-null column. Restoring their frozen shape
+// lets the migrated database apply its reset-aware default to those rows.
+type databaseSnapshotV14ChannelGroupRecord struct {
+	UsageCreditPolicy string         `gorm:"column:usage_credit_policy;not null;default:last_resort;size:16"`
+	ID                uint           `gorm:"column:id;primaryKey;autoIncrement;index:idx_channel_group_active_order,priority:2;index:idx_channel_group_enabled_order,priority:3"`
+	ChannelName       string         `gorm:"column:channel_name;not null"`
+	Disabled          bool           `gorm:"column:disabled;not null;default:false;index:idx_channel_group_enabled_order,priority:2"`
+	CreatedAt         time.Time      `gorm:"column:created_at"`
+	UpdatedAt         time.Time      `gorm:"column:updated_at"`
+	DeletedAt         gorm.DeletedAt `gorm:"column:deleted_at;index;index:idx_channel_group_active_order,priority:1;index:idx_channel_group_enabled_order,priority:1"`
+}
+
+func (databaseSnapshotV14ChannelGroupRecord) TableName() string { return "channel_group" }
+
+func databaseSnapshotV14ModelRegistry() []databaseModel {
+	models := currentDatabaseModels()
+	for index := range models {
+		if models[index].name == "channel_group" {
+			models[index] = newDatabaseModel[databaseSnapshotV14ChannelGroupRecord]("channel_group", []string{"id"}, true, true)
+		}
+	}
+	return models
+}
+
+var databaseSnapshotV14Models = databaseSnapshotV14ModelRegistry()
