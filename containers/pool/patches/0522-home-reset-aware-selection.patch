+func TestQuotaResetOrderingAndBalancedFallback(t *testing.T) {
+	now := time.Now()
+	accounts := []*Auth{{ID: "a", Status: StatusActive}, {ID: "b", Status: StatusActive}, {ID: "c", Status: StatusActive}}
+	ranks := func() map[string]QuotaResetRank {
+		return map[string]QuotaResetRank{
+			"a": {ResetAt: now.Add(4 * time.Hour), ExpiresAt: now.Add(time.Minute), Headroom: .8, WindowID: "weekly"},
+			"b": {ResetAt: now.Add(time.Hour), ExpiresAt: now.Add(time.Minute), Headroom: .8, WindowID: "weekly"},
+			"c": {ResetAt: now.Add(time.Hour), ExpiresAt: now.Add(time.Minute), Headroom: .4, WindowID: "weekly"},
+		}
+	}
+	for _, test := range []struct {
+		name   string
+		change func(*AccountSelection)
+		want   string
+	}{
+		{"earliest-weekly-then-headroom", func(*AccountSelection) {}, "c"},
+		{"balanced", func(s *AccountSelection) { s.Policy = "balanced" }, "a"},
+		{"credits-retain-order", func(s *AccountSelection) { s.PlanFunded = false }, "a"},
+		{"unknown", func(s *AccountSelection) { delete(s.Ranks, "a") }, "a"},
+		{"stale", func(s *AccountSelection) { r := s.Ranks["a"]; r.ExpiresAt = now.Add(-time.Second); s.Ranks["a"] = r }, "a"},
+		{"reset-already-passed", func(s *AccountSelection) { r := s.Ranks["a"]; r.ResetAt = now.Add(-time.Second); s.Ranks["a"] = r }, "a"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			selection := &AccountSelection{Policy: "reset_aware", PlanFunded: true, Ranks: ranks()}
+			test.change(selection)
+			picked, errPick := (&RoundRobinSelector{}).Pick(t.Context(), "claude", "opus", Options{AccountSelection: selection}, accounts)
+			if errPick != nil || picked.ID != test.want {
+				t.Fatalf("picked=%v error=%v, want %s", picked, errPick, test.want)
+			}
+		})
+	}
+}
+
+func TestQuotaResetOrderingKeepsAffinityAndAdmissionCandidate(t *testing.T) {
+	now := time.Now()
+	selection := &AccountSelection{Policy: "reset_aware", PlanFunded: true, Ranks: map[string]QuotaResetRank{
+		"a": {ResetAt: now.Add(time.Hour), ExpiresAt: now.Add(time.Minute), Headroom: .5},
+		"b": {ResetAt: now.Add(2 * time.Hour), ExpiresAt: now.Add(time.Minute), Headroom: .5},
+	}}
+	selector := NewSessionAffinitySelectorWithConfig(SessionAffinityConfig{Fallback: &RoundRobinSelector{}})
+	t.Cleanup(selector.Stop)
+	accounts := []*Auth{{ID: "a", Status: StatusActive}, {ID: "b", Status: StatusActive}}
+	opts := Options{AccountSelection: selection, Headers: http.Header{"X-Session-Id": []string{"synthetic-sticky"}}}
+	first, errFirst := selector.Pick(context.Background(), "claude", "opus", opts, accounts)
+	if errFirst != nil || first.ID != "a" {
+		t.Fatalf("first=%v error=%v", first, errFirst)
+	}
+	rank := selection.Ranks["b"]
+	rank.ResetAt = now.Add(30 * time.Minute)
+	selection.Ranks["b"] = rank
+	second, errSecond := selector.Pick(context.Background(), "claude", "opus", opts, accounts)
+	if errSecond != nil || second.ID != "a" {
+		t.Fatalf("sticky account moved: %v error=%v", second, errSecond)
+	}
+	opts.Headers.Set("X-Session-Id", "synthetic-new-session")
+	opts.SessionAffinity = &SessionAffinitySelection{}
+	third, errThird := selector.Pick(context.Background(), "claude", "opus", opts, accounts)
+	if errThird != nil || third.ID != "b" || opts.SessionAffinity.Commit == nil || opts.SessionAffinity.Commit.AuthID != "b" {
+		t.Fatalf("new session did not propose earliest account for atomic admission: %v error=%v", third, errThird)
+	}
+}
+
+func TestQuotaResetOrderingRespectsExistingSelectorsAndPriority(t *testing.T) {
+	for name, newSelector := range map[string]func() Selector{
+		"round-robin": func() Selector { return &RoundRobinSelector{} },
+		"fill-first":  func() Selector { return &FillFirstSelector{} },
+		"weighted":    func() Selector { return &WeightedRoundRobinSelector{} },
+	} {
+		t.Run(name, func(t *testing.T) {
+			now := time.Now()
+			ranks := map[string]QuotaResetRank{
+				"a": {ResetAt: now.Add(time.Hour), ExpiresAt: now.Add(time.Minute), Headroom: .5},
+				"b": {ResetAt: now.Add(2 * time.Hour), ExpiresAt: now.Add(time.Minute), Headroom: .5},
+			}
+			accounts := []*Auth{{ID: "a", Status: StatusActive, Attributes: map[string]string{"weight": "1"}}, {ID: "b", Status: StatusActive, Attributes: map[string]string{"weight": "4"}}}
+			selection := &AccountSelection{Policy: "reset_aware", PlanFunded: true, Ranks: ranks}
+			picked, errPick := newSelector().Pick(t.Context(), "claude", "opus", Options{AccountSelection: selection}, accounts)
+			if errPick != nil || picked.ID != "a" {
+				t.Fatalf("reset selection: %v %v", picked, errPick)
+			}
+			accounts[1].Attributes["priority"] = "10"
+			picked, errPick = newSelector().Pick(t.Context(), "claude", "opus", Options{AccountSelection: selection}, accounts)
+			if errPick != nil || picked.ID != "b" {
+				t.Fatalf("priority overridden: %v %v", picked, errPick)
+			}
+			delete(accounts[1].Attributes, "priority")
+			rank := ranks["b"]
+			rank.ResetAt = ranks["a"].ResetAt
+			ranks["b"] = rank
+			withPolicy, withoutPolicy := newSelector(), newSelector()
+			for index := 0; index < 12; index++ {
+				got, errGot := withPolicy.Pick(t.Context(), "claude", "opus", Options{AccountSelection: selection}, accounts)
+				want, errWant := withoutPolicy.Pick(t.Context(), "claude", "opus", Options{}, accounts)
+				if errGot != nil || errWant != nil || got.ID != want.ID {
+					t.Fatalf("tied reset changed selector at %d: got=%v want=%v errors=%v %v", index, got, want, errGot, errWant)
+				}
+			}
+		})
+	}
+}
+
+func TestQuotaResetOrderingPreservesParentAffinity(t *testing.T) {
+	now := time.Now()
+	selection := &AccountSelection{Policy: "reset_aware", PlanFunded: true, Ranks: map[string]QuotaResetRank{
+		"a": {ResetAt: now.Add(time.Hour), ExpiresAt: now.Add(time.Minute), Headroom: .5},
+		"b": {ResetAt: now.Add(2 * time.Hour), ExpiresAt: now.Add(time.Minute), Headroom: .5},
+	}}
+	selector := NewSessionAffinitySelectorWithConfig(SessionAffinityConfig{Fallback: &RoundRobinSelector{}})
+	t.Cleanup(selector.Stop)
+	accounts := []*Auth{{ID: "a", Status: StatusActive}, {ID: "b", Status: StatusActive}}
+	opts := Options{AccountSelection: selection, Headers: http.Header{"X-Session-Id": []string{"synthetic-parent"}}}
+	first, errFirst := selector.Pick(t.Context(), "claude", "opus", opts, accounts)
+	if errFirst != nil || first.ID != "a" {
+		t.Fatal(first, errFirst)
+	}
+	rank := selection.Ranks["b"]
+	rank.ResetAt = now.Add(30 * time.Minute)
+	selection.Ranks["b"] = rank
+	opts.Headers.Set("X-Session-Id", "synthetic-child")
+	opts.Headers.Set("X-Parent-Session-Id", "synthetic-parent")
+	child, errChild := selector.Pick(t.Context(), "claude", "opus", opts, accounts)
+	if errChild != nil || child.ID != "a" || selection.Reason != "parent_affinity" {
+		t.Fatalf("parent moved: %v %v reason=%s", child, errChild, selection.Reason)
+	}
+}
