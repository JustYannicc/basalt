--- /dev/null
+++ b/internal/cliproxy/auth/quota_selection.go
@@ -0,0 +1,59 @@
+package auth
+
+import (
+	"math"
+	"time"
+)
+
+type QuotaResetRank struct {
+	ResetAt   time.Time
+	ExpiresAt time.Time
+	Headroom  float64
+	WindowID  string
+}
+
+// AccountSelection is request-owned. The funding read fills it before selection;
+// affinity bypasses ordering when its existing binding remains eligible.
+type AccountSelection struct {
+	Policy     string
+	PlanFunded bool
+	Ranks      map[string]QuotaResetRank
+	Reason     string
+}
+
+func quotaOrderedCandidates(available []*Auth, selection *AccountSelection, now time.Time) []*Auth {
+	if selection == nil {
+		return available
+	}
+	if selection.Reason == "pinned" {
+		return available
+	}
+	selection.Reason = "balanced"
+	if selection.Policy != "reset_aware" {
+		return available
+	}
+	selection.Reason = "funding_fallback"
+	if !selection.PlanFunded {
+		return available
+	}
+	selection.Reason = "reset_unknown"
+	var best QuotaResetRank
+	for _, candidate := range available {
+		rank, ok := selection.Ranks[candidate.ID]
+		if !ok || !rank.ResetAt.After(now) || !rank.ExpiresAt.After(now) || rank.Headroom <= 0 || rank.Headroom > 1 || math.IsNaN(rank.Headroom) || math.IsInf(rank.Headroom, 0) {
+			return available
+		}
+		if best.ResetAt.IsZero() || rank.ResetAt.Before(best.ResetAt) || rank.ResetAt.Equal(best.ResetAt) && rank.Headroom < best.Headroom {
+			best = rank
+		}
+	}
+	selected := make([]*Auth, 0, len(available))
+	for _, candidate := range available {
+		rank := selection.Ranks[candidate.ID]
+		if rank.ResetAt.Equal(best.ResetAt) && rank.Headroom == best.Headroom {
+			selected = append(selected, candidate)
+		}
+	}
+	selection.Reason = "reset_deadline"
+	return selected
+}
