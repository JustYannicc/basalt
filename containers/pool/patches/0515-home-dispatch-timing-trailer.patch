+// The opt-in array keeps the primary reply intact and appends timing after its real write.
+func (w *safeWriter) WriteTimingPrefix() error {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if w.w == nil {
+		return net.ErrClosed
+	}
+	if _, err := w.w.WriteString("*2\r\n"); err != nil {
+		return err
+	}
+	return w.w.Flush()
+}
