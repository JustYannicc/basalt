diff --git a/internal/respserver/basalt_timing_trailer_test.go b/internal/respserver/basalt_timing_trailer_test.go
new file mode 100644
--- /dev/null
+++ b/internal/respserver/basalt_timing_trailer_test.go
@@ -0,0 +1,87 @@
+package respserver
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPIHome/internal/cluster"
+	"github.com/router-for-me/CLIProxyAPIHome/internal/dispatchtiming"
+	"github.com/router-for-me/CLIProxyAPIHome/internal/respserver/dispatch"
+)
+
+func TestBasaltHomeDispatchTimingTrailerOptIn(t *testing.T) {
+	for _, optIn := range []bool{false, true} {
+		request := `{"type":"auth","dispatch_timing":false}`
+		if optIn {
+			request = `{"type":"auth","dispatch_timing":true}`
+		}
+		conn := &dispatchTimingConn{subscriptionTestConn: newSubscriptionTestConn("RPOP", request)}
+		server := New("", newSubscriptionTestRuntime(t, &blockingConfigAdapter{loadStarted: make(chan struct{})}))
+		server.registry = dispatch.NewRegistry()
+		server.SetClusterHandler(&blockingClusterHandler{lifetime: cluster.ConnectionLifetime{Fingerprint: peerCertificateFingerprint(conn), ConnectedAt: time.Now(), Controlled: true}})
+		calls := 0
+		if err := server.registry.RegisterDynamic("RPOP", "auth", func(ctx context.Context, _ dispatch.Env, _ []string) dispatch.Reply {
+			calls++
+			for _, stage := range []dispatchtiming.Stage{dispatchtiming.Authenticate, dispatchtiming.Selection, dispatchtiming.Admission} {
+				dispatchtiming.Observe(ctx, stage, time.Now(), nil)
+			}
+			return dispatch.BulkString([]byte("synthetic-primary"))
+		}); err != nil {
+			t.Fatal(err)
+		}
+		server.HandleConn(context.Background(), conn)
+		wire := conn.Output()
+		if calls != 1 {
+			t.Fatal("dispatch replayed")
+		}
+		if !optIn {
+			if wire != "$17\r\nsynthetic-primary\r\n" {
+				t.Fatalf("legacy reply changed: %q", wire)
+			}
+			continue
+		}
+		if !strings.HasPrefix(wire, "*2\r\n$17\r\nsynthetic-primary\r\n$") {
+			t.Fatalf("primary not preserved: %q", wire)
+		}
+		trailer := wire[strings.Index(wire, "[{\""):]
+		trailer = strings.TrimSuffix(trailer, "\r\n")
+		var metrics []dispatchtiming.Metric
+		if json.Unmarshal([]byte(trailer), &metrics) != nil || len(metrics) != 4 {
+			t.Fatalf("invalid trailer: %q", trailer)
+		}
+		for index, stage := range []dispatchtiming.Stage{dispatchtiming.Authenticate, dispatchtiming.Selection, dispatchtiming.Admission, dispatchtiming.ReplyWrite} {
+			if metrics[index].Stage != stage || metrics[index].Outcome != "ok" {
+				t.Fatalf("missing measured stage %s", stage)
+			}
+		}
+	}
+}
+
+type timingTrailerFailureWriter struct {
+	calls int
+	data  bytes.Buffer
+}
+
+func (w *timingTrailerFailureWriter) Write(p []byte) (int, error) {
+	w.calls++
+	// Prefix and primary succeed; the diagnostic trailer fails.
+	if w.calls == 3 {
+		return 0, errors.New("synthetic trailer failure")
+	}
+	return w.data.Write(p)
+}
+func TestBasaltHomeDispatchTimingTrailerFailureFences(t *testing.T) {
+	_, collector := dispatchtiming.WithCollector(context.Background())
+	fenced, closed := false, false
+	conn := &dispatch.ConnEnv{FenceFingerprint: func(context.Context, string) error { fenced = true; return nil }, CloseLocalFingerprint: func() { closed = true }}
+	writer := &timingTrailerFailureWriter{}
+	err := writeDispatchReplyWithFence(context.Background(), newSafeWriter(writer), dispatch.Reply{Kind: dispatch.ReplyKindBulkString, BulkString: []byte("synthetic-primary"), AccountedAdmission: true}, conn, true, collector)
+	if err == nil || !fenced || !closed {
+		t.Fatal("incomplete accounted response was not fenced")
+	}
+}
