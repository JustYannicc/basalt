@@ -0,0 +1,31 @@
+package dynamic
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPIHome/internal/dispatchtiming"
+)
+
+func TestBasaltHomeDispatchTimingTrailerRealDispatchStages(t *testing.T) {
+	for _, failure := range []bool{false, true} {
+		runtime, admitter := newConcurrencyDispatchRuntime(t, []string{"synthetic-credential"})
+		if failure {
+			admitter.SetResult("synthetic-credential", context.DeadlineExceeded)
+		}
+		ctx, collector := dispatchtiming.WithCollector(context.Background())
+		_ = handleAuth(ctx, protocolOneDispatchEnv(runtime, "synthetic-fingerprint"), []string{"RPOP", `{"type":"auth","model":"gpt","concurrency_protocol":1,"headers":{"x-api-key":"dispatch-client-key"}}`})
+		var metrics []dispatchtiming.Metric
+		if json.Unmarshal(collector.JSON(), &metrics) != nil || len(metrics) != 3 {
+			t.Fatalf("missing runtime stages: %s", collector.JSON())
+		}
+		want := "ok"
+		if failure {
+			want = "timeout"
+		}
+		if metrics[0].Stage != dispatchtiming.Authenticate || metrics[1].Stage != dispatchtiming.Selection || metrics[2].Stage != dispatchtiming.Admission || metrics[2].Outcome != want {
+			t.Fatalf("incorrect runtime timing: %s", collector.JSON())
+		}
+	}
+}
