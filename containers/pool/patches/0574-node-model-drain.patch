--- /dev/null
+++ b/sdk/api/handlers/openai/basalt_model_drain.go
@@ -0,0 +1,59 @@
+package openai
+
+import (
+	"encoding/binary"
+	"errors"
+	"github.com/gorilla/websocket"
+)
+
+const basaltModelDrainProtocol = "basalt.model-drain.v1"
+const basaltModelDrainBytes = 16 * 1024 * 1024
+
+// The private transport acknowledges an actual socket read, not inference success.
+func readBasaltModelDrain(conn *websocket.Conn, kind int, payload []byte, sequence *uint32) (int, []byte, error) {
+	if conn.Subprotocol() != basaltModelDrainProtocol {
+		return kind, payload, nil
+	}
+	if kind != websocket.BinaryMessage || len(payload) < 5 || len(payload) > basaltModelDrainBytes+5 || payload[0] > 1 {
+		return 0, nil, errors.New("invalid model consumer frame")
+	}
+	next := binary.BigEndian.Uint32(payload[1:5])
+	if next != *sequence+1 || next > 0x7fffffff {
+		return 0, nil, errors.New("invalid model consumer sequence")
+	}
+	*sequence = next
+	kind = websocket.TextMessage
+	if payload[0] == 1 {
+		kind = websocket.BinaryMessage
+	}
+	return kind, payload[5:], nil
+}
+
+func (w *responsesWebsocketWriter) acknowledgeBasaltModelDrain(sequence uint32, size int) error {
+	if w.conn.Subprotocol() != basaltModelDrainProtocol {
+		return nil
+	}
+	frame := make([]byte, 9)
+	frame[0] = 2
+	binary.BigEndian.PutUint32(frame[1:5], sequence)
+	binary.BigEndian.PutUint32(frame[5:9], uint32(size))
+	w.writeMu.Lock()
+	defer w.writeMu.Unlock()
+	if w.closing.Load() {
+		return websocket.ErrCloseSent
+	}
+	return w.conn.WriteMessage(websocket.BinaryMessage, frame)
+}
+
+// Caller owns writeMu, just as on the raw Responses transport.
+func (w *responsesWebsocketWriter) writeBasaltModelPayload(payload []byte) error {
+	if w.conn.Subprotocol() != basaltModelDrainProtocol {
+		return w.conn.WriteMessage(websocket.TextMessage, payload)
+	}
+	if len(payload) > basaltModelDrainBytes {
+		return errors.New("model consumer output exceeded")
+	}
+	frame := make([]byte, 1+len(payload))
+	copy(frame[1:], payload)
+	return w.conn.WriteMessage(websocket.BinaryMessage, frame)
+}
diff --git a/sdk/api/handlers/openai/basalt_model_drain_test.go b/sdk/api/handlers/openai/basalt_model_drain_test.go
