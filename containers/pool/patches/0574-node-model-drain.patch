index 0000000..15d7fc1
--- /dev/null
+++ b/sdk/api/handlers/openai/basalt_model_drain_test.go
@@ -0,0 +1,129 @@
+package openai
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"github.com/gorilla/websocket"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func basaltModelDrainPair(t *testing.T, protocol string) (*websocket.Conn, *websocket.Conn) {
+	t.Helper()
+	accepted := make(chan *websocket.Conn, 1)
+	closed := make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		upgrader := websocket.Upgrader{Subprotocols: []string{protocol}}
+		conn, err := upgrader.Upgrade(w, r, nil)
+		if err != nil {
+			return
+		}
+		accepted <- conn
+		<-closed
+		_ = conn.Close()
+	}))
+	dialer := websocket.Dialer{Subprotocols: []string{protocol}}
+	client, _, err := dialer.Dial("ws"+strings.TrimPrefix(server.URL, "http"), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	peer := <-accepted
+	t.Cleanup(func() { _ = client.Close(); close(closed); server.Close() })
+	return client, peer
+}
+
+func TestBasaltModelDrainReadCompletion(t *testing.T) {
+	client, peer := basaltModelDrainPair(t, basaltModelDrainProtocol)
+	ctx, cancel := context.WithCancelCause(context.Background())
+	defer cancel(nil)
+	var epoch atomic.Uint64
+	input, done := readResponsesWebsocketInput(ctx, cancel, peer, nil, newResponsesLocalInterrupt(), newResponsesWebsocketWriter(peer), nil, &epoch)
+	if cap(input) != 0 {
+		t.Fatal("private consumer must not retain a 16-message queue")
+	}
+	payload := []byte(`{"type":"response.create","model":"synthetic","input":[]}`)
+	frame := make([]byte, 5+len(payload))
+	binary.BigEndian.PutUint32(frame[1:5], 1)
+	copy(frame[5:], payload)
+	if err := client.WriteMessage(websocket.BinaryMessage, frame); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case item := <-input:
+		if !bytes.Equal(item.Payload, payload) {
+			t.Fatal("private envelope reached model input")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("consumer did not read the input")
+	}
+	_ = client.SetReadDeadline(time.Now().Add(time.Second))
+	kind, ack, err := client.ReadMessage()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if kind != websocket.BinaryMessage || len(ack) != 9 || ack[0] != 2 || binary.BigEndian.Uint32(ack[1:5]) != 1 || binary.BigEndian.Uint32(ack[5:9]) != uint32(len(payload)) {
+		t.Fatal("invalid read-completion receipt")
+	}
+	_ = client.Close()
+	<-done
+}
+
+func TestBasaltModelDrainRawTransportIsUnchanged(t *testing.T) {
+	client, peer := basaltModelDrainPair(t, "raw-fixture")
+	ctx, cancel := context.WithCancelCause(context.Background())
+	defer cancel(nil)
+	var epoch atomic.Uint64
+	writer := newResponsesWebsocketWriter(peer)
+	input, done := readResponsesWebsocketInput(ctx, cancel, peer, nil, newResponsesLocalInterrupt(), writer, nil, &epoch)
+	if cap(input) != 16 {
+		t.Fatal("raw queue changed")
+	}
+	payload := []byte(`{"type":"response.create","input":[]}`)
+	if err := client.WriteMessage(websocket.TextMessage, payload); err != nil {
+		t.Fatal(err)
+	}
+	if item := <-input; !bytes.Equal(item.Payload, payload) {
+		t.Fatal("raw input changed")
+	}
+	if err := writeResponsesWebsocketPayload(writer, nil, payload, time.Now()); err != nil {
+		t.Fatal(err)
+	}
+	kind, actual, err := client.ReadMessage()
+	if err != nil || kind != websocket.TextMessage || !bytes.Equal(actual, payload) {
+		t.Fatal("raw output or receipt behavior changed")
+	}
+	_ = client.Close()
+	<-done
+}
+
+func TestBasaltModelDrainOutputAndSequence(t *testing.T) {
+	client, peer := basaltModelDrainPair(t, basaltModelDrainProtocol)
+	writer := newResponsesWebsocketWriter(peer)
+	payload := []byte(`{"type":"response.completed"}`)
+	if err := writeResponsesWebsocketPayload(writer, nil, payload, time.Now()); err != nil {
+		t.Fatal(err)
+	}
+	kind, actual, err := client.ReadMessage()
+	if err != nil || kind != websocket.BinaryMessage || actual[0] != 0 || !bytes.Equal(actual[1:], payload) {
+		t.Fatal("private output framing changed model bytes")
+	}
+	var sequence uint32
+	frame := []byte{1, 0, 0, 0, 1, 0, 255}
+	originalKind, original, err := readBasaltModelDrain(peer, websocket.BinaryMessage, frame, &sequence)
+	if err != nil || originalKind != websocket.BinaryMessage || !bytes.Equal(original, frame[5:]) {
+		t.Fatal("binary model input changed")
+	}
+	if _, _, err := readBasaltModelDrain(peer, websocket.BinaryMessage, frame, &sequence); err == nil {
+		t.Fatal("duplicate sequence accepted")
+	}
+	for _, bad := range [][]byte{{}, {2, 0, 0, 0, 2}, {0, 0, 0, 0, 3}} {
+		if _, _, err := readBasaltModelDrain(peer, websocket.BinaryMessage, bad, &sequence); err == nil {
+			t.Fatal("invalid private frame accepted")
+		}
+	}
+}
