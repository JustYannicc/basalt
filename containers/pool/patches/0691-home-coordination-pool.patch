diff --git a/internal/cluster/coordination_pool_nodes_postgres_test.go b/internal/cluster/coordination_pool_nodes_postgres_test.go
new file mode 100644
index 0000000..0053cc9
--- /dev/null
+++ b/internal/cluster/coordination_pool_nodes_postgres_test.go
@@ -0,0 +1,233 @@
+package cluster_test
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPIHome/internal/cluster"
+	"github.com/router-for-me/CLIProxyAPIHome/internal/cluster/management"
+	"github.com/router-for-me/CLIProxyAPIHome/internal/config"
+	"gorm.io/driver/postgres"
+	"gorm.io/gorm"
+	"gorm.io/gorm/logger"
+)
+
+// readinessAuditTimeout is the pool supervisor's client timeout for GET /v8/management/nodes.
+const readinessAuditTimeout = 2 * time.Second
+
+const readinessAuditNodeID = "cpa-readiness"
+
+// newNodeListingFixture serves Home's node listing over a main pool of two connections, wired as
+// cmd/home does: through the coordination pool when coordinationConns is positive, else the main
+// pool. One live Home and one healthy CPA node are seeded on a fresh schema.
+func newNodeListingFixture(t *testing.T, coordinationConns int) (*gorm.DB, *httptest.Server) {
+	t.Helper()
+	dsn := strings.TrimSpace(os.Getenv("HOME_TEST_POSTGRES_DSN"))
+	if dsn == "" {
+		dsn = strings.TrimSpace(os.Getenv("CLIPROXY_HOME_TEST_POSTGRES_DSN"))
+	}
+	if dsn == "" {
+		t.Skip("HOME_TEST_POSTGRES_DSN is not configured")
+	}
+	adminDB, errAdmin := gorm.Open(postgres.Open(dsn), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	if errAdmin != nil {
+		t.Fatalf("open postgres admin database: %v", errAdmin)
+	}
+	adminSQLDB, errAdminSQL := adminDB.DB()
+	if errAdminSQL != nil {
+		t.Fatal(errAdminSQL)
+	}
+	schema := "coordination_nodes_" + strconv.FormatInt(time.Now().UnixNano(), 10)
+	if errCreate := adminDB.Exec("CREATE SCHEMA " + schema).Error; errCreate != nil {
+		t.Fatalf("create postgres schema: %v", errCreate)
+	}
+	mainConns := 2
+	cfg := cluster.PGSQLConfig{
+		PostgresURI:              dsnWithSearchPath(dsn, schema),
+		MaxOpenConns:             &mainConns,
+		CoordinationMaxOpenConns: coordinationConns,
+	}
+	mainDB, errOpen := cluster.Open(context.Background(), cfg)
+	if errOpen != nil {
+		t.Fatal(errOpen)
+	}
+	coordinationDB, errCoordination := cluster.OpenCoordination(context.Background(), cfg)
+	if errCoordination != nil {
+		t.Fatal(errCoordination)
+	}
+	t.Cleanup(func() {
+		for _, db := range []*gorm.DB{mainDB, coordinationDB} {
+			if db == nil {
+				continue
+			}
+			if sqlDB, errDB := db.DB(); errDB == nil {
+				if errClose := sqlDB.Close(); errClose != nil {
+					t.Errorf("close postgres database: %v", errClose)
+				}
+			}
+		}
+		if errDrop := adminDB.Exec("DROP SCHEMA " + schema + " CASCADE").Error; errDrop != nil {
+			t.Errorf("drop postgres schema: %v", errDrop)
+		}
+		if errClose := adminSQLDB.Close(); errClose != nil {
+			t.Errorf("close postgres admin database: %v", errClose)
+		}
+	})
+	if errMigrate := cluster.AutoMigrate(mainDB); errMigrate != nil {
+		t.Fatal(errMigrate)
+	}
+	seedReadinessAuditNode(t, mainDB)
+
+	repo := cluster.NewRepository(mainDB)
+	coordinationRepo := repo
+	if coordinationDB != nil {
+		coordinationRepo = cluster.NewRepository(coordinationDB)
+	}
+	handler := management.NewHandler(repo, nil, "127.0.0.1", 18317)
+	handler.SetLivenessRepository(coordinationRepo)
+	gin.SetMode(gin.TestMode)
+	engine := gin.New()
+	engine.GET("/v8/management/nodes", handler.ListNodes)
+	server := httptest.NewServer(engine)
+	t.Cleanup(server.Close)
+	return mainDB, server
+}
+
+func seedReadinessAuditNode(t *testing.T, db *gorm.DB) {
+	t.Helper()
+	now := time.Now().UTC()
+	home := cluster.ClusterNodeRecord{IP: "127.0.0.1", Port: 18317, StartedAt: now.Add(-time.Hour), LastSeenAt: now}
+	membership := cluster.CPANodeMembershipRecord{
+		CertificateFingerprint: "fp-readiness",
+		NodeID:                 readinessAuditNodeID,
+		HomeIP:                 home.IP,
+		HomePort:               home.Port,
+		HomeStartedAt:          home.StartedAt,
+		ProtocolVersion:        1,
+		State:                  cluster.MembershipStateActive,
+		CPAHeartbeatTimeout:    config.DefaultCPAHeartbeatTimeout,
+		ConnectedAt:            now.Add(-time.Minute),
+		LastSeenAt:             now,
+		UpdatedAt:              now,
+	}
+	snapshot := cluster.CPANodeRecord{
+		HomeIP:                 home.IP,
+		HomePort:               home.Port,
+		HomeStartedAt:          home.StartedAt,
+		NodeKey:                "fingerprint:fp-readiness",
+		NodeID:                 readinessAuditNodeID,
+		ClientIP:               "10.0.9.1",
+		ClientCount:            1,
+		CertificateFingerprint: "fp-readiness",
+		ConnectedAt:            now.Add(-time.Minute),
+		LastSeenAt:             now,
+	}
+	for _, record := range []any{&home, &membership, &snapshot} {
+		if errCreate := db.Create(record).Error; errCreate != nil {
+			t.Fatalf("seed readiness audit node: %v", errCreate)
+		}
+	}
+}
+
+// holdAllConnections keeps every connection of db busy until the returned release is called.
+func holdAllConnections(t *testing.T, db *gorm.DB, conns int) func() {
+	t.Helper()
+	ctx, cancel := context.WithCancel(context.Background())
+	var wg sync.WaitGroup
+	started := make(chan struct{}, conns)
+	for range conns {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			_ = db.WithContext(ctx).Connection(func(*gorm.DB) error {
+				started <- struct{}{}
+				<-ctx.Done()
+				return nil
+			})
+		}()
+	}
+	for range conns {
+		<-started
+	}
+	return func() {
+		cancel()
+		wg.Wait()
+	}
+}
+
+// readinessAudit asks for the node listing the way the pool supervisor's check_services does.
+func readinessAudit(server *httptest.Server) (bool, error) {
+	client := &http.Client{Timeout: readinessAuditTimeout}
+	resp, errGet := client.Get(server.URL + "/v8/management/nodes")
+	if errGet != nil {
+		return false, errGet
+	}
+	defer func() { _ = resp.Body.Close() }()
+	if resp.StatusCode != http.StatusOK {
+		return false, errors.New("node listing status " + resp.Status)
+	}
+	var body struct {
+		Nodes []struct {
+			NodeID  string `json:"node_id"`
+			Healthy bool   `json:"healthy"`
+		} `json:"nodes"`
+	}
+	if errDecode := json.NewDecoder(resp.Body).Decode(&body); errDecode != nil {
+		return false, errDecode
+	}
+	for _, item := range body.Nodes {
+		if item.NodeID == readinessAuditNodeID && item.Healthy {
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+func TestHomeDBPoolCoordinationServesTheReadinessAuditOffASaturatedMainPool(t *testing.T) {
+	mainDB, server := newNodeListingFixture(t, 2)
+	release := holdAllConnections(t, mainDB, 2)
+	defer release()
+	healthy, errAudit := readinessAudit(server)
+	if errAudit != nil {
+		t.Fatalf("readiness audit with a coordination pool: %v", errAudit)
+	}
+	if !healthy {
+		t.Fatalf("readiness audit did not see %s healthy", readinessAuditNodeID)
+	}
+}
+
+func TestHomeDBPoolCoordinationSharedPoolFailsTheReadinessAudit(t *testing.T) {
+	mainDB, server := newNodeListingFixture(t, 0)
+	if healthy, errAudit := readinessAudit(server); errAudit != nil || !healthy {
+		t.Fatalf("readiness audit on an idle shared pool = %v, %v; want the node healthy", healthy, errAudit)
+	}
+	release := holdAllConnections(t, mainDB, 2)
+	defer release()
+	_, errAudit := readinessAudit(server)
+	var urlErr *url.Error
+	if !errors.As(errAudit, &urlErr) || !urlErr.Timeout() {
+		t.Fatalf("readiness audit on the shared saturated pool = %v, want the client timeout", errAudit)
+	}
+}
+
+func dsnWithSearchPath(dsn string, schema string) string {
+	parsed, errParse := url.Parse(dsn)
+	if errParse == nil && parsed.Scheme != "" {
+		query := parsed.Query()
+		query.Set("search_path", schema)
+		parsed.RawQuery = query.Encode()
+		return parsed.String()
+	}
+	return dsn + " search_path=" + schema
+}
