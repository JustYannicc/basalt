+package cluster
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestHomeDBPoolSettings(t *testing.T) {
+	intPtr := func(n int) *int { return &n }
+	tests := []struct {
+		name    string
+		config  PGSQLConfig
+		want    databasePoolSettings
+		invalid bool
+	}{
+		{name: "defaults", want: databasePoolSettings{6, 6, 5 * time.Minute, 30 * time.Minute}},
+		{name: "smaller open default idle", config: PGSQLConfig{MaxOpenConns: intPtr(1)}, want: databasePoolSettings{1, 1, 5 * time.Minute, 30 * time.Minute}},
+		{name: "explicit", config: PGSQLConfig{MaxOpenConns: intPtr(8), MaxIdleConns: intPtr(0), ConnMaxIdleTime: time.Minute, ConnMaxLifetime: time.Hour}, want: databasePoolSettings{8, 0, time.Minute, time.Hour}},
+		{name: "zero open", config: PGSQLConfig{MaxOpenConns: intPtr(0)}, invalid: true},
+		{name: "negative open", config: PGSQLConfig{MaxOpenConns: intPtr(-1)}, invalid: true},
+		{name: "negative idle", config: PGSQLConfig{MaxIdleConns: intPtr(-1)}, invalid: true},
+		{name: "idle above open", config: PGSQLConfig{MaxOpenConns: intPtr(2), MaxIdleConns: intPtr(3)}, invalid: true},
+		{name: "negative idle time", config: PGSQLConfig{ConnMaxIdleTime: -time.Second}, invalid: true},
+		{name: "negative lifetime", config: PGSQLConfig{ConnMaxLifetime: -time.Second}, invalid: true},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			settings, errSettings := test.config.poolSettings()
+			if (errSettings != nil) != test.invalid {
+				t.Fatalf("settings error = %v, invalid = %v", errSettings, test.invalid)
+			}
+			if !test.invalid && settings != test.want {
+				t.Fatalf("settings = %+v, want %+v", settings, test.want)
+			}
+			test.config.PostgresURI = "postgresql://fixture:fixture@localhost/home"
+			if errValidate := test.config.Validate(); (errValidate != nil) != test.invalid {
+				t.Fatalf("validation = %v, invalid = %v", errValidate, test.invalid)
+			}
+		})
+	}
+}
+
+func TestHomeDBPoolConfigYAML(t *testing.T) {
+	for _, test := range []struct {
+		name, fields string
+		invalid      bool
+	}{
+		{name: "custom", fields: "  max-open-conns: 9\n  max-idle-conns: 4\n  conn-max-idle-time: 2m\n  conn-max-lifetime: 15m\n"},
+		{name: "unlimited rejected", fields: "  max-open-conns: 0\n", invalid: true},
+		{name: "bad duration rejected", fields: "  conn-max-idle-time: forever\n", invalid: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "cluster.yaml")
+			content := "pgsql:\n  postgres_uri: postgresql://fixture:fixture@localhost/home\n" + test.fields + "node:\n  port: 8327\n"
+			if errWrite := os.WriteFile(path, []byte(content), 0600); errWrite != nil {
+				t.Fatal(errWrite)
+			}
+			cfg, _, errLoad := LoadConfigOptional(path)
+			if (errLoad != nil) != test.invalid {
+				t.Fatalf("load error = %v, invalid = %v", errLoad, test.invalid)
+			}
+			if !test.invalid {
+				settings, errSettings := cfg.PGSQL.poolSettings()
+				want := databasePoolSettings{9, 4, 2 * time.Minute, 15 * time.Minute}
+				if errSettings != nil || settings != want {
+					t.Fatalf("settings = %+v, %v; want %+v", settings, errSettings, want)
+				}
+			}
+		})
+	}
+}
