diff --git a/internal/cluster/db_pool.go b/internal/cluster/db_pool.go
new file mode 100644
index 0000000..052a229
--- /dev/null
+++ b/internal/cluster/db_pool.go
@@ -0,0 +1,80 @@
+package cluster
+
+import (
+	"database/sql"
+	"fmt"
+	"time"
+)
+
+type databasePoolSettings struct {
+	maxOpen, maxIdle         int
+	maxIdleTime, maxLifetime time.Duration
+}
+
+func (c PGSQLConfig) poolSettings() (databasePoolSettings, error) {
+	settings := databasePoolSettings{6, 6, 5 * time.Minute, 30 * time.Minute}
+	if c.MaxOpenConns != nil {
+		settings.maxOpen = *c.MaxOpenConns
+		settings.maxIdle = min(settings.maxIdle, settings.maxOpen)
+	}
+	if c.MaxIdleConns != nil {
+		settings.maxIdle = *c.MaxIdleConns
+	}
+	if settings.maxOpen <= 0 {
+		return settings, fmt.Errorf("pgsql.max-open-conns must be greater than 0")
+	}
+	if settings.maxIdle < 0 || settings.maxIdle > settings.maxOpen {
+		return settings, fmt.Errorf("pgsql.max-idle-conns must be between 0 and max-open-conns")
+	}
+	if c.ConnMaxIdleTime < 0 || c.ConnMaxLifetime < 0 {
+		return settings, fmt.Errorf("pgsql connection idle time and lifetime must not be negative")
+	}
+	if c.ConnMaxIdleTime != 0 {
+		settings.maxIdleTime = c.ConnMaxIdleTime
+	}
+	if c.ConnMaxLifetime != 0 {
+		settings.maxLifetime = c.ConnMaxLifetime
+	}
+	return settings, nil
+}
+
+func (s databasePoolSettings) apply(db *sql.DB) {
+	db.SetMaxOpenConns(s.maxOpen)
+	db.SetMaxIdleConns(s.maxIdle)
+	db.SetConnMaxIdleTime(s.maxIdleTime)
+	db.SetConnMaxLifetime(s.maxLifetime)
+}
+
+// DatabasePoolStats contains process-local counters, without connection details.
+type DatabasePoolStats struct {
+	MaxOpenConnections int   `json:"max_open_connections"`
+	OpenConnections    int   `json:"open_connections"`
+	InUse              int   `json:"in_use"`
+	Idle               int   `json:"idle"`
+	WaitCount          int64 `json:"wait_count"`
+	WaitDurationNS     int64 `json:"wait_duration_ns"`
+	MaxIdleClosed      int64 `json:"max_idle_closed"`
+	MaxIdleTimeClosed  int64 `json:"max_idle_time_closed"`
+	MaxLifetimeClosed  int64 `json:"max_lifetime_closed"`
+}
+
+// DatabasePoolStats reads database/sql counters without checking out a connection.
+func (r *Repository) DatabasePoolStats() (DatabasePoolStats, error) {
+	db, errDB := r.database()
+	if errDB != nil {
+		return DatabasePoolStats{}, errDB
+	}
+	sqlDB, errSQL := db.DB()
+	if errSQL != nil {
+		return DatabasePoolStats{}, errSQL
+	}
+	stats := sqlDB.Stats()
+	return DatabasePoolStats{
+		MaxOpenConnections: stats.MaxOpenConnections,
+		OpenConnections:    stats.OpenConnections,
+		InUse:              stats.InUse, Idle: stats.Idle,
+		WaitCount: stats.WaitCount, WaitDurationNS: int64(stats.WaitDuration),
+		MaxIdleClosed: stats.MaxIdleClosed, MaxIdleTimeClosed: stats.MaxIdleTimeClosed,
+		MaxLifetimeClosed: stats.MaxLifetimeClosed,
+	}, nil
+}
diff --git a/internal/cluster/db_pool_postgres_test.go b/internal/cluster/db_pool_postgres_test.go
new file mode 100644
index 0000000..56ebf09
--- /dev/null
+++ b/internal/cluster/db_pool_postgres_test.go
@@ -0,0 +1,247 @@
+package cluster
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"runtime"
+	"sync"
+	"testing"
+	"time"
+
+	"gorm.io/driver/postgres"
+)
+
+// Reuse the isolated schema fixture, but open the runtime pool through production Open.
+func newHomeDBPoolRepository(t *testing.T, maxOpen int) *Repository {
+	t.Helper()
+	fixture := newPostgresQuiescenceRepository(t)
+	dsn := fixture.db.Dialector.(*postgres.Dialector).DSN
+	fixtureSQL, errSQL := fixture.db.DB()
+	if errSQL != nil {
+		t.Fatal(errSQL)
+	}
+	if errClose := fixtureSQL.Close(); errClose != nil {
+		t.Fatal(errClose)
+	}
+	cfg := PGSQLConfig{PostgresURI: dsn}
+	if maxOpen != 0 {
+		cfg.MaxOpenConns = &maxOpen
+	}
+	db, errOpen := Open(t.Context(), cfg)
+	if errOpen != nil {
+		t.Fatal(errOpen)
+	}
+	sqlDB, errDB := db.DB()
+	if errDB != nil {
+		t.Fatal(errDB)
+	}
+	t.Cleanup(func() {
+		if errClose := sqlDB.Close(); errClose != nil {
+			t.Error(errClose)
+		}
+	})
+	return NewRepository(db)
+}
+
+func holdHomeDBPoolConnections(t *testing.T, db *sql.DB, count int) func() {
+	t.Helper()
+	held := make([]*sql.Conn, 0, count)
+	var once sync.Once
+	release := func() {
+		once.Do(func() {
+			for _, conn := range held {
+				if errClose := conn.Close(); errClose != nil {
+					t.Error(errClose)
+				}
+			}
+		})
+	}
+	t.Cleanup(release)
+	for range count {
+		conn, errConn := db.Conn(t.Context())
+		if errConn != nil {
+			t.Fatal(errConn)
+		}
+		held = append(held, conn)
+	}
+	return release
+}
+
+// Wait on the pool's queue counter, not elapsed time or an assumed goroutine schedule.
+func waitHomeDBPoolQueue(t *testing.T, db *sql.DB, target int64) {
+	t.Helper()
+	for db.Stats().WaitCount < target {
+		if errContext := t.Context().Err(); errContext != nil {
+			t.Fatal(errContext)
+		}
+		runtime.Gosched()
+	}
+}
+
+func TestHomeDBPoolPostgresCap(t *testing.T) {
+	repo := newHomeDBPoolRepository(t, 0)
+	db, errDB := repo.db.DB()
+	if errDB != nil {
+		t.Fatal(errDB)
+	}
+	release := holdHomeDBPoolConnections(t, db, 6)
+	stats, errStats := repo.DatabasePoolStats()
+	if errStats != nil {
+		t.Fatal(errStats)
+	}
+	if stats.MaxOpenConnections != 6 || stats.OpenConnections != 6 || stats.InUse != 6 || stats.Idle != 0 {
+		t.Fatalf("full pool = %+v", stats)
+	}
+	const workers = 32
+	baseline := stats.WaitCount
+	done := make(chan error, workers)
+	for range workers {
+		go func() {
+			_, errExec := db.ExecContext(t.Context(), "SELECT 1")
+			done <- errExec
+		}()
+	}
+	waitHomeDBPoolQueue(t, db, baseline+workers)
+	// Reading diagnostics must work even while every connection is checked out.
+	queued, errQueued := repo.DatabasePoolStats()
+	if errQueued != nil || queued.OpenConnections != 6 || queued.InUse != 6 || queued.WaitCount != baseline+workers {
+		t.Fatalf("queued pool = %+v, %v", queued, errQueued)
+	}
+	release()
+	for range workers {
+		if errWork := <-done; errWork != nil {
+			t.Fatal(errWork)
+		}
+	}
+	final, errFinal := repo.DatabasePoolStats()
+	if errFinal != nil || final.OpenConnections != 6 || final.InUse != 0 || final.Idle != 6 || final.WaitDurationNS <= 0 {
+		t.Fatalf("drained pool = %+v, %v", final, errFinal)
+	}
+}
+
+func TestHomeDBPoolPostgresMixedWorkload(t *testing.T) {
+	testHomeDBPoolMixedWorkload(t, func(ctx context.Context, repo *Repository) error {
+		_, errPurge := repo.PurgeExpiredSessionBindings(ctx, time.Now(), 10)
+		return errPurge
+	})
+}
+
+func testHomeDBPoolMixedWorkload(t *testing.T, maintenance func(context.Context, *Repository) error) {
+	t.Helper()
+	repo := newHomeDBPoolRepository(t, 0)
+	coordinator := newSnapshotTestCoordinator(t, repo)
+	home, _ := coordinator.HomeIncarnation()
+	lifecycle, errLifecycle := repo.EnsureLifecycleConfig(t.Context(), DefaultHeartbeatTimeout())
+	if errLifecycle != nil {
+		t.Fatal(errLifecycle)
+	}
+	member, errMember := repo.SubscribeMembership(t.Context(), SubscribeMembershipRequest{
+		Fingerprint: "pool-test-fingerprint", NodeID: "pool-test-node", Home: home,
+		ProtocolVersion: 1, LifecycleConfigRevision: lifecycle.Revision,
+	})
+	if errMember != nil {
+		t.Fatal(errMember)
+	}
+	lifetime := ConnectionLifetime{Fingerprint: member.CertificateFingerprint, ConnectedAt: member.ConnectedAt, Home: home, Controlled: true}
+	db, errDB := repo.db.DB()
+	if errDB != nil {
+		t.Fatal(errDB)
+	}
+	configHeld, releaseConfig := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	finishConfig := func() { once.Do(func() { close(releaseConfig) }) }
+	t.Cleanup(finishConfig)
+	configDone := make(chan error, 1)
+	go func() {
+		configDone <- repo.MutateConfigSnapshot(t.Context(), DefaultHeartbeatTimeout(), func(root map[string]any) (map[string]any, error) {
+			close(configHeld)
+			<-releaseConfig
+			root["debug"] = true
+			return root, nil
+		})
+	}()
+	select {
+	case <-configHeld:
+	case errConfig := <-configDone:
+		t.Fatalf("config failed before callback: %v", errConfig)
+	}
+	releaseFour := holdHomeDBPoolConnections(t, db, 4)
+	releaseLast := holdHomeDBPoolConnections(t, db, 1)
+	baseline := db.Stats().WaitCount
+	watcher := NewEventWatcher(repo, time.Second, func(context.Context, ClusterEventRecord) error { return nil })
+	jobs := []func() error{
+		func() error { return repo.RefreshCPALiveness(t.Context(), lifetime) },
+		func() error {
+			if errHeartbeat := repo.HeartbeatHomeIncarnation(t.Context(), home); errHeartbeat != nil {
+				return errHeartbeat
+			}
+			return coordinator.heartbeatAndElect(t.Context(), home)
+		},
+		func() error { return watcher.poll(t.Context()) },
+		func() error { return maintenance(t.Context(), repo) },
+		func() error {
+			_, errLog := repo.AppendAppLog(t.Context(), "", "", `{"line":"pool test","level":"info"}`)
+			return errLog
+		},
+	}
+	done := make(chan error, len(jobs))
+	for _, job := range jobs {
+		go func() { done <- job() }()
+	}
+	waitHomeDBPoolQueue(t, db, baseline+int64(len(jobs)))
+	releaseLast()
+	// All five callers must finish using the one available connection while config
+	// retains its transaction and four unrelated callers retain their connections.
+	for range jobs {
+		if errWork := <-done; errWork != nil {
+			t.Fatal(errWork)
+		}
+	}
+	select {
+	case errConfig := <-configDone:
+		t.Fatalf("config finished before release: %v", errConfig)
+	default:
+	}
+	releaseFour()
+	finishConfig()
+	if errConfig := <-configDone; errConfig != nil {
+		t.Fatal(errConfig)
+	}
+	snapshot, errSnapshot := repo.LoadConfigSnapshot(t.Context())
+	if errSnapshot != nil {
+		t.Fatal(errSnapshot)
+	}
+	var debug bool
+	if errDecode := json.Unmarshal(snapshot["debug"], &debug); errDecode != nil || !debug {
+		t.Fatalf("config was not committed: debug = %v, error = %v", debug, errDecode)
+	}
+	if stats := db.Stats(); stats.OpenConnections > 6 || stats.InUse != 0 {
+		t.Fatalf("pool = %+v", stats)
+	}
+}
+
+func TestHomeDBPoolPostgresSingleConnectionTransactions(t *testing.T) {
+	repo := newHomeDBPoolRepository(t, 1)
+	stats, errStats := repo.DatabasePoolStats()
+	if errStats != nil || stats.MaxOpenConnections != 1 {
+		t.Fatalf("single connection pool = %+v, %v", stats, errStats)
+	}
+	if errMigrate := autoMigratePostgresContext(t.Context(), repo.db, true, nil); errMigrate != nil {
+		t.Fatal(errMigrate)
+	}
+	if errConfig := repo.MutateConfigSnapshot(t.Context(), DefaultHeartbeatTimeout(), func(root map[string]any) (map[string]any, error) {
+		root["debug"] = true
+		return root, nil
+	}); errConfig != nil {
+		t.Fatal(errConfig)
+	}
+	coordinator := newSnapshotTestCoordinator(t, repo)
+	home, _ := coordinator.HomeIncarnation()
+	if errHeartbeat := repo.HeartbeatHomeIncarnation(t.Context(), home); errHeartbeat != nil {
+		t.Fatal(errHeartbeat)
+	}
+	if errElect := coordinator.heartbeatAndElect(t.Context(), home); errElect != nil {
+		t.Fatal(errElect)
+	}
+}
