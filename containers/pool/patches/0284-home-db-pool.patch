+package management
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPIHome/internal/cluster"
+)
+
+func TestHomeDBPoolCapabilities(t *testing.T) {
+	handler, closeRepo := newUsageObservabilityTestHandler(t)
+	defer closeRepo()
+	expected, errStats := handler.repo.DatabasePoolStats()
+	if errStats != nil {
+		t.Fatal(errStats)
+	}
+	gin.SetMode(gin.TestMode)
+	engine := gin.New()
+	engine.GET("/capabilities", handler.GetCapabilities)
+	response := httptest.NewRecorder()
+	engine.ServeHTTP(response, httptest.NewRequest(http.MethodGet, "/capabilities", nil))
+	if response.Code != http.StatusOK {
+		t.Fatalf("status = %d", response.Code)
+	}
+	var body struct {
+		ServerInfo struct {
+			Pool *cluster.DatabasePoolStats `json:"database_pool"`
+		} `json:"server_info"`
+	}
+	if errDecode := json.Unmarshal(response.Body.Bytes(), &body); errDecode != nil {
+		t.Fatal(errDecode)
+	}
+	if body.ServerInfo.Pool == nil || *body.ServerInfo.Pool != expected {
+		t.Fatalf("pool diagnostics = %+v, want %+v", body.ServerInfo.Pool, expected)
+	}
+}
