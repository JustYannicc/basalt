+package cluster
+
+import (
+	"testing"
+	"time"
+)
+
+func TestUsageSummaryUpgradeFromV15PreservesLegacyRows(t *testing.T) {
+	repo := newPostgresQuiescenceRepository(t)
+	db := repo.db
+	row := UsageRecord{Timestamp: time.Now().UTC().Add(time.Hour), PayloadJSON: JSONB(`{"legacy":true}`)}
+	if errCreate := db.Create(&row).Error; errCreate != nil {
+		t.Fatal(errCreate)
+	}
+	var before string
+	if errRead := db.Raw("SELECT to_jsonb(u)::text FROM usage u WHERE id=?", row.ID).Scan(&before).Error; errRead != nil {
+		t.Fatal(errRead)
+	}
+	if errReset := db.Exec(`DROP TRIGGER usage_summary_pending_insert ON usage;
+		DROP TRIGGER usage_summary_pending_delete ON usage;
+		DROP TABLE usage_summary_pending;
+		UPDATE home_schema_migration SET version=15`).Error; errReset != nil {
+		t.Fatal(errReset)
+	}
+	if errMigrate := AutoMigrateContext(t.Context(), db); errMigrate != nil {
+		t.Fatal(errMigrate)
+	}
+	var after string
+	if errRead := db.Raw("SELECT to_jsonb(u)::text FROM usage u WHERE id=?", row.ID).Scan(&after).Error; errRead != nil {
+		t.Fatal(errRead)
+	}
+	if before != after {
+		t.Fatalf("v15 retained row changed: before=%s after=%s", before, after)
+	}
+	assertPostgresSchemaMigrationVersion(t, db, 16)
+	var pending int64
+	if errCount := db.Model(&UsageSummaryPendingRecord{}).Where("usage_id=?", row.ID).Count(&pending).Error; errCount != nil || pending != 1 {
+		t.Fatalf("preexisting future row pending=%d error=%v", pending, errCount)
+	}
+}
