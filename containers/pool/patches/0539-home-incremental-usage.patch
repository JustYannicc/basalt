+package cluster
+
+import (
+	"context"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestUsageSummarySnapshotPreservesOnlyUnacknowledgedTokens(t *testing.T) {
+	ctx := context.Background()
+	source := openDatabaseSnapshotSQLiteTestDB(t, filepath.Join(t.TempDir(), "source.db"))
+	at := time.Now().UTC()
+	rows := []UsageRecord{{Timestamp: at, PayloadJSON: JSONB(`{}`)}, {Timestamp: at, PayloadJSON: JSONB(`{}`)}}
+	if errCreate := source.Create(&rows).Error; errCreate != nil {
+		t.Fatal(errCreate)
+	}
+	if errDelete := source.Delete(&UsageSummaryPendingRecord{}, "usage_id = ?", rows[0].ID).Error; errDelete != nil {
+		t.Fatal(errDelete)
+	}
+	var before []UsageSummaryPendingRecord
+	if errRead := source.Find(&before).Error; errRead != nil {
+		t.Fatal(errRead)
+	}
+	path := filepath.Join(t.TempDir(), "pending.snapshot.zip")
+	if _, errExport := ExportDatabaseSnapshot(ctx, source, DatabaseSnapshotExportOptions{Path: path}); errExport != nil {
+		t.Fatal(errExport)
+	}
+	snapshot, errOpen := OpenDatabaseSnapshot(ctx, path)
+	if errOpen != nil {
+		t.Fatal(errOpen)
+	}
+	defer func() {
+		if errClose := snapshot.Close(); errClose != nil {
+			t.Error(errClose)
+		}
+	}()
+	target := openDatabaseSnapshotSQLiteRawTestDB(t, filepath.Join(t.TempDir(), "target.db"))
+	if _, errImport := ImportDatabaseSnapshot(ctx, target, snapshot, nil); errImport != nil {
+		t.Fatal(errImport)
+	}
+	var after []UsageSummaryPendingRecord
+	if errRead := target.Find(&after).Error; errRead != nil {
+		t.Fatal(errRead)
+	}
+	if len(after) != 1 || len(before) != 1 || after[0] != before[0] {
+		t.Fatalf("pending changed: before=%v after=%v", before, after)
+	}
+}
