+			if backend == "postgres" {
+				repo = newPostgresQuiescenceRepository(t)
+			} else {
+				var closeRepo func()
+				repo, closeRepo = newBillingTestRepository(t, ctx)
+				defer closeRepo()
+			}
+			db, errDB := repo.database()
+			if errDB != nil {
+				t.Fatal(errDB)
+			}
+			at := time.Date(2026, 11, 12, 12, 0, 0, 0, time.UTC)
+			source := UsageRecord{Timestamp: at, APIKey: "late-key", AuthIndex: "late-auth", PayloadJSON: JSONB(`{}`)}
+			if errCreate := db.Create(&source).Error; errCreate != nil {
+				t.Fatal(errCreate)
+			}
+			before, _, errRead := repo.ListPendingUsageSummaryRecords(ctx, at.Add(time.Hour))
