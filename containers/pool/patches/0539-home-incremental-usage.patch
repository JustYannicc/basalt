+				t.Fatalf("before=%v %v", before, errRead)
+			}
+			key := APIKeyRecord{APIKey: "late-key"}
+			if errCreate := db.Create(&key).Error; errCreate != nil {
+				t.Fatal(errCreate)
+			}
+			if errAck := repo.AcknowledgeUsageSummaryRecords(ctx, []UsageSummaryPendingRecord{{UsageID: source.ID, Token: before[0].SummaryPendingToken}}); errAck != nil {
+				t.Fatal(errAck)
+			}
+			after, _, errRead := repo.ListPendingUsageSummaryRecords(ctx, at.Add(time.Hour))
+			if errRead != nil || len(after) != 1 || after[0].SummaryPendingToken == before[0].SummaryPendingToken {
+				t.Fatalf("repair lost: %v %v", after, errRead)
+			}
+			if errAck := repo.AcknowledgeUsageSummaryRecords(ctx, []UsageSummaryPendingRecord{{UsageID: source.ID, Token: after[0].SummaryPendingToken}}); errAck != nil {
+				t.Fatal(errAck)
+			}
+			// These common writes must not requeue retained usage.
+			if errUpdate := db.Model(&key).Update("display_name", "fixture-label").Error; errUpdate != nil {
+				t.Fatal(errUpdate)
+			}
+			if errUpdate := db.Model(&key).Update("api_key", key.APIKey).Error; errUpdate != nil {
+				t.Fatal(errUpdate)
+			}
+			user := UserRecord{Username: "fixture-user"}
+			if errCreate := db.Create(&user).Error; errCreate != nil {
+				t.Fatal(errCreate)
+			}
+			if errUpdate := db.Model(&user).Update("credits", 42).Error; errUpdate != nil {
+				t.Fatal(errUpdate)
+			}
+			empty, _, errRead := repo.ListPendingUsageSummaryRecords(ctx, at.Add(time.Hour))
+			if errRead != nil || len(empty) != 0 {
+				t.Fatalf("no-op requeued: %v %v", empty, errRead)
+			}
+			auth := AuthRecord{UUID: "late-auth", AuthJSON: JSONB(`{}`)}
+			if errCreate := db.Create(&auth).Error; errCreate != nil {
+				t.Fatal(errCreate)
+			}
+			repaired, _, errRead := repo.ListPendingUsageSummaryRecords(ctx, at.Add(time.Hour))
+			if errRead != nil || len(repaired) != 1 {
+				t.Fatalf("auth repair missing: %v %v", repaired, errRead)
+			}
+		})
+	}
+}
+
+func TestUsageSummaryInstallationQueuesLegacyFutureRowsOnce(t *testing.T) {
+	for _, backend := range []string{"sqlite", "postgres"} {
+		t.Run(backend, func(t *testing.T) {
+			ctx := context.Background()
+			var repo *Repository
+			if backend == "postgres" {
+				repo = newPostgresQuiescenceRepository(t)
+			} else {
+				var closeRepo func()
+				repo, closeRepo = newBillingTestRepository(t, ctx)
+				defer closeRepo()
+			}
+			db := repo.db
+			drop := "DROP TRIGGER usage_summary_pending_insert"
+			if backend == "postgres" {
+				drop += " ON usage"
+			}
+			if errDrop := db.Exec(drop).Error; errDrop != nil {
+				t.Fatal(errDrop)
+			}
+			future := UsageRecord{Timestamp: time.Now().UTC().Add(24 * time.Hour), PayloadJSON: JSONB(`{}`)}
+			if errCreate := db.Create(&future).Error; errCreate != nil {
+				t.Fatal(errCreate)
+			}
+			if errMigrate := migrateUsageSummaryPending(db); errMigrate != nil {
+				t.Fatal(errMigrate)
+			}
+			rows, _, errRead := repo.ListPendingUsageSummaryRecords(ctx, future.Timestamp.Add(time.Hour))
+			if errRead != nil || len(rows) != 1 || rows[0].UsageID != future.ID {
+				t.Fatalf("legacy future lost: %v %v", rows, errRead)
+			}
+			if errAck := repo.AcknowledgeUsageSummaryRecords(ctx, []UsageSummaryPendingRecord{{UsageID: future.ID, Token: rows[0].SummaryPendingToken}}); errAck != nil {
+				t.Fatal(errAck)
+			}
+			if errMigrate := migrateUsageSummaryPending(db); errMigrate != nil {
+				t.Fatal(errMigrate)
+			}
+			rows, _, errRead = repo.ListPendingUsageSummaryRecords(ctx, future.Timestamp.Add(time.Hour))
+			if errRead != nil || len(rows) != 0 {
+				t.Fatalf("installation repeated: %v %v", rows, errRead)
+			}
+		})
+	}
+}
diff --git a/internal/cluster/usage_summary_records.go b/internal/cluster/usage_summary_records.go
