+++ b/internal/cluster/usage_summary_records.go
@@ -0,0 +1,100 @@
+package cluster
+
+import (
+	"context"
+	"strings"
+	"time"
+)
+
+type UsageSummaryCursor struct {
+	Timestamp time.Time `json:"timestamp"`
+	ID        uint      `json:"id"`
+}
+
+type UsageSummaryRecordQuery struct {
+	From  time.Time
+	To    time.Time
+	After *UsageSummaryCursor
+	Limit int
+}
+
+// This stream is for retained counters. Detailed diagnostics stay on the records API.
+func usageSummaryRecordSelect() string {
+	columns := []string{`"usage"."id" AS usage_id`, `"usage"."auth_index" AS usage_auth_index`}
+	for _, name := range []string{"timestamp", "provider", "model", "executor_type", "input_tokens", "output_tokens", "reasoning_tokens", "cached_tokens", "cache_read_tokens", "cache_read_tokens_present", "cache_creation_tokens", "total_tokens", "token_accounting_version", "token_accounting_quality", "accounting_total_tokens", "accounting_input_tokens", "uncached_input_tokens", "accounting_cache_read_tokens", "accounting_cache_write_tokens", "accounting_output_tokens", "non_reasoning_output_tokens", "accounting_reasoning_tokens", "unclassified_tokens"} {
+		columns = append(columns, `"usage"."`+name+`" AS `+name)
+	}
+	columns = append(columns,
+		usageObservabilitySQLDisplayTokens(`"usage"`, "input_tokens")+` AS display_input_tokens`,
+		usageObservabilitySQLDisplayTokens(`"usage"`, "output_tokens")+` AS display_output_tokens`,
+		`COALESCE("billing_charge"."api_key_id", "api_key"."id") AS client_api_key_id`,
+		`"user"."username" AS username`,
+		`"billing_charge"."id" AS charge_id`, `"billing_charge"."amount" AS amount`,
+		`"billing_charge"."matched_price_rule" AS matched_price_rule`,
+		usageObservabilitySQLAuthUUID()+` AS auth_uuid`, usageObservabilitySQLAuthID()+` AS auth_id`,
+		usageObservabilitySQLAuthIndex()+` AS auth_index`)
+	return strings.Join(columns, ",")
+}
+
+func (r *Repository) ListUsageSummaryRecords(ctx context.Context, query UsageSummaryRecordQuery) ([]UsageObservabilityRecord, bool, error) {
+	db, errDB := r.database()
+	if errDB != nil {
+		return nil, false, errDB
+	}
+	limit := query.Limit
+	if limit <= 0 || limit > UsageObservabilityMaxRecordLimit {
+		limit = UsageObservabilityMaxRecordLimit
+	}
+	scope := usageObservabilityRecordScope(db.WithContext(contextOrBackground(ctx)).Table("usage"), UsageObservabilityRecordQuery{From: &query.From, To: &query.To})
+	if query.After != nil {
+		scope = scope.Where(`("usage"."timestamp", "usage"."id") > (?, ?)`, query.After.Timestamp, query.After.ID)
+	}
+	var rows []usageObservabilityRecordRow
+	if errFind := scope.Select(usageSummaryRecordSelect()).Order(`"usage"."timestamp" ASC, "usage"."id" ASC`).Limit(limit + 1).Scan(&rows).Error; errFind != nil {
+		return nil, false, errFind
+	}
+	more := len(rows) > limit
+	if more {
+		rows = rows[:limit]
+	}
+	records := make([]UsageObservabilityRecord, 0, len(rows))
+	for index := range rows {
+		records = append(records, usageObservabilityRecordFromRow(&rows[index]))
+	}
+	return records, more, nil
+}
+
+// Candidate IDs start at the indexed key columns. A charge's key always wins over a current key.
+func usageExactClientKeyCandidates() string {
+	return `"usage"."id" IN (
+ SELECT c.usage_id FROM "billing_charge" c JOIN "usage" u ON u.id = c.usage_id
+ WHERE c.api_key_id = ? AND u.timestamp >= ? AND u.failed = false
+ UNION
+ SELECT u.id FROM "api_key" k JOIN "usage" u ON
+   (u.api_key = k.api_key AND COALESCE(u.payload->>'api_key_fingerprint','') = '') OR
+   (u.api_key = k.diagnostic_fingerprint AND u.payload->>'api_key_fingerprint' = u.api_key)
+ LEFT JOIN "billing_charge" c ON c.usage_id = u.id
+ WHERE k.id = ? AND c.api_key_id IS NULL AND u.timestamp >= ? AND u.failed = false)`
+}
+
+func (r *Repository) FirstSuccessfulKeyUsage(ctx context.Context, key uint, since time.Time, credentials []string) (*time.Time, error) {
+	if len(credentials) == 0 {
+		return nil, nil
+	}
+	db, errDB := r.database()
+	if errDB != nil {
+		return nil, errDB
+	}
+	scope := usageObservabilityApplyRecordFilters(usageObservabilityAuthScope(db.WithContext(contextOrBackground(ctx)).Table("usage")), UsageObservabilityRecordQuery{From: &since, Status: "success"})
+	scope = scope.Where(usageExactClientKeyCandidates(), key, since, key, since)
+	scope = scope.Where(usageObservabilitySQLCredentialID()+` IN ?`, credentials)
+	var rows []usageObservabilityRecordRow
+	if errFind := scope.Select(`"usage"."timestamp"`).Order(`"usage"."timestamp" ASC`).Limit(1).Scan(&rows).Error; errFind != nil {
+		return nil, errFind
+	}
+	if len(rows) == 0 {
+		return nil, nil
+	}
+	at := rows[0].Timestamp.UTC()
+	return &at, nil
+}
