diff --git a/internal/cluster/management/usage_summary_records.go b/internal/cluster/management/usage_summary_records.go
new file mode 100644
index 0000000..1eccdaa
--- /dev/null
+++ b/internal/cluster/management/usage_summary_records.go
@@ -0,0 +1,140 @@
+package management
+
+import (
+	"encoding/hex"
+	"net/http"
+	"strconv"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPIHome/internal/cluster"
+)
+
+func (h *Handler) ListUsageSummaryRecords(c *gin.Context) {
+	from, to, errRange := parseUsageTimeRange(c.Query("from"), c.Query("to"), time.UTC)
+	if errRange != nil {
+		respondUsageHTTPError(c, errRange)
+		return
+	}
+	if from == nil || to == nil {
+		respondUsageHTTPError(c, newUsageHTTPError("invalid_range", "from and to are required"))
+		return
+	}
+	limit, errLimit := parseUsageLimit(c.Query("limit"), 200, 200)
+	if errLimit != nil {
+		respondUsageHTTPError(c, errLimit)
+		return
+	}
+	query := cluster.UsageSummaryRecordQuery{From: *from, To: *to, Limit: limit}
+	rawAt, rawID := c.Query("after_timestamp"), c.Query("after_id")
+	if rawAt != "" || rawID != "" {
+		at, errAt := time.Parse(time.RFC3339Nano, rawAt)
+		id, errID := strconv.ParseUint(rawID, 10, 64)
+		if errAt != nil || errID != nil || id == 0 || at.Before(*from) || !at.Before(*to) {
+			respondUsageHTTPError(c, newUsageHTTPError("invalid_cursor", "cursor must identify a row in the requested range"))
+			return
+		}
+		query.After = &cluster.UsageSummaryCursor{Timestamp: at, ID: uint(id)}
+	}
+	ctx, cancel := h.requestContext(c)
+	defer cancel()
+	records, more, errRecords := h.repo.ListUsageSummaryRecords(ctx, query)
+	if errRecords != nil {
+		respondError(c, http.StatusInternalServerError, "usage_summary_load_failed", errRecords)
+		return
+	}
+	var next any
+	if more && len(records) > 0 {
+		last := records[len(records)-1]
+		next = gin.H{"timestamp": last.Timestamp.UTC().Format(time.RFC3339Nano), "id": last.ID}
+	}
+	c.JSON(http.StatusOK, gin.H{"items": usageSummaryItems(records), "next": next})
+}
+
+func usageSummaryItems(records []cluster.UsageObservabilityRecord) []gin.H {
+	items := make([]gin.H, 0, len(records))
+	for _, record := range records {
+		item := gin.H{
+			"id": record.ID, "timestamp": record.Timestamp.UTC().Format(time.RFC3339Nano),
+			"provider": record.Provider, "model": record.Model,
+			"tokens": gin.H{"input_tokens": record.Tokens.InputTokens, "output_tokens": record.Tokens.OutputTokens,
+				"cache_read_tokens": record.Tokens.CacheReadTokens, "cache_creation_tokens": record.Tokens.CacheCreationTokens, "total_tokens": record.Tokens.TotalTokens},
+			"token_breakdown": usageTokenBreakdownResponse(record.Tokens.TokenBreakdown),
+			"client":          gin.H{"username": record.Client.Username}, "credential": gin.H{"credential_id": record.Credential.CredentialID},
+			"billing": gin.H{"amount": record.Billing.Amount, "matched_price_rule": record.Billing.MatchedPriceRule},
+		}
+		if record.SummaryPendingToken != "" {
+			item["pending_token"] = record.SummaryPendingToken
+		}
+		items = append(items, item)
+	}
+	return items
+}
+
+func (h *Handler) ListPendingUsageSummaryRecords(c *gin.Context) {
+	to, errTo := time.Parse(time.RFC3339Nano, c.Query("to"))
+	if errTo != nil {
+		respondUsageHTTPError(c, newUsageHTTPError("invalid_range", "to is required"))
+		return
+	}
+	ctx, cancel := h.requestContext(c)
+	defer cancel()
+	records, more, errRead := h.repo.ListPendingUsageSummaryRecords(ctx, to)
+	if errRead != nil {
+		respondError(c, http.StatusInternalServerError, "usage_summary_load_failed", errRead)
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"items": usageSummaryItems(records), "more": more})
+}
+
+func (h *Handler) AcknowledgeUsageSummaryRecords(c *gin.Context) {
+	var body struct {
+		Items []struct {
+			ID    string `json:"id"`
+			Token string `json:"token"`
+		} `json:"items"`
+	}
+	if errBind := c.ShouldBindJSON(&body); errBind != nil || len(body.Items) > 200 {
+		respondUsageHTTPError(c, newUsageHTTPError("invalid_query", "at most 200 usage IDs are required"))
+		return
+	}
+	items := make([]cluster.UsageSummaryPendingRecord, 0, len(body.Items))
+	for _, item := range body.Items {
+		id, errID := strconv.ParseUint(item.ID, 10, strconv.IntSize)
+		decoded, errToken := hex.DecodeString(item.Token)
+		if errID != nil || id == 0 || errToken != nil || len(decoded) != 16 {
+			respondUsageHTTPError(c, newUsageHTTPError("invalid_query", "positive usage IDs are required"))
+			return
+		}
+		items = append(items, cluster.UsageSummaryPendingRecord{UsageID: uint(id), Token: item.Token})
+	}
+	ctx, cancel := h.requestContext(c)
+	defer cancel()
+	if errAck := h.repo.AcknowledgeUsageSummaryRecords(ctx, items); errAck != nil {
+		respondError(c, http.StatusInternalServerError, "usage_summary_ack_failed", errAck)
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"ok": true})
+}
+
+func (h *Handler) FirstSuccessfulKeyUsage(c *gin.Context) {
+	key, errKey := optionalUint(c.Query("client_key_id"), "client_key_id")
+	from, _, errRange := parseUsageTimeRange(c.Query("from"), "", time.UTC)
+	credentials := c.QueryArray("credential_id")
+	if errKey != nil || errRange != nil || key == nil || *key == 0 || from == nil || len(credentials) > 500 {
+		respondUsageHTTPError(c, newUsageHTTPError("invalid_query", "positive client_key_id, from and at most 500 credentials are required"))
+		return
+	}
+	ctx, cancel := h.requestContext(c)
+	defer cancel()
+	at, errRead := h.repo.FirstSuccessfulKeyUsage(ctx, *key, *from, credentials)
+	if errRead != nil {
+		respondError(c, http.StatusInternalServerError, "usage_first_success_load_failed", errRead)
+		return
+	}
+	var timestamp any
+	if at != nil {
+		timestamp = at.UTC().Format(time.RFC3339Nano)
+	}
+	c.JSON(http.StatusOK, gin.H{"timestamp": timestamp})
+}
