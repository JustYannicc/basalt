+++ b/internal/cluster/usage_summary_attribution.go
@@ -0,0 +1,71 @@
+package cluster
+
+import "gorm.io/gorm"
+
+// Previously unknown records can become attributable after identity repair.
+// Requeue only affected IDs; ordinary credit/health updates leave the feed alone.
+func migrateUsageSummaryAttribution(db *gorm.DB) error {
+	if usageObservabilityIsPostgres(db) {
+		return db.Exec(`CREATE OR REPLACE FUNCTION home_usage_summary_attribution() RETURNS trigger
+		LANGUAGE plpgsql AS $function$ BEGIN
+		IF TG_TABLE_NAME = 'api_key' THEN
+			IF TG_OP='UPDATE' AND (NEW.api_key,NEW.diagnostic_fingerprint,NEW.user_id)
+				IS NOT DISTINCT FROM (OLD.api_key,OLD.diagnostic_fingerprint,OLD.user_id) THEN RETURN NEW; END IF;
+			INSERT INTO usage_summary_pending (usage_id,token) SELECT id,replace(gen_random_uuid()::text,'-','') FROM usage
+				WHERE api_key=NEW.api_key OR api_key=NEW.diagnostic_fingerprint ON CONFLICT(usage_id) DO UPDATE SET token=excluded.token;
+		ELSIF TG_TABLE_NAME = 'auth' THEN
+			IF TG_OP='UPDATE' AND (NEW.uuid,NEW.id,NEW.index,NEW.deleted_at)
+				IS NOT DISTINCT FROM (OLD.uuid,OLD.id,OLD.index,OLD.deleted_at) THEN RETURN NEW; END IF;
+			INSERT INTO usage_summary_pending (usage_id,token) SELECT id,replace(gen_random_uuid()::text,'-','') FROM usage
+				WHERE auth_index IN (NEW.uuid,NEW.id,NEW.index) ON CONFLICT(usage_id) DO UPDATE SET token=excluded.token;
+		ELSIF TG_TABLE_NAME = 'user' THEN
+			IF TG_OP='UPDATE' AND NEW.username IS NOT DISTINCT FROM OLD.username THEN RETURN NEW; END IF;
+			INSERT INTO usage_summary_pending (usage_id,token)
+ SELECT id,replace(gen_random_uuid()::text,'-','') FROM usage WHERE id IN (
+ SELECT usage_id FROM billing_charge WHERE user_id=NEW.id
+ UNION SELECT u.id FROM usage u JOIN api_key k ON u.api_key=k.api_key OR u.api_key=k.diagnostic_fingerprint WHERE k.user_id=NEW.id)
+ ON CONFLICT(usage_id) DO UPDATE SET token=excluded.token;
+		ELSE
+			IF TG_OP='UPDATE' AND (NEW.user_id,NEW.api_key_id) IS NOT DISTINCT FROM (OLD.user_id,OLD.api_key_id) THEN RETURN NEW; END IF;
+			INSERT INTO usage_summary_pending (usage_id,token) SELECT id,replace(gen_random_uuid()::text,'-','') FROM usage WHERE id=NEW.usage_id ON CONFLICT(usage_id) DO UPDATE SET token=excluded.token;
+		END IF;
+		RETURN NEW; END $function$;
+		CREATE OR REPLACE TRIGGER usage_summary_key_attribution AFTER INSERT OR UPDATE OF api_key,diagnostic_fingerprint,user_id ON api_key
+		 FOR EACH ROW EXECUTE FUNCTION home_usage_summary_attribution();
+		CREATE OR REPLACE TRIGGER usage_summary_auth_attribution AFTER INSERT OR UPDATE OF uuid,id,index,deleted_at ON auth
+		 FOR EACH ROW EXECUTE FUNCTION home_usage_summary_attribution();
+		CREATE OR REPLACE TRIGGER usage_summary_user_attribution AFTER INSERT OR UPDATE OF username ON "user"
+		 FOR EACH ROW EXECUTE FUNCTION home_usage_summary_attribution();
+		CREATE OR REPLACE TRIGGER usage_summary_charge_attribution AFTER INSERT OR UPDATE OF user_id,api_key_id ON billing_charge
+		 FOR EACH ROW EXECUTE FUNCTION home_usage_summary_attribution()`).Error
+	}
+	queries := []string{
+		`CREATE TRIGGER IF NOT EXISTS usage_summary_key_insert AFTER INSERT ON api_key BEGIN
+		 INSERT OR REPLACE INTO usage_summary_pending (usage_id,token) SELECT id,lower(hex(randomblob(16))) FROM usage WHERE api_key=NEW.api_key OR api_key=NEW.diagnostic_fingerprint; END`,
+		`CREATE TRIGGER IF NOT EXISTS usage_summary_key_update AFTER UPDATE OF api_key,diagnostic_fingerprint,user_id ON api_key
+		 WHEN NEW.api_key IS NOT OLD.api_key OR NEW.diagnostic_fingerprint IS NOT OLD.diagnostic_fingerprint OR NEW.user_id IS NOT OLD.user_id BEGIN
+		 INSERT OR REPLACE INTO usage_summary_pending (usage_id,token) SELECT id,lower(hex(randomblob(16))) FROM usage WHERE api_key=NEW.api_key OR api_key=NEW.diagnostic_fingerprint; END`,
+		`CREATE TRIGGER IF NOT EXISTS usage_summary_auth_insert AFTER INSERT ON auth BEGIN
+		 INSERT OR REPLACE INTO usage_summary_pending (usage_id,token) SELECT id,lower(hex(randomblob(16))) FROM usage WHERE auth_index IN(NEW.uuid,NEW.id,NEW."index"); END`,
+		`CREATE TRIGGER IF NOT EXISTS usage_summary_auth_update AFTER UPDATE OF uuid,id,"index",deleted_at ON auth
+		 WHEN NEW.uuid IS NOT OLD.uuid OR NEW.id IS NOT OLD.id OR NEW."index" IS NOT OLD."index" OR NEW.deleted_at IS NOT OLD.deleted_at BEGIN
+		 INSERT OR REPLACE INTO usage_summary_pending (usage_id,token) SELECT id,lower(hex(randomblob(16))) FROM usage WHERE auth_index IN(NEW.uuid,NEW.id,NEW."index"); END`,
+		`CREATE TRIGGER IF NOT EXISTS usage_summary_user_insert AFTER INSERT ON "user" BEGIN
+ INSERT OR REPLACE INTO usage_summary_pending (usage_id,token) SELECT id,lower(hex(randomblob(16))) FROM usage WHERE id IN(SELECT usage_id FROM billing_charge WHERE user_id=NEW.id
+ UNION SELECT u.id FROM usage u JOIN api_key k ON u.api_key=k.api_key OR u.api_key=k.diagnostic_fingerprint WHERE k.user_id=NEW.id); END`,
+		`CREATE TRIGGER IF NOT EXISTS usage_summary_user_update AFTER UPDATE OF username ON "user" WHEN NEW.username IS NOT OLD.username BEGIN
+		 INSERT OR REPLACE INTO usage_summary_pending (usage_id,token) SELECT id,lower(hex(randomblob(16))) FROM usage WHERE id IN(SELECT usage_id FROM billing_charge WHERE user_id=NEW.id
+ UNION SELECT u.id FROM usage u JOIN api_key k ON u.api_key=k.api_key OR u.api_key=k.diagnostic_fingerprint WHERE k.user_id=NEW.id); END`,
+		`CREATE TRIGGER IF NOT EXISTS usage_summary_charge_insert AFTER INSERT ON billing_charge BEGIN
+		 INSERT OR REPLACE INTO usage_summary_pending (usage_id,token) SELECT id,lower(hex(randomblob(16))) FROM usage WHERE id=NEW.usage_id; END`,
+		`CREATE TRIGGER IF NOT EXISTS usage_summary_charge_update AFTER UPDATE OF user_id,api_key_id ON billing_charge
+		 WHEN NEW.user_id IS NOT OLD.user_id OR NEW.api_key_id IS NOT OLD.api_key_id BEGIN
+		 INSERT OR REPLACE INTO usage_summary_pending (usage_id,token) SELECT id,lower(hex(randomblob(16))) FROM usage WHERE id=NEW.usage_id; END`,
+	}
+	for _, sql := range queries {
+		if errCreate := db.Exec(sql).Error; errCreate != nil {
+			return errCreate
+		}
+	}
+	return nil
+}
diff --git a/internal/cluster/usage_summary_pending.go b/internal/cluster/usage_summary_pending.go
new file mode 100644
index 0000000..1419db7
--- /dev/null
+++ b/internal/cluster/usage_summary_pending.go
@@ -0,0 +1,113 @@
+package cluster
+
+import (
+	"context"
+	"time"
+
+	"gorm.io/gorm"
+)
+
+// The singleton rollup consumer acknowledges IDs only after its durable commit.
+// Replays are harmless; rows committed behind any cursor remain pending.
+type UsageSummaryPendingRecord struct {
+	UsageID uint   `gorm:"column:usage_id;primaryKey;autoIncrement:false"`
+	Token   string `gorm:"column:token;not null"`
+}
+
+func (UsageSummaryPendingRecord) TableName() string { return "usage_summary_pending" }
+
+func migrateUsageSummaryPending(db *gorm.DB) error {
+	return db.Transaction(installUsageSummaryPending)
+}
+
+func installUsageSummaryPending(db *gorm.DB) error {
+	var existing int64
+	if usageObservabilityIsPostgres(db) {
+		if errRead := db.Raw(`SELECT count(*) FROM pg_trigger WHERE tgrelid=to_regclass('usage') AND tgname='usage_summary_pending_insert'`).Scan(&existing).Error; errRead != nil {
+			return errRead
+		}
+	} else if errRead := db.Raw(`SELECT count(*) FROM sqlite_master WHERE type='trigger' AND name='usage_summary_pending_insert'`).Scan(&existing).Error; errRead != nil {
+		return errRead
+	}
+	if usageObservabilityIsPostgres(db) {
+		if errTriggers := db.Exec(`CREATE OR REPLACE FUNCTION home_usage_summary_pending() RETURNS trigger
+			LANGUAGE plpgsql AS $function$ BEGIN
+			IF TG_OP = 'DELETE' THEN
+				DELETE FROM usage_summary_pending WHERE usage_id = OLD.id;
+				RETURN OLD;
+			END IF;
+			INSERT INTO usage_summary_pending (usage_id,token) VALUES (NEW.id,replace(gen_random_uuid()::text,'-',''))
+ ON CONFLICT(usage_id) DO UPDATE SET token=excluded.token;
+			RETURN NEW;
+		END $function$;
+		CREATE OR REPLACE TRIGGER usage_summary_pending_insert AFTER INSERT ON usage
+			FOR EACH ROW EXECUTE FUNCTION home_usage_summary_pending();
+		CREATE OR REPLACE TRIGGER usage_summary_pending_delete AFTER DELETE ON usage
+			FOR EACH ROW EXECUTE FUNCTION home_usage_summary_pending()`).Error; errTriggers != nil {
+			return errTriggers
+		}
+		if existing > 0 {
+			return nil
+		}
+		return db.Exec(`INSERT INTO usage_summary_pending(usage_id,token) SELECT id,replace(gen_random_uuid()::text,'-','') FROM usage WHERE timestamp >= CURRENT_TIMESTAMP ON CONFLICT(usage_id) DO NOTHING`).Error
+	}
+	for _, sql := range []string{
+		`CREATE TRIGGER IF NOT EXISTS usage_summary_pending_insert AFTER INSERT ON usage BEGIN
+		 INSERT OR REPLACE INTO usage_summary_pending (usage_id,token) VALUES (NEW.id,lower(hex(randomblob(16)))); END`,
+		`CREATE TRIGGER IF NOT EXISTS usage_summary_pending_delete AFTER DELETE ON usage BEGIN
+		 DELETE FROM usage_summary_pending WHERE usage_id = OLD.id; END`,
+	} {
+		if errCreate := db.Exec(sql).Error; errCreate != nil {
+			return errCreate
+		}
+	}
+	if existing > 0 {
+		return nil
+	}
+	return db.Exec(`INSERT OR IGNORE INTO usage_summary_pending(usage_id,token) SELECT id,lower(hex(randomblob(16))) FROM usage WHERE timestamp >= CURRENT_TIMESTAMP`).Error
+}
+
+func (r *Repository) ListPendingUsageSummaryRecords(ctx context.Context, to time.Time) ([]UsageObservabilityRecord, bool, error) {
+	db, errDB := r.database()
+	if errDB != nil {
+		return nil, false, errDB
+	}
+	// Bound the pending IDs before canonical joins. A merge join driven by usage
+	// would otherwise walk retained history before reaching the first pending ID.
+	page := db.WithContext(contextOrBackground(ctx)).Table("usage_summary_pending pending").
+		Select("pending.usage_id,pending.token").Where(`(SELECT u.timestamp FROM usage u WHERE u.id=pending.usage_id) < ?`, to).
+		Order("pending.usage_id").Limit(UsageObservabilityMaxRecordLimit + 1)
+	scope := usageObservabilityRecordScope(db.WithContext(contextOrBackground(ctx)).Table("(?) AS pending_page", page).
+		Joins(`JOIN "usage" ON "usage".id = pending_page.usage_id`), UsageObservabilityRecordQuery{})
+	var rows []usageObservabilityRecordRow
+	if errRead := scope.Select(usageSummaryRecordSelect() + ",pending_page.token AS summary_pending_token").Order(`"usage".id`).Limit(UsageObservabilityMaxRecordLimit + 1).Scan(&rows).Error; errRead != nil {
+		return nil, false, errRead
+	}
+	more := len(rows) > UsageObservabilityMaxRecordLimit
+	if more {
+		rows = rows[:UsageObservabilityMaxRecordLimit]
+	}
+	records := make([]UsageObservabilityRecord, 0, len(rows))
+	for index := range rows {
+		record := usageObservabilityRecordFromRow(&rows[index])
+		record.SummaryPendingToken = rows[index].SummaryPendingToken
+		records = append(records, record)
+	}
+	return records, more, nil
+}
+
+func (r *Repository) AcknowledgeUsageSummaryRecords(ctx context.Context, items []UsageSummaryPendingRecord) error {
+	if len(items) == 0 {
+		return nil
+	}
+	db, errDB := r.database()
+	if errDB != nil {
+		return errDB
+	}
+	pairs := make([][]any, 0, len(items))
+	for _, item := range items {
+		pairs = append(pairs, []any{item.UsageID, item.Token})
+	}
+	// A repair committed after the read has a different token and stays pending.
+	return db.WithContext(contextOrBackground(ctx)).Where("(usage_id,token) IN ?", pairs).Delete(&UsageSummaryPendingRecord{}).Error
+}
