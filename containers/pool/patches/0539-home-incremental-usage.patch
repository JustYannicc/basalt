diff --git a/internal/cluster/database_snapshot.go b/internal/cluster/database_snapshot.go
index b77aa76..0feda96 100644
--- a/internal/cluster/database_snapshot.go
+++ b/internal/cluster/database_snapshot.go
@@ -1156,8 +1156,22 @@ func importDatabaseSnapshotRecords(ctx context.Context, tx *gorm.DB, snapshot *V
 	if errEmpty := ensureDatabaseSnapshotTargetEmpty(ctx, tx); errEmpty != nil {
 		return DatabaseSnapshotImportResult{}, errEmpty
 	}
+	// Install on the empty target before restoring acknowledged state. Later
+	// custom migrations must not enqueue already acknowledged future records.
+	if snapshot.manifest.FormatVersion >= 16 {
+		if errPrepare := migrateUsageSummaryPending(tx); errPrepare != nil {
+			return DatabaseSnapshotImportResult{}, errPrepare
+		}
+	}
 	for index, model := range snapshot.models {
 		manifestTable := snapshot.manifest.Tables[index]
+		// An already initialized target may have queued imported usage through its
+		// triggers. The final table restores the source's exact pending work instead.
+		if model.name == "usage_summary_pending" {
