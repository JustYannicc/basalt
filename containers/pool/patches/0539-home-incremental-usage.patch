+package cluster
+
+import (
+	"context"
+	"log"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	"gorm.io/gorm/logger"
+)
+
+func TestPoolSummaryCursorPreservesTokensAttributionAndBillingWithoutWideReads(t *testing.T) {
+	ctx := context.Background()
+	repo, closeRepo := newBillingTestRepository(t, ctx)
+	defer closeRepo()
+	db, errDB := repo.database()
+	if errDB != nil {
+		t.Fatal(errDB)
+	}
+	at := time.Date(2026, time.November, 12, 12, 0, 0, 123456000, time.UTC)
+	var records []UsageRecord
+	for i := 0; i < 9; i++ {
+		records = append(records, UsageRecord{Timestamp: at.Add(time.Duration(i/3) * time.Second), Provider: "anthropic", Model: "model", ExecutorType: "claude", AuthIndex: "credential", InputTokens: 100, OutputTokens: 20, CachedTokens: 30, CacheCreationTokens: 10, TotalTokens: 120, PayloadJSON: JSONB(`{}`), CreatedAt: at})
+	}
+	if errCreate := db.Create(&records).Error; errCreate != nil {
+		t.Fatal(errCreate)
+	}
+	full, errFull := repo.ListUsageObservabilityRecords(ctx, UsageObservabilityRecordQuery{Sort: "timestamp_asc", Limit: 200})
+	if errFull != nil {
+		t.Fatal(errFull)
+	}
+	expected := map[string]UsageObservabilityRecord{}
+	for _, row := range full.Records {
+		expected[row.ID] = row
+	}
+	var statements strings.Builder
+	db.Logger = logger.New(log.New(&statements, "", 0), logger.Config{LogLevel: logger.Info})
+	query := UsageSummaryRecordQuery{From: at.Add(-time.Hour), To: at.Add(time.Hour), Limit: 2}
+	seen := map[string]bool{}
+	for page := 0; page < 8; page++ {
+		rows, more, errRead := repo.ListUsageSummaryRecords(ctx, query)
+		if errRead != nil {
+			t.Fatal(errRead)
+		}
+		for _, row := range rows {
+			old, ok := expected[row.ID]
+			if !ok || seen[row.ID] {
+				t.Fatalf("unexpected or repeated row %s", row.ID)
+			}
+			seen[row.ID] = true
+			if !reflect.DeepEqual(row.Tokens, old.Tokens) || row.Client.Username != old.Client.Username || row.Credential.CredentialID != old.Credential.CredentialID || !reflect.DeepEqual(row.Billing.Amount, old.Billing.Amount) || row.Billing.MatchedPriceRule != old.Billing.MatchedPriceRule {
+				t.Fatalf("summary changed values for %s", row.ID)
+			}
+		}
+		if !more {
+			break
+		}
+		last := rows[len(rows)-1]
+		query.After = &UsageSummaryCursor{Timestamp: last.Timestamp, ID: last.UsageID}
+	}
+	if len(seen) != len(expected) {
+		t.Fatalf("got %d rows, want %d", len(seen), len(expected))
+	}
+	sql := statements.String()
+	for _, wide := range []string{"COUNT(", "OFFSET", "auth_json", " AS payload_json"} {
+		if strings.Contains(sql, wide) {
+			t.Fatalf("stream still reads %s", wide)
+		}
+	}
+}
+
+func TestFirstSuccessfulKeyUsageUsesSinceMembershipAndChargePrecedence(t *testing.T) {
+	ctx := context.Background()
+	repo, closeRepo := newBillingTestRepository(t, ctx)
+	defer closeRepo()
+	db, errDB := repo.database()
+	if errDB != nil {
+		t.Fatal(errDB)
+	}
+	at := time.Date(2026, time.November, 12, 12, 0, 0, 0, time.UTC)
+	keys := []APIKeyRecord{{ID: 17, APIKey: "fixture-key"}, {ID: 18, APIKey: "other-key"}}
+	if errCreate := db.Create(&keys).Error; errCreate != nil {
+		t.Fatal(errCreate)
+	}
+	rows := []UsageRecord{
+		{Timestamp: at.Add(-time.Hour), APIKey: "fixture-key", AuthIndex: "allowed", PayloadJSON: JSONB(`{}`)},
+		{Timestamp: at.Add(time.Minute), APIKey: "fixture-key", AuthIndex: "allowed", Failed: true, PayloadJSON: JSONB(`{}`)},
+		{Timestamp: at.Add(2 * time.Minute), APIKey: "fixture-key", AuthIndex: "other", PayloadJSON: JSONB(`{}`)},
+		{Timestamp: at.Add(3 * time.Minute), APIKey: "fixture-key", AuthIndex: "allowed", PayloadJSON: JSONB(`{}`)},
+		{Timestamp: at.Add(4 * time.Minute), APIKey: "fixture-key", AuthIndex: "allowed", PayloadJSON: JSONB(`{}`)},
+	}
+	if errCreate := db.Create(&rows).Error; errCreate != nil {
+		t.Fatal(errCreate)
+	}
+	chargedKey := uint(18)
+	if errCreate := db.Create(&BillingChargeRecord{ID: "charge", UsageID: rows[3].ID, APIKeyID: &chargedKey, PayloadHash: "fixture-hash", PriceSnapshot: JSONB(`{}`)}).Error; errCreate != nil {
+		t.Fatal(errCreate)
+	}
+	got, errRead := repo.FirstSuccessfulKeyUsage(ctx, 17, at, []string{"allowed"})
+	if errRead != nil {
+		t.Fatal(errRead)
+	}
+	want := at.Add(4 * time.Minute)
+	if got == nil || !got.Equal(want) {
+		t.Fatalf("first = %v, want %v", got, want)
+	}
+	missing, errMissing := repo.FirstSuccessfulKeyUsage(ctx, 999, at, []string{"allowed"})
+	if errMissing != nil || missing != nil {
+		t.Fatalf("missing = %v, %v", missing, errMissing)
+	}
+	empty, errEmpty := repo.FirstSuccessfulKeyUsage(ctx, 17, at, nil)
+	if errEmpty != nil || empty != nil {
+		t.Fatalf("empty = %v, %v", empty, errEmpty)
+	}
+}
