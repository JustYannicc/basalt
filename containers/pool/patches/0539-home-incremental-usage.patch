@@ -0,0 +1,100 @@
+package management
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+)
+
+func TestSummaryFeedKeepsDiagnosticsPrivateAndAcknowledgesObservedToken(t *testing.T) {
+	handler, closeRepo := newUsageObservabilityTestHandler(t)
+	defer closeRepo()
+	seedUsageObservabilityManagementRecord(t, handler)
+	gin.SetMode(gin.TestMode)
+	engine := gin.New()
+	engine.GET("/usage/summary-records", handler.ListUsageSummaryRecords)
+	engine.GET("/usage/summary-pending", handler.ListPendingUsageSummaryRecords)
+	engine.POST("/usage/summary-ack", handler.AcknowledgeUsageSummaryRecords)
+	engine.GET("/usage/first-success", handler.FirstSuccessfulKeyUsage)
+	request := func(method, path, body string) map[string]any {
+		t.Helper()
+		resp := httptest.NewRecorder()
+		req := httptest.NewRequest(method, path, strings.NewReader(body))
+		req.Header.Set("content-type", "application/json")
+		engine.ServeHTTP(resp, req)
+		if resp.Code != http.StatusOK {
+			t.Fatalf("%s %s: %d %s", method, path, resp.Code, resp.Body.String())
+		}
+		for _, private := range []string{"client-key-secret", "203.0.113.8", "hello", "Primary OAuth", "auth_json", "payload", "request_id", "balance_after"} {
+			if strings.Contains(resp.Body.String(), private) {
+				t.Fatalf("summary exposed %s", private)
+			}
+		}
+		var result map[string]any
+		if errDecode := json.Unmarshal(resp.Body.Bytes(), &result); errDecode != nil {
+			t.Fatal(errDecode)
+		}
+		return result
+	}
+	result := request(http.MethodGet, "/usage/summary-records?from=2026-06-10T00:00:00Z&to=2026-06-11T00:00:00Z&limit=1", "")
+	items := result["items"].([]any)
+	if len(items) != 1 || result["next"] != nil {
+		t.Fatalf("summary=%v", result)
+	}
+	item := items[0].(map[string]any)
+	tokens := item["tokens"].(map[string]any)
+	if tokens["input_tokens"] != float64(100) || tokens["output_tokens"] != float64(50) {
+		t.Fatalf("tokens changed: %v", tokens)
+	}
+	credential := item["credential"].(map[string]any)["credential_id"].(string)
+	success := request(http.MethodGet, "/usage/first-success?client_key_id=1&from=2026-06-10T00:00:00Z&credential_id="+url.QueryEscape(credential), "")
+	if success["timestamp"] != "2026-06-10T01:02:03Z" {
+		t.Fatalf("success=%v", success)
+	}
+	denied := request(http.MethodGet, "/usage/first-success?client_key_id=1&from=2026-06-10T00:00:00Z&credential_id=foreign", "")
+	if denied["timestamp"] != nil {
+		t.Fatalf("foreign credential leaked success: %v", denied)
+	}
+	pending := request(http.MethodGet, "/usage/summary-pending?to=2026-06-11T00:00:00Z", "")["items"].([]any)
+	row := pending[0].(map[string]any)
+	body, errEncode := json.Marshal(map[string]any{"items": []any{map[string]any{"id": row["id"], "token": row["pending_token"]}}})
+	if errEncode != nil {
+		t.Fatal(errEncode)
+	}
+	request(http.MethodPost, "/usage/summary-ack", string(body))
+	request(http.MethodPost, "/usage/summary-ack", string(body))
+	empty := request(http.MethodGet, "/usage/summary-pending?to=2026-06-11T00:00:00Z", "")["items"].([]any)
+	if len(empty) != 0 {
+		t.Fatalf("ack did not drain: %v", empty)
+	}
+}
+
+func TestSummaryFeedRejectsInvalidRangeCursorAndAcknowledgment(t *testing.T) {
+	handler, closeRepo := newUsageObservabilityTestHandler(t)
+	defer closeRepo()
+	gin.SetMode(gin.TestMode)
+	engine := gin.New()
+	engine.GET("/records", handler.ListUsageSummaryRecords)
+	engine.GET("/pending", handler.ListPendingUsageSummaryRecords)
+	engine.POST("/ack", handler.AcknowledgeUsageSummaryRecords)
+	engine.GET("/success", handler.FirstSuccessfulKeyUsage)
+	for _, path := range []string{"/records", "/records?from=2026-06-10&to=2026-06-11&after_id=1", "/records?from=2026-06-10&to=2026-06-11&after_id=0&after_timestamp=2026-06-10T01:00:00Z", "/records?from=2026-06-10&to=2026-06-11&limit=0", "/pending?to=invalid", "/success?client_key_id=0&from=2026-06-10"} {
+		resp := httptest.NewRecorder()
+		engine.ServeHTTP(resp, httptest.NewRequest(http.MethodGet, path, nil))
+		if resp.Code != http.StatusBadRequest {
+			t.Fatalf("%s=%d", path, resp.Code)
+		}
+	}
+	resp := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodPost, "/ack", strings.NewReader(`{"items":[{"id":"1","token":"bad"}]}`))
+	req.Header.Set("content-type", "application/json")
+	engine.ServeHTTP(resp, req)
+	if resp.Code != http.StatusBadRequest {
+		t.Fatalf("ack=%d", resp.Code)
+	}
+}
diff --git a/internal/cluster/reporting_indexes.go b/internal/cluster/reporting_indexes.go
new file mode 100644
index 0000000..4f0c9ab
--- /dev/null
+++ b/internal/cluster/reporting_indexes.go
@@ -0,0 +1,133 @@
+package cluster
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"gorm.io/gorm"
+)
+
+type reportingIndex struct {
+	name, table, columns, predicate string
+	keys                            int
+	unique                          bool
+	definition                      string
+}
+
+// The three covering shapes come from CLIProxyAPIHome PR 171. Build them online,
+// outside the schema transaction, so reporting cannot block live usage writes.
+var reportingIndexes = []reportingIndex{
+	{"idx_billing_charge_usage_cover_v1", "billing_charge", "usage_id,amount,user_id,api_key_id", "", 1, true,
+		`CREATE UNIQUE INDEX CONCURRENTLY IF NOT EXISTS idx_billing_charge_usage_cover_v1 ON billing_charge (usage_id) INCLUDE (amount,user_id,api_key_id)`},
+	{"idx_billing_charge_overview_time_v1", "billing_charge", "created_at,usage_id,user_id,amount,input_tokens,output_tokens,cache_tokens", "", 1, false,
+		`CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_billing_charge_overview_time_v1 ON billing_charge (created_at) INCLUDE (usage_id,user_id,amount,input_tokens,output_tokens,cache_tokens)`},
+	{"idx_usage_billing_complete_v2", "usage", "id,accounting_input_tokens,accounting_output_tokens", "((token_accounting_version = 2) AND (token_accounting_quality = 'complete'::text))", 1, false,
+		`CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_usage_billing_complete_v2 ON usage (id) INCLUDE (accounting_input_tokens,accounting_output_tokens) WHERE token_accounting_version = 2 AND token_accounting_quality = 'complete'`},
+	{"idx_usage_summary_cursor_v1", "usage", "timestamp,id", "", 2, false,
+		`CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_usage_summary_cursor_v1 ON usage (timestamp,id)`},
+	{"idx_usage_key_success_time_v1", "usage", "api_key,timestamp", "(failed = false)", 2, false,
+		`CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_usage_key_success_time_v1 ON usage (api_key,timestamp) WHERE failed = false`},
+	{"idx_billing_charge_key_usage_v1", "billing_charge", "api_key_id,usage_id", "", 2, false,
+		`CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_billing_charge_key_usage_v1 ON billing_charge (api_key_id,usage_id)`},
+}
+
+func reportingIndexState(db *gorm.DB, index reportingIndex) (bool, bool, error) {
+	var row struct {
+		Matches bool
+		Ready   bool
+	}
+	result := db.Raw(`SELECT
+		i.indisvalid AND i.indisready AS ready,
+		i.indrelid = to_regclass(?) AND i.indisunique = ? AND i.indnkeyatts = ?
+		AND i.indnatts = ? AND am.amname = 'btree' AND i.indexprs IS NULL
+		AND COALESCE(pg_get_expr(i.indpred,i.indrelid),'') = ?
+		AND NOT EXISTS (SELECT 1 FROM unnest(i.indoption) option WHERE option <> 0)
+        AND NOT EXISTS (SELECT 1 FROM unnest(i.indclass) opclass
+          JOIN pg_opclass op ON op.oid=opclass JOIN pg_namespace ns ON ns.oid=op.opcnamespace
+          WHERE NOT op.opcdefault OR ns.nspname <> 'pg_catalog')
+        AND NOT EXISTS (SELECT 1 FROM unnest(i.indcollation) WITH ORDINALITY co(collation_oid,position)
+          JOIN unnest(i.indkey) WITH ORDINALITY k(attnum,position) USING(position)
+          JOIN pg_attribute a ON a.attrelid=i.indrelid AND a.attnum=k.attnum WHERE co.collation_oid <> a.attcollation)
+		AND (SELECT string_agg(a.attname::text,',' ORDER BY k.position)
+		 FROM unnest(i.indkey) WITH ORDINALITY k(attnum,position)
+		 JOIN pg_attribute a ON a.attrelid=i.indrelid AND a.attnum=k.attnum) = ? AS matches
+		FROM pg_index i JOIN pg_class c ON c.oid=i.indexrelid
+		JOIN pg_am am ON am.oid=c.relam WHERE i.indexrelid=to_regclass(?)`,
+		index.table, index.unique, index.keys, len(strings.Split(index.columns, ",")), index.predicate, index.columns, index.name).Scan(&row)
+	if result.Error != nil {
+		return false, false, result.Error
+	}
+	if !row.Matches && result.RowsAffected != 0 {
+		return false, false, fmt.Errorf("reporting index %s has an unexpected definition", index.name)
+	}
+	return row.Matches, row.Ready, nil
+}
+
+func migrateReportingIndexesOnline(ctx context.Context, db *gorm.DB) error {
+	if !usageObservabilityIsPostgres(db) {
+		return nil
+	}
+	ctx, cancel := context.WithTimeout(contextOrBackground(ctx), 10*time.Minute)
+	defer cancel()
+	// A transaction lock coordinates builders even through PgBouncer. Only the
+	// guard is transactional; index DDL uses a separate connection with no BEGIN.
+	busy := errors.New("reporting index builder is active")
+	for {
+		errBuild := db.WithContext(ctx).Transaction(func(guard *gorm.DB) error {
+			// A blocked SELECT holds a snapshot that CREATE INDEX CONCURRENTLY
+			// must wait for. The command-only DO also avoids a retained result
+			// portal on the successful guard connection through pgx.
+			if errLock := guard.Exec(`DO $lock$ BEGIN
+				IF NOT pg_try_advisory_xact_lock(hashtextextended('home-reporting-indexes-v1',0)) THEN
+					RAISE lock_not_available USING MESSAGE = 'reporting index builder is active';
+				END IF;
+			END $lock$`).Error; errLock != nil {
+				var postgresError interface{ SQLState() string }
+				if errors.As(errLock, &postgresError) && postgresError.SQLState() == "55P03" {
+					return busy
+				}
+				return errLock
+			}
+			return db.WithContext(ctx).Connection(func(builder *gorm.DB) error {
+				for _, index := range reportingIndexes {
+					exists, ready, errState := reportingIndexState(builder, index)
+					if errState != nil {
+						return errState
+					}
+					if exists && ready {
+						continue
+					}
+					if exists {
+						if errDrop := builder.Exec(`DROP INDEX CONCURRENTLY ` + index.name).Error; errDrop != nil {
+							return fmt.Errorf("repair reporting index %s: %w", index.name, errDrop)
+						}
+					}
+					if errCreate := builder.Exec(index.definition).Error; errCreate != nil {
+						return fmt.Errorf("build reporting index %s concurrently: %w", index.name, errCreate)
+					}
+					_, valid, errValidate := reportingIndexState(builder, index)
+					if errValidate != nil {
+						return errValidate
+					}
+					if !valid {
+						return fmt.Errorf("reporting index %s is not ready", index.name)
+					}
+				}
+				return nil
+			})
+		})
+		if !errors.Is(errBuild, busy) {
+			return errBuild
+		}
+		timer := time.NewTimer(schemaMigrationPollInterval)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return ctx.Err()
+		case <-timer.C:
+		}
+	}
+}
diff --git a/internal/cluster/reporting_indexes_postgres_test.go b/internal/cluster/reporting_indexes_postgres_test.go
new file mode 100644
index 0000000..0b65b56
--- /dev/null
+++ b/internal/cluster/reporting_indexes_postgres_test.go
@@ -0,0 +1,125 @@
+package cluster
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"gorm.io/gorm"
+)
+
+func TestReportingIndexesRemainOnlineAndRepairInterruptedBuild(t *testing.T) {
+	repo := newPostgresQuiescenceRepository(t)
+	db := repo.db
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+	defer cancel()
+	index := reportingIndexes[3]
+	if errDrop := db.Exec("DROP INDEX " + index.name).Error; errDrop != nil {
+		t.Fatal(errDrop)
+	}
+	writer := db.WithContext(ctx).Begin()
+	if writer.Error != nil {
+		t.Fatal(writer.Error)
+	}
+	defer func() {
+		if errRollback := writer.Rollback().Error; errRollback != nil && !errors.Is(errRollback, sql.ErrTxDone) {
+			t.Error(errRollback)
+		}
+	}()
+	if errInsert := writer.Create(&UsageRecord{Timestamp: time.Now().UTC(), PayloadJSON: JSONB(`{}`)}).Error; errInsert != nil {
+		t.Fatal(errInsert)
+	}
+	var writerPID int
+	if errPID := writer.Raw("SELECT pg_backend_pid()").Scan(&writerPID).Error; errPID != nil {
+		t.Fatal(errPID)
+	}
+	holder := make(chan postgresBackendPIDResult, 1)
+	holder <- postgresBackendPIDResult{pid: writerPID}
+	builder := make(chan postgresBackendPIDResult, 1)
+	var observed sync.Once
+	hook := "reporting-index-builder-pid"
+	if errHook := db.Callback().Raw().Before("gorm:raw").Register(hook, func(tx *gorm.DB) {
+		if !strings.HasPrefix(tx.Statement.SQL.String(), "CREATE INDEX CONCURRENTLY") || !strings.Contains(tx.Statement.SQL.String(), index.name) {
+			return
+		}
+		observed.Do(func() {
+			var pid int
+			errPID := tx.Session(&gorm.Session{NewDB: true}).Raw("SELECT pg_backend_pid()").Scan(&pid).Error
+			builder <- postgresBackendPIDResult{pid: pid, err: errPID}
+		})
+	}); errHook != nil {
+		t.Fatal(errHook)
+	}
+	defer func() {
+		if errRemove := db.Callback().Raw().Remove(hook); errRemove != nil {
+			t.Error(errRemove)
+		}
+	}()
+	buildCtx, cancelBuild := context.WithCancel(ctx)
+	defer cancelBuild()
+	finished := make(chan error, 1)
+	go func() { finished <- migrateReportingIndexesOnline(buildCtx, db) }()
+	waitForPostgresContendersBlockedByHolder(t, ctx, repo, holder, builder)
+	// The real concurrent builder is waiting on the old writer; a new write still commits.
+	if errInsert := db.WithContext(ctx).Create(&UsageRecord{Timestamp: time.Now().UTC(), PayloadJSON: JSONB(`{}`)}).Error; errInsert != nil {
+		t.Fatalf("online index blocked a new usage write: %v", errInsert)
+	}
+	var locks []struct {
+		Mode    string
+		Granted bool
+	}
+	if errLocks := db.Raw("SELECT mode,granted FROM pg_locks WHERE relation=to_regclass('usage') ORDER BY mode,granted").Scan(&locks).Error; errLocks != nil {
+		t.Fatal(errLocks)
+	}
+	t.Logf("REPORTING_INDEX_LOCKS writer_and_builder=%v", locks)
+	cancelBuild()
+	select {
+	case errBuild := <-finished:
+		if errBuild == nil {
+			t.Fatal("interrupted build succeeded")
+		}
+	case <-ctx.Done():
+		t.Fatal(ctx.Err())
+	}
+	exists, ready, errState := reportingIndexState(db, index)
+	if errState != nil || !exists || ready {
+		t.Fatalf("interrupted state exists=%t ready=%t error=%v", exists, ready, errState)
+	}
+	if errRollback := writer.Rollback().Error; errRollback != nil {
+		t.Fatal(errRollback)
+	}
+	if errRepair := migrateReportingIndexesOnline(ctx, db); errRepair != nil {
+		t.Fatal(errRepair)
+	}
+	exists, ready, errState = reportingIndexState(db, index)
+	if errState != nil || !exists || !ready {
+		t.Fatalf("repaired state exists=%t ready=%t error=%v", exists, ready, errState)
+	}
+	if errAgain := migrateReportingIndexesOnline(ctx, db); errAgain != nil {
+		t.Fatal(errAgain)
+	}
+}
+
+func TestReportingIndexesRefuseWrongDefinitionsWithoutDroppingThem(t *testing.T) {
+	repo := newPostgresQuiescenceRepository(t)
+	db := repo.db
+	index := reportingIndexes[3]
+	if errReplace := db.Exec("DROP INDEX " + index.name + "; CREATE INDEX " + index.name + " ON usage(timestamp DESC,id)").Error; errReplace != nil {
+		t.Fatal(errReplace)
+	}
+	errMigrate := migrateReportingIndexesOnline(context.Background(), db)
+	if errMigrate == nil || !strings.Contains(errMigrate.Error(), index.name+" has an unexpected definition") {
+		t.Fatalf("unexpected index accepted: %v", errMigrate)
+	}
+	var definition string
+	if errRead := db.Raw("SELECT pg_get_indexdef(to_regclass(?))", index.name).Scan(&definition).Error; errRead != nil {
+		t.Fatal(errRead)
+	}
+	if !strings.Contains(definition, "DESC") {
+		t.Fatalf("wrong index was replaced without authority: %s", definition)
+	}
+}
diff --git a/internal/cluster/reporting_scale_metrics_test.go b/internal/cluster/reporting_scale_metrics_test.go
new file mode 100644
index 0000000..f8ab7e1
--- /dev/null
+++ b/internal/cluster/reporting_scale_metrics_test.go
@@ -0,0 +1,66 @@
+package cluster
+
+import (
+	"context"
+	"encoding/json"
+	"net"
+	"net/http"
+	"os"
+	"testing"
+)
+
+type reportingResources struct {
+	CPU       uint64
+	Anonymous uint64
+	FileCache uint64
+}
+
+// Optional fixture-only counters exclude the test host and SQL EXPLAIN instrumentation.
+func reportingResourceSample(t *testing.T) reportingResources {
+	t.Helper()
+	socket, container := os.Getenv("POOL_TEST_DOCKER_SOCKET"), os.Getenv("POOL_TEST_CONTAINER")
+	if socket == "" || container == "" {
+		return reportingResources{}
+	}
+	client := &http.Client{Transport: &http.Transport{DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
+		return (&net.Dialer{}).DialContext(ctx, "unix", socket)
+	}}}
+	defer client.CloseIdleConnections()
+	response, errGet := client.Get("http://docker/containers/" + container + "/stats?stream=false&one-shot=true")
+	if errGet != nil {
+		t.Fatal(errGet)
+	}
+	defer func() {
+		if errClose := response.Body.Close(); errClose != nil {
+			t.Error(errClose)
+		}
+	}()
+	var stats struct {
+		CPU struct {
+			Usage struct {
+				Total uint64 `json:"total_usage"`
+			} `json:"cpu_usage"`
+		} `json:"cpu_stats"`
+		Memory struct {
+			Stats map[string]uint64 `json:"stats"`
+		} `json:"memory_stats"`
+	}
+	if errDecode := json.NewDecoder(response.Body).Decode(&stats); errDecode != nil {
+		t.Fatal(errDecode)
+	}
+	return reportingResources{CPU: stats.CPU.Usage.Total, Anonymous: stats.Memory.Stats["anon"], FileCache: stats.Memory.Stats["file"]}
+}
+
+func reportingOperatorMemory(plan map[string]any) (float64, float64) {
+	peak, disk := numberFromPlan(plan, "Peak Memory Usage"), numberFromPlan(plan, "Disk Usage")
+	if children, ok := plan["Plans"].([]any); ok {
+		for _, child := range children {
+			p, d := reportingOperatorMemory(child.(map[string]any))
+			if p > peak {
+				peak = p
+			}
+			disk += d
+		}
+	}
+	return peak, disk
+}
diff --git a/internal/cluster/reporting_scale_postgres_test.go b/internal/cluster/reporting_scale_postgres_test.go
new file mode 100644
index 0000000..2b8cd2a
--- /dev/null
+++ b/internal/cluster/reporting_scale_postgres_test.go
@@ -0,0 +1,178 @@
+package cluster
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+
+	"gorm.io/gorm"
+	"gorm.io/gorm/logger"
+)
+
+type reportingSQLCapture struct {
+	logger.Interface
+	statements []string
+}
+
+func (capture *reportingSQLCapture) Trace(_ context.Context, _ time.Time, statement func() (string, int64), _ error) {
+	sql, _ := statement()
+	if strings.HasPrefix(sql, "SELECT") || strings.HasPrefix(sql, "DELETE") {
+		capture.statements = append(capture.statements, sql)
+	}
+}
+
+func reportingPlan(t *testing.T, db *gorm.DB, statement string) map[string]any {
+	t.Helper()
+	var raw string
+	if errPlan := db.Raw("EXPLAIN (ANALYZE,BUFFERS,MEMORY,FORMAT JSON) " + statement).Scan(&raw).Error; errPlan != nil {
+		t.Fatal(errPlan)
+	}
+	var plan []map[string]any
+	if errJSON := json.Unmarshal([]byte(raw), &plan); errJSON != nil {
+		t.Fatal(errJSON)
+	}
+	return plan[0]
+}
+
+func reportingScanRows(plan map[string]any) float64 {
+	var rows float64
+	if kind, _ := plan["Node Type"].(string); strings.Contains(kind, "Scan") {
+		rows = (numberFromPlan(plan, "Actual Rows") + numberFromPlan(plan, "Rows Removed by Filter")) * numberFromPlan(plan, "Actual Loops")
+	}
+	if children, ok := plan["Plans"].([]any); ok {
+		for _, child := range children {
+			rows += reportingScanRows(child.(map[string]any))
+		}
+	}
+	return rows
+}
+func numberFromPlan(plan map[string]any, key string) float64 {
+	value, _ := plan[key].(float64)
+	return value
+}
+
+// Focused, opt-in real-SQL load proof. Setup and backfill are excluded from steady-state work.
+func TestPoolReportingScaleMarginals(t *testing.T) {
+	for _, history := range []int{1000, 10000} {
+		for _, users := range []int{1, 10, 100} {
+			t.Run(fmt.Sprintf("users%d_history%d", users, history), func(t *testing.T) {
+				repo := newPostgresQuiescenceRepository(t)
+				db, errDB := repo.database()
+				if errDB != nil {
+					t.Fatal(errDB)
+				}
+				at := time.Date(2026, 11, 12, 12, 0, 0, 0, time.UTC)
+				for user := 1; user <= users; user++ {
+					if errCreate := db.Create(&APIKeyRecord{ID: uint(user), APIKey: fmt.Sprintf("fixture-%d", user)}).Error; errCreate != nil {
+						t.Fatal(errCreate)
+					}
+				}
+				if errDisable := db.Exec(`ALTER TABLE usage DISABLE TRIGGER usage_summary_pending_insert`).Error; errDisable != nil {
+					t.Fatal(errDisable)
+				}
+				if errSeed := db.Exec(`INSERT INTO usage(timestamp,api_key,auth_index,payload,created_at,failed)
+			 SELECT ?::timestamptz - interval '1 day', 'fixture-'||((n-1)%?+1), 'allowed',
+			 jsonb_build_object('diagnostic',repeat('x',16384)),?::timestamptz,false
+			 FROM generate_series(1,?::int) n`, at, users, at, users*history).Error; errSeed != nil {
+					t.Fatal(errSeed)
+				}
+				if errEnable := db.Exec(`ALTER TABLE usage ENABLE TRIGGER usage_summary_pending_insert`).Error; errEnable != nil {
+					t.Fatal(errEnable)
+				}
+				if errSeed := db.Exec(`INSERT INTO usage(timestamp,api_key,auth_index,payload,created_at,failed)
+			 SELECT ?::timestamptz + interval '1 minute', 'fixture-'||((n-1)%?+1), 'foreign',
+			 jsonb_build_object('diagnostic',repeat('x',16384)),?::timestamptz,false
+			 FROM generate_series(1,?::int) n`, at, users, at, users*40).Error; errSeed != nil {
+					t.Fatal(errSeed)
+				}
+				if errAnalyze := db.Exec(`ANALYZE usage; ANALYZE usage_summary_pending; ANALYZE api_key`).Error; errAnalyze != nil {
+					t.Fatal(errAnalyze)
+				}
+				capture := &reportingSQLCapture{Interface: logger.Discard}
+				repo.db = db.Session(&gorm.Session{Logger: capture})
+				ctx := context.Background()
+				var returnedBytes, rowsRead, bufferHits, bufferReads, peakOperatorKiB, spillKiB float64
+				var cpuNS uint64
+				resourcesBefore := reportingResourceSample(t)
+				peakAnonymous := resourcesBefore.Anonymous
+				queries, records := 0, 0
+				for {
+					capture.statements = nil
+					sampleBefore := reportingResourceSample(t)
+					rows, more, errRead := repo.ListPendingUsageSummaryRecords(ctx, at.Add(5*time.Minute))
+					sampleAfter := reportingResourceSample(t)
+					cpuNS += sampleAfter.CPU - sampleBefore.CPU
+					if sampleAfter.Anonymous > peakAnonymous {
+						peakAnonymous = sampleAfter.Anonymous
+					}
+					if errRead != nil {
+						t.Fatal(errRead)
+					}
+					if len(capture.statements) != 1 {
+						t.Fatalf("pending read emitted %d statements", len(capture.statements))
+					}
+					plan := reportingPlan(t, db, capture.statements[0])
+					node := plan["Plan"].(map[string]any)
+					peak, spill := reportingOperatorMemory(node)
+					if peak > peakOperatorKiB {
+						peakOperatorKiB = peak
+					}
+					spillKiB += spill
+					rowsRead += reportingScanRows(node)
+					bufferHits += numberFromPlan(node, "Shared Hit Blocks")
+					bufferReads += numberFromPlan(node, "Shared Read Blocks")
+					encoded, _ := json.Marshal(rows)
+					returnedBytes += float64(len(encoded))
+					records += len(rows)
+					queries++
+					ids := make([]UsageSummaryPendingRecord, 0, len(rows))
+					for _, row := range rows {
+						ids = append(ids, UsageSummaryPendingRecord{UsageID: row.UsageID, Token: row.SummaryPendingToken})
+					}
+					if len(ids) > 0 {
+						sampleBefore = reportingResourceSample(t)
+						if errAck := repo.AcknowledgeUsageSummaryRecords(ctx, ids); errAck != nil {
+							t.Fatal(errAck)
+						}
+						sampleAfter = reportingResourceSample(t)
+						cpuNS += sampleAfter.CPU - sampleBefore.CPU
+						queries++
+					}
+					if !more {
+						break
+					}
+				}
+				if records != users*40 {
+					t.Fatalf("drained %d, want %d", records, users*40)
+				}
+				capture.statements = nil
+				checksBefore := reportingResourceSample(t)
+				for user := 1; user <= users; user++ {
+					found, errFind := repo.FirstSuccessfulKeyUsage(ctx, uint(user), at, []string{"allowed"})
+					if errFind != nil || found != nil {
+						t.Fatalf("first success = %v %v", found, errFind)
+					}
+				}
+				checksAfter := reportingResourceSample(t)
+				if len(capture.statements) != users {
+					t.Fatalf("pending checks emitted %d queries for %d users", len(capture.statements), users)
+				}
+				checkPlan := reportingPlan(t, db, capture.statements[0])
+				metrics := map[string]any{"users": users, "history_per_user": history, "new_requests": records, "source_queries": queries,
+					"queries_per_user": float64(queries) / float64(users), "queries_per_request": float64(queries) / float64(records),
+					"returned_bytes_per_user": returnedBytes / float64(users), "returned_bytes_per_request": returnedBytes / float64(records),
+					"scan_rows_per_user": rowsRead / float64(users), "scan_rows_per_request": rowsRead / float64(records),
+					"shared_hit_blocks": bufferHits, "shared_read_blocks": bufferReads, "first_success_plan": checkPlan,
+					"database_cpu_ns_per_user": float64(cpuNS) / float64(users), "database_cpu_ns_per_request": float64(cpuNS) / float64(records),
+					"first_success_cpu_ns_per_user": float64(checksAfter.CPU-checksBefore.CPU) / float64(users),
+					"anonymous_bytes_before":        resourcesBefore.Anonymous, "anonymous_bytes_after": checksAfter.Anonymous, "sampled_peak_anonymous_bytes": peakAnonymous,
+					"operator_peak_kib": peakOperatorKiB, "operator_spill_kib": spillKiB}
+				encoded, _ := json.Marshal(metrics)
+				t.Logf("REPORTING_SCALE %s", encoded)
+			})
+		}
+	}
+}
