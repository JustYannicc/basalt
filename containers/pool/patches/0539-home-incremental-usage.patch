+	"time"
+)
+
+func TestUsageSummaryPendingSurvivesLateCommitAndIdempotentAcknowledgement(t *testing.T) {
+	repo := newPostgresQuiescenceRepository(t)
+	db, errDB := repo.database()
+	if errDB != nil {
+		t.Fatal(errDB)
+	}
+	ctx := context.Background()
+	at := time.Date(2026, 11, 12, 12, 0, 0, 0, time.UTC)
+	late := db.Begin()
+	defer func() {
+		if errRollback := late.Rollback().Error; errRollback != nil && !errors.Is(errRollback, sql.ErrTxDone) {
+			t.Error(errRollback)
+		}
+	}()
+	first := UsageRecord{Timestamp: at.Add(-6 * time.Hour), AuthIndex: "first", PayloadJSON: JSONB(`{}`)}
+	if errCreate := late.Create(&first).Error; errCreate != nil {
+		t.Fatal(errCreate)
+	}
+	second := UsageRecord{Timestamp: at, AuthIndex: "second", PayloadJSON: JSONB(`{}`)}
+	if errCreate := db.Create(&second).Error; errCreate != nil {
+		t.Fatal(errCreate)
+	}
+	rows, more, errRead := repo.ListPendingUsageSummaryRecords(ctx, at.Add(time.Hour))
+	if errRead != nil || more || len(rows) != 1 || rows[0].UsageID != second.ID {
+		t.Fatalf("visible pending = %v %v %v", rows, more, errRead)
+	}
+	for range 2 {
+		if errAck := repo.AcknowledgeUsageSummaryRecords(ctx, []UsageSummaryPendingRecord{{UsageID: second.ID, Token: rows[0].SummaryPendingToken}}); errAck != nil {
+			t.Fatal(errAck)
+		}
+	}
+	if errCommit := late.Commit().Error; errCommit != nil {
+		t.Fatal(errCommit)
+	}
+	rows, more, errRead = repo.ListPendingUsageSummaryRecords(ctx, at.Add(time.Hour))
+	if errRead != nil || more || len(rows) != 1 || rows[0].UsageID != first.ID {
+		t.Fatalf("late pending = %v %v %v", rows, more, errRead)
+	}
+	if errDelete := db.Delete(&first).Error; errDelete != nil {
+		t.Fatal(errDelete)
+	}
+	var pending int64
+	if errCount := db.Model(&UsageSummaryPendingRecord{}).Count(&pending).Error; errCount != nil || pending != 0 {
+		t.Fatalf("pending count = %d %v", pending, errCount)
+	}
+}
+
+func TestUsageSummaryPendingRollsBackWithSourceAndRetainsFutureRows(t *testing.T) {
+	ctx := context.Background()
+	repo, closeRepo := newBillingTestRepository(t, ctx)
+	defer closeRepo()
+	db, errDB := repo.database()
+	if errDB != nil {
+		t.Fatal(errDB)
+	}
+	at := time.Date(2026, 11, 12, 12, 0, 0, 0, time.UTC)
+	tx := db.Begin()
+	row := UsageRecord{Timestamp: at, PayloadJSON: JSONB(`{}`)}
+	if errCreate := tx.Create(&row).Error; errCreate != nil {
+		t.Fatal(errCreate)
+	}
+	if errRollback := tx.Rollback().Error; errRollback != nil {
+		t.Fatal(errRollback)
+	}
+	future := UsageRecord{Timestamp: at.Add(time.Hour), PayloadJSON: JSONB(`{}`)}
+	if errCreate := db.Create(&future).Error; errCreate != nil {
+		t.Fatal(errCreate)
+	}
+	rows, _, errRead := repo.ListPendingUsageSummaryRecords(ctx, at)
+	if errRead != nil || len(rows) != 0 {
+		t.Fatalf("early read = %v %v", rows, errRead)
+	}
+	rows, _, errRead = repo.ListPendingUsageSummaryRecords(ctx, at.Add(2*time.Hour))
+	if errRead != nil || len(rows) != 1 || rows[0].UsageID != future.ID {
+		t.Fatalf("future read = %v %v", rows, errRead)
+	}
+}
+
+func TestUsageSummaryRepairCannotBeAcknowledgedByAnEarlierRead(t *testing.T) {
+	for _, backend := range []string{"sqlite", "postgres"} {
+		t.Run(backend, func(t *testing.T) {
+			ctx := context.Background()
