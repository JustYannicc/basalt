@@ -0,0 +1,62 @@
+package home
+
+import (
+	"context"
+	"fmt"
+	"testing"
+	"time"
+
+	coreauth "github.com/router-for-me/CLIProxyAPIHome/internal/cliproxy/auth"
+)
+
+// The node reports a 429 through the usage queue with no body and no headers, only the closed
+// number fail.retry_after_ms taken from the provider's own retry time. Home ends the cooldown
+// then; a missing, zero or unparsable number means the provider gave no time.
+func TestRecordUsagePayloadEndsTheCooldownAtTheProviderRetryTime(t *testing.T) {
+	payload := func(index string, retry string) string {
+		fail := `"status_code": 429`
+		if retry != "" {
+			fail += `, "retry_after_ms": ` + retry
+		}
+		return fmt.Sprintf(`{"auth_index": %q, "provider": "claude", "model": "claude-opus-5-5", "failed": true, "fail": {%s}}`, index, fail)
+	}
+	cooling := func(t *testing.T, id, retry string) time.Duration {
+		t.Helper()
+		auth := &coreauth.Auth{ID: id, Index: id, Provider: "claude", Status: coreauth.StatusActive,
+			ModelStates: map[string]*coreauth.ModelState{"claude-opus-5-5": {Quota: coreauth.QuotaState{BackoffLevel: 11}}}}
+		rt := newUsageResultTestRuntime(t, auth)
+		before := time.Now()
+		rt.RecordUsagePayload(context.Background(), payload(id, retry))
+		got, ok := rt.coreManager.GetByID(id)
+		if !ok || got == nil || got.ModelStates["claude-opus-5-5"] == nil {
+			t.Fatalf("%s: no model state after the 429", id)
+		}
+		return got.ModelStates["claude-opus-5-5"].NextRetryAfter.Sub(before)
+	}
+	if got := cooling(t, "timed", "90000"); got < 89*time.Second || got > 91*time.Second {
+		t.Fatalf("a Claude 429 with the provider's 90 s cooled for %s", got)
+	}
+	for _, retry := range []string{"", "0", "-5", `"90000"`, "1.5e12", "90000.5"} {
+		if got := cooling(t, "untimed"+retry, retry); got < 29*time.Minute {
+			t.Fatalf("retry_after_ms %q was taken as a provider time: cooled %s", retry, got)
+		}
+	}
+}
+
+// A body whose reset has already passed gives no time, so it never hides the node's number.
+func TestRecordUsagePayloadPrefersTheNodeTimeOverAPassedBodyReset(t *testing.T) {
+	id := "codex-stale-reset"
+	auth := &coreauth.Auth{ID: id, Index: id, Provider: "codex", Status: coreauth.StatusActive,
+		ModelStates: map[string]*coreauth.ModelState{"gpt-5": {Quota: coreauth.QuotaState{BackoffLevel: 11}}}}
+	rt := newUsageResultTestRuntime(t, auth)
+	passed := time.Now().Add(-time.Hour).Unix()
+	before := time.Now()
+	rt.RecordUsagePayload(context.Background(), fmt.Sprintf(`{"auth_index": %q, "provider": "codex", "model": "gpt-5", "failed": true, "fail": {"status_code": 429, "retry_after_ms": 90000, "body": "{\"error\":{\"type\":\"usage_limit_reached\",\"resets_at\":%d}}"}}`, id, passed))
+	got, ok := rt.coreManager.GetByID(id)
+	if !ok || got == nil || got.ModelStates["gpt-5"] == nil {
+		t.Fatal("no model state after the 429")
+	}
+	if cooled := got.ModelStates["gpt-5"].NextRetryAfter.Sub(before); cooled < 89*time.Second || cooled > 91*time.Second {
+		t.Fatalf("a passed body reset hid the node's 90 s: cooled %s", cooled)
+	}
+}
