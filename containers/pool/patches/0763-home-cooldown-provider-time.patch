+package auth
+
+import (
+	"context"
+	"testing"
+	"testing/synctest"
+	"time"
+)
+
+// A quota cooldown ends when the provider says, for every provider, and never later on the blind
+// backoff; the backoff only decides when the provider gives no time.
+func TestBasaltCooldownEndsAtTheProviderTime(t *testing.T) {
+	now := time.Date(2026, 11, 22, 16, 0, 0, 0, time.UTC)
+	ninety := 90 * time.Second
+	threeDays := 72 * time.Hour
+	tiny := 100 * time.Millisecond
+	short := 5 * time.Second
+	reset := now.Add(2 * time.Hour)
+	cases := []struct {
+		name   string
+		quota  QuotaState
+		result Result
+		want   time.Duration
+		level  int
+	}{
+		{"a Claude retry time ends a high backoff at that time", QuotaState{BackoffLevel: 11}, Result{Provider: "claude", RetryAfter: &ninety}, ninety, 11},
+		{"a Claude reset ends the cooldown at the reset", QuotaState{}, Result{Provider: "claude", ResetAt: &reset}, 2 * time.Hour, 1},
+		{"a really limited account stays out until the provider's time", QuotaState{BackoffLevel: 2}, Result{Provider: "claude", RetryAfter: &threeDays}, threeDays, 3},
+		{"a short provider time never undercuts the escalating backoff", QuotaState{BackoffLevel: 11}, Result{Provider: "codex", RetryAfter: &tiny}, quotaBackoffMax, 11},
+		{"a short provider time still waits at least that long", QuotaState{}, Result{Provider: "claude", RetryAfter: &short}, short, 1},
+		{"without a provider time the backoff still grows", QuotaState{BackoffLevel: 3}, Result{Provider: "claude"}, 8 * time.Second, 4},
+		{"without a provider time a high level still waits the cap", QuotaState{BackoffLevel: 11}, Result{Provider: "claude"}, quotaBackoffMax, 11},
+	}
+	for _, c := range cases {
+		deadline, level := quotaCooldownAfterFailure(c.quota, now, c.result)
+		if got := deadline.Sub(now); got != c.want || level != c.level {
+			t.Errorf("%s: cools %s at level %d, want %s at level %d", c.name, got, level, c.want, c.level)
+		}
+	}
+
+	// Two limits can hold at once: a shorter time from another 429 never shortens an open window.
+	open := QuotaState{Exceeded: true, NextRecoverAt: now.Add(time.Hour), BackoffLevel: 4}
+	five := 5 * time.Second
+	if deadline, level := quotaCooldownAfterFailure(open, now, Result{Provider: "claude", RetryAfter: &five}); !deadline.Equal(open.NextRecoverAt) || level != 4 {
+		t.Errorf("a shorter provider time shortened an open window to %s at level %d", deadline.Sub(now), level)
+	}
+	// A provider that keeps saying "retry in a second" while still refusing is not called every
+	// second: the backoff keeps escalating, as upstream's own regression requires.
+	quota := QuotaState{}
+	at := now
+	one := time.Second
+	for index, want := range []time.Duration{time.Second, 2 * time.Second, 4 * time.Second, 8 * time.Second, 16 * time.Second} {
+		deadline, level := quotaCooldownAfterFailure(quota, at, Result{Provider: "claude", RetryAfter: &one})
+		if got := deadline.Sub(at); got != want {
+			t.Fatalf("a repeating 1 s provider time, failure %d: cooled %s, want %s", index+1, got, want)
+		}
+		quota = QuotaState{NextRecoverAt: deadline, BackoffLevel: level}
+		at = deadline.Add(time.Nanosecond)
+	}
+	later := now.Add(3 * time.Hour)
+	if deadline, _ := quotaCooldownAfterFailure(open, now, Result{Provider: "claude", ResetAt: &later}); !deadline.Equal(later) {
+		t.Errorf("a later provider reset did not extend an open window: %s", deadline.Sub(now))
+	}
+}
+
+// End to end through MarkResult: a Claude account at a high backoff level is selectable again at
+// the provider's time.
+func TestBasaltClaudeCooldownEndsAtTheProviderRetryTime(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		ctx := context.Background()
+		manager := NewManager(nil, nil, nil)
+		account := &Auth{ID: "busy-claude", Provider: "claude", ModelStates: map[string]*ModelState{
+			"claude-opus-5-5": {Quota: QuotaState{BackoffLevel: 11}},
+		}}
+		if _, errRegister := manager.Register(ctx, account); errRegister != nil {
+			t.Fatalf("Register: %v", errRegister)
+		}
+		retry := 90 * time.Second
+		result := quotaResult(account.ID, "claude-opus-5-5")
+		result.Provider = "claude"
+		result.RetryAfter = &retry
+		manager.MarkResult(ctx, result)
+		time.Sleep(retry - time.Nanosecond)
+		current, _ := manager.GetByID(account.ID)
+		if blocked, _, _ := isAuthBlockedForModel(current, "claude-opus-5-5", time.Now()); !blocked {
+			t.Fatal("the account is selectable before the provider's time")
+		}
+		time.Sleep(time.Nanosecond)
+		current, _ = manager.GetByID(account.ID)
+		if blocked, _, next := isAuthBlockedForModel(current, "claude-opus-5-5", time.Now()); blocked {
+			t.Fatalf("at the provider's time the account is still cooling for another %s", next.Sub(time.Now()))
+		}
+	})
+}
