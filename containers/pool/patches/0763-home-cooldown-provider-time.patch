diff --git a/internal/home/usage_result.go b/internal/home/usage_result.go
index c2b9478..29031cb 100644
--- a/internal/home/usage_result.go
+++ b/internal/home/usage_result.go
@@ -2,12 +2,19 @@ package home
 
 import (
 	"context"
+	"math"
+	"net/http"
 	"strings"
+	"time"
 
 	coreauth "github.com/router-for-me/CLIProxyAPIHome/internal/cliproxy/auth"
 	"github.com/tidwall/gjson"
 )
 
+// usageRetryAfterMax is the longest provider retry time Home trusts from a node, the same horizon
+// it trusts any provider hint for; a longer one is treated as no time at all.
+const usageRetryAfterMax = 60 * 24 * time.Hour
+
 // RecordUsagePayload applies downstream usage status to the scheduler auth state.
 func (r *Runtime) RecordUsagePayload(ctx context.Context, payload string) {
 	// Validate input data before converting it into runtime state.
@@ -41,6 +48,27 @@ func (r *Runtime) RecordUsagePayload(ctx context.Context, payload string) {
 	body := gjson.Get(payload, "fail.body").String()
 
 	result := coreauth.NewUsageResult(authIndex, provider, model, statusCode, body)
+	// The node's number stands in for a body that gave no usable time; a reset already passed is none.
+	bodyReset := result.ResetAt != nil && result.ResetAt.After(time.Now())
+	bodyRetry := result.RetryAfter != nil && *result.RetryAfter > 0
+	if statusCode == http.StatusTooManyRequests && !bodyReset && !bodyRetry {
+		if retryAfter, ok := usageRetryAfter(gjson.Get(payload, "fail.retry_after_ms")); ok {
+			result.RetryAfter = &retryAfter
+		}
+	}
 	result.AccessTokenSHA256 = strings.TrimSpace(gjson.Get(payload, "access_token_sha256").String())
 	r.coreManager.MarkResult(ctx, result)
 }
+
+// usageRetryAfter reads the node's fail.retry_after_ms: the provider's own retry time for a 429,
+// as a whole positive number of milliseconds. Anything else means the provider gave no time.
+func usageRetryAfter(value gjson.Result) (time.Duration, bool) {
+	if value.Type != gjson.Number {
+		return 0, false
+	}
+	ms := value.Float()
+	if ms <= 0 || ms != math.Trunc(ms) || ms > float64(usageRetryAfterMax/time.Millisecond) {
+		return 0, false
+	}
+	return time.Duration(ms) * time.Millisecond, true
+}
diff --git a/internal/home/usage_retry_after_test.go b/internal/home/usage_retry_after_test.go
