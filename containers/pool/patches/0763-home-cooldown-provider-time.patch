@@ -980,25 +980,44 @@ func quotaCooldownAfterFailure(quota QuotaState, now time.Time, result Result) (
 		nextLevel = level
 	}
 
-	provider := strings.ToLower(strings.TrimSpace(result.Provider))
-	if provider != "antigravity" && provider != "codex" {
+	providerAt, given := providerQuotaTime(result, now)
+	if !given {
 		return deadline, nextLevel
 	}
-	if result.ResetAt != nil && result.ResetAt.After(now) {
-		resetAt := result.ResetAt.UTC()
-		if resetAt.Sub(now) <= providerQuotaHintMaxHorizon {
-			if resetAt.After(deadline) {
-				deadline = resetAt
-			}
-			return deadline, nextLevel
+	if windowOpen {
+		// Two limits can hold at once: another 429's time only ever extends an open window.
+		if providerAt.After(deadline) {
+			deadline = providerAt
 		}
+		return deadline, nextLevel
 	}
-	if result.RetryAfter != nil && *result.RetryAfter > 0 && *result.RetryAfter <= providerQuotaHintMaxHorizon {
-		if retryAt := now.Add(*result.RetryAfter); retryAt.After(deadline) {
-			deadline = retryAt
+	// A provider that keeps answering "retry in a moment" while still refusing would be called
+	// every second (#5265 upstream), so a short time only ever lengthens the escalating backoff.
+	if providerAt.Sub(now) < providerQuotaTimeTrustedFrom {
+		if providerAt.After(deadline) {
+			deadline = providerAt
 		}
+		return deadline, nextLevel
+	}
+	// A provider time of this length is authoritative, for every provider: the cooldown ends then
+	// and never later on the blind backoff, which decides only when the provider gives no time.
+	return providerAt, nextLevel
+}
+
+// providerQuotaTimeTrustedFrom is the shortest provider time that ends a cooldown exactly; the
+// same floor upstream puts on a pool's retry time.
+const providerQuotaTimeTrustedFrom = 10 * time.Second
+
+// providerQuotaTime is when the provider says a limited account may be used again: its reset,
+// else its retry delay, within the horizon a provider hint is trusted for.
+func providerQuotaTime(result Result, now time.Time) (time.Time, bool) {
+	if result.ResetAt != nil && result.ResetAt.After(now) && result.ResetAt.Sub(now) <= providerQuotaHintMaxHorizon {
+		return result.ResetAt.UTC(), true
+	}
+	if result.RetryAfter != nil && *result.RetryAfter > 0 && *result.RetryAfter <= providerQuotaHintMaxHorizon {
+		return now.Add(*result.RetryAfter), true
 	}
-	return deadline, nextLevel
+	return time.Time{}, false
 }
 
