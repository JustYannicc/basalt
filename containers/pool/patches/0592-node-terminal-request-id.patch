+func terminalRequestIDForSequence(base uuid.UUID, sequence uint64) string {
+	if sequence == 0 || sequence > maxTerminalRequestSequence {
+		return ""
+	}
+	tail := uint64(base[10])<<40 | uint64(base[11])<<32 | uint64(base[12])<<24 |
+		uint64(base[13])<<16 | uint64(base[14])<<8 | uint64(base[15])
+	tail = (tail + sequence) & maxTerminalRequestSequence
+	for index := 15; index >= 10; index-- {
+		base[index] = byte(tail)
+		tail >>= 8
+	}
+	return base.String()
