+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	core "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	coreusage "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/usage"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+)
+
+type codexDuplexTerminalUsage struct {
+	terminalRequestID string
+	record            coreusage.Record
+}
+
+type codexDuplexTerminalUsageCapture struct {
+	alias   string
+	records chan codexDuplexTerminalUsage
+}
+
+func (c *codexDuplexTerminalUsageCapture) HandleUsage(ctx context.Context, record coreusage.Record) {
+	if record.Alias != c.alias {
+		return
+	}
+	select {
+	case c.records <- codexDuplexTerminalUsage{
+		terminalRequestID: internallogging.TerminalRequestIDFromContext(ctx),
+		record:            record,
+	}:
+	default:
+	}
+}
+
+type codexDuplexTerminalUsageNoop struct{}
+
+func (codexDuplexTerminalUsageNoop) HandleUsage(context.Context, coreusage.Record) {}
+
+func (c *codexDuplexTerminalUsageCapture) await(t *testing.T) codexDuplexTerminalUsage {
+	t.Helper()
+	select {
+	case usage := <-c.records:
+		return usage
+	case <-time.After(5 * time.Second):
+		t.Fatal("timed out waiting for duplex usage record")
+		return codexDuplexTerminalUsage{}
+	}
+}
+
+func TestCodexDuplexSuccessorsKeepTerminalAndExecutionIDsSeparate(t *testing.T) {
+	const (
+		alias       = "codex-duplex-terminal-context-test"
+		initialID   = "018f3a5b-1234-7abc-def0-12345678abcd"
+		firstID     = "018f3a5b-1234-7abc-def0-12345678abce"
+		secondID    = "018f3a5b-1234-7abc-def0-12345678abcf"
+		traceID     = "node-trace-id"
+		initialResp = "resp-1"
+		firstResp   = "resp-2"
+		secondResp  = "resp-3"
+	)
+	capture := &codexDuplexTerminalUsageCapture{alias: alias, records: make(chan codexDuplexTerminalUsage, 4)}
+	coreusage.RegisterNamedPlugin(t.Name(), capture)
+	t.Cleanup(func() { coreusage.RegisterNamedPlugin(t.Name(), codexDuplexTerminalUsageNoop{}) })
+
+	serverDone := make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		defer close(serverDone)
+		conn, err := (&websocket.Upgrader{}).Upgrade(w, r, nil)
+		if err != nil {
+			t.Errorf("upgrade upstream websocket: %v", err)
+			return
+		}
+		defer conn.Close()
+		_ = conn.SetReadDeadline(time.Now().Add(10 * time.Second))
+		readRequest := func() []byte {
+			_, payload, errRead := conn.ReadMessage()
+			if errRead != nil {
+				t.Errorf("read upstream request: %v", errRead)
+			}
+			return payload
+		}
+		writeResponse := func(id string) {
+			for _, payload := range [][]byte{
+				[]byte(`{"type":"response.created","response":{"id":"` + id + `","output":[]}}`),
+				[]byte(`{"type":"response.completed","response":{"id":"` + id + `","output":[],"usage":{"input_tokens":2,"output_tokens":1,"total_tokens":3}}}`),
+			} {
+				if errWrite := conn.WriteMessage(websocket.TextMessage, payload); errWrite != nil {
+					t.Errorf("write upstream response: %v", errWrite)
+					return
+				}
+			}
+		}
+
+		if got := ojson.GetBytes(readRequest(), "type").String(); got != "response.create" {
+			t.Errorf("initial request type = %q", got)
+		}
+		writeResponse(initialResp)
+		if got := ojson.GetBytes(readRequest(), "type").String(); got != "response.create" {
+			t.Errorf("first successor type = %q", got)
+		}
+		writeResponse(firstResp)
+		if got := ojson.GetBytes(readRequest(), "type").String(); got != "response.create" {
+			t.Errorf("second successor type = %q", got)
+		}
+		writeResponse(secondResp)
+		_, _, _ = conn.ReadMessage()
+	}))
+	defer server.Close()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 12*time.Second)
+	defer cancel()
+	ctx = coreusage.WithRequestedModelAlias(ctx, alias)
