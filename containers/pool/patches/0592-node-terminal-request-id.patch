+	ctx = internallogging.WithTerminalRequestID(ctx, initialID)
+	input := make(chan core.WebsocketInput, 4)
+	ctx = core.WithWebsocketInput(core.WithDownstreamWebsocket(ctx), input)
+
+	exec := NewCodexWebsocketsExecutor(&config.Config{Codex: config.CodexConfig{ResponseSteering: true}})
+	exec.store = &codexWebsocketSessionStore{sessions: make(map[string]*codexWebsocketSession)}
+	auth := &cliproxyauth.Auth{ID: "terminal-id-test", Provider: "codex", Attributes: map[string]string{"api_key": "test-key", "base_url": server.URL, "websockets": "true"}}
+	req := core.Request{Model: "gpt-6-astra", Payload: []byte(`{"model":"gpt-6-astra","input":[]}`)}
+	opts := core.Options{SourceFormat: sdktranslator.FromString("codex"), Metadata: map[string]any{core.ExecutionSessionMetadataKey: "terminal-id-test"}}
+	result, err := exec.ExecuteStream(ctx, auth, req, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	started := make(map[string]bool)
+	completed := make(map[string]bool)
+	for len(completed) < 3 {
+		select {
+		case chunk, ok := <-result.Chunks:
+			if !ok {
+				t.Fatal("duplex stream ended before all responses")
+			}
+			if chunk.Err != nil {
+				t.Fatal(chunk.Err)
+			}
+			eventType := ojson.GetBytes(chunk.Payload, "type").String()
+			if eventType == "basalt.request_started" {
+				id := ojson.GetBytes(chunk.Payload, "request_id").String()
+				if id != firstID && id != secondID {
+					t.Fatalf("unexpected successor terminal ID %q", id)
+				}
+				if started[id] {
+					t.Fatalf("duplicate request-start marker for %q", id)
+				}
+				started[id] = true
+				continue
+			}
+			if eventType != "response.completed" {
+				continue
+			}
+			responseID := ojson.GetBytes(chunk.Payload, "response.id").String()
+			if completed[responseID] {
+				t.Fatalf("duplicate terminal response %q", responseID)
+			}
+			completed[responseID] = true
+			switch responseID {
+			case initialResp:
+				input <- core.WebsocketInput{Payload: []byte(`{"type":"response.create","model":"gpt-6-astra","input":[{"role":"user","content":"second turn"}]}`), TerminalRequestID: firstID}
+			case firstResp:
+				input <- core.WebsocketInput{Payload: []byte(`{"type":"response.create","model":"gpt-6-astra","input":[{"role":"user","content":"third turn"}]}`), TerminalRequestID: secondID}
+			case secondResp:
+				cancel()
+			default:
+				t.Fatalf("unexpected response ID %q", responseID)
+			}
+		case <-ctx.Done():
+			t.Fatal(ctx.Err())
+		}
+	}
+
+	if !started[firstID] || !started[secondID] {
+		t.Fatalf("successor markers = %v", started)
+	}
+	select {
+	case <-serverDone:
+	case <-time.After(3 * time.Second):
+		t.Fatal("upstream did not close")
+	}
+	for range result.Chunks {
+	}
+
+	usageRecords := make([]codexDuplexTerminalUsage, 0, 3)
+	for range 3 {
+		usageRecords = append(usageRecords, capture.await(t))
+	}
+	select {
+	case extra := <-capture.records:
+		t.Fatalf("unexpected extra usage record: %+v", extra)
+	default:
+	}
+	terminalByID := make(map[string]coreusage.Record, 3)
+	executionIDs := make(map[string]bool, 3)
+	for _, usage := range usageRecords {
+		if usage.record.RequestID == "" || usage.record.RequestID == usage.terminalRequestID || executionIDs[usage.record.RequestID] {
+			t.Fatalf("execution ID was replaced or reused: %+v", usage)
+		}
+		if usage.record.TraceID != traceID {
+			t.Fatalf("trace ID = %q, want %q", usage.record.TraceID, traceID)
+		}
+		if usage.record.HomeSelection == nil || usage.record.HomeSelection.Model != "home-route" {
+			t.Fatalf("home selection changed: %+v", usage.record.HomeSelection)
+		}
+		executionIDs[usage.record.RequestID] = true
+		terminalByID[usage.terminalRequestID] = usage.record
+	}
+	if len(terminalByID) != 3 || terminalByID[initialID].HomeSelection.Reused || !terminalByID[firstID].HomeSelection.Reused || !terminalByID[secondID].HomeSelection.Reused {
+		t.Fatalf("terminal IDs or reused-selection counts changed: %+v", terminalByID)
+	}
+}
