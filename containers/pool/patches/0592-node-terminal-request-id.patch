+
+func TestResponsesWebsocketInputTypeUsesFirstBoundedRootString(t *testing.T) {
+	tests := []struct {
+		name string
+		body string
+		want string
+	}{
+		{name: "root field", body: `{"type":" response.create\r\n","nested":{"type":"response.interrupt"}}`, want: "response.create"},
+		{name: "first duplicate wins", body: `{"type":"response.interrupt","type":"response.create"}`, want: "response.interrupt"},
+		{name: "escaped decoded length", body: `{"type":"` + strings.Repeat(`\u0020`, 240) + `\u0072\u0065\u0073\u0070\u006f\u006e\u0073\u0065\u002e\u0063\u0072\u0065\u0061\u0074\u0065"}`, want: "response.create"},
+		{name: "case sensitive key", body: `{"Type":"response.create"}`, want: ""},
+		{name: "non string", body: `{"type":4}`, want: ""},
+		{name: "untrimmed limit", body: `{"type":"` + strings.Repeat(" ", 250) + `response.create"}`, want: ""},
+		{name: "unicode whitespace remains", body: `{"type":" response.create "}`, want: " response.create "},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if got := responsesWebsocketInputType([]byte(test.body)); got != test.want {
+				t.Fatalf("input type = %q, want %q", got, test.want)
+			}
+		})
+	}
+}
+
+func TestTerminalRequestIDSequenceIsUniqueAndPreservesUUIDPrefix(t *testing.T) {
+	base := uuid.MustParse("018f3a5b-1234-7abc-def0-12345678abcd")
+	first, errFirst := uuid.Parse(terminalRequestIDForSequence(base, 1))
+	second, errSecond := uuid.Parse(terminalRequestIDForSequence(base, 2))
+	if errFirst != nil || errSecond != nil {
+		t.Fatalf("derived IDs were invalid UUIDs: %v / %v", errFirst, errSecond)
+	}
+	if first == second || first == base || second == base {
+		t.Fatal("sequence did not produce distinct IDs")
+	}
+	if !bytes.Equal(first[:10], base[:10]) || !bytes.Equal(second[:10], base[:10]) {
+		t.Fatal("sequence changed the UUID prefix")
+	}
+}
+
+func TestResponsesWebsocketTerminalProtocolIsAcknowledgedIn101(t *testing.T) {
+	const terminalID = "018f3a5b-1234-7abc-def0-12345678abcd"
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, err := responsesWebsocketUpgrader.Upgrade(w, r, websocketUpgradeHeaders(r))
+		if err != nil {
+			return
+		}
+		_ = conn.Close()
+	}))
+	defer server.Close()
+
+	requestHeader := http.Header{}
+	requestHeader.Set(internallogging.BasaltRequestIDHeader, terminalID)
+	client, response, err := (&websocket.Dialer{}).Dial("ws"+strings.TrimPrefix(server.URL, "http"), requestHeader)
+	if err != nil {
+		t.Fatalf("websocket upgrade failed: %v", err)
+	}
+	defer client.Close()
+	if response.StatusCode != http.StatusSwitchingProtocols {
+		t.Fatalf("status = %d, want 101", response.StatusCode)
+	}
+	if got := response.Header.Get(internallogging.BasaltTerminalProtocolHeader); got != "1" {
+		t.Fatalf("terminal protocol acknowledgement = %q, want 1", got)
+	}
+}
+
+func TestTerminalRequestClassifierDoesNotCopyIgnoredContent(t *testing.T) {
+	payload := []byte(`{"input":"` + strings.Repeat("x", 4<<20) + `","type":"response.create"}`)
+	result := testing.Benchmark(func(b *testing.B) {
+		b.ReportAllocs()
+		for i := 0; i < b.N; i++ {
+			if responsesWebsocketInputType(payload) != "response.create" {
+				b.Fatal("lost root request type")
+			}
+		}
+	})
+	if result.AllocedBytesPerOp() > 64<<10 {
+		t.Fatalf("request classifier allocated %d bytes for ignored content", result.AllocedBytesPerOp())
+	}
+}
