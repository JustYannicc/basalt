--- a/internal/logging/requestid.go
+++ b/internal/logging/requestid.go
@@ -12,6 +12,54 @@ import (
 // requestIDKey is the context key for storing/retrieving request IDs.
 type requestIDKey struct{}
 
+const (
+	BasaltRequestIDHeader        = "X-Basalt-Request-Id"
+	BasaltTerminalProtocolHeader = "X-Basalt-Terminal-Protocol"
+)
+
+type terminalRequestIDKey struct{}
+
+// ParseTerminalRequestID accepts only a canonical UUID supplied by the pool Worker.
+func ParseTerminalRequestID(value string) string {
+	value = strings.TrimSpace(value)
+	id, err := uuid.Parse(value)
+	if err != nil || id.String() != value {
+		return ""
+	}
+	return value
+}
+
+// WithTerminalRequestID tags one model execution without replacing the HTTP trace ID.
+func WithTerminalRequestID(ctx context.Context, requestID string) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	requestID = ParseTerminalRequestID(requestID)
+	if requestID == "" {
+		return ctx
+	}
+	return context.WithValue(ctx, terminalRequestIDKey{}, requestID)
+}
+
+// WithoutTerminalRequestID starts a new websocket response scope without inheriting its predecessor's ID.
+func WithoutTerminalRequestID(ctx context.Context) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	return context.WithValue(ctx, terminalRequestIDKey{}, "")
+}
+
+// TerminalRequestIDFromContext returns the Worker correlation ID for one model execution.
+func TerminalRequestIDFromContext(ctx context.Context) string {
+	if ctx == nil {
+		return ""
+	}
+	if id, ok := ctx.Value(terminalRequestIDKey{}).(string); ok {
+		return id
+	}
+	return ""
+}
+
 // ginRequestIDKey is the Gin context key for request IDs.
 const ginRequestIDKey = "__request_id__"
 
