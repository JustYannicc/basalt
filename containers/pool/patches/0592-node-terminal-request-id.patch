+package logging
+
+import (
+	"context"
+	"testing"
+)
+
+func TestTerminalRequestIDStaysSeparateFromTraceID(t *testing.T) {
+	const (
+		traceID    = "node-trace-id"
+		terminalID = "018f3a5b-1234-7abc-def0-12345678abcd"
+	)
+	ctx := WithRequestID(context.Background(), traceID)
+	ctx = WithTerminalRequestID(ctx, terminalID)
+
+	if got := TerminalRequestIDFromContext(ctx); got != terminalID {
+		t.Fatalf("terminal ID = %q, want %q", got, terminalID)
+	}
+	if got := GetRequestID(ctx); got != traceID {
+		t.Fatalf("trace ID = %q, want %q", got, traceID)
+	}
+	if got := TerminalRequestIDFromContext(WithoutTerminalRequestID(ctx)); got != "" {
+		t.Fatalf("cleared terminal ID = %q, want empty", got)
+	}
+}
+
+func TestParseTerminalRequestIDRequiresCanonicalUUID(t *testing.T) {
+	const valid = "018f3a5b-1234-7abc-def0-12345678abcd"
+	if got := ParseTerminalRequestID(valid); got != valid {
+		t.Fatalf("valid UUID = %q", got)
+	}
+	for _, candidate := range []string{"", "not-a-uuid", "018F3A5B-1234-7ABC-DEF0-12345678ABCD"} {
+		if got := ParseTerminalRequestID(candidate); got != "" {
+			t.Errorf("ParseTerminalRequestID(%q) = %q, want empty", candidate, got)
+		}
+	}
+}
