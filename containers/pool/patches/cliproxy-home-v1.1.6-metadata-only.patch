+
+func TestDiagnosticsPrivacyFallbackAndRequestLogs(t *testing.T) {
+	t.Setenv(cluster.DiagnosticsMetadataOnlyEnv, "1")
+	t.Chdir(t.TempDir())
+	if errMkdir := os.Mkdir("logs", 0700); errMkdir != nil {
+		t.Fatal(errMkdir)
+	}
+	secret := "fallback-body-and-auth-sentinel-274"
+	historical := `{"api_key":"` + secret + `","fail":{"status_code":400,"body":"` + secret + `"},"headers":{"Authorization":"` + secret + `"}}`
+	if errWrite := os.WriteFile("logs/usage.log", []byte(historical+"\n"), 0600); errWrite != nil {
+		t.Fatal(errWrite)
+	}
+	if errSanitize := SanitizeUsageLog(); errSanitize != nil {
+		t.Fatal(errSanitize)
+	}
+	if errAppend := appendUsageLog(historical); errAppend != nil {
+		t.Fatal(errAppend)
+	}
+	data, errRead := os.ReadFile("logs/usage.log")
+	if errRead != nil || strings.Contains(string(data), secret) {
+		t.Fatal("fallback log retained content")
+	}
+	requestFile := filepath.Join("logs", "node-2026-10-29T120000-req.log")
+	if errWrite := os.WriteFile(requestFile, []byte(secret), 0600); errWrite != nil {
+		t.Fatal(errWrite)
+	}
+	removed, errPurge := PurgeRequestLogs()
+	if errPurge != nil || removed != 1 {
+		t.Fatal("request file was not removed")
+	}
+	handleRequestLog(context.Background(), dispatch.Env{}, []string{"rpush", "request-log", `{"request_log":"` + secret + `"}`})
+	entries, errDir := os.ReadDir("logs")
+	if errDir != nil || len(entries) != 1 || entries[0].Name() != "usage.log" {
+		t.Fatal("request log push created a file")
+	}
+}
