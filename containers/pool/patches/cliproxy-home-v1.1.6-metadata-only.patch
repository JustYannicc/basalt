+
+func seedPrivacyHistory(t *testing.T, db *gorm.DB, count int) APIKeyRecord {
+	t.Helper()
+	key := APIKeyRecord{APIKey: "history-live-key-sentinel-518"}
+	if errCreate := db.Create(&key).Error; errCreate != nil {
+		t.Fatal(errCreate)
+	}
+	rows := make([]UsageRecord, count)
+	for index := range rows {
+		rows[index] = UsageRecord{Timestamp: time.Now().UTC(), APIKey: key.APIKey, FailBody: "historical-body-sentinel-729",
+			Failed: true, TotalTokens: 7, FailStatusCode: 400,
+			PayloadJSON: JSONB(`{"api_key":"` + key.APIKey + `","failed":true,"fail":{"body":"historical-body-sentinel-729","status_code":400}}`)}
+	}
+	if errCreate := db.CreateInBatches(rows, 20).Error; errCreate != nil {
+		t.Fatal(errCreate)
+	}
+	return key
+}
+
+func privacyStep(t *testing.T, db *gorm.DB) diagnosticsPrivacyMigrationRecord {
+	t.Helper()
+	var step diagnosticsPrivacyMigrationRecord
+	if errRead := db.First(&step, "name = ?", diagnosticPrivacyStepName).Error; errRead != nil {
+		t.Fatal(errRead)
+	}
+	return step
+}
+
+func TestDiagnosticsPrivacyDoesNotPurgeDuringStartupAndResumesCommittedBatch(t *testing.T) {
+	t.Setenv(DiagnosticsMetadataOnlyEnv, "0")
+	db := privacyTestDB(t)
+	const count = diagnosticsPrivacyBatchSize*2 + 3
+	key := seedPrivacyHistory(t, db, count)
+	t.Setenv(DiagnosticsMetadataOnlyEnv, "1")
+	if errMigrate := AutoMigrate(db); errMigrate != nil {
+		t.Fatal(errMigrate)
+	}
+	var exposed int64
+	if errCount := db.Model(&UsageRecord{}).Where("fail_body <> ''").Count(&exposed).Error; errCount != nil || exposed != count {
+		t.Fatal("startup ran the historical purge")
+	}
+	var output bytes.Buffer
+	previous := log.StandardLogger().Out
+	log.SetOutput(&output)
+	t.Cleanup(func() { log.SetOutput(previous) })
+	repo := NewRepository(db)
+	for index := 0; index < 10; index++ {
+		if _, errBatch := repo.RunDiagnosticsPrivacyBatch(t.Context()); errBatch != nil {
+			t.Fatal(errBatch)
+		}
+		if privacyStep(t, db).LastUsageID > 0 {
+			break
+		}
+	}
+	partial := privacyStep(t, db)
+	if partial.UsageRowsUpdated != diagnosticsPrivacyBatchSize || partial.Completed {
+		t.Fatal("batch was not bounded and committed before completion")
+	}
+	var audit diagnosticsPrivacyAuditRecord
+	if errRead := db.First(&audit, "name = ?", partial.Name).Error; errRead != nil || audit.RowsScanned != diagnosticsPrivacyBatchSize || audit.MatchedActiveAPIKeyCopies != 2*diagnosticsPrivacyBatchSize {
+		t.Fatal("audit and scrub did not commit together")
+	}
+	if strings.Contains(output.String(), "POOL_PRIVACY_AUDIT ") {
+		t.Fatal("completion marker was emitted during a partial purge")
+	}
+	stopped, cancel := context.WithCancel(t.Context())
+	cancel()
+	if _, errStopped := repo.RunDiagnosticsPrivacyBatch(stopped); !errors.Is(errStopped, context.Canceled) {
+		t.Fatal("cancelled worker advanced its journal")
+	}
+	// A new repository instance has no in-memory cursor or accumulated counts.
+	if errResume := runDiagnosticsMetadataOnlyPrivacyMigration(t.Context(), db); errResume != nil {
+		t.Fatal(errResume)
+	}
+	if errRead := db.First(&audit, "name = ?", partial.Name).Error; errRead != nil {
+		t.Fatal(errRead)
+	}
+	if audit.RowsScanned != count || audit.MatchedActiveAPIKeyCopies != count*2 || audit.ActiveAPIKeyCount != 1 {
+		t.Fatal("resume lost or duplicated the durable audit counts")
+	}
+	if errAgain := runDiagnosticsMetadataOnlyPrivacyMigration(t.Context(), db); errAgain != nil {
+		t.Fatal(errAgain)
+	}
+	if strings.Count(output.String(), "POOL_PRIVACY_AUDIT ") != 1 {
+		t.Fatal("completion marker was missing or duplicated")
+	}
+	var stored []UsageRecord
+	if errFind := db.Find(&stored).Error; errFind != nil || len(stored) != count {
+		t.Fatal("purge dropped historical usage")
+	}
+	assertPrivateBytesAbsent(t, stored, key.APIKey, "historical-body-sentinel-729")
+	assertPrivateBytesAbsent(t, output.String(), key.APIKey, "historical-body-sentinel-729")
+}
+
+func TestDiagnosticsPrivacyFailedBatchRollsBackAuditAndCursor(t *testing.T) {
+	t.Setenv(DiagnosticsMetadataOnlyEnv, "0")
+	db := privacyTestDB(t)
+	seedPrivacyHistory(t, db, 3)
+	t.Setenv(DiagnosticsMetadataOnlyEnv, "1")
+	if errPrepare := prepareDiagnosticsPrivacyStep(t.Context(), db, diagnosticPrivacyStepName); errPrepare != nil {
+		t.Fatal(errPrepare)
+	}
+	for index := 0; index < 2; index++ {
+		if _, errBatch := runDiagnosticsPrivacyAPIKeyBatch(t.Context(), db, diagnosticPrivacyStepName); errBatch != nil {
+			t.Fatal(errBatch)
+		}
+	}
+	var updates int
+	const callback = "privacy_fail_second_usage_update"
+	if errRegister := db.Callback().Update().Before("gorm:update").Register(callback, func(tx *gorm.DB) {
+		if tx.Statement.Table == "usage" {
+			updates++
+			if updates == 2 {
+				tx.AddError(errors.New("fixture private database error 872"))
+			}
+		}
+	}); errRegister != nil {
+		t.Fatal(errRegister)
+	}
+	_, errBatch := runDiagnosticsPrivacyUsageBatch(t.Context(), db, diagnosticPrivacyStepName)
+	db.Callback().Update().Remove(callback)
+	if errBatch == nil {
+		t.Fatal("failed update did not stop the batch")
+	}
+	step := privacyStep(t, db)
+	if step.LastUsageID != 0 || step.UsageRowsUpdated != 0 {
+		t.Fatal("failed batch advanced the cursor")
+	}
+	var audits, keys int64
+	if errCount := db.Model(&diagnosticsPrivacyAuditRecord{}).Count(&audits).Error; errCount != nil || audits != 0 {
+		t.Fatal("failed batch committed audit counts")
+	}
+	if errCount := db.Model(&diagnosticsPrivacyAuditKeyRecord{}).Count(&keys).Error; errCount != nil || keys != 0 {
+		t.Fatal("failed batch committed distinct-key counts")
+	}
+	if errResume := runDiagnosticsMetadataOnlyPrivacyMigration(t.Context(), db); errResume != nil {
+		t.Fatal(errResume)
+	}
+}
+
+// Used by focused migration tests; serving uses one batch per maintenance turn.
+func runDiagnosticsMetadataOnlyPrivacyMigration(ctx context.Context, db *gorm.DB) error {
+	if errPrepare := prepareDiagnosticsMetadataOnlyPrivacyMigration(ctx, db); errPrepare != nil {
+		return errPrepare
+	}
+	for {
+		result, errBatch := NewRepository(db).RunDiagnosticsPrivacyBatch(ctx)
+		if errBatch != nil || result.Done {
+			return errBatch
+		}
+	}
+}
+
+func TestDiagnosticsPrivacySnapshotImportQueuesBoundedHistoricalWork(t *testing.T) {
+	t.Setenv(DiagnosticsMetadataOnlyEnv, "0")
+	source := privacyTestDB(t)
+	key := seedPrivacyHistory(t, source, 3)
+	path := filepath.Join(t.TempDir(), "privacy-snapshot.zip")
+	if _, errExport := ExportDatabaseSnapshot(t.Context(), source, DatabaseSnapshotExportOptions{Path: path}); errExport != nil {
+		t.Fatal(errExport)
+	}
+	snapshot, errOpen := OpenDatabaseSnapshot(t.Context(), path)
+	if errOpen != nil {
+		t.Fatal(errOpen)
+	}
+	defer snapshot.Close()
+	target := openDatabaseSnapshotSQLiteRawTestDB(t, filepath.Join(t.TempDir(), "restored.db"))
+	t.Setenv(DiagnosticsMetadataOnlyEnv, "1")
+	if _, errImport := ImportDatabaseSnapshot(t.Context(), target, snapshot, nil); errImport != nil {
+		t.Fatal(errImport)
+	}
+	var pending []diagnosticsPrivacyMigrationRecord
+	if errRead := target.Find(&pending).Error; errRead != nil || len(pending) != 1 || pending[0].UsageMaxID != 3 || pending[0].Completed {
+		t.Fatal("restore did not queue the imported rows for background cleanup")
+	}
+	if errResume := runDiagnosticsMetadataOnlyPrivacyMigration(t.Context(), target); errResume != nil {
+		t.Fatal(errResume)
+	}
+	var restored []UsageRecord
+	if errRead := target.Find(&restored).Error; errRead != nil || len(restored) != 3 {
+		t.Fatal("restore lost historical usage")
+	}
+	assertPrivateBytesAbsent(t, restored, key.APIKey, "historical-body-sentinel-729")
+}
