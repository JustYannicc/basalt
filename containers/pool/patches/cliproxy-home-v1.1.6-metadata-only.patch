+func diagnosticsPrivacySnapshotStepName(manifest DatabaseSnapshotManifest) string {
+	var identity strings.Builder
+	identity.WriteString(fmt.Sprint(manifest.FormatVersion))
+	for _, table := range manifest.Tables {
+		identity.WriteByte('\n')
+		identity.WriteString(table.Name)
+		identity.WriteByte(':')
+		identity.WriteString(table.SHA256)
+	}
+	digest := sha256.Sum256([]byte(identity.String()))
+	return fmt.Sprintf("diagnostics_metadata_only_snapshot_%x", digest[:])
+}
