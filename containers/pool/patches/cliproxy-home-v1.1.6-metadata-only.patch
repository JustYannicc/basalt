+// PurgeRequestLogs removes request logs left by earlier Home versions when
+// metadata-only diagnostics is enabled.
+func PurgeRequestLogs() (int, error) {
+	if !cluster.DiagnosticsMetadataOnlyEnabled() {
+		return 0, nil
+	}
+	logFilesMu.Lock()
+	defer logFilesMu.Unlock()
+	entries, errRead := os.ReadDir("logs")
+	if errRead != nil {
+		if os.IsNotExist(errRead) {
+			return 0, nil
+		}
+		return 0, fmt.Errorf("read request log directory")
+	}
+	removed := 0
+	for _, entry := range entries {
+		if !requestLogFilenamePattern.MatchString(entry.Name()) {
+			continue
+		}
+		info, errInfo := entry.Info()
+		if errInfo != nil {
+			if os.IsNotExist(errInfo) {
+				continue
+			}
+			return removed, fmt.Errorf("inspect request log file")
+		}
+		if !info.Mode().IsRegular() {
+			continue
+		}
+		if errRemove := os.Remove(filepath.Join("logs", entry.Name())); errRemove != nil {
+			if os.IsNotExist(errRemove) {
+				continue
+			}
+			return removed, fmt.Errorf("remove request log file")
+		}
+		removed++
+	}
+	return removed, nil
+}
