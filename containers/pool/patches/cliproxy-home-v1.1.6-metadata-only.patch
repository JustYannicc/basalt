+package cluster
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	log "github.com/sirupsen/logrus"
+	"github.com/tidwall/gjson"
+	"gorm.io/gorm"
+)
+
+func privacyTestDB(t *testing.T) *gorm.DB {
+	t.Helper()
+	db, errOpen := OpenSQLite(t.Context(), filepath.Join(t.TempDir(), "home.db"))
+	if errOpen != nil {
+		t.Fatal("open fixture database", errOpen)
+	}
+	handle, errDB := db.DB()
+	if errDB != nil {
+		t.Fatal(errDB)
+	}
+	t.Cleanup(func() {
+		if errClose := handle.Close(); errClose != nil {
+			t.Error(errClose)
+		}
+	})
+	if errMigrate := AutoMigrate(db); errMigrate != nil {
+		t.Fatal("migrate fixture", errMigrate)
+	}
+	return db
+}
+
+func assertPrivateBytesAbsent(t *testing.T, value any, secrets ...string) {
+	t.Helper()
+	encoded, errMarshal := json.Marshal(value)
+	if errMarshal != nil {
+		t.Fatal(errMarshal)
+	}
+	for _, secret := range secrets {
+		if bytes.Contains(encoded, []byte(secret)) {
+			t.Fatal("diagnostic projection retained a private sentinel")
+		}
+	}
+}
+
+func TestDiagnosticsPrivacyProjectionAndFingerprintIdentity(t *testing.T) {
+	t.Setenv(DiagnosticsMetadataOnlyEnv, "1")
+	db := privacyTestDB(t)
+	repo := NewRepository(db)
+	key := APIKeyRecord{APIKey: "client-credential-sentinel-818"}
+	if errCreate := db.Create(&key).Error; errCreate != nil {
+		t.Fatal(errCreate)
+	}
+	input := `{"timestamp":"2026-10-29T12:00:00Z","provider":"openai","model":"gpt-4.1","auth_index":"account-1","auth_type":"api_key","request_id":"4aac2bb8-00d3-4bf2-ae6c-b3178dca1940","api_key":"client-credential-sentinel-818","failed":true,"latency_ms":72,"service_tier":"priority","fail":{"status_code":400,"body":"private-response-sentinel-729"},"prompt":"private-prompt-sentinel-630","headers":{"Authorization":"Bearer upstream-sentinel-541"},"tokens":{"total_tokens":0}}`
+	record, errRecord := repo.AppendUsageWithRuntime(t.Context(), input, UsageRuntimeMetadata{})
+	if errRecord != nil {
+		t.Fatal("append private-mode usage", errRecord)
+	}
+	secrets := []string{key.APIKey, "private-response-sentinel-729", "private-prompt-sentinel-630", "upstream-sentinel-541"}
+	assertPrivateBytesAbsent(t, record, secrets...)
+	if record.FailBody != "" || record.FailStatusCode != 400 || record.LatencyMS != 72 || record.ServiceTier != "priority" {
+		t.Fatal("safe metadata was lost")
+	}
+	fingerprint := DiagnosticAPIKeyFingerprint(key.APIKey)
+	if record.APIKey != fingerprint {
+		t.Fatal("key was not fingerprinted")
+	}
+	ok, errValidate := repo.ValidateAPIKey(t.Context(), fingerprint)
+	if errValidate != nil || ok {
+		t.Fatal("fingerprint authenticated")
+	}
+	ok, errValidate = repo.ValidateAPIKey(t.Context(), key.APIKey)
+	if errValidate != nil || !ok {
+		t.Fatal("raw authentication credential stopped working")
+	}
+	matched, errLookup := billingAPIKeyByValue(t.Context(), db, fingerprint)
+	if errLookup != nil || matched == nil || matched.ID != key.ID {
+		t.Fatal("billing identity lost")
+	}
+	var joined []struct {
+		ID    uint
+		KeyID uint
+	}
+	if errJoin := db.Table("usage").Select(`usage.id, api_key.id AS key_id`).Joins(usageObservabilityAPIKeyJoinSQL).Scan(&joined).Error; errJoin != nil {
+		t.Fatal(errJoin)
+	}
+	if len(joined) != 1 || joined[0].KeyID != key.ID {
+		t.Fatal("usage identity lost or duplicated")
+	}
+	twice, errSanitize := SanitizeUsagePayloadSecrets(string(record.PayloadJSON))
+	if errSanitize != nil || gjson.Get(twice, "api_key").String() != fingerprint {
+		t.Fatal("repeat sanitizer rehashed the fingerprint")
+	}
+	// A legacy raw key that looks like a fingerprint must still be hashed as a credential.
+	shaped := `{"api_key":"` + fingerprint + `"}`
+	safe, errSanitize := SanitizeUsagePayloadSecrets(shaped)
+	if errSanitize != nil || gjson.Get(safe, "api_key").String() != DiagnosticAPIKeyFingerprint(fingerprint) {
+		t.Fatal("raw prefix was trusted as metadata")
+	}
+	var stored UsageRecord
+	if errRead := db.First(&stored, record.ID).Error; errRead != nil {
+		t.Fatal(errRead)
+	}
+	assertPrivateBytesAbsent(t, stored, secrets...)
+}
+
+func TestDiagnosticsPrivacyAuditCountsOnlyAffectedDeletedKeys(t *testing.T) {
+	t.Setenv(DiagnosticsMetadataOnlyEnv, "0")
+	db := privacyTestDB(t)
+	for _, token := range []string{"affected-deleted-token", "unaffected-deleted-token"} {
+		key := APIKeyRecord{APIKey: token}
+		if err := db.Create(&key).Error; err != nil {
+			t.Fatal(err)
+		}
+		if err := db.Delete(&key).Error; err != nil {
+			t.Fatal(err)
+		}
+	}
+	payload := `{"timestamp":"2026-10-28T12:00:00Z","api_key":"affected-deleted-token","failed":true}`
+	if _, err := NewRepository(db).AppendUsageWithRuntime(t.Context(), payload, UsageRuntimeMetadata{}); err != nil {
+		t.Fatal(err)
+	}
+	counts, err := collectDiagnosticsPrivacyAudit(t.Context(), db)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if counts.DeletedAPIKeyCount != 1 || counts.UnknownKeyCount != 0 || len(counts.MatchedActiveAPIKeyIDs) != 0 {
+		t.Fatal("audit confused affected deleted credentials with unrelated or unknown keys")
+	}
+}
+
+func TestDiagnosticsPrivacyPurgeResumesAndPreservesCounters(t *testing.T) {
+	t.Setenv(DiagnosticsMetadataOnlyEnv, "0")
+	db := privacyTestDB(t)
+	key := APIKeyRecord{APIKey: "historical-client-sentinel-452"}
+	if errCreate := db.Create(&key).Error; errCreate != nil {
+		t.Fatal(errCreate)
+	}
+	body := "historical-response-sentinel-363"
+	payload := `{"timestamp":"2026-10-28T12:00:00Z","provider":"openai","model":"gpt-4.1","api_key":"` + key.APIKey + `","failed":true,"fail":{"status_code":400,"body":"` + body + `"},"tokens":{"total_tokens":7}}`
+	record, errAppend := NewRepository(db).AppendUsageWithRuntime(t.Context(), payload, UsageRuntimeMetadata{})
+	if errAppend != nil {
+		t.Fatal(errAppend)
+	}
+	if record.FailBody != body || record.APIKey != key.APIKey {
+		t.Fatal("fixture did not reproduce the legacy capture")
+	}
+	var logs bytes.Buffer
+	previous := log.StandardLogger().Out
+	previousFormatter := log.StandardLogger().Formatter
+	log.SetOutput(&logs)
+	log.SetFormatter(&log.JSONFormatter{})
+	t.Cleanup(func() { log.SetOutput(previous); log.SetFormatter(previousFormatter) })
+	t.Setenv(DiagnosticsMetadataOnlyEnv, "1")
+	if errPrepare := prepareDiagnosticsPrivacyStep(t.Context(), db, diagnosticPrivacyStepName); errPrepare != nil {
+		t.Fatal(errPrepare)
+	}
+	if errAudit := auditDiagnosticsPrivacyStep(t.Context(), db, diagnosticPrivacyStepName); errAudit != nil {
+		t.Fatal(errAudit)
+	}
+	if _, errBatch := runDiagnosticsPrivacyAPIKeyBatch(t.Context(), db, diagnosticPrivacyStepName); errBatch != nil {
+		t.Fatal(errBatch)
+	}
+	// Resume the immutable step from a committed partial batch as after a process failure.
+	if errResume := runDiagnosticsMetadataOnlyPrivacyMigration(t.Context(), db); errResume != nil {
+		t.Fatal(errResume)
+	}
+	var stored UsageRecord
+	if errRead := db.First(&stored, record.ID).Error; errRead != nil {
+		t.Fatal(errRead)
+	}
+	if stored.TotalTokens != 7 || stored.FailStatusCode != 400 || stored.ID != record.ID {
+		t.Fatal("purge changed counts or status")
+	}
+	assertPrivateBytesAbsent(t, stored, key.APIKey, body)
+	assertPrivateBytesAbsent(t, logs.String(), key.APIKey, body)
+	if !strings.Contains(logs.String(), "POOL_PRIVACY_AUDIT ") {
+		t.Fatal("safe audit marker missing")
+	}
+	if strings.Contains(logs.String(), "active_key_ids") {
+		t.Fatal("audit log contains key IDs")
+	}
+	var marker map[string]int64
+	for _, line := range strings.Split(logs.String(), "\n") {
+		message := gjson.Get(line, "msg").String()
+		if strings.HasPrefix(message, "POOL_PRIVACY_AUDIT ") {
+			if err := json.Unmarshal([]byte(strings.TrimPrefix(message, "POOL_PRIVACY_AUDIT ")), &marker); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	if marker["active_key_count"] != 1 || marker["matched_active_key_copies"] != 2 {
+		t.Fatal("audit did not report one active key and both diagnostic token copies")
+	}
+	var audit diagnosticsPrivacyAuditRecord
+	if errRead := db.First(&audit, "name = ?", diagnosticPrivacyStepName).Error; errRead != nil {
+		t.Fatal(errRead)
+	}
+	var ids []uint
+	if errDecode := json.Unmarshal(audit.MatchedActiveAPIKeyIDs, &ids); errDecode != nil || len(ids) != 1 || ids[0] != key.ID {
+		t.Fatal("affected active key ID missing")
+	}
+	before, errEncode := json.Marshal(stored)
+	if errEncode != nil {
+		t.Fatal(errEncode)
+	}
+	if errAgain := runDiagnosticsMetadataOnlyPrivacyMigration(context.Background(), db); errAgain != nil {
+		t.Fatal(errAgain)
+	}
+	var after UsageRecord
+	if errRead := db.First(&after, record.ID).Error; errRead != nil {
+		t.Fatal(errRead)
+	}
+	encoded, errEncode := json.Marshal(after)
+	if errEncode != nil || !bytes.Equal(before, encoded) {
+		t.Fatal("repeat step rewrote retained data")
+	}
+	var count int64
+	if errCount := db.Model(&UsageRecord{}).Count(&count).Error; errCount != nil || count != 1 {
+		t.Fatal("purge dropped or duplicated rows")
+	}
+	// Make the mode-off boundary explicit without wall-clock waits.
+	if !record.Timestamp.Equal(time.Date(2026, 10, 28, 12, 0, 0, 0, time.UTC)) {
+		t.Fatal("timestamp changed")
+	}
+}
