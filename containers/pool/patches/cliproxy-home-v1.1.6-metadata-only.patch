+package respserver
+
+import (
+	"context"
+	"net"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPIHome/internal/cluster"
+)
+
+func TestDiagnosticsPrivacyPurgeFailureRefusesConnections(t *testing.T) {
+	t.Setenv(cluster.DiagnosticsMetadataOnlyEnv, "1")
+	t.Chdir(t.TempDir())
+	if err := os.WriteFile("logs", []byte("private-content-sentinel"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	server := New("", nil)
+	local, peer := net.Pipe()
+	defer peer.Close()
+	go server.HandleConn(context.Background(), local)
+	_ = peer.SetReadDeadline(time.Now().Add(time.Second))
+	if _, err := peer.Read(make([]byte, 1)); err == nil {
+		t.Fatal("privacy purge failure accepted a connection")
+	} else if timeout, ok := err.(net.Error); ok && timeout.Timeout() {
+		t.Fatal("privacy purge failure did not close the connection")
+	}
+}
