diff --git a/internal/cluster/diagnostics_privacy.go b/internal/cluster/diagnostics_privacy.go
new file mode 100644
index 0000000..77bf368
--- /dev/null
+++ b/internal/cluster/diagnostics_privacy.go
@@ -0,0 +1,353 @@
+package cluster
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"math"
+	"net/http"
+	"os"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/tidwall/gjson"
+)
+
+const (
+	DiagnosticsMetadataOnlyEnv = "CLIPROXY_DIAGNOSTICS_METADATA_ONLY"
+	diagnosticPrivacyStepName  = "diagnostics_metadata_only_v1_1_6"
+)
+
+var (
+	diagnosticIdentifierPattern  = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.:/@+-]{0,255}$`)
+	diagnosticHeaderValuePattern = regexp.MustCompile(`^[A-Za-z0-9_.-]{1,64}$`)
+)
+
+// DiagnosticsMetadataOnlyEnabled reports whether diagnostic payloads must be
+// reduced to the closed metadata projection.
+func DiagnosticsMetadataOnlyEnabled() bool {
+	return strings.TrimSpace(os.Getenv(DiagnosticsMetadataOnlyEnv)) == "1"
+}
+
+// DiagnosticAPIKeyFingerprint returns the stable, non-authentication identity
+// used to attribute diagnostic usage to a client API key.
+func DiagnosticAPIKeyFingerprint(apiKey string) string {
+	apiKey = strings.TrimSpace(apiKey)
+	if apiKey == "" {
+		return ""
+	}
+	digest := sha256.Sum256([]byte(apiKey))
+	return "sha256:" + hex.EncodeToString(digest[:])
+}
+
+func diagnosticAPIKeyFingerprintFromPayload(payload string, fallbackRaw string) string {
+	var fields map[string]json.RawMessage
+	if json.Unmarshal([]byte(payload), &fields) == nil {
+		if fingerprint := decodeJSONFieldString(fields, "api_key_fingerprint"); isDiagnosticAPIKeyFingerprint(fingerprint) {
+			return "sha256:" + strings.ToLower(strings.TrimPrefix(strings.ToLower(fingerprint), "sha256:"))
+		}
+		if apiKey := decodeJSONFieldString(fields, "api_key"); apiKey != "" {
+			return DiagnosticAPIKeyFingerprint(apiKey)
+		}
+	}
+	return DiagnosticAPIKeyFingerprint(fallbackRaw)
+}
+
+func apiKeyFingerprintForWrite(apiKey string, currentFingerprint string) string {
+	if !DiagnosticsMetadataOnlyEnabled() && strings.TrimSpace(currentFingerprint) == "" {
+		return ""
+	}
+	return DiagnosticAPIKeyFingerprint(apiKey)
+}
+
+func isDiagnosticAPIKeyFingerprint(value string) bool {
+	value = strings.TrimSpace(value)
+	if len(value) != len("sha256:")+sha256.Size*2 || !strings.EqualFold(value[:len("sha256:")], "sha256:") {
+		return false
+	}
+	decoded, errDecode := hex.DecodeString(value[len("sha256:"):])
+	return errDecode == nil && len(decoded) == sha256.Size
+}
+
+func sanitizeUsagePayloadMetadataOnly(payload string) (string, error) {
+	quotaPayload, errQuota := sanitizeUsageQuotaHeaders(payload)
+	if errQuota != nil {
+		return "", errQuota
+	}
+	var fields map[string]json.RawMessage
+	if errDecode := json.Unmarshal([]byte(quotaPayload), &fields); errDecode != nil || fields == nil {
+		return "", fmt.Errorf("usage payload must be a json object")
+	}
+
+	projected := make(map[string]any, 16)
+	if raw := strings.TrimSpace(decodeJSONFieldString(fields, "timestamp")); raw != "" {
+		if timestamp, errTime := time.Parse(time.RFC3339Nano, raw); errTime == nil {
+			projected["timestamp"] = timestamp.UTC().Format(time.RFC3339Nano)
+		}
+	}
+	for field, maxLength := range map[string]int{
+		"provider":      80,
+		"executor_type": 128,
+		"model":         256,
+
+		"auth_index":  256,
+		"cpa_node_id": 128,
+	} {
+		if value := diagnosticIdentifier(decodeJSONFieldString(fields, field), maxLength); value != "" {
+			projected[field] = value
+		}
+	}
+	if value := diagnosticAuthType(decodeJSONFieldString(fields, "auth_type")); value != "" {
+		projected["auth_type"] = value
+	}
+	if requestID := diagnosticRequestID(decodeJSONFieldString(fields, "request_id")); requestID != "" {
+		projected["request_id"] = requestID
+	}
+	if sessionID := diagnosticSessionID(decodeJSONFieldString(fields, "session_id")); sessionID != "" {
+		projected["session_id"] = sessionID
+	}
+	if requestID := diagnosticRequestID(decodeJSONFieldString(fields, "upstream_request_id")); requestID != "" {
+		projected["upstream_request_id"] = requestID
+	}
+	serviceTier := decodeJSONFieldString(fields, "service_tier")
+	if serviceTier == "" {
+		serviceTier = decodeJSONFieldString(fields, "request_service_tier")
+	}
+	if value := diagnosticServiceTier(serviceTier); value != "" {
+		projected["service_tier"] = value
+	}
+	if value := diagnosticServiceTier(decodeJSONFieldString(fields, "response_service_tier")); value != "" {
+		projected["response_service_tier"] = value
+	}
+	if apiKey := diagnosticAPIKeyFingerprintFromPayload(quotaPayload, ""); apiKey != "" {
+		projected["api_key"] = apiKey
+		projected["api_key_fingerprint"] = apiKey
+	}
+	if eventType := normalizeUsageObservabilityEventType(decodeJSONFieldString(fields, "event_type")); eventType != "" {
+		projected["event_type"] = eventType
+	}
+	if endpoint := safeDiagnosticEndpoint(decodeJSONFieldString(fields, "endpoint")); endpoint != "" {
+		projected["endpoint"] = endpoint
+	}
+	if failed, ok := decodeJSONFieldBool(fields, "failed"); ok {
+		projected["failed"] = failed
+	}
+	if statusCode, ok := diagnosticStatusCode(gjson.Get(quotaPayload, "fail.status_code")); ok {
+		projected["fail"] = map[string]any{"status_code": statusCode}
+	}
+	if statusCode := usagePayloadInt(quotaPayload, "upstream_status_code", "upstream.status_code", "response.status_code"); statusCode >= 100 && statusCode <= 599 {
+		projected["upstream_status_code"] = statusCode
+	}
+	for _, field := range []string{"latency_ms", "ttft_ms"} {
+		if value, ok := diagnosticNonNegativeInteger(fields[field]); ok {
+			projected[field] = value
+		}
+	}
+	if tokens := diagnosticTokenFields(fields["tokens"]); len(tokens) > 0 {
+		projected["tokens"] = tokens
+	}
+	if accounting := diagnosticTokenAccounting(quotaPayload); accounting != nil {
+		projected["accounting_version"] = UsageTokenAccountingSchemaVersion
+		projected["token_breakdown"] = accounting
+	}
+	if headers := diagnosticQuotaHeaders(quotaPayload); len(headers) > 0 {
+		projected["quota_headers"] = headers
+	}
+
+	encoded, errMarshal := json.Marshal(projected)
+	if errMarshal != nil {
+		return "", fmt.Errorf("encode usage metadata projection: %w", errMarshal)
+	}
+	return string(encoded), nil
+}
+
+func decodeJSONFieldString(fields map[string]json.RawMessage, key string) string {
+	var value string
+	if errDecode := json.Unmarshal(fields[key], &value); errDecode != nil {
+		return ""
+	}
+	return strings.TrimSpace(value)
+}
+
+func decodeJSONFieldBool(fields map[string]json.RawMessage, key string) (bool, bool) {
+	var value bool
+	if errDecode := json.Unmarshal(fields[key], &value); errDecode != nil {
+		return false, false
+	}
+	return value, true
+}
+
+func diagnosticIdentifier(value string, maxLength int) string {
+	value = strings.TrimSpace(value)
+	if value == "" || len(value) > maxLength || !diagnosticIdentifierPattern.MatchString(value) {
+		return ""
+	}
+	return value
+}
+
+func safeDiagnosticEndpoint(value string) string {
+	switch strings.TrimSpace(value) {
+	case "/v1/chat/completions", "/v1/completions", "/v1/responses", "/v1/messages", "/v1/embeddings":
+		return strings.TrimSpace(value)
+	default:
+		return ""
+	}
+}
+
+func diagnosticStatusCode(value gjson.Result) (int64, bool) {
+	if !value.Exists() || value.Type != gjson.Number {
+		return 0, false
+	}
+	code := value.Int()
+	return code, code >= 100 && code <= 599
+}
+
+func diagnosticNonNegativeInteger(raw json.RawMessage) (int64, bool) {
+	if len(raw) == 0 {
+		return 0, false
+	}
+	var value json.Number
+	if errDecode := json.Unmarshal(raw, &value); errDecode == nil {
+		parsed, errParse := strconv.ParseInt(value.String(), 10, 64)
+		return parsed, errParse == nil && parsed >= 0
+	}
+	var numericString string
+	if errDecode := json.Unmarshal(raw, &numericString); errDecode != nil {
+		return 0, false
+	}
+	parsed, errParse := strconv.ParseInt(strings.TrimSpace(numericString), 10, 64)
+	return parsed, errParse == nil && parsed >= 0
+}
+
+func diagnosticTokenFields(raw json.RawMessage) map[string]any {
+	var fields map[string]json.RawMessage
+	if errDecode := json.Unmarshal(raw, &fields); errDecode != nil || fields == nil {
+		return nil
+	}
+	projected := make(map[string]any, len(fields))
+	for _, key := range []string{
+		"input_tokens", "output_tokens", "reasoning_tokens", "cached_tokens", "cache_read_tokens",
+		"cache_creation_tokens", "cache_write_tokens", "total_tokens",
+	} {
+		if value, ok := diagnosticNonNegativeInteger(fields[key]); ok {
+			projected[key] = value
+		}
+	}
+	if value, ok := decodeJSONFieldBool(fields, "cache_read_tokens_present"); ok {
+		projected["cache_read_tokens_present"] = value
+	}
+	if len(projected) == 0 {
+		return nil
+	}
+	return projected
+}
+
+func diagnosticTokenAccounting(payload string) *UsageTokenBreakdown {
+	var accounting struct {
+		Version   int                 `json:"accounting_version"`
+		Breakdown UsageTokenBreakdown `json:"token_breakdown"`
+	}
+	if errDecode := json.Unmarshal([]byte(payload), &accounting); errDecode != nil ||
+		accounting.Version != UsageTokenAccountingSchemaVersion ||
+		!accounting.Breakdown.Valid() {
+		return nil
+	}
+	return &accounting.Breakdown
+}
+
+func diagnosticQuotaHeaders(payload string) map[string]string {
+	if !strings.EqualFold(strings.TrimSpace(gjson.Get(payload, "provider").String()), "codex") {
+		return nil
+	}
+	result := gjson.Get(payload, "quota_headers")
+	if !result.IsObject() {
+		return nil
+	}
+	filtered := make(map[string]string)
+	for rawKey, rawValue := range result.Map() {
+		key := http.CanonicalHeaderKey(strings.TrimSpace(rawKey))
+		value := strings.TrimSpace(rawValue.String())
+
+		if !strings.HasPrefix(key, codexQuotaHeaderPrefix) {
+			continue
+		}
+		for _, suffix := range []string{"-Used-Percent", "-Window-Minutes", "-Reset-At", "-Reset-After-Seconds"} {
+			if !strings.HasSuffix(key, suffix) {
+				continue
+			}
+			group := strings.TrimSuffix(strings.TrimPrefix(key, codexQuotaHeaderPrefix), suffix)
+			if group != "Primary" && group != "Secondary" {
+				break
+			}
+			if quotaHeaderValueSafe(suffix, value) {
+				filtered[key] = value
+			}
+			break
+		}
+	}
+	return filtered
+}
+
+func quotaHeaderValueSafe(suffix string, value string) bool {
+	if len(value) == 0 || len(value) > 32 {
+		return false
+	}
+	switch suffix {
+	case "-Used-Percent":
+		parsed, errParse := strconv.ParseFloat(value, 64)
+		return errParse == nil && !math.IsInf(parsed, 0) && !math.IsNaN(parsed) && parsed >= 0 && parsed <= 100
+	case "-Window-Minutes":
+		parsed, errParse := strconv.ParseInt(value, 10, 64)
+		return errParse == nil && parsed > 0 && parsed <= 1000000
+	case "-Reset-At":
+		parsed, errParse := strconv.ParseInt(value, 10, 64)
+		return errParse == nil && parsed >= 0 && parsed <= 4102444800
+	case "-Reset-After-Seconds":
+		parsed, errParse := strconv.ParseInt(value, 10, 64)
+		return errParse == nil && parsed >= 0 && parsed <= 315576000
+	default:
+		return false
+	}
+}
+
+func diagnosticRequestID(value string) string {
+	value = strings.TrimSpace(value)
+	if len(value) == 8 {
+		if _, err := hex.DecodeString(value); err == nil {
+			return value
+		}
+	}
+	if id, err := uuid.Parse(value); err == nil && id.String() == value && (id.Version() == 4 || id.Version() == 7) {
+		return value
+	}
+	return ""
+}
+
+func diagnosticServiceTier(value string) string {
+	value = strings.ToLower(strings.TrimSpace(value))
+	switch value {
+	case "auto", "default", "standard", "priority", "flex", "fast":
+		return value
+	}
+	return ""
+}
+func diagnosticAuthType(value string) string {
+	switch value {
+	case "oauth", "api_key", "provider_api_key", "file_auth", "vertex":
+		return value
+	}
+	return ""
+}
+
+func diagnosticSessionID(value string) string {
+	value = strings.TrimSpace(value)
+	id, errParse := uuid.Parse(value)
+	if errParse != nil || id.String() != strings.ToLower(value) {
+		return ""
+	}
+	return id.String()
+}
diff --git a/internal/cluster/diagnostics_privacy_audit.go b/internal/cluster/diagnostics_privacy_audit.go
new file mode 100644
index 0000000..9d75b35
--- /dev/null
+++ b/internal/cluster/diagnostics_privacy_audit.go
@@ -0,0 +1,147 @@
+package cluster
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"strconv"
+	"strings"
+
+	log "github.com/sirupsen/logrus"
+	"github.com/tidwall/gjson"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+// Distinct matches are journaled without retaining the raw token. Unknown
+// references are one-way fingerprints; active/deleted references are key IDs.
+type diagnosticsPrivacyAuditKeyRecord struct {
+	Name string `gorm:"column:name;primaryKey;size:192"`
+	Kind string `gorm:"column:kind;primaryKey;size:16"`
+	Ref  string `gorm:"column:ref;primaryKey;size:80"`
+}
+
+func (diagnosticsPrivacyAuditKeyRecord) TableName() string {
+	return "home_data_migration_audit_key"
+}
+
+func auditDiagnosticsPrivacyRows(tx *gorm.DB, name string, rows []UsageRecord) error {
+	if errEnsure := ensureDiagnosticsPrivacyAudit(tx, name); errEnsure != nil {
+		return errEnsure
+	}
+	tokens := make(map[string]struct{}, len(rows)*2)
+	for index := range rows {
+		for _, token := range []string{rows[index].APIKey, gjson.Get(string(rows[index].PayloadJSON), "api_key").String()} {
+			if token = strings.TrimSpace(token); token != "" {
+				tokens[token] = struct{}{}
+			}
+		}
+	}
+	values := make([]string, 0, len(tokens))
+	for token := range tokens {
+		values = append(values, token)
+	}
+	var keys []APIKeyRecord
+	if len(values) > 0 {
+		if errFind := tx.Unscoped().Select("id", "api_key", "deleted_at").Where("api_key IN ?", values).Find(&keys).Error; errFind != nil {
+			return errFind
+		}
+	}
+	byToken := make(map[string]APIKeyRecord, len(keys))
+	for index := range keys {
+		byToken[strings.TrimSpace(keys[index].APIKey)] = keys[index]
+	}
+	counts := diagnosticsPrivacyAuditCounts{RowsScanned: int64(len(rows))}
+	matches := make(map[diagnosticsPrivacyAuditKeyRecord]struct{})
+	for index := range rows {
+		payload := string(rows[index].PayloadJSON)
+		marker := strings.TrimSpace(gjson.Get(payload, "api_key_fingerprint").String())
+		for _, token := range []string{strings.TrimSpace(rows[index].APIKey), strings.TrimSpace(gjson.Get(payload, "api_key").String())} {
+			if token == "" {
+				continue
+			}
+			counts.TokenCopies++
+			if isDiagnosticAPIKeyFingerprint(marker) && strings.EqualFold(marker, token) {
+				counts.PrehashedTokenCopies++
+				continue
+			}
+			counts.RawTokenCopies++
+			kind, ref := "unknown", DiagnosticAPIKeyFingerprint(token)
+			if key, ok := byToken[token]; ok {
+				ref = strconv.FormatUint(uint64(key.ID), 10)
+				if key.DeletedAt.Valid {
+					kind = "deleted"
+				} else {
+					kind = "active"
+					counts.MatchedActiveAPIKeyCopies++
+				}
+			} else {
+				counts.UnmatchedRawTokenCopies++
+			}
+			matches[diagnosticsPrivacyAuditKeyRecord{Name: name, Kind: kind, Ref: ref}] = struct{}{}
+		}
+	}
+	for match := range matches {
+		insert := tx.Clauses(clause.OnConflict{DoNothing: true}).Create(&match)
+		if insert.Error != nil {
+			return insert.Error
+		}
+		switch match.Kind {
+		case "active":
+			counts.ActiveAPIKeyCount += insert.RowsAffected
+		case "deleted":
+			counts.DeletedAPIKeyCount += insert.RowsAffected
+		default:
+			counts.UnknownKeyCount += insert.RowsAffected
+		}
+	}
+
+	return tx.Model(&diagnosticsPrivacyAuditRecord{}).Where("name = ?", name).Updates(map[string]any{
+		"rows_scanned":                  gorm.Expr("rows_scanned + ?", counts.RowsScanned),
+		"token_copies":                  gorm.Expr("token_copies + ?", counts.TokenCopies),
+		"raw_token_copies":              gorm.Expr("raw_token_copies + ?", counts.RawTokenCopies),
+		"prehashed_token_copies":        gorm.Expr("prehashed_token_copies + ?", counts.PrehashedTokenCopies),
+		"matched_active_api_key_copies": gorm.Expr("matched_active_api_key_copies + ?", counts.MatchedActiveAPIKeyCopies),
+		"unmatched_raw_token_copies":    gorm.Expr("unmatched_raw_token_copies + ?", counts.UnmatchedRawTokenCopies),
+		"active_api_key_count":          gorm.Expr("active_api_key_count + ?", counts.ActiveAPIKeyCount),
+		"deleted_api_key_count":         gorm.Expr("deleted_api_key_count + ?", counts.DeletedAPIKeyCount),
+		"unknown_key_count":             gorm.Expr("unknown_key_count + ?", counts.UnknownKeyCount),
+	}).Error
+}
+
+func emitDiagnosticsPrivacyAuditMarker(ctx context.Context, db *gorm.DB, name string) error {
+	var line []byte
+	errClaim := diagnosticsPrivacyBatchTransaction(ctx, db, name, func(tx *gorm.DB, state *diagnosticsPrivacyMigrationRecord) error {
+		if !state.Completed || state.AuditMarkerEmitted {
+			return nil
+		}
+		var audit diagnosticsPrivacyAuditRecord
+		if errFind := tx.First(&audit, "name = ?", name).Error; errFind != nil {
+			return errFind
+		}
+		marker := struct {
+			UsageRows              int64 `json:"usage_rows"`
+			PurgedRows             int64 `json:"purged_rows"`
+			ActiveKeyCount         int64 `json:"active_key_count"`
+			MatchedActiveKeyCopies int64 `json:"matched_active_key_copies"`
+			DeletedKeyCount        int64 `json:"deleted_key_count"`
+			UnknownKeyCount        int64 `json:"unknown_key_count"`
+		}{audit.RowsScanned, state.UsageRowsUpdated, audit.ActiveAPIKeyCount,
+			audit.MatchedActiveAPIKeyCopies, audit.DeletedAPIKeyCount, audit.UnknownKeyCount}
+		var errEncode error
+		line, errEncode = json.Marshal(marker)
+		if errEncode != nil {
+			return errEncode
+		}
+		return tx.Model(state).Update("audit_marker_emitted", true).Error
+	})
+	if errClaim != nil {
+		return errors.New("privacy audit summary unavailable")
+	}
+	// Claim once before output so parallel Homes and later boots cannot duplicate
+	// the marker. The committed audit remains the receipt if the process dies here.
+	if len(line) > 0 {
+		log.Info("POOL_PRIVACY_AUDIT " + string(line))
+	}
+	return nil
+}
diff --git a/internal/cluster/diagnostics_privacy_identity.go b/internal/cluster/diagnostics_privacy_identity.go
new file mode 100644
index 0000000..8e9d488
--- /dev/null
+++ b/internal/cluster/diagnostics_privacy_identity.go
@@ -0,0 +1,48 @@
+package cluster
+
+import (
+	"context"
+	"errors"
+
+	"gorm.io/gorm"
+)
+
+// Legacy keys can be used immediately while the historical backfill is pending.
+// Normal lookups use the fingerprint index. A first use fills only its matching
+// credential, without treating a fingerprint as an authentication credential.
+func diagnosticAPIKeyByFingerprint(ctx context.Context, tx *gorm.DB, fingerprint string) (*APIKeyRecord, error) {
+	var record APIKeyRecord
+	query := tx.WithContext(ctx).Unscoped().Where("diagnostic_fingerprint = ?", fingerprint).First(&record)
+	if query.Error == nil {
+		return &record, nil
+	}
+	if !errors.Is(query.Error, gorm.ErrRecordNotFound) {
+		return nil, query.Error
+	}
+	var lastID uint
+	for {
+		var rows []APIKeyRecord
+		if errFind := tx.WithContext(ctx).Unscoped().Where("id > ? AND (diagnostic_fingerprint IS NULL OR diagnostic_fingerprint = '')", lastID).
+			Order("id").Limit(diagnosticsPrivacyBatchSize).Find(&rows).Error; errFind != nil {
+			return nil, errFind
+		}
+		if len(rows) == 0 {
+			return nil, nil
+		}
+		for index := range rows {
+			lastID = rows[index].ID
+			if DiagnosticAPIKeyFingerprint(rows[index].APIKey) != fingerprint {
+				continue
+			}
+			updated := tx.Unscoped().Model(&APIKeyRecord{}).Where("id = ? AND api_key = ?", rows[index].ID, rows[index].APIKey).
+				Update("diagnostic_fingerprint", fingerprint)
+			if updated.Error != nil {
+				return nil, updated.Error
+			}
+			if updated.RowsAffected > 0 {
+				rows[index].DiagnosticFingerprint = fingerprint
+				return &rows[index], nil
+			}
+		}
+	}
+}
diff --git a/internal/cluster/diagnostics_privacy_journal.go b/internal/cluster/diagnostics_privacy_journal.go
new file mode 100644
index 0000000..e15b29d
--- /dev/null
+++ b/internal/cluster/diagnostics_privacy_journal.go
@@ -0,0 +1,173 @@
+package cluster
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+	gormlogger "gorm.io/gorm/logger"
+)
+
+const (
+	diagnosticsPrivacyBatchSize       = 100
+	diagnosticsPrivacyBatchTimeout    = 5 * time.Second
+	diagnosticsPrivacyAdvisoryLockKey = int64(749327842680272319)
+	diagnosticFingerprintDisplay      = "sha256:…"
+	diagnosticPrivacyMatchBasis       = "stored usage token equals a currently active api_key.api_key value; this is not evidence of external authentication use"
+)
+
+type diagnosticsPrivacyMigrationRecord struct {
+	UsageMaxID               uint      `gorm:"column:usage_max_id;not null;default:0"`
+	APIKeyMaxID              uint      `gorm:"column:api_key_max_id;not null;default:0"`
+	BillingChargeMaxID       string    `gorm:"column:billing_charge_max_id;not null;default:''"`
+	Name                     string    `gorm:"column:name;primaryKey;size:192"`
+	LastAPIKeyID             uint      `gorm:"column:last_api_key_id;not null;default:0"`
+	LastUsageID              uint      `gorm:"column:last_usage_id;not null;default:0"`
+	LastBillingChargeID      string    `gorm:"column:last_billing_charge_id;not null;default:''"`
+	APIKeysDone              bool      `gorm:"column:api_keys_done;not null;default:false"`
+	UsageDone                bool      `gorm:"column:usage_done;not null;default:false"`
+	BillingChargesDone       bool      `gorm:"column:billing_charges_done;not null;default:false"`
+	Completed                bool      `gorm:"column:completed;not null;default:false;index:idx_home_data_migration_completed"`
+	AuditMarkerEmitted       bool      `gorm:"column:audit_marker_emitted;not null;default:false"`
+	APIKeyRowsUpdated        int64     `gorm:"column:api_key_rows_updated;not null;default:0"`
+	UsageRowsUpdated         int64     `gorm:"column:usage_rows_updated;not null;default:0"`
+	BillingChargeRowsUpdated int64     `gorm:"column:billing_charge_rows_updated;not null;default:0"`
+	UpdatedAt                time.Time `gorm:"column:updated_at;not null"`
+}
+
+func (diagnosticsPrivacyMigrationRecord) TableName() string {
+	return "home_data_migration"
+}
+
+type diagnosticsPrivacyAuditRecord struct {
+	Name                         string    `gorm:"column:name;primaryKey;size:192"`
+	RowsScanned                  int64     `gorm:"column:rows_scanned;not null;default:0"`
+	TokenCopies                  int64     `gorm:"column:token_copies;not null;default:0"`
+	RawTokenCopies               int64     `gorm:"column:raw_token_copies;not null;default:0"`
+	PrehashedTokenCopies         int64     `gorm:"column:prehashed_token_copies;not null;default:0"`
+	MatchedActiveAPIKeyCopies    int64     `gorm:"column:matched_active_api_key_copies;not null;default:0"`
+	UnmatchedRawTokenCopies      int64     `gorm:"column:unmatched_raw_token_copies;not null;default:0"`
+	UnknownKeyCount              int64     `gorm:"column:unknown_key_count;not null;default:0"`
+	ActiveAPIKeyCount            int64     `gorm:"column:active_api_key_count;not null;default:0"`
+	DeletedAPIKeyCount           int64     `gorm:"column:deleted_api_key_count;not null;default:0"`
+	MatchedActiveAPIKeyIDs       JSONB     `gorm:"column:matched_active_api_key_ids;not null"`
+	ActiveKeyMatchInterpretation string    `gorm:"column:active_key_match_interpretation;not null;type:text"`
+	AuditedAt                    time.Time `gorm:"column:audited_at;not null"`
+}
+
+func (diagnosticsPrivacyAuditRecord) TableName() string {
+	return "home_data_migration_audit"
+}
+
+type diagnosticsPrivacyAuditCounts struct {
+	RowsScanned               int64
+	TokenCopies               int64
+	RawTokenCopies            int64
+	PrehashedTokenCopies      int64
+	MatchedActiveAPIKeyCopies int64
+	UnmatchedRawTokenCopies   int64
+	UnknownKeyCount           int64
+	ActiveAPIKeyCount         int64
+	DeletedAPIKeyCount        int64
+}
+
+func prepareDiagnosticsPrivacyStep(ctx context.Context, db *gorm.DB, name string) error {
+	name = strings.TrimSpace(name)
+	if db == nil || name == "" || len(name) > 192 || !strings.HasPrefix(name, "diagnostics_metadata_only_") {
+		return errors.New("invalid diagnostics privacy step")
+	}
+	var existing diagnosticsPrivacyMigrationRecord
+	query := db.WithContext(contextOrBackground(ctx)).Where("name = ?", name).Limit(1).Find(&existing)
+	if query.Error != nil || query.RowsAffected > 0 {
+		return query.Error
+	}
+	// Pin indexed upper bounds so live traffic cannot extend this historical job.
+	var usage UsageRecord
+	var key APIKeyRecord
+	var charge BillingChargeRecord
+	for _, query := range []*gorm.DB{
+		db.WithContext(ctx).Select("id").Order("id DESC").Limit(1).Find(&usage),
+		db.WithContext(ctx).Unscoped().Select("id").Order("id DESC").Limit(1).Find(&key),
+		db.WithContext(ctx).Select("id").Order("id DESC").Limit(1).Find(&charge),
+	} {
+		if query.Error != nil {
+			return query.Error
+		}
+	}
+	return db.WithContext(ctx).Clauses(clause.OnConflict{DoNothing: true}).Create(&diagnosticsPrivacyMigrationRecord{
+		Name: name, UsageMaxID: usage.ID, APIKeyMaxID: key.ID, BillingChargeMaxID: charge.ID,
+		UpdatedAt: time.Now().UTC(),
+	}).Error
+}
+
+func diagnosticsPrivacyBatchTransaction(ctx context.Context, db *gorm.DB, name string, run func(*gorm.DB, *diagnosticsPrivacyMigrationRecord) error) error {
+	ctx, cancel := context.WithTimeout(contextOrBackground(ctx), diagnosticsPrivacyBatchTimeout)
+	defer cancel()
+	return db.Session(&gorm.Session{Logger: gormlogger.Discard}).WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if errLimit := setDiagnosticsPrivacyTransactionLimits(tx, diagnosticsPrivacyBatchTimeout); errLimit != nil {
+			return errLimit
+		}
+		if errLock := lockDiagnosticsPrivacyMigration(tx); errLock != nil {
+			return errLock
+		}
+		var state diagnosticsPrivacyMigrationRecord
+		query := tx.WithContext(ctx).Where("name = ?", name)
+		if tx.Dialector != nil && tx.Dialector.Name() == "postgres" {
+			query = query.Clauses(clause.Locking{Strength: "UPDATE"})
+		}
+		if errFirst := query.First(&state).Error; errFirst != nil {
+			return errFirst
+		}
+		return run(tx.WithContext(ctx), &state)
+	})
+}
+
+func setDiagnosticsPrivacyTransactionLimits(tx *gorm.DB, timeout time.Duration) error {
+	if tx == nil || tx.Dialector == nil || tx.Dialector.Name() != "postgres" {
+		return nil
+	}
+	statementMs := timeout.Milliseconds()
+	if statementMs < 1000 {
+		statementMs = 1000
+	}
+	if statementMs > 30000 {
+		statementMs = 30000
+	}
+	if errSet := tx.Exec("SET LOCAL application_name = 'home-privacy-maintenance'").Error; errSet != nil {
+		return errSet
+	}
+	if errSet := tx.Exec("SET LOCAL lock_timeout = '2s'").Error; errSet != nil {
+		return errSet
+	}
+	return tx.Exec(fmt.Sprintf("SET LOCAL statement_timeout = '%dms'", statementMs)).Error
+}
+
+func lockDiagnosticsPrivacyMigration(tx *gorm.DB) error {
+	if tx == nil || tx.Dialector == nil || tx.Dialector.Name() != "postgres" {
+		return nil
+	}
+	return tx.Exec("SELECT pg_advisory_xact_lock(?)", diagnosticsPrivacyAdvisoryLockKey).Error
+}
+
+func completeDiagnosticsPrivacyStep(ctx context.Context, db *gorm.DB, name string) error {
+	return diagnosticsPrivacyBatchTransaction(ctx, db, name, func(tx *gorm.DB, state *diagnosticsPrivacyMigrationRecord) error {
+		if state.Completed {
+			return nil
+		}
+		if !state.APIKeysDone || !state.UsageDone || !state.BillingChargesDone {
+			return errors.New("privacy data step is incomplete")
+		}
+
+		if errAudit := ensureDiagnosticsPrivacyAudit(tx, name); errAudit != nil {
+			return errAudit
+		}
+		if errAudit := tx.Model(&diagnosticsPrivacyAuditRecord{}).Where("name = ?", name).Update("audited_at", time.Now().UTC()).Error; errAudit != nil {
+			return errAudit
+		}
+		return tx.Model(state).Updates(map[string]any{"completed": true, "updated_at": time.Now().UTC()}).Error
+	})
+}
diff --git a/internal/cluster/diagnostics_privacy_migration.go b/internal/cluster/diagnostics_privacy_migration.go
new file mode 100644
index 0000000..cd5b642
--- /dev/null
+++ b/internal/cluster/diagnostics_privacy_migration.go
@@ -0,0 +1,236 @@
+package cluster
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"time"
+
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+func runDiagnosticsPrivacyAPIKeyBatch(ctx context.Context, db *gorm.DB, name string) (int64, error) {
+	var updated int64
+	errTransaction := diagnosticsPrivacyBatchTransaction(ctx, db, name, func(tx *gorm.DB, state *diagnosticsPrivacyMigrationRecord) error {
+		if state.Completed || state.APIKeysDone {
+			return nil
+		}
+		var rows []APIKeyRecord
+		query := tx.WithContext(contextOrBackground(ctx)).Unscoped().Select("id", "api_key", "diagnostic_fingerprint").
+			Where("id > ? AND id <= ?", state.LastAPIKeyID, state.APIKeyMaxID).Order("id").Limit(diagnosticsPrivacyBatchSize)
+		if tx.Dialector != nil && tx.Dialector.Name() == "postgres" {
+			query = query.Clauses(clause.Locking{Strength: "UPDATE"})
+		}
+		if errFind := query.Find(&rows).Error; errFind != nil {
+			return errFind
+		}
+		if len(rows) == 0 {
+			return tx.Model(state).Updates(map[string]any{"api_keys_done": true, "updated_at": time.Now().UTC()}).Error
+		}
+		for index := range rows {
+			fingerprint := DiagnosticAPIKeyFingerprint(rows[index].APIKey)
+			if rows[index].DiagnosticFingerprint != fingerprint {
+				if errUpdate := tx.Model(&APIKeyRecord{}).Where("id = ?", rows[index].ID).Update("diagnostic_fingerprint", fingerprint).Error; errUpdate != nil {
+					return errUpdate
+				}
+				updated++
+			}
+		}
+		return tx.Model(state).Updates(map[string]any{
+			"last_api_key_id":      rows[len(rows)-1].ID,
+			"api_key_rows_updated": gorm.Expr("api_key_rows_updated + ?", updated),
+			"updated_at":           time.Now().UTC(),
+		}).Error
+	})
+	if errTransaction != nil {
+		return 0, errors.New("diagnostics privacy api key batch failed")
+	}
+	return updated, nil
+}
+
+func runDiagnosticsPrivacyUsageBatch(ctx context.Context, db *gorm.DB, name string) (int64, error) {
+	var updated int64
+	errTransaction := diagnosticsPrivacyBatchTransaction(ctx, db, name, func(tx *gorm.DB, state *diagnosticsPrivacyMigrationRecord) error {
+		if state.Completed || state.UsageDone {
+			return nil
+		}
+		var rows []UsageRecord
+		query := tx.WithContext(contextOrBackground(ctx)).Select("*").Where("id > ? AND id <= ?", state.LastUsageID, state.UsageMaxID).Order("id").Limit(diagnosticsPrivacyBatchSize)
+		if tx.Dialector != nil && tx.Dialector.Name() == "postgres" {
+			query = query.Clauses(clause.Locking{Strength: "UPDATE"})
+		}
+		if errFind := query.Find(&rows).Error; errFind != nil {
+			return errFind
+		}
+		if len(rows) == 0 {
+			return tx.Model(state).Updates(map[string]any{"usage_done": true, "updated_at": time.Now().UTC()}).Error
+		}
+		if errAudit := auditDiagnosticsPrivacyRows(tx, name, rows); errAudit != nil {
+			return errAudit
+		}
+		for index := range rows {
+			updates, errProjection := diagnosticsPrivacyUsageUpdates(&rows[index])
+			if errProjection != nil {
+				return errProjection
+			}
+			if errUpdate := tx.Model(&UsageRecord{}).Where("id = ?", rows[index].ID).Updates(updates).Error; errUpdate != nil {
+				return errUpdate
+			}
+			updated++
+		}
+		return tx.Model(state).Updates(map[string]any{
+			"last_usage_id":      rows[len(rows)-1].ID,
+			"usage_rows_updated": gorm.Expr("usage_rows_updated + ?", updated),
+			"updated_at":         time.Now().UTC(),
+		}).Error
+	})
+	if errTransaction != nil {
+		return 0, errors.New("diagnostics privacy usage batch failed")
+	}
+	return updated, nil
+}
+
+func diagnosticsPrivacyUsageUpdates(record *UsageRecord) (map[string]any, error) {
+	if record == nil {
+		return nil, errors.New("missing usage row")
+	}
+	payload, errSanitize := sanitizeUsagePayloadMetadataOnly(string(record.PayloadJSON))
+	if errSanitize != nil {
+		payload, errSanitize = sanitizeUsagePayloadMetadataOnly(diagnosticsPrivacyFallbackUsagePayload(record))
+		if errSanitize != nil {
+			return nil, errors.New("usage metadata projection failed")
+		}
+	}
+
+	apiKey := diagnosticAPIKeyFingerprintFromPayload(payload, record.APIKey)
+	if apiKey != "" {
+		payload, errSanitize = sjson.Set(payload, "api_key", apiKey)
+		if errSanitize != nil {
+			return nil, errors.New("usage key projection failed")
+		}
+		payload, errSanitize = sjson.Set(payload, "api_key_fingerprint", apiKey)
+		if errSanitize != nil {
+			return nil, errors.New("usage fingerprint projection failed")
+		}
+	}
+
+	requestID := diagnosticRequestID(gjson.Get(payload, "request_id").String())
+	upstreamRequestID := diagnosticRequestID(gjson.Get(payload, "upstream_request_id").String())
+	eventType := normalizeUsageObservabilityEventType(gjson.Get(payload, "event_type").String())
+	updates := map[string]any{
+		"api_key":               apiKey,
+		"payload":               JSONB(payload),
+		"fail_body":             "",
+		"fail":                  jsonbFromPayloadField(payload, "fail"),
+		"tokens":                jsonbFromPayloadField(payload, "tokens"),
+		"source":                "",
+		"provider":              diagnosticIdentifier(gjson.Get(payload, "provider").String(), 80),
+		"executor_type":         diagnosticIdentifier(gjson.Get(payload, "executor_type").String(), 128),
+		"model":                 diagnosticIdentifier(gjson.Get(payload, "model").String(), 256),
+		"alias":                 "",
+		"effort":                "",
+		"service_tier":          diagnosticServiceTier(gjson.Get(payload, "service_tier").String()),
+		"response_service_tier": diagnosticServiceTier(gjson.Get(payload, "response_service_tier").String()),
+		"endpoint":              safeDiagnosticEndpoint(gjson.Get(payload, "endpoint").String()),
+		"auth_type":             diagnosticIdentifier(gjson.Get(payload, "auth_type").String(), 80),
+		"auth_index":            diagnosticIdentifier(gjson.Get(payload, "auth_index").String(), 256),
+		"request_id":            requestID,
+		"session_id":            diagnosticSessionID(gjson.Get(payload, "session_id").String()),
+		"parent_session_id":     "",
+		"root_session_id":       diagnosticSessionID(gjson.Get(payload, "session_id").String()),
+		"upstream_request_id":   upstreamRequestID,
+		"event_type":            eventType,
+		"cpa_node_id":           diagnosticIdentifier(gjson.Get(payload, "cpa_node_id").String(), 128),
+		"cpa_ip":                "",
+		"cpa_port":              0,
+		"cpa_label":             "",
+	}
+	if statusCode, ok := diagnosticStatusCode(gjson.Get(payload, "fail.status_code")); ok {
+		updates["fail_status_code"] = statusCode
+	}
+	if statusCode := usagePayloadInt(payload, "upstream_status_code"); statusCode >= 100 && statusCode <= 599 {
+		updates["upstream_status_code"] = statusCode
+	}
+	return updates, nil
+}
+
+func diagnosticsPrivacyFallbackUsagePayload(record *UsageRecord) string {
+	fields := map[string]any{
+		"timestamp":            record.Timestamp.UTC().Format(time.RFC3339Nano),
+		"provider":             record.Provider,
+		"executor_type":        record.ExecutorType,
+		"model":                record.Model,
+		"auth_type":            record.AuthType,
+		"auth_index":           record.AuthIndex,
+		"request_id":           record.RequestID,
+		"api_key":              record.APIKey,
+		"failed":               record.Failed,
+		"latency_ms":           record.LatencyMS,
+		"ttft_ms":              record.TTFTMS,
+		"upstream_status_code": record.UpstreamStatusCode,
+		"tokens": map[string]any{
+			"input_tokens": record.InputTokens, "output_tokens": record.OutputTokens,
+			"reasoning_tokens": record.ReasoningTokens, "cached_tokens": record.CachedTokens,
+			"cache_read_tokens": record.CacheReadTokens, "cache_read_tokens_present": record.CacheReadTokensPresent,
+			"cache_creation_tokens": record.CacheCreationTokens, "total_tokens": record.TotalTokens,
+		},
+	}
+	if record.FailStatusCode >= 100 && record.FailStatusCode <= 599 {
+		fields["fail"] = map[string]any{"status_code": record.FailStatusCode}
+	}
+	encoded, errMarshal := json.Marshal(fields)
+	if errMarshal != nil {
+		return `{"timestamp":"1970-01-01T00:00:00Z"}`
+	}
+	return string(encoded)
+}
+
+func runDiagnosticsPrivacyBillingChargeBatch(ctx context.Context, db *gorm.DB, name string) (int64, error) {
+	var updated int64
+	errTransaction := diagnosticsPrivacyBatchTransaction(ctx, db, name, func(tx *gorm.DB, state *diagnosticsPrivacyMigrationRecord) error {
+		if state.Completed || state.BillingChargesDone {
+			return nil
+		}
+		var rows []BillingChargeRecord
+		query := tx.WithContext(contextOrBackground(ctx)).Select("id", "api_key_masked", "endpoint", "provider", "model", "original_model", "actual_model", "request_id").
+			Where("id > ? AND id <= ?", state.LastBillingChargeID, state.BillingChargeMaxID).Order("id").Limit(diagnosticsPrivacyBatchSize)
+		if tx.Dialector != nil && tx.Dialector.Name() == "postgres" {
+			query = query.Clauses(clause.Locking{Strength: "UPDATE"})
+		}
+		if errFind := query.Find(&rows).Error; errFind != nil {
+			return errFind
+		}
+		if len(rows) == 0 {
+			return tx.Model(state).Updates(map[string]any{"billing_charges_done": true, "updated_at": time.Now().UTC()}).Error
+		}
+		for index := range rows {
+			requestID := diagnosticRequestID(rows[index].RequestID)
+			updates := map[string]any{
+				"api_key_masked":  diagnosticFingerprintDisplay,
+				"request_summary": "",
+				"endpoint":        "",
+				"provider":        diagnosticIdentifier(rows[index].Provider, 80),
+				"model":           diagnosticIdentifier(rows[index].Model, 256),
+				"original_model":  diagnosticIdentifier(rows[index].OriginalModel, 256),
+				"actual_model":    diagnosticIdentifier(rows[index].ActualModel, 256),
+				"request_id":      requestID,
+			}
+			if errUpdate := tx.Model(&BillingChargeRecord{}).Where("id = ?", rows[index].ID).Updates(updates).Error; errUpdate != nil {
+				return errUpdate
+			}
+			updated++
+		}
+		return tx.Model(state).Updates(map[string]any{
+			"last_billing_charge_id":      rows[len(rows)-1].ID,
+			"billing_charge_rows_updated": gorm.Expr("billing_charge_rows_updated + ?", updated),
+			"updated_at":                  time.Now().UTC(),
+		}).Error
+	})
+	if errTransaction != nil {
+		return 0, errors.New("diagnostics privacy billing batch failed")
+	}
+	return updated, nil
+}
diff --git a/internal/cluster/diagnostics_privacy_postgres.go b/internal/cluster/diagnostics_privacy_postgres.go
new file mode 100644
index 0000000..22e1b2f
--- /dev/null
+++ b/internal/cluster/diagnostics_privacy_postgres.go
@@ -0,0 +1,405 @@
+package cluster
+
+import (
+	"context"
+	"errors"
+
+	"gorm.io/gorm"
+)
+
+const diagnosticsMetadataOnlyAPIKeyFunctionV1 = `
+CREATE OR REPLACE FUNCTION home_diagnostics_metadata_only_api_key_v1()
+RETURNS trigger
+LANGUAGE plpgsql
+AS $$
+BEGIN
+    IF COALESCE(btrim(NEW.api_key), '') = '' THEN
+        NEW.diagnostic_fingerprint := '';
+    ELSE
+        NEW.diagnostic_fingerprint := 'sha256:' || encode(sha256(convert_to(btrim(NEW.api_key), 'UTF8')), 'hex');
+    END IF;
+    RETURN NEW;
+END;
+$$;
+`
+
+const diagnosticsMetadataOnlyUsageFunctionV1 = `
+CREATE OR REPLACE FUNCTION home_diagnostics_metadata_only_usage_v1()
+RETURNS trigger
+LANGUAGE plpgsql
+AS $$
+DECLARE
+    v_raw jsonb;
+    v_clean jsonb := '{}'::jsonb;
+    v_tokens_raw jsonb;
+    v_tokens jsonb := '{}'::jsonb;
+    v_fail jsonb := '{}'::jsonb;
+    v_quota jsonb := '{}'::jsonb;
+    v_entry record;
+    v_text text;
+    v_key text;
+    v_suffix text;
+    v_group text;
+    v_api_key text;
+    v_status integer;
+    v_breakdown_raw jsonb;
+    v_input jsonb;
+    v_output jsonb;
+    v_in_total bigint;
+    v_in_uncached bigint;
+    v_in_read bigint;
+    v_in_write bigint;
+    v_out_total bigint;
+    v_out_non_reasoning bigint;
+    v_out_reasoning bigint;
+    v_unclassified bigint;
+    v_accounting_total bigint;
+    v_quality text;
+BEGIN
+    v_raw := CASE WHEN jsonb_typeof(NEW.payload) = 'object' THEN NEW.payload ELSE '{}'::jsonb END;
+    v_clean := jsonb_build_object(
+        'timestamp', to_char(NEW.timestamp AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.US"Z"')
+    );
+
+    v_text := COALESCE(NULLIF(btrim(v_raw->>'provider'), ''), NULLIF(btrim(NEW.provider), ''));
+    IF v_text ~ '^[A-Za-z0-9][A-Za-z0-9_.:/@+-]{0,79}$' THEN
+        v_clean := v_clean || jsonb_build_object('provider', v_text);
+        NEW.provider := v_text;
+    ELSE
+        NEW.provider := '';
+    END IF;
+
+    v_text := COALESCE(NULLIF(btrim(v_raw->>'executor_type'), ''), NULLIF(btrim(NEW.executor_type), ''));
+    IF v_text ~ '^[A-Za-z0-9][A-Za-z0-9_.:/@+-]{0,127}$' THEN
+        v_clean := v_clean || jsonb_build_object('executor_type', v_text);
+        NEW.executor_type := v_text;
+    ELSE
+        NEW.executor_type := '';
+    END IF;
+
+    v_text := COALESCE(NULLIF(btrim(v_raw->>'model'), ''), NULLIF(btrim(NEW.model), ''));
+    IF v_text ~ '^[A-Za-z0-9][A-Za-z0-9_.:/@+-]{0,255}$' THEN
+        v_clean := v_clean || jsonb_build_object('model', v_text);
+        NEW.model := v_text;
+    ELSE
+        NEW.model := '';
+    END IF;
+
+    NEW.alias := '';
+
+    v_text := COALESCE(NULLIF(btrim(v_raw->>'auth_type'), ''), NULLIF(btrim(NEW.auth_type), ''));
+    IF v_text IN ('oauth','api_key','provider_api_key','file_auth','vertex') THEN
+        v_clean := v_clean || jsonb_build_object('auth_type', v_text);
+        NEW.auth_type := v_text;
+    ELSE
+        NEW.auth_type := '';
+    END IF;
+
+    v_text := COALESCE(NULLIF(btrim(v_raw->>'auth_index'), ''), NULLIF(btrim(NEW.auth_index), ''));
+    IF v_text ~ '^[A-Za-z0-9][A-Za-z0-9_.:/@+-]{0,255}$' THEN
+        v_clean := v_clean || jsonb_build_object('auth_index', v_text);
+        NEW.auth_index := v_text;
+    ELSE
+        NEW.auth_index := '';
+    END IF;
+
+    v_text := COALESCE(NULLIF(btrim(v_raw->>'request_id'), ''), NULLIF(btrim(NEW.request_id), ''));
+    IF v_text ~ '^([0-9a-f]{8}|[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$' THEN
+        v_clean := v_clean || jsonb_build_object('request_id', v_text);
+        NEW.request_id := v_text;
+    ELSE
+        NEW.request_id := '';
+    END IF;
+
+    v_text := COALESCE(NULLIF(btrim(v_raw->>'upstream_request_id'), ''), NULLIF(btrim(NEW.upstream_request_id), ''));
+    IF v_text ~ '^([0-9a-f]{8}|[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$' THEN
+        v_clean := v_clean || jsonb_build_object('upstream_request_id', v_text);
+        NEW.upstream_request_id := v_text;
+    ELSE
+        NEW.upstream_request_id := '';
+    END IF;
+
+    v_text := COALESCE(NULLIF(btrim(v_raw->>'cpa_node_id'), ''), NULLIF(btrim(NEW.cpa_node_id), ''));
+    IF v_text ~ '^[A-Za-z0-9][A-Za-z0-9_.:/@+-]{0,127}$' THEN
+        v_clean := v_clean || jsonb_build_object('cpa_node_id', v_text);
+        NEW.cpa_node_id := v_text;
+    ELSE
+        NEW.cpa_node_id := '';
+    END IF;
+
+    v_text := lower(COALESCE(NULLIF(btrim(v_raw->>'event_type'), ''), NULLIF(btrim(NEW.event_type), '')));
+    IF v_text ~ '^[a-z0-9_]{1,32}$' THEN
+        v_clean := v_clean || jsonb_build_object('event_type', v_text);
+        NEW.event_type := v_text;
+    ELSE
+        NEW.event_type := '';
+    END IF;
+
+    v_text := COALESCE(NULLIF(btrim(v_raw->>'endpoint'), ''), NULLIF(btrim(NEW.endpoint), ''));
+    IF v_text IN ('/v1/chat/completions', '/v1/completions', '/v1/responses', '/v1/messages', '/v1/embeddings') THEN
+        v_clean := v_clean || jsonb_build_object('endpoint', v_text);
+        NEW.endpoint := v_text;
+    ELSE
+        NEW.endpoint := '';
+    END IF;
+
+    v_text := COALESCE(NULLIF(btrim(v_raw->>'service_tier'), ''), NULLIF(btrim(v_raw->>'request_service_tier'), ''), NULLIF(btrim(NEW.service_tier), ''));
+    IF v_text IN ('auto','default','standard','priority','flex','fast') THEN
+        v_clean := v_clean || jsonb_build_object('service_tier', v_text);
+        NEW.service_tier := v_text;
+    ELSE
+        NEW.service_tier := '';
+    END IF;
+
+    v_text := COALESCE(NULLIF(btrim(v_raw->>'response_service_tier'), ''), NULLIF(btrim(NEW.response_service_tier), ''));
+    IF v_text IN ('auto','default','standard','priority','flex','fast') THEN
+        v_clean := v_clean || jsonb_build_object('response_service_tier', v_text);
+        NEW.response_service_tier := v_text;
+    ELSE
+        NEW.response_service_tier := '';
+    END IF;
+
+    IF jsonb_typeof(v_raw->'failed') = 'boolean' THEN
+        NEW.failed := (v_raw->>'failed')::boolean;
+    END IF;
+    v_clean := v_clean || jsonb_build_object('failed', NEW.failed);
+
+    v_text := COALESCE(v_raw#>>'{fail,status_code}', NEW.fail_status_code::text);
+    IF v_text ~ '^[0-9]{3}$' AND v_text::integer BETWEEN 100 AND 599 THEN
+        v_status := v_text::integer;
+        v_fail := jsonb_build_object('status_code', v_status);
+        v_clean := v_clean || jsonb_build_object('fail', v_fail);
+        NEW.fail_status_code := v_status;
+    ELSE
+        NEW.fail_status_code := 0;
+    END IF;
+
+    v_text := COALESCE(v_raw->>'upstream_status_code', v_raw#>>'{upstream,status_code}', v_raw#>>'{response,status_code}', NEW.upstream_status_code::text);
+    IF v_text ~ '^[0-9]{3}$' AND v_text::integer BETWEEN 100 AND 599 THEN
+        NEW.upstream_status_code := v_text::integer;
+        v_clean := v_clean || jsonb_build_object('upstream_status_code', NEW.upstream_status_code);
+    ELSE
+        NEW.upstream_status_code := 0;
+    END IF;
+
+    IF NEW.latency_ms >= 0 THEN
+        v_clean := v_clean || jsonb_build_object('latency_ms', NEW.latency_ms);
+    END IF;
+    IF NEW.ttft_ms >= 0 THEN
+        v_clean := v_clean || jsonb_build_object('ttft_ms', NEW.ttft_ms);
+    END IF;
+
+    v_tokens_raw := COALESCE(v_raw->'tokens', NEW.tokens, '{}'::jsonb);
+    IF jsonb_typeof(v_tokens_raw) = 'object' THEN
+        FOR v_entry IN SELECT key, value FROM jsonb_each(v_tokens_raw) LOOP
+            IF v_entry.key = ANY (ARRAY['input_tokens', 'output_tokens', 'reasoning_tokens', 'cached_tokens', 'cache_read_tokens', 'cache_creation_tokens', 'cache_write_tokens', 'total_tokens'])
+               AND jsonb_typeof(v_entry.value) = 'number' AND (v_entry.value::text ~ '^[0-9]+$') THEN
+                v_tokens := v_tokens || jsonb_build_object(v_entry.key, v_entry.value);
+            ELSIF v_entry.key = 'cache_read_tokens_present' AND jsonb_typeof(v_entry.value) = 'boolean' THEN
+                v_tokens := v_tokens || jsonb_build_object(v_entry.key, v_entry.value);
+            END IF;
+        END LOOP;
+    END IF;
+    IF v_tokens <> '{}'::jsonb THEN
+        v_clean := v_clean || jsonb_build_object('tokens', v_tokens);
+    END IF;
+
+    v_breakdown_raw := v_raw->'token_breakdown';
+    IF jsonb_typeof(v_breakdown_raw) = 'object' THEN
+        v_input := v_breakdown_raw->'input';
+        v_output := v_breakdown_raw->'output';
+        v_quality := v_breakdown_raw->>'quality';
+        IF jsonb_typeof(v_input) = 'object' AND jsonb_typeof(v_output) = 'object'
+           AND v_breakdown_raw->>'schema_version' = '2'
+           AND v_quality IN ('complete', 'inconsistent', 'unclassified')
+           AND (v_breakdown_raw->>'total_tokens') ~ '^[0-9]+$'
+           AND (v_breakdown_raw->>'unclassified_tokens') ~ '^[0-9]+$'
+           AND (v_input->>'total_tokens') ~ '^[0-9]+$'
+           AND (v_input->>'uncached_tokens') ~ '^[0-9]+$'
+           AND (v_input->>'cache_read_tokens') ~ '^[0-9]+$'
+           AND (v_input->>'cache_write_tokens') ~ '^[0-9]+$'
+           AND (v_output->>'total_tokens') ~ '^[0-9]+$'
+           AND (v_output->>'non_reasoning_tokens') ~ '^[0-9]+$'
+           AND (v_output->>'reasoning_tokens') ~ '^[0-9]+$' THEN
+            v_accounting_total := (v_breakdown_raw->>'total_tokens')::bigint;
+            v_unclassified := (v_breakdown_raw->>'unclassified_tokens')::bigint;
+            v_in_total := (v_input->>'total_tokens')::bigint;
+            v_in_uncached := (v_input->>'uncached_tokens')::bigint;
+            v_in_read := (v_input->>'cache_read_tokens')::bigint;
+            v_in_write := (v_input->>'cache_write_tokens')::bigint;
+            v_out_total := (v_output->>'total_tokens')::bigint;
+            v_out_non_reasoning := (v_output->>'non_reasoning_tokens')::bigint;
+            v_out_reasoning := (v_output->>'reasoning_tokens')::bigint;
+            IF v_in_total = v_in_uncached + v_in_read + v_in_write
+               AND v_out_total = v_out_non_reasoning + v_out_reasoning
+               AND v_accounting_total = v_in_total + v_out_total + v_unclassified
+               AND (v_quality <> 'complete' OR v_unclassified = 0) THEN
+                v_breakdown_raw := jsonb_build_object(
+                    'schema_version', 2,
+                    'quality', v_quality,
+                    'total_tokens', v_accounting_total,
+                    'input', jsonb_build_object('total_tokens', v_in_total, 'uncached_tokens', v_in_uncached, 'cache_read_tokens', v_in_read, 'cache_write_tokens', v_in_write),
+                    'output', jsonb_build_object('total_tokens', v_out_total, 'non_reasoning_tokens', v_out_non_reasoning, 'reasoning_tokens', v_out_reasoning),
+                    'unclassified_tokens', v_unclassified
+                );
+                v_clean := v_clean || jsonb_build_object('accounting_version', 2, 'token_breakdown', v_breakdown_raw);
+            END IF;
+        END IF;
+    END IF;
+
+    FOR v_entry IN
+        SELECT key, value FROM jsonb_each(CASE WHEN jsonb_typeof(v_raw->'quota_headers') = 'object' THEN v_raw->'quota_headers' ELSE '{}'::jsonb END)
+        UNION ALL
+        SELECT key, value FROM jsonb_each(CASE WHEN jsonb_typeof(v_raw->'response_headers') = 'object' THEN v_raw->'response_headers' ELSE '{}'::jsonb END)
+    LOOP
+        v_key := lower(btrim(v_entry.key));
+        IF jsonb_typeof(v_entry.value) = 'string' THEN
+            v_text := btrim(v_entry.value#>>'{}');
+        ELSIF jsonb_typeof(v_entry.value) = 'array' THEN
+            v_text := btrim(v_entry.value->>0);
+        ELSE
+            v_text := '';
+        END IF;
+        IF length(v_text) = 0 OR length(v_text) > 32 THEN
+            CONTINUE;
+        END IF;
+        IF v_key !~ '^x-codex-(primary|secondary)-(used-percent|window-minutes|reset-at|reset-after-seconds)$' THEN CONTINUE; END IF;
+        v_group := substring(v_key from '^x-codex-([a-z0-9][a-z0-9_.-]{0,63})-');
+        v_suffix := substring(v_key from '(-(used-percent|window-minutes|reset-at|reset-after-seconds))$');
+        IF v_suffix = '-used-percent' AND v_text ~ '^[0-9]+(\.[0-9]+)?$' AND v_text::numeric BETWEEN 0 AND 100 THEN
+            v_quota := v_quota || jsonb_build_object(v_key, v_text);
+        ELSIF v_suffix = '-window-minutes' AND v_text ~ '^[0-9]+$' AND length(v_text) <= 7 AND v_text::bigint BETWEEN 1 AND 1000000 THEN
+            v_quota := v_quota || jsonb_build_object(v_key, v_text);
+        ELSIF (v_suffix = '-reset-at' OR v_suffix = '-reset-after-seconds') AND v_text ~ '^[0-9]+$' AND length(v_text) <= 10 AND v_text::bigint BETWEEN 0 AND 4102444800 THEN
+            v_quota := v_quota || jsonb_build_object(v_key, v_text);
+        END IF;
+    END LOOP;
+    IF v_quota <> '{}'::jsonb THEN
+        v_clean := v_clean || jsonb_build_object('quota_headers', v_quota);
+    END IF;
+
+    v_api_key := NULLIF(btrim(v_raw->>'api_key_fingerprint'), '');
+    IF v_api_key IS NOT NULL AND v_api_key ~* '^sha256:[0-9a-f]{64}$' THEN
+        v_api_key := lower(v_api_key);
+        v_clean := v_clean || jsonb_build_object('api_key', v_api_key, 'api_key_fingerprint', v_api_key);
+    ELSE
+        v_api_key := COALESCE(NULLIF(btrim(NEW.api_key), ''), NULLIF(btrim(v_raw->>'api_key'), ''));
+        IF v_api_key IS NOT NULL THEN
+            v_api_key := 'sha256:' || encode(sha256(convert_to(btrim(v_api_key), 'UTF8')), 'hex');
+            v_clean := v_clean || jsonb_build_object('api_key', v_api_key, 'api_key_fingerprint', v_api_key);
+        ELSE
+            v_api_key := '';
+        END IF;
+    END IF;
+
+    NEW.api_key := v_api_key;
+    NEW.payload := jsonb_strip_nulls(v_clean);
+    NEW.tokens := v_tokens;
+    NEW.fail := v_fail;
+    NEW.fail_body := '';
+    NEW.source := '';
+    NEW.effort := '';
+    v_text := COALESCE(NULLIF(btrim(v_raw->>'session_id'), ''), NULLIF(btrim(NEW.session_id), ''));
+    IF lower(v_text) ~ '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' THEN
+        NEW.session_id := lower(v_text);
+        NEW.payload := NEW.payload || jsonb_build_object('session_id', NEW.session_id);
+    ELSE
+        NEW.session_id := '';
+    END IF;
+    NEW.parent_session_id := '';
+    NEW.root_session_id := NEW.session_id;
+    NEW.cpa_ip := '';
+    NEW.cpa_port := 0;
+    NEW.cpa_label := '';
+    RETURN NEW;
+END;
+$$;
+`
+
+const diagnosticsMetadataOnlyBillingFunctionV1 = `
+CREATE OR REPLACE FUNCTION home_diagnostics_metadata_only_billing_v1()
+RETURNS trigger
+LANGUAGE plpgsql
+AS $$
+BEGIN
+    NEW.api_key_masked := 'sha256:…';
+    NEW.endpoint := '';
+    NEW.request_summary := '';
+    IF COALESCE(NEW.provider, '') !~ '^[A-Za-z0-9][A-Za-z0-9_.:/@+-]{0,79}$' THEN NEW.provider := ''; END IF;
+    IF COALESCE(NEW.model, '') !~ '^[A-Za-z0-9][A-Za-z0-9_.:/@+-]{0,255}$' THEN NEW.model := ''; END IF;
+    IF COALESCE(NEW.original_model, '') !~ '^[A-Za-z0-9][A-Za-z0-9_.:/@+-]{0,255}$' THEN NEW.original_model := ''; END IF;
+    IF COALESCE(NEW.actual_model, '') !~ '^[A-Za-z0-9][A-Za-z0-9_.:/@+-]{0,255}$' THEN NEW.actual_model := ''; END IF;
+    IF COALESCE(NEW.request_id, '') !~ '^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$'
+       OR lower(NEW.request_id) ~ '(authorization|access[_-]?token|refresh[_-]?token|api[_-]?key|secret|bearer|cookie)' THEN
+        NEW.request_id := '';
+    END IF;
+    RETURN NEW;
+END;
+$$;
+`
+
+func installDiagnosticsMetadataOnlyPostgresGuardsContext(db *gorm.DB) error {
+	return installDiagnosticsMetadataOnlyPostgresGuards(context.Background(), db)
+}
+
+func installDiagnosticsMetadataOnlyPostgresGuards(ctx context.Context, db *gorm.DB) error {
+	if db == nil || db.Dialector == nil || db.Dialector.Name() != "postgres" {
+		return nil
+	}
+	ctx = contextOrBackground(ctx)
+	errInstall := db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if errLimit := setDiagnosticsPrivacyTransactionLimits(tx, diagnosticsPrivacyBatchTimeout); errLimit != nil {
+			return errLimit
+		}
+		if errLock := lockDiagnosticsPrivacyMigration(tx); errLock != nil {
+			return errLock
+		}
+		for _, guard := range []struct {
+			table       string
+			triggerName string
+			functionSQL string
+			triggerSQL  string
+		}{
+			{
+				table:       "api_key",
+				triggerName: "home_diagnostics_metadata_only_api_key_v1_trigger",
+				functionSQL: diagnosticsMetadataOnlyAPIKeyFunctionV1,
+				triggerSQL:  `CREATE TRIGGER home_diagnostics_metadata_only_api_key_v1_trigger BEFORE INSERT OR UPDATE ON api_key FOR EACH ROW EXECUTE FUNCTION home_diagnostics_metadata_only_api_key_v1()`,
+			},
+			{
+				table:       "usage",
+				triggerName: "home_diagnostics_metadata_only_usage_v1_trigger",
+				functionSQL: diagnosticsMetadataOnlyUsageFunctionV1,
+				triggerSQL:  `CREATE TRIGGER home_diagnostics_metadata_only_usage_v1_trigger BEFORE INSERT OR UPDATE ON usage FOR EACH ROW EXECUTE FUNCTION home_diagnostics_metadata_only_usage_v1()`,
+			},
+			{
+				table:       "billing_charge",
+				triggerName: "home_diagnostics_metadata_only_billing_v1_trigger",
+				functionSQL: diagnosticsMetadataOnlyBillingFunctionV1,
+				triggerSQL:  `CREATE TRIGGER home_diagnostics_metadata_only_billing_v1_trigger BEFORE INSERT OR UPDATE ON billing_charge FOR EACH ROW EXECUTE FUNCTION home_diagnostics_metadata_only_billing_v1()`,
+			},
+		} {
+			var exists bool
+			if errCheck := tx.Raw(`SELECT EXISTS (
+				SELECT 1 FROM pg_trigger t JOIN pg_class c ON c.oid = t.tgrelid
+				WHERE t.tgname = ? AND c.relname = ? AND NOT t.tgisinternal
+			)`, guard.triggerName, guard.table).Scan(&exists).Error; errCheck != nil {
+				return errCheck
+			}
+			if exists {
+				continue
+			}
+			if errFunction := tx.Exec(guard.functionSQL).Error; errFunction != nil {
+				return errFunction
+			}
+			if errTrigger := tx.Exec(guard.triggerSQL).Error; errTrigger != nil {
+				return errTrigger
+			}
+		}
+		return nil
+	})
+	if errInstall != nil {
+		return errors.New("postgres diagnostics guards could not be installed")
+	}
+	return nil
+}
