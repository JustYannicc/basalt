+package main
+
+import (
+	"context"
+	"encoding/json"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPIHome/internal/cluster"
+	log "github.com/sirupsen/logrus"
+)
+
+// Runs independently of listeners. A failed batch rolls back and is retried;
+// neither a large history nor a failed cleanup can take serving down.
+func runDiagnosticsPrivacyMaintenance(ctx context.Context, repo *cluster.Repository) {
+	if repo == nil || !cluster.DiagnosticsMetadataOnlyEnabled() {
+		return
+	}
+	var attempts, batches, rowsUpdated int64
+	for ctx.Err() == nil {
+		batchCtx, cancel := context.WithTimeout(ctx, 6*time.Second)
+		result, errBatch := repo.RunDiagnosticsPrivacyBatch(batchCtx)
+		cancel()
+		delay := 100 * time.Millisecond
+		if errBatch != nil {
+			if ctx.Err() != nil {
+				return
+			}
+			attempts++
+			delay = time.Second << min(attempts-1, 6)
+			if delay > time.Minute {
+				delay = time.Minute
+			}
+			message, _ := json.Marshal(struct {
+				Attempt           int64 `json:"attempt"`
+				RetryAfterSeconds int64 `json:"retry_after_seconds"`
+			}{attempts, int64(delay / time.Second)})
+			log.Error("POOL_PRIVACY_RETRY " + string(message))
+		} else {
+			attempts = 0
+			if result.Done {
+				delay = time.Minute
+			} else if result.RowsUpdated > 0 {
+				batches++
+				rowsUpdated += result.RowsUpdated
+				message, _ := json.Marshal(struct {
+					Batches     int64 `json:"batches"`
+					RowsUpdated int64 `json:"rows_updated"`
+				}{batches, rowsUpdated})
+				log.Info("POOL_PRIVACY_PROGRESS " + string(message))
+			}
+		}
+		timer := time.NewTimer(delay)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return
+		case <-timer.C:
+		}
+	}
+}
+
+func waitForDiagnosticsPrivacyHistory(ctx context.Context, repo *cluster.Repository) bool {
+	for ctx.Err() == nil {
+		probeCtx, cancel := context.WithTimeout(ctx, time.Second)
+		ready, errProbe := repo.DiagnosticsPrivacyHistoryReady(probeCtx)
+		cancel()
+		if errProbe == nil && ready {
+			return true
+		}
+		timer := time.NewTimer(time.Second)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return false
+		case <-timer.C:
+		}
+	}
+	return false
+}
