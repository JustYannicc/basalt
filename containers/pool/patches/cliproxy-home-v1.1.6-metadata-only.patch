+		t.Run(sessionID, func(t *testing.T) {
+			record, errAppend := NewRepository(db).AppendUsageWithRuntime(t.Context(), `{"timestamp":"2026-10-29T12:00:00Z","session_id":"`+sessionID+`","failed":false}`, UsageRuntimeMetadata{})
+			if errAppend != nil {
+				t.Fatal(errAppend)
+			}
+			var count int64
+			if errCount := db.Model(&UsageRecord{}).Where("session_id = ?", sessionID).Count(&count).Error; errCount != nil || count != 1 || record.SessionID != sessionID {
+				t.Fatal("canonical session lookup stopped finding usage")
+			}
+		})
+	}
+	raw, errSanitize := SanitizeUsagePayloadSecrets(`{"session_id":"private-client-session-text-289"}`)
+	if errSanitize != nil || strings.Contains(raw, "private-client-session-text-289") {
+		t.Fatal("free session text survived projection")
+	}
+}
+
+func TestDiagnosticsPrivacyServingLegacyKeyBeforeBackfill(t *testing.T) {
+	t.Setenv(DiagnosticsMetadataOnlyEnv, "0")
+	db := privacyTestDB(t)
+	key := APIKeyRecord{APIKey: "legacy-live-credential-914"}
+	if errCreate := db.Create(&key).Error; errCreate != nil {
+		t.Fatal(errCreate)
+	}
+	t.Setenv(DiagnosticsMetadataOnlyEnv, "1")
+	fingerprint := DiagnosticAPIKeyFingerprint(key.APIKey)
+	matched, errMatch := billingAPIKeyByValue(t.Context(), db, fingerprint)
+	if errMatch != nil || matched == nil || matched.ID != key.ID {
+		t.Fatal("serving lost key identity while historical backfill was pending")
+	}
+	var persisted APIKeyRecord
+	if errRead := db.First(&persisted, key.ID).Error; errRead != nil || persisted.DiagnosticFingerprint != fingerprint {
+		t.Fatal("first use did not establish the indexed diagnostic identity")
+	}
+}
diff --git a/internal/cluster/diagnostics_privacy_worker.go b/internal/cluster/diagnostics_privacy_worker.go
new file mode 100644
index 0000000..8a16672
--- /dev/null
+++ b/internal/cluster/diagnostics_privacy_worker.go
@@ -0,0 +1,110 @@
+package cluster
+
+import (
+	"context"
+	"errors"
+
+	"gorm.io/gorm"
+)
+
+// prepareDiagnosticsMetadataOnlyPrivacyMigration installs only the capture guard.
+// Historical work is driven after listeners open by RunDiagnosticsPrivacyBatch.
+func prepareDiagnosticsMetadataOnlyPrivacyMigration(ctx context.Context, db *gorm.DB) error {
+	if !DiagnosticsMetadataOnlyEnabled() {
+		return nil
+	}
+	if db == nil || db.Dialector == nil {
+		return errors.New("diagnostics privacy migration unavailable")
+	}
+	if db.Dialector.Name() == "postgres" {
+		return installDiagnosticsMetadataOnlyPostgresGuards(ctx, db)
+	}
+	return nil
+}
+
+// DiagnosticsPrivacyBatchResult describes one committed maintenance transaction.
+type DiagnosticsPrivacyBatchResult struct {
+	Done        bool
+	RowsUpdated int64
+}
+
+// RunDiagnosticsPrivacyBatch advances one journaled batch. Call after listeners
+// open. Audit counts, row cleanup and the cursor commit or roll back together.
+func (r *Repository) RunDiagnosticsPrivacyBatch(ctx context.Context) (DiagnosticsPrivacyBatchResult, error) {
+	if !DiagnosticsMetadataOnlyEnabled() {
+		return DiagnosticsPrivacyBatchResult{Done: true}, nil
+	}
+	if r == nil || r.db == nil {
+		return DiagnosticsPrivacyBatchResult{}, errors.New("privacy maintenance unavailable")
+	}
+	ctx = contextOrBackground(ctx)
+	if errContext := ctx.Err(); errContext != nil {
+		return DiagnosticsPrivacyBatchResult{}, errContext
+	}
+	var existing diagnosticsPrivacyMigrationRecord
+	anyStep := r.db.WithContext(ctx).Where("name LIKE ?", "diagnostics_metadata_only_%").Limit(1).Find(&existing)
+	if anyStep.Error != nil {
+		return DiagnosticsPrivacyBatchResult{}, errors.New("privacy journal unavailable")
+	}
+	if anyStep.RowsAffected == 0 {
+		if errPrepare := prepareDiagnosticsPrivacyStep(ctx, r.db, diagnosticPrivacyStepName); errPrepare != nil {
+			return DiagnosticsPrivacyBatchResult{}, errors.New("privacy journal unavailable")
+		}
+	}
+	var state diagnosticsPrivacyMigrationRecord
+	query := r.db.WithContext(ctx).Where("name LIKE ? AND (completed = ? OR audit_marker_emitted = ?)", "diagnostics_metadata_only_%", false, false).
+		Order("name").Limit(1).Find(&state)
+	if query.Error != nil {
+		return DiagnosticsPrivacyBatchResult{}, errors.New("privacy journal unreadable")
+	}
+	if query.RowsAffected == 0 {
+		return DiagnosticsPrivacyBatchResult{Done: true}, nil
+	}
+	var result DiagnosticsPrivacyBatchResult
+	var errBatch error
+	switch {
+	case !state.APIKeysDone:
+		result.RowsUpdated, errBatch = runDiagnosticsPrivacyAPIKeyBatch(ctx, r.db, state.Name)
+	case !state.UsageDone:
+		result.RowsUpdated, errBatch = runDiagnosticsPrivacyUsageBatch(ctx, r.db, state.Name)
+	case !state.BillingChargesDone:
+		result.RowsUpdated, errBatch = runDiagnosticsPrivacyBillingChargeBatch(ctx, r.db, state.Name)
+	case !state.Completed:
+		errBatch = completeDiagnosticsPrivacyStep(ctx, r.db, state.Name)
+	default:
+		errBatch = emitDiagnosticsPrivacyAuditMarker(ctx, r.db, state.Name)
+	}
+	if errBatch != nil {
+		return DiagnosticsPrivacyBatchResult{}, errors.New("privacy maintenance batch failed")
+	}
+	return result, nil
+}
+
+func ensureDiagnosticsPrivacyAudit(tx *gorm.DB, name string) error {
+	return tx.Exec(`INSERT INTO home_data_migration_audit
+		(name, rows_scanned, token_copies, raw_token_copies, prehashed_token_copies,
+		matched_active_api_key_copies, unmatched_raw_token_copies, unknown_key_count,
+		active_api_key_count, deleted_api_key_count, matched_active_api_key_ids,
+		active_key_match_interpretation, audited_at)
+		VALUES (?, 0, 0, 0, 0, 0, 0, 0, 0, 0, '[]', ?, CURRENT_TIMESTAMP)
+		ON CONFLICT (name) DO NOTHING`, name, diagnosticPrivacyMatchBasis).Error
+}
+
+// DiagnosticsPrivacyHistoryReady lets other historical backfills yield while
+// this job audits the rows. Serving and new usage ingestion do not wait on it.
+func (r *Repository) DiagnosticsPrivacyHistoryReady(ctx context.Context) (bool, error) {
+	if !DiagnosticsMetadataOnlyEnabled() {
+		return true, nil
+	}
+	if r == nil || r.db == nil {
+		return false, errors.New("privacy history journal unavailable")
+	}
+	var bootstrap diagnosticsPrivacyMigrationRecord
+	query := r.db.WithContext(ctx).Where("name LIKE ?", "diagnostics_metadata_only_%").Limit(1).Find(&bootstrap)
+	if query.Error != nil || query.RowsAffected == 0 {
+		return false, query.Error
+	}
+	var pending diagnosticsPrivacyMigrationRecord
+	query = r.db.WithContext(ctx).Where("name LIKE ? AND completed = ?", "diagnostics_metadata_only_%", false).Limit(1).Find(&pending)
+	return query.Error == nil && query.RowsAffected == 0, query.Error
+}
