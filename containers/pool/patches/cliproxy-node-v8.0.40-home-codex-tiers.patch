+func TestCodexClientModelsResponse_ClaudeFastTierRequiresPureClaudeRoute(t *testing.T) {
+	available := []map[string]any{
+		{"id": "claude-opus-4-6"},
+		{"id": "gpt-5.5"},
+		{"id": "mixed-route-model"},
+		{"id": "claude-named-openai-route"},
+	}
+	providers := map[string][]string{
+		"claude-opus-4-6":           {"claude"},
+		"gpt-5.5":                   {"claude"},
+		"mixed-route-model":         {"claude", "openai-compatible"},
+		"claude-named-openai-route": {"openai-compatible"},
+	}
+	response := BuildResponseForClientWithServiceTierRoutes(available, func(id string) []string { return providers[id] }, nil, nil, nil, nil, false, "cpa")
+	models, ok := response["models"].([]map[string]any)
+	if !ok {
+		t.Fatalf("models = %T, want []map[string]any", response["models"])
+	}
+	bySlug := make(map[string]map[string]any, len(models))
+	for _, model := range models {
+		bySlug[stringModelValue(model, "slug")] = model
+	}
+
+	for _, slug := range []string{"claude-opus-4-6", "gpt-5.5"} {
+		tiers, ok := bySlug[slug]["service_tiers"].([]any)
+		if !ok || len(tiers) != 1 {
+			t.Fatalf("%s service_tiers = %#v, want one conditional Fast tier", slug, bySlug[slug]["service_tiers"])
+		}
+		tier, ok := tiers[0].(map[string]any)
+		if !ok || tier["id"] != "priority" || tier["name"] != "Fast" || tier["description"] != claudeFastServiceTierDescription {
+			t.Errorf("%s Fast tier = %#v", slug, tiers[0])
+		}
+	}
+	for _, slug := range []string{"mixed-route-model", "claude-named-openai-route"} {
+		tiers, ok := bySlug[slug]["service_tiers"].([]any)
+		if !ok || len(tiers) != 0 {
+			t.Errorf("%s service_tiers = %#v, want none for non-pure Claude routes", slug, bySlug[slug]["service_tiers"])
+		}
+	}
+}
