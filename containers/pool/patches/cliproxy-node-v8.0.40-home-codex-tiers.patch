+func TestClaudeFastCatalogTierTranslatesToAnthropicSpeedAndBeta(t *testing.T) {
+	const model = "claude-opus-4-6"
+	catalog := codexmodels.BuildResponseForClientWithServiceTierRoutes(
+		[]map[string]any{{"id": model}},
+		func(id string) []string {
+			if id == model {
+				return []string{"claude"}
+			}
+			return nil
+		},
+		nil, nil, nil, nil, false, "cpa",
+	)
+	models, ok := catalog["models"].([]map[string]any)
+	if !ok || len(models) != 1 {
+		t.Fatalf("catalog models = %#v, want one model", catalog["models"])
+	}
+	tiers, ok := models[0]["service_tiers"].([]any)
+	if !ok || len(tiers) != 1 {
+		t.Fatalf("catalog service_tiers = %#v, want one Fast tier", models[0]["service_tiers"])
+	}
+	tier, ok := tiers[0].(map[string]any)
+	if !ok || tier["name"] != "Fast" {
+		t.Fatalf("catalog tier = %#v, want Fast", tiers[0])
+	}
+	tierID, ok := tier["id"].(string)
+	if !ok || tierID == "" {
+		t.Fatalf("catalog tier id = %#v, want non-empty id", tier["id"])
+	}
+
+	requestBody := []byte(fmt.Sprintf(`{"model":%q,"service_tier":%q,"input":[{"type":"message","role":"user","content":[{"type":"input_text","text":"hi"}]}]}`, model, tierID))
+	upstreamBody, err := responsesclaude.ConvertOpenAIResponsesRequestToClaude(model, requestBody, false)
+	if err != nil {
+		t.Fatalf("ConvertOpenAIResponsesRequestToClaude() error = %v", err)
+	}
+	if got := gjson.GetBytes(upstreamBody, "speed").String(); got != "fast" {
+		t.Fatalf("translated speed = %q, want fast; body=%s", got, upstreamBody)
+	}
+
+	apiKey := "key-catalog-fast"
+	auth := &cliproxyauth.Auth{Attributes: map[string]string{"api_key": apiKey}}
+	upstreamRequest := newClaudeHeaderTestRequest(t, nil)
+	if err := applyClaudeHeaders(upstreamRequest, auth, apiKey, false, nil, upstreamBody, nil, nil, false); err != nil {
+		t.Fatalf("applyClaudeHeaders() error = %v", err)
+	}
+	if got := upstreamRequest.Header.Get("Anthropic-Beta"); !strings.Contains(got, claudeFastModeBeta) {
+		t.Fatalf("Anthropic-Beta = %q, want %s for the catalog tier", got, claudeFastModeBeta)
+	}
+}
