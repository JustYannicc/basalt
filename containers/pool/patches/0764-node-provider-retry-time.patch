-		record.Fail = Failure{StatusCode: status, Type: failureType, Code: failureCode}
+		// The provider's retry time is one closed number; no body or header leaves the node.
+		record.Fail = Failure{StatusCode: status, Type: failureType, Code: failureCode, RetryAfterMS: closedRetryAfterMS(status, record.Fail.RetryAfterMS)}
 	} else {
 		record.Fail = Failure{}
