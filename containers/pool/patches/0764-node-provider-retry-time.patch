+type retryTimeSetupDispatcher struct{}
+
+func (retryTimeSetupDispatcher) HeartbeatOK() bool { return true }
+
+func (retryTimeSetupDispatcher) RPopAuth(context.Context, string, string, http.Header, int) ([]byte, error) {
+	return json.Marshal(map[string]any{
+		"model":    "limited-model",
+		"provider": "antigravity",
+		"auth": cliproxyauth.Auth{
+			ID:         "limited-antigravity-setup",
+			Index:      "limited-antigravity-setup",
+			Provider:   "antigravity",
+			Status:     cliproxyauth.StatusActive,
+			Attributes: map[string]string{cliproxyauth.AttributeAuthKind: cliproxyauth.AuthKindOAuth},
+			Metadata:   map[string]any{"access_token": "token", "expired": time.Now().Add(time.Hour).Format(time.RFC3339)},
+		},
+	})
+}
+
+func (retryTimeSetupDispatcher) AbortAmbiguousDispatch() {}
+
+// A 429 during Antigravity credential setup under Home dispatch reaches Home as its own record,
+// outside the executor's reporter; it must carry the provider's retry time the same way.
+func TestBasaltProviderRetryTimeReachesHomeOnTheWireFromCredentialSetup(t *testing.T) {
+	t.Setenv(diagnostics.MetadataOnlyEnv, "1")
+	wasEnabled, wasCounted := redisqueue.Enabled(), redisqueue.UsageStatisticsEnabled()
+	redisqueue.SetEnabled(false)
+	redisqueue.SetEnabled(true)
+	redisqueue.SetUsageStatisticsEnabled(true)
+	t.Cleanup(func() {
+		redisqueue.SetEnabled(false)
+		redisqueue.SetEnabled(wasEnabled)
+		redisqueue.SetUsageStatisticsEnabled(wasCounted)
+	})
+	redisqueue.PopOldest(1 << 10)
+
+	cfg := &config.Config{RequestRetry: 1}
+	cfg.Home.Enabled = true
+	manager := cliproxyauth.NewManager(nil, nil, nil)
+	manager.SetConfig(cfg)
+	manager.RegisterExecutor(NewAntigravityExecutor(cfg))
+	manager.PublishHomeDispatch(retryTimeSetupDispatcher{}, executionregistry.New(), 1)
+	ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", roundTripperFunc(func(*http.Request) (*http.Response, error) {
+		return &http.Response{
+			StatusCode: http.StatusTooManyRequests,
+			Header:     http.Header{"Content-Type": {"application/json"}},
+			Body:       io.NopCloser(strings.NewReader(`{"error":{"code":429,"status":"RESOURCE_EXHAUSTED","details":[{"@type":"type.googleapis.com/google.rpc.RetryInfo","retryDelay":"45s"}]}}`)),
+		}, nil
+	}))
+	payload := []byte(`{"model":"limited-model","messages":[{"role":"user","content":"hello"}]}`)
+	if _, errExecute := manager.Execute(ctx, []string{"antigravity"}, cliproxyexecutor.Request{Model: "limited-model", Payload: payload}, cliproxyexecutor.Options{
+		SourceFormat: sdktranslator.FormatOpenAI, ResponseFormat: sdktranslator.FormatOpenAI, OriginalRequest: payload,
+	}); errExecute == nil {
+		t.Fatal("Execute() succeeded, want the credential setup's 429")
+	}
+	raw := popUsagePayloadWhere(t, "executor_type", "home-result")
+	var sent struct {
+		Fail            map[string]any `json:"fail"`
+		ResponseHeaders map[string]any `json:"response_headers"`
+	}
+	if errDecode := json.Unmarshal(raw, &sent); errDecode != nil {
+		t.Fatalf("usage payload: %v", errDecode)
+	}
+	if got, _ := sent.Fail["retry_after_ms"].(float64); int64(got) != 45000 {
+		t.Fatalf("setup 429: fail.retry_after_ms = %v, want 45000", sent.Fail["retry_after_ms"])
+	}
+	if body, _ := sent.Fail["body"].(string); body != "" || len(sent.ResponseHeaders) != 0 {
+		t.Fatalf("setup 429: the provider's body or headers left the node: %s", raw)
+	}
+}
+
+// popUsagePayloadFor returns the first queued usage payload for one credential index, skipping
+// records other tests left in the process-wide pipeline.
+func popUsagePayloadFor(t *testing.T, authIndex string) []byte {
+	t.Helper()
+	return popUsagePayloadWhere(t, "auth_index", authIndex)
+}
+
+// popUsagePayloadWhere returns the first queued usage payload whose string field has the value,
+// skipping records other tests left in the process-wide pipeline.
+func popUsagePayloadWhere(t *testing.T, field, value string) []byte {
+	t.Helper()
+	deadline := time.Now().Add(5 * time.Second)
+	for time.Now().Before(deadline) {
+		items := redisqueue.PopOldest(1)
+		if len(items) == 0 {
+			time.Sleep(10 * time.Millisecond)
+			continue
+		}
+		var record map[string]any
+		if json.Unmarshal(items[0], &record) == nil && record[field] == value {
+			return items[0]
+		}
+	}
+	t.Fatalf("no usage payload with %s %s reached the queue", field, value)
+	return nil
+}
