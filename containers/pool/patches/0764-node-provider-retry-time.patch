diff --git a/sdk/cliproxy/usage/manager.go b/sdk/cliproxy/usage/manager.go
index 04be8d7a..f24745f3 100644
--- a/sdk/cliproxy/usage/manager.go
+++ b/sdk/cliproxy/usage/manager.go
@@ -104,6 +104,26 @@ type Failure struct {
 	// across usage sinks so downstream schedulers do not treat locally
 	// synthesized statuses as received upstream refusals.
 	Code string
+	// RetryAfterMS is the provider's own retry time for a 429, in whole milliseconds, or 0 when the
+	// provider gave none. Home ends the credential's cooldown then instead of guessing.
+	RetryAfterMS int64
+}
+
+// providerRetryAfterMax is the longest provider retry time passed on, the same horizon Home trusts
+// a provider hint for. A longer one is dropped rather than shortened, so it reads as no time.
+const providerRetryAfterMax = 60 * 24 * time.Hour
+
+// ProviderRetryAfterMS is a 429's provider retry time as the closed number Home reads: whole
+// milliseconds rounded up, so the cooldown never ends before the provider's time; 0 for none.
+func ProviderRetryAfterMS(statusCode int, retryAfter *time.Duration) int64 {
+	if statusCode != 429 || retryAfter == nil || *retryAfter <= 0 || *retryAfter > providerRetryAfterMax {
+		return 0
+	}
+	ms := int64(*retryAfter / time.Millisecond)
+	if *retryAfter%time.Millisecond != 0 {
+		ms++
+	}
+	return ms
 }
 
 // Detail holds the token and structured usage breakdown captured from an upstream response.
