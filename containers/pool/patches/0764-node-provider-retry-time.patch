diff --git a/internal/runtime/executor/basalt_provider_retry_time_test.go b/internal/runtime/executor/basalt_provider_retry_time_test.go
new file mode 100644
index 0000000..3040b89
--- /dev/null
+++ b/internal/runtime/executor/basalt_provider_retry_time_test.go
@@ -0,0 +1,86 @@
+package executor
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"strconv"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/diagnostics"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/redisqueue"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor/helps"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+// Home cools a credential only from the usage record the node sends it, which in metadata-only
+// mode carries no body and no headers. A 429 from each provider must still put the provider's own
+// retry time on that wire, as the one closed number fail.retry_after_ms.
+func TestBasaltProviderRetryTimeReachesHomeOnTheWire(t *testing.T) {
+	t.Setenv(diagnostics.MetadataOnlyEnv, "1")
+	wasEnabled, wasCounted := redisqueue.Enabled(), redisqueue.UsageStatisticsEnabled()
+	redisqueue.SetEnabled(false)
+	redisqueue.SetEnabled(true)
+	redisqueue.SetUsageStatisticsEnabled(true)
+	t.Cleanup(func() {
+		redisqueue.SetEnabled(false)
+		redisqueue.SetEnabled(wasEnabled)
+		redisqueue.SetUsageStatisticsEnabled(wasCounted)
+	})
+
+	now := time.Now()
+	claudeHeaders := http.Header{}
+	claudeHeaders.Set("Anthropic-Ratelimit-Unified-Status", "rejected")
+	claudeHeaders.Set("Anthropic-Ratelimit-Unified-5h-Status", "rejected")
+	claudeHeaders.Set("Anthropic-Ratelimit-Unified-5h-Reset", strconv.FormatInt(now.Add(2*time.Hour).Unix(), 10))
+	claudeHeaders.Set("Anthropic-Ratelimit-Unified-Reset", strconv.FormatInt(now.Add(2*time.Hour).Unix(), 10))
+	cases := []struct {
+		provider string
+		err      error
+	}{
+		{"claude", classifyClaudeUpstreamError(http.StatusTooManyRequests, claudeHeaders, []byte(`{"type":"error","error":{"type":"rate_limit_error","message":"This request would exceed your account's rate limit. Please try again later."}}`))},
+		{"codex", newCodexStatusErrWithHeaders(http.StatusTooManyRequests, nil, []byte(`{"error":{"type":"usage_limit_reached","resets_at":`+strconv.FormatInt(now.Add(time.Hour).Unix(), 10)+`}}`))},
+		{"antigravity", newAntigravityStatusErr(http.StatusTooManyRequests, []byte(`{"error":{"code":429,"details":[{"@type":"type.googleapis.com/google.rpc.RetryInfo","retryDelay":"45s"}]}}`))},
+	}
+	for _, c := range cases {
+		provider, ok := c.err.(interface{ RetryAfter() *time.Duration })
+		if !ok || provider.RetryAfter() == nil {
+			t.Fatalf("%s: the executor's 429 carries no provider retry time", c.provider)
+		}
+		// Whole milliseconds, rounded up so the cooldown never ends before the provider's time.
+		retry := *provider.RetryAfter()
+		want := int64((retry + time.Millisecond - 1) / time.Millisecond)
+		redisqueue.PopOldest(1 << 10)
+		ctx := context.Background()
+		reporter := helps.NewUsageReporter(ctx, c.provider, "limited-model", &cliproxyauth.Auth{ID: "limited-" + c.provider, Index: "limited-" + c.provider, Provider: c.provider})
+		reporter.PublishFailure(ctx, c.err)
+		payload := popUsagePayload(t)
+		var sent struct {
+			Fail            map[string]any `json:"fail"`
+			ResponseHeaders map[string]any `json:"response_headers"`
+		}
+		if errDecode := json.Unmarshal(payload, &sent); errDecode != nil {
+			t.Fatalf("%s: usage payload: %v", c.provider, errDecode)
+		}
+		if got, _ := sent.Fail["retry_after_ms"].(float64); int64(got) != want {
+			t.Fatalf("%s: fail.retry_after_ms = %v, want %d", c.provider, sent.Fail["retry_after_ms"], want)
+		}
+		if body, _ := sent.Fail["body"].(string); body != "" || len(sent.ResponseHeaders) != 0 {
+			t.Fatalf("%s: the provider's body or headers left the node: %v", c.provider, string(payload))
+		}
+	}
+}
+
+func popUsagePayload(t *testing.T) []byte {
+	t.Helper()
+	deadline := time.Now().Add(5 * time.Second)
+	for time.Now().Before(deadline) {
+		if items := redisqueue.PopOldest(1); len(items) == 1 {
+			return items[0]
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatal("no usage payload reached the queue")
+	return nil
+}
