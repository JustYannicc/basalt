+// providerRetryAfter is the retry time the executor parsed from the provider's own response.
+func providerRetryAfter(err error) *time.Duration {
+	var provider interface{ RetryAfter() *time.Duration }
+	if errors.As(err, &provider) && provider != nil {
+		return provider.RetryAfter()
+	}
+	return nil
+}
