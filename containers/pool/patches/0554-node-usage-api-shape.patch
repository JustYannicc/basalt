+func diagnosticEndpoint(value string) string {
+	value = strings.TrimSpace(value)
+	if strings.HasPrefix(value, "POST ") {
+		value = strings.TrimPrefix(value, "POST ")
+	} else if value == "GET /v1/responses" {
+		value = "/v1/responses"
+	}
+	switch value {
+	case "/v1/chat/completions", "/v1/completions", "/v1/responses", "/v1/messages", "/v1/embeddings":
+		return value
+	default:
+		return ""
+	}
+}
