+func TestMetadataOnlyEndpointShapes(t *testing.T) {
+	for _, path := range []string{"/v1/chat/completions", "/v1/completions", "/v1/responses", "/v1/messages", "/v1/embeddings"} {
+		for _, value := range []string{path, "POST " + path} {
+			ctx := internallogging.WithEndpoint(context.Background(), value)
+			clean, record := RedactForMetadataOnly(ctx, Record{})
+			if got := internallogging.GetEndpoint(clean); got != path {
+				t.Fatalf("safe endpoint = %q, want %q", got, path)
+			}
+			repeated, _ := RedactForMetadataOnly(clean, record)
+			if internallogging.GetEndpoint(repeated) != path {
+				t.Fatal("repeat projection lost safe endpoint")
+			}
+		}
+	}
+	for _, value := range []string{"GET /v1/responses", "/v1/messages?api_key=private", "POST /v1/messages?secret=private", "https://private.invalid/v1/messages", "/private/path", "sentinel-request-body", "GET /v1/messages", "POST /v1/messages\nAuthorization: private"} {
+		ctx := internallogging.WithEndpoint(context.Background(), value)
+		clean, _ := RedactForMetadataOnly(ctx, Record{})
+		want := ""
+		if value == "GET /v1/responses" {
+			want = "/v1/responses"
+		}
+		if got := internallogging.GetEndpoint(clean); got != want {
+			t.Fatalf("unexpected endpoint shape %q", got)
+		}
+	}
+}
