index 0000000..3bd1490
--- /dev/null
+++ b/internal/home/basalt_limit_reading_test.go
@@ -0,0 +1,202 @@
+package home
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	coreauth "github.com/router-for-me/CLIProxyAPIHome/internal/cliproxy/auth"
+)
+
+type limitReadingCollector struct {
+	mu    sync.Mutex
+	ids   []string
+	calls chan struct{}
+	// accept returns how many jobs the call accepts; nil accepts every id.
+	accept func(call int) int
+}
+
+func (c *limitReadingCollector) TriggerCollection(_ context.Context, ids map[string]struct{}, _ map[string]struct{}) (int, error) {
+	c.mu.Lock()
+	for id := range ids {
+		c.ids = append(c.ids, id)
+	}
+	call := len(c.ids)
+	c.mu.Unlock()
+	c.calls <- struct{}{}
+	if c.accept != nil {
+		return c.accept(call), nil
+	}
+	return len(ids), nil
+}
+
+func (c *limitReadingCollector) triggered() []string {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return append([]string(nil), c.ids...)
+}
+
+func limitPayload(index, provider string, status int) string {
+	return limitPayloadForModel(index, provider, "model-a", status)
+}
+
+func limitPayloadForModel(index, provider, model string, status int) string {
+	return fmt.Sprintf(`{"auth_index": %q, "provider": %q, "model": %q, "failed": true, "fail": {"status_code": %d}}`, index, provider, model, status)
+}
+
+// awaitLimitReadingSettled makes each queued reading's trigger report back, so a test can send the
+// next 429 only once the previous one's window is decided.
+func awaitLimitReadingSettled(t *testing.T) <-chan struct{} {
+	t.Helper()
+	settled := make(chan struct{}, 8)
+	previous := limitedReadingSettled
+	limitedReadingSettled = func() { settled <- struct{}{} }
+	t.Cleanup(func() { limitedReadingSettled = previous })
+	return settled
+}
+
+func expectLimitReading(t *testing.T, calls <-chan struct{}, what string) {
+	t.Helper()
+	select {
+	case <-calls:
+	case <-time.After(5 * time.Second):
+		t.Fatalf("%s queued no reading", what)
+	}
+}
+
+func expectNoLimitReading(t *testing.T, calls <-chan struct{}, what string) {
+	t.Helper()
+	select {
+	case <-calls:
+		t.Fatalf("%s queued a reading", what)
+	case <-time.After(200 * time.Millisecond):
+	}
+}
+
+// A subscription account's 429 queues one forced quota reading for that account, so the reading
+// shows the limit; repeats within the account's window and other statuses or providers queue nothing.
+func TestBasaltLimitQueuesOneFreshReadingForTheAccount(t *testing.T) {
+	rt := newUsageResultTestRuntime(t, &coreauth.Auth{ID: "claude-a", Index: "claude-a-index", Provider: "claude", Status: coreauth.StatusActive})
+	other := &coreauth.Auth{ID: "gemini-a", Index: "gemini-a-index", Provider: "gemini", Status: coreauth.StatusActive}
+	if _, errRegister := rt.coreManager.Register(context.Background(), other); errRegister != nil {
+		t.Fatal(errRegister)
+	}
+	collector := &limitReadingCollector{calls: make(chan struct{}, 8)}
+	rt.usageCreditCollector = collector
+	rt.RecordUsagePayload(context.Background(), limitPayload("claude-a-index", "claude", 429))
+	select {
+	case <-collector.calls:
+	case <-time.After(5 * time.Second):
+		t.Fatal("a Claude 429 queued no fresh reading")
+	}
+	for _, payload := range []string{
+		limitPayload("claude-a-index", "claude", 429), // within the account's window
+		limitPayload("claude-a-index", "claude", 500),
+		limitPayload("gemini-a-index", "gemini", 429),
+	} {
+		rt.RecordUsagePayload(context.Background(), payload)
+	}
+	select {
+	case <-collector.calls:
+		t.Fatalf("queued more readings than one: %v", collector.triggered())
+	case <-time.After(200 * time.Millisecond):
+	}
+	if got := collector.triggered(); len(got) != 1 || got[0] != "claude-a" {
+		t.Fatalf("queued readings for %v, want exactly claude-a", got)
+	}
+}
+
+// Queueing never makes the 429's report wait, even when the collector is slow.
+func TestBasaltLimitReadingDoesNotBlockTheReport(t *testing.T) {
+	rt := newUsageResultTestRuntime(t, &coreauth.Auth{ID: "codex-a", Index: "codex-a-index", Provider: "codex", Status: coreauth.StatusActive})
+	collector := &limitReadingCollector{calls: make(chan struct{})} // unbuffered: the trigger blocks until read
+	rt.usageCreditCollector = collector
+	done := make(chan struct{})
+	go func() {
+		rt.RecordUsagePayload(context.Background(), limitPayload("codex-a-index", "codex", 429))
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("the 429's report waited for the collector")
+	}
+	<-collector.calls
+}
+
+// The limit reading and the funding refusal's refresh keep separate windows: a refresh taken before
+// the limit doesn't hold back the reading that shows it, and a limit reading doesn't make a funding
+// refusal skip the fresh reading it waits for.
+func TestBasaltLimitReadingKeepsItsOwnWindow(t *testing.T) {
+	rt := newUsageResultTestRuntime(t, &coreauth.Auth{ID: "claude-a", Index: "claude-a-index", Provider: "claude", Status: coreauth.StatusActive})
+	collector := &limitReadingCollector{calls: make(chan struct{}, 8)}
+	rt.usageCreditCollector = collector
+	rt.usageCreditRefreshMu.Lock()
+	rt.usageCreditRefreshAt = map[string]time.Time{"claude-a": time.Now()}
+	rt.usageCreditRefreshMu.Unlock()
+	rt.RecordUsagePayload(context.Background(), limitPayload("claude-a-index", "claude", 429))
+	select {
+	case <-collector.calls:
+	case <-time.After(5 * time.Second):
+		t.Fatal("a refresh taken before the limit held back the limit's reading")
+	}
+	rt.usageCreditRefreshMu.Lock()
+	delete(rt.usageCreditRefreshAt, "claude-a")
+	rt.usageCreditRefreshMu.Unlock()
+	if _, errRefresh := rt.requestUsageCreditRefresh(context.Background(), []string{"claude-a"}); errRefresh != nil {
+		t.Fatalf("funding refresh after a limit reading = %v", errRefresh)
+	}
+	select {
+	case <-collector.calls:
+	case <-time.After(5 * time.Second):
+		t.Fatal("a limit reading made the funding refusal skip its fresh reading")
+	}
+}
+
+// A 429 whose reading the collector didn't accept, because a collection of the account was already
+// running and may have read it before the limit, doesn't hold back the next 429's reading for the
+// window; only the short retry does.
+func TestBasaltLimitReadingWindowStartsOnlyWhenAReadingIsAccepted(t *testing.T) {
+	previousRetry := limitedReadingRetry
+	limitedReadingRetry = 0
+	t.Cleanup(func() { limitedReadingRetry = previousRetry })
+	settled := awaitLimitReadingSettled(t)
+	rt := newUsageResultTestRuntime(t, &coreauth.Auth{ID: "claude-a", Index: "claude-a-index", Provider: "claude", Status: coreauth.StatusActive})
+	collector := &limitReadingCollector{calls: make(chan struct{}, 8), accept: func(call int) int {
+		if call == 1 {
+			return 0
+		}
+		return 1
+	}}
+	rt.usageCreditCollector = collector
+	rt.RecordUsagePayload(context.Background(), limitPayload("claude-a-index", "claude", 429))
+	expectLimitReading(t, collector.calls, "the first 429")
+	<-settled
+	rt.RecordUsagePayload(context.Background(), limitPayload("claude-a-index", "claude", 429))
+	expectLimitReading(t, collector.calls, "a 429 after one whose reading wasn't accepted")
+	<-settled
+	rt.RecordUsagePayload(context.Background(), limitPayload("claude-a-index", "claude", 429))
+	expectNoLimitReading(t, collector.calls, "a 429 right after an accepted reading")
+}
+
+// Each account and model keeps its own window: a limit on a second model within the window gets its
+// own reading, while a repeat on the same model doesn't.
+func TestBasaltLimitReadingIsPerModel(t *testing.T) {
+	settled := awaitLimitReadingSettled(t)
+	rt := newUsageResultTestRuntime(t, &coreauth.Auth{ID: "claude-a", Index: "claude-a-index", Provider: "claude", Status: coreauth.StatusActive})
+	collector := &limitReadingCollector{calls: make(chan struct{}, 8)}
+	rt.usageCreditCollector = collector
+	rt.RecordUsagePayload(context.Background(), limitPayloadForModel("claude-a-index", "claude", "model-a", 429))
+	expectLimitReading(t, collector.calls, "a 429 on model-a")
+	<-settled
+	rt.RecordUsagePayload(context.Background(), limitPayloadForModel("claude-a-index", "claude", "model-b", 429))
+	expectLimitReading(t, collector.calls, "a 429 on model-b within model-a's window")
+	<-settled
+	rt.RecordUsagePayload(context.Background(), limitPayloadForModel("claude-a-index", "claude", "model-a", 429))
+	expectNoLimitReading(t, collector.calls, "a repeat 429 on model-a")
+	if got := collector.triggered(); len(got) != 2 {
+		t.Fatalf("queued readings for %v, want one per model", got)
+	}
+}
