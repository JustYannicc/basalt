+// limitedReadingTimeout bounds the queueing of one forced collection after a 429.
+const limitedReadingTimeout = 10 * time.Second
+
+// limitedReadingWindow is how long one accepted forced reading holds back the next for the same
+// account and model. It matches the collector's own backoff after a failed probe, so a run of 429s on
+// one model adds at most one usage probe per account and model in that time, per Home; a probe the
+// usage endpoint itself refuses marks the account unavailable until its next probe, and forcing one
+// every few seconds would make that likelier.
+const limitedReadingWindow = 5 * time.Minute
+
+// limitedReadingRetry is how long a 429 waits to queue a reading when none was accepted because a
+// collection of the account was already running. That collection may have read the account before
+// the limit, so the next 429 after it queues its own; the wait only keeps a burst of 429s from
+// listing every credential once each.
+var limitedReadingRetry = 10 * time.Second
+
+// limitedReadingSettled runs once a queued reading's trigger has returned. Tests wait on it.
+var limitedReadingSettled = func() {}
+
+type limitedReadingKey struct {
+	authID string
+	model  string
+}
+
+// requestLimitedReading queues one forced quota collection for an account whose call on model was
+// just refused 429, so its reading shows the limit and the funding filter can drop it while another
+// account is eligible. Each account and model keeps its own window, apart from the funding refusal's
+// refresh, and the window starts only when the collector accepted the reading. It never makes the
+// caller wait: queueing reads the credentials, so it runs on its own goroutine with a detached,
+// bounded context.
+func (r *Runtime) requestLimitedReading(ctx context.Context, id, model string) {
+	key := limitedReadingKey{authID: strings.TrimSpace(id), model: coreauth.CanonicalModelID(model)}
+	if r == nil || key.authID == "" {
+		return
+	}
+	r.cfgMu.RLock()
+	collector := r.usageCreditCollector
+	r.cfgMu.RUnlock()
+	if collector == nil {
+		return
+	}
+	now := time.Now()
+	r.limitReadingMu.Lock()
+	if r.limitReadingUntil == nil {
+		r.limitReadingUntil = make(map[limitedReadingKey]time.Time)
+	}
+	for queued, until := range r.limitReadingUntil {
+		if !now.Before(until) {
+			delete(r.limitReadingUntil, queued)
+		}
+	}
+	if _, queued := r.limitReadingUntil[key]; queued {
+		r.limitReadingMu.Unlock()
+		return
+	}
+	// Held while the trigger runs, so concurrent 429s don't queue a second reading.
+	r.limitReadingUntil[key] = now.Add(limitedReadingWindow)
+	r.limitReadingMu.Unlock()
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	queueCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), limitedReadingTimeout)
+	go func() {
+		defer limitedReadingSettled()
+		defer cancel()
+		accepted, errTrigger := collector.TriggerCollection(queueCtx, map[string]struct{}{key.authID: {}}, nil)
+		if errTrigger == nil && accepted > 0 {
+			return
+		}
+		r.limitReadingMu.Lock()
+		if errTrigger != nil {
+			// This collection never started: let the next 429 try again.
+			delete(r.limitReadingUntil, key)
+		} else {
+			r.limitReadingUntil[key] = time.Now().Add(limitedReadingRetry)
+		}
+		r.limitReadingMu.Unlock()
+	}()
+}
+
 // forgetUsageCreditRefresh lets the next refusal retry a collection that never started.
 func (r *Runtime) forgetUsageCreditRefresh(ids map[string]struct{}) {
 	r.usageCreditRefreshMu.Lock()
