@@ -0,0 +1,64 @@
+package auth
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"sync/atomic"
+	"testing"
+
+	internalconfig "github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executionregistry"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+type fundingHomeDispatcher struct {
+	retainingHomeExecutionDispatcher
+	checks atomic.Int32
+	denied atomic.Bool
+}
+
+func (d *fundingHomeDispatcher) ValidateUsageCreditTurn(context.Context, string, http.Header, string) error {
+	d.checks.Add(1)
+	if d.denied.Load() {
+		return errors.New("plan account recovered; credits forbidden")
+	}
+	return nil
+}
+func TestBasaltUsageCreditRetainedTurnRefusesBeforeExecutor(t *testing.T) {
+	dispatcher := &fundingHomeDispatcher{}
+	manager := NewManager(nil, nil, nil)
+	manager.SetConfig(&internalconfig.Config{Home: internalconfig.HomeConfig{Enabled: true}})
+	manager.PublishHomeDispatch(dispatcher, executionregistry.New(), 1)
+	executor := &retainingHomeExecutionExecutor{}
+	manager.RegisterExecutor(executor)
+	ctx := cliproxyexecutor.WithDownstreamWebsocket(context.Background())
+	opts := cliproxyexecutor.Options{Metadata: map[string]any{cliproxyexecutor.ExecutionSessionMetadataKey: "credits-session", cliproxyexecutor.PinnedAuthMetadataKey: "home-auth"}}
+	request := cliproxyexecutor.Request{Model: "model-a", Payload: []byte(`{"previous_response_id":"account-owned-response"}`)}
+	if _, errExecute := manager.Execute(ctx, []string{"home-execution"}, request, opts); errExecute != nil {
+		t.Fatal(errExecute)
+	}
+	dispatcher.denied.Store(true)
+	if _, errExecute := manager.Execute(ctx, []string{"home-execution"}, request, opts); errExecute == nil {
+		t.Fatal("retained turn bypassed funding policy")
+	}
+	if executor.calls.Load() != 1 || dispatcher.calls.Load() != 1 || dispatcher.checks.Load() < 1 {
+		t.Fatal("denied turn executed or redispatched account-owned response")
+	}
+	dispatcher.denied.Store(false)
+	if _, errExecute := manager.Execute(ctx, []string{"home-execution"}, request, opts); errExecute != nil {
+		t.Fatal(errExecute)
+	}
+	if executor.calls.Load() != 2 {
+		t.Fatal("allowed retained turn failed to resume")
+	}
+}
+
+func TestBasaltUsageCreditUnsupportedValidatorFailsClosed(t *testing.T) {
+	manager := NewManager(nil, nil, nil)
+	manager.SetConfig(&internalconfig.Config{Home: internalconfig.HomeConfig{Enabled: true}})
+	manager.PublishHomeDispatch(&fixtureHomeDispatcher{}, executionregistry.New(), 1)
+	if errValidate := manager.ValidateHomeUsageCreditTurn(context.Background(), "model", nil, "account"); errValidate == nil {
+		t.Fatal("missing validation capability allowed paid turn")
+	}
+}
