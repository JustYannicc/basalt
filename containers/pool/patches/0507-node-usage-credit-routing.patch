new file mode 100644
index 0000000..3bd22b4
--- /dev/null
+++ b/sdk/cliproxy/auth/usage_credits.go
@@ -0,0 +1,29 @@
+package auth
+
+import (
+	"context"
+	"net/http"
+)
+
+type homeUsageCreditValidator interface {
+	ValidateUsageCreditTurn(context.Context, string, http.Header, string) error
+}
+
+// Retained transports recheck funding at each new turn, before forwarding any upstream bytes.
+func (m *Manager) ValidateHomeUsageCreditTurn(ctx context.Context, model string, headers http.Header, authID string) error {
+	if m == nil || !m.HomeEnabled() {
+		return nil
+	}
+	bundle := m.HomeDispatchBundle()
+	if bundle == nil || bundle.client == nil {
+		return &Error{Code: "usage_credit_policy_unavailable", Message: "Pool credit policy is unavailable. Reconnect before another turn.", HTTPStatus: 503, Retryable: true}
+	}
+	validator, ok := bundle.client.(homeUsageCreditValidator)
+	if !ok {
+		return &Error{Code: "usage_credit_policy_unavailable", Message: "Pool funding validation is unavailable. Reconnect before another turn.", HTTPStatus: 503, Retryable: true}
+	}
+	if errValidate := validator.ValidateUsageCreditTurn(ctx, model, headers, authID); errValidate != nil {
+		return &Error{Code: "continuity_requires_reconnect", Message: "The retained account no longer satisfies pool funding policy. Reconnect and replay the full context.", HTTPStatus: 409, Retryable: true}
+	}
+	return nil
+}
