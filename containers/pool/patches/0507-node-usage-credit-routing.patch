+package home
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"strings"
+
+	"github.com/MoeForge/moego/ojson"
+)
+
+// ValidateUsageCreditTurn reads policy without acquiring another concurrency admission.
+// Older Home rejects unknown types before calling its auth dispatch handler.
+func (c *Client) ValidateUsageCreditTurn(ctx context.Context, model string, headers http.Header, authID string) error {
+	if c == nil || strings.TrimSpace(authID) == "" {
+		return errors.New("retained funding validation unavailable")
+	}
+	cmd, errClient := c.commandClient()
+	if errClient != nil {
+		return errClient
+	}
+	payload := ojson.NewDocString("{}")
+	if errSet := payload.Set("type", "usage-credit-check"); errSet != nil {
+		return errSet
+	}
+	if errSet := payload.Set("model", model); errSet != nil {
+		return errSet
+	}
+	if errSet := payload.Set("headers", headersToLowerMap(headers)); errSet != nil {
+		return errSet
+	}
+	if errSet := payload.Set("pinned_auth_id", authID); errSet != nil {
+		return errSet
+	}
+	raw, errCheck := cmd.RPop(ctx, string(payload.Bytes())).Bytes()
+	if errCheck != nil {
+		return errCheck
+	}
+	if !ojson.ValidBytes(raw) || ojson.GetBytesNoCopy(raw, "usage_credit_allowed").Raw != "true" || ojson.GetBytesNoCopy(raw, "auth_id").String() != authID {
+		return errors.New("retained account no longer satisfies pool funding policy; reconnect")
+	}
+	return nil
+}
