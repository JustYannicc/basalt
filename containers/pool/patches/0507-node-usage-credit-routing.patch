+package home
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/MoeForge/moego/ojson"
+)
+
+func TestBasaltUsageCreditWireRefusesUnsupportedOrMalformedCheck(t *testing.T) {
+	for _, response := range []string{"-ERR unsupported type\r\n", "{\"usage_credit_allowed\":true,\"auth_id\":\"other\"}", "{\"usage_credit_allowed\":\"true\",\"auth_id\":\"account\"}"} {
+		client, commands := newRedisCommandTestClient(t, func(args []string) string {
+			if len(args) > 0 && strings.EqualFold(args[0], "RPOP") {
+				if strings.HasPrefix(response, "-") {
+					return response
+				}
+				return fmt.Sprintf("$%d\r\n%s\r\n", len(response), response)
+			}
+			return "-ERR unexpected command\r\n"
+		})
+		if errCheck := client.ValidateUsageCreditTurn(context.Background(), "model", http.Header{"Authorization": {"Bearer synthetic-fixture"}}, "account"); errCheck == nil {
+			t.Fatal("invalid check acknowledged")
+		}
+		last := commands.Last()
+		if len(last) != 2 || !strings.EqualFold(last[0], "RPOP") || ojson.Get(last[1], "type").String() != "usage-credit-check" || ojson.Get(last[1], "pinned_auth_id").String() != "account" {
+			t.Fatal("check used a dispatch request")
+		}
+	}
+}
