+	"testing"
+
+	"github.com/MoeForge/moego/ojson"
+	"github.com/gin-gonic/gin"
+	"github.com/gorilla/websocket"
+	internalconfig "github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/api/handlers"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executionregistry"
+	sdkconfig "github.com/router-for-me/CLIProxyAPI/v8/sdk/config"
+)
+
+func (*homeResponsesWebsocketDispatcher) ValidateUsageCreditTurn(context.Context, string, http.Header, string) error {
+	return nil
+}
+
+type creditWebsocketDispatcher struct {
+	homeResponsesWebsocketDispatcher
+	denied atomic.Bool
+	checks atomic.Int32
+}
+
+func (d *creditWebsocketDispatcher) ValidateUsageCreditTurn(context.Context, string, http.Header, string) error {
+	d.checks.Add(1)
+	if d.denied.Load() {
+		return errors.New("pool policy requires plan account")
+	}
+	return nil
+}
+func TestBasaltUsageCreditWebsocketContinuationRefusesBeforeForwarding(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	dispatcher := &creditWebsocketDispatcher{}
+	executor := &homeResponsesWebsocketExecutor{}
+	manager := coreauth.NewManager(nil, nil, nil)
+	manager.SetConfig(&internalconfig.Config{Home: internalconfig.HomeConfig{Enabled: true}})
+	manager.PublishHomeDispatch(dispatcher, executionregistry.New(), 1)
+	manager.RegisterExecutor(executor)
+	handler := NewOpenAIResponsesAPIHandler(handlers.NewBaseAPIHandlers(&sdkconfig.SDKConfig{}, manager))
+	router := gin.New()
+	router.GET("/v1/responses/ws", handler.ResponsesWebsocket)
+	server := httptest.NewServer(router)
+	defer server.Close()
+	conn, _, errDial := websocket.DefaultDialer.Dial("ws"+strings.TrimPrefix(server.URL, "http")+"/v1/responses/ws", nil)
+	if errDial != nil {
+		t.Fatal(errDial)
+	}
+	defer func() {
+		if errClose := conn.Close(); errClose != nil {
+			t.Logf("close websocket: %v", errClose)
+		}
+	}()
+	send := func(payload string) []byte {
+		t.Helper()
+		if errWrite := conn.WriteMessage(websocket.TextMessage, []byte(payload)); errWrite != nil {
+			t.Fatal(errWrite)
+		}
+		_, response, errRead := conn.ReadMessage()
+		if errRead != nil {
+			t.Fatal(errRead)
+		}
+		return response
+	}
+	first := send(`{"type":"response.create","model":"basalt-home-only-model","input":[]}`)
+	if ojson.GetBytes(first, "type").String() != wsEventTypeCompleted {
+		t.Fatal("initial turn did not finish")
+	}
+	dispatcher.denied.Store(true)
+	second := send(`{"type":"response.create","model":"basalt-home-only-model","previous_response_id":"home-response","input":[]}`)
+	if ojson.GetBytes(second, "type").String() != "error" {
+		t.Fatalf("denied turn returned %s", second)
+	}
+	if executor.calls.Load() != 1 || dispatcher.calls.Load() != 1 || dispatcher.checks.Load() < 1 {
+		t.Fatal("retained response was forwarded or transferred to another account")
+	}
+}
