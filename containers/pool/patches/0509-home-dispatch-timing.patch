index 0000000..6dafebf
--- /dev/null
+++ b/internal/respserver/pop/dynamic/basalt_dispatch_timing_test.go
@@ -0,0 +1,63 @@
+package dynamic
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"strings"
+	"testing"
+
+	log "github.com/sirupsen/logrus"
+	logtest "github.com/sirupsen/logrus/hooks/test"
+)
+
+func TestBasaltHomeDispatchTimingNamesAdmissionFailureWithoutPrivateData(t *testing.T) {
+	for _, failed := range []bool{false, true} {
+		t.Run(map[bool]string{false: "success", true: "admission timeout"}[failed], func(t *testing.T) {
+			runtime, admitter := newConcurrencyDispatchRuntime(t, []string{"private-credential-sentinel"})
+			if failed {
+				admitter.SetResult("private-credential-sentinel", context.DeadlineExceeded)
+			}
+			logger := log.StandardLogger()
+			oldHooks := logger.Hooks
+			oldOutput := logger.Out
+			hook := logtest.NewGlobal()
+			logger.SetOutput(io.Discard)
+			defer func() { logger.ReplaceHooks(oldHooks); logger.SetOutput(oldOutput) }()
+			_ = handleAuth(context.Background(), protocolOneDispatchEnv(runtime, "private-fingerprint-sentinel"), []string{"RPOP", `{"type":"auth","model":"gpt","concurrency_protocol":1,"headers":{"x-api-key":"dispatch-client-key"}}`})
+			if admitter.Calls() != 1 {
+				t.Fatalf("admission calls=%d, want1", admitter.Calls())
+			}
+			stages := map[string]string{}
+			for _, entry := range hook.AllEntries() {
+				if !strings.HasPrefix(entry.Message, "POOL_HOME_DISPATCH_TIMING ") {
+					continue
+				}
+				if strings.Contains(entry.Message, "private-") || strings.Contains(entry.Message, "dispatch-client-key") {
+					t.Fatal("diagnostic retained request/credential data")
+				}
+				var record map[string]any
+				if json.Unmarshal([]byte(strings.TrimPrefix(entry.Message, "POOL_HOME_DISPATCH_TIMING ")), &record) != nil {
+					t.Fatal("invalid JSON")
+				}
+				if len(record) != 3 {
+					t.Fatalf("unexpected fields: %v", record)
+				}
+				elapsed, ok := record["duration_ms"].(float64)
+				if !ok || elapsed < 0 || elapsed > 86400000 {
+					t.Fatal("invalid duration")
+				}
+				stage, _ := record["stage"].(string)
+				outcome, _ := record["outcome"].(string)
+				stages[stage] = outcome
+			}
+			want := "ok"
+			if failed {
+				want = "timeout"
+			}
+			if stages["authenticate"] != "ok" || stages["selection"] != "ok" || stages["admission"] != want {
+				t.Fatalf("stage metadata=%v, want auth=ok,selection=ok,admission=%s", stages, want)
+			}
+		})
+	}
+}
