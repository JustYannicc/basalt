@@ -0,0 +1,46 @@
+package dispatchtiming
+
+import (
+	"context"
+	"errors"
+	"net"
+	"time"
+
+	log "github.com/sirupsen/logrus"
+)
+
+type Stage string
+
+const (
+	Authenticate Stage = "authenticate"
+	Selection    Stage = "selection"
+	Admission    Stage = "admission"
+	ReplyWrite   Stage = "reply_write"
+)
+
+// Record emits only bounded timings; request values and error text never enter the record.
+func Record(stage Stage, started time.Time, err error) {
+	switch stage {
+	case Authenticate, Selection, Admission, ReplyWrite:
+	default:
+		return
+	}
+	outcome := "ok"
+	if err != nil {
+		outcome = "error"
+		var timeout net.Error
+		if errors.Is(err, context.DeadlineExceeded) || errors.As(err, &timeout) && timeout.Timeout() {
+			outcome = "timeout"
+		} else if errors.Is(err, context.Canceled) {
+			outcome = "cancelled"
+		}
+	}
+	elapsed := time.Since(started).Milliseconds()
+	if elapsed < 0 {
+		elapsed = 0
+	}
+	if elapsed > 86400000 {
+		elapsed = 86400000
+	}
+	log.Infof(`POOL_HOME_DISPATCH_TIMING {"stage":"%s","duration_ms":%d,"outcome":"%s"}`, stage, elapsed, outcome)
+}
diff --git a/internal/dispatchtiming/timing_test.go b/internal/dispatchtiming/timing_test.go
