diff --git a/internal/respserver/basalt_dispatch_timing_test.go b/internal/respserver/basalt_dispatch_timing_test.go
new file mode 100644
index 0000000..83fc35f
--- /dev/null
+++ b/internal/respserver/basalt_dispatch_timing_test.go
@@ -0,0 +1,58 @@
+package respserver
+
+import (
+	"context"
+	"errors"
+	log "github.com/sirupsen/logrus"
+	logtest "github.com/sirupsen/logrus/hooks/test"
+	"io"
+	"strings"
+	"testing"
+)
+
+type dispatchTimingConn struct {
+	*subscriptionTestConn
+	failed bool
+}
+
+func (c *dispatchTimingConn) Read(p []byte) (int, error) { return c.input.Read(p) }
+func (c *dispatchTimingConn) Write(p []byte) (int, error) {
+	if c.failed {
+		return 0, errors.New("private-write-sentinel")
+	}
+	return c.subscriptionTestConn.Write(p)
+}
+func TestBasaltHomeDispatchTimingReplyTransport(t *testing.T) {
+	for _, failed := range []bool{false, true} {
+		t.Run(map[bool]string{false: "success", true: "write failure"}[failed], func(t *testing.T) {
+			runtime := newSubscriptionTestRuntime(t, &blockingConfigAdapter{loadStarted: make(chan struct{})})
+			logger := log.StandardLogger()
+			oldHooks := logger.Hooks
+			oldOutput := logger.Out
+			hook := logtest.NewGlobal()
+			logger.SetOutput(io.Discard)
+			defer func() { logger.ReplaceHooks(oldHooks); logger.SetOutput(oldOutput) }()
+			conn := &dispatchTimingConn{newSubscriptionTestConn("RPOP", `{"type":"auth","model":"private-model-sentinel"}`), failed}
+			New("", runtime).HandleConn(context.Background(), conn)
+			found := 0
+			for _, entry := range hook.AllEntries() {
+				if strings.HasPrefix(entry.Message, "POOL_HOME_DISPATCH_TIMING ") && strings.Contains(entry.Message, `"stage":"reply_write"`) {
+					found++
+					want := "ok"
+					if failed {
+						want = "error"
+					}
+					if !strings.Contains(entry.Message, `"outcome":"`+want+`"`) || strings.Contains(entry.Message, "private-") {
+						t.Fatalf("invalid reply metadata %s", entry.Message)
+					}
+				}
+			}
+			if found != 1 {
+				t.Fatalf("reply write records=%d, want1", found)
+			}
+			if !failed && conn.Output() == "" {
+				t.Fatal("response was suppressed")
+			}
+		})
+	}
+}
