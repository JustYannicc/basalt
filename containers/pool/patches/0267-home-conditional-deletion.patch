diff --git a/internal/cluster/conditional_delete.go b/internal/cluster/conditional_delete.go
new file mode 100644
--- /dev/null
+++ b/internal/cluster/conditional_delete.go
@@ -0,0 +1,53 @@
+package cluster
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+
+	"gorm.io/gorm"
+)
+
+var ErrDeletePrecondition = errors.New("delete precondition failed")
+
+// Conditional deletes use the same row lock as refresh writers until the tombstone commits.
+func (r *Repository) deleteIfMatch(ctx context.Context, query string, id any, expected string, remove func(*Repository) error) error {
+	db, errDB := r.database()
+	if errDB != nil {
+		return errDB
+	}
+	if db.Dialector.Name() != "postgres" {
+		return fmt.Errorf("conditional deletion requires PostgreSQL")
+	}
+	return db.WithContext(contextOrBackground(ctx)).Transaction(func(tx *gorm.DB) error {
+		if errBudget := tx.Exec("SET LOCAL statement_timeout = '8s'").Error; errBudget != nil {
+			return errBudget
+		}
+		if errLock := tx.Exec("SET LOCAL lock_timeout = '500ms'").Error; errLock != nil {
+			return errLock
+		}
+		var row string
+		if errRead := tx.Raw(query, id).Row().Scan(&row); errRead != nil {
+			return ErrDeletePrecondition
+		}
+		sum := sha256.Sum256([]byte(row))
+		if hex.EncodeToString(sum[:]) != expected {
+			return ErrDeletePrecondition
+		}
+		return remove(NewRepository(tx))
+	})
+}
+
+func (r *Repository) SoftDeleteAuthIfMatch(ctx context.Context, id, expected string) error {
+	return r.deleteIfMatch(ctx, "SELECT to_jsonb(a)::text FROM auth a WHERE uuid = ? AND deleted_at IS NULL FOR UPDATE", id, expected, func(locked *Repository) error {
+		return locked.SoftDeleteAuth(ctx, id)
+	})
+}
+
+func (r *Repository) DeleteChannelGroupDetailIfMatch(ctx context.Context, id uint, expected string) error {
+	return r.deleteIfMatch(ctx, "SELECT to_jsonb(m)::text FROM channel_group_detail m WHERE id = ? AND deleted_at IS NULL FOR UPDATE", id, expected, func(locked *Repository) error {
+		return locked.DeleteChannelGroupDetail(ctx, id)
+	})
+}
diff --git a/internal/cluster/conditional_delete_test.go b/internal/cluster/conditional_delete_test.go
new file mode 100644
--- /dev/null
+++ b/internal/cluster/conditional_delete_test.go
@@ -0,0 +1,91 @@
+package cluster
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"os"
+	"testing"
+
+	"gorm.io/driver/postgres"
+	"gorm.io/gorm"
+)
+
+func TestConditionalDeletePostgres(t *testing.T) {
+	dsn := os.Getenv("CLIPROXY_HOME_TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("CLIPROXY_HOME_TEST_POSTGRES_DSN is not configured")
+	}
+	db, errOpen := gorm.Open(postgres.Open(dsn), databaseGORMConfig(defaultDatabaseSlowQueryThreshold))
+	if errOpen != nil {
+		t.Fatal(errOpen)
+	}
+	sqlDB, errDB := db.DB()
+	if errDB != nil {
+		t.Fatal(errDB)
+	}
+	defer func() {
+		if errClose := sqlDB.Close(); errClose != nil {
+			t.Error(errClose)
+		}
+	}()
+	if errMigrate := db.AutoMigrate(&AuthRecord{}, &ChannelGroupDetailRecord{}, &QuotaSnapshotRecord{}, &QuotaWindowRecord{}, &ClusterEventRecord{}); errMigrate != nil {
+		t.Fatal(errMigrate)
+	}
+	ctx := context.Background()
+	repo := NewRepository(db)
+	credential := AuthRecord{UUID: "11111111-1111-4111-8111-111111111111", ID: "11111111-1111-4111-8111-111111111111", Provider: "claude", AuthJSON: JSONB(`{"access_token":"synthetic-token"}`)}
+	if errCreate := db.Create(&credential).Error; errCreate != nil {
+		t.Fatal(errCreate)
+	}
+	member := ChannelGroupDetailRecord{ChannelGroupID: 1, AuthID: credential.UUID}
+	if errCreate := db.Create(&member).Error; errCreate != nil {
+		t.Fatal(errCreate)
+	}
+	checksum := func(query string, id any) string {
+		t.Helper()
+		var row string
+		if errRead := db.Raw(query, id).Row().Scan(&row); errRead != nil {
+			t.Fatal(errRead)
+		}
+		sum := sha256.Sum256([]byte(row))
+		return hex.EncodeToString(sum[:])
+	}
+	authQuery := "SELECT to_jsonb(a)::text FROM auth a WHERE uuid = ?"
+	memberQuery := "SELECT to_jsonb(m)::text FROM channel_group_detail m WHERE id = ?"
+	approved := checksum(authQuery, credential.UUID)
+	// A normal refresh writer commits after the approval snapshot and before the DELETE.
+	if errRefresh := db.Model(&credential).Update("version", 2).Error; errRefresh != nil {
+		t.Fatal(errRefresh)
+	}
+	if errDelete := repo.SoftDeleteAuthIfMatch(ctx, credential.UUID, approved); !errors.Is(errDelete, ErrDeletePrecondition) {
+		t.Fatalf("stale credential deletion = %v", errDelete)
+	}
+	var active int64
+	if errCount := db.Model(&AuthRecord{}).Where("uuid = ?", credential.UUID).Count(&active).Error; errCount != nil || active != 1 {
+		t.Fatalf("refreshed credential was lost: count=%d err=%v", active, errCount)
+	}
+	memberApproved := checksum(memberQuery, member.ID)
+	if errRefresh := db.Model(&member).Update("channel_group_id", 2).Error; errRefresh != nil {
+		t.Fatal(errRefresh)
+	}
+	if errDelete := repo.DeleteChannelGroupDetailIfMatch(ctx, member.ID, memberApproved); !errors.Is(errDelete, ErrDeletePrecondition) {
+		t.Fatalf("stale membership deletion = %v", errDelete)
+	}
+	if errCount := db.Model(&ChannelGroupDetailRecord{}).Where("id = ?", member.ID).Count(&active).Error; errCount != nil || active != 1 {
+		t.Fatalf("changed membership was lost: count=%d err=%v", active, errCount)
+	}
+	if errDelete := repo.SoftDeleteAuthIfMatch(ctx, credential.UUID, checksum(authQuery, credential.UUID)); errDelete != nil {
+		t.Fatal(errDelete)
+	}
+	if errDelete := repo.DeleteChannelGroupDetailIfMatch(ctx, member.ID, checksum(memberQuery, member.ID)); errDelete != nil {
+		t.Fatal(errDelete)
+	}
+	if errCount := db.Model(&AuthRecord{}).Where("uuid = ?", credential.UUID).Count(&active).Error; errCount != nil || active != 0 {
+		t.Fatalf("credential remains: count=%d err=%v", active, errCount)
+	}
+	if errCount := db.Model(&ChannelGroupDetailRecord{}).Where("id = ?", member.ID).Count(&active).Error; errCount != nil || active != 0 {
+		t.Fatalf("membership remains: count=%d err=%v", active, errCount)
+	}
+}
diff --git a/internal/cluster/management/conditional_delete.go b/internal/cluster/management/conditional_delete.go
new file mode 100644
--- /dev/null
+++ b/internal/cluster/management/conditional_delete.go
@@ -0,0 +1,80 @@
+package management
+
+import (
+	"errors"
+	"net/http"
+	"regexp"
+	"strings"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPIHome/internal/cluster"
+)
+
+var deleteChecksum = regexp.MustCompile(`^"[a-f0-9]{64}"$`)
+
+func conditionalChecksum(c *gin.Context) (string, bool) {
+	value := c.GetHeader("If-Match")
+	if !deleteChecksum.MatchString(value) {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid_request"})
+		return "", false
+	}
+	return strings.Trim(value, `"`), true
+}
+
+func conditionalDeleteError(c *gin.Context, err error) {
+	if errors.Is(err, cluster.ErrDeletePrecondition) {
+		c.JSON(http.StatusPreconditionFailed, gin.H{"error": "precondition_failed"})
+		return
+	}
+	respondError(c, http.StatusInternalServerError, "write_failed", err)
+}
+
+func (h *Handler) DeleteCredentialConditional(c *gin.Context) {
+	checksum, ok := conditionalChecksum(c)
+	if !ok {
+		return
+	}
+	id := strings.TrimSpace(c.Query("id"))
+	if id == "" {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid_request"})
+		return
+	}
+	ctx, cancel := h.requestContext(c)
+	defer cancel()
+	auth, errAuth := h.findOAuthAuth(ctx, authIdentifier{ID: id})
+	if errAuth != nil {
+		respondError(c, http.StatusInternalServerError, "auth_load_failed", errAuth)
+		return
+	}
+	if auth == nil {
+		c.JSON(http.StatusPreconditionFailed, gin.H{"error": "precondition_failed"})
+		return
+	}
+	if errDelete := h.repo.SoftDeleteAuthIfMatch(ctx, id, checksum); errDelete != nil {
+		conditionalDeleteError(c, errDelete)
+		return
+	}
+	if errRefresh := h.refreshAuths(ctx); errRefresh != nil {
+		respondError(c, http.StatusInternalServerError, "reload_failed", errRefresh)
+		return
+	}
+	respondOK(c)
+}
+
+func (h *Handler) DeleteChannelGroupDetailConditional(c *gin.Context) {
+	checksum, ok := conditionalChecksum(c)
+	if !ok {
+		return
+	}
+	id, ok := channelIDFromParam(c)
+	if !ok {
+		return
+	}
+	ctx, cancel := h.requestContext(c)
+	defer cancel()
+	if errDelete := h.repo.DeleteChannelGroupDetailIfMatch(ctx, id, checksum); errDelete != nil {
+		conditionalDeleteError(c, errDelete)
+		return
+	}
+	respondOK(c)
+}
