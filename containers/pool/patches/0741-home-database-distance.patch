+package cluster
+
+import (
+	"context"
+	"time"
+)
+
+// DatabaseRoundTrip times one trivial statement on this repository's own pool, so a runtime can
+// measure its distance to the database over the connection its work actually uses.
+func (r *Repository) DatabaseRoundTrip(ctx context.Context) (time.Duration, error) {
+	db, errDB := r.database()
+	if errDB != nil {
+		return 0, errDB
+	}
+	var one int
+	started := time.Now()
+	errScan := db.WithContext(contextOrBackground(ctx)).Raw("SELECT 1").Scan(&one).Error
+	return time.Since(started), errScan
+}
diff --git a/internal/cluster/management/database_distance.go b/internal/cluster/management/database_distance.go
new file mode 100644
index 0000000..2a912ba
--- /dev/null
+++ b/internal/cluster/management/database_distance.go
@@ -0,0 +1,68 @@
+package management
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"sort"
+	"time"
+
+	"github.com/gin-gonic/gin"
+)
+
+const (
+	databaseDistanceSamples      = 7
+	databaseDistanceMinimum      = 3
+	databaseDistanceSampleBudget = 500 * time.Millisecond
+	databaseDistanceTotalBudget  = 3500 * time.Millisecond
+)
+
+var errDatabaseDistanceUnavailable = errors.New("too few database round trips answered")
+
+// GetDatabaseDistance reports the shortest round trip to the database on the pool the node listing
+// uses (Home's coordination pool when configured). The pool supervisor puts it on readiness, and
+// the controller routes to runtimes near the database. One unmeasured statement first warms the
+// connection, so connection setup never counts as distance.
+func (h *Handler) GetDatabaseDistance(c *gin.Context) {
+	repo := h.livenessRepository()
+	if repo == nil {
+		respondError(c, http.StatusServiceUnavailable, "distance_unavailable", errDatabaseDistanceUnavailable)
+		return
+	}
+	ctx, cancel := context.WithTimeout(c.Request.Context(), databaseDistanceTotalBudget)
+	defer cancel()
+	sample := func() (time.Duration, error) {
+		sampleCtx, cancelSample := context.WithTimeout(ctx, databaseDistanceSampleBudget)
+		defer cancelSample()
+		return repo.DatabaseRoundTrip(sampleCtx)
+	}
+	_, _ = sample()
+	samples := make([]time.Duration, 0, databaseDistanceSamples)
+	for range databaseDistanceSamples {
+		if ctx.Err() != nil {
+			break
+		}
+		if elapsed, err := sample(); err == nil {
+			samples = append(samples, elapsed)
+		}
+	}
+	if len(samples) < databaseDistanceMinimum {
+		respondError(c, http.StatusServiceUnavailable, "distance_unavailable", errDatabaseDistanceUnavailable)
+		return
+	}
+	sort.Slice(samples, func(i, j int) bool { return samples[i] < samples[j] })
+	// Queueing in the pool or the pooler only adds time, so the fastest round trip is the distance;
+	// a near runtime booting while the database is busy must not read as far and be redrawn.
+	c.JSON(http.StatusOK, gin.H{
+		"rtt_ms":    wholeMilliseconds(samples[0]),
+		"median_ms": wholeMilliseconds(samples[len(samples)/2]),
+		"max_ms":    wholeMilliseconds(samples[len(samples)-1]),
+		"samples":   len(samples),
+	})
+}
+
+// wholeMilliseconds rounds up and never reports zero, so a near database still reads as a distance.
+func wholeMilliseconds(d time.Duration) int {
+	ms := int((d + time.Millisecond - 1) / time.Millisecond)
+	return max(ms, 1)
+}
diff --git a/internal/cluster/management/database_distance_test.go b/internal/cluster/management/database_distance_test.go
new file mode 100644
index 0000000..cd6c030
--- /dev/null
+++ b/internal/cluster/management/database_distance_test.go
@@ -0,0 +1,70 @@
+package management
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPIHome/internal/cluster"
+)
+
+func newDistanceServer(t *testing.T) (*httptest.Server, func()) {
+	t.Helper()
+	db, errOpen := cluster.OpenSQLite(context.Background(), filepath.Join(t.TempDir(), "home.db"))
+	if errOpen != nil {
+		t.Fatal(errOpen)
+	}
+	handler := NewHandler(cluster.NewRepository(db), nil, "127.0.0.1", 18317)
+	gin.SetMode(gin.TestMode)
+	engine := gin.New()
+	engine.GET("/v8/management/database/distance", handler.GetDatabaseDistance)
+	server := httptest.NewServer(engine)
+	closeDB := func() {
+		if sqlDB, errDB := db.DB(); errDB == nil {
+			_ = sqlDB.Close()
+		}
+	}
+	t.Cleanup(func() {
+		server.Close()
+		closeDB()
+	})
+	return server, closeDB
+}
+
+func TestDatabaseDistanceReportsTheShortestRoundTripInWholeMilliseconds(t *testing.T) {
+	server, _ := newDistanceServer(t)
+	resp, err := http.Get(server.URL + "/v8/management/database/distance")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	var body struct {
+		RTTMs    int `json:"rtt_ms"`
+		MedianMs int `json:"median_ms"`
+		MaxMs    int `json:"max_ms"`
+		Samples  int `json:"samples"`
+	}
+	if errDecode := json.NewDecoder(resp.Body).Decode(&body); errDecode != nil {
+		t.Fatal(errDecode)
+	}
+	if resp.StatusCode != http.StatusOK || body.Samples != databaseDistanceSamples || body.RTTMs < 1 || body.MedianMs < body.RTTMs || body.MaxMs < body.MedianMs {
+		t.Fatalf("distance answered %d %+v", resp.StatusCode, body)
+	}
+}
+
+func TestDatabaseDistanceRefusesWhenTheDatabaseDoesNotAnswer(t *testing.T) {
+	server, closeDB := newDistanceServer(t)
+	closeDB()
+	resp, err := http.Get(server.URL + "/v8/management/database/distance")
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp.Body.Close()
+	if resp.StatusCode != http.StatusServiceUnavailable {
+		t.Fatalf("a closed database answered %d", resp.StatusCode)
+	}
+}
