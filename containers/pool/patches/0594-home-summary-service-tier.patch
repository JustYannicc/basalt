diff --git a/internal/cluster/management/basalt_allowance_tier_test.go b/internal/cluster/management/basalt_allowance_tier_test.go
new file mode 100644
--- /dev/null
+++ b/internal/cluster/management/basalt_allowance_tier_test.go
@@ -0,0 +1,54 @@
+package management
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+)
+
+func TestUsageCreditSummaryServiceTierPreservesUnknownAndPrivacy(t *testing.T) {
+	handler, closeRepo := newUsageObservabilityTestHandler(t)
+	defer closeRepo()
+	seedUsageObservabilityManagementRecord(t, handler)
+	seedUsageObservabilityFailedManagementRecord(t, handler)
+	gin.SetMode(gin.TestMode)
+	engine := gin.New()
+	engine.GET("/usage/summary-records", handler.ListUsageSummaryRecords)
+	engine.GET("/usage/summary-pending", handler.ListPendingUsageSummaryRecords)
+	for _, path := range []string{
+		"/usage/summary-records?from=2026-06-10T00:00:00Z&to=2026-06-11T00:00:00Z",
+		"/usage/summary-pending?to=2026-06-11T00:00:00Z",
+	} {
+		response := httptest.NewRecorder()
+		engine.ServeHTTP(response, httptest.NewRequest(http.MethodGet, path, nil))
+		if response.Code != http.StatusOK {
+			t.Fatalf("summary returned HTTP %d", response.Code)
+		}
+		for _, private := range []string{"client-key-secret", "203.0.113.", "hello", "Primary OAuth", "auth_json", "payload", "request_id", "balance_after", "access_token"} {
+			if strings.Contains(response.Body.String(), private) {
+				t.Fatal("summary exposed private request metadata")
+			}
+		}
+		var result struct {
+			Items []struct {
+				ServiceTier *string `json:"service_tier"`
+			} `json:"items"`
+		}
+		if err := json.Unmarshal(response.Body.Bytes(), &result); err != nil {
+			t.Fatal(err)
+		}
+		if len(result.Items) != 2 {
+			t.Fatalf("summary returned %d rows", len(result.Items))
+		}
+		if result.Items[0].ServiceTier == nil || *result.Items[0].ServiceTier != "auto" {
+			t.Fatal("unknown tier must retain Home's auto marker")
+		}
+		if result.Items[1].ServiceTier == nil || *result.Items[1].ServiceTier != "priority" {
+			t.Fatal("known priority tier must survive the narrow projection")
+		}
+	}
+}
