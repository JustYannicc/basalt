package main

import (
	"encoding/json"
	"os"

	"github.com/router-for-me/CLIProxyAPIHome/internal/logging"
	log "github.com/sirupsen/logrus"
)

func main() {
	var records []struct {
		Message string     `json:"message"`
		Fields  log.Fields `json:"fields"`
	}
	if len(os.Args) != 2 || json.Unmarshal([]byte(os.Args[1]), &records) != nil {
		os.Exit(2)
	}
	logger := log.New()
	logger.SetOutput(os.Stdout)
	logger.SetFormatter(&logging.LogFormatter{})
	logger.SetReportCaller(true)
	for _, record := range records {
		logger.WithFields(record.Fields).Error(record.Message)
	}
	os.Exit(1)
}
