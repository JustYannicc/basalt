{
  "name": "basalt",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "prepare:upstream": "node scripts/prepare-upstream.ts",
    "check": "node --test src/catalog/*.test.ts src/*.test.ts src/pool/*.test.ts src/tunnel/*.test.ts src/setup/*.test.ts src/setup/*.test.mjs src/feedback/*.test.ts src/telemetry/*.test.ts src/site/*.test.ts scripts/*.test.ts apps/pool/*.test.ts apps/pool/ui/*.test.ts e2e/slack/*.test.mjs",
    "typecheck": "node scripts/typecheck.ts",
    "typecheck:upstream": "bun run --cwd .upstream typecheck",
    "build": "node scripts/build.ts",
    "check:build": "node --test scripts/build-tests/*.test.ts",
    "check:startup": "node --test scripts/worker-startup-tests/*.test.ts && node scripts/worker-startup.ts",
    "deploy": "node scripts/deploy.ts",
    "check:providers": "node scripts/pool-providers.ts --check",
    "check:upstream": "node --test scripts/upstream-tests/*.test.ts",
    "check:releases": "node --test scripts/releases/*.test.ts scripts/release-credentials/*.test.ts scripts/release-preview/*.test.ts scripts/release-merge/*.test.ts scripts/deploy-safety/*.test.ts scripts/deploy-main/*.test.ts scripts/preview/*.test.ts",
    "check:preview-auth": "node .upstream/apps/hosted/cloud/scripts/check-preview-password-sign-in.ts && node scripts/preview-auth/tests/check.ts",
    "prove:releases": "node scripts/releases/simulate.ts",
    "check:atlassian": "node scripts/check-atlassian.ts",
    "architecture:format": "bun run --cwd scripts/architecture format",
    "architecture:validate": "bun run --cwd scripts/architecture validate",
    "architecture:model": "bun run --cwd scripts/architecture model",
    "architecture:typecheck": "bun run --cwd scripts/architecture typecheck",
    "architecture:deployment": "bun run --cwd scripts/architecture deployment",
    "architecture:test": "bun run --cwd scripts/architecture test",
    "architecture:inventory": "bun run --cwd scripts/architecture inventory",
    "lint:apps": "node scripts/app-lint/check.mjs",
    "check:app-lint": "node --test scripts/app-lint/*.test.mjs"
  },
  "engines": {
    "node": ">=24.3.0"
  }
}
