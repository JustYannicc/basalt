{
  "name": "basalt",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:upstream": "node scripts/prepare-upstream.ts",
    "check": "node --test src/*.test.ts src/pool/*.test.ts src/setup/*.test.ts src/setup/*.test.mjs scripts/*.test.ts apps/pool/*.test.ts apps/pool/ui/*.test.ts",
    "typecheck": "node scripts/typecheck.ts",
    "build": "node scripts/build.ts",
    "check:build": "node --test scripts/build-tests/*.test.ts",
    "deploy": "node scripts/deploy.ts",
    "check:providers": "node scripts/pool-providers.ts --check",
    "check:upstream": "node --test scripts/upstream-tests/*.test.ts",
    "check:releases": "node --test scripts/releases/*.test.ts scripts/release-preview/*.test.ts scripts/release-merge/*.test.ts scripts/deploy-safety/*.test.ts scripts/preview/*.test.ts",
    "check:preview-auth": "node scripts/preview-auth/check.ts",
    "prove:releases": "node scripts/releases/simulate.ts",
    "architecture:format": "bun run --cwd scripts/architecture format",
    "architecture:validate": "bun run --cwd scripts/architecture validate",
    "architecture:model": "bun run --cwd scripts/architecture model",
    "architecture:typecheck": "bun run --cwd scripts/architecture typecheck",
    "architecture:deployment": "bun run --cwd scripts/architecture deployment",
    "architecture:test": "bun run --cwd scripts/architecture test",
    "architecture:inventory": "bun run --cwd scripts/architecture inventory"
  },
  "engines": {
    "node": ">=24.3.0"
  }
}
