{
  "extends": "./tsconfig.pool.json",
  "compilerOptions": {
    "paths": {
      "apps": ["./.upstream/packages/apps/dist/types/apps/src/index.d.ts"],
      "apps/*": ["./.upstream/packages/apps/dist/types/apps/src/*.d.ts"],
      "react": ["./.upstream/playground/demo-apps/live-inbox/node_modules/@types/react"],
      "react/*": ["./.upstream/playground/demo-apps/live-inbox/node_modules/@types/react/*"],
      "react-dom": ["./.upstream/playground/demo-apps/live-inbox/node_modules/@types/react-dom"],
      "react-dom/*": [
        "./.upstream/playground/demo-apps/live-inbox/node_modules/@types/react-dom/*"
      ],
      "react-markdown": ["./e2e/obsidian/vault-page/node_modules/react-markdown"],
      "remark-gfm": ["./e2e/obsidian/vault-page/node_modules/remark-gfm"],
      "@flowershow/remark-wiki-link": [
        "./e2e/obsidian/vault-page/node_modules/@flowershow/remark-wiki-link/dist/index.d.ts"
      ],
      "@r4ai/remark-callout": [
        "./e2e/obsidian/vault-page/node_modules/@r4ai/remark-callout/dist/index.d.ts"
      ]
    }
  },
  "include": ["apps/obsidian/**/*.ts", "apps/obsidian/**/*.tsx"],
  "exclude": ["apps/obsidian/**/*.test.ts"]
}
