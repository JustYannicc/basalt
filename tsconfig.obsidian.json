{
  "extends": "./tsconfig.pool.json",
  "compilerOptions": {
    "paths": {
      "apps": ["./.upstream/packages/apps/dist/types/apps/src/index.d.ts"],
      "apps/*": ["./.upstream/packages/apps/dist/types/apps/src/*.d.ts"],
      "react": ["./.upstream/playground/demo-apps/live-inbox/node_modules/@types/react"],
      "react/*": ["./.upstream/playground/demo-apps/live-inbox/node_modules/@types/react/*"],
      "react-dom": ["./.upstream/playground/demo-apps/live-inbox/node_modules/@types/react-dom"],
      "react-dom/*": ["./.upstream/playground/demo-apps/live-inbox/node_modules/@types/react-dom/*"],
      "react-markdown": ["./.upstream/packages/ui/node_modules/react-markdown"],
      "remark-gfm": ["./.upstream/packages/ui/node_modules/remark-gfm"]
    }
  },
  "include": ["apps/obsidian/**/*.ts", "apps/obsidian/**/*.tsx", "scripts/types/obsidian-markdown-plugins.d.ts"],
  "exclude": ["apps/obsidian/**/*.test.ts"]
}
