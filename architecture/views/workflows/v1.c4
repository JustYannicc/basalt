views {
  dynamic view v1_current_model_request {
    #v1
    variant sequence
    title "Workflows/Basalt/Current /v1 request"
    description """
      Status: Implemented. The router returns HTTP 503 for `/v1` and `/v1/*`. The pool path is not invoked.
    """

    include poolOwner, localClient, basalt.router
    poolOwner -> localClient "sends model request"
    localClient -> basalt.router "POST /v1"
    localClient <- basalt.router "503 Service Unavailable"
    poolOwner <- localClient "shows failure"
  }

  dynamic view current_tools_passthrough {
    #v1
    variant sequence
    title "Workflows/Basalt/Current tools request"
    description """
      Status: Implemented. Non-`/v1` requests pass through the service binding to the public tools dependency.
    """

    include poolOwner, localClient, basalt.router, basalt.toolsGateway
    poolOwner -> localClient "opens service"
    localClient -> basalt.router "non-/v1 request"
    basalt.router -> basalt.toolsGateway "TOOLS_SERVICE"
    basalt.router <- basalt.toolsGateway "service response"
    localClient <- basalt.router "HTTP response"
    poolOwner <- localClient "shows response"
  }

  dynamic view v1_sign_in_empty_pool {
    #v1 #planned
    variant sequence
    title "Workflows/Basalt/Sign in and empty pool"
    description """
      Status: The public identity flow exists in the dependency. Basalt's onboarding path that creates an
      empty pool is planned.
    """

    include
      poolOwner,
      localClient,
      basalt.router,
      basalt.toolsGateway,
      basalt.publicIdentity,
      basalt.pool
    poolOwner -> localClient "signs in"
    localClient -> basalt.router "sign-in request"
    basalt.router -> basalt.toolsGateway "TOOLS_SERVICE"
    basalt.toolsGateway -> basalt.publicIdentity "authenticate"
    basalt.toolsGateway -> basalt.pool "create empty pool"
    basalt.toolsGateway <- basalt.pool "empty pool"
    basalt.router <- basalt.toolsGateway "signed-in session"
    localClient <- basalt.router "shows empty pool"
    poolOwner <- localClient "starts with own pool"
  }

  dynamic view v1_connect_model_subscription {
    #v1 #planned
    variant sequence
    title "Workflows/Basalt/Connect model subscription"
    description """
      Status: Planned. The pool runtime uses the released pool binary's supported sign-in flow. Providers are
      represented as one boundary, with no provider-specific path.
    """

    include
      poolOwner,
      localClient,
      basalt.router,
      basalt.toolsGateway,
      basalt.pool,
      basalt.poolRuntime,
      modelProviders
    poolOwner -> localClient "connects a subscription"
    localClient -> basalt.router "connect account"
    basalt.router -> basalt.toolsGateway "TOOLS_SERVICE"
    basalt.toolsGateway -> basalt.pool "connect subscription"
    basalt.pool -> basalt.poolRuntime "start account login"
    basalt.poolRuntime -> modelProviders "provider login"
    basalt.poolRuntime <- modelProviders "login callback"
    basalt.pool <- basalt.poolRuntime "account stored"
    basalt.toolsGateway <- basalt.pool "account connected"
    basalt.router <- basalt.toolsGateway "connection result"
    localClient <- basalt.router "shows connected account"
    poolOwner <- localClient "sees account"
  }

  dynamic view v1_invite_pool {
    #v1 #planned
    variant sequence
    title "Workflows/Basalt/Invite to a pool"
    description """
      Status: Planned. The public tools dependency already provides identity and sharing. Basalt's pool
      binding and invitation flow are planned.
    """

    include poolOwner, poolMember, localClient, basalt.router, basalt.toolsGateway, basalt.pool
    poolOwner -> localClient "creates invite"
    localClient -> basalt.router "share pool"
    basalt.router -> basalt.toolsGateway "TOOLS_SERVICE"
    basalt.toolsGateway -> basalt.pool "create invite"
    poolMember -> localClient "accepts invite"
    localClient -> basalt.router "accept invite"
    basalt.router -> basalt.toolsGateway "TOOLS_SERVICE"
    basalt.toolsGateway -> basalt.pool "grant pool access"
    basalt.toolsGateway <- basalt.pool "member access granted"
    basalt.router <- basalt.toolsGateway "invite result"
    localClient <- basalt.router "shows shared pool"
    poolMember <- localClient "opens pool"
  }

  dynamic view v1_remove_member_denied_next_request {
    #v1 #planned
    variant sequence
    title "Workflows/Basalt/Remove member and deny next request"
    description """
      Status: Planned. Removing a member must make their next model request fail clearly.
    """

    include
      poolOwner,
      poolMember,
      localClient,
      basalt.router,
      basalt.toolsGateway,
      basalt.modelGateway,
      basalt.pool
    poolOwner -> localClient "removes member"
    localClient -> basalt.router "remove access"
    basalt.router -> basalt.toolsGateway "TOOLS_SERVICE"
    basalt.toolsGateway -> basalt.pool "remove member"
    poolMember -> localClient "sends next request"
    localClient -> basalt.router "POST /v1"
    basalt.router -> basalt.modelGateway "route"
    basalt.modelGateway -> basalt.pool "serve request"
    basalt.modelGateway <- basalt.pool "deny removed member"
    basalt.router <- basalt.modelGateway "denied"
    localClient <- basalt.router "clear denial"
    poolMember <- localClient "request fails"
  }

  dynamic view v1_usage_visibility {
    #v1 #planned
    variant sequence
    title "Workflows/Basalt/Usage visibility"
    description """
      Status: Planned. Owners see usage by member, model, and time. Members see only their own usage.
    """

    include poolOwner, poolMember, localClient, basalt.router, basalt.toolsGateway, basalt.pool
    poolOwner -> localClient "opens pool usage"
    localClient -> basalt.router "owner view"
    basalt.router -> basalt.toolsGateway "TOOLS_SERVICE"
    basalt.toolsGateway -> basalt.pool "read usage"
    basalt.toolsGateway <- basalt.pool "member, model, and time"
    basalt.router <- basalt.toolsGateway "owner usage"
    localClient <- basalt.router "shows pool usage"
    poolMember -> localClient "opens own usage"
    localClient -> basalt.router "member view"
    basalt.router -> basalt.toolsGateway "TOOLS_SERVICE"
    basalt.toolsGateway -> basalt.pool "read own usage"
    basalt.toolsGateway <- basalt.pool "member's usage"
    basalt.router <- basalt.toolsGateway "member usage"
    localClient <- basalt.router "shows own usage"
    poolMember <- localClient "sees own usage"
  }

  dynamic view v1_connect_personal_account {
    #v1 #planned
    variant sequence
    title "Workflows/Basalt/Connect personal account"
    description """
      Status: The public connector flow exists in the dependency. Basalt's Connection interface and app
      integration are planned; the account remains personal.
    """

    include
      poolMember,
      localClient,
      basalt.router,
      basalt.toolsGateway,
      basalt.publicConnectors,
      basalt.publicVault,
      outsideServices
    poolMember -> localClient "connects own account"
    localClient -> basalt.router "connect account"
    basalt.router -> basalt.toolsGateway "TOOLS_SERVICE"
    basalt.toolsGateway -> basalt.publicConnectors "start hosted connection"
    basalt.toolsGateway -> outsideServices "account consent"
    basalt.toolsGateway <- outsideServices "consent result"
    basalt.toolsGateway -> basalt.publicVault "store secret"
    basalt.router <- basalt.toolsGateway "account connected"
    localClient <- basalt.router "shows connection"
    poolMember <- localClient "uses own account"
  }

  dynamic view v1_setup_computer {
    #v1 #planned
    variant sequence
    title "Workflows/Basalt/Set up a computer"
    description """
      Status: Planned. A one-time setup link mints a computer key bound to the pool selected for that
      computer.
    """

    include poolOwner, localClient, basalt.router, basalt.toolsGateway, basalt.pool
    poolOwner -> localClient "chooses a pool for this computer"
    localClient -> basalt.router "setup request"
    basalt.router -> basalt.toolsGateway "TOOLS_SERVICE"
    basalt.toolsGateway -> basalt.pool "mint pool-bound key"
    basalt.toolsGateway <- basalt.pool "computer key"
    basalt.router <- basalt.toolsGateway "one-time setup link"
    localClient <- basalt.router "setup instructions"
    poolOwner <- localClient "sets up computer"
  }

  dynamic view v1_revoke_key {
    #v1 #planned
    variant sequence
    title "Workflows/Basalt/Revoke a computer key"
    description """
      Status: Planned. A revoked key must fail on the next request.
    """

    include
      poolOwner,
      poolMember,
      localClient,
      basalt.router,
      basalt.toolsGateway,
      basalt.modelGateway,
      basalt.pool
    poolOwner -> localClient "revokes computer key"
    localClient -> basalt.router "revoke key"
    basalt.router -> basalt.toolsGateway "TOOLS_SERVICE"
    basalt.toolsGateway -> basalt.pool "revoke key"
    poolMember -> localClient "sends next request"
    localClient -> basalt.router "POST /v1"
    basalt.router -> basalt.modelGateway "route"
    basalt.modelGateway -> basalt.pool "serve request"
    basalt.modelGateway <- basalt.pool "deny revoked key"
    basalt.router <- basalt.modelGateway "denied"
    localClient <- basalt.router "clear denial"
    poolMember <- localClient "request fails"
  }

  dynamic view v1_disconnect_personal_account {
    #v1 #planned
    variant sequence
    title "Workflows/Basalt/Disconnect personal account"
    description """
      Status: The public connector flow exists in the dependency. Basalt's Connection integration is
      planned; the next call through a disconnected account must fail clearly.
    """

    include
      poolMember,
      localClient,
      basalt.router,
      basalt.toolsGateway,
      basalt.publicConnectors
    poolMember -> localClient "disconnects own account"
    localClient -> basalt.router "disconnect account"
    basalt.router -> basalt.toolsGateway "TOOLS_SERVICE"
    basalt.toolsGateway -> basalt.publicConnectors "disconnect account"
    poolMember -> localClient "sends next tool request"
    localClient -> basalt.router "tool request"
    basalt.router -> basalt.toolsGateway "TOOLS_SERVICE"
    basalt.toolsGateway -> basalt.publicConnectors "resolve account"
    basalt.toolsGateway <- basalt.publicConnectors "connection missing"
    basalt.router <- basalt.toolsGateway "clear failure"
    localClient <- basalt.router "shows failure"
    poolMember <- localClient "sees failure"
  }

  dynamic view v1_model_request {
    #v1 #planned
    variant sequence
    title "Workflows/Basalt/Model request"
    description """
      Status: Planned. The current `/v1` route returns 503. The target uses one singleton EU actor and one
      warm EU container running the released pool binary and its runtime adapter. A separate logical pool database
      stays in the same EU cluster.
    """

    include
      poolOwner,
      localClient,
      basalt.router,
      basalt.modelGateway,
      basalt.pool,
      basalt.poolRuntime,
      basalt.poolDatabase,
      modelProviders
    poolOwner -> localClient "sends model request"
    localClient -> basalt.router "POST /v1"
    basalt.router -> basalt.modelGateway "route"
    basalt.modelGateway -> basalt.pool "serve pool request"
    basalt.pool -> basalt.poolRuntime "invoke pool runtime"
    basalt.poolRuntime -> basalt.poolDatabase "read or write state"
    basalt.poolRuntime -> modelProviders "provider request"
    basalt.poolRuntime <- basalt.poolDatabase "state result"
    basalt.poolRuntime <- modelProviders "streamed result"
    basalt.pool <- basalt.poolRuntime "runtime result"
    basalt.modelGateway <- basalt.pool "pool result"
    basalt.router <- basalt.modelGateway "stream reply"
    localClient <- basalt.router "stream reply"
    poolOwner <- localClient "shows reply"
  }
}
