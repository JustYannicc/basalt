model {
  extend basalt.toolsGateway {
    accountPresentation = part "Account identity presentation" {
      description "A verified identity row takes its provider mark from the verified issuer and family name, independently of saved-binding age or consumer-app order. Catalog app icons and check avatars cannot replace that identity mark. Unverified saved accounts and app-specific account views retain their own provider marks. Display grouping does not change saved IDs, credentials, access or app selections."
      metadata { code ".upstream/packages/ui/src/implementation/dashboard/account-row.tsx|.upstream/packages/ui/src/implementation/dashboard/accounts-client.tsx" }
    }
  }
}
