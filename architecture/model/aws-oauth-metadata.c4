model {
  extend basalt.catalog {
    metadata {
      constraint "The cloud-platform package keeps automatic client registration while that outside service also advertises enterprise identity-assertion grants. Registration still requests only authorization code and refresh grants with a public client and S256 PKCE. The reviewed snapshot pins the complete document, so any other issuer, endpoint, method or capability change still needs review and an explicit re-pin."
    }
  }
}
