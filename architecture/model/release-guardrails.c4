model {
  extend basalt {
    releaseGuardrails = module "Release guardrails" {
      #basalt
      description "Deterministic checks on how release work reaches production, computed from the update source's deployment and pull request records and the repository history: release health (time since the last good deployment, consecutive failed deployments, how long merged work has waited), one list of the files that make up the release path, and the gates built on them."
      metadata {
        code "scripts/guardrails|.github/workflows/guardrails.yml"
      }
    }
  }
  basalt.releaseGuardrails -[sync]-> repositoryApi "read production deployments, merged pull requests and comparisons"
  basalt.releaseGuardrails -[sync]-> basalt.build "walk the repository import graph from the release entries"
}
