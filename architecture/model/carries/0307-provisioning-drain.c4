model {
  extend basalt.toolsGateway {
    metadata {
      constraint "A provisioning kick dispatches successive batches until no jobs are runnable, retaining dispatch leases and deferred retries. Member setup finishes the current defaults before personal-team creation and its placed provisioning wake, so pending setup cannot fan out more installations and trigger-created defaults do not depend on Cron. Workflow IDs, claims, readiness assertions and deadlines remain unchanged."
    }
  }
}
