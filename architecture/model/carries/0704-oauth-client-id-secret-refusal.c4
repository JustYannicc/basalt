model {
  extend basalt.toolsGateway {
    metadata {
      constraint "Authorization refuses a client ID that starts with a documented client-secret prefix for every client source (operator, entered, saved and dynamically registered) before it builds the browser URL or sends the anonymous authorization check. The refusal is the protocol failure client_id_looks_like_secret, holds no part of the value, crosses the hosted OAuth wire unchanged and reaches people as the existing invalid_client setup failure, without setup instructions that quote the client ID. Its prefixes are the hosted deploy check's; a test holds the two equal."
    }
  }
}
