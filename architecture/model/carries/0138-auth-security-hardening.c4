model {
  extend basalt.toolsGateway {
    metadata {
      constraint "The carry patches no dependency: its security runner proves against the pinned Better Auth that social-token and signing-key requests refuse redirects while their direct answers still succeed, administrator updates cannot replace a user ID, and banned users cannot acquire sessions through adapter-only paths. A Better Auth upgrade that loses one of these fails the runner instead of shipping."
    }
  }
}
