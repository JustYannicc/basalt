model {
  extend basalt.toolsGateway.accountForms {
    metadata {
      constraint "Catalog connection guidance may rename a method in the connect form's method list. Without it, OAuth methods keep the generic sign-in name. The deferral sentence a manual method with an OAuth client guide shows above that guide is carry 0636's, so a provider with no sign-in for outside apps still says why."
    }
  }
}
