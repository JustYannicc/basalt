model {
  extend basalt.toolsGateway {
    metadata {
      constraint "Workflow run status reads, including dashboard batch reads, emit one native failure record containing only a bounded phase, a closed exception class or tag, and the trace id. Native status and decode errors are observed before their causes are translated. Decode failures return WorkflowStatusUnavailable with HTTP 503 without changing or restarting the run. Client rejections and successful reads emit no failure record. Forced-phase controls exist only in local Cloud; deployed runtime adapters ignore their request header."
    }
  }
}
