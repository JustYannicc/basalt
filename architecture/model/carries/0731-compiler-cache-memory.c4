model {
  extend basalt.build {
    metadata {
      constraint "The production compiler cache digests its key one file at a time and never encodes a result whose string and byte floor already exceeds its 8 MB envelope, so reuse adds no whole-dependency-set copy to a compiler isolate that two builds share. Its entries live under one exported prefix that carries the key's version, and the compiler cache proof finds entries by that same prefix, so a new key shape can't leave the proof reading an old version. The preview acceptance's cold cache lookup reads the same prefix."
    }
  }
}
