model {
  extend basalt.modelGateway {
    metadata {
      constraint "Node usage and application diagnostics retain only bounded metadata while preserving Home selection identity and request outcomes. Credentials, payload bodies, token fingerprints and arbitrary error text never enter metadata-only diagnostics. The carry preserves upstream authentication policy fields and their refresh behavior independently of diagnostic redaction, including version-specific request-scoped error rules."
    }
  }
}
