model {
  extend basalt.toolsGateway.accountForms {
    metadata {
      constraint "Client-credentials forms use method-specific key guidance instead of generic client-registration instructions when supplied. They distinguish the client ID and secret's token exchange destination from the app's access-token hosts. Explicit token endpoints follow the selected site's URL rebasing; discovered destinations are described without inventing a host. The carried source follows the pinned formatter while preserving its typed behavior and test assertions."
    }
  }
}
