model {
  extend basalt.toolsGateway {
    metadata {
      constraint "Native saved-account removal carries the authenticated host CurrentActor into the retirement callback, never the acquisition owner or client input. Native unlink captures the verified private binding before its authorized transaction and sends a signed receipt only after commit; the pool revalidates membership before recording acknowledgement. A missing person, refused operation, stale binding, retained selection or unavailable receiver records no intentional-removal receipt."
    }
  }
}
