model {
  extend basalt.toolsGateway.accountPresentation {
    metadata {
      constraint "The app tab keeps traffic Requests separate from account management and retains existing request links and access checks when account navigation changes. Its app-tab proof requires exactly both linked accounts in weekly and hourly traffic reads, and exactly the named account and its observed window start in token reads; the fixture rejects a missing weekly observation window and unexpected pool actions before those checks. Traffic selection comes from the exact saved rows linked in this app tab; unrelated pools cannot enable its traffic column, and active check or retry state remains independent of traffic reads."
    }
  }
}
