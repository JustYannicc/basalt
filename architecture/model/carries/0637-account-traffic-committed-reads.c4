model {
  extend basalt.toolsGateway {
    metadata {
      constraint "Account tool-call traffic follows committed per-account counter revisions in the saved account's existing owner scope. Only explicitly selected accounts that the current principal may inspect reach an organization stream or head receipt, with the same accountAccesses policy checked before and after current heads and before delivery. A private account's call changes no org-wide head or another member's feed and causes no read for that member. Bounded selectors preserve the 32-key protocol and at most two counter requests run concurrently. App details and user links retain authoritative mutation and permission handling while following their committed topics, with zero healthy idle body reads. Normal hosted migration 23 adds the counter trigger without rewriting retained counts or depending on explicit journal activation 22."
    }
  }
}
