model {
  extend basalt.toolsGateway {
    metadata {
      constraint "Connect Obsidian installs Signalbox Sync from the plugin's own public repository, JustYannicc/signalbox-sync, whose releases are only plugin builds tagged with the bare manifest version, so BRAT's latest release there is always the newest plugin. Basalt's plugin release workflow pushes each build and its tag there, and that repository's tag workflow attaches the files Obsidian installs."
    }
  }
}
