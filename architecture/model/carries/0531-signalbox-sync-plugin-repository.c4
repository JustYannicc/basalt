model {
  extend basalt.toolsGateway {
    metadata {
      constraint "Connect Obsidian installs Signalbox Sync from the plugin's own public repository, JustYannicc/signalbox-sync, whose releases are only plugin builds tagged with the bare manifest version, so BRAT's latest release there is always the newest plugin. It retains the latest install track while sharing the anonymous release reader with the clients download page; the two pages select their own repositories and keep distinct session cache entries. Basalt's plugin release workflow checks its key to that repository before publishing anywhere, pushes each build and its tag there, and finishes only once that repository's tag workflow has published a release with the same files; a version already there must match byte for byte."
    }
  }
}
