model {
  extend basalt.toolsGateway.accountReadings {
    metadata {
      constraint "A banked reset control spends only credits that refill the window it sits on, by the same placement the counts use: a model's reset on that model's window, a 5-hour reset on the account's 5-hour window, and weekly, full and other account resets on the longest account window. It sends the confirmed kind and scope with the spend, and the pool refuses, unspent, a credit of any other kind. A reset whose window or scope is unknown is never spent from a row. Credits from a pool that predates kinds keep the longest window."
    }
  }
}
