model {
  extend basalt.toolsGateway {
    metadata {
      constraint "App redeployment preserves a provider ref for a strict auth-map addition only when every old named method is credential-equivalent after existing normalization, name/site/family are unchanged, and exactly one previous provider ref qualifies. Changed or removed methods and ambiguous candidates receive new refs, including when removing a newly added method would otherwise reproduce a retained historical hash. Existing account grants and provider-mismatch checks remain authoritative."
    }
  }
}
