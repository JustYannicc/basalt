model {
  extend basalt.toolsGateway.appCalls {
    metadata {
      constraint "A pool overview fill whose post-read heads change or cannot be read discards that result and runs one uncached read within the same request. The fallback is never stored or retried by the overview cache, and its normal request and source authority checks retain their final decision. Initial guard errors and expired authority still fail closed. A stable fill remains reusable under equal heads and its existing presentation deadlines. No storage migration or protocol change."
    }
  }
}
