model {
  extend basalt.toolsGateway.accountPresentation {
    metadata {
      constraint "An app's Accounts tab names every account requirement so no two sections read alike, and the naming prompt that replaces a closing Connect dialog lets that dialog unmount at once and returns focus to what opened it. Requirement titles and section-qualified account menus remain derived from declarations rather than rewriting provider IDs or sharing one row action across distinct requirements."
    }
  }
}
