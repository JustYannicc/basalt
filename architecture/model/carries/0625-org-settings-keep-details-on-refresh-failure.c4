model {
  extend basalt.toolsGateway {
    metadata {
      constraint "An organization access refresh that fails to answer keeps the last verified organization details, so pages that need them stay on their retained content. Only a refusal (forbidden or unauthorized) drops those details, at once, and it also revokes the retained copy so a later failed refresh cannot show them again. The server checks current access on every request regardless of what the browser retains."
    }
  }
}
