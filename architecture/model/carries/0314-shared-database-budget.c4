model {
  extend basalt.deployment {
    metadata {
      constraint "All production runtime database paths use the existing local transaction pooler, with one server-connection budget per logical database across runtime roles and processes, derived from the declared database connection plan. Runtime URLs depend on successful budget configuration and readback. Direct sessions belong only to bounded release jobs. Warm backends retire with a sixty-second lifetime and fifteen-second idle timeout; read-only post-deploy counts must converge within ninety seconds or deployment fails without terminating sessions. Owner selection and server timeouts stay transaction-local."
    }
  }
}
