model {
  extend basalt.toolsGateway.accountRechecks {
    metadata {
      constraint "Account health rechecks use bounded cron dispatch with authority-checked leases and provider cooldowns. Hosted migration 17 adds the persistent queue and provider deadlines. Legacy hosted fixtures remove these objects and the journal row together before replaying earlier migrations; an upgrade recreates them once and keeps its receipts across restarts."
    }
  }
}
