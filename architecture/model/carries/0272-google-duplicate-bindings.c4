model {
  extend basalt.productionOps {
    metadata {
      constraint "Duplicate outside-service binding repair identifies exact redundant bindings while preserving the canonical account and every distinct authorization. Dry runs list exact targets before an authorized apply, and repeated execution is safe. The registration-race fixture defers unrelated onboarding so it reaches the signed retirement and webhook lock boundary without requiring the separate pool service."
    }
  }
}
