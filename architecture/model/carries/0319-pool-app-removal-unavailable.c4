model {
  extend basalt.toolsGateway {
    metadata {
      constraint "App removal requires its external access-revocation acknowledgement before commit. An unavailable acknowledgement returns AppRemovalUnavailable with HTTP 503 while preserving the app and saved account links. A successful retry removes the app and keeps reusable accounts. Managed Cloud coverage refuses only its own pool at the external receiver and verifies rollback, recovery and complete organization teardown."
    }
  }
}
