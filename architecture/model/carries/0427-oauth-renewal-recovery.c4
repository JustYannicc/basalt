model {
  extend basalt.toolsGateway {
    metadata {
      constraint "Account health retains the renewal reason and only closed protocol evidence, never vendor response text or credentials. Recognized invalid_grant remains reconnect-required; outages, rate limits and client refusal keep their existing grant semantics. Old failures remain readable without inventing a cause. Supported reconnect actions use the existing app connection path and preserve saved account identity, links and access."
    }
  }
}
