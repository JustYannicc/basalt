model {
  extend basalt.setupHost {
    metadata {
      constraint "Deleting an app updates every live scoped connection that names it, for every person, through one server-only grants endpoint. A connection that named only that app is revoked with its grants and tokens; one that also names other apps keeps them with the deleted app removed. Hosted, Cloud through its private grant RPC, and local all call it after the app is removed. The app removal never fails because of it: a failure is logged and the leftover connection stays revocable on Connections."
    }
  }
}
