model {
  extend basalt.toolsGateway {
    metadata {
      constraint "An Obsidian app's devices are its connection: Accounts and the Overview accounts card list the member's grants held through a scoped connection whose policy includes that app, oldest first, never other apps' or unscoped grants, and Accounts offers Disconnect, which revokes that one grant. Devices that report only the plugin's shared client name are numbered in connection order. The header reads Connect another device once one device syncs the vault and Connect Obsidian otherwise. Apps without the sync protocol read neither their tool list nor grants for this."
    }
  }
}
