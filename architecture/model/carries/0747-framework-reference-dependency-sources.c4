model {
  extend basalt.build {
    metadata {
      constraint "The framework reference the Authoring Worker embeds names a declaration under `node_modules` from its last `node_modules` segment. It recorded each declaration's file relative to the workspace's parent, so a dependency's file climbed into the store directory a fresh install creates, and the reference, its digest and the Authoring Worker's bundle changed on every fresh install."
    }
  }
}
