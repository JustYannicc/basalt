model {
  extend basalt.pool {
    metadata {
      constraint "Self-service history imports require current pool management access and a page-bound dry-run approval before each write. The browser strips message content, previews every page, and only applies unchanged reviewed metadata after the person starts the import. Imported rows remain unattributed and unpriced; pausing or retrying never duplicates retained identities. Settings opens the same authenticated pool import flow."
    }
  }
}
