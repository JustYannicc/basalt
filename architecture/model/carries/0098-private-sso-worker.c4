model {
  extend basalt.toolsGateway.ssoService {
    metadata {
      constraint "The private SSO service owns SAML and OIDC verification through the existing auth factory, encrypted provider configuration and request-scoped database. API forwarding preserves URL, body and cookies for native SSO paths; ordinary auth and the v1 handoff retain their current handler and membership rules without loading SSO into the public API bundle."
    }
  }
}
