model {
  basalt = system "Basalt" {
    #basalt

    router = module "Router" {
      #basalt #v1 #passthrough #port
      description "Forwards the exact signed app-model ingress path to the model gateway without rewriting the envelope. App model declarations and binding APIs stay on the tools gateway."
      metadata { code "src/router.ts|src/native-model.ts"; endpointHosts "app.signalbox.run"; bindings "TOOLS_SERVICE=basalt.toolsGateway|APP_UI_SERVICE=basalt.toolsGateway|ASSETS=basalt.clientAssets|POOL_SERVICE=basalt.modelGateway|CATALOG_SERVICE=basalt.catalog" }
    }

    nativeTunnel = module "Native tunnel" {
      #basalt #deep
      description "An outbound WebSocket multiplexes fixed model and MCP operations. Model operations may carry a separate search of at most 2048 characters; the server validates, parses and re-serializes it onto the literal allowed path. MCP operations accept no search. Existing calls without search keep their behavior. The verified native bearer expiry and pool registry lease bound its lifetime. Receiver credit bounds buffering; interrupted operations are never replayed."
      metadata { code "src/tunnel"; libraries "effect"; bindings "TOOLS_SERVICE=basalt.toolsGateway|POOL_SERVICE=basalt.modelGateway" }
    }

    brandConfig = part "Brand configuration" {
      description "Name, logo, hosts and the brand's own links: docs, privacy, terms and the public source repository the dashboard sidebar links last, under its hosting service's name when the dashboard recognizes it. A fork points the source link at its own repository or sets it to null. The dashboard shows the built-in app's skills under the brand's name; agents still read them as written."
      metadata { code "brand.ts"; configuration "true" }
    }


    frameworkRelease = part "Served framework release" {
      description "One framework version shared by deployment settings, app-source producers and the connector catalog."
      metadata { code "framework-release.ts"; configuration "true" }
    }

    deployment = module "Deployment" {
      description "Production releases check primary connection headroom through the database provider HTTP metrics API before any mutation; an observed ceiling change refuses until its configuration is explicitly reviewed. Read-only Worker deployment baselines project only account and script identifiers because the SDK serializes excess object fields into a GET body. They use the SDK's bounded transient retry policy; writes never retry automatically. A read-only Actions probe matches every expected logical Worker to live production inventory and runs the same baseline reader concurrently through native fetch, retaining only logical roles, closed failures, response byte counts, durations and attempts. Same-repository release changes run this probe in Check; production releases run it before backup or deployment work. The probe uses the pinned preparation toolchain and its own attempt identity, reads only account-scoped namespace metadata needed by declaration guards, and reports candidate-read stages, closed cause tags and known missing input names in errors and summaries. The probe refuses writes, content reads and unexpected targets. HTTP client refusals retain only a closed error class and reason with a numeric response status when present. Private operations use an isolated Node IPC bridge when the release runs in Bun, preserving Wrangler remote dispatch, request cancellation and bounded cleanup. The serving barrier observes completed rollout and a candidate instance running before its unchanged startup and serving windows. Closed failures retain the failed check, HTTP status and last safe instance state in errors and summaries. A separate encrypted State output journals frozen release targets and activation intents before production changes. The next release preflights every Worker and exact container rollout, verifies passive runtime boot identity, and adopts only guarded container attributes before planning. Native finalization records its exact write hashes before each container record write. A journal-proven Worker/container image mismatch carries the exact observed baseline and Worker version into the next ordinary release; it never fabricates matching native attrs and remains pending until that release records its own journal. Each frozen pool Worker retains its observed baseline image binding for another interrupted continuation. Known damaged placement versions are forbidden as rollback destinations. Two exact damaged Worker deployments may carry pending placement repair after all other settings match; only the listed API version may additionally repair its missing subrequests limit to 50000, after the prior immutable runtime proves that declared value. Immutable runtime limits and active settings are read back before and after activation; each successful activation retires its exception durably, and immutable version plus active script settings are read back. Version payloads preserve placement, limits and observability. Sealed backups permit hash-guarded undo; same-repository Check only reads production and emits the proposed adoption receipt. The full Alchemy graph prepares against shadow state, stages and verifies the existing pool image from a private copy of its effective build inputs through the provider publisher, and freezes every actual Worker upload before live Commands run. Only image changes to the existing pool application are supported; equivalent published digests do not change its configuration or start a rollout. Existing EU source-namespace readiness is checked without provisioning before upload and again before activation. Only explicitly supported Commands may participate; database Commands must all belong to the isolated database phase. The exact root readiness Command, including an attribute-free creating record left by an interrupted attempt, is admitted solely as deferred verification. Resuming creation permits changes only to its declared deployment environment; command identity and all other properties must match. Admission and refusal receipts retain lifecycle state and environment field names without values. Preparation executes no readiness command and creates no infrastructure. Every version needs provider startup evidence at or below 750 ms; upload rejection activates nothing. New resources, DO migrations, partial selection and other unsupported resource changes refuse preflight. Preflight checks every node and reports all refusals together, retaining changed property paths, unresolved dependency paths and effective image input hash comparisons with bounded public scalar values; environment, secret, binding and credential values stay redacted in failure receipts. Verified publication progress is retained before preparation continues. Preparation and Worker baseline failures retain the logical resource, operation, closed error type and bounded numeric provider status/codes through Effect and Promise boundaries in receipts, job errors and step summaries; raw provider messages, bodies and stacks are omitted. A stale pool baseline may use the observed same or immediately next application version only when its immutable recorded image and input hash pair, identity, attachment and settings match after known basic-resource and execution/network default expansion, with no active rollout. A redacted observation receipt records the normalization without claiming a native write. The candidate image still follows admission, staged rollout and serving verification before native commit. Raw application observations accept only the known runtime and singleton bandwidth metadata; other fields and values refuse. Native records not changed by the database phase, including its unchanged dependencies, are rechecked after database work. Complete image and Worker admission precedes the database phase, exact Worker version activation and the frozen pool rollout. Image changes use a full_manual rollout with one explicitly advanced singleton step rather than application PATCH; its retained ID and target version must converge before native state is committed. Before native commit, checks verify the application and every active instance image, private desired-revision boot readiness, Home/node/policy readiness and unsigned health/authentication. Existing database convergence limits remain. A model stream runs only when a dedicated acceptance credential is configured; otherwise the release summary states that it is not configured. Recovery submits the saved container digest and full configuration as a new rollout, proves old-image instance digests and private runtime health without reconciling the new Worker image, then restores Worker baseline IDs. Its health expectation follows the PoolWorker deployment proven at preflight, allowing exact-baseline recovery to resume after a partial Worker restoration. Verified recovery records the restored digest, input hash and actual application version in native state so another release can proceed. Saved configuration is encrypted in retained receipts with the deployment encryption key. Unknown database compatibility and foreign application versions refuse recovery. Partial or uncertain writes retain pending intent without automatic mutation retries or forced rollback. Release concurrency serializes workflow callers; the container API has no compare-and-swap protection against an out-of-band writer between observation and mutation. Per-attempt identity stays in Commands. Both production Hyperdrive configurations consume only their runtime role and stable configuration. Runtime URLs retain the pool initialization and budget gates. Fresh preview Hyperdrive creation also waits for its logical database initialization and grants. Release receipts use the checked-out Basalt commit independently of the framework pin. PoolOperations uses an independent stable deployment key. Database commands run once per fresh deploy-attempt identity and are no-ops in its full pass. A failed database phase preserves the previous application release. A later application failure retains committed database changes and requires expand/contract compatibility with the previous runtime adapters. Instant gauges have no source timestamps; HTTP freshness does not establish scrape freshness. Local development keeps its ordinary build path. Source-registry API failures retain only bounded numeric codes and validated request, rate-limit and challenge headers; HTTP 403 remains fatal without retries. Release backups request 30-day retention and remain completed and protected before deployment. Retirement reports read provider metadata and verified release history without changing backups. Only backups older than 30 days and outside the newest ten completed release backups on their production branch can be candidates. Exact rollback and migration recovery points, pins, unresolved releases, restore dependencies and unverified state stay protected; external keep evidence binds to the observed inventory and ledger. Deletion requires a separate exact-ID decision. The database-budget CLI imports a separate PostgreSQL observer; library code never imports the executable entrypoint. Live scoped timers bound command waits, receipt retention and disposal. Their scheduler is injectable across those three phases so CLI fixtures expire only after a stalled operation is reached, without changing global timers or production limits. The CLI flushes its receipt before exiting even when a remote bridge ignores disposal."
      metadata {
        code "alchemy.run.ts|scripts/deploy.ts|scripts/release-phases|scripts/release-barrier|.upstream/apps/hosted/cloud/src/infrastructure/release-command-attempt.ts|scripts/ensure-artifacts.ts|scripts/ensure-pool-database.ts|scripts/pool-database-provisioning.ts|scripts/pool-history-operator.ts|scripts/pool-runtime-operator.ts|scripts/environment.ts|scripts/smoke.ts|scripts/pool-acceptance.ts|scripts/pool-acceptance|scripts/preview|scripts/preview-auth|scripts/deploy-safety|src/pool/deployment.ts|src/pool/database.ts|src/pool/database-budget.ts|scripts/database-budget-verification.ts|scripts/database-budget-receipt.ts|scripts/database-budget-readiness.ts|scripts/pool-operations.ts|scripts/pool-operations-node.ts|scripts/pool-operations-node-worker.mjs|scripts/verify-pool-stream.ts|scripts/database-budget-command.ts|scripts/database-budget-postgres.ts|scripts/verify-database-budget.ts|src/pool/worker-database.ts|.upstream/apps/hosted/cloud/src/infrastructure/database-budget-observation.ts|src/browser-check.ts|.github/workflows/deploy.yml|.github/workflows/pool-acceptance.yml"
        bindings "stageRouter=basalt.router|this.stageRouter=basalt.router|controlPlane=deploymentProvider|platform.env.POOL_OPERATIONS=basalt.modelGateway|operations=basalt.modelGateway|service=basalt.modelGateway|connection.service=basalt.modelGateway"
        libraries "better-auth|alchemy|@effect/platform-node"
      }
    }


    releaseUpdates = module "Release updates" {
      #basalt #v1 #deep
      description "Detects pinned upstream updates and opens one update pull request per release. Model gateway version v8.0.60 is checked hourly against published stable releases; its source archive and native plugin pins move together while existing carries stay byte-identical. Desired upstream release identity is separate from the verified serving image digest and application version; failed rollout never downgrades desired pins. Image updates use staged immutable publication and recorded container recovery through the release barrier. Model gateway pull requests run the pool and same-socket model-provider continuation regressions and require coordinator merge. Tools candidates require published versioned releases. Each carry has a same-stem JSON record, and a format-4 header assembles the registry in patch filename order; automatic retirement deletes the pair while preserving surviving records byte for byte. CI proves the exact merge commit against current main. A stale release branch is updated and waits for fresh checks; release merge attempts are serialized in their own workflow. An exact-head preview must pass real sign-in and native client acceptance, then destroy and verify all temporary resources before automatic merge. Database or workflow identity changes take the manual path: they deploy from a main-only environment after a completed backup, with no approval step, and the main deploy starts that path itself. A workflow identity change fails before deploying while any workflow instance is still running. Stopping new work, quiescing writes and database restore are done by whoever dispatches. A protected workflow exports exact dedicated subscription accounts through the owner-scoped control API straight into Actions secrets. Manual rollback accepts the latest successful or failed database release and deploys recorded previous pins once the dispatcher names the restored backup, which must match the recorded one. The next release that contains a single failed release rolls forward over it, re-applying its forward-only migrations and data steps; a second failure, or one the release does not contain, waits for a person, and undoing database writes stays that deliberate rollback. V1 accepts a main advance between the final check and squash merge; production deploys only the exact commit whose own main CI passed. Tools gateway storage migration failures retain only known error classes, SQLSTATE and the attempted registered schema version; release logs never receive SQL, parameters or driver messages. Live acceptance is pending account setup."
      metadata {
        code "scripts/cpa-update.py|scripts/cpa-pipeline-guard.py|scripts/releases|scripts/release-credentials|scripts/release-preview|scripts/release-merge|.github/workflows/cpa-updates.yml|.github/workflows/releases.yml|.github/workflows/release-preview.yml|.github/workflows/release-cleanup.yml|.github/workflows/release-merge.yml|.github/workflows/release-manual.yml|.github/workflows/release-main.yml|.github/workflows/release-rollback.yml|.github/workflows/release-credentials.yml"
      }
    }

    toolsGateway = module "Tools gateway" {
      #basalt #v1 #deep #port #funnel
      // Removal acceptance locks the organization row exclusively while recording its tombstone.
      // App persistence keeps a parent key-share lock through commit and reads the tombstone
      // after that lock is acquired, including after a wait. Compilation holds neither lock.
      // One compiler RPC owns its FIFO wait and cleanup; queue expiry after 50 seconds is BuildBusy/503.
      // The separate 50-second compile deadline and lease start at admission.
      // The caller's lost-RPC guard is the sum of those budgets, so queue time cannot consume compile time.
      summary "The catalog groups visible instances by trusted service identity. Open selects a named instance when several exist; Add another explicitly requests a fresh instance through the shared installer. Existing pool IDs are projected from recorded metadata without rewriting them. Native access can describe the authenticated account and current usable pool names without granting management or pool-switch authority. Display fields are optional while retained pool runtime adapters still return authorization alone. App declarations may name model slots. Mutations, scheduled mutations and webhook delivery receive one invocation-owned model callback through the existing app capability RPC. The hosted binding chooses the pool and rechecks its authorizer and the current app caller before dispatch; read and render operations have no inference callback. Durable workflow steps return a typed refusal until external dispatch receipts survive replay."
      description "A row names at most two apps that use it; past that it names the first and a count that opens the rest, so rows stay one line tall. Account acquisition status reads retry at most three times per poll within their deadline and sign-in expiry. Transient status errors leave the same session open; uncertain callbacks never repeat automatically. Definitive failures retain the closed receipt in the pending connection and explain the cause. A reconnect superseded by a newer saved binding stays terminal with its binding-change explanation. Only Enterprise contact-sales checkout for legacy Free pay-as-you-go subscriptions without a members balance skips seat synchronization when no current seat plan is active. Purchasable seat plans still require a real members balance. Every balance-present path is unchanged. Provisioning dispatch keeps original job IDs in database rows and Workflow params, preserving catalog-only and pool-token rotation-only handlers. Invalid instance IDs map to a reserved SHA-256 namespace within runtime adapter limits; create and recovery use the same stable identity. Retained queued jobs retry through that mapping after deployment. Dispatch logs only recognized error names and closed platform diagnostics. The Accounts tab shows each linked account's lab logo, plan and availability badges, and quota meters with remaining text and relative reset times, using upstream's existing account-health tones without per-lab tints. The Accounts tab shows each linked account's lab logo, plan and availability badges, and one usage cell per reported limited window: remaining share, a green, amber or red bar and the reset countdown, greyed with its age when stale. Unlimited windows and balances stay in Details, banked resets show as a count, accounts without a usage reporter show no usage, and a reporter account with no reading yet offers Refresh on one line that reads Checking usage while a first collection is under way. Unlimited windows and balances stay in Details, banked resets show as a count, accounts without a usage reporter show no usage, and a reporter account with no reading yet shows one line that reads Checking usage while a first collection is under way. One shared account row composes both the Accounts list and an app's Accounts tab: usage cells form a band only under reporter accounts, Refresh, Details, requested access and full checks live behind the row menu, and a current sign-in rejection is the row's only inline recovery. Every account list titles a row by its verified identity, else the name the person gave it, else the email or name its own check reported, without the verified mark, and only then its generated Default label. On the Accounts list a native pool account's row reads the pool's manager-only usage series once per page: Requests 7d, eight hourly ticks and the 7-day success share, amber below 95%, and under each usage cell the tokens the pool counted in that window, marked as a minimum when some requests lacked counts. Other accounts' counts, unmapped requests and connector accounts show no numbers, and no cost appears until an API-equivalent price is proven. An app's Accounts tab reads the same series for the pool accounts linked to it and shows the same Requests 7d count, labelled because the tab has no column header, and a dash naming the gap where no history is visible. Ticks and share stand in for a healthy check only; a current failing check, a stale check or a missing sign-in keeps its own label on both lists. The Accounts list uses the same light logo tile and names the apps that link an account for everyone. The account-row and logo overlay lives in carry 0030, App-tab UI presence lives in carry 0028, and carry 0032 matches upstream #2438. Legacy app-acquired accounts use the app's optional connect check with its linked backend accounts; an absent check falls back to provider health. Removing an app-acquired account runs the acquiring version's remove hook. When that version can no longer be prepared, because another requirement's definition changed and its linked account no longer fits, the current version removes it while it still acquires the method. A failed remove step logs the cause's error kind. The pool app's check uses a membership-scoped Home observation; stale or failed readings force a capped collection, and only a fresh completed result passes. Known credential refusals, rate limits and outages use native health reasons. OAuth invocations project new and saved grant fields to the method's declared response before app code or privacy validation sees them. Named responses drop only unconstrained JSON rest added by export; explicitly typed dynamic fields remain available on exchange and rotation. Rejected-token renewal compares that same projection while refresh tokens and rotation stay in the trusted grant. Before check results leave the app or enter storage, a bounded matcher refuses identity and status strings containing raw credential values or opaque references, their UTF-8 base64/base64url forms, percent escapes or hexadecimal forms. Fields the method declares plain are public and never count. A match of eight or more characters fails the check. A shorter match may be chance, so only the identity field, badge, meter or stat containing it is hidden. Status shares the existing JSON health record. Allowance observations use a separate additive table so failed refreshes retain the last reading and its source version without advancing credential health. The product authorizes allowance inspection and refresh independently of account use, and filters retained app reports by caller-visible reporter apps. Host-registered account sources follow account inspection authority. Invalid optional allowance never invalidates a passing credential check. New host-registered connections retain one saved account independently of an acquiring app. Host-reviewed family metadata and the shared capability planner preserve provider IDs and reuse authorized saved bindings across apps and pools without granting access or model capacity. One shared offering schema describes subscription, metered API, prepaid, other or unknown access, separately from credential mechanism. Optional method hints are nonidentity metadata; missing or conflicting hints stay unknown and never establish grants, readiness or a current plan. Authorized observations retain their source, credential generation and freshness for plan and reset readings. Reconnect preserves its identity, explicit owner-authorized deletion resolves its durable binding, and app removal leaves it intact. Separate additive acquisition and driver-check tables retain those bindings and health across process restarts. Native subscription health uses the saved host binding to make a signed Home check without requiring a pool link. The check shares the quota collection cap and leaves the sign-in attribution queue free; credential rejection, rate limits and outages remain distinct native outcomes. Account directories include authorized app-scoped links when projecting health. Shared health controls show driver checks independently of app checks, and current driver capability enables checking before the first result. Unclassified failures return a fixed retry explanation without exposing their private cause. Failed app and driver checks retain a closed failure phase and error tag in the existing health JSON with display status and reason. Public identity decodes only AccountInfo fields, preserving its original retrieval time through failed checks and restarts. Upgrade retention and failure recovery have independent storage scenarios with the same 60-second limit. Passing checks clear the failure and reason; failed checks emit the same bounded values in telemetry. Unsaved credential checks return the same diagnostics without retaining credentials or results. Host-provisioned methods are absent from Connect, reconnect and credential forms. The shared link boundary refuses replacing a provisioned plain-slot link through radio selection, agent connection policies or connection completion. Host-owned provisioning and pool repair use a separate trusted link path. The compiler records each request's received, admitted, dependency, bundle, reply and release phases immediately, correlated by trace, attempt, isolate and source digest. These fixed diagnostic records contain no source or credentials and remain in retained Cloud logs when the completed span is lost. Two admitted builds can prepare dependencies concurrently. Admission tickets preserve arrival order within the queue budget. Waiters own their timers and a request-owned native RPC capability. Completion, cancellation and caller disconnection dispose that capability, immediately removing its queued ticket; admission also skips aborted waiters. Every bundle owns an independent esbuild service. Admission is the only queue; an earlier request cannot hold a bundler gate or close a successor's service. The queue and compile budgets remain 50 seconds each. Production caches successful compiler output privately by exact source, public paths, the checked-out Basalt release commit and the resolved dependency bytes that the same request compiles. Only pinned source manifests qualify; custom registries, previews and test stages or framework overrides bypass reuse at deployment. Reads verify the serialized result digest and executable entry module before reuse; failed integrity checks compile normally. A separately launched development host evaluates the production compiler declaration and calls its generated private RPC binding with released assets. E2E reaches that host through a scoped Effect HTTP adapter, preserving its application-import boundary. The inherited-production-settings case changes only the actual Alchemy Stage service. Cache corruption stays in the isolated host. Requirements, app, token and access publication run fresh for every instance. The private Authoring Worker bundles the framework reference as structured JSON. Its files() binding serializes that reference once and returns the same file bytes. After verified organization entry, the browser starts its existing resource directory read without blocking the page. The one-shot subscriber releases when the read settles or the organization or signed-in person changes; normal page consumers keep the existing cache and polling. An account's check for an app also reads that app's tool catalog with the account, and agents' catalog reads mark or clear the same check, so a sign-in that passes while the app's tools fail to load shows as tools unavailable with the reason agents get. OpenAPI apps skip, and log, a static document patch whose path item or operation the provider's current definition no longer has; any other missing target or malformed patch still fails the definition. Whole-page client loading preserves the route's page frame, heading and description until its controls arrive."
      metadata { code ".upstream/apps/hosted/cloud|.upstream/apps/hosted/server/src/implementation/first-party-oauth.ts|.upstream/apps/hosted/server/src/implementation/pool-worker-revision.ts" }
      accountRechecks = part "Automatic account health" {
        description "The existing minute cron claims at most four saved accounts, with a 128-candidate window and two concurrent checks. A durable five-minute lease admits only its exact account; user links retain their saved member authority and app links retain current contribution policy. Changed app versions and credential generations become due on the next tick. Current checks wait six hours. Accounts of one provider family start at least one minute apart, and rate limiting defers that family for fifteen minutes. The normal explicit check path retains its own OAuth renewal, failure phases and provider reasons. An old lease cannot acknowledge a newer one. Every scheduled dispatch, including driver checks and user-subject checks, revalidates its lease and current hosted authority. Family deadlines survive account and organization deletion. Before dispatch an uncertain attempt reserves sixteen minutes, covering its 55-second ceiling plus a fifteen-minute cooldown. Completion retains a full minute of spacing, and a rate-limited driver or app result retains fifteen minutes. Organization administrators can read the last dispatched batch without credentials or another organization's activity."
        metadata { code ".upstream/apps/hosted/server/src/implementation/account-recheck-queue.ts|.upstream/apps/hosted/server/src/implementation/account-recheck-schema.ts|.upstream/apps/hosted/server/src/implementation/account-recheck-authority.ts|.upstream/apps/hosted/server/src/implementation/account-rechecks.ts|.upstream/apps/hosted/server/src/contracts/account-rechecks.ts" }
      }
      hostedRoutes = part "Hosted Routes" {
        description "The mapping app keeps bring-your-own-key APIs and adds a separate provisioned personal capability. The host verifies current membership, app and account use, the live link and signed nonce before a fixed directions request to the outside service. One central Postgres ledger reserves every dispatch across app instances before the external call, with a 620-request UTC month ceiling and tighter daily, minute and personal limits. Failed or uncertain dispatches still count. Health checks are local and make no outside service call."
        metadata { code ".upstream/apps/hosted/cloud/src/infrastructure/maps-routes|.upstream/apps/hosted/cloud/src/infrastructure/hosted-routes.ts|.upstream/apps/hosted/server/src/contracts/hosted-routes.ts|.upstream/apps/hosted/server/src/implementation/hosted-routes-accounts.ts|.upstream/apps/hosted/server/src/implementation/hosted-routes-token.ts|.upstream/apps/hosted/server/src/implementation/hosted-routes-schema.ts" }
      }
      ssoApi = door "Single sign-on entry" {
        description "The API forwards only native SSO paths through a private service binding, preserving the original URL, method, body and cookies. Ordinary auth retains the same storage schema and SSO-managed email guard. The API upload budget stays at 5,460,000 bytes."
        metadata { code ".upstream/apps/hosted/cloud/src/infrastructure/sso.ts|.upstream/apps/hosted/cloud/src/infrastructure/sso-worker.ts|.upstream/apps/hosted/cloud/src/implementation/sso-policy.ts"; bindings "Sso=basalt.toolsGateway.ssoService" }
      }
      ssoService = module "Single sign-on service" {
        description "A private service owns the native SAML and OIDC engine. It uses the existing auth factory, signing keys, encrypted provider configuration and request-scoped database adapter. Domain verification, browser-bound SAML relay state, assertion validation and replay refusal stay inside this service. Sessions remain readable by ordinary auth, and JIT membership still checks billing, invitations and the exact organization. Organization creation stays in the API. This changes no stored schema."
        metadata { code ".upstream/apps/hosted/cloud/src/sso.ts|.upstream/apps/hosted/cloud/src/implementation/sso.ts"; resources "resource-788034ee557d123216961f26810903c7b395cae8fc8db771f10e716503df971c"; libraries "@better-auth/sso|better-auth" }
      }
      accountRecovery = part "Verified account recovery" {
        description "A signed operator preparation reads saved outside-service grants without renewing or rewriting them, verifies issuer and subject through UserInfo, and rechecks the exact grant and placement. The named SQL migration groups only those proven bindings and replaces generic display labels with the verified email. The existing private MCP Worker executes the signed operation after a bounded API forward. The runner owns encrypted backup, exact-plan approval, transaction and receipt. Account IDs, credentials, app links and access placement survive; changed authority refuses apply. Partial consent saves reviewed requested, granted and missing permission names on the connection’s latest failed sign-in and emits the same evidence as a native structured log. Permission names outside operator client allowlists or host-reviewed family recipes are withheld. The callback explains permission selection, administrator restrictions and app-owner diagnosis before another attempt while existing apps keep working."
        metadata { code ".upstream/apps/hosted/cloud/src/infrastructure/production-ops/migrations|.upstream/apps/hosted/cloud/src/infrastructure/production-ops/preparations.ts" }
      }
      workflowDisplayApi = door "Workflow display API" {
        description "Authenticates the browser and rechecks the question recipient, app and workflow access on every display request. Passes the verified caller, organization and policy through a private binding to the existing MCP Worker."
        metadata { code ".upstream/apps/hosted/cloud/src/infrastructure/workflow-display.ts|.upstream/apps/hosted/server/src/implementation/workflow-input-displays.ts"; bindings "McpServer=basalt.toolsGateway.workflowDisplayHost" }
      }
      workflowDisplayHost = part "MCP workflow displays" {
        description "Runs inside the existing private MCP Worker. Retains views, reads resources and maps callbacks through ordinary MCP Apps rules. Each private call binds the current caller and policy to the normal MCP authorization backend; no authority is cached across requests."
        metadata { code ".upstream/apps/hosted/cloud/src/infrastructure/workflow-display-server.ts|.upstream/apps/hosted/cloud/src/mcp-server.ts" }
      }
      providerAccountMethods = part "Provider account methods" {
        description "Provider apps connect reusable model accounts. Registered pools select saved accounts and refuse fresh or stale acquisition before provider calls or credential writes. The host returns connection and selection policy, authorized provider destinations, a typed provider-app identity and actual credential provenance. Ordinary tool apps keep their connection behavior. Provider-app login-file imports use existing subscription identities, retain an assigned account and backend reference before upload, and keep pending bindings unusable until acknowledgement. Explicit linking follows separately. Legacy-linked pools retain their exact active version and serving/check/removal behavior until approved adoption or removal clears those links; reconciliation and manual activation cannot replace that version. Only atomic publication initializes native membership; deploy-first recovery preserves legacy policy. The API composes login-file import storage and validation explicitly; serving runtime adapters do not import those implementations."
        metadata { code ".upstream/apps/hosted/server/src/implementation/provider-account-methods.ts|.upstream/apps/hosted/server/src/implementation/provider-account-policy.ts|.upstream/apps/hosted/server/src/implementation/provider-account-destination.ts|.upstream/apps/hosted/server/src/implementation/provider-account-context.ts|.upstream/apps/hosted/server/src/implementation/requirement-login-file.ts|.upstream/apps/hosted/server/src/implementation/pool-retained-subscriptions.ts|.upstream/packages/sdk/src/implementation/account-acquisition-import.ts" }
      }
      contributionApi = door "Account and membership API" {
        description "Native account requests and membership changes enter the same hosted authorization and database transaction boundaries. Reset handlers resolve the endpoint’s inspect or use grant before sending a pool request. Browser-only approval-policy mutations authenticate the current browser principal in request middleware. Request grants and browser identity never become self-host startup dependencies."
        metadata { code ".upstream/apps/hosted/server/src/implementation/app-accounts.ts|.upstream/apps/hosted/server/src/implementation/organization.ts|.upstream/apps/hosted/server/src/implementation/organization-auth.ts" }
      }
      contributedLinks = part "Contributed account links" {
        description "App authors opt in each many-account requirement. Linking requires current app use and account use. Native links record their contributor; that person or an app editor may detach them. Management alone grants no private-account use. Detach preserves saved credentials and other app links. The saved-account list joins only exact saved account IDs and retains each readable native binding, including management without credential use. Reconnect actions use the account grant, requirement access and supported acquisition method. Verified-identity display groups preserve every saved ID. The pool app links to the native Accounts list and keeps only capacity and usage from its backend. A pool filters those same rows by recorded native membership; verified identities and backend credential references never merge saved IDs. Driver checks stay separate from consumer checks, while usage and its permissions remain on the observation query. Explicit deletion locks all linked apps in order before the account, releases its savepoint locks before retrying a changed link set or an account-first reconnect, and rereads the locked account before releasing its current OAuth grant. Authorization is rechecked in the same deletion transaction. Identity details follow holder and management access."
        metadata { code ".upstream/apps/hosted/server/src/implementation/app-account-links.ts|.upstream/apps/hosted/server/src/implementation/contributed-account-policy.ts|.upstream/apps/hosted/server/src/implementation/contributed-account-departure.ts|.upstream/apps/hosted/server/src/implementation/account-removal-lock.ts" }
      }
      contributionDepartures = store "Contribution departure queue" {
        description "Member removal snapshots exact native links in the membership transaction. In Cloud, API or auth writes and the minute cron wake cleanup. GET, HEAD and OPTIONS do not; a read-only app query sent as POST does. Failed attempts back off, starting at two seconds. After transient lock contention, physical unlink can lag about 62 seconds with no backlog or intervening writes, while native pool use is vetoed before removal commits. Repeated failures retain links until recovery. Independent expiring claims recover interrupted cleanup without an old server acknowledging the new queue. A retained link timestamp prevents stale cleanup from removing a newer contribution. Jobs detach links and never delete saved credentials. Hosted migration 13 adds enqueue time and fixed error kinds; older rows keep unknown diagnostics. Only current app managers can read at most 100 remaining link snapshots, with explicit completeness."
        metadata { code ".upstream/apps/hosted/server/src/implementation/contributed-departure-queue.ts|.upstream/apps/hosted/server/src/implementation/contributed-departure-schema.ts" }
      }
      serviceInstalls = part "Service installs" {
        description "A trusted catalog ID and exact endpoint aliases identify one team service across native and MCP transports. Normal adds reuse its app; a deliberate separate instance keeps its own name. App creation claims the service inside the short SDK transaction, so concurrent requests return one app without replacing saved accounts or source. Only visible app IDs enter the service projection; existing pool records retain their explicit instance identity."
        metadata { code ".upstream/apps/hosted/server/src/implementation/service-installs.ts|.upstream/apps/hosted/server/src/implementation/service-install-records.ts|.upstream/packages/catalog/src/implementation/services.ts" }
      }
    }

    site = module "Public site" {
      #basalt #v1
      description "Home, privacy, terms and legal notice at the zone apex (signalbox.run), rendered from the brand configuration in a separate Worker. Static pages with no scripts, forms or third-party requests."
      metadata { code "src/site" }
    }


    catalog = module "Connector catalog" {
      #basalt #v1
      description "Read-only feed in a separate Worker. Merges the official catalog with published additions and editable check recipes. No person credentials. Carried apps pin the prepared host framework and declare each operation's approval. Messaging app source combines frozen public source, a contributed personal user-token patch, and a separate exact host-framework pin. Its registration manifest, app grant and hosted client request matching user scopes and omit the tokens.basic scope rejected at registration. Its API definition drops duplicate authentication parameters before schema compilation; the selected account supplies the Bearer header for reads and writes. Its queries never require approval; mutations always require approval, including side effects exposed as GET. Community publication remains on hold until the owner selects a publisher scope and the chosen host supports the strict nested-grant option and passes its behavior checks. It substitutes trusted tenant configuration only when tenant and hosted OAuth client settings are complete. The issue-tracking and wiki package serves four full API routers and five read shortcuts. Its specification loader verifies reviewed OpenAPI hashes before compilation and keys its cache by that hash, refusing changed documents. Issue and service-desk specifications are retained as content-addressed static assets on the catalog origin, so vendor publication cannot change a released tool surface. Visual collaboration and customer support packages serve their full supported REST operations. Every REST mutation requires approval; deployment-service MCP uses its destructive-tool hints for approval, and audio-service MCP requires approval unless marked read-only so generation retains its credit-spending gate. Every REST mutation requires approval; remote MCP uses its destructive-tool hints for approval. Saved account grants and provider roles still bound access. Every mutation requires approval; saved account grants and provider roles still bound access. Every listing it writes, including description overrides of official apps, has one plain sentence, and every vendor listing carries a tightly cropped inline PNG logo that shows on both themes, enforced by a catalog fitness test; check recipes keep the host's app glyph. Official packages are served with their framework dependency set to the release Basalt's compiler serves, so catalog apps build on Basalt's framework; CI builds every served package on it. One service package can expose its official remote sign-in alongside its existing token API. Separate account requirements preserve the token provider identity and keep each credential on its own transport. Catalog updates treat a new zero-or-more account requirement as optional; existing provider, scope and cardinality breaks still hold the update for review. Newly required slots also hold it when a shared app account is missing or a caller may lack a personal account. The feed carries method-specific deferrals for Connect while catalog cards remain unchanged. Each OAuth method has an exact package-and-method decision: automatic client metadata, a reviewed host client, or an explicit unverified deferral. Positive one-click claims are bound to reviewed source content. CI rejects unclassified methods, changed positive-claim sources, unknown host clients and changed automatic metadata. A failed check never rewrites installed app source or saved accounts. The notes workspace package's account check names the workspace through one read-only remote MCP tool call made as plain JSON-RPC over the host's fetch, without bundling an MCP client library. It reads the tool's documented workspace-and-person answer and falls back to the person's email when the workspace has no name; the lookup is bounded and a failed lookup leaves a verified account healthy. The music service package's account check names the account by the person's email or display name; the provider's opaque user id identifies the account but never names it. Three maintained source packages live in separate repositories. Maintainer imports verify immutable commit and blob identities and embed reviewed snapshots; installing an app never reads those repositories. Sources stay outside the tools API Worker."
      metadata { code "src/catalog"; libraries "apps"; bindings "context=basalt.router" }

      providerApps = part "Model provider apps" {
        description "Installable model-provider packages carry the same provider declarations as pools. People connect reusable host-owned accounts through each app; removing an app leaves saved accounts and other links intact. Installing these packages does not migrate existing accounts or activate native pool membership. The shared Accounts view renders connection and reconnect controls only where the host connection policy allows them, and none while that policy is unread; elsewhere, such as in a pool, it only selects saved accounts and links to the provider apps the host names. Login-file import is offered only where the host lists import methods. Only the host's provider-app marker makes an Accounts tab list where its accounts are used, read from the visible inventory."
      }
    }

    workflowRecipes = module "Editable check recipes" {
      #basalt #v1
      description "Pool scans request the current public pool view and await revalidation before recording completed health; a retained stale view cannot prove recovery. Ordinary private apps with user schedules, native workflow waits and app SQL checkpoints. The source owns detection and nudge deduplication; the tools gateway owns credentials, permissions and durable workflow input. Its Human in the loop tab retains existing pending questions and scheduled tool approvals, showing their question or saved tool invocation before review. It accepts form responses and source-bound custom displays through the ordinary MCP Apps sandbox and tool-consent path. Every named workflow owns its destination and quiet hours, defaulting to Human in the loop without external delivery. Source edits require renewed copy consent; retained runs cannot borrow it. The pool-owner workflow checks failed or five-minute-delayed contribution cleanup once per minute per distinct watched app. It observes the bounded authorized queue projection and never retries native detachment. Customized copies stay untouched."
      metadata { code "recipes"; libraries "apps"; bindings "context=basalt.router|step=outsideServices" }
    }

    publicIdentity = iface "Public identity" { #v1 }
    publicConnectors = iface "Public connectors" { #v1 }
    publicVault = iface "Public vault" { #v1 }

    identity = module "Identity interface" {
      #basalt #planned #deep
      metadata { status "planned Basalt-facing interface" }
    }

    modelGateway = module "Model gateway" {
      #basalt #v1 #deep #port #funnel
      description "Intentional native account removals retain a host-authenticated person and an acknowledgement after backend removal; missing identity and failed acknowledgement cannot silence the pool watcher. The private PoolOperations entrypoint can inspect runtime health without warming it. A signed restart approval expires within one minute and binds one operation ID, exact controller instance and deployed image. The controller records a durable started receipt before destruction and serializes restart with ongoing warmup. Replayed approvals and lost replies read the existing receipt without another restart. Failed restart results stay failed. Owns the computer registry, the pool directory and encrypted one-time setup credentials in the pool controller. A per-pool handoff can make the native app audience and organization roles authoritative for use and management; deployment preserves existing grants until that handoff. Membership writes and audience projections share an organization database lock until native auth finishes its write. Native app managers read per-person usage and change caps through exact signed host operations, without app or model use authority; old tokens cannot restore revoked native grants. Signed import deletion keeps an uncertain attempt durable, stops on operator cancellation before any later write, and requires Home to compare the approved full-row checksum under the database mutation lock. Dedicated conditional routes refuse older runtimes instead of allowing ID-only deletion. Startup deadline failures retain their timeout classification. Generates model keys registered to a user and a nonempty channel-group list, re-points a computer's key to another of the person's pools, and applies signed access changes: revokes the keys of people who lost a pool before the tools service commits. Before looking up the singleton pool controller, the Worker normalizes credentials as Home does and checks model-key candidates in Home order through POOL_AUTH_DATABASE, stopping at the first active api_key match before later malformed candidates can fail. Its separate Hyperdrive configuration uses the pool runtime role and logical database with verified TLS, query caching disabled and a soft limit of five origin connections. The container retains POOL_DATABASE_URL for its direct connection. Connections and queries each time out after 2.5 seconds, and the entire lookup including graceful close has a six-second deadline that destroys a stalled connection; missing, invalid and revoked keys return 401, and missing bindings, database failures or timeouts return 503. Signed pool-control tokens and computer credentials use their existing routes and checks. Usage series and last-success are signed pool control routes under /pool/v1. Home still applies quota and model policy after a valid key reaches the pool runtime. After a successful model POST, the pool Worker schedules usage observation with waitUntil; its periodic alarm calls the same observer through the same Home usage interface as a fallback. Persists only each pool's complete public account fields in the runtime adapter's durable storage with each Home part's read time and unchanged provider observation timestamps; raw credential inventory, proxy settings and other pools' accounts stay outside storage. Every view keeps the current permission checks and shapes caller-visible fields anew. A retained view returns immediately as stale and one revalidation runs per pool. A fresh read joins only running work and otherwise starts a new read; completed work is discarded and failure retains the stale view. Home writes and signed membership reservations invalidate persisted revisions, and a superseded read cannot republish old data. Keeps 31 days of per-pool, per-person, per-account, per-model daily usage read from Home's records, reads each pool account's limit windows, banked resets and reading freshness from Home's per-credential quota detail, retains account limit observations without legacy seven-day sizing verdicts, retains 400 days of hourly weighted capacity in bounded daily partitions from those same Home observations, and keeps comparable observation-time demand separately from the display range. Seasonal forecasts begin after two completed weeks and account advice after four, with coverage, backtest and known-weight requirements. Forecasts never use a current-rate fallback or spend banked resets. Weekly and five-hour windows retain independent units and reset schedules, and both measured and projected five-hour allowance are unusable while the same account is weekly-exhausted; raw quota remains separate. Fixed-window forecasts require a known reset schedule. Incoherent snapshots retain independent measurements but suppress complete capacity verdicts and projections. Daily money percentiles exclude days with unproven Home capture hours. The manager overview keeps signed-person and account-inspection authority across its usage snapshot and names member rows through the authorized directory. A separate personal overview requires current app use, derives its person hash from the authenticated host session, and filters all queries to that person without manager authority or a directory. Its money classification carries only opaque history references that pass the viewer's account-inspection checks and billing kinds from explicit provider declarations. Missing trusted classification stays unavailable. It asks Home to import API prices, sets each member's optional weekly cap as a Home spend limit on that person's backend user for the pool, and rewrites Home's cap refusal into a clear message. Host account mirrors preserve the saved account and per-generation Home UUID. Native API keys use Home configuration; one pool-owned queue serializes whole-family writes and verifies readback while preserving unrelated keys. Named compatible providers use discovered models; Vertex service accounts use the documented credential payload. Token-based compatible inference uses an existing explicit account ID or the sole visible account of a user token. Multi-account user-token selection remains a separate follow-up. Mirroring never performs inference or enables billing."
      metadata {
        code "src/pool"
        endpointHosts "pool-operations"
        libraries "apps"
        bindings "TOOLS_SERVICE=basalt.toolsGateway|service=basalt.toolsGateway|input.tools=basalt.toolsGateway|readiness=basalt.poolRuntime|POOL_AUTH_DATABASE=databaseService|POOL_DATABASE_URL=basalt.poolDatabase|singleton(env)=basalt.poolController|singleton(this.env)=basalt.poolController|container.getTcpPort(port)=basalt.poolRuntime|deps=basalt.poolRuntime|this.ctx.container.getTcpPort(target)=basalt.poolRuntime|container.getTcpPort(8318)=basalt.poolRuntime|container.getTcpPort(8327)=basalt.poolRuntime"
      }
    }

    usageImportClient = adapter "Usage import client" {
      description "Operator-supplied target origin and private pool-token file. Redirects are refused; only the usage import endpoint is called. Manager Plus metadata files stream in byte-bounded pages of at most 200 rows. A complete hashed exact-ID dry-run manifest binds the source file, destination and caller. A temporary disk-backed ID index rejects duplicates across all pages before apply. Apply obtains a fresh matching short-lived page approval and fsyncs acknowledgement receipts; uncertain HTTP results stop for reconciliation. Replays compare immutable retained contents before inserting missing identities."
      metadata { code "scripts/import-usage.ts|scripts/import-cpamp.ts|scripts/usage-import-stream.ts"; bindings "globalThis=basalt.modelGateway" }
    }

    usageExportClient = adapter "Usage export client" {
      description "Operator-supplied source origin and private management-key file. Reads fixed non-destructive export routes, checks page counts and refuses redirects. Manager Plus uses an explicit frozen upper row ID and paced read-only keyset pages on its live SQLite file, with a short transaction and SQL deadline per page. A second pass checks the same metadata ranges by checksum. Private fsynced local page receipts allow resume, and a disk floor stops new allocations. It never copies the source database or reads request payloads."
      metadata { code "scripts/usage-import-source.ts|scripts/cpamp-read-page.py|scripts/export-cpamp.py"; bindings "globalThis=historyExportService" }
    }

    poolController = actor "Pool controller" {
      #basalt #v1
      metadata { jurisdiction "eu"; singleton "control-plane" }
    }

    setupHost = module "Setup host" {
      #basalt #v1 #deep
      description "Old /share bookmarks resolve their signed intent and current native management authority to the pool app's Settings. Old sharing mutations return 410. Native Settings owns app audiences and groups. The host API exposes per-person 30-day usage and optional weekly caps, which native Settings shows and edits. Signed usage and cap operations enter the public model gateway at /pool/v1/managed-usage and /pool/v1/managed-cap; private setup routes stay closed at the router. The host holds the organization access lock through each signed usage or cap operation, so a role or audience change cannot pass an older management check. Management grants no private-account or model use. /setup redirects to the person's own organization's Connect page. The desktop model client setup issues a models-only key through the existing consumed one-time link and downloads its unchanged gateway and OAuth MCP configuration in one action. Manual setup stays behind an explicit disclosure; repeated downloads reuse the issued key for the selected pool. Failed claims retain their issuance attempt and retry the same link; an uncertain lost key requires explicit revocation rather than another mint. Manual credential fields mount only while their disclosure is open. Revoked or unavailable connection state clears the remembered key during render before it can be reused. The Connect journey verifies recovery through injected browser operations, starting download and response listeners before the actions they observe. Existing-pool activation and live acceptance remain separate."
      metadata {
        code "src/setup"
        libraries "react|react-dom"
        bindings "TOOLS_SERVICE=basalt.toolsGateway|POOL_SERVICE=basalt.modelGateway"
      }
    }

    feedback = module "Feedback" {
      #basalt #v1 #deep
      description "Same-origin host for the dashboard sidebar's feedback form. The host verifies the caller through the tools service's native cookie session, checks the optional screenshot and redacts the optional page logs again within their caps, and submits accepted feedback through Telemetry."
      metadata {
        code "src/feedback"
        bindings "TOOLS_SERVICE=basalt.toolsGateway"
      }
    }

    telemetry = module "Telemetry" {
      #basalt #v1 #deep #funnel
      description "Shared privacy-filtered HTTP boundary for product events, feedback, traces and errors. Product events carry account IDs and allowlisted properties, never content, credentials or email. AccountConnected remains distinct from app_installed. Direct diagnostic export disables runtime platform trace export; only scrubbed Effect spans and router traces reach the observability adapter. Diagnostic DSN, OTLP endpoint and product capture key settings are optional."
      metadata { code "src/telemetry" }
    }

    setupInstaller = module "Config installer" {
      #basalt #v1 #deep
      description "Node.js installer consumes one-time credentials and parses and writes marked model-client config. It backs up files before writing and supports undo while preserving later unrelated edits. Its shared file engine previews paths and fields without credentials, supports keeping each agent's current settings and checks that reviewed files have not changed. Bundled as a downloadable router asset."
      metadata { code "src/setup/client.mjs|src/setup/config.mjs|src/setup/files.mjs|src/setup/files.d.mts|src/setup/mcp-choice.mjs"; libraries "smol-toml" }
    }

    clientConnection = module "Client connection" {
      #basalt #deep
      summary "Model callers authenticate with their local bearer or X-Api-Key. Direct model forwarding replaces the local key while retaining a separate provider login; native requests use only the device grant. Tools and operator controls retain their bearer-only authority. Operator health reads check server reachability without credentials or grant renewal with bounded network deadlines and cached observations; they never replay application work."
      description "One headless process forwards inference and cloud tools over authenticated loopback HTTP and private stdio IPC. Native sign-in uses verifier-bound browser approval and the outbound device tunnel. Rotated grants reach the credential store before use; an uncertain refresh requires sign-in. Explicit direct keys remain available. Local agents have separate service permissions, bounded streams and cancellation. Interrupted operations are never replayed."
      metadata {
        code "clients/cli|clients/connection|clients/contracts"
        libraries "@modelcontextprotocol/sdk|@napi-rs/keyring|computer-setup|effect|proper-lockfile|ws|node:http|node:https|node:net"
        endpointHosts "127.0.0.1|localhost"
        bindings "globalThis=basalt.router"
      }
    }

    clientDesktop = module "Desktop client" {
      #basalt #deep
      description "Electron window and tray supervise the same headless connection process. Browser approval stores remote credentials in the OS store. Selected agents receive separate local credentials only after a reviewed configuration change. Closing the window keeps the connection running; quitting stops only the process this app started."
      metadata {
        code "clients/desktop"
        libraries "electron|esbuild|react|react-dom"
        endpointHosts "127.0.0.1|localhost"
      }
    }

    clientMobile = module "Phone client" {
      #basalt #deep
      description "Phone sign-in uses browser approval and stores its grant in device-only secure storage. The shared connection adapter streams models and calls cloud tools through the native tunnel. Tool approval and input continue the original request. Backgrounding interrupts active work; returning checks device access. The phone runs no local server or agent process."
      metadata {
        code "clients/mobile"
        libraries "expo|expo-constants|expo-crypto|expo-dev-client|expo-secure-store|expo-system-ui|expo-web-browser|react|react-native|react-native-safe-area-context|effect|node:path"
        endpointHosts "127.0.0.1|localhost"
      }
    }

    poolRuntime = module "Pool runtime" {
      #basalt #v1 #deep
      description """
        Uses the released node WebSocket session pinning for Home-owned model catalogs.
        Continuations on the same socket retain Home authority without a node-local model registration.
        Metadata-only usage keeps the captured client identity until projection produces its fingerprint,
        so Home can attribute records and charges without retaining credentials in the reporter or queue.
        The image build verifies this through the actual Responses handler before plugin probes.
        Projects application logs before the node formats or queues them and independently before
        control-plane ingestion prints or stores them. Keeps a fixed count line, closed severity,
        timestamp and validated generated request ID. Container log collection is enabled in the
        stack. The supervisor forwards closed numeric maintenance signals during normal operation.
        Pool admission does not depend on having an API-equivalent model price. The supervisor
        detects Home billing support and sets allow_unpriced_models before readiness, requiring
        persisted readback. Only the known legacy billing shape can omit that capability.
        Home release updates require the same explicit policy; missing prices remain unknown,
        never synthetic zero-price rules.
        Unexpected process exits emit POOL_CHILD_EXIT with a closed home, node or home_import
        child name, bounded numeric exit status and failure category before cleanup. Home exits also
        attach at most eight Home-formatted error, fatal or panic records from stdout or stderr,
        captured before startup-error projection. The producer formatter escapes embedded CR/LF
        after interpolating messages and fields and appends one physical line delimiter. Embedded
        headers remain in the original slot and are never parsed as additional records. Each record
        matches at most one fixed pinned Home template. Whole dynamic error slots become one of
        eleven priority-ordered labels; listen addresses become a constant. Unmatched records keep
        only the level and unrecognized. The coordinator accepts at most about 4 bits per record,
        8 records. Each record is at most 512 bytes; unformatted and oversized lines are omitted.
        Dynamic details and text suppressed inside the runtime remain unavailable.
        A runtime Home exit 1 permits two replacement generations per supervisor lifetime,
        with 1-second then 5-second backoff and one 180-second deadline per recovery episode.
        Replacement rotates boot identity and requires fresh policy and service health.
        Exhaustion emits a closed recovery record and the normal runtime failure before exit 1.
        A known startup exit retains exactly one closed receipt if its bounded reader drain
        fails or exhausts the operation deadline. The drain failure stays terminal; it cannot
        authorize another launch or publish readiness.
        A runtime Home exit 1 permits two replacement generations per supervisor lifetime,
        with 1-second then 5-second backoff and one 180-second deadline per recovery episode.
        Replacement rotates boot identity and requires fresh policy and service health.
        Recovery management reads reject EOF before the declared body length is consumed,
        even when the partial body is valid JSON or empty; deadline checks still apply.
        Exhaustion emits a closed recovery record and the normal runtime failure before exit 1.
        It emits one `POOL_STARTUP_PHASE` record per measured phase with the exact fields
        `phase`, `start_ms`, `end_ms`, and `duration_ms`. The phase enum is `home_boot`,
        `bootstrap_import`, `config_apply`, `node_launch`, and `initial_health`. The integer
        offsets are bounded to 24 hours from supervisor `main()` entry and use a monotonic clock;
        duration equals end minus start. Supervisor failures, readiness HTTP errors and uncaught
        exceptions still emit numeric categories on stderr, without exception text, class names,
        tracebacks or client addresses.
        `home_boot` measures each Home launch through the supervisor's readiness wait. An empty
        database config ends the first wait early; the supervisor emits `bootstrap_import` and a
        second `home_boot`. The wait includes Home initialization before its readiness response.
        `bootstrap_import` appears only for an empty database config.
        `config_apply` covers the fixed pool config patch. `node_launch` covers Home node-token
        creation and node process launch. `initial_health` waits for Home and node health, including node initialization and mTLS
        certificate enrollment after launch. Those parts are not timed separately.
        Image pull precedes the supervisor and is not measured. Home migration, privacy-guard and
        historical-purge timing is not emitted separately.
        Historical cleanup starts alongside Home listener handling in bounded
        transactions, independently of pool readiness, and does not gate readiness on its completion.
      """
      metadata {
        code "containers/pool"
        libraries "socket|http.client"
        releaseManifest "containers/pool/releases.json"
        sourceManifest "containers/pool/sources.json"
        diagnosticPolicy "metadata-only usage and application logs; closed startup phase enums with bounded monotonic milliseconds; privacy counts and numeric failure categories; unexpected Home exits attach at most eight formatter error records captured before count projection, producer formatter escapes embedded CR/LF before its single physical line delimiter; embedded headers remain slot text and each record matches at most one fixed pinned Home message template with whole dynamic error slots replaced by one of eleven priority-ordered labels and listen addresses replaced by a constant; unmatched records retain only level and unrecognized; coordinator accepts a bounded classifier channel of at most about 4 bits per record, 8 records; records are at most 512 bytes; fingerprint client keys; old-writer guards before readiness; bounded historical cleanup independent of pool readiness"
        schedulingPolicy "default"
        jurisdiction "eu"
        regions "EEUR|WEUR"
        maxInstances "1"
      }
    }

    poolDatabase = store "Pool database" {
      #basalt #v1
      description """
        Model request history lives in 16 fixed hash partitions with source-scoped Home usage IDs;
        HTTP request traces are correlation metadata and may span several attempts.
        Explicit metadata projections retain tokens, timing, status, attribution and immutable price
        provenance forever. Row and statement triggers refuse UPDATE, DELETE and TRUNCATE. No history
        table has cascading foreign keys or a retention deadline. Operator commands install the
        additive schema and approve a count-only historical backfill separately. Activation and capture
        wait for Home's existing privacy history migration before freezing legacy attribution.
        Billing snapshots retain matched rule and requested/response/effective tier provenance.
        A named private operator entrypoint returns bounded catalog and count-only plans using
        the Worker's database connection. Schema writes require explicit GO and matching hashes;
        remote invocation retains a target-bound private plan and started receipt. The operator accepts only
        known v1 and v2 manifests, prints pending DDL and migration markers before apply, and refuses
        changed statement previews. It refreshes the catalog for both versions before applying and refuses when
        the current hash or pending statements differ from the approved plan. Capture defaults
        off; production enables it after approved schema and backfill activation. Capture cannot
        create its own activation cursor. Forward, historical and repeating sweep
        cursors commit with their request rows. Each sweep freezes its upper bound so sustained
        arrivals cannot prevent revisiting late commits. Missing model metadata remains unknown;
        Home charges round half up to twelve decimal places without rejecting extra precision.
        The import endpoint accepts paginated Home JSONL, Manager Plus metadata JSONL or legacy per-request snapshots, defaults
        to a read-only dry run and requires a signed matching approval before inserting a batch.
        It stores neither exports nor prompts, raw keys, human labels or error text. Aggregate-only
        history stays explicitly unimportable. Historical API prices need a model/provider mapping
        and dated rates; only validated complete token breakdowns can receive a calculated price.
        Local Home imports explicitly bind to the local source and resolve its exact usage IDs and
        attribution before signed approval, deduplicating against capture in either order.
        Manager Plus event hashes retain a stable source-scoped identity independent of source row IDs. Its absent authoritative billing and unproved token semantics stay unpriced and legacy. External imports reject changed retained contents even across concurrent inserts; local Home imports retain their canonical attribution resolution. Remote usage IDs stay source-scoped; display-only HTTP codes never fill unknown status. Remote exports use fixed
        read-only Home routes with offset pagination, never a consumable usage queue.
        Guards diagnostic usage and application-log inserts and updates from older writers.
        Application-log cleanup extends the existing privacy journal, including completed usage
        cleanups, with an indexed upper bound and atomic cursor/count commits for at most 100 rows. Its separate
        processed-log count preserves the original usage audit receipt across retries and restarts.
      """
      metadata { database "basalt_pool"; region "eu-central" }
    }

    connection = module "Connection interface" {
      #basalt #planned #deep
      metadata { status "planned Basalt-facing interface" }
    }

    vault = module "Vault interface" {
      #basalt #planned #deep
      metadata { status "planned Basalt-facing interface" }
    }
  }

  poolOwner = person "Pool owner" { #v1 }
  poolMember = person "Pool member" { #v1 }
  localClient = client "Local client" { #v1 }

  mappingService = adapter "Mapping and directions service" {
    #external
    metadata { hosts "routes.googleapis.com|www.google.com" }
  }

  appFramework = adapter "App framework" {
    #external
    metadata { sdks "@executor-js/sdk|@executor-js/utils" }
  }

  schemaVocabulary = adapter "Schema vocabulary" {
    #external
    metadata { hosts "json-schema.org" }
  }

  outsideServices = external "Outside services" {
    #external
    metadata { hosts "dynamic"; sdks "upstream" }
  }

  modelProviders = adapter "Model providers" {
    #external
    metadata { hosts "dynamic|chatgpt.com|api.anthropic.com|mcp.cloudflare.com"; sdks "upstream" }
  }

  priceCatalog = external "API price catalog" {
    #external
    description "models.dev, fetched by the pool backend's own price import. Basalt code never calls it."
    metadata { hosts "dynamic"; sdks "upstream" }
  }

  appHosting = external "App hosting" {
    #external
    description "Private per-app origins under the existing wildcard certificate; only exact a-UUID labels reach the app-page Worker. The app-page Worker gets its address scheme and embedding flags the way the API Worker does, as values its runtime reads bind at deploy, never as explicit plain-text bindings, which the runtime would parse as JSON. It logs every startup or request failure through Effect's logger, as telemetry records failures, by tag and fixed sentence only, plus the key paths and issue kinds of a config error, never its values. Request errors keep their HTTP status; anything else answers with a private 500. Same-site cookies and dashboard-only CSP ancestors support embedded screens. The dashboard decides the App tab and its default selection from the existing UI-presence data, read from build manifests per version, and the caller's access, seeded from the loaded Apps list. The organization layout owns authorized app frames across console navigation and version activation. A page supplies their visible placement without moving their documents. Hidden frames are inert and receive inactive messages so app polling pauses; a bounded least-recently-used set limits retained documents. Changing organizations or confirmed loss of use closes them. Each app request still checks current authority. App query request spans retain separate durations for session and access checks, caller-account resolution and app dispatch, with a fixed completion order. The strict trace exporter accepts only those phase names and finite nonnegative durations. Each completed phase also emits a native structured log with its fixed phase, the same duration and the existing request trace and span IDs, including failed or interrupted phases. The native log store retains those timings when direct trace export disables platform traces and remote log export. Authorization and dispatch behavior stay unchanged."
    metadata { hosts "a-*.signalbox.run"; status "source enabled; live routing unverified" }
  }

