model {
  basalt = system "Basalt" {
    #basalt

    router = module "Router" {
      #basalt #v1 #passthrough #port
      metadata { code "src/router.ts"; endpointHosts "app.signalbox.run"; bindings "TOOLS_SERVICE=basalt.toolsGateway|POOL_SERVICE=basalt.modelGateway|CATALOG_SERVICE=basalt.catalog" }
    }

    brandConfig = part "Brand configuration" {
      metadata { code "brand.ts"; configuration "true" }
    }

    build = module "Build" {
      metadata { code "scripts|containers/pool/fetch_releases.py|containers/pool/Dockerfile|.github/workflows/ci.yml"; libraries "@effect/platform-node|alchemy|esbuild" }
    }

    deployment = module "Deployment" {
      metadata {
        code "alchemy.run.ts|scripts/deploy.ts|scripts/ensure-artifacts.ts|scripts/ensure-pool-database.ts|scripts/environment.ts|scripts/smoke.ts|scripts/pool-acceptance.ts|scripts/pool-acceptance|src/pool/deployment.ts|src/pool/database.ts|.github/workflows/deploy.yml|.github/workflows/pool-acceptance.yml"
        bindings "stageRouter=basalt.router|this.stageRouter=basalt.router"
      }
    }

    toolsGateway = module "Tools gateway" {
      #basalt #v1 #deep #port #funnel
      metadata { code ".upstream/apps/hosted/cloud" }
    }

    catalog = module "Connector catalog" {
      #basalt #v1
      description "Read-only feed in a separate Worker. Merges the official catalog with published additions and provider notices. No person credentials; official app implementations stay unchanged."
      metadata { code "src/catalog" }
    }

    publicIdentity = iface "Public identity" { #v1 }
    publicConnectors = iface "Public connectors" { #v1 }
    publicVault = iface "Public vault" { #v1 }

    identity = module "Identity interface" {
      #basalt #planned #deep
      metadata { status "planned Basalt-facing interface" }
    }

    modelGateway = module "Model gateway" {
      #basalt #v1 #deep #port #funnel
      description "Owns the computer registry and encrypted one-time setup credentials in the pool controller. Generates model keys registered to a user and a nonempty channel-group list. Model traffic remains on the existing /v1 passthrough. After a successful model POST, the pool Worker schedules usage observation with waitUntil; its periodic alarm calls the same observer through the same Home usage interface as a fallback."
      metadata {
        code "src/pool"
        bindings "singleton(env)=basalt.poolController|container.getTcpPort(port)=basalt.poolRuntime|container.getTcpPort(8318)=basalt.poolRuntime|container.getTcpPort(8327)=basalt.poolRuntime"
      }
    }

    poolController = actor "Pool controller" {
      #basalt #v1
      metadata { jurisdiction "eu"; singleton "control-plane" }
    }

    pool = module "Pool app" {
      #basalt #v1 #deep
      description "One private app instance per person per organization, run by the tools service. Accounts and Computers screens request a signed setup intent from the pool Worker and open the root /setup page. App screen hosting is disabled; live acceptance is pending."
      metadata { code "apps/pool"; libraries "apps|react|react-dom"; bindings "ctx=basalt.router" }
    }

    setupHost = module "Setup host" {
      #basalt #v1 #deep
      description "Root /setup React page reuses pool UI components and is bundled as router static assets. HTTP setup handlers use the native cookie session and personal PAT API, then call the private pool binding with an action-bound signature expiring after 30 seconds. Source implementation; live acceptance is pending."
      metadata {
        code "src/setup"
        libraries "react|react-dom"
        bindings "TOOLS_SERVICE=basalt.toolsGateway|POOL_SERVICE=basalt.modelGateway"
      }
    }

    feedback = module "Feedback" {
      #basalt #v1 #deep
      description "Browser feedback widget and same-origin host. The host verifies the caller through the tools service's native cookie session and submits accepted feedback through Telemetry."
      metadata {
        code "src/feedback|public/feedback.js"
        bindings "TOOLS_SERVICE=basalt.toolsGateway"
      }
    }

    telemetry = module "Telemetry" {
      #basalt #v1 #deep #funnel
      description "Shared privacy-filtered HTTP boundary for product events, feedback, traces and errors. Product events carry account IDs and allowlisted properties, never content, credentials or email. AccountConnected remains distinct from app_installed. Direct diagnostic export disables runtime platform trace export; only scrubbed Effect spans and router traces reach the observability adapter. Diagnostic DSN, OTLP endpoint and product capture key settings are optional."
      metadata { code "src/telemetry" }
    }

    setupInstaller = module "Config installer" {
      #basalt #v1 #deep
      description "Node.js installer consumes one-time credentials and parses and writes marked model-client config. It backs up files before writing and supports undo while preserving later unrelated edits. Bundled as a downloadable router asset."
      metadata { code "src/setup/client.mjs|src/setup/config.mjs|src/setup/files.mjs"; libraries "smol-toml" }
    }

    poolRuntime = module "Pool runtime" {
      #basalt #v1 #deep
      metadata {
        code "containers/pool"
        releaseManifest "containers/pool/releases.json"
        schedulingPolicy "default"
        jurisdiction "eu"
        regions "EEUR|WEUR"
        maxInstances "1"
      }
    }

    poolDatabase = store "Pool database" {
      #basalt #v1
      metadata { database "basalt_pool"; region "eu-central" }
    }

    connection = module "Connection interface" {
      #basalt #planned #deep
      metadata { status "planned Basalt-facing interface" }
    }

    vault = module "Vault interface" {
      #basalt #planned #deep
      metadata { status "planned Basalt-facing interface" }
    }
  }

  poolOwner = person "Pool owner" { #v1 }
  poolMember = person "Pool member" { #v1 }
  localClient = client "Local client" { #v1 }

  outsideServices = external "Outside services" {
    #external
    metadata { hosts "dynamic"; sdks "upstream" }
  }

  modelProviders = external "Model providers" {
    #external
    metadata { hosts "dynamic"; sdks "upstream" }
  }

  appHosting = external "App hosting" {
    #external #planned
    metadata { hosts "apps.signalbox.run"; status "disabled origin configuration" }
  }

  basalt.deployment -[sync]-> appHosting "configure origin" { #planned }
  basalt.router -[sync]-> basalt.catalog "CATALOG_SERVICE: /catalog/index.json and app sources"
  basalt.toolsGateway -[sync]-> basalt.catalog "read hosted catalog and app sources"
  basalt.catalog -[sync]-> basalt.brandConfig "read connector copy brand"
  basalt.deployment -[sync]-> basalt.catalog "provision read-only feed Worker"
  basalt.build -[sync]-> basalt.catalog "read catalog configuration"
  basalt.router -[sync]-> basalt.brandConfig "read brand configuration"
  basalt.deployment -[sync]-> basalt.brandConfig "read deployment configuration"
  basalt.deployment -[sync]-> basalt.telemetry "resolve optional telemetry deployment settings"
  basalt.build -[sync]-> basalt.brandConfig "read build configuration"
  basalt.build -[sync]-> basalt.deployment "read deployment settings"
  basalt.deployment -[sync]-> basalt.build "run deployment commands"
  basalt.deployment -[sync]-> basalt.modelGateway "provision pool; supply POOL_APP_SIGNING_KEY and optional telemetry settings"
  basalt.deployment -[sync]-> basalt.poolRuntime "configure pool image"
  basalt.deployment -[sync]-> basalt.toolsGateway "provision tools; supply POOL_APP_SIGNING_KEY, patched apps framework and optional telemetry relay config"
  basalt.deployment -[sync]-> basalt.router "check public routes; supply POOL_APP_SIGNING_KEY and optional telemetry settings"
  basalt.deployment -[sync]-> basalt.router "acceptance: stream test requests and read signed pool usage"
  basalt.deployment -[sync]-> basalt.router "preview: native sign-in and pool data; claim setup; download built installer; observe and revoke computers"
  basalt.deployment -[sync]-> basalt.setupInstaller "preview: execute downloaded built installer and undo"
  basalt.deployment -[sync]-> localClient "preview: run installed model clients in isolated homes"
  basalt.deployment -[sync]-> basalt.pool "import pool usage contract for acceptance"
  basalt.build -[sync]-> basalt.poolRuntime "build pool image"
  basalt.build -[sync]-> basalt.pool "bundle server tools and React screen"
  basalt.build -[sync]-> basalt.feedback "bundle feedback UI"
  basalt.build -[sync]-> basalt.modelGateway "copy pool token signer; check provider catalog"
  basalt.build -[sync]-> basalt.toolsGateway "copy app bundle and token signer; build patched apps framework for compiler"
  basalt.build -[sync]-> basalt.router "copy dashboard fonts to public/brand/fonts for cross-origin pool screens"
  basalt.build -[sync]-> basalt.setupHost "bundle root setup React page from shared pool UI"
  basalt.build -[sync]-> basalt.setupInstaller "install frozen setup dependencies; bundle installer asset"
  basalt.router -[sync]-> basalt.pool "import pool control path contract"
  basalt.modelGateway -[sync]-> basalt.pool "import pool control and sign-in contracts"
  basalt.modelGateway -[sync]-> basalt.brandConfig "read setup brand and public endpoint"
  basalt.router -[sync]-> basalt.setupHost "route /setup/v1/* and /setup/claim/*; observe real MCP tool calls"
  basalt.router -[sync]-> basalt.feedback "serve feedback widget and host submission route"
  basalt.router -[sync]-> basalt.telemetry "record router telemetry and relay events"
  basalt.toolsGateway -[sync]-> basalt.router "optional authenticated analytics and feedback relay"
  basalt.feedback -[sync]-> basalt.toolsGateway "verify caller through native cookie session"
  basalt.feedback -[sync]-> basalt.telemetry "submit accepted feedback"
  basalt.modelGateway -[sync]-> basalt.telemetry "record model request telemetry"
  basalt.setupHost -[sync]-> basalt.telemetry "record setup and computer observation telemetry"
  basalt.setupHost -[sync]-> basalt.router "setup response and public computer metadata"
  basalt.setupHost -[sync]-> basalt.pool "reuse pool UI components"
  basalt.setupHost -[sync]-> basalt.brandConfig "read setup brand and public endpoint"
  basalt.setupHost -[sync]-> basalt.toolsGateway "TOOLS_SERVICE: native cookie get-session; create and delete personal PAT"
  basalt.toolsGateway -[sync]-> basalt.setupHost "verified session or personal PAT result"
  basalt.setupHost -[sync]-> basalt.modelGateway "POOL_SERVICE: private /__setup/v1/*; signed action and 30-second expiry"
  basalt.modelGateway -[sync]-> basalt.setupHost "intent validation, computer metadata or consumed one-time credentials"
  basalt.setupInstaller -[sync]-> basalt.brandConfig "read config markers and public endpoint"
  basalt.setupInstaller -[sync]-> basalt.router "claim one-time credentials from /setup/claim/*"
  basalt.router -[sync]-> basalt.setupInstaller "installer asset or one-time credential response"
  localClient -[sync]-> basalt.setupInstaller "run installer or undo"
  basalt.setupInstaller -[sync]-> localClient "write backed-up marked client config; restart instructions"

  poolOwner -[sync]-> appHosting "open pool screen" { #planned }
  poolMember -[sync]-> appHosting "open shared pool screen" { #planned }
  appHosting -[sync]-> basalt.pool "host pool screen" { #planned }
  poolOwner -[sync]-> basalt.toolsGateway "call pool tools from hosted screen" { #planned }
  basalt.toolsGateway -[sync]-> poolOwner "show pool tool result in hosted screen" { #planned }
  poolOwner -[sync]-> modelProviders "sign in on the provider's page in own browser"
  basalt.pool -[sync]-> basalt.router "pool control API: /pool/v1 with a pool token" {
    description "Scoped to the pool's channel group; owner-only changes and owner-only usage reads by exact client session or key (GET /pool/v1/usage). The tools service supplies ctx.user.id as the caller."
  }
  basalt.router -[sync]-> basalt.modelGateway "POOL_SERVICE: /pool/v1/*"
  basalt.modelGateway -[sync]-> basalt.router "pool control response"
  basalt.router -[sync]-> basalt.pool "pool control response"
  poolOwner -[sync]-> localClient "uses"
  poolMember -[sync]-> localClient "uses"
  localClient -[sync]-> basalt.router "HTTP request"
  basalt.router -[sync]-> basalt.toolsGateway "TOOLS_SERVICE"
  basalt.toolsGateway -[sync]-> basalt.publicIdentity "sign in"
  basalt.toolsGateway -[tool]-> basalt.publicConnectors "connectors"
  basalt.toolsGateway -[sync]-> basalt.publicVault "secret custody"
  basalt.toolsGateway -[tool]-> outsideServices "dynamic egress"

  basalt.router -[model]-> basalt.modelGateway "POOL_SERVICE: /v1 and /v1/*"
  basalt.modelGateway -[sync]-> basalt.poolController "singleton EU control-plane" {
    description "The pool control API verifies the pool token and caller; scoped to the pool's channel group; owner-only changes."
  }
  basalt.poolController -[model]-> basalt.poolRuntime "inference on port 8317"
  basalt.poolController -[sync]-> basalt.poolRuntime "management on port 8327"
  basalt.poolController -[sync]-> basalt.poolRuntime "start or reuse; GET /ready on port 8318"
  basalt.modelGateway -[sync]-> basalt.poolRuntime "container port bindings"
  basalt.modelGateway -[model]-> basalt.pool "serve request" {
    #planned
  }
  basalt.pool -[sync]-> basalt.poolRuntime "invoke runtime" {
    #planned
  }
  basalt.poolRuntime -[sync]-> basalt.poolDatabase "credentials, keys, usage and routing state"
  basalt.poolRuntime -[model]-> modelProviders "provider request"

  basalt.toolsGateway -[tool]-> basalt.pool "install and upgrade per member; link signed pool token" {
    description "One private instance per verified member per organization. Sign the token with POOL_APP_SIGNING_KEY; sharing uses the tools service's built-in sharing."
  }
  basalt.toolsGateway -[tool]-> basalt.pool "run pool app tools with the caller"
  basalt.toolsGateway -[tool]-> basalt.connection "resolve caller connection" {
    #planned
  }
  basalt.connection -[tool]-> basalt.publicConnectors "use public connectors" {
    #planned
  }
  basalt.connection -[sync]-> basalt.vault "read secret" {
    #planned
  }
  basalt.vault -[sync]-> basalt.publicVault "use public vault" {
    #planned
  }
  basalt.identity -[sync]-> basalt.publicIdentity "use public identity" {
    #planned
  }

  localClient -[sync]-> poolOwner "shows result"
  localClient -[sync]-> poolMember "shows result"
  basalt.router -[sync]-> localClient "HTTP response"
  basalt.toolsGateway -[sync]-> basalt.router "service response"
  basalt.pool -[tool]-> basalt.toolsGateway "pool tool result"
  basalt.modelGateway -[model]-> basalt.router "stream reply"
  basalt.poolRuntime -[model]-> basalt.poolController "stream reply"
  basalt.poolRuntime -[sync]-> basalt.poolController "management response or readiness identity"
  basalt.poolController -[model]-> basalt.modelGateway "stream reply"
  basalt.poolController -[sync]-> basalt.modelGateway "pool control or prewarm result"
  basalt.pool -[model]-> basalt.modelGateway "pool result" {
    #planned
  }
  basalt.poolRuntime -[sync]-> basalt.pool "runtime result" {
    #planned
  }
  basalt.poolDatabase -[sync]-> basalt.poolRuntime "state result"
  modelProviders -[model]-> basalt.poolRuntime "provider result"
  outsideServices -[tool]-> basalt.toolsGateway "outside result"
  basalt.publicConnectors -[tool]-> basalt.toolsGateway "connector result"
}
