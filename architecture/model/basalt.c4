model {
  basalt = system "Basalt" {
    #basalt

    router = module "Router" {
      #basalt #v1 #passthrough #port
      metadata { code "src/router.ts"; endpointHosts "app.signalbox.run"; bindings "TOOLS_SERVICE=basalt.toolsGateway|APP_UI_SERVICE=basalt.toolsGateway|ASSETS=basalt.clientAssets|POOL_SERVICE=basalt.modelGateway|CATALOG_SERVICE=basalt.catalog" }
    }

    brandConfig = part "Brand configuration" {
      description "Name, logo, hosts and the brand's own links: docs, privacy, terms and the public source repository the dashboard sidebar links last, under its hosting service's name when the dashboard recognizes it. A fork points the source link at its own repository or sets it to null. The dashboard shows the built-in app's skills under the brand's name; agents still read them as written."
      metadata { code "brand.ts"; configuration "true" }
    }

    build = module "Build" {
      metadata { code "scripts|e2e/slack/catalog.mjs|e2e/slack/run.ts|containers/pool/fetch_releases.py|containers/pool/fetch_sources.py|containers/pool/Dockerfile|.github/workflows/ci.yml|.github/workflows/app-lint.yml"; libraries "@effect/platform-node|alchemy|esbuild"; bindings "platform.env.POOL_OPERATIONS=basalt.modelGateway" }
    }

    deployment = module "Deployment" {
      description "Dashboard and marketing shells wait for successful database migrations before updating, so a failed migration leaves the running shell and its browser assets on the same build. Local development keeps its ordinary build path."
      metadata {
        code "alchemy.run.ts|scripts/deploy.ts|scripts/ensure-artifacts.ts|scripts/ensure-pool-database.ts|scripts/pool-database-provisioning.ts|scripts/pool-history-operator.ts|scripts/environment.ts|scripts/smoke.ts|scripts/pool-acceptance.ts|scripts/pool-acceptance|scripts/preview|scripts/preview-auth|scripts/deploy-safety|src/pool/deployment.ts|src/pool/database.ts|src/pool/worker-database.ts|src/browser-check.ts|.github/workflows/deploy.yml|.github/workflows/pool-acceptance.yml"
        bindings "stageRouter=basalt.router|this.stageRouter=basalt.router|controlPlane=deploymentProvider|platform.env.POOL_OPERATIONS=basalt.modelGateway"
        libraries "better-auth"
      }
    }

    releaseUpdates = module "Release updates" {
      #basalt #v1 #deep
      description "Detects pinned upstream updates and opens one update pull request per release. Tools candidates require published versioned releases. CI proves the exact merge commit against current main. A stale release branch is updated and waits for fresh checks; release merge attempts are serialized in their own workflow. An exact-head preview must pass real sign-in and native client acceptance, then destroy and verify all temporary resources before automatic merge. Database or workflow identity changes take the manual path: they deploy from a main-only environment after a completed backup, with no approval step, and the main deploy starts that path itself. A workflow identity change fails before deploying while any workflow instance is still running. Stopping new work, quiescing writes and database restore are done by whoever dispatches. A protected workflow exports exact dedicated subscription accounts through the owner-scoped control API straight into Actions secrets. Manual rollback accepts the latest successful or failed database release and deploys recorded previous pins once the dispatcher names the restored backup, which must match the recorded one. The next release that contains a single failed release rolls forward over it, re-applying its forward-only migrations and data steps; a second failure, or one the release does not contain, waits for a person, and undoing database writes stays that deliberate rollback. V1 accepts a main advance between the final check and squash merge; production deploys only the exact commit whose own main CI passed. Tools gateway storage migration failures retain only known error classes, SQLSTATE and the attempted registered schema version; release logs never receive SQL, parameters or driver messages. Live acceptance is pending account setup."
      metadata {
        code "scripts/releases|scripts/release-credentials|scripts/release-preview|scripts/release-merge|.github/workflows/releases.yml|.github/workflows/release-preview.yml|.github/workflows/release-cleanup.yml|.github/workflows/release-merge.yml|.github/workflows/release-manual.yml|.github/workflows/release-main.yml|.github/workflows/release-rollback.yml|.github/workflows/release-credentials.yml"
      }
    }

    toolsGateway = module "Tools gateway" {
      #basalt #v1 #deep #port #funnel
      description "Provisioning dispatch keeps original job IDs in database rows and Workflow params, preserving catalog-only and pool-token rotation-only handlers. Invalid instance IDs map to a reserved SHA-256 namespace within runtime adapter limits; create and recovery use the same stable identity. Retained queued jobs retry through that mapping after deployment. Dispatch logs only recognized error names and closed platform diagnostics. The Accounts tab shows each linked account's lab logo, plan and availability badges, and quota meters with remaining text and relative reset times, using upstream's existing account-health tones without per-lab tints. The Accounts list uses the same light logo tile and names the apps that link an account for everyone. The account-row and logo overlay lives in carry 0030, App-tab UI presence lives in carry 0028, and carry 0032 matches upstream #2438. App-acquired accounts use the app's optional connect check with its linked backend accounts; an absent check falls back to provider health. Removing an app-acquired account runs the acquiring version's remove hook. When that version can no longer be prepared, because another requirement's definition changed and its linked account no longer fits, the current version removes it while it still acquires the method. A failed remove step logs the cause's error kind. The pool app's check uses a membership-scoped Home observation; stale or failed readings force a capped collection, and only a fresh completed result passes. Known credential refusals, rate limits and outages use native health reasons. Before check results leave the app or enter storage, a bounded matcher refuses identity and status strings containing raw credential values or opaque references, their UTF-8 base64/base64url forms, percent escapes or hexadecimal forms. Fields the method declares plain are public and never count. A match of eight or more characters fails the check. A shorter match may be chance, so only the identity field, badge, meter or stat containing it is hidden. Status shares the existing JSON health record. Allowance observations use a separate additive table so failed refreshes retain the last reading and its source version without advancing credential health. The product authorizes allowance inspection and refresh independently of account use, and filters every retained report by caller-visible reporter apps. Invalid optional allowance never invalidates a passing credential check. Host-provisioned methods are absent from Connect, reconnect and credential forms. The shared link boundary refuses replacing a provisioned plain-slot link through radio selection, agent connection policies or connection completion. Host-owned provisioning and pool repair use a separate trusted link path."
      metadata { code ".upstream/apps/hosted/cloud" }
    }

    site = module "Public site" {
      #basalt #v1
      description "Home, privacy, terms and legal notice at the zone apex (signalbox.run), rendered from the brand configuration in a separate Worker. Static pages with no scripts, forms or third-party requests."
      metadata { code "src/site" }
    }

    catalog = module "Connector catalog" {
      #basalt #v1
      description "Read-only feed in a separate Worker. Merges the official catalog with published additions. No person credentials. Carried apps pin the prepared host framework and declare each operation's approval. Messaging app source combines frozen public source, a contributed personal user-token patch, and a separate exact host-framework pin. Its registration manifest, app grant and hosted client request matching user scopes and omit the tokens.basic scope rejected at registration. Its queries never require approval; mutations always require approval, including side effects exposed as GET. Community publication remains on hold until the owner selects a publisher scope and the chosen host supports the strict nested-grant option and passes its behavior checks. It substitutes trusted tenant configuration only when tenant and hosted OAuth client settings are complete. The visual collaboration package requests only board read/write scopes and excludes organization and team administration tools. Personal account permissions still apply. Sources stay outside the tools API Worker."
      metadata { code "src/catalog" }
    }

    publicIdentity = iface "Public identity" { #v1 }
    publicConnectors = iface "Public connectors" { #v1 }
    publicVault = iface "Public vault" { #v1 }

    identity = module "Identity interface" {
      #basalt #planned #deep
      metadata { status "planned Basalt-facing interface" }
    }

    modelGateway = module "Model gateway" {
      #basalt #v1 #deep #port #funnel
      description "Owns the computer registry, the pool directory and encrypted one-time setup credentials in the pool controller. A per-pool handoff can make the native app audience and organization roles authoritative for use and management; deployment preserves existing grants until that handoff. Membership writes and audience projections share an organization database lock until native auth finishes its write. Native managers need use access to administer usage and caps; old tokens cannot restore revoked native grants. Generates model keys registered to a user and a nonempty channel-group list, re-points a computer's key to another of the person's pools, and applies signed access changes: revokes the keys of people who lost a pool before the tools service commits. Before looking up the singleton pool controller, the Worker normalizes credentials as Home does and checks model-key candidates in Home order through POOL_AUTH_DATABASE, stopping at the first active api_key match before later malformed candidates can fail. Its separate Hyperdrive configuration uses the pool runtime role and logical database with verified TLS, query caching disabled and a soft limit of five origin connections. The container retains POOL_DATABASE_URL for its direct connection. Connections and queries each time out after 2.5 seconds, and the entire lookup including graceful close has a six-second deadline that destroys a stalled connection; missing, invalid and revoked keys return 401, and missing bindings, database failures or timeouts return 503. Signed pool-control tokens and computer credentials use their existing routes and checks. Home still applies quota and model policy after a valid key reaches the pool runtime. After a successful model POST, the pool Worker schedules usage observation with waitUntil; its periodic alarm calls the same observer through the same Home usage interface as a fallback. Keeps 31 days of per-pool, per-person, per-account, per-model daily usage read from Home's records, reads each pool account's limit windows, banked resets and reading freshness from Home's per-credential quota detail, samples account limits for the accounts-needed advice, asks Home to import API prices, sets each member's optional weekly cap as a Home spend limit on that person's backend user for the pool, and rewrites Home's cap refusal into a clear message."
      metadata {
        code "src/pool"
        bindings "POOL_AUTH_DATABASE=databaseService|POOL_DATABASE_URL=basalt.poolDatabase|singleton(env)=basalt.poolController|container.getTcpPort(port)=basalt.poolRuntime|container.getTcpPort(8318)=basalt.poolRuntime|container.getTcpPort(8327)=basalt.poolRuntime"
      }
    }

    usageImportClient = adapter "Usage import client" {
      description "Operator-supplied target origin and private pool-token file. Redirects are refused; only the usage import endpoint is called."
      metadata { code "scripts/import-usage.ts"; bindings "globalThis=basalt.modelGateway" }
    }

    usageExportClient = adapter "Usage export client" {
      description "Operator-supplied source origin and private management-key file. Reads fixed non-destructive export routes, checks page counts and refuses redirects."
      metadata { code "scripts/usage-import-source.ts"; bindings "globalThis=historyExportService" }
    }

    poolController = actor "Pool controller" {
      #basalt #v1
      metadata { jurisdiction "eu"; singleton "control-plane" }
    }

    pool = module "Pool app" {
      #basalt #v1 #deep
      description "One private app instance per person per organization, run by the tools service. The pool owner's membership-scoped Home readings feed the host's generic allowance observations, preserving reported windows, quantities, periods, source times and expiring balances. Observation endpoints remain owner-only; members keep the existing health path. Accounts uses the host's native check status with exception-only pool badges; idle freshness, zero reset counts and internal window IDs are omitted. Usage screen; Usage shows tokens and API-equivalent cost per model over 30 days, the whole pool for an authorized manager who can use it and only the caller's own otherwise. Before the native-policy handoff the recorded owner retains the existing management rule. People set up and list their computers on the tools gateway's Connect page, which asks the pool Worker for a signed setup intent through this app's computerContext query. App screens embed on isolated opaque same-site origins; live routing acceptance is pending."
      metadata { code "apps/pool"; libraries "apps|react|react-dom"; bindings "ctx=basalt.router" }
    }

    setupHost = module "Setup host" {
      #basalt #v1 #deep
      description "The root /share React page reuses pool UI components and is bundled as a router static asset; /setup redirects to the person's own organization's Connect page. The share page shows each person's 30-day usage and lets the owner set or remove their weekly cap. HTTP handlers use the native cookie session, personal PAT, organization invitation and member APIs and app access, then call the private pool binding with an action-bound signature expiring after 30 seconds. Source implementation; live acceptance is pending."
      metadata {
        code "src/setup"
        libraries "react|react-dom"
        bindings "TOOLS_SERVICE=basalt.toolsGateway|POOL_SERVICE=basalt.modelGateway"
      }
    }

    feedback = module "Feedback" {
      #basalt #v1 #deep
      description "Same-origin host for the dashboard sidebar's feedback form. The host verifies the caller through the tools service's native cookie session, checks the optional screenshot and redacts the optional page logs again within their caps, and submits accepted feedback through Telemetry."
      metadata {
        code "src/feedback"
        bindings "TOOLS_SERVICE=basalt.toolsGateway"
      }
    }

    telemetry = module "Telemetry" {
      #basalt #v1 #deep #funnel
      description "Shared privacy-filtered HTTP boundary for product events, feedback, traces and errors. Product events carry account IDs and allowlisted properties, never content, credentials or email. AccountConnected remains distinct from app_installed. Direct diagnostic export disables runtime platform trace export; only scrubbed Effect spans and router traces reach the observability adapter. Diagnostic DSN, OTLP endpoint and product capture key settings are optional."
      metadata { code "src/telemetry" }
    }

    setupInstaller = module "Config installer" {
      #basalt #v1 #deep
      description "Node.js installer consumes one-time credentials and parses and writes marked model-client config. It backs up files before writing and supports undo while preserving later unrelated edits. Bundled as a downloadable router asset."
      metadata { code "src/setup/client.mjs|src/setup/config.mjs|src/setup/files.mjs"; libraries "smol-toml" }
    }

    clientConnection = module "Client connection" {
      #basalt #deep
      description "One headless process forwards inference and cloud tools over authenticated loopback HTTP and private stdio IPC. Local agents have separate service permissions; remote credentials stay in the OS store or explicitly selected owner-only headless files. Streaming, cancellation and backpressure pass through, and interrupted requests are never replayed. Direct-key mode does not register a native device."
      metadata {
        code "clients/cli|clients/connection|clients/contracts"
        libraries "@modelcontextprotocol/sdk|@napi-rs/keyring|effect|proper-lockfile|node:http|node:https|node:net"
        endpointHosts "127.0.0.1|localhost"
      }
    }

    poolRuntime = module "Pool runtime" {
      #basalt #v1 #deep
      description """
        Projects application logs before the node formats or queues them and independently before
        control-plane ingestion prints or stores them. Keeps a fixed count line, closed severity,
        timestamp and validated generated request ID. Container log collection is enabled in the
        stack. For child output, the supervisor forwards only closed numeric maintenance signals.
        It emits one `POOL_STARTUP_PHASE` record per measured phase with the exact fields
        `phase`, `start_ms`, `end_ms`, and `duration_ms`. The phase enum is `home_boot`,
        `bootstrap_import`, `config_apply`, `node_launch`, and `initial_health`. The integer
        offsets are bounded to 24 hours from supervisor `main()` entry and use a monotonic clock;
        duration equals end minus start. Its failures, readiness HTTP errors and uncaught
        exceptions still emit numeric categories on stderr, without exception text, class names,
        tracebacks or client addresses.
        `home_boot` measures each Home launch through the supervisor's readiness wait. An empty
        database config ends the first wait early; the supervisor emits `bootstrap_import` and a
        second `home_boot`. The wait includes Home initialization before its readiness response.
        `bootstrap_import` appears only for an empty database config.
        `config_apply` covers the fixed pool config patch. `node_launch` covers Home node-token
        creation and node process launch. `initial_health` waits for Home and node health, including node initialization and mTLS
        certificate enrollment after launch. Those parts are not timed separately.
        Image pull precedes the supervisor and is not measured. Home migration, privacy-guard and
        historical-purge timing is not emitted separately.
        Historical cleanup starts alongside Home listener handling in bounded
        transactions, independently of pool readiness, and does not gate readiness on its completion.
      """
      metadata {
        code "containers/pool"
        releaseManifest "containers/pool/releases.json"
        sourceManifest "containers/pool/sources.json"
        diagnosticPolicy "metadata-only usage and application logs; closed startup phase enums with bounded monotonic milliseconds; privacy counts and numeric failure categories; fingerprint client keys; old-writer guards before readiness; bounded historical cleanup independent of pool readiness"
        schedulingPolicy "default"
        jurisdiction "eu"
        regions "EEUR|WEUR"
        maxInstances "1"
      }
    }

    poolDatabase = store "Pool database" {
      #basalt #v1
      description """
        Model request history lives in 16 fixed hash partitions with source-scoped Home usage IDs;
        HTTP request traces are correlation metadata and may span several attempts.
        Explicit metadata projections retain tokens, timing, status, attribution and immutable price
        provenance forever. Row and statement triggers refuse UPDATE, DELETE and TRUNCATE. No history
        table has cascading foreign keys or a retention deadline. Operator commands install the
        additive schema and approve a count-only historical backfill separately. Activation and capture
        wait for Home's existing privacy history migration before freezing legacy attribution.
        Billing snapshots retain matched rule and requested/response/effective tier provenance.
        A named private operator entrypoint returns bounded catalog and count-only plans using
        the Worker's database connection. Schema writes require explicit GO and matching hashes;
        remote invocation retains a target-bound private plan and started receipt. Capture defaults
        off; production enables it after approved schema and backfill activation. Capture cannot
        create its own activation cursor. Forward, historical and repeating sweep
        cursors commit with their request rows. Each sweep freezes its upper bound so sustained
        arrivals cannot prevent revisiting late commits. Missing model metadata remains unknown;
        Home charges round half up to twelve decimal places without rejecting extra precision.
        The import endpoint accepts paginated Home JSONL or legacy per-request snapshots, defaults
        to a read-only dry run and requires a signed matching approval before inserting a batch.
        It stores neither exports nor prompts, raw keys, human labels or error text. Aggregate-only
        history stays explicitly unimportable. Historical API prices need a model/provider mapping
        and dated rates; only validated complete token breakdowns can receive a calculated price.
        Local Home imports explicitly bind to the local source and resolve its exact usage IDs and
        attribution before signed approval, deduplicating against capture in either order.
        Remote usage IDs stay source-scoped; display-only HTTP codes never fill unknown status. Remote exports use fixed
        read-only Home routes with offset pagination, never a consumable usage queue.
        Guards diagnostic usage and application-log inserts and updates from older writers.
        Application-log cleanup extends the existing privacy journal, including completed usage
        cleanups, with an indexed upper bound and atomic cursor/count commits for at most 100 rows. Its separate
        processed-log count preserves the original usage audit receipt across retries and restarts.
      """
      metadata { database "basalt_pool"; region "eu-central" }
    }

    connection = module "Connection interface" {
      #basalt #planned #deep
      metadata { status "planned Basalt-facing interface" }
    }

    vault = module "Vault interface" {
      #basalt #planned #deep
      metadata { status "planned Basalt-facing interface" }
    }
  }

  poolOwner = person "Pool owner" { #v1 }
  poolMember = person "Pool member" { #v1 }
  localClient = client "Local client" { #v1 }

  outsideServices = external "Outside services" {
    #external
    metadata { hosts "dynamic"; sdks "upstream" }
  }

  modelProviders = adapter "Model providers" {
    #external
    metadata { hosts "dynamic|chatgpt.com|api.anthropic.com"; sdks "upstream" }
  }

  priceCatalog = external "API price catalog" {
    #external
    description "models.dev, fetched by the pool backend's own price import. Basalt code never calls it."
    metadata { hosts "dynamic"; sdks "upstream" }
  }

  appHosting = external "App hosting" {
    #external
    description "Private per-app origins under the existing wildcard certificate; only exact a-UUID labels reach the app-page Worker. The app-page Worker gets its address scheme and embedding flags the way the API Worker does, as values its runtime reads bind at deploy, never as explicit plain-text bindings, which the runtime would parse as JSON. It logs every startup or request failure through Effect's logger, as telemetry records failures, by tag and fixed sentence only, plus the key paths and issue kinds of a config error, never its values. Request errors keep their HTTP status; anything else answers with a private 500. Same-site cookies and dashboard-only CSP ancestors support embedded screens. The dashboard decides the App tab and its default selection from the existing UI-presence data, read from build manifests per version, and the caller's access, seeded from the loaded Apps list. It prewarms a mounted App frame, keeps it mounted through version activation, and tells it when it is hidden so app polling pauses."
    metadata { hosts "a-*.signalbox.run"; status "source enabled; live routing unverified" }
  }

  basalt.deployment -[sync]-> appHosting "configure opaque same-site origins and wildcard routing"
  basalt.router -[sync]-> basalt.clientAssets "ASSETS: dashboard-host static files only"
  basalt.router -[sync]-> basalt.catalog "CATALOG_SERVICE: /catalog/index.json and app sources"
  basalt.toolsGateway -[sync]-> basalt.catalog "read hosted catalog and app sources"
  basalt.catalog -[sync]-> basalt.brandConfig "read connector copy brand"
  basalt.site -[sync]-> basalt.brandConfig "read site copy, operator and links"
  basalt.site -[sync]-> basalt.clientAssets "serve brand logo and fonts"
  basalt.site -[sync]-> basalt.router "link Sign in to the app host"
  basalt.deployment -[sync]-> basalt.site "provision apex site Worker"
  basalt.deployment -[sync]-> basalt.catalog "provision read-only feed Worker"
  basalt.build -[sync]-> basalt.catalog "read catalog configuration"
  basalt.router -[sync]-> basalt.brandConfig "read brand configuration"
  basalt.deployment -[sync]-> basalt.brandConfig "read deployment configuration"
  basalt.deployment -[sync]-> basalt.telemetry "resolve optional telemetry deployment settings"
  basalt.build -[sync]-> basalt.brandConfig "read build configuration"
  basalt.build -[sync]-> basalt.site "render the home page volcano to the page's timing"
  basalt.build -[sync]-> basalt.deployment "read deployment settings"
  basalt.deployment -[sync]-> basalt.build "run deployment commands"
  basalt.releaseUpdates -[sync]-> basalt.pool "read pool control contract"
  basalt.releaseUpdates -[sync]-> basalt.modelGateway "sign owner-scoped export claims"
  basalt.releaseUpdates -[sync]-> basalt.brandConfig "derive public credential export origin"
  basalt.releaseUpdates -[sync]-> basalt.router "export exact dedicated owner accounts through pool control API"
  basalt.releaseUpdates -[sync]-> basalt.build "prepare pinned source and verify carried patches"
  basalt.releaseUpdates -[sync]-> basalt.deployment "deploy isolated preview; seed native sign-in; destroy and verify absence"
  basalt.deployment -[sync]-> basalt.releaseUpdates "classify source changes before backup and workflow drain gates"
  basalt.releaseUpdates -[sync]-> basalt.toolsGateway "sign in with native preview auth and use credential-free tool search"
  basalt.releaseUpdates -[sync]-> basalt.setupHost "mint and revoke separate preview computers through public setup routes"
  basalt.releaseUpdates -[sync]-> basalt.setupInstaller "download and run the public installer; undo isolated client configuration"
  basalt.releaseUpdates -[sync]-> localClient "run both native clients with dedicated preview credentials"
  localClient -[sync]-> basalt.releaseUpdates "return native model and tool-call evidence"
  basalt.deployment -[sync]-> basalt.modelGateway "provision pool; supply POOL_APP_SIGNING_KEY and optional telemetry settings"
  basalt.deployment -[sync]-> basalt.poolRuntime "configure pool image"
  basalt.deployment -[sync]-> basalt.toolsGateway "provision tools; supply POOL_APP_SIGNING_KEY, patched apps framework and optional telemetry relay config"
  basalt.deployment -[sync]-> basalt.router "check public routes; supply POOL_APP_SIGNING_KEY and optional telemetry settings"
  basalt.deployment -[sync]-> basalt.router "acceptance: stream test requests and read signed pool usage"
  basalt.deployment -[sync]-> basalt.router "preview: native sign-in and pool data; claim setup; download built installer; observe and revoke computers"
  basalt.deployment -[sync]-> basalt.setupInstaller "preview: execute downloaded built installer and undo"
  basalt.deployment -[sync]-> localClient "preview: run installed model clients in isolated homes"
  basalt.deployment -[sync]-> basalt.pool "import pool usage contract for acceptance"
  basalt.build -[sync]-> basalt.poolRuntime "build pool image"
  basalt.build -[sync]-> basalt.pool "bundle server tools and React screen"
  basalt.build -[sync]-> basalt.modelGateway "copy pool token signer; check provider catalog"
  basalt.build -[sync]-> basalt.modelGateway "POOL_OPERATIONS: dry run or apply an approved bounded provider credential transport update through the private entrypoint"
  basalt.build -[sync]-> basalt.toolsGateway "write the pool app bundle as a hash-named site asset; copy token signer and access contract; build patched apps framework for compiler"
  basalt.build -[sync]-> basalt.router "copy dashboard fonts to public/brand/fonts for cross-origin pool screens"
  basalt.build -[sync]-> basalt.setupHost "bundle the root share React page from shared pool UI"
  basalt.build -[sync]-> basalt.setupInstaller "install frozen setup dependencies; bundle installer asset"
  basalt.router -[sync]-> basalt.pool "import pool control path contract"
  basalt.modelGateway -[sync]-> basalt.pool "import pool control and sign-in contracts"
  basalt.modelGateway -[sync]-> basalt.brandConfig "read setup brand and public endpoint"
  basalt.router -[sync]-> basalt.setupHost "route /setup/v1/*, /setup/claim/* and /share/v1/*; observe real MCP tool calls"
  basalt.router -[sync]-> basalt.feedback "route /feedback/v1/* to the submission host"
  basalt.deployment -[sync]-> basalt.feedback "point the dashboard's feedback form at the submission route when diagnostics are configured"
  basalt.router -[sync]-> basalt.telemetry "record router telemetry and relay events"
  basalt.toolsGateway -[sync]-> basalt.router "optional authenticated analytics and feedback relay"
  basalt.feedback -[sync]-> basalt.toolsGateway "verify caller through native cookie session"
  basalt.feedback -[sync]-> basalt.telemetry "submit accepted feedback"
  basalt.modelGateway -[sync]-> basalt.telemetry "record model request telemetry"
  basalt.setupHost -[sync]-> basalt.telemetry "record setup and computer observation telemetry"
  basalt.setupHost -[sync]-> basalt.router "setup response and public computer metadata"
  basalt.setupHost -[sync]-> basalt.pool "reuse pool UI components"
  basalt.setupHost -[sync]-> basalt.brandConfig "read setup brand and public endpoint"
  basalt.setupHost -[sync]-> basalt.toolsGateway "TOOLS_SERVICE: native cookie get-session; create and delete personal PAT; list organizations"
  basalt.setupHost -[sync]-> basalt.toolsGateway "TOOLS_SERVICE: share a pool; invite as member, cancel and remove; app access" {
    description "Removal commits only after the tools service's access hook revoked the member's computer keys on the pool."
  }
  basalt.toolsGateway -[sync]-> basalt.setupHost "verified session or personal PAT result"
  basalt.setupHost -[sync]-> basalt.modelGateway "POOL_SERVICE: private /__setup/v1/*; signed action and 30-second expiry"
  basalt.modelGateway -[sync]-> basalt.setupHost "intent validation, computer metadata or consumed one-time credentials"
  basalt.setupInstaller -[sync]-> basalt.brandConfig "read config markers and public endpoint"
  basalt.setupInstaller -[sync]-> basalt.router "claim one-time credentials from /setup/claim/*"
  basalt.router -[sync]-> basalt.setupInstaller "installer asset or one-time credential response"
  localClient -[sync]-> basalt.setupInstaller "run installer or undo"
  localClient -[sync]-> basalt.clientConnection "local model requests and cloud tool calls"
  basalt.clientConnection -[sync]-> basalt.router "authenticated direct model and tools requests"
  basalt.router -[sync]-> basalt.clientConnection "stream reply or MCP messages"
  basalt.clientConnection -[sync]-> localClient "stream reply or MCP messages"
  basalt.setupInstaller -[sync]-> localClient "write backed-up marked client config; restart instructions"

  poolOwner -[sync]-> appHosting "open private app screen in dashboard App tab"
  poolMember -[sync]-> appHosting "open authorized shared app screen in dashboard App tab"
  appHosting -[sync]-> basalt.toolsGateway "authenticate and serve isolated app screen"
  poolOwner -[sync]-> basalt.toolsGateway "call pool tools from hosted screen" { #planned }
  basalt.toolsGateway -[sync]-> poolOwner "show pool tool result in hosted screen" { #planned }
  poolOwner -[sync]-> modelProviders "sign in on the provider's page in own browser"
  basalt.pool -[sync]-> basalt.router "pool control API: /pool/v1 with a pool token" {
    description "Scoped to the pool's channel group; owner-only changes and owner-only usage reads by exact client session or key (GET /pool/v1/usage). GET /pool/v1/usage/summary answers any caller: the whole pool for the owner, only their own usage and cap for anyone else. The tools service supplies ctx.user.id as the caller."
  }
  basalt.router -[sync]-> basalt.modelGateway "POOL_SERVICE: /pool/v1/*"
  basalt.toolsGateway -[sync]-> basalt.router "access change: POST /pool/v1/access, signed sba1, before the change commits" {
    description "Sharing, groups, member removal, pool deletion, organization removal and account deletion send the pool's new audience. A non-2xx answer fails the change."
  }
  basalt.router -[sync]-> basalt.toolsGateway "access change applied: keys revoked, backend users created"
  basalt.modelGateway -[sync]-> basalt.router "pool control response"
  basalt.router -[sync]-> basalt.pool "pool control response"
  poolOwner -[sync]-> localClient "uses"
  poolMember -[sync]-> localClient "uses"
  localClient -[sync]-> basalt.router "HTTP request"
  basalt.router -[sync]-> basalt.toolsGateway "TOOLS_SERVICE: dashboard and API; APP_UI_SERVICE: isolated app origins"
  basalt.toolsGateway -[sync]-> basalt.publicIdentity "sign in"
  basalt.toolsGateway -[tool]-> basalt.publicConnectors "connectors"
  basalt.toolsGateway -[sync]-> basalt.publicVault "secret custody"
  basalt.toolsGateway -[tool]-> outsideServices "dynamic egress"

  basalt.router -[model]-> basalt.modelGateway "POOL_SERVICE: /v1 and /v1/*"
  basalt.modelGateway -[sync]-> basalt.poolDatabase "check active Home API-key candidates through uncached Hyperdrive before controller lookup"
  basalt.modelGateway -[sync]-> basalt.poolController "singleton EU control-plane" {
    description "The pool control API verifies the pool token and caller; scoped to the pool's channel group; owner-only changes."
  }
  basalt.poolController -[model]-> basalt.poolRuntime "inference on port 8317"
  basalt.poolController -[sync]-> basalt.poolRuntime "management on port 8327" {
    description "Pool views overlap membership and credential reads, then read only the membership-scoped quota details with bounded concurrency. Operation timings record fixed names, durations and counts without Home response data; readiness warming is timed separately. Subscription checks and idle sampling share a persisted 30-minute forced-collection cap per account. Checks allow the owner or current pool audience and verify exact credential membership. Separate owner-only observation read and refresh routes return a bounded projection, preserve quota alongside credential failures, and bypass OAuth attribution state. A check's Home reads share a twelve-second deadline, including membership and credentials, and wait at most nine seconds for a completed collection. Current pool members can force capped quota collection. Owner-only pool app tools pause and resume routing and clear quota cooldowns. Banked-reset reads retain provider credit IDs, expiry and model provider use conditions. Reset redemption uses fixed provider URLs through Home token substitution; per-account queues and durable request receipts preserve uncertain outcomes and retry follow-up work without repeating a confirmed spend."
  }
  basalt.poolController -[sync]-> basalt.poolRuntime "start or reuse; GET /ready on port 8318" {
    description "The controller persists the desired launch revision after stopping an older boot and before starting its replacement. A readiness timeout or controller replacement preserves a running boot for that revision; a changed image or secret revision still replaces it. Readiness remains a separate bounded check. A failed revision write prevents launch, and a failed stop leaves the old revision recorded."
  }
  basalt.modelGateway -[sync]-> basalt.poolRuntime "container port bindings"
  basalt.modelGateway -[model]-> basalt.pool "serve request" {
    #planned
  }
  basalt.pool -[sync]-> basalt.poolRuntime "invoke runtime" {
    #planned
  }
  basalt.poolRuntime -[sync]-> basalt.poolDatabase "credentials, keys, usage and routing state"
  basalt.modelGateway -[sync]-> basalt.poolDatabase "read-only migration inventory without starting Home"
  basalt.modelGateway -[sync]-> basalt.poolDatabase "capture content-free request history and serve authorized history pages"
  basalt.deployment -[sync]-> basalt.modelGateway "POOL_OPERATIONS: inspect the schema catalog and apply an explicitly approved additive schema"
  basalt.usageImportClient -[sync]-> basalt.modelGateway "dry-run and apply bounded usage imports"
  basalt.usageImportClient -[sync]-> basalt.usageExportClient "read private source files or export pages"
  basalt.usageExportClient -[sync]-> basalt.modelGateway "use the shared import size and metadata validation contract"
  basalt.poolRuntime -[model]-> modelProviders "provider request"
  basalt.modelGateway -[sync]-> modelProviders "read and redeem banked resets through Home token substitution"
  basalt.poolRuntime -[sync]-> priceCatalog "import API prices when the pool Worker asks"

  basalt.toolsGateway -[tool]-> basalt.pool "install and upgrade per member from the hash-checked site asset; link signed pool token" {
    description "One private instance per verified member per organization. Sign the token with POOL_APP_SIGNING_KEY; sharing uses the tools service's built-in sharing."
  }
  basalt.toolsGateway -[tool]-> basalt.pool "run pool app tools with the caller"
  basalt.toolsGateway -[tool]-> basalt.connection "resolve caller connection" {
    #planned
  }
  basalt.connection -[tool]-> basalt.publicConnectors "use public connectors" {
    #planned
  }
  basalt.connection -[sync]-> basalt.vault "read secret" {
    #planned
  }
  basalt.vault -[sync]-> basalt.publicVault "use public vault" {
    #planned
  }
  basalt.identity -[sync]-> basalt.publicIdentity "use public identity" {
    #planned
  }

  localClient -[sync]-> poolOwner "shows result"
  localClient -[sync]-> poolMember "shows result"
  basalt.router -[sync]-> localClient "HTTP response"
  basalt.toolsGateway -[sync]-> basalt.router "service response"
  basalt.pool -[tool]-> basalt.toolsGateway "pool tool result"
  basalt.modelGateway -[model]-> basalt.router "stream reply"
  basalt.poolRuntime -[model]-> basalt.poolController "stream reply"
  basalt.poolRuntime -[sync]-> basalt.poolController "management response or readiness identity"
  basalt.poolController -[model]-> basalt.modelGateway "stream reply"
  basalt.poolController -[sync]-> basalt.modelGateway "pool control or prewarm result"
  basalt.pool -[model]-> basalt.modelGateway "pool result" {
    #planned
  }
  basalt.poolRuntime -[sync]-> basalt.pool "runtime result" {
    #planned
  }
  basalt.poolDatabase -[sync]-> basalt.poolRuntime "state result"
  modelProviders -[model]-> basalt.poolRuntime "provider result"
  outsideServices -[tool]-> basalt.toolsGateway "outside result"
  basalt.publicConnectors -[tool]-> basalt.toolsGateway "connector result"
}
