model {
  extend basalt.toolsGateway {
    accountTargets = part "Account execution targets" {
      description "A saved account retains target metadata independently of app instances. No binding means cloud execution. A host-authorized binding records one named device and observed availability. Device-bound accounts always refuse execution before cloud credential resolution, even when the device is online. This slice has no dispatch callback or production device host. Embedded MCP Apps bundles include the account target contract, so they must be generated after the target overlay. Authenticated reverse transport, a client receiver and current device access-grant enforcement remain required for device execution. Retargeting uses a revision check and authorizes both bindings; disabling retains the binding until an explicit revision-checked return to cloud execution. Approval resumption and other cloud execution paths refuse a device-bound account. Hosted and local HTTP tool contracts and their clients preserve the offline and unavailable errors. Receipt-gated app calls use the same tools.call refusal gate; enabling cloud mutations does not enable device execution."
      metadata { code ".upstream/packages/sdk/src/implementation/account-targets.ts|.upstream/packages/sdk/src/implementation/account-target-schema.ts|.upstream/packages/sdk/src/contracts/account-target.ts" }
    }
    appCalls = part "App dependency calls" {
      description "Saved personal or shared dependency connections bind one exact target app instance and account selection. The host rechecks current authority and calls the ordinary native tool path. A trusted configuration callback runs only after a successful consumed SDK approval; it attaches or revokes an encrypted confirmation bound to current connection and source/target versions. Native dispatch consults host policy after decoding; denials and policy failures remain authoritative. Approved mutations reserve a receipt after current authority is checked again. The native framework replays completed results before target execution. Host protocol changes regenerate the embedded MCP renderer and its content-addressed asset paths with the pinned generator. An unmatched ask refuses before saving an independently resumable target approval. Workflow evidence comes from the active runtime step, crosses the native workerd workflow host transport and is rebound to the stored run at the receiving host. Account generations come from the normal current saved-account selector. Host policy lookups run as independent invocations without inheriting the target effect context. Queries remain read-only. Mutations require a retained target framework that implements receipt replay and a persisted workflow or parent operation identity. Entry paths without that identity refuse cross-app effects before dispatch. Host-assigned operation ordinals bind workflow effects to the stored run and active step, including after a process restart. Encrypted effect receipts reserve one host operation identity, retain completed results and close expired or uncertain reservations without dispatch takeover."
      metadata { code ".upstream/packages/sdk/src/implementation/app-calls.ts|.upstream/packages/sdk/src/implementation/app-call-context.ts|.upstream/packages/sdk/src/implementation/app-call-effects.ts|.upstream/packages/sdk/src/implementation/app-call-protection.ts|.upstream/packages/sdk/src/implementation/app-connections.ts|.upstream/packages/sdk/src/implementation/app-call-receipts.ts|.upstream/packages/sdk/src/implementation/app-confirmations.ts|.upstream/packages/sdk/src/implementation/app-call-accounts.ts" }
    }
  }
}
