model {
  extend basalt.toolsGateway {
    accountTargets = part "Account execution targets" {
      description "A saved account retains its execution target independently of app instances. No binding means cloud execution. A host-authorized device binding routes explicit queries through the ordinary tools.call selector to one named device, carrying only saved account identities and generations. Availability is observed at read and dispatch time. Disabled, offline, missing and mixed-device bindings never fall back to cloud credentials. Retargeting uses a revision check and authorizes both bindings; disabling retains the binding until an explicit revision-checked return to cloud execution. Approval resumption and other unsupported cloud execution paths refuse a device-bound account. Reverse transport and device operation journals belong to the device host."
      metadata { code ".upstream/packages/sdk/src/implementation/account-targets.ts|.upstream/packages/sdk/src/implementation/account-target-schema.ts|.upstream/packages/sdk/src/contracts/account-target.ts" }
    }
    appCalls = part "App dependency calls" {
      description "Saved personal or shared dependency connections bind one exact target app instance and account selection. The host rechecks current authority and calls the ordinary native tool path. A trusted configuration callback runs only after a successful consumed SDK approval; it attaches or revokes an encrypted confirmation bound to current connection and source/target versions. Native dispatch consults host policy only after decoding and only to satisfy user-approval; denials and policy failures remain authoritative. Workflow evidence comes from the active runtime step, crosses the native workerd workflow host transport and is rebound to the stored run at the receiving host. Account generations come from the normal current saved-account selector. Only queries are enabled in the first slice; mutation calls return effects_unavailable. Encrypted effect receipts reserve one host operation identity, retain completed results and close expired or uncertain reservations without dispatch takeover."
      metadata { code ".upstream/packages/sdk/src/implementation/app-calls.ts|.upstream/packages/sdk/src/implementation/app-connections.ts|.upstream/packages/sdk/src/implementation/app-call-receipts.ts|.upstream/packages/sdk/src/implementation/app-confirmations.ts|.upstream/packages/sdk/src/implementation/app-call-accounts.ts" }
    }
  }
}
