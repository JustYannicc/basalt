model {
  extend basalt.toolsGateway {
    appHostNavigation = part "App host navigation" {
      description "An embedded app page asks its host, through the public app client, to open one of its own app's tabs or the Accounts page with an account highlighted. The shown app screen follows only its own document's requests, at its origin, while the person's login and the page's own sign-in are live and for the app's active version, as a new history entry in the same window; the host's permissions decide what the person then sees. One frame owner above the routes keeps each running document across the dashboard and the app's own window."
      metadata { code ".upstream/packages/ui/src/contracts/host-navigation.ts|.upstream/apps/hosted/web/src/implementation/pages/app-screen.tsx|.upstream/apps/hosted/web/src/implementation/components/app-frames.tsx" }
    }
  }
}
