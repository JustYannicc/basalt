model {
  extend basalt {
    acceptancePool = module "Acceptance pool operation" {
      #basalt
      description "A manual main-branch workflow drives the tools gateway's signed acceptance-pool route: one setup plan and one teardown plan per test run, each a dry run first and then an apply bound to that plan's checksum and the coordinator's exact GO, plus read-only verifications. It runs in the emulated upstream's own environment and shares production-ops' concurrency group, so two production operations never run at once. The target is named, production so far, and the driver builds its host from the brand; no dispatch names an address. For a setup it sends only a digest of the emulated upstream origin it holds, never the origin, and only the setup apply step receives the upstream key, which travels inside the signed body and nowhere else. Its outputs, summary and logs carry the encrypted plan, counts, checksums, statuses and the server's closed refusal words, and name the pool app and its accounts only by domain-separated digests, because anyone signed in can read a run's files; a later run reads the ids by a signed verify of its own. A run keeps only the answer's named fields, each in its own shape. Its tests walk every kept file and printed line and assert that no id, host, address, key or origin appears in any of them."
      metadata { code "scripts/acceptance-pool|.github/workflows/acceptance-pool.yml" }
    }
  }
  basalt.acceptancePool -[sync]-> basalt.router "send a signed acceptance-pool operation to the target origin"
  basalt.acceptancePool -[sync]-> basalt.toolsGateway "plan, apply and verify the acceptance pool's setup and teardown"
  basalt.acceptancePool -[sync]-> repositoryApi "verify the completed dry-run dispatch an apply names"
  basalt.acceptancePool -[sync]-> basalt.brandConfig "read the production host"
  basalt.acceptancePool -[sync]-> basalt.modelGateway "sign the operation with the pool's envelope format and key"
}
