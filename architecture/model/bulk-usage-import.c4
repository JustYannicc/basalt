model {
  extend basalt {
    bulkUsageImport = actor "Bulk usage import" {
      #basalt #v1 #deep
      description "One EU job owns immutable metadata chunks, exact manifest approval and resumable progress. Each bounded chunk requires fresh owner admission and an external load guard. Mapped Home targets stay locked through the atomic history-and-receipt commit; a scoped fingerprint reuses mapping validation only after a fresh eligibility read. One transaction-level advisory lock admits a bulk writer without changing live capture or legacy import identity."
      metadata {
        code "src/pool/model-history/bulk-contract.ts|src/pool/model-history/bulk-do.worker.ts|src/pool/model-history/bulk-job.ts|src/pool/model-history/bulk-parser.ts|src/pool/model-history/bulk-progress.ts|src/pool/model-history/bulk-schema.ts|src/pool/model-history/bulk-store.ts"
        jurisdiction "eu"
        resources "resource-39aaf5da0aa90abe20204d4834f474ea6149d8da965638f3e4af78e068b32120"
        bindings "TOOLS_SERVICE=basalt.toolsGateway|UsageImportArtifacts=basalt.usageImportArtifacts|POOL_AUTH_DATABASE=databaseService"
      }
    }
    usageImportArtifacts = store "Usage import artifacts" {
      #basalt #v1
      description "Immutable metadata-only NDJSON chunks in EU record storage. Each chunk has an approved byte digest, exact-ID digest and row count, with at most 5,000 rows and 8 MiB. Upload is separate from approval. The accepted original manifest and metadata remain the operator's recovery inputs."
      metadata { jurisdiction "eu"; resources "resource-8b145eda56e5de69b2bb9265850f96752fc533d6a24710194156854acecfc701" }
    }
    usageBulkImportClient = adapter "Bulk usage import client" {
      #basalt
      description "Rechecks the accepted original page hashes, stable request IDs, source file and private account map before writing a descriptor. Uses the recorded owner's session for staged upload, exact digest approval, guard updates and explicit pause/resume. Private fsynced receipts record requests before dispatch and verified responses afterward; an uncertain response stops without automatic mutation retry. Guard files come from an external observer, expire within ninety seconds and never supply authority."
      metadata { code "scripts/import-cpamp-bulk.ts|scripts/usage-import-bulk.ts"; bindings "globalThis=basalt.toolsGateway" }
    }
  }

  basalt.modelGateway -[sync]-> basalt.bulkUsageImport "route signed bulk commands to the EU job without waking the pool controller"
  basalt.bulkUsageImport -[sync]-> basalt.modelGateway "reuse exact history parsing, signed envelopes, database sessions and durable chunk storage"
  basalt.bulkUsageImport -[sync]-> basalt.toolsGateway "TOOLS_SERVICE: fresh signed owner admission before every chunk; host transaction ends before reply"
  basalt.bulkUsageImport -[sync]-> basalt.usageImportArtifacts "store and reload immutable metadata chunks"
  basalt.bulkUsageImport -[sync]-> basalt.poolDatabase "lock mapped Home targets; atomically commit history and additive v6 job/receipt rows"
  basalt.bulkUsageImport -[sync]-> databaseService "POOL_AUTH_DATABASE: bounded pool transactions through Hyperdrive"
  basalt.usageBulkImportClient -[sync]-> basalt.toolsGateway "ordinary owner-session bulk import HTTP route"
  basalt.usageBulkImportClient -[sync]-> basalt.bulkUsageImport "reuse descriptor, chunk, guard and parser contracts"
  basalt.usageBulkImportClient -[sync]-> basalt.modelGateway "derive the same source-scoped history IDs and immutable record contents"
  basalt.usageBulkImportClient -[sync]-> basalt.usageImportClient "recheck accepted pages and file hashes"
  basalt.usageBulkImportClient -[sync]-> basalt.usageExportClient "validate target origin and private owner credential file"
  basalt.build -[sync]-> basalt.bulkUsageImport "verify bounded chunks, atomic receipts and real durable-job recovery"
  basalt.build -[sync]-> basalt.usageBulkImportClient "verify accepted-manifest reuse and explicit operator recovery"
  basalt.deployment -[sync]-> basalt.bulkUsageImport "declare dedicated job actor in the existing pool Worker"
  basalt.deployment -[sync]-> basalt.usageImportArtifacts "provision retained EU chunk storage"
}
