model {
  extend basalt {
    bulkUsageImport = actor "Bulk usage import" {
      #basalt #v1 #deep
      description "One reserved bulk-usage-import:<job> object of the existing Artifacts coordinator class owns immutable metadata chunks, exact manifest approval and resumable progress. SQL batches start at 500 rows and adapt toward 500 milliseconds between 100 and 5,000 rows, with persisted pacing and atomic subrange receipts. CPU at least 70 percent throttles until below 60; two minutes at least 90 percent or database errors stop for operator attention. Release and backup windows pause new batches. Serving telemetry is optional until configured, then binding with frozen per-route and stream-mode baselines, sample counts and thresholds. Genuine model completions and serving-dependency observations remain distinct; stale or failed configured reads pause without substituting control durations. Each bounded chunk requires fresh owner admission and an external load guard. Mapped Home targets stay locked through the atomic history-and-receipt commit; a scoped fingerprint reuses mapping validation only after a fresh eligibility read. One transaction-level advisory lock admits a bulk writer without changing live capture or legacy import identity."
      metadata {
        code "src/pool/model-history/bulk-contract.ts|src/pool/model-history/bulk-load.ts|src/pool/model-history/bulk-serving.ts|src/pool/model-history/bulk-serving-contract.ts|src/pool/model-history/bulk-do.worker.ts|src/pool/model-history/bulk-coordinator.ts|src/pool/model-history/bulk-job.ts|src/pool/model-history/bulk-parser.ts|src/pool/model-history/bulk-progress.ts|src/pool/model-history/bulk-schema.ts|src/pool/model-history/bulk-store.ts"
        jurisdiction "eu"
        bindings "TOOLS_SERVICE=basalt.toolsGateway|UsageImportArtifacts=basalt.usageImportArtifacts|POOL_AUTH_DATABASE=databaseService"
      }
    }
    usageImportArtifacts = store "Usage import chunks" {
      #basalt #v1
      description "The usage-import-v1/ prefix in the retained vault attachment bucket holds immutable NDJSON chunks contain only validated scalar metadata. Each chunk has an approved byte digest, exact-ID digest and row count, with at most 5,000 rows and 8 MiB. Upload is separate from approval. The accepted original manifest and metadata remain the operator's recovery inputs."
      metadata { jurisdiction "eu" }
    }
    usageBulkImportClient = adapter "Bulk usage import client" {
      #basalt
      description "Rechecks the accepted original page hashes, stable request IDs, source file and private account map before writing a descriptor. Uses the recorded owner's session for staged upload, exact digest approval, guard updates and explicit pause/resume. Private fsynced receipts record requests before dispatch and verified responses afterward; an uncertain response stops without automatic mutation retry. Guard files come from an external observer, expire within ninety seconds and never supply authority."
      metadata { code "scripts/bulk-cli-input.ts|scripts/bulk-cli-protocol.ts|scripts/import-cpamp-bulk.ts|scripts/usage-import-bulk.ts"; bindings "globalThis=basalt.toolsGateway" }
    }
  }

  basalt.modelGateway -[sync]-> basalt.bulkUsageImport "forward signed bulk commands through a foreign binding to the existing Artifacts coordinator class; refuse as not provisioned while unbound"
  basalt.bulkUsageImport -[sync]-> basalt.modelGateway "reuse exact history parsing, signed envelopes, database sessions and durable chunk storage"
  basalt.bulkUsageImport -[sync]-> basalt.toolsGateway "TOOLS_SERVICE: fresh signed owner admission before every chunk; host transaction ends before reply"
  basalt.bulkUsageImport -[sync]-> basalt.usageImportArtifacts "store and reload only usage-import-v1/<job>/ keys, disjoint from every vault-<app>/ operation"
  basalt.usageImportArtifacts -[sync]-> basalt.vaultRecords "reuse retained EU storage without a new bucket or lifecycle change"
  basalt.bulkUsageImport -[sync]-> basalt.poolDatabase "lock mapped Home targets; atomically commit history and additive v6 job/receipt rows"
  basalt.bulkUsageImport -[sync]-> databaseService "POOL_AUTH_DATABASE: bounded pool transactions through Hyperdrive"
  basalt.usageBulkImportClient -[sync]-> basalt.toolsGateway "ordinary owner-session bulk import HTTP route"
  basalt.usageBulkImportClient -[sync]-> basalt.bulkUsageImport "reuse descriptor, chunk, guard and parser contracts"
  basalt.usageBulkImportClient -[sync]-> basalt.modelGateway "derive the same source-scoped history IDs and immutable record contents"
  basalt.usageBulkImportClient -[sync]-> basalt.usageImportClient "recheck accepted pages and file hashes"
  basalt.usageBulkImportClient -[sync]-> basalt.usageExportClient "validate target origin and private owner credential file"
  basalt.build -[sync]-> basalt.bulkUsageImport "verify bounded chunks, atomic receipts and real durable-job recovery"
  basalt.build -[sync]-> basalt.usageBulkImportClient "verify accepted-manifest reuse and explicit operator recovery"
}
