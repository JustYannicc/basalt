model {
  extend basalt.toolsGateway {
    cloudDrive = part "App cloud drives" {
      description "Each app has an isolated cloud drive. Its storage engine is a vendored source snapshot, built with the pinned compiler and separate dependencies. Git writer branches preserve conflicting edits and operation receipts distinguish saved branches from landed main. Each vault's text and history live in its own fork, which a single vault object writes; that object keeps a clone it rebuilds by streaming the fork's packs into its own storage with bounded memory, and attachment bytes stay in retained record storage. The clone indexes every object its trees name and reads a missing blob from the fork only when a tree names it, so writing new objects costs no fork reads. Earlier vaults kept packs in record storage and migrate with identical commit ids. The vault object serves per-note history from its clone, with each commit's server-written time, and records each device grant's last sync and the head it saw. An account ledger admits logical bytes, physical storage and I/O before work; the default monthly allowance of 100,000 metered writes and 1,000,000 metered reads guards against runaway use and is sized so heavy daily vault editing never reaches it. Initial imports declare bounded manifest pages and reserve a separate counted cost allowance; serialized operation scopes prevent other writes borrowing it. Content-addressed attachment parts survive unknown replies and accepted bytes never expire. Exhaustion names the exact resource and never prunes accepted history. Agent writes use native approval and active workflow authority. Protocol 38 carries bounded batches and quota failures across the installed framework transport."
      metadata {
        code "src/drive|apps/obsidian"
        libraries "effect|apps|buffer|isomorphic-git|sha.js"
        constraint "The Obsidian app is installed from the public catalog. Its release-owned source snapshot must match the shipped app files and declare the served framework. Catalog registration and the source endpoint ship together."
      }
    }
    obsidianSync = part "Obsidian Sync" {
      description "A thin plugin connects through a browser-created app-scoped connection and device authorization. Credentials stay in Obsidian's secure storage. Local queues and exact receipts resume initial imports and offline edits. The Mac mirrors all content with bounded desktop file reads. Phones fetch note attachments on opening or pinning and evict only verified local copies. Journaled publication preserves changed local bytes and conflicting branches remain reviewable. The plugin ships as main.js, manifest.json and styles.css only, so standard Obsidian installers carry all of it. The desktop reader is bundled into main.js behind a lazy require that only desktop runs; the build loads main.js with every Node built-in failing to prove phones never evaluate it. Each manifest version is published once as a signalbox-sync-<version> source repository release that is never Latest, and a changed build under a published version fails the release. Actual iPhone resource-range and file publication behavior still need device proof."
      metadata {
        code "clients/obsidian|.github/workflows/obsidian-plugin-release.yml"
        libraries "obsidian"
        constraint "Sync follows Git, not a timer. File events only mark the working tree dirty. One checkpoint commits every dirty path, deletes included, from one base and pushes it: after about three idle minutes, when Obsidian is hidden, or on Sync now. Remote checks are fetches every five minutes, on opening a note and on return, and never commit. A file keeps an older base only while its local edit outlived a cloud edit, so that commit merges instead of overwriting. Listed text formats up to 1 MiB that decode as UTF-8 without NUL bytes are Git text; everything else, including larger text, goes behind an attachment pointer."
      }
    }
  }
  extend basalt.toolsGateway {
    obsidianVaultPage = part "Obsidian vault page" {
      description "The Obsidian app's own screen shows a synced vault read-only: its state, a folder tree loaded folder by folder, search, notes and each note's dated versions. It reads only the app's drive tools, so whatever a plugin already synced renders without a plugin update. It claims up to date only when every recorded sync holds the drive's head; reads a server or plugin does not have yet degrade to less detail, never to an empty or connect state. Notes render as Obsidian-flavoured Markdown with the dashboard's renderer, raw HTML skipped, wikilinks resolved by Obsidian's shortest-path rule and image embeds read from the vault."
      metadata {
        code "apps/obsidian/ui"
        libraries "react|react-dom|react-markdown|remark-gfm|@flowershow/remark-wiki-link|@r4ai/remark-callout|apps"
        constraint "A vault that has synced never shows the never-synced state: only no import, no files and no history does. Per-note history counts only when the server dates its versions; otherwise the page says versions appear after the next update."
      }
    }
  }
  basalt.toolsGateway.obsidianVaultPage -> basalt.toolsGateway.cloudDrive "Reads notes, versions and import state"
  extend basalt.build {
    cloudDriveProof = part "Cloud drive verification" {
      description "Synthetic installed-app proofs use the ordinary HTTP, MCP, native approval and workflow paths. Seeded large-vault proofs use real local workerd, SQLite and record storage, verify complete cold coverage and retained history, enforce disk bounds and delete their own bulk data after exporting hashes. Local proofs do not establish hosted adoption or device compatibility."
      metadata {
        code "e2e/obsidian"
        libraries "effect|apps|@effect/platform-node|fumadb-effect|esbuild|miniflare|@modelcontextprotocol/sdk"
        endpointHosts "127.0.0.1|fixture.invalid|volume.invalid"
      }
    }
  }
  basalt.build.cloudDriveProof -> basalt.toolsGateway.cloudDrive "Verifies cloud storage and recovery"
  basalt.build.cloudDriveProof -> basalt.toolsGateway "Verifies installed app transports"
  basalt.build.cloudDriveProof -> basalt.toolsGateway.obsidianSync "Verifies the public plugin transport"
  basalt.toolsGateway.obsidianSync -> basalt.toolsGateway.cloudDrive "Syncs manifest entries and pinned revisions"
  basalt.toolsGateway.obsidianSync -[sync]-> repositoryApi "publish each plugin version once as a release"
  basalt.toolsGateway.obsidianSync -[sync]-> packageSource "download the pinned bundler"
}
