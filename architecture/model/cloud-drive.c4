model {
  extend basalt.toolsGateway {
    cloudDrive = part "App cloud drives" {
      description "Each app has an isolated cloud drive. Its storage engine is a vendored source snapshot, built with the pinned compiler and separate dependencies. Git writer branches preserve conflicting edits and operation receipts distinguish saved branches from landed main. Each vault's text and history live in its own fork, which a single vault object writes; that object keeps a rebuildable clone, and attachment bytes stay in retained record storage. Earlier vaults kept packs in record storage and migrate with identical commit ids. An account ledger admits logical bytes, physical storage and I/O before work; the default monthly allowance of 100,000 metered writes and 1,000,000 metered reads guards against runaway use and is sized so heavy daily vault editing never reaches it. Initial imports declare bounded manifest pages and reserve a separate counted cost allowance; serialized operation scopes prevent other writes borrowing it. Content-addressed attachment parts survive unknown replies and accepted bytes never expire. Exhaustion names the exact resource and never prunes accepted history. Agent writes use native approval and active workflow authority. Protocol 38 carries bounded batches and quota failures across the installed framework transport."
      metadata {
        code "src/drive|apps/obsidian"
        libraries "effect|apps|buffer|isomorphic-git|sha.js"
        constraint "The Obsidian app is installed from the public catalog. Its release-owned source snapshot must match the shipped app files and declare the served framework. Catalog registration and the source endpoint ship together."
      }
    }
    obsidianSync = part "Obsidian Sync" {
      description "A thin plugin connects through a browser-created app-scoped connection and device authorization. Credentials stay in Obsidian's secure storage. Local queues and exact receipts resume initial imports and offline edits. The Mac mirrors all content with bounded desktop file reads. Phones fetch note attachments on opening or pinning and evict only verified local copies. Journaled publication preserves changed local bytes and conflicting branches remain reviewable. The plugin ships as main.js, manifest.json and styles.css only, so standard Obsidian installers carry all of it. The desktop reader is bundled into main.js behind a lazy require that only desktop runs; the build loads main.js with every Node built-in failing to prove phones never evaluate it. Each manifest version is published once as a basalt-sync-<version> source repository release that is never Latest, and a changed build under a published version fails the release. Actual iPhone resource-range and file publication behavior still need device proof."
      metadata {
        code "clients/obsidian|.github/workflows/obsidian-plugin-release.yml"
        libraries "obsidian"
      }
    }
  }
  extend basalt.build {
    cloudDriveProof = part "Cloud drive verification" {
      description "Synthetic installed-app proofs use the ordinary HTTP, MCP, native approval and workflow paths. Seeded large-vault proofs use real local workerd, SQLite and record storage, verify complete cold coverage and retained history, enforce disk bounds and delete their own bulk data after exporting hashes. Local proofs do not establish hosted adoption or device compatibility."
      metadata {
        code "e2e/obsidian"
        libraries "effect|apps|@effect/platform-node|fumadb-effect|esbuild|miniflare|@modelcontextprotocol/sdk"
        endpointHosts "127.0.0.1|fixture.invalid|volume.invalid"
      }
    }
  }
  basalt.build.cloudDriveProof -> basalt.toolsGateway.cloudDrive "Verifies cloud storage and recovery"
  basalt.build.cloudDriveProof -> basalt.toolsGateway "Verifies installed app transports"
  basalt.build.cloudDriveProof -> basalt.toolsGateway.obsidianSync "Verifies the public plugin transport"
  basalt.toolsGateway.obsidianSync -> basalt.toolsGateway.cloudDrive "Syncs manifest entries and pinned revisions"
  basalt.toolsGateway.obsidianSync -[sync]-> repositoryApi "publish each plugin version once as a release"
  basalt.toolsGateway.obsidianSync -[sync]-> packageSource "download the pinned bundler"
}
