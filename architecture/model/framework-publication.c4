model {
  extend basalt.toolsGateway {
    frameworkPublication = part "Framework publication identity" {
      description "Published framework manifests bind the protocol, server and browser bytes to reviewed source identity. Build verification compares the actual publication with approved releases. Its native proof compiles authored source through the production WASM compiler in workerd, writes and loads retained formats one and two, and admits remote declarations and cold and warm calls. The real SQLite data facet retains accepted caller writes and refuses altered lineage before authored effects."
      metadata { code ".upstream/packages/sdk/src/contracts/worker-build.ts|.upstream/packages/sdk/src/implementation/framework-identity.ts|.upstream/packages/sdk/src/implementation/basalt-framework-releases.ts" }
    }
  }
  basalt.build -[sync]-> basalt.toolsGateway.frameworkPublication "verify the published framework against approved identities"
}
