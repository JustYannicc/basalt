model {
  extend basalt {
    build = module "Build" {
      // Pool recipes serve signed revision assertions through the production change handler
      // before pool-token routes, reading committed heads from transactional fixture storage.
      // Pool container fixtures select a separately locked stable runtime binary before loading the emulator.
