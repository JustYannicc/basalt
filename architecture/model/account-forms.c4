model {
  extend basalt.toolsGateway {
    accountForms = part "Account forms" {
      description "The active sign-in method owns its fields and errors. Blocked alternatives sit below that form in a collapsed Other sign-in methods disclosure, keep their reasons when expanded and never repeat the selected method's refusal. Client-credentials setup uses method-specific key guidance in place of generic client-registration instructions. Its form distinguishes the token exchange destination from the app’s access-token hosts."
      metadata { code ".upstream/packages/ui/src/implementation/dashboard/account-form.tsx" }
    }
  }
}
