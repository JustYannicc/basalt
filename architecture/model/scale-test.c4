model {
  extend basalt {
    scaleTest = module "Isolated pool scale test" {
      #basalt
      description "A manually dispatched test owns one temporary stage, synthetic traffic, its time and cost limits, and verified cleanup. Provisioning keeps state on its own runner. Size changes and deletion use only issue-scoped resources; production state and runtime are outside this boundary. An independent load-evidence gate requires complete raw traffic, latency, persistence and cleanup records. Deploy and destroy never pass this gate; single-instance measurements never claim autoscaling."
      metadata {
        constraint "A scratch readiness hold always reads the real container port first, retains each positive body, boot and launch witness, then suppresses that result while the exact runtime and attempt are held. Release admits only a fresh observation and never replays a stale policy lease. The hold is bounded within the unchanged startup budget and changes no Home database authority. Stage state proof reads the production root, witness and endpoint activity records. Doubled Home ports do not establish real fleet acceptance."
        code "scripts/scale-test|.github/workflows/scale-test.yml"
        libraries "asyncio|ssl|resource"
        bindings "real=basalt.scaleStage.runtime|stageClient=basalt.scaleStage|globalThis=basalt.scaleStage|stub(this.env.Mock)=basalt.scaleStage.fixtures|super=basalt.scaleStage.controller|this.ctx.container!.getTcpPort=basalt.scaleStage.runtime|c.getTcpPort=basalt.scaleStage.fixtures|stub(env.PoolContainer)=basalt.scaleStage.controller|target=basalt.scaleStage.fixtures"
      }
    }
    scaleStage = adapter "Isolated scale stage" {
      #external
      metadata { hosts "workers.dev" }
      controller = actor "Test pool controller"
      runtime = adapter "Test pool runtime"
      fixtures = adapter "Synthetic provider and load generator" {
        metadata { endpointHosts "scale-mock.invalid|fixture" }
      }
    }
  }
  frozenScaleCandidate = adapter "Pinned test source" {
    #external
    metadata { sdks "@basalt-scale/candidate" }
  }
  basalt.scaleTest -[sync]-> basalt.modelGateway "observe production lifecycle and durable state through the scratch container adapter"
  basalt.scaleTest -[sync]-> basalt.scaleStage "call only the validated test gateway"
  basalt.scaleTest -[sync]-> basalt.scaleStage.controller "wrap the pinned controller with test control operations"
  basalt.scaleTest -[sync]-> basalt.scaleStage.runtime "sample processes, readiness and direct database usage"
  basalt.scaleTest -[sync]-> basalt.scaleStage.fixtures "route synthetic provider requests and drive measured load"
  basalt.scaleTest -[sync]-> frozenScaleCandidate "use the immutable gateway source and database contract"
  basalt.scaleTest -[sync]-> deploymentProvider "provision, resize and remove only isolated test resources"
  basalt.scaleTest -[sync]-> databaseProvider "create and remove only the temporary test database"
  basalt.scaleTest -[sync]-> databaseService "read usage and authenticate against the isolated test database"
  basalt.scaleTest -[sync]-> repositoryApi "download workflow actions and pinned source"
}
