model {
  extend basalt {
    observationStoreProvisioning = module "Observation store provisioning" {
      #basalt #deep
      description "The serialized provisioning lane records one existing account store in native state after a separately approved read-only plan. The plan freezes its account, identity, declaration, SDK and absent-row digests. Missing stores refuse without creation. Standard adoption preserves other resource rows, the deployed stack output and recovery history; completion requires native readback, a no-op replan and unchanged release admission. A separately approved journal restore authenticates the original successful workflow artifact, archives its completed provisioning head and restores only a completed previous head accepted by the frozen release reader. Native resource state and the original adoption receipt never change."
      metadata {
        code "scripts/release-barrier/observation-store-apply.ts|scripts/release-barrier/observation-store-contract.ts|scripts/release-barrier/observation-store-envelope.ts|scripts/release-barrier/observation-store-plan.ts|scripts/release-barrier/observation-store-stack.ts|scripts/release-barrier/observation-store-state.ts|scripts/release-barrier/observation-store-wire.ts|scripts/release-barrier/journal-restore.ts|scripts/release-barrier/journal-restore-contract.ts|scripts/release-barrier/journal-restore-proof.ts|scripts/release-barrier/b102-journal-reader.ts|scripts/release-barrier/restore-preparation-probe.ts"
        libraries "alchemy"
        constraint "State authentication alone may create the bounded ephemeral preview needed to read its existing credential. The exact account-bound session GET and State script preview POST are counted and logged; their exception closes before planning. Artifact reads preserve explicit manual redirects to inspect the signed location without forwarding repository credentials; automatic redirects remain forbidden. A credential-free CI preparation probe verifies the real immutable artifact under that guard and denies all State or cloud account access. A global transport guard refuses every other cloud account mutation throughout the operation, and the provider guard independently admits only store-list reads. Receipts distinguish the actual auth-preview POST count from zero other cloud account mutations. An auth violation prevents planning; uncertain adoption cannot replay. Restore refuses before external access unless the source run matches its maintainer-controlled workflow variable. Restore plans freeze both encrypted head digests, native state, the immutable source receipt and the pinned compatibility decoder. Apply archives before restoring under the same production writer; an existing or uncertain archive requires inspection. Release probes project explicit v1 forward and v2 provisioning headers without exposing ciphertext and reject unknown versions."
      }
    }
  }
  basalt.deployment -[sync]-> basalt.observationStoreProvisioning "run the approved plan or native adoption under the production writer lock"
  basalt.observationStoreProvisioning -[sync]-> basalt.deployment "retain the provisioning journal and require unchanged release admission"
  basalt.observationStoreProvisioning -[sync]-> basalt.modelGateway "reuse the shared retained account store declaration"
  basalt.observationStoreProvisioning -[sync]-> basalt.toolsGateway "reuse the hosted native State storage configuration"
  basalt.observationStoreProvisioning -[sync]-> repositoryApi "verify the immutable successful adoption run and checksum-bound receipt archive"
  basalt.observationStoreProvisioning -[sync]-> deploymentProvider "authenticate State and observe the existing account store"
}
