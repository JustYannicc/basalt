model {
  extend basalt.pool {
    metadata {
      constraint "The shipped allowance seed is a fallback. A source's seed rows count only while that source has no stored state or is unavailable, so a renewed seed changes no decision for a pool whose sources answer; while a source is down, the renewal's newer rows decide with the same size and revision. Rows without a refreshing source, such as pool policy, always count. Allowance tests own their seed fixtures and never read the shipped seed."
    }
  }
}
