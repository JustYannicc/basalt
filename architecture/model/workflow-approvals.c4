model {
  extend basalt.toolsGateway {
    ownerApprovalPolicies = part "Owner approval policies" {
      description "Hosted owners choose app, tool or account rules with optional exact workflow and decoded-input constraints. The imported JSON meta-schema is decoded through the shared JSON contract before validation, preserving the same type boundary under root and upstream compiler settings. The host supplies stored runtime workflow identity rather than reading it from app input. Saved dependency calls provide that captured identity around normal target dispatch. The native host applies them after app approval and decoding on ordinary calls and workflow operations. A matched ask is terminal; no match alone falls through to workflow confirmation. An approved general rule still passes through the shared dispatcher's effect receipt gate. Browser writes require app management for unrestricted rules or account management plus app use for account-restricted rules, and call-time evaluation checks the rule author's current authority and personal-account ownership. Hosted migration 16 and Cloud migration 10 add only policy and immutable history tables. Policy changes and encrypted confirmation installation, replacement or clearing append history in the same SQL transaction; failed audit writes roll back both. Confirmation revocation locks and compares the encrypted payload fingerprint so an old view cannot clear a replacement."
      metadata { code ".upstream/packages/sdk/src/implementation/tool-policy.ts|.upstream/apps/hosted/server/src/implementation/tool-policies.ts|.upstream/apps/hosted/server/src/implementation/tool-policy-evaluation.ts|.upstream/apps/hosted/server/src/implementation/workflow-confirmations.ts|.upstream/apps/hosted/server/src/implementation/tool-policy-schema.ts|.upstream/apps/hosted/web/src/implementation/pages/tool-policies.tsx" }
    }
    workflowApprovals = part "Workflow approval evaluation" {
      description "The host adapts consumed configure approvals and postdecoded target asks to one policy. Confirmation must include the exact workflow step, target, account and recipient in the actual approval input. Self-host and Cloud resolve the current verified personal owner and recognize the full inspected structured sender source. Current configuration, versions, runtime workflow identity and saved credential generations must still match at dispatch. With no general owner rule, ordinary calls retain their asks. App denial and callback failure remain authoritative. Mutation execution remains gated until the shared dispatcher proves its durable receipt path."
      metadata { code ".upstream/packages/sdk/src/implementation/workflow-approval.ts|.upstream/packages/sdk/src/implementation/workflow-email-envelope.ts|.upstream/packages/sdk/src/implementation/workflow-approval-hooks.ts|.upstream/apps/hosted/server/src/implementation/workflow-app-approvals.ts" }
    }
  }
}
