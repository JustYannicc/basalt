model {
  extend basalt.toolsGateway {
    workflowApprovals = part "Workflow approval evaluation" {
      description "The host adapts consumed configure approvals and postdecoded target asks to one policy. Confirmation must include the exact workflow step, target, account and recipient in the actual approval input. Self-host and Cloud resolve the current verified personal owner and recognize the full inspected structured sender source. Current configuration, versions, runtime workflow identity and saved credential generations must still match at dispatch. Ordinary calls retain their asks; app denial and callback failure remain authoritative. Mutation execution remains gated until the shared dispatcher proves its durable receipt path."
      metadata { code ".upstream/packages/sdk/src/implementation/workflow-approval.ts|.upstream/packages/sdk/src/implementation/workflow-email-envelope.ts|.upstream/packages/sdk/src/implementation/workflow-approval-hooks.ts|.upstream/apps/hosted/server/src/implementation/workflow-app-approvals.ts" }
    }
  }
}
