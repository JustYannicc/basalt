model {
  extend basalt.toolsGateway {
    appUiKit = part "App UI kit" {
      description "App pages build the dashboard's own controls, tokens, provider marks and selected-account identity and health through the served framework's public `apps/ui` and `apps/ui.css`. The dashboard and app pages render the same implementation; no app keeps a copied kit. One exception: the pool overview's lab marks stay pool-local (the provider app's icon, then the approved mock's logo, then an initial) until the kit's provider mark can draw images (#1140)."
      metadata { code ".upstream/packages/apps/src/ui.tsx|.upstream/packages/ui/src/implementation/styles/app.css" }
    }
  }
}
