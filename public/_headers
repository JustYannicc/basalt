# Pool pages load the dashboard's fonts from here, across origins.
/brand/fonts/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400
# The public site's type and art. Regenerated under the same names, so a day, not immutable.
/brand/serif/*
  Cache-Control: public, max-age=86400
/brand/hero/*
  Cache-Control: public, max-age=86400
# Captures of assistants' own dialogs, shown in the Connect guides.
/brand/assistants/*
  Cache-Control: public, max-age=86400
# Reviewed API documents use their exact SHA-256 as the filename.
/catalog/openapi/atlassian/*
  Access-Control-Allow-Origin: *
  Content-Type: application/json; charset=utf-8
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=31536000, immutable
