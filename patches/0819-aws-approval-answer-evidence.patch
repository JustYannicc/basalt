diff --git a/e2e/support/answer-evidence.ts b/e2e/support/answer-evidence.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/answer-evidence.ts
@@ -0,0 +1,15 @@
+/**
+ * An app's answer as public evidence may keep it: its whole shape, with numbers, flags and words
+ * as they are, and any string carrying a link or a token-like run replaced, since evidence is
+ * uploaded where anyone can read it.
+ */
+export const answerEvidence = (value: unknown): unknown =>
+  Array.isArray(value)
+    ? value.map(answerEvidence)
+    : value !== null && typeof value === "object"
+      ? Object.fromEntries(
+          Object.entries(value).map(([key, entry]) => [key, answerEvidence(entry)]),
+        )
+      : typeof value === "string" && (value.includes("://") || /[\w.+/=-]{20,}/u.test(value))
+        ? "[cut]"
+        : value;
