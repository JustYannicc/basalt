index 00000000..0b734dbd
--- /dev/null
+++ b/packages/apps/src/implementation/app-calls.ts
@@ -0,0 +1,33 @@
+import { Effect, Schema } from "effect";
+import {
+  AppCallCommand,
+  AppCallFailed,
+  type AppCalls,
+  type AppCallHost,
+  type DeclaredAppDependencies,
+} from "../contracts/app-calls.ts";
+/** Only the declaration and the host capability can admit a call; authored fields grant nothing. */
+export const authorAppCalls = (
+  declarations: DeclaredAppDependencies | undefined,
+  host: AppCallHost | undefined,
+  signal: AbortSignal,
+): AppCalls => ({
+  call: (input) =>
+    Effect.runPromise(
+      Effect.gen(function* () {
+        const command = yield* Schema.decodeUnknownEffect(AppCallCommand)(
+          { operation: "app-call", ...input },
+          { onExcessProperty: "error" },
+        ).pipe(
+          Effect.mapError(() => new AppCallFailed({ retryable: false, reason: "invalid_input" })),
+        );
+        const declared = declarations?.[command.connection]?.tools[command.tool];
+        if (declared === undefined || declared.kind !== command.kind)
+          return yield* new AppCallFailed({ retryable: false, reason: "denied" });
+        if (host === undefined)
+          return yield* new AppCallFailed({ retryable: false, reason: "connection_missing" });
+        return yield* host(command);
+      }),
+      { signal },
+    ),
+});
