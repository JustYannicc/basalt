+++ b/packages/sdk/src/implementation/app-connections.ts
@@ -0,0 +1,197 @@
+import { Clock, type Crypto, Effect, Redacted, Schema } from "effect";
+import { AppDependency } from "apps/contracts";
+import { CurrentActor, type ResourceLifecycle } from "../contracts/executor.ts";
+import {
+  AppConnection,
+  AppConnectionId,
+  AppConnectionPayload,
+  AppConnectionConflict,
+  AppConnectionRefused,
+  type AppConnectionIdentity,
+  type AppConnections,
+} from "../contracts/app-calls.ts";
+import { JsonObject, StorageError, type AppId } from "../contracts/shared.ts";
+import type { Credentials } from "../contracts/storage.ts";
+import { storedApp, storedVersion, lockApp } from "./apps.ts";
+import { query, transaction, type Query } from "./database.ts";
+
+export const makeAppConnections = (
+  db: Query,
+  credentials: Credentials,
+  crypto: Crypto.Crypto,
+  hooks?: ResourceLifecycle,
+) => {
+  const authorize = (input: AppConnectionIdentity & { target?: AppId }, managing: boolean) =>
+    hooks === undefined
+      ? Effect.void
+      : hooks.appConnectionAuthorizing === undefined
+        ? Effect.fail(new AppConnectionRefused())
+        : hooks
+            .appConnectionAuthorizing({ ...input, managing })
+            .pipe(Effect.mapError(() => new AppConnectionRefused()));
+  const find = (app: AppId, dependency: string, subject: string) =>
+    query(() =>
+      db.findFirst("appConnections", {
+        where: (b) =>
+          b.and(b("app", "=", app), b("dependency", "=", dependency), b("subject", "=", subject)),
+      }),
+    );
+  type Row = NonNullable<Effect.Success<ReturnType<typeof find>>>;
+  const view = (row: Row) =>
+    AppConnection.make({
+      id: AppConnectionId.make(row.id),
+      dependency: row.dependency,
+      target: row.target,
+      scope: row.subject === "" ? "app" : "user",
+      revision: row.revision,
+      enabled: row.enabled,
+    });
+  const payload = (row: Row) =>
+    credentials.decrypt(AppConnectionId.make(row.id), Redacted.make(row.encrypted)).pipe(
+      Effect.flatMap((value) =>
+        Schema.decodeUnknownEffect(AppConnectionPayload)(Redacted.value(value)),
+      ),
+      Effect.mapError(() => new StorageError()),
+    );
+  const seal = (id: AppConnectionId, value: typeof AppConnectionPayload.Type) =>
+    Schema.encodeEffect(Schema.toCodecJson(AppConnectionPayload))(value).pipe(
+      Effect.flatMap(Schema.decodeUnknownEffect(JsonObject)),
+      Effect.flatMap((value) => credentials.encrypt(id, Redacted.make(value))),
+      Effect.mapError(() => new StorageError()),
+    );
+  const subject = (scope: "app" | "user") =>
+    Effect.gen(function* () {
+      const actor = yield* CurrentActor;
+      if (scope === "user" && actor === undefined && hooks !== undefined)
+        return yield* new AppConnectionRefused();
+      return scope === "app" ? "" : (actor ?? "local");
+    });
+  const declaration = (input: AppConnectionIdentity) =>
+    Effect.gen(function* () {
+      const app = yield* storedApp(db, input);
+      const version = yield* storedVersion(db, app);
+      const declared = version.requirements.dependencies?.[input.dependency];
+      if (declared?.scope !== input.scope) return yield* new AppConnectionRefused();
+      return yield* Schema.decodeUnknownEffect(AppDependency)(declared).pipe(
+        Effect.mapError(() => new AppConnectionRefused()),
+      );
+    });
+  const current = (input: AppConnectionIdentity & { revision: number }) =>
+    Effect.gen(function* () {
+      yield* lockApp(db, input);
+      yield* authorize(input, true);
+      const row = yield* find(input.app, input.dependency, yield* subject(input.scope));
+      if (row === null || row.owner !== input.owner || row.revision !== input.revision)
+        return yield* new AppConnectionConflict();
+      return row;
+    });
+  const operations: AppConnections = {
+    list: (input) =>
+      Effect.gen(function* () {
+        yield* storedApp(db, input);
+        yield* authorize({ ...input, dependency: "", scope: "user" }, false);
+        const actor = yield* subject("user");
+        const rows = yield* query(() =>
+          db.findMany("appConnections", {
+            where: (b) =>
+              b.and(
+                b("app", "=", input.app),
+                b("owner", "=", input.owner),
+                b.or(b("subject", "=", ""), b("subject", "=", actor)),
+              ),
+          }),
+        );
+        return { connections: rows.map(view) };
+      }).pipe(Effect.catchTag("AppNotFound", () => new AppConnectionRefused())),
+    save: (input) =>
+      transaction(db, () =>
+        Effect.gen(function* () {
+          yield* lockApp(db, input);
+          yield* authorize(input, true);
+          const selected = yield* storedApp(db, { app: input.target, owner: input.owner });
+          yield* authorize({ ...input, target: selected.id }, true);
+          const declared = yield* declaration(input);
+          const actor = yield* subject(input.scope);
+          const old = yield* find(input.app, input.dependency, actor);
+          if ((old?.revision ?? 0) !== input.revision) return yield* new AppConnectionConflict();
+          const id =
+            old === null
+              ? AppConnectionId.make(
+                  `acn_${yield* crypto.randomUUIDv4.pipe(Effect.mapError(() => new StorageError()))}`,
+                )
+              : AppConnectionId.make(old.id);
+          const now = new Date(yield* Clock.currentTimeMillis);
+          const values = {
+            app: input.app,
+            owner: input.owner,
+            dependency: input.dependency,
+            subject: actor,
+            target: selected.id,
+            authorizer: (yield* CurrentActor) ?? "local",
+            revision: input.revision + 1,
+            enabled: true,
+            encrypted: yield* seal(id, {
+              declaration: declared,
+              accounts: input.accounts ?? { app: {}, user: {} },
+            }),
+            updatedAt: now,
+          };
+          if (old === null)
+            yield* query(() => db.create("appConnections", { ...values, id, createdAt: now }));
+          else
+            yield* query(() =>
+              db.updateMany("appConnections", { where: (b) => b("id", "=", id), set: values }),
+            );
+          return view({ ...values, id, createdAt: old?.createdAt ?? now });
+        }),
+      ).pipe(
+        Effect.catchTags({
+          AppNotFound: () => new AppConnectionRefused(),
+          AppNotDeployed: () => new AppConnectionRefused(),
+          VersionNotFound: () => new AppConnectionRefused(),
+        }),
+      ),
+    update: (input) =>
+      transaction(db, () =>
+        Effect.gen(function* () {
+          const old = yield* current(input);
+          const now = new Date(yield* Clock.currentTimeMillis);
+          // Disabling also revokes any host confirmation. Re-enabling requires a fresh confirmation.
+          const data = yield* payload(old);
+          const encrypted = yield* seal(AppConnectionId.make(old.id), {
+            declaration: data.declaration,
+            accounts: data.accounts,
+          });
+          yield* query(() =>
+            db.updateMany("appConnections", {
+              where: (b) => b("id", "=", old.id),
+              set: {
+                revision: old.revision + 1,
+                enabled: input.enabled,
+                encrypted,
+                updatedAt: now,
+              },
+            }),
+          );
+          return view({
+            ...old,
+            revision: old.revision + 1,
+            enabled: input.enabled,
+            encrypted,
+            updatedAt: now,
+          });
+        }),
+      ).pipe(Effect.catchTag("AppNotFound", () => new AppConnectionRefused())),
+    remove: (input) =>
+      transaction(db, () =>
+        Effect.gen(function* () {
+          const old = yield* current(input);
+          yield* query(() =>
+            db.deleteMany("appConnections", { where: (b) => b("id", "=", old.id) }),
+          );
+          return { success: true as const };
+        }),
+      ).pipe(Effect.catchTag("AppNotFound", () => new AppConnectionRefused())),
+  };
+  return { operations, find, payload, seal, view, declaration, authorize };
+};
