+++ b/e2e/tests/app-calls.spec.ts
@@ -0,0 +1,148 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Api, body } from "../support/api.ts";
+import { Actors } from "../support/actors.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Connection = Schema.Struct({
+  id: Schema.String,
+  dependency: Schema.String,
+  target: Schema.String,
+  scope: Schema.Literals(["app", "user"]),
+  revision: Schema.Int,
+  enabled: Schema.Boolean,
+});
+const Connections = Schema.Struct({ connections: Schema.Array(Connection) });
+
+layer(RuntimeLive, { excludeTestServices: true })("App calls", (it) => {
+  it.effect(scenarios.appCallConnections.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api;
+        const actors = yield* Actors;
+        const prefix = `/api/organizations/${actors.organization.id}/apps`;
+        const apps: string[] = [];
+        yield* Effect.addFinalizer(() =>
+          Effect.forEach(apps, (id) => api.request(actors.owner, "DELETE", `${prefix}/${id}`)).pipe(
+            Effect.orDie,
+          ),
+        );
+        const deploy = (name: string, content: string) =>
+          Effect.gen(function* () {
+            const response = yield* api.request(actors.owner, "POST", `${prefix}/deploy`, {
+              name,
+              files: [{ path: "index.ts", content }, appsManifest],
+            });
+            expect(response.status, JSON.stringify(response.body)).toBe(200);
+            const { id } = yield* body(Resource, response);
+            apps.push(id);
+            return id;
+          });
+        const target = yield* deploy(
+          "First target",
+          `import { defineApp, object, query, mutation, string, router } from "apps";
+const ping = query({input: object({message: string()})}, async (_ctx,input) => ({name: "first", message: input.message}));
+const write = mutation({input: object({})}, async () => ({wrote: true}));
+export default defineApp({}, {tools: router({ping,write})});`,
+        );
+        const source = yield* deploy(
+          "Calling app",
+          `import {defineApp, query, object, string, json, router} from "apps";
+const invoke = query({input: object({target: string(), tool: string(), kind: string(), payload: json()})}, async (ctx,input) => ctx.apps.call({connection: "remote", target: input.target, tool: input.tool, kind: input.kind, input: input.payload}));
+export default defineApp({dependencies: {remote: {scope: "user", tools: {ping: {kind: "query"}, write: {kind: "mutation"}}}}}, {tools: router({invoke})});`,
+        );
+        const path = `${prefix}/${source}/connections`;
+        const linked = yield* api.request(actors.owner, "PUT", `${path}/remote`, {
+          scope: "user",
+          target,
+          revision: 0,
+        });
+        expect(linked.status, JSON.stringify(linked.body)).toBe(200);
+        const first = yield* body(Connection, linked);
+        expect(first).toMatchObject({
+          dependency: "remote",
+          target,
+          scope: "user",
+          revision: 1,
+          enabled: true,
+        });
+        const secondTarget = yield* deploy(
+          "Second target",
+          `import {defineApp} from "apps"; export default defineApp({}, {});`,
+        );
+        const call = (
+          targetId = target,
+          tool = "ping",
+          kind = "query",
+          payload: Schema.Json = { message: "hello" },
+        ) =>
+          api.request(actors.owner, "POST", `${prefix}/${source}/tools/call`, {
+            tool: "invoke",
+            kind: "query",
+            input: { target: targetId, tool, kind, payload },
+          });
+        const called = yield* call();
+        expect(called.status, JSON.stringify(called.body)).toBe(200);
+        expect(called.body).toEqual({ name: "first", message: "hello" });
+        const malformed = yield* call(target, "ping", "query", { message: 3 });
+        expect(malformed.status).not.toBe(200);
+        expect((yield* api.request(actors.member, "GET", path)).status).toBe(403);
+        expect(
+          (yield* api.request(actors.member, "PUT", `${path}/remote`, {
+            scope: "user",
+            target,
+            revision: 0,
+          })).status,
+        ).toBe(403);
+        yield* serverControl("restart");
+        expect((yield* call()).body).toEqual({ name: "first", message: "hello" });
+        const wrongTarget = yield* call(secondTarget);
+        expect(wrongTarget.status).not.toBe(200);
+        expect(wrongTarget.body).toMatchObject({
+          failure: { errorName: "AppCallFailed", code: "denied" },
+        });
+        const mutation = yield* call(target, "write", "mutation");
+        expect(mutation.status).not.toBe(200);
+        expect(mutation.body).toMatchObject({
+          failure: { errorName: "AppCallFailed", code: "effects_unavailable" },
+        });
+        const listed = yield* body(Connections, yield* api.request(actors.owner, "GET", path));
+        expect(listed.connections).toEqual([first]);
+        const disabled = yield* api.request(actors.owner, "PATCH", `${path}/remote`, {
+          scope: "user",
+          revision: first.revision,
+          enabled: false,
+        });
+        expect(disabled.status, JSON.stringify(disabled.body)).toBe(200);
+        expect(yield* body(Connection, disabled)).toMatchObject({
+          target,
+          revision: 2,
+          enabled: false,
+        });
+        expect((yield* call()).body).toMatchObject({
+          failure: { errorName: "AppCallFailed", code: "denied" },
+        });
+        expect(
+          (yield* api.request(actors.owner, "PATCH", `${path}/remote`, {
+            scope: "user",
+            revision: 1,
+            enabled: true,
+          })).status,
+        ).toBe(409);
+        expect(
+          (yield* api.request(actors.owner, "DELETE", `${path}/remote?scope=user&revision=2`))
+            .status,
+        ).toBe(200);
+        expect(
+          (yield* body(Connections, yield* api.request(actors.owner, "GET", path))).connections,
+        ).toEqual([]);
+      }),
+    ),
+  );
+});
