diff --git a/e2e/support/app-call-sdk-source.ts b/e2e/support/app-call-sdk-source.ts
new file mode 100644
index 00000000..a8e9340f
--- /dev/null
+++ b/e2e/support/app-call-sdk-source.ts
@@ -0,0 +1,122 @@
+/** Complete public SDK host with retained PostgreSQL storage and a controlled host clock. */
+export const appCallSdkSource = `import * as NodeCrypto from "@effect/platform-node/NodeCrypto";
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import * as Runtime from "@effect/platform-node/NodeRuntime";
+import { nativeRepositories } from "@executor-js/app-source/node";
+import { createExecutor, makeExecutorStorage, executorHandlers, ExecutorApi, OwnerId,
+  AppId, ToolName, AppCallReceiptId, AppCallsHost, CurrentActor, ToolInputs, Json, type Executor } from "@executor-js/sdk/core";
+import { filesystemBlobStore, workerdApps } from "@executor-js/sdk/node";
+import { memoryRegistry } from "@executor-js/sdk/testing";
+import { AppCallFailed } from "apps/contracts";
+import { Clock, Console, Deferred, Effect, Layer, Path, Redacted, Schema } from "effect";
+import { HttpApiBuilder } from "effect/http-api";
+import { FetchHttpClient, HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { pgliteLayer } from "fumadb-effect/pglite";
+import { createServer } from "node:http";
+const input = INPUT;
+const Reserve = Schema.Struct({id: AppCallReceiptId, fingerprint: Schema.String, deadline: Schema.Number});
+const Finish = Schema.Struct({id: AppCallReceiptId, dispatch: Schema.String, result: Schema.optionalKey(Json)});
+Runtime.runMain(Effect.scoped(Effect.gen(function* () {
+  const path = yield* Path.Path;
+  const database = yield* Layer.build(pgliteLayer({dataDir: path.join(input.directory, "postgres")}));
+  const storage = yield* makeExecutorStorage({provider: "postgresql"}).pipe(Effect.provideContext(database));
+  yield* storage.migrate;
+  const secret = Redacted.make("b".repeat(64));
+  const blobs = filesystemBlobStore({directory: path.join(input.directory, "blobs")});
+  const ready = yield* Deferred.make<Executor>();
+  const host = yield* workerdApps({directory: path.join(input.directory, "workerd"), blobs,
+    executor: Deferred.await(ready), npmRegistry: input.npmRegistry, encryptionKey: secret});
+  const owner = OwnerId.make("receipt-host");
+  const workflowObserved = yield* Deferred.make<void>();
+  const workflowEvidence:Array<{message:string;workflow:{run:string;name:string;step:string;stepId:string}|null}> = [];
+  let approvedConfigurations = 0;
+  let protectedChecks = 0;
+  let confirmedChecks = 0;
+  const executor = yield* createExecutor({database: storage, secret, blobs,
+    appCalls:{
+      configurationApproved:event => Effect.gen(function* () {
+        if (event.actor !== "receipt-host" || event.owner !== owner || event.tool !== "configure")
+          return yield* new AppCallFailed({reason:"denied",retryable:false});
+        const output = yield* Schema.decodeUnknownEffect(Schema.Struct({revision:Schema.NonEmptyString}))(event.output).pipe(Effect.orDie);
+        approvedConfigurations++;
+        return {approvedBy:event.actor,attachments:event.connections.map(connection => ({
+          connection:connection.id,revision:connection.revision,configurationRevision:output.revision,
+          value:{fixture:"owner-confirmed"},
+        }))};
+      }),
+      protectedDispatch:event => Effect.gen(function* () {
+        if (event.source.workflow !== undefined) {
+          const decoded = yield* Schema.decodeUnknownEffect(Schema.Struct({message:Schema.String}))(event.decodedInput).pipe(Effect.orDie);
+          workflowEvidence.push({message:decoded.message,workflow:event.source.workflow});
+          if (workflowEvidence.length >= 2) yield* Deferred.succeed(workflowObserved,undefined);
+        }
+        protectedChecks++;
+        if (event.confirmation?.value.fixture === "owner-confirmed") {confirmedChecks++;return "approved" as const;}
+        return "user-approval" as const;
+      }),
+    },
+    git: nativeRepositories(path.join(input.directory, "repositories")), runtime: host.runtime,
+    workflows: host.workflows, registry: memoryRegistry()}).pipe(Effect.provide(NodeCrypto.layer));
+  yield* Deferred.succeed(ready, executor);
+  const listed = yield* executor.apps.list({owner});
+  const app = listed[0] ?? (yield* executor.apps.deploy({owner, name: "Receipt owner",
+    files: input.files})).app;
+  const receipts = executor[AppCallsHost].receipts;
+  let now = 1000;
+  const live = yield* Clock.Clock;
+  const clock: Clock.Clock = {...live, currentTimeMillisUnsafe: () => now,
+    currentTimeMillis: Effect.sync(() => now), currentTimeNanosUnsafe: () => BigInt(now)*1000000n,
+    currentTimeNanos: Effect.sync(() => BigInt(now)*1000000n)};
+  const route = <A, I>(name: string, schema: Schema.Codec<A,I>, run: (value:A) => Effect.Effect<unknown, unknown>) =>
+    HttpRouter.add("POST", \`/_fixture/\${name}\`, Effect.gen(function* () {
+      const request = yield* HttpServerRequest.HttpServerRequest;
+      const value = yield* request.json.pipe(Effect.flatMap(Schema.decodeUnknownEffect(schema)));
+      return yield* run(value).pipe(Effect.provideService(Clock.Clock, clock),Effect.provideService(CurrentActor,"receipt-host"),
+        Effect.flatMap((value) => HttpServerResponse.json(value)),
+        Effect.catchIf(Schema.is(AppCallFailed), (error) => HttpServerResponse.json({reason: error.reason}, {status:409})));
+    }).pipe(Effect.orDie));
+  const configurationSetup = Effect.gen(function* () {
+    const target = (yield* executor.apps.deploy({owner,name:"Protected query target",files:[
+      {path:"index.ts",content:'import {defineApp,query,object,string,router} from "apps"; const guard=query({input:object({message:string()}),approval:()=>"user-approval"},async(_ctx,input)=>input);export default defineApp({},{tools:router({guard})});'},input.files[1],
+    ]})).app;
+    const source = (yield* executor.apps.deploy({owner,name:"Approved configuration source",files:[
+      {path:"index.ts",content:'import {defineApp,query,mutation,object,string,router} from "apps"; const configure=mutation({input:object({revision:string()}),approval:()=>"user-approval"},async(_ctx,input)=>input); const ordinary=mutation({input:object({revision:string()})},async(_ctx,input)=>input); const invoke=query({input:object({target:string(),message:string()})},async(ctx,input)=>ctx.apps.call({connection:"remote",target:input.target,tool:"guard",kind:"query",input:{message:input.message}})); export default defineApp({dependencies:{remote:{scope:"user",configuration:{tool:"configure",policy:{fixture:"owner-confirmed"}},tools:{guard:{kind:"query"}}}}},{tools:router({configure,ordinary,invoke})});'},input.files[1],
+    ]})).app;
+    const connection = yield* executor.appConnections.save({app:source.id,owner,dependency:"remote",scope:"user",target:target.id,revision:0});
+    return {source:source.id,target:target.id,connection:connection.id};
+  });
+  const workflowSetup = Effect.gen(function* () {
+    const target = (yield* executor.apps.deploy({owner,name:"Workflow query target",files:[
+      {path:"index.ts",content:'import {defineApp,query,object,string,router} from "apps"; const guard=query({input:object({message:string()}),approval:()=>"user-approval"},async(_ctx,input)=>input);export default defineApp({},{tools:router({guard})});'},input.files[1],
+    ]})).app;
+    const source = (yield* executor.apps.deploy({owner,name:"Native workflow caller",files:[
+      {path:"index.ts",content:'import {defineApp,query,mutation,workflow,object,string,router} from "apps"; const configure=mutation({input:object({revision:string()}),approval:()=>"user-approval"},async(_ctx,input)=>input); const nested=query({input:object({target:string()})},async(ctx,input)=>ctx.apps.call({connection:"remote",target:input.target,tool:"guard",kind:"query",input:{message:"operation"}})); const prove=workflow({input:object({target:string()})},async(ctx,input)=>{const direct=await ctx.step.do("direct",step=>step.apps.call({connection:"remote",target:input.target,tool:"guard",kind:"query",input:{message:"direct"}}));const operation=await ctx.step.runQuery("operation",nested,input);return {direct,operation};});export default defineApp({dependencies:{remote:{scope:"user",configuration:{tool:"configure",policy:{fixture:"owner-confirmed"}},tools:{guard:{kind:"query"}}}}},{tools:router({configure,nested}),workflows:{prove}});'},input.files[1],
+    ]})).app;
+    const connection = yield* executor.appConnections.save({app:source.id,owner,dependency:"remote",scope:"user",target:target.id,revision:0});
+    return {source:source.id,target:target.id,connection:connection.id};
+  });
+  const configureInput = Schema.Struct({app:AppId,tool:Schema.Literals(["configure","ordinary"]),revision:Schema.String});
+  const queryInput = Schema.Struct({app:AppId,target:AppId});
+  const routes = Layer.mergeAll(
+    HttpApiBuilder.layer(ExecutorApi).pipe(Layer.provide(executorHandlers(executor))),
+    route("configuration/setup", Schema.Null, () => configurationSetup),
+    route("workflow/setup",Schema.Null,() => workflowSetup),
+    route("workflow/start",Schema.Struct({app:AppId,target:AppId}),value => executor.apps.workflowRuns.start({app:value.app,workflow:"prove",input:{target:value.target}})),
+    route("workflow/evidence",Schema.Null,() => Deferred.await(workflowObserved).pipe(Effect.as(workflowEvidence))),
+    route("configuration/configure", configureInput, value => executor.tools.call({app:value.app,tool:ToolName.make(value.tool),kind:"mutation",input:{revision:value.revision}})),
+    route("configuration/resume", ToolInputs.resume, value => executor.tools.resume(value)),
+    route("configuration/call", queryInput, value => executor.tools.call({app:value.app,tool:ToolName.make("invoke"),kind:"query",input:{target:value.target,message:"decoded"}})),
+    route("configuration/counts", Schema.Null, () => Effect.succeed({approvedConfigurations,protectedChecks,confirmedChecks})),
+    route("reserve", Reserve, (value) => receipts.reserve({...value, owner, app: AppId.make(app.id), connection:"saved-connection"})),
+    route("finish", Finish, (value) => receipts.finish({...value, owner, app: AppId.make(app.id)})),
+    route("clock", Schema.Number, (value) => Effect.sync(() => {now=value;return null;})),
+  );
+  const services = yield* Layer.build(HttpRouter.serve(routes, {disableLogger:true, disableListenLog:true})
+    .pipe(Layer.provideMerge(NodeHttpServer.layer(createServer, {host:"127.0.0.1",port:0}))));
+  const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+  if (!("port" in server.address)) return yield* Effect.die("Expected TCP");
+  yield* Console.log(JSON.stringify({port:server.address.port}));
+  return yield* Effect.never;
+})).pipe(Effect.provide(Layer.mergeAll(NodeServices.layer, FetchHttpClient.layer))));
+`;
diff --git a/e2e/support/app-call-sdk.ts b/e2e/support/app-call-sdk.ts
new file mode 100644
index 00000000..f2a37fe5
--- /dev/null
+++ b/e2e/support/app-call-sdk.ts
@@ -0,0 +1,87 @@
+import { Effect, Exit, FileSystem, Option, Path, Schema, Scope, Stream } from "effect";
+import { ChildProcess, ChildProcessSpawner } from "effect/process";
+import { HttpClient, HttpClientRequest } from "effect/http";
+import { appCallSdkSource } from "./app-call-sdk-source.ts";
+import { appsManifest } from "./apps-release.ts";
+import { lockedNpmRegistry } from "./npm-registry.ts";
+import { Target } from "./platform.ts";
+const Ready = Schema.Struct({ port: Schema.Number });
+export const appCallSdk = Effect.gen(function* () {
+  const target = yield* Target;
+  const fs = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const processes = yield* ChildProcessSpawner.ChildProcessSpawner;
+  const client = yield* HttpClient.HttpClient;
+  const registry = yield* lockedNpmRegistry;
+  const entry = path.join(target.directory, "app-call-sdk.ts");
+  const directory = path.join(target.directory, "app-call-sdk");
+  yield* fs.makeDirectory(directory, { recursive: true });
+  yield* fs.writeFileString(
+    entry,
+    appCallSdkSource.replace(
+      "INPUT",
+      JSON.stringify({
+        directory,
+        npmRegistry: registry.url,
+        files: [
+          {
+            path: "index.ts",
+            content: 'import {defineApp} from "apps"; export default defineApp({},{});',
+          },
+          appsManifest,
+        ],
+      }) + " as const",
+    ),
+  );
+  const config = path.join(target.directory, "app-call-sdk-tsconfig.json");
+  yield* fs.writeFileString(
+    config,
+    JSON.stringify({
+      extends: path.resolve("tsconfig.json"),
+      compilerOptions: { typeRoots: [path.resolve("node_modules/@types")] },
+      files: [entry],
+      include: [],
+      exclude: [],
+    }),
+  );
+  const checked = yield* processes.exitCode(
+    ChildProcess.make(path.resolve("node_modules/.bin/tsc-rs"), ["--noEmit", "-p", config], {
+      stdout: "inherit",
+      stderr: "inherit",
+    }),
+  );
+  if (checked !== 0) return yield* Effect.die("Public app-call SDK host failed its typecheck");
+  let childScope = yield* Scope.make();
+  let origin = "";
+  yield* Effect.addFinalizer(() => Scope.close(childScope, Exit.void));
+  const start = Effect.gen(function* () {
+    const child = yield* processes
+      .spawn(ChildProcess.make("node", [entry], { stdout: "pipe", stderr: "inherit" }))
+      .pipe(Scope.provide(childScope));
+    const line = yield* child.stdout.pipe(
+      Stream.decodeText(),
+      Stream.splitLines,
+      Stream.filter((line) => line.startsWith('{"port":')),
+      Stream.runHead,
+    );
+    if (Option.isNone(line)) return yield* Effect.die("SDK host exited before listening");
+    const ready = yield* Schema.decodeUnknownEffect(Schema.fromJsonString(Ready))(line.value);
+    origin = `http://127.0.0.1:${ready.port}`;
+  });
+  yield* start;
+  return {
+    restart: Effect.gen(function* () {
+      yield* Scope.close(childScope, Exit.void);
+      childScope = yield* Scope.make();
+      yield* start;
+    }),
+    request: (route: string, data: unknown) =>
+      Effect.gen(function* () {
+        const request = yield* HttpClientRequest.bodyJson(data)(
+          HttpClientRequest.post(origin + "/_fixture/" + route),
+        );
+        const response = yield* client.execute(request);
+        return { status: response.status, body: yield* response.json };
+      }),
+  };
+});
