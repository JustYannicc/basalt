+import { column, idColumn, table } from "fumadb-effect/schema";
+import { Schema } from "effect";
+import { AppId, OwnerId } from "../contracts/shared.ts";
+export const appConnections = table("executor_app_connections", {
+  id: idColumn("id", Schema.String, { type: "varchar(80)" }),
+  app: column("app", AppId, { type: "varchar(255)" }),
+  owner: column("owner", OwnerId, { type: "varchar(255)" }),
+  dependency: column("dependency", Schema.String, { type: "varchar(48)" }),
+  subject: column("subject", Schema.String, { type: "varchar(255)" }),
+  target: column("target", AppId, { type: "varchar(255)" }),
+  authorizer: column("authorizer", Schema.String, { type: "varchar(255)" }),
+  revision: column("revision", Schema.Int),
+  enabled: column("enabled", Schema.Boolean),
+  encrypted: column("encrypted", Schema.Uint8Array),
+  createdAt: column("created_at", Schema.Date),
+  updatedAt: column("updated_at", Schema.Date),
+}).unique("executor_app_connections_binding", ["app", "dependency", "subject"]);
+export const appCallReceipts = table("executor_app_call_receipts", {
+  id: idColumn("id", Schema.String, { type: "varchar(80)" }),
+  app: column("app", AppId, { type: "varchar(255)" }),
+  owner: column("owner", OwnerId, { type: "varchar(255)" }),
+  connection: column("connection", Schema.String, { type: "varchar(80)" }),
+  state: column("state", Schema.String, { type: "varchar(32)" }),
+  deadline: column("deadline", Schema.Date),
+  encrypted: column("encrypted", Schema.Uint8Array),
+  createdAt: column("created_at", Schema.Date),
+  updatedAt: column("updated_at", Schema.Date),
+});
diff --git a/packages/sdk/src/implementation/app-calls.ts b/packages/sdk/src/implementation/app-calls.ts
new file mode 100644
index 00000000..3786359a
--- /dev/null
+++ b/packages/sdk/src/implementation/app-calls.ts
@@ -0,0 +1,313 @@
+import { appCallAccountVersions } from "./app-call-accounts.ts";
+import { UserFacingError } from "@executor-js/utils/user-facing-error";
+import { Validator } from "@cfworker/json-schema";
+/** Saved dependency authority feeds normal native tool hosting; this slice only admits queries. */
+import { Context, Effect, Schema } from "effect";
+import {
+  AppCallCommand,
+  AppCallFailed,
+  AppDependency,
+  type AppCallHost,
+  type AppToolPolicyHost,
+} from "apps/contracts";
+import { AppId, BuildId, ToolName, type Json } from "../contracts/shared.ts";
+import { CurrentActor, type Executor, type ResourceLifecycle } from "../contracts/executor.ts";
+import { storedApp, storedVersion } from "./apps.ts";
+import type {
+  AppCallHooks,
+  AppProtectedDispatch,
+  AppCallWorkflowIdentity,
+} from "../contracts/app-calls.ts";
+import type { Query } from "./database.ts";
+import type { makeAppConnections } from "./app-connections.ts";
+export const AppCallWorkflow = Context.Reference<AppCallWorkflowIdentity | undefined>(
+  "executor/AppCallWorkflow",
+  { defaultValue: () => undefined },
+);
+const AppCallProtection = Context.Reference<
+  Omit<AppProtectedDispatch, "decodedInput" | "appPolicy"> | undefined
+>("executor/AppCallProtection", { defaultValue: () => undefined });
+const AppCallDepth = Context.Reference<number>("executor/AppCallDepth", { defaultValue: () => 0 });
+const same = (left: unknown, right: unknown): boolean => {
+  if (left === right) return true;
+  if (left === null || right === null || typeof left !== "object" || typeof right !== "object")
+    return false;
+  if (Array.isArray(left) || Array.isArray(right))
+    return (
+      Array.isArray(left) &&
+      Array.isArray(right) &&
+      left.length === right.length &&
+      left.every((value, index) => same(value, right[index]))
+    );
+  const a = Object.entries(left),
+    b = Object.entries(right);
+  return (
+    a.length === b.length &&
+    a.every(([key, value]) => Object.hasOwn(right, key) && same(value, Reflect.get(right, key)))
+  );
+};
+export const makeAppCalls = (options: {
+  readonly db: Query;
+  readonly connections: ReturnType<typeof makeAppConnections>;
+  readonly tools: () => Pick<Executor["tools"], "call">;
+  readonly hooks?: ResourceLifecycle;
+  readonly policy?: AppCallHooks;
+}) => {
+  const dispatchAppCall = (
+    identity: {
+      readonly app: string;
+      readonly build: string;
+      readonly caller?: string;
+      readonly workflow?: AppCallWorkflowIdentity;
+    },
+    raw: AppCallCommand,
+  ) =>
+    Effect.gen(function* () {
+      const command = yield* Schema.decodeUnknownEffect(AppCallCommand)(raw, {
+        onExcessProperty: "error",
+      }).pipe(
+        Effect.mapError(() => new AppCallFailed({ retryable: false, reason: "invalid_input" })),
+      );
+      // No mutation reaches target code until pre-dispatch receipts and their public replay proof ship.
+      if (command.kind !== "query")
+        return yield* new AppCallFailed({ retryable: false, reason: "effects_unavailable" });
+      const depth = yield* AppCallDepth;
+      if (depth >= 8)
+        return yield* new AppCallFailed({ retryable: false, reason: "depth_exceeded" });
+      const app = yield* storedApp(options.db, { app: AppId.make(identity.app) });
+      const version = yield* storedVersion(options.db, app);
+      if (version.build !== identity.build)
+        return yield* new AppCallFailed({ retryable: false, reason: "stale" });
+      const declaration = version.requirements.dependencies?.[command.connection];
+      if (declaration === undefined || declaration.tools[command.tool]?.kind !== command.kind)
+        return yield* new AppCallFailed({ retryable: false, reason: "denied" });
+      if (
+        declaration.scope === "user" &&
+        identity.caller === undefined &&
+        options.hooks !== undefined
+      )
+        return yield* new AppCallFailed({ retryable: false, reason: "denied" });
+      const row = yield* options.connections.find(
+        app.id,
+        command.connection,
+        declaration.scope === "app" ? "" : (identity.caller ?? "local"),
+      );
+      if (row === null)
+        return yield* new AppCallFailed({ retryable: false, reason: "connection_missing" });
+      if (row.owner !== app.owner || !row.enabled || row.target !== command.target)
+        return yield* new AppCallFailed({ retryable: false, reason: "denied" });
+      const accepted = yield* options.connections.payload(row);
+      const operation = declaration.tools[command.tool];
+      const fits = (schema: import("../contracts/shared.ts").JsonObject | undefined, value: Json) =>
+        schema === undefined || new Validator(schema, "2020-12", false).validate(value).valid;
+      if (!fits(operation?.inputSchema, command.input))
+        return yield* new AppCallFailed({ retryable: false, reason: "invalid_input" });
+      if (
+        !same(
+          Schema.encodeSync(AppDependency)(declaration),
+          Schema.encodeSync(AppDependency)(accepted.declaration),
+        )
+      )
+        return yield* new AppCallFailed({ retryable: false, reason: "stale" });
+      // A removed target or a target from another owner cannot be replaced by a similar app.
+      const target = yield* storedApp(options.db, { app: row.target, owner: app.owner });
+      const targetVersion = yield* storedVersion(options.db, target);
+      const readVersions = appCallAccountVersions(options.db, target.id, accepted.accounts).pipe(
+        Effect.provideService(
+          CurrentActor,
+          row.authorizer === "local" ? undefined : row.authorizer,
+        ),
+      );
+      const accountVersions = yield* options.hooks === undefined
+        ? readVersions
+        : options.hooks.appCallAs === undefined
+          ? Effect.fail(new AppCallFailed({ reason: "denied", retryable: false }))
+          : options.hooks.appCallAs(
+              {
+                app: app.id,
+                owner: app.owner,
+                target: target.id,
+                scope: declaration.scope,
+                authorizer: row.authorizer,
+                ...(identity.caller === undefined ? {} : { caller: identity.caller }),
+              },
+              readVersions,
+            );
+      const execute = options
+        .tools()
+        .call({
+          app: target.id,
+          version: targetVersion.id,
+          accounts: accepted.accounts,
+          tool: ToolName.make(command.tool),
+          kind: "query",
+          input: command.input,
+        })
+        .pipe(
+          Effect.flatMap((result) =>
+            result.status === "completed" && result.toolError !== true
+              ? Effect.succeed(result.value)
+              : Effect.fail(new AppCallFailed({ retryable: false, reason: "denied" })),
+          ),
+          Effect.flatMap((value) =>
+            fits(operation?.outputSchema, value)
+              ? Effect.succeed(value)
+              : Effect.fail(new AppCallFailed({ retryable: false, reason: "invalid_output" })),
+          ),
+          Effect.provideService(
+            CurrentActor,
+            row.authorizer === "local" ? undefined : row.authorizer,
+          ),
+          Effect.provideService(AppCallDepth, depth + 1),
+          Effect.provideService(AppCallProtection, {
+            source: {
+              app: app.id,
+              version: version.id,
+              build: BuildId.make(identity.build),
+              ...(identity.caller === undefined ? {} : { caller: identity.caller }),
+              ...(identity.workflow === undefined ? {} : { workflow: identity.workflow }),
+            },
+            connection: options.connections.view(row),
+            declaration,
+            ...(accepted.confirmation === undefined ? {} : { confirmation: accepted.confirmation }),
+            target: {
+              app: target.id,
+              version: targetVersion.id,
+              build: targetVersion.build,
+              tool: command.tool,
+              kind: command.kind,
+              accounts: accepted.accounts,
+              accountVersions,
+            },
+          }),
+        );
+      if (options.hooks === undefined) return yield* execute;
+      if (options.hooks.appCallAs === undefined)
+        return yield* new AppCallFailed({ retryable: false, reason: "denied" });
+      return yield* options.hooks.appCallAs(
+        {
+          app: app.id,
+          owner: app.owner,
+          target: target.id,
+          scope: declaration.scope,
+          authorizer: row.authorizer,
+          ...(identity.caller === undefined ? {} : { caller: identity.caller }),
+        },
+        execute,
+      );
+    }).pipe(
+      Effect.mapError((error) =>
+        Schema.is(AppCallFailed)(error)
+          ? error
+          : new AppCallFailed({
+              retryable: false,
+              reason:
+                UserFacingError.is(error) &&
+                error.code === "AccountDeviceOffline" &&
+                !("mayHaveWritten" in error)
+                  ? "device_offline"
+                  : "denied",
+            }),
+      ),
+    );
+  const forInvocation = (identity: {
+    readonly app: string;
+    readonly build: string;
+    readonly caller?: string;
+  }): Effect.Effect<AppCallHost> =>
+    Effect.gen(function* () {
+      const services = yield* Effect.context<never>();
+      const workflow = yield* AppCallWorkflow;
+      const bound = { ...identity, ...(workflow === undefined ? {} : { workflow }) };
+      return (command) => dispatchAppCall(bound, command).pipe(Effect.provideContext(services));
+    });
+  const toolPolicy =
+    (identity: { readonly app: string; readonly build: string }): AppToolPolicyHost =>
+    (command) =>
+      Effect.gen(function* () {
+        if (command.decision !== "user-approval") return { decision: command.decision };
+        const protectedCall = yield* AppCallProtection;
+        if (protectedCall === undefined || options.policy?.protectedDispatch === undefined)
+          return { decision: "user-approval" as const };
+        const { source, target, connection } = protectedCall;
+        if (
+          identity.app !== target.app ||
+          identity.build !== target.build ||
+          command.tool !== target.tool ||
+          command.kind !== target.kind
+        )
+          return yield* new AppCallFailed({ reason: "denied", retryable: false });
+        const sourceApp = yield* storedApp(options.db, { app: source.app });
+        const sourceVersion = yield* storedVersion(options.db, sourceApp);
+        const targetApp = yield* storedApp(options.db, { app: target.app, owner: sourceApp.owner });
+        const targetVersion = yield* storedVersion(options.db, targetApp);
+        const current = yield* options.connections.find(
+          source.app,
+          connection.dependency,
+          connection.scope === "app" ? "" : (source.caller ?? "local"),
+        );
+        if (
+          sourceVersion.id !== source.version ||
+          targetVersion.id !== target.version ||
+          current === null ||
+          current.id !== connection.id ||
+          current.revision !== connection.revision ||
+          !current.enabled ||
+          current.target !== target.app
+        )
+          return yield* new AppCallFailed({ reason: "stale", retryable: false });
+        const accepted = yield* options.connections.payload(current);
+        if (
+          !same(accepted.accounts, target.accounts) ||
+          !Schema.toEquivalence(AppDependency)(accepted.declaration, protectedCall.declaration)
+        )
+          return yield* new AppCallFailed({ reason: "stale", retryable: false });
+        const accountVersions = yield* appCallAccountVersions(
+          options.db,
+          target.app,
+          accepted.accounts,
+        );
+        if (!same(accountVersions, target.accountVersions))
+          return yield* new AppCallFailed({ reason: "stale", retryable: false });
+        const confirmation = accepted.confirmation;
+        const valid =
+          confirmation !== undefined &&
+          confirmation.sourceVersion === source.version &&
+          confirmation.targetVersion === target.version &&
+          confirmation.connectionRevision === connection.revision &&
+          same(confirmation.accounts, target.accounts) &&
+          same(confirmation.accountVersions, accountVersions) &&
+          Schema.toEquivalence(AppDependency)(confirmation.declaration, accepted.declaration);
+        const { confirmation: _oldConfirmation, ...currentCall } = protectedCall;
+        const event: AppProtectedDispatch = {
+          ...currentCall,
+          decodedInput: command.input,
+          appPolicy: "user-approval",
+          ...(valid ? { confirmation } : {}),
+        };
+        const check = options.policy.protectedDispatch(event);
+        if (options.hooks === undefined) return { decision: yield* check };
+        if (options.hooks.appCallAs === undefined)
+          return yield* new AppCallFailed({ reason: "denied", retryable: false });
+        return {
+          decision: yield* options.hooks.appCallAs(
+            {
+              app: source.app,
+              owner: sourceApp.owner,
+              target: target.app,
+              scope: connection.scope,
+              authorizer: current.authorizer,
+              ...(source.caller === undefined ? {} : { caller: source.caller }),
+            },
+            check,
+          ),
+        };
+      }).pipe(
+        Effect.mapError((error) =>
+          Schema.is(AppCallFailed)(error)
+            ? error
+            : new AppCallFailed({ reason: "denied", retryable: false }),
+        ),
+      );
+  return { dispatchAppCall, forInvocation, toolPolicy };
+};
diff --git a/packages/sdk/src/implementation/app-confirmations.ts b/packages/sdk/src/implementation/app-confirmations.ts
new file mode 100644
index 00000000..9dc93d6e
--- /dev/null
+++ b/packages/sdk/src/implementation/app-confirmations.ts
@@ -0,0 +1,148 @@
+import { appCallAccountVersions } from "./app-call-accounts.ts";
+import { Effect, Schema } from "effect";
+import { AppCallFailed, AppDependency } from "apps/contracts";
+import { CurrentActor } from "../contracts/executor.ts";
+import {
+  type AppApprovedConfiguration,
+  type AppCallHooks,
+  AppConnectionId,
+} from "../contracts/app-calls.ts";
+import { StorageError } from "../contracts/shared.ts";
+import { storedApp, storedVersion, lockApp } from "./apps.ts";
+import { query, transaction, type Query } from "./database.ts";
+import type { makeAppConnections } from "./app-connections.ts";
+
+/** Only tools.resume supplies a consumed, successful approval event. There is no public writer. */
+export const makeAppConfirmations =
+  (
+    db: Query,
+    connections: ReturnType<typeof makeAppConnections>,
+    hooks: AppCallHooks | undefined,
+  ) =>
+  (event: Omit<AppApprovedConfiguration, "actor" | "connections">) =>
+    Effect.gen(function* () {
+      if (hooks?.configurationApproved === undefined) return;
+      const actor = yield* CurrentActor;
+      if (actor === undefined) return;
+      const source = yield* storedApp(db, { app: event.app, owner: event.owner });
+      const version = yield* storedVersion(db, source);
+      if (version.id !== event.version)
+        return yield* new AppCallFailed({ reason: "stale", retryable: false });
+      const rows = yield* query(() =>
+        db.findMany("appConnections", {
+          where: (b) =>
+            b.and(
+              b("app", "=", event.app),
+              b("owner", "=", event.owner),
+              b.or(b("subject", "=", ""), b("subject", "=", actor)),
+            ),
+        }),
+      );
+      const candidates: Array<AppApprovedConfiguration["connections"][number]> = [];
