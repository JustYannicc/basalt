+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { appCallSdk } from "../support/app-call-sdk.ts";
+import { TestLive, withCase } from "../support/case.ts";
+import { scenarios } from "../test-plan.ts";
+const Reserved = Schema.Struct({ status: Schema.Literal("reserved"), dispatch: Schema.String });
+layer(TestLive, { excludeTestServices: true })("App-call receipts", (it) => {
+  it.effect(scenarios.appCallConfiguration.title, (context) =>
+    withCase(
+      context,
+      Effect.gen(function* () {
+        const sdk = yield* appCallSdk;
+        const setup = yield* sdk.request("configuration/setup", null);
+        expect(setup.status, JSON.stringify(setup.body)).toBe(200);
+        const ids = yield* Schema.decodeUnknownEffect(
+          Schema.Struct({
+            source: Schema.String,
+            target: Schema.String,
+            connection: Schema.String,
+          }),
+        )(setup.body);
+        const counts = () => sdk.request("configuration/counts", null);
+        const call = () =>
+          sdk.request("configuration/call", { app: ids.source, target: ids.target });
+        expect((yield* call()).status).not.toBe(200);
+        expect((yield* counts()).body).toMatchObject({
+          approvedConfigurations: 0,
+          confirmedChecks: 0,
+        });
+        const ordinary = yield* sdk.request("configuration/configure", {
+          app: ids.source,
+          tool: "ordinary",
+          revision: "unapproved",
+        });
+        expect(ordinary.status).toBe(200);
+        expect((yield* counts()).body).toMatchObject({
+          approvedConfigurations: 0,
+          confirmedChecks: 0,
+        });
+        const pending = yield* sdk.request("configuration/configure", {
+          app: ids.source,
+          tool: "configure",
+          revision: "owner-r1",
+        });
+        expect(pending.status, JSON.stringify(pending.body)).toBe(200);
+        const request = yield* Schema.decodeUnknownEffect(
+          Schema.Struct({ status: Schema.Literal("approval-required"), requestId: Schema.String }),
+        )(pending.body);
+        expect((yield* counts()).body).toMatchObject({ approvedConfigurations: 0 });
+        const completed = yield* sdk.request("configuration/resume", {
+          requestId: request.requestId,
+          response: { action: "accept" },
+        });
+        expect(completed.status, JSON.stringify(completed.body)).toBe(200);
+        expect((yield* counts()).body).toMatchObject({ approvedConfigurations: 1 });
+        expect((yield* call()).body).toMatchObject({
+          status: "completed",
+          value: { message: "decoded" },
+        });
+        expect((yield* counts()).body).toMatchObject({ confirmedChecks: 1 });
+        yield* sdk.request("configuration/resume", {
+          requestId: request.requestId,
+          response: { action: "accept" },
+        });
+        expect((yield* counts()).body).toMatchObject({ approvedConfigurations: 1 });
+      }),
+    ),
+  );
+
+  it.effect(scenarios.appCallWorkflow.title, (context) =>
+    withCase(
+      context,
+      Effect.gen(function* () {
+        const sdk = yield* appCallSdk;
+        const setup = yield* sdk.request("workflow/setup", null);
+        expect(setup.status, JSON.stringify(setup.body)).toBe(200);
+        const ids = yield* Schema.decodeUnknownEffect(
+          Schema.Struct({
+            source: Schema.String,
+            target: Schema.String,
+            connection: Schema.String,
+          }),
+        )(setup.body);
+        const pending = yield* sdk.request("configuration/configure", {
+          app: ids.source,
+          tool: "configure",
+          revision: "workflow-r1",
+        });
+        const approval = yield* Schema.decodeUnknownEffect(
+          Schema.Struct({ status: Schema.Literal("approval-required"), requestId: Schema.String }),
+        )(pending.body);
+        expect(
+          (yield* sdk.request("configuration/resume", {
+            requestId: approval.requestId,
+            response: { action: "accept" },
+          })).status,
+        ).toBe(200);
+        const started = yield* sdk.request("workflow/start", {
+          app: ids.source,
+          target: ids.target,
+        });
+        expect(started.status, JSON.stringify(started.body)).toBe(200);
+        const run = yield* Schema.decodeUnknownEffect(Schema.Struct({ id: Schema.String }))(
+          started.body,
+        );
+        const observed = yield* sdk.request("workflow/evidence", null);
+        expect(observed.status, JSON.stringify(observed.body)).toBe(200);
+        const evidence = yield* Schema.decodeUnknownEffect(
+          Schema.Array(
+            Schema.Struct({
+              message: Schema.String,
+              workflow: Schema.Struct({
+                run: Schema.String,
+                name: Schema.String,
+                step: Schema.String,
+                stepId: Schema.NonEmptyString,
+              }),
+            }),
+          ),
+        )(observed.body);
+        expect(
+          evidence.map((item) => ({
+            message: item.message,
+            run: item.workflow.run,
+            name: item.workflow.name,
+            step: item.workflow.step,
+          })),
+        ).toEqual([
+          { message: "direct", run: run.id, name: "prove", step: "direct" },
+          { message: "operation", run: run.id, name: "prove", step: "operation" },
+        ]);
+        expect(evidence[0]!.workflow.stepId).not.toBe(evidence[1]!.workflow.stepId);
+      }),
+    ),
+  );
+
+  it.effect(scenarios.appCallReceipts.title, (context) =>
+    withCase(
+      context,
+      Effect.gen(function* () {
+        const sdk = yield* appCallSdk;
+        const reserve = (id: string, fingerprint = "first", deadline = 2000) =>
+          sdk.request("reserve", { id, fingerprint, deadline });
+        const contenders = yield* Effect.all([reserve("concurrent"), reserve("concurrent")], {
+          concurrency: 2,
+        });
+        expect(contenders.map((r) => r.status)).toEqual([200, 200]);
+        const winners = contenders.filter((r) => Schema.is(Reserved)(r.body));
+        expect(winners).toHaveLength(1);
+        const winner = yield* Schema.decodeUnknownEffect(Reserved)(winners[0]!.body);
+        expect(contenders.find((r) => !Schema.is(Reserved)(r.body))?.body).toEqual({
+          status: "in_progress",
+        });
+        expect((yield* reserve("concurrent", "different")).body).toEqual({
+          reason: "identity_conflict",
+        });
+        expect(
+          (yield* sdk.request("finish", { id: "concurrent", dispatch: "wrong", result: 1 })).status,
+        ).toBe(409);
+        expect(
+          (yield* sdk.request("finish", {
+            id: "concurrent",
+            dispatch: winner.dispatch,
+            result: { message: "retained" },
+          })).body,
+        ).toEqual({ status: "completed" });
+        expect((yield* reserve("concurrent")).body).toEqual({
+          status: "completed",
+          value: { message: "retained" },
+        });
+        expect(
+          (yield* sdk.request("finish", {
+            id: "concurrent",
+            dispatch: winner.dispatch,
+            result: "replace",
+          })).body,
+        ).toEqual({ status: "completed" });
+        expect((yield* reserve("concurrent")).body).toEqual({
+          status: "completed",
+          value: { message: "retained" },
+        });
+        const interrupted = yield* Schema.decodeUnknownEffect(Reserved)(
+          (yield* reserve("interrupted")).body,
+        );
+        expect(
+          (yield* sdk.request("finish", { id: "interrupted", dispatch: interrupted.dispatch }))
+            .body,
+        ).toEqual({ status: "outcome_unknown" });
+        expect((yield* reserve("interrupted")).body).toEqual({ status: "outcome_unknown" });
+        const pending = yield* reserve("expires");
+        const token = (yield* Schema.decodeUnknownEffect(Reserved)(pending.body)).dispatch;
+        yield* sdk.request("clock", 2000);
+        expect((yield* reserve("expires")).body).toEqual({ status: "outcome_unknown" });
+        expect(
+          (yield* sdk.request("finish", { id: "expires", dispatch: token, result: 1 })).body,
+        ).toEqual({ status: "outcome_unknown" });
+        expect((yield* reserve("expires", "first", 999999)).body).toEqual({
+          status: "outcome_unknown",
+        });
+        expect((yield* reserve("already-expired", "first", 0)).body).toEqual({
+          status: "outcome_unknown",
+        });
+        expect((yield* reserve("already-expired", "first", 999999)).body).toEqual({
+          status: "outcome_unknown",
+        });
+        const active = yield* Schema.decodeUnknownEffect(Reserved)(
+          (yield* reserve("restart-active", "first", 5000)).body,
+        );
+        yield* sdk.restart;
+        expect((yield* reserve("restart-active", "first", 999999)).body).toEqual({
+          status: "in_progress",
+        });
+        yield* sdk.request("clock", 5000);
+        expect((yield* reserve("restart-active", "first", 999999)).body).toEqual({
+          status: "outcome_unknown",
+        });
+        expect(
+          (yield* sdk.request("finish", {
+            id: "restart-active",
+            dispatch: active.dispatch,
+            result: 1,
+          })).body,
+        ).toEqual({ status: "outcome_unknown" });
+        expect((yield* reserve("expires")).body).toEqual({ status: "outcome_unknown" });
+        expect((yield* reserve("already-expired")).body).toEqual({ status: "outcome_unknown" });
+        expect((yield* reserve("concurrent")).body).toEqual({
+          status: "completed",
+          value: { message: "retained" },
+        });
+      }),
+    ),
+  );
+});
diff --git a/e2e/tests/app-calls.spec.ts b/e2e/tests/app-calls.spec.ts
