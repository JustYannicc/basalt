diff --git a/apps/hosted/server/src/contracts/pool-manager-tokens.ts b/apps/hosted/server/src/contracts/pool-manager-tokens.ts
new file mode 100644
index 000000000..5fb8e3e5f
--- /dev/null
+++ b/apps/hosted/server/src/contracts/pool-manager-tokens.ts
@@ -0,0 +1,38 @@
+import { AppId, StorageError } from "@executor-js/sdk/core";
+import { ApiError } from "@executor-js/utils/api-error";
+import { Schema } from "effect";
+import { HttpApiEndpoint, HttpApiGroup } from "effect/http-api";
+import { BrowserSessionOnly, Principal, RequireUser } from "./auth.ts";
+import { RequiredAction } from "./authorization.ts";
+import {
+  OrganizationForbidden,
+  OrganizationReference,
+  RequireOrganization,
+} from "./organization.ts";
+
+export const MintPoolManagerToken = Schema.Struct({
+  user: Principal.fields.userId,
+  lifetimeSeconds: Schema.Int.check(Schema.isGreaterThan(0), Schema.isLessThanOrEqualTo(900)),
+});
+export const PoolManagerTokenUnavailable = ApiError.define({
+  tag: "PoolManagerTokenUnavailable",
+  status: 503,
+  message: "Temporary pool access is unavailable.",
+});
+export const PoolManagerToken = Schema.Struct({
+  token: Schema.NonEmptyString,
+  expiresAt: Schema.NonEmptyString,
+});
+export const HostedPoolManagerTokens = HttpApiGroup.make("poolManagerTokens")
+  .add(
+    HttpApiEndpoint.post("mint", "/api/organizations/:organization/apps/:app/pool-manager-tokens", {
+      params: { organization: OrganizationReference, app: AppId },
+      payload: MintPoolManagerToken,
+      success: PoolManagerToken,
+      error: [OrganizationForbidden, StorageError, PoolManagerTokenUnavailable],
+    })
+      .annotate(RequiredAction, "manage")
+      .annotate(BrowserSessionOnly, true)
+      .middleware(RequireUser),
+  )
+  .middleware(RequireOrganization);
