diff --git a/apps/hosted/server/src/implementation/pool-manager-tokens.ts b/apps/hosted/server/src/implementation/pool-manager-tokens.ts
new file mode 100644
index 000000000..2498953b2
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-manager-tokens.ts
@@ -0,0 +1,68 @@
+import { AppId, StorageError } from "@executor-js/sdk/core";
+import { Clock, Config, Effect, Option, Redacted, Schema } from "effect";
+import { HttpApiBuilder } from "effect/http-api";
+import { HostedApi } from "../contracts/api.ts";
+import { OrganizationForbidden } from "../contracts/organization.ts";
+import {
+  MintPoolManagerToken,
+  PoolManagerTokenUnavailable,
+} from "../contracts/pool-manager-tokens.ts";
+import { lockCurrentActor, policyDatabase, requireAppAccessAs } from "./resource-policy.ts";
+import { signPoolToken } from "./pool-token.ts";
+
+const Pool = Schema.Struct({ owner: Schema.String, authorization: Schema.NullOr(Schema.String) });
+
+/** Mint under the same access lock as role and app-policy changes; never accept a caller identity from a grant. */
+export const mintPoolManagerToken = (app: AppId, input: typeof MintPoolManagerToken.Type) =>
+  Effect.gen(function* () {
+    const parsed = yield* Schema.decodeUnknownEffect(MintPoolManagerToken)(input);
+    const key = yield* Config.Redacted("POOL_APP_SIGNING_KEY").pipe(
+      Config.option,
+      Effect.mapError(() => new PoolManagerTokenUnavailable()),
+    );
+    if (Option.isNone(key)) return yield* new PoolManagerTokenUnavailable();
+    const sql = yield* policyDatabase;
+    return yield* sql.withTransaction(
+      Effect.gen(function* () {
+        const actor = yield* lockCurrentActor;
+        if (parsed.user !== actor.user) return yield* new OrganizationForbidden();
+        yield* requireAppAccessAs(actor, app, "manage");
+        const rows = yield* sql`select coalesce(entry.value ->> 'owner', entry.key) as owner,
+        entry.value ->> 'authorization' as authorization
+        from organization o
+        cross join lateral jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) entry
+        join executor_apps app on app.id = entry.value ->> 'app' and app.owner = 'organization:' || o.id
+        where o.id = ${actor.organization} and app.id = ${app}`;
+        const pools = yield* Schema.decodeUnknownEffect(Schema.Array(Pool))(rows);
+        if (pools.length !== 1 || pools[0] === undefined) return yield* new OrganizationForbidden();
+        const pool = pools[0];
+        // Retained pools still use their recorded owner; app management alone cannot upgrade that authority.
+        if (pool.authorization !== "executor-app-v1" && pool.owner !== actor.user)
+          return yield* new OrganizationForbidden();
+        const exp = Math.floor((yield* Clock.currentTimeMillis) / 1000) + parsed.lifetimeSeconds;
+        const token = yield* Effect.tryPromise({
+          try: () =>
+            signPoolToken(Redacted.value(key.value), {
+              pool: app,
+              owner: actor.user,
+              organization: actor.organization,
+              exp,
+            }),
+          catch: () => new PoolManagerTokenUnavailable(),
+        });
+        return { token, expiresAt: new Date(exp * 1000).toISOString() };
+      }),
+    );
+  }).pipe(
+    Effect.catchTags({
+      SqlError: () => new StorageError(),
+      SchemaError: () => new OrganizationForbidden(),
+    }),
+  );
+
+export const hostedPoolManagerTokenHandlers = HttpApiBuilder.group(
+  HostedApi,
+  "poolManagerTokens",
+  (handlers) =>
+    handlers.handle("mint", ({ params, payload }) => mintPoolManagerToken(params.app, payload)),
+);
