diff --git a/packages/ui/src/implementation/dashboard/tool-router-failures.tsx b/packages/ui/src/implementation/dashboard/tool-router-failures.tsx
new file mode 100644
index 0000000..97e5f93
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/tool-router-failures.tsx
@@ -0,0 +1,40 @@
+import { AccountUnavailable, type ToolRouter } from "@executor-js/sdk";
+import { Schema } from "effect";
+import { Button } from "../components/button.tsx";
+import { CompactFailure } from "./error-notice.tsx";
+
+export function ToolRouterFailures({
+  routers,
+  retry,
+  retrying,
+}: {
+  readonly routers: readonly ToolRouter[];
+  readonly retry: () => void;
+  readonly retrying: boolean;
+}) {
+  // Account failures already have notices with their own recovery actions.
+  const failed = routers.filter(
+    (router) => router.error !== undefined && !Schema.is(AccountUnavailable)(router.error),
+  );
+  if (failed.length === 0) return null;
+  return (
+    <ul
+      aria-label="Sources whose tools could not load"
+      className="max-h-72 shrink-0 space-y-3 overflow-y-auto border-b px-4 py-3 max-[740px]:px-3"
+    >
+      {failed.map((router) => (
+        <li key={router.path} className="max-w-3xl min-w-0">
+          <CompactFailure
+            title={`Couldn't load ${router.title || router.path || "this source"} tools.`}
+            busy={retrying}
+          >
+            <p>Some tools may be missing. Refresh to try this source again.</p>
+            <Button type="button" size="xs" variant="outline" disabled={retrying} onClick={retry}>
+              {retrying ? "Refreshing tools…" : "Refresh tools"}
+            </Button>
+          </CompactFailure>
+        </li>
+      ))}
+    </ul>
+  );
+}
