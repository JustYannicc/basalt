+  globalThis.fetch = fetch;
+  try {
+    await run();
+  } finally {
+    globalThis.fetch = original;
+  }
+}
+
+async function redirects(operation, directBody) {
+  for (const status of [301, 302, 303, 307, 308, "opaque"]) {
+    const requests = [];
+    await withFetch(
+      async (input, init) => {
+        const url = input instanceof Request ? input.url : String(input);
+        requests.push({ url, redirect: init?.redirect });
+        // A following fetch would expose the redirected response to the caller.
+        if (init?.redirect !== "manual") return Response.json(directBody);
+        if (status !== "opaque")
+          return new Response(null, {
+            status,
+            headers: { location: "https://redirect-target.invalid/collect" },
+          });
+        const response = new Response(null);
+        Object.defineProperties(response, {
+          ok: { value: false },
+          status: { value: 0 },
+          type: { value: "opaqueredirect" },
+        });
+        return response;
+      },
+      async () => {
+        await assert.rejects(operation, /returned an HTTP redirect/u);
+        assert.equal(requests.length, 1);
+        assert.equal(requests[0].redirect, "manual");
+      },
+    );
+  }
+}
+
+async function authFixture(run) {
+  const database = new DatabaseSync(":memory:");
+  try {
+    const options = {
+      baseURL: "http://localhost:3000",
+      database,
+      emailAndPassword: { enabled: true },
+      plugins: [admin()],
+      rateLimit: { enabled: false },
+      secret: "synthetic-secret-that-is-long-enough-for-better-auth",
+    };
+    // Synthetic in-memory fixture only. No application migration or schema version changes.
+    await (await getMigrations(options)).runMigrations();
+    const auth = betterAuth(options);
+    await auth.api.signUpEmail({
+      body: { email: "admin@example.test", name: "Admin", password: "synthetic-password" },
+    });
+    const context = await auth.$context;
+    const user = (await context.internalAdapter.findUserByEmail("admin@example.test"))?.user;
+    assert.ok(user);
+    await context.internalAdapter.updateUser(user.id, { role: "admin" });
+    const signedIn = await auth.api.signInEmail({
+      body: { email: "admin@example.test", password: "synthetic-password" },
+      returnHeaders: true,
+    });
+    const headers = new Headers();
+    applySetCookies(headers, splitSetCookieHeader(signedIn.headers.get("set-cookie") ?? ""));
+    const target = await context.internalAdapter.createUser(
+      { email: "security-control@example.test", emailVerified: false, name: "Security Control" },
+      { method: "admin" },
+    );
+    await run({ auth, context, headers, target });
+  } finally {
+    database.close();
+  }
+}
+
+const cases = {
+  "social-token-redirect": () =>
+    redirects(exchange, { access_token: "redirected-access", token_type: "bearer" }),
+  "jwks-redirect": () =>
+    redirects(() => getGooglePublicKey(redirectedJwk.kid), { keys: [redirectedJwk] }),
+  "admin-user-id": () =>
+    authFixture(async ({ auth, context, headers, target }) => {
+      await assert.rejects(
+        auth.api.adminUpdateUser({
+          body: { userId: target.id, data: { id: "replacement-user-id" } },
+          headers,
+        }),
+        (error) => error?.body?.code === "USER_ID_CANNOT_BE_UPDATED",
+      );
+      assert.ok(await context.internalAdapter.findUserById(target.id));
+      assert.equal(await context.internalAdapter.findUserById("replacement-user-id"), null);
+      const updated = await auth.api.adminUpdateUser({
+        body: { userId: target.id, data: { name: "Updated Security Control" } },
+        headers,
+      });
+      assert.equal(updated.id, target.id);
+      assert.equal(updated.name, "Updated Security Control");
+    }),
+  "banned-session": () =>
+    authFixture(async ({ context, target }) => {
+      await context.internalAdapter.updateUser(target.id, { banned: true });
+      await assert.rejects(
+        context.internalAdapter.createSession(target.id),
+        (error) => error?.body?.code === "BANNED_USER",
+      );
+      await context.internalAdapter.updateUser(target.id, {
+        banned: true,
+        banExpires: new Date(Date.now() - 1_000),
+        banReason: "expired control",
+      });
+      assert.equal((await context.internalAdapter.createSession(target.id)).userId, target.id);
+      const retained = await context.internalAdapter.findUserById(target.id);
+      assert.deepEqual(
+        {
+          banned: retained?.banned,
+          banExpires: retained?.banExpires,
+          banReason: retained?.banReason,
+        },
+        { banned: false, banExpires: null, banReason: null },
+      );
+    }),
+  "direct-responses": () =>
+    withFetch(
+      async (input, init) => {
+        assert.equal(init?.redirect, "manual");
+        const url = input instanceof Request ? input.url : String(input);
+        if (url === "https://github.com/login/oauth/access_token")
+          return Response.json({ access_token: "direct-access", token_type: "bearer" });
+        assert.equal(url, "https://www.googleapis.com/oauth2/v3/certs");
+        return Response.json({ keys: [redirectedJwk] });
+      },
+      async () => {
+        assert.equal((await exchange()).accessToken, "direct-access");
+        assert.ok(await getGooglePublicKey(redirectedJwk.kid));
+      },
+    ),
+};
+
+const selected = process.argv.slice(2);
+for (const name of selected.length ? selected : Object.keys(cases)) {
+  assert.ok(Object.hasOwn(cases, name), `Unknown security case: ${name}`);
+  await cases[name]();
+  console.log(`Better Auth security: ${name} passed.`);
+}
