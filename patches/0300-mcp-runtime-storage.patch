+/** Caller-owned runtime queries; hosts migrate before serving requests. */
+import { Effect } from "effect";
+import { SqlClient } from "effect/sql";
+import { fumadb, type Provider as SqlProvider } from "fumadb-effect";
+import { sqlRuntimeAdapter } from "fumadb-effect/sql";
+import { makeReactiveStore } from "@executor-js/reactivity";
+import { StorageError } from "../contracts/shared.ts";
+import { bindOrm } from "./reactive-orm.ts";
+import { currentStorageSchema } from "./storage-current.ts";
+import { makeAppViewStorage } from "./app-view-storage.ts";
+import { makeToolSearchStore } from "./tool-search-store.ts";
+
+const runtimeDatabase = fumadb({ namespace: "executor", schemas: [currentStorageSchema] });
+
+/** Capture SQL and reactivity without constructing a migration engine. */
+export const makeExecutorRuntimeStorage = (options: { readonly provider: SqlProvider }) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const reactivity = yield* makeReactiveStore({ namespace: "executor" });
+    const client = runtimeDatabase.client(sqlRuntimeAdapter({ provider: options.provider }));
+    const db = bindOrm(client.orm("4.0.28"), sql, reactivity);
+    return {
+      orm: (_version: "4.0.24" | "4.0.25" | "4.0.27" | "4.0.28") => db,
+      // The ORM forbids primary-key updates. Lock without changing source data or provenance.
+      lockAccountObservation: (id: string) =>
+        sql`update executor_account_observations set id = id where id = ${id}`.pipe(
+          Effect.asVoid,
+          Effect.mapError(() => new StorageError()),
+        ),
+
+      reactivity,
+      // Search rows are derived data no reactive reader watches, ranked by SQL the ORM cannot express.
+      toolSearch: makeToolSearchStore(sql),
+      appViews: makeAppViewStorage(sql),
+    };
+  });
+
+/** Storage needed to serve requests, independent of the host's migration lifecycle. */
+export type ExecutorRuntimeDatabase = Effect.Success<ReturnType<typeof makeExecutorRuntimeStorage>>;
