@@ -0,0 +1,98 @@
+import { useState } from "react";
+import type { App } from "@executor-js/sdk";
+import { AppIcon } from "@executor-js/ui/dashboard/common";
+import { useDashboard } from "@executor-js/ui/dashboard/context";
+import { HugeiconsIcon } from "@hugeicons/react";
+import { ArrowRight02Icon } from "@hugeicons/core-free-icons";
+import {
+  isStale,
+  latestActivity,
+  type ObsidianDevice,
+  type VaultSync,
+} from "../../contracts/obsidian-devices.ts";
+import { ObsidianVault } from "./obsidian-devices.tsx";
+import { deviceCount } from "./obsidian-vault-card.tsx";
+
+/**
+ * Vaults a search on Accounts names: a vault's access is its devices, not a saved sign-in, so
+ * the search points to each matching vault's Accounts tab. Shown only while a vault matches.
+ */
+export function VaultSearchResults({
+  apps,
+  search,
+}: {
+  readonly apps: readonly App[];
+  readonly search: string;
+}) {
+  const term = search.trim().toLowerCase();
+  // Only an app the search can name is checked, so a search for anything else reads nothing.
+  const named = apps.filter((app) => `${app.name} obsidian vault`.toLowerCase().includes(term));
+  if (term.length === 0 || named.length === 0) return null;
+  return (
+    <section
+      aria-label="Obsidian vaults"
+      className="mx-auto hidden w-full max-w-xl px-4 pb-6 has-[li]:block"
+    >
+      <p className="mb-3 text-center text-[13px] text-muted-foreground">
+        Obsidian vaults don't use a sign-in. The devices that sync each vault are on that vault's
+        Accounts tab.
+      </p>
+      <ul className="divide-y overflow-hidden rounded-lg border">
+        {/* Apps that can't speak the sync protocol fall back to nothing without any read. */}
+        {named.map((app) => (
+          <ObsidianVault key={app.id} app={app} fallback={null}>
+            {(vault) =>
+              vault.kind === "ready" ? (
+                <li>
+                  <VaultSearchRow app={app} devices={vault.devices} sync={vault.sync} />
+                </li>
+              ) : null
+            }
+          </ObsidianVault>
+        ))}
+      </ul>
+    </section>
+  );
+}
+
+function VaultSearchRow({
+  app,
+  devices,
+  sync,
+}: {
+  readonly app: App;
+  readonly devices: readonly ObsidianDevice[];
+  readonly sync: VaultSync | undefined;
+}) {
+  const { AppLink } = useDashboard();
+  // Read once per mount, like the relative times on the vault's own tab.
+  const [now] = useState(() => Date.now());
+  const stale = isStale(latestActivity(devices, sync), now);
+  return (
+    <AppLink
+      app={app.id}
+      view="accounts"
+      className="flex items-center gap-3 px-3.5 py-2.5 text-[13px] hover:bg-muted"
+    >
+      <AppIcon app={app} />
+      <span className="min-w-0 flex-1 truncate font-medium">{app.name}</span>
+      <span className={stale ? "text-sign-in-warning" : "text-muted-foreground"}>
+        {devices.length === 0
+          ? "No devices yet"
+          : `${deviceCount(devices)}${stale ? " · needs attention" : ""}`}
+      </span>
+      <HugeiconsIcon
+        icon={ArrowRight02Icon}
+        size={14}
+        aria-hidden
+        className="shrink-0 text-muted-foreground"
+      />
+    </AppLink>
+  );
+}
+
+/** What Accounts shows under the results of a search. */
+export const vaultAccountsSearch = (
+  search: string,
+  inventory: { readonly apps: readonly App[] },
+) => <VaultSearchResults apps={inventory.apps} search={search} />;
