diff --git a/e2e/support/account-delete-contention.ts b/e2e/support/account-delete-contention.ts
new file mode 100644
index 0000000..19ecf6a
--- /dev/null
+++ b/e2e/support/account-delete-contention.ts
@@ -0,0 +1,80 @@
+/** Observe only the scenario's held rows and verify a deleted synthetic account independently. */
+import { expect } from "@effect/vitest";
+import { Effect, Fiber, Schedule, Schema } from "effect";
+import { refused } from "./app-links.ts";
+import { cloudLocks } from "./cloud-locks.ts";
+import type { Response } from "./platform.ts";
+
+export const Holder = Schema.Tuple([Schema.Struct({ pid: Schema.Number })]);
+export const Backends = Schema.Array(Schema.Struct({ pid: Schema.Number, query: Schema.String }));
+export class PendingDelete extends Schema.TaggedError<PendingDelete>()("PendingDelete", {}) {}
+
+export const blocked = (
+  locks: Effect.Success<typeof cloudLocks>,
+  blockers: readonly number[],
+  statement: string,
+) =>
+  locks
+    .run({
+      sql: `select pid, query from pg_stat_activity
+      where pg_blocking_pids(pid) && string_to_array($1, ',')::integer[] and query ilike $2`,
+      params: [blockers.join(","), statement],
+    })
+    .pipe(
+      Effect.flatMap(Schema.decodeUnknownEffect(Backends)),
+      Effect.filterOrFail(
+        (rows) => rows.length === 1,
+        () => new PendingDelete(),
+      ),
+      Effect.retry({ while: Schema.is(PendingDelete), schedule: Schedule.spaced("100 millis") }),
+      Effect.orDie,
+    );
+
+export const deletedAccount = (
+  locks: Effect.Success<typeof cloudLocks>,
+  account: string,
+  response: Response,
+) =>
+  Effect.gen(function* () {
+    yield* refused(response, 403, "OrganizationForbidden");
+    const rows = yield* locks.run({
+      sql: `select (select count(*) from executor_accounts where id = $1)::text as accounts,
+      (select count(*) from hosted_app_account_links where account = $1)::text as links`,
+      params: [account],
+    });
+    expect(rows).toEqual([{ accounts: "0", links: "0" }]);
+  });
+
+/** Queue the held app behind the route precheck, so the SDK must reacquire it afterward. */
+export const holdSdkApp = <A, E, R>(
+  input: { readonly organization: string; readonly user: string; readonly app: string },
+  remove: Effect.Effect<A, E, R>,
+) =>
+  Effect.gen(function* () {
+    const membership = yield* cloudLocks;
+    const app = yield* cloudLocks;
+    yield* Effect.addFinalizer(() => Effect.ignore(membership.release));
+    yield* Effect.addFinalizer(() => Effect.ignore(app.release));
+    const [member] = yield* membership
+      .hold({
+        sql: `select pg_backend_pid() as pid from member
+      where "organizationId" = $1 and "userId" = $2 for update`,
+        params: [input.organization, input.user],
+      })
+      .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Holder)), Effect.orDie);
+    const request = yield* Effect.forkChild(remove);
+    const [precheck] = yield* blocked(membership, [member!.pid], "%from member%for share%");
+    const holding = yield* Effect.forkChild(
+      app
+        .hold({
+          sql: "select pg_backend_pid() as pid from executor_apps where id = $1 for no key update",
+          params: [input.app],
+        })
+        .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Holder)), Effect.orDie),
+    );
+    yield* blocked(membership, [precheck!.pid], "%executor_apps%");
+    yield* membership.release;
+    const [holder] = yield* Fiber.join(holding);
+    const [deleting] = yield* blocked(membership, [holder!.pid], "%executor_apps%");
+    return { request, app, observer: membership, deleting: deleting!, holder: holder! };
+  });
