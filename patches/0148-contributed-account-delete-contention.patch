@@ -0,0 +1,40 @@
+/** Acquire the complete app/account lock set before the SDK starts deleting credentials. */
+import { AppId, StorageError, type AccountId } from "@executor-js/sdk/core";
+import { Effect, Schedule, Schema } from "effect";
+import type { SqlClient } from "effect/sql";
+
+class RetryRemovalLocks extends Schema.TaggedError<RetryRemovalLocks>()("RetryRemovalLocks", {}) {}
+const Apps = Schema.Array(Schema.Struct({ app: AppId }));
+
+export const lockAccountRemoval = (sql: SqlClient.SqlClient, account: AccountId) => {
+  const linkedApps = sql`select distinct app from hosted_app_account_links
+    where account = ${account} order by app`.pipe(Effect.flatMap(Schema.decodeUnknownEffect(Apps)));
+  return sql
+    .withTransaction(
+      Effect.gen(function* () {
+        const apps = yield* linkedApps;
+        for (const { app } of apps)
+          yield* sql`select id from executor_apps where id = ${app} for no key update`;
+        // A reconnect can hold the account before requesting an app. Release this savepoint's
+        // app locks on contention so that writer can finish instead of forming a cycle.
+        yield* sql`select id from executor_accounts where id = ${account} for update nowait`;
+        const held = new Set(apps.map(({ app }) => app));
+        // A new link may have committed while the app locks were acquired. Restart without
+        // the account lock, then take the expanded app set in order. No writes ran yet.
+        if ((yield* linkedApps).some(({ app }) => !held.has(app)))
+          return yield* new RetryRemovalLocks();
+      }),
+    )
+    .pipe(
+      Effect.catchTag("SqlError", (error) =>
+        Effect.fail(
+          error.reason._tag === "LockTimeoutError" ? new RetryRemovalLocks() : new StorageError(),
+        ),
+      ),
+      Effect.retry({
+        while: Schema.is(RetryRemovalLocks),
+        schedule: Schedule.spaced("10 millis"),
+      }),
+      Effect.mapError(() => new StorageError()),
+    );
+};
