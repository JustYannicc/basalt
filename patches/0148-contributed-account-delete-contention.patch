--- /dev/null
+++ b/e2e/tests/contributed-account-delete-oauth.spec.ts
@@ -0,0 +1,165 @@
+/** A completed reconnect's current grant must be removed, even when deletion read its old binding. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Fiber, Schema } from "effect";
+import { FetchHttpClient, HttpClient } from "effect/http";
+import {
+  Holder,
+  blocked,
+  deletedAccount,
+  holdSdkApp,
+} from "../support/account-delete-contention.ts";
+import { accountIdentityIssuer } from "../support/account-identity-issuer.ts";
+import { body } from "../support/api.ts";
+import { connectionsPath } from "../support/app-accounts.ts";
+import { appLinksFixture, ok } from "../support/app-links.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { cloudLocks } from "../support/cloud-locks.ts";
+import { Resource } from "../support/contracts.ts";
+import { Evidence } from "../support/evidence.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(RuntimeLive, { excludeTestServices: true })("Contributed OAuth account deletion", (it) => {
+  it.effect(scenarios.contributedAccountDeleteOAuthReconnect.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const issuer = yield* accountIdentityIssuer;
+        const config = {
+          authorizationUrl: issuer.origin + "/authorize",
+          tokenUrl: issuer.origin + "/token",
+          revocationUrl: issuer.origin + "/revoke",
+          tokenEndpointAuthMethod: "none",
+          scopes: ["read"],
+          identity: { issuer: issuer.origin, name: "Deletion identity" },
+        };
+        const f = yield* appLinksFixture([
+          {
+            path: "index.ts",
+            content: `import { defineApp, defineProvider, oauth2, router } from "apps";
+const service = defineProvider({ name: "Deletion OAuth", auth: { oauth: oauth2(${JSON.stringify(config)}) } });
+export default defineApp({ app: { accounts: { shared: service.many().contributed() } }, user: { accounts: { own: service.many() } } }, async () => ({ tools: router({}) }));`,
+          },
+        ]);
+        const { api, actors, prefix } = f;
+        const http = yield* HttpClient.HttpClient;
+        const shared = { kind: "shared", audience: { kind: "everyone" } };
+        const consent = (connection: string) =>
+          Effect.gen(function* () {
+            const start = yield* api.request(
+              actors.member,
+              "POST",
+              `${prefix}/connections/${connection}/oauth/start`,
+              {
+                method: "oauth",
+                client: { clientId: "delete-reconnect-client" },
+              },
+            );
+            yield* ok(start);
+            const { authorizationUrl } = yield* body(
+              Schema.Struct({ authorizationUrl: Schema.String }),
+              start,
+            );
+            return yield* Effect.scoped(
+              Effect.gen(function* () {
+                const redirect = yield* HttpClient.withScope(http).get(authorizationUrl);
+                expect(redirect.status).toBe(302);
+                if (redirect.headers.location === undefined)
+                  return yield* Effect.die("Issuer omitted callback");
+                return redirect.headers.location;
+              }),
+            ).pipe(Effect.provideService(FetchHttpClient.RequestInit, { redirect: "manual" }));
+          });
+        const complete = (connection: string, callbackUrl: string) =>
+          api.request(actors.member, "POST", `${prefix}/connections/${connection}/oauth/complete`, {
+            callbackUrl,
+          });
+        const first = yield* body(Resource, yield* f.start(actors.member, "user", "own", shared));
+        const source = yield* body(Resource, yield* complete(first.id, yield* consent(first.id)));
+        yield* Effect.addFinalizer(() =>
+          api
+            .request(actors.member, "DELETE", `${prefix}/accounts/${source.id}`)
+            .pipe(Effect.orDie),
+        );
+        const pending = yield* body(
+          Resource,
+          yield* f.start(actors.member, "app", "shared", shared),
+        );
+        const reused = yield* api.request(
+          actors.member,
+          "POST",
+          `${prefix}/connections/${pending.id}/oauth/reuse`,
+          {
+            method: "oauth",
+            account: source.id,
+          },
+        );
+        yield* ok(reused);
+        const { account } = yield* body(
+          Schema.Struct({ status: Schema.Literal("completed"), account: Resource }),
+          reused,
+        );
+        yield* Effect.addFinalizer(() =>
+          api
+            .request(actors.member, "DELETE", `${prefix}/accounts/${account.id}`)
+            .pipe(Effect.orDie),
+        );
+        const reconnect = yield* body(
+          Resource,
+          yield* api.request(actors.member, "POST", connectionsPath(f.path, "app", "shared"), {
+            account: account.id,
+          }),
+        );
+        yield* issuer.configure({ subject: "person-two" });
+        const callback = yield* consent(reconnect.id);
+        const completing = yield* cloudLocks;
+        yield* Effect.addFinalizer(() => Effect.ignore(completing.release));
+        const [holder] = yield* completing
+          .hold({
+            sql: "select pg_backend_pid() as pid from hosted_connection_access where connection_id = $1 for update",
+            params: [reconnect.id],
+          })
+          .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Holder)), Effect.orDie);
+        const saving = yield* Effect.forkChild(complete(reconnect.id, callback));
+        const [writer] = yield* blocked(
+          completing,
+          [holder!.pid],
+          "%hosted_connection_access%for share%",
+        );
+        // Reconnect has updated its account but cannot commit. The deletion reads the old grant
+        // binding before it waits on this app, then must read again after obtaining the account.
+        const deletion = yield* holdSdkApp(
+          {
+            organization: actors.organization.id,
+            // Keep this gate independent of the reconnect's membership share lock.
+            user: f.ids.admin,
+            app: f.app.id,
+          },
+          api.request(actors.admin, "DELETE", `${prefix}/accounts/${account.id}`),
+        );
+        yield* completing.release;
+        yield* deletion.app.release;
+        yield* ok(yield* Fiber.join(saving));
+        yield* ok(yield* Fiber.join(deletion.request));
+        yield* deletedAccount(
+          completing,
+          account.id,
+          yield* api.request(actors.member, "GET", `${prefix}/accounts/${account.id}`),
+        );
+        const grants = yield* completing.run({
+          sql: "select id from executor_oauth_grants where id = $1",
+          params: [account.id],
+        });
+        yield* (yield* Evidence).json("oauth-reconnect-delete.json", {
+          writer,
+          deleting: deletion.deleting,
+          grants,
+        });
+        expect(grants).toEqual([]);
+        yield* issuer.awaitRevocation;
+        expect((yield* issuer.metrics).revocations).toBe(1);
+        yield* ok(yield* api.request(actors.member, "GET", `${prefix}/accounts/${source.id}`));
+      }),
+    ),
+  );
+});
