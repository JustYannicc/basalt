diff --git a/e2e/tests/contributed-account-delete-contention.spec.ts b/e2e/tests/contributed-account-delete-contention.spec.ts
new file mode 100644
index 0000000..067ed18
--- /dev/null
+++ b/e2e/tests/contributed-account-delete-contention.spec.ts
@@ -0,0 +1,175 @@
+/** Saved-account deletion remains usable while another transaction holds a linked app. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Fiber, Ref, Schedule, Schema } from "effect";
+import { ok } from "../support/app-links.ts";
+import {
+  Holder,
+  Backends,
+  PendingDelete,
+  blocked,
+  deletedAccount,
+} from "../support/account-delete-contention.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { cloudLocks } from "../support/cloud-locks.ts";
+import { contributedApp } from "../support/contributed-app.ts";
+import { Evidence } from "../support/evidence.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Waiting = Schema.Array(Schema.Struct({ query: Schema.String }));
+
+layer(RuntimeLive, { excludeTestServices: true })(
+  "Contributed account deletion contention",
+  (it) => {
+    it.effect(scenarios.contributedAccountDeleteContention.title, (context) =>
+      withHostedHttpCase(
+        context,
+        Effect.gen(function* () {
+          const f = yield* contributedApp;
+          const { api, actors, prefix } = f;
+          const account = yield* f.connect(actors.member, "app", "shared", "Contended account", {
+            kind: "shared",
+            audience: { kind: "everyone" },
+          });
+          const locks = yield* cloudLocks;
+          yield* Effect.addFinalizer(() => Effect.ignore(locks.release));
+          const [holder] = yield* locks
+            .hold({
+              sql: "select pg_backend_pid() as pid from executor_apps where id = $1 for no key update",
+              params: [f.app.id],
+            })
+            .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Holder)), Effect.orDie);
+          const finished = yield* Ref.make(false);
+          const request = yield* Effect.forkChild(
+            api
+              .request(actors.member, "DELETE", `${prefix}/accounts/${account}`)
+              .pipe(Effect.ensuring(Ref.set(finished, true))),
+          );
+          // A failing NOWAIT returns immediately. A waiting delete is released as soon as its
+          // actual database statement is blocked, without holding it for an arbitrary delay.
+          const observed = yield* Effect.gen(function* () {
+            if (yield* Ref.get(finished))
+              return { kind: "response" as const, response: yield* Fiber.join(request) };
+            const rows = yield* locks
+              .run({
+                sql: `select query from pg_stat_activity
+                where $1 = any(pg_blocking_pids(pid)) and query ilike '%executor_apps%'`,
+                params: [holder!.pid],
+              })
+              .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Waiting)), Effect.orDie);
+            if (rows.length === 0) return yield* new PendingDelete();
+            return { kind: "waiting" as const, rows };
+          }).pipe(
+            Effect.retry({
+              while: Schema.is(PendingDelete),
+              schedule: Schedule.spaced("100 millis"),
+            }),
+          );
+          yield* locks.release;
+          const response =
+            observed.kind === "response" ? observed.response : yield* Fiber.join(request);
+          yield* (yield* Evidence).json("delete-contention.json", {
+            heldApp: f.app.id,
+            observed,
+            status: response.status,
+          });
+          yield* ok(response);
+          expect(observed.kind).toBe("waiting");
+          expect(yield* f.readLinks()).toEqual([]);
+          yield* deletedAccount(
+            locks,
+            account,
+            yield* api.request(actors.member, "GET", `${prefix}/accounts/${account}`),
+          );
+        }),
+      ),
+    );
+
+    it.effect(scenarios.contributedAccountDeleteLinkWriter.title, (context) =>
+      withHostedHttpCase(
+        context,
+        Effect.gen(function* () {
+          const f = yield* contributedApp;
+          const { api, actors, prefix } = f;
+          const account = yield* f.connect(actors.member, "app", "shared", "Delete beside writer", {
+            kind: "shared",
+            audience: { kind: "everyone" },
+          });
+          const other = yield* f.connect(actors.member, "user", "own", "Writer account", {
+            kind: "shared",
+            audience: { kind: "everyone" },
+          });
+          const policy = yield* cloudLocks;
+          const credentials = yield* cloudLocks;
+          yield* Effect.addFinalizer(() => Effect.ignore(policy.release));
+          yield* Effect.addFinalizer(() => Effect.ignore(credentials.release));
+          const [policyHolder] = yield* policy
+            .hold({
+              sql: "select pg_backend_pid() as pid from hosted_account_access where account_id = $1 for update",
+              params: [account],
+            })
+            .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Holder)), Effect.orDie);
+          const [credentialHolder] = yield* credentials
+            .hold({
+              sql: "select pg_backend_pid() as pid from executor_accounts where id = $1 for update",
+              params: [other],
+            })
+            .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Holder)), Effect.orDie);
+          const finished = yield* Ref.make(false);
+          const deletion = yield* Effect.forkChild(
+            api
+              .request(actors.member, "DELETE", `${prefix}/accounts/${account}`)
+              .pipe(Effect.ensuring(Ref.set(finished, true))),
+          );
+          // The route precheck has finished; hold the SDK transaction at its policy lock.
+          const [deleting] = yield* blocked(
+            policy,
+            [policyHolder!.pid],
+            "%hosted_account_access%for update%",
+          );
+          const linking = yield* Effect.forkChild(f.link(actors.member, "shared", other));
+          // The old order lets the link hold the app while its account FK waits. App-first
+          // deletion instead makes the link wait behind the delete. Both interleavings must finish.
+          const [writer] = yield* blocked(credentials, [credentialHolder!.pid, deleting!.pid], "%");
+          yield* policy.release;
+          const progress = yield* Effect.gen(function* () {
+            if (yield* Ref.get(finished)) return { kind: "response" as const };
+            const rows = yield* credentials
+              .run({
+                sql: `select pid, query from pg_stat_activity
+                where $1 = any(pg_blocking_pids(pid)) and query ilike '%executor_apps%'`,
+                params: [writer!.pid],
+              })
+              .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Backends)), Effect.orDie);
+            if (rows.length === 0) return yield* new PendingDelete();
+            return { kind: "waiting" as const, rows };
+          }).pipe(
+            Effect.retry({
+              while: Schema.is(PendingDelete),
+              schedule: Schedule.spaced("100 millis"),
+            }),
+          );
+          yield* credentials.release;
+          const removed = yield* Fiber.join(deletion);
+          const linked = yield* Fiber.join(linking);
+          yield* (yield* Evidence).json("public-link-writer-contention.json", {
+            deleting,
+            writer,
+            progress,
+            deleteStatus: removed.status,
+            linkStatus: linked.status,
+          });
+          yield* ok(removed);
+          yield* ok(linked);
+          expect((yield* f.readLinks()).map((link) => link.account.id)).toEqual([other]);
+          yield* deletedAccount(
+            credentials,
+            account,
+            yield* api.request(actors.member, "GET", `${prefix}/accounts/${account}`),
+          );
+          yield* ok(yield* api.request(actors.member, "GET", `${prefix}/accounts/${other}`));
+        }),
+      ),
+    );
+  },
+);
