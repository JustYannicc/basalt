@@ -0,0 +1,166 @@
+/** Rebuild the lock set when concurrent public writers change it or hold an account first. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Fiber, Schema } from "effect";
+import {
+  Holder,
+  blocked,
+  deletedAccount,
+  holdSdkApp,
+} from "../support/account-delete-contention.ts";
+import { connectionsPath } from "../support/app-accounts.ts";
+import { body } from "../support/api.ts";
+import { ok } from "../support/app-links.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { cloudLocks } from "../support/cloud-locks.ts";
+import { contributedApp, contributedSource } from "../support/contributed-app.ts";
+import { Resource } from "../support/contracts.ts";
+import { Evidence } from "../support/evidence.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(RuntimeLive, { excludeTestServices: true })("Contributed account delete lock set", (it) => {
+  it.effect(scenarios.contributedAccountDeleteExpandedLinks.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* contributedApp;
+        const { api, actors, prefix } = f;
+        const otherPath = yield* f.another(contributedSource);
+        const otherApp = otherPath.split("/").at(-1)!;
+        const account = yield* f.connect(actors.member, "app", "shared", "Expanding links", {
+          kind: "shared",
+          audience: { kind: "everyone" },
+        });
+        const deletion = yield* holdSdkApp(
+          {
+            organization: actors.organization.id,
+            user: f.ids.member,
+            app: f.app.id,
+          },
+          api.request(actors.member, "DELETE", `${prefix}/accounts/${account}`),
+        );
+        // The SDK has read only the original link and is waiting to lock that app.
+        yield* ok(
+          yield* api.request(actors.member, "PUT", `${otherPath}/accounts/app/shared/${account}`),
+        );
+        const added = yield* cloudLocks;
+        yield* Effect.addFinalizer(() => Effect.ignore(added.release));
+        const [holder] = yield* added
+          .hold({
+            sql: "select pg_backend_pid() as pid from executor_apps where id = $1 for no key update",
+            params: [otherApp],
+          })
+          .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Holder)), Effect.orDie);
+        yield* deletion.app.release;
+        const [expanded] = yield* blocked(added, [holder!.pid], "%executor_apps%");
+        // The expansion retry must release its account lock before waiting for the new app.
+        const accountLock = yield* added.probe({
+          sql: "select id from executor_accounts where id = $1 for update nowait",
+          params: [account],
+        });
+        expect(accountLock).toEqual([{ code: null }]);
+        yield* added.release;
+        const removed = yield* Fiber.join(deletion.request);
+        yield* ok(removed);
+        expect(yield* f.readLinks()).toEqual([]);
+        const otherLinks = yield* api.request(actors.member, "GET", `${otherPath}/accounts/app`);
+        yield* ok(otherLinks);
+        expect(otherLinks.body).toEqual([]);
+        yield* deletedAccount(
+          added,
+          account,
+          yield* api.request(actors.member, "GET", `${prefix}/accounts/${account}`),
+        );
+        yield* (yield* Evidence).json("expanded-delete-locks.json", {
+          expanded,
+          accountLock,
+          deleteStatus: removed.status,
+        });
+      }),
+    ),
+  );
+
+  it.effect(scenarios.contributedAccountDeleteReconnect.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* contributedApp;
+        const { api, actors, prefix } = f;
+        const otherPath = yield* f.another(contributedSource);
+        const otherApp = otherPath.split("/").at(-1)!;
+        const account = yield* f.connect(
+          actors.member,
+          "app",
+          "shared",
+          "Reconnecting beside delete",
+          {
+            kind: "shared",
+            audience: { kind: "everyone" },
+          },
+        );
+        yield* ok(
+          yield* api.request(actors.member, "PUT", `${otherPath}/accounts/app/shared/${account}`),
+        );
+        const [first, second] = [f.app.id, otherApp].sort();
+        const firstPath = first === f.app.id ? f.path : otherPath;
+        const pending = yield* body(
+          Resource,
+          yield* api.request(actors.member, "POST", connectionsPath(firstPath, "app", "shared"), {
+            account,
+          }),
+        );
+        const completing = yield* cloudLocks;
+        yield* Effect.addFinalizer(() => Effect.ignore(completing.release));
+        const [holder] = yield* completing
+          .hold({
+            sql: `select pg_backend_pid() as pid from hosted_connection_access
+          where connection_id = $1 for update`,
+            params: [pending.id],
+          })
+          .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Holder)), Effect.orDie);
+        const reconnect = yield* Effect.forkChild(
+          f.submit(actors.member, pending.id, "Reconnected token"),
+        );
+        const [saving] = yield* blocked(
+          completing,
+          [holder!.pid],
+          "%hosted_connection_access%for share%",
+        );
+        const deletion = yield* holdSdkApp(
+          {
+            organization: actors.organization.id,
+            // The reconnect may already hold its actor's membership share lock.
+            user: f.ids.admin,
+            app: second!,
+          },
+          api.request(actors.admin, "DELETE", `${prefix}/accounts/${account}`),
+        );
+        // Reconnect owns the account. Deletion owns the first app and waits on the second.
+        yield* completing.release;
+        const [waitingReconnect] = yield* blocked(
+          completing,
+          [deletion.deleting.pid],
+          "%executor_apps%",
+        );
+        expect(waitingReconnect!.pid).toBe(saving!.pid);
+        yield* deletion.app.release;
+        const reconnected = yield* Fiber.join(reconnect);
+        const removed = yield* Fiber.join(deletion.request);
+        yield* ok(reconnected);
+        yield* ok(removed);
+        yield* deletedAccount(
+          completing,
+          account,
+          yield* api.request(actors.member, "GET", `${prefix}/accounts/${account}`),
+        );
+        yield* (yield* Evidence).json("reconnect-delete-locks.json", {
+          saving,
+          waitingReconnect,
+          deleting: deletion.deleting,
+          reconnectStatus: reconnected.status,
+          deleteStatus: removed.status,
+        });
+      }),
+    ),
+  );
+});
diff --git a/e2e/tests/contributed-account-delete-oauth.spec.ts b/e2e/tests/contributed-account-delete-oauth.spec.ts
new file mode 100644
