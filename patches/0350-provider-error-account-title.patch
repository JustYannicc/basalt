diff --git a/packages/sdk/src/contracts/account-kind.ts b/packages/sdk/src/contracts/account-kind.ts
new file mode 100644
index 0000000..38c9db6
--- /dev/null
+++ b/packages/sdk/src/contracts/account-kind.ts
@@ -0,0 +1,116 @@
+import {
+  declaredAccountOffering,
+  type AccountCredentialMechanism,
+  type AccountOffering,
+} from "apps/contracts";
+import type { ProviderDefinition } from "./provider.ts";
+
+interface DisplayKind {
+  readonly mechanism: AccountCredentialMechanism;
+  readonly offering?: AccountOffering;
+}
+
+// Verified legacy declarations, keyed by immutable provider identity and exact method.
+// Display only: never merge these hints into provider definitions, identities or access policy.
+const legacyKinds: Readonly<Record<string, Readonly<Record<string, DisplayKind>>>> = {
+  // Subscription: the retained pool provider's ChatGPT sign-in.
+  prv_18bb54217e216de5533e5baa846e78ee147913029f183f7b219880fe230b0856: {
+    codex: { mechanism: "interactive", offering: "subscription" },
+  },
+  // Vercel: Access token.
+  prv_2b75c3056562dbf5eeb5d1a37f9d5de7fb28a0dd83a6c76ffe7ea2e2d4a8605c: {
+    apiKey: { mechanism: "api-key" },
+  },
+  // Jev: TypeSafe API key.
+  prv_ba76d7b3d90a3fd6b0862b14a1d119537dbe5a69b573e6592ba7777366eaa911: {
+    apiKey: { mechanism: "api-key" },
+  },
+  // ElevenLabs: API key.
+  prv_6d677ada2e24ae9d7c21495d1a90ccf93e37bc185766a1ae0aaeb5792969df07: {
+    apiKey: { mechanism: "api-key" },
+  },
+};
+
+/** Compatibility for declarations that predate kind hints; no name or method-name guessing. */
+export const legacyAccountKind = (provider: string | undefined, method: string) => {
+  if (provider === undefined || !Object.hasOwn(legacyKinds, provider)) return undefined;
+  const methods = legacyKinds[provider]!;
+  return Object.hasOwn(methods, method) ? methods[method] : undefined;
+};
+
+/** Explicit declarations win, including ambiguity; compatibility is display-only. */
+export const accountMethodMechanism = (
+  definitions: readonly ProviderDefinition[],
+  method: string,
+  provider?: string,
+): AccountCredentialMechanism | undefined => {
+  const declared = new Set(
+    definitions.flatMap((definition) => {
+      const value = definition.family?.methods?.[method]?.mechanism;
+      return value === undefined ? [] : [value];
+    }),
+  );
+  if (declared.size > 0) return declared.size === 1 ? [...declared][0] : undefined;
+  const legacy = legacyAccountKind(provider, method);
+  if (legacy !== undefined) return legacy.mechanism;
+  const auth = definitions
+    .flatMap((definition) =>
+      Object.hasOwn(definition.auth, method) ? [definition.auth[method]] : [],
+    )
+    .find((value) => value !== undefined);
+  return auth === undefined
+    ? undefined
+    : auth.type === "oauth2"
+      ? "oauth"
+      : auth.type === "interactive"
+        ? "interactive"
+        : "other";
+};
+
+export const accountMethodOffering = (
+  definitions: readonly ProviderDefinition[],
+  method: string,
+  provider?: string,
+): AccountOffering => {
+  const families = definitions.map((definition) => definition.family);
+  if (families.some((family) => family?.methods?.[method]?.offering !== undefined))
+    return declaredAccountOffering(families, method) ?? "unknown";
+  const mechanisms = new Set(
+    families.flatMap((family) => {
+      const mechanism = family?.methods?.[method]?.mechanism;
+      return mechanism === undefined ? [] : [mechanism];
+    }),
+  );
+  if (mechanisms.size > 1) return "unknown";
+  return legacyAccountKind(provider, method)?.offering ?? "unknown";
+};
+
+export const connectionKindLabel = (
+  mechanism: AccountCredentialMechanism | undefined,
+  offering: AccountOffering | undefined,
+) => {
+  const label =
+    offering === "subscription"
+      ? "Subscription"
+      : offering === "metered_api"
+        ? "Metered API"
+        : offering === "prepaid"
+          ? "Prepaid"
+          : undefined;
+  return (
+    [mechanism === "api-key" ? "API key" : mechanism === "oauth" ? "OAuth" : undefined, label]
+      .filter((value) => value !== undefined)
+      .join(" · ") || undefined
+  );
+};
+
+/** A single consumer's declaration, for its account selection and detail rows. */
+export const accountMethodKindLabel = (
+  definition: ProviderDefinition,
+  method: string,
+  provider?: string,
+) =>
+  connectionKindLabel(
+    accountMethodMechanism([definition], method, provider),
+    accountMethodOffering([definition], method, provider),
+  );
diff --git a/packages/sdk/src/contracts/account-title.ts b/packages/sdk/src/contracts/account-title.ts
new file mode 100644
index 0000000..e658113
--- /dev/null
+++ b/packages/sdk/src/contracts/account-title.ts
@@ -0,0 +1,95 @@
+import type { Account, AccountHealth } from "./account.ts";
+import { accountMethodKindLabel } from "./account-kind.ts";
+import type { ProviderDefinition } from "./provider.ts";
+
+/** The label the SDK gives an account saved without a name: "Default", then "Default 2", … */
+const generated = /^Default( \d+)?$/;
+
+/** A label the person gave the account; a generated or blank one is not a name. */
+export const authoredLabel = (label: string) => {
+  const trimmed = label.trim();
+  return trimmed === "" || generated.test(trimmed) ? undefined : label;
+};
+
+/** A generated or blank label's number, such as " 2" for "Default 2"; undefined for a name. */
+const generatedNumber = (label: string) => {
+  const trimmed = label.trim();
+  if (trimmed === "") return "";
+  const match = generated.exec(trimmed);
+  return match === null ? undefined : (match[1] ?? "");
+};
+
+/**
+ * A generated or blank label read as what the account is: its provider and kind, such as
+ * "ElevenLabs API key", keeping the generated number so "Default 2" reads "ElevenLabs API key 2".
+ * A combined kind such as "API key · Metered API" names the row by its first part.
+ */
+const describedLabel = (
+  label: string,
+  providerName: string | undefined,
+  kind: string | undefined,
+) => {
+  const number = generatedNumber(label);
+  const provider = providerName?.trim();
+  if (number === undefined || !provider) return undefined;
+  return `${provider} ${kind?.split(" · ")[0]?.trim() || "account"}${number}`;
+};
+
+/**
+ * What names an account's row on every account list: its verified identity, else the name the
+ * person gave it, else what its own check reported (an email first), else its provider and `kind`
+ * in place of a generated label ("Default 2" stays distinct), else `fallback`. A reported value
+ * never earns the verified mark and never groups rows; only `account.identity` does. A generated
+ * label never titles a row.
+ */
+export const accountTitle = (
+  account: Pick<Account, "label"> & {
+    readonly identity?: Account["identity"] | undefined;
+    readonly health?: Pick<AccountHealth, "info"> | undefined;
+    readonly providerName?: string | undefined;
+  },
+  fallback = "Unnamed account",
+  /** The account's declared kind, such as "API key", when the caller knows it. */
+  kind?: string,
+) =>
+  account.identity?.label ??
+  authoredLabel(account.label) ??
+  (account.health?.info?.email ||
+    account.health?.info?.displayName ||
+    account.health?.info?.username ||
+    describedLabel(account.label, account.providerName, kind) ||
+    `${fallback}${generatedNumber(account.label) ?? ""}`);
+
+/**
+ * What names one saved account's own controls, such as its "Manage" menu: the name the person gave
+ * it, else its row title, so a generated "Default" is never announced. A `binding`, one sign-in
+ * inside a grouped identity row, is named only by what is its own (provider, kind and number),
+ * never by the identity or a value its check reported, so sibling sign-ins keep distinct names.
+ */
+export const accountMenuName = (
+  account: Parameters<typeof accountTitle>[0],
+  /** The account's declared kind, such as "API key", when the caller knows it. */
+  kind?: string,
+  { binding = false }: { readonly binding?: boolean } = {},
+) =>
+  authoredLabel(account.label) ??
+  (binding
+    ? accountTitle({ label: account.label, providerName: account.providerName }, undefined, kind)
+    : accountTitle(account, undefined, kind));
+
+/** The same provider, mechanism and offering title used by an Accounts row. */
+export const providerAccountTitle = (
+  account: Parameters<typeof accountTitle>[0] & Pick<Account, "method" | "provider">,
+  provider?: ProviderDefinition,
+  fallback?: string,
+) => {
+  const kind =
+    provider === undefined
+      ? undefined
+      : accountMethodKindLabel(provider, account.method, account.provider);
+  return accountTitle(
+    { ...account, providerName: account.providerName ?? provider?.name },
+    fallback,
+    kind,
+  );
+};
