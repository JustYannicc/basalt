diff --git a/packages/sdk/src/contracts/account-title.ts b/packages/sdk/src/contracts/account-title.ts
new file mode 100644
index 0000000..fdb9747
--- /dev/null
+++ b/packages/sdk/src/contracts/account-title.ts
@@ -0,0 +1,87 @@
+import type { Account, AccountHealth } from "./account.ts";
+import type { ProviderDefinition } from "./provider.ts";
+
+/** The label the SDK gives an account saved without a name: "Default", then "Default 2", … */
+const generated = /^Default( \d+)?$/;
+
+/** A label the person gave the account; a generated or blank one is not a name. */
+export const authoredLabel = (label: string) => {
+  const trimmed = label.trim();
+  return trimmed === "" || generated.test(trimmed) ? undefined : label;
+};
+
+/** A generated or blank label's number, such as " 2" for "Default 2"; undefined for a name. */
+const generatedNumber = (label: string) => {
+  const trimmed = label.trim();
+  if (trimmed === "") return "";
+  const match = generated.exec(trimmed);
+  return match === null ? undefined : (match[1] ?? "");
+};
+
+/**
+ * A generated or blank label read as what the account is: its provider and kind, such as
+ * "ElevenLabs API key", keeping the generated number so "Default 2" reads "ElevenLabs API key 2".
+ * A combined kind such as "API key · Metered API" names the row by its first part.
+ */
+const describedLabel = (
+  label: string,
+  providerName: string | undefined,
+  kind: string | undefined,
+) => {
+  const number = generatedNumber(label);
+  const provider = providerName?.trim();
+  if (number === undefined || !provider) return undefined;
+  return `${provider} ${kind?.split(" · ")[0]?.trim() || "account"}${number}`;
+};
+
+/**
+ * What names an account's row on every account list: its verified identity, else the name the
+ * person gave it, else what its own check reported (an email first), else its provider and `kind`
+ * in place of a generated label ("Default 2" stays distinct), else `fallback`. A reported value
+ * never earns the verified mark and never groups rows; only `account.identity` does. A generated
+ * label never titles a row.
+ */
+export const accountTitle = (
+  account: Pick<Account, "label"> & {
+    readonly identity?: Account["identity"] | undefined;
+    readonly health?: AccountHealth | undefined;
+    readonly providerName?: string | undefined;
+  },
+  fallback = "Unnamed account",
+  /** The account's declared kind, such as "API key", when the caller knows it. */
+  kind?: string,
+) =>
+  account.identity?.label ??
+  authoredLabel(account.label) ??
+  (account.health?.info?.email ||
+    account.health?.info?.displayName ||
+    account.health?.info?.username ||
+    describedLabel(account.label, account.providerName, kind) ||
+    `${fallback}${generatedNumber(account.label) ?? ""}`);
+
+/**
+ * What names one saved account's own controls, such as its "Manage" menu: the name the person gave
+ * it, else its row title, so a generated "Default" is never announced. A `binding`, one sign-in
+ * inside a grouped identity row, is named only by what is its own (provider, kind and number),
+ * never by the identity or a value its check reported, so sibling sign-ins keep distinct names.
+ */
+export const accountMenuName = (
+  account: Parameters<typeof accountTitle>[0],
+  /** The account's declared kind, such as "API key", when the caller knows it. */
+  kind?: string,
+  { binding = false }: { readonly binding?: boolean } = {},
+) =>
+  authoredLabel(account.label) ??
+  (binding
+    ? accountTitle({ label: account.label, providerName: account.providerName }, undefined, kind)
+    : accountTitle(account, undefined, kind));
+
+/** The account's row title using its provider's own sign-in method label. */
+export const providerAccountTitle = (
+  account: Parameters<typeof accountTitle>[0] & Pick<Account, "method">,
+  provider: Pick<ProviderDefinition, "name" | "auth">,
+) => {
+  const method = provider.auth[account.method];
+  const kind = method !== undefined && "label" in method ? method.label : undefined;
+  return accountTitle({ ...account, providerName: provider.name }, undefined, kind);
+};
