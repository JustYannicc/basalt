+/** A shared unnamed account's tool failures obey the same privacy policy as its account row. */
+import { expect } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { appLinksFixture, ok } from "./app-links.ts";
+import { body } from "./api.ts";
+import { Browser } from "./browser.ts";
+import { Resource } from "./contracts.ts";
+
+const refusal = Schema.Struct({
+  _tag: Schema.Literal("AppProviderFailed"),
+  message: Schema.String,
+  account: Schema.Struct({ label: Schema.String }),
+});
+
+export const providerErrorVisibility = Effect.gen(function* () {
+  const fixture = yield* appLinksFixture([
+    {
+      path: "index.ts",
+      content: `import { defineApp, defineProvider, secrets, query, object, string, router, ProviderError } from "apps";
+const service = defineProvider({ name: "Shared service", auth: { key: secrets({ label: "Key", fields: object({ token: string() }) }) },
+  async health() { return { accountInfo: { email: "owner@company.test", displayName: "Hidden Owner" } }; }
+});
+export default defineApp({ app: { accounts: { service } } }, async ({ app: { accounts } }) => ({ tools: router({
+  read: query({ input: object({}) }, async () => { throw new ProviderError({ reason: "forbidden", status: 403, accountId: accounts.service.id }); }),
+}) }));`,
+    },
+  ]);
+  const { api, actors, prefix } = fixture;
+  const browser = yield* Browser;
+  const pending = yield* fixture.start(actors.owner, "app", "service", {
+    kind: "shared",
+    audience: { kind: "everyone" },
+  });
+  yield* ok(pending);
+  const saved = yield* api.request(
+    actors.owner,
+    "POST",
+    `${prefix}/connections/${(yield* body(Resource, pending)).id}/submit`,
+    {
+      method: "key",
+      label: "Default",
+      fields: { token: "synthetic-shared-key" },
+    },
+  );
+  yield* ok(saved);
+  const account = (yield* body(Resource, saved)).id;
+  yield* fixture.saved(actors.owner, account);
+  const checked = yield* api.request(actors.owner, "POST", `${prefix}/accounts/${account}/health`);
+  yield* ok(checked);
+  expect(checked.body).toMatchObject({ info: { email: "owner@company.test" } });
+  for (const [actor, title] of [
+    [actors.member, "Shared service account"],
+    [actors.owner, "owner@company.test"],
+  ] as const) {
+    yield* browser.login(actor);
+    yield* browser.use("Open caller's own Accounts list", (page) =>
+      page.goto(`/org/${actors.organization.slug}/accounts`),
+    );
+    const rowTitle = yield* browser.use("Read caller-visible account title", (page) =>
+      page.locator("[data-account-name]").filter({ hasText: title }).first().innerText(),
+    );
+    const called = yield* fixture.call(actor, "read");
+    expect(called.status, JSON.stringify(called.body)).toBe(502);
+    const error = yield* body(refusal, called);
+    expect(error.account.label).toBe(rowTitle);
+    expect(error.message).toContain(rowTitle);
+    if (actor === actors.member) {
+      expect(JSON.stringify(called.body)).not.toContain("owner@company.test");
+      expect(JSON.stringify(called.body)).not.toContain("Hidden Owner");
+    }
+  }
+});
