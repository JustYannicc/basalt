+const selfHostWeb = steps.find((step) => step.name === "hosted:self-host:web:build")!;
+const selfHostWebStamp = path.join(selfHostWeb.outputs[0]!, ".e2e-inputs.json");
+
+export function assertSelfHostWebFresh() {
+  const inputs = keyOf(selfHostWeb);
+  let stamp: unknown;
+  try {
+    stamp = JSON.parse(fs.readFileSync(selfHostWebStamp, "utf8"));
+  } catch {}
+  if (
+    !stamp ||
+    typeof stamp !== "object" ||
+    !("inputs" in stamp) ||
+    stamp.inputs !== inputs ||
+    !fs.existsSync(path.join(selfHostWeb.outputs[0]!, "index.html"))
+  ) {
+    throw new Error(
+      "Self-host web build is stale or missing. Run bun run e2e:prepare before starting the suite.",
+    );
+  }
+}
+
+function prepare() {
+  const started = performance.now();
+  const summary: Array<string> = [];
+  for (const step of steps) {
+    const stepStarted = performance.now();
+    const key = useCache || step === selfHostWeb ? keyOf(step) : undefined;
+    if (key !== undefined) keys.set(step.name, key);
+    const entry = !useCache || key === undefined ? undefined : path.join(cacheRoot, step.name, key);
+    if (step === selfHostWeb) fs.rmSync(selfHostWebStamp, { force: true });
