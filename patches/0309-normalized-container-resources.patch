++++ b/src/Cloudflare/Containers/ContainerConfiguration.ts
+@@ -0,0 +1,37 @@
++import { deepEqual } from "../../Diff.ts";
++import { normalizeNulls } from "../../Util/stable.ts";
++
++// Cloudflare expands named sizes into these resources on readback.
++// https://developers.cloudflare.com/containers/platform/limits/#instance-types
++const instanceResources: Record<string, readonly [number, number, number]> = {
++  dev: [1 / 16, 256, 2],
++  lite: [1 / 16, 256, 2],
++  basic: [1 / 4, 1024, 4],
++  standard: [1 / 2, 4096, 8],
++  "standard-1": [1 / 2, 4096, 8],
++  "standard-2": [1, 6144, 12],
++  "standard-3": [2, 8192, 16],
++  "standard-4": [4, 12288, 20],
++};
++
++const comparableValue = (value: unknown) => {
++  if (value === null || typeof value !== "object" ||
++    !("image" in value) || typeof value.image !== "string" ||
++    !("instanceType" in value) || typeof value.instanceType !== "string") return value;
++  const resources = instanceResources[value.instanceType];
++  if (resources === undefined) return value;
++  const [vcpu, memoryMib, diskGB] = resources;
++  return normalizeNulls({
++    ...value,
++    instanceType: undefined,
++    vcpu: ("vcpu" in value ? value.vcpu : undefined) ?? vcpu,
++    memory: ("memory" in value ? value.memory : undefined) ??
++      (memoryMib < 1024 ? `${memoryMib}MiB` : `${memoryMib / 1024}GiB`),
++    memoryMib: ("memoryMib" in value ? value.memoryMib : undefined) ?? memoryMib,
++    disk: ("disk" in value ? value.disk : undefined) ?? { size: `${diskGB}GB`, size_mb: diskGB * 1000 },
++  });
++};
++
++// Attachment and development-image values retain exact comparison.
++export const equalContainerValues = (left: unknown, right: unknown) =>
++  deepEqual(comparableValue(left), comparableValue(right));
