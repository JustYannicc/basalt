+/** A redeploy preserves a selected credential only when new sign-ins add no ambiguity. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { randomUUID } from "node:crypto";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { accountLinks, connectionsPath } from "../support/app-accounts.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { scenarios } from "../test-plan.ts";
+
+const App = Schema.Struct({
+  id: Schema.String,
+  requirements: Schema.Struct({
+    accounts: Schema.Record(Schema.String, Schema.Struct({ provider: Schema.String })),
+  }),
+});
+const key = (field = "token", label = "REST token") =>
+  `secrets({ label: ${JSON.stringify(label)}, fields: object({ ${field}: string() }) })`;
+const rest = { rest: key() };
+const mcp = 'oauth2({ discover: "https://mcp.example.test/mcp" })';
+const metadata = {
+  name: "Provider continuity fixture",
+  family: { id: "fixture", name: "Fixture" },
+};
+const source = (
+  methods: Readonly<Record<string, string>>,
+  details: object = metadata,
+  extra?: Readonly<Record<string, string>>,
+) => [
+  {
+    path: "index.ts",
+    content: `
+import { defineApp, defineProvider, oauth2, object, query, router, secrets, string } from "apps";
+const service = defineProvider({ ...${JSON.stringify(details)}, auth: {
+  ${Object.entries(methods)
+    .map(([name, value]) => `${name}: ${value}`)
+    .join(",")}
+} });
+${
+  extra === undefined
+    ? ""
+    : `const other = defineProvider({ ...${JSON.stringify(details)}, auth: {
+  ${Object.entries(extra)
+    .map(([name, value]) => `${name}: ${value}`)
+    .join(",")}
+} });`
+}
+export default defineApp({ user: { accounts: { service ${extra === undefined ? "" : ", other"} } } }, async ({ user }) => ({
+  tools: router({ selected: query({ input: object({}), output: string() }, async () => user.accounts.service.id) })
+}));`,
+  },
+  appsManifest,
+];
+
+const fixture = (files: ReturnType<typeof source>) =>
+  Effect.gen(function* () {
+    const api = yield* Api,
+      actors = yield* Actors;
+    const prefix = `/api/organizations/${actors.organization.id}`;
+    const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+      name: `Provider continuity ${randomUUID().slice(0, 8)}`,
+      files,
+    });
+    expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+    const app = yield* body(App, deployed);
+    const path = `${prefix}/apps/${app.id}`;
+    const accountIds: string[] = [];
+    yield* Effect.addFinalizer(() =>
+      Effect.gen(function* () {
+        yield* api.request(actors.owner, "DELETE", path).pipe(Effect.orDie);
+        for (const id of accountIds) {
+          yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${id}`).pipe(Effect.orDie);
+        }
+      }),
+    );
+    const connect = (method: string, fields: Record<string, string>) =>
+      Effect.gen(function* () {
+        const pending = yield* api.request(
+          actors.owner,
+          "POST",
+          connectionsPath(path, "user", "service"),
+          {},
+        );
+        expect(pending.status, JSON.stringify(pending.body)).toBe(200);
+        const connection = yield* body(Resource, pending);
+        const submitted = yield* api.request(
+          actors.owner,
+          "POST",
+          `${prefix}/connections/${connection.id}/submit`,
+          { method, fields },
+        );
+        expect(submitted.status, JSON.stringify(submitted.body)).toBe(200);
+        const account = yield* body(Resource, submitted);
+        accountIds.push(account.id);
+        return account;
+      });
+    const account = yield* connect("rest", { token: "synthetic-rest-credential" });
+    const redeploy = (next: ReturnType<typeof source>) =>
+      Effect.gen(function* () {
+        const result = yield* api.request(actors.owner, "POST", `${path}/deploy`, { files: next });
+        expect(result.status, JSON.stringify(result.body)).toBe(200);
+        return (yield* body(Schema.Struct({ app: App }), result)).app;
+      });
+    return { api, actors, app, path, account, connect, redeploy };
+  });
+
+layer(HostedLive, { excludeTestServices: true })("Provider authentication continuity", (it) => {
+  it.effect(scenarios.additiveProviderAuthSelection.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* fixture(source(rest));
+        const next = yield* f.redeploy(source({ rest: key("token", "API token"), mcp }));
+        expect(
+          next.requirements.accounts.service?.provider,
+          "An additive sign-in must keep the REST provider ref",
+        ).toBe(f.app.requirements.accounts.service?.provider);
+        expect(yield* accountLinks(f.actors.owner, f.path)).toEqual([["service", f.account.id]]);
+        const call = yield* f.api.request(f.actors.owner, "POST", `${f.path}/tools/call`, {
+          tool: "selected",
+          kind: "query",
+          input: {},
+        });
+        expect(call.status, JSON.stringify(call.body)).toBe(200);
+        expect(call.body).toBe(f.account.id);
+        const repeated = yield* f.redeploy(source({ rest: key("token", "API token"), mcp }));
+        expect(repeated.requirements.accounts.service?.provider).toBe(
+          next.requirements.accounts.service?.provider,
+        );
+        const removed = yield* f.redeploy(source(rest));
+        expect(
+          removed.requirements.accounts.service?.provider,
+          "Removing an added method must not reuse its original hash",
+        ).not.toBe(next.requirements.accounts.service?.provider);
+        const refused = yield* f.api.request(f.actors.owner, "POST", `${f.path}/tools/call`, {
+          tool: "selected",
+          kind: "query",
+          input: {},
+        });
+        expect(refused.status, JSON.stringify(refused.body)).toBe(422);
+        expect(refused.body).toMatchObject({
+          _tag: "AccountSelectionInvalid",
+          reason: "provider_mismatch",
+        });
+        const addedAgain = yield* f.redeploy(source({ ...rest, mcp }));
+        expect(addedAgain.requirements.accounts.service?.provider).toBe(
+          removed.requirements.accounts.service?.provider,
+        );
+        const removedAgain = yield* f.redeploy(source(rest));
+        expect(removedAgain.requirements.accounts.service?.provider).not.toBe(
+          addedAgain.requirements.accounts.service?.provider,
+        );
+        expect(
+          removedAgain.requirements.accounts.service?.provider,
+          "A second removal must not revive the original saved selection",
+        ).not.toBe(f.app.requirements.accounts.service?.provider);
+        const refusedAgain = yield* f.api.request(f.actors.owner, "POST", `${f.path}/tools/call`, {
+          tool: "selected",
+          kind: "query",
+          input: {},
+        });
+        expect(refusedAgain.status, JSON.stringify(refusedAgain.body)).toBe(422);
+        expect(refusedAgain.body).toMatchObject({
+          _tag: "AccountSelectionInvalid",
+          reason: "provider_mismatch",
+        });
+      }),
+    ),
+  );
+
+  it.effect(scenarios.additiveProviderAuthShared.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const a = yield* fixture(source(rest));
+        const b = yield* fixture(source(rest));
+        const added = yield* a.redeploy(source({ ...rest, additional: key() }));
+        expect(added.requirements.accounts.service?.provider).toBe(
+          a.app.requirements.accounts.service?.provider,
+        );
+        const unchanged = yield* b.redeploy(source(rest));
+        expect(unchanged.requirements.accounts.service?.provider).toBe(
+          added.requirements.accounts.service?.provider,
+        );
+        const extra = yield* a.connect("additional", { token: "synthetic-additional-credential" });
+        yield* b.redeploy(source(rest));
+        const call = yield* a.api.request(a.actors.owner, "POST", `${a.path}/tools/call`, {
+          tool: "selected",
+          kind: "query",
+          input: {},
+        });
+        expect(call.status, JSON.stringify(call.body)).toBe(200);
+        expect(call.body).toBe(extra.id);
+        const conflict = yield* b.redeploy(source({ ...rest, additional: key("differentToken") }));
+        expect(conflict.requirements.accounts.service?.provider).not.toBe(
+          added.requirements.accounts.service?.provider,
+        );
+        const own = yield* b.connect("additional", {
+          differentToken: "synthetic-conflicting-credential",
+        });
+        const ownCall = yield* b.api.request(b.actors.owner, "POST", `${b.path}/tools/call`, {
+          tool: "selected",
+          kind: "query",
+          input: {},
+        });
+        expect(ownCall.status, JSON.stringify(ownCall.body)).toBe(200);
+        expect(ownCall.body).toBe(own.id);
+        const after = yield* a.api.request(a.actors.owner, "POST", `${a.path}/tools/call`, {
+          tool: "selected",
+          kind: "query",
+          input: {},
+        });
+        expect(after.status, JSON.stringify(after.body)).toBe(200);
+        expect(after.body).toBe(extra.id);
+        const c = yield* fixture(source(rest));
+        const d = yield* fixture(source(rest));
+        const concurrent = yield* Effect.all(
+          [
+            c.redeploy(source({ ...rest, cMethod: key() })),
+            d.redeploy(source({ ...rest, dMethod: key() })),
+          ],
+          { concurrency: 2 },
+        );
+        for (const deployed of concurrent) {
+          expect(deployed.requirements.accounts.service?.provider).toBe(
+            added.requirements.accounts.service?.provider,
+          );
+        }
