+/** Provider ref continuity within one app's deployment lineage. */
+import { type Crypto, Effect, Schema } from "effect";
+import type { AppRequirements } from "../contracts/apps.ts";
+import { ProviderDefinition } from "../contracts/provider.ts";
+import { JsonObject, ProviderId, StorageError } from "../contracts/shared.ts";
+import { query, type Query } from "./database.ts";
+import { canonical, identifyProvider, methodCredential } from "./provider.ts";
+
+/**
+ * Preserve a provider ref only for a strict addition of sign-in methods. Existing methods keep
+ * their credential contract, and service metadata must still describe the same provider.
+ */
+const addsAuthMethods = (previous: ProviderDefinition, next: ProviderDefinition) => {
+  const before = Object.entries(previous.auth);
+  if (Object.keys(next.auth).length <= before.length) return false;
+  const metadata = ({ name, site, family }: ProviderDefinition) => ({
+    name,
+    site: site ?? null,
+    family: family ?? null,
+  });
+  return (
+    canonical(metadata(previous)) === canonical(metadata(next)) &&
+    before.every(([name, method]) => {
+      const current = Object.hasOwn(next.auth, name) ? next.auth[name] : undefined;
+      return (
+        current !== undefined &&
+        canonical(methodCredential(method)) === canonical(methodCredential(current))
+      );
+    })
+  );
+};
+
+/**
+ * The ID each declared provider gets. Provider IDs once also hashed display text, so a provider
+ * stored then can have an ID other than its identity. A deploy keeps the ID its app's active
+ * version gives a provider of the same identity, preferring the same requirement; else it uses the
+ * row stored for this exact definition under that earlier ID; else the identity. A changed
+ * identity may keep exactly one prior ref when it only adds auth methods. Ambiguous additions
+ * get a new ref, including when one candidate is in the same slot.
+ */
+export const chooseProviderIds = <
+  Entry extends {
+    readonly slot: string;
+    readonly provider: {
+      readonly identity: ProviderId;
+      readonly legacy: ProviderId;
+      readonly definition: ProviderDefinition;
+    };
+  },
+>(
+  db: Query,
+  crypto: Crypto.Crypto,
+  entries: ReadonlyArray<Entry>,
+  previous: AppRequirements["accounts"] | undefined,
+) =>
+  Effect.gen(function* () {
+    const kept = yield* Effect.forEach(Object.entries(previous ?? {}), ([slot, required]) =>
+      identifyProvider(required.definition, crypto).pipe(
+        Effect.map(({ identity }) => ({ slot, identity, ...required })),
+      ),
+    );
+    const continued = entries.map((entry) => {
+      const same = kept.filter((item) => item.identity === entry.provider.identity);
+      const exact = (same.find((item) => item.slot === entry.slot) ?? same[0])?.provider;
+      if (exact !== undefined) return exact;
+      const additive = new Set(
+        kept
+          .filter((item) => addsAuthMethods(item.definition, entry.provider.definition))
+          .map((item) => item.provider),
+      );
+      return additive.size === 1 ? additive.values().next().value : undefined;
+    });
+    const legacy = entries.flatMap(({ provider }, index) =>
+      continued[index] !== undefined || provider.legacy === provider.identity
+        ? []
+        : [provider.legacy],
+    );
+    const stored = new Set(
+      legacy.length === 0
+        ? []
+        : (yield* query(() =>
+            db.findMany("providers", { select: ["id"], where: (b) => b("id", "in", legacy) }),
+          )).map((row) => row.id),
+    );
+    return entries.map((entry, index) => {
+      const { identity, legacy } = entry.provider;
+      const id = continued[index] ?? (stored.has(legacy) ? legacy : identity);
+      return {
+        ...entry,
+        provider: {
+          ...entry.provider,
+          id,
+          allowAdditionalStoredMethods: previous === undefined || continued[index] !== undefined,
+        },
+      };
+    });
+  });
+
+const compatibleMethods = (stored: ProviderDefinition, incoming: ProviderDefinition) =>
+  Object.entries(incoming.auth).every(([name, method]) => {
+    const old = Object.hasOwn(stored.auth, name) ? stored.auth[name] : undefined;
+    return (
+      old === undefined || canonical(methodCredential(old)) === canonical(methodCredential(method))
+    );
+  });
+
+/**
+ * Called inside app activation's transaction. Lock candidate refs in one order before merging
+ * auth maps, so an older app cannot remove another app's added methods or race their writes.
+ * Conflicting declarations get their own ref; requirements record that final choice.
+ */
+export const storeProviders = <
+  Entry extends {
+    readonly provider: {
+      readonly id: ProviderId;
+      readonly identity: ProviderId;
+      readonly shared: Omit<ProviderDefinition, "hosts" | "site">;
+      readonly allowAdditionalStoredMethods: boolean;
+    };
+  },
+>(
+  db: Query,
+  crypto: Crypto.Crypto,
+  entries: ReadonlyArray<Entry>,
+) =>
+  Effect.gen(function* () {
+    const candidates = new Map<ProviderId, ProviderDefinition>();
+    for (const { provider } of entries) {
+      candidates.set(provider.id, provider.shared);
+      candidates.set(provider.identity, provider.shared);
+    }
+    const locked = new Map<ProviderId, ProviderDefinition>();
+    for (const [id, shared] of [...candidates].sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0))) {
+      const definition = yield* Schema.decodeUnknownEffect(JsonObject)(shared).pipe(
+        Effect.mapError(() => new StorageError()),
+      );
+      yield* query(() =>
+        db.upsert("providers", {
+          where: (b) => b("id", "=", id),
+          create: { id, definition },
+          update: {},
+        }),
+      );
+      yield* db.lockProvider(id);
+      const row = yield* query(() => db.findFirst("providers", { where: (b) => b("id", "=", id) }));
+      if (row === null) return yield* new StorageError();
+      locked.set(
+        id,
+        yield* Schema.decodeUnknownEffect(ProviderDefinition)(row.definition).pipe(
+          Effect.mapError(() => new StorageError()),
+        ),
+      );
+    }
+    return yield* Effect.forEach(entries, (entry) =>
+      Effect.gen(function* () {
+        const { provider } = entry;
+        const allowed = (stored: ProviderDefinition | undefined) =>
+          stored === undefined ||
+          (compatibleMethods(stored, provider.shared) &&
+            (provider.allowAdditionalStoredMethods ||
+              (Object.keys(stored.auth).length === Object.keys(provider.shared.auth).length &&
+                Object.keys(stored.auth).every((name) =>
+                  Object.hasOwn(provider.shared.auth, name),
+                ))));
+        let id = provider.id;
+        if (!allowed(locked.get(id))) id = provider.identity;
+        if (!allowed(locked.get(id))) {
+          // A prior additive deployment may already own both content hashes. An incompatible
+          // transition needs a fresh ref, rather than reviving a historical account selection.
+          id = ProviderId.make(
+            `prv_${yield* crypto.randomUUIDv4.pipe(Effect.mapError(() => new StorageError()))}`,
+          );
+        }
+        const merged = {
+          ...provider.shared,
+          auth: { ...locked.get(id)?.auth, ...provider.shared.auth },
+        };
+        const definition = yield* Schema.decodeUnknownEffect(JsonObject)(merged).pipe(
+          Effect.mapError(() => new StorageError()),
+        );
+        yield* query(() =>
+          db.upsert("providers", {
+            where: (b) => b("id", "=", id),
+            create: { id, definition },
+            update: { definition },
+          }),
+        );
+        locked.set(id, merged);
+        return { ...entry, provider: { ...provider, id } };
+      }),
+    );
+  });
