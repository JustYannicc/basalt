+++ b/apps/hosted/cloud/src/infrastructure/production-ops/diagnostics.ts
@@ -0,0 +1,94 @@
+import { Cause, Effect, Option, Schema } from "effect";
+import { SqlError } from "effect/sql";
+
+const SqlStateClass = Schema.Literals([
+  "08",
+  "09",
+  "0A",
+  "0B",
+  "0F",
+  "0L",
+  "0P",
+  "0Z",
+  "20",
+  "21",
+  "22",
+  "23",
+  "24",
+  "25",
+  "26",
+  "27",
+  "28",
+  "2B",
+  "2D",
+  "2F",
+  "34",
+  "38",
+  "39",
+  "3B",
+  "3D",
+  "3F",
+  "40",
+  "42",
+  "44",
+  "53",
+  "54",
+  "55",
+  "57",
+  "58",
+  "72",
+  "F0",
+  "HV",
+  "P0",
+  "XX",
+]);
+export const FailureReceipt = Schema.Struct({
+  format: Schema.Literal("basalt-production-ops-failure-v1"),
+  category: Schema.Literals(["config", "auth", "decode", "sql", "encryption", "unknown"]),
+  phase: Schema.Literals(["config", "auth", "decode", "sql", "encryption", "forward"]),
+  sqlStateClass: Schema.optionalKey(SqlStateClass),
+});
+type FailureReceipt = typeof FailureReceipt.Type;
+type Phase = FailureReceipt["phase"];
+
+class DiagnosticFailure extends Error {
+  readonly receipt: FailureReceipt;
+  constructor(receipt: FailureReceipt) {
+    super("Production operation refused");
+    this.receipt = receipt;
+  }
+}
+
+/** No message, query, row, response or credential enters this projection. */
+export function diagnostic(cause: Cause.Cause<unknown>, phase: Phase): FailureReceipt {
+  const error = Cause.findErrorOption(cause);
+  if (Option.isSome(error)) {
+    if (error.value instanceof DiagnosticFailure) return error.value.receipt;
+    if (SqlError.isSqlError(error.value)) {
+      const driver = error.value.reason.cause;
+      const code =
+        typeof driver === "object" && driver !== null && "code" in driver ? driver.code : undefined;
+      const state = Schema.decodeUnknownOption(SqlStateClass)(
+        typeof code === "string" && /^[0-9A-Z]{5}$/.test(code) ? code.slice(0, 2) : undefined,
+      );
+      return {
+        format: "basalt-production-ops-failure-v1",
+        category: "sql",
+        phase,
+        ...(Option.isSome(state) ? { sqlStateClass: state.value } : {}),
+      };
+    }
+  }
+  return {
+    format: "basalt-production-ops-failure-v1",
+    category: phase === "sql" || phase === "forward" ? "unknown" : phase,
+    phase,
+  };
+}
+
+export const atPhase =
+  (phase: Phase) =>
+  <A, E, R>(work: Effect.Effect<A, E, R>) =>
+    work.pipe(
+      Effect.catchCause((cause) => Effect.fail(new DiagnosticFailure(diagnostic(cause, phase)))),
+    );
