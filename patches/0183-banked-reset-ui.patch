diff --git a/packages/ui/src/implementation/dashboard/account-reset-control.tsx b/packages/ui/src/implementation/dashboard/account-reset-control.tsx
new file mode 100644
index 0000000..23f5910
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/account-reset-control.tsx
@@ -0,0 +1,420 @@
+/**
+ * The banked reset control on a usage cell: `↻ n` opens a confirm step, and only its "Use reset"
+ * spends. Every state comes from the product's reads; the server's retained attempt decides
+ * recovery, and nothing here survives a reload.
+ */
+import { useEffect, useState, type ReactNode } from "react";
+import type { DisplayFormat } from "../../contracts/display.ts";
+import { Button } from "../components/button.tsx";
+import { Popover, PopoverContent, PopoverTrigger } from "../components/popover.tsx";
+import { cn } from "../lib/utils.ts";
+import { moment } from "./account-observation-format.ts";
+
+type Provider = "codex" | "claude";
+type Outcome =
+  | "reset"
+  | "already_redeemed"
+  | "already_used"
+  | "nothing_to_reset"
+  | "no_credit"
+  | "not_limited"
+  | "cooldown"
+  | "ineligible"
+  | "unavailable"
+  | "rate_limited"
+  | "auth_error"
+  | "unknown";
+
+/** One credit from the product's fresh catalog, soonest expiry first. */
+export interface ResetCreditView {
+  readonly id: string;
+  readonly remaining: number;
+  readonly expiresAt: string | null;
+  /** True: applies now. Null: the provider has not said. False: not spendable now. */
+  readonly usableNow: boolean | null;
+}
+export interface ResetResultView {
+  readonly requestId: string;
+  readonly outcome: Outcome;
+  readonly cooldownCleared: boolean;
+  readonly usageRefreshQueued: boolean;
+}
+/** The server's retained attempt; its retry window is the only recovery clock. */
+export interface ResetAttemptView extends ResetResultView {
+  readonly creditId: string;
+  readonly retryUntil: string;
+  readonly canRetryProvider: boolean;
+}
+export type ResetRead<A> =
+  | { readonly ok: true; readonly value: A }
+  | { readonly ok: false; readonly message: string };
+/** A spend's answer. `lost` means no answer reached the browser: recover, never re-mint. */
+export type ResetUse =
+  | { readonly kind: "result"; readonly result: ResetResultView }
+  | { readonly kind: "refused"; readonly message: string }
+  | { readonly kind: "lost" };
+
+/**
+ * What a product gives the cell when the caller may spend this account's banked resets. Each
+ * function must keep its identity across renders: `attempt` is read once when the cell mounts.
+ */
+export interface AccountResetActions {
+  readonly credits: () => Promise<
+    ResetRead<{ readonly provider: Provider; readonly credits: readonly ResetCreditView[] }>
+  >;
+  readonly attempt: () => Promise<ResetRead<ResetAttemptView | null>>;
+  readonly use: (spend: Spend) => Promise<ResetUse>;
+}
+
+type Spend = { readonly creditId: string; readonly requestId: string };
+type State =
+  | { readonly kind: "idle" }
+  | { readonly kind: "checking" }
+  | {
+      readonly kind: "confirm";
+      readonly provider: Provider;
+      readonly credit: ResetCreditView;
+      readonly usable: number;
+    }
+  | { readonly kind: "pending"; readonly spend: Spend }
+  | {
+      readonly kind: "unknown";
+      readonly spend: Spend;
+      readonly attempt?: ResetAttemptView | undefined;
+      readonly confirming?: boolean;
+    }
+  | { readonly kind: "confirmed"; readonly result: ResetResultView; readonly reading: string }
+  | { readonly kind: "refused"; readonly message: string };
+
+const done = new Set<Outcome>(["reset", "already_redeemed", "already_used"]);
+const providers = { codex: "Codex", claude: "Claude" } satisfies Record<Provider, string>;
+const refusals: Partial<Record<Outcome, string>> = {
+  nothing_to_reset: "The provider says there's nothing to reset right now",
+  no_credit: "That banked reset is no longer available",
+  not_limited: "The account isn't at its limit, so a reset can't apply yet",
+  cooldown: "The provider asks to wait before using another reset",
+  ineligible: "The provider says this account can't use that reset",
+  unavailable: "The provider didn't take the request",
+  rate_limited: "The provider is limiting requests",
+  auth_error: "The provider rejected the account's sign-in",
+};
+const shortId = (id: string) => `${id.slice(0, 8)}…${id.slice(-4)}`;
+const spendOf = (attempt: ResetAttemptView): Spend => ({
+  creditId: attempt.creditId,
+  requestId: attempt.requestId,
+});
+/** Retry only inside the server's window; this compares its times, it never runs a timer. */
+const retryable = (attempt: ResetAttemptView | undefined, now: number) =>
+  attempt !== undefined && attempt.canRetryProvider && Date.parse(attempt.retryUntil) > now;
+
+/**
+ * The control for the cell header and the note under the cells. `reading` is when the account's
+ * usage was last observed: a confirmed reset keeps the control disabled until a newer reading
+ * arrives, since the count is never decremented here.
+ */
+export function useResetControl({
+  actions,
+  count,
+  title,
+  stale,
+  label,
+  reading,
+  now,
+  format,
+}: {
+  readonly actions: AccountResetActions;
+  readonly count: number;
+  readonly title: string;
+  readonly stale: boolean;
+  readonly label: string;
+  readonly reading: string;
+  readonly now: number;
+  readonly format: DisplayFormat;
+}): { readonly control: ReactNode; readonly note: ReactNode } {
+  const [stored, setState] = useState<State>({ kind: "idle" });
+  const state: State =
+    stored.kind === "confirmed" && stored.reading !== reading ? { kind: "idle" } : stored;
+  // A retained unknown from another tab, another device or before a reload comes back exactly.
+  const readAttempt = actions.attempt;
+  useEffect(() => {
+    let live = true;
+    void readAttempt().then((read) => {
+      if (live && read.ok && read.value?.outcome === "unknown") {
+        const attempt = read.value;
+        setState((previous) =>
+          previous.kind === "idle"
+            ? { kind: "unknown", spend: spendOf(attempt), attempt }
+            : previous,
+        );
+      }
+    });
+    return () => {
+      live = false;
+    };
+  }, [readAttempt]);
+
+  /** The server's record of this exact request, after a lost or unknown answer. */
+  const recover = (spend: Spend, confirming = false) =>
+    actions.attempt().then((read) => {
+      const attempt = read.ok && read.value?.requestId === spend.requestId ? read.value : undefined;
+      if (attempt !== undefined && done.has(attempt.outcome))
+        return setState({ kind: "confirmed", result: attempt, reading });
+      setState({
+        kind: "unknown",
+        spend,
+        attempt,
+        confirming: confirming && retryable(attempt, Date.now()),
+      });
+    });
+
+  // A retry's refusal says nothing about the original request, so it recovers that request.
+  const send = (spend: Spend, retrying = false) => {
+    setState({ kind: "pending", spend });
+    void actions.use(spend).then((answer) => {
+      if (answer.kind === "lost" || (retrying && answer.kind === "refused")) return recover(spend);
+      if (answer.kind === "refused") return setState({ kind: "refused", message: answer.message });
+      const { result } = answer;
+      if (done.has(result.outcome)) return setState({ kind: "confirmed", result, reading });
+      if (result.outcome === "unknown") return recover(spend);
+      setState({ kind: "refused", message: refusals[result.outcome] ?? "The provider refused" });
+    });
+  };
+
+  // Clicking only reads. A retained unknown shows its state instead of offering a new spend.
+  const start = () => {
+    setState({ kind: "checking" });
+    void Promise.all([actions.attempt(), actions.credits()]).then(([attempt, catalog]) => {
+      if (!attempt.ok) return setState({ kind: "refused", message: attempt.message });
+      if (attempt.value?.outcome === "unknown")
+        return setState({ kind: "unknown", spend: spendOf(attempt.value), attempt: attempt.value });
+      if (!catalog.ok) return setState({ kind: "refused", message: catalog.message });
+      // The catalog's total counts unusable grants too; only these may be offered.
+      const offered = catalog.value.credits.filter(
+        (credit) => credit.usableNow !== false && credit.remaining > 0,
+      );
+      const [credit] = offered;
+      if (credit === undefined)
+        return setState({ kind: "refused", message: "No banked reset can be used right now" });
+      setState({
+        kind: "confirm",
+        provider: catalog.value.provider,
+        credit,
+        usable: offered.reduce((total, entry) => total + entry.remaining, 0),
+      });
+    });
+  };
+
+  const disabledReason =
+    state.kind === "pending"
+      ? "Waiting for the provider to answer this reset."
+      : state.kind === "confirmed"
+        ? "Reset confirmed. Another can be used once fresh usage arrives."
+        : state.kind === "unknown"
+          ? retryable(state.attempt, now)
+            ? "The last reset request has no answer yet. Retry it below; a new one can't start."
+            : "The last reset request never got an answer and its retry window ended, so no new reset can start."
+          : undefined;
+  const button = (
+    <Button
+      variant="ghost"
+      size="xs"
+      className={cn(
+        "h-5.5 shrink-0 px-1.5 text-xs font-semibold tabular-nums",
+        stale ? "text-muted-foreground" : "text-foreground",
+      )}
+      loading={state.kind === "checking" || state.kind === "pending"}
+      disabledReason={disabledReason}
+      title={
+        disabledReason === undefined ? `${title}. Click to use one; you confirm first.` : undefined
+      }
+      aria-label={disabledReason === undefined ? `${title}. Use one` : title}
+      data-reset-count={count}
+      data-reset-control={state.kind}
+    >
+      <span aria-hidden>↻ {count}</span>
+    </Button>
+  );
+  const control =
+    disabledReason !== undefined ? (
+      button
+    ) : (
+      <Confirm
+        open={state.kind === "confirm"}
+        onOpen={() => {
+          if (state.kind === "idle" || state.kind === "refused") start();
+        }}
+        onCancel={() => setState({ kind: "idle" })}
+        onConfirm={() => {
+          if (state.kind === "confirm")
+            send({ creditId: state.credit.id, requestId: crypto.randomUUID() });
+        }}
+        title="Use a banked reset?"
+        action="Use reset"
+        trigger={button}
+      >
+        {state.kind === "confirm" && (
+          <>
+            <p>
+              Spends <b className="font-medium text-foreground">1 of {state.usable}</b> on {label}:{" "}
+              {state.credit.expiresAt === null ? (
+                "the one that doesn't expire"
+              ) : (
+                <>
+                  the one expiring{" "}
+                  <b className="font-medium text-foreground">
+                    {moment(state.credit.expiresAt, now, format)}
+                  </b>
+                </>
+              )}
+              . It can't be undone.
+            </p>
+            <p data-reset-applies>
+              {state.credit.usableNow === true
+                ? `${providers[state.provider]} says it applies now.`
+                : `${providers[state.provider]} hasn't said whether it applies now.`}
+            </p>
+          </>
+        )}
+      </Confirm>
+    );
+  const note =
+    state.kind === "pending" ? (
+      <p role="status" className={noteLine} data-reset-note="pending">
+        Using a banked reset…
+      </p>
+    ) : state.kind === "unknown" ? (
+      <UnknownNote
+        state={state}
+        now={now}
+        // A retry re-reads the server first, so its window and IDs are the retained ones.
+        onRetry={() => void recover(state.spend, true)}
+        onCancel={() => setState({ ...state, confirming: false })}
+        onConfirm={() => send(state.spend, true)}
+      />
+    ) : state.kind === "confirmed" ? (
+      <div role="status" className={noteLine} data-reset-note="confirmed">
+        <span className="font-medium text-foreground">Reset went through.</span>
+        <span>The bar updates when fresh usage arrives.</span>
+        <span className="text-muted-foreground" data-reset-followups>
+          {state.result.usageRefreshQueued ? "Usage refresh queued." : "Usage refresh not queued."}
+          {state.result.cooldownCleared && " Cooldown cleared."}
+        </span>
+      </div>
+    ) : state.kind === "refused" ? (
+      <div role="status" className={noteLine} data-reset-note="refused">
+        <span className="min-w-0 wrap-anywhere">
+          {state.message.replace(/\.$/u, "")}. No reset was used.
+        </span>
+        <Button variant="ghost" size="xs" onClick={() => setState({ kind: "idle" })}>
+          Dismiss
+        </Button>
+      </div>
+    ) : null;
+  return { control, note };
+}
+
+const noteLine = "flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1 text-xs text-foreground/80";
+
+function UnknownNote({
+  state,
+  now,
+  onRetry,
+  onCancel,
+  onConfirm,
+}: {
+  readonly state: Extract<State, { kind: "unknown" }>;
+  readonly now: number;
+  readonly onRetry: () => void;
+  readonly onCancel: () => void;
+  readonly onConfirm: () => void;
+}) {
+  const { requestId } = state.spend;
+  // Without a retained attempt the window is unread; Retry reads it before offering anything.
+  const open = state.attempt === undefined || retryable(state.attempt, now);
+  return (
+    <div role="status" className={noteLine} data-reset-note="unknown" data-request-id={requestId}>
+      <span className="min-w-0 wrap-anywhere">
+        Status unknown for reset request{" "}
+        <span className="tabular-nums" title={requestId}>
+          {shortId(requestId)}
+        </span>
+        .{" "}
+        {open
+          ? "Retry sends the same request, so it can't spend a second reset."
+          : "Its retry window ended, so nothing more is sent and no new reset can start."}
+      </span>
+      {open && (
+        <Confirm
+          open={state.confirming === true}
+          onOpen={onRetry}
+          onCancel={onCancel}
+          onConfirm={onConfirm}
+          title="Retry the reset request?"
+          action="Retry"
+          trigger={
+            <Button variant="outline" size="xs">
+              Retry
+            </Button>
+          }
+        >
+          <p>
+            Sends request {shortId(requestId)} again, unchanged, so it can't spend a second reset.
+          </p>
+        </Confirm>
+      )}
+    </div>
+  );
+}
+
+/**
+ * The human decision before any spend. Opening is the caller's job after its fresh reads; Escape
+ * and outside clicks cancel, and Cancel takes focus so a stray Enter or double click spends nothing.
+ */
+function Confirm({
+  open,
+  onOpen,
+  onCancel,
+  onConfirm,
+  title,
+  action,
+  trigger,
+  children,
+}: {
+  readonly open: boolean;
+  readonly onOpen: () => void;
+  readonly onCancel: () => void;
+  readonly onConfirm: () => void;
+  readonly title: string;
+  readonly action: string;
+  readonly trigger: ReactNode;
+  readonly children: ReactNode;
+}) {
+  return (
+    <Popover open={open} onOpenChange={(next) => (next ? onOpen() : onCancel())}>
+      <PopoverTrigger asChild>{trigger}</PopoverTrigger>
+      <PopoverContent
+        role="dialog"
+        aria-label={title}
+        className="grid w-75 gap-2 p-3 text-[13px] text-muted-foreground"
+        data-reset-confirm
+        onOpenAutoFocus={(event) => {
+          event.preventDefault();
+          const content = event.currentTarget;
+          if (content instanceof HTMLElement)
+            content.querySelector<HTMLButtonElement>("[data-reset-cancel]")?.focus();
+        }}
+      >
+        <h3 className="text-sm font-semibold text-foreground">{title}</h3>
+        {children}
+        <div className="mt-0.5 flex justify-end gap-2">
+          <Button variant="outline" size="xs" data-reset-cancel onClick={onCancel}>
+            Cancel
+          </Button>
+          <Button size="xs" onClick={onConfirm}>
+            {action}
+          </Button>
+        </div>
+      </PopoverContent>
+    </Popover>
+  );
+}
