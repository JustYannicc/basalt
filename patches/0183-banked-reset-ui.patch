diff --git a/apps/hosted/web/src/implementation/pages/account-resets-client.tsx b/apps/hosted/web/src/implementation/pages/account-resets-client.tsx
new file mode 100644
index 0000000..3d4a799
--- /dev/null
+++ b/apps/hosted/web/src/implementation/pages/account-resets-client.tsx
@@ -0,0 +1,84 @@
+/** The hosted adapter behind a usage cell's banked reset control. The server stays authoritative. */
+import { useAtomSet } from "@effect/atom-react";
+import type { AccountId, AppId } from "@executor-js/sdk";
+import type { OrganizationReference } from "@executor-js/hosted-server/organization";
+import type { SavedAccountRow } from "@executor-js/hosted-server/resource-access";
+import type {
+  AccountResetActions,
+  ResetRead,
+  ResetUse,
+} from "@executor-js/ui/dashboard/account-reset-control";
+import { Cause, Exit, Option } from "effect";
+import { useMemo } from "react";
+import {
+  resetAttemptAtom,
+  resetCreditsAtom,
+  useResetAtom,
+  type ResetResult,
+} from "../../contracts/account-resets.ts";
+import { appError, type HostedError } from "../../contracts/errors.ts";
+
+/**
+ * The pool whose reset routes this caller may use for the account: a binding to a pool the caller
+ * owns, since the routes require the current pool owner. The first such binding wins; credits
+ * belong to the account, so any owned pool reads the same ones.
+ */
+export const ownedResetPool = (
+  row: SavedAccountRow | undefined,
+  viewer: string | undefined,
+): AppId | undefined =>
+  viewer === undefined
+    ? undefined
+    : row?.bindings.find(
+        (binding) =>
+          binding.pool !== undefined && binding.access.canUse && binding.access.creator === viewer,
+      )?.pool;
+
+const read = <A,>(exit: Exit.Exit<A, HostedError>): ResetRead<A> =>
+  Exit.isSuccess(exit)
+    ? { ok: true, value: exit.value }
+    : { ok: false, message: appError(exit.cause) };
+
+const refusedReasons = {
+  busy: "Another reset request for this account hasn't finished",
+  invalid_query: "This reset can't start",
+  not_found: "This reset can't start",
+  unknown_provider: "This reset can't start",
+} as const;
+
+/**
+ * Only a definite refusal ends a spend. An unreachable reset backend is unspent unless the server
+ * recorded the request, which the control checks. Anything else, such as a dropped connection,
+ * may have reached the provider, so the control recovers the same request.
+ */
+const used = (exit: Exit.Exit<ResetResult, HostedError>): ResetUse => {
+  if (Exit.isSuccess(exit)) return { kind: "result", result: exit.value };
+  const error = Option.getOrUndefined(Cause.findErrorOption(exit.cause));
+  if (error?._tag === "AccountResetRefused")
+    return { kind: "refused", message: refusedReasons[error.reason] };
+  if (error?._tag === "Forbidden" || error?._tag === "OrganizationForbidden")
+    return { kind: "refused", message: "You can't use this account's banked resets" };
+  if (error?._tag === "AccountResetUnavailable")
+    return { kind: "unavailable", message: "This account's banked resets couldn't be reached" };
+  return { kind: "lost" };
+};
+
+/** Stable actions for one saved account in one owned pool. */
+export function useHostedResetActions(target: {
+  readonly organization: OrganizationReference;
+  readonly pool: AppId;
+  readonly account: AccountId;
+}): AccountResetActions {
+  const credits = useAtomSet(resetCreditsAtom(target), { mode: "promiseExit" });
+  const attempt = useAtomSet(resetAttemptAtom(target), { mode: "promiseExit" });
+  const use = useAtomSet(useResetAtom(target), { mode: "promiseExit" });
+  return useMemo(
+    () => ({
+      key: JSON.stringify([target.organization, target.pool, target.account]),
+      credits: () => credits().then(read),
+      attempt: () => attempt().then(read),
+      use: (spend) => use(spend).then(used),
+    }),
+    [credits, attempt, use, target.organization, target.pool, target.account],
+  );
+}
