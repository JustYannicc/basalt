diff --git a/packages/ui/src/implementation/dashboard/account-reset-control.tsx b/packages/ui/src/implementation/dashboard/account-reset-control.tsx
new file mode 100644
index 0000000..ef87cf8
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/account-reset-control.tsx
@@ -0,0 +1,585 @@
+/**
+ * The banked reset control on a usage cell: `↻ n` opens a confirm step, and only its "Use reset"
+ * spends. The server's retained attempt is the truth for recovery. The only client memory is the
+ * IDs of a spend the server may never have recorded, kept for this tab so a reload cannot mint a
+ * second request while one is unresolved.
+ */
+import { useEffect, useState, type ReactNode } from "react";
+import type { DisplayFormat } from "../../contracts/display.ts";
+import { Button } from "../components/button.tsx";
+import { Popover, PopoverContent, PopoverTrigger } from "../components/popover.tsx";
+import { cn } from "../lib/utils.ts";
+import { moment } from "./account-observation-format.ts";
+
+type Provider = "codex" | "claude";
+type Outcome =
+  | "reset"
+  | "already_redeemed"
+  | "already_used"
+  | "nothing_to_reset"
+  | "no_credit"
+  | "not_limited"
+  | "cooldown"
+  | "ineligible"
+  | "unavailable"
+  | "rate_limited"
+  | "auth_error"
+  | "unknown";
+
+/** One credit from the product's fresh catalog, soonest expiry first. */
+export interface ResetCreditView {
+  readonly id: string;
+  readonly remaining: number;
+  readonly expiresAt: string | null;
+  /** True: applies now. Null: the provider has not said. False: not spendable now. */
+  readonly usableNow: boolean | null;
+}
+export interface ResetResultView {
+  readonly requestId: string;
+  readonly outcome: Outcome;
+  readonly cooldownCleared: boolean;
+  readonly usageRefreshQueued: boolean;
+}
+/** The server's retained attempt; its retry window is the only recovery clock. */
+export interface ResetAttemptView extends ResetResultView {
+  readonly creditId: string;
+  readonly retryUntil: string;
+  readonly canRetryProvider: boolean;
+}
+export type ResetRead<A> =
+  | { readonly ok: true; readonly value: A }
+  | { readonly ok: false; readonly message: string };
+/**
+ * A spend's answer. `refused` is definite and nothing was recorded. `unavailable` means the host
+ * couldn't reach the reset backend: unspent only when no attempt was recorded for the request.
+ * `lost` means no answer reached the browser: recover the same request, never re-mint.
+ */
+export type ResetUse =
+  | { readonly kind: "result"; readonly result: ResetResultView }
+  | { readonly kind: "refused"; readonly message: string }
+  | { readonly kind: "unavailable"; readonly message: string }
+  | { readonly kind: "lost" };
+
+/**
+ * What a product gives the cell when the caller may spend this account's banked resets. Each
+ * function keeps its identity across renders: `attempt` is read when the cell mounts. `key` names
+ * the account and pool for the tab's memory of a spend the server may not have recorded.
+ */
+export interface AccountResetActions {
+  readonly key: string;
+  readonly credits: () => Promise<
+    ResetRead<{ readonly provider: Provider; readonly credits: readonly ResetCreditView[] }>
+  >;
+  readonly attempt: () => Promise<ResetRead<ResetAttemptView | null>>;
+  readonly use: (spend: Spend) => Promise<ResetUse>;
+}
+
+type Spend = { readonly creditId: string; readonly requestId: string };
+/**
+ * A spend without a settled answer. `unknown`: the server holds it without an answer.
+ * `unrecorded`: the server has no record of it, so it may never have arrived. `unread`: its
+ * status couldn't be read.
+ */
+type Unresolved = {
+  readonly kind: "unresolved";
+  readonly status: "unknown" | "unrecorded" | "unread";
+  readonly spend: Spend;
+  readonly attempt?: ResetAttemptView | undefined;
+  /** The last definite answer to a replay; it never proves the original spent nothing. */
+  readonly reason?: string | undefined;
+  /** A replay was sent, so no later answer may say nothing was used. */
+  readonly replayed: boolean;
+  readonly confirming?: boolean;
+};
+type State =
+  | { readonly kind: "idle" }
+  | { readonly kind: "checking" }
+  | {
+      readonly kind: "confirm";
+      readonly provider: Provider;
+      readonly credit: ResetCreditView;
+      readonly usable: number;
+    }
+  | { readonly kind: "pending"; readonly spend: Spend }
+  | Unresolved
+  | { readonly kind: "confirmed"; readonly result: ResetResultView; readonly reading: string }
+  | { readonly kind: "refused"; readonly message: string };
+
+const done = new Set<Outcome>(["reset", "already_redeemed", "already_used"]);
+const providers = { codex: "Codex", claude: "Claude" } satisfies Record<Provider, string>;
+const refusals: Partial<Record<Outcome, string>> = {
+  nothing_to_reset: "The provider says there's nothing to reset right now",
+  no_credit: "That banked reset is no longer available",
+  not_limited: "The account isn't at its limit, so a reset can't apply yet",
+  cooldown: "The provider asks to wait before using another reset",
+  ineligible: "The provider says this account can't use that reset",
+  unavailable: "The provider didn't take the request",
+  rate_limited: "The provider is limiting requests",
+  auth_error: "The provider rejected the account's sign-in",
+};
+const refusal = (outcome: Outcome) => refusals[outcome] ?? "The provider refused";
+const sentence = (text: string) => `${text.replace(/\.$/u, "")}.`;
+const shortId = (id: string) => `${id.slice(0, 8)}…${id.slice(-4)}`;
+const spendOf = (attempt: ResetAttemptView): Spend => ({
+  creditId: attempt.creditId,
+  requestId: attempt.requestId,
+});
+/** Whether a same-ID replay may be offered. The server's window decides; no timer runs here. */
+const replayable = (state: Unresolved, now: number) =>
+  state.status === "unrecorded" ||
+  (state.status === "unknown" &&
+    state.attempt !== undefined &&
+    state.attempt.canRetryProvider &&
+    Date.parse(state.attempt.retryUntil) > now);
+
+/**
+ * Where a spend stands, from the server's latest attempt read. A different retained unknown wins,
+ * since the server blocks new spends behind it. `reading` dates a confirmed result.
+ */
+const settled = (
+  spend: Spend,
+  read: ResetRead<ResetAttemptView | null>,
+  options: {
+    readonly replayed: boolean;
+    readonly reason?: string | undefined;
+    readonly reading: string;
+  },
+): State => {
+  const base = {
+    kind: "unresolved",
+    spend,
+    replayed: options.replayed,
+    reason: options.reason,
+  } as const;
+  if (!read.ok) return { ...base, status: "unread" };
+  const attempt = read.value;
+  if (attempt?.requestId === spend.requestId) {
+    if (done.has(attempt.outcome))
+      return { kind: "confirmed", result: attempt, reading: options.reading };
+    if (attempt.outcome === "unknown") return { ...base, status: "unknown", attempt };
+    return options.replayed
+      ? { ...base, status: "unknown", attempt, reason: refusal(attempt.outcome) }
+      : { kind: "refused", message: refusal(attempt.outcome) };
+  }
+  if (attempt?.outcome === "unknown")
+    return { ...base, spend: spendOf(attempt), status: "unknown", attempt };
+  return { ...base, status: "unrecorded" };
+};
+
+/**
+ * The tab's memory of a spend in flight, written before the request leaves and cleared once the
+ * server settles it. sessionStorage scopes it to the tab that minted the IDs and survives reloads;
+ * another device relies on the server's attempt. A storage failure only loses this fallback.
+ */
+const memory = {
+  name: (key: string) => `executor:reset-spend:${key}`,
+  read: (key: string): Spend | undefined => {
+    try {
+      const value: unknown = JSON.parse(sessionStorage.getItem(memory.name(key)) ?? "null");
+      return typeof value === "object" &&
+        value !== null &&
+        "creditId" in value &&
+        "requestId" in value &&
+        typeof value.creditId === "string" &&
+        typeof value.requestId === "string"
+        ? { creditId: value.creditId, requestId: value.requestId }
+        : undefined;
+    } catch {
+      return undefined;
+    }
+  },
+  /** Unresolved states keep their IDs; every other state clears them. */
+  keep: (key: string, state: State) => {
+    try {
+      if (state.kind === "unresolved")
+        sessionStorage.setItem(memory.name(key), JSON.stringify(state.spend));
+      else sessionStorage.removeItem(memory.name(key));
+    } catch {}
+  },
+};
+
+/**
+ * The control for the cell header and the note under the cells. `reading` is when the account's
+ * usage was last observed: a confirmed reset keeps the control disabled until a newer reading
+ * arrives, since the count is never decremented here.
+ */
+export function useResetControl({
+  actions,
+  count,
+  title,
+  stale,
+  label,
+  reading,
+  now,
+  format,
+}: {
+  readonly actions: AccountResetActions;
+  readonly count: number;
+  readonly title: string;
+  readonly stale: boolean;
+  readonly label: string;
+  readonly reading: string;
+  readonly now: number;
+  readonly format: DisplayFormat;
+}): { readonly control: ReactNode; readonly note: ReactNode } {
+  const [stored, setState] = useState<State>({ kind: "idle" });
+  const state: State =
+    stored.kind === "confirmed" && stored.reading !== reading ? { kind: "idle" } : stored;
+  const { key, attempt: readAttempt } = actions;
+  const apply = (next: State) => {
+    memory.keep(key, next);
+    setState(next);
+  };
+
+  // After a reload or on another device: the server's unknown first, then this tab's IDs. A
+  // request it settled meanwhile just clears; the row shows that through its usage.
+  useEffect(() => {
+    let live = true;
+    const remembered = memory.read(key);
+    void readAttempt().then((read) => {
+      if (!live) return;
+      const spend = read.ok && read.value?.outcome === "unknown" ? spendOf(read.value) : remembered;
+      if (spend === undefined) return;
+      const next = settled(spend, read, { replayed: false, reading: "" });
+      memory.keep(key, next);
+      if (next.kind === "unresolved")
+        setState((previous) => (previous.kind === "idle" ? next : previous));
+    });
+    return () => {
+      live = false;
+    };
+  }, [readAttempt, key]);
+
+  const reread = (confirming: boolean) =>
+    actions.attempt().then((read) => {
+      if (stored.kind !== "unresolved") return;
+      const next = settled(stored.spend, read, {
+        replayed: stored.replayed,
+        reason: stored.reason,
+        reading,
+      });
+      apply(
+        confirming && next.kind === "unresolved" && replayable(next, Date.now())
+          ? { ...next, confirming: true }
+          : next,
+      );
+    });
+
+  const recover = (spend: Spend, replayed: boolean, reason?: string) =>
+    actions.attempt().then((read) => apply(settled(spend, read, { replayed, reason, reading })));
+
+  const send = (spend: Spend, replayed: boolean) => {
+    memory.keep(key, { kind: "unresolved", status: "unrecorded", spend, replayed });
+    setState({ kind: "pending", spend });
+    void actions.use(spend).then((answer) => {
+      if (answer.kind === "result" && done.has(answer.result.outcome))
+        return apply({ kind: "confirmed", result: answer.result, reading });
+      // A replay's answer proves nothing about the original, so anything but done recovers.
+      if (replayed)
+        return recover(
+          spend,
+          true,
+          answer.kind === "result"
+            ? answer.result.outcome === "unknown"
+              ? undefined
+              : refusal(answer.result.outcome)
+            : answer.kind === "lost"
+              ? undefined
+              : answer.message,
+        );
+      if (answer.kind === "refused") return apply({ kind: "refused", message: answer.message });
+      if (answer.kind === "result" && answer.result.outcome !== "unknown")
+        return apply({ kind: "refused", message: refusal(answer.result.outcome) });
+      if (answer.kind === "unavailable")
+        // The backend was unreachable: unspent only if the server recorded nothing for it.
+        return actions.attempt().then((read) => {
+          const next = settled(spend, read, { replayed: false, reading });
+          apply(
+            next.kind === "unresolved" && next.status === "unrecorded"
+              ? { kind: "refused", message: answer.message }
+              : next,
+          );
+        });
+      return recover(spend, false);
+    });
+  };
+
+  // Clicking only reads. Anything unresolved shows its state instead of offering a new spend.
+  const start = () => {
+    setState({ kind: "checking" });
+    const remembered = memory.read(key);
+    void Promise.all([actions.attempt(), actions.credits()]).then(([attempt, catalog]) => {
+      const spend =
+        attempt.ok && attempt.value?.outcome === "unknown" ? spendOf(attempt.value) : remembered;
+      if (spend !== undefined) {
+        const next = settled(spend, attempt, { replayed: false, reading: "" });
+        memory.keep(key, next);
+        if (next.kind === "unresolved") return setState(next);
+      }
+      if (!attempt.ok) return setState({ kind: "refused", message: attempt.message });
+      if (!catalog.ok) return setState({ kind: "refused", message: catalog.message });
+      // The catalog's total counts unusable grants too; only these may be offered.
+      const offered = catalog.value.credits.filter(
+        (credit) => credit.usableNow !== false && credit.remaining > 0,
+      );
+      const [credit] = offered;
+      if (credit === undefined)
+        return setState({ kind: "refused", message: "No banked reset can be used right now" });
+      setState({
+        kind: "confirm",
+        provider: catalog.value.provider,
+        credit,
+        usable: offered.reduce((total, entry) => total + entry.remaining, 0),
+      });
+    });
+  };
+
+  const disabledReason =
+    state.kind === "pending"
+      ? "Waiting for the provider to answer this reset."
+      : state.kind === "confirmed"
+        ? "Reset confirmed. Another can be used once fresh usage arrives."
+        : state.kind !== "unresolved"
+          ? undefined
+          : state.status === "unread"
+            ? "Couldn't read the last reset request's status, so a new one can't start. Check it below."
+            : replayable(state, now)
+              ? "The last reset request has no answer yet. Retry it below; a new one can't start."
+              : "The last reset request never got an answer and its retry window ended, so no new reset can start.";
+  const button = (
+    <Button
+      variant="ghost"
+      size="xs"
+      loading={state.kind === "checking" || state.kind === "pending"}
+      disabledReason={disabledReason}
+      title={
+        disabledReason === undefined ? `${title}. Click to use one; you confirm first.` : undefined
+      }
+      aria-label={disabledReason === undefined ? `${title}. Use one` : title}
+      data-reset-count={count}
+      data-reset-control={state.kind === "unresolved" ? state.status : state.kind}
+    >
+      <span
+        aria-hidden
+        className={cn(
+          "font-semibold tabular-nums",
+          stale ? "text-muted-foreground" : "text-foreground",
+        )}
+      >
+        ↻ {count}
+      </span>
+    </Button>
+  );
+  const control =
+    disabledReason !== undefined ? (
+      button
+    ) : (
+      <Confirm
+        open={state.kind === "confirm"}
+        onOpen={() => {
+          if (state.kind === "idle" || state.kind === "refused") start();
+        }}
+        onCancel={() => setState({ kind: "idle" })}
+        onConfirm={() => {
+          if (state.kind === "confirm")
+            send({ creditId: state.credit.id, requestId: crypto.randomUUID() }, false);
+        }}
+        title="Use a banked reset?"
+        action="Use reset"
+        trigger={button}
+      >
+        {state.kind === "confirm" && (
+          <>
+            <p>
+              Spends <b className="font-medium text-foreground">1 of {state.usable}</b> on {label}:{" "}
+              {state.credit.expiresAt === null ? (
+                "the one that doesn't expire"
+              ) : (
+                <>
+                  the one expiring{" "}
+                  <b className="font-medium text-foreground">
+                    {moment(state.credit.expiresAt, now, format)}
+                  </b>
+                </>
+              )}
+              . It can't be undone.
+            </p>
+            <p data-reset-applies>
+              {state.credit.usableNow === true
+                ? `${providers[state.provider]} says it applies now.`
+                : `${providers[state.provider]} hasn't said whether it applies now.`}
+            </p>
+          </>
+        )}
+      </Confirm>
+    );
+  const note =
+    state.kind === "pending" ? (
+      <p role="status" className={noteLine} data-reset-note="pending">
+        Using a banked reset…
+      </p>
+    ) : state.kind === "unresolved" ? (
+      <UnresolvedNote
+        state={state}
+        now={now}
+        // Both re-read the server first; a replay is offered only from what it says.
+        onCheck={() => void reread(false)}
+        onRetry={() => void reread(true)}
+        onCancel={() => setState({ ...state, confirming: false })}
+        onConfirm={() => send(state.spend, true)}
+      />
+    ) : state.kind === "confirmed" ? (
+      <div role="status" className={noteLine} data-reset-note="confirmed">
+        <span className="font-medium text-foreground">Reset went through.</span>
+        <span>The bar updates when fresh usage arrives.</span>
+        <span className="text-muted-foreground" data-reset-followups>
+          {state.result.usageRefreshQueued ? "Usage refresh queued." : "Usage refresh not queued."}
+          {state.result.cooldownCleared && " Cooldown cleared."}
+        </span>
+      </div>
+    ) : state.kind === "refused" ? (
+      <div role="status" className={noteLine} data-reset-note="refused">
+        <span className="min-w-0 wrap-anywhere">{sentence(state.message)} No reset was used.</span>
+        <Button variant="ghost" size="xs" onClick={() => setState({ kind: "idle" })}>
+          Dismiss
+        </Button>
+      </div>
+    ) : null;
+  return { control, note };
+}
+
+const noteLine = "flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1 text-xs text-foreground/80";
+
+function UnresolvedNote({
+  state,
+  now,
+  onCheck,
+  onRetry,
+  onCancel,
+  onConfirm,
+}: {
+  readonly state: Unresolved;
+  readonly now: number;
+  readonly onCheck: () => void;
+  readonly onRetry: () => void;
+  readonly onCancel: () => void;
+  readonly onConfirm: () => void;
+}) {
+  const { requestId } = state.spend;
+  const id = (
+    <span className="tabular-nums" title={requestId}>
+      {shortId(requestId)}
+    </span>
+  );
+  const replay = replayable(state, now);
+  return (
+    <div
+      role="status"
+      className={noteLine}
+      data-reset-note={state.status}
+      data-request-id={requestId}
+    >
+      <span className="min-w-0 wrap-anywhere">
+        {state.status === "unread" ? (
+          <>Couldn't read the status of reset request {id}, so a new one can't start yet.</>
+        ) : (
+          <>
+            {state.status === "unrecorded" ? (
+              <>Reset request {id} didn't reach the server, or its answer was lost. </>
+            ) : (
+              <>Status unknown for reset request {id}. </>
+            )}
+            {replay
+              ? "Retry sends the same request, so it can't spend a second reset."
+              : "Its retry window ended, so nothing more is sent and no new reset can start."}
+          </>
+        )}
+        {state.reason !== undefined && (
+          <span className="text-muted-foreground" data-reset-reason>
+            {" "}
+            Last answer: {sentence(state.reason)}
+          </span>
+        )}
+      </span>
+      {state.status === "unread" ? (
+        <Button variant="outline" size="xs" onClick={onCheck}>
+          Check again
+        </Button>
+      ) : (
+        replay && (
+          <Confirm
+            open={state.confirming === true}
+            onOpen={onRetry}
+            onCancel={onCancel}
+            onConfirm={onConfirm}
+            title="Retry the reset request?"
+            action="Retry"
+            trigger={
+              <Button variant="outline" size="xs">
+                Retry
+              </Button>
+            }
+          >
+            <p>
+              Sends request {shortId(requestId)} again, unchanged, so it can't spend a second reset.
+            </p>
+          </Confirm>
+        )
+      )}
+    </div>
+  );
+}
+
+/**
+ * The human decision before any spend. Opening is the caller's job after its fresh reads; Escape
+ * and outside clicks cancel, and Cancel takes focus so a stray Enter or double click spends nothing.
+ */
+function Confirm({
+  open,
+  onOpen,
+  onCancel,
+  onConfirm,
+  title,
+  action,
+  trigger,
+  children,
+}: {
+  readonly open: boolean;
+  readonly onOpen: () => void;
+  readonly onCancel: () => void;
+  readonly onConfirm: () => void;
+  readonly title: string;
+  readonly action: string;
+  readonly trigger: ReactNode;
+  readonly children: ReactNode;
+}) {
+  return (
+    <Popover open={open} onOpenChange={(next) => (next ? onOpen() : onCancel())}>
+      <PopoverTrigger asChild>{trigger}</PopoverTrigger>
+      <PopoverContent
+        role="dialog"
+        aria-label={title}
+        data-reset-confirm
+        onOpenAutoFocus={(event) => {
+          event.preventDefault();
+          const content = event.currentTarget;
+          if (content instanceof HTMLElement)
+            content.querySelector<HTMLButtonElement>("[data-reset-cancel]")?.focus();
+        }}
+      >
+        <div className="grid gap-2 text-[13px] text-muted-foreground">
+          <h3 className="text-sm font-semibold text-foreground">{title}</h3>
+          {children}
+          <div className="mt-0.5 flex justify-end gap-2">
+            <Button variant="outline" size="xs" data-reset-cancel onClick={onCancel}>
+              Cancel
+            </Button>
+            <Button size="xs" onClick={onConfirm}>
+              {action}
+            </Button>
+          </div>
+        </div>
+      </PopoverContent>
+    </Popover>
+  );
+}
