diff --git a/apps/hosted/server/src/implementation/host-managed-accounts.ts b/apps/hosted/server/src/implementation/host-managed-accounts.ts
new file mode 100644
index 0000000..f75f94f
--- /dev/null
+++ b/apps/hosted/server/src/implementation/host-managed-accounts.ts
@@ -0,0 +1,65 @@
+/**
+ * Credentials the host created for its own use. People never pick, list or count them; tool calls
+ * and the machine views that run with them still see every account.
+ */
+import {
+  isProvisionedMethod,
+  StorageError,
+  type Account,
+  type AccountId,
+  type Executor,
+} from "@executor-js/sdk/core";
+import { Effect, Schema } from "effect";
+import type { SqlClient } from "effect/sql";
+import { HostManagedAccountRecords } from "../contracts/host-managed-accounts.ts";
+import { organizationOwner, type OrganizationId } from "../contracts/organization.ts";
+
+const KeyAccounts = Schema.Array(
+  Schema.Struct({ accounts: Schema.Record(Schema.String, Schema.String) }),
+);
+
+/**
+ * The listed accounts the host manages: a method declared `provisioned`, a default access key
+ * organization setup recorded for a member, or one the host's own records prove. Labels are never
+ * evidence; a person can name any account anything.
+ */
+export const hostManagedAccounts = (
+  executor: Executor,
+  sql: SqlClient.SqlClient,
+  organization: OrganizationId,
+  accounts: readonly Account[],
+) =>
+  Effect.gen(function* () {
+    const managed = new Set<AccountId>();
+    if (accounts.length === 0) return managed;
+    const definitions = new Map(
+      (yield* executor.accounts.providers({ owner: organizationOwner(organization) })).map(
+        (provider) => [provider.id, provider.definition],
+      ),
+    );
+    for (const account of accounts) {
+      const definition = definitions.get(account.provider);
+      if (definition !== undefined && isProvisionedMethod(definition, account.method))
+        managed.add(account.id);
+    }
+    // Default access keys predate the marker. Organization setup records each one it minted, and
+    // only ever records keys it minted.
+    const [recorded] = yield* sql`select
+        coalesce(metadata::jsonb -> 'executorKeyAccounts', '{}'::jsonb) as accounts
+      from "organization" where id = ${organization}`.pipe(
+      Effect.flatMap(Schema.decodeUnknownEffect(KeyAccounts)),
+      Effect.mapError(() => new StorageError()),
+    );
+    const keys = new Set(Object.values(recorded?.accounts ?? {}));
+    for (const account of accounts)
+      if (account.method === "apiKey" && keys.has(account.id)) managed.add(account.id);
+    const remaining = accounts.filter((account) => !managed.has(account.id));
+    if (remaining.length > 0)
+      for (const id of yield* (yield* HostManagedAccountRecords)({
+        sql,
+        organization,
+        accounts: remaining,
+      }))
+        if (remaining.some((account) => account.id === id)) managed.add(id);
+    return managed;
+  });
diff --git a/apps/hosted/server/src/implementation/pool-access-provenance.ts b/apps/hosted/server/src/implementation/pool-access-provenance.ts
new file mode 100644
index 0000000..c09d28c
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-access-provenance.ts
@@ -0,0 +1,36 @@
+/**
+ * Pool access tokens are the host's own, including ones a repair replaced before the token method
+ * was declared `provisioned`. Provisioning records each person's pool app in organization metadata
+ * (`basaltPools`) and saves its token as that person's personal `token` account of the pool
+ * requirement's provider. A retained version of that recorded app must declare the account's exact
+ * provider for its `pool` requirement. Labels, provider names and credentials prove nothing and are
+ * never read. Anything else, such as a pool app that no longer exists, stays listed.
+ */
+import { AccountId, StorageError } from "@executor-js/sdk/core";
+import { Effect, Schema } from "effect";
+import type { HostManagedAccountInput } from "../contracts/host-managed-accounts.ts";
+import { organizationOwner } from "../contracts/organization.ts";
+
+const Proven = Schema.Array(Schema.Struct({ account: AccountId }));
+
+export const poolAccessRecords = ({ sql, organization, accounts }: HostManagedAccountInput) =>
+  Effect.gen(function* () {
+    const tokens = accounts.flatMap((account) => (account.method === "token" ? [account.id] : []));
+    if (tokens.length === 0) return [];
+    const rows = yield* sql`select a.id as account
+      from executor_accounts a
+      join hosted_account_access p on p.account_id = a.id
+        and p.organization_id = ${organization} and p.kind = 'personal'
+      join "organization" team on team.id = ${organization}
+      join executor_apps app on app.owner = a.owner
+        and app.id = coalesce(team.metadata::jsonb -> 'basaltPools', '{}'::jsonb)
+          -> p.personal_user_id ->> 'app'
+      where a.owner = ${organizationOwner(organization)} and a.method = 'token'
+        and ${sql.in("a.id", tokens)}
+        and exists (select 1 from executor_deployments d where d.code = app.code
+          and d.requirements::jsonb -> 'accounts' -> 'pool' ->> 'provider' = a.provider)`.pipe(
+      Effect.flatMap(Schema.decodeUnknownEffect(Proven)),
+      Effect.mapError(() => new StorageError()),
+    );
+    return rows.map((row) => row.account);
+  });
