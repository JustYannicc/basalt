+  readonly sql: SqlClient.SqlClient;
+  readonly organization: OrganizationId;
+  /** Accounts the method marker and the default access records did not already prove. */
+  readonly accounts: readonly Account[];
+}
+
+/**
+ * Accounts saved before their method was declared `provisioned` carry no marker. A host that kept
+ * its own provisioning records can still prove them here, from those records and the accounts'
+ * stored provider and method. It gets no executor, so it cannot read credentials. Anything it
+ * cannot prove stays listed.
+ */
+export const HostManagedAccountRecords = Context.Reference<
+  (input: HostManagedAccountInput) => Effect.Effect<readonly AccountId[], StorageError>
+>("hosted/HostManagedAccountRecords", { defaultValue: () => () => Effect.succeed([]) });
