diff --git a/e2e/tests/host-managed-accounts.spec.ts b/e2e/tests/host-managed-accounts.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/host-managed-accounts.spec.ts
@@ -0,0 +1,302 @@
+/**
+ * People's account lists leave out the host's own credentials: a method declared `provisioned`,
+ * a default access key, or one the host's provisioning records prove. Labels prove nothing, and
+ * an editor still sees a host credential that needs repair.
+ */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { Evidence } from "../support/evidence.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { managementApp } from "../support/management-app.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+const App = Schema.Struct({
+  id: Schema.String,
+  activeVersion: Schema.String,
+  requirements: Schema.Struct({
+    accounts: Schema.Struct({ pool: Schema.Struct({ provider: Schema.String }) }),
+  }),
+});
+const source = (
+  provisioned: boolean,
+  broken = false,
+) => `import { defineApp, defineProvider, object, query, router, secrets, string } from "apps";
+const pool = defineProvider({ name: "Signalbox pool", auth: {
+  token: secrets({ label: "Pool access", ${provisioned ? "provisioned: true," : ""} fields: object({ token: string() }) }),
+}, async health() { ${broken ? 'throw new Error("Host access needs repair");' : "return {};"} } });
+const subscription = defineProvider({ name: "Subscription", auth: { key: secrets({ label: "Subscription", fields: object({ token: string() }) }) } });
+const notes = defineProvider({ name: "Notes", auth: { token: secrets({ label: "Notes token", fields: object({ token: string() }) }) } });
+export default defineApp({ app: { accounts: { pool } }, user: { accounts: { subscription, notes } } }, {
+  tools: router({ present: query({ input: object({}) }, async () => ({ valid: true })) }),
+});`;
+const Listed = Schema.Struct({ accounts: Schema.Array(Schema.Unknown) });
+const pool = /^Signalbox pool(?: \(pool\))?$/;
+const subscriptionRegion = /^Subscription(?: \(subscription\))?$/;
+
+layer(HostedLive, { excludeTestServices: true })("Host-managed account visibility", (it) => {
+  it.effect(scenarios.hostManagedAccounts.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          browser = yield* Browser,
+          evidence = yield* Evidence;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const files = (provisioned: boolean, broken = false) => [
+          { path: "index.ts", content: source(provisioned, broken) },
+          appsManifest,
+        ];
+        const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: "Synthetic pool",
+          files: files(false),
+        });
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const app = yield* body(App, deployed),
+          path = `${prefix}/apps/${app.id}`;
+        const saved: string[] = [];
+        yield* Effect.addFinalizer(() =>
+          serverControl("start").pipe(
+            Effect.andThen(
+              Effect.gen(function* () {
+                yield* api.request(actors.owner, "DELETE", path);
+                for (const account of saved)
+                  yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`);
+              }),
+            ),
+            Effect.orDie,
+          ),
+        );
+        const connect = (scope: "app" | "user", slot: string, method: string, label: string) =>
+          Effect.gen(function* () {
+            const pending = yield* body(
+              Resource,
+              yield* api.request(
+                actors.owner,
+                "POST",
+                `${path}/accounts/${scope}/${slot}/connections`,
+                {},
+              ),
+            );
+            const response = yield* api.request(
+              actors.owner,
+              "POST",
+              `${prefix}/connections/${pending.id}/submit`,
+              { method, label, fields: { token: `synthetic-${saved.length}` } },
+            );
+            expect(response.status, JSON.stringify(response.body)).toBe(200);
+            const id = (yield* body(Resource, response)).id;
+            saved.push(id);
+            return id;
+          });
+        // A pool access token replaced before its method was declared: saved, unlinked, renamed.
+        const retired = yield* connect("app", "pool", "token", "Pool access");
+        const current = yield* connect("app", "pool", "token", "Pool access");
+        expect(
+          (yield* api.request(actors.owner, "PATCH", `${prefix}/accounts/${retired}`, {
+            label: "Pool access (retired)",
+          })).status,
+        ).toBe(200);
+        const subscription = yield* connect("user", "subscription", "key", "Personal subscription");
+        // Someone's own token with the same method name and label is still their sign-in.
+        const lookalike = yield* connect("user", "notes", "token", "Pool access (retired)");
+        const access = yield* body(
+          Schema.Struct({ revision: Schema.String }),
+          yield* api.request(actors.owner, "GET", `${path}/access`),
+        );
+        expect(
+          (yield* api.request(actors.owner, "PATCH", `${path}/access`, {
+            revision: access.revision,
+            audience: { kind: "everyone" },
+          })).status,
+        ).toBe(200);
+        const updated = yield* api.request(actors.owner, "POST", `${path}/deploy`, {
+          files: files(true),
+        });
+        expect(updated.status, JSON.stringify(updated.body)).toBe(200);
+        const marked = (yield* body(Schema.Struct({ app: App }), updated)).app;
+        expect(marked.requirements.accounts.pool.provider).not.toBe(
+          app.requirements.accounts.pool.provider,
+        );
+        // The host replaces its current token under the marked provider, and its provisioning
+        // record names the holder's pool app; the retired token keeps the earlier provider.
+        const [, recorded] = yield* legacyStorage([
+          {
+            sql: "UPDATE executor_accounts SET provider = $1 WHERE id = $2",
+            params: [marked.requirements.accounts.pool.provider, current],
+          },
+          {
+            sql: `UPDATE "organization" SET metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb),
+              '{basaltPools}', jsonb_build_object(p.personal_user_id,
+              jsonb_build_object('app', $1::text, 'version', $2::text)))::text
+              FROM hosted_account_access p
+              WHERE "organization".id = $3 AND p.account_id = $4 AND p.kind = 'personal'
+              RETURNING p.personal_user_id`,
+            params: [app.id, marked.activeVersion, actors.organization.id, retired],
+          },
+        ]);
+        expect(recorded).toHaveLength(1);
+        yield* serverControl("start");
+        const key = (yield* managementApp(actors.owner)).account;
+        const check = () =>
+          api.request(actors.owner, "POST", `${prefix}/accounts/${current}/health`);
+        expect((yield* check()).status).toBe(200);
+
+        // People's directory lists their own sign-ins; the machine inventory keeps every account.
+        const listed = (route: string) =>
+          Effect.gen(function* () {
+            const response = yield* api.request(actors.owner, "GET", `${prefix}/${route}`);
+            expect(response.status, JSON.stringify(response.body)).toBe(200);
+            const text = JSON.stringify((yield* body(Listed, response)).accounts);
+            return (id: string) => text.includes(id);
+          });
+        const people = yield* listed("resources"),
+          machine = yield* listed("inventory");
+        for (const id of [retired, current, key]) {
+          expect(people(id), id).toBe(false);
+          expect(machine(id), id).toBe(true);
+        }
+        for (const id of [subscription, lookalike]) {
+          expect(people(id), id).toBe(true);
+          expect(machine(id), id).toBe(true);
+        }
+
+        yield* browser.login(actors.owner);
+        yield* browser.use("Open saved sign-ins", (page) =>
+          page.goto(`/org/${actors.organization.slug}/accounts`),
+        );
+        yield* browser.use("Wait for the subscription row", (page) =>
+          page.getByText("Personal subscription", { exact: true }).waitFor(),
+        );
+        yield* evidence.attach(
+          "accounts.png",
+          "image/png",
+          yield* browser.use("Capture Accounts", (page) => page.screenshot({ fullPage: true })),
+        );
+        const rows = yield* browser.use("Count host and lookalike rows", (page) =>
+          Promise.all([
+            page.locator("main").getByText("Pool access (retired)", { exact: true }).count(),
+            page.locator("main").getByText("Pool access", { exact: true }).count(),
+            page
+              .locator("main")
+              .getByText(/^Your .+ access$/)
+              .count(),
+          ]),
+        );
+        expect(rows).toEqual([1, 0, 0]);
+
+        yield* browser.use("Open Apps", (page) =>
+          page.goto(`/org/${actors.organization.slug}/apps`),
+        );
+        const card = yield* browser.use("Read the pool card", (page) =>
+          page.getByRole("link", { name: /^Open Synthetic pool/ }).innerText(),
+        );
+        yield* evidence.attach(
+          "apps.png",
+          "image/png",
+          yield* browser.use("Capture Apps", (page) => page.screenshot({ fullPage: true })),
+        );
+        // The host's token fills the app requirement without counting as an account for everyone.
+        expect(card).toContain("Personal subscription");
+        expect(card).not.toContain("for everyone");
+
+        yield* browser.use("Open the pool's Accounts", (page) =>
+          page.goto(`/org/${actors.organization.slug}/apps/${app.id}?view=accounts`),
+        );
+        yield* browser.use("Wait for Subscription", (page) =>
+          page.getByRole("region", { name: subscriptionRegion }).waitFor(),
+        );
+        yield* evidence.attach(
+          "pool-accounts.png",
+          "image/png",
+          yield* browser.use("Capture the pool's Accounts", (page) =>
+            page.screenshot({ fullPage: true }),
+          ),
+        );
+        expect(
+          yield* browser.use("A healthy host requirement has no section", (page) =>
+            page.getByRole("region", { name: pool }).count(),
+          ),
+        ).toBe(0);
+
+        expect(
+          (yield* api.request(actors.owner, "POST", `${path}/deploy`, { files: files(true, true) }))
+            .status,
+        ).toBe(200);
+        const failed = yield* check();
+        expect(failed.status, JSON.stringify(failed.body)).toBe(200);
+        expect(JSON.stringify(failed.body)).toContain("Host access needs repair");
+        yield* browser.use("Reload failed host access", (page) => page.reload());
+        yield* browser.use("An editor sees the failed check", (page) =>
+          page
+            .getByRole("region", { name: pool })
+            .getByText("Host access needs repair", { exact: true })
+            .waitFor(),
+        );
+        yield* evidence.attach(
+          "pool-broken-check.png",
+          "image/png",
+          yield* browser.use("Capture the failed requirement", (page) =>
+            page.screenshot({ fullPage: true }),
+          ),
+        );
+        yield* browser.login(actors.member);
+        yield* browser.use("Open host access as a member", (page) =>
+          page.goto(`/org/${actors.organization.slug}/apps/${app.id}?view=accounts`),
+        );
+        yield* browser.use("Wait for member Subscription", (page) =>
+          page.getByRole("region", { name: subscriptionRegion }).waitFor(),
+        );
+        yield* evidence.attach(
+          "pool-broken-member.png",
+          "image/png",
+          yield* browser.use("Capture the member's view", (page) =>
+            page.screenshot({ fullPage: true }),
+          ),
+        );
+        expect(
+          yield* browser.use("Only editors see host repairs", (page) =>
+            page.getByRole("region", { name: pool }).count(),
+          ),
+        ).toBe(0);
+        yield* legacyStorage([
+          {
+            sql: "DELETE FROM hosted_app_account_links WHERE app = $1 AND requirement = 'pool'",
+            params: [app.id],
+          },
+        ]);
+        yield* serverControl("start");
+        const choices = yield* api.request(actors.owner, "GET", `${path}/accounts/app/pool`);
+        expect(choices.status, JSON.stringify(choices.body)).toBe(200);
+        expect((yield* body(Listed, choices)).accounts).toEqual([]);
+        yield* browser.login(actors.owner);
+        yield* browser.use("Open missing host access as an editor", (page) =>
+          page.goto(`/org/${actors.organization.slug}/apps/${app.id}?view=accounts`),
+        );
+        yield* browser.use("An editor sees missing host access", (page) =>
+          page
+            .getByRole("region", { name: pool })
+            .getByText(
+              "This account is set up automatically and is missing. Ask an administrator to restore it.",
+              { exact: true },
+            )
+            .waitFor(),
+        );
+        yield* evidence.attach(
+          "pool-unlinked.png",
+          "image/png",
+          yield* browser.use("Capture missing host access", (page) =>
+            page.screenshot({ fullPage: true }),
+          ),
+        );
+      }),
+    ),
+  );
+});
