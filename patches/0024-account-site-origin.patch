+
+const suffixHost = (value: string): string | undefined => {
+  const parsed = URL.parse(`https://${value}`);
+  return parsed !== null && parsed.hostname === value.toLowerCase() && parsed.port === ""
+    ? parsed.hostname
+    : undefined;
