@@ -0,0 +1,504 @@
+/** App checks use real linked backend credentials and expose bounded display data through HTTP and the row. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { App, Resource } from "../support/contracts.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { Evidence } from "../support/evidence.ts";
+import {
+  accountStatusBackend,
+  accountStatusSource,
+  displayedStatus,
+} from "../support/account-status-fixture.ts";
+import {
+  interactiveAccountBackend,
+  interactiveBackendKey,
+} from "../support/interactive-account-backend.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Detail = Schema.Struct({
+  health: Schema.Struct({
+    info: Schema.Unknown,
+    apps: Schema.Array(
+      Schema.Struct({
+        checkable: Schema.Boolean,
+        check: Schema.NullOr(
+          Schema.Struct({
+            status: Schema.String,
+            current: Schema.Boolean,
+            displayStatus: Schema.optionalKey(Schema.Unknown),
+          }),
+        ),
+      }),
+    ),
+  }),
+});
+const Health = Detail.fields.health;
+const Connected = Schema.Struct({ state: Schema.Literal("connected"), account: Resource });
+
+layer(HostedLive, { excludeTestServices: true })("Account display status", (it) => {
+  it.effect(scenarios.accountDisplayStatus.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          browser = yield* Browser,
+          evidence = yield* Evidence;
+        const backend = yield* interactiveAccountBackend;
+        const statusBackend = yield* accountStatusBackend;
+        const longName = "Synthetic subscription account with a very long display name";
+        const longEmail = `fixture-${"unbreakable-".repeat(7)}account@example.test`;
+        yield* backend.setAccountInfo({
+          displayName: longName,
+          email: longEmail,
+          avatarUrl: `${statusBackend.origin}/logo.svg`,
+        });
+        yield* statusBackend.answer({
+          status: 200,
+          body: {
+            accountInfo: {
+              displayName: longName,
+              email: longEmail,
+              avatarUrl: `${statusBackend.origin}/logo.svg`,
+            },
+            status: displayedStatus,
+            privateCredential: "must-not-cross-the-check-boundary",
+          },
+        });
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: "Account status fixture",
+          files: [
+            {
+              path: "index.ts",
+              content: accountStatusSource(backend.origin, statusBackend.origin),
+            },
+            appsManifest,
+          ],
+        });
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const app = yield* body(App, deployed),
+          path = `${prefix}/apps/${app.id}`;
+        const accounts: string[] = [];
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* api.request(actors.owner, "DELETE", path);
+            for (const account of accounts)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`);
+          }).pipe(Effect.orDie),
+        );
+        const connection = yield* body(
+          Resource,
+          yield* api.request(actors.owner, "POST", `${path}/accounts/app/backend/connections`, {}),
+        );
+        const saved = yield* api.request(
+          actors.owner,
+          "POST",
+          `${prefix}/connections/${connection.id}/submit`,
+          { method: "key", fields: { token: interactiveBackendKey } },
+        );
+        expect(saved.status, JSON.stringify(saved.body)).toBe(200);
+        accounts.push((yield* body(Resource, saved)).id);
+        const pending = yield* body(
+          Resource,
+          yield* api.request(
+            actors.owner,
+            "POST",
+            `${path}/accounts/user/identity/connections`,
+            {},
+          ),
+        );
+        const steps = `${prefix}/connections/${pending.id}/interactive`;
+        expect(
+          (yield* api.request(actors.owner, "POST", `${steps}/start`, { method: "device" })).status,
+        ).toBe(200);
+        yield* api.request(actors.owner, "GET", `${steps}/status`);
+        const connected = yield* body(
+          Connected,
+          yield* api.request(actors.owner, "GET", `${steps}/status`),
+        );
+        const account = connected.account.id;
+        accounts.push(account);
+        const accountPath = `${prefix}/accounts/${account}`;
+        const check = () =>
+          Effect.gen(function* () {
+            const response = yield* api.request(actors.owner, "POST", `${accountPath}/health`);
+            expect(response.status, JSON.stringify(response.body)).toBe(200);
+            expect(JSON.stringify(response.body)).not.toContain(
+              "must-not-cross-the-check-boundary",
+            );
+            expect(JSON.stringify(response.body)).not.toContain(interactiveBackendKey);
+            return yield* body(Health, response);
+          });
+        const health = yield* check();
+        expect(health.info).toMatchObject({ displayName: longName, email: longEmail });
+        expect(health.apps[0]).toMatchObject({
+          checkable: true,
+          check: { status: "healthy", current: true, displayStatus: displayedStatus },
+        });
+        expect(yield* statusBackend.calls).toBe(1);
+        expect(
+          (yield* body(Detail, yield* api.request(actors.owner, "GET", accountPath))).health,
+        ).toEqual(health);
+        yield* browser.login(actors.owner);
+        yield* browser.use("Open the account status row", (page) =>
+          page.goto(`/org/${actors.organization.slug}/apps/${app.id}?view=accounts`),
+        );
+        yield* browser.use("Wait for the account status", (page) =>
+          page
+            .getByRole("region", { name: "Your accounts", exact: true })
+            .getByRole("group", { name: "Account status badges", exact: true })
+            .getByText("Available", { exact: true })
+            .waitFor(),
+        );
+        const visible = yield* browser.use("Read the status row and accessible meter", (page) => {
+          const status = page
+            .getByRole("region", { name: "Your accounts", exact: true })
+            .getByRole("group", { name: "Account status details", exact: true });
+          const row = status.locator("xpath=ancestor::li[1]");
+          const header = row.locator("[data-account-row-header]");
+          const menu = row.locator("[data-account-row-menu]");
+          const badges = header.getByRole("group", { name: "Account status badges", exact: true });
+          const good = status.getByRole("meter", { name: "5h", exact: true });
+          const unknown = status.getByRole("meter", { name: "Weekly", exact: true });
+          const exhausted = status.getByRole("meter", { name: "Monthly", exact: true });
+          return Promise.all([
+            header.getByText("Pro", { exact: true }).count(),
+            good.getAttribute("aria-valuenow"),
+            good.getAttribute("data-meter-state"),
+            good.locator(".account-meter-fill").getAttribute("class"),
+            unknown.getAttribute("data-meter-state"),
+            unknown.getAttribute("class"),
+            status
+              .getByRole("meter", { name: "Daily", exact: true })
+              .getAttribute("data-meter-state"),
+            exhausted.getAttribute("data-meter-state"),
+            exhausted.getAttribute("class"),
+            exhausted
+              .locator("xpath=preceding-sibling::span[1]")
+              .locator("[data-meter-remaining]")
+              .locator("[data-meter-label]")
+              .getAttribute("class"),
+            status.getByText("Rem unknown", { exact: true }).count(),
+            status.innerText(),
+            header.getByText("Working", { exact: true }).count(),
+            row.locator("[data-account-name]").getAttribute("title"),
+            row
+              .locator("[data-account-name]")
+              .evaluate((element) => getComputedStyle(element).textOverflow),
+            row.locator("[data-account-identity]").getAttribute("title"),
+            row
+              .locator("[data-account-identity]")
+              .evaluate((element) => getComputedStyle(element).textOverflow),
+            row.locator('img[src$="/logo.svg"]').getAttribute("src"),
+            row.locator("[data-added-by-slot]").count(),
+            status.getByRole("meter", { name: "Daily", exact: true }).getAttribute("class"),
+            status
+              .getByRole("meter", { name: "Daily", exact: true })
+              .locator(".account-meter-fill")
+              .getAttribute("class"),
+            header.getByRole("group", { name: "Account status badges", exact: true }).innerText(),
+            menu.boundingBox(),
+            badges.boundingBox(),
+            row.boundingBox(),
+          ]);
+        });
+        expect(visible[0]).toBe(1);
+        expect(visible[1]).toBe("70");
+        expect(visible[2]).toBe("good");
+        expect(visible[3]).toContain("bg-emerald-500");
+        expect(visible[4]).toBe("unknown");
+        expect(visible[5]).toContain("repeating-linear-gradient");
+        expect(visible[6]).toBe("bad");
+        expect(visible[7]).toBe("exhausted");
+        expect(visible[8]).toContain("bg-destructive/20");
+        expect(visible[9]).toContain("text-destructive");
+        expect(visible[10]).toBe(1);
+        expect(visible[11]).toContain("Rem 70%");
