diff --git a/e2e/tests/provisioned-accounts.spec.ts b/e2e/tests/provisioned-accounts.spec.ts
new file mode 100644
index 00000000..61a984af
--- /dev/null
+++ b/e2e/tests/provisioned-accounts.spec.ts
@@ -0,0 +1,161 @@
+/** Retained host credentials survive adopting a provisioned declaration; browser and HTTP cannot replace them. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { Evidence } from "../support/evidence.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { serverControl } from "../support/server-control.ts";
+import { provisionedSource as source } from "../support/provisioned-source.ts";
+import { scenarios } from "../test-plan.ts";
+
+const App = Schema.Struct({
+  id: Schema.String,
+  requirements: Schema.Struct({
+    accounts: Schema.Struct({ service: Schema.Struct({ provider: Schema.String }) }),
+  }),
+});
+
+layer(HostedLive, { excludeTestServices: true })("Provisioned accounts", (it) => {
+  it.effect(scenarios.provisionedAccounts.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          browser = yield* Browser,
+          evidence = yield* Evidence;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: "Host access fixture",
+          files: [{ path: "index.ts", content: source(false) }, appsManifest],
+        });
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const app = yield* body(App, deployed),
+          path = `${prefix}/apps/${app.id}`;
+        let account: string | undefined;
+        yield* Effect.addFinalizer(() =>
+          serverControl("start").pipe(
+            Effect.andThen(
+              Effect.gen(function* () {
+                yield* api.request(actors.owner, "DELETE", path);
+                if (account !== undefined)
+                  yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`);
+              }),
+            ),
+            Effect.orDie,
+          ),
+        );
+        const connections = `${path}/accounts/user/service/connections`;
+        const pending = yield* body(
+          Resource,
+          yield* api.request(actors.owner, "POST", connections, {}),
+        );
+        const saved = yield* api.request(
+          actors.owner,
+          "POST",
+          `${prefix}/connections/${pending.id}/submit`,
+          {
+            method: "key",
+            label: "Host account",
+            fields: { token: "fixture-host-key" },
+          },
+        );
+        expect(saved.status, JSON.stringify(saved.body)).toBe(200);
+        account = (yield* body(Resource, saved)).id;
+        yield* browser.login(actors.owner);
+        yield* browser.use("Open the previous connection controls", (page) =>
+          page.goto(`/org/${actors.organization.slug}/apps/${app.id}?view=accounts`),
+        );
+        yield* browser.use("The previous declaration invites another connection", (page) =>
+          page.getByRole("button", { name: "Connect new account", exact: true }).waitFor(),
+        );
+        yield* evidence.attach(
+          "provisioned-before.png",
+          "image/png",
+          yield* browser.use("Capture the previous controls", (page) =>
+            page.screenshot({ fullPage: true }),
+          ),
+        );
+        const updated = yield* api.request(actors.owner, "POST", `${path}/deploy`, {
+          files: [{ path: "index.ts", content: source(true) }, appsManifest],
+        });
+        expect(updated.status, JSON.stringify(updated.body)).toBe(200);
+        const current = yield* body(Schema.Struct({ app: App }), updated);
+        // Host provisioning has no HTTP credential-write endpoint. Retain the pre-declaration
+        // account, as a host upgrading its existing provisioned account does, using the supported
+        // isolated database fixture. Normal account setup above still went through the product.
+        yield* legacyStorage([
+          {
+            sql: "UPDATE executor_accounts SET provider = $1 WHERE id = $2",
+            params: [current.app.requirements.accounts.service.provider, account],
+          },
+        ]);
+        yield* serverControl("start");
+        for (const input of [{}, { account }]) {
+          const refused = yield* api.request(actors.owner, "POST", connections, input);
+          expect(refused.status, JSON.stringify(refused.body)).toBe(422);
+          expect(refused.body).toMatchObject({
+            _tag: "AccountProvisioned",
+            message: expect.stringContaining("automatically"),
+          });
+        }
+        const used = yield* api.request(actors.owner, "POST", `${path}/tools/call`, {
+          tool: "present",
+          kind: "query",
+          input: {},
+        });
+        expect(used.status, JSON.stringify(used.body)).toBe(200);
+        expect(used.body).toMatchObject({ valid: true });
+        yield* browser.use("Reload the provisioned account row", (page) => page.reload());
+        yield* browser.use("Wait for the provisioned account identity", (page) =>
+          page.getByText("Host account", { exact: true }).waitFor(),
+        );
+        const provisionedText = yield* browser.use("Read the provisioned account section", (page) =>
+          page.getByRole("region", { name: "Your accounts", exact: true }).innerText(),
+        );
+        const accountRow = yield* browser.use(
+          "Read the provisioned row label and attribution slot",
+          (page) => {
+            const row = page
+              .getByRole("region", { name: "Your accounts", exact: true })
+              .getByText("Host account", { exact: true })
+              .locator("xpath=ancestor::li[1]");
+            return Promise.all([
+              row.locator("[data-account-provisioned]").innerText(),
+              row.locator("[data-added-by-slot]").innerText(),
+            ]);
+          },
+        );
+        yield* evidence.attach(
+          "provisioned-after.png",
+          "image/png",
+          yield* browser.use("Capture automatic setup", (page) =>
+            page.screenshot({ fullPage: true }),
+          ),
+        );
+        expect(provisionedText).toContain("Set up automatically");
+        expect(accountRow).toEqual(["Set up automatically", ""]);
+        yield* browser.use("Wait for automatic setup", (page) =>
+          page.locator("[data-account-provisioned]").waitFor(),
+        );
+        const actions = yield* browser.use("Read provisioned row actions", (page) =>
+          Promise.all([
+            page.getByRole("button", { name: "Connect new account", exact: true }).count(),
+            page.getByRole("button", { name: "Reconnect", exact: true }).count(),
+            page.getByRole("button", { name: "Manage Host account", exact: true }).count(),
+            page.getByRole("button", { name: "Update credentials", exact: true }).count(),
+            page
+              .getByRole("menuitem", { name: /Remove|Delete|Update credentials|Reconnect/ })
+              .count(),
+          ]),
+        );
+        expect(actions).toEqual([0, 0, 0, 0, 0]);
+      }),
+    ),
+  );
+});
diff --git a/e2e/tests/provisioned-link-boundary.spec.ts b/e2e/tests/provisioned-link-boundary.spec.ts
new file mode 100644
index 00000000..67f7d976
--- /dev/null
+++ b/e2e/tests/provisioned-link-boundary.spec.ts
@@ -0,0 +1,187 @@
+import { Resource } from "../support/contracts.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { provisionedSource } from "../support/provisioned-source.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { serverControl } from "../support/server-control.ts";
+/** Radio linking and agent connection policies share the same provisioned replacement boundary. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { randomUUID } from "node:crypto";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { scenarios } from "../test-plan.ts";
+
+const App = Schema.Struct({
+  id: Schema.String,
+  requirements: Schema.Struct({
+    accounts: Schema.Struct({ service: Schema.Struct({ provider: Schema.String }) }),
+  }),
+});
+const provisionedLinkFixture = Effect.gen(function* () {
+  const api = yield* Api,
+    actors = yield* Actors;
+  const prefix = `/api/organizations/${actors.organization.id}`;
+  const files = (flag: boolean) => [
+    {
+      path: "index.ts",
+      content: provisionedSource(flag, true).replace(
+        "service: access",
+        "service: access, saved: access.many()",
+      ),
+    },
+    appsManifest,
+  ];
+  const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+    name: "Protected link fixture",
+    files: files(false),
+  });
+  expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+  const app = yield* body(App, deployed),
+    path = `${prefix}/apps/${app.id}`;
+  const ids: string[] = [];
+  yield* Effect.addFinalizer(() =>
+    Effect.gen(function* () {
+      yield* serverControl("start");
+      yield* api.request(actors.owner, "DELETE", path);
+      for (const id of ids) yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${id}`);
+    }).pipe(Effect.orDie),
+  );
+  const add = (slot: string, method: string, label: string, token: string) =>
+    Effect.gen(function* () {
+      const pending = yield* body(
+        Resource,
+        yield* api.request(actors.owner, "POST", `${path}/accounts/user/${slot}/connections`, {}),
+      );
+      const response = yield* api.request(
+        actors.owner,
+        "POST",
+        `${prefix}/connections/${pending.id}/submit`,
+        { method, label, fields: { token } },
+      );
+      expect(response.status, JSON.stringify(response.body)).toBe(200);
+      const account = (yield* body(Resource, response)).id;
+      ids.push(account);
+      return account;
+    });
+  const provisioned = yield* add("service", "key", "Host account", "fixture-host-key");
+  const ordinary = yield* add("saved", "manual", "Ordinary account", "ordinary-fixture-key");
+  expect(
+    (yield* api.request(actors.owner, "DELETE", `${path}/accounts/user/saved/${ordinary}`)).status,
+  ).toBe(200);
+  const updated = yield* api.request(actors.owner, "POST", `${path}/deploy`, {
+    files: files(true),
+  });
+  expect(updated.status, JSON.stringify(updated.body)).toBe(200);
+  const current = yield* body(Schema.Struct({ app: App }), updated);
+  const assertRetained = Effect.gen(function* () {
+    const used = yield* api.request(actors.owner, "POST", `${path}/tools/call`, {
+      tool: "present",
+      kind: "query",
+      input: {},
+    });
+    expect(used.status, JSON.stringify(used.body)).toBe(200);
+    expect(used.body).toMatchObject({ valid: true });
+  });
+  return {
+    prefix,
+    path,
+    app: app.id,
+    provisioned,
+    ordinary,
+    provider: current.app.requirements.accounts.service.provider,
+    assertRetained,
+  };
+});
+
+layer(HostedLive, { excludeTestServices: true })("Provisioned link boundary", (it) => {
+  it.effect(scenarios.provisionedRadio.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const fixture = yield* provisionedLinkFixture,
+          actors = yield* Actors,
+          browser = yield* Browser;
+        yield* legacyStorage([
+          {
+            sql: "UPDATE executor_accounts SET provider = $1 WHERE id IN ($2, $3)",
+            params: [fixture.provider, fixture.provisioned, fixture.ordinary],
+          },
+        ]);
+        yield* serverControl("start");
+        yield* browser.login(actors.owner);
+        yield* browser.use("Open the provisioned account choices", (page) =>
+          page.goto(`/org/${actors.organization.slug}/apps/${fixture.app}?view=accounts`),
+        );
+        const status = yield* browser.use("Try the ordinary account radio", (page) =>
+          Promise.all([
+            page.waitForResponse(
+              (response) =>
+                response.request().method() === "PUT" &&
+                new URL(response.url()).pathname.endsWith(
+                  `/accounts/user/service/${fixture.ordinary}`,
+                ),
+            ),
+            page
+              .getByRole("region", { name: "Host access", exact: true })
+              .getByRole("radio", { name: "Ordinary account", exact: true })
+              .click(),
+          ]).then(([response]) => response.status()),
+        );
+        expect(status).toBe(422);
+        yield* fixture.assertRetained;
+      }),
+    ),
+  );
+  it.effect(scenarios.provisionedAgent.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const fixture = yield* provisionedLinkFixture,
+          actors = yield* Actors,
+          api = yield* Api;
+        yield* legacyStorage([
+          {
+            sql: "UPDATE executor_accounts SET provider = $1 WHERE id IN ($2, $3)",
+            params: [fixture.provider, fixture.provisioned, fixture.ordinary],
+          },
+        ]);
+        yield* serverControl("start");
+        const path = `${fixture.prefix}/mcp-connections`,
+          id = randomUUID();
+        yield* Effect.addFinalizer(() =>
+          api.request(actors.owner, "POST", `${path}/${id}/revoke`).pipe(Effect.orDie),
+        );
+        const apps = [
+          {
+            app: fixture.app,
+            runsAs: [{ kind: "account", id: fixture.ordinary }],
+            tools: { kind: "readOnly" },
+          },
+        ];
+        const response = yield* api.request(actors.owner, "POST", path, {
+          id,
+          name: "Protected agent",
+          apps,
+        });
+        expect(response.status, JSON.stringify(response.body)).toBe(422);
+        expect(response.body).toMatchObject({ _tag: "AccountProvisioned" });
+        yield* fixture.assertRetained;
+        const created = yield* api.request(actors.owner, "POST", path, {
+          id,
+          name: "Protected agent",
+          apps: [],
+        });
+        expect(created.status, JSON.stringify(created.body)).toBe(200);
+        const updated = yield* api.request(actors.owner, "PUT", `${path}/${id}`, {
+          name: "Protected agent",
+          apps,
+        });
+        expect(updated.status, JSON.stringify(updated.body)).toBe(422);
+        expect(updated.body).toMatchObject({ _tag: "AccountProvisioned" });
+        yield* fixture.assertRetained;
+      }),
+    ),
+  );
+});
diff --git a/e2e/tests/provisioned-mixed.spec.ts b/e2e/tests/provisioned-mixed.spec.ts
new file mode 100644
index 00000000..680fe1f8
--- /dev/null
+++ b/e2e/tests/provisioned-mixed.spec.ts
@@ -0,0 +1,150 @@
+/** Completion cannot replace a provisioned plain-slot link through a mixed provider. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { FetchHttpClient, HttpClient } from "effect/http";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { oauthSetupIssuer } from "../support/oauth-setup-issuer.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { serverControl } from "../support/server-control.ts";
+import { provisionedSource } from "../support/provisioned-source.ts";
+import { scenarios } from "../test-plan.ts";
+const App = Schema.Struct({
+  id: Schema.String,
+  requirements: Schema.Struct({
+    accounts: Schema.Struct({ service: Schema.Struct({ provider: Schema.String }) }),
+  }),
+});
+layer(HostedLive, { excludeTestServices: true })("Mixed provisioned methods", (it) => {
+  it.effect(scenarios.provisionedMixed.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          http = yield* HttpClient.HttpClient;
+        const issuer = yield* oauthSetupIssuer;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const files = (provisioned: boolean) => [
+          {
+            path: "index.ts",
+            content: provisionedSource(provisioned, true, issuer.origin)
+              .replace("string, oauth2", "string, oauth2, interactive")
+              .replace("auth: {", 'auth: { device: interactive({ label: "Device" }),')
+              .replace(
+                "tools: router(",
+                'connect: { service: { start: async () => ({ session: "fixture-session", message: "Fixture sign-in" }), status: async () => ({ state: "connected" as const, ref: "fixture-acquired-reference" }), remove: async () => {} } }, tools: router(',
+              ),
+          },
+          appsManifest,
+        ];
+        const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: "Mixed host credential fixture",
+          files: files(false),
+        });
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const app = yield* body(App, deployed),
+          path = `${prefix}/apps/${app.id}`;
+        let account: string | undefined;
+        yield* Effect.addFinalizer(() =>
+          serverControl("start").pipe(
+            Effect.andThen(
+              Effect.gen(function* () {
+                yield* api.request(actors.owner, "DELETE", path);
+                if (account !== undefined)
+                  yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`);
+              }),
+            ),
+            Effect.orDie,
+          ),
+        );
+        const pending = () =>
+          api
+            .request(actors.owner, "POST", `${path}/accounts/user/service/connections`, {})
+            .pipe(Effect.flatMap((r) => body(Resource, r)));
+        const connection = yield* pending();
+        const added = yield* api.request(
+          actors.owner,
+          "POST",
+          `${prefix}/connections/${connection.id}/submit`,
+          { method: "key", fields: { token: "fixture-host-key" } },
+        );
+        expect(added.status, JSON.stringify(added.body)).toBe(200);
+        account = (yield* body(Resource, added)).id;
+        const updated = yield* api.request(actors.owner, "POST", `${path}/deploy`, {
+          files: files(true),
+        });
+        expect(updated.status, JSON.stringify(updated.body)).toBe(200);
+        const current = yield* body(Schema.Struct({ app: App }), updated);
+        yield* legacyStorage([
+          {
+            sql: "UPDATE executor_accounts SET provider = $1 WHERE id = $2",
+            params: [current.app.requirements.accounts.service.provider, account],
+          },
+        ]);
+        yield* serverControl("start");
+        const manual = yield* pending();
+        const refused = yield* api.request(
+          actors.owner,
+          "POST",
+          `${prefix}/connections/${manual.id}/submit`,
+          { method: "manual", fields: { token: "ordinary-key" } },
+        );
+        expect(refused.status, JSON.stringify(refused.body)).toBe(422);
+        expect(refused.body).toMatchObject({ _tag: "AccountProvisioned" });
+        const oauth = yield* pending();
+        const started = yield* api.request(
+          actors.owner,
+          "POST",
+          `${prefix}/connections/${oauth.id}/oauth/start`,
+          { method: "browser" },
+        );
+        expect(started.status, JSON.stringify(started.body)).toBe(200);
+        const signIn = yield* body(Schema.Struct({ authorizationUrl: Schema.String }), started);
+        const callbackUrl = yield* Effect.scoped(
+          Effect.gen(function* () {
+            const response = yield* HttpClient.withScope(http).get(signIn.authorizationUrl);
+            expect(response.status).toBe(302);
+            if (response.headers.location === undefined)
+              return yield* Effect.die("No fixture callback");
+            return response.headers.location;
+          }),
+        ).pipe(Effect.provideService(FetchHttpClient.RequestInit, { redirect: "manual" }));
+        const completed = yield* api.request(
+          actors.owner,
+          "POST",
+          `${prefix}/connections/${oauth.id}/oauth/complete`,
+          { callbackUrl },
+        );
+        expect(completed.status, JSON.stringify(completed.body)).toBe(422);
+        expect(completed.body).toMatchObject({ _tag: "AccountProvisioned" });
+        const interactive = yield* pending();
+        const steps = `${prefix}/connections/${interactive.id}/interactive`;
+        expect(
+          (yield* api.request(actors.owner, "POST", `${steps}/start`, { method: "device" })).status,
+        ).toBe(200);
+        const finished = yield* api.request(actors.owner, "GET", `${steps}/status`);
+        expect(finished.status, JSON.stringify(finished.body)).toBe(422);
+        expect(finished.body).toMatchObject({ _tag: "AccountProvisioned" });
+        const used = yield* api.request(actors.owner, "POST", `${path}/tools/call`, {
+          tool: "present",
+          kind: "query",
+          input: {},
+        });
+        expect(used.status, JSON.stringify(used.body)).toBe(200);
+        expect(used.body).toMatchObject({ valid: true });
+        const stored = yield* legacyStorage([
+          {
+            sql: "SELECT id FROM executor_accounts WHERE provider = $1",
+            params: [current.app.requirements.accounts.service.provider],
+          },
+        ]);
+        expect(stored).toEqual([[{ id: account }]]);
+        yield* serverControl("start");
+      }),
+    ),
+  );
+});
