+import type { AccountStatus } from "apps";
+
+const tones = {
+  neutral: "bg-muted text-muted-foreground",
+  good: "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
+  warning: "bg-amber-500/10 text-amber-700 dark:text-amber-400",
+  bad: "bg-destructive/10 text-destructive",
+};
+
+const meterState = (remaining: number | null) =>
+  remaining === null
+    ? "unknown"
+    : remaining === 0
+      ? "exhausted"
+      : remaining >= 0.7
+        ? "good"
+        : remaining >= 0.3
+          ? "warn"
+          : "bad";
+
+const meterFill = {
+  good: "bg-emerald-500",
+  warn: "bg-amber-500",
+  bad: "bg-destructive",
+  exhausted: "bg-destructive",
+  unknown: "",
+};
+
+const resetLabel = (value: string | undefined) => {
+  if (value === undefined) return "Reset unknown";
+  const seconds = Math.round((new Date(value).getTime() - Date.now()) / 1000);
+  if (!Number.isFinite(seconds)) return "Reset unknown";
+  const units = [
+    [31_536_000, "year"],
+    [2_592_000, "month"],
+    [604_800, "week"],
+    [86_400, "day"],
+    [3_600, "hour"],
+    [60, "minute"],
+  ] as const;
+  const unit = units.find(([size]) => Math.abs(seconds) >= size);
+  if (unit === undefined) return seconds >= 0 ? "in less than a minute" : "less than a minute ago";
+  const amount = Math.max(1, Math.ceil(Math.abs(seconds) / unit[0]));
+  const count = `${amount} ${unit[1]}${amount === 1 ? "" : "s"}`;
+  return seconds >= 0 ? `in ${count}` : `${count} ago`;
+};
+
+/** Display only. Text never becomes HTML, links, credentials or an authorization decision. */
+export function AccountDisplayStatus({
+  status,
+  current,
+  part = "all",
+}: {
+  readonly status: AccountStatus;
+  readonly current: boolean;
+  readonly part?: "all" | "badges" | "details";
+}) {
+  const headerReset =
+    part === "badges" ? status.meters.find((meter) => meter.resetsAt !== undefined) : undefined;
+  return (
+    <span
+      role="group"
+      aria-label={
+        part === "all"
+          ? current
+            ? "Account status"
+            : "Account status, outdated"
+          : part === "badges"
+            ? current
+              ? "Account status badges"
+              : "Account status badges, outdated"
+            : current
+              ? "Account status details"
+              : "Account status details, outdated"
+      }
+      data-account-status-part={part}
+      className={`${part === "badges" ? "inline-flex min-w-0 items-center" : "flex w-full min-w-0 flex-col gap-2"} text-[11px] text-foreground/80`}
+    >
+      {(part === "all" || part === "badges") &&
+        (status.badges.length > 0 || headerReset !== undefined) && (
+          <span className="flex flex-wrap items-center gap-1.5">
+            {status.badges.map((badge, index) => (
+              <span
+                key={index}
+                className={`rounded-full px-2 py-0.5 font-medium wrap-anywhere ${current ? tones[badge.tone] : tones.neutral}`}
+              >
+                {badge.label}
+              </span>
+            ))}
+            {headerReset !== undefined && (
+              <span data-status-reset className="whitespace-nowrap text-muted-foreground">
+                Resets {resetLabel(headerReset.resetsAt)}
+              </span>
+            )}
+          </span>
+        )}
+      {(part === "all" || part === "details") && status.meters.length > 0 && (
+        <span className="flex min-w-0 flex-col gap-2">
+          {status.meters.map((meter, index) => {
+            const state = meterState(meter.remaining);
+            const percent =
+              meter.remaining === null ? undefined : Math.round(meter.remaining * 100);
+            const reset = resetLabel(meter.resetsAt);
+            const stateLabel = state === "warn" || state === "bad" ? " · Low" : "";
+            const remainingLabel =
+              percent === undefined ? "Remaining amount unknown" : `Rem ${percent}%${stateLabel}`;
+            return (
+              <span key={index} className="flex min-w-0 flex-col gap-1">
+                <span className="flex min-w-0 items-baseline justify-between gap-2">
+                  <span className="truncate font-medium text-foreground">{meter.label}</span>
+                  <span className="shrink-0 tabular-nums" data-meter-remaining>
+                    {percent === undefined ? "Rem unknown" : `Rem ${percent}%${stateLabel}`}
+                    {state === "exhausted" && (
+                      <span className="font-medium text-destructive" data-meter-label>
+                        {" · Exhausted"}
+                      </span>
+                    )}
+                  </span>
+                </span>
+                <span
+                  role="meter"
+                  aria-label={meter.label}
+                  aria-valuemin={0}
