++import * as Effect from "effect/Effect";
++import * as FileSystem from "effect/FileSystem";
++import * as Path from "effect/Path";
++import * as Result from "effect/Result";
++import { selectDockerBuildContext } from "../../Docker/BuildHash.ts";
++
++/** Docker consumes this private copy, so later source edits cannot poison a content-keyed registry entry. */
++export const snapshotContainerBuild = Effect.fn(function* (source: {
++  readonly context: string;
++  readonly dockerfile: string;
++}) {
++  const fs = yield* FileSystem.FileSystem;
++  const path = yield* Path.Path;
++  const selected = yield* selectDockerBuildContext(source);
++  const root = yield* fs.makeTempDirectoryScoped({ prefix: "alchemy-container-publication-" });
++  const context = path.join(root, "context");
++  yield* fs.makeDirectory(context);
++  const directories: Array<{ path: string; mode: number }> = [];
++  const links: string[] = [];
++  yield* Effect.addFinalizer(() => Effect.forEach(directories, (directory) =>
++    fs.chmod(directory.path, directory.mode | 0o700).pipe(Effect.ignore), { discard: true }));
++  for (const entry of (yield* fs.readDirectory(selected.context, { recursive: true })).sort()) {
++    if (!selected.includes(entry)) continue;
++    if (links.some((link) => entry.startsWith(`${link}${path.sep}`)))
++      return yield* Effect.fail(new Error("Container context changed entry type while freezing"));
++    const original = path.join(selected.context, entry);
++    const target = path.join(context, entry);
++    yield* fs.makeDirectory(path.dirname(target), { recursive: true });
++    const link = yield* Effect.result(fs.readLink(original));
++    if (Result.isSuccess(link)) {
++      yield* fs.symlink(link.success, target);
++      links.push(entry);
++      continue;
++    }
++    const info = yield* fs.stat(original);
++    if (info.type === "Directory") {
++      yield* fs.makeDirectory(target, { recursive: true });
++      directories.push({ path: target, mode: info.mode & 0o7777 });
++    } else if (info.type === "File") {
++      yield* fs.copyFile(original, target);
++      yield* fs.chmod(target, info.mode & 0o7777);
++    } else return yield* Effect.fail(new Error("Unsupported container build context entry"));
++  }
++  for (const directory of [...directories].reverse()) yield* fs.chmod(directory.path, directory.mode);
++  const dockerfile = selected.dockerfilePath === undefined
++    ? path.join(root, "Dockerfile")
++    : path.join(context, selected.dockerfilePath);
++  if (selected.dockerfilePath === undefined) {
++    yield* fs.copyFile(selected.dockerfile, dockerfile);
++    if (yield* fs.exists(`${selected.dockerfile}.dockerignore`))
++      yield* fs.copyFile(`${selected.dockerfile}.dockerignore`, `${dockerfile}.dockerignore`);
++  }
++  return { context, dockerfile };
