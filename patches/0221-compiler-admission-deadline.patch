diff --git a/apps/hosted/cloud/src/implementation/compiler-request.ts b/apps/hosted/cloud/src/implementation/compiler-request.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/cloud/src/implementation/compiler-request.ts
@@ -0,0 +1,47 @@
+/** Capacity waiting and admitted compile work each keep their existing 50-second budget. */
+import { RuntimeBuildFailed } from "@executor-js/sdk/core";
+import { Duration, Effect } from "effect";
+
+export const compilerQueueBudget = "50 seconds";
+export const compilerCompileBudget = "50 seconds";
+const compilerRequestBudget = Duration.sum(
+  Duration.fromInputUnsafe(compilerQueueBudget),
+  Duration.fromInputUnsafe(compilerCompileBudget),
+);
+
+const unanswered = (message: string) =>
+  Effect.annotateCurrentSpan("build.compiler_deadline_exceeded", true).pipe(
+    Effect.andThen(
+      Effect.fail(
+        new RuntimeBuildFailed({
+          stage: "compile",
+          message,
+          unanswered: true,
+        }),
+      ),
+    ),
+  );
+
+/** Called inside admission, so queued time never consumes compile time. */
+export const compileWithinDeadline = <A, E, R>(work: Effect.Effect<A, E, R>) =>
+  work.pipe(
+    Effect.timeoutOrElse({
+      duration: compilerCompileBudget,
+      orElse: () =>
+        unanswered(
+          `The compiler did not answer within ${compilerCompileBudget}. No new version was activated; deploy again.`,
+        ),
+    }),
+  );
+
+/** A lost Worker still cannot hold the RPC forever; normal queue and compile expiry report there. */
+export const requestCompile = <A, E, R>(request: Effect.Effect<A, E, R>) =>
+  request.pipe(
+    Effect.timeoutOrElse({
+      duration: compilerRequestBudget,
+      orElse: () =>
+        unanswered(
+          "The compiler request did not answer within its queue and compile budgets. No new version was activated; deploy again.",
+        ),
+    }),
+  );
