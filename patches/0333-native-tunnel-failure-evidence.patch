diff --git a/e2e/tests/native-tunnel-failure.spec.ts b/e2e/tests/native-tunnel-failure.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/native-tunnel-failure.spec.ts
@@ -0,0 +1,63 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Redacted } from "effect";
+import { Actors } from "../support/actors.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Evidence } from "../support/evidence.ts";
+import { approveNative, startNativeProtocol } from "../support/native-grants.ts";
+import { nativeTunnel } from "../support/native-tunnel.ts";
+import { Target } from "../support/platform.ts";
+import { targetHosts } from "../support/role-hosts.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Native tunnel failure evidence", (it) => {
+  it.effect(scenarios.nativeTunnelFailure.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const actors = yield* Actors;
+        const p = yield* startNativeProtocol(actors.owner);
+        const tokens = yield* approveNative(p);
+        const worker = yield* nativeTunnel(targetHosts(yield* Target).browser, p.upstream);
+        const connected = yield* worker.connect(Redacted.value(tokens.access_token));
+        expect(connected.status).toBe(101);
+        const channel = connected.channel!;
+        yield* Effect.addFinalizer(() => Effect.sync(() => channel.close()));
+        yield* channel.next("ready");
+        channel.send({
+          type: "open",
+          id: 1,
+          operation: {
+            service: "models",
+            method: "GET",
+            path: "/v1/responses",
+            transport: "websocket",
+          },
+          headers: {},
+        });
+        expect((yield* channel.next("response", 1)).status).toBe(101);
+        yield* channel.next("credit", 1);
+        channel.send({
+          type: "data",
+          id: 1,
+          text: true,
+          bytes: Buffer.from("force-buffer-failure").toString("base64"),
+        });
+        const refused = yield* channel.next("error", 1);
+        expect(refused).toEqual({ v: 1, type: "error", id: 1, code: "limit", outcome: "unknown" });
+        const failures = yield* worker.finish;
+        expect(failures).toEqual([
+          {
+            id: 1,
+            class: "Error",
+            name: "Error",
+            code: null,
+            phase: "message",
+            event: "message",
+          },
+        ]);
+        const evidence = yield* Evidence;
+        yield* evidence.json("tunnel-forced-failure.json", failures);
+      }),
+    ),
+  );
+});
