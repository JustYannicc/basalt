+/** A pool's Subscription credits policy and what it does with each account, read through the host. */
+import { hydrated } from "@executor-js/ui/contracts/http";
+import { revalidated } from "@executor-js/ui/contracts/refresh";
+import { pollingQuery } from "@executor-js/ui/contracts/polling";
+import { Data, Effect, Option } from "effect";
+import { AsyncResult, Atom } from "effect/reactivity";
+import type { AppId } from "@executor-js/sdk";
+import type { OrganizationReference } from "@executor-js/hosted-server/organization";
+import type { UsageCreditPolicy } from "apps/contracts";
+import { HostedClient } from "./api.ts";
+import { protectedQuery } from "./protected-query.ts";
+
+class PoolKey extends Data.Class<{
+  readonly organization: OrganizationReference;
+  readonly app: AppId;
+}> {}
+
+const source = Atom.family((key: PoolKey) =>
+  HostedClient.query(
+    "poolUsage",
+    "accountRouting",
+    hydrated({ params: { organization: key.organization, app: key.app } }),
+  ).pipe(revalidated, protectedQuery),
+);
+const polled = Atom.family((key: PoolKey) => pollingQuery(source(key)));
+const routing = Atom.family((key: PoolKey) =>
+  Atom.readable(
+    (get) => {
+      const result = get(source(key));
+      // Routing follows fresh readings, so a pool keeps polling while visible; any other app's
+      // null answer is read once.
+      const current = AsyncResult.value(result);
+      if (Option.isSome(current) && current.value !== null) get(polled(key));
+      return result;
+    },
+    (refresh) => refresh(source(key)),
+  ),
+);
+/** The pool's policy, whether the caller may change it, and each account's routing; null off pools. */
+export const poolAccountRoutingAtom = (key: {
+  readonly organization: OrganizationReference;
+  readonly app: AppId;
+}) => routing(new PoolKey(key));
+
+const setPolicy = Atom.family((key: PoolKey) =>
+  HostedClient.runtime.fn((policy: UsageCreditPolicy, get) =>
+    Effect.flatMap(HostedClient, (client) =>
+      client.poolUsage.setCreditPolicy({
+        params: { organization: key.organization, app: key.app },
+        payload: { usageCreditPolicy: policy },
+      }),
+    ).pipe(
+      // The host acknowledges only after the pool reads the policy back, and every account's
+      // routing can change with it, so the routing is read again either way.
+      Effect.ensuring(Effect.sync(() => get.refresh(source(key)))),
+    ),
+  ),
+);
+/** Save the pool's policy; acknowledged only once the pool applies it. */
+export const setPoolCreditPolicyAtom = (key: {
+  readonly organization: OrganizationReference;
+  readonly app: AppId;
+}) => setPolicy(new PoolKey(key));
