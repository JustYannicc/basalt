diff --git a/apps/hosted/web/src/implementation/pages/pool-credit-policy.tsx b/apps/hosted/web/src/implementation/pages/pool-credit-policy.tsx
new file mode 100644
index 0000000..8a59588
--- /dev/null
+++ b/apps/hosted/web/src/implementation/pages/pool-credit-policy.tsx
@@ -0,0 +1,98 @@
+import { useAtomSet } from "@effect/atom-react";
+import { Cause, Exit, Option } from "effect";
+import { AsyncResult } from "effect/reactivity";
+import { useState } from "react";
+import type { AccountId, App } from "@executor-js/sdk";
+import { useQuery } from "@executor-js/ui/dashboard/context";
+import type { UsageCreditPolicy } from "apps/contracts";
+import { UsageCreditPolicySetting } from "@executor-js/ui/dashboard/account-usage-credits-view";
+import { useOrganizationRoute } from "../components/organization.tsx";
+import { HostedFailure } from "../components/dashboard-bindings.tsx";
+import {
+  poolAccountRoutingAtom,
+  setPoolCreditPolicyAtom,
+} from "../../contracts/pool-credit-routing.ts";
+import type { HostedError } from "../../contracts/errors.ts";
+
+/** Each account's routing in this pool; undefined off pools and before the first read. */
+export function usePoolAccountRouting(app: App) {
+  const { organization } = useOrganizationRoute();
+  const { data } = useQuery(poolAccountRoutingAtom({ organization, app: app.id }));
+  const routing = Option.getOrNull(data);
+  return (account: AccountId) => routing?.accounts[account];
+}
+
+/**
+ * The pool's Subscription credits setting above its accounts. Other apps read null and show
+ * nothing; people who use the pool but can't edit it see the policy that applies to them.
+ */
+export function PoolCreditPolicy({ app }: { readonly app: App }) {
+  const { organization } = useOrganizationRoute();
+  const key = { organization, app: app.id };
+  const { data, result, refresh } = useQuery(poolAccountRoutingAtom(key));
+  const save = useAtomSet(setPoolCreditPolicyAtom(key), { mode: "promiseExit" });
+  // A save in flight, with the policy the pool reported when it started.
+  const [pending, setPending] = useState<{
+    readonly policy: UsageCreditPolicy;
+    readonly from: UsageCreditPolicy;
+  }>();
+  const [error, setError] = useState<{
+    readonly policy: UsageCreditPolicy;
+    readonly cause: Cause.Cause<HostedError>;
+  }>();
+  const routing = Option.getOrNull(data);
+  // The chosen policy shows until the pool reports a different one than when the save began, so it
+  // never flickers back before the reread, and any later change from elsewhere still shows.
+  const saving =
+    pending !== undefined && routing !== null && routing.usageCreditPolicy === pending.from
+      ? pending.policy
+      : undefined;
+  // A pool that can't be reached says so; any other app, or a caller without access, shows nothing.
+  const unreachable =
+    AsyncResult.isFailure(result) &&
+    Option.exists(
+      Cause.findErrorOption(result.cause),
+      (error) => error._tag === "PoolCreditPolicyUnavailable",
+    );
+  if (routing === null)
+    return unreachable && AsyncResult.isFailure(result) ? (
+      <div className="mb-6">
+        <HostedFailure
+          cause={result.cause}
+          retry={refresh}
+          retrying={result.waiting}
+          layout="compact"
+        />
+      </div>
+    ) : null;
+  const change = async (policy: UsageCreditPolicy) => {
+    setPending({ policy, from: routing.usageCreditPolicy });
+    setError(undefined);
+    const exit = await save(policy);
+    if (Exit.isFailure(exit)) {
+      setPending(undefined);
+      setError({ policy, cause: exit.cause });
+    }
+  };
+  return (
+    <div className="mb-6">
+      <UsageCreditPolicySetting
+        policy={saving ?? routing.usageCreditPolicy}
+        pending={saving !== undefined}
+        {...(routing.canEdit
+          ? { onChange: (policy: UsageCreditPolicy) => void change(policy) }
+          : { disabledReason: "Only the pool's owner can change this." })}
+        failure={
+          error === undefined ? undefined : (
+            <HostedFailure
+              cause={error.cause}
+              retry={() => void change(error.policy)}
+              retrying={saving !== undefined}
+              layout="compact"
+            />
+          )
+        }
+      />
+    </div>
+  );
+}
