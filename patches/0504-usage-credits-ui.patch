+/** Subscription credits read as the provider reported them, beside usage, and never as money or zero. */
+import { expect, layer } from "@effect/vitest";
+import { Clock, Effect, Schema } from "effect";
+import type { Locator, Page } from "playwright";
+import { Browser } from "../support/browser.ts";
+import { Evidence } from "../support/evidence.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { observationBackend, observationFixture } from "../support/account-observation-fixture.ts";
+import { accountRow, openRowDetails, usageGroupName } from "../support/account-rows.ts";
+import { type AccountsTabSection, rowMenuName } from "../support/account-choices.ts";
+import { day, hour, trafficPool } from "../support/account-traffic.ts";
+import { poolFixtureSigningKey } from "../support/cloud-pool-gateway.ts";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { poolUsageBackend } from "../support/pool-usage-backend.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+const iso = (at: number) => new Date(at).toISOString();
+const limitWindow = (
+  id: string,
+  label: string,
+  seconds: number,
+  remaining: number,
+  at: number,
+) => ({
+  id,
+  label,
+  observedAt: iso(at),
+  measure: { unit: "%", used: 100 - remaining, remainingRatio: remaining / 100 },
+  period: { mode: "fixed", seconds },
+  resetsAt: iso(at + Math.min(seconds, 4 * day)),
+});
+const banked = (index: number, at: number) => ({
+  id: `resets-${index}`,
+  label: "Banked resets",
+  unit: "resets",
+  available: 1,
+  observedAt: iso(at),
+  expiresAt: iso(at + 27 * day),
+});
+const credits = <const F>(at: number, fields: F) => ({
+  balance: null,
+  observedAt: iso(at),
+  staleAt: iso(at + hour),
+  freshness: "fresh",
+  extraUsage: null,
+  ...fields,
+});
+/** A subscription reading; `fiveHour` adds the short window two-window plans report. */
+const subscription = <const C, const B = readonly []>(
+  at: number,
+  remaining: number,
+  usageCredits: C,
+  balances?: B,
+  fiveHour?: number,
+) => ({
+  observedAt: iso(at),
+  observation: {
+    offering: "subscription",
+    windows: [
+      limitWindow("seven_day", "Weekly", 7 * day, remaining, at),
+      ...(fiveHour === undefined
+        ? []
+        : [limitWindow("five_hour", "5-hour", 5 * hour, fiveHour, at)]),
+    ],
+    balances: balances ?? [],
+    usageCredits,
+  },
+});
+
+/** Each Details row of `row`'s credits, by name. */
+const creditDetailRows = (row: Locator) =>
+  row
+    .locator("[data-credit-detail]")
+    .evaluateAll((rows) =>
+      Object.fromEntries(
+        rows.map((element) => [
+          element.getAttribute("data-credit-detail") ?? "",
+          element.querySelector("dd")?.textContent ?? "",
+        ]),
+      ),
+    );
+
+/** The pool tab's row for the account saved as `label`, found by its ⋯ menu. */
+const tabRow = (page: Page, section: AccountsTabSection, label: string) =>
+  page
+    .getByRole("region", { name: section, exact: true })
+    .locator("li")
+    .filter({ has: page.getByRole("button", { name: rowMenuName(label, section), exact: true }) });
+
+layer(HostedLive, { excludeTestServices: true })("Account usage credits", (it) => {
+  it.effect(scenarios.accountUsageCredits.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const browser = yield* Browser;
+        const evidence = yield* Evidence;
+        const now = yield* Clock.currentTimeMillis;
+        const cases = [
+          {
+            label: "Wallet",
+            body: subscription(
+              now,
+              0,
+              credits(now, {
+                state: "available",
+                balance: { value: "1250", unit: "credits" },
+              }),
+              [banked(0, now), banked(1, now)],
+            ),
+            line: "1,250 credits",
+          },
+          {
+            label: "Unlimited",
+            body: subscription(now, 0, credits(now, { state: "unlimited" })),
+            line: "Unlimited credits",
+          },
+          {
+            label: "Plan only",
+            body: subscription(now, 68, credits(now, { state: "none" }), [], 81),
+            line: "No credits",
+          },
+          {
+            label: "Unread",
+            body: subscription(
+              now,
+              40,
+              credits(now, {
+                state: "unknown",
+                observedAt: null,
+                staleAt: null,
+                freshness: "unknown",
+              }),
+            ),
+            line: "Credits unavailable",
+          },
+          {
+            label: "Extra on",
+            body: subscription(
+              now,
+              0,
+              credits(now, {
+                state: "unknown",
+                extraUsage: {
+                  enabled: true,
+                  monthlyCap: "limited",
+                  usedRatio: 0.35,
+                  spent: null,
+                  cap: null,
+                },
+              }),
+              [],
+              0,
+            ),
+            line: "Extra usage on",
+          },
+          {
+            label: "Extra off",
+            body: subscription(
+              now,
+              0,
+              credits(now, {
+                state: "disabled",
+                extraUsage: {
+                  enabled: false,
+                  monthlyCap: "unknown",
+                  usedRatio: null,
+                  spent: null,
+                  cap: null,
+                },
+              }),
+              [],
+              0,
+            ),
+            line: "Extra usage off",
+          },
+        ] as const;
+        const fixtures = [];
+        for (const entry of cases) {
+          const fixture = yield* observationFixture({
+            name: `${entry.label} fixture`,
+            observe: true,
+            health: true,
+          });
+          yield* fixture.backend.answer({ status: 200, body: entry.body });
+          expect(
+            (yield* fixture.api.request(fixture.actors.owner, "PATCH", fixture.accountPath, {
+              label: entry.label,
+            })).status,
+          ).toBe(200);
+          expect((yield* fixture.refresh()).status).toBe(200);
+          fixtures.push(fixture);
+        }
+        const { actors } = fixtures[0]!;
+        yield* browser.login(actors.owner);
+        const accounts = `/org/${actors.organization.slug}/accounts`;
+        const line = (page: Page, label: string) =>
+          page.getByRole("group", usageGroupName(label)).locator("[data-usage-credits]");
+        const ready = (page: Page) =>
+          Promise.all(cases.map((entry) => line(page, entry.label).waitFor()));
+
+        for (const width of [1280, 390])
+          for (const scheme of ["light", "dark"] as const) {
+            yield* browser.use(`Open Accounts at ${width}px in ${scheme} mode`, (page) =>
+              page
+                .setViewportSize({ width, height: 900 })
+                .then(() => page.emulateMedia({ colorScheme: scheme }))
+                .then(() => page.goto(accounts))
+                .then(() => ready(page)),
+            );
+            yield* evidence.attach(
+              `after-usage-credits-${width}-${scheme}.png`,
+              "image/png",
+              yield* browser.use("Capture the account list", (page) =>
+                page.screenshot({ fullPage: true }),
+              ),
+            );
+            const overflow = yield* browser.use("Measure horizontal overflow", (page) =>
+              page.evaluate(() => document.documentElement.scrollWidth - window.innerWidth),
+            );
+            expect(overflow, `no horizontal scroll at ${width}px`).toBeLessThanOrEqual(0);
+          }
+
+        const lines = yield* browser.use("Read every credit line", (page) =>
+          page
+            .setViewportSize({ width: 1280, height: 900 })
+            .then(() => page.goto(accounts))
+            .then(() => ready(page))
+            .then(() =>
+              Promise.all(
+                cases.map((entry) =>
+                  line(page, entry.label)
+                    .locator("[data-usage-credits-line]")
+                    .innerText()
+                    .then((text) => [entry.label, text] as const),
+                ),
+              ),
+            ),
+        );
+        expect(Object.fromEntries(lines)).toEqual(
+          Object.fromEntries(cases.map((entry) => [entry.label, entry.line])),
+        );
+        const layout = yield* browser.use("Measure the two-window Claude row", (page) => {
+          const group = page.getByRole("group", usageGroupName("Extra on"));
+          return Promise.all([
+            group.locator('[data-reading="seven_day"]').boundingBox(),
+            group.locator("[data-usage-credits]").boundingBox(),
+            group.locator("[data-usage-credits]").innerText(),
+          ]);
+        });
+        const [cell, creditLine, extraText] = layout;
+        // At desktop width the credit line sits beside both windows, not under them.
+        expect(creditLine!.y).toBeLessThan(cell!.y + cell!.height);
+        expect(creditLine!.x).toBeGreaterThan(cell!.x + cell!.width);
+        expect(extraText).toContain("balance unavailable");
+        // No pool is showing these rows, so nothing claims what a pool does with them.
+        const statuses = yield* browser.use("Count routing statuses", (page) =>
+          page.locator("[data-usage-credit-status]").count(),
+        );
+        expect(statuses).toBe(0);
+
+        const wallet = yield* browser.use("Open the wallet's Details", (page) => {
+          const row = accountRow(page, "Wallet");
+          return openRowDetails(page, row, "Wallet").then(() => creditDetailRows(row));
+        });
+        expect(wallet).toMatchObject({
+          "Credit balance": "1,250 credits",
+          "Balance unit": "Usage credits",
+          "Credit reading": expect.stringMatching(/^Read /),
+          "Banked quota resets": "2 · separate from usage credits",
+        });
+        for (const width of [1280, 390]) {
+          yield* browser.use(`Show the wallet's Details at ${width}px`, (page) =>
+            page
+              .setViewportSize({ width, height: 900 })
+              .then(() =>
+                accountRow(page, "Wallet")
+                  .locator("[data-usage-credit-details]")
+                  .scrollIntoViewIfNeeded(),
+              ),
+          );
+          yield* evidence.attach(
+            `after-usage-credits-details-${width}.png`,
+            "image/png",
+            yield* browser.use("Capture the wallet's Details", (page) => page.screenshot()),
+          );
+        }
+
+        const claude = yield* browser.use("Open extra usage Details", (page) => {
+          const row = accountRow(page, "Extra on");
+          return page
+            .setViewportSize({ width: 1280, height: 900 })
+            .then(() => openRowDetails(page, row, "Extra on"))
+            .then(() => creditDetailRows(row));
+        });
+        const unlimited = yield* browser.use("Open the unlimited account's Details", (page) => {
+          const row = accountRow(page, "Unlimited");
+          return openRowDetails(page, row, "Unlimited").then(() => creditDetailRows(row));
+        });
+        expect(unlimited).toMatchObject({
+          "Credit balance": "Unlimited, reported by provider",
+          "Balance unit": "Usage credits",
+        });
+        // A cap is not a wallet: the balance stays unavailable while extra usage is on.
+        expect(claude).toMatchObject({
+          "Credit balance": "Unavailable",
+          "Extra usage": "On",
+          "Monthly spend cap": "Limited · 35% used",
+          "Extra usage spent": "Amount unavailable",
+        });
+      }),
+    ),
+  );
+
+  it.effect(scenarios.poolUsageCreditPolicy.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          browser = yield* Browser,
+          evidence = yield* Evidence,
+          observed = yield* observationBackend,
+          pool = yield* poolUsageBackend;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const {
+          app,
+          accounts: [wallet, unread, plan],
+        } = yield* trafficPool({
+          name: "Credit pool",
+          origin: observed.origin,
+          labels: ["Pool wallet", "Pool unread", "Pool plan"],
+        });
+        if (wallet === undefined || unread === undefined || plan === undefined)
+          return yield* Effect.die("The pool saved fewer accounts than asked");
+        const now = yield* Clock.currentTimeMillis;
+        // Each account reads what the mock shows beside its pool status.
+        const readings = [
+          [
+            wallet,
+            subscription(
+              now,
+              0,
+              credits(now, { state: "available", balance: { value: "1250", unit: "credits" } }),
+            ),
+          ],
+          [
+            unread,
+            subscription(
+              now,
+              0,
+              credits(now, {
+                state: "unknown",
+                extraUsage: {
+                  enabled: true,
+                  monthlyCap: "limited",
+                  usedRatio: 0.35,
+                  spent: null,
+                  cap: null,
+                },
+              }),
+              [],
+              0,
+            ),
+          ],
+          [plan, subscription(now, 68, credits(now, { state: "none" }), [], 81)],
+        ] as const;
+        for (const [account, reading] of readings) {
+          yield* observed.answer({ status: 200, body: reading });
+          expect(
+            (yield* api.request(
+              actors.owner,
+              "POST",
+              `${prefix}/accounts/${account}/observations/refresh`,
+            )).status,
+          ).toBe(200);
+        }
+        // The pool's own decisions: one account it would pay with credits, one with unknown
+        // funding and one on plan quota.
+        yield* pool.creditAccounts({
+          [wallet]: { use: "credits", eligible: true, reason: "credits_only" },
+          [unread]: { use: "unknown", eligible: true, reason: "usage_unknown" },
+          [plan]: { use: "plan", eligible: true, reason: "plan_available" },
+        });
+        const viewer = yield* body(
+          Schema.Struct({ userId: Schema.String }),
+          yield* api.request(actors.owner, "GET", "/api/viewer"),
+        );
+        const pools = (value: object) => ({
+          sql: `update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb), '{basaltPools}', $1::jsonb)::text where id=$2`,
+          params: [JSON.stringify(value), actors.organization.id],
+        });
+        yield* serverControl("stop");
+        yield* legacyStorage([
+          pools({
+            [viewer.userId]: {
+              app,
+              version: "retained-version",
+              authorization: "executor-app-v1",
+              membership: "executor-links-v1",
+            },
+          }),
+        ]);
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* serverControl("stop");
+            yield* legacyStorage([pools({})]);
+            yield* serverControl("start");
+          }).pipe(Effect.orDie),
+        );
+        yield* serverControl("environment", 200, {
+          POOL_APP_SIGNING_KEY: poolFixtureSigningKey,
+          BASALT_POOL_ORIGIN: pool.origin,
+        });
+        yield* serverControl("start");
+
+        const poolTab = `/org/${actors.organization.slug}/apps/${app}?view=accounts`;
+        const setting = (page: Page) =>
+          page.getByRole("region", { name: "Subscription credits", exact: true });
+        const status = (page: Page, label: string) =>
+          tabRow(page, "App accounts", label).locator(
+            "[data-usage-credits] [data-usage-credit-status]",
+          );
+        const statuses = (page: Page) =>
+          Promise.all(
+            ["Pool wallet", "Pool unread", "Pool plan"].map((label) =>
+              status(page, label).innerText(),
+            ),
+          );
+        yield* browser.login(actors.owner);
+        const before = yield* browser.use("Open the pool's Accounts tab", (page) =>
+          page
+            .setViewportSize({ width: 1280, height: 900 })
+            .then(() => page.goto(poolTab))
+            .then(() => status(page, "Pool plan").waitFor())
+            .then(() =>
+              Promise.all([
+                setting(page)
+                  .getByRole("radio", { name: "Allow as last resort", exact: true })
+                  .getAttribute("aria-checked"),
+                setting(page).locator("[data-usage-credit-policy-note]").innerText(),
+                statuses(page),
+              ]),
+            ),
+        );
+        expect(before).toEqual([
+          "true",
+          "Credits are used only when no account has plan quota.",
+          ["· Usable on credits", "· Usage unknown · last resort", "· Using plan quota"],
+        ]);
+        const beside = yield* browser.use("Measure a two-window pool row", (page) => {
+          const row = tabRow(page, "App accounts", "Pool unread");
+          return Promise.all([
+            row.locator('[data-reading="five_hour"]').boundingBox(),
+            row.locator("[data-usage-credits]").boundingBox(),
+          ]);
+        });
+        // The credit line sits beside both windows in the pool's own tab too.
+        expect(beside[1]!.x).toBeGreaterThan(beside[0]!.x + beside[0]!.width);
+        expect(beside[1]!.y).toBeLessThan(beside[0]!.y + beside[0]!.height);
+        const tones = yield* browser.use("Read which statuses pay with credits", (page) =>
+          Promise.all(
+            ["Pool wallet", "Pool unread", "Pool plan"].map((label) =>
+              status(page, label).evaluate((element) => element.hasAttribute("data-credit-use")),
+            ),
+          ),
+        );
+        expect(tones, "only paying with credits is highlighted").toEqual([true, false, false]);
+        for (const width of [1280, 390]) {
+          yield* browser.use(`Show the setting at ${width}px`, (page) =>
+            page
+              .setViewportSize({ width, height: 900 })
+              .then(() => setting(page).scrollIntoViewIfNeeded()),
+          );
+          if (width === 390) {
+            const choices = yield* browser.use("Measure the choices on a phone", (page) =>
+              Promise.all(
+                ["Allow as last resort", "Never use credits"].map((name) =>
+                  setting(page).getByRole("radio", { name, exact: true }).boundingBox(),
+                ),
+              ),
+            );
+            expect(choices[1]!.y, "the choices stack on a phone").toBeGreaterThan(
+              choices[0]!.y + choices[0]!.height,
+            );
+          }
+          yield* evidence.attach(
+            `after-pool-credits-last-resort-${width}.png`,
+            "image/png",
+            yield* browser.use("Capture the pool tab", (page) =>
+              page.screenshot({ fullPage: true }),
+            ),
+          );
+        }
+
+        const after = yield* browser.use("Choose Never use credits", (page) =>
+          page
+            .setViewportSize({ width: 1280, height: 900 })
+            .then(() =>
+              setting(page).getByRole("radio", { name: "Never use credits", exact: true }).click(),
+            )
+            .then(() =>
+              setting(page)
+                .locator("[data-usage-credit-policy-note]", {
+                  hasText: "Accounts with unknown usage are skipped.",
+                })
+                .waitFor(),
+            )
+            .then(() =>
+              status(page, "Pool wallet").filter({ hasText: "Credits blocked by pool" }).waitFor(),
+            )
+            .then(() => statuses(page)),
+        );
+        // Blocked credits keep their amount; unknown funding says it is skipped, not blocked.
+        expect(after).toEqual([
+          "· Credits blocked by pool",
+          "· Skipped · usage unknown",
+          "· Using plan quota",
+        ]);
+        const firstSaves = (yield* pool.calls).filter((call) => call.action === "setCreditPolicy");
+        expect(firstSaves.map((call) => call.usageCreditPolicy)).toEqual(["never"]);
+
+        const details = yield* browser.use("Open the wallet's Details in the pool", (page) => {
+          const row = tabRow(page, "App accounts", "Pool wallet");
+          return row
+            .getByRole("button", { name: rowMenuName("Pool wallet", "App accounts"), exact: true })
+            .click()
+            .then(() => page.getByRole("menuitem", { name: "Details", exact: true }).click())
+            .then(() => row.locator("[data-usage-credit-details]").waitFor())
+            .then(() => creditDetailRows(row));
+        });
+        expect(details).toMatchObject({
+          "Included plan": "Exhausted",
+          "Credit balance": "1,250 credits",
+          "Credit policy": "Never use credits",
+        });
+        for (const width of [1280, 390]) {
+          yield* browser.use(`Show the pool Details at ${width}px`, (page) =>
+            page
+              .setViewportSize({ width, height: 900 })
+              .then(() =>
+                tabRow(page, "App accounts", "Pool wallet")
+                  .locator("[data-usage-credit-details]")
+                  .scrollIntoViewIfNeeded(),
+              ),
+          );
+          yield* evidence.attach(
+            `after-pool-credits-never-details-${width}.png`,
+            "image/png",
+            yield* browser.use("Capture the never policy", (page) => page.screenshot()),
+          );
+          const columns = yield* browser.use("Measure the Details columns", (page) =>
+            tabRow(page, "App accounts", "Pool wallet")
+              .locator("[data-usage-credit-details] dl")
+              .evaluateAll((lists) => lists.map((list) => list.getBoundingClientRect().left)),
+          );
+          // Two columns side by side on a desktop, one under the other on a phone.
+          if (width === 390) expect(columns[0]).toBe(columns[1]);
+          else expect(columns[1]).toBeGreaterThan(columns[0]!);
+          const overflow = yield* browser.use("Measure horizontal overflow", (page) =>
+            page.evaluate(() => document.documentElement.scrollWidth - window.innerWidth),
+          );
+          expect(overflow, `no horizontal scroll at ${width}px`).toBeLessThanOrEqual(0);
+        }
+
+        // A failed save names the failure and keeps the pool's policy.
+        yield* pool.unavailable(true);
+        const failed = yield* browser.use(
+          "Choose Allow as last resort while the pool is down",
+          (page) =>
+            page
+              .setViewportSize({ width: 1280, height: 900 })
+              .then(() =>
+                setting(page)
+                  .getByRole("radio", { name: "Allow as last resort", exact: true })
+                  .click(),
+              )
+              .then(() =>
+                setting(page)
+                  .getByText("Pool credit policy could not be confirmed", { exact: false })
+                  .waitFor(),
+              )
+              .then(() =>
+                setting(page)
+                  .getByRole("radio", { name: "Never use credits", exact: true })
+                  .getAttribute("aria-checked"),
+              ),
+        );
+        expect(failed).toBe("true");
+        yield* pool.unavailable(false);
+
+        // The way back: Allow as last resort restores the last-resort statuses.
+        const restored = yield* browser.use("Choose Allow as last resort again", (page) =>
+          setting(page)
+            .getByRole("radio", { name: "Allow as last resort", exact: true })
+            .click()
+            .then(() =>
+              status(page, "Pool wallet").filter({ hasText: "Usable on credits" }).waitFor(),
+            )
+            .then(() => statuses(page)),
+        );
+        expect(restored).toEqual([
+          "· Usable on credits",
+          "· Usage unknown · last resort",
+          "· Using plan quota",
+        ]);
+        const saved = (yield* pool.calls).filter((call) => call.action === "setCreditPolicy");
+        expect(saved.map((call) => call.usageCreditPolicy)).toEqual([
+          "never",
+          "last_resort",
+          "last_resort",
+        ]);
+      }),
+    ),
+  );
+});
