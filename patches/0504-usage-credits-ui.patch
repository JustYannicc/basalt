diff --git a/packages/ui/src/implementation/dashboard/account-usage-credits-view.tsx b/packages/ui/src/implementation/dashboard/account-usage-credits-view.tsx
new file mode 100644
index 0000000..0fc2c0c
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/account-usage-credits-view.tsx
@@ -0,0 +1,237 @@
+import type { AccountObservationRecord } from "@executor-js/sdk";
+import { RadioGroup } from "radix-ui";
+import { useId, type ReactNode } from "react";
+import type { DisplayFormat } from "../../contracts/display.ts";
+import { cn } from "../lib/utils.ts";
+import { radioClass, radioDot } from "./radio-choice.ts";
+import { UsageCreditPolicy } from "apps/contracts";
+import type { AccountUsageRouting, UsageCredits } from "apps/contracts";
+import { Schema } from "effect";
+import {
+  creditDetails,
+  creditLine,
+  policyLabels,
+  policyNotes,
+  routingStatus,
+  type CreditDetail,
+} from "./account-usage-credits.ts";
+
+type Observation = NonNullable<AccountObservationRecord["result"]>["observation"];
+
+const creditTone = "text-sign-in-warning";
+
+/**
+ * The account's credits beside its usage cells: the provider's fact, then what the pool does with
+ * it. Paying with credits is amber, so it never reads as ordinary plan use.
+ */
+export function UsageCreditLine({
+  credits,
+  routing,
+  format,
+}: {
+  readonly credits: UsageCredits;
+  readonly routing?: AccountUsageRouting | undefined;
+  readonly format: DisplayFormat;
+}) {
+  const line = creditLine(credits, format);
+  const status = routing === undefined ? undefined : routingStatus(routing);
+  return (
+    <p
+      className="flex min-w-0 flex-wrap items-baseline gap-x-2 gap-y-0.5 self-center text-xs"
+      data-usage-credits={credits.state}
+      {...(routing === undefined ? {} : { "data-usage-routing": routing.use })}
+    >
+      <strong className="font-semibold text-foreground" data-usage-credits-line>
+        {line.text}
+      </strong>
+      {line.detail !== undefined && <span className="text-muted-foreground">· {line.detail}</span>}
+      {status !== undefined && (
+        <span
+          className={cn("text-[11px]", status.credit ? creditTone : "text-muted-foreground")}
+          data-usage-credit-status
+          {...(status.credit ? { "data-credit-use": "" } : {})}
+        >
+          · {status.text}
+        </span>
+      )}
+    </p>
+  );
+}
+
+function Rows({ rows }: { readonly rows: readonly CreditDetail[] }) {
+  return (
+    <dl className="m-0 min-w-0">
+      {rows.map((row) => (
+        <div
+          key={row.name}
+          className="flex justify-between gap-4 border-b border-border py-2 max-[640px]:gap-2.5"
+          data-credit-detail={row.name}
+        >
+          <dt className="text-muted-foreground">{row.name}</dt>
+          <dd
+            className={cn(
+              "m-0 max-w-[65%] text-right tabular-nums wrap-anywhere",
+              row.stale === true ? "text-sign-in-warning" : "text-foreground",
+            )}
+          >
+            {row.value}
+          </dd>
+        </div>
+      ))}
+    </dl>
+  );
+}
+
+/** Credits in the account's Details: plan, balance and policy, kept apart from banked resets. */
+export function UsageCreditDetails({
+  title,
+  subtitle,
+  credits,
+  routing,
+  observation,
+  now,
+  format,
+}: {
+  readonly title: string;
+  readonly subtitle?: string | undefined;
+  readonly credits: UsageCredits;
+  readonly routing?: AccountUsageRouting | undefined;
+  readonly observation: Observation;
+  readonly now: number;
+  readonly format: DisplayFormat;
+}) {
+  const heading = useId();
+  const details = creditDetails(credits, routing, observation, now, format);
+  const status = routing === undefined ? undefined : routingStatus(routing);
+  return (
+    <section
+      aria-labelledby={heading}
+      data-usage-credit-details
+      className="grid max-w-[900px] gap-4 rounded-lg border bg-card p-4 text-[12px] max-[640px]:gap-3 max-[640px]:p-3.5"
+    >
+      <div className="flex items-start justify-between gap-3 max-[640px]:flex-col max-[640px]:gap-1">
+        <div className="min-w-0">
+          <h3 id={heading} className="text-[13px] font-semibold text-foreground wrap-anywhere">
+            Details · {title}
+          </h3>
+          {subtitle !== undefined && <p className="text-muted-foreground">{subtitle}</p>}
+        </div>
+        {status !== undefined && (
+          <span className={creditTone} data-usage-credit-status>
+            {status.text}
+          </span>
+        )}
+      </div>
+      <div className="grid grid-cols-2 gap-x-9 max-[640px]:grid-cols-1">
+        <Rows rows={details.left} />
+        <Rows rows={details.right} />
+      </div>
+      <p className="max-w-[75ch] text-muted-foreground" data-usage-credit-note>
+        {details.note}
+      </p>
+    </section>
+  );
+}
+
+/** Each source's credits in the account's Details; sources without credits add nothing. */
+export function UsageCreditReports({
+  reports,
+  ...props
+}: Omit<Parameters<typeof UsageCreditDetails>[0], "credits" | "observation"> & {
+  readonly reports: readonly AccountObservationRecord[];
+}) {
+  return reports.map((report) => {
+    const observation = report.result?.observation;
+    const credits = observation?.usageCredits;
+    return observation === undefined || credits === undefined ? null : (
+      <UsageCreditDetails
+        key={report.source.id}
+        {...props}
+        credits={credits}
+        observation={observation}
+      />
+    );
+  });
+}
+
+/**
+ * The pool's Subscription credits policy. It steers routing in this pool only; the provider's own
+ * setting is the only absolute guarantee, which the disclosure says.
+ */
+export function UsageCreditPolicySetting({
+  policy,
+  onChange,
+  pending = false,
+  disabledReason,
+  failure,
+}: {
+  readonly policy: UsageCreditPolicy;
+  /** Absent for a caller who may not change the pool's policy. */
+  readonly onChange?: ((policy: UsageCreditPolicy) => void) | undefined;
+  readonly pending?: boolean;
+  /** Why the caller can't change it, shown under the choices. */
+  readonly disabledReason?: string | undefined;
+  /** A save that failed, with its retry, in the host's failure layout. */
+  readonly failure?: ReactNode;
+}) {
+  const heading = useId();
+  const note = useId();
+  return (
+    <section
+      aria-labelledby={heading}
+      aria-busy={pending}
+      data-usage-credit-policy={policy}
+      className="grid grid-cols-[minmax(240px,_1fr)_minmax(300px,_1fr)] gap-x-7 gap-y-2.5 rounded-lg border bg-card p-4 max-[850px]:grid-cols-1 max-[640px]:p-3.5"
+    >
+      <div className="min-w-0">
+        <h2 id={heading} className="text-[15px] font-semibold">
+          Subscription credits
+        </h2>
+        <p className="mt-0.5 text-xs text-muted-foreground">
+          Accounts with plan quota are always used first.
+        </p>
+      </div>
+      <div className="grid min-w-0 gap-1.5">
+        <RadioGroup.Root
+          value={policy}
+          aria-labelledby={heading}
+          aria-describedby={note}
+          disabled={onChange === undefined || pending}
+          onValueChange={(value) => {
+            if (Schema.is(UsageCreditPolicy)(value)) onChange?.(value);
+          }}
+          className="flex min-h-7 flex-wrap items-center gap-x-5 gap-y-2.5 max-[640px]:flex-col max-[640px]:items-start"
+        >
+          {UsageCreditPolicy.literals.map((choice) => (
+            <label
+              key={choice}
+              className="flex min-h-7 cursor-pointer items-center gap-2 text-[13px] has-disabled:cursor-default"
+            >
+              <RadioGroup.Item value={choice} className={radioClass}>
+                <RadioGroup.Indicator className={radioDot} />
+              </RadioGroup.Item>
+              {policyLabels[choice]}
+            </label>
+          ))}
+        </RadioGroup.Root>
+        <p id={note} className="text-xs text-muted-foreground" data-usage-credit-policy-note>
+          {pending ? "Saving…" : policyNotes[policy]}
+        </p>
+        {disabledReason !== undefined && (
+          <p className="text-xs text-muted-foreground">{disabledReason}</p>
+        )}
+        {failure}
+      </div>
+      <details className="col-span-full text-xs text-muted-foreground">
+        <summary className="w-fit cursor-pointer underline underline-offset-3">
+          About this limit
+        </summary>
+        <p className="max-w-[75ch] pt-1.5">
+          This controls routing in this pool. A request can cross the provider's quota limit while
+          it runs. For an absolute no-charge guarantee, turn off extra usage or credits in the
+          provider's settings.
+        </p>
+      </details>
+    </section>
+  );
+}
diff --git a/packages/ui/src/implementation/dashboard/account-usage-credits.ts b/packages/ui/src/implementation/dashboard/account-usage-credits.ts
new file mode 100644
index 0000000..e926969
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/account-usage-credits.ts
@@ -0,0 +1,215 @@
+import type { AccountObservationRecord } from "@executor-js/sdk";
+import type { AccountUsageRouting, UsageCreditPolicy, UsageCredits } from "apps/contracts";
+import type { DisplayFormat } from "../../contracts/display.ts";
+import { age, bankedResets, countedUnit } from "./account-observation-format.ts";
+
+type Observation = NonNullable<AccountObservationRecord["result"]>["observation"];
+
+export const policyLabels = {
+  last_resort: "Allow as last resort",
+  never: "Never use credits",
+} satisfies Record<UsageCreditPolicy, string>;
+
+export const policyNotes = {
+  last_resort: "Credits are used only when no account has plan quota.",
+  never: "Accounts with unknown usage are skipped.",
+} satisfies Record<UsageCreditPolicy, string>;
+
+// Decimal strings stay exact: Intl formats them without a float round trip or rounding.
+const decimal = (value: string, format: DisplayFormat) =>
+  new Intl.NumberFormat(format.locale, { maximumFractionDigits: 20 }).format(
+    value as Intl.StringNumericLiteral,
+  );
+const money = (value: string, currency: string, format: DisplayFormat) =>
+  new Intl.NumberFormat(format.locale, { style: "currency", currency }).format(
+    value as Intl.StringNumericLiteral,
+  );
+
+/** The finite balance in its own unit; usage credits are never shown as money. */
+const balanceText = (balance: NonNullable<UsageCredits["balance"]>, format: DisplayFormat) =>
+  balance.unit === "currency" && balance.currency !== undefined
+    ? money(balance.value, balance.currency, format)
+    : `${decimal(balance.value, format)} ${countedUnit(Number(balance.value), "credits")}`;
+
+/** The row's credit fact: what the provider reported, and for Claude whether extra usage is on. */
+export function creditLine(credits: UsageCredits, format: DisplayFormat) {
+  const extra = credits.extraUsage;
+  if (extra !== null && (credits.state === "disabled" || extra.enabled === false))
+    return { text: "Extra usage off" };
+  if (extra?.enabled === true && credits.balance === null)
+    return { text: "Extra usage on", detail: "balance unavailable" };
+  switch (credits.state) {
+    case "available":
+      // "Available" with no amount, or with zero, is not a spendable balance to show.
+      return credits.balance === null
+        ? { text: "Credits unavailable" }
+        : /^0(?:\.0+)?$/u.test(credits.balance.value)
+          ? { text: "No credits" }
+          : { text: balanceText(credits.balance, format) };
+    case "unlimited":
+      return { text: "Unlimited credits" };
+    case "none":
+      return { text: "No credits" };
+    case "disabled":
+      return { text: "Credits off" };
+    case "unknown":
+      return { text: "Credits unavailable" };
+  }
+}
+
+/**
+ * What the pool does with the account now. The pool's own reason wins where it explains a refusal:
+ * a never policy blocks credits even while the account could otherwise spend them.
+ */
+export function routingStatus(routing: AccountUsageRouting) {
+  if (routing.reason === "credit_policy_never" && routing.use === "credits")
+    return { text: "Credits blocked by pool", credit: true };
+  switch (routing.use) {
+    case "plan":
+      return { text: "Using plan quota", credit: false };
+    case "credits":
+      return { text: "Usable on credits", credit: true };
+    case "exhausted":
+      return { text: "Plan exhausted", credit: false };
+    case "unknown":
+      return routing.policy === "never"
+        ? { text: "Skipped · usage unknown", credit: false }
+        : { text: "Usage unknown · last resort", credit: false };
+    case "blocked":
+      return routing.reason === "continuity_requires_reconnect"
+        ? { text: "Not used · reconnect needed", credit: false }
+        : routing.reason === "credential_unavailable"
+          ? { text: "Not used · sign-in unavailable", credit: false }
+          : { text: "Not used", credit: false };
+  }
+}
+
+const planState = (routing: AccountUsageRouting | undefined) =>
+  routing === undefined
+    ? undefined
+    : routing.use === "plan"
+      ? "Available"
+      : routing.use === "credits" || routing.use === "exhausted"
+        ? "Exhausted"
+        : "Unknown";
+
+const balanceDetail = (credits: UsageCredits, format: DisplayFormat) =>
+  credits.state === "unlimited"
+    ? "Unlimited, reported by provider"
+    : credits.state === "none"
+      ? "None"
+      : credits.balance === null
+        ? "Unavailable"
+        : balanceText(credits.balance, format);
+
+const reading = (credits: UsageCredits, now: number) =>
+  credits.observedAt === null || credits.freshness === "unknown"
+    ? "Unavailable"
+    : credits.freshness === "stale"
+      ? `Stale · last read ${age(credits.observedAt, now)}`
+      : `Read ${age(credits.observedAt, now)}`;
+
+const capDetail = (extra: NonNullable<UsageCredits["extraUsage"]>, format: DisplayFormat) => {
+  if (extra.monthlyCap === "unlimited") return "No monthly cap";
+  if (extra.monthlyCap === "unknown") return "No monthly cap reported";
+  const used = extra.usedRatio === null ? undefined : `${Math.round(extra.usedRatio * 100)}% used`;
+  const cap = extra.cap === null ? undefined : money(extra.cap.value, extra.cap.currency, format);
+  return ["Limited", cap, used].filter((part) => part !== undefined).join(" · ");
+};
+
+/**
+ * Plain words for the state, so nobody reads a cap, a flag or a missing reading as a wallet. Claims
+ * about the plan appear only where the pool's routing proves them.
+ */
+function creditNote(credits: UsageCredits, routing: AccountUsageRouting | undefined) {
+  const extra = credits.extraUsage;
+  const exhausted = routing?.use === "exhausted" || routing?.use === "credits";
+  if (extra !== null && (credits.state === "disabled" || extra.enabled === false))
+    return `Extra usage is off.${exhausted ? " The included plan is currently exhausted." : ""} A retained historical spend amount would not enable extra usage or prove a spendable balance.`;
+  if (extra?.enabled === true && credits.balance === null)
+    return "Extra usage is enabled. The monthly spending cap is not a credit balance. The provider has not supplied a verified wallet balance or currency scale. This account is a final fallback only when credits are allowed; its funding remains unknown.";
+  switch (credits.state) {
+    case "available":
+      return `The provider reports a credit balance. ${credits.balance?.unit === "currency" ? "Its currency and scale are verified." : "These are usage credits, not US dollars."} The pool uses accounts with plan quota before this account. Banked quota resets are separate and are never spent automatically.`;
+    case "unlimited":
+      return "The provider reports unlimited credits. This does not mean usage is free. Accounts with plan quota still come first.";
+    case "none":
+      return routing?.use === "plan"
+        ? "This account has included plan quota and no additional usage credits. It is preferred over every account that would need credits, including accounts with an existing session binding."
+        : "The provider reports no additional usage credits for this account.";
+    case "disabled":
+      return "Credits are off for this account.";
+    case "unknown":
+      return `There is no current credit${routing?.use === "unknown" ? " or plan-quota" : ""} reading. Missing data does not mean zero. Never use credits skips this account until included quota is confirmed. Allow as last resort keeps unknown funding behind known plan and credit accounts.`;
+  }
+}
+
+export interface CreditDetail {
+  readonly name: string;
+  readonly value: string;
+  readonly stale?: boolean;
+}
+
+/** Details' two columns: the plan, balance and policy, then the reading or Claude's extra usage. */
+export function creditDetails(
+  credits: UsageCredits,
+  routing: AccountUsageRouting | undefined,
+  observation: Observation,
+  now: number,
+  format: DisplayFormat,
+) {
+  const plan = planState(routing);
+  const left: CreditDetail[] = [
+    ...(plan === undefined ? [] : [{ name: "Included plan", value: plan }]),
+    { name: "Credit balance", value: balanceDetail(credits, format) },
+    ...(routing === undefined
+      ? []
+      : [{ name: "Credit policy", value: policyLabels[routing.policy] }]),
+  ];
+  const extra = credits.extraUsage;
+  const resets = bankedResets(observation, now);
+  const right: CreditDetail[] =
+    extra !== null
+      ? [
+          {
+            name: "Extra usage",
+            value: extra.enabled === null ? "Unknown" : extra.enabled ? "On" : "Off",
+          },
+          { name: "Monthly spend cap", value: capDetail(extra, format) },
+          {
+            name: "Extra usage spent",
+            value:
+              extra.spent === null
+                ? "Amount unavailable"
+                : money(extra.spent.value, extra.spent.currency, format),
+          },
+        ]
+      : [
+          {
+            name: "Credit reading",
+            value: reading(credits, now),
+            stale: credits.freshness === "stale",
+          },
+          {
+            name: "Balance unit",
+            value:
+              credits.balance === null
+                ? credits.state === "unlimited"
+                  ? "Usage credits"
+                  : credits.state === "none"
+                    ? "Credits"
+                    : "Unavailable"
+                : credits.balance.unit === "currency"
+                  ? (credits.balance.currency ?? "Unavailable")
+                  : "Usage credits",
+          },
+          {
+            name: "Banked quota resets",
+            value:
+              resets === undefined
+                ? "None reported"
+                : `${resets.count} · separate from usage credits`,
+          },
+        ];
+  return { left, right, note: creditNote(credits, routing) };
+}
