+import { RequiredAction } from "./authorization.ts";
+import {
+  OrganizationForbidden,
+  OrganizationReference,
+  RequireOrganization,
+} from "./organization.ts";
+
+export const HostedPools = HttpApiGroup.make("pools")
+  .add(
+    HttpApiEndpoint.post("create", "/api/organizations/:organization/pools", {
+      params: { organization: OrganizationReference },
+      payload: CreatePool,
+      success: AppInstallResult,
+      error: [
+        StorageError,
+        AppNotFound,
+        OrganizationForbidden,
+        PoolCreationUnavailable,
+        PoolCreationConflict,
+        AppNameTaken,
+        AppSlugTaken,
+      ],
+    }).annotate(RequiredAction, "manage"),
+  )
+  .middleware(RequireOrganization);
