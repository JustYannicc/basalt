@@ -0,0 +1,72 @@
+import { Effect, FileSystem, Path } from "effect";
+import { ChildProcess, ChildProcessSpawner } from "effect/process";
+import { Target } from "./platform.ts";
+import { serverControl } from "./server-control.ts";
+
+/** The full host with the same verified pool source and access adapter supplied by Cloud. */
+export const poolCreationProduct = (origin: string) =>
+  Effect.gen(function* () {
+    const target = yield* Target;
+    const fs = yield* FileSystem.FileSystem;
+    const path = yield* Path.Path;
+    const entry = path.join(target.directory, "pool-creation-product.ts");
+    const assetDirectory = path.resolve("apps/hosted/cloud/.generated/pool-app");
+    yield* fs.writeFileString(
+      entry,
+      `
+import * as Runtime from "@effect/platform-bun/BunRuntime";
+import { main } from "@executor-js/hosted-self-host/server";
+import { PoolAppSource, poolAppVersion, poolAppAssetPath } from "@executor-js/hosted-server/pool-defaults";
+import { poolAccessLifecycle } from "@executor-js/hosted-server/pool-access-hook";
+import { AccessLifecycle } from "@executor-js/hosted-server/access-lifecycle";
+import { SourceFiles } from "@executor-js/sdk/core";
+import { Effect, Option, Redacted, Schema } from "effect";
+import { readFile } from "node:fs/promises";
+import { basename, join } from "node:path";
+import { createHash } from "node:crypto";
+Runtime.runMain(Effect.gen(function* () {
+  const serialized = yield* Effect.tryPromise(() => readFile(join(${JSON.stringify(assetDirectory)}, basename(poolAppAssetPath)), "utf8"));
+  if (createHash("sha256").update(serialized).digest("hex") !== poolAppVersion)
+    return yield* Effect.die("Pool source differs from its production digest");
+  const files = yield* Schema.decodeUnknownEffect(SourceFiles)(JSON.parse(serialized));
+  return yield* main.pipe(
+    Effect.provideService(PoolAppSource, { version: poolAppVersion, files: Effect.succeed(files) }),
+    Effect.provideService(AccessLifecycle, poolAccessLifecycle(Option.some(Redacted.make("ab".repeat(32))), ${JSON.stringify(origin)})),
+  );
+}));
+`,
+    );
+    const links = path.join(target.directory, "node_modules", "@executor-js");
+    yield* fs.makeDirectory(links, { recursive: true });
+    const product = path.join(links, "hosted-self-host");
+    if (!(yield* fs.exists(product)))
+      yield* fs.symlink(path.resolve("apps/hosted/self-host"), product);
+    const configuration = path.join(target.directory, "pool-creation-product.json");
+    yield* fs.writeFileString(
+      configuration,
+      JSON.stringify({
+        extends: path.resolve("tsconfig.json"),
+        compilerOptions: { typeRoots: [path.resolve("node_modules/@types")] },
+        files: [entry],
+        include: [],
+        exclude: [],
+      }),
+    );
+    const processes = yield* ChildProcessSpawner.ChildProcessSpawner;
+    const checked = yield* processes.exitCode(
+      ChildProcess.make(
+        path.resolve("node_modules/.bin/tsc-rs"),
+        ["--noEmit", "-p", configuration],
+        { stdout: "inherit", stderr: "inherit" },
+      ),
+    );
+    if (checked !== 0)
+      return yield* Effect.die("Pool creation product failed its public API typecheck");
+    yield* serverControl("stop");
+    yield* serverControl("environment", 200, {
+      EXECUTOR_E2E_PRODUCT_ENTRY: entry,
+      POOL_APP_SIGNING_KEY: "ab".repeat(32),
+      BASALT_POOL_ORIGIN: origin,
+    });
+    yield* serverControl("start");
+  });
