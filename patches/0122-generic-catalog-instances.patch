--- /dev/null
+++ b/e2e/tests/catalog-instances.spec.ts
@@ -0,0 +1,279 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import {
+  AccountLinks,
+  Instance,
+  InstallResult,
+  catalogInstancesUI,
+  catalogRow as row,
+} from "../support/catalog-instances-ui.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { poolCreationBackend } from "../support/pool-creation-backend.ts";
+import { poolCreationProduct } from "../support/pool-creation-product.ts";
+import { captureCatalog, settleCatalogAnimations } from "../support/pool-creation-ui.ts";
+import { officialApps } from "../support/public-catalogs.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Catalog instances", (it) => {
+  it.effect(scenarios.catalogInstances.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api;
+        const browser = yield* Browser;
+        const actors = yield* Actors;
+        const ui = yield* catalogInstancesUI;
+        const backend = yield* poolCreationBackend;
+        yield* poolCreationProduct(backend.origin);
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const viewer = yield* body(
+          Schema.Struct({ userId: Schema.String }),
+          yield* api.request(actors.owner, "GET", "/api/viewer"),
+        );
+        yield* serverControl("stop");
+        yield* legacyStorage([
+          {
+            sql: 'update "user" set "emailVerified" = true where id = $1',
+            params: [viewer.userId],
+          },
+        ]);
+        yield* serverControl("start");
+        const install = (entry: string, name: string, newInstance = false) =>
+          api
+            .request(actors.owner, "POST", `${prefix}/apps/install`, {
+              entry,
+              name,
+              newInstance,
+              requestId: crypto.randomUUID(),
+            })
+            .pipe(Effect.flatMap((response) => body(Instance, response)));
+        const pool = yield* install("basalt-pool", "Retained pool", true);
+        // A legacy pool has no service claim or origin. Its owner-keyed metadata is authoritative.
+        yield* serverControl("stop");
+        yield* legacyStorage([
+          {
+            sql: `update organization set metadata = jsonb_set(metadata::jsonb - 'basaltServiceInstalls',
+            '{basaltPools}', jsonb_build_object($2::text, (metadata::jsonb -> 'basaltPools' -> $3) - 'owner'))::text
+            where id = $1`,
+            params: [actors.organization.id, viewer.userId, pool.id],
+          },
+          { sql: "update executor_apps set copied_from = null where id = $1", params: [pool.id] },
+        ]);
+        yield* serverControl("start");
+        const work = yield* install(officialApps.tracker.id, "Tracker work");
+        const personal = yield* install(officialApps.tracker.id, "Tracker personal", true);
+        const catalog = `/org/${actors.organization.slug}/apps/add`;
+        const visit = browser.use("Open the service catalog", (page) => page.goto(catalog));
+        const links = (id: string) =>
+          api
+            .request(actors.owner, "GET", `${prefix}/apps/${id}/accounts/user`)
+            .pipe(Effect.flatMap((response) => body(AccountLinks, response)));
+        yield* browser.login(actors.owner);
+        yield* visit;
+        // Old UI captures finish before the new-feature assertion used for the negative control.
+        yield* captureCatalog("Service catalog", (page) =>
+          row(page, officialApps.mail.name)
+            .getByRole("button", { name: `Add ${officialApps.mail.name}` })
+            .waitFor(),
+        );
+        expect(
+          yield* browser.use("One entry covers native and MCP tracker", (page) =>
+            row(page, officialApps.tracker.name).count(),
+          ),
+        ).toBe(1);
+        expect(
+          yield* browser.use("Every installed service offers Add another", (page) =>
+            row(page, "Pool").getByRole("button", { name: "More actions for Pool" }).count(),
+          ),
+        ).toBe(1);
+        expect(
+          yield* browser.use("Retained pool opens its exact ID", (page) =>
+            row(page, "Pool").getByRole("link", { name: "Open", exact: true }).getAttribute("href"),
+          ),
+        ).toBe(`/org/${actors.organization.slug}/apps/${pool.id}?view=accounts`);
+        yield* browser.use("Choose among tracker instances", (page) =>
+          row(page, officialApps.tracker.name)
+            .getByRole("button", { name: /choose one of 2/ })
+            .click(),
+        );
+        for (const app of [work, personal]) {
+          yield* browser.use(`Find ${app.name}`, (page) =>
+            page.getByRole("menuitem", { name: new RegExp(app.name) }).waitFor(),
+          );
+          expect(
+            yield* browser.use(`Open exact ${app.name}`, (page) =>
+              page.getByRole("menuitem", { name: new RegExp(app.name) }).getAttribute("href"),
+            ),
+          ).toContain(`/apps/${app.id}?view=accounts`);
+        }
+        yield* browser.use("Finish the desktop chooser transition", settleCatalogAnimations);
+        yield* browser.checkpoint("Desktop chooser keeps both named tracker instances reachable");
+        yield* browser.use("Escape closes the chooser", (page) => page.keyboard.press("Escape"));
+        expect(
+          yield* browser.use("Focus returns to Open", (page) =>
+            row(page, officialApps.tracker.name)
+              .getByRole("button", { name: /choose one of 2/ })
+              .evaluate((button) => button === document.activeElement),
+          ),
+        ).toBe(true);
+        yield* browser.use("Show phone layout", (page) =>
+          page.setViewportSize({ width: 390, height: 900 }),
+        );
+        yield* browser.use("Open phone chooser", (page) =>
+          row(page, officialApps.tracker.name)
+            .getByRole("button", { name: /choose one of 2/ })
+            .click(),
+        );
+        for (const app of [work, personal])
+          yield* browser.use(`Phone opens ${app.name}`, (page) =>
+            page
+              .getByRole("dialog", { name: `Open ${officialApps.tracker.name}`, exact: true })
+              .getByRole("link", { name: new RegExp(app.name) })
+              .waitFor(),
+          );
+        yield* browser.use("Finish the phone sheet transition", settleCatalogAnimations);
+        yield* browser.checkpoint("Phone chooser shows both named instances in a sheet");
+        yield* browser.use("Cancel phone chooser", (page) =>
+          page.getByRole("dialog").getByRole("button", { name: "Cancel", exact: true }).click(),
+        );
+        yield* browser.use("Return to desktop", (page) =>
+          page.setViewportSize({ width: 1280, height: 900 }),
+        );
+        yield* ui.another("Pool");
+        yield* ui.name("Denied pool");
+        yield* browser.use("Refuse creation before any write", (page) =>
+          page.route(
+            "**/api/organizations/*/apps/install",
+            (route) =>
+              route.fulfill({
+                status: 403,
+                contentType: "application/json",
+                body: JSON.stringify({ _tag: "OrganizationForbidden" }),
+              }),
+            { times: 1 },
+          ),
+        );
+        const denied = yield* ui.submit("Add", { dialog: true });
+        expect(denied.status).toBe(403);
+        yield* browser.use("A definite refusal finishes the request", (page) =>
+          page.getByText("Organization access denied", { exact: true }).waitFor(),
+        );
+        expect(
+          yield* browser.use("A definite refusal keeps the name editable", (page) =>
+            page.getByRole("textbox", { name: "Name", exact: true }).getAttribute("readonly"),
+          ),
+        ).toBeNull();
+        expect(
+          yield* browser.use("A definite refusal does not claim uncertain creation", (page) =>
+            page.getByText(/Couldn't confirm whether/).count(),
+          ),
+        ).toBe(0);
+        yield* browser.checkpoint("A definite refusal keeps the name editable");
+        yield* ui.name("Research pool");
+        yield* captureCatalog("Name a separate pool", (page) =>
+          page.getByRole("dialog", { name: "Add another Pool", exact: true }).waitFor(),
+        );
+        yield* backend.available(false);
+        const failed = yield* ui.submit("Add", { dialog: true });
+        expect(failed.status).toBe(503);
+        yield* browser.use("Uncertain creation offers retry", (page) =>
+          page.getByRole("button", { name: "Try again", exact: true }).waitFor(),
+        );
+        expect(
+          yield* browser.use("Uncertain name stays fixed", (page) =>
+            page.getByRole("textbox", { name: "Name", exact: true }).getAttribute("readonly"),
+          ),
+        ).not.toBeNull();
+        yield* browser.checkpoint("Unconfirmed creation keeps its name and retry request");
+        yield* browser.use("Close unfinished intent", (page) =>
+          page.getByRole("dialog").getByRole("button", { name: "Cancel", exact: true }).click(),
+        );
+        yield* ui.another("Pool");
+        expect(
+          yield* browser.use("Reopened intent keeps its name", (page) =>
+            page.getByRole("textbox", { name: "Name", exact: true }).inputValue(),
+          ),
+        ).toBe("Research pool");
+        yield* backend.available(true);
+        const retried = yield* ui.submit("Try again", { twice: true });
+        expect(retried.payload).toEqual(failed.payload);
+        expect(retried.status).toBe(200);
+        const research = yield* Schema.decodeUnknownEffect(InstallResult)(retried.body);
+        expect(research.reused).toBe(true);
+        expect(research.id).not.toBe(pool.id);
+        yield* ui.setup(research.id);
+        yield* visit;
+        yield* browser.use("Choose among both pools", (page) =>
+          row(page, "Pool")
+            .getByRole("button", { name: /choose one of 2/ })
+            .click(),
+        );
+        for (const app of [pool, research])
+          yield* browser.use(`Keep ${app.name} reachable`, (page) =>
+            page.getByRole("menuitem", { name: new RegExp(app.name) }).waitFor(),
+          );
+        yield* browser.use("Close pools chooser", (page) => page.keyboard.press("Escape"));
+        const addedMail = yield* ui.submit(`Add ${officialApps.mail.name}`);
+        expect(addedMail.status).toBe(200);
+        const mail = yield* Schema.decodeUnknownEffect(InstallResult)(addedMail.body);
+        expect(mail.reused).toBe(false);
+        yield* ui.setup(mail.id);
+        const account = yield* body(
+          Schema.Struct({ id: Schema.String }),
+          yield* api.request(actors.owner, "POST", `${prefix}/apps/${mail.id}/accounts/user/mail`, {
+            creation: crypto.randomUUID(),
+            method: "apiKey",
+            fields: { token: "synthetic-mail-token" },
+          }),
+        );
+        expect(
+          (yield* api.request(
+            actors.owner,
+            "PUT",
+            `${prefix}/apps/${mail.id}/accounts/user/mail/${account.id}`,
+          )).status,
+        ).toBe(200);
+        const originalLinks = yield* links(mail.id);
+        expect(originalLinks).toHaveLength(1);
+        yield* visit;
+        yield* ui.another(officialApps.mail.name);
+        yield* ui.name("Mail for research");
+        const anotherMail = yield* ui.submit("Add", { dialog: true });
+        expect(anotherMail.status).toBe(200);
+        const secondMail = yield* Schema.decodeUnknownEffect(InstallResult)(anotherMail.body);
+        yield* ui.setup(secondMail.id);
+        expect(secondMail.id).not.toBe(mail.id);
+        expect(yield* links(secondMail.id)).toEqual([]);
+        expect(yield* links(mail.id)).toEqual(originalLinks);
+        yield* browser.checkpoint("Another mail instance opens fresh setup without copying links");
+        yield* ui.staleInventory(catalog, [mail.id, secondMail.id]);
+        yield* browser.use("Stale inventory offers Add", (page) =>
+          row(page, officialApps.mail.name)
+            .getByRole("button", { name: `Add ${officialApps.mail.name}` })
+            .waitFor(),
+        );
+        // The stale read has reached the UI. Remove the route before app navigation cancels reads.
+        yield* ui.clearStaleInventory;
+        const reused = yield* ui.submit(`Add ${officialApps.mail.name}`);
+        expect(reused.status).toBe(200);
+        expect(yield* Schema.decodeUnknownEffect(InstallResult)(reused.body)).toEqual({
+          id: mail.id,
+          name: mail.name,
+          reused: true,
+        });
+        yield* ui.setup(mail.id);
+        expect(yield* links(mail.id)).toEqual(originalLinks);
+        const inventory = yield* body(
+          Schema.Struct({ apps: Schema.Array(Instance) }),
+          yield* api.request(actors.owner, "GET", `${prefix}/inventory`),
+        );
+        expect(inventory.apps.filter((app) => app.name === research.name)).toHaveLength(1);
+      }),
+    ),
+  );
+});
