diff --git a/packages/ui/src/implementation/dashboard/catalog-add-another.tsx b/packages/ui/src/implementation/dashboard/catalog-add-another.tsx
new file mode 100644
index 00000000..75b170a0
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/catalog-add-another.tsx
@@ -0,0 +1,201 @@
+import { useRef, useState, type ComponentType } from "react";
+import { Cause, Exit, Option, Predicate } from "effect";
+import type { CatalogEntry } from "@executor-js/catalog/contracts";
+import type { AppSummary, FailureProps, InstallApp } from "../../contracts/dashboard.ts";
+import { Button } from "../components/button.tsx";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogTitle,
+} from "../components/dialog.tsx";
+import { Input } from "../components/input.tsx";
+
+// Transport, decoding and storage failures can hide a committed install; declared refusals settle it.
+const unconfirmedFailures = [
+  "StorageError",
+  "PoolCreationUnavailable",
+  "HttpClientError",
+  "SchemaError",
+] as const;
+
+/** A version 4 UUID. `crypto.randomUUID` exists only in secure contexts; a self-host can be HTTP. */
+const newRequestId = () => {
+  const bytes = crypto.getRandomValues(new Uint8Array(16));
+  bytes[6] = ((bytes[6] ?? 0) & 0x0f) | 0x40;
+  bytes[8] = ((bytes[8] ?? 0) & 0x3f) | 0x80;
+  const hex = Array.from(bytes, (byte) => byte.toString(16).padStart(2, "0")).join("");
+  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
+};
+
+/**
+ * One deliberate new instance. `unconfirmed` means the last attempt may have created it: the name
+ * and request ID stay fixed until a retry gets an answer, so a retry can't add a second one.
+ */
+interface Draft<IE> {
+  readonly name: string;
+  readonly requestId: string;
+  readonly attempted: boolean;
+  readonly unconfirmed: boolean;
+  readonly failure?: Cause.Cause<IE>;
+}
+
+/**
+ * Add another: a separate, named instance installed through the service's own catalog entry with
+ * `newInstance`. Nothing is copied from the existing instances. Each entry keeps its draft while the
+ * page is open, so closing and reopening the dialog resumes the same request.
+ */
+export function AddAnotherDialog<IE>({
+  target,
+  install,
+  onInstalled,
+  onClose,
+  InstallFailure,
+}: {
+  readonly target:
+    | {
+        readonly entry: CatalogEntry;
+        readonly label: string;
+        /** Focus goes back here when the dialog closes; the menu that opened it is gone. */
+        readonly returnFocus: HTMLElement | null;
+      }
+    | undefined;
+  /** Runs the install, or resolves `undefined` when one for this entry is already running. */
+  readonly install: (
+    entry: CatalogEntry,
+    input: InstallApp,
+  ) => Promise<Exit.Exit<AppSummary, IE> | undefined>;
+  readonly onInstalled: (app: AppSummary) => void;
+  readonly onClose: () => void;
+  readonly InstallFailure: ComponentType<FailureProps<IE>>;
+}) {
+  const [drafts, setDrafts] = useState<ReadonlyMap<string, Draft<IE>>>(new Map());
+  const [sending, setSending] = useState(false);
+  // State updates land after the event; a second click in the same frame must not send twice.
+  const inFlight = useRef(false);
+  // The dialog keeps its content while it animates closed, after `target` is cleared.
+  const last = useRef(target);
+  if (target !== undefined) last.current = target;
+  const shown = target ?? last.current;
+  const entry = shown?.entry;
+  const draft: Draft<IE> | undefined =
+    entry &&
+    (drafts.get(entry.id) ?? {
+      name: "",
+      requestId: newRequestId(),
+      attempted: false,
+      unconfirmed: false,
+    });
+  const save = (id: string, next: Draft<IE> | undefined) =>
+    setDrafts((current) => {
+      const copy = new Map(current);
+      if (next === undefined) copy.delete(id);
+      else copy.set(id, next);
+      return copy;
+    });
+  const submit = async () => {
+    if (entry === undefined || draft === undefined || inFlight.current) return;
+    const name = draft.name.trim();
+    if (!name) return;
+    inFlight.current = true;
+    setSending(true);
+    const request = {
+      name,
+      requestId: draft.requestId,
+      attempted: true,
+      unconfirmed: draft.unconfirmed,
+    };
+    save(entry.id, request);
+    try {
+      const exit = await install(entry, {
+        entry: entry.id,
+        name,
+        newInstance: true,
+        requestId: request.requestId,
+      });
+      if (exit === undefined) return;
+      if (Exit.isSuccess(exit)) {
+        save(entry.id, undefined);
+        onClose();
+        onInstalled(exit.value);
+        return;
+      }
+      const error = Cause.findErrorOption(exit.cause);
+      const unconfirmed =
+        Option.isNone(error) ||
+        unconfirmedFailures.some((tag) => Predicate.isTagged(tag)(error.value));
+      save(entry.id, { ...request, unconfirmed, failure: exit.cause });
+    } finally {
+      inFlight.current = false;
+      setSending(false);
+    }
+  };
+  return (
+    <Dialog
+      open={target !== undefined}
+      onOpenChange={(open) => {
+        if (!open && !sending) onClose();
+      }}
+    >
+      <DialogContent
+        onCloseAutoFocus={(event) => {
+          const focus = shown?.returnFocus;
+          if (!focus?.isConnected) return;
+          event.preventDefault();
+          focus.focus({ preventScroll: true });
+        }}
+      >
+        <DialogTitle>{shown ? `Add another ${shown.label}` : null}</DialogTitle>
+        <DialogDescription>
+          {shown
+            ? `A separate ${shown.label} with its own name, set up the way ${shown.label} always is. It starts empty: no accounts, links or history are copied.`
+            : null}
+        </DialogDescription>
+        <form
+          className="space-y-4"
+          onSubmit={(event) => {
+            event.preventDefault();
+            void submit();
+          }}
+        >
+          <label className="field-label flex flex-col gap-2.25 text-[13px] font-medium">
+            Name
+            <Input
+              required
+              maxLength={120}
+              value={draft?.name ?? ""}
+              readOnly={draft?.unconfirmed}
+              disabled={sending}
+              onChange={(event) => {
+                if (entry === undefined || draft === undefined || draft.unconfirmed) return;
+                const name = event.target.value;
+                // A used request ID belongs to its name; a corrected name is a new request.
+                save(
+                  entry.id,
+                  draft.attempted
+                    ? { name, requestId: newRequestId(), attempted: false, unconfirmed: false }
+                    : { ...draft, name },
+                );
+              }}
+            />
+          </label>
+          {draft?.unconfirmed && (
+            <p className="text-[13px] text-muted-foreground">
+              {`Couldn't confirm whether ${draft.name} was added. Try again keeps the same name and request.`}
+            </p>
+          )}
+          {draft?.failure && <InstallFailure cause={draft.failure} layout="compact" />}
+          <DialogFooter>
+            <Button type="button" variant="outline" disabled={sending} onClick={onClose}>
+              Cancel
+            </Button>
+            <Button type="submit" loading={sending} disabled={!draft?.name.trim()}>
+              {draft?.unconfirmed ? "Try again" : "Add"}
+            </Button>
+          </DialogFooter>
+        </form>
+      </DialogContent>
+    </Dialog>
+  );
+}
diff --git a/packages/ui/src/implementation/dashboard/catalog-instances.ts b/packages/ui/src/implementation/dashboard/catalog-instances.ts
new file mode 100644
index 00000000..81f15963
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/catalog-instances.ts
@@ -0,0 +1,44 @@
+/** Which installed apps each catalog row stands for. The server owns service identity. */
+import type { CatalogEntry } from "@executor-js/catalog/contracts";
+import type { AppSummary } from "../../contracts/dashboard.ts";
+
+/**
+ * The installed instances of each catalog entry's service, keyed by entry ID, oldest first. An
+ * app's recorded service decides its entry, even when it names a service no entry lists. Only an
+ * app without one falls back to the exact package it was copied from: an entry's own package
+ * first, then a package another entry declares for its service. Names, hosts and endpoints never
+ * place an app; the server records the service of every app it can attribute.
+ */
+export function serviceInstances(
+  entries: readonly CatalogEntry[],
+  apps: readonly AppSummary[] | undefined,
+): ReadonlyMap<string, readonly AppSummary[]> {
+  const byService = new Map<string, string>();
+  const byPackage = new Map<string, string>();
+  for (const entry of entries) {
+    const service = entry.service?.id ?? entry.package;
+    if (!byService.has(service)) byService.set(service, entry.id);
+    if (!byPackage.has(entry.package)) byPackage.set(entry.package, entry.id);
+  }
+  // A declared package never takes the place of the entry that is that package.
+  for (const entry of entries)
+    for (const name of entry.service?.packages ?? [])
+      if (!byPackage.has(name)) byPackage.set(name, entry.id);
+  const instances = new Map<string, AppSummary[]>();
+  for (const app of apps ?? []) {
+    const entry =
+      app.service === undefined
+        ? app.copiedFrom && byPackage.get(app.copiedFrom.name)
+        : byService.get(app.service.id);
+    if (!entry) continue;
+    const list = instances.get(entry);
+    if (list === undefined) instances.set(entry, [app]);
+    else list.push(app);
+  }
+  for (const list of instances.values())
+    list.sort(
+      (a, b) =>
+        Number(a.createdAt) - Number(b.createdAt) || (a.id < b.id ? -1 : a.id > b.id ? 1 : 0),
+    );
+  return instances;
+}
