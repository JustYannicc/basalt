+import { Effect, Schema } from "effect";
+import type { Page } from "playwright";
+import { Browser } from "./browser.ts";
+
+export const catalogRow = (page: Page, name: string) =>
+  page.locator(".catalog-row").filter({
+    has: page.locator("strong").filter({ hasText: new RegExp(`^${name}$`) }),
+  });
+export const Instance = Schema.Struct({ id: Schema.String, name: Schema.String });
+export const InstallResult = Schema.Struct({
+  id: Schema.String,
+  name: Schema.String,
+  reused: Schema.Boolean,
+});
+export const AccountLinks = Schema.Array(
+  Schema.Struct({ requirement: Schema.String, account: Schema.Struct({ id: Schema.String }) }),
+);
+const inventoryRoute = /\/api\/organizations\/[^/]+\/inventory(?:\?|$)/;
+const Record = Schema.Record(Schema.String, Schema.Unknown);
+
+/** Browser transport operations; the scenario owns state, assertions and fixture writes. */
+export const catalogInstancesUI = Effect.gen(function* () {
+  const browser = yield* Browser;
+  const another = (label: string) =>
+    Effect.gen(function* () {
+      yield* browser.use(`Open ${label} actions`, (page) =>
+        catalogRow(page, label)
+          .getByRole("button", { name: `More actions for ${label}` })
+          .click(),
+      );
+      yield* browser.use(`Add another ${label}`, (page) =>
+        page.getByRole("menuitem", { name: "Add another", exact: true }).click(),
+      );
+      yield* browser.use(`Show ${label} naming`, (page) =>
+        page.getByRole("dialog", { name: `Add another ${label}`, exact: true }).waitFor(),
+      );
+    });
+  const name = (value: string) =>
+    browser.use(`Name ${value}`, (page) =>
+      page.getByRole("dialog").getByRole("textbox", { name: "Name", exact: true }).fill(value),
+    );
+  const submit = (
+    button: string,
+    options: { readonly dialog?: boolean; readonly twice?: boolean } = {},
+  ) =>
+    browser.use(`Submit ${button}`, (page) => {
+      const target = (options.dialog ? page.getByRole("dialog") : page).getByRole("button", {
+        name: button,
+        exact: true,
+      });
+      return Promise.all([
+        page.waitForResponse(
+          (response) =>
+            response.request().method() === "POST" &&
+            new URL(response.url()).pathname.endsWith("/apps/install"),
+        ),
+        options.twice ? target.dblclick() : target.click(),
+      ]).then(([response]) =>
+        response.json().then((body: unknown) => ({
+          status: response.status(),
+          payload: response.request().postDataJSON() as unknown,
+          body,
+        })),
+      );
+    });
+  const setup = (id: string) =>
+    browser.use("Open the returned app's setup", (page) =>
+      page.waitForURL(`**/apps/${id}?view=accounts`),
+    );
+  const staleInventory = (catalog: string, ids: readonly string[]) =>
+    Effect.gen(function* () {
+      yield* browser.use("Hide stale mail instances at the HTTP boundary", (page) =>
+        page.route(inventoryRoute, (route) =>
+          route.fetch().then((response) =>
+            response.json().then((json: unknown) => {
+              const record = Schema.decodeUnknownSync(Record)(json);
+              const apps = Schema.decodeUnknownSync(Schema.Array(Record))(record.apps);
+              return route.fulfill({
+                response,
+                json: {
+                  ...record,
+                  apps: apps.filter((app) => typeof app.id !== "string" || !ids.includes(app.id)),
+                },
+              });
+            }),
+          ),
+        ),
+      );
+      yield* browser.use("Revisit with stale inventory", (page) => page.goto(catalog));
+      yield* browser.use("Reload with stale inventory", (page) => page.reload());
+      // Hydration supplies the first inventory; returning to the tab requests the routed read.
+      yield* browser.use("Refresh the visible inventory", (page) =>
+        page.evaluate(() => {
+          window.dispatchEvent(new Event("visibilitychange"));
+        }),
+      );
+    });
+  return {
+    another,
+    name,
+    submit,
+    setup,
+    staleInventory,
+    clearStaleInventory: browser.use("Remove stale inventory response", (page) =>
+      page.unroute(inventoryRoute),
+    ),
+  };
+});
diff --git a/e2e/support/pool-creation-backend.ts b/e2e/support/pool-creation-backend.ts
new file mode 100644
index 00000000..c14b8f74
--- /dev/null
+++ b/e2e/support/pool-creation-backend.ts
@@ -0,0 +1,75 @@
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Effect, Layer, Ref, Schema } from "effect";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { createHmac, timingSafeEqual } from "node:crypto";
+import { createServer } from "node:http";
+
+const Audience = Schema.Struct({
+  pool: Schema.String,
+  owner: Schema.String,
+  organization: Schema.String,
+  users: Schema.Array(Schema.String),
+  managers: Schema.Array(Schema.String),
+  authorization: Schema.Literal("executor-app-v1"),
+});
+
+/** Only the remote pool receiver is synthetic; apps, accounts, policy and links are real. */
+export const poolCreationBackend = Effect.gen(function* () {
+  const pools = yield* Ref.make<readonly (typeof Audience.Type)[]>([]);
+  let available = true;
+  const receive = Effect.gen(function* () {
+    const request = yield* HttpServerRequest.HttpServerRequest;
+    const body = yield* request.json.pipe(
+      Effect.flatMap(Schema.decodeUnknownEffect(Schema.Struct({ envelope: Schema.String }))),
+    );
+    const [prefix, encoded, signature, extra] = body.envelope.split(".");
+    if (
+      prefix !== "sba1" ||
+      encoded === undefined ||
+      signature === undefined ||
+      extra !== undefined
+    )
+      return HttpServerResponse.empty({ status: 401 });
+    const expected = createHmac("sha256", Buffer.from("ab".repeat(32), "hex"))
+      .update(`${prefix}.${encoded}`)
+      .digest();
+    const actual = Buffer.from(signature, "base64url");
+    if (actual.length !== expected.length || !timingSafeEqual(actual, expected))
+      return HttpServerResponse.empty({ status: 401 });
+    if (!available) return HttpServerResponse.empty({ status: 503 });
+    const raw = JSON.parse(Buffer.from(encoded, "base64url").toString());
+    const value = yield* Schema.decodeUnknownEffect(
+      Schema.Struct({
+        action: Schema.String,
+        pools: Schema.optionalKey(Schema.Array(Audience)),
+      }),
+    )(raw);
+    if (value.pools !== undefined)
+      yield* Ref.update(pools, (current) => [...current, ...value.pools!]);
+    return HttpServerResponse.empty({ status: 200 });
+  });
+  const services = yield* Layer.build(
+    HttpRouter.serve(
+      Layer.mergeAll(
+        HttpRouter.add("POST", "/pool/v1/access", receive),
+        // Link invalidation is acknowledged; no synthetic model inference is claimed.
+        HttpRouter.add(
+          "POST",
+          "/pool/v1/membership",
+          Effect.succeed(HttpServerResponse.empty({ status: 200 })),
+        ),
+      ),
+      { disableLogger: true, disableListenLog: true },
+    ).pipe(Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 }))),
+  );
+  const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+  if (!("port" in server.address)) return yield* Effect.die("Pool receiver requires TCP");
+  return {
+    origin: `http://127.0.0.1:${server.address.port}`,
+    pools: Ref.get(pools),
+    available: (value: boolean) =>
+      Effect.sync(() => {
+        available = value;
+      }),
+  };
+});
