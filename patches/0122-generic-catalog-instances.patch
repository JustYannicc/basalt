+import { Effect } from "effect";
+import type { Page } from "playwright";
+import { Browser } from "./browser.ts";
+
+export const settleCatalogAnimations = (page: Page) =>
+  page.evaluate(() =>
+    // A theme switch cancels running transitions, which rejects their `finished`.
+    Promise.allSettled(document.getAnimations().map((animation) => animation.finished)).then(
+      () => {},
+    ),
+  );
+
+/** Captures the current catalog state in light and dark, at desktop and phone widths. */
+export const captureCatalog = (name: string, ready: (page: Page) => Promise<unknown>) =>
+  Effect.gen(function* () {
+    const browser = yield* Browser;
+    for (const width of [1280, 390])
+      for (const colorScheme of ["light", "dark"] as const) {
+        yield* browser.use(`Show ${name} at ${width}px in ${colorScheme} mode`, (page) =>
+          page
+            .setViewportSize({ width, height: 900 })
+            .then(() => page.emulateMedia({ colorScheme }))
+            .then(() => ready(page))
+            .then(() => settleCatalogAnimations(page)),
+        );
+        const fits = yield* browser.use(`Keep ${name} inside ${width}px`, (page) =>
+          page.evaluate(() => document.documentElement.scrollWidth <= innerWidth),
+        );
+        if (!fits) return yield* Effect.die(`${name} overflows at ${width}px`);
+        yield* browser.checkpoint(`${name} ${width}px ${colorScheme}`);
+      }
+    yield* browser.use(`Return from ${name} to the desktop light view`, (page) =>
+      page
+        .setViewportSize({ width: 1280, height: 900 })
+        .then(() => page.emulateMedia({ colorScheme: "light" })),
+    );
+  });
