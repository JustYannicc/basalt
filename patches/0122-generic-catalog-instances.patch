+import { useRef, useState, type ReactElement, type ReactNode } from "react";
+import { HugeiconsIcon } from "@hugeicons/react";
+import { Add01Icon, ArrowDown01Icon, MoreHorizontalIcon } from "@hugeicons/core-free-icons";
+import type { AppSummary } from "../../contracts/dashboard.ts";
+import { Button } from "../components/button.tsx";
+import {
+  Dialog,
+  DialogClose,
+  DialogContent,
+  DialogTitle,
+  DialogTrigger,
+} from "../components/dialog.tsx";
+import {
+  DropdownMenu,
+  DropdownMenuContent,
+  DropdownMenuItem,
+  DropdownMenuLabel,
+  DropdownMenuTrigger,
+} from "../components/dropdown-menu.tsx";
+import { formatMoment, useDisplayFormat } from "../hooks/display-format.ts";
+import { useMediaQuery } from "../hooks/media-query.ts";
+
+/** Renders a link to an app's own page around the given content. */
+export type OpenApp = (app: AppSummary, children: ReactNode) => ReactNode;
+
+/**
+ * A catalog row's actions. A service not yet added offers Add. One instance opens directly; with
+ * several, Open asks which one and never picks for the user. Every added service offers Add
+ * another, which installs a separate, empty instance through the same service.
+ */
+export function CatalogRowActions({
+  label,
+  instances,
+  adding,
+  open,
+  onAdd,
+  onAddAnother,
+}: {
+  /** The service's display name. */
+  readonly label: string;
+  readonly instances: readonly AppSummary[];
+  readonly adding: boolean;
+  readonly open: OpenApp;
+  readonly onAdd: () => void;
+  /** Starts another instance; focus returns to the given element when that ends. */
+  readonly onAddAnother: (returnFocus: HTMLElement | null) => void;
+}) {
+  const format = useDisplayFormat();
+  const more = useRef<HTMLButtonElement>(null);
+  const [only] = instances;
+  if (only === undefined)
+    return (
+      <div className={actionsClass}>
+        <Button
+          type="button"
+          variant="outline"
+          size="sm"
+          aria-label={`Add ${label}`}
+          disabled={adding}
+          onClick={onAdd}
+        >
+          {adding ? "Adding…" : "Add"}
+        </Button>
+      </div>
+    );
+  return (
+    <div className={actionsClass}>
+      {instances.length === 1 ? (
+        <Button variant="outline" size="sm" asChild title={`Open ${only.name}`}>
+          {open(only, "Open")}
+        </Button>
+      ) : (
+        <RowMenu
+          title={`Open ${label}`}
+          trigger={
+            <Button
+              type="button"
+              variant="outline"
+              size="sm"
+              aria-label={`Open ${label}: choose one of ${instances.length}`}
+            >
+              Open
+              <HugeiconsIcon icon={ArrowDown01Icon} strokeWidth={2} aria-hidden />
+            </Button>
+          }
+          items={instances.map((app) => ({
+            key: app.id,
+            label: app.name,
+            detail: `Added ${formatMoment(app.createdAt, format, { day: "numeric", month: "short", year: "numeric" })}`,
+            link: (content: ReactNode) => open(app, content),
+          }))}
+        />
+      )}
+      <RowMenu
+        title={label}
+        trigger={
+          <Button
+            ref={more}
+            type="button"
+            variant="outline"
+            size="icon-sm"
+            aria-label={`More actions for ${label}`}
+            disabled={adding}
+          >
+            <HugeiconsIcon icon={MoreHorizontalIcon} strokeWidth={2} aria-hidden />
+          </Button>
+        }
+        items={[
+          {
+            key: "another",
+            label: "Add another",
+            icon: <HugeiconsIcon icon={Add01Icon} strokeWidth={2} aria-hidden />,
+            onSelect: () => onAddAnother(more.current),
+          },
+        ]}
+      />
+    </div>
+  );
+}
+
+/** The actions sit in the row's last column on phones, beside the name and description. */
+const actionsClass =
+  "catalog-row-actions flex shrink-0 items-center gap-2 max-[740px]:col-[3] max-[740px]:row-[1_/_3]";
+
+/** The phone layout the dashboard shell switches at. */
+const phoneViewport = "(max-width: 740px)";
+
+type RowMenuItem =
+  | {
+      readonly key: string;
+      readonly label: string;
+      readonly detail: string;
+      readonly link: (content: ReactNode) => ReactNode;
+    }
+  | {
+      readonly key: string;
+      readonly label: string;
+      readonly icon: ReactNode;
+      readonly onSelect: () => void;
+    };
+
+/**
+ * A row's menu: anchored to its trigger on wide screens, a bottom sheet with full-height targets on
+ * phones. Escape and an outside press close both, and focus returns to the trigger.
+ */
+function RowMenu({
+  title,
+  trigger,
+  items,
+}: {
+  /** Names the menu for assistive technology; the sheet also shows it. */
+  readonly title: string;
+  readonly trigger: ReactElement;
+  readonly items: readonly RowMenuItem[];
+}) {
+  const phone = useMediaQuery(phoneViewport);
+  const [open, setOpen] = useState(false);
+  const content = (item: RowMenuItem) =>
+    "link" in item ? (
+      <>
+        <span className="min-w-0 flex-1 truncate">{item.label}</span>
+        <span className="shrink-0 text-xs text-muted-foreground">{item.detail}</span>
+      </>
+    ) : (
+      <>
+        {item.icon}
+        {item.label}
+      </>
+    );
+  if (phone)
+    return (
+      <Dialog open={open} onOpenChange={setOpen}>
+        <DialogTrigger asChild>{trigger}</DialogTrigger>
+        <DialogContent
+          showCloseButton={false}
+          aria-describedby={undefined}
+          overlayClassName="bg-black/20"
+          className="top-auto bottom-0 left-0 translate-x-0 translate-y-0 w-full max-w-none sm:max-w-none gap-0 rounded-b-none rounded-t-[14px] border-b-0 p-[8px_8px_max(12px,_env(safe-area-inset-bottom))] max-h-[85dvh] overflow-y-auto data-[state=open]:slide-in-from-bottom-4 data-[state=closed]:slide-out-to-bottom-4 data-[state=open]:zoom-in-100 data-[state=closed]:zoom-out-100"
+          onClickCapture={(event) => {
+            // Following a link closes the sheet; the route change happens as usual.
+            if (event.target instanceof Element && event.target.closest("a")) setOpen(false);
+          }}
+        >
+          <div className="mx-auto mb-2 h-1 w-9 rounded-full bg-border" aria-hidden />
+          <DialogTitle className="px-2.5 pt-1 pb-2 text-[13px] font-medium text-muted-foreground">
+            {title}
+          </DialogTitle>
+          <ul className="flex flex-col">
+            {items.map((item) => (
+              <li key={item.key}>
+                {"link" in item ? (
+                  <Button variant="ghost" asChild className="w-full justify-between gap-3">
+                    {item.link(content(item))}
+                  </Button>
+                ) : (
+                  <Button
+                    type="button"
+                    variant="ghost"
+                    className="w-full justify-start"
+                    onClick={() => {
+                      setOpen(false);
+                      item.onSelect();
+                    }}
+                  >
+                    {content(item)}
+                  </Button>
+                )}
+              </li>
+            ))}
+          </ul>
+          <DialogClose asChild>
+            <Button type="button" variant="outline" className="mt-2 w-full">
+              Cancel
+            </Button>
+          </DialogClose>
+        </DialogContent>
+      </Dialog>
+    );
+  return (
+    <DropdownMenu open={open} onOpenChange={setOpen}>
+      <DropdownMenuTrigger asChild>{trigger}</DropdownMenuTrigger>
+      <DropdownMenuContent align="end" className="min-w-56 max-w-80" aria-label={title}>
+        {"link" in (items[0] ?? {}) && (
+          <DropdownMenuLabel className="text-xs font-normal text-muted-foreground">
+            {title}
+          </DropdownMenuLabel>
+        )}
+        {items.map((item) =>
+          "link" in item ? (
+            <DropdownMenuItem key={item.key} asChild>
+              {item.link(content(item))}
+            </DropdownMenuItem>
+          ) : (
+            <DropdownMenuItem key={item.key} onSelect={item.onSelect}>
+              {content(item)}
+            </DropdownMenuItem>
+          ),
+        )}
+      </DropdownMenuContent>
+    </DropdownMenu>
+  );
+}
