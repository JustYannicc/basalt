new file mode 100644
index 00000000..ef65db3f
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pools.ts
@@ -0,0 +1,173 @@
+import { AppNameTaken, AppSlugTaken, StorageError, type App } from "@executor-js/sdk/core";
+import { Config, Effect, Option, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import { HttpApiBuilder } from "effect/http-api";
+import { HostedApi } from "../contracts/api.ts";
+import { AccessLifecycle } from "../contracts/access-lifecycle.ts";
+import { CurrentUserId } from "../contracts/auth.ts";
+import { HostedExecutor } from "../contracts/executor.ts";
+import { CurrentOrganization, OrganizationForbidden } from "../contracts/organization.ts";
+import { PoolAppSource } from "../contracts/pool-defaults.ts";
+import {
+  CreatePool,
+  PoolCreationConflict,
+  PoolCreationUnavailable,
+} from "../contracts/pool-creation.ts";
+import { ScheduleWakeup } from "../contracts/schedules.ts";
+import { lockAppLinks } from "./app-accounts.ts";
+import { repairPoolAccount, poolTokenKeyVersion } from "./pool-account.ts";
+import { ownedPoolRecords, PoolRecords } from "./pool-records.ts";
+import { currentResourceAuthority, policyDatabase } from "./resource-policy.ts";
+import { poolAppSetup } from "./resource-lifecycle.ts";
+import { poolCatalogPackage, poolCatalogService } from "./pool-catalog.ts";
+import { installService } from "./service-installs.ts";
+
+/** Compilation precedes publication; the app, token, link and record commit together. */
+const createPoolApp = (input: typeof CreatePool.Type, replayed: () => void) =>
+  Effect.gen(function* () {
+    const actor = yield* currentResourceAuthority;
+    if (actor.role !== "owner") return yield* new OrganizationForbidden();
+    const { owner, organization } = yield* CurrentOrganization;
+    const user = yield* CurrentUserId;
+    if (user === undefined) return yield* new OrganizationForbidden();
+    const executor = yield* Effect.flatten(HostedExecutor);
+    const sql = yield* policyDatabase;
+    const eligible = yield* sql`select m.id from member m join "user" u on u.id = m."userId"
+      where m."organizationId" = ${organization} and m."userId" = ${user}
+        and m.role = 'owner' and u."emailVerified" = true`;
+    if (eligible.length !== 1) return yield* new OrganizationForbidden();
+    const key = yield* Config.Redacted("POOL_APP_SIGNING_KEY").pipe(
+      Config.option,
+      Effect.mapError(() => new PoolCreationUnavailable()),
+    );
+    const source = yield* Effect.serviceOption(PoolAppSource);
+    if (Option.isNone(key) || Option.isNone(source)) return yield* new PoolCreationUnavailable();
+    const seed = source.value;
+    const signingKey = key.value;
+    const tokenKeyVersion = yield* poolTokenKeyVersion(signingKey);
+    const records = (lock = false) =>
+      Effect.gen(function* () {
+        const rows =
+          yield* sql`select coalesce(metadata::jsonb -> 'basaltPools', '{}'::jsonb) as pools
+      from organization where id = ${organization} ${lock ? sql`for no key update` : sql``}`;
+        if (rows.length !== 1) return yield* new StorageError();
+        return yield* Schema.decodeUnknownEffect(PoolRecords)(rows[0]);
+      });
+    const replay = Effect.gen(function* () {
+      const { pools } = yield* records();
+      const matches = ownedPoolRecords(pools, user).filter(
+        ([, record]) => record.requestId === input.requestId,
+      );
+      if (matches.length === 0) return undefined;
+      const saved = matches[0]?.[1];
+      if (matches.length !== 1 || saved?.requestName !== input.name)
+        return yield* new PoolCreationConflict();
+      return yield* executor.apps.get({ owner, app: saved.app }).pipe(
+        Effect.tap(() => Effect.sync(replayed)),
+        Effect.catchTag("AppNotFound", () => new PoolCreationConflict()),
+      );
+    });
+    const previous = yield* replay;
+    if (previous !== undefined) return previous;
+    const publish = (app: App) =>
+      Effect.gen(function* () {
+        const { pools } = yield* records(true);
+        if (
+          Object.hasOwn(pools, app.id) ||
+          app.activeVersion === null ||
+          ownedPoolRecords(pools, user).some(([, record]) => record.requestId === input.requestId)
+        )
+          return yield* new StorageError();
+        yield* lockAppLinks(sql, app.id);
+        const repaired = yield* repairPoolAccount(
+          executor,
+          sql,
+          signingKey,
+          organization,
+          user,
+          app,
+        );
+        const record = {
+          app: app.id,
+          version: app.activeVersion,
+          bundle: seed.version,
+          account: repaired.account,
+          tokenKeyVersion,
+          owner: user,
+          primary: input.newInstance !== true,
+          requestId: input.requestId,
+          requestName: input.name,
+          authorization: "executor-app-v1",
+          membership: "executor-links-v1",
+        };
+        yield* sql`update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb),
+      '{basaltPools}', coalesce(metadata::jsonb -> 'basaltPools', '{}'::jsonb)
+        || jsonb_build_object(${app.id}::text, ${JSON.stringify(record)}::jsonb))::text
+      where id = ${organization}`;
+      }).pipe(Effect.mapError(() => new StorageError()));
+    const files = yield* seed.files;
+    const app = yield* executor.apps
+      .copy({
+        owner,
+        name: input.name,
+        from: {
+          files,
+          activation: "deploy",
+          origin: {
+            reference: "https://github.com/JustYannicc/basalt/tree/main/apps/pool",
+            name: poolCatalogPackage,
+            commit: null,
+          },
+        },
+      })
+      .pipe(
+        poolAppSetup(user, publish),
+        Effect.catch((error) =>
+          Effect.gen(function* () {
+            const saved = yield* replay;
+            if (saved !== undefined) return saved;
+            return yield* Effect.fail(
+              Schema.is(AppNameTaken)(error) || Schema.is(AppSlugTaken)(error)
+                ? error
+                : new StorageError(),
+            );
+          }),
+        ),
+        Effect.provideService(SqlClient.SqlClient, sql),
+      );
+    const wake = yield* Effect.serviceOption(ScheduleWakeup);
+    if (Option.isSome(wake)) yield* wake.value;
+    return app;
+  }).pipe(
+    Effect.tap((app) =>
+      Effect.gen(function* () {
+        const lifecycle = yield* AccessLifecycle;
+        const organization = (yield* CurrentOrganization).organization;
+        yield* (lifecycle.appAccessChanged?.({ organization, apps: [app.id] }) ?? Effect.void).pipe(
+          Effect.provideService(SqlClient.SqlClient, yield* policyDatabase),
+          Effect.mapError(() => new PoolCreationUnavailable()),
+        );
+      }),
+    ),
+    Effect.catchTags({ SqlError: () => new StorageError(), SchemaError: () => new StorageError() }),
+  );
+
+export const createPool = (input: typeof CreatePool.Type) =>
+  Effect.gen(function* () {
+    const { owner } = yield* CurrentOrganization;
+    let replayed = false;
+    // Service reuse surrounds all pool work, so opening a retained pool cannot repair or reconfigure it.
+    const app = yield* installService(
+      owner,
+      poolCatalogService,
+      input.newInstance ?? false,
+      createPoolApp(input, () => {
+        replayed = true;
+      }),
+    );
+    return replayed ? { ...app, reused: true } : app;
+  });
+
+export const hostedPoolHandlers = HttpApiBuilder.group(HostedApi, "pools", (handlers) =>
+  handlers.handle("create", ({ payload }) => createPool(payload)),
+);
