+import { AppName } from "@executor-js/sdk/core";
+import { ApiError } from "@executor-js/utils/api-error";
+import { Schema } from "effect";
+
+export const PoolCreationId = Schema.String.check(
+  Schema.isPattern(
+    /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$/u,
+  ),
+);
+export const CreatePool = Schema.Struct({
+  name: AppName,
+  requestId: PoolCreationId,
+  newInstance: Schema.optionalKey(Schema.Boolean),
+});
+
+export const PoolCreationUnavailable = ApiError.define({
+  tag: "PoolCreationUnavailable",
+  status: 503,
+  message: "Pool creation is unavailable right now. Retry this request with the same name.",
+});
+export const PoolCreationConflict = ApiError.define({
+  tag: "PoolCreationConflict",
+  status: 409,
+  message:
+    "This creation request was already used. Keep the original name when retrying, or start a new request.",
+});
