diff --git a/e2e/tests/pool-creation.spec.ts b/e2e/tests/pool-creation.spec.ts
new file mode 100644
index 00000000..49e8c1cb
--- /dev/null
+++ b/e2e/tests/pool-creation.spec.ts
@@ -0,0 +1,256 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { randomUUID } from "node:crypto";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { Evidence } from "../support/evidence.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { poolCreationBackend } from "../support/pool-creation-backend.ts";
+import { poolCreationProduct } from "../support/pool-creation-product.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+const App = Schema.Struct({
+  id: Schema.String,
+  name: Schema.String,
+  activeVersion: Schema.String,
+  copiedFrom: Schema.NullOr(Schema.Struct({ name: Schema.String })),
+  service: Schema.optionalKey(Schema.Struct({ id: Schema.String, newInstance: Schema.Boolean })),
+  reused: Schema.optionalKey(Schema.Boolean),
+});
+const Links = Schema.Array(
+  Schema.Struct({
+    requirement: Schema.String,
+    account: Schema.Struct({ id: Schema.String }),
+    hostManaged: Schema.optionalKey(Schema.Boolean),
+  }),
+);
+const Catalog = Schema.Array(
+  Schema.Struct({
+    id: Schema.String,
+    name: Schema.String,
+    service: Schema.Struct({
+      id: Schema.String,
+      mcp: Schema.Array(Schema.String),
+      packages: Schema.optionalKey(Schema.Array(Schema.String)),
+    }),
+  }),
+);
+
+layer(RuntimeLive, { excludeTestServices: true })("Pool creation", (it) => {
+  it.effect(scenarios.poolCreation.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api;
+        const actors = yield* Actors;
+        const evidence = yield* Evidence;
+        const backend = yield* poolCreationBackend;
+        yield* poolCreationProduct(backend.origin);
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const viewer = yield* body(
+          Schema.Struct({ userId: Schema.String }),
+          yield* api.request(actors.owner, "GET", "/api/viewer"),
+        );
+        const create = (name: string, requestId = randomUUID()) =>
+          api.request(actors.owner, "POST", `${prefix}/pools`, {
+            name,
+            requestId,
+            newInstance: true,
+          });
+        const readLinks = (id: string) =>
+          api
+            .request(actors.owner, "GET", `${prefix}/apps/${id}/accounts/app`)
+            .pipe(Effect.flatMap((response) => body(Links, response)));
+        const catalog = yield* body(
+          Catalog,
+          yield* api.request(actors.owner, "GET", `${prefix}/catalog?search=pool`),
+        );
+        expect(catalog).toContainEqual({
+          id: "basalt-pool",
+          name: "Pool",
+          service: { id: "@signalbox/pool", mcp: [], packages: ["basalt-pool"] },
+        });
+        expect((yield* create("Unverified owner")).status).toBe(403);
+        // A retained verified identity has the eligibility of an existing Google sign-in.
+        yield* serverControl("stop");
+        const identity = yield* legacyStorage([
+          {
+            sql: `update "user" set "emailVerified" = true where id = $1 returning id`,
+            params: [viewer.userId],
+          },
+        ]);
+        expect(identity[0]).toEqual([{ id: viewer.userId }]);
+        yield* serverControl("start");
+        const originalResponse = yield* create("Existing pool");
+        expect(originalResponse.status, JSON.stringify(originalResponse.body)).toBe(200);
+        const original = yield* body(App, originalResponse);
+        expect(original.copiedFrom?.name).toBe("basalt-pool");
+        expect(original.service).toEqual({ id: "@signalbox/pool", newInstance: true });
+        expect(original.reused).toBe(false);
+        const originalLinks = yield* readLinks(original.id);
+        expect(originalLinks).toEqual(
+          expect.arrayContaining([
+            expect.objectContaining({ requirement: "pool", hostManaged: true }),
+          ]),
+        );
+        // Retained installations use a user key. Preserve that complete record, including policy fields.
+        yield* serverControl("stop");
+        const retained = yield* legacyStorage([
+          {
+            sql: `update organization set metadata = jsonb_set(metadata::jsonb, '{basaltPools}',
+      jsonb_build_object($2::text, (metadata::jsonb -> 'basaltPools' -> $3) - 'owner'))::text
+      where id = $1 returning metadata::jsonb -> 'basaltPools' -> $2 as record`,
+            params: [actors.organization.id, viewer.userId, original.id],
+          },
+          {
+            sql: `update organization set metadata = (metadata::jsonb - 'basaltServiceInstalls')::text
+              where id = $1`,
+            params: [actors.organization.id],
+          },
+          {
+            sql: `update executor_apps set copied_from = null where id = $1`,
+            params: [original.id],
+          },
+        ]);
+        yield* serverControl("start");
+        // Neither a catalog origin nor a service claim remains: only the retained pool ID identifies it.
+        const legacy = yield* body(
+          App,
+          yield* api.request(actors.owner, "GET", `${prefix}/apps/${original.id}`),
+        );
+        expect(legacy.copiedFrom).toBeNull();
+        expect(legacy.service).toEqual({ id: "@signalbox/pool", newInstance: true });
+        const reused = yield* body(
+          App,
+          yield* api.request(actors.owner, "POST", `${prefix}/apps/install`, {
+            entry: "basalt-pool",
+            name: "Another name does not create a pool",
+          }),
+        );
+        expect(reused.id).toBe(original.id);
+        expect(reused.name).toBe(original.name);
+        expect(reused.activeVersion).toBe(original.activeVersion);
+        expect(reused.reused).toBe(true);
+        expect(reused.service).toEqual(legacy.service);
+        expect(yield* readLinks(original.id)).toEqual(originalLinks);
+        const privateReuse = yield* api.request(actors.member, "POST", `${prefix}/apps/install`, {
+          entry: "basalt-pool",
+          name: "Private pool",
+        });
+        expect(privateReuse.status).toBe(403);
+        expect(JSON.stringify(privateReuse.body)).not.toContain(original.id);
+        expect(JSON.stringify(privateReuse.body)).not.toContain(original.name);
+        const requestId = randomUUID();
+        const [first, retry] = yield* Effect.all(
+          [create("Research pool", requestId), create("Research pool", requestId)],
+          { concurrency: 2 },
+        );
+        expect(first.status, JSON.stringify(first.body)).toBe(200);
+        expect(retry.status, JSON.stringify(retry.body)).toBe(200);
+        const second = yield* body(App, first);
+        expect((yield* body(App, retry)).id).toBe(second.id);
+        expect(second.id).not.toBe(original.id);
+        expect((yield* create("Changed request", requestId)).status).toBe(409);
+        const thirdResponse = yield* api.request(actors.owner, "POST", `${prefix}/apps/install`, {
+          entry: "basalt-pool",
+          name: "Team pool",
+          requestId: randomUUID(),
+          newInstance: true,
+        });
+        expect(thirdResponse.status, JSON.stringify(thirdResponse.body)).toBe(200);
+        const third = yield* body(App, thirdResponse);
+        expect(new Set([original.id, second.id, third.id]).size).toBe(3);
+        const stillDefault = yield* body(
+          App,
+          yield* api.request(actors.owner, "POST", `${prefix}/apps/install`, {
+            entry: "basalt-pool",
+            name: "Still not a deliberate instance",
+          }),
+        );
+        expect(stillDefault.id).toBe(original.id);
+        expect(stillDefault.reused).toBe(true);
+        const secondLinks = yield* readLinks(second.id);
+        const thirdLinks = yield* readLinks(third.id);
+        expect(
+          new Set(
+            [originalLinks, secondLinks, thirdLinks].flatMap((links) =>
+              links.map((link) => link.account.id),
+            ),
+          ).size,
+        ).toBe(3);
+        expect(yield* readLinks(original.id)).toEqual(originalLinks);
+        expect(
+          (yield* api.request(actors.member, "POST", `${prefix}/pools`, {
+            name: "Denied",
+            requestId: randomUUID(),
+          })).status,
+        ).toBe(403);
+        expect(
+          (yield* api.request(actors.member, "GET", `${prefix}/apps/${second.id}/accounts/app`))
+            .status,
+        ).toBe(403);
+        expect((yield* create("Research pool")).status).toBe(409);
+        expect(
+          (yield* api.request(actors.owner, "POST", `${prefix}/pools`, {
+            name: "Invalid",
+            requestId: "bad",
+          })).status,
+        ).toBe(400);
+        // Publication survived restart, and an uncertain response retries only receiver synchronization.
+        yield* backend.available(false);
+        const recoveryId = randomUUID();
+        expect((yield* create("Receiver recovery", recoveryId)).status).toBe(503);
+        yield* backend.available(true);
+        yield* serverControl("restart");
+        const recoveredResponse = yield* create("Receiver recovery", recoveryId);
+        expect(recoveredResponse.status, JSON.stringify(recoveredResponse.body)).toBe(200);
+        const recovered = yield* body(App, recoveredResponse);
+        const inventory = yield* body(
+          Schema.Array(App),
+          yield* api.request(actors.owner, "GET", `${prefix}/apps`),
+        );
+        expect(
+          inventory.filter((app) =>
+            [original.id, second.id, third.id, recovered.id].includes(app.id),
+          ),
+        ).toHaveLength(4);
+        expect(inventory.filter((app) => app.name === "Receiver recovery")).toHaveLength(1);
+        yield* serverControl("stop");
+        const records = yield* legacyStorage([
+          {
+            sql: "select metadata::jsonb -> 'basaltPools' as pools from organization where id=$1",
+            params: [actors.organization.id],
+          },
+        ]);
+        expect(records[0]?.[0]?.pools).toMatchObject({
+          [viewer.userId]: retained[0]?.[0]?.record,
+          [second.id]: { app: second.id, owner: viewer.userId },
+        });
+        yield* serverControl("start");
+        const audiences = yield* backend.pools;
+        expect(audiences).toEqual(
+          expect.arrayContaining([
+            expect.objectContaining({
+              pool: second.id,
+              owner: viewer.userId,
+              users: [viewer.userId],
+            }),
+          ]),
+        );
+        yield* evidence.json("pool-creation.json", {
+          apps: inventory,
+          originalLinks,
+          legacy,
+          reused,
+          secondLinks,
+          thirdLinks,
+          records,
+          audiences,
+        });
+      }),
+    ),
+  );
+});
