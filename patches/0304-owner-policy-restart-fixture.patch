@@ -0,0 +1,12 @@
+import { layer } from "@effect/vitest";
+import { withHostedHttpCase } from "../support/case.ts";
+import { ownerToolPolicyCase } from "../support/owner-tool-policy-case.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(RuntimeLive, { excludeTestServices: true })("Approval policy persistence", (it) => {
+  it.effect(scenarios.hostedToolPolicyRestart.title, (context) =>
+    withHostedHttpCase(context, ownerToolPolicyCase(serverControl("restart"))),
+  );
+});
