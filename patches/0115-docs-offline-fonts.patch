+// Keep the same Latin variable faces in source; Cloud startup must not fetch fonts.
+const latinUnicodeRange =
+  "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD";
+const fontSubsets: AstroIntegration = {
+  name: "executor-docs-font-subsets",
+  hooks: {
+    "astro:config:setup": ({ config }) => {
+      // Blume's local variant schema omits Astro's unicodeRange option.
+      for (const font of config.fonts ?? []) {
+        if (font.name !== "Geist" && font.name !== "Geist Mono") continue;
+        for (const variant of font.options?.variants ?? []) {
+          variant.unicodeRange = [latinUnicodeRange];
+          variant.weight = font.name === "Geist" ? "400 700" : "400 600";
+        }
+      }
+    },
+  },
+};
+const geist = {
+  name: "Geist",
+  variants: [
