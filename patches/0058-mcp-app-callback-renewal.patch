diff --git a/e2e/support/mcp-app-renewal.ts b/e2e/support/mcp-app-renewal.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/mcp-app-renewal.ts
@@ -0,0 +1,109 @@
+import { expect } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import type { Browser } from "./browser.ts";
+
+const guest = (page: import("playwright").Page) =>
+  page
+    .frameLocator('iframe[title="Executor view"]')
+    .frameLocator("iframe")
+    .frameLocator('iframe[title="App content"]');
+
+export const prepareRenewalDraft = (browser: Browser["Service"], peer: string) =>
+  Effect.gen(function* () {
+    yield* browser.use("Keep the client wall clock five minutes behind the server", (page) =>
+      page.clock.install({ time: Date.now() - 5 * 60 * 1000 }),
+    );
+    yield* browser.use("Open the retained app before callback expiry", (page) => page.goto(peer));
+    yield* browser.use("Wait for the live retained guest", (page) =>
+      guest(page)
+        .getByRole("status")
+        .filter({ hasText: /^Ready$/ })
+        .waitFor(),
+    );
+    yield* browser.use("Keep an unsaved draft before expiry", (page) =>
+      guest(page).getByRole("textbox", { name: "Draft" }).fill("Draft across callback expiry"),
+    );
+    return yield* browser.use("Record the guest document identity", (page) =>
+      guest(page)
+        .locator("body")
+        .evaluate((body) => {
+          const identity = crypto.randomUUID();
+          body.setAttribute("data-document-identity", identity);
+          return identity;
+        }),
+    );
+  });
+
+export const exerciseRenewalDraft = (
+  browser: Browser["Service"],
+  documentIdentity: string,
+  elapsed: number,
+) =>
+  Effect.gen(function* () {
+    yield* browser.use("Advance elapsed client time while preserving its clock skew", (page) =>
+      page.clock.fastForward(elapsed),
+    );
+    const saved = yield* browser
+      .use("Renew authority before a callback", (page) =>
+        Promise.all([
+          page
+            .waitForResponse(
+              (response) =>
+                response.url().endsWith("/call") &&
+                response.request().postDataJSON()?.name === "app-callback",
+            )
+            .then((response) => response.json()),
+          guest(page).getByRole("button", { name: "Save", exact: true }).click(),
+        ]).then(([result]) => result),
+      )
+      .pipe(
+        Effect.flatMap(
+          Schema.decodeUnknownEffect(
+            Schema.Struct({ isError: Schema.optionalKey(Schema.Boolean) }),
+          ),
+        ),
+      );
+    expect(saved.isError, "The expired save must use renewed authority").not.toBe(true);
+    yield* browser.use("Read the approved callback after renewal", (page) =>
+      guest(page)
+        .getByRole("status")
+        .filter({ hasText: /^Draft across callback expiry$/ })
+        .waitFor(),
+    );
+    yield* browser.use("Read a resource with renewed authority", (page) =>
+      guest(page).getByRole("button", { name: "Read note", exact: true }).click(),
+    );
+    yield* browser.use("Receive the original source resource after renewal", (page) =>
+      guest(page)
+        .getByRole("status")
+        .filter({ hasText: /^Alpha source note$/ })
+        .waitFor(),
+    );
+    expect(
+      yield* browser.use("The unsaved draft survives authority replacement", (page) =>
+        guest(page).getByRole("textbox", { name: "Draft" }).inputValue(),
+      ),
+    ).toBe("Draft across callback expiry");
+    expect(
+      yield* browser.use("Authority replacement keeps the same guest document", (page) =>
+        guest(page).locator("body").getAttribute("data-document-identity"),
+      ),
+    ).toBe(documentIdentity);
+    yield* browser.checkpoint("App draft and document survive callback authority renewal");
+  });
+
+export const renewDuringApproval = (browser: Browser["Service"], elapsed: number) =>
+  Effect.gen(function* () {
+    yield* browser.use("Keep the guest open while its approval crosses capability expiry", (page) =>
+      page.clock.fastForward(elapsed),
+    );
+    yield* browser.use("Renew through a concurrent resource read during approval", (page) =>
+      guest(page).getByRole("button", { name: "Read note", exact: true }).click(),
+    );
+    yield* browser.use("The held approval permits a resource read with renewed authority", (page) =>
+      guest(page)
+        .getByRole("status")
+        .filter({ hasText: /^Alpha source note$/ })
+        .waitFor(),
+    );
+  });
