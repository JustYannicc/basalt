new file mode 100644
--- /dev/null
+++ b/packages/mcp/src/ui/app-authority.ts
@@ -0,0 +1,112 @@
+import { appViewLimits } from "@executor-js/sdk/core";
+import type { App } from "@modelcontextprotocol/ext-apps";
+import { Schema } from "effect";
+import { McpAppResources } from "apps/contracts";
+import {
+  appViewResourceBase,
+  encodeAppResource,
+  type AppBridgePayload,
+} from "../contracts/app-bridge.ts";
+
+const Authority = Schema.Struct({ capability: Schema.String });
+const ResourceError = Schema.Struct({
+  data: Schema.Struct({ "executor/app-state": Schema.String }),
+});
+
+/** Authority stays in the outer frame. Renewal never reloads the guest or repeats a tool action. */
+export const appAuthority = (
+  app: App,
+  payload: AppBridgePayload,
+  lifetime: AbortSignal,
+  checkAuthority: (result: { readonly _meta?: Record<string, unknown> | undefined }) => void,
+) => {
+  let capability = payload.capability;
+  let receivedAt = performance.now();
+  let renewal: Promise<void> | undefined;
+  const current = async (signal: AbortSignal) => {
+    signal.throwIfAborted();
+    if (
+      Number(capability.split(".")[0]) - Date.now() <= 30000 ||
+      performance.now() - receivedAt >= appViewLimits.capabilityTtlMs - 30000
+    ) {
+      renewal ??= app
+        .callServerTool(
+          {
+            name: "app-renew",
+            arguments: { view: payload.view, capability },
+          },
+          { signal: lifetime, timeout: 30000 },
