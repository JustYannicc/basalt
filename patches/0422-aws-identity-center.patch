@@ -0,0 +1,130 @@
+/** Hosted app -> official MCP client -> independently verified synthetic AWS SigV4 endpoint. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, FileSystem, Path, Schema } from "effect";
+import { Api, body } from "../support/api.ts";
+import { Actors } from "../support/actors.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { App } from "../support/contracts.ts";
+import { appsVersion, mcpSdkVersion } from "../support/apps-release.ts";
+import { awsSignedMcp, syntheticAws } from "../support/aws-signed-mcp.ts";
+import { awsIdentityJourney } from "../support/aws-identity-journey.ts";
+import { awsReconnectJourney } from "../support/aws-reconnect-journey.ts";
+import { awsFormJourney } from "../support/aws-form-journey.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })("AWS Identity Center", (it) => {
+  it.effect(scenarios.awsIdentityCenterSigV4.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          fixture = yield* awsSignedMcp;
+        const fs = yield* FileSystem.FileSystem,
+          path = yield* Path.Path;
+        const source = yield* Schema.decodeUnknownEffect(
+          Schema.fromJsonString(
+            Schema.Struct({
+              files: Schema.Array(Schema.Struct({ path: Schema.String, content: Schema.String })),
+            }),
+          ),
+        )(
+          yield* fs.readFileString(
+            yield* path.fromFileUrl(
+              new URL("../../../src/catalog/aws/source.json", import.meta.url),
+            ),
+          ),
+        );
+        const signerSource = source.files.find(
+          (file) => file.path === "vendor/aws4fetch.js",
+        )?.content;
+        if (signerSource === undefined) throw new Error("The catalog AWS signer is missing");
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const Reference = Schema.Struct({
+          entry: Schema.optional(
+            Schema.Struct({ symbol: Schema.String, definition: Schema.optional(Schema.String) }),
+          ),
+          types: Schema.Array(Schema.Struct({ symbol: Schema.String })),
+        });
+        const [providerReference, providerMethod] = yield* Effect.all(
+          ["Provider", "Provider.many"].map((symbol) =>
+            api
+              .request(
+                actors.owner,
+                "GET",
+                `${prefix}/framework/describe?${new URLSearchParams({ symbol })}`,
+              )
+              .pipe(Effect.flatMap((response) => body(Reference, response))),
+          ),
+          { concurrency: 2 },
+        );
+        expect(providerReference?.entry?.symbol).toBe("apps.Provider");
+        expect(providerReference?.entry?.definition).toContain("export class Provider");
+        expect(providerMethod?.types.map((type) => type.symbol)).toContain("apps.Provider");
+        const files = [
+          {
+            path: "package.json",
+            content: JSON.stringify({
+              dependencies: { apps: appsVersion, "@modelcontextprotocol/sdk": mcpSdkVersion },
+            }),
+          },
+          {
+            path: "vendor/aws4fetch.js",
+            content: signerSource,
+          },
+          {
+            path: "index.ts",
+            content: `import { defineApp, router } from "apps";
+import { mcpRouter } from "apps/mcp";
+import { AwsClient } from "./vendor/aws4fetch.js";
+export default defineApp({}, async ({ signal, fetch }) => {
+  const signer = new AwsClient({ ...${JSON.stringify({ ...syntheticAws, service: "aws-mcp", region: "us-east-1" })}, fetch });
+  const options = { url: ${JSON.stringify(fixture.url)}, signal,
+    signRequest: async (request: Request) => signer.sign(request) };
+  return { tools: router({ aws: await mcpRouter(options) }) };
+});`,
+          },
+        ];
+        const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: "AWS signed transport",
+          files,
+        });
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const app = yield* body(App, deployed);
+        yield* Effect.addFinalizer(() =>
+          api
+            .request(actors.owner, "DELETE", `${prefix}/apps/${app.id}`)
+            .pipe(Effect.asVoid, Effect.orDie),
+        );
+        const called = yield* api.request(
+          actors.owner,
+          "POST",
+          `${prefix}/apps/${app.id}/tools/call`,
+          { tool: "aws.get_tasks", kind: "query", input: {} },
+        );
+        expect(called.status, JSON.stringify(called.body)).toBe(200);
+        expect(called.body).toMatchObject({
+          structuredContent: { account: "staging", signed: true },
+        });
+        expect(fixture.accepted.some((event) => event.rpc === "initialize")).toBe(true);
+        expect(fixture.accepted.some((event) => event.rpc === "tools/list")).toBe(true);
+        expect(fixture.accepted.filter((event) => event.rpc === "tools/call")).toHaveLength(1);
+        expect(fixture.refusals()).toBe(0);
+      }),
+    ),
+  );
+  it.effect(scenarios.awsIdentityCenterFormDesktop.title, (context) =>
+    withHostedCase(context, awsFormJourney(1280)),
+  );
+  it.effect(scenarios.awsIdentityCenterFormPhone.title, (context) =>
+    withHostedCase(context, awsFormJourney(390)),
+  );
+
+  it.effect(scenarios.awsIdentityCenterReconnect.title, (context) =>
+    withHostedCase(context, awsReconnectJourney),
+  );
+
+  it.effect(scenarios.awsIdentityCenterSession.title, (context) =>
+    withHostedCase(context, awsIdentityJourney(1280)),
+  );
+});
