+/** Synthetic AWS Identity Center, STS-shaped credential, and SigV4 MCP endpoints. */
+import { createServer } from "node:http";
+import { createHash, createHmac, timingSafeEqual } from "node:crypto";
+import { Effect, Layer } from "effect";
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+
+type SyntheticAccount = {
+  readonly id: string;
+  readonly name: string;
+  readonly roles: readonly string[];
+};
+type SyntheticCredential = {
+  readonly accessKeyId: string;
+  readonly secretAccessKey: string;
+  readonly sessionToken: string;
+  readonly expiration: number;
+  readonly accountId: string;
+  readonly roleName: string;
+};
+type VerifiedCall = {
+  readonly accountId: string;
+  readonly roleName: string;
+  readonly accessKeyId: string;
+  readonly method: string;
+  readonly tool?: string;
+  readonly arguments?: unknown;
+  readonly bodyHash: string;
+};
+
+type FixtureOptions = {
+  /** Number of explicit CreateToken polls that return authorization_pending before approval. */
+  readonly pendingPolls?: number;
+  readonly initialAccessTokenSeconds?: number;
+  readonly accountPageSize?: number;
+  readonly rolePageSize?: number;
+};
+
+const defaultAccounts: readonly SyntheticAccount[] = Array.from({ length: 8 }, (_, index) => {
+  const number = index + 1;
+  return {
+    id: `00000000000${number}`,
+    name: [
+      `Development`,
+      `Staging`,
+      `Production`,
+      `Analytics`,
+      `Security`,
+      `Shared`,
+      `Sandbox`,
+      `Archive`,
+    ][index]!,
+    roles: [`AppReadOnly${number}`, `AppOperator${number}`],
+  };
+});
+const allRoles = defaultAccounts.flatMap((account) =>
+  account.roles.map((roleName) => ({ accountId: account.id, roleName })),
+);
+const roleKey = (accountId: string, roleName: string) => `${accountId}:${roleName}`;
+const hash = (value: string) => createHash("sha256").update(value).digest("hex");
+const hmac = (key: string | Buffer, value: string) =>
+  createHmac("sha256", key).update(value).digest();
+const json = (value: unknown, status = 200) => HttpServerResponse.json(value, { status });
+const error = (errorCode: string, status = 400) => json({ error: errorCode }, status);
+const slicePage = <A>(values: readonly A[], token: string | undefined, size: number) => {
+  const offset = token === undefined ? 0 : Number(token);
+  const items = values.slice(offset, offset + size);
+  const next = offset + items.length < values.length ? String(offset + items.length) : undefined;
+  return { items, ...(next === undefined ? {} : { nextToken: next }) };
+};
+const bodyJson = (text: string): Record<string, unknown> => {
+  const value: unknown = text.length === 0 ? {} : JSON.parse(text);
+  if (typeof value !== "object" || value === null || Array.isArray(value))
+    throw new TypeError("Expected a JSON object");
+  return value as Record<string, unknown>;
+};
+const queryPage = (url: string, size: number) => {
+  const parameters = new URL(url, "http://synthetic.invalid").searchParams;
+  const requestedSize = Number(parameters.get("max_result") ?? size);
+  const nextToken = parameters.get("next_token") ?? undefined;
+  return {
+    size:
+      Number.isSafeInteger(requestedSize) && requestedSize > 0
+        ? Math.min(requestedSize, size, 100)
+        : size,
+    nextToken,
+  };
+};
+
+/**
+ * Create an in-memory AWS wire fixture. All IDs, tokens, role credentials, accounts, and responses
+ * are synthetic. The fixture records identities and tool arguments, never credential values.
+ *
+ * Example in an Effect E2E case:
+ *   const fixture = yield* awsIdentityFixture({ pendingPolls: 1 });
+ *   fixture.approve();
+ *   // Deploy an app against fixture.oidcUrl, fixture.portalUrl and fixture.mcpUrl.
+ *   expect(fixture.calls()).toContainEqual(expect.objectContaining({ accountId, roleName }));
+ */
+export const awsIdentityFixture = (options: FixtureOptions = {}) =>
+  Effect.gen(function* () {
+    let accounts = defaultAccounts;
+    const assignedRoles = [...allRoles];
+    const accountPageSize = options.accountPageSize ?? 3;
+    const rolePageSize = options.rolePageSize ?? 1;
+    const requiredPendingPolls = options.pendingPolls ?? 1;
+    const clientId = "synthetic-client-id";
+    const clientSecret = "synthetic-client-secret";
+    const deviceCode = "synthetic-device-code";
+    const userCode = "SYNTH-1234";
+    const accessToken = "synthetic-identity-center-access-token";
+    const refreshToken = "synthetic-identity-center-refresh-token";
+    const credentials = new Map<string, SyntheticCredential>();
+    for (const { accountId, roleName } of allRoles) {
+      const digest = createHash("sha256")
+        .update(roleKey(accountId, roleName))
+        .digest("hex")
+        .slice(0, 12)
+        .toUpperCase();
+      credentials.set(roleKey(accountId, roleName), {
+        accessKeyId: `synthetic-access-key-id-${digest}`,
+        secretAccessKey: `synthetic-secret-${digest}`,
+        sessionToken: `synthetic-session-${digest}`,
+        expiration: Date.now() + 3_600_000,
+        accountId,
+        roleName,
+      });
+    }
+    let approved = false;
+    let denied = false;
+    let expired = false;
+    let unavailable = false;
+    let wrongRegion = false;
+    let pendingPollCount = 0;
+    let refreshCount = 0;
+    let listAccountsCount = 0;
+    let listRolesCount = 0;
+    let getCredentialsCount = 0;
+    let mcpRefusals = 0;
+    const tokenGrants: string[] = [];
+    const verifiedCalls: VerifiedCall[] = [];
+    const writes: VerifiedCall[] = [];
+    const requestCounts = new Map<string, number>();
+    const count = (key: string) => requestCounts.set(key, (requestCounts.get(key) ?? 0) + 1);
+
+    const hasJsonContentType = (request: HttpServerRequest.HttpServerRequest) =>
+      request.headers["content-type"]?.toLowerCase().startsWith("application/json") === true;
+    const routes = Layer.mergeAll(
+      HttpRouter.add(
+        "POST",
+        "/client/register",
+        Effect.gen(function* () {
+          const request = yield* HttpServerRequest.HttpServerRequest;
+          count("RegisterClient");
+          if (!hasJsonContentType(request)) return yield* error("InvalidRequest");
+          const value = bodyJson(yield* request.text);
+          if (
+            typeof value.clientName !== "string" ||
+            value.clientName.trim().length === 0 ||
+            value.clientType !== "public" ||
+            !Array.isArray(value.scopes) ||
+            !value.scopes.includes("sso:account:access")
+          )
+            return yield* error("InvalidRequest");
+          return yield* json({
+            clientId,
+            clientSecret,
+            clientIdIssuedAt: 1_800_000_000,
+            clientSecretExpiresAt: 2_000_000_000,
+            authorizationEndpoint: "https://oidc.synthetic.invalid/authorize",
+            tokenEndpoint: "https://oidc.synthetic.invalid/token",
+          });
+        }),
+      ),
+      HttpRouter.add(
+        "POST",
+        "/device_authorization",
+        Effect.gen(function* () {
+          const request = yield* HttpServerRequest.HttpServerRequest;
+          count("StartDeviceAuthorization");
+          if (wrongRegion) {
+            wrongRegion = false;
+            return yield* error("InvalidRequestRegionException");
+          }
+          if (!hasJsonContentType(request)) return yield* error("InvalidRequest");
+          const value = bodyJson(yield* request.text);
+          if (
+            value.clientId !== clientId ||
+            value.clientSecret !== clientSecret ||
+            value.startUrl !== "https://company.awsapps.com/start"
+          )
+            return yield* error("InvalidClient");
+          approved = false;
+          denied = false;
+          expired = false;
+          pendingPollCount = 0;
+          return yield* json({
+            deviceCode,
+            userCode,
+            verificationUri: "https://ssoins-0a1b2c3d4e5f6789.us-east-1.portal.amazonaws.com/#/device",
+            verificationUriComplete: `https://ssoins-0a1b2c3d4e5f6789.us-east-1.portal.amazonaws.com/#/device?user_code=${userCode}`,
+            expiresIn: 600,
+            interval: 1,
+          });
+        }),
+      ),
+      HttpRouter.add(
+        "POST",
+        "/token",
+        Effect.gen(function* () {
+          const request = yield* HttpServerRequest.HttpServerRequest;
+          count("CreateToken");
+          if (!hasJsonContentType(request)) return yield* error("InvalidRequest");
+          const value = bodyJson(yield* request.text);
+          if (value.clientId !== clientId || value.clientSecret !== clientSecret)
+            return yield* error("InvalidClient");
+          if (value.grantType === "refresh_token") {
+            if (expired || value.refreshToken !== refreshToken)
+              return yield* error("invalid_grant");
+            refreshCount++;
+            tokenGrants.push("refresh_token");
+            return yield* json({ accessToken, tokenType: "Bearer", expiresIn: 3600, refreshToken });
+          }
+          if (
+            value.grantType !== "urn:ietf:params:oauth:grant-type:device_code" ||
+            value.deviceCode !== deviceCode
+          )
+            return yield* error("invalid_grant");
+          if (expired) return yield* error("expired_token");
+          if (denied) return yield* error("access_denied");
+          if (!approved) {
+            if (pendingPollCount++ < requiredPendingPolls)
+              return yield* error("authorization_pending");
+            return yield* error("slow_down");
+          }
+          tokenGrants.push("device_code");
+          return yield* json({
+            accessToken,
+            tokenType: "Bearer",
+            expiresIn: options.initialAccessTokenSeconds ?? 3600,
+            refreshToken,
+          });
+        }),
+      ),
+      HttpRouter.add(
+        "GET",
+        "/assignment/accounts",
+        Effect.gen(function* () {
+          const request = yield* HttpServerRequest.HttpServerRequest;
+          count("ListAccounts");
+          listAccountsCount++;
+          if (unavailable) return yield* error("ServiceUnavailable", 503);
+          if (expired || request.headers["x-amz-sso_bearer_token"] !== accessToken)
+            return yield* error("UnauthorizedException", 401);
+          const pageInput = queryPage(request.url, accountPageSize);
+          const page = slicePage(accounts, pageInput.nextToken, pageInput.size);
+          return yield* json({
+            accountList: page.items.map(({ id, name }) => ({ accountId: id, accountName: name })),
+            ...(page.nextToken === undefined ? {} : { nextToken: page.nextToken }),
+          });
+        }),
+      ),
+      HttpRouter.add(
+        "GET",
+        "/assignment/roles",
+        Effect.gen(function* () {
+          const request = yield* HttpServerRequest.HttpServerRequest;
+          count("ListAccountRoles");
+          listRolesCount++;
+          if (unavailable) return yield* error("ServiceUnavailable", 503);
+          if (expired || request.headers["x-amz-sso_bearer_token"] !== accessToken)
+            return yield* error("UnauthorizedException", 401);
+          const parameters = new URL(request.url, "http://synthetic.invalid").searchParams;
+          const accountId = parameters.get("account_id");
+          if (accountId === null || !accounts.some(({ id }) => id === accountId))
+            return yield* error("ResourceNotFoundException", 404);
+          const pageInput = queryPage(request.url, rolePageSize);
+          const assigned = assignedRoles.filter((role) => role.accountId === accountId);
+          const page = slicePage(assigned, pageInput.nextToken, pageInput.size);
+          return yield* json({
+            roleList: page.items,
+            ...(page.nextToken === undefined ? {} : { nextToken: page.nextToken }),
+          });
+        }),
+      ),
+      HttpRouter.add(
+        "GET",
+        "/federation/credentials",
+        Effect.gen(function* () {
+          const request = yield* HttpServerRequest.HttpServerRequest;
+          count("GetRoleCredentials");
+          getCredentialsCount++;
+          if (unavailable) return yield* error("ServiceUnavailable", 503);
+          if (expired || request.headers["x-amz-sso_bearer_token"] !== accessToken)
+            return yield* error("UnauthorizedException", 401);
+          const parameters = new URL(request.url, "http://synthetic.invalid").searchParams;
+          const accountId = parameters.get("account_id");
+          const roleName = parameters.get("role_name");
+          if (
+            accountId === null ||
+            roleName === null ||
+            !assignedRoles.some(
+              (role) => role.accountId === accountId && role.roleName === roleName,
+            )
+          )
+            return yield* error("UnauthorizedException", 403);
+          const found = credentials.get(roleKey(accountId, roleName));
+          if (found === undefined) return yield* error("UnauthorizedException", 403);
+          return yield* json({
+            roleCredentials: {
+              accessKeyId: found.accessKeyId,
+              secretAccessKey: found.secretAccessKey,
+              sessionToken: found.sessionToken,
+              expiration: found.expiration,
+            },
+          });
+        }),
+      ),
+      HttpRouter.add(
+        "POST",
+        "/mcp",
+        Effect.gen(function* () {
+          const request = yield* HttpServerRequest.HttpServerRequest;
+          const body = yield* request.text;
+          count("McpRequest");
+          const auth =
+            /^AWS4-HMAC-SHA256 Credential=([^/]+)\/(\d{8})\/([^/]+)\/([^/]+)\/aws4_request, SignedHeaders=([^,]+), Signature=([a-f0-9]{64})$/.exec(
+              request.headers.authorization ?? "",
+            );
+          if (!auth || auth[3] !== "us-east-1" || auth[4] !== "aws-mcp") {
+            mcpRefusals++;
+            return yield* error("SignatureDoesNotMatch", 403);
+          }
+          const credential = [...credentials.values()].find(
+            ({ accessKeyId }) => accessKeyId === auth[1],
+          );
+          const signed = auth[5]!.split(";");
+          if (
+            credential === undefined ||
+            !["host", "x-amz-date", "x-amz-security-token"].every((name) =>
+              signed.includes(name),
+            ) ||
+            request.headers["x-amz-security-token"] !== credential.sessionToken
+          ) {
+            mcpRefusals++;
+            return yield* error("InvalidClientTokenId", 403);
+          }
+          const url = new URL(request.url ?? "/", "http://synthetic.invalid");
+          const canonicalHeaders = signed
+            .map(
+              (name) =>
+                `${name}:${String(request.headers[name] ?? "")
+                  .trim()
+                  .replace(/\s+/g, " ")}`,
+            )
+            .join("\n");
+          const canonical = [
+            request.method,
+            url.pathname,
+            url.searchParams.toString(),
+            `${canonicalHeaders}\n`,
+            auth[5],
+            hash(body),
+          ].join("\n");
+          const scope = `${auth[2]}/${auth[3]}/${auth[4]}/aws4_request`;
+          const toSign = [
+            "AWS4-HMAC-SHA256",
+            request.headers["x-amz-date"],
+            scope,
+            hash(canonical),
+          ].join("\n");
+          const signingKey = hmac(
+            hmac(hmac(hmac(`AWS4${credential.secretAccessKey}`, auth[2]!), auth[3]!), auth[4]!),
+            "aws4_request",
+          );
+          const expected = hmac(signingKey, toSign);
+          if (!timingSafeEqual(expected, Buffer.from(auth[6]!, "hex"))) {
+            mcpRefusals++;
+            return yield* error("SignatureDoesNotMatch", 403);
+          }
+          const rpc = bodyJson(body);
+          const call =
+            rpc.method === "tools/call" && typeof rpc.params === "object" && rpc.params !== null
+              ? (rpc.params as Record<string, unknown>)
+              : undefined;
+          const identity: VerifiedCall = {
+            accountId: credential.accountId,
+            roleName: credential.roleName,
+            accessKeyId: credential.accessKeyId,
+            method: String(rpc.method ?? ""),
+            ...(call === undefined
+              ? {}
+              : { tool: String(call.name ?? ""), arguments: call.arguments }),
+            bodyHash: hash(body),
+          };
+          verifiedCalls.push(identity);
+          if (request.method !== "POST") return yield* error("MethodNotAllowed", 405);
+          const rpcMethod = rpc.method;
+          if (rpc.id === undefined) return HttpServerResponse.empty({ status: 202 });
+          if (rpcMethod === "initialize")
+            return yield* json({
+              jsonrpc: "2.0",
+              id: rpc.id,
+              result: {
+                protocolVersion: (rpc.params as Record<string, unknown>)?.protocolVersion,
+                serverInfo: { name: "Synthetic AWS MCP", version: "1" },
+                capabilities: { tools: {} },
+              },
+            });
+          if (rpcMethod === "tools/list")
+            return yield* json({
+              jsonrpc: "2.0",
+              id: rpc.id,
+              result: {
+                tools: [
+                  {
+                    name: "get_tasks",
+                    description: "Read synthetic AWS account state",
+                    inputSchema: {
+                      type: "object",
+                      properties: { accountId: { type: "string" }, roleName: { type: "string" } },
+                      additionalProperties: false,
+                    },
+                    annotations: { readOnlyHint: true },
+                  },
+                  {
+                    name: "run_script",
+                    description: "Run an AWS script",
+                    inputSchema: {
+                      type: "object",
+                      properties: {
+                        accountId: { type: "string" },
+                        roleName: { type: "string" },
+                        script: { type: "string" },
+                        changes: { type: "array", items: { type: "string" } },
+                      },
+                      required: ["script"],
+                      additionalProperties: false,
+                    },
+                    annotations: { readOnlyHint: false },
+                  },
+                ],
+              },
+            });
+          if (rpcMethod === "tools/call") {
+            const input = (call?.arguments ?? {}) as Record<string, unknown>;
+            const requestedAccount = input.accountId;
+            const requestedRole = input.roleName;
+            if (requestedAccount !== undefined && requestedAccount !== credential.accountId)
+              return yield* error("AccessDeniedException", 403);
+            if (requestedRole !== undefined && requestedRole !== credential.roleName)
+              return yield* error("AccessDeniedException", 403);
+            const tool = String(call?.name ?? "");
+            if (tool === "run_script") {
+              const write: VerifiedCall = { ...identity, tool, arguments: input };
+              writes.push(write);
+              return yield* json({
+                jsonrpc: "2.0",
+                id: rpc.id,
+                result: {
+                  content: [{ type: "text", text: "Synthetic AWS write accepted by fixture" }],
+                  structuredContent: {
+                    accepted: true,
+                    accountId: credential.accountId,
+                    roleName: credential.roleName,
+                  },
+                },
+              });
+            }
+            if (tool === "get_tasks")
+              return yield* json({
+                jsonrpc: "2.0",
+                id: rpc.id,
+                result: {
+                  content: [{ type: "text", text: "Synthetic AWS read" }],
+                  structuredContent: {
+                    accountId: credential.accountId,
+                    roleName: credential.roleName,
+                    tasks: [],
+                  },
+                },
+              });
+            return yield* error("MethodNotFound", 404);
+          }
+          return yield* json({ jsonrpc: "2.0", id: rpc.id, result: {} });
+        }),
+      ),
+    );
+
+    const services = yield* Layer.build(
+      HttpRouter.serve(routes, { disableLogger: true, disableListenLog: true }).pipe(
+        Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 })),
+      ),
+    );
+    const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+    if (!("port" in server.address)) return yield* Effect.die("Fixture must listen on TCP");
+    const base = `http://127.0.0.1:${server.address.port}`;
+    const credentialSummary = () =>
+      [...credentials.values()].map(({ accountId, roleName, accessKeyId, expiration }) => ({
+        accountId,
+        roleName,
+        accessKeyId,
+        expiration,
+      }));
+    return {
+      oidcUrl: base,
+      portalUrl: base,
+      mcpUrl: `${base}/mcp`,
+      client: () => ({ clientId, clientSecret }),
+      approve: () => {
+        approved = true;
+        denied = false;
+      },
+      deny: () => {
+        denied = true;
+        approved = false;
+      },
+      expire: () => {
+        expired = true;
+        approved = false;
+      },
+      wrongRegion: () => {
+        wrongRegion = true;
+      },
+      outage: (value = true) => {
+        unavailable = value;
+      },
+      access: (value = true) => {
+        accounts = value ? defaultAccounts : [];
+      },
+      revokeRole: (accountId: string, roleName: string) => {
+        credentials.delete(roleKey(accountId, roleName));
+        const index = assignedRoles.findIndex(
+          (role) => role.accountId === accountId && role.roleName === roleName,
+        );
+        if (index >= 0) assignedRoles.splice(index, 1);
+      },
+      approveCount: () => tokenGrants.filter((grant) => grant === "device_code").length,
+      refreshCount: () => refreshCount,
+      accountPageCount: () => listAccountsCount,
+      rolePageCount: () => listRolesCount,
+      roleCredentialCount: () => getCredentialsCount,
+      requestCount: (name: string) => requestCounts.get(name) ?? 0,
+      refusals: () => mcpRefusals,
+      calls: () => [...verifiedCalls],
+      writes: () => [...writes],
+      credentials: credentialSummary,
+      assignedAccounts: () =>
+        accounts.map(({ id, name }) => ({
+          accountId: id,
+          accountName: name,
+          roles: assignedRoles.filter((role) => role.accountId === id).map((role) => role.roleName),
+        })),
+    };
+  });
