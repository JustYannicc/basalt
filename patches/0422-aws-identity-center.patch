diff --git a/packages/ui/src/implementation/dashboard/interactive-setup-form.tsx b/packages/ui/src/implementation/dashboard/interactive-setup-form.tsx
new file mode 100644
index 0000000..d052a86
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/interactive-setup-form.tsx
@@ -0,0 +1,105 @@
+import { useId, useState } from "react";
+import type { InteractiveForm } from "apps/contracts";
+import { Button } from "../components/button.tsx";
+import { Input } from "../components/input.tsx";
+import {
+  Select,
+  SelectContent,
+  SelectItem,
+  SelectTrigger,
+  SelectValue,
+} from "../components/select.tsx";
+
+/** Setup belongs to the pending sign-in; saved credential values never populate these fields. */
+export function InteractiveSetupForm({
+  form,
+  disabled,
+  submit,
+}: {
+  readonly form: InteractiveForm;
+  readonly disabled: boolean;
+  readonly submit: (fields: Readonly<Record<string, string>>) => void;
+}) {
+  const id = useId();
+  const [values, setValues] = useState<Readonly<Record<string, string>>>(() =>
+    Object.fromEntries(form.fields.map((field) => [field.name, field.defaultValue ?? ""])),
+  );
+  const complete = form.fields.every((field) => (values[field.name] ?? "").trim() !== "");
+  return (
+    <fieldset className="flex min-w-0 flex-col gap-4" disabled={disabled}>
+      {form.fields.map((field) => (
+        <label
+          key={field.name}
+          htmlFor={`${id}-${field.name}`}
+          className="field-label flex min-w-0 flex-col gap-2 text-[13px] font-medium"
+        >
+          {field.label}
+          {field.type === "select" ? (
+            <Select
+              value={values[field.name] ?? ""}
+              disabled={disabled}
+              required
+              onValueChange={(value) => setValues({ ...values, [field.name]: value })}
+            >
+              <SelectTrigger
+                id={`${id}-${field.name}`}
+                aria-label={field.label}
+                aria-describedby={
+                  field.description === undefined ? undefined : `${id}-${field.name}-description`
+                }
+              >
+                <SelectValue placeholder={field.placeholder ?? "Choose a value"} />
+              </SelectTrigger>
+              <SelectContent>
+                {field.options?.map((option) => (
+                  <SelectItem key={option.value} value={option.value}>
+                    {option.label}
+                  </SelectItem>
+                ))}
+              </SelectContent>
+            </Select>
+          ) : (
+            <Input
+              id={`${id}-${field.name}`}
+              aria-label={field.label}
+              aria-describedby={
+                field.description === undefined ? undefined : `${id}-${field.name}-description`
+              }
+              type={field.type}
+              value={values[field.name] ?? ""}
+              placeholder={field.placeholder}
+              required
+              disabled={disabled}
+              autoComplete="off"
+              onChange={(event) => setValues({ ...values, [field.name]: event.target.value })}
+              onKeyDown={(event) => {
+                if (event.key === "Enter" && complete && !disabled) {
+                  event.preventDefault();
+                  if (event.currentTarget.closest("form")?.reportValidity()) submit(values);
+                }
+              }}
+            />
+          )}
+          {field.description !== undefined && (
+            <span
+              id={`${id}-${field.name}-description`}
+              className="text-xs font-normal text-muted-foreground"
+            >
+              {field.description}
+            </span>
+          )}
+        </label>
+      ))}
+      <Button
+        type="button"
+        disabled={!complete || disabled}
+        className="w-full"
+        onClick={(event) => {
+          if (event.currentTarget.closest("form")?.reportValidity()) submit(values);
+        }}
+      >
+        {form.submitLabel}
+      </Button>
+    </fieldset>
+  );
+}
