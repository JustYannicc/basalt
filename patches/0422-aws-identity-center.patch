+import { Actors } from "./actors.ts";
+import { McpClient } from "./mcp-client.ts";
+import type { awsIdentityFixture } from "./aws-identity-fixture.ts";
+const Executed = Schema.Struct({
+  structuredContent: Schema.Struct({
+    execution: Schema.Struct({ ok: Schema.Literal(true), value: Schema.Json }),
+  }),
+});
+type Fixture = Effect.Success<ReturnType<typeof awsIdentityFixture>>;
+export const awsProductionApprovals = (input: {
+  readonly app: { readonly id: string; readonly slug: string };
+  readonly accountId: string;
+  readonly fixture: Fixture;
+  readonly reauthorize: Effect.Effect<void, unknown>;
