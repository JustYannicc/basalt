+      "000000000003",
+      "AppOperator3",
+      "run_script",
+      "synthetic_write()",
+      "Update the synthetic resource flag",
+    ])
+      expect(prompts[0]).toContain(detail);
+    const changed = yield* mcp.connect(key.key, "aws-reauthorized", {
+      organization: actors.organization.id,
+      mode: "native",
+      whileApproving: input.reauthorize,
