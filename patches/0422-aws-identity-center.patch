+  Effect.gen(function* () {
+    const api = yield* Api,
+      actors = yield* Actors,
+      mcp = yield* McpClient;
+    const key = yield* body(
+      Schema.Struct({ id: Schema.String, key: Schema.RedactedFromValue(Schema.String) }),
+      yield* api.request(actors.owner, "POST", "/api/auth/api-key/create", {
+        name: "AWS synthetic approval proof",
+      }),
+    );
+    yield* Effect.addFinalizer(() =>
+      api
+        .request(actors.owner, "POST", "/api/auth/api-key/delete", { keyId: key.id })
+        .pipe(Effect.asVoid, Effect.orDie),
+    );
+    const args = {
+      accountId: input.accountId,
+      input: {
+        account: "Production",
+        role: "AppOperator3",
+        arguments: { script: "synthetic_write()", changes: ["Update the synthetic resource flag"] },
+      },
+    };
+    const code = `return await tools[${JSON.stringify(input.app.slug)}].run_script(${JSON.stringify(args)});`;
+    const execute = (client: Effect.Success<ReturnType<typeof mcp.connect>>, label: string) =>
+      client
+        .use(label, (client, signal) =>
+          client.callTool({ name: "execute", arguments: { code } }, undefined, { signal }),
+        )
+        .pipe(
+          Effect.flatMap(Schema.decodeUnknownEffect(Executed)),
+          Effect.map((result) => result.structuredContent.execution.value),
+        );
+    const before = input.fixture.roleCredentialCount();
+    const denied = yield* mcp.connect(key.key, "aws-denied", {
+      organization: actors.organization.id,
+      mode: "native",
+      answer: "decline",
+    });
+    expect(yield* execute(denied, "Deny the exact production operation")).toMatchObject({
+      ok: true,
+      value: {
+        state: "denied",
+        target: {
+          accountId: "000000000003",
+          roleName: "AppOperator3",
+          production: true,
+          operation: "run_script",
+        },
+      },
+    });
+    expect(input.fixture.roleCredentialCount()).toBe(before);
+    expect(input.fixture.writes()).toHaveLength(0);
+    const prompts = yield* denied.prompts;
+    expect(prompts).toHaveLength(1);
