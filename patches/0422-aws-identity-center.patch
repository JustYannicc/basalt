+++ b/e2e/support/aws-reconnect-journey.ts
@@ -0,0 +1,115 @@
+/** Re-sign-in must update the same saved account and leave it usable on cancellation. */
+import { expect } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Api, body } from "./api.ts";
+import { Actors } from "./actors.ts";
+import { App, Resource } from "./contracts.ts";
+import { appsManifest } from "./apps-release.ts";
+const Connected = Schema.Struct({
+  state: Schema.Literal("connected"),
+  account: Schema.Struct({ id: Schema.String, label: Schema.String }),
+});
+const source = `import { defineApp, defineProvider, interactive, router, query, object } from "apps";
+const options = { label: "Identity Center", reconnect: true as const };
+const aws = defineProvider({ name: "AWS reconnect fixture", auth: { identityCenter: interactive(options), legacy: interactive({label:"Legacy interactive"}) } });
+const requirements = { user: { accounts: { aws: aws.many() } } };
+export default defineApp(requirements, { tools: router({ ping: query({input:object({})}, () => true) }), connect: { aws: {
+ start: async (_ctx, input) => ({session: JSON.stringify({ref: input.ref ?? "synthetic-saved-aws-reference"}), message:"Synthetic re-sign-in"}),
+ status: async (_ctx, input) => ({state:"connected",ref:JSON.parse(input.session).ref,accountInfo:{displayName:"Synthetic AWS work"}}),
+ cancel: async () => {}, remove: async () => {throw new Error("Re-sign-in must not remove the saved session")}
+} } });`;
+export const awsReconnectJourney = Effect.gen(function* () {
+  const api = yield* Api,
+    actors = yield* Actors;
+  const prefix = `/api/organizations/${actors.organization.id}`;
+  const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+    name: "AWS reconnect fixture",
+    files: [appsManifest, { path: "index.ts", content: source }],
+  });
+  expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+  const app = yield* body(App, deployed),
+    appPath = `${prefix}/apps/${app.id}`;
+  yield* Effect.addFinalizer(() =>
+    api.request(actors.owner, "DELETE", appPath).pipe(Effect.asVoid, Effect.orDie),
+  );
+  const first = yield* api.request(
+    actors.owner,
+    "POST",
+    `${appPath}/accounts/user/aws/connections`,
+    {},
+  );
+  const pending = yield* body(Resource, first),
+    path = `${prefix}/connections/${pending.id}/interactive`;
+  expect(
+    (yield* api.request(actors.owner, "POST", `${path}/start`, { method: "identityCenter" }))
+      .status,
+  ).toBe(200);
+  const account = (yield* body(
+    Connected,
+    yield* api.request(actors.owner, "GET", `${path}/status`),
+  )).account;
+  expect(
+    (yield* api.request(actors.owner, "PATCH", `${prefix}/accounts/${account.id}`, {
+      label: "My saved AWS name",
+    })).status,
+  ).toBe(200);
+  const reconnect = yield* api.request(
+    actors.owner,
+    "POST",
+    `${appPath}/accounts/user/aws/connections`,
+    { account: account.id },
+  );
+  expect(reconnect.status, JSON.stringify(reconnect.body)).toBe(200);
+  const attempt = yield* body(Resource, reconnect),
+    again = `${prefix}/connections/${attempt.id}/interactive`;
+  const restarted = yield* api.request(actors.owner, "POST", `${again}/start`, {
+    method: "identityCenter",
+  });
+  expect(restarted.status, JSON.stringify(restarted.body)).toBe(200);
+  expect((yield* api.request(actors.owner, "POST", `${again}/cancel`)).status).toBe(200);
+  expect((yield* api.request(actors.owner, "GET", `${prefix}/accounts/${account.id}`)).status).toBe(
+    200,
+  );
+  expect(
+    (yield* api.request(actors.owner, "POST", `${again}/start`, { method: "identityCenter" }))
+      .status,
+  ).toBe(200);
+  const finished = yield* body(
+    Connected,
+    yield* api.request(actors.owner, "GET", `${again}/status`),
+  );
+  expect(finished.account).toMatchObject({ id: account.id, label: "My saved AWS name" });
+  const links = yield* api.request(actors.owner, "GET", `${appPath}/accounts/user`);
+  expect(JSON.stringify(links.body).split(account.id).length - 1).toBeGreaterThan(0);
+  const legacyPending = yield* api.request(
+    actors.owner,
+    "POST",
+    `${appPath}/accounts/user/aws/connections`,
+    {},
+  );
+  const legacyRequest = yield* body(Resource, legacyPending),
+    legacyPath = `${prefix}/connections/${legacyRequest.id}/interactive`;
+  expect(
+    (yield* api.request(actors.owner, "POST", `${legacyPath}/start`, { method: "legacy" })).status,
+  ).toBe(200);
+  const legacy = yield* body(
+    Connected,
+    yield* api.request(actors.owner, "GET", `${legacyPath}/status`),
+  );
+  const unsupported = yield* api.request(
+    actors.owner,
+    "POST",
+    `${appPath}/accounts/user/aws/connections`,
+    { account: legacy.account.id },
+  );
+  expect(unsupported.status, JSON.stringify(unsupported.body)).toBe(422);
+  expect(unsupported.body).toMatchObject({ _tag: "InteractiveReconnectUnsupported" });
+  expect(
+    (yield* api.request(actors.owner, "GET", `${prefix}/accounts/${legacy.account.id}`)).status,
+  ).toBe(200);
+  expect(
+    (yield* api.request(actors.member, "POST", `${appPath}/accounts/user/aws/connections`, {
+      account: account.id,
+    })).status,
+  ).toBe(403);
+});
diff --git a/e2e/support/aws-signed-mcp.ts b/e2e/support/aws-signed-mcp.ts
new file mode 100644
index 0000000..788ea2e
--- /dev/null
+++ b/e2e/support/aws-signed-mcp.ts
@@ -0,0 +1,135 @@
+/** Synthetic AWS wire endpoint. Node's HMAC verifies the Web Crypto signer's outgoing request. */
+import { createServer } from "node:http";
+import { createHash, createHmac, timingSafeEqual } from "node:crypto";
+import { Effect, Layer } from "effect";
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+
+export const syntheticAws = {
+  accessKeyId: "synthetic-access-key-id",
+  secretAccessKey: "synthetic-secret-access-key",
+  sessionToken: "synthetic-session-token",
+};
+const hash = (value: string) => createHash("sha256").update(value).digest("hex");
+const hmac = (key: string | Buffer, value: string) =>
+  createHmac("sha256", key).update(value).digest();
+
+export const awsSignedMcp = Effect.gen(function* () {
+  const accepted: { method: string; rpc?: string; account: string; bodyHash: string }[] = [];
+  let refused = 0;
+  const routes = HttpRouter.add(
+    "*",
+    "/mcp",
+    Effect.gen(function* () {
+      const request = yield* HttpServerRequest.HttpServerRequest;
+      const body = yield* request.text;
+      const auth =
+        /^AWS4-HMAC-SHA256 Credential=([^/]+)\/(\d{8})\/([^/]+)\/([^/]+)\/aws4_request, SignedHeaders=([^,]+), Signature=([a-f0-9]{64})$/.exec(
+          request.headers.authorization ?? "",
+        );
+      const send = (status: number, value: unknown) => HttpServerResponse.json(value, { status });
+      if (
+        !auth ||
+        auth[1] !== syntheticAws.accessKeyId ||
+        auth[3] !== "us-east-1" ||
+        auth[4] !== "aws-mcp" ||
+        request.headers["x-amz-security-token"] !== syntheticAws.sessionToken
+      ) {
+        refused++;
+        return yield* send(403, { message: "AWS signature is required" });
+      }
+      const signed = auth[5]!.split(";");
+      if (!["host", "x-amz-date", "x-amz-security-token"].every((name) => signed.includes(name))) {
+        refused++;
+        return yield* send(403, { message: "AWS identity must be signed" });
+      }
+      const url = new URL(request.url ?? "/", "http://fixture.invalid");
+      const canonicalHeaders = signed
+        .map(
+          (name) =>
+            `${name}:${String(request.headers[name] ?? "")
+              .trim()
+              .replace(/\s+/g, " ")}`,
+        )
+        .join("\n");
+      const canonical = [
+        request.method,
+        url.pathname,
+        url.searchParams.toString(),
+        `${canonicalHeaders}\n`,
+        auth[5],
+        hash(body),
+      ].join("\n");
+      const scope = `${auth[2]}/${auth[3]}/${auth[4]}/aws4_request`;
+      const toSign = [
+        "AWS4-HMAC-SHA256",
+        request.headers["x-amz-date"],
+        scope,
+        hash(canonical),
+      ].join("\n");
+      const key = hmac(
+        hmac(hmac(hmac(`AWS4${syntheticAws.secretAccessKey}`, auth[2]!), auth[3]!), auth[4]!),
+        "aws4_request",
+      );
+      const expected = hmac(key, toSign);
+      if (!timingSafeEqual(expected, Buffer.from(auth[6]!, "hex"))) {
+        refused++;
+        return yield* send(403, { message: "AWS signature does not match the request" });
+      }
+      const rpc = body ? JSON.parse(body) : undefined;
+      accepted.push({
+        method: request.method ?? "",
+        rpc: rpc?.method,
+        account: "staging",
+        bodyHash: hash(body),
+      });
+      if (request.method !== "POST") return yield* send(405, {});
+      if (rpc?.id === undefined) {
+        return HttpServerResponse.empty({ status: 202 });
+      }
+      if (rpc.method === "initialize")
+        return yield* send(200, {
+          jsonrpc: "2.0",
+          id: rpc.id,
+          result: {
+            protocolVersion: rpc.params.protocolVersion,
+            serverInfo: { name: "Synthetic AWS MCP", version: "1" },
+            capabilities: { tools: {} },
+          },
+        });
+      if (rpc.method === "tools/list")
+        return yield* send(200, {
+          jsonrpc: "2.0",
+          id: rpc.id,
+          result: {
+            tools: [
+              {
+                name: "get_tasks",
+                description: "Synthetic read",
+                inputSchema: { type: "object", properties: {}, additionalProperties: false },
+                annotations: { readOnlyHint: true },
+              },
+            ],
+          },
+        });
+      if (rpc.method === "tools/call")
+        return yield* send(200, {
+          jsonrpc: "2.0",
+          id: rpc.id,
+          result: {
+            content: [{ type: "text", text: "staging-signed" }],
+            structuredContent: { account: "staging", signed: true },
+          },
+        });
+      return yield* send(200, { jsonrpc: "2.0", id: rpc.id, result: {} });
+    }),
+  );
+  const services = yield* Layer.build(
+    HttpRouter.serve(routes, { disableLogger: true, disableListenLog: true }).pipe(
+      Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 })),
+    ),
+  );
+  const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+  if (!("port" in server.address)) return yield* Effect.die("Fixture must listen on TCP");
+  return { url: `http://127.0.0.1:${server.address.port}/mcp`, accepted, refusals: () => refused };
+});
diff --git a/e2e/tests/aws-identity-center.spec.ts b/e2e/tests/aws-identity-center.spec.ts
