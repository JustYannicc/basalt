+/** Deploy the retained AWS catalog source and exercise only public hosted APIs. */
+import { expect } from "@effect/vitest";
+import { Effect, FileSystem, Path, Schema } from "effect";
+import { openPrivateApp, waitForAppUrl } from "./app-pages.ts";
+import { Api, body } from "./api.ts";
+import { Actors } from "./actors.ts";
+import { Browser } from "./browser.ts";
+import { App, Resource } from "./contracts.ts";
+import { appsVersion } from "./apps-release.ts";
+import { awsProductionApprovals } from "./aws-production-approval.ts";
+import { awsIdentityFixture } from "./aws-identity-fixture.ts";
+const Source = Schema.fromJsonString(
+  Schema.Struct({
+    files: Schema.Array(Schema.Struct({ path: Schema.String, content: Schema.String })),
+  }),
+);
+const Connected = Schema.Struct({
+  state: Schema.Literal("connected"),
+  account: Schema.Struct({ id: Schema.String, label: Schema.String }),
+});
+const Account = Schema.Struct({
+  accountId: Schema.String,
+  accountName: Schema.String,
+  roles: Schema.Array(Schema.String),
+  production: Schema.Boolean,
+});
+const Inventory = Schema.Struct({
+  ok: Schema.Literal(true),
+  value: Schema.Struct({
+    connections: Schema.Array(
+      Schema.Struct({
+        connection: Schema.String,
+        accounts: Schema.Array(Account),
+        defaultTarget: Schema.NullOr(
+          Schema.Struct({ accountId: Schema.String, roleName: Schema.String }),
+        ),
+      }),
+    ),
+  }),
+});
+
+export const awsIdentityJourney = (width = 1280) =>
+  Effect.gen(function* () {
+    const path = yield* Path.Path,
+      fs = yield* FileSystem.FileSystem,
+      api = yield* Api,
+      actors = yield* Actors,
+      browser = yield* Browser,
+      fixture = yield* awsIdentityFixture({ initialAccessTokenSeconds: 0 });
+    const source = yield* Schema.decodeUnknownEffect(Source)(
+      yield* fs.readFileString(
+        yield* path.fromFileUrl(new URL("../../../src/catalog/aws/source.json", import.meta.url)),
+      ),
+    );
+    const files = source.files.map((file) => {
+      if (file.path === "package.json")
+        return {
+          ...file,
+          content: JSON.stringify({
+            ...JSON.parse(file.content),
+            dependencies: { ...JSON.parse(file.content).dependencies, apps: appsVersion },
+          }),
+        };
+      if (file.path === "wire.ts")
+        return {
+          ...file,
+          content: `export const identityEndpoints=()=>(${JSON.stringify({ oidc: fixture.oidcUrl, portal: fixture.portalUrl })});export const managedMcpEndpoint=${JSON.stringify(fixture.mcpUrl)};`,
+        };
+      return file;
+    });
+    const prefix = `/api/organizations/${actors.organization.id}`;
+    const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+      name: "AWS Identity Center acceptance",
+      files,
+    });
+    expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+    const app = yield* body(App, deployed),
+      appPath = `${prefix}/apps/${app.id}`;
+    yield* Effect.addFinalizer(() =>
+      api.request(actors.owner, "DELETE", appPath).pipe(Effect.asVoid, Effect.orDie),
+    );
+    const pending = yield* api.request(
+      actors.owner,
