+/** Read retained identities without returning or evaluating any compiled module. */
+import { StoredWorkerBuild, frameworkIdentity } from "@executor-js/sdk/workerd";
+import { Effect, Schema } from "effect";
+import { ProductionOperationRefused } from "./contracts.ts";
+
+export const retainedFrameworkBounds = {
+  records: 2000,
+  objects: 2000,
+  objectBytes: 8_000_000,
+  totalBytes: 32_000_000,
+} as const;
+
+export const retainedFrameworkRefused = (reason: string) =>
+  Effect.fail(new ProductionOperationRefused({ message: `Retained frameworks: ${reason}` }));
+
+const Id = (prefix: string) =>
+  Schema.String.check(Schema.isPattern(new RegExp(`^${prefix}_[A-Za-z0-9_-]{1,251}$`, "u")));
+const References = Schema.Array(
+  Schema.Struct({ app: Id("app"), deployment: Id("dpl"), build: Id("bld") }),
+);
+const Metadata = Schema.Struct({
+  key: Schema.String,
+  size: Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)),
+  etag: Schema.NonEmptyString.check(Schema.isMaxLength(256)),
+  uploaded: Schema.String,
+});
+export type FrameworkMetadata = typeof Metadata.Type;
+export interface RetainedFrameworkObjects {
+  readonly list: Effect.Effect<readonly FrameworkMetadata[], unknown>;
+  /** The adapter bounds the stream before accumulating it, including a false size header. */
+  readonly read: (key: string, maxBytes: number) => Effect.Effect<Uint8Array | null, unknown>;
+}
+
+const frameworkName = /^frameworks\/([A-Za-z0-9][A-Za-z0-9.+_-]{0,127})-([a-f0-9]{64})\.json$/u;
+type Identity = { readonly version: string; readonly sha256: string; readonly protocol: number };
+type IncompleteReason =
+  | "missing_record"
+  | "unreadable_record"
+  | "malformed_record"
+  | "missing_framework"
+  | "ambiguous_framework"
+  | "missing_framework_modules";
+type Projection =
+  | ({ readonly complete: true } & Identity)
+  | { readonly complete: false; readonly reason: IncompleteReason };
+
+/** Decode failures discard their schema diagnostics, which can contain module text. */
+const project = (body: Uint8Array, split: boolean, frameworks: readonly FrameworkMetadata[]) =>
+  Effect.gen(function* () {
+    const decoded = yield* Effect.try(() =>
+      JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(body)),
+    ).pipe(Effect.flatMap(Schema.decodeUnknownEffect(StoredWorkerBuild)));
+    if (split && decoded.format !== 2)
+      return { complete: false, reason: "malformed_record" } as const;
+    if (!split && decoded.format !== 1)
+      return { complete: false, reason: "malformed_record" } as const;
+    if (decoded.format === 2) {
+      const { version, sha256 } = decoded.framework;
+      const key = `frameworks/${version}-${sha256}.json`;
+      if (!frameworks.some((object) => object.key === key))
+        return { complete: false, reason: "missing_framework" } as const;
+      return { complete: true, version, sha256, protocol: decoded.protocol } as const;
+    }
+    // The same canonical hash and module predicate as the retained-format migration, without
+    // its source reader, compiler, writes, package version inference or module evaluation.
+    const modules: Record<string, string> = {};
+    for (const [name, module] of Object.entries(decoded.modules))
+      if (
+        typeof module === "string" &&
+        name.startsWith("node_modules/apps/") &&
+        name.endsWith(".js")
+      )
+        modules[name] = module;
+    if (Object.keys(modules).length === 0)
+      return { complete: false, reason: "missing_framework_modules" } as const;
+    const { sha256 } = yield* frameworkIdentity({ version: "unlabelled", modules });
+    const matches = frameworks.filter((object) => frameworkName.exec(object.key)?.[2] === sha256);
+    if (matches.length !== 1)
+      return {
+        complete: false,
+        reason: matches.length === 0 ? "missing_framework" : "ambiguous_framework",
+      } as const;
+    return {
+      complete: true,
+      version: frameworkName.exec(matches[0]!.key)![1]!,
+      sha256,
+      protocol: decoded.protocol,
+    } as const;
+  }).pipe(
+    Effect.catch(() => Effect.succeed({ complete: false, reason: "malformed_record" } as const)),
+  );
+
+/** SQL owns the scoped app/version associations; only their build keys may reach R2 bodies. */
+export const retainedFrameworks = (references: unknown, objects: RetainedFrameworkObjects) =>
+  Effect.gen(function* () {
+    const refs = yield* Schema.decodeUnknownEffect(References)(references).pipe(
+      Effect.mapError(
+        () =>
+          new ProductionOperationRefused({ message: "Retained frameworks: malformed references" }),
+      ),
+    );
+    if (refs.length > retainedFrameworkBounds.records)
+      return yield* retainedFrameworkRefused("record count bound");
+    const frameworks = yield* objects.list.pipe(
+      Effect.flatMap(Schema.decodeUnknownEffect(Schema.Array(Metadata))),
+      Effect.mapError((error) =>
+        error instanceof ProductionOperationRefused
+          ? error
+          : new ProductionOperationRefused({ message: "Retained frameworks: unreadable metadata" }),
+      ),
+    );
+    if (frameworks.length > retainedFrameworkBounds.objects)
+      return yield* retainedFrameworkRefused("object count bound");
+    const keys = new Set<string>();
+    for (const object of frameworks) {
+      if (
+        !frameworkName.test(object.key) ||
+        !Number.isSafeInteger(object.size) ||
+        !Number.isFinite(Date.parse(object.uploaded)) ||
+        keys.has(object.key)
+      )
+        return yield* retainedFrameworkRefused("malformed metadata");
+      keys.add(object.key);
+    }
+    const grouped = new Map<string, { apps: Set<string>; deployments: Set<string> }>();
+    const deploymentBuilds = new Map<string, string>();
+    for (const ref of refs) {
+      const prior = deploymentBuilds.get(ref.deployment);
+      if (prior !== undefined && prior !== ref.build)
+        return yield* retainedFrameworkRefused("inconsistent references");
+      deploymentBuilds.set(ref.deployment, ref.build);
+      const group = grouped.get(ref.build) ?? {
+        apps: new Set<string>(),
+        deployments: new Set<string>(),
+      };
+      group.apps.add(ref.app);
+      group.deployments.add(ref.deployment);
+      grouped.set(ref.build, group);
+    }
+    let bytes = 0;
+    const read = (key: string) =>
+      Effect.gen(function* () {
+        const remaining = retainedFrameworkBounds.totalBytes - bytes;
+        const max = Math.min(retainedFrameworkBounds.objectBytes, remaining);
+        if (max <= 0) return yield* retainedFrameworkRefused("total byte bound");
+        const body = yield* objects.read(key, max);
+        if (body !== null) {
+          if (body.byteLength > max) return yield* retainedFrameworkRefused("byte bound");
+          bytes += body.byteLength;
+        }
+        return body;
+      });
+    const builds = yield* Effect.forEach([...grouped], ([build, group]) =>
+      Effect.gen(function* () {
+        const body = yield* read(`${build}/worker.json`);
+        const legacy = body === null ? yield* read(`${build}.json`) : null;
+        const result: Projection =
+          body !== null
+            ? yield* project(body, true, frameworks)
+            : legacy !== null
+              ? yield* project(legacy, false, frameworks)
+              : { complete: false, reason: "missing_record" };
+        return result;
+      }).pipe(
+        Effect.catch((error) =>
+          error instanceof ProductionOperationRefused
+            ? Effect.fail(error)
+            : Effect.succeed({ complete: false, reason: "unreadable_record" } as const),
+        ),
+        Effect.map((result) => ({
+          build,
+          apps: [...group.apps].sort(),
+          deployments: [...group.deployments].sort(),
+          ...result,
+        })),
+      ),
+    );
+    const tuples = new Map<string, Identity & { apps: Set<string>; deployments: Set<string> }>();
+    for (const build of builds) {
+      if (!build.complete) continue;
+      const { version, sha256, protocol } = build;
+      const key = JSON.stringify([version, sha256, protocol]);
+      const tuple = tuples.get(key) ?? {
+        version,
+        sha256,
+        protocol,
+        apps: new Set<string>(),
+        deployments: new Set<string>(),
+      };
+      build.apps.forEach((app) => tuple.apps.add(app));
+      build.deployments.forEach((deployment) => tuple.deployments.add(deployment));
+      tuples.set(key, tuple);
+    }
+    return {
+      complete: builds.every((build) => build.complete),
+      builds,
+      frameworks,
+      rows: [...tuples.values()].map(({ version, sha256, protocol, apps, deployments }) => ({
+        version,
+        sha256,
+        protocol,
+        apps: [...apps].sort(),
+        deployments: deployments.size,
+      })),
+    };
+  }).pipe(
+    Effect.timeout("8 seconds"),
+    Effect.catchTag("TimeoutError", () => retainedFrameworkRefused("time bound")),
+  );
