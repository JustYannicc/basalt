+/** The existing EU AppBuilds binding supplies reads inside the signed Worker invocation. */
+import { RuntimeContext } from "alchemy";
+import * as Cloudflare from "alchemy/Cloudflare";
+import { Effect, Stream } from "effect";
+import { AppBuilds } from "../blobs.ts";
+import {
+  retainedFrameworkBounds,
+  retainedFrameworkRefused,
+  type FrameworkMetadata,
+  type RetainedFrameworkObjects,
+} from "./retained-frameworks.ts";
+
+export interface RetainedFrameworkBucket {
+  readonly list: (options: { prefix: string; limit: number; cursor?: string }) => Effect.Effect<
+    {
+      objects: readonly { key: string; size: number; etag: string; uploaded: Date }[];
+      truncated: boolean;
+      cursor?: string;
+    },
+    unknown,
+    RuntimeContext
+  >;
+  readonly get: (key: string) => Effect.Effect<
+    {
+      size: number;
+      body: Stream.Stream<Uint8Array, unknown>;
+      readonly readable?: ReadableStream<Uint8Array> | undefined;
+    } | null,
+    unknown,
+    RuntimeContext
+  >;
+}
+
+/** No raw client, write method, source path or framework body reaches the inventory resolver. */
+export const retainedFrameworkObjects = (
+  bucket: RetainedFrameworkBucket,
+): RetainedFrameworkObjects => ({
+  list: Effect.gen(function* () {
+    const objects: FrameworkMetadata[] = [];
+    const cursors = new Set<string>();
+    let cursor: string | undefined;
+    for (let pageNumber = 0; pageNumber < 3; pageNumber++) {
+      const page = yield* bucket.list({
+        prefix: "frameworks/",
+        limit: 1000,
+        ...(cursor === undefined ? {} : { cursor }),
+      });
+      for (const object of page.objects) {
+        if (!(object.uploaded instanceof Date) || !Number.isFinite(object.uploaded.getTime()))
+          return yield* retainedFrameworkRefused("malformed metadata");
+        objects.push({
+          key: object.key,
+          size: object.size,
+          etag: object.etag,
+          uploaded: object.uploaded.toISOString(),
+        });
+      }
+      if (
+        objects.length > retainedFrameworkBounds.objects ||
+        (page.truncated && objects.length >= retainedFrameworkBounds.objects)
+      )
+        return yield* retainedFrameworkRefused("object count bound");
+      if (!page.truncated) return objects;
+      if (!page.cursor || cursors.has(page.cursor))
+        return yield* retainedFrameworkRefused("invalid metadata cursor");
+      cursors.add(page.cursor);
+      cursor = page.cursor;
+    }
+    return yield* retainedFrameworkRefused("metadata page bound");
+  }).pipe(Effect.provide(RuntimeContext.phantom)),
+  read: (key, maxBytes) =>
+    Effect.gen(function* () {
+      if (!/^bld_[A-Za-z0-9_-]{1,251}(?:\/worker\.json|\.json)$/u.test(key))
+        return yield* retainedFrameworkRefused("invalid build key");
+      const object = yield* bucket.get(key);
+      if (object === null) return null;
+      return yield* Effect.gen(function* () {
+        if (!Number.isSafeInteger(object.size) || object.size < 0)
+          return yield* retainedFrameworkRefused("malformed record size");
+        if (object.size > maxBytes) return yield* retainedFrameworkRefused("object byte bound");
+        const chunks: Uint8Array[] = [];
+        let length = 0;
+        yield* object.body.pipe(
+          Stream.runForEach((chunk) =>
+            Effect.gen(function* () {
+              length += chunk.byteLength;
+              if (length > maxBytes) return yield* retainedFrameworkRefused("stream byte bound");
+              chunks.push(chunk);
+            }),
+          ),
+        );
+        if (length !== object.size) return yield* retainedFrameworkRefused("record size changed");
+        const body = new Uint8Array(length);
+        let offset = 0;
+        for (const chunk of chunks) {
+          body.set(chunk, offset);
+          offset += chunk.byteLength;
+        }
+        return body;
+      }).pipe(
+        Effect.ensuring(
+          Effect.sync(() => {
+            // Stream finalization cancels an acquired reader. Header refusals also cancel an
+            // unacquired native body, without waiting for a provider's cancellation reply.
+            if (object.readable !== undefined && !object.readable.locked)
+              void object.readable.cancel().catch(() => {});
+          }),
+        ),
+      );
+    }).pipe(Effect.provide(RuntimeContext.phantom)),
+});
+
+export const cloudRetainedFrameworkObjects = Effect.gen(function* () {
+  return retainedFrameworkObjects(yield* Cloudflare.R2.ReadBucket(AppBuilds));
+}).pipe(Effect.provide(Cloudflare.R2.ReadBucketBinding));
