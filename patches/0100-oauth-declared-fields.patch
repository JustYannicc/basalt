diff --git a/packages/sdk/src/implementation/oauth-fields.ts b/packages/sdk/src/implementation/oauth-fields.ts
new file mode 100644
--- /dev/null
+++ b/packages/sdk/src/implementation/oauth-fields.ts
@@ -0,0 +1,68 @@
+/** OAuth response fields exposed to apps; refresh material stays in the trusted grant. */
+import { Effect, JsonSchema, Schema, SchemaAST, SchemaRepresentation } from "effect";
+import { JsonObject, StorageError } from "../contracts/shared.ts";
+
+// JSON Schema export makes structs open. An OAuth response's named fields are the app's
+// credential contract, so incidental token metadata must not become invocation credentials.
+const declaredFields = (ast: SchemaAST.AST): SchemaAST.AST => {
+  switch (ast._tag) {
+    case "Objects":
+      return ast.propertySignatures.length === 0
+        ? ast
+        : new SchemaAST.Objects(
+            ast.propertySignatures,
+            [],
+            ast.annotations,
+            ast.checks,
+            ast.encoding,
+            ast.context,
+            ast.encodingChecks,
+          );
+    case "Union":
+      return new SchemaAST.Union(
+        ast.types.map(declaredFields),
+        ast.options,
+        ast.annotations,
+        ast.checks,
+        ast.encoding,
+        ast.context,
+        ast.encodingChecks,
+      );
+    case "Suspend":
+      return new SchemaAST.Suspend(
+        () => declaredFields(ast.thunk()),
+        ast.annotations,
+        ast.checks,
+        ast.encoding,
+        ast.context,
+      );
+    default:
+      return ast;
+  }
+};
+
+export const projectOAuthFields = (response: JsonObject, fields: unknown) =>
+  Effect.gen(function* () {
+    const input = yield* Schema.decodeUnknownEffect(JsonObject)(fields).pipe(
+      Effect.mapError(() => new StorageError()),
+    );
+    const publicFields = Object.fromEntries(
+      Object.entries(input).filter(
+        ([key]) =>
+          !["refresh_token", "id_token", "client_secret", "client_assertion"].includes(key),
+      ),
+    );
+    const decoder = yield* Effect.try({
+      try: () => {
+        const schema = Schema.toType(
+          SchemaRepresentation.fromJsonSchemaDocument(JsonSchema.fromSchemaDraft2020_12(response)),
+        );
+        return Schema.toType(Schema.make(declaredFields(schema.ast)));
+      },
+      catch: () => new StorageError(),
+    });
+    return yield* Schema.decodeUnknownEffect(decoder)(publicFields).pipe(
+      Effect.flatMap((value) => Schema.decodeUnknownEffect(JsonObject)(value)),
+      Effect.mapError(() => new StorageError()),
+    );
+  });
