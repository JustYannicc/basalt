+/** Named fields and an authored typed rest must survive both exchange and rotation. */
+const mixedTokenResponse = (context: TestContext) =>
+  withHostedCase(
+    context,
+    Effect.gen(function* () {
+      const issuer = yield* oauthSetupIssuer;
+      const { signIn, read } = yield* serviceApp(issuer, { scope: true, mixed: true });
+      for (const renews of [false, true]) {
+        yield* issuer.configure({
+          tokenShape: scoped("openid read", "openid write"),
+          refreshTokens: true,
+          expiresIn: renews ? 10 : 3600,
+        });
+        const signedIn = yield* signIn(
+          renews ? "Mixed response renewal" : "Mixed response exchange",
+        );
+        expect(signedIn.completed.status, JSON.stringify(signedIn.failure)).toBe(200);
+        const presented: string[] = [];
+        for (const call of [1, 2]) {
+          const { response, refreshes } = yield* read(signedIn);
+          expect(response.status, JSON.stringify(response.body)).toBe(200);
+          expect(response.body, `typed dynamic scope on call ${call}`).toMatchObject({
+            scope: renews ? "openid write" : "openid read",
+          });
+          expect(refreshes).toBe(renews ? 1 : 0);
+          const echo = yield* body(ScopeEcho, response);
+          expect(echo.refreshed).toBe(renews);
+          presented.push(echo.authorization ?? "");
+        }
+        if (renews) expect(presented[1]).not.toBe(presented[0]);
+      }
+    }),
+  );
