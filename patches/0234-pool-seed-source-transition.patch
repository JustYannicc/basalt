+  {
+    "path": "sign-in.ts",
+    "content": "import type { Account, SignInStarted, SignInStatus } from \"./contract.ts\";\n\nconst loopback = new Set([\"localhost\", \"127.0.0.1\", \"[::1]\"]);\n\n/** Whether a pasted address is the local page a provider's sign-in ended on. */\nexport function isLoopbackUrl(value: string): boolean {\n  try {\n    const url = new URL(value);\n    return (url.protocol === \"http:\" || url.protocol === \"https:\") && loopback.has(url.hostname);\n  } catch {\n    return false;\n  }\n}\n\n/** The local address a sign-in will end on, read from the sign-in link's own redirect. */\nexport function callbackOrigin(signInUrl: string): string | null {\n  try {\n    const redirect = new URL(signInUrl).searchParams.get(\"redirect_uri\");\n    if (!redirect || !isLoopbackUrl(redirect)) return null;\n    return new URL(redirect).origin;\n  } catch {\n    return null;\n  }\n}\n\n/** The Connect dialog's method for pasting a login file; backend provider ids are lowercase. */\nexport const loginFileMethod = \"loginFile\";\n\n/** What the Connect dialog shows for each sign-in the backend starts. */\nexport const prompt = {\n  signIn(started: SignInStarted) {\n    const origin = callbackOrigin(started.url);\n    return {\n      session: started.session,\n      url: started.url,\n      ...(started.userCode ? { code: started.userCode } : {}),\n      ...(started.flow === \"callback\"\n        ? {\n            paste: {\n              label: `The tab ends on a page that won't load, at a local address${origin ? ` starting with ${origin}` : \"\"}. That's expected. Copy the whole address and paste it here.`,\n              ...(origin ? { placeholder: `${origin}/\u2026` } : {}),\n            },\n          }\n        : {}),\n      expiresAt: Date.parse(started.expiresAt),\n    };\n  },\n  loginFile: {\n    session: loginFileMethod,\n    message: \"Paste a login file the pool backend exported. It connects that subscription without signing in again.\",\n    paste: { label: \"Login file contents\", placeholder: \"{ \u2026 }\" },\n  },\n};\n\n/** The dialog's view of a sign-in, with the pool account it added as the account's reference. */\nexport function signedIn(status: SignInStatus) {\n  if (status.status === \"waiting\") return { state: \"waiting\" as const };\n  if (status.status === \"failed\") return { state: \"failed\" as const, message: status.message };\n  if (status.accountId === null)\n    return {\n      state: \"failed\" as const,\n      message: \"The subscription connected, but the pool couldn't tell which account it was. It shows on the pool's page; remove it there and connect it again.\",\n    };\n  return { state: \"connected\" as const, ref: status.accountId };\n}\n\n/** The identity a connected subscription reports, the way a connected Gmail shows its address. */\nexport function identityOf(\n  account: Pick<Account, \"label\" | \"provider\">,\n  sites: readonly { readonly id: string; readonly site?: string }[],\n) {\n  const label = account.label.trim().slice(0, 255);\n  const site = sites.find((provider) => provider.id === account.provider)?.site;\n  return {\n    ...(label ? { displayName: label } : {}),\n    ...(/^[^\\s@]+@[^\\s@]+$/.test(label) ? { email: label } : {}),\n    // The same logo service the dashboard uses for provider icons.\n    ...(site ? { avatarUrl: `https://integrations.sh/logo/${site}?sz=64` } : {}),\n  };\n}\n\nexport type AccountIdentity = ReturnType<typeof identityOf>;\n\n/** Identity is optional, so its lookup gets a short slice of the connect step and never fails it. */\nexport const identityLookupMs = 3_000;\n\n/**\n * Add the account's identity to a connected sign-in. Any failure of the lookup, including a\n * malformed or late answer, keeps the connected result as it was.\n */\nexport async function withIdentity<S extends { readonly state: string; readonly ref?: string }>(\n  state: S,\n  lookup: () => Promise<{ readonly ok: boolean; readonly value?: { readonly accounts?: readonly Account[] } }>,\n  sites: readonly { readonly id: string; readonly site?: string }[],\n  timeoutMs = identityLookupMs,\n): Promise<S | (S & { accountInfo: AccountIdentity })> {\n  if (state.state !== \"connected\") return state;\n  const late = new Promise<S>((resolve) =>\n    AbortSignal.timeout(timeoutMs).addEventListener(\"abort\", () => resolve(state), { once: true }),\n  );\n  const found = Promise.resolve()\n    .then(lookup)\n    .then((view) => {\n      const account = view.ok ? view.value?.accounts?.find((candidate) => candidate.id === state.ref) : undefined;\n      return account === undefined ? state : { ...state, accountInfo: identityOf(account, sites) };\n    })\n    .catch(() => state);\n  return await Promise.race([found, late]);\n}\n"
+  },
+  {
+    "path": "providers.ts",
+    "content": "export const providers: readonly { readonly id: string; readonly name: string; readonly site?: string }[] = [{\"id\":\"claude\",\"name\":\"Claude\",\"site\":\"claude.ai\"},{\"id\":\"codex\",\"name\":\"ChatGPT\",\"site\":\"chatgpt.com\"},{\"id\":\"antigravity\",\"name\":\"Antigravity\",\"site\":\"antigravity.google\"},{\"id\":\"kimi\",\"name\":\"Kimi\",\"site\":\"kimi.com\"},{\"id\":\"xai\",\"name\":\"Grok\",\"site\":\"x.ai\"},{\"id\":\"devin\",\"name\":\"Devin\",\"site\":\"devin.ai\"},{\"id\":\"meta\",\"name\":\"Meta\",\"site\":\"meta.ai\"}];\n"
+  },
+  {
+    "path": "account-observations.ts",
+    "content": "import type { ConnectContext, QueryContext } from \"apps\";\nimport type { AccountObservationResponse, Account } from \"./contract.ts\";\nimport { control } from \"./control.ts\";\nimport { accountStatus, checkFailure } from \"./account-status.ts\";\nimport { subscriptionFailure } from \"./account-health.ts\";\nimport { providers } from \"./providers.ts\";\nimport type { requirements } from \"./requirements.ts\";\nimport { ProviderError } from \"apps\";\n\ntype Caller = QueryContext<typeof requirements> | ConnectContext<typeof requirements>;\n\n/** Owner reads include allowance. Existing member health checks keep their narrower route. */\nexport async function checkSubscription(ctx: Caller, ref: string) {\n  const path = `/accounts/${encodeURIComponent(ref)}`;\n  const observed = await control<AccountObservationResponse>(ctx, `${path}/observations`);\n  if (observed.ok) {\n    const failure = subscriptionFailure(observed.value.account);\n    if (failure) throw new ProviderError({ reason: failure });\n    return {\n      ...accountStatus(observed.value.account, providers),\n      ...(observed.value.observation === null ? {} : { observation: observed.value.observation }),\n    };\n  }\n  if (observed.error !== \"not_owner\") throw new ProviderError({ reason: checkFailure(observed.error) });\n  const checked = await control<Account>(ctx, `${path}/collect`, { method: \"POST\" });\n  if (!checked.ok) throw new ProviderError({ reason: checkFailure(checked.error) });\n  const failure = subscriptionFailure(checked.value);\n  if (failure) throw new ProviderError({ reason: failure });\n  return accountStatus(checked.value, providers);\n}\n"
+  },
+  {
+    "path": "account-status.ts",
+    "content": "// What the Accounts tab shows under a subscription: its plan, anything stopping the pool from using it,\n// and how much of each usage window is left. Read from the pool's own view, never from the provider.\n// Wording and window order match the pool's own screen.\nimport type { Account, ControlErrorCode, UsageWindow } from \"./contract.ts\";\nimport { identityOf } from \"./sign-in.ts\";\nimport { clamp, orderedWindows } from \"./ui/usage.ts\";\n\ntype Tone = \"neutral\" | \"good\" | \"warning\" | \"bad\";\n\n// The host's check pill already says a healthy account works.\nconst states: Record<Account[\"state\"], { readonly label: string; readonly tone: Tone } | null> = {\n  active: null,\n  disabled: { label: \"Paused\", tone: \"warning\" },\n  unavailable: { label: \"Unavailable\", tone: \"warning\" },\n  error: { label: \"Needs attention\", tone: \"bad\" },\n};\n\nconst text = (value: string, max: number) => value.trim().slice(0, max);\n\n/** The host accepts only a strict ISO instant; anything else is left out rather than failing the check. */\nfunction instant(value: string | null): string | undefined {\n  if (value === null) return undefined;\n  const time = Date.parse(value);\n  if (!Number.isFinite(time)) return undefined;\n  const iso = new Date(time).toISOString();\n  // Years past 9999 print with a sign and six digits, which the host refuses.\n  return /^\\d{4}-/.test(iso) ? iso : undefined;\n}\n\nfunction meter(window: UsageWindow) {\n  const resetsAt = instant(window.resetAt);\n  const remaining = window.remainingRatio;\n  return {\n    label: text(window.label, 64) || \"Usage\",\n    remaining: remaining === null || !Number.isFinite(remaining) ? null : clamp(remaining),\n    ...(resetsAt === undefined ? {} : { resetsAt }),\n  };\n}\n\nfunction resetText(account: Account, now: Date): string | null {\n  const resets = account.bankedResets;\n  if (!resets?.available) return null;\n  const expiry = resets.nextExpiresAt === null ? null : instant(resets.nextExpiresAt);\n  if (!expiry) return `${resets.available} banked reset${resets.available === 1 ? \"\" : \"s\"}`;\n  const days = Math.max(0, Math.ceil((Date.parse(expiry) - now.getTime()) / 86_400_000));\n  return `\u21bb ${resets.available} banked \u00b7 next expires in ${days} day${days === 1 ? \"\" : \"s\"}`;\n}\n\n/** The account check result for one pool account, within the host's display limits. */\nexport function accountStatus(account: Account, sites: readonly { readonly id: string; readonly site?: string }[], now = new Date()) {\n  const plan = account.plan === null ? \"\" : text(account.plan, 64);\n  // Like the pool screen, a note shows only when something is wrong.\n  const message = account.message === null || account.state === \"active\" ? \"\" : text(account.message, 128);\n  const windows = orderedWindows(account.windows).slice(0, 4);\n  const reset = resetText(account, now);\n  const state = states[account.state];\n  const resetMeter = windows.findIndex((window) => window.windowSeconds === 18_000);\n  const badges = [\n    ...(plan ? [{ label: plan, tone: \"neutral\" as const }] : []),\n    ...(state ? [state] : []),\n    ...(account.readingFailed ? [{ label: \"Usage reading failed\", tone: \"warning\" as const }] : []),\n    ...(reset && resetMeter < 0 ? [{ label: text(reset, 96), tone: \"neutral\" as const }] : []),\n  ].slice(0, 8);\n  const meters = windows.map((window, index) => ({\n    ...meter(window),\n    ...(reset && index === resetMeter ? { detail: text(reset, 256) } : {}),\n  }));\n  return {\n    accountInfo: identityOf(account, sites),\n    status: {\n      badges,\n      meters,\n      stats: message ? [{ label: \"Note\", value: message }] : [],\n    },\n  };\n}\n\n/** How a pool refusal reads to the host's account check. */\nexport function checkFailure(error: ControlErrorCode | \"missing\") {\n  switch (error) {\n    case \"not_found\":\n    case \"missing\":\n      return \"rejected\" as const;\n    case \"not_owner\":\n      return \"forbidden\" as const;\n    case \"busy\":\n      return \"rate_limited\" as const;\n    default:\n      return \"unavailable\" as const;\n  }\n}\n"
+  }
