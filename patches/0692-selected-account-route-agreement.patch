+/**
+ * Each account's native read through the app page `sourceQueryProof` opened. A refused query is
+ * kept as its error, so the caller compares every account with the same read through tools/call.
+ */
+export const sourceInspections = (name: string, accounts: readonly string[]) =>
+  Effect.flatMap(Browser, (browser) =>
+    browser.use(
+      `Run three concurrent ${name} native reads through the app page`,
+      (page): Promise<unknown> =>
+        page.evaluate(`globalThis.sourceInspections(${JSON.stringify(accounts)})`),
+    ),
+  );
+
