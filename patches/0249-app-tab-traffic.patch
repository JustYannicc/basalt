diff --git a/e2e/tests/app-account-traffic.spec.ts b/e2e/tests/app-account-traffic.spec.ts
new file mode 100644
index 0000000..308be43
--- /dev/null
+++ b/e2e/tests/app-account-traffic.spec.ts
@@ -0,0 +1,268 @@
+/** An app's Accounts tab shows what the account's pool counted, beside the app's own check. */
+import { expect, layer } from "@effect/vitest";
+import { Clock, Effect, Schema } from "effect";
+import type { Page } from "playwright";
+import { Api, body } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { Evidence } from "../support/evidence.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Actors } from "../support/actors.ts";
+import { observationBackend, observationFixture } from "../support/account-observation-fixture.ts";
+import { answer, trafficPool, weekly } from "../support/account-traffic.ts";
+import { openRowMenu } from "../support/account-rows.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { poolUsageSeriesBackend } from "../support/pool-usage-series-backend.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+/** The tab's row for the account saved as `label`, found by its ⋯ menu, in one section. */
+const tabRow = (page: Page, section: string, label: string) =>
+  page
+    .getByRole("region", { name: section, exact: true })
+    .locator("li")
+    .filter({ has: page.getByRole("button", { name: `Manage ${label}`, exact: true }) });
+
+layer(HostedLive, { excludeTestServices: true })("App account traffic", (it) => {
+  it.effect(scenarios.appAccountTraffic.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          browser = yield* Browser,
+          evidence = yield* Evidence,
+          observed = yield* observationBackend,
+          pool = yield* poolUsageSeriesBackend;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        // A connector's own tab: its account keeps sign-in health and gets no Requests value.
+        const connector = yield* observationFixture({
+          name: "Tab connector",
+          observe: false,
+          health: true,
+        });
+        expect(
+          (yield* api.request(actors.owner, "PATCH", connector.accountPath, {
+            label: "Tab connector mail",
+          })).status,
+        ).toBe(200);
+        expect((yield* connector.check()).status).toBe(200);
+
+        const {
+          app,
+          accounts: [traffic, quiet],
+        } = yield* trafficPool({
+          name: "Tab pool",
+          origin: observed.origin,
+          labels: ["Tab traffic", "Tab quiet"],
+        });
+        if (traffic === undefined || quiet === undefined)
+          return yield* Effect.die("The pool saved fewer accounts than asked");
+        yield* observed.answer({ status: 200, body: weekly() });
+        expect(
+          (yield* api.request(
+            actors.owner,
+            "POST",
+            `${prefix}/accounts/${traffic}/observations/refresh`,
+          )).status,
+        ).toBe(200);
+        expect(
+          (yield* api.request(actors.owner, "POST", `${prefix}/accounts/${traffic}/health`)).status,
+        ).toBe(200);
+
+        // Opt the app in as the owner's native pool, with the signed loopback usage backend. The
+        // roles this tab doesn't list get IDs no account has, so the series never names them.
+        const ids = {
+          traffic,
+          steady: "unlisted-steady",
+          rejected: "unlisted-rejected",
+          idle: "unlisted-idle",
+        };
+        // One instant for the fixture's records and the browser's Date; timers still run.
+        const anchor = yield* Clock.currentTimeMillis;
+        yield* pool.respond(answer(ids, true, anchor));
+        const viewer = yield* body(
+          Schema.Struct({ userId: Schema.String }),
+          yield* api.request(actors.owner, "GET", "/api/viewer"),
+        );
+        const pools = (value: object) => ({
+          sql: `update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb), '{basaltPools}', $1::jsonb)::text where id=$2`,
+          params: [JSON.stringify(value), actors.organization.id],
+        });
+        yield* serverControl("stop");
+        yield* legacyStorage([
+          pools({
+            [viewer.userId]: {
+              app,
+              version: "retained-version",
+              authorization: "executor-app-v1",
+              membership: "executor-links-v1",
+            },
+          }),
+        ]);
+        // Opted out again before the app and accounts are removed: a native pool's link changes
+        // would notify the pool, which this loopback backend does not implement.
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* serverControl("stop");
+            yield* legacyStorage([pools({})]);
+            yield* serverControl("start");
+          }).pipe(Effect.orDie),
+        );
+        yield* serverControl("environment", 200, {
+          POOL_APP_SIGNING_KEY: "ab".repeat(32),
+          BASALT_POOL_ORIGIN: pool.origin,
+        });
+        yield* serverControl("start");
+
+        const slug = actors.organization.slug;
+        const poolTab = `/org/${slug}/apps/${app}?view=accounts`;
+        const connectorTab = `/org/${slug}/apps/${connector.app.id}?view=accounts`;
+        const row = (page: Page) => tabRow(page, "App accounts", "Tab traffic");
+        const ready = (page: Page) =>
+          Promise.all([
+            row(page).locator('[data-health-state="traffic"]').waitFor(),
+            row(page).locator("[data-window-tokens]").waitFor(),
+          ]);
+        yield* browser.login(actors.owner);
+        yield* browser.use("Fix the page's Date at the fixture's instant", (page) =>
+          page.clock.setFixedTime(anchor),
+        );
+        for (const width of [1280, 390]) {
+          yield* browser.use(`Open the pool's Accounts tab at ${width}px`, (page) =>
+            page
+              .setViewportSize({ width, height: 900 })
+              .then(() => page.goto(poolTab))
+              .then(() => ready(page)),
+          );
+          yield* evidence.attach(
+            `app-account-traffic-${width}.png`,
+            "image/png",
+            yield* browser.use("Capture the tab", (page) => page.screenshot({ fullPage: true })),
+          );
+        }
+
+        const before = (yield* pool.calls).length;
+        const wide = yield* browser.use("Read the tab at 1280px", (page) =>
+          page
+            .setViewportSize({ width: 1280, height: 900 })
+            .then(() => page.goto(poolTab))
+            .then(() => ready(page))
+            .then(() =>
+              Promise.all([
+                row(page).locator("[data-account-requests]").getAttribute("data-account-requests"),
+                row(page).locator("[data-account-requests]").getAttribute("title"),
+                row(page).locator("[data-requests-unit]").isVisible(),
+                row(page).locator('[data-health-state="traffic"]').getAttribute("data-ticks"),
+                row(page).locator("[data-success-share]").innerText(),
+                row(page).locator('[data-health-state="traffic"]').getAttribute("title"),
+                row(page).locator("[data-window-tokens]").innerText(),
+              ]),
+            ),
+        );
+        // The tab reads only the accounts linked to it, never the organization's whole list.
+        const reads = (yield* pool.calls)
+          .slice(before)
+          .flatMap((call) =>
+            call.action === "lastSuccessAt"
+              ? []
+              : [
+                  Schema.decodeUnknownSync(
+                    Schema.Struct({ accounts: Schema.optional(Schema.Array(Schema.String)) }),
+                  )(call.input).accounts,
+                ],
+          );
+        expect(reads.length).toBeGreaterThan(0);
+        for (const accounts of reads) expect(accounts).toEqual([traffic, quiet].sort());
+        // A linked account the series doesn't name says why its count is missing, never 0.
+        const quietCell = yield* browser.use("Read the quiet account's count", (page) =>
+          tabRow(page, "App accounts", "Tab quiet")
+            .locator("[data-account-requests-cell]")
+            .evaluate((cell) => ({
+              text: cell.textContent,
+              title: cell.querySelector("[data-account-requests-none]")?.getAttribute("title"),
+              count: cell.querySelectorAll("[data-account-requests]").length,
+            })),
+        );
+        expect(quietCell).toEqual({
+          text: "–No request history you can see for this account",
+          title: "No request history you can see for this account",
+          count: 0,
+        });
+        const [requests, requestsTitle, unit, ticks, share, healthTitle, tokens] = wide;
+        expect(requests).toBe("41");
+        expect(requestsTitle).toBe("41 requests in the last 7 days, counted by Tab pool");
+        // These lists have no column header, so the count says what it counts at every width.
+        expect(unit, "the count reads 41 req").toBe(true);
+        expect(ticks).toBe("nnnngnbg");
+        expect(share).toBe("92.6%");
+        // Traffic sits beside the app's own check, which the tooltip still names.
+        expect(healthTitle).toMatch(
+          /^41 requests in 7 days · 92\.6% succeeded · last success 12 min ago, counted by Tab pool\nHealthy by .+ · checked /,
+        );
+        expect(tokens).toBe("≥ 1.2M tokens");
+        expect(tokens).not.toContain("$");
+
+        const details = yield* browser.use("Open the account's details on the tab", (page) =>
+          openRowMenu(page, row(page), "Tab traffic")
+            .then((menu) => menu.getByRole("menuitem", { name: "Details", exact: true }).click())
+            .then(() => row(page).locator("[data-account-traffic-details]").innerText()),
+        );
+        expect(details).toMatch(
+          /^Requests: 41 in 7 days · 92\.6% succeeded · last success 12 min ago · counted by Tab pool$/,
+        );
+
+        const phone = yield* browser.use("Read the tab at 390px", (page) =>
+          page
+            .setViewportSize({ width: 390, height: 900 })
+            .then(() => page.goto(poolTab))
+            .then(() => ready(page))
+            .then(() =>
+              Promise.all([
+                page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth),
+                row(page).locator("[data-requests-unit]").isVisible(),
+              ]),
+            ),
+        );
+        expect(phone).toEqual([true, true]);
+
+        // The connector's tab: sign-in health only, no count and no ticks.
+        const connectorCells = yield* browser.use("Read the connector's tab", (page) => {
+          const mail = tabRow(page, "Your accounts", "Tab connector mail");
+          return page
+            .setViewportSize({ width: 1280, height: 900 })
+            .then(() => page.goto(connectorTab))
+            .then(() => mail.locator('[data-health-state="healthy"]').waitFor())
+            .then(() =>
+              Promise.all([
+                mail.locator("[data-account-requests]").count(),
+                mail.locator('[data-health-state="traffic"]').count(),
+                mail.locator("[data-account-traffic-details]").count(),
+              ]),
+            );
+        });
+        expect(connectorCells).toEqual([0, 0, 0]);
+
+        // Once the pool can't map any request, the open tab drops the Requests cells and the
+        // ticks, and Health is the app's check again. The next 30-second poll reads it.
+        yield* browser.use("Open the pool's tab again", (page) =>
+          page.goto(poolTab).then(() => ready(page)),
+        );
+        yield* pool.respond(answer(ids, false, anchor));
+        const hidden = yield* browser.use("Wait for the tab's Requests cells to go", (page) =>
+          page
+            .locator("[data-account-requests-cell]")
+            .first()
+            .waitFor({ state: "detached", timeout: 45_000 })
+            .then(() =>
+              Promise.all([
+                page.locator("[data-account-requests-cell]").count(),
+                page.locator('[data-health-state="traffic"]').count(),
+                row(page).locator('[data-health-state="healthy"]').count(),
+              ]),
+            ),
+        );
+        expect(hidden).toEqual([0, 0, 1]);
+      }),
+    ),
+  );
+});
