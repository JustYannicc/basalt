diff --git a/e2e/support/account-traffic.ts b/e2e/support/account-traffic.ts
new file mode 100644
index 0000000..f3d9cb4
--- /dev/null
+++ b/e2e/support/account-traffic.ts
@@ -0,0 +1,275 @@
+/**
+ * A native pool's answers for the account traffic scenarios: the series buckets and last successes
+ * the pool app's signed usage routes return, a reporter's weekly window, and the pool app itself
+ * with its accounts linked for everyone.
+ */
+import { expect } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "./actors.ts";
+import { Api, body } from "./api.ts";
+import { connectionsPath } from "./app-accounts.ts";
+import { appsManifest } from "./apps-release.ts";
+import { Resource } from "./contracts.ts";
+import { observationSource, observationToken } from "./account-observation-fixture.ts";
+import type { SeriesAssertion } from "./pool-usage-series-backend.ts";
+import { serverControl } from "./server-control.ts";
+
+export const hour = 3_600_000;
+export const day = 24 * hour;
+
+/** A full series bucket, as the pool sends one for an account the caller may inspect. */
+export const bucket = (
+  at: number,
+  requests: number,
+  failed: number,
+  total = { sum: null as string | null, known: 0, missing: requests },
+) => {
+  const token = { sum: null, known: 0, missing: requests };
+  const none = { amount: null, currency: null, priced: 0, unpriced: requests };
+  return {
+    at: new Date(at).toISOString(),
+    partial: false,
+    requests,
+    failed,
+    unassignedFailures: 0,
+    successRate: requests === 0 ? null : (requests - failed) / requests,
+    lastSuccessAtInRange: null,
+    tokens: {
+      input: token,
+      output: token,
+      cacheRead: token,
+      cacheWrite: token,
+      reasoning: token,
+      total,
+    },
+    tokenQuality: { complete: 0, legacy: 0, unclassified: requests, inconsistent: 0 },
+    cost: {
+      homeCharge: none,
+      importedApiPrice: none,
+      apiEquivalent: { status: "unavailable", reason: "No API price provenance." },
+      unpricedRequests: requests,
+    },
+    attribution: { chargeSnapshot: 0, keyAtCapture: 0, importOwner: 0, unknown: requests },
+  };
+};
+
+const SeriesInput = Schema.Struct({
+  from: Schema.String,
+  to: Schema.String,
+  bucket: Schema.Literals(["hour", "day"]),
+  accounts: Schema.optional(Schema.Array(Schema.String)),
+});
+
+/** The pool accounts by role; the series names each by its saved account ID. */
+export interface TrafficIds {
+  readonly traffic: string;
+  readonly steady: string;
+  readonly rejected: string;
+  readonly idle: string;
+}
+
+/**
+ * The traffic account made 41 requests in 7 days, 3 of them failed (92.6%). In the last hours it
+ * succeeded now and three hours ago and failed an hour ago, and its weekly window counted at least
+ * 1.2M tokens, one request without a count. The steady account succeeded 199 of 200 (99.5%), the
+ * rejected one 10 of 10, and the idle one last succeeded 3 days ago. The fifth account's requests
+ * are only other accounts' counts. Without `proven`, the pool can't map any request to an account.
+ */
+// Last successes are fixed at `anchor`, like real records, so polls don't move them. A spec fixes
+// the browser's Date at the same instant, so ages read exactly.
+export const answer =
+  (ids: TrafficIds, proven = true, anchor = Date.now()) =>
+  (assertion: SeriesAssertion) => {
+    const unavailable = { status: "unavailable", reason: "Synthetic." };
+    const mapping = {
+      current: true,
+      historicalGenerations: "unknown",
+      proof: proven ? "proven" : "unavailable",
+    };
+    if (assertion.action === "lastSuccessAt") {
+      const { accounts } = Schema.decodeUnknownSync(
+        Schema.Struct({ accounts: Schema.Array(Schema.String) }),
+      )(assertion.input);
+      const ago = {
+        [ids.traffic]: 12 * 60_000,
+        [ids.steady]: 5 * 60_000,
+        [ids.rejected]: 2 * hour,
+        [ids.idle]: 3 * day,
+      };
+      return {
+        asOf: new Date().toISOString(),
+        mapping,
+        accounts: accounts.map((account) => ({
+          account,
+          lastSuccessAt:
+            ago[account] === undefined ? null : new Date(anchor - ago[account]).toISOString(),
+        })),
+      };
+    }
+    const input = Schema.decodeUnknownSync(SeriesInput)(assertion.input);
+    const from = Date.parse(input.from);
+    const to = Date.parse(input.to);
+    const current = Math.floor(to / hour) * hour;
+    const week = input.bucket === "day" && to - from > 6 * day;
+    const named = (account: string) =>
+      input.accounts === undefined || input.accounts.includes(account);
+    const all = !proven
+      ? []
+      : input.bucket === "hour"
+        ? [
+            {
+              key: { currency: null, account: ids.traffic },
+              buckets: [
+                bucket(current - 3 * hour, 2, 0),
+                bucket(current - hour, 4, 1),
+                bucket(current, 5, 0),
+              ],
+            },
+            { key: { currency: null, account: ids.steady }, buckets: [bucket(current, 20, 0)] },
+            { key: { currency: null, account: ids.rejected }, buckets: [bucket(current, 1, 0)] },
+          ]
+        : week
+          ? [
+              {
+                key: { currency: null, account: ids.traffic },
+                buckets: [bucket(to - 2 * day, 30, 1), bucket(to - day, 11, 2)],
+              },
+              { key: { currency: null, account: ids.steady }, buckets: [bucket(to - day, 200, 1)] },
+              {
+                key: { currency: null, account: ids.rejected },
+                buckets: [bucket(to - day, 10, 0)],
+              },
+            ]
+          : [
+              {
+                key: { currency: null, account: ids.traffic },
+                buckets: [bucket(from, 41, 3, { sum: "1234567", known: 40, missing: 1 })],
+              },
+            ];
+    // Only an unfiltered read carries other accounts' counts.
+    const others =
+      proven && week && input.accounts === undefined
+        ? [
+            {
+              key: { currency: null, account: "otherAccounts" },
+              buckets: [
+                {
+                  at: new Date(to - day).toISOString(),
+                  partial: false,
+                  requests: 9,
+                  failed: 4,
+                  unassignedFailures: 0,
+                  successRate: 5 / 9,
+                },
+              ],
+            },
+          ]
+        : [];
+    return {
+      from: input.from,
+      to: input.to,
+      bucket: input.bucket,
+      asOf: new Date().toISOString(),
+      coverage: {
+        sources: [],
+        firstAt: null,
+        lastAt: null,
+        capturedThrough: null,
+        mapping: { ...mapping, mapped: 251, unmapped: 0, otherAccounts: 9 },
+        pricing: {
+          homeCharge: 0,
+          importedApiPrice: 0,
+          unpriced: 260,
+          missing: 0,
+          missingSnapshot: 0,
+          missingVersion: 0,
+          apiEquivalent: unavailable,
+        },
+        priceProjection: unavailable,
+        percentiles: unavailable,
+        seasonalTrainingRange: unavailable,
+      },
+      groups: [...all.filter((group) => named(group.key.account)), ...others],
+      next: null,
+    };
+  };
+
+/** A weekly window that started a day ago, so its tokens are read over exactly that day. */
+export const weekly = (at = new Date().toISOString()) => ({
+  observedAt: at,
+  observation: {
+    offering: "subscription",
+    plan: { label: "Pro", observedAt: at },
+    windows: [
+      {
+        id: "seven_day",
+        label: "Weekly",
+        observedAt: at,
+        measure: { unit: "percent", used: 11, limit: 100, remainingRatio: 0.89 },
+        period: { mode: "fixed", seconds: 7 * 86_400 },
+        resetsAt: new Date(Date.parse(at) + 6 * day).toISOString(),
+      },
+    ],
+    balances: [],
+  },
+});
+
+/**
+ * Deploys `name` as a pool app whose many() requirement is linked for everyone, then saves and
+ * links one account per label, in order. The app and accounts are removed when the case ends.
+ */
+export const trafficPool = (options: {
+  readonly name: string;
+  readonly origin: string;
+  readonly labels: readonly string[];
+}) =>
+  Effect.gen(function* () {
+    const api = yield* Api,
+      actors = yield* Actors;
+    const prefix = `/api/organizations/${actors.organization.id}`;
+    const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+      name: options.name,
+      files: [
+        {
+          path: "index.ts",
+          content: observationSource(options.origin, { observe: true, health: true }).replace(
+            "{ user:{accounts:{service}} }",
+            "{ app:{accounts:{service:service.many()}} }",
+          ),
+        },
+        appsManifest,
+      ],
+    });
+    expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+    const app = (yield* body(Resource, deployed)).id;
+    const appPath = `${prefix}/apps/${app}`;
+    const saved: string[] = [];
+    yield* Effect.addFinalizer(() =>
+      Effect.gen(function* () {
+        yield* serverControl("start");
+        yield* api.request(actors.owner, "DELETE", appPath);
+        for (const account of saved)
+          yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`);
+      }).pipe(Effect.orDie),
+    );
+    for (const label of options.labels) {
+      const pending = yield* body(
+        Resource,
+        yield* api.request(actors.owner, "POST", connectionsPath(appPath, "app", "service"), {}),
+      );
+      const submitted = yield* api.request(
+        actors.owner,
+        "POST",
+        `${prefix}/connections/${pending.id}/submit`,
+        { method: "key", fields: { token: observationToken } },
+      );
+      expect(submitted.status, JSON.stringify(submitted.body)).toBe(200);
+      const account = (yield* body(Resource, submitted)).id;
+      saved.push(account);
+      expect(
+        (yield* api.request(actors.owner, "PATCH", `${prefix}/accounts/${account}`, { label }))
+          .status,
+      ).toBe(200);
+    }
+    return { app, appPath, accounts: saved };
+  });
