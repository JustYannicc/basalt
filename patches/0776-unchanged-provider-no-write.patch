diff --git a/e2e/support/provider-writes.ts b/e2e/support/provider-writes.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/provider-writes.ts
@@ -0,0 +1,175 @@
+/**
+ * Provider rows are shared by every organization. A deploy must write one only when its definition
+ * changes, and concurrent deploys must still merge their definitions one at a time.
+ */
+import { expect } from "@effect/vitest";
+import { Clock, Effect, Fiber, Redacted, Schema } from "effect";
+import { Api, body } from "./api.ts";
+import { appsManifest } from "./apps-release.ts";
+import type { cloudLocks } from "./cloud-locks.ts";
+import { Target } from "./platform.ts";
+import { removeAppWhenStopped } from "./webhook-sources.ts";
+import { FixtureActors, fixtureRequest } from "../sdk/fixtures.ts";
+
+type Database = Effect.Success<typeof cloudLocks>;
+type Files = readonly { readonly path: string; readonly content: string }[];
+const App = Schema.Struct({
+  id: Schema.String,
+  requirements: Schema.Struct({
+    accounts: Schema.Record(Schema.String, Schema.Struct({ provider: Schema.String })),
+  }),
+});
+const Version = Schema.Array(Schema.Struct({ version: Schema.String }));
+const Pid = Schema.Array(Schema.Struct({ pid: Schema.Number }));
+const Waiting = Schema.Array(Schema.Struct({ waiting: Schema.Number }));
+const Rows = Schema.Array(
+  Schema.Struct({ id: Schema.String, methods: Schema.Array(Schema.String) }),
+);
+
+/** The row's creating transaction: it changes exactly when the row is written. */
+export const providerVersion = (database: Database, id: string) =>
+  database
+    .run({
+      sql: "select xmin::text as version from executor_providers where id = $1",
+      params: [id],
+    })
+    .pipe(
+      Effect.flatMap(Schema.decodeUnknownEffect(Version)),
+      Effect.map((rows) => {
+        expect(rows).toHaveLength(1);
+        return rows[0]!.version;
+      }),
+    );
+
+/** A second organization with its own owner, for deploys that share only provider rows. */
+export const otherOrganization = Effect.gen(function* () {
+  const api = yield* Api,
+    target = yield* Target;
+  if (target.fixtures === undefined) return yield* Effect.die("Managed Cloud required");
+  const control = target.fixtures,
+    id = crypto.randomUUID().replaceAll("-", "");
+  yield* Effect.addFinalizer(() => fixtureRequest(control, "/remove", { id }).pipe(Effect.orDie));
+  const outside = yield* fixtureRequest(control, "/actors", {
+    id,
+    label: "Organization deploying the same provider",
+  }).pipe(Effect.flatMap(Schema.decodeUnknownEffect(FixtureActors)));
+  const owner = yield* api.session(Redacted.make(outside.actors.owner.cookies));
+  const prefix = `/api/organizations/${outside.organization.id}`;
+  return {
+    deploy: (name: string, files: Files) =>
+      Effect.gen(function* () {
+        const response = yield* api.request(owner, "POST", `${prefix}/apps/deploy`, {
+          name,
+          files,
+        });
+        expect(response.status, JSON.stringify(response.body)).toBe(200);
+        const app = yield* body(App, response);
+        yield* Effect.addFinalizer(() =>
+          removeAppWhenStopped(owner, `${prefix}/apps/${app.id}`).pipe(Effect.asVoid, Effect.orDie),
+        );
+        return app;
+      }),
+    redeploy: (app: string, files: Files) =>
+      Effect.gen(function* () {
+        const response = yield* api.request(owner, "POST", `${prefix}/apps/${app}/deploy`, {
+          files,
+        });
+        expect(response.status, JSON.stringify(response.body)).toBe(200);
+        return (yield* body(Schema.Struct({ app: App }), response)).app;
+      }),
+  };
+});
+
+const source = (name: string, methods: readonly string[]): Files => [
+  {
+    path: "index.ts",
+    content: `import { defineApp, defineProvider, object, query, router, secrets, string } from "apps";
+const service = defineProvider({ name: ${JSON.stringify(name)}, family: { id: "fixture", name: "Fixture" }, auth: {
+  ${methods.map((method) => `${method}: secrets({ label: "${method} token", fields: object({ token: string() }) })`).join(",\n  ")}
+} });
+export default defineApp({ user: { accounts: { service } } }, async () => ({
+  tools: router({ ping: query({ input: object({}), output: string() }, async () => "ok") })
+}));`,
+  },
+  appsManifest,
+];
+
+/**
+ * Two first deploys of a new provider, started together, agree on one row; Postgres arbitrates
+ * their inserts, and nothing here forces the overlap. Two deploys adding different methods
+ * to that row, started while it is held, wait for it and then merge one after the other: the
+ * second sees the first's method, and the row is written because its definition changed.
+ */
+export const proveSerializedProviderWrites = (
+  database: Database,
+  other: Effect.Success<typeof otherOrganization>,
+) =>
+  Effect.gen(function* () {
+    const name = `Provider write proof ${crypto.randomUUID().slice(0, 8)}`;
+    const first = yield* Effect.all(
+      [
+        other.deploy(`${name} a`, source(name, ["rest"])),
+        other.deploy(`${name} b`, source(name, ["rest"])),
+      ],
+      { concurrency: 2 },
+    );
+    const ref = first[0].requirements.accounts.service!.provider;
+    expect(first[1].requirements.accounts.service?.provider).toBe(ref);
+    const rows = () =>
+      database
+        .run({
+          sql: "select id, array(select jsonb_object_keys(definition::jsonb -> 'auth') order by 1) as methods from executor_providers where definition::jsonb ->> 'name' = $1 order by id",
+          params: [name],
+        })
+        .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Rows)));
+    const created = yield* rows();
+    expect(created.map((row) => row.id)).toContain(ref);
+    // Content refs only: a fresh random ref would mean one deploy saw a conflicting definition.
+    expect(created.filter((row) => !/^prv_[0-9a-f]{64}$/.test(row.id))).toEqual([]);
+    const written = yield* providerVersion(database, ref);
+    const held = yield* database.hold({
+      sql: "select id from executor_providers where definition::jsonb ->> 'name' = $1 order by id for update",
+      params: [name],
+    });
+    expect(held.length).toBeGreaterThan(0);
+    const [holder] = yield* database
+      .hold({ sql: "select pg_backend_pid() as pid" })
+      .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Pid)));
+    // Each app keeps its ref for a strict addition, so both redeploys merge into the held row.
+    const merging = yield* Effect.all(
+      [
+        other.redeploy(first[0].id, source(name, ["rest", "aMethod"])),
+        other.redeploy(first[1].id, source(name, ["rest", "bMethod"])),
+      ],
+      { concurrency: 2 },
+    ).pipe(Effect.forkScoped);
+    const deadline = (yield* Clock.currentTimeMillis) + 30_000;
+    for (;;) {
+      // The second deploy queues behind the first, so it is blocked by the holder only through it.
+      const [blocked] = yield* database
+        .run({
+          sql: `with w as (select pid, pg_blocking_pids(pid) as by from pg_stat_activity where wait_event_type = 'Lock')
+          select count(*)::int as waiting from w where $1::int = any(w.by)
+            or exists (select 1 from w x where x.pid = any(w.by) and $1::int = any(x.by))`,
+          params: [holder!.pid],
+        })
+        .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Waiting)));
+      if (blocked!.waiting >= 2) break;
+      // A deploy that ends here never waited for the held row: report its own result instead.
+      if (merging.pollUnsafe() !== undefined)
+        return yield* Fiber.join(merging).pipe(
+          Effect.andThen(Effect.die("A deploy finished without waiting for the held provider row")),
+        );
+      expect(
+        yield* Clock.currentTimeMillis,
+        "both deploys wait for the held provider",
+      ).toBeLessThan(deadline);
+      yield* Effect.sleep("100 millis");
+    }
+    yield* database.release;
+    for (const deployed of yield* Fiber.join(merging))
+      expect(deployed.requirements.accounts.service?.provider).toBe(ref);
+    const after = (yield* rows()).find((row) => row.id === ref)!;
+    expect(after.methods).toEqual(["aMethod", "bMethod", "rest"]);
+    expect(yield* providerVersion(database, ref)).not.toBe(written);
+  });
