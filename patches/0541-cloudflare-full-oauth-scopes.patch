diff --git a/e2e/tests/oauth-scope-expansion-hosted.spec.ts b/e2e/tests/oauth-scope-expansion-hosted.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/oauth-scope-expansion-hosted.spec.ts
@@ -0,0 +1,190 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { FetchHttpClient, HttpClient } from "effect/http";
+import { randomUUID } from "node:crypto";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { accountIdentityIssuer } from "../support/account-identity-issuer.ts";
+import { IdentityAccount } from "../support/account-identity-product.ts";
+import { connectionsPath, linkedAccountIds } from "../support/app-accounts.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { Evidence } from "../support/evidence.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Hosted OAuth scope expansion", (it) => {
+  it.effect(scenarios.accountScopeExpansionHosted.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          issuer = yield* accountIdentityIssuer,
+          http = yield* HttpClient.HttpClient,
+          browser = yield* Browser,
+          evidence = yield* Evidence;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const name = `Scope expansion ${randomUUID().slice(0, 8)}`;
+        const files = (scopes: readonly string[]) => [
+          appsManifest,
+          {
+            path: "index.ts",
+            content: `import { defineApp, defineProvider, oauth2, router } from "apps";
+const service = defineProvider({ name: ${JSON.stringify(name)}, auth: { oauth: oauth2(${JSON.stringify(
+              {
+                authorizationUrl: issuer.origin + "/authorize",
+                tokenUrl: issuer.origin + "/token",
+                revocationUrl: issuer.origin + "/revoke",
+                tokenEndpointAuthMethod: "none",
+                scopes,
+                identity: { issuer: issuer.origin, name: "Scope fixture identity" },
+              },
+            )}) } });
+export default defineApp({ user: { accounts: { service } } }, async () => ({ tools: router({}) }));`,
+          },
+        ];
+        let app: string | undefined, account: string | undefined;
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            if (app !== undefined)
+              expect(
+                (yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app}`)).status,
+              ).toBe(200);
+            if (account !== undefined)
+              expect(
+                (yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`))
+                  .status,
+              ).toBe(200);
+          }).pipe(Effect.orDie),
+        );
+        const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name,
+          files: files(["read"]),
+        });
+        expect(deployed.status).toBe(200);
+        app = (yield* body(Resource, deployed)).id;
+        const appPath = `${prefix}/apps/${app}`;
+        const connectionPath = connectionsPath(appPath, "user", "service");
+        const created = yield* api.request(actors.owner, "POST", connectionPath, {});
+        expect(created.status).toBe(200);
+        const first = yield* body(Resource, created);
+        const started = yield* api.request(
+          actors.owner,
+          "POST",
+          `${prefix}/connections/${first.id}/oauth/start`,
+          { method: "oauth", client: { clientId: "synthetic-client" } },
+        );
+        expect(started.status).toBe(200);
+        const authorization = yield* body(
+          Schema.Struct({ authorizationUrl: Schema.String }),
+          started,
+        );
+        expect(new URL(authorization.authorizationUrl).searchParams.get("scope")).toBe("read");
+        const callbackUrl = yield* Effect.scoped(
+          Effect.gen(function* () {
+            const consent = yield* HttpClient.withScope(http).get(authorization.authorizationUrl);
+            expect(consent.status).toBe(302);
+            if (consent.headers.location === undefined)
+              return yield* Effect.die("Issuer omitted callback");
+            return consent.headers.location;
+          }),
+        ).pipe(Effect.provideService(FetchHttpClient.RequestInit, { redirect: "manual" }));
+        const completed = yield* api.request(
+          actors.owner,
+          "POST",
+          `${prefix}/connections/${first.id}/oauth/complete`,
+          { callbackUrl },
+        );
+        expect(completed.status).toBe(200);
+        const original = yield* body(IdentityAccount, completed);
+        account = original.id;
+        expect(yield* linkedAccountIds(actors.owner, appPath)).toEqual([original.id]);
+        const expanded = yield* api.request(actors.owner, "POST", `${appPath}/deploy`, {
+          files: files(["read", "write"]),
+        });
+        expect(expanded.status).toBe(200);
+
+        yield* browser.omitNetworkTrace;
+        yield* browser.login(actors.owner);
+        const accountsPage = `/org/${actors.organization.slug}/accounts`;
+        yield* browser.use("Open the saved synthetic account in Accounts", (page) =>
+          page.goto(accountsPage).then(() =>
+            page
+              .locator(".inventory-row")
+              .filter({ has: page.getByText("same@example.test", { exact: true }) })
+              .waitFor({ state: "visible" }),
+          ),
+        );
+        yield* browser.use("Open the saved account's menu", (page) =>
+          page
+            .locator(".inventory-row")
+            .filter({ has: page.getByText("same@example.test", { exact: true }) })
+            .getByRole("button", { name: /^Manage / })
+            .click(),
+        );
+        yield* evidence.attach(
+          "hosted-scope-expansion-menu.png",
+          "image/png",
+          yield* browser.use("Capture the permissions reconnect action", (page) =>
+            page.screenshot({ fullPage: true }),
+          ),
+        );
+        // A reconnect reads its own OAuth setup, creating its pinned connection as the dialog opens.
+        const reconnect = yield* browser.use("Reconnect directly from the Accounts menu", (page) =>
+          Promise.all([
+            page.waitForResponse(
+              (response) =>
+                response.request().method() === "POST" &&
+                new URL(response.url()).pathname.endsWith(
+                  `/apps/${app}/accounts/user/service/connections`,
+                ),
+            ),
+            page
+              .getByRole("menu")
+              .getByRole("menuitem", { name: "Reconnect to grant new permissions", exact: true })
+              .click(),
+          ]).then(async ([response]) => ({
+            status: response.status(),
+            payload: response.request().postDataJSON() as unknown,
+            body: (await response.json()) as unknown,
+          })),
+        );
+        expect(reconnect.status).toBe(200);
+        expect(reconnect.payload).toMatchObject({ account: original.id });
+        expect(reconnect.body).toMatchObject({
+          provider: { id: original.provider },
+          reconnectAccount: { id: original.id },
+          target: { app, requirement: "service" },
+        });
+        yield* browser.use("The reconnect dialog opens over Accounts", async (page) => {
+          const dialog = page.getByRole("dialog", { name: `Reconnect ${name}`, exact: true });
+          await dialog.waitFor({ state: "visible" });
+          await dialog.getByRole("button", { name: `Reconnect ${name}`, exact: true }).waitFor();
+          expect(new URL(page.url()).pathname).toBe(accountsPage);
+        });
+        yield* evidence.attach(
+          "hosted-scope-expansion-dialog.png",
+          "image/png",
+          yield* browser.use("Capture reconnect without visiting the app", (page) =>
+            page.screenshot({ fullPage: true }),
+          ),
+        );
+        yield* browser.use("Close the reconnect dialog", (page) =>
+          page.getByRole("dialog").getByRole("button", { name: "Close", exact: true }).click(),
+        );
+        const retained = yield* api.request(
+          actors.owner,
+          "GET",
+          `${prefix}/accounts/${original.id}`,
+        );
