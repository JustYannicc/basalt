diff --git a/packages/sdk/src/implementation/provider-oauth-scopes.ts b/packages/sdk/src/implementation/provider-oauth-scopes.ts
new file mode 100644
--- /dev/null
+++ b/packages/sdk/src/implementation/provider-oauth-scopes.ts
@@ -0,0 +1,33 @@
+/** OAuth access may grow without changing where credentials go or how they are used. */
+import { Schema } from "effect";
+import { JsonObject } from "../contracts/shared.ts";
+import type { ProviderDefinition } from "../contracts/provider.ts";
+import { canonical } from "./provider.ts";
+
+type Method = ProviderDefinition["auth"][string];
+
+/** Only authorization-code scopes may expand. Every other credential declaration must match. */
+export const expandsOAuthScopes = (before: Method, after: Method): boolean => {
+  if (
+    before.type !== "oauth2" ||
+    after.type !== "oauth2" ||
+    before.grant === "client_credentials" ||
+    after.grant === "client_credentials"
+  )
+    return false;
+  const { scopes: oldScopes, identity: _oldIdentity, ...oldContract } = before;
+  const { scopes: newScopes, identity: _newIdentity, ...newContract } = after;
+  return (
+    newScopes !== undefined &&
+    newScopes.length > 0 &&
+    Schema.is(JsonObject)(oldContract) &&
+    Schema.is(JsonObject)(newContract) &&
+    canonical(oldContract) === canonical(newContract) &&
+    (oldScopes ?? []).every((scope) => newScopes.includes(scope)) &&
+    (oldScopes === undefined || newScopes.some((scope) => !oldScopes.includes(scope)))
+  );
+};
+
+/** A retained app version cannot erase scopes another compatible version already requested. */
+export const mergeOAuthScopes = (stored: Method | undefined, incoming: Method): Method =>
+  stored !== undefined && expandsOAuthScopes(incoming, stored) ? stored : incoming;
