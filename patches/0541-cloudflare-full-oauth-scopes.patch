+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { TestLive, withCase } from "../support/case.ts";
+import { accountIdentityIssuer } from "../support/account-identity-issuer.ts";
+import { accountIdentityProduct, IdentityAccount } from "../support/account-identity-product.ts";
+import { body } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { Evidence } from "../support/evidence.ts";
+import { localAgent, pairLocalBrowser } from "../support/local-links.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(TestLive, { excludeTestServices: true })("OAuth scope expansion", (it) => {
+  it.effect(scenarios.accountScopeExpansion.title, (context) =>
+    withCase(
+      context,
+      Effect.gen(function* () {
+        const issuer = yield* accountIdentityIssuer,
+          product = yield* accountIdentityProduct;
+        const name = "Scope expansion fixture";
+        const app = yield* product.deploy(issuer.origin, name, ["read"]);
+        const first = yield* product.connection(app);
+        const started = yield* product.authorize(first);
+        expect((yield* product.complete(first, started)).status).toBe(200);
+        const original = yield* product.connectionAccount(first);
+        const sibling = yield* product.deploy(
+          issuer.origin,
+          "Retained reader",
+          ["read"],
+          {},
+          undefined,
+          { name },
+        );
+        const selected = yield* product.reuse(sibling, original.id);
+        expect(selected.status).toBe("completed");
+        if (selected.status !== "completed") return;
+        expect(selected.account.id).toBe(original.id);
+        const signIn = () => product.request("GET", `/v1/accounts/${original.id}/sign-in`);
+        const before = yield* signIn();
+        expect(before.status).toBe(200);
+        yield* product.deploy(issuer.origin, name, ["read", "write"], {}, app);
+        const after = yield* signIn();
+        expect(after.body).toMatchObject({ state: "reconnect", reason: "permissions" });
+        const browser = yield* Browser,
+          evidence = yield* Evidence;
+        yield* pairLocalBrowser((yield* localAgent).agent);
+        yield* browser.use("Inspect expanded OAuth access on the app Accounts tab", (page) =>
+          page
+            .goto(`/apps/${app}?view=accounts`)
+            .then(() => page.locator('[data-health-state="needs-sign-in"]').first().waitFor()),
+        );
+        yield* evidence.attach(
+          "scope-expansion-accounts.png",
+          "image/png",
+          yield* browser.use("Capture the permissions reconnect control", (page) =>
+            page.screenshot({ fullPage: true }),
+          ),
+        );
+        yield* browser.use("Reconnect the existing account from its permissions prompt", (page) =>
+          page
+            .getByRole("button", { name: "Reconnect to grant new permissions", exact: true })
+            .click()
+            .then(() =>
+              page.getByRole("dialog", { name: "Reconnect account", exact: true }).waitFor(),
+            )
+            .then(() =>
+              page.getByRole("dialog").getByRole("button", { name: "Close", exact: true }).click(),
+            ),
+        );
+        expect(yield* product.connectionAccount(first)).toEqual(original);
+        expect((yield* product.read(sibling)).status).toBe(200);
+        // A retained reader cannot overwrite the expanded provider's requested permissions.
+        yield* product.deploy(issuer.origin, "Retained reader", ["read"], {}, sibling, { name });
+        expect((yield* signIn()).body).toMatchObject({ state: "reconnect", reason: "permissions" });
+        const pending = yield* product.connection(app, original.id);
+        yield* issuer.configure({ denied: true });
+        const denied = yield* product.authorize(pending);
+        expect((yield* product.complete(pending, denied)).status).toBe(400);
+        expect(yield* product.connectionAccount(first)).toEqual(original);
+        expect((yield* product.read(sibling)).status).toBe(200);
+        yield* issuer.configure({ denied: false });
+        const upgraded = yield* product.authorize(pending);
+        expect(new URL(upgraded.authorizationUrl).searchParams.get("scope")).toBe("read write");
+        expect((yield* product.complete(pending, upgraded)).status).toBe(200);
+        const current = yield* product.connectionAccount(pending);
+        expect(current.id).toBe(original.id);
+        expect(current.provider).toBe(original.provider);
+        expect(current.identity?.id).toBe(original.identity?.id);
+        const state = yield* product.request("GET", `/v1/account-connections/${pending}`);
+        expect(state.body).toMatchObject({
+          id: pending,
+          state: { status: "completed", account: { id: original.id } },
+        });
+        for (const linked of [app, sibling]) expect((yield* product.read(linked)).status).toBe(200);
+        const accounts = yield* body(
+          Schema.Array(IdentityAccount),
+          yield* product.request("GET", "/v1/accounts?owner=local"),
+        );
+        expect(accounts.filter((a) => a.provider === original.provider)).toHaveLength(1);
+        expect((yield* signIn()).body).toMatchObject({ state: "saved" });
+        yield* serverControl("restart");
+        expect((yield* signIn()).body).toMatchObject({ state: "saved" });
+        expect((yield* product.connectionAccount(pending)).id).toBe(original.id);
+        // Removing a required scope gets a separate provider and cannot revive the old selection.
+        yield* product.deploy(issuer.origin, name, ["read"], {}, app);
+        const fresh = yield* product.connection(app);
+        const description = yield* product.request("GET", `/v1/account-connections/${fresh}`);
+        expect(description.body).toMatchObject({ reconnectAccount: null });
+        const provider = yield* body(
+          Schema.Struct({ provider: Schema.Struct({ id: Schema.String }) }),
+          description,
+        );
+        expect(provider.provider.id).not.toBe(original.provider);
+      }),
+    ),
+  );
+});
