+import { Effect, Schema } from "effect";
+import type { SqlClient } from "effect/sql";
+import type { ReactiveStore } from "@executor-js/reactivity";
+import { StorageError, type AccountId } from "../contracts/shared.ts";
+import { currentStorageSchema } from "./storage-current.ts";
+
+const SelectionAccount = Schema.Struct({
+  ...currentStorageSchema.tables.accounts.row.fields,
+  createdAt: Schema.Union([Schema.Date, Schema.DateFromString]),
+  executionTarget: Schema.NullOr(Schema.Record(Schema.String, Schema.Unknown)),
+});
+
+/** The optional target is a read join, with no new foreign key or migration. */
+export const makeSelectionAccountStore =
+  (sql: SqlClient.SqlClient, reactive: ReactiveStore) => (ids: readonly AccountId[]) =>
+    ids.length === 0
+      ? Effect.succeed([])
+      : reactive.read(
+          ["accounts", "accountTargets"],
+          sql`SELECT a.id, a.provider, a.method, a.label, a.description, a.owner, a.site,
+      a.created_at AS "createdAt", a.encrypted_credentials AS "encryptedCredentials",
+      a.credential_generation AS "credentialGeneration", a.allowed_hosts::jsonb AS "allowedHosts",
+      a.identity_id AS "identityId", a.oauth_grant_id AS "oauthGrantId",
+      CASE WHEN target.account IS NULL THEN NULL ELSE jsonb_build_object(
+        'account', target.account, 'owner', target.owner, 'revision', target.revision,
+        'mode', target.mode, 'enabled', target.enabled, 'device', target.device,
+        'deviceName', target.device_name, 'binding', target.binding,
+        'manifestRevision', target.manifest_revision) END AS "executionTarget"
+      FROM "executor_accounts" a LEFT JOIN executor_account_targets target
+        ON target.account = a.id AND target.owner = a.owner
+      WHERE ${sql.in("a.id", ids)}`.pipe(
+            Effect.flatMap(Schema.decodeUnknownEffect(Schema.Array(SelectionAccount))),
+            Effect.mapError(() => new StorageError()),
+          ),
+        );
