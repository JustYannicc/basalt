+import { Effect, Schema } from "effect";
+import { AccountTargetBinding } from "../contracts/account-target.ts";
+import { StorageError, type AccountId, type OwnerId } from "../contracts/shared.ts";
+
+/** Raw metadata observed with this exact account row; null is an observed absence. */
+export interface AccountTargetRead {
+  readonly account: AccountId;
+  readonly owner: OwnerId;
+  readonly credentialGeneration: number;
+  readonly row: unknown;
+}
+
+const StoredTarget = Schema.Struct({
+  account: AccountTargetBinding.fields.account,
+  owner: AccountTargetBinding.fields.owner,
+  revision: AccountTargetBinding.fields.revision,
+  mode: AccountTargetBinding.fields.mode,
+  enabled: AccountTargetBinding.fields.enabled,
+  ...AccountTargetBinding.fields.target.fields,
+});
+
+/** Decode at the target gate, after normal selection and app-view binding validation. */
+export const decodeAccountTarget = (
+  input: unknown,
+): Effect.Effect<AccountTargetBinding | undefined, StorageError> =>
+  input === null
+    ? Effect.succeed(undefined)
+    : Schema.decodeUnknownEffect(StoredTarget)(input).pipe(
+        Effect.flatMap(({ device, deviceName, binding, manifestRevision, ...identity }) =>
+          Schema.decodeUnknownEffect(AccountTargetBinding)({
+            ...identity,
+            target: { device, deviceName, binding, manifestRevision },
+          }),
+        ),
+        Effect.mapError(() => new StorageError()),
+      );
