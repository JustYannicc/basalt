--- /dev/null
+++ b/e2e/support/account-tool-accounting.ts
@@ -0,0 +1,167 @@
+import { expect } from "@effect/vitest";
+import { Effect, Schedule, Schema } from "effect";
+import { randomBytes, randomUUID } from "node:crypto";
+import { Api, body, type Session } from "./api.ts";
+import { App, Resource } from "./contracts.ts";
+import { appsManifest } from "./apps-release.ts";
+import { connectionsPath } from "./app-accounts.ts";
+import { Telemetry } from "./evidence.ts";
+
+const files = [
+  {
+    path: "index.ts",
+    content: `
+import { defineApp, defineProvider, secrets, object, string, router, query } from "apps";
+const service = defineProvider({ name: "Background accounting fixture", auth: {
+  key: secrets({ label: "API key", fields: object({ token: string() }) }),
+} });
+export default defineApp({ user: { accounts: { service } } }, { tools: router({
+  ping: query({ input: object({}) }, async () => true),
+  fail: query({ input: object({}) }, async () => { throw new Error("Synthetic tool failure"); }),
+}) });`,
+  },
+  appsManifest,
+];
+const Traffic = Schema.Struct({
+  accounts: Schema.Array(
+    Schema.Struct({
+      account: Schema.String,
+      requests: Schema.Number,
+      failed: Schema.Number,
+      lastSuccessAt: Schema.NullOr(Schema.String),
+    }),
+  ),
+});
+
+/** A normal deployed app and a linked synthetic key account, with only public operations. */
+export const accountToolAccounting = (
+  api: typeof Api.Service,
+  owner: Session,
+  prefix: string,
+  headers: Record<string, string> = {},
+) =>
+  Effect.gen(function* () {
+    const deployed = yield* api.request(
+      owner,
+      "POST",
+      `${prefix}/apps/deploy`,
+      {
+        name: `Background accounting ${randomUUID().slice(0, 8)}`,
+        files,
+      },
+      headers,
+    );
+    expect(deployed.status).toBe(200);
+    const app = (yield* body(App, deployed)).id;
+    yield* Effect.addFinalizer(() =>
+      api.request(owner, "DELETE", `${prefix}/apps/${app}`, undefined, headers).pipe(
+        Effect.tap((response) => Effect.sync(() => expect(response.status).toBe(200))),
+        Effect.orDie,
+      ),
+    );
+    const pending = yield* api.request(
+      owner,
+      "POST",
+      connectionsPath(`${prefix}/apps/${app}`, "user", "service"),
+      {},
+      headers,
+    );
+    expect(pending.status).toBe(200);
+    const saved = yield* api.request(
+      owner,
+      "POST",
+      `${prefix}/connections/${(yield* body(Resource, pending)).id}/submit`,
+      {
+        method: "key",
+        label: "Background key",
+        fields: { token: "synthetic-background-token" },
+      },
+      headers,
+    );
+    expect(saved.status).toBe(200);
+    const account = (yield* body(Resource, saved)).id;
+    yield* Effect.addFinalizer(() =>
+      api.request(owner, "DELETE", `${prefix}/accounts/${account}`, undefined, headers).pipe(
+        Effect.tap((response) => Effect.sync(() => expect(response.status).toBe(200))),
+        Effect.orDie,
+      ),
+    );
+    return {
+      account,
+      call: (tool: "ping" | "fail") =>
+        Effect.gen(function* () {
+          const traceId = randomBytes(16).toString("hex");
+          const response = yield* api.request(
+            owner,
+            "POST",
+            `${prefix}/apps/${app}/tools/call`,
+            {
+              tool,
+              kind: "query",
+              input: {},
+            },
+            { ...headers, traceparent: `00-${traceId}-${randomBytes(8).toString("hex")}-01` },
+          );
+          if (tool === "ping") expect(response.status).toBe(200);
+          else expect(response.status).toBeGreaterThanOrEqual(400);
+          return { response, traceId };
+        }),
+      read: Effect.gen(function* () {
+        const response = yield* api.request(
+          owner,
+          "POST",
+          `${prefix}/account-traffic`,
+          { accounts: [account] },
+          headers,
+        );
+        expect(response.status).toBe(200);
+        return (
+          (yield* body(Traffic, response)).accounts[0] ?? {
