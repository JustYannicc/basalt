+import { expect, layer } from "@effect/vitest";
+import { Effect, Schedule } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Evidence, Telemetry } from "../support/evidence.ts";
+import { cloudLocks } from "../support/cloud-locks.ts";
+import { accountToolAccounting, accountingCompleted } from "../support/account-tool-accounting.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })(
+  "Cloud background account tool accounting",
+  (it) => {
+    it.effect(scenarios.cloudAccountToolAccounting.title, (context) =>
+      withHostedCase(
+        context,
+        Effect.gen(function* () {
+          const api = yield* Api,
+            actors = yield* Actors,
+            evidence = yield* Evidence,
+            telemetry = yield* Telemetry,
+            locks = yield* cloudLocks;
+          const fixture = yield* accountToolAccounting(
+            api,
+            actors.owner,
+            `/api/organizations/${actors.organization.id}`,
+          );
+          for (const tool of ["ping", "fail"] as const) {
+            const before = yield* fixture.read;
+            // This scenario owns its managed Cloud database. A table lock also covers a call that
+            // opens a new UTC hour, while normal public traffic reads remain possible.
+            yield* locks.hold({ sql: "lock table executor_account_tool_calls in share mode" });
+            const [holder] = yield* locks.hold({ sql: "select pg_backend_pid() as pid" });
+            const pid = holder?.pid;
+            if (typeof pid !== "number") return yield* Effect.die("Accounting lock holder missing");
+            const call = yield* fixture.call(tool);
+            const blocked = yield* locks
+              .run({
+                sql: `select pid from pg_stat_activity where $1 = any(pg_blocking_pids(pid))
+            and query ilike '%insert into executor_account_tool_calls%'`,
+                params: [pid],
+              })
+              .pipe(
+                Effect.repeat({
+                  schedule: Schedule.spaced("20 millis"),
+                  until: (rows) => rows.length === 1,
+                }),
+                Effect.timeout("1 second"),
+              );
+            expect(blocked).toHaveLength(1);
+            expect(yield* fixture.read).toEqual(before);
+            yield* locks.release;
+            yield* evidence.json(
+              `${tool}-background-trace`,
+              yield* accountingCompleted(telemetry, call.traceId),
+            );
+            const after = yield* fixture.read;
+            expect(after.requests).toBe(before.requests + 1);
+            expect(after.failed).toBe(before.failed + (tool === "fail" ? 1 : 0));
+            if (tool === "ping") expect(after.lastSuccessAt).not.toBeNull();
+            else expect(after.lastSuccessAt).toBe(before.lastSuccessAt);
+            yield* evidence.json(`${tool}-accounting-order`, {
+              before,
+              after,
+              callTrace: call.traceId,
+              blocked: blocked.length,
+            });
+          }
+        }),
+      ),
+    );
+  },
+);
