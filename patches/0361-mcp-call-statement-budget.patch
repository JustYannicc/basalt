@@ -0,0 +1,86 @@
+import { Cause, Clock, Effect, Exit, Option, Predicate } from "effect";
+import { currentTraceContext, ownedBy, traceLinks } from "@executor-js/telemetry";
+import type { BackgroundWork } from "../contracts/declarations.ts";
+import { StorageError, type AccountId } from "../contracts/shared.ts";
+import { accountTrafficNotCounted, type makeAccountTrafficStore } from "./account-traffic-store.ts";
+
+const accountFailures = [
+  "ToolCallFailed",
+  "AppProviderFailed",
+  "OAuthReconnectRequired",
+  "OAuthRenewalFailed",
+] as const;
+
+/** Count only completed app work, preserving its outcome and original UTC bucket. */
+export const makeToolCallAccounting =
+  (
+    store: Pick<ReturnType<typeof makeAccountTrafficStore>, "record">,
+    background: BackgroundWork | undefined,
+  ) =>
+  (accounts: readonly AccountId[], entered: () => boolean) =>
+  <A, E, R>(effect: Effect.Effect<A, E, R>) =>
+    Effect.onExit(effect, (exit) => {
+      if (!entered() || accounts.length === 0) return Effect.void;
+      const ok = Exit.isSuccess(exit)
+        ? Predicate.hasProperty(exit.value, "status") && exit.value.status === "completed"
+          ? !(Predicate.hasProperty(exit.value, "toolError") && exit.value.toolError === true)
+          : undefined
+        : Cause.findErrorOption(exit.cause).pipe(
+              Option.exists((error) =>
+                accountFailures.some((tag) => Predicate.isTagged(error, tag)),
+              ),
+            )
+          ? false
+          : undefined;
+      if (ok === undefined) return Effect.void;
+      return Effect.gen(function* () {
+        const at = yield* Clock.currentTimeMillis;
+        const trace = yield* currentTraceContext;
+        const record = (accepted: boolean) =>
+          store.record({ accounts, at, ok }).pipe(
+            Effect.interruptible,
+            Effect.timeout("2 seconds"),
+            Effect.tap(() =>
+              Effect.annotateCurrentSpan("executor.account_traffic.outcome", "persisted"),
+            ),
+            Effect.catchCause((cause) => {
+              const error = Option.getOrUndefined(Cause.findErrorOption(cause));
+              const report = Cause.hasInterruptsOnly(cause)
+                ? accepted
+                  ? accountTrafficNotCounted("interrupted", undefined, accounts.length)
+                  : Effect.void
+                : error instanceof StorageError
+                  ? Effect.void
+                  : accountTrafficNotCounted(
+                      Cause.isTimeoutError(error) ? "timeout" : "unexpected",
+                      undefined,
+                      accounts.length,
+                    );
+              return Effect.uninterruptible(report);
+            }),
+          );
+        const linked = <B, F, S>(work: Effect.Effect<B, F, S>) =>
+          work.pipe(
+            Effect.withSpan(
+              "sdk.account_traffic.record",
+              ownedBy("background", {
+                root: true,
+                links: traceLinks(trace, "account-traffic"),
+                attributes:
+                  trace === undefined
+                    ? {}
+                    : {
+                        "executor.account_traffic.call_trace": trace.traceId,
+                        "executor.account_traffic.call_span": trace.spanId,
+                      },
+              }),
+            ),
+          );
+        if (background === undefined) return yield* record(false);
+        const accepted = yield* background(linked(record(true)));
+        if (accepted) return;
+        yield* linked(accountTrafficNotCounted("refused", undefined, accounts.length));
+        // A closing host refused ownership; keep the original bounded inline attempt.
+        yield* record(false);
+      });
+    });
