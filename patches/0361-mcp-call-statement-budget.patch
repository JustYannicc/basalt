diff --git a/apps/hosted/server/src/implementation/app-link-schema.ts b/apps/hosted/server/src/implementation/app-link-schema.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7672798898edaa7d5899f4ba717e6056dc575000
--- /dev/null
+++ b/apps/hosted/server/src/implementation/app-link-schema.ts
@@ -0,0 +1,12 @@
+import type { SqlClient } from "effect/sql";
+
+const contributedSchemas = new WeakSet<SqlClient.SqlClient>();
+
+/** Register only after hosted migrations committed, or in a runtime bound to their success. */
+export const registerContributedAccountSchema = (sql: SqlClient.SqlClient) => {
+  contributedSchemas.add(sql);
+};
+
+/** Schema capability follows the client, never an app's mutable deployment requirements. */
+export const hasContributedAccountSchema = (sql: SqlClient.SqlClient) =>
+  contributedSchemas.has(sql);
diff --git a/apps/hosted/server/src/implementation/background-work.ts b/apps/hosted/server/src/implementation/background-work.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1b5b60eeefe7ebfb15d6a5587c718c7ca80d574b
--- /dev/null
+++ b/apps/hosted/server/src/implementation/background-work.ts
@@ -0,0 +1,26 @@
+import { Effect, FiberSet } from "effect";
+import type { BackgroundWork } from "@executor-js/sdk/core";
+
+/** Accepted work drains before its host releases the database and runtime it shares. */
+export const makeHostedBackgroundWork = Effect.gen(function* () {
+  const work = yield* FiberSet.make();
+  let closing = false;
+  yield* Effect.addFinalizer(() =>
+    Effect.sync(() => {
+      closing = true;
+    }).pipe(
+      Effect.andThen(Effect.logDebug("Host background work is draining")),
+      Effect.andThen(FiberSet.awaitEmpty(work)),
+      Effect.timeoutOption("20 seconds"),
+      Effect.asVoid,
+    ),
+  );
+  return ((effect) =>
+    Effect.uninterruptible(
+      Effect.suspend(() =>
+        closing
+          ? Effect.succeed(false)
+          : FiberSet.run(work, Effect.interruptible(effect)).pipe(Effect.as(true)),
+      ),
+    )) satisfies BackgroundWork;
+});
