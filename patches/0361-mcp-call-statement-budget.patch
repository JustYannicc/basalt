+
+/** Wait for an exported completion event, then retain its independently rooted SQL trace. */
+export const accountingCompleted = (
+  telemetry: typeof Telemetry.Service,
+  traceId: string,
+  failure?: "storage" | "timeout",
+) =>
+  telemetry
+    .search("sdk.account_traffic.record", { "executor.account_traffic.call_trace": traceId })
+    .pipe(
+      Effect.repeat({
+        schedule: Schedule.spaced("100 millis"),
+        until: (result) => result.data.length > 0,
+      }),
+      Effect.timeout("10 seconds"),
+      Effect.flatMap((result) =>
+        Effect.gen(function* () {
+          expect(result.data).toHaveLength(1);
+          const entry = result.data[0]!;
+          expect(entry.traceId).not.toBe(traceId);
+          expect(entry.span.parentSpanId).toBeNull();
+          expect(entry.span.tags["executor.owner"]).toBe("background");
+          expect(entry.span.tags["executor.account_traffic.outcome"]).toBe(
+            failure === undefined ? "persisted" : "unconfirmed",
+          );
+          if (failure !== undefined) {
+            expect(entry.span.tags["executor.account_traffic.failure"]).toBe(failure);
+            expect(entry.span.tags["executor.account_traffic.accounts"]).toBe("1");
+            if (failure === "storage")
+              expect(entry.span.tags["executor.account_traffic.sqlstate"]).toBe("42883");
+          }
+          expect(entry.span.tags["executor.account_traffic.call_span"]).toMatch(/^[a-f0-9]{16}$/u);
+          const trace = yield* telemetry.query(entry.traceId);
+          if (failure !== "timeout")
+            expect(trace.data.some(({ span }) => span.operationName === "sql.execute")).toBe(true);
+          return trace;
+        }),
+      ),
+    );
