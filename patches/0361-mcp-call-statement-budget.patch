+import { scenarios } from "../test-plan.ts";
+
+const hold = "/api/devtools/statement-hold";
+const Held = Schema.Struct({ held: Schema.Boolean, completed: Schema.Boolean });
+const Users = Schema.Struct({
+  users: Schema.Array(Schema.Struct({ id: Schema.String, email: Schema.String })),
+});
+const Organizations = Schema.Array(Schema.Struct({ id: Schema.String }));
+
+layer(HostedLive, { excludeTestServices: true })("Background account tool accounting", (it) => {
+  it.effect(scenarios.accountToolAccounting.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const evidence = yield* Evidence;
+        const target = yield* startControlledDevelopmentServer(yield* Target);
+        const api = yield* Api.pipe(
+          Effect.provide(Layer.fresh(Api.layer)),
+          Effect.provide(Layer.fresh(SessionClients.layer)),
+          Effect.provideService(Target, target),
+        );
+        const telemetry = yield* Telemetry.pipe(
+          Effect.provide(Layer.fresh(Telemetry.layer)),
+          Effect.provideService(Target, target),
+        );
+        const owner = yield* api.session();
+        const headers = { origin: target.metadata.origin };
+        const send = (method: "GET" | "POST" | "DELETE", path: string, data?: unknown) =>
+          api.request(owner, method, `${target.metadata.origin}${path}`, data, headers);
+        expect((yield* send("POST", "/api/devtools/operator", {})).status).toBe(200);
+        const developer = (yield* body(
+          Users,
+          yield* send("GET", "/api/auth/admin/list-users"),
+        )).users.find((user) => user.email === "agent-agent@example.test");
+        if (developer === undefined) return yield* Effect.die("Development owner missing");
+        expect(
+          (yield* send("POST", "/api/auth/admin/impersonate-user", { userId: developer.id }))
+            .status,
+        ).toBe(200);
+        const organization = (yield* body(
+          Organizations,
+          yield* send("GET", "/api/auth/organization/list"),
+        ))[0];
+        if (organization === undefined)
+          return yield* Effect.die("Development organization missing");
+        const fixture = yield* accountToolAccounting(
+          api,
+          owner,
+          `${target.metadata.origin}/api/organizations/${organization.id}`,
+          headers,
+        );
+        yield* Effect.addFinalizer(() => send("DELETE", hold).pipe(Effect.orDie));
+
+        for (const tool of ["ping", "fail"] as const) {
+          for (const failure of ["storage", "timeout"] as const) {
+            const before = yield* fixture.read;
+            expect(
+              (yield* send("POST", hold, {
+                traffic: fixture.account,
+                ...(failure === "storage" ? { failure } : {}),
+              })).status,
+            ).toBe(200);
+            const call = yield* fixture.call("ping");
+            expect((yield* send("GET", `${hold}/reached`)).status).toBe(200);
+            if (failure === "storage") expect((yield* send("DELETE", hold)).status).toBe(200);
+            yield* evidence.json(
+              `${failure}-background-trace`,
+              yield* accountingCompleted(telemetry, call.traceId, failure),
+            );
+            expect(yield* fixture.read).toEqual(before);
+            expect((yield* send("DELETE", hold)).status).toBe(200);
+          }
+
+          const before = yield* fixture.read;
+          expect((yield* send("POST", hold, { traffic: fixture.account })).status).toBe(200);
+          const call = yield* fixture.call(tool);
+          expect((yield* send("GET", `${hold}/reached`)).status).toBe(200);
+          const held = yield* body(Held, yield* send("GET", hold));
+          expect(held).toEqual({ held: true, completed: false });
+          expect(yield* fixture.read).toEqual(before);
+          expect((yield* send("DELETE", hold)).status).toBe(200);
+          yield* evidence.json(
+            `${tool}-background-trace`,
+            yield* accountingCompleted(telemetry, call.traceId),
+          );
+          const after = yield* fixture.read;
+          expect(after.requests).toBe(before.requests + 1);
+          expect(after.failed).toBe(before.failed + (tool === "fail" ? 1 : 0));
+          if (tool === "ping") expect(after.lastSuccessAt).not.toBeNull();
+          else expect(after.lastSuccessAt).toBe(before.lastSuccessAt);
+          yield* evidence.json(`${tool}-accounting-order`, {
+            held,
+            before,
+            after,
+            callTrace: call.traceId,
+          });
+        }
+
+        const before = yield* fixture.read;
+        expect(
+          (yield* send("POST", hold, { traffic: fixture.account, releaseOnShutdown: true })).status,
+        ).toBe(200);
+        const call = yield* fixture.call("ping");
+        expect((yield* send("GET", `${hold}/reached`)).status).toBe(200);
+        expect(yield* body(Held, yield* send("GET", hold))).toEqual({
+          held: true,
+          completed: false,
+        });
+        // Release only after the host reports its drain has started, through the runner's stdin
+        // control. The product listener may already be closing, so it cannot release this hold.
+        yield* Effect.gen(function* () {
+          const stopping = yield* serverControl("stop").pipe(Effect.forkScoped);
+          yield* serverControl("accounting/closing");
+          yield* serverControl("accounting/release");
+          yield* Fiber.join(stopping);
+        }).pipe(
+          Effect.ensuring(serverControl("start").pipe(Effect.orDie)),
+          Effect.provideService(Target, target),
+        );
+        const after = yield* fixture.read;
+        expect(after.requests).toBe(before.requests + 1);
+        expect(after.failed).toBe(before.failed);
+        expect(after.lastSuccessAt).not.toBeNull();
+        yield* evidence.json("shutdown-accepted-accounting", {
+          before,
+          after,
+          callTrace: call.traceId,
+        });
+      }),
+    ),
+  );
+});
