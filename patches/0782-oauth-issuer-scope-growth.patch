+
+/** An issuer whose reviewed connections ask for its whole published scope list. */
+export interface WholeListIssuer {
+  readonly issuer: string;
+  /** The issuer's reviewed list today. A sign-in asking for all of it records so on its grant. */
+  readonly scopes: readonly string[];
+  /** The reviewed list when grants began recording that; earlier grants that asked for it count. */
+  readonly baseline: readonly string[];
+}
+
+/**
+ * The whole-list issuers. The default is generated by the host's preparation from its review
+ * registry; apps cannot mark an issuer.
+ */
+export const WholeListScopeIssuers = Context.Reference<{
+  readonly issuers: readonly WholeListIssuer[];
+}>("executor/WholeListScopeIssuers", { defaultValue: () => ({ issuers: wholeListScopeIssuers }) });
+
+const sameIssuer = (left: string, right: string) =>
+  URL.canParse(left) && URL.canParse(right) && new URL(left).href === new URL(right).href;
+const reviewedIssuer = (issuers: readonly WholeListIssuer[], issuer: string) =>
+  issuers.find((reviewed) => sameIssuer(reviewed.issuer, issuer));
+const covers = (asked: readonly string[], scopes: readonly string[]) =>
+  scopes.length > 0 && scopes.every((scope) => asked.includes(scope));
+
+/**
+ * Whether a sign-in to this server asks for its reviewed issuer's whole list. It is enough to ask
+ * for every baseline scope the issuer still publishes, so an app version that has not yet followed
+ * the issuer's latest change still counts.
+ */
+export const asksWholeList = (
+  server: { readonly issuer: string },
+  requested: readonly string[] | undefined,
+  issuers: readonly WholeListIssuer[],
+) => {
+  const reviewed = reviewedIssuer(issuers, server.issuer);
+  if (reviewed === undefined || requested === undefined) return false;
+  const kept = reviewed.scopes.filter((scope) => reviewed.baseline.includes(scope));
+  return covers(requested, kept.length > 0 ? kept : reviewed.scopes);
+};
+
+/**
+ * The requested scopes a saved grant is held to. A grant that asked for its reviewed issuer's
+ * whole list is not held to a scope it did not ask for that the issuer published since, or that
+ * the issuer has dropped from the baseline: neither is a permission the grant's tools were built
+ * on, and the next sign-in or reconnect asks for what the issuer still publishes. Any other scope
+ * stays required, and every other grant, including an older or narrower request on the same
+ * issuer, is held to every scope.
+ */
+export const scopesHeldToGrant = (
+  requested: readonly string[],
+  grant: OAuthGrant,
+  issuers: readonly WholeListIssuer[],
+) => {
+  if (grant.grant === "client_credentials" || isFirstPartyGrant(grant)) return requested;
+  const asked = grant.requestedScopes;
+  const reviewed = reviewedIssuer(issuers, grant.server.issuer);
+  if (asked === undefined || reviewed === undefined) return requested;
+  return grant.requestedIssuerList === true || covers(asked, reviewed.baseline)
+    ? requested.filter(
+        (scope) =>
+          asked.includes(scope) ||
+          (!reviewed.scopes.includes(scope) && !reviewed.baseline.includes(scope)),
+      )
+    : requested;
+};
