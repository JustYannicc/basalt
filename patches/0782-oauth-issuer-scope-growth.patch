+
+/**
+ * A short name for a set of scope names, so the SDK carries one name per reviewed list instead
+ * of the list. It tells reviewed lists apart and guards nothing secret: a list made to collide
+ * could only spare a grant's reconnect prompt or shared-grant refusal, and the service still
+ * refuses what the token lacks. Upstream preparation computes the same names; a test holds the two
+ * equal.
+ */
+export const scopeListDigest = (scopes: readonly string[]) => {
+  const names = [...new Set(scopes)].sort();
+  const text = names.join("\n");
+  let h1 = 0xdeadbeef ^ names.length;
+  let h2 = 0x41c6ce57 ^ names.length;
+  for (let index = 0; index < text.length; index++) {
+    const code = text.charCodeAt(index);
+    h1 = Math.imul(h1 ^ code, 2654435761);
+    h2 = Math.imul(h2 ^ code, 1597334677);
+  }
+  h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507) ^ Math.imul(h2 ^ (h2 >>> 13), 3266489909);
+  h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507) ^ Math.imul(h1 ^ (h1 >>> 13), 3266489909);
+  const hex = (value: number) => (value >>> 0).toString(16).padStart(8, "0");
+  return `${names.length}:${hex(h2)}${hex(h1)}`;
+};
+
+/** An issuer whose reviewed connections ask for its whole published scope list. */
+export interface WholeListIssuer {
+  readonly issuer: string;
+  /**
+   * `scopeListDigest` of every list reviewed since the mark: first the baseline grants asked for
+   * before they recorded a whole-list request, last today's. A stored provider can keep asking for
+   * an earlier one after the issuer drops a scope.
+   */
+  readonly lists: readonly string[];
+}
+
+/**
+ * The whole-list issuers. The default is generated by the host's preparation from its review
+ * registry; apps cannot mark an issuer.
+ */
+export const WholeListScopeIssuers = Context.Reference<{
+  readonly issuers: readonly WholeListIssuer[];
+}>("executor/WholeListScopeIssuers", { defaultValue: () => ({ issuers: wholeListScopeIssuers }) });
+
+const sameIssuer = (left: string, right: string) =>
+  URL.canParse(left) && URL.canParse(right) && new URL(left).href === new URL(right).href;
+const reviewedIssuer = (issuers: readonly WholeListIssuer[], issuer: string) =>
+  issuers.find((reviewed) => sameIssuer(reviewed.issuer, issuer));
+/** Exactly one of the issuer's reviewed lists, today's or one an older version still asks for. */
+const wholeList = (scopes: readonly string[], reviewed: WholeListIssuer) =>
+  scopes.length > 0 && reviewed.lists.includes(scopeListDigest(scopes));
+
+/** Whether a sign-in to this server asks for its reviewed issuer's whole list. */
+export const asksWholeList = (
+  server: { readonly issuer: string },
+  requested: readonly string[] | undefined,
+  issuers: readonly WholeListIssuer[],
+) => {
+  const reviewed = reviewedIssuer(issuers, server.issuer);
+  return reviewed !== undefined && requested !== undefined && wholeList(requested, reviewed);
+};
+
+/**
+ * The requested scopes a saved grant is held to. When the grant asked for its reviewed issuer's
+ * whole list (recorded at sign-in, or exactly the baseline for grants saved before the record) and
+ * today's request is one of that issuer's reviewed lists too, the grant is held only to what it
+ * asked for: a scope the list gained or lost since is no permission its tools were built on, and
+ * the next sign-in or reconnect asks for it. Every other grant or request, including an older or
+ * narrower one or one adding a scope outside the reviewed lists, is held to every requested scope.
+ */
+export const scopesHeldToGrant = (
+  requested: readonly string[],
+  grant: OAuthGrant,
+  issuers: readonly WholeListIssuer[],
+) => {
+  if (grant.grant === "client_credentials" || isFirstPartyGrant(grant)) return requested;
+  const asked = grant.requestedScopes;
+  const reviewed = reviewedIssuer(issuers, grant.server.issuer);
+  if (asked === undefined || reviewed === undefined) return requested;
+  const askedWhole =
+    grant.requestedIssuerList === true ||
+    (asked.length > 0 && scopeListDigest(asked) === reviewed.lists[0]);
+  return askedWhole && wholeList(requested, reviewed)
+    ? requested.filter((scope) => asked.includes(scope))
+    : requested;
+};
