diff --git a/apps/hosted/server/src/implementation/pool-defaults.ts b/apps/hosted/server/src/implementation/pool-defaults.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-defaults.ts
@@ -0,0 +1,250 @@
+/** One private pool app per verified organization owner. Compile before locking setup metadata. */
+import { pinnedOnly } from "@executor-js/app-management/data-steps";
+import {
+  AccountId,
+  AppId,
+  VersionId,
+  StorageError,
+  StorageHost,
+  sourceFilesEqual,
+  type App,
+  type Executor,
+} from "@executor-js/sdk/core";
+import { Config, Effect, Option, type Redacted, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import { type OrganizationId, organizationOwner } from "../contracts/organization.ts";
+import { ScheduleWakeup } from "../contracts/schedules.ts";
+import { lockAppLinks } from "./app-accounts.ts";
+import { poolAppSetup } from "./resource-lifecycle.ts";
+import { poolAppFiles, poolAppVersion } from "./pool-app-source.ts";
+import { repairPoolAccount, poolTokenKeyVersion } from "./pool-account.ts";
+import { productBrandSettings } from "@executor-js/utils/product-brand";
+
+const basaltPools = "basaltPools";
+const Pools = Schema.Struct({
+  pools: Schema.Record(
+    Schema.String,
+    Schema.Struct({
+      app: AppId,
+      version: VersionId,
+      bundle: Schema.optionalKey(Schema.String),
+      account: Schema.optionalKey(AccountId),
+      tokenKeyVersion: Schema.optionalKey(Schema.String),
+    }),
+  ),
+});
+const Member = Schema.Struct({ name: Schema.String, email: Schema.String });
+const poolSource = {
+  reference: "https://github.com/JustYannicc/basalt/tree/main/apps/pool",
+  commit: null,
+};
+
+/** Bound display names leave room for a numeric suffix under the SDK's 120-character limit. */
+export const poolName = (name: string, email: string, suffix = 1) => {
+  const person = name.trim() || email.split("@")[0] || "Your";
+  return `${person.slice(0, 100)}'s pool${suffix === 1 ? "" : ` ${suffix}`}`;
+};
+
+export const poolDefaults = (
+  executor: Executor,
+  key: Option.Option<Redacted.Redacted<string>>,
+  organization: OrganizationId,
+  user: string,
+) => {
+  let intent = false;
+  return Effect.gen(function* () {
+    if (Option.isNone(key)) {
+      yield* Effect.logWarning("Pool setup skipped: POOL_APP_SIGNING_KEY is missing");
+      return;
+    }
+    const sql = yield* SqlClient.SqlClient;
+    const owner = organizationOwner(organization);
+    const rows = yield* sql`select coalesce(metadata::jsonb -> ${basaltPools}, '{}'::jsonb) as pools
+      from organization where id = ${organization}`;
+    if (rows.length !== 1) return;
+    const { pools } = yield* Schema.decodeUnknownEffect(Pools)(rows[0]);
+    const saved = Object.hasOwn(pools, user) ? pools[user] : undefined;
+    const tokenKeyVersion = yield* poolTokenKeyVersion(key.value);
+    const members = yield* sql`select "user".name, "user".email from member
+      join "user" on "user".id = member."userId"
+      where member."organizationId" = ${organization} and member."userId" = ${user}
+        and member.role = 'owner' and "user"."emailVerified" = true`;
+    if (members.length !== 1) return;
+    const member = yield* Schema.decodeUnknownEffect(Member)(members[0]);
+    // Only metadata and credentials need the provisioning transaction. Copy/deploy own their
+    // short SDK transactions and release their connections before compilation.
+    const lockedState = Effect.gen(function* () {
+      const rows =
+        yield* sql`select coalesce(metadata::jsonb -> ${basaltPools}, '{}'::jsonb) as pools
+        from organization where id = ${organization} for no key update`;
+      if (rows.length !== 1) return undefined;
+      const state = yield* Schema.decodeUnknownEffect(Pools)(rows[0]);
+      yield* sql`select pg_advisory_xact_lock(hashtextextended(${`basalt-pool:${organization}:${user}`}, 0))`;
+      const eligible = yield* sql`select member.id from member
+        join "user" on "user".id = member."userId"
+        where member."organizationId" = ${organization} and member."userId" = ${user}
+          and member.role = 'owner' and "user"."emailVerified" = true for share of member, "user"`;
+      return eligible.length === 1 ? state : undefined;
+    });
+    const record = (pools: typeof Pools.Type.pools, pool: (typeof Pools.Type.pools)[string]) =>
+      sql`update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb),
+        array[${basaltPools}], ${JSON.stringify({ ...pools, [user]: pool })}::jsonb)::text
+        where id = ${organization}`;
+    if (saved !== undefined) {
+      const app = yield* executor.apps
+        .get({ owner, app: saved.app })
+        .pipe(Effect.catchTag("AppNotFound", () => Effect.succeed(undefined)));
+      // A recorded deletion is deliberate. Never recreate its app or credentials.
+      if (app === undefined) return;
+      let version = saved.version;
+      let bundle = saved.bundle;
+      // Owner deployments and workspace edits keep their source; credentials can still be repaired.
+      if (saved.bundle !== poolAppVersion && app.activeVersion === saved.version) {
+        const source = yield* executor.apps.source({ owner, app: app.id });
+        if (source.id === app.activeVersion) {
+          if (sourceFilesEqual(source.files, poolAppFiles)) bundle = poolAppVersion;
+          else {
+            const workspace = yield* executor.apps.workspace({ owner, app: app.id });
+            if (pinnedOnly(workspace.files, source.files)) {
+              const deployed = yield* executor.apps
+                .deploy({
+                  owner,
+                  app: app.id,
+                  files: poolAppFiles,
+                })
+                .pipe(poolAppSetup(user));
+              if (deployed.app.activeVersion === null) return yield* new StorageError();
+              version = deployed.app.activeVersion;
+              bundle = poolAppVersion;
+              intent = true;
+            }
+          }
+        }
+      }
+      yield* executor[StorageHost].transaction(
+        Effect.gen(function* () {
+          const current = yield* lockedState;
+          if (current === undefined) return;
+          const recorded = Object.hasOwn(current.pools, user) ? current.pools[user] : undefined;
+          // Another installer may have advanced the record while this compile was in flight.
+          if (
+            recorded?.app !== saved.app ||
+            recorded.version !== saved.version ||
+            recorded.bundle !== saved.bundle ||
+            recorded.account !== saved.account ||
+            recorded.tokenKeyVersion !== saved.tokenKeyVersion
+          )
+            return;
+          yield* lockAppLinks(sql, app.id);
+          const locked = yield* executor.apps
+            .get({ owner, app: app.id })
+            .pipe(Effect.catchTag("AppNotFound", () => Effect.succeed(undefined)));
+          if (
+            locked === undefined ||
+            locked.activeVersion !== (version === saved.version ? app.activeVersion : version)
+          )
+            return;
+          const repaired = yield* repairPoolAccount(
+            executor,
+            sql,
+            key.value,
+            organization,
+            user,
+            locked,
+            saved.account,
+          );
+          if (repaired.changed) intent = true;
+          yield* record(current.pools, {
+            app: app.id,
+            version,
+            ...(bundle === undefined ? {} : { bundle }),
+            account: repaired.account,
+            tokenKeyVersion,
+          });
+        }),
+      );
+      return;
+    }
+    const productName = (yield* Config.String(productBrandSettings.name).pipe(
+      Config.withDefault(""),
+    )).trim();
+    const origin = { ...poolSource, name: `${productName || "Signalbox"} pool` };
+    let candidate: App | undefined;
+    for (let suffix = 1; suffix <= 100; suffix++) {
+      const name = poolName(member.name, member.email, suffix);
+      candidate = yield* executor.apps
+        .copy({
+          owner,
+          name,
+          from: { files: poolAppFiles, origin, activation: "deploy" },
+        })
+        .pipe(
+          poolAppSetup(user),
+          Effect.catchTags({
+            AppNameTaken: () => Effect.succeed(undefined),
+            AppSlugTaken: () => Effect.succeed(undefined),
+          }),
+        );
+      if (candidate !== undefined) break;
+      const existing = (yield* executor.apps.list({ owner, name }))[0];
+      // The SDK preserves a copy's origin in App.copiedFrom. Hosted app access records who
+      // created it and its audience; a matching name alone never makes it this member's pool.
+      if (existing?.copiedFrom?.reference !== poolSource.reference) continue;
+      const ours = yield* sql`select access.id from hosted_app_access access
+        join organization team on team.id = access.organization_id
+        where access.id = ${existing.id} and access.organization_id = ${organization}
+          and access.creator_id = ${user} and access.audience = 'private'
+          and not exists (
+            select 1 from jsonb_each(coalesce(team.metadata::jsonb -> ${basaltPools}, '{}'::jsonb)) saved
+            where saved.key <> ${user} and saved.value ->> 'app' = ${existing.id}
+          )`;
+      if (ours.length === 1) {
+        candidate = existing;
+        break;
+      }
+    }
+    if (candidate === undefined) return yield* new StorageError();
+    const app = candidate;
+    const changed = yield* executor[StorageHost].transaction(
+      Effect.gen(function* () {
+        const current = yield* lockedState;
+        if (
+          current === undefined ||
+          Object.hasOwn(current.pools, user) ||
+          Object.values(current.pools).some((pool) => pool.app === app.id)
+        ) {
+          // Compilation has already committed this candidate. Never delete it or mutate the
+          // winner when another job recorded a pool first, or membership changed meanwhile.
+          yield* Effect.logInfo("Pool setup skipped; leaving candidate app unchanged", {
+            app: app.id,
+          });
+          return false;
+        }
+        yield* lockAppLinks(sql, app.id);
+        const locked = yield* executor.apps.get({ owner, app: app.id });
+        if (locked.activeVersion === null) return yield* new StorageError();
+        const repaired = yield* repairPoolAccount(
+          executor,
+          sql,
+          key.value,
+          organization,
+          user,
+          locked,
+        );
+        yield* record(current.pools, {
+          app: app.id,
+          version: locked.activeVersion,
+          bundle: poolAppVersion,
+          account: repaired.account,
+          tokenKeyVersion,
+        });
+        return true;
+      }),
+    );
+    if (changed) intent = true;
+  }).pipe(
+    Effect.tapError(() => Effect.logWarning("Pool setup failed; member job will retry")),
+    Effect.mapError(() => new StorageError()),
+    Effect.ensuring(Effect.suspend(() => (intent ? Effect.flatten(ScheduleWakeup) : Effect.void))),
+  );
+};
diff --git a/apps/hosted/server/src/implementation/pool-app-upgrades.ts b/apps/hosted/server/src/implementation/pool-app-upgrades.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-app-upgrades.ts
@@ -0,0 +1,39 @@
+import { Effect, type Redacted } from "effect";
+import { SqlClient } from "effect/sql";
+import { poolTokenKeyVersion } from "./pool-account.ts";
+import { poolAppVersion } from "./pool-app-source.ts";
+
+/** One rollout per bundle and signing key; the closure belongs to one initialized Worker isolate. */
+export const queuePoolAppUpgrades = (key: Redacted.Redacted<string>, version = poolAppVersion) => {
+  let completed = false;
+
+  return Effect.gen(function* () {
+    if (completed) return;
+    const name = `basalt-pools:${version}:${yield* poolTokenKeyVersion(key)}`;
+    const sql = yield* SqlClient.SqlClient;
+    // A fresh isolate checks the existing journal's primary key before reading any memberships.
+    const done = yield* sql`select 1 from private_hosted_data_steps
+      where name = ${name} and run = 'apply' and completed_at is not null`;
+    if (done.length === 0) {
+      yield* sql.withTransaction(
+        Effect.gen(function* () {
+          // Concurrent isolates serialize on this marker, without locking organization rows.
+          yield* sql`insert into private_hosted_data_steps (name, run, mode)
+          values (${name}, 'apply', 'apply') on conflict do nothing`;
+          const pending = yield* sql`select 1 from private_hosted_data_steps
+          where name = ${name} and run = 'apply' and completed_at is null for update`;
+          if (pending.length === 0) return;
+          // Jobs and completion commit together. The delay lets the replacement Worker take over.
+          yield* sql`insert into hosted_provisioning (kind, organization_id, user_id, available_at)
+          select 'member', member."organizationId", member."userId", now() + interval '15 minutes'
+          from member join "user" on "user".id = member."userId"
+          where member.role = 'owner' and "user"."emailVerified" = true`;
+          yield* sql`update private_hosted_data_steps set completed_at = now()
+          where name = ${name} and run = 'apply'`;
+        }),
+      );
+    }
+    // No promises or invocation-owned I/O are retained; failures leave the next tick eligible.
+    completed = true;
+  });
+};
diff --git a/apps/hosted/server/src/implementation/pool-account.ts b/apps/hosted/server/src/implementation/pool-account.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-account.ts
@@ -0,0 +1,116 @@
+/** Credential repair stays in the member setup transaction, after locking the pool's app. */
+import { AccountId, StorageError, type App, type Executor } from "@executor-js/sdk/core";
+import { Effect, Redacted, Schema } from "effect";
+import type { SqlClient } from "effect/sql";
+import { type OrganizationId, organizationOwner } from "../contracts/organization.ts";
+import { linkAppAccount } from "./app-accounts.ts";
+import { usableAppLinks } from "./resource-policy.ts";
+import { personalAccountCreation } from "./resource-lifecycle.ts";
+import { signPoolToken, verifyPoolToken } from "./pool-token.ts";
+
+/** A rotation gets a separate rollout without persisting the signing secret. */
+export const poolTokenKeyVersion = (key: Redacted.Redacted<string>) =>
+  Effect.tryPromise({
+    try: async () => {
+      const digest = await crypto.subtle.digest(
+        "SHA-256",
+        new TextEncoder().encode(Redacted.value(key)),
+      );
+      return Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, "0"))
+        .join("")
+        .slice(0, 16);
+    },
+    catch: () => new StorageError(),
+  });
+
+const Linked = Schema.Struct({ account: AccountId });
+
+/** Check the actual linked token even when the bundle and recorded key version are current. */
+export const repairPoolAccount = (
+  executor: Executor,
+  sql: SqlClient.SqlClient,
+  key: Redacted.Redacted<string>,
+  organization: OrganizationId,
+  user: string,
+  app: App,
+  recordedAccount?: AccountId,
+) =>
+  Effect.gen(function* () {
+    const requirement = app.requirements.accounts.pool;
+    if (
+      requirement === undefined ||
+      requirement.scope !== "app" ||
+      requirement.cardinality !== "one"
+    )
+      return yield* new StorageError();
+    const owner = organizationOwner(organization);
+    const linked = yield* Schema.decodeUnknownEffect(Schema.Array(Linked))(
+      yield* sql`select a.id as account from ${usableAppLinks(sql, [app.id])}
+      and l.requirement = 'pool' and a.provider = ${requirement.provider}
+      and a.method = 'token' and p.kind = 'personal' and p.personal_user_id = ${user}
+      order by l.created_at desc, a.id`,
+    );
+    const claimsFor = (account: AccountId) =>
+      Effect.gen(function* () {
+        const fields = yield* executor.managedAccounts.readCredentials({ owner, account }).pipe(
+          Effect.map((fields) => Redacted.value(fields)),
+          Effect.catchTags({
+            AccountNotFound: () => Effect.succeed(undefined),
+            CredentialsError: () => Effect.succeed(undefined),
+          }),
+        );
+        if (typeof fields?.token !== "string") return undefined;
+        const token = fields.token;
+        return yield* Effect.tryPromise({
+          try: () => verifyPoolToken(Redacted.value(key), token),
+          catch: () => new StorageError(),
+        });
+      });
+    const isOurs = (claims: Awaited<ReturnType<typeof verifyPoolToken>>) =>
+      claims?.pool === app.id && claims.owner === user && claims.organization === organization;
+    for (const { account } of linked)
+      if (isOurs(yield* claimsFor(account))) return { account, changed: false };
