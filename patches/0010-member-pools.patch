@@ -0,0 +1,78 @@
+export { cleanupRetiredPoolAccounts } from "./pool-account-cleanup.ts";
+import { Effect, type Redacted } from "effect";
+import { SqlClient } from "effect/sql";
+import { PoolAppSource, poolRotationJobPrefix } from "../contracts/pool-defaults.ts";
+import { poolTokenKeyVersion } from "./pool-account.ts";
+
+/**
+ * Bump when what a reconcile does changes, such as a new repair or decision log, so every pool is
+ * reconciled once even though the pool app's own source is unchanged.
+ */
+export const poolReconcileRevision = 3;
+
+/** Delay both rollouts: the pool Worker can deploy after tools; previous-key tokens keep working. */
+export const queuePoolAppUpgrades = (key: Redacted.Redacted<string>, version?: string) => {
+  let completed = false;
+  return Effect.gen(function* () {
+    if (completed) return;
+    const poolAppVersion = version ?? (yield* PoolAppSource).version;
+    const keyVersion = yield* poolTokenKeyVersion(key);
+    const sql = yield* SqlClient.SqlClient;
+    const steps = [
+      {
+        name: "basalt-pool-tokens",
+        cursor: keyVersion,
+        jobs: sql`insert into hosted_provisioning (id, kind, organization_id, user_id, available_at)
+          select ${poolRotationJobPrefix} || ${keyVersion} || ':' || gen_random_uuid()::text,
+            'member', team.id, pool.key, now() + interval '15 minutes' from organization team
+          cross join lateral jsonb_each(coalesce(team.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) pool
+          where pool.value ->> 'tokenKeyVersion' is distinct from ${keyVersion}`,
+      },
+      {
+        name: `basalt-pools:${poolAppVersion}:reconcile-${poolReconcileRevision}`,
+        cursor: null,
+        jobs: sql`insert into hosted_provisioning (kind, organization_id, user_id, available_at)
+          select 'member', member."organizationId", member."userId", now() + interval '15 minutes'
+          from member join "user" on "user".id = member."userId"
+          where member.role = 'owner' and "user"."emailVerified" = true`,
+      },
+    ];
+    // Fresh isolates read only the journal when both rollouts have already completed.
+    const done = yield* sql<{
+      name: string;
+      cursor: string | null;
+    }>`select name, cursor from private_hosted_data_steps
+      where ${sql.in(
+        "name",
+        steps.map((step) => step.name),
+      )}
+        and run = 'apply' and completed_at is not null`;
+    const pending = steps.filter(
+      (step) =>
+        !done.some(
+          (row) => row.name === step.name && (step.cursor === null || row.cursor === step.cursor),
+        ),
+    );
+    if (pending.length > 0)
+      yield* sql.withTransaction(
+        Effect.gen(function* () {
+          for (const step of pending) {
+            // Jobs and completion commit together; concurrent isolates serialize on each marker.
+            yield* sql`insert into private_hosted_data_steps (name, run, mode)
+          values (${step.name}, 'apply', 'apply') on conflict do nothing`;
+            const [locked] = yield* sql<{ completed: boolean; cursor: string | null }>`select
+              completed_at is not null as completed, cursor from private_hosted_data_steps
+              where name = ${step.name} and run = 'apply' for update`;
+            if (locked?.completed && (step.cursor === null || locked.cursor === step.cursor))
+              continue;
+            yield* step.jobs;
+            yield* sql`update private_hosted_data_steps set cursor = ${step.cursor},
+              pass = pass + case when completed_at is null then 0 else 1 end, completed_at = now()
+              where name = ${step.name} and run = 'apply'`;
+          }
+        }),
+      );
+    // No invocation-owned I/O is retained; failures leave the next tick eligible.
+    completed = true;
+  });
+};
