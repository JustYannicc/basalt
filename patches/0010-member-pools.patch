+/** The static asset binding serves the seed without an external HTTP request. */
+import type { Fetcher } from "@cloudflare/workers-types";
+import * as Cloudflare from "alchemy/Cloudflare";
+import { StorageError } from "@executor-js/sdk/core";
+import { Effect, Schema } from "effect";
+import { makePoolAppSource } from "../implementation/pool-app-assets.ts";
+
+const Assets = Schema.declare(
+  (value): value is Pick<Fetcher, "fetch"> =>
+    typeof value === "object" &&
+    value !== null &&
+    "fetch" in value &&
+    typeof value.fetch === "function",
+);
+
+export const cloudPoolAppSource = Effect.gen(function* () {
+  const environment = yield* Cloudflare.WorkerEnvironment;
+  return makePoolAppSource((path) =>
+    Effect.gen(function* () {
+      const assets = yield* Schema.decodeUnknownEffect(Assets)(environment.ASSETS).pipe(
+        Effect.mapError(() => new StorageError()),
+      );
+      return yield* Effect.tryPromise({
+        try: () => assets.fetch(new URL(path, "https://assets.invalid").href),
+        catch: () => new StorageError(),
+      });
+    }),
+  );
+});
