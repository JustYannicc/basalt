diff --git a/apps/hosted/server/src/implementation/managed-account-retirement.ts b/apps/hosted/server/src/implementation/managed-account-retirement.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/server/src/implementation/managed-account-retirement.ts
@@ -0,0 +1,49 @@
+import {
+  StorageHost,
+  StorageError,
+  type AccountId,
+  type Executor,
+  type OwnerId,
+} from "@executor-js/sdk/core";
+import { Context, Effect } from "effect";
+import type { SqlClient } from "effect/sql";
+
+/** Only a host repair can retire this exact account, after proving that it has no links. */
+export const ManagedAccountRetirement = Context.Reference<AccountId | undefined>(
+  "hosted/ManagedAccountRetirement",
+  {
+    defaultValue: () => undefined,
+  },
+);
+
+export const retireUnlinkedManagedAccount = (
+  executor: Executor,
+  sql: SqlClient.SqlClient,
+  owner: OwnerId,
+  account: AccountId,
+) =>
+  executor[StorageHost]
+    .transaction(
+      Effect.gen(function* () {
+        const rows =
+          yield* sql`select id from executor_accounts where id = ${account} and owner = ${owner} for update`;
+        if (rows.length === 0) return true;
+        // Link inserts take the account's key-share lock. Recheck after obtaining its exclusive lock.
+        if (
+          (yield* sql`select 1 from hosted_app_account_links where account = ${account} limit 1`)
+            .length > 0
+        )
+          return false;
+        yield* executor.accounts
+          .remove({ owner, account })
+          .pipe(Effect.provideService(ManagedAccountRetirement, account));
+        return true;
+      }),
+    )
+    .pipe(
+      Effect.catchTags({
+        AccountWebhooksActive: () => Effect.succeed(false),
+        AccountWorkflowsActive: () => Effect.succeed(false),
+      }),
+      Effect.mapError(() => new StorageError()),
+    );
diff --git a/apps/hosted/server/src/implementation/pool-account-cleanup.ts b/apps/hosted/server/src/implementation/pool-account-cleanup.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-account-cleanup.ts
@@ -0,0 +1,35 @@
+import { AccountId, type Executor, OwnerId } from "@executor-js/sdk/core";
+import { Effect, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import { retireUnlinkedManagedAccount } from "./managed-account-retirement.ts";
+
+const Retired = Schema.Array(Schema.Struct({ id: AccountId, owner: OwnerId }));
+const name = "basalt-retired-pool-accounts";
+
+/** GO approved: remove zero-link retired pool credentials. The journal and deletion commit together. */
+export const cleanupRetiredPoolAccounts = (executor: Executor) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    yield* sql.withTransaction(
+      Effect.gen(function* () {
+        yield* sql`insert into private_hosted_data_steps (name, run, mode) values (${name}, 'apply', 'apply') on conflict do nothing`;
+        const [step] = yield* sql<{
+          completed: boolean;
+          cursor: string | null;
+        }>`select cursor, completed_at is not null as completed from private_hosted_data_steps where name = ${name} and run = 'apply' for update`;
+        if (step?.completed) return;
+        const accounts = yield* Schema.decodeUnknownEffect(Retired)(
+          yield* sql`select a.id, a.owner
+      from executor_accounts a join hosted_account_access p on p.account_id = a.id
+      where a.label = 'Pool access (retired)' and a.method = 'token' and p.kind = 'personal'
+        and a.owner = 'organization:' || p.organization_id
+        and a.id > ${step?.cursor ?? ""}
+        and not exists (select 1 from hosted_app_account_links l where l.account = a.id)
+      order by a.id limit 100`,
+        );
+        for (const account of accounts)
+          yield* retireUnlinkedManagedAccount(executor, sql, account.owner, account.id);
+        yield* sql`update private_hosted_data_steps set cursor = ${accounts.at(-1)?.id ?? step?.cursor ?? null}, completed_at = ${accounts.length < 100 ? sql`now()` : sql`null`} where name = ${name} and run = 'apply'`;
+      }),
+    );
+  });
