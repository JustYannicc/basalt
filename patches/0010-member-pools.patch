+++ b/apps/hosted/cloud/src/implementation/pool-app-assets.ts
@@ -0,0 +1,51 @@
+/** Only a verified, immutable seed is cached. Failures and invocation-owned I/O never are. */
+import { SourceFiles, StorageError } from "@executor-js/sdk/core";
+import {
+  poolAppVersion,
+  poolAppAssetPath,
+  type PoolAppSource,
+} from "@executor-js/hosted-server/pool-defaults";
+import { Effect, Schema } from "effect";
+
+type AssetResponse = { readonly ok: boolean; readonly json: () => Promise<unknown> };
+
+export const makePoolAppSource = (
+  asset: (path: string) => Effect.Effect<AssetResponse, StorageError>,
+  version = poolAppVersion,
+  path = poolAppAssetPath,
+): Parameters<typeof PoolAppSource.of>[0] => {
+  let verified: SourceFiles | undefined;
+  return {
+    version,
+    files: Effect.suspend(() =>
+      verified === undefined
+        ? Effect.gen(function* () {
+            const response = yield* asset(path);
+            if (!response.ok) return yield* new StorageError();
+            const value = yield* Effect.tryPromise({
+              try: () => response.json(),
+              catch: () => new StorageError(),
+            });
+            const files = yield* Schema.decodeUnknownEffect(SourceFiles)(value).pipe(
+              Effect.mapError(() => new StorageError()),
+            );
+            const digest = yield* Effect.tryPromise({
+              try: () =>
+                crypto.subtle.digest("SHA-256", new TextEncoder().encode(JSON.stringify(files))),
+              catch: () => new StorageError(),
+            });
+            const hash = Array.from(new Uint8Array(digest), (byte) =>
+              byte.toString(16).padStart(2, "0"),
+            ).join("");
+            if (hash !== version) return yield* new StorageError();
+            verified = files;
+            return files;
+          }).pipe(
+            Effect.tapError(() =>
+              Effect.logWarning("Pool app seed is missing or invalid; setup will retry", { path }),
+            ),
+          )
+        : Effect.succeed(verified),
+    ),
+  };
+};
