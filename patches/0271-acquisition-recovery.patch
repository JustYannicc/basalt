diff --git a/apps/hosted/server/src/implementation/pool-acquisition-transport.ts b/apps/hosted/server/src/implementation/pool-acquisition-transport.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-acquisition-transport.ts
@@ -0,0 +1,86 @@
+import {
+  AcquisitionFailureReceipt,
+  InteractiveConnectionFailed,
+  type AccountAcquisitionContext,
+} from "@executor-js/sdk/core";
+import { Schema } from "effect";
+
+const failure = Schema.Struct({ receipt: AcquisitionFailureReceipt });
+
+/** Only read-only status requests repeat; mutation outcomes may be uncertain. */
+export async function acquisitionTransport(
+  context: AccountAcquisitionContext,
+  url: URL,
+  body: string,
+  action: string,
+): Promise<unknown> {
+  const limit = action === "status" ? 3 : 1;
+  for (let attempt = 0; attempt < limit; attempt++) {
+    let receipt: typeof AcquisitionFailureReceipt.Type = {
+      phase: "request",
+      errorClass: "transport",
+      retryable: true,
+    };
+    const remaining = context.deadline - Date.now() - 500;
+    const signal = AbortSignal.any([
+      context.signal,
+      AbortSignal.timeout(
+        Math.max(1, action === "status" ? Math.min(4_000, remaining) : remaining),
+      ),
+    ]);
+    if (remaining <= 0)
+      throw new InteractiveConnectionFailed({
+        reason: "step",
+        receipt: { phase: "request", errorClass: "timeout", retryable: true },
+      });
+    try {
+      const response = await context.fetch(url, {
+        method: "POST",
+        signal,
+        headers: { "content-type": "application/json" },
+        body,
+      });
+      if (response.ok) {
+        try {
+          return await response.json();
+        } catch {
+          receipt = { phase: "request", errorClass: "invalid_response", retryable: true };
+        }
+      } else {
+        // Decode only the endpoint's closed receipt; never retain or log its body.
+        const value: unknown = await response.json().catch(() => undefined);
+        const decoded = Schema.decodeUnknownOption(failure)(value);
+        receipt =
+          decoded._tag === "Some"
+            ? decoded.value.receipt
+            : {
+                phase: "request",
+                errorClass:
+                  response.status >= 500 || response.status === 429
+                    ? "home_unavailable"
+                    : "home_rejected",
+                retryable: response.status >= 500 || response.status === 429,
+              };
+      }
+    } catch {
+      receipt = {
+        phase: "request",
+        errorClass: signal.aborted ? "timeout" : "transport",
+        retryable: true,
+      };
+    }
+    console.warn(
+      "POOL_ACQUISITION_DRIVER_FAILURE",
+      JSON.stringify({ ...receipt, attempt: attempt + 1 }),
+    );
+    if (
+      !receipt.retryable ||
+      attempt + 1 >= limit ||
+      context.signal.aborted ||
+      Date.now() + 750 >= context.deadline
+    )
+      throw new InteractiveConnectionFailed({ reason: "step", receipt });
+    await new Promise<void>((resolve) => setTimeout(resolve, 250 * (attempt + 1)));
+  }
+  throw new InteractiveConnectionFailed({ reason: "step" });
+}
