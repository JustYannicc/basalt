diff --git a/apps/hosted/cloud/src/implementation/access-hooks.ts b/apps/hosted/cloud/src/implementation/access-hooks.ts
new file mode 100644
index 0000000..4d34ed7
--- /dev/null
+++ b/apps/hosted/cloud/src/implementation/access-hooks.ts
@@ -0,0 +1,123 @@
+/** Better Auth's Promise boundary for host access notifications and member-only sharing. */
+import type { BetterAuthPlugin } from "better-auth";
+import { tryGetCurrentAuthEndpointContext } from "@better-auth/core/context";
+import { APIError, createAuthMiddleware, getSessionFromCtx } from "better-auth/api";
+import type { OrganizationOptions } from "better-auth/plugins/organization";
+import { Schema } from "effect";
+
+export interface CloudAccessHooks {
+  readonly memberRemoving: (organization: string, member: string) => Promise<void>;
+  /** Grants may already be committed. The host logs failures; lazy key minting repairs them. */
+  readonly membersAdded: (organization: string) => Promise<void>;
+  readonly userDeleting: (user: string) => Promise<void>;
+}
+
+const requireMember = (role: string) => {
+  if (role !== "member")
+    throw new APIError("FORBIDDEN", {
+      message: "People can only join as members. Choose the member role and try again.",
+    });
+};
+
+const beforeRemoval = async (
+  access: CloudAccessHooks | undefined,
+  organization: string,
+  member: string,
+) => {
+  try {
+    await access?.memberRemoving(organization, member);
+  } catch {
+    throw new APIError("SERVICE_UNAVAILABLE", {
+      message: "Pool access could not be updated. No member was removed. Try again.",
+    });
+  }
+};
+
+export const organizationAccessHooks = (access?: CloudAccessHooks) =>
+  ({
+    beforeCreateOrganization: async ({ organization }) => {
+      if (organization.metadata === undefined) return;
+      const { basaltPools: _, ...metadata } = organization.metadata;
+      // Better Auth merges hook data with the request, so override the whole metadata field.
+      return { data: { metadata } };
+    },
+    beforeUpdateOrganization: async ({ organization }) => {
+      // Replacing JSON would erase SQL-owned pools; reading and merging races provisioning.
+      if (organization.metadata !== undefined)
+        throw new APIError("BAD_REQUEST", {
+          message: "Organization metadata cannot be updated through authentication requests.",
+        });
+    },
+    beforeCreateInvitation: async ({ invitation }) => {
+      requireMember(invitation.role);
+    },
+    beforeAcceptInvitation: async ({ invitation }) => {
+      requireMember(invitation.role);
+    },
+    beforeUpdateMemberRole: async ({ newRole }) => {
+      requireMember(newRole);
+    },
+    beforeAddMember: async ({ member, user }) => {
+      // Better Auth calls this for the creator too. Only its create endpoint owns that exception.
+      const creator =
+        tryGetCurrentAuthEndpointContext()?.path === "/organization/create" &&
+        member.role === "owner" &&
+        member.userId === user.id;
+      if (!creator) requireMember(member.role);
+    },
+    beforeRemoveMember: async ({ member, organization }) =>
+      beforeRemoval(access, organization.id, member.id),
+    afterAddMember: async ({ organization }) => {
+      await access?.membersAdded(organization.id);
+    },
+    afterAcceptInvitation: async ({ organization }) => {
+      await access?.membersAdded(organization.id);
+    },
+  }) satisfies NonNullable<OrganizationOptions["organizationHooks"]>;
+
+/** Better Auth 1.7.5's leave route bypasses beforeRemoveMember. Check the departing user here. */
+export const leavingAccessHook = (access?: CloudAccessHooks): BetterAuthPlugin => ({
+  id: "host-access-on-leave",
+  hooks: {
+    before: [
+      {
+        matcher: (context) => context.path === "/organization/leave",
+        handler: createAuthMiddleware(async (context) => {
+          const { organizationId } = Schema.decodeUnknownSync(
+            Schema.Struct({ organizationId: Schema.String }),
+          )(context.body);
+          const session = await getSessionFromCtx(context);
+          if (session === null) return;
+          const member = await context.context.adapter.findOne<{ id: string; role: string }>({
+            model: "member",
+            where: [
+              { field: "organizationId", value: organizationId },
+              { field: "userId", value: session.user.id },
+            ],
+          });
+          if (member === null) return;
+          // Native leave refuses the sole owner after plugin before-hooks have run. Let it refuse
+          // without revoking an audience for a membership that must remain in place.
+          if (member.role.split(",").includes("owner")) {
+            const members = await context.context.adapter.findMany<{ role: string }>({
+              model: "member",
+              where: [{ field: "organizationId", value: organizationId }],
+            });
+            if (members.filter((row) => row.role.split(",").includes("owner")).length <= 1) return;
+          }
+          await beforeRemoval(access, organizationId, member.id);
+        }),
+      },
+    ],
+  },
+});
+
+export const beforeUserDeletion = async (access: CloudAccessHooks | undefined, user: string) => {
+  try {
+    await access?.userDeleting(user);
+  } catch {
+    throw new APIError("SERVICE_UNAVAILABLE", {
+      message: "Pool access could not be revoked. Your account was not deleted. Try again.",
+    });
+  }
+};
