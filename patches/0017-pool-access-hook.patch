diff --git a/apps/hosted/server/src/implementation/pool-access-hook.ts b/apps/hosted/server/src/implementation/pool-access-hook.ts
new file mode 100644
index 0000000..86e037d
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-access-hook.ts
@@ -0,0 +1,124 @@
+/** Synchronize pool audiences before an access change becomes authoritative. */
+import { StorageError, type HostAccessLifecycle } from "@executor-js/sdk/core";
+import { Clock, Effect, Option, Redacted, Schedule, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import { FetchHttpClient, HttpBody, HttpClient } from "effect/http";
+import { accessPath, accessPrefix, accessTtl, type AccessChange } from "./pool-access-contract.ts";
+import { signEnvelope } from "./pool-token.ts";
+
+const Pool = Schema.Struct({
+  pool: Schema.String,
+  owner: Schema.String,
+  organization: Schema.String,
+  name: Schema.String,
+  users: Schema.Array(Schema.String),
+});
+
+/** The caller supplies the writing transaction's client, never a second connection. */
+export const poolAccessLifecycle = (
+  key: Option.Option<Redacted.Redacted<string>>,
+  origin: string,
+): HostAccessLifecycle => {
+  const send = (change: AccessChange) =>
+    Effect.gen(function* () {
+      if (Option.isNone(key)) {
+        yield* Effect.logWarning(
+          "Pool access synchronization skipped: POOL_APP_SIGNING_KEY is absent.",
+        );
+        return;
+      }
+      const at = yield* Clock.currentTimeMillis;
+      const envelope = yield* Effect.tryPromise(() =>
+        signEnvelope(Redacted.value(key.value), accessPrefix, {
+          ...change,
+          at,
+          expiresAt: at + accessTtl,
+        }),
+      );
+      const client = yield* HttpClient.HttpClient;
+      const response = yield* client.post(new URL(accessPath, origin).href, {
+        body: HttpBody.jsonUnsafe({ envelope }),
+      });
+      if (response.status < 200 || response.status >= 300) return yield* new StorageError();
+    }).pipe(
+      // Deletion is idempotent at the receiver, including an acknowledgement lost after commit.
+      Effect.retry({
+        times: change.action === "pool-deleted" ? 2 : 0,
+        schedule: Schedule.spaced("100 millis"),
+      }),
+      Effect.timeout("10 seconds"),
+      Effect.provide(FetchHttpClient.layer),
+      Effect.catch(() => new StorageError()),
+    );
+
+  const pools = (organization: string, apps?: readonly string[], removing?: string) =>
+    Effect.gen(function* () {
+      const sql = yield* SqlClient.SqlClient;
+      // JSON expands only this organization's recorded pools; deleted apps stay deleted.
+      const rows = yield* sql`select app.id as pool, entry.key as owner, o.id as organization,
+        app.name, array(select distinct users.id from (
+          select entry.key as id union select m."userId" from member m
+          where m."organizationId" = o.id
+          and ((access.audience = 'private' and access.creator_id = m."userId")
+            or access.audience = 'everyone' or (access.audience = 'groups' and exists (
+              select 1 from hosted_app_groups g join hosted_group_members gm on gm.group_id = g.group_id
+              where g.app_id = app.id and gm.member_id = m.id)))
+        ) users where not exists (select 1 from member departing
+          where departing.id = ${removing ?? null} and departing."organizationId" = o.id
+            and departing."userId" = users.id) order by users.id) as users
+        from organization o
+        cross join lateral jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) entry
+        join executor_apps app on app.id = entry.value ->> 'app' and app.owner = 'organization:' || o.id
+        join hosted_app_access access on access.id = app.id and access.organization_id = o.id
+        where o.id = ${organization} ${apps === undefined ? sql`` : sql`and ${sql.in("app.id", apps)}`}`;
+      return yield* Schema.decodeUnknownEffect(Schema.Array(Pool))(rows);
+    }).pipe(Effect.catch(() => new StorageError()));
+
+  const audience = (organization: string, apps?: readonly string[], removing?: string) =>
+    Effect.gen(function* () {
+      if (Option.isNone(key)) return yield* send({ action: "audience", pools: [] });
+      const found = yield* pools(organization, apps, removing);
+      if (found.length > 0) yield* send({ action: "audience", pools: found });
+    });
+  return {
+    appAccessChanged: ({ organization, apps }) => audience(organization, apps),
+    memberRemoving: ({ organization, member }) => audience(organization, undefined, member),
+    appRemoving: (app) =>
+      Effect.gen(function* () {
+        if (Option.isNone(key)) return yield* send({ action: "pool-deleted", pool: app });
+        const sql = yield* SqlClient.SqlClient;
+        const found = yield* sql`select o.id from organization o
+        cross join lateral jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) entry
+        join executor_apps app on app.id = entry.value ->> 'app' and app.owner = 'organization:' || o.id
+        where app.id = ${app}`.pipe(Effect.catch(() => new StorageError()));
+        if (found.length > 0) yield* send({ action: "pool-deleted", pool: app });
+      }),
+    organizationRemoving: (organization) =>
+      Effect.gen(function* () {
+        if (Option.isNone(key)) return yield* send({ action: "audience", pools: [] });
+        const sql = yield* SqlClient.SqlClient;
+        // Notify before owner-store erasure, while SQL can still prove the pool belongs here.
+        const rows = yield* sql<{
+          pool: string;
+        }>`select app.id as pool from organization o
+        cross join lateral jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) entry
+        join executor_apps app on app.id = entry.value ->> 'app' and app.owner = 'organization:' || o.id
+        where o.id = ${organization}`.pipe(Effect.catch(() => new StorageError()));
+        for (const row of rows) yield* send({ action: "pool-deleted", pool: row.pool });
+      }),
+    userDeleting: (user) =>
+      Effect.gen(function* () {
+        if (Option.isSome(key)) {
+          const sql = yield* SqlClient.SqlClient;
+          // Membership may be gone; the app must still belong to the organization recording it.
+          const rows = yield* sql<{
+            pool: string;
+          }>`select app.id as pool from organization o
+            join executor_apps app on app.id = o.metadata::jsonb -> 'basaltPools' -> ${user} ->> 'app'
+              and app.owner = 'organization:' || o.id`.pipe(Effect.catch(() => new StorageError()));
+          for (const row of rows) yield* send({ action: "pool-deleted", pool: row.pool });
+        }
+        yield* send({ action: "person-deleted", user });
+      }),
+  };
+};
