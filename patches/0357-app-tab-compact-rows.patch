+/**
+ * The ⋯ for a row the host gives no menu of its own, such as a grouped identity or a host-provisioned
+ * app account: the row's own actions (usage, Details, adding an app for the identity), and, with
+ * `manage`, each grouped sign-in's own actions in a dialog. Like every row with a menu, its checks
+ * and requested access open with Details. A row with no actions of its own gets no menu.
+ */
+export function AccountOwnActionsMenu({
+  title,
+  name,
+  manage,
+}: {
+  readonly title: string;
+  /** What the menu's button announces; by default the row's title (`accountMenuName`). */
+  readonly name?: string | undefined;
+  readonly manage?: ReactNode;
+}) {
+  const row = useAccountRow();
+  const [managing, setManaging] = useState(false);
+  const returnFocus = useRef<HTMLElement | null>(null);
+  if (manage === undefined && (row === undefined || !accountRowHasActions(row))) return null;
+  return (
+    <>
+      <AccountActionsMenu account={{ label: title }} name={name}>
+        {manage !== undefined && (
+          <DropdownMenuItem
+            onSelect={(event) => {
+              returnFocus.current = menuTrigger(event.target);
+              setManaging(true);
+            }}
+          >
+            Manage apps
+          </DropdownMenuItem>
+        )}
+      </AccountActionsMenu>
+      {manage !== undefined && (
+        <Dialog open={managing} onOpenChange={setManaging}>
+          <DialogContent
+            className="max-h-[85dvh] min-w-0 overflow-y-auto sm:max-w-[480px]"
+            onCloseAutoFocus={(event) => {
+              const target = returnFocus.current;
+              returnFocus.current = null;
+              if (target?.isConnected !== true) return;
+              event.preventDefault();
+              target.focus({ preventScroll: true });
+            }}
+          >
+            <DialogTitle>Manage apps</DialogTitle>
+            <DialogDescription>
+              Each saved sign-in for {title} has its own actions. Removing one leaves the others.
+            </DialogDescription>
+            {manage}
+          </DialogContent>
+        </Dialog>
+      )}
+    </>
+  );
+}
