++++ b/dist/esbuild-session.js
+@@ -0,0 +1,73 @@
++import { createService } from "esbuild-wasm/lib/browser.js";
++
++// The hosted compiler's caller stops waiting after 50 seconds. Only values cross requests:
++// a waiter owns its timer, and an expired owner's finalizer cannot close a newer service.
++const leaseMillis = 50_000;
++let active;
++const stop = (session) => {
++  if (!session.closed) {
++    session.closed = true;
++    void session.service.stop();
++  }
++  if (active === session) active = undefined;
++};
++const pause = (millis, signal) =>
++  new Promise((resolve, reject) => {
++    const finish = () => {
++      signal?.removeEventListener("abort", abort);
++      resolve();
++    };
++    const timer = setTimeout(finish, millis);
++    const abort = () => {
++      clearTimeout(timer);
++      signal.removeEventListener("abort", abort);
++      reject(signal.reason);
++    };
++    signal?.addEventListener("abort", abort, { once: true });
++    if (signal?.aborted) abort();
++  });
++
++export async function withEsbuildSession(signal, initialize, build) {
++  let session;
++  for (;;) {
++    signal?.throwIfAborted();
++    const now = Date.now();
++    if (active !== undefined && active.expires <= now) stop(active);
++    if (active === undefined) {
++      session = { service: createService(), expires: now + leaseMillis, closed: false };
++      active = session;
++      break;
++    }
++    await pause(Math.min(200, active.expires - now), signal);
++  }
++  let rejectAbort;
++  const cancelled =
++    signal === undefined
++      ? undefined
++      : new Promise((_, reject) => {
++          rejectAbort = reject;
++        });
++  const abort = () => {
++    stop(session);
++    rejectAbort(signal.reason);
++  };
++  signal?.addEventListener("abort", abort, { once: true });
++  const run = async () => {
++    signal?.throwIfAborted();
++    await initialize(session.service);
++    if (session.closed) {
++      // stop() during initialization has no running service yet. Close a late start too.
++      await session.service.stop();
++      throw new Error("The esbuild session ended before initialization completed");
++    }
++    const result = await build(session.service);
++    if (session.closed) throw new Error("The esbuild session ended before bundling completed");
++    return result;
++  };
++  try {
++    return await (cancelled === undefined ? run() : Promise.race([run(), cancelled]));
++  } finally {
++    signal?.removeEventListener("abort", abort);
++    stop(session);
++  }
++}
