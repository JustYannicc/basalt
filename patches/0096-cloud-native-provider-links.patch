diff --git a/e2e/support/cloud-native-stack.ts b/e2e/support/cloud-native-stack.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/cloud-native-stack.ts
@@ -0,0 +1,47 @@
+import { Effect, FileSystem, Path } from "effect";
+
+/** Use the production dev stack's Workers and preflights without its unrelated dashboard dev process. */
+export const cloudNativeStack = (cloud: string, directory: string) =>
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem,
+      path = yield* Path.Path;
+    const module = (file: string) => JSON.stringify(path.join(cloud, file));
+    const entry = path.join(directory, "native-http-stack.ts");
+    yield* fs.writeFileString(
+      entry,
+      `
+import * as Alchemy from "alchemy";
+import { AlchemyContext } from "alchemy/AlchemyContext";
+import { Effect } from "effect";
+import { cloudWorkers, cloudProviders } from ${module("alchemy.run.ts")};
+import { Api } from ${module("src/main.ts")};
+import AppPages from ${module("src/app-ui.ts")};
+import { McpServer } from ${module("src/infrastructure/mcp-server-worker.ts")};
+import { stackState } from ${module("src/infrastructure/state.ts")};
+import { databaseInfrastructure } from ${module("src/infrastructure/database.ts")};
+import { authEmailInfrastructure } from ${module("src/infrastructure/email.ts")};
+import { cloudAppUiBase } from ${module("src/contracts/app-ui.ts")};
+import { productionOAuthProxyCheck } from ${module("src/infrastructure/deploy-settings.ts")};
+import { mcpSessionRetirementGate } from ${module("src/infrastructure/mcp-session-release.ts")};
+import { uploadCloudSourceMaps } from ${module("src/infrastructure/sentry.ts")};
+export default Alchemy.Stack("executor-next-hosted", { providers: cloudProviders, state: stackState },
+  Effect.gen(function* () {
+    if (!(yield* AlchemyContext).dev) return yield* Effect.die("Native HTTP fixture requires local dev");
+    yield* productionOAuthProxyCheck.pipe(Effect.orDie);
+    yield* mcpSessionRetirementGate.pipe(Effect.orDie);
+    yield* databaseInfrastructure;
+    yield* authEmailInfrastructure.pipe(Effect.orDie);
+    const api = yield* Api;
+    if ((yield* cloudAppUiBase.pipe(Effect.orDie)) !== undefined) {
+      const pages = yield* AppPages;
+      yield* uploadCloudSourceMaps("app-pages", pages.hash).pipe(Effect.orDie);
+    }
+    yield* uploadCloudSourceMaps("api", api.hash).pipe(Effect.orDie);
+    yield* uploadCloudSourceMaps("mcp-server", (yield* McpServer).hash).pipe(Effect.orDie);
+    return { url: api.url };
+  }).pipe(Effect.provide(cloudWorkers)),
+);
+`,
+    );
+    return entry;
+  });
diff --git a/e2e/support/cloud-pool-gateway.ts b/e2e/support/cloud-pool-gateway.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/cloud-pool-gateway.ts
@@ -0,0 +1,164 @@
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Effect, FileSystem, Layer, Path, Ref, Schema } from "effect";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { createHmac, timingSafeEqual } from "node:crypto";
+import { createServer, request } from "node:http";
+import { freePort } from "./ports.ts";
+
+const access = "/pool/v1/access";
+const acquisition = "/pool/v1/account-acquisitions";
+const catalog = "/native-provider-fixture/catalog";
+const Signed = Schema.Struct({
+  action: Schema.String,
+  provider: Schema.optionalKey(Schema.String),
+  at: Schema.Number,
+  expiresAt: Schema.Number,
+});
+
+/** The outer pool service is external to the Cloud Worker, including for its own-origin callbacks. */
+export const cloudPoolGateway = (origin: string, directory: string) =>
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem,
+      path = yield* Path.Path;
+    const port = yield* freePort;
+    const source = yield* fs.readFileString(
+      path.resolve("..", "src/catalog/provider-apps/openai.json"),
+    );
+    const events = yield* Ref.make<
+      readonly {
+        path: string;
+        action: string;
+        provider: string | undefined;
+        refused: boolean;
+      }[]
+    >([]);
+    const backend = (url: string) =>
+      Effect.gen(function* () {
+        const { envelope } = yield* HttpServerRequest.schemaBodyJson(
+          Schema.Struct({ envelope: Schema.String }),
+        );
+        const [prefix, payload, signature, extra] = envelope.split(".");
+        if (
+          prefix !== (url === access ? "sba1" : "sbaa1") ||
+          payload === undefined ||
+          signature === undefined ||
+          extra !== undefined
+        )
+          return HttpServerResponse.empty({ status: 401 });
+        const expected = createHmac("sha256", Buffer.from("ab".repeat(32), "hex"))
+          .update(`${prefix}.${payload}`)
+          .digest();
+        const supplied = Buffer.from(signature, "base64url");
+        if (supplied.length !== expected.length || !timingSafeEqual(supplied, expected))
+          return HttpServerResponse.empty({ status: 401 });
+        const input = yield* Schema.decodeUnknownEffect(Schema.fromJsonString(Signed))(
+          Buffer.from(payload, "base64url").toString(),
+        );
+        const now = Date.now();
+        if (input.at > now || input.expiresAt <= now || input.expiresAt > input.at + 30_000)
+          return HttpServerResponse.empty({ status: 401 });
+        const refused =
+          process.env.BASALT_E2E_POOL_CLEANUP_REFUSED === "1" &&
+          (input.action === "remove" ||
+            input.action === "pool-deleted" ||
+            input.action === "person-deleted");
+        const event = { path: url, action: input.action, provider: input.provider, refused };
+        yield* Ref.update(events, (previous) => [...previous, event]);
+        yield* fs.writeFileString(
+          path.join(directory, "pool-backend.ndjson"),
+          JSON.stringify(event) + "\n",
+          { flag: "a", mode: 0o600 },
+        );
+        if (refused) return HttpServerResponse.empty({ status: 503 });
+        if (url === access) return HttpServerResponse.jsonUnsafe(null);
+        if (input.action === "start")
+          return HttpServerResponse.jsonUnsafe({ session: "synthetic-cloud-native-session" });
+        if (input.action === "status" || input.action === "submit")
+          return HttpServerResponse.jsonUnsafe({
+            state: "connected",
+            ref: "synthetic-cloud-native-reference",
+          });
+        if (input.action === "check") return HttpServerResponse.jsonUnsafe({ result: {} });
+        return HttpServerResponse.jsonUnsafe(null);
+      });
+    const routes = Layer.mergeAll(
+      HttpRouter.add("POST", access, backend(access)),
+      HttpRouter.add("POST", acquisition, backend(acquisition)),
+      HttpRouter.add(
+        "GET",
+        "/native-provider-fixture/backend-events",
+        Ref.get(events).pipe(Effect.map(HttpServerResponse.jsonUnsafe)),
+      ),
+      HttpRouter.add(
+        "GET",
+        `${catalog}/index.json`,
+        Effect.succeed(
+          HttpServerResponse.jsonUnsafe({
+            version: 1,
+            apps: [
+              {
+                id: "provider-openai",
+                package: "provider-openai",
+                name: "OpenAI",
+                description: "Native provider account fixture",
+                auth: [{ method: "codex", kind: "interactive" }],
+                icons: [],
+                source: "apps/provider-openai.json",
+              },
+            ],
+          }),
+        ),
+      ),
+      HttpRouter.add(
+        "GET",
+        `${catalog}/apps/provider-openai.json`,
+        Effect.succeed(HttpServerResponse.text(source, { contentType: "application/json" })),
+      ),
+    );
+    const context = yield* Layer.build(
+      HttpRouter.serve(routes, { disableLogger: true, disableListenLog: true }).pipe(
+        Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 })),
+      ),
+    );
+    const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(context));
+    if (!("port" in server.address)) return yield* Effect.die("Expected a TCP pool backend");
+    const backendPort = server.address.port;
+    yield* Effect.acquireRelease(
+      Effect.promise(() => {
+        const gateway = createServer((incoming, outgoing) => {
+          const url = new URL(incoming.url ?? "/", origin).pathname;
+          const forwarded = request(
+            {
+              hostname: "127.0.0.1",
+              port:
+                url.startsWith("/pool/v1/") || url.startsWith("/native-provider-fixture/")
+                  ? backendPort
+                  : port,
+              path: incoming.url,
+              method: incoming.method,
+              headers: incoming.headers,
+            },
+            (response) => {
+              outgoing.writeHead(response.statusCode ?? 502, response.headers);
+              response.pipe(outgoing);
+            },
+          );
+          forwarded.on("error", () => outgoing.writeHead(502).end());
+          incoming.pipe(forwarded);
+        });
+        return new Promise<typeof gateway>((resolve, reject) => {
+          gateway.once("error", reject);
+          gateway.listen(Number(new URL(origin).port), "127.0.0.1", () => resolve(gateway));
+        });
+      }),
+      (gateway) =>
+        Effect.promise(
+          () =>
+            new Promise<void>((resolve) => {
+              gateway.closeAllConnections();
+              gateway.close(() => resolve());
+            }),
+        ),
+    );
+    return port;
+  });
