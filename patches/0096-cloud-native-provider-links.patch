+import { expect } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "./actors.ts";
+import { Api, body } from "./api.ts";
+import { Resource } from "./contracts.ts";
+
+const Connected = Schema.Struct({ state: Schema.Literal("connected"), account: Resource });
+const Source = Schema.Struct({
+  files: Schema.Array(Schema.Struct({ path: Schema.String, content: Schema.String })),
+});
+
+/** Both account acquisition and cleanup use the real hosted API and its external native backend. */
+export const nativeProviderLinkFixture = Effect.gen(function* () {
+  const api = yield* Api,
+    actors = yield* Actors;
+  const prefix = `/api/organizations/${actors.organization.id}`;
+  let pendingAccount: string | undefined;
+  let acquiringApp: string | undefined;
+  const removeAccount = Effect.gen(function* () {
+    if (pendingAccount === undefined) return;
+    if (acquiringApp !== undefined) {
+      const unlinked = yield* api.request(
+        actors.owner,
+        "DELETE",
+        `${prefix}/apps/${acquiringApp}/accounts/app/openai/${pendingAccount}`,
+      );
+      expect(unlinked.status, JSON.stringify(unlinked.body)).toBe(200);
+      acquiringApp = undefined;
+    }
+    const removed = yield* api.request(
+      actors.owner,
+      "DELETE",
+      `${prefix}/accounts/${pendingAccount}`,
+    );
+    expect(removed.status, JSON.stringify(removed.body)).toBe(200);
+    pendingAccount = undefined;
+  });
+  yield* Effect.addFinalizer(() => removeAccount.pipe(Effect.orDie));
+  const source = yield* body(
+    Source,
+    yield* api.request(
+      actors.owner,
+      "GET",
+      "/native-provider-fixture/catalog/apps/provider-openai.json",
+    ),
+  );
+  const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+    name: "Ordinary OpenAI account consumer",
+    files: source.files,
+  });
+  expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+  const app = (yield* body(Resource, deployed)).id;
+  acquiringApp = app;
+  const pending = yield* body(
+    Resource,
+    yield* api.request(
+      actors.owner,
+      "POST",
+      `${prefix}/apps/${app}/accounts/app/openai/connections`,
+      { destination: { kind: "personal" } },
+    ),
+  );
+  const path = `${prefix}/connections/${pending.id}/interactive`;
+  const started = yield* api.request(actors.owner, "POST", `${path}/start`, { method: "codex" });
+  expect(started.status, JSON.stringify(started.body)).toBe(200);
+  const saved = yield* api.request(actors.owner, "GET", `${path}/status`);
+  expect(saved.status, JSON.stringify(saved.body)).toBe(200);
+  const account = (yield* body(Connected, saved)).account.id;
+  pendingAccount = account;
+  const installed = yield* api.request(actors.owner, "POST", `${prefix}/apps/install`, {
+    entry: "provider-openai",
+    name: "Native OpenAI provider",
+  });
+  expect(installed.status, JSON.stringify(installed.body)).toBe(200);
+  const target = (yield* body(Resource, installed)).id;
+  return { api, actors, prefix, target, account, removeAccount };
+});
