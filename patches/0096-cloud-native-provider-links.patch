+++ b/e2e/tests/native-provider-cloud-links.spec.ts
@@ -0,0 +1,71 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { nativeProviderLinkFixture } from "../support/native-provider-link-fixture.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Inventory = Schema.Struct({ accounts: Schema.Array(Schema.Struct({ id: Schema.String })) });
+
+const Methods = Schema.Struct({
+  unavailable: Schema.Array(Schema.Struct({ requirement: Schema.String, method: Schema.String })),
+});
+
+layer(HostedLive, { excludeTestServices: true })("Cloud native provider links", (it) => {
+  it.effect(scenarios.nativeProviderCloudLinks.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const p = yield* nativeProviderLinkFixture;
+        const path = `${p.prefix}/apps/${p.target}`;
+        const linked = yield* p.api.request(
+          p.actors.owner,
+          "PUT",
+          `${path}/accounts/app/openai/${p.account}`,
+        );
+        expect(linked.status, JSON.stringify(linked.body)).toBe(200);
+        const methods = yield* body(
+          Methods,
+          yield* p.api.request(p.actors.owner, "GET", `${path}/accounts/methods`),
+        );
+        expect(methods.unavailable).not.toContainEqual(
+          expect.objectContaining({ requirement: "openai", method: "codex" }),
+        );
+        const links = yield* p.api.request(p.actors.owner, "GET", `${path}/accounts/app`);
+        expect(links.status, JSON.stringify(links.body)).toBe(200);
+        expect(JSON.stringify(links.body)).toContain(p.account);
+        const removed = yield* p.api.request(
+          p.actors.owner,
+          "DELETE",
+          `${path}/accounts/app/openai/${p.account}`,
+        );
+        expect(removed.status, JSON.stringify(removed.body)).toBe(200);
+        const inventory = () =>
+          p.api
+            .request(p.actors.owner, "GET", `${p.prefix}/inventory`)
+            .pipe(Effect.flatMap((response) => body(Inventory, response)));
+        expect((yield* inventory()).accounts).toContainEqual(
+          expect.objectContaining({ id: p.account }),
+        );
+        yield* p.removeAccount;
+        expect((yield* inventory()).accounts).not.toContainEqual(
+          expect.objectContaining({ id: p.account }),
+        );
+        const events = yield* p.api.request(
+          p.actors.owner,
+          "GET",
+          "/native-provider-fixture/backend-events",
+        );
+        expect(events.status).toBe(200);
+        expect(events.body).toContainEqual(
+          expect.objectContaining({
+            path: "/pool/v1/account-acquisitions",
+            action: "remove",
+            provider: "codex",
+            refused: false,
+          }),
+        );
+      }),
+    ),
+  );
+});
