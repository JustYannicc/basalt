diff --git a/e2e/support/native-provider-link-fixture.ts b/e2e/support/native-provider-link-fixture.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/native-provider-link-fixture.ts
@@ -0,0 +1,125 @@
+import { expect } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "./actors.ts";
+import { Api, body } from "./api.ts";
+import { appsManifest } from "./apps-release.ts";
+import { cloudLocks } from "./cloud-locks.ts";
+import { Resource } from "./contracts.ts";
+import { providerAppsCatalog } from "./provider-apps-catalog.ts";
+
+const Connected = Schema.Struct({ state: Schema.Literal("connected"), account: Resource });
+const Provider = Schema.Array(Schema.Struct({ provider: Schema.String }));
+
+/** Seed a pre-existing native account from a public sign-in's encrypted reference in disposable SQL. */
+export const nativeProviderLinkFixture = Effect.gen(function* () {
+  const api = yield* Api,
+    actors = yield* Actors,
+    database = yield* cloudLocks,
+    catalog = yield* providerAppsCatalog;
+  const prefix = `/api/organizations/${actors.organization.id}`;
+  const apps: string[] = [];
+  let account: string | undefined;
+  yield* Effect.addFinalizer(() =>
+    Effect.gen(function* () {
+      // The disposable Cloud has no outer pool Worker. Remove only its exact synthetic pool rows.
+      yield* database.run({
+        sql: "delete from executor_apps app using organization o, lateral jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) entry where o.id = $1 and app.id = entry.value ->> 'app' and app.owner = 'organization:' || o.id",
+        params: [actors.organization.id],
+      });
+      if (account !== undefined) {
+        for (const [table, column] of [
+          ["hosted_app_account_links", "account"],
+          ["executor_webhook_sources", "account"],
+          ["executor_account_acquisitions", "account"],
+          ["hosted_account_access", "account_id"],
+        ])
+          yield* database.run({
+            sql: `delete from ${table} where ${column} = $1`,
+            params: [account],
+          });
+        yield* database.run({
+          sql: "delete from executor_account_connections where state -> 'account' ->> 'id' = $1",
+          params: [account],
+        });
+        yield* database.run({
+          sql: "delete from executor_accounts where id = $1",
+          params: [account],
+        });
+      }
+      for (const app of apps) {
+        const removed = yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app}`);
+        expect(removed.status, JSON.stringify(removed.body)).toBe(200);
+      }
+    }).pipe(Effect.orDie),
+  );
+  const deploy = (name: string, files: readonly { path: string; content: string }[]) =>
+    Effect.gen(function* () {
+      const response = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+        name,
+        files,
+      });
+      expect(response.status, JSON.stringify(response.body)).toBe(200);
+      const app = (yield* body(Resource, response)).id;
+      apps.push(app);
+      return app;
+    });
+  const source = yield* deploy("Existing native account source", [
+    appsManifest,
+    {
+      path: "index.ts",
+      content: `import { defineApp, defineProvider, interactive } from "apps";
+const legacy = defineProvider({ name: "Subscription", auth: { codex: interactive({ label: "ChatGPT" }) } });
+export default defineApp({ app: { accounts: { legacy: legacy.many() } } }, {
+  connect: { legacy: {
+    start: async () => ({ session: "synthetic-native-link" }),
+    status: async () => ({ state: "connected", ref: "synthetic-native-link-reference" }),
+    cancel: async () => {}, remove: async () => {}
+  } }
+});`,
+    },
+  ]);
+  const pending = yield* body(
+    Resource,
+    yield* api.request(
+      actors.owner,
+      "POST",
+      `${prefix}/apps/${source}/accounts/app/legacy/connections`,
+      { destination: { kind: "personal" } },
+    ),
+  );
+  const path = `${prefix}/connections/${pending.id}/interactive`;
+  expect(
+    (yield* api.request(actors.owner, "POST", `${path}/start`, { method: "codex" })).status,
+  ).toBe(200);
+  const saved = yield* api.request(actors.owner, "GET", `${path}/status`);
+  expect(saved.status, JSON.stringify(saved.body)).toBe(200);
+  account = (yield* body(Connected, saved)).account.id;
+  const target = yield* deploy("Native OpenAI provider", catalog.sources.get("openai")!.files);
+  const providers = yield* database
+    .run({
+      sql: "select d.requirements -> 'accounts' -> 'openai' ->> 'provider' as provider from executor_deployments d join executor_apps a on a.active_deployment = d.id where a.id = $1",
+      params: [target],
+    })
+    .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Provider)));
+  const provider = providers[0]!.provider;
+  yield* database.run({
+    sql: "update executor_apps set copied_from = $2::json where id = $1",
+    params: [
+      target,
+      JSON.stringify({
+        reference: "https://catalog.example.test/provider-openai",
+        name: "provider-openai",
+        commit: null,
+      }),
+    ],
+  });
+  yield* database.run({
+    sql: "update executor_accounts set provider = $2 where id = $1",
+    params: [account, provider],
+  });
+  yield* database.run({
+    sql: "insert into executor_account_acquisitions (account,owner,provider,method,driver,driver_revision,generation,revision,removal,mirror_reference,mirror_ready,mirror_operation) select id,owner,provider,method,'basalt-home','oauth-v1',credential_generation,'native-link-fixture',null,null,true,null from executor_accounts where id = $1",
+    params: [account],
+  });
+  return { api, actors, prefix, target, account };
+});
