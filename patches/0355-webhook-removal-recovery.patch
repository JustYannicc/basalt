+++ b/e2e/support/webhook-removal-fixture.ts
@@ -0,0 +1,145 @@
+import { expect } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { FetchHttpClient, HttpClient } from "effect/http";
+import { body } from "./api.ts";
+import { connectionsPath, requirementPath } from "./app-accounts.ts";
+import { appLinksFixture, keyProvider } from "./app-links.ts";
+import { Resource } from "./contracts.ts";
+import { oauthSetupIssuer } from "./oauth-setup-issuer.ts";
+import { webhookRegistrationFixture } from "./webhook-registration.ts";
+import {
+  settleWebhookSources,
+  settleWebhookSubscriptions,
+  sourcesAre,
+  webhookSubscriptions,
+} from "./webhook-sources.ts";
+
+export type RemovalFailure = "authored" | "provider" | "oauth" | "storage";
+const Authorization = Schema.Struct({ authorizationUrl: Schema.String });
+
+/** Valid registrations fail later at a real provider or retained credential boundary. */
+export const webhookRemovalFixture = (kind: RemovalFailure) =>
+  Effect.gen(function* () {
+    const provider = yield* webhookRegistrationFixture;
+    const issuer = yield* oauthSetupIssuer;
+    const http = yield* HttpClient.HttpClient;
+    yield* provider.fail;
+    yield* issuer.configure({ refreshTokens: true, expiresIn: 20 });
+    const declaration =
+      kind === "oauth"
+        ? `defineProvider({ name: "Removal service", auth: { oauth: oauth2({ discover: ${JSON.stringify(`${issuer.origin}/mcp`)} }) } })`
+        : keyProvider("Removal service");
+    const unregister =
+      kind === "authored" || kind === "provider"
+        ? `const response = await ctx.fetch(${JSON.stringify(provider.url)}, { method: "POST" });
+        if (!response.ok) throw ${kind === "provider" ? 'new ProviderError({ reason: "unavailable", status: response.status, accountId: ctx.user.accounts.service.id })' : 'new Error("Synthetic removal failure")'};`
+        : "";
+    const source = `import { defineApp, defineProvider, secrets, object, string, oauth2, router, ProviderError } from "apps";
+const service = ${declaration};
+export default defineApp({ user: { accounts: { service } } }, { tools: router({}), webhooks: {
+  incoming: { account: { user: "service" }, config: object({}), state: object({}),
+    register: async () => ({}), unregister: async ctx => { ${unregister} },
+    handle: async () => new Response("ok") }
+} });`;
+    const f = yield* appLinksFixture([{ path: "index.ts", content: source }]);
+    const { api, actors, prefix, path } = f;
+    const connect = (account?: string) =>
+      Effect.gen(function* () {
+        const connection = yield* body(
+          Resource,
+          yield* api.request(
+            actors.owner,
+            "POST",
+            connectionsPath(path, "user", "service"),
+            account === undefined ? {} : { account },
+          ),
+        );
+        if (kind !== "oauth") {
+          const saved = yield* api.request(
+            actors.owner,
+            "POST",
+            `${prefix}/connections/${connection.id}/submit`,
+            { method: "key", label: "Synthetic removal account", fields: { token: "synthetic" } },
+          );
+          expect(saved.status, JSON.stringify(saved.body)).toBe(200);
+          return (yield* body(Resource, saved)).id;
+        }
+        const started = yield* api.request(
+          actors.owner,
+          "POST",
+          `${prefix}/connections/${connection.id}/oauth/start`,
+          { method: "oauth", label: "Synthetic removal account" },
+        );
+        expect(started.status, JSON.stringify(started.body)).toBe(200);
+        const authorization = yield* body(Authorization, started);
+        const callbackUrl = yield* Effect.scoped(
+          Effect.gen(function* () {
+            const consent = yield* HttpClient.withScope(http).get(authorization.authorizationUrl);
+            expect(consent.status).toBe(302);
+            const location = consent.headers.location;
+            if (location === undefined)
+              return yield* Effect.die("Missing synthetic OAuth callback");
+            return location;
+          }),
+        ).pipe(Effect.provideService(FetchHttpClient.RequestInit, { redirect: "manual" }));
+        const completed = yield* api.request(
+          actors.owner,
+          "POST",
+          `${prefix}/connections/${connection.id}/oauth/complete`,
+          { callbackUrl },
+        );
+        expect(completed.status, JSON.stringify(completed.body)).toBe(200);
+        return (yield* body(Resource, completed)).id;
+      });
+    const account = yield* connect();
+    yield* f.saved(actors.owner, account);
+    const unlink = api.request(
+      actors.owner,
+      "DELETE",
+      `${requirementPath(path, "user", "service")}/${account}`,
+    );
+    let broken = false;
+    const recover = Effect.gen(function* () {
+      yield* provider.recover;
+      yield* issuer.configure({ tokenError: null });
+      if (broken) {
+        expect(yield* connect(account)).toBe(account);
+        broken = false;
+      }
+    });
+    // Cleanup repairs the injected fault even when the regression assertion fails.
+    yield* Effect.addFinalizer(() =>
+      Effect.gen(function* () {
+        yield* recover;
+        yield* unlink;
+        const hooks = yield* webhookSubscriptions(actors.owner, path);
+        for (const hook of hooks)
+          if (hook.status !== "stopped")
+            yield* api.request(actors.owner, "DELETE", `${path}/webhooks/${hook.id}`);
+        yield* settleWebhookSubscriptions(actors.owner, path, (hooks) =>
+          hooks.every((hook) => hook.status === "stopped"),
+        );
+      }).pipe(Effect.orDie),
+    );
+    yield* settleWebhookSources(
+      actors.owner,
+      path,
+      sourcesAre({ [account]: { status: "ready", failure: null } }),
+    );
+    const hooks = yield* webhookSubscriptions(actors.owner, path);
+    expect(hooks).toHaveLength(1);
+    const hook = hooks[0]!;
+    expect(hook.status).toBe("active");
+    const fail = Effect.gen(function* () {
+      if (kind === "oauth") {
+        broken = true;
+        yield* issuer.configure({
+          tokenError: { status: 400, body: { error: "invalid_grant" } },
+        });
+      }
+      if (kind === "storage") {
+        broken = true;
+      }
+    });
+    return { ...f, account, hook, fail, recover, unlink, removalRequests: provider.requests };
+  });
diff --git a/e2e/support/webhook-removal-case.ts b/e2e/support/webhook-removal-case.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/webhook-removal-case.ts
@@ -0,0 +1,117 @@
+import { expect } from "@effect/vitest";
+import { Clock, Effect, Schedule, Schema } from "effect";
+import { body } from "./api.ts";
+import { Evidence, Telemetry } from "./evidence.ts";
+import type { webhookRemovalFixture, RemovalFailure } from "./webhook-removal-fixture.ts";
+import { settleWebhookSources, settleWebhookSubscriptions, sourcesAre } from "./webhook-sources.ts";
+
+const Subscription = Schema.Struct({
+  id: Schema.String,
+  status: Schema.String,
+  failure: Schema.NullOr(Schema.String),
+});
+export const removalRecovery = <A, E, R>(
+  kind: RemovalFailure,
+  f: Effect.Success<ReturnType<typeof webhookRemovalFixture>>,
+  beforeThird: Effect.Effect<A, E, R>,
+) =>
+  Effect.gen(function* () {
+    const { api, actors, prefix, app, path, account, hook } = f;
+    const evidence = yield* Evidence;
+    const telemetry = yield* Telemetry;
+    const endpoint = `${path}/webhooks/${hook.id}`;
+    const attempts: Array<typeof Subscription.Type> = [];
+    yield* f.fail;
+    for (const expected of ["stopping", "stopping", "disabled"]) {
+      // The count must survive a process restart rather than start a fresh retry budget.
+      if (attempts.length === 2) yield* beforeThird;
+      const response = yield* api.request(actors.owner, "DELETE", endpoint);
+      expect(response.status, JSON.stringify(response.body)).toBe(200);
+      const result = yield* body(Subscription, response);
+      attempts.push(result);
+      yield* evidence.json("webhook-removal-attempts.json", { kind, attempts });
+      expect(result).toMatchObject({ id: hook.id, status: expected, failure: "unregister" });
+    }
+    if (kind === "authored" || kind === "provider") {
+      // Re-saving the same source exercises managed creation with the disabled key.
+      const configured = yield* api.request(
+        actors.owner,
+        "PUT",
+        `${path}/webhook-sources/${account}/config`,
+        { config: {} },
+      );
+      expect(configured.status, JSON.stringify(configured.body)).toBe(200);
+      yield* settleWebhookSources(
+        actors.owner,
+        path,
+        sourcesAre({
+          [account]: { status: "failed", failure: "registration" },
+        }),
+      );
+      expect(yield* f.removalRequests).toBe(3);
+    }
+    // Unlinking cannot discard a registration the provider may still hold.
+    const unlinkStarted = yield* Clock.currentTimeMillis;
+    expect((yield* f.unlink).status).toBe(200);
+    if (kind === "authored" || kind === "provider") {
+      // Observe the source pass caused by this unlink before checking it sent no fourth request.
+      yield* telemetry
+        .search("sdk.webhooks.reconcileSource", {
+          "executor.app.id": app.id,
+          "executor.account.id": account,
+        })
+        .pipe(
+          Effect.repeat({
+            schedule: Schedule.spaced("100 millis"),
+            until: (result) =>
+              result.data.some(({ span }) => Date.parse(span.startTime) >= unlinkStarted),
+          }),
+        );
+      expect(yield* f.removalRequests).toBe(3);
+    }
+    const protectedAccount = yield* api.request(
+      actors.owner,
+      "DELETE",
+      `${prefix}/accounts/${account}`,
+    );
+    expect(protectedAccount.status, JSON.stringify(protectedAccount.body)).toBe(409);
+    expect(protectedAccount.body).toMatchObject({ _tag: "AccountWebhooksActive" });
+    const setup = yield* api.request(
+      actors.owner,
+      "GET",
+      `${prefix}/webhook-setup/${app.id}/${hook.id}`,
+    );
+    expect(setup.status, JSON.stringify(setup.body)).toBe(200);
+    expect(setup.body).toMatchObject({
+      step: "remove",
+      subscription: { id: hook.id, status: "disabled" },
+    });
+    if (kind === "authored") {
+      // A person confirms cleanup at the provider; confirmation releases the dependency.
+      const confirmed = yield* api.request(actors.owner, "POST", `${endpoint}/confirm-removal`);
+      expect(confirmed.status, JSON.stringify(confirmed.body)).toBe(200);
+      expect(confirmed.body).toMatchObject({ id: hook.id, status: "stopped", failure: null });
+    } else {
+      yield* f.recover;
+      const resumed = yield* api.request(actors.owner, "POST", `${endpoint}/reconcile`);
+      expect(resumed.status, JSON.stringify(resumed.body)).toBe(200);
+      expect(resumed.body).toMatchObject({ id: hook.id, status: "stopped", failure: null });
+    }
+    yield* f.recover;
+    yield* f.unlink;
+    yield* settleWebhookSubscriptions(actors.owner, path, (hooks) =>
+      hooks.every((hook) => hook.status === "stopped"),
+    );
+    const releasedAccount = yield* api.request(
+      actors.owner,
+      "DELETE",
+      `${prefix}/accounts/${account}`,
+    );
+    expect(releasedAccount.status, JSON.stringify(releasedAccount.body)).toBe(200);
+    yield* evidence.json("webhook-removal-recovered.json", {
+      kind,
+      terminalAfter: attempts.length,
+      manualConfirmation: kind === "authored",
+      recoveredSubscription: hook.id,
+    });
+  });
diff --git a/e2e/tests/webhook-removal-recovery.spec.ts b/e2e/tests/webhook-removal-recovery.spec.ts
new file mode 100644
