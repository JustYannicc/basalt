+++ b/e2e/tests/webhook-removal-recovery.spec.ts
@@ -0,0 +1,25 @@
+import { layer } from "@effect/vitest";
+import { Effect } from "effect";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { webhookRemovalFixture } from "../support/webhook-removal-fixture.ts";
+import { removalRecovery } from "../support/webhook-removal-case.ts";
+import { scenarios } from "../test-plan.ts";
+
+const cases = [
+  ["authored", scenarios.webhookRemovalAuthored],
+  ["provider", scenarios.webhookRemovalProvider],
+  ["oauth", scenarios.webhookRemovalReconnect],
+] as const;
+
+layer(HostedLive, { excludeTestServices: true })("Webhook removal recovery", (it) => {
+  for (const [kind, plan] of cases)
+    it.effect(plan.title, (context) =>
+      withHostedCase(
+        context,
+        Effect.gen(function* () {
+          const f = yield* webhookRemovalFixture(kind);
+          yield* removalRecovery(kind, f, Effect.void);
+        }),
+      ),
+    );
+});
