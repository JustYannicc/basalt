+import { layer } from "@effect/vitest";
+import { Effect } from "effect";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { serverControl } from "../support/server-control.ts";
+import { webhookRemovalFixture } from "../support/webhook-removal-fixture.ts";
+import { removalRecovery } from "../support/webhook-removal-case.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Webhook removal storage recovery", (it) => {
+  it.effect(scenarios.webhookRemovalUnreadable.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* webhookRemovalFixture("storage");
+        yield* f.fail;
+        yield* legacyStorage([
+          {
+            sql: "update executor_accounts set encrypted_credentials=decode('123456','hex') where id=$1",
+            params: [f.account],
+          },
+        ]);
+        yield* serverControl("start");
+        yield* removalRecovery("storage", f, serverControl("restart"));
+      }),
+    ),
+  );
+});
