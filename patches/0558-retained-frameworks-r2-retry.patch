@@ -0,0 +1,172 @@
+import { Clock, Context, Effect, Random, Schema } from "effect";
+import { ProductionOperationRefused } from "./contracts.ts";
+
+export const productionOperationTimeoutMs = 25_000;
+
+export const retainedFrameworkReadBounds = {
+  attempts: 3,
+  attemptMs: 3000,
+  inventoryMs: 18_000,
+  responseReserveMs: 2000,
+} as const;
+
+/** SQL may contain several bounded statements. Reserve response time from the whole operation. */
+export const retainedFrameworkReadBudget = (operationStartedAt: number) =>
+  Clock.currentTimeMillis.pipe(
+    Effect.map((now) =>
+      Math.max(
+        0,
+        Math.min(
+          retainedFrameworkReadBounds.inventoryMs,
+          productionOperationTimeoutMs -
+            (now - operationStartedAt) -
+            retainedFrameworkReadBounds.responseReserveMs,
+        ),
+      ),
+    ),
+  );
+
+const Count = (maximum: number) => Schema.Int.check(Schema.isBetween({ minimum: 0, maximum }));
+export const RetainedFrameworkReadWork = Schema.Struct({
+  references: Count(2001),
+  builds: Count(2000),
+  metadataAttempts: Count(9),
+  metadataPages: Count(3),
+  metadataObjects: Count(3000),
+  recordAttempts: Count(12000),
+  completedBuilds: Count(2000),
+});
+export type RetainedFrameworkReadWork = {
+  -readonly [
+    K in keyof typeof RetainedFrameworkReadWork.Type
+  ]: (typeof RetainedFrameworkReadWork.Type)[K];
+};
+
+export const RetainedFrameworkReadDiagnostic = Schema.Struct({
+  objectClass: Schema.Literals([
+    "references",
+    "framework_metadata",
+    "split_record",
+    "legacy_record",
+  ]),
+  readPhase: Schema.Literals(["validate", "list", "read", "project"]),
+  elapsedMs: Schema.Int.check(Schema.isBetween({ minimum: 0, maximum: 86_400_000 })),
+  work: RetainedFrameworkReadWork,
+});
+export type RetainedFrameworkReadDiagnostic = typeof RetainedFrameworkReadDiagnostic.Type;
+
+export class RetainedFrameworkReadRefused extends ProductionOperationRefused {
+  readonly diagnostic: RetainedFrameworkReadDiagnostic;
+  constructor(message: string, diagnostic: RetainedFrameworkReadDiagnostic) {
+    super({ message });
+    this.diagnostic = diagnostic;
+  }
+}
+
+export interface RetainedFrameworkReadProgress {
+  objectClass: RetainedFrameworkReadDiagnostic["objectClass"];
+  readPhase: RetainedFrameworkReadDiagnostic["readPhase"];
+  work: RetainedFrameworkReadWork;
+}
+export const RetainedFrameworkReadProgress = Context.Service<RetainedFrameworkReadProgress>(
+  "production-ops/RetainedFrameworkReadProgress",
+);
+
+/** One phase owns its deadline and counters; retries never create a new phase or shared state. */
+export const withRetainedFrameworkReadBudget = <A, E, R>(
+  budgetMs: number,
+  read: (progress: RetainedFrameworkReadProgress) => Effect.Effect<A, E, R>,
+) =>
+  Effect.gen(function* () {
+    const startedAt = yield* Clock.currentTimeMillis;
+    const progress: RetainedFrameworkReadProgress = {
+      objectClass: "references",
+      readPhase: "validate",
+      work: {
+        references: 0,
+        builds: 0,
+        metadataAttempts: 0,
+        metadataPages: 0,
+        metadataObjects: 0,
+        recordAttempts: 0,
+        completedBuilds: 0,
+      },
+    };
+    return yield* read(progress).pipe(
+      Effect.timeout(Math.max(0, Math.min(retainedFrameworkReadBounds.inventoryMs, budgetMs))),
+      Effect.catchTag("TimeoutError", () =>
+        Effect.fail(new ProductionOperationRefused({ message: "Retained frameworks: time bound" })),
+      ),
+      Effect.catch((error) =>
+        error instanceof ProductionOperationRefused
+          ? Clock.currentTimeMillis.pipe(
+              Effect.flatMap((now) =>
+                Effect.fail(
+                  new RetainedFrameworkReadRefused(error.message, {
+                    objectClass: progress.objectClass,
+                    readPhase: progress.readPhase,
+                    elapsedMs: Math.min(86_400_000, Math.max(0, now - startedAt)),
+                    work: { ...progress.work },
+                  }),
+                ),
+              ),
+            )
+          : Effect.fail(error),
+      ),
+      Effect.provideService(RetainedFrameworkReadProgress, progress),
+    );
+  });
+
+const transientTypes = new Set([
+  "TimeoutError",
+  "InternalServerError",
+  "BadGateway",
+  "ServiceUnavailable",
+  "GatewayTimeout",
+  "TooManyRequests",
+  "CloudflareRateLimited",
+  "Locked",
+]);
+const field = (value: unknown, name: string): unknown =>
+  typeof value === "object" && value !== null ? Reflect.get(value, name) : undefined;
+
+/** Native binding and stream adapters wrap errors; messages and paths never classify a retry. */
+function retryable(error: unknown): boolean {
+  for (let depth = 0; depth < 3; depth++) {
+    if (error instanceof ProductionOperationRefused) return false;
+    const tag = field(error, "_tag") ?? field(error, "name");
+    if (typeof tag === "string" && transientTypes.has(tag)) return true;
+    if (tag === "HttpClientError")
+      return field(field(error, "reason"), "_tag") === "TransportError";
+    if (tag !== "R2Error" && tag !== "UnknownError") return false;
+    error = field(error, "cause");
+  }
+  return false;
+}
+
+/** The caller keeps one inventory deadline and reserves bytes anew inside each body attempt. */
+export const retryRetainedFrameworkRead = <A, E, R>(
+  work: Effect.Effect<A, E, R>,
+  onAttempt?: () => void,
+) =>
+  Effect.gen(function* () {
+    for (let attempt = 1; ; attempt++) {
+      onAttempt?.();
+      const result = yield* work.pipe(
+        Effect.timeout(retainedFrameworkReadBounds.attemptMs),
+        Effect.match({
+          onSuccess: (value) => ({ ok: true as const, value }),
+          onFailure: (error) => ({ ok: false as const, error }),
+        }),
+      );
+      if (result.ok) return result.value;
+      if (attempt === retainedFrameworkReadBounds.attempts || !retryable(result.error))
+        return yield* field(result.error, "_tag") === "TimeoutError"
+          ? Effect.fail(
+              new ProductionOperationRefused({ message: "Retained frameworks: read timeout" }),
+            )
+          : Effect.fail(result.error);
+      const jitter = yield* Random.next;
+      yield* Effect.sleep(Math.floor(100 * 2 ** (attempt - 1) * (1 + jitter * 0.2)));
+    }
+  });
