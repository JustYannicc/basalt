new file mode 100644
index 0000000..52ad760
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-account-recovery.ts
@@ -0,0 +1,69 @@
+import { StorageError } from "@executor-js/sdk/core";
+import { Effect, Option, Schema } from "effect";
+import type { HostManagedRecoveryInput } from "../contracts/host-managed-accounts.ts";
+import { catalogAppJobPrefix } from "../contracts/catalog-app-updates.ts";
+import { poolRotationJobPrefix } from "../contracts/pool-defaults.ts";
+import { usableAppLinks } from "./resource-policy.ts";
+import { PoolRecords } from "./pool-records.ts";
+
+/** Called under the app/link and organization access locks, so concurrent views share one job. */
+export const poolAccountRecovery =
+  (enabled: boolean) =>
+  ({ sql, organization, app, requirement }: HostManagedRecoveryInput) =>
+    Effect.gen(function* () {
+      const required = app.requirements.accounts[requirement];
+      if (
+        !enabled ||
+        requirement !== "pool" ||
+        app.activeVersion === null ||
+        required === undefined ||
+        required.scope !== "app" ||
+        required.cardinality !== "one" ||
+        required.definition.auth.token?.type !== "secrets"
+      )
+        return undefined;
+      const rows =
+        yield* sql`select coalesce(metadata::jsonb -> 'basaltPools', '{}'::jsonb) as pools
+        from organization where id = ${organization}`;
+      if (rows.length !== 1) return undefined;
+      // Setup decodes the whole map, so a malformed sibling would also prevent a repair.
+      const state = yield* Schema.decodeUnknownEffect(PoolRecords)(rows[0]).pipe(Effect.option);
+      if (Option.isNone(state)) return undefined;
+      const owners = Object.entries(state.value.pools).filter(([, pool]) => pool.app === app.id);
+      const owner = owners[0]?.[0];
+      if (owners.length !== 1 || owner === undefined) return undefined;
+      const members =
+        yield* sql`select m.id from member m join "user" person on person.id = m."userId"
+        where m."organizationId" = ${organization} and m."userId" = ${owner}
+          and m.role = 'owner' and person."emailVerified" = true`;
+      if (members.length !== 1) return undefined;
+      const linked = yield* sql`select a.id from ${usableAppLinks(sql, [app.id])}
+        and l.requirement = 'pool' and a.provider = ${required.provider} and a.method = 'token'
+        and p.kind = 'personal' and p.personal_user_id = ${owner} limit 1`;
+      if (linked.length > 0) return undefined;
+      // A running job may already have passed pool setup. Keep one queued successor.
+      const pending = yield* sql`select id from hosted_provisioning
+        where kind = 'member' and organization_id = ${organization} and user_id = ${owner}
+          and status = 'queued'
+          and id not like ${poolRotationJobPrefix + "%"}
+          and id not like ${catalogAppJobPrefix + "%"}
+        order by available_at, id limit 1 for update`;
+      if (pending.length === 0) {
+        // Match the worker's maximum backoff before another view can retry exhausted setup.
+        const failed = yield* sql`select id from hosted_provisioning
+          where kind = 'member' and organization_id = ${organization} and user_id = ${owner}
+            and status = 'failed' and updated_at > now() - interval '5 minutes'
+            and id not like ${poolRotationJobPrefix + "%"}
+            and id not like ${catalogAppJobPrefix + "%"} limit 1`;
+        if (failed.length > 0) return undefined;
+        yield* sql`insert into hosted_provisioning (kind, organization_id, user_id, available_at)
+          values ('member', ${organization}, ${owner}, now())`;
+      } else
+        yield* sql`update hosted_provisioning set available_at = least(available_at, now()), updated_at = now()
+          where id = ${pending[0]!.id} and attempts = 0`;
+      return "restoring" as const;
+    }).pipe(
+      Effect.catchTags({
+        SqlError: () => new StorageError(),
+      }),
+    );
