+++ b/e2e/tests/native-account-create-before-link.spec.ts
@@ -0,0 +1,162 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { providerAccountBackend } from "../support/provider-account-backend.ts";
+import { providerAccountProduct } from "../support/provider-account-product.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+const source = `import { defineApp, defineProvider, object, query, router, secrets, string } from "apps";
+const jev = defineProvider({ name: "Jev", hosts: ["api.typesafe.ai"], auth: {
+  apiKey: secrets({ label: "TypeSafe API key", fields: object({ token: string({ minLength: 1 }) }) }) } });
+export default defineApp({ app: { accounts: { jev: jev.many() } } }, { tools: router({
+  present: query({ input: object({}) }, async (ctx) => ctx.app.accounts.jev.map(a => ({ id: a.id, method: a.method, fields: Object.keys(a.fields) })))
+}) });`;
+const Revision = Schema.Struct({ revision: Schema.String });
+
+layer(RuntimeLive, { excludeTestServices: true })("Native token creation before linking", (it) => {
+  it.effect(scenarios.nativeAccountCreateBeforeLink.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          backend = yield* providerAccountBackend;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const apps: string[] = [],
+          accounts: string[] = [];
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* serverControl("start");
+            for (const app of apps)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app}`);
+            for (const account of accounts)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`);
+          }).pipe(Effect.orDie),
+        );
+        const deploy = (name: string) =>
+          Effect.gen(function* () {
+            const response = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+              name,
+              files: [{ path: "index.ts", content: source }, appsManifest],
+            });
+            expect(response.status, JSON.stringify(response.body)).toBe(200);
+            const app = yield* body(Resource, response);
+            apps.push(app.id);
+            const path = `${prefix}/apps/${app.id}`;
+            const access = yield* body(
+              Revision,
+              yield* api.request(actors.owner, "GET", `${path}/access`),
+            );
+            expect(
+              (yield* api.request(actors.owner, "PATCH", `${path}/access`, {
+                revision: access.revision,
+                audience: { kind: "everyone" },
+              })).status,
+            ).toBe(200);
+            return { id: app.id, path };
+          });
+        const first = yield* deploy("First native token pool"),
+          second = yield* deploy("Second native token pool");
+        // Native activation has no public UI yet. Only this scenario's organization is opted in.
+        yield* legacyStorage([
+          {
+            sql: "update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb), '{basaltPools}', $1::jsonb)::text where id = $2",
+            params: [
+              JSON.stringify({
+                first: { app: first.id, membership: "executor-links-v1" },
+                second: { app: second.id, membership: "executor-links-v1" },
+              }),
+              actors.organization.id,
+            ],
+          },
+        ]);
+        yield* providerAccountProduct(backend.origin);
+        const requirement = `${first.path}/accounts/app/jev`;
+        const pending = yield* api.request(actors.owner, "POST", `${requirement}/connections`, {});
+        expect(pending.status, JSON.stringify(pending.body)).toBe(200);
+        const connection = yield* body(Resource, pending);
+        const oldSubmit = yield* api.request(
+          actors.owner,
+          "POST",
+          `${prefix}/connections/${connection.id}/submit`,
+          {
+            method: "apiKey",
+            fields: { token: "synthetic-old-submit-must-not-save" },
+          },
+        );
+        expect(oldSubmit.status, JSON.stringify(oldSubmit.body)).toBe(409);
+        expect(JSON.stringify(oldSubmit.body)).toContain("AccountLinkRequired");
+        expect(yield* backend.calls).toHaveLength(0);
+        expect(
+          (yield* api.request(actors.owner, "GET", `${first.path}/accounts/app`)).body,
+        ).toEqual([]);
+
+        const payload = {
+          creation: crypto.randomUUID(),
+          method: "apiKey",
+          fields: { token: "synthetic-new-native-token" },
+        };
+        expect((yield* api.request(actors.member, "POST", requirement, payload)).status).toBe(403);
+        const created = yield* api.request(actors.owner, "POST", requirement, payload);
+        expect(created.status, JSON.stringify(created.body)).toBe(200);
+        const account = (yield* body(Resource, created)).id;
+        accounts.push(account);
+        expect(JSON.stringify(created.body)).not.toContain(payload.fields.token);
+        expect(yield* backend.calls).toHaveLength(0);
+        const link = (path: string) =>
+          api.request(actors.owner, "PUT", `${path}/accounts/app/jev/${account}`);
+        yield* backend.failAfterAccept;
+        const failed = yield* link(first.path);
+        expect(failed.status, JSON.stringify(failed.body)).toBe(503);
+        expect(
+          (yield* api.request(actors.owner, "GET", `${prefix}/accounts/${account}`)).status,
+        ).toBe(200);
+        for (const app of [first, second])
+          expect(
+            (yield* api.request(actors.owner, "GET", `${app.path}/accounts/app`)).body,
+          ).toEqual([]);
+        const firstAttempt = yield* backend.calls;
+        expect(firstAttempt).toHaveLength(1);
+        expect(firstAttempt[0]).toMatchObject({ type: "typesafe", token: payload.fields.token });
+        expect(yield* backend.references).toContain(firstAttempt[0]!.reference);
+
+        const retriedCreate = yield* api.request(actors.owner, "POST", requirement, {
+          ...payload,
+          fields: { token: "synthetic-retry-must-not-replace" },
+        });
+        expect(retriedCreate.status, JSON.stringify(retriedCreate.body)).toBe(200);
+        expect((yield* body(Resource, retriedCreate)).id).toBe(account);
+        expect((yield* link(first.path)).status).toBe(200);
+        expect(yield* backend.calls).toEqual([firstAttempt[0], firstAttempt[0]]);
+        expect((yield* link(second.path)).status).toBe(200);
+        expect(yield* backend.calls).toHaveLength(2);
+        expect(
+          (yield* api.request(actors.owner, "DELETE", `${first.path}/accounts/app/jev/${account}`))
+            .status,
+        ).toBe(200);
+        expect((yield* api.request(actors.owner, "DELETE", first.path)).status).toBe(200);
+        expect(
+          (yield* api.request(actors.owner, "GET", `${prefix}/accounts/${account}`)).status,
+        ).toBe(200);
+        expect(
+          (yield* api.request(actors.owner, "GET", `${second.path}/accounts/app`)).body,
+        ).toMatchObject([{ requirement: "jev", account: { id: account } }]);
+        const used = yield* api.request(actors.owner, "POST", `${second.path}/tools/call`, {
+          tool: "present",
+          kind: "query",
+          input: {},
+        });
+        expect(used.status, JSON.stringify(used.body)).toBe(200);
+        expect(used.body).toEqual([{ id: account, method: "apiKey", fields: ["token"] }]);
+        expect(yield* backend.references).toContain(firstAttempt[0]!.reference);
+      }),
+    ),
+  );
+});
