@@ -0,0 +1,72 @@
+import {
+  AccountId,
+  AccountFieldsInvalid,
+  AccountProvisioned,
+  AccountSiteInvalid,
+  AuthMethodInvalid,
+  type AccountScope,
+  type AppId,
+} from "@executor-js/sdk/core";
+import { Effect } from "effect";
+import { HostedExecutor } from "../contracts/executor.ts";
+import { RequirementMismatch, type CreateRequirementAccount } from "../contracts/app-accounts.ts";
+import { currentOwner } from "./access.ts";
+import { checkDestination } from "./connection-policy.ts";
+import { requireAppAccess, requireAccountAccess } from "./resource-policy.ts";
+import { accountDestination } from "./resource-lifecycle.ts";
+
+/** Creation commits before a native pool's appLink performs any backend mirroring. */
+export const createRequirementAccount = (
+  scope: AccountScope,
+  input: { readonly app: AppId; readonly requirement: string },
+  payload: typeof CreateRequirementAccount.Type,
+) =>
+  Effect.gen(function* () {
+    const owner = yield* currentOwner;
+    yield* requireAppAccess(input.app, scope === "app" ? "manage" : "use");
+    const executor = yield* Effect.flatten(HostedExecutor);
+    const app = yield* executor.apps.get({ owner, app: input.app });
+    const requirement = Object.hasOwn(app.requirements.accounts, input.requirement)
+      ? app.requirements.accounts[input.requirement]
+      : undefined;
+    if (requirement === undefined || requirement.scope !== scope)
+      return yield* new RequirementMismatch({ ...input, scope, reason: "requirement" });
+    const method = Object.hasOwn(requirement.definition.auth, payload.method)
+      ? requirement.definition.auth[payload.method]
+      : undefined;
+    if (method?.type !== "secrets")
+      return yield* new AuthMethodInvalid({
+        provider: requirement.provider,
+        method: payload.method,
+      });
+    if (method.provisioned === true)
+      return yield* new AccountProvisioned({ provider: requirement.provider });
+    // Per-site providers need the existing connection flow's URL policy and saved site binding.
+    if (requirement.definition.site !== undefined)
+      return yield* new AccountSiteInvalid({ ...input, reason: "required" });
+    const destination = payload.destination ?? { kind: "personal" as const };
+    yield* checkDestination(destination);
+    const id = AccountId.make(`acc_${payload.creation.toLowerCase()}`);
+    const existing = yield* executor.accounts
+      .get({ owner, account: id })
+      .pipe(Effect.catchTag("AccountNotFound", () => Effect.succeed(undefined)));
+    if (existing !== undefined) {
+      yield* requireAccountAccess(id, "manage");
+      if (existing.provider !== requirement.provider || existing.method !== payload.method)
+        return yield* new AccountFieldsInvalid({
+          provider: requirement.provider,
+          method: payload.method,
+        });
+      return existing;
+    }
+    return yield* executor.managedAccounts
+      .add({
+        id,
+        owner,
+        provider: requirement.provider,
+        method: payload.method,
+        fields: payload.fields,
+        ...(payload.label === undefined ? {} : { label: payload.label }),
+      })
+      .pipe(accountDestination(destination));
+  });
