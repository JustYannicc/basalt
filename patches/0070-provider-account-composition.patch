@@ -0,0 +1,107 @@
+import {
+  accountAcquisitionDriver,
+  AccountAcquisitionUnavailable,
+  identifyProvider,
+  type AccountAcquisitionContext,
+  type AccountAcquisitionRegistration,
+} from "@executor-js/sdk/core";
+import { providerDeclaration } from "apps/host";
+import { InteractiveStart, InteractiveStatus } from "apps/contracts";
+import { Crypto, Effect, Option, Redacted, Schema } from "effect";
+import { providers } from "./pool-provider-definitions.ts";
+import { providerCapabilities } from "./pool-provider-capabilities.ts";
+import {
+  accountAcquisitionPath,
+  accountAcquisitionPrefix,
+} from "./pool-account-acquisition-contract.ts";
+import { signEnvelope } from "./pool-token.ts";
+import { homeAccountKeyMirror } from "./account-key-mirror.ts";
+
+/** Registration is host-owned; an app can request a canonical method, never a driver or URL. */
+export const poolAccountAcquisition = (
+  key: Option.Option<Redacted.Redacted<string>>,
+  origin: string,
+) =>
+  Effect.gen(function* () {
+    if (Option.isNone(key)) return { registrations: [] };
+    const secret = key.value;
+    const crypto = yield* Crypto.Crypto;
+    const registrations: AccountAcquisitionRegistration[] = [];
+    for (const capability of providerCapabilities) {
+      if (capability.connection === "unavailable") continue;
+      const definition = yield* providerDeclaration(providers[capability.lab]);
+      const identified = yield* identifyProvider(definition, crypto);
+      const send = async (
+        context: AccountAcquisitionContext,
+        action: string,
+        input: Record<string, unknown> = {},
+      ) => {
+        const at = Date.now();
+        const envelope = await signEnvelope(Redacted.value(secret), accountAcquisitionPrefix, {
+          owner: context.owner,
+          operation: context.operation,
+          action,
+          provider: capability.backend,
+          at,
+          expiresAt: Math.min(context.deadline, at + 30_000),
+          ...input,
+        });
+        const response = await context.fetch(new URL(accountAcquisitionPath, origin), {
+          method: "POST",
+          signal: context.signal,
+          headers: { "content-type": "application/json" },
+          body: JSON.stringify({ envelope }),
+        });
+        if (!response.ok) {
+          await response.body?.cancel();
+          throw new Error("Account acquisition backend unavailable");
+        }
+        return await response.json();
+      };
+      const oauth = capability.connection === "home-oauth";
+      const mirror = homeAccountKeyMirror({
+        origin,
+        signingKey: secret,
+        credential: { type: "typesafe" },
+        fields: { token: "token" },
+      });
+      const driver = accountAcquisitionDriver({
+        id: "basalt-home",
+        revision: oauth ? "oauth-v1" : "key-mirror-v1",
+        start: async (context, reconnect) => {
+          if (!oauth) throw new Error("This account uses its saved API-key connection");
+          return Schema.decodeUnknownSync(InteractiveStart)(
+            await send(
+              context,
+              "start",
+              reconnect === undefined ? {} : { reconnect: Redacted.value(reconnect.reference) },
+            ),
+          );
+        },
+        status: async (context, input) =>
+          Schema.decodeUnknownSync(InteractiveStatus)(await send(context, "status", input)),
+        submit: async (context, input) =>
+          Schema.decodeUnknownSync(InteractiveStatus)(await send(context, "submit", input)),
+        cancel: async (context, input) => {
+          if (oauth) await send(context, "cancel", input);
+        },
+        remove: async (context) => {
+          if (oauth)
+            await send(context, "remove", { reference: Redacted.value(context.reference) });
+          else await mirror.remove(context);
+        },
+        ...(oauth ? {} : { mirror: mirror.mirror }),
+      });
+      // The previous label-sensitive identity can still name an account deployed by an older app.
+      for (const provider of new Set([identified.identity, identified.legacy]))
+        registrations.push({
+          provider,
+          method: capability.method,
+          current: true,
+          exposeHostReference: true,
+          driver,
+          fetch: globalThis.fetch,
+        });
+    }
+    return { registrations };
+  }).pipe(Effect.mapError(() => new AccountAcquisitionUnavailable({ reason: "registration" })));
