+/** External synthetic custodian can lose its reply after accepting the assigned credential. */
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Effect, Layer, Ref, Schema } from "effect";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { createHmac, timingSafeEqual } from "node:crypto";
+import { createServer } from "node:http";
+
+const Mirror = Schema.Struct({
+  reference: Schema.String,
+  action: Schema.Literals(["upsert", "remove"]),
+  at: Schema.Number,
+  expiresAt: Schema.Number,
+  credential: Schema.optionalKey(Schema.Struct({ type: Schema.String, token: Schema.String })),
+});
+
+export const providerAccountBackend = Effect.gen(function* () {
+  const calls = yield* Ref.make<readonly { reference: string; type: string; token: string }[]>([]);
+  const references = yield* Ref.make<ReadonlySet<string>>(new Set());
+  const failNext = yield* Ref.make(false);
+  const routes = Layer.mergeAll(
+    HttpRouter.add(
+      "POST",
+      "/pool/v1/account-mirrors",
+      Effect.gen(function* () {
+        const { envelope } = yield* HttpServerRequest.schemaBodyJson(
+          Schema.Struct({ envelope: Schema.String }),
+        );
+        const [prefix, payload, signature, extra] = envelope.split(".");
+        if (
+          prefix !== "sbam1" ||
+          payload === undefined ||
+          signature === undefined ||
+          extra !== undefined
+        )
+          return HttpServerResponse.empty({ status: 401 });
+        const expected = createHmac("sha256", Buffer.from("ab".repeat(32), "hex"))
+          .update(`${prefix}.${payload}`)
+          .digest();
+        const actual = Buffer.from(signature, "base64url");
+        if (actual.byteLength !== expected.byteLength || !timingSafeEqual(actual, expected))
+          return HttpServerResponse.empty({ status: 401 });
+        const value = yield* Schema.decodeUnknownEffect(Mirror)(
+          JSON.parse(Buffer.from(payload, "base64url").toString()),
+        ).pipe(Effect.orDie);
+        if (
+          value.at > Date.now() ||
+          value.expiresAt <= Date.now() ||
+          value.expiresAt > value.at + 30_000
+        )
+          return HttpServerResponse.empty({ status: 401 });
+        if (value.action === "remove") {
+          yield* Ref.update(
+            references,
+            (items) => new Set([...items].filter((id) => id !== value.reference)),
+          );
+        } else {
+          if (value.credential === undefined) return HttpServerResponse.empty({ status: 400 });
+          const credential = value.credential;
+          yield* Ref.update(calls, (items) => [
+            ...items,
+            { reference: value.reference, ...credential },
+          ]);
+          yield* Ref.update(references, (items) => new Set([...items, value.reference]));
+          if (yield* Ref.getAndSet(failNext, false))
+            return HttpServerResponse.empty({ status: 503 });
+        }
+        return HttpServerResponse.empty({ status: 204 });
+      }),
+    ),
+    HttpRouter.add("POST", "/pool/v1/membership", Effect.succeed(HttpServerResponse.empty())),
+    HttpRouter.add("POST", "/pool/v1/access", Effect.succeed(HttpServerResponse.empty())),
+  );
+  const context = yield* Layer.build(
+    HttpRouter.serve(routes, { disableLogger: true, disableListenLog: true }).pipe(
+      Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 })),
+    ),
+  );
+  const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(context));
+  if (!("port" in server.address)) return yield* Effect.die("Expected TCP custodian fixture");
+  return {
+    origin: `http://127.0.0.1:${server.address.port}`,
+    calls: Ref.get(calls),
+    references: Ref.get(references),
+    failAfterAccept: Ref.set(failNext, true),
+  };
+});
