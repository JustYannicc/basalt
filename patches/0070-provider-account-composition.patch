@@ -0,0 +1,81 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect } from "effect";
+import { body } from "../support/api.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { acquisitionFixture } from "../support/account-acquisition-fixture.ts";
+import { linkAccount, unlinkAccount } from "../support/app-accounts.ts";
+import { Resource } from "../support/contracts.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(RuntimeLive, { excludeTestServices: true })("Saved accounts before linking", (it) => {
+  it.effect(scenarios.accountCreateBeforeLink.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* acquisitionFixture();
+        const first = yield* f.deploy("First token consumer", "app");
+        const second = yield* f.deploy("Second token consumer", "app");
+        const path = `${first.path}/accounts/app/identity`;
+        const payload = {
+          creation: crypto.randomUUID(),
+          method: "manual",
+          fields: { token: "synthetic-original-token" },
+        };
+        expect((yield* f.api.request(f.actors.member, "POST", path, payload)).status).toBe(403);
+        const created = yield* f.api.request(f.actors.owner, "POST", path, payload);
+        expect(created.status, JSON.stringify(created.body)).toBe(200);
+        const account = (yield* body(Resource, created)).id;
+        f.trackAccount(f.actors.owner, account);
+        expect(JSON.stringify(created.body)).not.toContain(payload.fields.token);
+        expect(
+          (yield* f.api.request(f.actors.owner, "GET", `${first.path}/accounts/app`)).body,
+        ).toEqual([]);
+
+        // A lost response can retry the same creation without replacing its saved credentials.
+        const repeated = yield* f.api.request(f.actors.owner, "POST", path, {
+          ...payload,
+          fields: { token: "synthetic-retry-must-not-replace" },
+        });
+        expect(repeated.status, JSON.stringify(repeated.body)).toBe(200);
+        expect((yield* body(Resource, repeated)).id).toBe(account);
+        yield* linkAccount(f.actors.owner, first.path, "identity", account, "app");
+        yield* linkAccount(f.actors.owner, second.path, "identity", account, "app");
+        yield* unlinkAccount(f.actors.owner, first.path, "identity", account, "app");
+        expect(
+          (yield* f.api.request(f.actors.owner, "GET", `${second.path}/accounts/app`)).body,
+        ).toMatchObject([{ requirement: "identity", account: { id: account } }]);
+        expect((yield* f.api.request(f.actors.owner, "DELETE", first.path)).status).toBe(200);
+        expect(
+          (yield* f.api.request(f.actors.owner, "GET", `${f.prefix}/accounts/${account}`)).status,
+        ).toBe(200);
+
+        const personalPayload = { ...payload, creation: crypto.randomUUID() };
+        const personal = yield* f.api.request(
+          f.actors.member,
+          "POST",
+          `${f.manager.path}/accounts/user/identity`,
+          personalPayload,
+        );
+        expect(personal.status, JSON.stringify(personal.body)).toBe(200);
+        const personalAccount = (yield* body(Resource, personal)).id;
+        f.trackAccount(f.actors.member, personalAccount);
+        expect(
+          (yield* f.api.request(f.actors.member, "GET", `${f.manager.path}/accounts/user`)).body,
+        ).toEqual([]);
+        expect(
+          (yield* f.api.request(
+            f.actors.owner,
+            "POST",
+            `${f.manager.path}/accounts/user/identity`,
+            personalPayload,
+          )).status,
+        ).toBe(403);
+        yield* linkAccount(f.actors.member, f.manager.path, "identity", personalAccount);
+        expect(
+          (yield* f.api.request(f.actors.member, "GET", `${f.manager.path}/accounts/user`)).body,
+        ).toMatchObject([{ requirement: "identity", account: { id: personalAccount } }]);
+      }),
+    ),
+  );
+});
