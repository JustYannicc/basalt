@@ -0,0 +1,26 @@
+import { StorageError, type AccountConnection } from "@executor-js/sdk/core";
+import { Effect } from "effect";
+import { AccountLinkRequired } from "../contracts/accounts.ts";
+import { policyDatabase } from "./resource-policy.ts";
+
+/** Native token creation must not reach the SDK's older create-and-link transaction. */
+export const requireSeparateNativeAccountLink = (connection: AccountConnection, method: string) =>
+  Effect.gen(function* () {
+    if (connection.reconnectAccount !== null) return;
+    const auth = connection.provider.definition.auth;
+    if (!Object.hasOwn(auth, method) || auth[method]?.type !== "secrets") return;
+    const sql = yield* policyDatabase;
+    const native = yield* sql`select 1 from organization o
+      cross join lateral jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) entry
+      join executor_apps a on a.id = entry.value ->> 'app' and a.owner = 'organization:' || o.id
+      join executor_deployments d on d.id = a.active_deployment
+      where 'organization:' || o.id = ${connection.owner}
+        and entry.value ->> 'app' = ${connection.target.app}
+        and entry.value ->> 'membership' = 'executor-links-v1'
+        and d.requirements::jsonb -> 'accounts' -> ${connection.target.requirement} ->> 'scope' = 'app' limit 1`;
+    if (native.length)
+      return yield* new AccountLinkRequired({
+        app: connection.target.app,
+        requirement: connection.target.requirement,
+      });
+  }).pipe(Effect.catchTag("SqlError", () => new StorageError()));
diff --git a/apps/hosted/server/src/implementation/requirement-account-creation.ts b/apps/hosted/server/src/implementation/requirement-account-creation.ts
