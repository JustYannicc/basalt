+++ b/e2e/support/provider-account-product.ts
@@ -0,0 +1,60 @@
+/** Supply the production provider registrations to the complete self-host product. */
+import { Effect, FileSystem, Path } from "effect";
+import { ChildProcess, ChildProcessSpawner } from "effect/process";
+import { Target } from "./platform.ts";
+import { serverControl } from "./server-control.ts";
+
+export const providerAccountProduct = (origin: string) =>
+  Effect.gen(function* () {
+    const target = yield* Target,
+      fs = yield* FileSystem.FileSystem,
+      path = yield* Path.Path;
+    const entry = path.join(target.directory, "provider-account-product.ts");
+    yield* fs.writeFileString(
+      entry,
+      `
+import * as NodeCrypto from "@effect/platform-node/NodeCrypto";
+import * as Runtime from "@effect/platform-bun/BunRuntime";
+import { main } from "@executor-js/hosted-self-host/server";
+import { poolAccountAcquisition } from "@executor-js/hosted-server/pool-account-acquisition";
+import { AccountAcquisitionConfiguration } from "@executor-js/sdk/core";
+import { Effect, Option, Redacted } from "effect";
+Runtime.runMain(Effect.gen(function* () {
+  const acquisition = yield* poolAccountAcquisition(Option.some(Redacted.make("ab".repeat(32))), ${JSON.stringify(origin)});
+  return yield* main.pipe(Effect.provideService(AccountAcquisitionConfiguration, acquisition));
+}).pipe(Effect.provide(NodeCrypto.layer)));
+`,
+    );
+    const links = path.join(target.directory, "node_modules", "@executor-js");
+    yield* fs.makeDirectory(links, { recursive: true });
+    const product = path.join(links, "hosted-self-host");
+    if (!(yield* fs.exists(product)))
+      yield* fs.symlink(path.resolve("apps/hosted/self-host"), product);
+    const config = path.join(target.directory, "provider-account-product.json");
+    yield* fs.writeFileString(
+      config,
+      JSON.stringify({
+        extends: path.resolve("tsconfig.json"),
+        compilerOptions: { typeRoots: [path.resolve("node_modules/@types")] },
+        files: [entry],
+        include: [],
+        exclude: [],
+      }),
+    );
+    const processes = yield* ChildProcessSpawner.ChildProcessSpawner;
+    const checked = yield* processes.exitCode(
+      ChildProcess.make(path.resolve("node_modules/.bin/tsc-rs"), ["--noEmit", "-p", config], {
+        stdout: "inherit",
+        stderr: "inherit",
+      }),
+    );
+    if (checked !== 0)
+      return yield* Effect.die("Provider registration product failed its public API typecheck");
+    yield* serverControl("stop");
+    yield* serverControl("environment", 200, {
+      EXECUTOR_E2E_PRODUCT_ENTRY: entry,
+      POOL_APP_SIGNING_KEY: "ab".repeat(32),
+      BASALT_POOL_ORIGIN: origin,
+    });
+    yield* serverControl("start");
+  });
