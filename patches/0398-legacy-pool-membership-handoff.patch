+import { Api, body } from "../support/api.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { scenarios } from "../test-plan.ts";
+
+const source = `import {defineApp,query,object,string,router} from "apps";
+export default defineApp({}, {tools:router({blocked:query({input:object({url:string()})}, async(ctx,{url})=>{
+  const response=await ctx.fetch(url);
+  return {status:response.status,body:await response.json()};
+})})});`;
+
+layer(RuntimeLive, { excludeTestServices: true })("Local Cloud app network", (it) => {
+  it.effect(scenarios.poolLocalEgress.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors;
+        const prefix = `/api/organizations/${actors.organization.id}/apps`;
+        const created = yield* api.request(actors.owner, "POST", `${prefix}/deploy`, {
+          name: "Local egress guard",
+          files: [{ path: "index.ts", content: source }, appsManifest],
+        });
+        expect(created.status, JSON.stringify(created.body)).toBe(200);
+        const app = yield* body(Schema.Struct({ id: Schema.String }), created);
+        // .invalid stays safe even if a regression removes the guard; no real service is contacted.
+        const result = yield* api.request(actors.owner, "POST", `${prefix}/${app.id}/tools/call`, {
+          tool: "blocked",
+          kind: "query",
+          input: { url: "https://e2e-blocked.invalid/must-not-leave-the-machine" },
+        });
+        expect(result.status, JSON.stringify(result.body)).toBe(200);
+        expect(result.body).toEqual({
+          status: 451,
