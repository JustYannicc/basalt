+          homeAccounts.map((account) => account.id).sort(),
+        );
+        expect(yield* home.members).toEqual(homeAccounts.map((account) => account.id).sort());
+        const registration = () =>
+          database.run({
+            sql: `select entry.value as registration from organization o cross join lateral jsonb_each(o.metadata::jsonb->'basaltPools') entry where o.id=$1 and entry.value->>'app'=$2`,
+            params: [actors.organization.id, pool.id],
+          });
+        const stableRegistration = yield* registration();
+        const writes = yield* home.writes;
+        expect((yield* read()).body).toMatchObject({ ok: true });
+        expect(yield* home.writes).toEqual(writes);
+        expect(yield* registration()).toEqual(stableRegistration);
+        expect(yield* links()).toEqual(beforeLinks);
+        expect(yield* controlState()).toEqual(beforeControl);
+
+        const usage = `${appPath}/pool-usage`;
+        const query = {
+          from: "2026-11-01T00:00:00Z",
+          to: "2026-11-02T00:00:00Z",
+          bucket: "day",
+          by: ["account"],
+        };
+        for (const account of accounts) {
+          const reset = yield* api.request(
+            actors.owner,
+            "GET",
+            `${prefix}/pools/${pool.id}/accounts/${account.id}/reset-attempt`,
+          );
+          expect(reset.status, JSON.stringify(reset.body)).toBe(200);
+          expect(reset.body).toBeNull();
+          for (const [route, input] of [
+            ["series", query],
+            ["last-success", {}],
+          ] as const) {
+            const response = yield* api.request(actors.owner, "POST", `${usage}/${route}`, {
+              ...input,
+              accounts: [account.id],
+            });
+            expect(response.status, JSON.stringify(response.body)).toBe(200);
+            expect(
+              (yield* api.request(actors.owner, "POST", `${usage}/${route}`, {
+                ...input,
+                accounts: [control],
+              })).status,
+            ).toBe(403);
+          }
+        }
+
+        // A failed selection handoff must roll back the saved link and its legacy marker together.
+        yield* legacy();
+        const refusal = (refused: boolean) =>
+          api.request(actors.owner, "POST", "/native-provider-fixture/membership-refusal", {
+            pool: pool.id,
+            refused,
+          });
+        expect((yield* refusal(true)).status).toBe(200);
+        const selection = `${appPath}/accounts/app/${accounts[0]!.requirement}/${accounts[0]!.id}`;
+        expect((yield* api.request(actors.owner, "DELETE", selection)).status).toBe(503);
+        expect(yield* links()).toEqual(beforeLinks);
+        expect(yield* home.writes).toEqual(writes);
+        expect((yield* refusal(false)).status).toBe(200);
+        expect((yield* api.request(actors.owner, "DELETE", selection)).status).toBe(200);
+        expect((yield* body(View, yield* read())).value.accounts).toHaveLength(3);
+        expect(yield* home.members).toHaveLength(3);
+        expect((yield* api.request(actors.owner, "PUT", selection)).status).toBe(200);
+        expect((yield* body(View, yield* read())).value.accounts).toHaveLength(4);
+        expect(yield* home.members).toEqual(homeAccounts.map((account) => account.id).sort());
+        expect(yield* links()).toEqual(beforeLinks);
+        expect(yield* controlState()).toEqual(beforeControl);
+      }),
+    ),
+  );
+});
