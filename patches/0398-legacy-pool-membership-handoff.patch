@@ -0,0 +1,104 @@
+import { Effect, Schema } from "effect";
+import {
+  FetchHttpClient,
+  HttpBody,
+  HttpClient,
+  HttpRouter,
+  HttpServerRequest,
+  HttpServerResponse,
+} from "effect/http";
+
+/** A scoped external-service route to the production Worker; it still authenticates every call. */
+export const poolProductPeer = Effect.gen(function* () {
+  const origins = new Map<string, string>();
+  const forward = (
+    pool: string,
+    path: string,
+    method: "GET" | "POST",
+    headers: Record<string, string>,
+    body?: string,
+  ) =>
+    Effect.gen(function* () {
+      const origin = origins.get(pool);
+      if (origin === undefined) return undefined;
+      const relative = new URL(path, "http://fixture.invalid");
+      const destination = new URL(relative.pathname + relative.search, origin).href;
+      const client = yield* HttpClient.HttpClient;
+      const response = yield* method === "GET"
+        ? client.get(destination, { headers })
+        : client.post(destination, { headers, body: HttpBody.text(body ?? "") });
+      const bytes = yield* response.arrayBuffer;
+      const forwardedHeaders = { ...response.headers };
+      // Fetch already decoded the response; its original wire encoding cannot describe these bytes.
+      delete forwardedHeaders["content-encoding"];
+      delete forwardedHeaders["content-length"];
+      delete forwardedHeaders["transfer-encoding"];
+      return HttpServerResponse.uint8Array(new Uint8Array(bytes), {
+        status: response.status,
+        headers: forwardedHeaders,
+      });
+    }).pipe(Effect.provide(FetchHttpClient.layer));
+  return {
+    forward,
+    configure: HttpRouter.add(
+      "POST",
+      "/native-provider-fixture/product-peer",
+      Effect.gen(function* () {
+        const input = yield* HttpServerRequest.schemaBodyJson(
+          Schema.Struct({
+            pool: Schema.String,
+            origin: Schema.NullOr(Schema.String),
+          }),
+        );
+        if (input.origin === null) {
+          origins.delete(input.pool);
+          return HttpServerResponse.jsonUnsafe({ configured: false });
+        }
+        const url = new URL(input.origin);
+        if (url.hostname !== "127.0.0.1") return HttpServerResponse.empty({ status: 400 });
+        origins.set(input.pool, url.origin);
+        return HttpServerResponse.jsonUnsafe({ configured: true });
+      }),
+    ),
+    control: HttpRouter.add(
+      "GET",
+      "/pool/v1/*",
+      Effect.gen(function* () {
+        const request = yield* HttpServerRequest.HttpServerRequest;
+        const token = /^Bearer (\S+)$/i.exec(request.headers.authorization ?? "")?.[1];
+        const encoded = token?.split(".")[1];
+        const claims =
+          encoded === undefined
+            ? undefined
+            : yield* Schema.decodeUnknownEffect(
+                Schema.fromJsonString(Schema.Struct({ pool: Schema.String })),
+              )(Buffer.from(encoded, "base64url").toString());
+        if (typeof claims?.pool !== "string") return HttpServerResponse.empty({ status: 401 });
+        return (
+          (yield* forward(claims.pool, request.url, "GET", request.headers)) ??
+          HttpServerResponse.empty({ status: 404 })
+        );
+      }),
+    ),
+    usage: HttpRouter.add(
+      "POST",
+      "/pool/v1/usage/*",
+      Effect.gen(function* () {
+        const request = yield* HttpServerRequest.HttpServerRequest;
+        const raw = yield* request.text;
+        const input = yield* Schema.decodeUnknownEffect(
+          Schema.fromJsonString(Schema.Struct({ envelope: Schema.String })),
+        )(raw);
+        const encoded = input.envelope.split(".")[1];
+        if (encoded === undefined) return HttpServerResponse.empty({ status: 401 });
+        const claims = yield* Schema.decodeUnknownEffect(
+          Schema.fromJsonString(Schema.Struct({ pool: Schema.String })),
+        )(Buffer.from(encoded, "base64url").toString());
+        return (
+          (yield* forward(claims.pool, request.url, "POST", request.headers, raw)) ??
+          HttpServerResponse.empty({ status: 404 })
+        );
+      }),
+    ),
+  };
+});
