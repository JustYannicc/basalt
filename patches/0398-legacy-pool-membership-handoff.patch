@@ -0,0 +1,289 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, FileSystem, Path, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { cloudLocks } from "../support/cloud-locks.ts";
+import { Evidence } from "../support/evidence.ts";
+import { legacyPoolHome } from "../support/legacy-pool-home.ts";
+import { driver, Target } from "../support/platform.ts";
+import { poolWorkerRuntime } from "../support/pool-worker-runtime.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Resource = Schema.Struct({ id: Schema.String });
+const App = Schema.Struct({ id: Schema.String, name: Schema.String });
+const Source = Schema.Struct({
+  files: Schema.Array(Schema.Struct({ path: Schema.String, content: Schema.String })),
+});
+const Links = Schema.Array(Schema.Struct({ requirement: Schema.String, account: Resource }));
+const View = Schema.Struct({
+  ok: Schema.Literal(true),
+  value: Schema.Struct({ accounts: Schema.Array(Resource) }),
+});
+
+layer(HostedLive, { excludeTestServices: true })("Legacy pool membership handoff", (it) => {
+  it.effect(scenarios.poolLegacyHandoff.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          database = yield* cloudLocks;
+        const target = yield* Target,
+          evidence = yield* Evidence,
+          browser = yield* Browser;
+        const fs = yield* FileSystem.FileSystem,
+          path = yield* Path.Path;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const viewer = yield* body(
+          Schema.Struct({ userId: Schema.String }),
+          yield* api.request(actors.owner, "GET", "/api/viewer"),
+        );
+        yield* database.run({
+          sql: `update "user" set "emailVerified" = true where id=$1`,
+          params: [viewer.userId],
+        });
+        const created = yield* api.request(actors.owner, "POST", `${prefix}/pools`, {
+          name: "Retained pool",
+          requestId: crypto.randomUUID(),
+          newInstance: true,
+        });
+        if (created.status !== 200)
+          yield* evidence.json("pool-creation-receiver-diagnostic.json", {
+            created: created.body,
+            events: (yield* api.request(
+              actors.owner,
+              "GET",
+              "/native-provider-fixture/backend-events",
+            )).body,
+            release: (yield* api.request(actors.owner, "GET", "/pool/v1/release")).body,
+          });
+        expect(created.status, JSON.stringify(created.body)).toBe(200);
+        const pool = yield* body(App, created);
+        const appPath = `${prefix}/apps/${pool.id}`;
+        const accounts: { id: string; requirement: string }[] = [];
+        for (const [requirement, method, count] of [
+          ["openai", "codex", 1],
+          ["anthropic", "claude", 3],
+        ] as const) {
+          const source = yield* fs
+            .readFileString(path.resolve(`../src/catalog/provider-apps/${requirement}.json`))
+            .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Schema.fromJsonString(Source))));
+          const provider = yield* body(
+            Resource,
+            yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+              name: `Retained ${requirement}`,
+              files: source.files,
+            }),
+          );
+          for (let index = 0; index < count; index++) {
+            const connection = yield* body(
+              Resource,
+              yield* api.request(
+                actors.owner,
+                "POST",
+                `${prefix}/apps/${provider.id}/accounts/app/${requirement}/connections`,
+                { destination: { kind: "personal" } },
+              ),
+            );
+            const interactive = `${prefix}/connections/${connection.id}/interactive`;
+            expect(
+              (yield* api.request(actors.owner, "POST", `${interactive}/start`, { method })).status,
+            ).toBe(200);
+            const connected = yield* body(
+              Schema.Struct({ state: Schema.Literal("connected"), account: Resource }),
+              yield* api.request(actors.owner, "GET", `${interactive}/status`),
+            );
+            accounts.push({ id: connected.account.id, requirement });
+            expect(
+              (yield* api.request(
+                actors.owner,
+                "PUT",
+                `${appPath}/accounts/app/${requirement}/${connected.account.id}`,
+              )).status,
+            ).toBe(200);
+          }
+        }
+        const links = () =>
+          api
+            .request(actors.owner, "GET", `${appPath}/accounts/app`)
+            .pipe(Effect.flatMap((response) => body(Links, response)));
