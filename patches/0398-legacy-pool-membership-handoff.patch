@@ -0,0 +1,129 @@
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Effect, Layer, Schema } from "effect";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { createHmac } from "node:crypto";
+import { createServer } from "node:http";
+
+/** Home starts with saved credentials and no channel memberships, as in a retained pool. */
+export const legacyPoolHome = (
+  pool: string,
+  accounts: readonly { id: string; provider: string }[],
+) =>
+  Effect.gen(function* () {
+    const members = new Map<number, string>();
+    const users: { id: number; username: string }[] = [];
+    const writes: string[] = [];
+    let sequence = 0;
+    const handler = Effect.gen(function* () {
+      const request = yield* HttpServerRequest.HttpServerRequest;
+      const url = new URL(request.url, "http://home.test");
+      const path = url.pathname;
+      if (path === "/ready")
+        return HttpServerResponse.jsonUnsafe({
+          boot_id: "synthetic-legacy-boot",
+          started_at: "2026-11-01T12:00:00.000Z",
+        });
+      if (path === "/native-policy") {
+        const input = yield* request.json.pipe(
+          Effect.flatMap(Schema.decodeUnknownEffect(Schema.Struct({ projection: Schema.String }))),
+        );
+        const [kind, encoded] = input.projection.split(".");
+        if (kind !== "sbm-policy1" || encoded === undefined)
+          return HttpServerResponse.empty({ status: 401 });
+        const signed = `${kind}.${encoded}`;
+        const signature = createHmac("sha256", Buffer.from("ab".repeat(32), "hex"))
+          .update(signed)
+          .digest("base64url");
+        if (`${signed}.${signature}` !== input.projection)
+          return HttpServerResponse.empty({ status: 401 });
+        const value = yield* Schema.decodeUnknownEffect(
+          Schema.fromJsonString(Schema.Struct({ revision: Schema.Number })),
+        )(Buffer.from(encoded, "base64url").toString());
+        return HttpServerResponse.jsonUnsafe({ installed: true, revision: value.revision });
+      }
+      if (request.headers["x-management-key"] !== "synthetic-management-key")
+        return HttpServerResponse.empty({ status: 401 });
+      if (path === "/v8/management/users") {
+        if (request.method === "POST") {
+          const value = yield* request.json.pipe(
+            Effect.flatMap(Schema.decodeUnknownEffect(Schema.Struct({ username: Schema.String }))),
+          );
+          users.push({ id: users.length + 1, username: value.username });
+        }
+        return HttpServerResponse.jsonUnsafe({ users });
+      }
+      if (path === "/v8/management/channel-groups")
+        return HttpServerResponse.jsonUnsafe({
+          channel_groups: [{ id: 1, channel_name: `signalbox-pool-${pool}` }],
+        });
+      if (path === "/v8/management/channel-group-details") {
+        if (request.method === "POST") {
+          const value = yield* request.json.pipe(
+            Effect.flatMap(
+              Schema.decodeUnknownEffect(
+                Schema.Struct({ auth_id: Schema.String, channel_group_id: Schema.Number }),
+              ),
+            ),
+          );
+          members.set(++sequence, value.auth_id);
+          writes.push(`add:${value.auth_id}`);
+        }
+        return HttpServerResponse.jsonUnsafe({
+          channel_group_details: [...members].map(([id, auth_id]) => ({
+            id,
+            channel_group_id: 1,
+            auth_id,
+          })),
+        });
+      }
+      if (path.startsWith("/v8/management/channel-group-details/") && request.method === "DELETE") {
+        const id = Number(path.split("/").at(-1));
+        writes.push(`remove:${members.get(id)}`);
+        members.delete(id);
+        return HttpServerResponse.jsonUnsafe({ ok: true });
+      }
+      if (path === "/v8/management/credentials")
+        return HttpServerResponse.jsonUnsafe({
+          files: accounts.map((account) => ({
+            ...account,
+            label: account.id,
+            token: "synthetic-private-credential",
+          })),
+        });
+      if (path.startsWith("/v8/management/quota/credentials/"))
+        return HttpServerResponse.jsonUnsafe({
+          credential: { credential_id: path.split("/").at(-1) },
+          windows: [],
+          collection: {
+            status: "success",
+            freshness: "fresh",
+            observed_at: "2026-11-01T12:00:00.000Z",
+          },
+          reset_credits: null,
+        });
+      if (path === "/v8/management/quota/credentials")
+        return HttpServerResponse.jsonUnsafe({
+          items: accounts.map((account) => ({ credential_id: account.id, windows: [] })),
+        });
+      if (path.endsWith("/resets/attempt")) return HttpServerResponse.jsonUnsafe(null);
+      return HttpServerResponse.jsonUnsafe(
+        { error: "unexpected_home_request", path },
+        { status: 404 },
+      );
+    });
+    const context = yield* Layer.build(
+      HttpRouter.serve(HttpRouter.add("*", "/*", handler), {
+        disableLogger: true,
+        disableListenLog: true,
+      }).pipe(
+        Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 })),
+      ),
+    );
+    const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(context));
+    if (!("port" in server.address)) return yield* Effect.die("Expected TCP Home peer");
+    return {
+      origin: `http://127.0.0.1:${server.address.port}`,
+      members: Effect.sync(() => [...members.values()].sort()),
+      writes: Effect.sync(() => [...writes]),
+    };
+  });
