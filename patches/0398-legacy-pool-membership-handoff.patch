+          database.run({
+            sql: `select id, owner, provider, method, credential_generation from executor_accounts where id=$1`,
+            params: [control],
+          });
+        const beforeControl = yield* controlState();
+        expect(beforeControl).toHaveLength(1);
+        // This is the only historical state: an existing registration predating the membership marker.
+        const legacy = () =>
+          database.run({
+            sql: `update organization set metadata=(select jsonb_set(metadata::jsonb, '{basaltPools}', jsonb_object_agg(entry.key, case when entry.value->>'app'=$2 then entry.value-'membership' else entry.value end))::text from jsonb_each(metadata::jsonb->'basaltPools') entry) where id=$1`,
+            params: [actors.organization.id, pool.id],
+          });
+        yield* legacy();
+        const homeAccounts = ["codex", "claude", "claude", "claude"].map((provider, index) => ({
+          id: `synthetic-cloud-native-reference-${index + 1}`,
+          provider,
+        }));
+        const home = yield* legacyPoolHome(pool.id, homeAccounts);
+        const worker = yield* poolWorkerRuntime(target.metadata.origin, home.origin);
+        expect(yield* home.members).toEqual([]);
+        expect(
+          (yield* api.request(actors.owner, "POST", "/native-provider-fixture/product-peer", {
+            pool: pool.id,
+            origin: worker.origin,
+          })).status,
+        ).toBe(200);
+        // The actor fixture outlives this scoped Worker and still needs its normal deletion peer.
+        yield* Effect.addFinalizer(() =>
+          api
+            .request(actors.owner, "POST", "/native-provider-fixture/product-peer", {
+              pool: pool.id,
+              origin: null,
+            })
+            .pipe(
+              Effect.tap((response) => Effect.sync(() => expect(response.status).toBe(200))),
+              Effect.orDie,
+            ),
+        );
+        // Apply the production history schema through its private operations API on this run's database.
+        for (const sql of [
+          "DO $$ BEGIN CREATE ROLE basalt_pool_owner NOLOGIN; EXCEPTION WHEN duplicate_object THEN NULL; END $$",
+          "GRANT USAGE, CREATE ON SCHEMA public TO basalt_pool_owner",
+          "create table usage (id bigint, timestamp timestamptz)",
+          "create table home_data_migration (name text, completed boolean)",
+        ])
+          yield* database.run({ sql });
+        const plan = yield* worker.operations("/model-history/schema/catalog");
+        expect(plan.status).toBe(200);
+        const hashes = yield* driver("Read isolated history schema plan", () => plan.json()).pipe(
+          Effect.flatMap(
+            Schema.decodeUnknownEffect(
+              Schema.Struct({ schemaHash: Schema.String, catalogHash: Schema.String }),
+            ),
+          ),
+        );
+        expect(
+          (yield* worker.operations("/model-history/schema", {
+            method: "POST",
+            headers: { "content-type": "application/json" },
+            body: JSON.stringify({ go: true, ...hashes }),
+          })).status,
+        ).toBe(200);
+        const read = () =>
+          api.request(actors.owner, "POST", `${appPath}/tools/call`, {
+            tool: "view",
+            kind: "query",
+            input: {},
+          });
+        const first = yield* read();
+        yield* evidence.json("first-legacy-pool-read.json", {
+          status: first.status,
+          body: first.body,
+          home: yield* home.members,
+        });
+        expect(first.status, JSON.stringify(first.body)).toBe(200);
+        const view = yield* body(View, first);
+        yield* browser.login(actors.owner);
+        for (const width of [1280, 390]) {
+          const empty = view.value.accounts.length === 0;
+          yield* browser.use(`The retained pool overview at ${width}px`, (page) =>
+            page
+              .setViewportSize({ width, height: 900 })
+              .then(() => page.goto(`/org/${actors.organization.slug}/apps/${pool.id}?view=app`))
+              .then(() =>
+                page
+                  .frameLocator(`iframe[title="${pool.name} app"]`)
+                  .getByText(
+                    empty ? "Pick your first account" : "4 subscription accounts across 2 labs",
+                    { exact: false },
+                  )
+                  .waitFor(),
+              ),
+          );
+          yield* browser.checkpoint(`legacy-pool-${empty ? "empty" : "four-accounts"}-${width}`);
+        }
