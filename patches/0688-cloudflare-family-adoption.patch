--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/production-ops/migrations/cloudflare-family-adoption-v1.ts
@@ -0,0 +1,346 @@
+import * as BrowserCrypto from "@effect/platform-browser/BrowserCrypto";
+import { catalogAppSweepPending } from "@executor-js/hosted-server/catalog-app-upgrades";
+import { familyProviderIdentity } from "@executor-js/hosted-server/provider-account-definitions";
+import { identifyProvider } from "@executor-js/sdk/core";
+import { Crypto, Data, Effect, Option, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import {
+  ProductionOperationBusy,
+  type Change,
+  type Json,
+  type MigrationPlan,
+  type ProductionMigration,
+} from "../contracts.ts";
+import { canonical } from "../crypto.ts";
+import { contention } from "../locking.ts";
+import {
+  cloudflareFamilyLinks,
+  cloudflareFamilyRows,
+  connectionWith,
+  object,
+  versionsNamingProvider,
+  slotsUsing,
+  sorted,
+  text,
+  update,
+  versionWith,
+} from "./cloudflare-family-rows.ts";
+import { familyVerification } from "./cloudflare-family-verification.ts";
+
+export const cloudflareFamilyAdoptionReasons = [
+  "family-ref-changed",
+  "already-family",
+  "family-provider-missing",
+  "retained-provider-not-family",
+  "account-set-changed",
+  "account-method-outside-family",
+  "connection-in-progress",
+  "acquisition-outside-selection",
+  "provider-keyed-oauth-client",
+  "link-unresolved",
+  "declaration-not-family",
+  "release-in-flight",
+  "deploy-in-flight",
+  "reviewed-plan-changed",
+  "write-count-changed",
+  "post-write-checks-failed",
+] as const;
+type Reason = (typeof cloudflareFamilyAdoptionReasons)[number];
+export class CloudflareFamilyAdoptionRefused extends Data.TaggedError(
+  "CloudflareFamilyAdoptionRefused",
+)<{ readonly reasonCode: Reason }> {}
+const refuse = (reasonCode: Reason) =>
+  Effect.fail(new CloudflareFamilyAdoptionRefused({ reasonCode }));
+
+const Id = Schema.String.check(Schema.isPattern(/^[A-Za-z0-9_-]{1,256}$/u));
+// Content-derived refs are hex digests; an incompatible transition once minted a random UUID ref.
+const ProviderRef = Schema.String.check(Schema.isPattern(/^prv_[A-Za-z0-9-]{1,128}$/u));
+const Request = Schema.Struct({
+  organization: Id,
+  from: ProviderRef,
+  /** The ref the consuming apps already name; it must equal the host's family identity. */
+  to: ProviderRef,
+  accounts: Schema.Array(Schema.Struct({ account: Id, generation: Schema.Int })),
+});
+type Request = typeof Request.Type;
+const Link = Schema.Struct({
+  app: Id,
+  requirement: Schema.String,
+  subject: Schema.NullOr(Schema.String),
+  account: Id,
+});
+const PlanData = Schema.Struct({
+  organization: Id,
+  from: ProviderRef,
+  to: ProviderRef,
+  accounts: Schema.Array(
+    Schema.Struct({ account: Id, method: Schema.String, generation: Schema.Int }),
+  ),
+  apps: Schema.Array(Schema.Struct({ app: Id, version: Id })),
+  joining: Schema.Array(Schema.Struct({ app: Id, version: Id })),
+  deployments: Schema.Array(Schema.Struct({ version: Id, slots: Schema.Array(Schema.String) })),
+  connections: Schema.Array(Id),
+  acquisitions: Schema.Array(Id),
+  links: Schema.Array(Link),
+});
+
+const familyTarget = familyProviderIdentity("cloudflare").pipe(Effect.provide(BrowserCrypto.layer));
+const identityOf = (definition: Json | undefined) =>
+  Effect.gen(function* () {
+    const crypto = yield* Crypto.Crypto;
+    return yield* identifyProvider(definition as never, crypto);
+  }).pipe(Effect.provide(BrowserCrypto.layer), Effect.option);
+
+/** Every row that names the retained ref, checked against the reviewed exact selection. */
+const snapshot = (input: Request) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const owner = `organization:${input.organization}`;
+    const target = yield* familyTarget;
+    const to = target.identity;
+    if (input.to !== to) return yield* refuse("family-ref-changed");
+    if (input.from === to) return yield* refuse("already-family");
+    const stored = yield* cloudflareFamilyRows(
+      sql`select to_jsonb(p) as row from executor_providers p where id in (${input.from}, ${to})`,
+    );
+    if (!stored.some((row) => row.id === to)) return yield* refuse("family-provider-missing");
+    // Only a ref whose current definition derives the family's own identity merges into it.
+    const retained = yield* identityOf(stored.find((row) => row.id === input.from)?.definition);
+    if (Option.isNone(retained) || retained.value.identity !== to)
+      return yield* refuse("retained-provider-not-family");
+
+    const accounts = sorted(
+      yield* cloudflareFamilyRows(
+        sql`select to_jsonb(a) as row from executor_accounts a where a.owner = ${owner} and a.provider = ${input.from}`,
+      ),
+    );
+    const selected = [...input.accounts].sort((a, b) => (a.account < b.account ? -1 : 1));
+    if (
+      accounts.length !== selected.length ||
+      accounts.some(
+        (row, index) =>
+          row.id !== selected[index]!.account ||
+          row.credential_generation !== selected[index]!.generation,
+      )
+    )
+      return yield* refuse("account-set-changed");
+    const methods = Object.keys(target.definition.auth);
+    if (accounts.some((row) => !methods.includes(text(row.method))))
+      return yield* refuse("account-method-outside-family");
+
+    const deployments = sorted(yield* versionsNamingProvider(owner, input.from));
+    const versions = deployments.map((row) => text(row.id));
+    const apps = sorted(
+      versions.length === 0
+        ? []
+        : yield* cloudflareFamilyRows(
+            sql`select to_jsonb(a) as row from executor_apps a where a.owner = ${owner} and ${sql.in("a.active_deployment", versions)}`,
+          ),
+    );
+    // A deploy that read the retained ref before this commits could write it back. Release sweeps
+    // redeploy catalog apps; any deploy reserves its order before it reads the active version.
+    if (yield* catalogAppSweepPending(input.organization))
+      return yield* refuse("release-in-flight");
+    if (apps.some((row) => Number(row.deploy_sequence) > Number(row.activated_sequence)))
+      return yield* refuse("deploy-in-flight");
+    // A copy of an app that still declares the first definition, or that source deployed as a new
+    // app, would derive the retained ref again. Such apps move to the current declaration first.
+    for (const app of apps) {
+      const active = deployments.find((row) => row.id === app.active_deployment);
+      const accounts = object(active?.requirements) ? active.requirements.accounts : undefined;
+      for (const slot of active === undefined ? [] : slotsUsing(active, input.from)) {
+        const required = object(accounts) ? accounts[slot] : undefined;
+        const declared = yield* identityOf(object(required) ? required.definition : undefined);
+        if (Option.isNone(declared) || declared.value.identity !== to)
+          return yield* refuse("declaration-not-family");
+      }
+    }
+
+    // A sign-in still in progress would finish under the ref this adoption retires.
+    const live = yield* sql`select id from executor_account_connections where owner = ${owner}
+      and provider = ${input.from} and state ->> 'status' = 'pending' and expires_at > clock_timestamp()`;
+    if (live.length !== 0) return yield* refuse("connection-in-progress");
+    const connections = sorted(
+      yield* cloudflareFamilyRows(
+        sql`select to_jsonb(c) as row from executor_account_connections c where c.owner = ${owner} and c.provider = ${input.from}`,
+      ),
+    );
+    const ids = accounts.map((row) => text(row.id));
+    const acquisitions = sorted(
+      yield* cloudflareFamilyRows(
+        sql`select to_jsonb(q) as row from executor_account_acquisitions q where q.owner = ${owner} and q.provider = ${input.from}`,
+      ),
+      "account",
+    );
+    if (acquisitions.some((row) => !ids.includes(text(row.account))))
+      return yield* refuse("acquisition-outside-selection");
+    // Clients saved before issuer keys derive their credential IDs from the provider ref.
+    const clients =
+      yield* sql`select id from executor_stored_oauth_clients where owner = ${owner} and provider = ${input.from}
+      union all select id from executor_stored_oauth_client_credentials where owner = ${owner} and provider = ${input.from}`;
+    if (clients.length !== 0) return yield* refuse("provider-keyed-oauth-client");
+
+    const links = yield* cloudflareFamilyLinks(ids);
+    if (links.some((link) => link.provider !== input.from)) return yield* refuse("link-unresolved");
+
+    const changes: Change[] = [
+      ...accounts.map((row) =>
+        update("executor_accounts", { id: text(row.id) }, row, { ...row, provider: to }),
+      ),
+      ...deployments.map((row) =>
+        update("executor_deployments", { id: text(row.id) }, row, versionWith(row, input.from, to)),
+      ),
+      ...connections.map((row) =>
+        update(
+          "executor_account_connections",
+          { id: text(row.id) },
+          row,
+          connectionWith(row, input.from, to),
+        ),
+      ),
+      ...acquisitions.map((row) =>
+        update("executor_account_acquisitions", { account: text(row.account) }, row, {
+          ...row,
+          provider: to,
+        }),
+      ),
+    ];
+    // Apps already on the family ref start offering these accounts once they move.
+    const familyVersions = (yield* versionsNamingProvider(owner, to)).map((row) => text(row.id));
+    const joining = sorted(
+      familyVersions.length === 0
+        ? []
+        : yield* cloudflareFamilyRows(
+            sql`select to_jsonb(a) as row from executor_apps a where a.owner = ${owner} and ${sql.in("a.active_deployment", familyVersions)}`,
+          ),
+    );
+    const data = {
+      organization: input.organization,
+      from: input.from,
+      to,
+      accounts: accounts.map((row) => ({
+        account: text(row.id),
+        method: text(row.method),
+        generation: Number(row.credential_generation),
+      })),
+      apps: apps.map((row) => ({ app: text(row.id), version: text(row.active_deployment) })),
+      joining: joining.map((row) => ({ app: text(row.id), version: text(row.active_deployment) })),
+      deployments: deployments.map((row) => ({
+        version: text(row.id),
+        slots: slotsUsing(row, input.from),
+      })),
+      connections: connections.map((row) => text(row.id)),
+      acquisitions: acquisitions.map((row) => text(row.account)),
+      links: links.map(({ link }) => link),
+    };
+    return { changes, data };
+  });
+
+const inspect = (raw: Json) =>
+  Schema.decodeUnknownEffect(Request)(raw).pipe(Effect.flatMap(snapshot));
+
+const verification = (raw: Json, plan: MigrationPlan, exact: boolean) =>
+  Effect.gen(function* () {
+    const input = yield* Schema.decodeUnknownEffect(Request)(raw);
+    const data = yield* Schema.decodeUnknownEffect(PlanData)(plan.data);
+    return yield* familyVerification(input, data, plan.changes, exact);
+  });
+const verify = (raw: Json, plan: MigrationPlan) => verification(raw, plan, false);
+
+/**
+ * Moves one organization's Cloudflare accounts from the provider ref their app lineage retained
+ * onto the Cloudflare family's canonical provider, the one every app declaring Cloudflare now
+ * derives. Account IDs, credentials, generations and links stay; only provider refs change.
+ */
+export const cloudflareFamilyAdoptionV1: ProductionMigration = {
+  name: "cloudflare-family-adoption-v1",
+  revision: "1",
+  tables: [
+    "organization",
+    "executor_providers",
+    "executor_accounts",
+    "executor_apps",
+    "executor_deployments",
+    "executor_account_connections",
+    "executor_account_acquisitions",
+    "hosted_app_account_links",
+  ],
+  inspect,
+  lockAuthority: (raw, plan) =>
+    Effect.gen(function* () {
+      const input = yield* Schema.decodeUnknownEffect(Request)(raw);
+      const data = yield* Schema.decodeUnknownEffect(PlanData)(plan.data);
+      const sql = yield* SqlClient.SqlClient;
+      // Link writers take the organization's access lock first; adoption keeps that order. The
+      // plan's snapshot is already fixed, so waiting here would hide what commits meanwhile.
+      const [access] = yield* sql<{
+        readonly held: boolean;
+      }>`select pg_try_advisory_xact_lock(hashtextextended(${`executor-access:${input.organization}`}, 0)) as held`;
+      if (access?.held !== true) return yield* new ProductionOperationBusy();
+      // Deploys and activations lock the app row, so every app owning a moved version waits for
+      // the GO and then reads the moved rows.
+      const versions = data.deployments.map((entry) => entry.version);
+      const owning =
+        versions.length === 0
+          ? []
+          : yield* sql<{ readonly id: string }>`select distinct a.id from executor_apps a
+              join executor_deployments d on d.code = a.code
+              where a.owner = ${`organization:${input.organization}`} and ${sql.in("d.id", versions)}`;
+      const apps = [
+        ...new Set([
+          ...data.apps.map((entry) => entry.app),
+          ...data.links.map((link) => link.app),
+          ...owning.map((row) => row.id),
+        ]),
+      ].sort();
+      for (const app of apps)
+        yield* sql`select id from executor_apps where id = ${app} for no key update nowait`;
+    }).pipe(Effect.mapError(contention)),
+  apply: (raw, plan) =>
+    Effect.gen(function* () {
+      const input = yield* Schema.decodeUnknownEffect(Request)(raw);
+      const fresh = yield* snapshot(input);
+      if (canonical(fresh) !== canonical(plan)) return yield* refuse("reviewed-plan-changed");
+      const { from, to } = fresh.data;
+      const sql = yield* SqlClient.SqlClient;
+      const owner = `organization:${input.organization}`;
+      const count = (written: ReadonlyArray<unknown>, expected: number) =>
+        written.length === expected ? Effect.void : refuse("write-count-changed");
+      const accounts = fresh.data.accounts.map((entry) => entry.account);
+      if (accounts.length !== 0)
+        yield* count(
+          yield* sql`update executor_accounts set provider = ${to} where owner = ${owner}
+            and provider = ${from} and ${sql.in("id", accounts)} returning id`,
+          accounts.length,
+        );
+      for (const { version, slots } of fresh.data.deployments)
+        for (const slot of slots)
+          yield* count(
+            yield* sql`update executor_deployments set requirements =
+              jsonb_set(requirements::jsonb, array['accounts', ${slot}, 'provider'], to_jsonb(${to}::text), false)::json
+              where id = ${version} and owner = ${owner}
+              and requirements::jsonb -> 'accounts' -> ${slot} ->> 'provider' = ${from} returning id`,
+            1,
+          );
+      const connections = fresh.data.connections;
+      if (connections.length !== 0)
+        yield* count(
+          yield* sql`update executor_account_connections set provider = ${to},
+            state = (case when state::jsonb -> 'account' ->> 'provider' = ${from}
+              then jsonb_set(state::jsonb, '{account,provider}', to_jsonb(${to}::text), false)
+              else state::jsonb end)::json
+            where owner = ${owner} and provider = ${from} and ${sql.in("id", connections)} returning id`,
+          connections.length,
+        );
+      const acquisitions = fresh.data.acquisitions;
+      if (acquisitions.length !== 0)
+        yield* count(
+          yield* sql`update executor_account_acquisitions set provider = ${to} where owner = ${owner}
+            and provider = ${from} and ${sql.in("account", acquisitions)} returning account`,
+          acquisitions.length,
+        );
+      if (!(yield* verification(raw, plan, true)).ok)
+        return yield* refuse("post-write-checks-failed");
+    }),
+  verify,
+};
