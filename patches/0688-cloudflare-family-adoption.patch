@@ -11,6 +12,7 @@ import type { ProductionMigration } from "./contracts.ts";
 /** Migration modules land with their owning feature and remain inert until an exact-ID GO. */
 export const productionMigrations: Readonly<Record<string, ProductionMigration>> = {
   [poolAssociationRepairV1.name]: poolAssociationRepairV1,
+  [cloudflareFamilyAdoptionV1.name]: cloudflareFamilyAdoptionV1,
