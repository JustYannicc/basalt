@@ -0,0 +1,93 @@
+import { Effect } from "effect";
+import { SqlClient } from "effect/sql";
+import type { MigrationPlan } from "../contracts.ts";
+import { canonical, sha256 } from "../crypto.ts";
+import {
+  cloudflareFamilyLinks,
+  object,
+  text,
+  versionsNamingProvider,
+  writtenCloudflareRows,
+} from "./cloudflare-family-rows.ts";
+
+type Refs = { readonly organization: string; readonly from: string; readonly to: string };
+type Adopted = Refs & {
+  readonly accounts: ReadonlyArray<{ readonly account: string }>;
+  readonly deployments: ReadonlyArray<{
+    readonly version: string;
+    readonly slots: ReadonlyArray<string>;
+  }>;
+  readonly connections: ReadonlyArray<string>;
+  readonly acquisitions: ReadonlyArray<string>;
+  readonly links: ReadonlyArray<unknown>;
+};
+
+/**
+ * Inside the GO every written row must match its planned hash and every kept link must exist.
+ * After commit people renew, rename, refresh, unlink and move apps to other providers, so the
+ * post-commit check and replays only require that the moved refs still name the family ref and
+ * that nothing, links included, names the retained one.
+ */
+export const familyVerification = (
+  input: Refs,
+  data: Adopted,
+  changes: MigrationPlan["changes"],
+  exact: boolean,
+) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const owner = `organization:${input.organization}`;
+    const after = new Map(
+      changes.map((change) => [canonical([change.table, change.key]), change.afterSha256]),
+    );
+    const written = [
+      ...(yield* writtenCloudflareRows(
+        "executor_accounts",
+        data.accounts.map((entry) => entry.account),
+      )),
+      ...(yield* writtenCloudflareRows(
+        "executor_deployments",
+        data.deployments.map((entry) => entry.version),
+      )),
+      ...(yield* writtenCloudflareRows("executor_account_connections", data.connections)),
+      ...(yield* writtenCloudflareRows("executor_account_acquisitions", data.acquisitions)),
+    ];
+    const accountsLeft =
+      yield* sql`select id from executor_accounts where owner = ${owner} and provider = ${data.from}`;
+    const versionsLeft = yield* versionsNamingProvider(owner, data.from);
+    const links = yield* cloudflareFamilyLinks(data.accounts.map((entry) => entry.account));
+    const slots = new Map(data.deployments.map((entry) => [entry.version, entry.slots]));
+    const moved = ({ key, row }: (typeof written)[number]) => {
+      if (key[0] !== "executor_deployments") {
+        const state = object(row.state) ? row.state.account : undefined;
+        return row.provider === data.to && !(object(state) && state.provider === data.from);
+      }
+      const accounts = object(row.requirements) ? row.requirements.accounts : undefined;
+      return (slots.get(text(row.id)) ?? []).every((slot) => {
+        const required = object(accounts) ? accounts[slot] : undefined;
+        return object(required) && required.provider === data.to;
+      });
+    };
+    const checks = {
+      requestBound:
+        input.organization === data.organization &&
+        input.from === data.from &&
+        input.to === data.to,
+      movedRefs: written.every(moved),
+      nothingLeftOnRetainedRef: accountsLeft.length === 0 && versionsLeft.length === 0,
+      noLinkOnRetainedRef: links.every((link) => link.provider !== data.from),
+      ...(exact
+        ? {
+            exactRows:
+              written.length === changes.length &&
+              written.every(({ key, row }) => after.get(canonical(key)) === sha256(canonical(row))),
+            linksResolve: links.every((link) => link.provider === data.to),
+            // People may link the moved accounts once they share the family ref.
+            linksKept: data.links.every((planned) =>
+              links.some(({ link }) => canonical(link) === canonical(planned)),
+            ),
+          }
+        : {}),
+    };
+    return { ok: Object.values(checks).every(Boolean), checks };
+  });
