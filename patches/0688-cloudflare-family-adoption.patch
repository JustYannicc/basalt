--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/production-ops/migrations/cloudflare-family-rows.ts
@@ -0,0 +1,133 @@
+import { Effect, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import type { Change, Json } from "../contracts.ts";
+import { canonical, sha256 } from "../crypto.ts";
+
+export type FamilyRow = { readonly [key: string]: Json };
+const Rows = Schema.Array(Schema.Struct({ row: Schema.Record(Schema.String, Schema.Json) }));
+
+export const cloudflareFamilyRows = <E, R>(query: Effect.Effect<ReadonlyArray<unknown>, E, R>) =>
+  query.pipe(
+    Effect.flatMap(Schema.decodeUnknownEffect(Rows)),
+    Effect.map((list) => list.map((entry) => entry.row as FamilyRow)),
+  );
+
+/** Versions of the organization whose account requirements name the provider ref. */
+export const versionsNamingProvider = (owner: string, provider: string) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    return yield* cloudflareFamilyRows(sql`select to_jsonb(d) as row from executor_deployments d
+      where d.owner = ${owner} and exists (select 1 from jsonb_each(case
+        when jsonb_typeof(d.requirements::jsonb -> 'accounts') = 'object'
+        then d.requirements::jsonb -> 'accounts' else '{}'::jsonb end) r
+        where r.value ->> 'provider' = ${provider})`);
+  });
+
+/** Each link of the accounts, with the provider its requirement uses in the app's active version. */
+export const cloudflareFamilyLinks = (accounts: readonly string[]) =>
+  Effect.gen(function* () {
+    if (accounts.length === 0) return [];
+    const sql = yield* SqlClient.SqlClient;
+    const rows = yield* sql<{
+      readonly app: string;
+      readonly requirement: string;
+      readonly subject: string | null;
+      readonly account: string;
+      readonly provider: string | null;
+    }>`select l.app, l.requirement, l.subject, l.account,
+        d.requirements::jsonb -> 'accounts' -> l.requirement ->> 'provider' as provider
+      from hosted_app_account_links l
+      left join executor_apps a on a.id = l.app
+      left join executor_deployments d on d.id = a.active_deployment
+      where ${sql.in("l.account", accounts)}
+      order by l.app, l.requirement, l.account, l.subject nulls first`;
+    return rows.map(({ provider, app, requirement, subject, account }) => ({
+      link: { app, requirement, subject, account },
+      provider,
+    }));
+  });
+
+/** The adoption's written rows now, keyed as its plan records them. */
+export const writtenCloudflareRows = (
+  table:
+    | "executor_accounts"
+    | "executor_deployments"
+    | "executor_account_connections"
+    | "executor_account_acquisitions",
+  values: readonly string[],
+) =>
+  Effect.gen(function* () {
+    if (values.length === 0) return [];
+    const sql = yield* SqlClient.SqlClient;
+    const key = table === "executor_account_acquisitions" ? "account" : "id";
+    const found = yield* cloudflareFamilyRows(
+      table === "executor_accounts"
+        ? sql`select to_jsonb(e) as row from executor_accounts e where ${sql.in("e.id", values)}`
+        : table === "executor_deployments"
+          ? sql`select to_jsonb(e) as row from executor_deployments e where ${sql.in("e.id", values)}`
+          : table === "executor_account_connections"
+            ? sql`select to_jsonb(e) as row from executor_account_connections e where ${sql.in("e.id", values)}`
+            : sql`select to_jsonb(e) as row from executor_account_acquisitions e where ${sql.in("e.account", values)}`,
+    );
+    return found.map((row) => ({ key: [table, { [key]: row[key] ?? null }] as const, row }));
+  });
+
+export const object = (value: Json | undefined): value is { readonly [key: string]: Json } =>
+  value !== null && typeof value === "object" && !Array.isArray(value);
+export const text = (value: Json | undefined) => (typeof value === "string" ? value : "");
+const order = (key: string) => (a: FamilyRow, b: FamilyRow) =>
+  text(a[key]) < text(b[key]) ? -1 : text(a[key]) > text(b[key]) ? 1 : 0;
+export const sorted = (list: readonly FamilyRow[], key = "id") => [...list].sort(order(key));
+
+/** Requirement slots of one version that use `provider`. */
+export const slotsUsing = (deployment: FamilyRow, provider: string) => {
+  const accounts = object(deployment.requirements) ? deployment.requirements.accounts : undefined;
+  return object(accounts)
+    ? Object.keys(accounts)
+        .filter((slot) => {
+          const required = accounts[slot];
+          return object(required) && required.provider === provider;
+        })
+        .sort()
+    : [];
+};
+export const versionWith = (deployment: FamilyRow, from: string, to: string): FamilyRow => {
+  const requirements = object(deployment.requirements) ? deployment.requirements : {};
+  const accounts = object(requirements.accounts) ? requirements.accounts : {};
+  return {
+    ...deployment,
+    requirements: {
+      ...requirements,
+      accounts: Object.fromEntries(
+        Object.entries(accounts).map(([slot, value]) => [
+          slot,
+          object(value) && value.provider === from ? { ...value, provider: to } : value,
+        ]),
+      ),
+    },
+  };
+};
+export const connectionWith = (connection: FamilyRow, from: string, to: string): FamilyRow => {
+  const state = object(connection.state) ? connection.state : {};
