+import { StorageError } from "@executor-js/sdk/core";
+import { Context, Effect } from "effect";
+import { SqlClient } from "effect/sql";
+
+type Requirement = { readonly app: string; readonly requirement: string };
+
+/** The app requirement an account is being saved for, when a person adds one for it. */
+export const AccountForRequirement = Context.Reference<Requirement | undefined>(
+  "hosted/AccountForRequirement",
+  { defaultValue: () => undefined },
+);
+export const accountForRequirement =
+  (requirement: Requirement) =>
+  <A, E, R>(effect: Effect.Effect<A, E, R>) =>
+    effect.pipe(Effect.provideService(AccountForRequirement, requirement));
+
+/**
+ * Runs in the account's insert transaction. A production migration may have moved the app's
+ * provider ref since the request read the requirement, and an account saved under the old ref is
+ * offered by no app. Lock the app's row as deploys do, then read the requirement again.
+ */
+export const requireRequirementProvider = (
+  sql: SqlClient.SqlClient,
+  target: Requirement,
+  account: { readonly owner: string; readonly provider: string },
+) =>
+  Effect.gen(function* () {
+    const locked = yield* sql<{ readonly version: string | null }>`update executor_apps
+      set code = code where id = ${target.app} and owner = ${account.owner}
+      returning active_deployment as version`;
+    const version = locked[0]?.version;
+    // A separate statement, so it reads what committed while the update waited for the lock.
+    const named =
+      version === undefined || version === null
+        ? []
+        : yield* sql<{ readonly provider: string | null }>`select
+            requirements::jsonb -> 'accounts' -> ${target.requirement} ->> 'provider' as provider
+            from executor_deployments where id = ${version} and owner = ${account.owner}`;
+    if (named[0]?.provider !== account.provider) return yield* new StorageError();
+  });
