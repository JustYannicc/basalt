diff --git a/e2e/support/requirement-tools-catalog.ts b/e2e/support/requirement-tools-catalog.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/requirement-tools-catalog.ts
@@ -0,0 +1,70 @@
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Effect, Layer } from "effect";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { createServer } from "node:http";
+import { appsVersion } from "./apps-release.ts";
+
+/**
+ * A catalog app that declares one service twice, like a sign-in beside a key, whose listing names
+ * the tools each requirement runs.
+ */
+export const requirementToolsCatalog = Effect.gen(function* () {
+  const entry = {
+    id: "requirement-tools",
+    package: "@executor.sh/requirement-tools",
+    name: "Requirement tools fixture",
+    description: "One service declared twice, each feeding different tools.",
+    auth: [
+      { method: "key", kind: "secrets", label: "API key" },
+      { method: "token", kind: "secrets", label: "MCP token" },
+    ],
+    icons: [],
+    source: "apps/requirement-tools.json",
+    requirementTools: { rest: "Fixture REST tools", mcp: "Fixture MCP tools" },
+  };
+  const source = {
+    package: entry.package,
+    files: [
+      {
+        path: "index.ts",
+        content: `import { defineApp, defineProvider, object, router, secrets, string } from "apps";
+const rest = defineProvider({ name: "Tools fixture", auth: { key: secrets({ label: "API key", fields: object({ token: string({ minLength: 1 }) }) }) } });
+const mcp = defineProvider({ name: "Tools fixture MCP", auth: { token: secrets({ label: "MCP token", fields: object({ token: string({ minLength: 1 }) }) }) } });
+export default defineApp({ user: { accounts: { rest: rest.many(), mcp: mcp.many() } } }, async () => ({ tools: router({}) }));`,
+      },
+      {
+        path: "package.json",
+        content: JSON.stringify({
+          name: entry.package,
+          private: true,
+          type: "module",
+          dependencies: { apps: appsVersion },
+        }),
+      },
+    ],
+  };
+  const listener = createServer();
+  const services = yield* Layer.build(
+    HttpRouter.serve(
+      HttpRouter.add(
+        "GET",
+        "/*",
+        Effect.gen(function* () {
+          const request = yield* HttpServerRequest.HttpServerRequest;
+          const path = new URL(request.url, "http://catalog").pathname;
+          if (path === "/index.json")
+            return HttpServerResponse.jsonUnsafe({ version: 1, apps: [entry] });
+          if (path === "/apps/requirement-tools.json") return HttpServerResponse.jsonUnsafe(source);
+          return HttpServerResponse.empty({ status: 404 });
+        }),
+      ),
+      { disableLogger: true, disableListenLog: true },
+    ).pipe(
+      Layer.provideMerge(NodeHttpServer.layer(() => listener, { host: "127.0.0.1", port: 0 })),
+    ),
+  );
+  yield* Effect.addFinalizer(() => Effect.sync(() => listener.closeAllConnections()));
+  const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+  if (!("port" in server.address)) return yield* Effect.die("Catalog needs a TCP listener");
+  return { url: `http://127.0.0.1:${server.address.port}/index.json`, entry };
+});
diff --git a/e2e/tests/requirement-tools.spec.ts b/e2e/tests/requirement-tools.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/requirement-tools.spec.ts
@@ -0,0 +1,122 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect } from "effect";
+import type { Page } from "playwright";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { connectionsPath } from "../support/app-accounts.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { requirementToolsCatalog } from "../support/requirement-tools-catalog.ts";
+import { serverControl } from "../support/server-control.ts";
+import { choiceName, connectName } from "../support/account-choices.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Requirement tools", (it) => {
+  for (const [scenario, width] of [
+    [scenarios.requirementToolsDesktop, 1280],
+    [scenarios.requirementToolsPhone, 390],
+  ] as const)
+    it.effect(scenario.title, (context) =>
+      withHostedCase(
+        context,
+        Effect.gen(function* () {
+          const api = yield* Api,
+            actors = yield* Actors,
+            browser = yield* Browser;
+          const catalog = yield* requirementToolsCatalog;
+          yield* serverControl("stop");
+          yield* serverControl("environment", 200, { EXECUTOR_CATALOG_URL: catalog.url });
+          yield* serverControl("start");
+          const prefix = `/api/organizations/${actors.organization.id}`;
+          const installed = yield* api.request(actors.owner, "POST", `${prefix}/apps/install`, {
+            entry: catalog.entry.id,
+            name: `Requirement tools ${width}`,
+          });
+          expect(installed.status, JSON.stringify(installed.body)).toBe(200);
+          const app = yield* body(Resource, installed),
+            path = `${prefix}/apps/${app.id}`;
+          const accounts: string[] = [];
+          yield* Effect.addFinalizer(() =>
+            Effect.gen(function* () {
+              expect((yield* api.request(actors.owner, "DELETE", path)).status).toBe(200);
+              for (const account of accounts)
+                expect(
+                  (yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`))
+                    .status,
+                ).toBe(200);
+            }).pipe(Effect.orDie),
+          );
+          /** Connect a key account for one requirement from the app, which links it there. */
+          const connect = (requirement: string, method: string, label: string) =>
+            Effect.gen(function* () {
+              const connection = yield* body(
+                Resource,
+                yield* api.request(
+                  actors.owner,
+                  "POST",
+                  connectionsPath(path, "user", requirement),
+                  {},
+                ),
+              );
+              const saved = yield* api.request(
+                actors.owner,
+                "POST",
+                `${prefix}/connections/${connection.id}/submit`,
+                { method, label, fields: { token: "synthetic-token" } },
+              );
+              expect(saved.status).toBe(200);
+              accounts.push((yield* body(Resource, saved)).id);
+            });
+          yield* connect("rest", "key", "Rest key");
+          yield* connect("mcp", "token", "MCP token");
+
+          yield* browser.login(actors.owner);
+          const service = (page: Page) =>
+            page.getByRole("region", { name: "Tools fixture", exact: true });
+          const row = (page: Page, label: string) =>
+            service(page)
+              .getByRole("listitem")
+              .filter({
+                has: page.getByRole("checkbox", { name: choiceName(label), exact: true }),
+              });
+          yield* browser.use(`Open the Accounts tab at ${width}px`, (page) =>
+            page
+              .setViewportSize({ width, height: 900 })
+              .then(() =>
+                page.goto(`/org/${actors.organization.slug}/apps/${app.id}?view=accounts`),
+              )
+              .then(() =>
+                service(page).getByRole("button", { name: connectName(), exact: true }).waitFor(),
+              ),
+          );
+          // Each row says exactly which of the service's tools its account can't run.
+          const notes = yield* browser.use("Read each row's note", (page) =>
+            Promise.all([
+              row(page, "Rest key")
+                .getByText("Can't run Fixture MCP tools.", { exact: true })
+                .count(),
+              row(page, "MCP token")
+                .getByText("Can't run Fixture REST tools.", { exact: true })
+                .count(),
+            ]).then(([rest, mcp]) => ({ rest, mcp })),
+          );
+          expect(notes).toEqual({ rest: 1, mcp: 1 });
+          // The connect menu says which tools each method reaches.
+          const offered = yield* browser.use("Open the service's connect menu", (page) =>
+            service(page)
+              .getByRole("button", { name: connectName(), exact: true })
+              .click()
+              .then(() => page.getByRole("menu").waitFor())
+              .then(() => page.getByRole("menuitem").allInnerTexts())
+              .then((texts) => texts.map((text) => text.split("\n").map((line) => line.trim()))),
+          );
+          expect(offered).toEqual([
+            ["API key", "Fixture REST tools"],
+            ["MCP token", "Fixture MCP tools"],
+          ]);
+          yield* browser.checkpoint(`Requirement tools ${width}px`);
+        }),
+      ),
+    );
+});
