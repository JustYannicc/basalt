+
+/** The tools each requirement of an app runs, by requirement, from its catalog listing. */
+export type RequirementTools = Readonly<Record<string, string>>;
+
+/** The catalog names the tools of every requirement in the section. */
+export const declaresEvery = (
+  tools: RequirementTools | undefined,
+  group: readonly RequirementEntry[],
+): tools is RequirementTools =>
+  tools !== undefined && group.every(([slot]) => tools[slot] !== undefined);
+
+/**
+ * The tools a row's account can't run beside the rest of its service: those of every other
+ * requirement in the section. Said only where the catalog names the tools of every requirement in
+ * the section, so no row claims a limit the app doesn't declare.
+ */
+export const requirementLimits = (
+  tools: RequirementTools | undefined,
+  group: readonly RequirementEntry[],
+  slot: string,
+) => {
+  if (!declaresEvery(tools, group)) return undefined;
+  const others = [
+    ...new Set(group.flatMap(([other]) => (other === slot ? [] : [tools[other]!]))),
+  ].filter((title) => title !== tools[slot]);
+  return others.length === 0 ? undefined : `Can't run ${others.join(" or ")}.`;
+};
