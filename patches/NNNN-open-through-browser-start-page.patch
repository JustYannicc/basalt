diff --git a/e2e/support/start-page.ts b/e2e/support/start-page.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/start-page.ts
@@ -0,0 +1,43 @@
+/** The dashboard page a scenario's document loads before it navigates in the browser. */
+
+/**
+ * `connect` is the organization's Connect page. Its route starts the Apps list on the server
+ * without waiting for it, so the document carries the list whenever it answers before the render
+ * ends. The browser then uses that list without requesting it, and a hold or a replacement
+ * answer a scenario put on the request never applies.
+ *
+ * `settings` is the organization's Settings page. Its route declares only reads that run in the
+ * browser, and nothing it renders reads the Apps list, so its document never carries the list.
+ * The organization still reads the list in the browser after hydration, through the network,
+ * where a scenario's hold or replacement answer applies. A scenario that holds or replaces the
+ * Apps list starts here.
+ */
+export type StartPage = "connect" | "settings";
+
+/** Each start page's route under `/org/<organization>/`. */
+const routes = { connect: "connect", settings: "organization" } as const;
+
+/**
+ * The page to load before opening `destination` in the browser. Hosted pages start in their own
+ * organization; account pages name it in their `organization` search parameter, because only
+ * dashboard routes are served as dashboard documents (Cloud serves other paths as static assets).
+ * The local dashboard has no organizations and serves `/connect`.
+ */
+export const startPage = (destination: URL, start: StartPage = "connect") => {
+  const organization =
+    /^\/org\/([^/?#]+)/.exec(destination.pathname)?.[1] ??
+    destination.searchParams.get("organization");
+  if (organization !== null) return `/org/${organization}/${routes[start]}`;
+  // Falling back to `/connect` would hide that the caller's document is not the one it asked for.
+  if (start !== "connect")
+    throw new Error(
+      `${destination.pathname} names no organization to start from its ${start} page`,
+    );
+  return "/connect";
+};
+
+/**
+ * Whether a dashboard document carries the Apps list: its streamed data then has an entry for
+ * the list's read. A read the server started but did not finish, or never started, leaves none.
+ */
+export const carriesAppsList = (html: string) => /AtomHttpApi:resourceAccess:directory:/.test(html);
