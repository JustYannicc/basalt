diff --git a/e2e/support/cloud-log-activity.ts b/e2e/support/cloud-log-activity.ts
new file mode 100644
index 0000000..d70922b
--- /dev/null
+++ b/e2e/support/cloud-log-activity.ts
@@ -0,0 +1,29 @@
+/** A saved-line revision bridges the collector and its separate test process without polling. */
+import { Deferred, Effect, Schema } from "effect";
+
+export const CloudLogRevision = Schema.Struct({
+  revision: Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)),
+});
+export const CloudLogWait = Schema.Struct({
+  after: Schema.optional(CloudLogRevision.fields.revision),
+});
+
+export const cloudLogActivity = Effect.gen(function* () {
+  let revision = 0;
+  let changed = yield* Deferred.make<void>();
+  return {
+    written: Effect.gen(function* () {
+      const next = yield* Deferred.make<void>();
+      const previous = changed;
+      changed = next;
+      revision++;
+      yield* Deferred.succeed(previous, undefined);
+    }),
+    wait: (after?: number) =>
+      Effect.suspend(() =>
+        after === undefined || revision > after
+          ? Effect.succeed({ revision })
+          : Deferred.await(changed).pipe(Effect.map(() => ({ revision }))),
+      ),
+  };
+});
