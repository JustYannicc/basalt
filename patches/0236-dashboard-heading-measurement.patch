+
+/** Lazy fallbacks replace heading nodes; query and measure in one browser task, without a retained handle. */
+const headingBounds = (page: Page, title: "Apps" | "Accounts") =>
+  page
+    .evaluate(() => {
+      const headings = [...document.querySelectorAll("h1")].flatMap((heading) => {
+        const box = heading.getBoundingClientRect();
+        if (
+          box.width === 0 ||
+          box.height === 0 ||
+          getComputedStyle(heading).visibility === "hidden" ||
+          heading.closest('[aria-hidden="true"]') !== null
+        )
+          return [];
+        return [
+          {
+            text: heading.textContent?.trim() ?? "",
+            box: { x: box.x, y: box.y, width: box.width, height: box.height },
+          },
+        ];
+      });
+      return { count: headings.length, heading: headings[0] ?? null };
+    })
+    .then(({ count, heading }) => {
+      expect(count, "Exactly one page heading is visible at the measurement").toBe(1);
+      expect(heading?.text, "The visible heading names the destination").toMatch(
+        title === "Apps" ? /^Apps(?:\s*\d+)?$/ : /^Accounts(?:\s*\d+)?$/,
+      );
+      return heading?.box ?? null;
+    });

