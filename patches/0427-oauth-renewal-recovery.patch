diff --git a/packages/ui/src/contracts/account-check-recovery.ts b/packages/ui/src/contracts/account-check-recovery.ts
new file mode 100644
index 0000000..d2006cd
--- /dev/null
+++ b/packages/ui/src/contracts/account-check-recovery.ts
@@ -0,0 +1,99 @@
+/**
+ * What a failed account check means for the person reading it, and whether signing in again can
+ * fix it. Renewal reasons and causes are the host's closed vocabularies; vendor text never enters.
+ */
+import type { AccountAppHealth, App, AppId } from "@executor-js/sdk";
+import type { AccountSummary } from "./dashboard.ts";
+
+type Check = NonNullable<AccountAppHealth["check"]>;
+type Failure = NonNullable<Check["failure"]>;
+type Renewal = NonNullable<Failure["oauthRenewal"]>;
+
+/**
+ * The renewal evidence of a check that failed renewing a saved OAuth sign-in. A failure recorded
+ * before reasons were kept has neither field, which says nothing about why.
+ */
+export const renewalFailure = (check: Pick<Check, "failure">): Renewal | undefined =>
+  check.failure?.tag === "OAuthRenewalFailed" ? (check.failure.oauthRenewal ?? {}) : undefined;
+
+/**
+ * Renewals that signing in again can plausibly fix: an unexplained failure, or a refusal that did
+ * not say the grant ended. An outage, a rate limit, an unusable response or a refused OAuth client
+ * keeps the saved sign-in, and a new one would meet the same problem.
+ */
+const reconnectable = new Set<Renewal["reason"]>([undefined, "renewal_rejected"]);
+
+/** A current check whose recovery is Reconnect: a rejected sign-in or a renewal it can fix. */
+export const checkOffersReconnect = (check: Pick<Check, "current" | "status" | "failure">) => {
+  if (!check.current) return false;
+  if (check.status === "credentials_rejected") return true;
+  const renewal = renewalFailure(check);
+  return renewal !== undefined && reconnectable.has(renewal.reason);
+};
+
+/** The label of a failed renewal, everywhere a check's status label would show. */
+export const renewalLabel = "Could not renew sign-in";
+
+const renewalReasons = {
+  service_unavailable:
+    "The sign-in service didn't answer. The saved sign-in is kept; check again shortly.",
+  rate_limited: "The service is limiting renewals. The saved sign-in is kept; check again shortly.",
+  incompatible_response:
+    "The service's renewal response couldn't be used. The saved sign-in is kept; this isn't a problem with the account.",
+  client_rejected:
+    "The service refused the OAuth client used to sign in, not this account. Someone who manages OAuth clients needs to check it.",
+  renewal_rejected:
+    "The service refused to renew the sign-in without saying it ended. Reconnect to sign in again.",
+} satisfies Record<NonNullable<Renewal["reason"]>, string>;
+
+/** Why a renewal failed, from its recorded reason only. An old failure has none and says so. */
+export const renewalReason = (renewal: Renewal) =>
+  renewal.reason === undefined
+    ? "No reason was recorded for this failure. Check again, or reconnect to sign in again."
+    : renewalReasons[renewal.reason];
+
+/** The protocol evidence of a renewal: closed stages, codes and fields, and the HTTP status. */
+export const renewalEvidence = ({ cause }: Renewal) =>
+  cause === undefined
+    ? undefined
+    : [
+        `OAuth ${cause.stage}`,
+        cause.status === undefined ? undefined : `HTTP ${cause.status}`,
+        cause.providerError,
+        cause.field === undefined ? undefined : `field ${cause.field}`,
+      ]
+        .filter((part) => part !== undefined)
+        .join(" · ");
+
+/**
+ * Why a check failed: the host's message, else a failed renewal's recorded reason, with the
+ * renewal's protocol evidence when it was kept.
+ */
+export const checkExplanation = (check: Pick<Check, "failure" | "message">) => {
+  const renewal = renewalFailure(check);
+  return {
+    message: check.message ?? (renewal === undefined ? undefined : renewalReason(renewal)),
+    evidence:
+      check.failure?.oauthRenewal === undefined
+        ? undefined
+        : renewalEvidence(check.failure.oauthRenewal),
+  };
+};
+
+/**
+ * The first app whose current check of `account` offers Reconnect and where the page supports it,
+ * so a row's one Reconnect opens the app that reported the problem.
+ */
+export const reconnectApp = (
+  account: AccountSummary,
+  apps: readonly App[],
+  canReconnect: ((app: App) => boolean) | undefined,
+): App | undefined => {
+  if (canReconnect === undefined) return undefined;
+  const offering = new Set<AppId>(
+    (account.health?.apps ?? []).flatMap((entry) =>
+      entry.check !== null && checkOffersReconnect(entry.check) ? [entry.app] : [],
+    ),
+  );
+  return apps.find((app) => offering.has(app.id) && canReconnect(app));
+};
