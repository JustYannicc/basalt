diff --git a/e2e/support/pool-source-query-proof.ts b/e2e/support/pool-source-query-proof.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/pool-source-query-proof.ts
@@ -0,0 +1,104 @@
+import { expect } from "@effect/vitest";
+import { Clock, Effect, FileSystem, Path, Schema } from "effect";
+import type { Session } from "./api.ts";
+import { Browser } from "./browser.ts";
+import { waitForAppUrl } from "./app-pages.ts";
+import { Evidence } from "./evidence.ts";
+import { Target } from "./platform.ts";
+
+export const sourceQueryFiles = [
+  {
+    path: "ui/index.html",
+    content:
+      '<!doctype html><html><body><p role="status">Source queries ready</p><script type="module" src="./main.ts"></script></body></html>',
+  },
+  {
+    path: "ui/main.ts",
+    content: `import { json } from "apps";
+import { createAppClient, queryReference } from "apps/client";
+const client = createAppClient();
+Object.assign(globalThis, { sourceViews: (accounts: string[]) => Promise.all(accounts.map(account => client.query(queryReference("view"), {account}, json()))) });`,
+  },
+];
+
+/** Observe each real query's own SQL trace without retaining statements or bind values. */
+export const sourceQueryProof = (actor: Session, appPath: string) =>
+  Effect.gen(function* () {
+    const browser = yield* Browser,
+      evidence = yield* Evidence,
+      fs = yield* FileSystem.FileSystem,
+      path = yield* Path.Path;
+    yield* browser.login(actor);
+    const appUrl = yield* waitForAppUrl(actor, appPath);
+    yield* browser.use("Open the source-query page", (page) => page.goto(appUrl));
+    yield* browser.use("The source-query page is ready", (page) =>
+      page.getByRole("status").filter({ hasText: "Source queries ready" }).waitFor(),
+    );
+    return (name: string, accounts: readonly string[]) =>
+      Effect.gen(function* () {
+        const start = yield* Clock.currentTimeNanos;
+        const responses = yield* browser.use(
+          `Run three concurrent ${name} source queries`,
+          (page) => {
+            const queries: Promise<{
+              trace: string | undefined;
+              timing: string | null;
+              status: number;
+            }>[] = [];
+            const observe = (response: import("playwright").Response) => {
+              if (!response.url().endsWith("/_executor/api/query")) return;
+              queries.push(
+                response.headerValue("server-timing").then((timing) => ({
+                  trace: response.request().headers()["traceparent"]?.split("-")[1],
+                  timing,
+                  status: response.status(),
+                })),
+              );
+            };
+            page.on("response", observe);
+            return page
+              .evaluate(`globalThis.sourceViews(${JSON.stringify(accounts)})`)
+              .then((replies) => Promise.all(queries).then((queries) => ({ replies, queries })))
+              .finally(() => page.off("response", observe));
+          },
+        );
+        const milliseconds = Number((yield* Clock.currentTimeNanos) - start) / 1_000_000;
+        expect(responses.queries).toHaveLength(3);
+        for (const query of responses.queries) expect(query.status).toBe(200);
+        const traces = new Set(responses.queries.map((query) => query.trace));
+        expect(traces.size).toBe(3);
+        const records = (yield* fs.readFileString(
+          path.join((yield* Target).directory, "provider-query-statements.jsonl"),
+        ))
+          .trim()
+          .split("\n")
+          .filter(Boolean)
+          .map((line) =>
+            Schema.decodeUnknownSync(
+              Schema.fromJsonString(
+                Schema.Struct({ trace: Schema.String, writeLock: Schema.Boolean }),
+              ),
+            )(line),
+          )
+          .filter((record) => traces.has(record.trace));
+        yield* evidence.json(`${name}-concurrent-source-resolution.json`, {
+          queries: traces.size,
+          milliseconds,
+          phases: responses.queries.map((query) => query.timing),
+          statements: records.length,
+          writeLocks: records.filter((record) => record.writeLock).length,
+        });
+        for (const trace of traces) {
+          expect(trace).toMatch(/^[a-f0-9]{32}$/u);
+          expect(
+            records.filter((record) => record.trace === trace).length,
+            "Every query must contribute its own measured SQL statements",
+          ).toBeGreaterThan(0);
+        }
+        expect(
+          records.filter((record) => record.writeLock),
+          "Existing source selections must not acquire write locks during concurrent queries",
+        ).toEqual([]);
+        return responses.replies;
+      });
+  });
