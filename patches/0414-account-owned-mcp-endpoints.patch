+            url.protocol === "http:" &&
+            ["localhost", "127.0.0.1", "[::1]"].includes(url.hostname) &&
+            url.port !== "" &&
+            url.username === "" &&
+            url.password === "" &&
+            url.search === "" &&
+            url.hash === ""
