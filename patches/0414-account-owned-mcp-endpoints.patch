--- /dev/null
+++ b/packages/apps/src/contracts/mcp-endpoint.ts
@@ -0,0 +1,13 @@
+/** A method accepts an account-owned endpoint only on its declared credential hosts. */
+import { Schema } from "effect";
+
+export const CredentialHost = Schema.String.check(
+  Schema.isPattern(
+    /^(\*\.)?[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*(?::[0-9]{1,5})?$/u,
+  ),
+);
+
+export const McpEndpoint = Schema.Struct({
+  label: Schema.optionalKey(Schema.NonEmptyString),
+  hosts: Schema.Array(CredentialHost).check(Schema.isMinLength(1)),
+});
