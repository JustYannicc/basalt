diff --git a/packages/sdk/src/implementation/mcp-endpoint.ts b/packages/sdk/src/implementation/mcp-endpoint.ts
new file mode 100644
--- /dev/null
+++ b/packages/sdk/src/implementation/mcp-endpoint.ts
@@ -0,0 +1,163 @@
+/** Private endpoint bindings share connection transactions and the existing credential envelope. */
+import { type Crypto, Effect, Redacted, Result, Schema } from "effect";
+import { Base64 } from "effect/encoding";
+import { parseDestination, type UrlPolicy } from "@executor-js/utils/url-policy";
+import { AccountFieldsInvalid } from "../contracts/account.ts";
+import { AuthMethodInvalid, type ProviderAuthMethod } from "../contracts/provider.ts";
+import type { SetConnectionMcpEndpoint } from "../contracts/account-connection.ts";
+import { OAuthSetupFailed, OAuthGrant } from "../contracts/oauth.ts";
+import {
+  type AccountConnectionId,
+  type OwnerId,
+  type ProviderId,
+  StorageError,
+} from "../contracts/shared.ts";
+import type { Credentials } from "../contracts/storage.ts";
+import { accountGrantId } from "./account-identities.ts";
+import { ownedAccount } from "./accounts.ts";
+import { credentialHostMatches } from "./credential-handles.ts";
+import {
+  lockConnection,
+  readConnection,
+  requireOpen,
+  type ConnectionRow,
+} from "./connection-state.ts";
+import { requireTargetProvider } from "./connection-target.ts";
+import { requireAccountConsumerMethod } from "./account-consumer-plan.ts";
+import { query, transaction, type Query } from "./database.ts";
+
+export const endpointMethod = (method: ProviderAuthMethod) =>
+  method.type === "oauth2" && "mcpEndpoint" in method ? method.mcpEndpoint : undefined;
+
+/** Validation does no I/O and its error never includes the submitted value. */
+export const validateMcpEndpoint = (
+  value: string,
+  method: ProviderAuthMethod,
+  policy: UrlPolicy,
+) => {
+  const rule = endpointMethod(method);
+  const url = parseDestination(value, policy);
+  return rule !== undefined &&
+    url !== undefined &&
+    url.protocol === "https:" &&
+    rule.hosts.some((host) => credentialHostMatches(host, url))
+    ? url.href
+    : undefined;
+};
+
+export const setConnectionMcpEndpoint = (
+  db: Query,
+  credentials: Credentials,
+  crypto: Crypto.Crypto,
+  policy: UrlPolicy,
+  input: typeof SetConnectionMcpEndpoint.Type,
+) =>
+  transaction(db, (tx) =>
+    Effect.gen(function* () {
+      const row = yield* lockConnection(tx, input, crypto);
+      yield* requireOpen(input, row);
+      const provider = yield* requireTargetProvider(tx, row);
+      yield* requireAccountConsumerMethod(tx, row.target, row.provider, input.method);
+      const method = provider.definition.auth[input.method];
+      if (
+        method === undefined ||
+        endpointMethod(method) === undefined ||
+        row.reconnectAccount !== null
+      )
+        return yield* new AuthMethodInvalid({ provider: row.provider, method: input.method });
+      const endpoint = validateMcpEndpoint(Redacted.value(input.endpoint), method, policy);
+      if (endpoint === undefined)
+        return yield* new AccountFieldsInvalid({ provider: row.provider, method: input.method });
+      const encrypted = Base64.encode(
+        yield* credentials.encrypt(row.id, Redacted.make({ endpoint })),
+      );
+      // Replacing pending input invalidates the browser attempt that used the previous binding.
+      const previous = row.oauthAttempt;
+      if (previous !== null)
+        yield* query(() =>
+          tx.updateMany("oauthAttempts", {
+            where: (b) => b("id", "=", previous),
+            set: { status: "completed", encrypted: new Uint8Array() },
+          }),
+        );
+      yield* query(() =>
+        tx.updateMany("accountConnections", {
+          where: (b) => b("id", "=", row.id),
+          set: {
+            state: { status: "pending", mcpEndpoint: { method: input.method, encrypted } },
+            oauthAttempt: null,
+          },
+        }),
+      );
+    }),
+  );
+
+/** Reconnects read their saved grant; uncommitted input belongs only to this connection. */
+export const connectionMcpEndpoint = (
+  db: Query,
+  credentials: Credentials,
+  row: ConnectionRow,
+  method: string,
+) =>
+  Effect.gen(function* () {
+    if (row.reconnectAccount !== null) {
+      const account = yield* ownedAccount(db, { account: row.reconnectAccount, owner: row.owner });
+      if (account.method !== method) return undefined;
+      const id = accountGrantId(account);
+      const grant = yield* query(() =>
+        db.findFirst("oauthGrants", { where: (b) => b("id", "=", id) }),
+      );
+      if (grant === null) return undefined;
+      const value = yield* credentials.decrypt(id, Redacted.make(grant.encrypted));
+      const parsed = yield* Schema.decodeUnknownEffect(OAuthGrant)(Redacted.value(value)).pipe(
+        Effect.mapError(() => new StorageError()),
+      );
+      return "mcpEndpoint" in parsed ? parsed.mcpEndpoint : undefined;
+    }
+    const binding = row.storedState.status === "pending" ? row.storedState.mcpEndpoint : undefined;
+    if (binding?.method !== method) return undefined;
+    const bytes = yield* Base64.decode(binding.encrypted).pipe(
+      Result.mapError(() => new StorageError()),
+      Effect.fromResult,
+    );
+    const value = yield* credentials.decrypt(row.id, Redacted.make(bytes));
+    const parsed = yield* Schema.decodeUnknownEffect(Schema.Struct({ endpoint: Schema.String }))(
+      Redacted.value(value),
+    ).pipe(Effect.mapError(() => new StorageError()));
+    return parsed.endpoint;
+  });
+
+/** Discovery receives the private resource only after its connection has been checked. */
+export const bindConnectionMcpMethod = (
+  db: Query,
+  credentials: Credentials,
+  policy: UrlPolicy,
+  method: Extract<ProviderAuthMethod, { type: "oauth2" }>,
+  input: {
+    readonly provider: ProviderId;
+    readonly method: string;
+    readonly connection?: AccountConnectionId | undefined;
+    readonly owner?: OwnerId | undefined;
+  },
+) =>
+  Effect.gen(function* () {
+    if (!("mcpEndpoint" in method)) return { method, mcpEndpoint: undefined };
+    if (input.connection === undefined) return yield* new AuthMethodInvalid(input);
