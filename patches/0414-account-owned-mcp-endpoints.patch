diff --git a/packages/ui/src/implementation/dashboard/mcp-endpoint-fields.tsx b/packages/ui/src/implementation/dashboard/mcp-endpoint-fields.tsx
new file mode 100644
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/mcp-endpoint-fields.tsx
@@ -0,0 +1,226 @@
+import {
+  useEffect,
+  useId,
+  useRef,
+  useState,
+  type ComponentType,
+  type KeyboardEvent,
+  type ReactNode,
+} from "react";
+import { Exit, Redacted, type Cause } from "effect";
+import { HugeiconsIcon } from "@hugeicons/react";
+import { SquareLock02Icon, ViewIcon, ViewOffSlashIcon } from "@hugeicons/core-free-icons";
+import type { FailureProps } from "../../contracts/dashboard.ts";
+import { Button } from "../components/button.tsx";
+import { Input } from "../components/input.tsx";
+import { useProductBrand } from "../hooks/product-brand.ts";
+
+/**
+ * Whether the entry can be offered to the server: a parseable https URL. Only action availability;
+ * the server owns allowed hosts and egress, and gets the full path and query as entered.
+ */
+const offerable = (value: string) => URL.parse(value)?.protocol === "https:";
+
+/**
+ * The account's own MCP server URL, asked for before the usual OAuth sign-in. The URL can carry a
+ * private path or key, so it stays masked, lives only in this component's state until saved, and
+ * never reaches attributes, copy or callbacks except as a Redacted value. Once the host reports it
+ * configured (or the save succeeds), the sign-in in `children` mounts; a saved URL is never shown
+ * or asked for again. Renders inside the account form, so it is fields and a button, not a form.
+ */
+export function McpEndpointFields<E>({
+  label = "Server URL",
+  disabled = false,
+  configured,
+  reconnect = false,
+  guidance,
+  children,
+  save,
+  Failure,
+  onPendingChange,
+}: {
+  readonly label?: string | undefined;
+  readonly disabled?: boolean | undefined;
+  /** The host's word that this connection or account already holds an endpoint. */
+  readonly configured: boolean;
+  /** Reconnecting an account, which keeps its saved endpoint. */
+  readonly reconnect?: boolean | undefined;
+  /** The catalog's steps for getting this URL, shown above the field. */
+  readonly guidance?: ReactNode;
+  /** The sign-in, mounted only once an endpoint is saved, so discovery never starts without one. */
+  readonly children: ReactNode;
+  readonly save: (endpoint: Redacted.Redacted<string>) => Promise<Exit.Exit<void, E>>;
+  readonly Failure: ComponentType<FailureProps<NoInfer<E>>>;
+  readonly onPendingChange?: ((pending: boolean) => void) | undefined;
+}) {
+  const brand = useProductBrand();
+  const inputId = useId();
+  const hintId = useId();
+  const problemId = useId();
+  const [value, setValue] = useState("");
+  const [shown, setShown] = useState(false);
+  const [touched, setTouched] = useState(false);
+  const [pending, setPending] = useState(false);
+  const [error, setError] = useState<Cause.Cause<E>>();
+  const [saved, setSaved] = useState(false);
+  const savedRef = useRef<HTMLParagraphElement>(null);
+  const live = useRef(true);
+  const pendingRef = useRef(false);
+  const pendingChange = useRef(onPendingChange);
+  useEffect(() => {
+    pendingChange.current = onPendingChange;
+  }, [onPendingChange]);
+
+  // Unmounting mid-save, as a method change does, must not leave the host form stuck busy.
+  useEffect(() => {
+    live.current = true;
+    return () => {
+      live.current = false;
+      if (pendingRef.current) pendingChange.current?.(false);
+    };
+  }, []);
+
+  const ready = configured || saved;
+  // The field unmounts on success; move focus to the confirmation so keyboard users continue on.
+  useEffect(() => {
+    if (saved) savedRef.current?.focus();
+  }, [saved]);
+
+  const updatePending = (next: boolean) => {
+    pendingRef.current = next;
+    setPending(next);
+    onPendingChange?.(next);
+  };
+
+  // Surrounding whitespace from a paste is never part of a URL; everything inside is kept as is.
+  const entry = value.trim();
+  const valid = offerable(entry);
+  const busy = pending || disabled;
+  const problem = touched && entry !== "" && !valid;
+
+  const submit = () => {
+    setTouched(true);
+    if (busy || !valid) return;
+    updatePending(true);
+    setError(undefined);
+    void save(Redacted.make(entry)).then((exit) => {
+      if (!live.current) return;
+      updatePending(false);
+      if (Exit.isFailure(exit)) setError(exit.cause);
+      else {
+        setValue("");
+        setShown(false);
+        setTouched(false);
+        setSaved(true);
+      }
+    });
+  };
+
+  if (ready)
+    return (
+      <>
+        <p
+          ref={savedRef}
+          tabIndex={-1}
+          role="status"
+          className="flex items-start gap-1.5 rounded-sm text-xs leading-relaxed text-muted-foreground outline-none focus-visible:ring-2 focus-visible:ring-ring"
+          data-mcp-endpoint="configured"
+        >
+          <HugeiconsIcon
+            icon={SquareLock02Icon}
+            className="mt-0.5 size-3.5 shrink-0 text-emerald-600"
+            aria-hidden
+          />
+          <span>
+            {reconnect && !saved
+              ? `Uses this account’s saved ${lower(label)}.`
+              : `${label} saved. ${brand.name} keeps it private to this account.`}
+          </span>
+        </p>
+        {children}
+      </>
+    );
+
+  const onKeyDown = (event: KeyboardEvent<HTMLInputElement>) => {
+    if (event.key !== "Enter" || event.nativeEvent.isComposing) return;
+    // Enter here means Continue, never a submit of the surrounding account form.
+    event.preventDefault();
+    submit();
+  };
+
+  return (
+    <div className="flex flex-col gap-4" data-mcp-endpoint="entry">
+      {guidance}
+      <div className="field-label flex flex-col gap-2.25 text-[13px] font-medium">
+        <label htmlFor={inputId}>{label}</label>
+        <div className="relative" data-private>
+          <Input
+            id={inputId}
+            // Masked like other credentials; shown as plain text so the browser never validates it.
+            type={shown ? "text" : "password"}
+            inputMode="url"
+            autoComplete="off"
+            autoCapitalize="none"
+            autoCorrect="off"
+            spellCheck={false}
+            placeholder="https://"
+            aria-required
+            aria-invalid={problem || error !== undefined}
+            aria-describedby={problem ? `${problemId} ${hintId}` : hintId}
+            value={value}
+            disabled={busy}
+            className="pr-10 max-[740px]:pr-12"
+            onChange={(event) => {
+              setValue(event.target.value);
+              // A failure belongs to the URL it was about.
+              setError(undefined);
+            }}
+            onBlur={() => setTouched(true)}
+            onKeyDown={onKeyDown}
+          />
+          <Button
+            type="button"
+            variant="ghost"
+            size="icon-sm"
+            className="absolute top-1/2 right-0.5 -translate-y-1/2 text-muted-foreground hover:text-foreground max-[740px]:right-0"
+            aria-label={shown ? `Hide ${lower(label)}` : `Show ${lower(label)}`}
+            aria-pressed={shown}
+            aria-controls={inputId}
+            disabled={busy}
+            onClick={() => setShown((current) => !current)}
+          >
+            <HugeiconsIcon icon={shown ? ViewOffSlashIcon : ViewIcon} strokeWidth={2} aria-hidden />
+          </Button>
+        </div>
+        {problem && (
+          <span id={problemId} className="text-[12px] font-normal leading-normal text-destructive">
+            Enter a full URL that starts with https://.
+          </span>
+        )}
+        <span
+          id={hintId}
+          className="field-hint text-[12px] font-normal leading-normal text-muted-foreground"
+        >
+          Paste the whole URL, including any key in it. {brand.name} keeps it private to this
+          account.
+        </span>
+      </div>
+      {error && <Failure cause={error} layout="compact" />}
+      <div className="form-actions flex flex-col pt-1">
+        <Button
+          type="button"
+          className="w-full"
+          loading={pending}
+          disabled={disabled || !valid}
+          onClick={submit}
+        >
+          Continue
+        </Button>
+      </div>
+    </div>
+  );
+}
+
+/** A label mid-sentence: "Server URL" reads "server URL", while "MCP server URL" keeps its acronym. */
+const lower = (label: string) =>
+  /^[A-Z][a-z]/.test(label) ? `${label.charAt(0).toLowerCase()}${label.slice(1)}` : label;
