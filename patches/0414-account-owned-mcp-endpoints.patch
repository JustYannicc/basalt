new file mode 100644
--- /dev/null
+++ b/packages/sdk/src/implementation/mcp-endpoint-protocol.ts
@@ -0,0 +1,31 @@
+import type { HostAccount, HostAccounts, HostAccountSlots } from "apps/contracts";
+
+const retainedAccount = (account: HostAccount): HostAccount => {
+  const { mcpEndpoint: _endpoint, ...retained } = account;
+  return {
+    ...retained,
+    provider: {
+      ...retained.provider,
+      auth: Object.fromEntries(
+        Object.entries(retained.provider.auth).filter(
+          ([, method]) => method.type !== "oauth2" || !("mcpEndpoint" in method),
+        ),
+      ),
+    },
+  };
+};
+
+/** Older bundles cannot decode an account-owned OAuth declaration added to a shared provider. */
+export const retainedMcpAccounts = (accounts: HostAccounts): HostAccounts => {
+  const slots = (value: HostAccountSlots): HostAccountSlots =>
+    Object.fromEntries(
+      Object.entries(value).map(([slot, selected]) => [
+        slot,
+        "id" in selected ? retainedAccount(selected) : selected.map(retainedAccount),
+      ]),
+    );
+  return {
+    app: slots(accounts.app),
+    ...(accounts.user === undefined ? {} : { user: slots(accounts.user) }),
+  };
+};
