+/**
+ * Moves the test clock 100 ms at a time, so a timer started after a step returns fires at most
+ * 100 ms late. Fails instead of hanging when the condition never holds.
+ */
+const advanceUntil = (done: () => boolean) =>
+  Effect.gen(function* () {
+    for (let step = 0; step < 400 && !done(); step++) yield* TestClock.adjust("100 millis");
+    if (!done()) return yield* Effect.die(new Error("Condition never held in 40 virtual seconds"));
+  });
+
+/** Answers in memory, so no request is on the network while the test clock moves. */
+const hangingEmulator = (hangs: number) => {
+  let calls = 0;
+  const client = HttpClient.make((request) =>
+    Effect.suspend(() =>
+      ++calls <= hangs
+        ? Effect.never
+        : Effect.succeed(
+            HttpClientResponse.fromWeb(
+              request,
+              new Response(JSON.stringify({ ready: true, secret }), {
+                headers: { "content-type": "application/json" },
+              }),
+            ),
+          ),
+    ),
+  );
+  return { client, calls: () => calls };
+};
+
+const retryLogs = () => {
+  const lines: string[] = [];
+  const logger = Logger.make(({ message, fiber }) => {
+    lines.push(
+      `${[message].flat().join(" ")} ${JSON.stringify(fiber.getRef(References.CurrentLogAnnotations))}`,
+    );
+  });
+  return { lines, layer: Logger.layer([logger]) };
+};
