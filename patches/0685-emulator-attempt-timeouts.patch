+export interface ProvisioningPolicy {
+  /**
+   * Abandons a hung request so the rest of the budget goes to a fresh one, and retries the timeout.
+   * Only requests that converge when repeated may set it: an abandoned request may still land.
+   */
+  readonly attemptTimeout?: Duration.Input;
+}
