diff --git a/apps/hosted/cloud/scripts/pool-token-retirement-apply.ts b/apps/hosted/cloud/scripts/pool-token-retirement-apply.ts
new file mode 100644
index 0000000000000000000000000000000000000000..69ef4c5bc3ab8c6c8acc74363eb0ec492d4c1782
--- /dev/null
+++ b/apps/hosted/cloud/scripts/pool-token-retirement-apply.ts
@@ -0,0 +1,231 @@
+import { Effect, Schema } from "effect";
+import type { PoolClient } from "pg";
+import {
+  Checkpoint,
+  ReportEnvelope,
+  RetirementConfiguration,
+  RetirementRefused,
+  RetirementRequest,
+  reportFreshMs,
+} from "./pool-token-retirement-contracts.ts";
+import { retirementCheckpoints } from "./pool-token-retirement-checkpoint.ts";
+import { retirementDatabase } from "./pool-token-retirement-database.ts";
+import {
+  inventoryFresh,
+  joinRetirementPool,
+  type RetirementInventory,
+} from "./pool-token-retirement-inventory.ts";
+import { retirementReader } from "./pool-token-retirement-reader.ts";
+
+export const retirePoolTokens = (
+  client: PoolClient,
+  request: typeof RetirementRequest.Type,
+  configuration: typeof RetirementConfiguration.Type,
+  envelope: typeof ReportEnvelope.Type,
+  inventory: RetirementInventory,
+  directory: string,
+  mode: "apply" | "recover",
+) =>
+  Effect.gen(function* () {
+    const report = envelope.report;
+    const ids = request.accounts.toSorted();
+    const reportedIds = report.accounts.map((account) => account.account).toSorted();
+    if (
+      new Set(ids).size !== ids.length ||
+      new Set(reportedIds).size !== reportedIds.length ||
+      (mode === "apply"
+        ? JSON.stringify(ids) !== JSON.stringify(reportedIds)
+        : ids.some((id) => !reportedIds.includes(id)))
+    )
+      return yield* new RetirementRefused({ reason: "report_ids_changed" });
+    if (
+      report.target !== configuration.target ||
+      inventory.target !== configuration.target ||
+      report.organization !== request.organization
+    )
+      return yield* new RetirementRefused({ reason: "report_target_changed" });
+    if (
+      report.external === null ||
+      report.external.homeHash !== inventory.homeHash ||
+      report.external.storageHash !== inventory.storageHash
+    )
+      return yield* new RetirementRefused({ reason: "report_inventory_changed" });
+    if (
+      report.accounts.some(
+        (account) => account.disposition !== "retire" || account.blockers.length !== 0,
+      )
+    )
+      return yield* new RetirementRefused({ reason: "report_has_blocked_accounts" });
+    const reader = yield* retirementReader(client, request.organization, configuration);
+    const database = retirementDatabase(reader, request.organization, envelope.sha256);
+    const checkpoints = yield* retirementCheckpoints(directory, configuration);
+    const identity = yield* reader.identity;
+    if (identity.database !== report.database)
+      return yield* new RetirementRefused({ reason: "report_database_changed" });
+    const fresh = Effect.gen(function* () {
+      const current = yield* reader.identity;
+      const now = Date.parse(current.snapshot),
+        at = Date.parse(report.snapshot),
+        until = Date.parse(report.expiresAt);
+      if (
+        !Number.isFinite(now) ||
+        !Number.isFinite(at) ||
+        until !== at + reportFreshMs ||
+        now < at - 5_000 ||
+        now > until ||
+        !inventoryFresh(inventory, now)
+      )
+        return yield* new RetirementRefused({ reason: "report_expired" });
+    });
+    // Validate all pending IDs before creating even the manual journal row. A completed batch
+    // may be read back after expiry, but no pending deletion gets that exception.
+    if (mode === "apply")
+      for (const candidate of report.accounts) {
+        if (!(yield* database.outcome(candidate.account))?.startsWith("deleted:")) yield* fresh;
+      }
+    const items: {
+      account: string;
+      outcome: string;
+      checkpoint: string;
+      alreadyRecorded: boolean;
+    }[] = [];
+    for (const candidate of report.accounts.filter((entry) => ids.includes(entry.account))) {
+      const result = yield* database
+        .transaction(
+          Effect.gen(function* () {
+            if (
+              candidate.pool === null ||
+              candidate.provider === null ||
+              candidate.replacement === null ||
+              candidate.person === null
+            )
+              return yield* new RetirementRefused({ reason: "report_provenance_missing" });
+            const pool = candidate.pool,
+              person = candidate.person;
+            yield* database.claim;
+            yield* database.lock(
+              candidate.account,
+              candidate.pool,
+              candidate.provider,
+              candidate.replacement,
+            );
+            const recorded = yield* database.outcome(candidate.account);
+            const current = yield* reader.account(candidate.account);
+            if (mode === "recover") {
+              const saved = yield* checkpoints.read(envelope.sha256, candidate.account);
+              if (saved.checkpoint.organization !== request.organization)
+                return yield* new RetirementRefused({ reason: "checkpoint_ownership_changed" });
+              if (recorded === `restored:${saved.digest}` && current !== undefined) {
+                const present = yield* database.snapshot(candidate.account, true);
+                if (JSON.stringify(present) !== JSON.stringify(saved.checkpoint.rows))
+                  return yield* new RetirementRefused({ reason: "recovery_destination_changed" });
+                return {
+                  account: candidate.account,
+                  outcome: "restored",
+                  checkpoint: saved.digest,
+                  alreadyRecorded: true,
+                };
+              }
+              if (recorded !== `deleted:${saved.digest}` || current !== undefined)
+                return yield* new RetirementRefused({ reason: "recovery_destination_occupied" });
+              yield* database.restore(candidate.account, saved.checkpoint.rows);
+              if (
+                JSON.stringify(yield* database.snapshot(candidate.account, true)) !==
+                JSON.stringify(saved.checkpoint.rows)
+              )
+                return yield* new RetirementRefused({ reason: "recovery_readback_failed" });
+              yield* database.record(candidate.account, `restored:${saved.digest}`);
+              return {
+                account: candidate.account,
+                outcome: "restored",
+                checkpoint: saved.digest,
+                alreadyRecorded: false,
+              };
+            }
+            if (recorded !== undefined) {
+              const saved = yield* checkpoints.read(envelope.sha256, candidate.account);
+              if (recorded !== `deleted:${saved.digest}` || current !== undefined)
+                return yield* new RetirementRefused({ reason: "recorded_outcome_changed" });
+              return {
+                account: candidate.account,
+                outcome: "deleted",
+                checkpoint: saved.digest,
+                alreadyRecorded: true,
+              };
+            }
+            const recheck = Effect.gen(function* () {
+              yield* fresh;
+              const facts = yield* reader.inspect(candidate.account);
+              const external = joinRetirementPool(inventory, request.organization, pool, person);
+              if (
+                facts.disposition !== "retire" ||
+                facts.fingerprint !== candidate.fingerprint ||
+                external.blockers.length > 0
+              )
+                return yield* new RetirementRefused({ reason: "candidate_changed" });
+            });
+            yield* recheck;
+            const checkpoint = yield* Schema.decodeUnknownEffect(Checkpoint)({
+              version: 1,
+              target: configuration.target,
+              organization: request.organization,
+              account: candidate.account,
+              reportSha256: envelope.sha256,
+              rows: yield* database.snapshot(candidate.account, true),
+            });
+            const digest = yield* checkpoints.save(checkpoint);
+            // The same account and policy locks remain held while the encrypted recovery point is fsynced.
+            yield* recheck;
+            yield* database.remove(candidate.account);
+            yield* database.record(candidate.account, `deleted:${digest}`);
+            return {
+              account: candidate.account,
+              outcome: "deleted",
+              checkpoint: digest,
+              alreadyRecorded: false,
+            };
+          }),
+        )
+        .pipe(
+          Effect.match({
+            onFailure: (error) => ({
+              ok: false as const,
+              reason: error instanceof RetirementRefused ? error.reason : "operation_unavailable",
+            }),
+            onSuccess: (item) => ({ ok: true as const, item }),
+          }),
+        );
+      if (!result.ok)
+        return {
+          complete: false,
+          mode,
+          writePerformed: null,
+          reportSha256: envelope.sha256,
+          items,
+          stoppedAt: candidate.account,
+          reason: result.reason,
+          externalActions: [],
+        };
+      const readback = yield* reader.account(candidate.account);
+      if ((mode === "apply") !== (readback === undefined))
+        return {
+          complete: false,
+          mode,
+          writePerformed: null,
+          reportSha256: envelope.sha256,
+          items,
+          stoppedAt: candidate.account,
+          reason: "post_commit_readback_changed",
+          externalActions: [],
+        };
+      items.push(result.item);
+    }
+    return {
+      complete: true,
+      mode,
+      writePerformed: items.some((item) => !item.alreadyRecorded),
+      reportSha256: envelope.sha256,
+      items,
+      externalActions: [],
+    };
+  }).pipe(Effect.withTracerEnabled(false));
diff --git a/apps/hosted/cloud/scripts/pool-token-retirement-checkpoint.ts b/apps/hosted/cloud/scripts/pool-token-retirement-checkpoint.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bf39588cfe5cf542cc29f31ba23cd5e5a8cdd0a3
--- /dev/null
+++ b/apps/hosted/cloud/scripts/pool-token-retirement-checkpoint.ts
@@ -0,0 +1,104 @@
+import { AccountId, aesGcmCredentials } from "@executor-js/sdk/core";
+import { createHash } from "node:crypto";
+import { constants } from "node:fs";
+import { mkdir, open, stat } from "node:fs/promises";
+import { join } from "node:path";
+import { Effect, Redacted, Schema } from "effect";
+import {
+  Checkpoint,
+  RetirementConfiguration,
+  RetirementRefused,
+  RetirementUnavailable,
+} from "./pool-token-retirement-contracts.ts";
+
+export const sha256 = (value: string | Uint8Array) =>
+  createHash("sha256").update(value).digest("hex");
+const io = <A>(run: () => Promise<A>) =>
+  Effect.tryPromise({ try: run, catch: () => new RetirementUnavailable() });
+
+/** A checkpoint contains the original ciphertext and private metadata, so its entire file is encrypted. */
+export const retirementCheckpoints = (
+  directory: string,
+  configuration: typeof RetirementConfiguration.Type,
+) =>
+  Effect.gen(function* () {
+    const credentials = yield* aesGcmCredentials(configuration.encryptionKey, crypto);
+    const binding = (report: string, account: typeof AccountId.Type) =>
+      Schema.decodeUnknownSync(AccountId)(
+        `acc_retirement_${sha256(JSON.stringify([configuration.target, report, account]))}`,
+      );
+    const path = (report: string, account: typeof AccountId.Type) =>
+      join(directory, `${sha256(JSON.stringify([report, account]))}.enc`);
+    const read = (report: string, account: typeof AccountId.Type) =>
+      Effect.gen(function* () {
+        const bytes = yield* io(async () => {
+          const file = await open(path(report, account), constants.O_RDONLY | constants.O_NOFOLLOW);
+          try {
+            const info = await file.stat();
+            if (!info.isFile() || info.size > 2_000_000 || (info.mode & 0o077) !== 0)
+              throw new Error("Private checkpoint required");
+            return new Uint8Array(await file.readFile());
+          } finally {
+            await file.close();
+          }
+        });
+        const fields = yield* credentials.decrypt(binding(report, account), Redacted.make(bytes));
+        const checkpoint = yield* Schema.decodeUnknownEffect(Schema.fromJsonString(Checkpoint))(
+          Redacted.value(fields).checkpoint,
+        );
+        if (
+          checkpoint.target !== configuration.target ||
+          checkpoint.reportSha256 !== report ||
+          checkpoint.account !== account
+        )
+          return yield* new RetirementRefused({ reason: "checkpoint_binding_changed" });
+        return { checkpoint, digest: sha256(bytes) };
+      });
+    const save = (checkpoint: typeof Checkpoint.Type) =>
+      Effect.gen(function* () {
+        const json = JSON.stringify(checkpoint);
+        if (Buffer.byteLength(json) > 1_000_000)
+          return yield* new RetirementRefused({ reason: "checkpoint_limit_exceeded" });
+        const bytes = yield* credentials.encrypt(
+          binding(checkpoint.reportSha256, checkpoint.account),
+          Redacted.make({ checkpoint: json }),
+        );
+        yield* io(async () => {
+          await mkdir(directory, { recursive: true, mode: 0o700 });
+          const info = await stat(directory);
+          if (!info.isDirectory() || (info.mode & 0o077) !== 0)
+            throw new Error("Private checkpoint directory required");
+          const destination = path(checkpoint.reportSha256, checkpoint.account);
+          // Exclusive creation preserves the first recovery point after a rollback or an uncertain commit.
+          const file = await open(destination, "wx", 0o600).catch((error: unknown) => {
+            if (
+              typeof error === "object" &&
+              error !== null &&
+              "code" in error &&
+              error.code === "EEXIST"
+            )
+              return null;
+            throw error;
+          });
+          if (file !== null) {
+            try {
+              await file.writeFile(bytes);
+              await file.sync();
+            } finally {
+              await file.close();
+            }
+            const folder = await open(directory, "r");
+            try {
+              await folder.sync();
+            } finally {
+              await folder.close();
+            }
+          }
+        });
+        const retained = yield* read(checkpoint.reportSha256, checkpoint.account);
+        if (JSON.stringify(retained.checkpoint) !== json)
+          return yield* new RetirementRefused({ reason: "checkpoint_source_changed" });
+        return retained.digest;
+      });
+    return { read, save };
+  });
diff --git a/apps/hosted/cloud/scripts/pool-token-retirement-contracts.ts b/apps/hosted/cloud/scripts/pool-token-retirement-contracts.ts
new file mode 100644
index 0000000000000000000000000000000000000000..eea481c0b276ec4f41ac8730fff27d5d6582fc23
--- /dev/null
+++ b/apps/hosted/cloud/scripts/pool-token-retirement-contracts.ts
@@ -0,0 +1,117 @@
+import { AccountId } from "@executor-js/sdk/core";
+import { Schema } from "effect";
+
+export const Identifier = Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(512));
+export const Hash = Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/u));
+const HexKey = Schema.RedactedFromValue(
+  Schema.String.check(Schema.isPattern(/^[0-9a-fA-F]{64}$/u)),
+);
+export const RetirementRequest = Schema.Struct({
+  organization: Identifier,
+  accounts: Schema.Array(AccountId).check(Schema.isMinLength(1), Schema.isMaxLength(100)),
+});
+export const RetirementConfiguration = Schema.Struct({
+  target: Identifier,
+  database: Schema.RedactedFromValue(
+    Schema.String.check(Schema.isPattern(/^postgres(?:ql)?:\/\//u)),
+  ),
+  encryptionKey: HexKey,
+  poolSigningKeys: Schema.Array(HexKey).check(Schema.isMinLength(1), Schema.isMaxLength(2)),
+});
+export const References = Schema.Array(Schema.Record(Schema.String, Schema.NullOr(Identifier)));
+export const Candidate = Schema.Struct({
+  account: AccountId,
+  exists: Schema.Boolean,
+  provider: Schema.NullOr(Identifier),
+  method: Schema.NullOr(Identifier),
+  generation: Schema.NullOr(Schema.Int),
+  policyRevision: Schema.NullOr(Identifier),
+  pool: Schema.NullOr(Identifier),
+  person: Schema.NullOr(Identifier),
+  replacement: Schema.NullOr(AccountId),
+  replacementGeneration: Schema.NullOr(Schema.Int),
+  replacementPolicyRevision: Schema.NullOr(Identifier),
+  signedClaimsVerified: Schema.Boolean,
+  replacementVerified: Schema.Boolean,
+  fingerprint: Hash,
+  disposition: Schema.Literals(["retire", "keep", "missing"]),
+  blockers: Schema.Array(Schema.String),
+  dependencies: Schema.Record(Schema.String, References),
+});
+export const ExternalPool = Schema.Struct({
+  pool: Identifier,
+  person: Identifier,
+  blockers: Schema.Array(Schema.String),
+  channels: Schema.Array(Identifier),
+  keys: Schema.Array(
+    Schema.Struct({
+      id: Identifier,
+      user: Schema.NullOr(Identifier),
+      channels: Schema.Array(Identifier),
+      deleted: Schema.Boolean,
+    }),
+  ),
+  computers: References,
+  memberships: Schema.Array(
+    Schema.Struct({
+      id: Identifier,
+      channel: Identifier,
+      credential: Identifier,
+      deleted: Schema.Boolean,
+    }),
+  ),
+});
+export const ExternalEvidence = Schema.Struct({
+  target: Identifier,
+  homeHash: Hash,
+  storageHash: Hash,
+  homeSnapshot: Identifier,
+  storageSnapshot: Identifier,
+  pools: Schema.Array(ExternalPool),
+});
+export const RetirementReport = Schema.Struct({
+  version: Schema.Literal(1),
+  mode: Schema.Literal("dry-run"),
+  writePerformed: Schema.Literal(false),
+  applySupported: Schema.Literal(true),
+  migrationGo: Schema.Literal(false),
+  target: Identifier,
+  organization: Identifier,
+  database: Identifier,
+  snapshot: Identifier,
+  expiresAt: Identifier,
+  accounts: Schema.Array(Candidate),
+  external: Schema.NullOr(ExternalEvidence),
+  requiredBeforeProductionApply: Schema.Array(Schema.String),
+  externalActions: Schema.Array(Schema.String),
+});
+export const ReportEnvelope = Schema.Struct({ report: RetirementReport, sha256: Hash });
+export const CheckpointRows = Schema.Struct({
+  account: Schema.Record(Schema.String, Schema.Json),
+  policy: Schema.Record(Schema.String, Schema.Json),
+  checks: Schema.Array(Schema.Record(Schema.String, Schema.Json)),
+  reports: Schema.Array(Schema.Record(Schema.String, Schema.Json)),
+  observations: Schema.Array(Schema.Record(Schema.String, Schema.Json)),
+  driverChecks: Schema.Array(Schema.Record(Schema.String, Schema.Json)),
+  observationAccess: Schema.Array(Schema.Record(Schema.String, Schema.Json)),
+});
+export const Checkpoint = Schema.Struct({
+  version: Schema.Literal(1),
+  target: Identifier,
+  organization: Identifier,
+  account: AccountId,
+  reportSha256: Hash,
+  rows: CheckpointRows,
+});
+export class RetirementUnavailable extends Schema.TaggedError<RetirementUnavailable>()(
+  "RetirementUnavailable",
+  {},
+) {}
+export class RetirementRefused extends Schema.TaggedError<RetirementRefused>()(
+  "RetirementRefused",
+  {
+    reason: Schema.String,
+  },
+) {}
+export const reportFreshMs = 5 * 60_000;
+export const retirementStep = "basalt-retired-pool-tokens-v1:";
diff --git a/apps/hosted/cloud/scripts/pool-token-retirement-database.ts b/apps/hosted/cloud/scripts/pool-token-retirement-database.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d7b9d11aa762d33b9fbb4c32578d273695706c7c
--- /dev/null
+++ b/apps/hosted/cloud/scripts/pool-token-retirement-database.ts
@@ -0,0 +1,147 @@
+import { Effect, Schema } from "effect";
+import {
+  CheckpointRows,
+  Identifier,
+  RetirementRefused,
+  retirementStep,
+} from "./pool-token-retirement-contracts.ts";
+import { retirementReader } from "./pool-token-retirement-reader.ts";
+
+type Reader = Effect.Success<ReturnType<typeof retirementReader>>;
+const Row = Schema.Record(Schema.String, Schema.Json);
+const Records = Schema.Array(Schema.Struct({ row: Row }));
+// This is the current SDK's plain-secret removal layout. Identity, OAuth and acquisition
+// lifecycles are refused by the reader, rather than approximated by this private operation.
+const sidecars = [
+  { field: "checks", table: "executor_account_checks", key: "account" },
+  { field: "reports", table: "executor_account_reports", key: "id" },
+  { field: "observations", table: "executor_account_observations", key: "account" },
+  { field: "driverChecks", table: "executor_account_driver_checks", key: "account" },
+  { field: "observationAccess", table: "hosted_account_observation_access", key: "account_id" },
+] as const;
+
+export const retirementDatabase = (reader: Reader, organization: string, report: string) => {
+  const name = retirementStep + report;
+  const transaction = <A, E, R>(body: Effect.Effect<A, E, R>) =>
+    Effect.acquireUseRelease(
+      reader.query("BEGIN"),
+      () =>
+        Effect.gen(function* () {
+          yield* reader.query("SET LOCAL statement_timeout = '3s'");
+          yield* reader.query("SET LOCAL lock_timeout = '500ms'");
+          yield* reader.query("SET LOCAL idle_in_transaction_session_timeout = '5s'");
+          const value = yield* body;
+          yield* reader.query("COMMIT");
+          return value;
+        }),
+      () => reader.query("ROLLBACK").pipe(Effect.ignore),
+    );
+  const outcome = (account: string) =>
+    reader
+      .query(
+        `select outcome from private_hosted_data_step_items
+    where name = $1 and run = 'apply' and item = $2 and owner = $3`,
+        [name, account, `organization:${organization}`],
+      )
+      .pipe(
+        Effect.flatMap(
+          Schema.decodeUnknownEffect(Schema.Array(Schema.Struct({ outcome: Identifier }))),
+        ),
+        Effect.map((rows) => rows[0]?.outcome),
+      );
+  const claim = Effect.gen(function* () {
+    yield* reader.query(
+      `insert into private_hosted_data_steps (name, run, mode) values ($1, 'apply', 'apply') on conflict do nothing`,
+      [name],
+    );
+    yield* reader.query(
+      `select name from private_hosted_data_steps where name = $1 and run = 'apply' for update`,
+      [name],
+    );
+  });
+  const record = (account: string, value: string) =>
+    reader.query(
+      `insert into private_hosted_data_step_items (name, run, item, owner, outcome, pass)
+    values ($1, 'apply', $2, $3, $4, 1) on conflict (name, run, item) do update set outcome = excluded.outcome`,
+      [name, account, `organization:${organization}`, value],
+    );
+  const lock = (account: string, pool: string, provider: string, replacement: string) =>
+    Effect.gen(function* () {
+      yield* reader.query("select id from organization where id = $1 for update", [organization]);
+      yield* reader.query("select id from executor_apps where id = $1 for update", [pool]);
+      yield* reader.query("select id from executor_providers where id = $1 for update", [provider]);
+      yield* reader.query(
+        "select id from executor_accounts where id in ($1, $2) order by id for update",
+        [account, replacement],
+      );
+      yield* reader.query(
+        "select account_id from hosted_account_access where account_id in ($1, $2) order by account_id for update",
+        [account, replacement],
+      );
+    });
+  const rows = (table: string, key: string, account: string, locked: boolean) =>
+    reader
+      .query(
+        `select to_jsonb(r) as row from ${table} r where ${key} = $1${locked ? " for update" : ""}`,
+        [account],
+      )
+      .pipe(
+        Effect.flatMap(Schema.decodeUnknownEffect(Records)),
+        Effect.map((entries) =>
+          entries
+            .map((entry) => entry.row)
+            .toSorted((a, b) => JSON.stringify(a).localeCompare(JSON.stringify(b))),
+        ),
+      );
+  const snapshot = (account: string, locked: boolean) =>
+    Effect.gen(function* () {
+      const accounts = yield* rows("executor_accounts", "id", account, locked);
+      const policies = yield* rows("hosted_account_access", "account_id", account, locked);
+      if (accounts.length !== 1 || policies.length !== 1)
+        return yield* new RetirementRefused({ reason: "checkpoint_source_missing" });
+      const caches = yield* Effect.forEach(sidecars, (sidecar) =>
+        rows(sidecar.table, sidecar.key, account, locked).pipe(
+          Effect.map((entries) => [sidecar.field, entries] as const),
+        ),
+      );
+      return yield* Schema.decodeUnknownEffect(CheckpointRows)({
+        account: accounts[0],
+        policy: policies[0],
+        ...Object.fromEntries(caches),
+      });
+    });
+  const remove = (account: string) =>
+    Effect.gen(function* () {
+      for (const sidecar of sidecars)
+        yield* reader.query(`delete from ${sidecar.table} where ${sidecar.key} = $1`, [account]);
+      const removed = yield* reader.query(
+        "delete from executor_accounts where id = $1 and owner = $2 returning id",
+        [account, `organization:${organization}`],
+      );
+      if (removed.length !== 1)
+        return yield* new RetirementRefused({ reason: "deletion_readback_failed" });
+    });
+  const restore = (account: string, saved: typeof CheckpointRows.Type) =>
+    Effect.gen(function* () {
+      if (
+        saved.account.id !== account ||
+        saved.account.owner !== `organization:${organization}` ||
+        saved.policy.account_id !== account ||
+        saved.policy.organization_id !== organization
+      )
+        return yield* new RetirementRefused({ reason: "checkpoint_ownership_changed" });
+      for (const sidecar of sidecars)
+        if ((yield* rows(sidecar.table, sidecar.key, account, true)).length > 0)
+          return yield* new RetirementRefused({ reason: "recovery_destination_occupied" });
+      const insert = (table: string, value: typeof Row.Type) =>
+        reader.query(
+          `insert into ${table} select * from jsonb_populate_record(null::${table}, $1::jsonb)`,
+          [JSON.stringify(value)],
+        );
+      yield* insert("executor_accounts", saved.account);
+      yield* insert("hosted_account_access", saved.policy);
+      for (const sidecar of sidecars)
+        for (const entry of saved[sidecar.field]) yield* insert(sidecar.table, entry);
+    });
+  return { transaction, outcome, claim, record, lock, snapshot, remove, restore };
+};
diff --git a/apps/hosted/cloud/scripts/pool-token-retirement-inventory.ts b/apps/hosted/cloud/scripts/pool-token-retirement-inventory.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5d3659a4c32aabad011771547880db92c87d8c18
--- /dev/null
+++ b/apps/hosted/cloud/scripts/pool-token-retirement-inventory.ts
@@ -0,0 +1,287 @@
+import { createHash } from "node:crypto";
+import { Schema } from "effect";
+import {
+  Hash,
+  Identifier,
+  RetirementRefused,
+  reportFreshMs,
+} from "./pool-token-retirement-contracts.ts";
+
+const Source = Schema.Literals(["pool-v1", "pool-storage-v1"]);
+const Common = { inventory: Source, run: Identifier };
+const Record = Schema.Union([
+  Schema.Struct({
+    ...Common,
+    event: Schema.Literal("part"),
+    index: Schema.Int,
+    data: Schema.String,
+  }),
+  Schema.Struct({
+    ...Common,
+    event: Schema.Literal("end"),
+    complete: Schema.Boolean,
+    sha256: Schema.optionalKey(Hash),
+    chunks: Schema.optionalKey(Schema.Int),
+    bytes: Schema.optionalKey(Schema.Int),
+    coverage: Schema.optionalKey(Schema.Array(Schema.String)),
+    migrationGo: Schema.Literal(false),
+  }),
+]);
+export const InventoryBundle = Schema.Struct({
+  target: Identifier,
+  homeRun: Identifier,
+  storageRun: Identifier,
+  records: Schema.Array(Record).check(Schema.isMaxLength(100)),
+});
+const Home = Schema.Struct({
+  snapshot: Identifier,
+  sections: Schema.Struct({
+    credentials: Schema.Array(
+      Schema.Struct({
+        uuid: Identifier,
+        id: Schema.NullOr(Identifier),
+        index: Schema.NullOr(Identifier),
+        provider: Schema.NullOr(Identifier),
+        disabled: Schema.Boolean,
+        deleted: Schema.Boolean,
+      }),
+    ),
+    keys: Schema.Array(
+      Schema.Struct({
+        id: Identifier,
+        user_id: Schema.NullOr(Identifier),
+        channels: Schema.NullOr(Schema.Array(Schema.Int)),
+        deleted: Schema.Boolean,
+      }),
+    ),
+    channels: Schema.Array(
+      Schema.Struct({
+        id: Identifier,
+        pool: Schema.NullOr(Identifier),
+        disabled: Schema.Boolean,
+        deleted: Schema.Boolean,
+      }),
+    ),
+    memberships: Schema.Array(
+      Schema.Struct({
+        id: Identifier,
+        channel_group_id: Identifier,
+        auth_id: Identifier,
+        deleted: Schema.Boolean,
+      }),
+    ),
+  }),
+});
+const Storage = Schema.Struct({
+  snapshot: Identifier,
+  absentKeys: Schema.Array(Schema.String),
+  computers: Schema.NullOr(
+    Schema.Array(
+      Schema.Struct({
+        id: Identifier,
+        user: Identifier,
+        pool: Identifier,
+        state: Identifier,
+        keyId: Schema.NullOr(Schema.Int),
+        userId: Schema.NullOr(Schema.Int),
+        toolsKeyId: Schema.NullOr(Identifier),
+        switching: Schema.Array(Identifier),
+        switchingTo: Schema.NullOr(Identifier),
+      }),
+    ),
+  ),
+  pools: Schema.NullOr(
+    Schema.Array(
+      Schema.Struct({
+        pool: Identifier,
+        owner: Identifier,
+        organization: Identifier,
+        users: Schema.Array(Identifier),
+        pending: Schema.Array(Identifier),
+        provisioned: Schema.Array(Identifier),
+        deleted: Schema.Boolean,
+      }),
+    ),
+  ),
+  attribution: Schema.NullOr(
+    Schema.Struct({
+      assigned: Schema.Array(Identifier),
+      locks: Schema.Array(
+        Schema.Struct({
+          provider: Identifier,
+          pool: Identifier,
+          snapshot: Schema.Array(Identifier),
+          unconfirmedUploads: Schema.Array(Identifier),
+        }),
+      ),
+      sessions: Schema.Array(
+        Schema.Struct({
+          pool: Identifier,
+          provider: Identifier,
+          accountId: Schema.NullOr(Identifier),
+          pendingIds: Schema.Array(Identifier),
+        }),
+      ),
+      uploads: Schema.Array(
+        Schema.Struct({ pool: Identifier, id: Identifier, assigned: Schema.Boolean }),
+      ),
+    }),
+  ),
+});
+
+const unavailable = () => {
+  throw new RetirementRefused({ reason: "external_inventory_invalid" });
+};
+const reconstruct = (
+  bundle: typeof InventoryBundle.Type,
+  source: typeof Source.Type,
+  run: string,
+  coverage: ReadonlyArray<string>,
+) => {
+  const records = bundle.records.filter((entry) => entry.inventory === source && entry.run === run);
+  const ends = records.filter((entry) => entry.event === "end");
+  const end = ends[0];
+  if (
+    ends.length !== 1 ||
+    end?.complete !== true ||
+    end.sha256 === undefined ||
+    end.chunks === undefined ||
+    end.bytes === undefined ||
+    end.coverage === undefined ||
+    !coverage.every((name) => end.coverage?.includes(name))
+  )
+    return unavailable();
+  const parts = records
+    .filter((entry) => entry.event === "part")
+    .toSorted((a, b) => a.index - b.index);
+  if (
+    parts.length !== end.chunks ||
+    parts.length < 1 ||
+    parts.some((part, index) => part.index !== index || part.data.length > 8_000)
+  )
+    return unavailable();
+  const text = parts.map((part) => part.data).join("");
+  if (
+    Buffer.byteLength(text) !== end.bytes ||
+    end.bytes > 120_000 ||
+    createHash("sha256").update(text).digest("hex") !== end.sha256
+  )
+    return unavailable();
+  return { text, hash: end.sha256 };
+};
+
+export const readRetirementInventory = (raw: unknown) => {
+  const bundle = Schema.decodeUnknownSync(InventoryBundle)(raw);
+  const home = reconstruct(bundle, "pool-v1", bundle.homeRun, [
+    "home-credentials",
+    "home-keys",
+    "home-channels",
+    "home-memberships",
+  ]);
+  const storage = reconstruct(bundle, "pool-storage-v1", bundle.storageRun, [
+    "computer-registry-v1",
+    "pool-directory-v1",
+    "pool-control-v1",
+  ]);
+  return {
+    target: bundle.target,
+    homeHash: home.hash,
+    storageHash: storage.hash,
+    home: Schema.decodeUnknownSync(Schema.fromJsonString(Home))(home.text),
+    storage: Schema.decodeUnknownSync(Schema.fromJsonString(Storage))(storage.text),
+  };
+};
+export type RetirementInventory = ReturnType<typeof readRetirementInventory>;
+
+export const inventoryFresh = (inventory: RetirementInventory, at: number) =>
+  [inventory.home.snapshot, inventory.storage.snapshot].every((snapshot) => {
+    const age = at - Date.parse(snapshot);
+    return Number.isFinite(age) && age >= -5_000 && age <= reportFreshMs;
+  });
+
+/** Home keys route through channel IDs; computers retain the exact Home key IDs they own. */
+export const joinRetirementPool = (
+  inventory: RetirementInventory,
+  organization: string,
+  pool: string,
+  person: string,
+) => {
+  const blockers: string[] = [];
+  const storage = inventory.storage,
+    home = inventory.home.sections;
+  if (
+    storage.absentKeys.length > 0 ||
+    storage.computers === null ||
+    storage.pools === null ||
+    storage.attribution === null
+  )
+    blockers.push("pool_storage_incomplete");
+  const entries = storage.pools?.filter((entry) => entry.pool === pool) ?? [];
+  const entry = entries[0];
+  if (
+    entries.length !== 1 ||
+    entry?.organization !== organization ||
+    entry.owner !== person ||
+    entry.deleted
+  )
+    blockers.push("pool_directory_unproven");
+  const channels = home.channels.filter((channel) => channel.pool === pool && !channel.deleted);
+  if (channels.length > 1 || channels.some((channel) => channel.disabled))
+    blockers.push("backend_pool_ambiguous");
+  const channelIds = channels.map((channel) => channel.id);
+  const keys = home.keys.filter((key) =>
+    key.channels?.some((channel) => channelIds.includes(String(channel))),
+  );
+  if (home.keys.some((key) => !key.deleted && (key.channels === null || key.channels.length === 0)))
+    blockers.push("unrestricted_backend_key");
+  const computers = (storage.computers ?? []).filter((computer) =>
+    [computer.pool, ...computer.switching, computer.switchingTo].includes(pool),
+  );
+  for (const computer of computers) {
+    if (
+      ["issuing", "revoking"].includes(computer.state) ||
+      computer.switching.length > 0 ||
+      computer.switchingTo !== null
+    )
+      blockers.push("computer_operation_inflight");
+    if (computer.state === "active" && computer.keyId !== null) {
+      const found = keys.filter((key) => key.id === String(computer.keyId) && !key.deleted);
+      if (found.length !== 1 || found[0]?.user_id !== String(computer.userId))
+        blockers.push("computer_key_unproven");
+    }
+  }
+  if (
+    (entry?.pending.length ?? 0) > 0 ||
+    storage.attribution?.locks.some((lock) => lock.pool === pool) ||
+    storage.attribution?.sessions.some((session) => session.pool === pool) ||
+    storage.attribution?.uploads.some((upload) => upload.pool === pool)
+  )
+    blockers.push("pool_operation_inflight");
+  return {
+    pool,
+    person,
+    blockers: [...new Set(blockers)],
+    channels: channelIds,
+    keys: keys.map((key) => ({
+      id: key.id,
+      user: key.user_id,
+      channels: (key.channels ?? []).map(String),
+      deleted: key.deleted,
+    })),
+    computers: computers.map((computer) => ({
+      id: computer.id,
+      user: computer.user,
+      key: computer.keyId === null ? null : String(computer.keyId),
+      toolsKey: computer.toolsKeyId,
+      state: computer.state,
+    })),
+    memberships: home.memberships
+      .filter((membership) => channelIds.includes(membership.channel_group_id))
+      .map((membership) => ({
+        id: membership.id,
+        channel: membership.channel_group_id,
+        credential: membership.auth_id,
+        deleted: membership.deleted,
+      })),
+  };
+};
diff --git a/apps/hosted/cloud/scripts/pool-token-retirement-queries.ts b/apps/hosted/cloud/scripts/pool-token-retirement-queries.ts
