@@ -0,0 +1,113 @@
+import { createHash } from "node:crypto";
+import { retirementTarget } from "./retired-pool-token-command.ts";
+
+/** The retained private inventories include live backend keys, which retirement must leave alone. */
+export const retirementInventory = (organization: string, pool: string, person: string) => {
+  const snapshot = new Date().toISOString();
+  const home = {
+    snapshot,
+    sections: {
+      credentials: [
+        {
+          uuid: "synthetic-native-credential",
+          id: "credential-1",
+          index: "1",
+          provider: "openai",
+          disabled: false,
+          deleted: false,
+        },
+      ],
+      keys: [{ id: "7", user_id: "9", channels: [11], deleted: false }],
+      channels: [{ id: "11", pool, disabled: false, deleted: false }],
+      memberships: [
+        {
+          id: "13",
+          channel_group_id: "11",
+          auth_id: "synthetic-native-credential",
+          deleted: false,
+        },
+      ],
+    },
+  };
+  const storage = {
+    snapshot,
+    absentKeys: [],
+    computers: [
+      {
+        id: "synthetic-computer",
+        user: person,
+        pool,
+        state: "active",
+        keyId: 7,
+        userId: 9,
+        toolsKeyId: null,
+        switching: [],
+        switchingTo: null,
+      },
+    ],
+    pools: [
+      {
+        pool,
+        owner: person,
+        organization,
+        users: [person],
+        pending: [],
+        provisioned: [person],
+        deleted: false,
+      },
+    ],
+    attribution: {
+      assigned: ["synthetic-native-credential"],
+      locks: [],
+      sessions: [],
+      uploads: [],
+    },
+  };
+  const records = (
+    inventory: "pool-v1" | "pool-storage-v1",
+    run: string,
+    value: unknown,
+    coverage: ReadonlyArray<string>,
+  ) => {
+    const data = JSON.stringify(value),
+      chunks = Array.from({ length: Math.ceil(data.length / 8_000) }, (_, index) => ({
+        inventory,
+        run,
+        event: "part",
+        index,
+        data: data.slice(index * 8_000, (index + 1) * 8_000),
+      }));
+    return [
+      ...chunks,
+      {
+        inventory,
+        run,
+        event: "end",
+        complete: true,
+        sha256: createHash("sha256").update(data).digest("hex"),
+        chunks: chunks.length,
+        bytes: Buffer.byteLength(data),
+        coverage,
+        migrationGo: false,
+      },
+    ];
+  };
+  return {
+    target: retirementTarget,
+    homeRun: "synthetic-home",
+    storageRun: "synthetic-storage",
+    records: [
+      ...records("pool-v1", "synthetic-home", home, [
+        "home-credentials",
+        "home-keys",
+        "home-channels",
+        "home-memberships",
+      ]),
+      ...records("pool-storage-v1", "synthetic-storage", storage, [
+        "computer-registry-v1",
+        "pool-directory-v1",
+        "pool-control-v1",
+      ]),
+    ],
+  };
+};
