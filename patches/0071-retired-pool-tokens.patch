@@ -0,0 +1,329 @@
+import { expect, layer } from "@effect/vitest";
+import { createHash, randomUUID } from "node:crypto";
+import { Effect, Schema } from "effect";
+import { withHostedHttpCase } from "../support/case.ts";
+import { Evidence } from "../support/evidence.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { retirementCommand } from "../support/retired-pool-token-command.ts";
+import { retiredTokenFixture } from "../support/retired-pool-token-fixture.ts";
+import { retirementInventory } from "../support/retired-pool-token-inventory.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Entry = Schema.Struct({
+  account: Schema.String,
+  disposition: Schema.String,
+  blockers: Schema.Array(Schema.String),
+  signedClaimsVerified: Schema.Boolean,
+  replacementVerified: Schema.Boolean,
+  dependencies: Schema.Record(
+    Schema.String,
+    Schema.Array(Schema.Record(Schema.String, Schema.NullOr(Schema.String))),
+  ),
+});
+const Output = Schema.fromJsonString(
+  Schema.Struct({
+    sha256: Schema.String,
+    report: Schema.Struct({
+      mode: Schema.Literal("dry-run"),
+      writePerformed: Schema.Literal(false),
+      applySupported: Schema.Literal(true),
+      migrationGo: Schema.Literal(false),
+      accounts: Schema.Array(Entry),
+      requiredBeforeProductionApply: Schema.Array(Schema.String),
+      external: Schema.Json,
+      externalActions: Schema.Array(Schema.String),
+    }),
+  }),
+);
+const Wire = Schema.fromJsonString(
+  Schema.Struct({ report: Schema.Record(Schema.String, Schema.Json), sha256: Schema.String }),
+);
+const Outcome = Schema.fromJsonString(
+  Schema.Struct({
+    complete: Schema.Literal(true),
+    mode: Schema.Literals(["apply", "recover"]),
+    writePerformed: Schema.Boolean,
+    items: Schema.Array(
+      Schema.Struct({
+        account: Schema.String,
+        outcome: Schema.String,
+        checkpoint: Schema.String,
+        alreadyRecorded: Schema.Boolean,
+      }),
+    ),
+    externalActions: Schema.Array(Schema.String),
+  }),
+);
+
+layer(RuntimeLive, { excludeTestServices: true })("Retired pool token operator", (it) => {
+  it.effect(scenarios.cloudRetiredPoolTokenDryRun.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* retiredTokenFixture,
+          evidence = yield* Evidence;
+        const command = yield* retirementCommand(f.organization);
+        const inventory = retirementInventory(f.organization, f.app.id, f.person),
+          inventoryBefore = JSON.stringify(inventory);
+        const before = yield* f.snapshot;
+        const dry = (ids: ReadonlyArray<string>, external: unknown = inventory) =>
+          command.execute(ids, { inventory: external }).pipe(Effect.flatMap((run) => run.run));
+        const write = (
+          raw: string,
+          ids: ReadonlyArray<string> = [f.id("unused")],
+          mode = "--apply",
+        ) =>
+          Effect.gen(function* () {
+            const envelope = yield* Schema.decodeUnknownEffect(Wire)(raw);
+            return yield* command.execute(ids, {
+              inventory,
+              report: raw,
+              flags: [mode, "--go", envelope.sha256],
+            });
+          });
+        const noInventory = yield* command.execute([f.id("unused")]);
+        const blocked = yield* noInventory.run.pipe(
+          Effect.flatMap(Schema.decodeUnknownEffect(Output)),
+        );
+        expect(blocked.report.accounts[0]?.blockers).toContain("external_inventory_required");
+        expect(blocked.report.accounts[0]?.disposition).toBe("keep");
+        const raw = yield* evidence.step(
+          "A complete inventory keeps active, linked and ambiguous accounts",
+          dry(f.ids),
+        );
+        const report = yield* Schema.decodeUnknownEffect(Output)(raw);
+        const account = (name: Parameters<typeof f.id>[0]) =>
+          report.report.accounts.find((entry) => entry.account === f.id(name));
+        expect(account("unused")).toMatchObject({
+          disposition: "retire",
+          blockers: [],
+          signedClaimsVerified: true,
+          replacementVerified: true,
+        });
+        expect(account("wrongProvider")?.blockers).toContain("retained_pool_provider_unproven");
+        expect(account("badClaims")?.blockers).toContain("signed_pool_claims_unproven");
+        expect(account("shared")?.blockers).toContain("host_personal_token_unproven");
+        expect(account("legacy")?.blockers).toContain("unsupported_account_lifecycle");
+        for (const [name, reference] of [
+          ["linked", "links"],
+          ["workflow", "workflows"],
+          ["webhook", "webhooks"],
+          ["pending", "connections"],
+          ["current", "pools"],
+        ] as const) {
+          expect(account(name)?.disposition).toBe("keep");
+          expect(account(name)?.blockers).toContain(`reference:${reference}`);
+          expect(account(name)?.dependencies[reference]).toHaveLength(1);
+        }
+        expect(report.report.requiredBeforeProductionApply).toContain("supported-encrypted-backup");
+        expect(report.report.externalActions).toEqual([]);
+        expect(JSON.stringify(report.report.external)).toContain('"id":"7"');
+        expect(JSON.stringify(report.report.external)).toContain("synthetic-native-credential");
+        for (const privateValue of [
+          ...command.privateValues,
+          f.validToken,
+          "Pool access (retired)",
+          "An ordinary saved name",
+        ])
+          expect(raw).not.toContain(privateValue);
+        const full = yield* Schema.decodeUnknownEffect(Wire)(raw);
+        expect(createHash("sha256").update(JSON.stringify(full.report)).digest("hex")).toBe(
+          full.sha256,
+        );
+        expect(
+          (yield* dry(f.ids).pipe(Effect.flatMap(Schema.decodeUnknownEffect(Output)))).report
+            .accounts,
+        ).toEqual(report.report.accounts);
+        expect(yield* f.snapshot).toEqual(before);
+
+        const approved = yield* dry([f.id("unused")]);
+        yield* evidence.step(
+          "Apply refuses missing GO, mismatched IDs, stale reports and incomplete inventory",
+          Effect.gen(function* () {
+            const journalBefore = yield* f.rows(
+              "select name from private_hosted_data_steps where name like 'basalt-retired-pool-tokens-v1:%' order by name",
+            );
+            expect(
+              yield* (yield* command.execute([f.id("unused")], { flags: ["--apply"] })).exit,
+            ).toBe(1);
+            expect(
+              yield* (yield* command.execute([f.id("unused")], {
+                inventory,
+                report: approved,
+                flags: ["--apply"],
+              })).exit,
+            ).toBe(1);
+            expect(yield* (yield* write(approved, [f.id("unused"), f.id("current")])).exit).toBe(1);
+            expect(yield* (yield* write(raw, f.ids)).exit).toBe(1);
+            const wire = yield* Schema.decodeUnknownEffect(Wire)(approved);
+            const old = {
+              ...wire.report,
+              snapshot: "2000-01-01T00:00:00.000Z",
+              expiresAt: "2000-01-01T00:05:00.000Z",
+            };
+            const stale = JSON.stringify({
+              report: old,
+              sha256: createHash("sha256").update(JSON.stringify(old)).digest("hex"),
+            });
+            expect(yield* (yield* write(stale)).exit).toBe(1);
+            const damaged = {
+              ...inventory,
+              records: inventory.records.map((record) =>
+                record.event === "end" ? { ...record, sha256: "0".repeat(64) } : record,
+              ),
+            };
+            expect(
+              yield* (yield* command.execute([f.id("unused")], { inventory: damaged })).exit,
+            ).toBe(1);
+            expect(
+              yield* (yield* command.execute([f.id("unused")], {
+                inventory: {
+                  ...inventory,
+                  records: inventory.records.filter((record) => record.event !== "end"),
+                },
+              })).exit,
+            ).toBe(1);
+            expect(
+              yield* (yield* command.execute([f.id("unused")], {
+                inventory: { ...inventory, target: "another-target" },
+              })).exit,
+            ).toBe(1);
+            expect(yield* f.snapshot).toEqual(before);
+            expect(
+              yield* f.rows(
+                "select name from private_hosted_data_steps where name like 'basalt-retired-pool-tokens-v1:%' order by name",
+              ),
+            ).toEqual(journalBefore);
+          }),
+        );
+        yield* evidence.step(
+          "Immediate rechecks preserve newly linked, reconnected and rotated accounts",
+          Effect.gen(function* () {
+            yield* f.link(f.id("unused"));
+            expect(yield* (yield* write(approved)).exit).toBe(1);
+            yield* f.rows("delete from hosted_app_account_links where account = $1", [
+              f.id("unused"),
+            ]);
+            yield* f.pending(f.id("unused"));
+            expect(yield* (yield* write(approved)).exit).toBe(1);
+            yield* f.rows("delete from executor_account_connections where source_account = $1", [
+              f.id("unused"),
+            ]);
+            yield* f.rows("update executor_accounts set credential_generation = 1 where id = $1", [
+              f.id("unused"),
+            ]);
+            expect(yield* (yield* write(approved)).exit).toBe(1);
+            expect(
+              yield* f.rows(
+                "select credential_generation::text as generation from executor_accounts where id = $1",
+                [f.id("unused")],
+              ),
+            ).toEqual([{ generation: "1" }]);
+            yield* f.rows("update executor_accounts set credential_generation = 0 where id = $1", [
+              f.id("unused"),
+            ]);
+            expect(yield* f.snapshot).toEqual(before);
+          }),
+        );
+        const fresh = yield* dry([f.id("unused")]);
+        const hash = (yield* Schema.decodeUnknownEffect(Wire)(fresh)).sha256;
+        const trigger = `retirement_failure_${randomUUID().replaceAll("-", "")}`;
+        const dropFailure = Effect.gen(function* () {
+          yield* f.rows(`drop trigger if exists ${trigger} on private_hosted_data_step_items`);
+          yield* f.rows(`drop function if exists ${trigger}()`);
+        });
+        yield* Effect.addFinalizer(() => dropFailure.pipe(Effect.orDie));
+        yield* f.rows(`create function ${trigger}() returns trigger language plpgsql as $$ begin
+      if NEW.item = '${f.id("unused")}' then raise exception 'SYNTHETIC_RETIREMENT_JOURNAL_FAILURE'; end if; return NEW; end $$`);
+        yield* f.rows(
+          `create trigger ${trigger} before insert on private_hosted_data_step_items for each row execute function ${trigger}()`,
+        );
+        yield* evidence.step(
+          "A journal failure rolls deletion back and keeps the encrypted recovery point",
+          Effect.gen(function* () {
+            expect(yield* (yield* write(fresh)).exit).toBe(1);
+            expect(yield* f.snapshot).toEqual(before);
+            expect(
+              yield* f.rows("select item from private_hosted_data_step_items where name = $1", [
+                `basalt-retired-pool-tokens-v1:${hash}`,
+              ]),
+            ).toEqual([]);
+            const files = yield* command.checkpoints;
+            expect(files).toHaveLength(1);
+            for (const file of files)
+              for (const marker of [
+                f.id("unused"),
+                "An ordinary saved name",
+                f.validToken,
+                ...command.privateValues,
+              ])
+                expect(Buffer.from(file).includes(Buffer.from(marker))).toBe(false);
+          }),
+        );
+        yield* dropFailure;
+        const applied = yield* evidence.step(
+          "Only the exact retired unused account is deleted, with post-commit readback",
+          (yield* write(fresh)).run.pipe(Effect.flatMap(Schema.decodeUnknownEffect(Outcome))),
+        );
+        expect(applied).toMatchObject({
+          complete: true,
+          mode: "apply",
+          writePerformed: true,
+          externalActions: [],
+          items: [{ account: f.id("unused"), outcome: "deleted", alreadyRecorded: false }],
+        });
+        expect(yield* f.snapshot).toEqual(before.filter((row) => row.id !== f.id("unused")));
+        expect(
+          yield* f.rows("select account from executor_account_checks where account = $1", [
+            f.id("unused"),
+          ]),
+        ).toEqual([]);
+        expect(
+          yield* (yield* write(fresh)).run.pipe(
+            Effect.flatMap(Schema.decodeUnknownEffect(Outcome)),
+          ),
+        ).toMatchObject({
+          complete: true,
+          writePerformed: false,
+          items: [{ alreadyRecorded: true }],
+        });
+        const restored = yield* evidence.step(
+          "Recovery restores the same ID, ciphertext, policy and cached check exactly once",
+          (yield* write(fresh, [f.id("unused")], "--recover")).run.pipe(
+            Effect.flatMap(Schema.decodeUnknownEffect(Outcome)),
+          ),
+        );
+        expect(restored).toMatchObject({
+          complete: true,
+          mode: "recover",
+          writePerformed: true,
+          items: [{ account: f.id("unused"), outcome: "restored", alreadyRecorded: false }],
+        });
+        expect(yield* f.snapshot).toEqual(before);
+        expect(
+          yield* (yield* write(fresh, [f.id("unused")], "--recover")).run.pipe(
+            Effect.flatMap(Schema.decodeUnknownEffect(Outcome)),
+          ),
+        ).toMatchObject({
+          complete: true,
+          writePerformed: false,
+          items: [{ alreadyRecorded: true }],
+        });
+        expect(yield* (yield* write(fresh)).exit).toBe(1);
+        expect(yield* f.snapshot).toEqual(before);
+        expect(JSON.stringify(inventory)).toBe(inventoryBefore);
+        expect(
+          (yield* dry([f.id("unused")]).pipe(Effect.flatMap(Schema.decodeUnknownEffect(Output))))
+            .report.accounts[0],
+        ).toMatchObject({ disposition: "retire", signedClaimsVerified: true });
+        yield* evidence.json("retirement-tooling.json", {
+          accounts: report.report.accounts,
+          applied,
