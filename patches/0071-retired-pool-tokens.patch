diff --git a/e2e/support/retired-pool-token-command.ts b/e2e/support/retired-pool-token-command.ts
new file mode 100644
index 0000000000000000000000000000000000000000..42e513a98598a5f683bf2ca83ddd6fd29a45abf0
--- /dev/null
+++ b/e2e/support/retired-pool-token-command.ts
@@ -0,0 +1,116 @@
+import { createCipheriv, createHmac, randomBytes, randomUUID } from "node:crypto";
+import { Effect, FileSystem, Schema, Stream } from "effect";
+import { ChildProcess, ChildProcessSpawner } from "effect/process";
+import { Target } from "./platform.ts";
+
+const encryptionKey = "cd".repeat(32),
+  signingKey = "ab".repeat(32);
+export const retirementTarget = "synthetic-token-retirement";
+
+/** Retained pool tokens use the documented signed envelope, without exposing host secrets. */
+export const retirementToken = (pool: string, owner: string, organization: string) => {
+  const signed = `sbp1.${Buffer.from(JSON.stringify({ pool, owner, organization })).toString("base64url")}`;
+  return `${signed}.${createHmac("sha256", Buffer.from(signingKey, "hex")).update(signed).digest("base64url")}`;
+};
+export const retirementCredentials = (id: string, value: string) => {
+  const nonce = randomBytes(12),
+    cipher = createCipheriv("aes-256-gcm", Buffer.from(encryptionKey, "hex"), nonce);
+  cipher.setAAD(Buffer.from(id));
+  return Buffer.concat([
+    Buffer.from([1]),
+    nonce,
+    cipher.update(JSON.stringify({ token: value })),
+    cipher.final(),
+    cipher.getAuthTag(),
+  ]).toString("hex");
+};
+
+/** Exercise the actual operator CLI; every invocation gets private request and approval files. */
+export const retirementCommand = (organization: string) =>
+  Effect.gen(function* () {
+    const target = yield* Target,
+      fs = yield* FileSystem.FileSystem,
+      processes = yield* ChildProcessSpawner.ChildProcessSpawner;
+    const directory = `${target.directory}/retirement-${randomUUID()}`;
+    yield* fs.makeDirectory(directory, { recursive: true, mode: 0o700 });
+    yield* Effect.addFinalizer(() => fs.remove(directory, { recursive: true }).pipe(Effect.orDie));
+    const db = yield* fs
+      .readFileString(`${target.directory}/sso-database.json`)
+      .pipe(
+        Effect.flatMap(
+          Schema.decodeUnknownEffect(
+            Schema.fromJsonString(Schema.Struct({ database: Schema.String })),
+          ),
+        ),
+      );
+    const configuration = `${directory}/configuration.json`;
+    yield* fs.writeFileString(
+      configuration,
+      JSON.stringify({
+        target: retirementTarget,
+        database: db.database,
+        encryptionKey,
+        poolSigningKeys: [signingKey],
+      }),
+      { mode: 0o600 },
+    );
+    const execute = (
+      accounts: ReadonlyArray<string>,
+      options: { inventory?: unknown; report?: string; flags?: ReadonlyArray<string> } = {},
+    ) =>
+      Effect.gen(function* () {
+        const invocation = randomUUID(),
+          request = `${directory}/${invocation}-request.json`;
+        yield* fs.writeFileString(request, JSON.stringify({ organization, accounts }), {
+          mode: 0o600,
+        });
+        const args = ["apps/hosted/cloud/scripts/retired-pool-tokens.ts", "--request", request];
+        if (options.inventory !== undefined) {
+          const file = `${directory}/${invocation}-inventory.json`;
+          yield* fs.writeFileString(file, JSON.stringify(options.inventory), { mode: 0o600 });
+          args.push("--inventory", file);
+        }
+        if (options.report !== undefined) {
+          const file = `${directory}/${invocation}-report.json`;
+          yield* fs.writeFileString(file, options.report, { mode: 0o600 });
+          args.push("--report", file, "--checkpoints", `${directory}/checkpoints`);
+        }
+        args.push(...(options.flags ?? []));
+        const command = ChildProcess.make("bun", args, {
+          env: { PATH: process.env.PATH ?? "", EXECUTOR_RETIREMENT_CONFIGURATION: configuration },
+          extendEnv: false,
+        });
+        return {
+          capture: Effect.scoped(
+            Effect.gen(function* () {
+              const child = yield* processes.spawn(command);
+              const [exit, stdout] = yield* Effect.all(
+                [child.exitCode, child.stdout.pipe(Stream.decodeText(), Stream.mkString)],
+                { concurrency: "unbounded" },
+              );
+              return { exit: Number(exit), stdout };
+            }),
+          ),
+          run: processes.string(command),
+          exit: processes.exitCode(
+            ChildProcess.make("bun", args, {
+              env: {
+                PATH: process.env.PATH ?? "",
+                EXECUTOR_RETIREMENT_CONFIGURATION: configuration,
+              },
+              extendEnv: false,
+              stdout: "ignore",
+              stderr: "ignore",
+            }),
+          ),
+        };
+      });
+    const checkpoints = fs
+      .readDirectory(`${directory}/checkpoints`)
+      .pipe(
+        Effect.flatMap((names) =>
+          Effect.forEach(names, (name) => fs.readFile(`${directory}/checkpoints/${name}`)),
+        ),
+      );
+    return { execute, checkpoints, privateValues: [encryptionKey, signingKey, db.database] };
+  });
diff --git a/e2e/support/retired-pool-token-fixture.ts b/e2e/support/retired-pool-token-fixture.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7ad5accfb1d144248aab02c140913b1593075e5c
--- /dev/null
+++ b/e2e/support/retired-pool-token-fixture.ts
@@ -0,0 +1,210 @@
+import { expect } from "@effect/vitest";
+import { randomUUID } from "node:crypto";
+import { Effect, Schema } from "effect";
+import { Api, body } from "./api.ts";
+import { Actors } from "./actors.ts";
+import { appsManifest } from "./apps-release.ts";
+import { writeRows } from "./cloud-rows.ts";
+import { retirementCredentials, retirementToken } from "./retired-pool-token-command.ts";
+
+const App = Schema.Struct({
+  id: Schema.String,
+  requirements: Schema.Struct({
+    accounts: Schema.Struct({ pool: Schema.Struct({ provider: Schema.String }) }),
+  }),
+});
+const source = `import { defineApp, defineProvider, object, query, router, secrets, string } from "apps";
+const pool = defineProvider({ name: "Retirement fixture pool", auth: {
+  token: secrets({ provisioned: true, label: "Pool access", fields: object({ token: string() }) }),
+} });
+export default defineApp({ app: { accounts: { pool } } }, {
+  tools: router({ present: query({ input: object({}) }, async () => ({ valid: true })) }),
+});`;
+export const retirementNames = [
+  "unused",
+  "unusedSecond",
+  "wrongProvider",
+  "badClaims",
+  "linked",
+  "workflow",
+  "webhook",
+  "pending",
+  "shared",
+  "current",
+  "legacy",
+] as const;
+
+/** Scoped retained rows cover old host-owned accounts that Connect intentionally cannot create. */
+export const retiredTokenFixture = Effect.gen(function* () {
+  const api = yield* Api,
+    actors = yield* Actors;
+  const rows = (sql: string, params: ReadonlyArray<string> = []) =>
+    writeRows("sso-database.json", [{ sql, params }]).pipe(Effect.map((result) => result[0] ?? []));
+  const prefix = `/api/organizations/${actors.organization.id}`;
+  const session = yield* body(
+    Schema.Struct({ user: Schema.Struct({ id: Schema.String }) }),
+    yield* api.request(actors.owner, "GET", "/api/auth/get-session"),
+  );
+  const deploy = (name: string, content: string) =>
+    api
+      .request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+        name,
+        files: [{ path: "index.ts", content }, appsManifest],
+      })
+      .pipe(
+        Effect.flatMap((response) => {
+          expect(response.status).toBe(200);
+          return body(App, response);
+        }),
+      );
+  const app = yield* deploy("Token retirement fixture", source);
+  const unrelated = yield* deploy(
+    "Ordinary token fixture",
+    source.replace("Retirement fixture pool", "Ordinary saved service"),
+  );
+  const legacy = yield* deploy(
+    "Legacy token fixture",
+    source
+      .replace("Retirement fixture pool", "Legacy unmarked pool")
+      .replace("provisioned: true", "provisioned: false"),
+  );
+  const ids = Object.fromEntries(retirementNames.map((name) => [name, `acc_${randomUUID()}`]));
+  const id = (name: (typeof retirementNames)[number]) => ids[name]!;
+  const owner = `organization:${actors.organization.id}`;
+  const validToken = retirementToken(app.id, session.user.id, actors.organization.id);
+  yield* Effect.addFinalizer(() =>
+    Effect.gen(function* () {
+      yield* rows(
+        "update organization set metadata = (coalesce(metadata::jsonb, '{}'::jsonb) - 'basaltPools')::text where id = $1",
+        [actors.organization.id],
+      );
+      for (const account of Object.values(ids)) {
+        for (const table of [
+          "executor_workflow_accounts",
+          "executor_webhook_accounts",
+          "executor_account_checks",
+        ])
+          yield* rows(`delete from ${table} where account = $1`, [account]);
+        yield* rows("delete from executor_account_connections where source_account = $1", [
+          account,
+        ]);
+        yield* rows("delete from executor_accounts where id = $1", [account]);
+      }
+      for (const fixture of [app, unrelated, legacy])
+        expect(
+          (yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${fixture.id}`)).status,
+        ).toBe(200);
+    }).pipe(Effect.orDie),
+  );
+  for (const name of retirementNames) {
+    const account = id(name),
+      token =
+        name === "badClaims"
+          ? retirementToken(unrelated.id, session.user.id, actors.organization.id)
+          : validToken;
+    yield* rows(
+      `insert into executor_accounts (id, owner, provider, method, label, encrypted_credentials, credential_generation, created_at)
+      values ($1, $2, $3, 'token', $4, decode($5, 'hex'), 0, now())`,
+      [
+        account,
+        owner,
+        name === "wrongProvider"
+          ? unrelated.requirements.accounts.pool.provider
+          : name === "legacy"
+            ? legacy.requirements.accounts.pool.provider
+            : app.requirements.accounts.pool.provider,
+        name === "unused" ? "An ordinary saved name" : "Pool access (retired)",
+        retirementCredentials(account, token),
+      ],
+    );
+    yield* rows(
+      `insert into hosted_account_access (account_id, organization_id, creator_id, kind, personal_user_id, audience)
+      values ($1, $2, $3, $4, nullif($5, ''), nullif($6, ''))`,
+      [
+        account,
+        actors.organization.id,
+        session.user.id,
+        name === "shared" ? "shared" : "personal",
+        name === "shared" ? "" : session.user.id,
+        name === "shared" ? "everyone" : "",
+      ],
+    );
+  }
+  yield* rows(
+    `update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb), '{basaltPools}', $1::jsonb)::text where id = $2`,
+    [
+      JSON.stringify({ [session.user.id]: { app: app.id, account: id("current") } }),
+      actors.organization.id,
+    ],
+  );
+  const link = (account: string) =>
+    rows(
+      `insert into hosted_app_account_links (app, requirement, subject, account, linked_by, created_at) values ($1, 'pool', null, $2, $3, now())`,
+      [unrelated.id, account, session.user.id],
+    );
+  yield* rows(
+    `insert into hosted_app_account_links (app, requirement, subject, account, linked_by, created_at) values ($1, 'pool', null, $2, $3, now())`,
+    [app.id, id("current"), session.user.id],
+  );
+  yield* link(id("linked"));
+  yield* rows("insert into executor_workflow_accounts (id, account, run) values ($1, $2, $3)", [
+    `fixture_${randomUUID()}`,
+    id("workflow"),
+    `run_${randomUUID()}`,
+  ]);
+  yield* rows(
+    "insert into executor_webhook_accounts (id, account, subscription) values ($1, $2, $3)",
+    [`fixture_${randomUUID()}`, id("webhook"), `wh_${randomUUID()}`],
+  );
+  const pending = (account: string) =>
+    rows(
+      `insert into executor_account_connections (id, owner, provider, source_account, state, revision, created_at, expires_at, target, additional_targets)
+    values ($1, $2, $3, $4, '{"status":"cancelled"}'::jsonb, $5, now(), now() - interval '1 day', 'null'::jsonb, '[]'::jsonb)`,
+      [
+        `con_${randomUUID()}`,
+        owner,
+        app.requirements.accounts.pool.provider,
+        account,
+        randomUUID(),
+      ],
+    );
+  yield* pending(id("pending"));
+  yield* rows(
+    `insert into executor_account_checks (id, account, app, deployment, credential_generation, status, checked_at, account_info)
+    values ($1, $2, $3, 'v_synthetic', 0, 'healthy', now(), 'null'::jsonb)`,
+    [`fixture_${randomUUID()}`, id("unused"), app.id],
+  );
+  const snapshot = rows(
+    `select a.id, md5(to_jsonb(a)::text) as account, md5(to_jsonb(p)::text) as policy,
+    coalesce((select jsonb_agg(to_jsonb(c) order by c.id)::text from executor_account_checks c where c.account = a.id), '[]') as checks
+    from executor_accounts a join hosted_account_access p on p.account_id = a.id where a.owner = $1 order by a.id`,
+    [owner],
+  ).pipe(
+    Effect.flatMap(
+      Schema.decodeUnknownEffect(
+        Schema.Array(
+          Schema.Struct({
+            id: Schema.String,
+            account: Schema.String,
+            policy: Schema.String,
+            checks: Schema.String,
+          }),
+        ),
+      ),
+    ),
+  );
+  return {
+    app,
+    unrelated,
+    id,
+    ids: Object.values(ids),
+    owner,
+    person: session.user.id,
+    organization: actors.organization.id,
+    validToken,
+    rows,
+    snapshot,
+    link,
+    pending,
+  };
+});
