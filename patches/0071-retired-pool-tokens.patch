index 0000000000000000000000000000000000000000..182323e12ce8a70ed08999c93c9fd6768e8c1c78
--- /dev/null
+++ b/e2e/tests/retired-pool-token-batch.spec.ts
@@ -0,0 +1,108 @@
+import { expect, layer } from "@effect/vitest";
+import { randomUUID } from "node:crypto";
+import { Effect, Schema } from "effect";
+import { withHostedHttpCase } from "../support/case.ts";
+import { Evidence } from "../support/evidence.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { retirementCommand } from "../support/retired-pool-token-command.ts";
+import { retiredTokenFixture } from "../support/retired-pool-token-fixture.ts";
+import { retirementInventory } from "../support/retired-pool-token-inventory.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Envelope = Schema.fromJsonString(Schema.Struct({ sha256: Schema.String }));
+const Result = Schema.fromJsonString(
+  Schema.Struct({
+    complete: Schema.Boolean,
+    stoppedAt: Schema.optionalKey(Schema.String),
+    items: Schema.Array(
+      Schema.Struct({
+        account: Schema.String,
+        outcome: Schema.String,
+        alreadyRecorded: Schema.Boolean,
+      }),
+    ),
+  }),
+);
+layer(RuntimeLive, { excludeTestServices: true })("Retired pool token batch recovery", (it) => {
+  it.effect(scenarios.cloudRetiredPoolTokenBatch.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* retiredTokenFixture,
+          evidence = yield* Evidence;
+        const command = yield* retirementCommand(f.organization);
+        const ids = [f.id("unused"), f.id("unusedSecond")],
+          inventory = retirementInventory(f.organization, f.app.id, f.person);
+        const approved = yield* (yield* command.execute(ids, { inventory })).run;
+        const hash = (yield* Schema.decodeUnknownEffect(Envelope)(approved)).sha256;
+        const invoke = (accounts: ReadonlyArray<string> = ids, mode = "--apply") =>
+          command.execute(accounts, { inventory, report: approved, flags: [mode, "--go", hash] });
+        const before = yield* f.snapshot;
+        const trigger = `retirement_batch_${randomUUID().replaceAll("-", "")}`;
+        const drop = Effect.gen(function* () {
+          yield* f.rows(`drop trigger if exists ${trigger} on private_hosted_data_step_items`);
+          yield* f.rows(`drop function if exists ${trigger}()`);
+        });
+        yield* Effect.addFinalizer(() => drop.pipe(Effect.orDie));
+        yield* f.rows(`create function ${trigger}() returns trigger language plpgsql as $$ begin
+      if NEW.item = '${f.id("unusedSecond")}' then raise exception 'SYNTHETIC_SECOND_ITEM_FAILURE'; end if; return NEW; end $$`);
+        yield* f.rows(
+          `create trigger ${trigger} before insert on private_hosted_data_step_items for each row execute function ${trigger}()`,
+        );
+        const partial = yield* evidence.step(
+          "An interrupted batch retains only the first committed deletion",
+          (yield* invoke()).capture,
+        );
+        expect(partial.exit).toBe(1);
+        expect(yield* Schema.decodeUnknownEffect(Result)(partial.stdout)).toMatchObject({
+          complete: false,
+          stoppedAt: f.id("unusedSecond"),
+          items: [{ account: f.id("unused"), outcome: "deleted", alreadyRecorded: false }],
+        });
+        expect(yield* f.snapshot).toEqual(before.filter((row) => row.id !== f.id("unused")));
+        yield* drop;
+        const resumed = yield* evidence.step(
+          "Retry reads the first receipt and deletes only the remaining exact ID",
+          (yield* invoke()).run.pipe(Effect.flatMap(Schema.decodeUnknownEffect(Result))),
+        );
+        expect(resumed).toMatchObject({
+          complete: true,
+          items: [
+            { account: f.id("unused"), alreadyRecorded: true },
+            { account: f.id("unusedSecond"), alreadyRecorded: false },
+          ],
+        });
+        expect(yield* f.snapshot).toEqual(before.filter((row) => !ids.includes(row.id)));
+        expect(yield* (yield* invoke([f.id("current")], "--recover")).exit).toBe(1);
+        const recovered = yield* evidence.step(
+          "Recovery can restore an explicitly selected committed ID from the original batch",
+          (yield* invoke([f.id("unused")], "--recover")).run.pipe(
+            Effect.flatMap(Schema.decodeUnknownEffect(Result)),
+          ),
+        );
+        expect(recovered).toMatchObject({
+          complete: true,
+          items: [{ account: f.id("unused"), outcome: "restored", alreadyRecorded: false }],
+        });
+        expect(yield* f.snapshot).toEqual(before.filter((row) => row.id !== f.id("unusedSecond")));
+        expect(
+          yield* (yield* invoke([f.id("unused")], "--recover")).run.pipe(
+            Effect.flatMap(Schema.decodeUnknownEffect(Result)),
+          ),
+        ).toMatchObject({ complete: true, items: [{ alreadyRecorded: true }] });
+        expect(
+          yield* (yield* invoke([f.id("unusedSecond")], "--recover")).run.pipe(
+            Effect.flatMap(Schema.decodeUnknownEffect(Result)),
+          ),
+        ).toMatchObject({
+          complete: true,
+          items: [{ account: f.id("unusedSecond"), outcome: "restored" }],
+        });
+        expect(yield* f.snapshot).toEqual(before);
+        expect(yield* (yield* invoke()).exit).toBe(1);
+        expect(yield* f.snapshot).toEqual(before);
+        yield* evidence.json("retirement-batch.json", { resumed, recovered, productionGo: false });
+      }),
+    ),
+  );
+});
diff --git a/e2e/tests/retired-pool-tokens.spec.ts b/e2e/tests/retired-pool-tokens.spec.ts
