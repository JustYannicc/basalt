index 0000000000000000000000000000000000000000..1ed16b96aa02b8d3f4493c13ab911cbb7ed1c998
--- /dev/null
+++ b/apps/hosted/cloud/scripts/pool-token-retirement-queries.ts
@@ -0,0 +1,56 @@
+// This command reads fixed projections only. Labels never enter its candidate selection.
+export const accountQuery = `
+select a.id, a.owner, a.provider, a.method, a.credential_generation as generation,
+  case when octet_length(a.encrypted_credentials) <= 16384 then a.encrypted_credentials end as encrypted, p.organization_id as organization,
+  p.personal_user_id as person, p.kind, p.audience, p.revision,
+  d.definition::jsonb #>> '{auth,token,type}' as method_kind,
+  coalesce(d.definition::jsonb #> '{auth,token,provisioned}' = 'true'::jsonb, false) as provisioned,
+  a.identity_id, a.oauth_grant_id
+from executor_accounts a left join hosted_account_access p on p.account_id = a.id
+  left join executor_providers d on d.id = a.provider
+where a.id = $1`;
+
+export const poolQuery = `
+select pool.value ->> 'app' as app, pool.value ->> 'account' as replacement,
+  exists (select 1 from executor_apps a join executor_deployments d on d.code = a.code
+    where a.id = pool.value ->> 'app' and a.owner = $2
+      and d.requirements::jsonb #>> '{accounts,pool,provider}' = $3
+      and d.requirements::jsonb #>> '{accounts,pool,scope}' = 'app'
+      and d.requirements::jsonb #>> '{accounts,pool,cardinality}' = 'one') as declared
+from organization o cross join lateral
+  jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) pool
+where o.id = $1 and pool.key = $4`;
+
+export const replacementLinkQuery = `
+select app, requirement, subject from hosted_app_account_links
+where account = $1 and app = $2 and requirement = 'pool' and subject is null`;
+
+// Completed connections and dormant sources are retained references too. A later apply must
+// decide their lifecycle explicitly rather than treating an inactive state as permission.
+export const dependencyQueries = {
+  links: `select app as id, requirement, subject from hosted_app_account_links where account = $1 order by app, requirement, subject limit 101`,
+  groups: `select group_id as id from hosted_account_groups where account_id = $1 order by group_id limit 101`,
+  workflows: `select id, run from executor_workflow_accounts where account = $1 order by id limit 101`,
+  workflowRuns: `select id, status from executor_workflow_runs
+    where jsonb_path_exists(accounts::jsonb, '$.** ? (@ == $account)', jsonb_build_object('account', $1::text)) order by id limit 101`,
+  profiles: `select id, app from executor_installations
+    where jsonb_path_exists(accounts::jsonb, '$.** ? (@ == $account)', jsonb_build_object('account', $1::text)) order by id limit 101`,
+  webhooks: `select id, subscription from executor_webhook_accounts where account = $1 order by id limit 101`,
+  subscriptions: `select id, app, status from executor_webhooks
+    where source_account = $1 or jsonb_path_exists(accounts::jsonb, '$.** ? (@ == $account)', jsonb_build_object('account', $1::text))
+    order by id limit 101`,
+  webhookSources: `select id, app, status from executor_webhook_sources
+    where account = $1 or jsonb_path_exists(accounts::jsonb, '$.** ? (@ == $account)', jsonb_build_object('account', $1::text))
+    order by id limit 101`,
+  connections: `select id, state ->> 'status' as status from executor_account_connections
+    where reconnect_account = $1 or source_account = $1 or state #>> '{account,id}' = $1
+    order by id limit 101`,
+  defaults: `select o.id, p.key as person from organization o cross join lateral
+    jsonb_each(coalesce(o.metadata::jsonb -> 'executorKeyAccounts', '{}'::jsonb)) p
+    where p.value #>> '{}' = $1 order by o.id, p.key limit 101`,
+  pools: `select o.id, p.key as person, p.value ->> 'app' as app from organization o
+    cross join lateral jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) p
+    where p.value ->> 'account' = $1 order by o.id, p.key limit 101`,
+  acquisitions: `select account as id from executor_account_acquisitions where account = $1 limit 101`,
+  grantUsers: `select id from executor_accounts where oauth_grant_id = $1 order by id limit 101`,
+} as const;
diff --git a/apps/hosted/cloud/scripts/pool-token-retirement-reader.ts b/apps/hosted/cloud/scripts/pool-token-retirement-reader.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4a2a5e7368c731643e24d368455389cccaf1e916
--- /dev/null
+++ b/apps/hosted/cloud/scripts/pool-token-retirement-reader.ts
@@ -0,0 +1,201 @@
+import { AccountId, aesGcmCredentials } from "@executor-js/sdk/core";
+import { verifyPoolToken } from "@executor-js/hosted-server/pool-token";
+import { createHash } from "node:crypto";
+import { Effect, Option, Redacted, Schema } from "effect";
+import type { PoolClient } from "pg";
+import {
+  accountQuery,
+  dependencyQueries,
+  poolQuery,
+  replacementLinkQuery,
+} from "./pool-token-retirement-queries.ts";
+import {
+  Identifier,
+  References,
+  RetirementConfiguration,
+  RetirementUnavailable,
+} from "./pool-token-retirement-contracts.ts";
+
+const Account = Schema.Struct({
+  id: AccountId,
+  owner: Identifier,
+  provider: Identifier,
+  method: Identifier,
+  generation: Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)),
+  encrypted: Schema.NullOr(Schema.Uint8Array),
+  organization: Schema.NullOr(Identifier),
+  person: Schema.NullOr(Identifier),
+  kind: Schema.NullOr(Identifier),
+  audience: Schema.NullOr(Identifier),
+  revision: Schema.NullOr(Identifier),
+  method_kind: Schema.NullOr(Identifier),
+  provisioned: Schema.Boolean,
+  identity_id: Schema.NullOr(Identifier),
+  oauth_grant_id: Schema.NullOr(Identifier),
+});
+const Pool = Schema.Struct({
+  app: Identifier,
+  replacement: Schema.NullOr(AccountId),
+  declared: Schema.Boolean,
+});
+
+export const retirementReader = (
+  client: PoolClient,
+  organization: string,
+  configuration: typeof RetirementConfiguration.Type,
+) =>
+  Effect.gen(function* () {
+    const query = (text: string, values: ReadonlyArray<string> = []) =>
+      Effect.tryPromise({
+        try: () => client.query<Record<string, unknown>>(text, [...values]),
+        catch: () => new RetirementUnavailable(),
+      }).pipe(Effect.map((result) => result.rows));
+    const credentials = yield* aesGcmCredentials(configuration.encryptionKey, crypto);
+    const account = (id: string) =>
+      query(accountQuery, [id]).pipe(
+        Effect.flatMap(Schema.decodeUnknownEffect(Schema.Array(Account))),
+        Effect.map((rows) => rows[0]),
+      );
+    const signedFor = (row: typeof Account.Type, app: string, person: string) =>
+      Effect.gen(function* () {
+        if (row.encrypted === null) return false;
+        const fields = yield* credentials
+          .decrypt(row.id, Redacted.make(row.encrypted))
+          .pipe(Effect.option);
+        if (Option.isNone(fields)) return false;
+        const token = Redacted.value(fields.value).token;
+        if (typeof token !== "string") return false;
+        for (const key of configuration.poolSigningKeys) {
+          const claims = yield* Effect.tryPromise({
+            try: () => verifyPoolToken(Redacted.value(key), token),
+            catch: () => new RetirementUnavailable(),
+          });
+          if (
+            claims?.pool === app &&
+            claims.owner === person &&
+            claims.organization === organization
+          )
+            return true;
+        }
+        return false;
+      });
+    const inspect = (id: typeof AccountId.Type) =>
+      Effect.gen(function* () {
+        const row = yield* account(id);
+        const dependencies: Record<string, typeof References.Type> = {};
+        const blockers: string[] = [];
+        if (row !== undefined) {
+          for (const [name, sql] of Object.entries(dependencyQueries)) {
+            const refs = yield* query(sql, [id]).pipe(
+              Effect.flatMap(Schema.decodeUnknownEffect(References)),
+            );
+            if (refs.length > 100) return yield* new RetirementUnavailable();
+            dependencies[name] = refs;
+            if (refs.length > 0) blockers.push(`reference:${name}`);
+          }
+        } else blockers.push("account_missing");
+        const owner = `organization:${organization}`;
+        const personal =
+          row !== undefined &&
+          row.owner === owner &&
+          row.organization === organization &&
+          row.kind === "personal" &&
+          row.audience === null &&
+          row.person !== null;
+        if (row !== undefined && (!personal || row.method !== "token"))
+          blockers.push("host_personal_token_unproven");
+        // Unmarked legacy methods can still start a reconnect without locking the account. Keep
+        // them until that path has a deletion-safe contract; signatures alone do not close the race.
+        if (
+          row !== undefined &&
+          (row.method_kind !== "secrets" ||
+            !row.provisioned ||
+            row.identity_id !== null ||
+            row.oauth_grant_id !== null)
+        )
+          blockers.push("unsupported_account_lifecycle");
+        const pools =
+          personal && row?.method === "token"
+            ? yield* query(poolQuery, [organization, owner, row.provider, row.person ?? ""]).pipe(
+                Effect.flatMap(Schema.decodeUnknownEffect(Schema.Array(Pool))),
+              )
+            : [];
+        const pool = pools.length === 1 ? pools[0] : undefined;
+        if (pool === undefined || !pool.declared) blockers.push("retained_pool_provider_unproven");
+        const signed =
+          row !== undefined && pool?.declared === true && row.person !== null
+            ? yield* signedFor(row, pool.app, row.person)
+            : false;
+        if (!signed) blockers.push("signed_pool_claims_unproven");
+        let replacementVerified = false;
+        let replacement: typeof Account.Type | undefined;
+        if (
+          pool !== undefined &&
+          pool.declared &&
+          pool.replacement !== null &&
+          pool.replacement !== id &&
+          row?.person != null
+        ) {
+          replacement = yield* account(pool.replacement);
+          const links = yield* query(replacementLinkQuery, [pool.replacement, pool.app]);
+          replacementVerified =
+            replacement !== undefined &&
+            links.length === 1 &&
+            replacement.owner === owner &&
+            replacement.provider === row.provider &&
+            replacement.method === "token" &&
+            replacement.organization === organization &&
+            replacement.kind === "personal" &&
+            replacement.person === row.person &&
+            replacement.audience === null &&
+            (yield* signedFor(replacement, pool.app, row.person));
+        }
+        if (!replacementVerified) blockers.push("current_replacement_unproven");
+        const facts = {
+          account: id,
+          exists: row !== undefined,
+          provider: row?.provider ?? null,
+          method: row?.method ?? null,
+          generation: row?.generation ?? null,
+          policyRevision: row?.revision ?? null,
+          pool: pool?.app ?? null,
+          person: row?.person ?? null,
+          replacement: pool?.replacement ?? null,
+          replacementGeneration: replacement?.generation ?? null,
+          replacementPolicyRevision: replacement?.revision ?? null,
+          signedClaimsVerified: signed,
+          replacementVerified,
+          dependencies,
+        };
+        return {
+          ...facts,
+          fingerprint: createHash("sha256").update(JSON.stringify(facts)).digest("hex"),
+          disposition:
+            row === undefined
+              ? ("missing" as const)
+              : blockers.length === 0
+                ? ("retire" as const)
+                : ("keep" as const),
+          blockers,
+        };
+      });
+    const identity =
+      query(`select current_database() as database, clock_timestamp()::text as snapshot,
+    (select value from private_executor_settings where key = 'version') as version`).pipe(
+        Effect.flatMap(
+          Schema.decodeUnknownEffect(
+            Schema.Array(
+              Schema.Struct({
+                database: Identifier,
+                snapshot: Identifier,
+                version: Schema.Literal("4.0.25"),
+              }),
+            ),
+          ),
+        ),
+        Effect.flatMap((rows) =>
+          rows[0] === undefined ? new RetirementUnavailable() : Effect.succeed(rows[0]),
+        ),
+      );
+    return { query, account, inspect, identity };
+  });
diff --git a/apps/hosted/cloud/scripts/pool-token-retirement-report.ts b/apps/hosted/cloud/scripts/pool-token-retirement-report.ts
new file mode 100644
index 0000000000000000000000000000000000000000..60151a9a5c3d464bac04d94baac6b35511fed0ae
--- /dev/null
+++ b/apps/hosted/cloud/scripts/pool-token-retirement-report.ts
@@ -0,0 +1,117 @@
+import { Effect, Schema } from "effect";
+import type { PoolClient } from "pg";
+import {
+  RetirementConfiguration,
+  RetirementRefused,
+  RetirementReport,
+  RetirementRequest,
+  reportFreshMs,
+} from "./pool-token-retirement-contracts.ts";
+import { retirementReader } from "./pool-token-retirement-reader.ts";
+import {
+  inventoryFresh,
+  joinRetirementPool,
+  type RetirementInventory,
+} from "./pool-token-retirement-inventory.ts";
+export { RetirementConfiguration, RetirementRequest } from "./pool-token-retirement-contracts.ts";
+
+/** Dry runs never initialize the SDK, invoke a callback, or write a journal. */
+export const retiredPoolTokenReport = (
+  client: PoolClient,
+  input: typeof RetirementRequest.Type,
+  configuration: typeof RetirementConfiguration.Type,
+  inventory?: RetirementInventory,
+) =>
+  Effect.gen(function* () {
+    if (new Set(input.accounts).size !== input.accounts.length)
+      return yield* new RetirementRefused({ reason: "duplicate_account_ids" });
+    if (inventory !== undefined && inventory.target !== configuration.target)
+      return yield* new RetirementRefused({ reason: "inventory_target_changed" });
+    const reader = yield* retirementReader(client, input.organization, configuration);
+    return yield* Effect.acquireUseRelease(
+      reader.query("BEGIN TRANSACTION ISOLATION LEVEL REPEATABLE READ READ ONLY"),
+      () =>
+        Effect.gen(function* () {
+          yield* reader.query("SET LOCAL statement_timeout = '3s'");
+          yield* reader.query("SET LOCAL lock_timeout = '500ms'");
+          yield* reader.query("SET LOCAL idle_in_transaction_session_timeout = '5s'");
+          yield* reader
+            .query("select current_setting('transaction_read_only') as setting")
+            .pipe(
+              Effect.flatMap(
+                Schema.decodeUnknownEffect(
+                  Schema.Array(Schema.Struct({ setting: Schema.Literal("on") })),
+                ),
+              ),
+            );
+          const identity = yield* reader.identity;
+          const at = Date.parse(identity.snapshot);
+          if (!Number.isFinite(at))
+            return yield* new RetirementRefused({ reason: "invalid_database_clock" });
+          const host = yield* Effect.forEach(input.accounts, reader.inspect);
+          const pools = new Map<string, ReturnType<typeof joinRetirementPool>>();
+          if (inventory !== undefined)
+            for (const candidate of host) {
+              if (candidate.pool !== null && candidate.person !== null)
+                pools.set(
+                  JSON.stringify([candidate.pool, candidate.person]),
+                  joinRetirementPool(
+                    inventory,
+                    input.organization,
+                    candidate.pool,
+                    candidate.person,
+                  ),
+                );
+            }
+          const accounts = host.map((candidate) => {
+            const external = pools.get(JSON.stringify([candidate.pool, candidate.person]));
+            const blockers = [...candidate.blockers];
+            if (inventory === undefined) blockers.push("external_inventory_required");
+            else if (!inventoryFresh(inventory, at)) blockers.push("external_inventory_stale");
+            if (external !== undefined) blockers.push(...external.blockers);
+            return {
+              ...candidate,
+              blockers,
+              disposition: candidate.exists
+                ? blockers.length === 0
+                  ? ("retire" as const)
+                  : ("keep" as const)
+                : ("missing" as const),
+            };
+          });
+          return yield* Schema.decodeUnknownEffect(RetirementReport)({
+            version: 1,
+            mode: "dry-run",
+            writePerformed: false,
+            applySupported: true,
+            migrationGo: false,
+            target: configuration.target,
+            organization: input.organization,
+            database: identity.database,
+            snapshot: identity.snapshot,
+            expiresAt: new Date(at + reportFreshMs).toISOString(),
+            accounts,
+            external:
+              inventory === undefined
+                ? null
+                : {
+                    target: inventory.target,
+                    homeHash: inventory.homeHash,
+                    storageHash: inventory.storageHash,
+                    homeSnapshot: inventory.home.snapshot,
+                    storageSnapshot: inventory.storage.snapshot,
+                    pools: [...pools.values()],
+                  },
+            requiredBeforeProductionApply: [
+              "exact-candidate-ids",
+              "supported-encrypted-backup",
+              "recovery-evidence",
+              "coordinator-go",
+            ],
+            externalActions: [],
+          });
+        }),
+      // Successful reports roll back too. PostgreSQL enforces the no-write guarantee.
+      () => reader.query("ROLLBACK").pipe(Effect.ignore),
+    );
+  }).pipe(Effect.withTracerEnabled(false));
diff --git a/apps/hosted/cloud/scripts/retired-pool-tokens.ts b/apps/hosted/cloud/scripts/retired-pool-tokens.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5d66293c045e0672a44a0ac12808255b2c1e1ed7
--- /dev/null
+++ b/apps/hosted/cloud/scripts/retired-pool-tokens.ts
@@ -0,0 +1,140 @@
+import { readFile } from "node:fs/promises";
+import { Pool } from "pg";
+import { Effect, Redacted, Schema } from "effect";
+import {
+  Hash,
+  ReportEnvelope,
+  RetirementConfiguration,
+  RetirementRequest,
+} from "./pool-token-retirement-contracts.ts";
+import { sha256 } from "./pool-token-retirement-checkpoint.ts";
+import { retiredPoolTokenReport } from "./pool-token-retirement-report.ts";
+import { readRetirementInventory } from "./pool-token-retirement-inventory.ts";
+import { retirePoolTokens } from "./pool-token-retirement-apply.ts";
+
+// Credentials stay in a private configuration file, never in argv or error output.
+const boundedJson = async (path: string, limit = 32_000) => {
+  const text = await readFile(path, "utf8");
+  if (Buffer.byteLength(text) > limit) throw new Error("Input limit exceeded");
+  return JSON.parse(text) as unknown;
+};
+const argumentsFor = (args: ReadonlyArray<string>) => {
+  const values = new Map<string, string>();
+  let mode: "dry-run" | "apply" | "recover" = "dry-run";
+  for (let index = 0; index < args.length; index++) {
+    const name = args[index];
+    if (name === "--apply" || name === "--recover") {
+      if (mode !== "dry-run") throw new Error("Choose one mode");
+      mode = name === "--apply" ? "apply" : "recover";
+    } else {
+      const value = args[++index];
+      if (
+        name === undefined ||
+        !["--request", "--inventory", "--report", "--go", "--checkpoints"].includes(name) ||
+        value === undefined ||
+        value.startsWith("--") ||
+        values.has(name)
+      )
+        throw new Error("Invalid arguments");
+      values.set(name, value);
+    }
+  }
+  const request = values.get("--request");
+  if (!request) throw new Error("Explicit account IDs are required");
+  if (mode === "dry-run" && ["--report", "--go", "--checkpoints"].some((name) => values.has(name)))
+    throw new Error("Unexpected write options");
+  if (
+    mode !== "dry-run" &&
+    ["--inventory", "--report", "--go", "--checkpoints"].some((name) => !values.has(name))
+  )
+    throw new Error("A matching report and explicit GO are required");
+  return { mode, request, values };
+};
+
+async function main() {
+  const args = argumentsFor(process.argv.slice(2));
+  const configurationFile = process.env.EXECUTOR_RETIREMENT_CONFIGURATION;
+  if (!configurationFile) throw new Error("Configuration is required");
+  const configuration = Schema.decodeUnknownSync(RetirementConfiguration)(
+    await boundedJson(configurationFile),
+  );
+  const request = Schema.decodeUnknownSync(RetirementRequest)(await boundedJson(args.request));
+  const inventoryFile = args.values.get("--inventory");
+  const inventory =
+    inventoryFile === undefined
+      ? undefined
+      : readRetirementInventory(await boundedJson(inventoryFile, 300_000));
+  const reportFile = args.values.get("--report"),
+    checkpointDirectory = args.values.get("--checkpoints");
+  let approved: typeof ReportEnvelope.Type | undefined;
+  if (reportFile !== undefined) {
+    const wire = Schema.decodeUnknownSync(Schema.Struct({ report: Schema.Json, sha256: Hash }))(
+      await boundedJson(reportFile, 120_000),
+    );
+    if (
+      sha256(JSON.stringify(wire.report)) !== wire.sha256 ||
+      args.values.get("--go") !== wire.sha256
+    )
+      throw new Error("Report approval changed");
+    approved = Schema.decodeUnknownSync(ReportEnvelope)(wire);
+  }
+  const pool = new Pool({
+    connectionString: Redacted.value(configuration.database),
+    max: 1,
+    connectionTimeoutMillis: 5_000,
+    query_timeout: 4_000,
+  });
+  pool.on("error", () => {});
+  try {
+    const client = await pool.connect();
+    try {
+      let output: unknown;
+      if (args.mode === "dry-run") {
+        const report = await Effect.runPromise(
+          retiredPoolTokenReport(client, request, configuration, inventory).pipe(
+            Effect.timeout("60 seconds"),
+          ),
+        );
+        output = { report, sha256: sha256(JSON.stringify(report)) };
+      } else {
+        if (approved === undefined || inventory === undefined || checkpointDirectory === undefined)
+          throw new Error("Incomplete write options");
+        const result = await Effect.runPromise(
+          retirePoolTokens(
+            client,
+            request,
+            configuration,
+            approved,
+            inventory,
+            checkpointDirectory,
+            args.mode,
+          ).pipe(Effect.timeout("60 seconds")),
+        );
+        output = result;
+        if (!result.complete) process.exitCode = 1;
+      }
+      const json = JSON.stringify(output);
+      if (Buffer.byteLength(json) > 120_000) throw new Error("Report limit exceeded");
+      process.stdout.write(json + "\n");
+    } finally {
+      client.release();
+    }
+  } finally {
+    await pool.end();
+  }
+}
+
+try {
+  await main();
+} catch {
+  // SQL and decoder causes may contain credentials, ciphertext or caller-controlled content.
+  const writeRequested = process.argv.includes("--apply") || process.argv.includes("--recover");
+  process.stderr.write(
+    JSON.stringify({
+      complete: false,
+      writePerformed: writeRequested ? null : false,
+      reason: "operation_unavailable",
+    }) + "\n",
+  );
+  process.exitCode = 1;
+}
