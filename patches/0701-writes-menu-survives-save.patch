+/**
+ * A new token whenever a manager asks for the catalog or setting again (Retry, Refresh tools,
+ * Reload). Restarting a read already in flight changes no value a view can see, so the token is
+ * how a save's hold on the catalog ends when the person asks for a fresh answer.
+ */
+const viewRequests = Atom.family((key: AvailabilityKey) => Atom.readable(() => Symbol(key.app)));
+
+/**
+ * List values this page published from its own confirmed saves, with the request token each saw.
+ * The read a save starts only reconciles the setting against the catalog already on screen, so
+ * that catalog stays until the read answers. A return to the page, a linked-account change, a
+ * manager's retry or a failed read never uses a save's value this way.
+ */
+const acknowledgedLists = new WeakMap<object, symbol>();
+
+const ownSave = <A extends object, E>(
+  result: AsyncResult.AsyncResult<A, E>,
+  request: symbol,
+): AsyncResult.AsyncResult<A, E> =>
+  AsyncResult.isSuccess(result) && result.waiting && acknowledgedLists.get(result.value) === request
+    ? AsyncResult.success<A, E>(result.value, { timestamp: result.timestamp })
+    : result;
+
+/** Asking again ends a save's hold on the catalog; the list is read again either way. */
+const askAgain = (key: AvailabilityKey) => (refresh: <A>(atom: Atom.Atom<A>) => void) => {
+  refresh(viewRequests(key));
+  refresh(lists(key));
+};
+
