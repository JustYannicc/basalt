diff --git a/apps/hosted/testing/provisioning-readiness-triggers.ts b/apps/hosted/testing/provisioning-readiness-triggers.ts
new file mode 100644
index 0000000..93a7660
--- /dev/null
+++ b/apps/hosted/testing/provisioning-readiness-triggers.ts
@@ -0,0 +1,32 @@
+/**
+ * Statement triggers that wake the provisioning readiness wait whenever one of its inputs commits.
+ *
+ * Provisioning jobs write these tables in their own orders while the triggers are installed and
+ * removed. Every statement here commits on its own, so this connection holds at most the one table
+ * lock it is waiting for and can never complete a deadlock cycle with those jobs.
+ */
+import type { Client } from "pg";
+
+const triggers = [
+  ["e2e_provisioning_completed", "hosted_provisioning"],
+  ["e2e_defaults_completed", "organization"],
+  ["e2e_pool_apps_completed", "executor_apps"],
+  ["e2e_pool_accounts_completed", "executor_accounts"],
+  ["e2e_pool_links_completed", "hosted_app_account_links"],
+] as const;
+
+/** Remove the triggers and their function; safe when none, or only some, are installed. */
+export const dropReadinessTriggers = async (client: Pick<Client, "query">) => {
+  for (const [name, table] of triggers)
+    await client.query(`drop trigger if exists ${name} on ${table}`);
+  await client.query("drop function if exists e2e_provisioning_completed()");
+};
+
+/** Install the function and one trigger per input table; the caller has already run LISTEN. */
+export const installReadinessTriggers = async (client: Pick<Client, "query">) => {
+  await client.query(`create function e2e_provisioning_completed() returns trigger language plpgsql as $$
+begin perform pg_notify('e2e_provisioning_completed', ''); return null; end $$`);
+  for (const [name, table] of triggers)
+    await client.query(`create trigger ${name} after insert or update or delete on ${table}
+for each statement execute function e2e_provisioning_completed()`);
+};
