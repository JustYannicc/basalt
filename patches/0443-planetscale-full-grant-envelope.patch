+
+/** Record only bounded names from the scope field, never the token response or credentials. */
+export const oauthScopeExceededEvidence = (
+  requested: readonly string[],
+  granted: readonly string[],
+  allowed: readonly string[],
+) => {
+  const permitted = new Set(allowed);
+  const excess = granted.filter((scope) => !permitted.has(scope));
+  const names = (values: readonly string[]) =>
+    [
+      ...new Set(
+        values.filter((name) => name.length <= 128 && /^[a-z][a-z0-9._:/-]*$/iu.test(name)),
+      ),
+    ].slice(0, 128);
+  const requestedScopes = names(requested);
+  const grantedScopes = names(granted);
+  const excessScopes = names(excess);
+  return {
+    requestedScopes,
+    grantedScopes,
+    excessScopes,
+    scopeNamesOmitted: [requested, granted, excess].some(
+      (values) => names(values).length !== new Set(values).size,
+    ),
+  };
+};
