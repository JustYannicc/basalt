+/** Additive host-owned state. A removed link keeps its provisioning tombstone. */
+import { Effect } from "effect";
+import { SqlClient } from "effect/sql";
+
+export const migrateHostedRoutes = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  yield* sql`create table if not exists basalt_hosted_routes_accounts (
+    app text not null,
+    organization text not null,
+    user_id text not null,
+    account_id text,
+    nonce text not null unique,
+    state text not null default 'provisioning' check (state in ('provisioning', 'linked', 'retired')),
+    primary key (app, user_id)
+  )`;
+  yield* sql`create table if not exists basalt_hosted_routes_usage (
+    id bigint generated always as identity primary key,
+    user_id text not null,
+    organization text not null,
+    app text not null,
+    created_at timestamp with time zone not null default now()
+  )`;
+  yield* sql`create index if not exists basalt_hosted_routes_usage_created
+    on basalt_hosted_routes_usage (created_at)`;
+  yield* sql`create index if not exists basalt_hosted_routes_usage_user_created
+    on basalt_hosted_routes_usage (user_id, created_at)`;
+});
