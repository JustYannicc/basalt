diff --git a/e2e/support/maps-routes-emulator.ts b/e2e/support/maps-routes-emulator.ts
new file mode 100644
index 0000000..5984ec5
--- /dev/null
+++ b/e2e/support/maps-routes-emulator.ts
@@ -0,0 +1,168 @@
+/** A loopback Maps Routes response for the E2E Cloud Worker. */
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Effect, Layer, Ref, Schema } from "effect";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { createServer } from "node:http";
+import { randomBytes } from "node:crypto";
+
+const expectedPath = "/directions/v2:computeRoutes";
+const routeResponse = {
+  routes: [
+    {
+      distanceMeters: 1200,
+      duration: "600s",
+      polyline: { encodedPolyline: "synthetic-route-polyline" },
+      legs: [
+        {
+          distanceMeters: 1200,
+          duration: "600s",
+          steps: [
+            {
+              distanceMeters: 1200,
+              staticDuration: "600s",
+              navigationInstruction: {
+                instructions: "Turn right onto Synthetic Road",
+                maneuver: "TURN_RIGHT",
+              },
+            },
+          ],
+        },
+      ],
+    },
+  ],
+};
+
+const State = Schema.Struct({
+  requests: Schema.Array(
+    Schema.Struct({
+      method: Schema.String,
+      path: Schema.String,
+      search: Schema.String,
+      body: Schema.Unknown,
+      fieldMask: Schema.NullOr(Schema.String),
+      hasGoogleKeyHeader: Schema.Boolean,
+      authorizedWithFixtureToken: Schema.Boolean,
+    }),
+  ),
+});
+type State = typeof State.Type;
+
+const hasFixtureToken = (authorization: string | undefined, token: string) =>
+  authorization === `Bearer ${token}`;
+
+const replaceText = (
+  value: unknown,
+  replacements: ReadonlyArray<readonly [string, string]>,
+): unknown => {
+  if (typeof value === "string")
+    return replacements.reduce(
+      (current, [before, after]) => current.replaceAll(before, after),
+      value,
+    );
+  if (Array.isArray(value)) return value.map((item) => replaceText(item, replacements));
+  if (value !== null && typeof value === "object")
+    return Object.fromEntries(
+      Object.entries(value).map(([key, item]) => [key, replaceText(item, replacements)]),
+    );
+  return value;
+};
+
+const CatalogFixture = Schema.Struct({
+  origin: Schema.String,
+  entry: Schema.Record(Schema.String, Schema.Unknown),
+  source: Schema.Record(Schema.String, Schema.Unknown),
+});
+
+/**
+ * This listener accepts only the fixed Routes request. It never forwards traffic to Google and
+ * exposes a protected read endpoint so the real Cloud Worker call can be asserted afterward.
+ */
+export const startMapsRoutesEmulator = (input: {
+  readonly document: typeof CatalogFixture.Type;
+  readonly browserOrigin: string;
+}) =>
+  Effect.gen(function* () {
+    const token = randomBytes(24).toString("hex");
+    const state = yield* Ref.make<State>({ requests: [] });
+    const sourceOrigin = new URL(input.document.origin);
+    const browserOrigin = new URL(input.browserOrigin);
+    const replacements = [
+      [sourceOrigin.origin, browserOrigin.origin],
+      [sourceOrigin.hostname, browserOrigin.hostname],
+    ] as const;
+    const source = replaceText(input.document.source, replacements);
+    const entry = input.document.entry;
+    const routes = HttpRouter.addAll([
+      HttpRouter.route(
+        "GET",
+        "/catalog/index.json",
+        HttpServerResponse.json({ version: 1, apps: [entry] }),
+      ),
+      HttpRouter.route("GET", "/catalog/apps/google-maps.json", HttpServerResponse.json(source)),
+      HttpRouter.route("GET", "/catalog/icons/*", HttpServerResponse.empty({ status: 404 })),
+      HttpRouter.route(
+        "GET",
+        "/__fixture/state",
+        Effect.gen(function* () {
+          const request = yield* HttpServerRequest.HttpServerRequest;
+          if (!hasFixtureToken(request.headers.authorization, token))
+            return yield* HttpServerResponse.json({ error: "unauthorized" }, { status: 401 });
+          return yield* HttpServerResponse.json(yield* Ref.get(state));
+        }),
+      ),
+      HttpRouter.route(
+        "POST",
+        "/__fixture/reset",
+        Effect.gen(function* () {
+          const request = yield* HttpServerRequest.HttpServerRequest;
+          if (!hasFixtureToken(request.headers.authorization, token))
+            return yield* HttpServerResponse.json({ error: "unauthorized" }, { status: 401 });
+          yield* Ref.set(state, { requests: [] });
+          return yield* HttpServerResponse.json({ ok: true });
+        }),
+      ),
+      HttpRouter.route(
+        "POST",
+        expectedPath,
+        Effect.gen(function* () {
+          const request = yield* HttpServerRequest.HttpServerRequest;
+          const text = yield* request.text;
+          const body = yield* Schema.decodeUnknownEffect(Schema.fromJsonString(Schema.Unknown))(
+            text,
+          );
+          const authorized = hasFixtureToken(request.headers.authorization, token);
+          if (!authorized)
+            return yield* HttpServerResponse.json({ error: "unauthorized" }, { status: 401 });
+          if (request.headers["x-goog-api-key"] !== undefined)
+            return yield* HttpServerResponse.json(
+              { error: "unexpected_google_key_header" },
+              { status: 400 },
+            );
+          yield* Ref.update(state, (current) => ({
+            requests: [
+              ...current.requests,
+              {
+                method: request.method,
+                path: new URL(request.url, "http://routes-fixture").pathname,
+                search: new URL(request.url, "http://routes-fixture").search,
+                body,
+                fieldMask: request.headers["x-goog-fieldmask"] ?? null,
+                hasGoogleKeyHeader: request.headers["x-goog-api-key"] !== undefined,
+                authorizedWithFixtureToken: authorized,
+              },
+            ],
+          }));
+          return yield* HttpServerResponse.json(routeResponse);
+        }),
+      ),
+      HttpRouter.route("*", "/*", HttpServerResponse.json({ error: "not_found" }, { status: 404 })),
+    ]);
+    const services = yield* Layer.build(
+      HttpRouter.serve(routes, { disableLogger: true, disableListenLog: true }).pipe(
+        Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 })),
+      ),
+    );
+    const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+    if (!("port" in server.address)) return yield* Effect.die("Routes fixture must listen on TCP");
+    return { baseUrl: `http://127.0.0.1:${server.address.port}`, token };
+  });
