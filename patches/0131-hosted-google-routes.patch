index 0000000..98af5fe
--- /dev/null
+++ b/apps/hosted/server/src/implementation/hosted-routes-token.ts
@@ -0,0 +1,72 @@
+import { isLoopbackHostname } from "@executor-js/utils/url-policy";
+/** A per-user capability for the hosted Google Routes proxy. */
+import { isSigningKey, openEnvelope, signEnvelope } from "./pool-token.ts";
+
+/** The identity and deployment origin bound to one provisioned Routes account. */
+export interface HostedRoutesClaims {
+  readonly app: string;
+  readonly organization: string;
+  readonly user: string;
+  readonly nonce: string;
+  readonly origin: string;
+}
+
+// Keep these credentials cryptographically separate from pool tokens even though both use the
+// same host signing key.
+const hostedRoutesPrefix = "bhr1";
+const maxClaimLength = 256;
+
+const validOrigin = (value: string) => {
+  try {
+    const url = new URL(value);
+    return (
+      url.origin === value &&
+      (url.protocol === "https:" || (url.protocol === "http:" && isLoopbackHostname(url.hostname)))
+    );
+  } catch {
+    return false;
+  }
+};
+
+const validClaims = (value: unknown): value is HostedRoutesClaims => {
+  if (typeof value !== "object" || value === null) return false;
+  const claims = value as Record<string, unknown>;
+  if (
+    Object.keys(claims).some(
+      (key) => !["app", "organization", "user", "nonce", "origin"].includes(key),
+    )
+  )
+    return false;
+  return (
+    ["app", "organization", "user", "nonce"].every(
+      (key) =>
+        typeof claims[key] === "string" &&
+        claims[key].length > 0 &&
+        claims[key].length <= maxClaimLength,
+    ) &&
+    typeof claims.origin === "string" &&
+    claims.origin.length <= maxClaimLength &&
+    validOrigin(claims.origin)
+  );
+};
+
+/** Create a domain-separated HMAC token. The Google API key is never included in the token. */
+export const signHostedRoutesToken = async (secret: string, claims: HostedRoutesClaims) => {
+  if (!isSigningKey(secret) || !validClaims(claims))
+    throw new Error("Hosted Routes token configuration is invalid");
+  return signEnvelope(secret, hostedRoutesPrefix, claims);
+};
+
+/** Return claims only for a valid token of this capability and version. */
+export const verifyHostedRoutesToken = async (
+  secret: string,
+  token: string,
+): Promise<HostedRoutesClaims | undefined> => {
+  try {
+    if (!isSigningKey(secret) || typeof token !== "string" || token.length > 4096) return undefined;
+    const claims = await openEnvelope(secret, hostedRoutesPrefix, token);
+    return validClaims(claims) ? claims : undefined;
+  } catch {
+    return undefined;
+  }
+};
