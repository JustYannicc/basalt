+++ b/apps/hosted/cloud/src/infrastructure/maps-routes/response.ts
@@ -0,0 +1,39 @@
+import { Schema } from "effect";
+
+const NavigationInstruction = Schema.Struct({
+  instructions: Schema.optionalKey(Schema.String),
+  maneuver: Schema.optionalKey(Schema.String),
+});
+
+const Step = Schema.Struct({
+  distanceMeters: Schema.optionalKey(Schema.Number),
+  staticDuration: Schema.optionalKey(Schema.String),
+  navigationInstruction: Schema.optionalKey(NavigationInstruction),
+});
+
+const Location = Schema.Struct({
+  latLng: Schema.Struct({ latitude: Schema.Number, longitude: Schema.Number }),
+});
+
+const Leg = Schema.Struct({
+  startLocation: Schema.optionalKey(Location),
+  endLocation: Schema.optionalKey(Location),
+  distanceMeters: Schema.optionalKey(Schema.Number),
+  duration: Schema.optionalKey(Schema.String),
+  steps: Schema.optionalKey(Schema.Array(Step)),
+});
+
+const Polyline = Schema.Struct({
+  encodedPolyline: Schema.optionalKey(Schema.String),
+});
+
+export const ComputeRoutesResponse = Schema.Struct({
+  routes: Schema.Array(
+    Schema.Struct({
+      distanceMeters: Schema.optionalKey(Schema.Number),
+      duration: Schema.optionalKey(Schema.String),
+      polyline: Schema.optionalKey(Polyline),
+      legs: Schema.optionalKey(Schema.Array(Leg)),
+    }),
+  ),
+});
diff --git a/apps/hosted/cloud/src/infrastructure/maps-routes/usage.ts b/apps/hosted/cloud/src/infrastructure/maps-routes/usage.ts
new file mode 100644
index 0000000..545eece
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/maps-routes/usage.ts
@@ -0,0 +1,80 @@
+import { Effect, Schema } from "effect";
+import type { SqlClient } from "effect/sql";
+
+const Counts = Schema.Struct({
+  globalMonth: Schema.Int,
+  globalDay: Schema.Int,
+  globalMinute: Schema.Int,
+  userMonth: Schema.Int,
+  userDay: Schema.Int,
+  userMinute: Schema.Int,
+});
+
+export type UsageDecision =
+  | { readonly allowed: true }
+  | { readonly allowed: false; readonly reason: "unavailable" }
+  | {
+      readonly allowed: false;
+      readonly reason: "limit";
+      readonly limit:
+        | "globalMonth"
+        | "globalDay"
+        | "globalMinute"
+        | "userMonth"
+        | "userDay"
+        | "userMinute";
+    };
+
+/** Reserve before calling Google. A timeout or an unclear response still consumes the slot. */
+export const reserveMapsRoute = <E, R>(
+  sql: SqlClient.SqlClient,
+  input: { readonly user: string; readonly organization: string; readonly app: string },
+  beforeReserve: Effect.Effect<unknown, E, R>,
+): Effect.Effect<UsageDecision, never, R> =>
+  sql
+    .withTransaction(
+      Effect.gen(function* () {
+        yield* sql`set local statement_timeout = '3s'`;
+        yield* sql`set local lock_timeout = '500ms'`;
+        yield* sql`set local idle_in_transaction_session_timeout = '5s'`;
+        // All instances serialize this short counter-and-insert section on the same PostgreSQL lock.
+        yield* sql`select pg_advisory_xact_lock(731905221)`;
+        // A revocation may commit while this request waits for the shared quota lock.
+        yield* beforeReserve;
+        const rows = yield* sql`
+        with bounds as (
+          select now() as current_time,
+            date_trunc('month', timezone('UTC', now())) at time zone 'UTC' as month_start,
+            date_trunc('day', timezone('UTC', now())) at time zone 'UTC' as day_start
+        )
+        select
+          count(*) filter (where created_at >= bounds.month_start)::int as "globalMonth",
+          count(*) filter (where created_at >= bounds.day_start)::int as "globalDay",
+          count(*) filter (where created_at >= bounds.current_time - interval '1 minute')::int as "globalMinute",
+          count(*) filter (where user_id = ${input.user} and created_at >= bounds.month_start)::int as "userMonth",
+          count(*) filter (where user_id = ${input.user} and created_at >= bounds.day_start)::int as "userDay",
+          count(*) filter (where user_id = ${input.user} and created_at >= bounds.current_time - interval '1 minute')::int as "userMinute"
+        from basalt_hosted_routes_usage, bounds
+        where created_at >= least(bounds.month_start, bounds.current_time - interval '1 minute')`;
+        const counts = yield* Schema.decodeUnknownEffect(Counts)(rows[0]);
+        const limits = {
+          globalMonth: 620,
+          globalDay: 20,
+          globalMinute: 1,
+          userMonth: 100,
+          userDay: 10,
+          userMinute: 1,
+        } as const;
+        for (const limit of Object.keys(limits) as Array<keyof typeof limits>)
+          if (counts[limit] >= limits[limit])
+            return { allowed: false as const, reason: "limit" as const, limit };
+        yield* sql`insert into basalt_hosted_routes_usage (user_id, organization, app)
+        values (${input.user}, ${input.organization}, ${input.app})`;
+        return { allowed: true as const };
+      }),
+    )
+    .pipe(
+      Effect.catch(() =>
+        Effect.succeed({ allowed: false as const, reason: "unavailable" as const }),
+      ),
+    );
