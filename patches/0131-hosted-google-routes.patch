diff --git a/apps/hosted/server/src/implementation/hosted-routes-accounts.ts b/apps/hosted/server/src/implementation/hosted-routes-accounts.ts
new file mode 100644
index 0000000..db28a9e
--- /dev/null
+++ b/apps/hosted/server/src/implementation/hosted-routes-accounts.ts
@@ -0,0 +1,310 @@
+import { isLoopbackHostname } from "@executor-js/utils/url-policy";
+/** Provision and authorize the host-owned Maps Routes account. */
+import {
+  AccountId,
+  AppId,
+  ProviderId,
+  StorageError,
+  StorageHost,
+  type App,
+  type Executor,
+} from "@executor-js/sdk/core";
+import { Effect, Redacted, Schema } from "effect";
+import type { SqlClient } from "effect/sql";
+import {
+  HostedRoutesConfiguration,
+  hostedRoutesMethod,
+  hostedRoutesRequirement,
+  type HostedRoutesConfiguration as HostedRoutesConfigurationValue,
+  type HostedRoutesAppIdentity,
+} from "../contracts/hosted-routes.ts";
+import {
+  OrganizationForbidden,
+  organizationOwner,
+  type OrganizationId,
+} from "../contracts/organization.ts";
+import { personalAccountCreation } from "./resource-lifecycle.ts";
+import { lockAppLinks, provisionAccountLink } from "./app-accounts.ts";
+import {
+  requireAccountAccessAs,
+  requireAppAccessAs,
+  resourceAuthority,
+} from "./resource-policy.ts";
+import { signHostedRoutesToken, verifyHostedRoutesToken } from "./hosted-routes-token.ts";
+
+export {
+  HostedRoutesConfiguration,
+  hostedRoutesCatalogReference,
+  hostedRoutesHealthPath,
+  hostedRoutesMethod,
+  hostedRoutesPath,
+  hostedRoutesRequirement,
+  hostedRoutesProviderDefinition,
+} from "../contracts/hosted-routes.ts";
+export type {
+  HostedRoutesAppIdentity,
+  HostedRoutesConfiguration as HostedRoutesConfigurationValue,
+} from "../contracts/hosted-routes.ts";
+
+const Reservation = Schema.Struct({
+  account: Schema.NullOr(AccountId),
+  nonce: Schema.String,
+  state: Schema.Literals(["provisioning", "linked", "retired"]),
+  provider: Schema.NullOr(ProviderId),
+  method: Schema.NullOr(Schema.String),
+  personalUser: Schema.NullOr(Schema.String),
+  linked: Schema.Boolean,
+});
+
+const AccountRow = Schema.Struct({ account: AccountId });
+const sqlFailures = {
+  SqlError: () => new StorageError(),
+  SchemaError: () => new StorageError(),
+};
+
+const validOrigin = (value: string) => {
+  try {
+    const url = new URL(value);
+    return (
+      url.origin === value &&
+      (url.protocol === "https:" || (url.protocol === "http:" && isLoopbackHostname(url.hostname)))
+    );
+  } catch {
+    return false;
+  }
+};
+
+const matchingRequirement = (app: App, identity: HostedRoutesAppIdentity) => {
+  const requirement = app.requirements.accounts[hostedRoutesRequirement];
+  return (
+    app.copiedFrom?.reference === identity.reference &&
+    requirement?.scope === "user" &&
+    requirement.cardinality === "many" &&
+    requirement.provider === identity.provider
+  );
+};
+
+/** Whether an app is the exact catalog Maps source with the host-owned Routes requirement. */
+export const isHostedRoutesApp = (
+  app: App,
+  configuration: HostedRoutesConfigurationValue | undefined,
+) =>
+  configuration !== undefined &&
+  configuration.enabled &&
+  validOrigin(configuration.origin) &&
+  configuration.identity !== undefined &&
+  matchingRequirement(app, configuration.identity);
+
+/**
+ * Provision the official Maps app's one hosted Routes account for this member. The migration's
+ * `(app, user_id)` key reserves creation before the SDK writes the account, so concurrent calls
+ * cannot create two accounts. A missing live link retires the mapping instead of recreating it.
+ */
+export const ensureHostedRoutesAccount = (
+  executor: Executor,
+  sql: SqlClient.SqlClient,
+  input: {
+    readonly organization: OrganizationId;
+    readonly user: string;
+    readonly app: App;
+  },
+) =>
+  Effect.gen(function* () {
+    const configuration = yield* HostedRoutesConfiguration;
+    const identity = configuration?.identity;
+    if (
+      configuration === undefined ||
+      identity === undefined ||
+      !isHostedRoutesApp(input.app, configuration)
+    )
+      return undefined;
+
+    const { app, organization, user } = input;
+    const owner = organizationOwner(organization);
+    const tokenKey = Redacted.value(configuration.signingKey);
+    return yield* executor[StorageHost].transaction(
+      Effect.gen(function* () {
+        yield* lockAppLinks(sql, app.id);
+        const rows = yield* sql`
+          select mapping.account_id as account, mapping.nonce, mapping.state,
+            account.provider, account.method, access.personal_user_id as "personalUser",
+            exists (
+              select 1 from hosted_app_account_links link
+              where link.app = mapping.app and link.requirement = ${hostedRoutesRequirement}
+                and link.subject = mapping.user_id and link.account = mapping.account_id
+            ) as linked
+          from basalt_hosted_routes_accounts mapping
+          left join executor_accounts account on account.id = mapping.account_id
+            and account.owner = ${owner}
+          left join hosted_account_access access on access.account_id = mapping.account_id
+          where mapping.app = ${app.id} and mapping.organization = ${organization}
+            and mapping.user_id = ${user}
+          for update of mapping`;
+        const existing = yield* Schema.decodeUnknownEffect(Schema.Array(Reservation))(rows);
+        if (existing.length > 1) return yield* new StorageError();
+        const current = existing[0];
+        if (current !== undefined) {
+          if (current.state === "provisioning") return undefined;
+          if (
+            current.account === null ||
+            current.provider !== identity.provider ||
+            current.method !== hostedRoutesMethod ||
+            current.personalUser !== user ||
+            !current.linked
+          ) {
+            yield* sql`update basalt_hosted_routes_accounts set state = 'retired'
+              where app = ${app.id} and user_id = ${user} and state = 'linked'`;
+            return undefined;
+          }
+          const credentials = yield* executor.managedAccounts
+            .readCredentials({ owner, account: current.account })
+            .pipe(
+              Effect.map(Redacted.value),
+              Effect.catchTags({
+                AccountNotFound: () => Effect.succeed(undefined),
+                CredentialsError: () => Effect.succeed(undefined),
+              }),
+            );
+          const claims =
+            typeof credentials?.token === "string"
+              ? yield* Effect.promise(() =>
+                  verifyHostedRoutesToken(tokenKey, credentials.token as string),
+                )
+              : undefined;
+          if (
+            claims?.app === app.id &&
+            claims.organization === organization &&
+            claims.user === user &&
+            claims.nonce === current.nonce &&
+            claims.origin === configuration.origin
+          ) {
+            if (current.state === "retired")
+              yield* sql`update basalt_hosted_routes_accounts set state = 'linked'
+                where app = ${app.id} and user_id = ${user} and state = 'retired'`;
+            return current.account;
+          }
+          // A live personal link is the authority to repair a host-owned credential after key
+          // rotation. Keep the same account so selections and explicit relinks survive.
+          const token = yield* Effect.tryPromise({
+            try: () =>
+              signHostedRoutesToken(tokenKey, {
+                app: app.id,
+                organization,
+                user,
+                nonce: current.nonce,
+                origin: configuration.origin,
+              }),
+            catch: () => new StorageError(),
+          });
+          yield* executor.managedAccounts.replaceCredentials({
+            owner,
+            account: current.account,
+            fields: Redacted.make({ origin: configuration.origin, token }),
+          });
+          yield* sql`update basalt_hosted_routes_accounts set state = 'linked'
+            where app = ${app.id} and user_id = ${user}`;
+          return current.account;
+        }
+
+        const nonce = crypto.randomUUID();
+        const token = yield* Effect.tryPromise({
+          try: () =>
+            signHostedRoutesToken(tokenKey, {
+              app: app.id,
+              organization,
+              user,
+              nonce,
+              origin: configuration.origin,
+            }),
+          catch: () => new StorageError(),
+        });
+        const reserved = yield* sql`
+          insert into basalt_hosted_routes_accounts
+            (app, organization, user_id, nonce, state)
+          values (${app.id}, ${organization}, ${user}, ${nonce}, 'provisioning')
+          on conflict (app, user_id) do nothing
+          returning app`;
+        if (reserved.length !== 1) {
+          return undefined;
+        }
+
+        const account = yield* executor.managedAccounts
+          .add({
+            owner,
+            provider: identity.provider,
+            method: hostedRoutesMethod,
+            fields: Redacted.make({ origin: configuration.origin, token }),
+            label: "Google Maps Routes",
+          })
+          .pipe(personalAccountCreation(user));
+        const linked = yield* provisionAccountLink(sql, executor.webhooks, {
+          app: app.id,
+          requirement: hostedRoutesRequirement,
+          subject: user,
+          account: account.id,
+          linkedBy: user,
+        });
+        if (!linked) return yield* new StorageError();
+        const updated =
+          yield* sql`update basalt_hosted_routes_accounts set account_id = ${account.id},
+          state = 'linked' where app = ${app.id} and organization = ${organization}
+            and user_id = ${user} and nonce = ${nonce} and state = 'provisioning'
+          returning app`;
+        if (updated.length !== 1) return yield* new StorageError();
+        return account.id;
+      }),
+    );
+  }).pipe(Effect.catchTags(sqlFailures));
+
+/** Recheck current membership and policy before using the token's mapped account. */
+export const authorizeHostedRoutesAccount = (
+  sql: SqlClient.SqlClient,
+  input: {
+    readonly organization: OrganizationId;
+    readonly user: string;
+    readonly app: AppId;
+    readonly nonce: string;
+    readonly provider: ProviderId;
+    readonly tokenOrigin: string;
+  },
+) =>
+  Effect.gen(function* () {
+    const configuration = yield* HostedRoutesConfiguration;
+    if (
+      configuration === undefined ||
+      !configuration.enabled ||
+      configuration.origin !== input.tokenOrigin ||
+      configuration.identity?.provider !== input.provider ||
+      !validOrigin(input.tokenOrigin)
+    )
+      return yield* new OrganizationForbidden();
+
+    const actor = yield* resourceAuthority(input.organization, input.user);
+    yield* requireAppAccessAs(actor, input.app, "use");
+    const rows = yield* sql`
+      select a.id as account
+      from hosted_app_account_links l
+      join executor_apps app on app.id = l.app
+      join executor_deployments deployment on deployment.id = app.active_deployment
+        and deployment.requirements::jsonb -> 'accounts' -> ${hostedRoutesRequirement} ->> 'provider' = ${input.provider}
+        and deployment.requirements::jsonb -> 'accounts' -> ${hostedRoutesRequirement} ->> 'scope' = 'user'
+        and deployment.requirements::jsonb -> 'accounts' -> ${hostedRoutesRequirement} ->> 'cardinality' = 'many'
+      join executor_accounts a on a.id = l.account and a.owner = app.owner
+      join hosted_account_access p on p.account_id = a.id
+        and a.owner = 'organization:' || p.organization_id
+      join member m on m."organizationId" = p.organization_id and m."userId" = l.subject
+      join basalt_hosted_routes_accounts mapping
+        on mapping.app = l.app and mapping.user_id = l.subject and mapping.account_id = a.id
+      where l.app = ${input.app} and l.subject = ${actor.user}
+        and l.requirement = ${hostedRoutesRequirement}
+        and m."organizationId" = ${actor.organization} and m."userId" = ${actor.user}
+        and mapping.organization = ${actor.organization} and mapping.nonce = ${input.nonce}
+        and mapping.state = 'linked' and a.provider = ${input.provider}
+        and a.method = ${hostedRoutesMethod} and p.kind = 'personal'
+        and p.personal_user_id = ${actor.user}`;
+    const accounts = yield* Schema.decodeUnknownEffect(Schema.Array(AccountRow))(rows);
+    const account = accounts[0]?.account;
+    if (accounts.length !== 1 || account === undefined) return yield* new OrganizationForbidden();
+    yield* requireAccountAccessAs(actor, account, "use");
+    return account;
+  }).pipe(Effect.catchTags(sqlFailures));
diff --git a/apps/hosted/server/src/implementation/hosted-routes-schema.ts b/apps/hosted/server/src/implementation/hosted-routes-schema.ts
