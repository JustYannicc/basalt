+/** Hosted Maps Routes runs through the installed catalog app and a guarded loopback Google stub. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Api, body } from "../support/api.ts";
+import { Actors } from "../support/actors.ts";
+import { linkAccount, linkedAccountIds, unlinkAccount } from "../support/app-accounts.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { App } from "../support/contracts.ts";
+import { cloudLocks } from "../support/cloud-locks.ts";
+import { Emulators } from "../support/emulators.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Installed = Schema.Struct({
+  id: Schema.String,
+  copiedFrom: Schema.Struct({ reference: Schema.String }),
+  requirements: Schema.Struct({ accounts: Schema.Record(Schema.String, Schema.Unknown) }),
+});
+const Session = Schema.Struct({ user: Schema.Struct({ id: Schema.String }) });
+const AppAccess = Schema.Struct({ revision: Schema.String });
+const RouteFixtureState = Schema.Struct({
+  requests: Schema.Array(
+    Schema.Struct({
+      method: Schema.String,
+      path: Schema.String,
+      search: Schema.String,
+      body: Schema.Unknown,
+      fieldMask: Schema.NullOr(Schema.String),
+      hasGoogleKeyHeader: Schema.Boolean,
+      authorizedWithFixtureToken: Schema.Boolean,
+    }),
+  ),
+});
+
+const isRecord = (value: unknown): value is Record<string, unknown> =>
+  typeof value === "object" && value !== null && !Array.isArray(value);
+
+layer(RuntimeLive, { excludeTestServices: true })("Hosted Google Routes", (it) => {
+  it.effect(scenarios.hostedRoutes.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          emulators = yield* Emulators,
+          database = yield* cloudLocks;
+        const routes = emulators.mapsRoutes;
+        if (routes === undefined)
+          return yield* Effect.die(
+            "Run this Cloud scenario with BASALT_E2E_ROUTES=1 and its private catalog source fixture",
+          );
+
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const routePath = "/api/maps/routes";
+        const routeInput = {
+          origin: { address: "10 Example Street, Zurich" },
+          destination: { address: "Zurich main station" },
+          travelMode: "DRIVE",
+        };
+        const state = () =>
+          routes.state().pipe(Effect.flatMap(Schema.decodeUnknownEffect(RouteFixtureState)));
+        const actorUser = (actor: typeof actors.owner) =>
+          Effect.flatMap(api.request(actor, "GET", "/api/auth/get-session"), (response) =>
+            body(Session, response),
+          );
+
+        yield* routes.reset();
+        const health = yield* api.request(actors.owner, "GET", `${routePath}/health`);
+        expect(health.status).toBe(401);
+        const invalid = yield* api.request(actors.owner, "POST", routePath, {
+          ...routeInput,
+          routingPreference: "TRAFFIC_AWARE",
+        });
+        expect(invalid.status).toBe(400);
+        expect((yield* state()).requests).toEqual([]);
+
+        const ownerUser = yield* actorUser(actors.owner);
+        const memberUser = yield* actorUser(actors.member);
+        const installed = yield* Effect.forEach(
+          ["owner", "member"],
+          (audience) =>
+            Effect.gen(function* () {
+              const response = yield* api.request(actors.owner, "POST", `${prefix}/apps/install`, {
+                entry: "google-maps",
+                name: `Hosted Routes ${audience}`,
+              });
+              expect(response.status, JSON.stringify(response.body)).toBe(200);
+              const app = yield* body(Installed, response);
+              expect(Object.keys(app.requirements.accounts).sort()).toEqual([
+                "googleMaps",
+                "hostedRoutes",
+              ]);
+              expect(app.copiedFrom.reference).toBe(
+                `${routes.baseUrl}/catalog/apps/google-maps.json`,
+              );
+              yield* Effect.addFinalizer(() =>
+                api.request(actors.owner, "DELETE", `${prefix}/apps/${app.id}`).pipe(Effect.orDie),
+              );
+              const path = `${prefix}/apps/${app.id}`;
+              const current = yield* body(
+                AppAccess,
+                yield* api.request(actors.owner, "GET", `${path}/access`),
+              );
+              const updated = yield* api.request(actors.owner, "PATCH", `${path}/access`, {
+                revision: current.revision,
+                audience: { kind: "everyone" },
+              });
+              expect(updated.status, JSON.stringify(updated.body)).toBe(200);
+              return { id: app.id, path };
+            }),
+          { concurrency: 1 },
+        );
+
+        yield* Effect.addFinalizer(() =>
+          database
+            .run({
+              sql: "delete from basalt_hosted_routes_usage where app in ($1, $2)",
+              params: installed.map((app) => app.id),
+            })
+            .pipe(Effect.orDie),
+        );
+
+        // Readiness is local. The first actual tool call is the only request allowed upstream.
+        const appCalls = [
+          { actor: actors.owner, app: installed[0]! },
+          { actor: actors.member, app: installed[1]! },
+        ];
+        const selected = yield* Effect.forEach(appCalls, ({ actor, app }) =>
+          Effect.gen(function* () {
+            const index = yield* api.request(actor, "GET", `${app.path}/tools/index`);
+            expect(index.status, JSON.stringify(index.body)).toBe(200);
+            const accounts = yield* linkedAccountIds(actor, app.path);
+            expect(accounts).toHaveLength(1);
+            return { actor, app, account: accounts[0]! };
+          }));
+        const results = yield* Effect.forEach(
+          selected,
+          ({ actor, app, account }) =>
+            api.request(actor, "POST", `${app.path}/tools/call`, {
+              tool: "hosted.computeRoutes",
+              kind: "query",
+              input: { accountId: account, input: routeInput },
+            }),
+          { concurrency: 2 },
+        );
+        const completed = results.filter(
+          (result) =>
+            result.status === 200 &&
+            isRecord(result.body) &&
+            Array.isArray(result.body.routes),
+        );
+        const rejected = results.filter(
+          (result) =>
+            result.status >= 400 || (isRecord(result.body) && result.body.toolError === true),
+        );
+        expect(completed, JSON.stringify({ results, fixture: yield* state() })).toHaveLength(1);
+        expect(rejected).toHaveLength(1);
+        const success = completed[0]!.body as Record<string, unknown>;
+        expect(JSON.stringify(success)).toContain("synthetic-route-polyline");
+        expect(JSON.stringify(results)).not.toContain("synthetic-e2e-routes-key");
+
+        const observed = yield* state();
+        expect(observed.requests).toHaveLength(1);
+        expect(observed.requests[0]).toMatchObject({
+          method: "POST",
+          path: "/directions/v2:computeRoutes",
+          search: "",
+          body: routeInput,
+          hasGoogleKeyHeader: false,
+          authorizedWithFixtureToken: true,
+        });
+        expect(observed.requests[0]?.fieldMask).toBe(
+          [
+            "routes.distanceMeters",
+            "routes.duration",
+            "routes.polyline.encodedPolyline",
+            "routes.legs.distanceMeters",
+            "routes.legs.duration",
+            "routes.legs.startLocation",
+            "routes.legs.endLocation",
+            "routes.legs.steps.distanceMeters",
+            "routes.legs.steps.staticDuration",
+            "routes.legs.steps.navigationInstruction.instructions",
+            "routes.legs.steps.navigationInstruction.maneuver",
+          ].join(","),
+        );
+
+        const mappingRows = yield* database.run({
+          sql: `select app, user_id, state from basalt_hosted_routes_accounts
+            where app in ($1, $2) order by app, user_id`,
+          params: installed.map((app) => app.id),
+        });
+        expect(mappingRows).toHaveLength(2);
+        expect(mappingRows.map((row) => row.state)).toEqual(["linked", "linked"]);
+        expect(mappingRows.map((row) => row.user_id).sort()).toEqual(
+          [ownerUser.user.id, memberUser.user.id].sort(),
+        );
+        const usageRows = yield* database.run({
+          sql: `select count(*)::int as calls from basalt_hosted_routes_usage
+            where app in ($1, $2)`,
+          params: installed.map((app) => app.id),
+        });
+        expect(usageRows).toEqual([{ calls: 1 }]);
+
+        const memberAccount = (yield* linkedAccountIds(actors.member, installed[1]!.path))[0];
+        if (memberAccount === undefined)
+          return yield* Effect.die("The member's hosted Routes account was not linked");
+        yield* unlinkAccount(actors.member, installed[1]!.path, "hostedRoutes", memberAccount);
+        const afterUnlink = yield* api.request(
+          actors.member,
+          "POST",
+          `${installed[1]!.path}/tools/call`,
+          {
+            tool: "hosted.computeRoutes",
+            kind: "query",
+            input: routeInput,
+          },
+        );
+        expect(afterUnlink.status).toBeGreaterThanOrEqual(400);
+        const retired = yield* database.run({
+          sql: `select state from basalt_hosted_routes_accounts where app = $1 and user_id = $2`,
+          params: [installed[1]!.id, memberUser.user.id],
+        });
+        expect(retired).toEqual([{ state: "retired" }]);
+        expect((yield* state()).requests).toHaveLength(1);
+        expect(
+          yield* database.run({
+            sql: `select count(*)::int as calls from basalt_hosted_routes_usage
+              where app in ($1, $2)`,
+            params: installed.map((app) => app.id),
+          }),
+        ).toEqual([{ calls: 1 }]);
+
+        // Explicitly relinking the retained account restores access without provisioning another.
+        yield* linkAccount(actors.member, installed[1]!.path, "hostedRoutes", memberAccount);
+        const restored = yield* api.request(actors.member, "GET", `${installed[1]!.path}/tools/index`);
+        expect(restored.status, JSON.stringify(restored.body)).toBe(200);
+        expect(JSON.stringify(restored.body)).toContain("hosted.computeRoutes");
+        expect(yield* database.run({
+          sql: "select state, account_id from basalt_hosted_routes_accounts where app = $1 and user_id = $2",
+          params: [installed[1]!.id, memberUser.user.id],
+        })).toEqual([{ state: "linked", account_id: memberAccount }]);
+        expect(yield* linkedAccountIds(actors.member, installed[1]!.path)).toEqual([memberAccount]);
+
+        // The monthly refusal stays observable even when shorter limits also apply.
+        yield* database.run({
+          sql: `insert into basalt_hosted_routes_usage (user_id, organization, app, created_at)
+            select $1, $2, $3, date_trunc('month', now()) from generate_series(1, 620)`,
+          params: [ownerUser.user.id, actors.organization.id, installed[0]!.id],
+        });
+        const monthly = yield* api.request(
+          actors.owner,
+          "POST",
+          `${installed[0]!.path}/tools/call`,
+          {
+            tool: "hosted.computeRoutes",
+            kind: "query",
+            input: { accountId: selected[0]!.account, input: routeInput },
+          },
+        );
+        expect(JSON.stringify(monthly.body)).toContain("monthly quota has been reached");
+        expect((yield* state()).requests).toHaveLength(1);
+      }).pipe(Effect.provide(Emulators.layer)),
+    ),
+  );
+});
