index 0000000..5e54db3
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/hosted-routes.ts
@@ -0,0 +1,66 @@
+/** Cloud configuration and the guarded external-provider emulator boundary. */
+import * as BrowserCrypto from "@effect/platform-browser/BrowserCrypto";
+import { identifyProvider } from "@executor-js/sdk/core";
+import {
+  hostedRoutesProviderDefinition,
+  hostedRoutesCatalogReference,
+} from "@executor-js/hosted-server/hosted-routes/contracts";
+import { Config, Effect, Option, Redacted } from "effect";
+import { Crypto } from "effect";
+import { cloudHosts } from "./stage.ts";
+import { cloudEmulators } from "./emulators.ts";
+import { mapsRoutesHandlers } from "./maps-routes/index.ts";
+
+export const cloudHostedRoutes = Effect.gen(function* () {
+  const apiKey = yield* Config.Redacted("GOOGLE_MAPS_ROUTES_API_KEY").pipe(Config.option);
+  const signingKey = yield* Config.Redacted("POOL_APP_SIGNING_KEY").pipe(Config.option);
+  const origin = (yield* cloudHosts.pipe(Effect.orDie)).browser;
+  const provider = yield* identifyProvider(
+    hostedRoutesProviderDefinition(origin),
+    yield* Crypto.Crypto,
+  ).pipe(Effect.orDie);
+  const feedUrl = yield* Config.String("EXECUTOR_CATALOG_URL").pipe(Config.option);
+  const reference = Option.isSome(feedUrl)
+    ? new URL("apps/google-maps.json", feedUrl.value).href
+    : hostedRoutesCatalogReference(origin);
+  const emulators = yield* cloudEmulators.pipe(Effect.orDie);
+  const emulator = Option.isSome(emulators)
+    ? Redacted.value(emulators.value).mapsRoutes
+    : undefined;
+  const fetcher: typeof fetch | undefined =
+    emulator === undefined
+      ? undefined
+      : async (input, init) => {
+          const url = new URL(
+            typeof input === "string" ? input : input instanceof URL ? input.href : input.url,
+          );
+          if (url.href !== "https://routes.googleapis.com/directions/v2:computeRoutes")
+            throw new Error("Unexpected Routes emulator destination");
+          const headers = new Headers(init?.headers);
+          headers.delete("x-goog-api-key");
+          headers.set("authorization", `Bearer ${emulator.token}`);
+          return fetch(`${emulator.baseUrl}/directions/v2:computeRoutes`, {
+            ...init,
+            headers,
+            redirect: "manual",
+          });
+        };
+  const configuration = Option.isSome(signingKey)
+    ? {
+        signingKey: signingKey.value,
+        origin,
+        enabled: Option.isSome(apiKey) && Redacted.value(apiKey.value).length > 0,
+        identity: { reference, provider: provider.identity },
+      }
+    : undefined;
+  return {
+    configuration,
+    handlers: mapsRoutesHandlers({
+      apiKey,
+      signingKey,
+      origin,
+      provider: provider.identity,
+      ...(fetcher === undefined ? {} : { fetcher }),
+    }),
+  };
+}).pipe(Effect.provide(BrowserCrypto.layer));
diff --git a/apps/hosted/cloud/src/infrastructure/maps-routes/google.ts b/apps/hosted/cloud/src/infrastructure/maps-routes/google.ts
new file mode 100644
index 0000000..3e6b8a2
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/maps-routes/google.ts
@@ -0,0 +1,101 @@
+import { Effect, Redacted } from "effect";
+import type { ComputeRoutesRequest } from "./request.ts";
+
+const GOOGLE_ROUTES_URL = "https://routes.googleapis.com/directions/v2:computeRoutes";
+const FIELD_MASK = [
+  "routes.distanceMeters",
+  "routes.duration",
+  "routes.polyline.encodedPolyline",
+  "routes.legs.distanceMeters",
+  "routes.legs.duration",
+  "routes.legs.startLocation",
+  "routes.legs.endLocation",
+  "routes.legs.steps.distanceMeters",
+  "routes.legs.steps.staticDuration",
+  "routes.legs.steps.navigationInstruction.instructions",
+  "routes.legs.steps.navigationInstruction.maneuver",
+].join(",");
+const RESPONSE_LIMIT = 128 * 1024;
+
+type Result =
+  | { readonly kind: "success"; readonly body: Record<string, unknown> }
+  | { readonly kind: "rejected" }
+  | { readonly kind: "failed" };
+
+const isRecord = (value: unknown): value is Record<string, unknown> =>
+  typeof value === "object" && value !== null && !Array.isArray(value);
+
+const readBounded = async (response: Response, limit: number, signal: AbortSignal) => {
+  const declared = Number(response.headers.get("content-length") ?? 0);
+  if (Number.isFinite(declared) && declared > limit) return undefined;
+  if (response.body === null) return new Uint8Array();
+  const reader = response.body.getReader();
+  const chunks: Uint8Array[] = [];
+  let size = 0;
+  const cancel = () => {
+    void reader.cancel();
+  };
+  signal.addEventListener("abort", cancel, { once: true });
+  try {
+    while (true) {
+      const item = await reader.read();
+      if (item.done) break;
+      size += item.value.byteLength;
+      if (size > limit) {
+        await reader.cancel();
+        return undefined;
+      }
+      chunks.push(item.value);
+    }
+  } finally {
+    signal.removeEventListener("abort", cancel);
+    reader.releaseLock();
+  }
+  const bytes = new Uint8Array(size);
+  let offset = 0;
+  for (const chunk of chunks) {
+    bytes.set(chunk, offset);
+    offset += chunk.byteLength;
+  }
+  return bytes;
+};
+
+/** Google is the only upstream. Callers cannot set its URL, method, key, or field mask. */
+export const computeRoutes = (
+  fetcher: typeof fetch,
+  apiKey: Redacted.Redacted<string>,
+  input: ComputeRoutesRequest,
+): Effect.Effect<Result> =>
+  Effect.gen(function* () {
+    const upstream = yield* Effect.tryPromise({
+      try: (signal) =>
+        fetcher(GOOGLE_ROUTES_URL, {
+          method: "POST",
+          redirect: "manual",
+          signal,
+          headers: {
+            "content-type": "application/json",
+            "x-goog-api-key": Redacted.value(apiKey),
+            "x-goog-fieldmask": FIELD_MASK,
+          },
+          body: JSON.stringify(input),
+        }),
+      catch: () => ({ _tag: "RoutesUpstreamFailed" as const }),
+    }).pipe(Effect.timeout("12 seconds"), Effect.option);
+    if (upstream._tag === "None") return { kind: "failed" as const };
+    if (!upstream.value.ok)
+      return upstream.value.status >= 400 && upstream.value.status < 500
+        ? { kind: "rejected" as const }
+        : { kind: "failed" as const };
+    const bytes = yield* Effect.tryPromise({
+      try: (signal) => readBounded(upstream.value, RESPONSE_LIMIT, signal),
+      catch: () => ({ _tag: "RoutesUpstreamBodyFailed" as const }),
+    }).pipe(Effect.timeout("5 seconds"), Effect.option);
+    if (bytes._tag === "None" || bytes.value === undefined) return { kind: "failed" as const };
+    const parsed = yield* Effect.try({
+      try: () => JSON.parse(new TextDecoder().decode(bytes.value)) as unknown,
+      catch: () => ({ _tag: "InvalidRoutesUpstreamJson" as const }),
+    }).pipe(Effect.option);
+    if (parsed._tag === "None" || !isRecord(parsed.value)) return { kind: "failed" as const };
+    return { kind: "success" as const, body: parsed.value };
+  });
diff --git a/apps/hosted/cloud/src/infrastructure/maps-routes/index.ts b/apps/hosted/cloud/src/infrastructure/maps-routes/index.ts
new file mode 100644
index 0000000..0f6c69a
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/maps-routes/index.ts
@@ -0,0 +1,223 @@
+import { AppId, ProviderId } from "@executor-js/sdk/core";
+import { authorizeHostedRoutesAccount } from "@executor-js/hosted-server/hosted-routes";
+import { HostedRoutesConfiguration } from "@executor-js/hosted-server/hosted-routes/contracts";
+import { verifyHostedRoutesToken } from "@executor-js/hosted-server/hosted-routes-token";
+import { GroupDatabase } from "@executor-js/hosted-server/groups";
+import { OrganizationId } from "@executor-js/hosted-server/organization";
+import { Effect, Option, Redacted, Result, Schema, Stream } from "effect";
+import { HttpServerRequest, HttpServerResponse } from "effect/http";
+import type { SqlClient } from "effect/sql";
+import { computeRoutes } from "./google.ts";
+import { ComputeRoutesRequest, validComputeRoutesRequest } from "./request.ts";
+import { ComputeRoutesResponse } from "./response.ts";
+import { reserveMapsRoute } from "./usage.ts";
+
+export const mapsRoutesPath = "/api/maps/routes";
+export const mapsRoutesHealthPath = "/api/maps/routes/health";
+
+const BODY_LIMIT = 16 * 1024;
+const NO_STORE = { "cache-control": "no-store", "x-content-type-options": "nosniff" } as const;
+
+interface RoutesOptions {
+  readonly apiKey: Option.Option<Redacted.Redacted<string>>;
+  readonly signingKey: Option.Option<Redacted.Redacted<string>>;
+  readonly origin: string;
+  readonly provider: ProviderId;
+  /** Used by the cloud emulator boundary to route only the fixed Google request to its fixture. */
+  readonly fetcher?: typeof fetch;
+}
+
+const tokenFrom = (request: HttpServerRequest.HttpServerRequest) => {
+  const authorization = request.headers.authorization;
+  if (typeof authorization !== "string" || !authorization.startsWith("Bearer ")) return undefined;
+  const token = authorization.slice("Bearer ".length);
+  return token.length > 0 && token.length <= 4096 ? token : undefined;
+};
+
+const authorize = (
+  sql: SqlClient.SqlClient,
+  input: {
+    readonly token: string | undefined;
+    readonly signingKey: Option.Option<Redacted.Redacted<string>>;
+    readonly origin: string;
+    readonly provider: ProviderId;
+  },
+) =>
+  Effect.gen(function* () {
+    if (Option.isNone(input.signingKey) || input.token === undefined) return undefined;
+    const signingKey = input.signingKey.value;
+    const token = input.token;
+    const claims = yield* Effect.tryPromise(() =>
+      verifyHostedRoutesToken(Redacted.value(signingKey), token),
+    ).pipe(Effect.option);
+    if (Option.isNone(claims) || claims.value === undefined || claims.value.origin !== input.origin)
+      return undefined;
+    const app = yield* Schema.decodeUnknownEffect(AppId)(claims.value.app).pipe(Effect.option);
+    const organization = yield* Schema.decodeUnknownEffect(OrganizationId)(
+      claims.value.organization,
+    ).pipe(Effect.option);
+    if (Option.isNone(app) || Option.isNone(organization) || claims.value.user.length === 0)
+      return undefined;
+    yield* authorizeHostedRoutesAccount(sql, {
+      app: app.value,
+      organization: organization.value,
+      user: claims.value.user,
+      nonce: claims.value.nonce,
+      provider: input.provider,
+      tokenOrigin: claims.value.origin,
+    });
+    return {
+      app: claims.value.app,
+      organization: claims.value.organization,
+      user: claims.value.user,
+      nonce: claims.value.nonce,
+    };
+  }).pipe(Effect.catchTag("OrganizationForbidden", () => Effect.succeed(undefined)));
+
+const response = (body: unknown, status = 200) =>
+  HttpServerResponse.json(body, { status, headers: NO_STORE });
+
+const authFailure = () => response({ error: "unauthorized" }, 401);
+const unavailable = () => response({ error: "routes_unavailable" }, 503);
+
+const boundedRequestText = (request: HttpServerRequest.HttpServerRequest) =>
+  Stream.runFoldEffect(
+    request.stream,
+    () => ({ chunks: [] as Uint8Array[], size: 0 }),
+    (state, chunk) => {
+      if (state.size + chunk.byteLength > BODY_LIMIT) return Effect.fail("too_large" as const);
+      return Effect.succeed({
+        chunks: [...state.chunks, chunk],
+        size: state.size + chunk.byteLength,
+      });
+    },
+  ).pipe(
+    Effect.map((state) => {
+      const bytes = new Uint8Array(state.size);
+      let offset = 0;
+      for (const chunk of state.chunks) {
+        bytes.set(chunk, offset);
+        offset += chunk.byteLength;
+      }
+      return new TextDecoder().decode(bytes);
+    }),
+    Effect.result,
+  );
+
+/** Cloud-only Routes proxy; never exposes Google's key or lets callers choose an upstream. */
+export const mapsRoutesHandlers = (options: RoutesOptions) => {
+  const apiKey = Option.isSome(options.apiKey) ? options.apiKey.value : undefined;
+  const configured =
+    apiKey !== undefined &&
+    Redacted.value(apiKey).length > 0 &&
+    Option.isSome(options.signingKey) &&
+    Redacted.value(options.signingKey.value).length > 0;
+  const fetcher = options.fetcher ?? globalThis.fetch;
+  const routesConfiguration = {
+    signingKey: Option.isSome(options.signingKey) ? options.signingKey.value : Redacted.make(""),
+    origin: options.origin,
+    enabled: configured,
+    identity: {
+      reference: new URL("/catalog/apps/google-maps.json", options.origin).href,
+      provider: options.provider,
+    },
+  } as const;
+
+  const health = Effect.gen(function* () {
+    if (!configured || apiKey === undefined) return yield* unavailable();
+    const request = yield* HttpServerRequest.HttpServerRequest;
+    const sql = yield* Effect.flatten(GroupDatabase);
+    const authorized = yield* authorize(sql, {
+      token: tokenFrom(request),
+      signingKey: options.signingKey,
+      origin: options.origin,
+      provider: options.provider,
+    });
+    if (authorized === undefined) return yield* authFailure();
+    return yield* response({ status: "ready" });
+  }).pipe(
+    Effect.provideService(HostedRoutesConfiguration, routesConfiguration),
+    Effect.withTracerEnabled(false),
+    Effect.catchCause(() => unavailable()),
+  );
+
+  const post = Effect.gen(function* () {
+    if (!configured || apiKey === undefined) return yield* unavailable();
+    const request = yield* HttpServerRequest.HttpServerRequest;
+    const contentType = request.headers["content-type"]?.toLowerCase() ?? "";
+    if (!contentType.startsWith("application/json"))
+      return yield* response({ error: "expected_json" }, 415);
+    const length = Number(request.headers["content-length"] ?? 0);
+    if (Number.isFinite(length) && length > BODY_LIMIT)
+      return yield* response({ error: "request_too_large" }, 413);
+    const text = yield* boundedRequestText(request);
+    if (Result.isFailure(text))
+      return yield* text.failure === "too_large"
+        ? response({ error: "request_too_large" }, 413)
+        : response({ error: "invalid_json" }, 400);
+    const bodyText = text.success;
+    const parsed = yield* Effect.try({
+      try: () => JSON.parse(bodyText) as unknown,
+      catch: () => ({ _tag: "InvalidRoutesJson" as const }),
+    }).pipe(Effect.option);
+    if (Option.isNone(parsed) || !validComputeRoutesRequest(parsed.value))
+      return yield* response({ error: "invalid_request" }, 400);
+    const decoded = yield* Schema.decodeUnknownEffect(ComputeRoutesRequest)(parsed.value).pipe(
+      Effect.option,
+    );
+    if (Option.isNone(decoded)) return yield* response({ error: "invalid_request" }, 400);
+
+    const sql = yield* Effect.flatten(GroupDatabase);
+    const authorized = yield* authorize(sql, {
+      token: tokenFrom(request),
+      signingKey: options.signingKey,
+      origin: options.origin,
+      provider: options.provider,
+    });
+    if (authorized === undefined) return yield* authFailure();
+
+    const reservation = yield* reserveMapsRoute(
+      sql,
+      authorized,
+      authorizeHostedRoutesAccount(sql, {
+        app: AppId.make(authorized.app),
+        organization: OrganizationId.make(authorized.organization),
+        user: authorized.user,
+        nonce: authorized.nonce,
+        provider: options.provider,
+        tokenOrigin: options.origin,
+      }),
+    );
+    if (!reservation.allowed)
+      return yield* reservation.reason === "limit"
+        ? response({ error: "route_quota_exceeded", limit: reservation.limit }, 429)
+        : unavailable();
+
+    const result = yield* computeRoutes(fetcher, apiKey, decoded.value);
+    if (result.kind === "rejected")
+      return yield* response({ error: "route_request_rejected" }, 422);
+    if (result.kind === "failed") return yield* response({ error: "routes_upstream_failed" }, 502);
+    const safe = yield* Schema.decodeUnknownEffect(ComputeRoutesResponse)(result.body).pipe(
+      Effect.option,
+    );
+    if (Option.isNone(safe)) return yield* response({ error: "routes_upstream_failed" }, 502);
+    const key = Redacted.value(apiKey);
+    const scrub = (value: unknown): unknown =>
+      typeof value === "string"
+        ? value.split(key).join("[redacted]")
+        : Array.isArray(value)
+          ? value.map(scrub)
+          : value !== null && typeof value === "object"
+            ? Object.fromEntries(
+                Object.entries(value).map(([name, nested]) => [name, scrub(nested)]),
+              )
+            : value;
+    return yield* response(scrub(safe.value));
+  }).pipe(
+    Effect.provideService(HostedRoutesConfiguration, routesConfiguration),
+    Effect.withTracerEnabled(false),
+    Effect.catchCause(() => unavailable()),
+  );
+
+  return { post, health };
+};
diff --git a/apps/hosted/cloud/src/infrastructure/maps-routes/request.ts b/apps/hosted/cloud/src/infrastructure/maps-routes/request.ts
new file mode 100644
index 0000000..760649a
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/maps-routes/request.ts
@@ -0,0 +1,77 @@
+import { Schema } from "effect";
+
+const Waypoint = Schema.Union([
+  Schema.Struct({ address: Schema.String }),
+  Schema.Struct({ placeId: Schema.String }),
+  Schema.Struct({
+    location: Schema.Struct({
+      latLng: Schema.Struct({
+        latitude: Schema.Number,
+        longitude: Schema.Number,
+      }),
+    }),
+  }),
+]);
+
+export const ComputeRoutesRequest = Schema.Struct({
+  origin: Waypoint,
+  destination: Waypoint,
+  intermediates: Schema.optionalKey(Schema.Array(Waypoint)),
+  travelMode: Schema.Literals(["DRIVE", "WALK", "BICYCLE", "TRANSIT"]),
+});
+export type ComputeRoutesRequest = typeof ComputeRoutesRequest.Type;
+
+const isRecord = (value: unknown): value is Record<string, unknown> =>
+  typeof value === "object" && value !== null && !Array.isArray(value);
+const onlyKeys = (value: Record<string, unknown>, keys: readonly string[]) =>
+  Object.keys(value).every((key) => keys.includes(key));
+
+/** Reject fields the host has not priced and bounded, including nested waypoint options. */
+const validWaypoint = (value: unknown): boolean => {
+  if (!isRecord(value) || !onlyKeys(value, ["address", "placeId", "location"])) return false;
+  if (Object.keys(value).length !== 1) return false;
+  if ("address" in value)
+    return (
+      typeof value.address === "string" &&
+      value.address.trim().length > 0 &&
+      value.address.length <= 512
+    );
+  if ("placeId" in value)
+    return (
+      typeof value.placeId === "string" &&
+      value.placeId.trim().length > 0 &&
+      value.placeId.length <= 256
+    );
+  const location = value.location;
+  if (!isRecord(location) || !onlyKeys(location, ["latLng"]) || !isRecord(location.latLng))
+    return false;
+  const latLng = location.latLng;
+  return (
+    onlyKeys(latLng, ["latitude", "longitude"]) &&
+    typeof latLng.latitude === "number" &&
+    Number.isFinite(latLng.latitude) &&
+    latLng.latitude >= -90 &&
+    latLng.latitude <= 90 &&
+    typeof latLng.longitude === "number" &&
+    Number.isFinite(latLng.longitude) &&
+    latLng.longitude >= -180 &&
+    latLng.longitude <= 180
+  );
+};
+
+export const validComputeRoutesRequest = (value: unknown): value is ComputeRoutesRequest => {
+  if (
+    !isRecord(value) ||
+    !onlyKeys(value, ["origin", "destination", "intermediates", "travelMode"])
+  )
+    return false;
+  if (!validWaypoint(value.origin) || !validWaypoint(value.destination)) return false;
+  if (
+    value.intermediates !== undefined &&
+    (!Array.isArray(value.intermediates) ||
+      value.intermediates.length > 10 ||
+      value.intermediates.some((waypoint) => !validWaypoint(waypoint)))
+  )
+    return false;
+  return ["DRIVE", "WALK", "BICYCLE", "TRANSIT"].includes(String(value.travelMode));
+};
diff --git a/apps/hosted/cloud/src/infrastructure/maps-routes/response.ts b/apps/hosted/cloud/src/infrastructure/maps-routes/response.ts
