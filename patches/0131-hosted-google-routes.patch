+import { isLoopbackHostname } from "@executor-js/utils/url-policy";
+import type { ProviderDefinition, ProviderId } from "@executor-js/sdk/core";
+import { Context, Redacted } from "effect";
+
+/** Stable app-source identity and provider identity computed from the rendered catalog source. */
+export interface HostedRoutesAppIdentity {
+  readonly reference: string;
+  readonly provider: ProviderId;
+}
+
+/** Host-owned settings for the hosted Google Routes capability. */
+export interface HostedRoutesConfiguration {
+  readonly signingKey: Redacted.Redacted<string>;
+  readonly origin: string;
+  readonly enabled: boolean;
+  readonly identity?: HostedRoutesAppIdentity;
+}
+
+/** Disabled by default so local and unrelated hosted installs fail closed. */
+export const HostedRoutesConfiguration = Context.Reference<HostedRoutesConfiguration | undefined>(
+  "hosted/RoutesConfiguration",
+  { defaultValue: () => undefined },
+);
+
+/** The one member account the official Maps app uses for host-paid Routes calls. */
+export const hostedRoutesRequirement = "hostedRoutes" as const;
+export const hostedRoutesMethod = "hostedRoutes" as const;
+
+/** Requests stay on this host's API Worker. */
+export const hostedRoutesPath = "/api/maps/routes";
+export const hostedRoutesHealthPath = "/api/maps/routes/health";
+
+const canonicalHostedRoutesOrigin = (origin: string) => {
+  const url = new URL(origin);
+  if (
+    url.origin !== origin ||
+    (url.protocol !== "https:" && !(url.protocol === "http:" && isLoopbackHostname(url.hostname)))
+  )
+    throw new Error("Hosted Routes origin must be a canonical HTTP(S) origin");
+  return url;
+};
+
+/** Provider declaration shared with the rendered Google Maps catalog source. */
+export const hostedRoutesProviderDefinition = (origin: string): ProviderDefinition => {
+  const url = canonicalHostedRoutesOrigin(origin);
+  return {
+    name: "Google Maps Routes",
+    hosts: [url.host],
+    auth: {
+      [hostedRoutesMethod]: {
+        type: "secrets",
+        provisioned: true,
+        label: "Signalbox hosted routes",
+        fields: {
+          $schema: "https://json-schema.org/draft/2020-12/schema",
+          type: "object",
+          properties: {
+            origin: { type: "string", minLength: 1 },
+            token: { type: "string", minLength: 1 },
+          },
+          required: ["origin", "token"],
+          additionalProperties: true,
+          $defs: {},
+        },
+        plain: ["origin"],
+        request: [
+          {
+            in: "header",
+            name: "authorization",
+            value: ["Bearer ", { field: "token" }],
+          },
+        ],
+      },
+    },
+  };
+};
+
+/** The copy origin of the one rendered Maps catalog app for this hosted deployment. */
+export const hostedRoutesCatalogReference = (origin: string) =>
+  `${canonicalHostedRoutesOrigin(origin).origin}/catalog/apps/google-maps.json`;
