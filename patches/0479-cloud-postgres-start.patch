index 0000000..ae621d0
--- /dev/null
+++ b/e2e/support/cloud-postgres-fixtures.ts
@@ -0,0 +1,66 @@
+import { connect } from "node:net";
+import { Effect, FileSystem } from "effect";
+import { ChildProcess, ChildProcessSpawner } from "effect/process";
+
+/** Exercise the published TCP endpoint, not just pg_isready inside the container. */
+export const postgresHandshake = (port: number) =>
+  Effect.gen(function* () {
+    const socket = yield* Effect.acquireRelease(
+      Effect.sync(() => connect({ host: "127.0.0.1", port })),
+      (socket) =>
+        Effect.sync(() => {
+          socket.destroy();
+        }),
+    );
+    return yield* Effect.tryPromise(
+      () =>
+        new Promise<string>((resolve, reject) => {
+          socket.setTimeout(5000, () => socket.destroy(new Error("Postgres handshake timed out")));
+          socket.once("error", reject);
+          socket.once("connect", () => socket.write(Buffer.from([0, 0, 0, 8, 4, 210, 22, 47])));
+          socket.once("data", (data) => resolve(data.toString()));
+          socket.once("end", () =>
+            reject(new Error("Postgres closed before the handshake response")),
+          );
+        }),
+    );
+  });
+
+export const localDocker = Effect.gen(function* () {
+  const fs = yield* FileSystem.FileSystem;
+  const processes = yield* ChildProcessSpawner.ChildProcessSpawner;
+  const directory = yield* fs.makeTempDirectoryScoped();
+  const host = (yield* processes.string(
+    ChildProcess.make("docker", ["context", "inspect", "--format", "{{.Endpoints.docker.Host}}"]),
+  )).trim();
+  if (!host.startsWith("unix://") && !host.startsWith("npipe://"))
+    return yield* Effect.die("A local Docker daemon is required");
+  return {
+    directory,
+    dockerEnv: { PATH: process.env.PATH ?? "", DOCKER_HOST: host, DOCKER_CONFIG: directory },
+  };
+});
+
+/** Fail one Docker sub-step without touching the daemon or relying on network outages. */
+export const failedDocker = (step: "pull" | "create" | "start", secret: string) =>
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem;
+    const directory = yield* fs.makeTempDirectoryScoped();
+    yield* fs.writeFileString(
+      `${directory}/docker`,
+      `#!/bin/sh
+case "$1" in
+  rm) : > "${directory}/removed"; exit 0 ;;
+  ps) exit 0 ;;
+  image) ${step === "pull" ? "exit 1" : "exit 0"} ;;
+  ${step}) echo 'daemon ${step} refused: ${secret}' >&2; exit 1 ;;
+  *) exit 0 ;;
+esac
+`,
+      { mode: 0o700 },
+    );
+    return {
+      directory,
+      dockerEnv: { PATH: directory, DOCKER_HOST: "unix:///synthetic", DOCKER_CONFIG: directory },
+    };
+  });
