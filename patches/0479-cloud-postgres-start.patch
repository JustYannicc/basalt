diff --git a/e2e/support/cloud-postgres-command.ts b/e2e/support/cloud-postgres-command.ts
new file mode 100644
index 0000000..5398fd6
--- /dev/null
+++ b/e2e/support/cloud-postgres-command.ts
@@ -0,0 +1,83 @@
+/** Docker diagnostics stay attached to the sub-step that failed, without test passwords. */
+import { Effect, FileSystem, Schema, Stream } from "effect";
+import { ChildProcess, ChildProcessSpawner } from "effect/process";
+
+export class CloudPostgresFailed extends Schema.TaggedError<CloudPostgresFailed>()(
+  "CloudPostgresFailed",
+  {
+    operation: Schema.String,
+  },
+) {
+  get message() {
+    return `Cloud test environment failed: ${this.operation}`;
+  }
+}
+
+export const postgresCommand = (input: {
+  readonly dockerEnv: Readonly<Record<string, string>>;
+  readonly log: string;
+  readonly secrets: ReadonlyArray<string>;
+}) =>
+  Effect.gen(function* () {
+    const processes = yield* ChildProcessSpawner.ChildProcessSpawner;
+    const fs = yield* FileSystem.FileSystem;
+    const redact = (text: string) =>
+      input.secrets
+        .filter(Boolean)
+        .reduce(
+          (safe, secret) =>
+            safe
+              .replaceAll(secret, "<redacted>")
+              .replaceAll(encodeURIComponent(secret), "<redacted>"),
+          text,
+        );
+    const run = (args: ReadonlyArray<string>, env: Record<string, string> = {}) =>
+      Effect.scoped(
+        Effect.gen(function* () {
+          const child = yield* processes.spawn(
+            ChildProcess.make("docker", args, {
+              env: { ...input.dockerEnv, ...env },
+              extendEnv: false,
+              stdout: "pipe",
+              stderr: "pipe",
+            }),
+          );
+          const [code, stdout, stderr] = yield* Effect.all(
+            [
+              child.exitCode,
+              Stream.mkString(Stream.decodeText(child.stdout)),
+              Stream.mkString(Stream.decodeText(child.stderr)),
+            ],
+            { concurrency: 3 },
+          );
+          return { code, stdout: redact(stdout), stderr: redact(stderr) };
+        }),
+      );
+    const check = (
+      operation: string,
+      subcommand: string,
+      result: { readonly code: number; readonly stdout: string; readonly stderr: string },
+    ) =>
+      Effect.gen(function* () {
+        if (result.code === 0) return result.stdout;
+        const diagnostic = `${operation} (docker ${subcommand}, exit ${result.code}): ${[result.stderr.trim(), result.stdout.trim()].filter(Boolean).join("\n") || "no Docker diagnostic"}`;
+        return yield* new CloudPostgresFailed({ operation: diagnostic });
+      }).pipe(
+        Effect.tapError((error) =>
+          fs.writeFileString(input.log, `${error.message}\n`, { flag: "a", mode: 0o600 }),
+        ),
+      );
+    const checked = (
+      operation: string,
+      args: ReadonlyArray<string>,
+      env?: Record<string, string>,
+    ) =>
+      run(args, env).pipe(
+        Effect.mapError(
+          (error) =>
+            new CloudPostgresFailed({ operation: redact(`${operation}: ${error.message}`) }),
+        ),
+        Effect.flatMap((result) => check(operation, args[0] ?? "", result)),
+      );
+    return { run, check, checked };
+  });
diff --git a/e2e/support/cloud-postgres-fixtures.ts b/e2e/support/cloud-postgres-fixtures.ts
