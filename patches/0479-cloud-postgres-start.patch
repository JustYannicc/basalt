+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { expect, layer } from "@effect/vitest";
+import { Cause, Effect, Exit, FileSystem } from "effect";
+import { ChildProcess, ChildProcessSpawner } from "effect/process";
+import { startCloudPostgres } from "../support/cloud-postgres.ts";
+import {
+  failedDocker,
+  localDocker,
+  postgresHandshake,
+} from "../support/cloud-postgres-fixtures.ts";
+import { holdPort } from "../support/ports.ts";
+import { productionOpsDatabaseProxy } from "../support/production-ops-database-proxy.ts";
+
+layer(NodeServices.layer, { excludeTestServices: true })("Cloud Postgres", (it) => {
+  it.effect(
+    "starts on an owned port despite an occupied earlier allocation and removes the container",
+    () =>
+      Effect.gen(function* () {
+        const { directory, dockerEnv } = yield* localDocker;
+        const processes = yield* ChildProcessSpawner.ChildProcessSpawner;
+        const stalePort = yield* holdPort(0);
+        const container = `executor-e2e-port-proof-${process.pid}`;
+        yield* Effect.scoped(
+          Effect.gen(function* () {
+            const { databasePort } = yield* startCloudPostgres({
+              container,
+              dockerEnv,
+              databasePassword: "synthetic-postgres-password",
+              runtimePassword: "synthetic-runtime-password",
+              log: `${directory}/postgres.log`,
+            });
+            expect(databasePort).not.toBe(stalePort);
+            expect(yield* postgresHandshake(databasePort)).toBe("N");
+            const alternate = yield* productionOpsDatabaseProxy();
+            yield* alternate.select(databasePort);
+            expect(alternate.port).not.toBe(databasePort);
+            expect(yield* postgresHandshake(alternate.port)).toBe("N");
+            const role = yield* processes.string(
+              ChildProcess.make(
+                "docker",
+                [
+                  "exec",
+                  container,
+                  "psql",
+                  "-U",
+                  "executor",
+                  "-d",
+                  "executor",
+                  "-Atc",
+                  "select rolname from pg_roles where rolname = 'executor_runtime'",
+                ],
+                { env: dockerEnv, extendEnv: false },
+              ),
+            );
+            expect(role.trim()).toBe("executor_runtime");
+          }),
+        );
+        expect(
+          yield* processes.exitCode(
+            ChildProcess.make("docker", ["inspect", container], {
+              env: dockerEnv,
+              extendEnv: false,
+              stdout: "ignore",
+              stderr: "ignore",
+            }),
+          ),
+        ).not.toBe(0);
+      }).pipe(Effect.scoped),
+  );
+
+  it.effect("names a real bind conflict and removes the failed container", () =>
+    Effect.gen(function* () {
+      const { directory, dockerEnv } = yield* localDocker;
+      const processes = yield* ChildProcessSpawner.ChildProcessSpawner;
+      const port = yield* holdPort(0);
+      const container = `executor-e2e-conflict-proof-${process.pid}`;
+      const result = yield* Effect.exit(
+        Effect.scoped(
+          startCloudPostgres({
+            container,
+            dockerEnv,
+            databasePort: port,
+            databasePassword: "synthetic-conflict-password",
+            log: `${directory}/postgres.log`,
+          }),
+        ),
+      );
+      expect(Exit.isFailure(result)).toBe(true);
+      if (Exit.isFailure(result)) {
+        const message = Cause.pretty(result.cause);
+        expect(message).toContain("Start the Postgres container (docker start, exit 1)");
+        expect(message).toMatch(
+          /address already in use|port is already allocated|ports are not available/i,
+        );
+      }
+      expect(
+        yield* processes.exitCode(
+          ChildProcess.make("docker", ["inspect", container], {
+            env: dockerEnv,
+            extendEnv: false,
+            stdout: "ignore",
+            stderr: "ignore",
+          }),
+        ),
+      ).not.toBe(0);
+    }).pipe(Effect.scoped),
+  );
+
+  for (const step of ["pull", "create", "start"] as const) {
+    it.effect(`retains the ${step} diagnostic without the database password`, () =>
+      Effect.gen(function* () {
+        const secret = "synthetic-diagnostic-secret";
+        const { directory, dockerEnv } = yield* failedDocker(step, secret);
+        const fs = yield* FileSystem.FileSystem;
+        const log = `${directory}/postgres.log`;
+        const result = yield* Effect.exit(
+          Effect.scoped(
+            startCloudPostgres({
+              container: "synthetic-postgres",
+              dockerEnv,
+              databasePassword: secret,
+              log,
+            }),
+          ),
+        );
+        expect(Exit.isFailure(result)).toBe(true);
+        if (Exit.isFailure(result)) {
+          const message = Cause.pretty(result.cause);
+          expect(message).toContain(`docker ${step}, exit 1`);
+          expect(message).toContain(`daemon ${step} refused: <redacted>`);
+          expect(message).not.toContain(secret);
+        }
+        const retained = yield* fs.readFileString(log);
+        expect(retained).toContain(`daemon ${step} refused: <redacted>`);
+        expect(retained).not.toContain(secret);
+        expect(yield* fs.exists(`${directory}/removed`)).toBe(step !== "pull");
+      }).pipe(Effect.scoped),
+    );
+  }
