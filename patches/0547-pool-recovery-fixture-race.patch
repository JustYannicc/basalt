diff --git a/e2e/support/provisioning-settlement.ts b/e2e/support/provisioning-settlement.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/provisioning-settlement.ts
@@ -0,0 +1,47 @@
+/** Await an already-dispatched provisioning attempt, including its committed retry handoff. */
+import { expect } from "@effect/vitest";
+import { Effect } from "effect";
+import { randomUUID } from "node:crypto";
+import type { cloudLocks } from "./cloud-locks.ts";
+
+export const provisioningSettlement = (
+  database: Effect.Success<typeof cloudLocks>,
+  organization: string,
+) =>
+  Effect.gen(function* () {
+    const rows = (sql: string, params: readonly string[] = []) => database.run({ sql, params });
+    const milestone = `pool_recovery_${randomUUID().replaceAll("-", "")}`;
+    yield* database.listen(milestone);
+    yield* Effect.addFinalizer(() =>
+      Effect.gen(function* () {
+        yield* rows(`drop trigger if exists ${milestone} on hosted_provisioning`);
+        yield* rows(`drop function if exists ${milestone}()`);
+      }).pipe(Effect.orDie),
+    );
+    yield* rows(`create function ${milestone}() returns trigger language plpgsql as $$ begin
+    perform pg_notify('${milestone}', new.id); return new; end $$`);
+    yield* rows(`create trigger ${milestone} after update of status on hosted_provisioning
+    for each row when (new.organization_id = '${organization.replaceAll("'", "''")}'
+      and new.status in ('queued', 'succeeded', 'failed') and new.attempts > 0) execute function ${milestone}()`);
+    return (ids: readonly unknown[]) =>
+      Effect.gen(function* () {
+        if (ids.length === 0) return [];
+        for (;;) {
+          const jobs = yield* rows(
+            `select id, status, attempts from hosted_provisioning
+            where id in (select jsonb_array_elements_text($1::jsonb)) order by id`,
+            [JSON.stringify(ids)],
+          );
+          expect(jobs).toHaveLength(ids.length);
+          expect(jobs.some((job) => job.status === "failed")).toBe(false);
+          if (
+            jobs.every(
+              (job) =>
+                job.status === "succeeded" || (job.status === "queued" && Number(job.attempts) > 0),
+            )
+          )
+            return jobs;
+          yield* database.notified;
+        }
+      });
+  });
