diff --git a/e2e/support/account-view-query-trace.ts b/e2e/support/account-view-query-trace.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/account-view-query-trace.ts
@@ -0,0 +1,114 @@
+export interface AccountViewSpan {
+  readonly traceId: string;
+  readonly span: {
+    readonly spanId: string;
+    readonly parentSpanId: string | null;
+    readonly operationName: string;
+    readonly startTime: string;
+    readonly durationMs: number;
+    readonly tags: Readonly<Record<string, unknown>>;
+  };
+}
+
+export interface AccountViewTraceInput {
+  readonly traceId: string;
+  readonly serverSpanId: string | undefined;
+  readonly sources: readonly number[];
+  readonly requiredExecutions?: 1 | 2;
+}
+
+export const inspectAccountViewTrace = (
+  rows: readonly AccountViewSpan[],
+  input: AccountViewTraceInput,
+) => {
+  const fail = (): never => {
+    throw new Error("The completed query trace is partial or has missing parents");
+  };
+  const spans = rows.map(({ span }) => span);
+  const byId = new Map(spans.map((span) => [span.spanId, span]));
+  const server = byId.get(input.serverSpanId ?? "");
+  if (
+    server?.operationName !== "http.server POST" ||
+    byId.size !== spans.length ||
+    rows.some((row) => row.traceId !== input.traceId) ||
+    spans.some(
+      (span) =>
+        span.operationName.startsWith("[missing parent") ||
+        (span.parentSpanId !== null && !byId.has(span.parentSpanId)) ||
+        !Number.isFinite(Date.parse(span.startTime)) ||
+        !Number.isFinite(span.durationMs) ||
+        span.durationMs < 0,
+    )
+  )
+    return fail();
+  const descendsFrom = (span: AccountViewSpan["span"], ancestor: string): boolean => {
+    const seen = new Set<string>();
+    let parent = span.parentSpanId;
+    while (parent !== null) {
+      if (seen.has(parent)) return fail();
+      seen.add(parent);
+      if (parent === ancestor) return true;
+      parent = byId.get(parent)?.parentSpanId ?? null;
+    }
+    return false;
+  };
+  const queries = spans
+    .filter((span) => span.operationName === "sdk.data.query")
+    .sort((a, b) => Date.parse(a.startTime) - Date.parse(b.startTime));
+  const executions = queries.length;
+  const order = server.tags["app.ui.query.phase_order"];
+  if (
+    (executions !== 1 && executions !== 2) ||
+    (input.requiredExecutions !== undefined && executions !== input.requiredExecutions) ||
+    order !== ["session_access", ...Array(executions).fill("caller_accounts"), "dispatch"].join(",")
+  )
+    return fail();
+  const operations = (name: string) => spans.filter((span) => span.operationName === name);
+  const invokes = operations("runtime.app.remote.invoke");
+  const releases = operations("runtime.app.rpc.release");
+  const catalogs = operations("catalog.lookup");
+  const counts = queries.map((query, index) => {
+    const start = Date.parse(query.startTime);
+    const end = start + query.durationMs;
+    if (
+      !descendsFrom(query, server.spanId) ||
+      query.durationMs <= 0 ||
+      start < Date.parse(server.startTime) ||
+      end > Date.parse(server.startTime) + server.durationMs ||
+      (index > 0 &&
+        start < Date.parse(queries[index - 1]!.startTime) + queries[index - 1]!.durationMs)
+    )
+      return fail();
+    const calls = invokes.filter((span) => descendsFrom(span, query.spanId));
+    const done = releases.filter((span) => descendsFrom(span, query.spanId));
+    // The cached catalog effect keeps its creation context, so it may be a sibling of the query.
+    const lookups = catalogs.filter((span) => {
+      const at = Date.parse(span.startTime);
+      return at >= start && at + span.durationMs <= end && descendsFrom(span, server.spanId);
+    });
+    if (
+      calls.length !== (input.sources[index] ?? -1) + 1 ||
+      done.length !== calls.length ||
+      new Set(calls.map((call) => call.parentSpanId)).size !== calls.length ||
+      // Remote invocation and server-side release are siblings under the same Cloud call.
+      calls.some(
+        (call) =>
+          call.parentSpanId === null ||
+          !["runtime.cloud.query", "runtime.cloud.call"].includes(
+            byId.get(call.parentSpanId)!.operationName,
+          ) ||
+          done.filter((span) => descendsFrom(span, call.parentSpanId!)).length !== 1,
+      ) ||
+      lookups.length !== 1
+    )
+      return fail();
+    return { invokes: calls.length, releases: done.length, catalogs: lookups.length };
+  });
+  if (
+    invokes.length !== counts.reduce((sum, count) => sum + count.invokes, 0) ||
+    releases.length !== counts.reduce((sum, count) => sum + count.releases, 0) ||
+    catalogs.length !== executions
+  )
+    return fail();
+  return { executions, counts, queries };
+};
