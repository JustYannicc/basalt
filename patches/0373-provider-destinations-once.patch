+import { permittedAppIds, permitsAction } from "@executor-js/authorization";
+import type { CatalogEntry } from "@executor-js/catalog/contracts";
+import { StorageError, identifyProvider, type App, type AppId } from "@executor-js/sdk/core";
+import { providerDeclaration } from "apps/host";
+import { Crypto, Effect, Option } from "effect";
+import { CurrentAuthorization } from "../contracts/authorization.ts";
+import { HostedCatalog } from "../contracts/catalog.ts";
+import { HostedExecutor } from "../contracts/executor.ts";
+import type { ProviderAccountDestination } from "../contracts/provider-account-policy.ts";
+import type { AppServiceIdentity } from "../contracts/service-install.ts";
+import { currentOwner } from "./access.ts";
+import { providers } from "./pool-provider-definitions.ts";
+import {
+  currentResourceAuthority,
+  policyDatabase,
+  visibleAppsWithAccessAs,
+  type ResourceAuthority,
+} from "./resource-policy.ts";
+import { recordedServiceInstalls } from "./service-install-records.ts";
+
+type Slot = App["requirements"]["accounts"][string];
+const unavailable = (reason: string) => ({ kind: "unavailable" as const, reason });
+const appRequirements = (app: App) =>
+  app.activeVersion === null
+    ? []
+    : Object.entries(app.requirements.accounts).filter(([, slot]) => slot.scope === "app");
+
+/** Prepare destination decisions and provider-app identity for one authorized call. */
+export const providerAccountContext = (
+  app: App,
+  requirements: readonly string[],
+  options: { readonly classify?: boolean; readonly actor?: ResourceAuthority } = {},
+) =>
+  Effect.gen(function* () {
+    const policy = yield* CurrentAuthorization;
+    const canManageAccounts = permitsAction(policy, "manage");
+    const identities = new Map<string, Effect.Success<ReturnType<typeof identifyProvider>>>();
+    const catalog = yield* Effect.cached(
+      Effect.gen(function* () {
+        const catalog = yield* Effect.serviceOption(HostedCatalog);
+        return Option.isNone(catalog)
+          ? Option.none()
+          : Option.some(yield* catalog.value.list.pipe(Effect.catch(() => Effect.succeed([]))));
+      }),
+    );
+    const resolve = (slot: Slot | undefined) =>
+      Effect.gen(function* () {
+        const family = slot?.definition.family?.id;
+        if (slot === undefined || family === undefined || !Object.hasOwn(providers, family))
+          return unavailable("This retained account must keep its existing link until adoption.");
+        let identity = identities.get(family);
+        if (identity === undefined) {
+          const definition = yield* providerDeclaration(
+            providers[family as keyof typeof providers],
+          );
+          identity = yield* identifyProvider(definition, yield* Crypto.Crypto);
+          identities.set(family, identity);
+        }
+        if (slot.provider !== identity.identity && slot.provider !== identity.legacy)
+          return unavailable("No provider app is registered for this account requirement.");
+        const entries = yield* catalog;
+        if (Option.isNone(entries)) return unavailable("The provider catalog is unavailable.");
+        const entry = entries.value.find((entry) => entry.id === `provider-${family}`);
+        return entry === undefined
+          ? unavailable("This provider app is not available in the catalog.")
+          : { kind: "provider" as const, family, slot, entry };
+      });
+    const requested = new Set(requirements);
+    const classification = options.classify ? appRequirements(app).map(([name]) => name) : [];
+    const plans = new Map<string, Effect.Success<ReturnType<typeof resolve>>>();
+    for (const requirement of new Set([...requested, ...classification]))
+      plans.set(requirement, yield* resolve(app.requirements.accounts[requirement]));
+    const classified = classification.flatMap((requirement) => {
+      const plan = plans.get(requirement)!;
+      return plan.kind === "provider" ? [{ requirement, ...plan }] : [];
+    });
+    const inventory =
+      canManageAccounts && [...requested].some((name) => plans.get(name)!.kind === "provider")
+        ? yield* Effect.gen(function* () {
+            const executor = yield* Effect.flatten(HostedExecutor);
+            const candidates = yield* executor.apps.list({
+              owner: yield* currentOwner,
+              ids: permittedAppIds(policy),
+            });
+            return yield* visibleAppsWithAccessAs(
+              options.actor ?? (yield* currentResourceAuthority),
+              candidates,
+            );
+          })
+        : undefined;
+    const apps = inventory?.apps ?? [];
+    const installApps =
+      classified.length !== 0
+        ? [...new Map([...apps, app].map((candidate) => [candidate.id, candidate])).values()]
+        : apps;
+    const recorded =
+      installApps.length === 0
+        ? new Map<AppId, AppServiceIdentity>()
+        : yield* recordedServiceInstalls(yield* policyDatabase, installApps);
+    const installed = (candidate: App, entry: CatalogEntry) => {
+      const service = recorded.get(candidate.id);
+      return service === undefined
+        ? candidate.copiedFrom?.name === entry.package
+        : service.id === (entry.service?.id ?? entry.package);
+    };
+    const found = classified.filter((plan) => installed(app, plan.entry));
+    const family = found[0]?.family;
+    const providerApp =
+      family === undefined || found.some((plan) => plan.family !== family)
+        ? null
+        : { family, requirements: found.map((plan) => plan.requirement) };
+    const destination = (requirement: string): ProviderAccountDestination => {
+      if (!requested.has(requirement))
+        throw new Error(`Provider account requirement was not prepared: ${requirement}`);
+      const plan = plans.get(requirement)!;
+      if (plan.kind === "unavailable") return plan;
+      if (!canManageAccounts) return unavailable("Account management access is required.");
+      const destinations = apps.flatMap((candidate) => {
+        if (!installed(candidate, plan.entry)) return [];
+        const access = inventory?.access.get(candidate.id);
+        return appRequirements(candidate).flatMap(([requirement, required]) =>
+          required.provider === plan.slot.provider &&
+          (required.contributed ? access?.canUse : access?.canManage)
+            ? [{ app: candidate.id, name: candidate.name, requirement }]
+            : [],
+        );
+      });
+      return destinations.length === 0
+        ? { kind: "catalog", entry: plan.entry.id }
+        : { kind: "apps", apps: destinations };
+    };
+    return { destination, providerApp, canManageAccounts };
+  }).pipe(Effect.mapError(() => new StorageError()));
