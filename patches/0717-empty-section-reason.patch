 const within = (path: string, namespace: string) =>
   path === namespace || path.startsWith(`${namespace}.`);
 
+/**
+ * An app's titled routers that list no tools for this caller, as each one's namespace and what an
+ * agent is told about a path into it: its accounts are connected another way, a policy hides its
+ * tools, or its source lists none. The router's own title and description say what it is for and
+ * what it needs, where "no tool at this path" would send the agent to search for a path that
+ * cannot exist. A router that failed, or has a failed router below it, is reported as a failure.
+ */
+const emptySections = (
+  slug: string,
+  routers: ReadonlyArray<ToolRouter>,
+  tools: ReadonlyArray<AppTool>,
+) =>
+  routers.flatMap((router): ReadonlyArray<readonly [namespace: string, reason: string]> => {
+    if (router.path === "" || router.title === undefined) return [];
+    const inside = (path: string) => within(path, router.path);
+    if (
+      routers.some((other) => other.error !== undefined && inside(other.path)) ||
+      tools.some((tool) => inside(tool.name))
+    )
+      return [];
+    const about = router.description === undefined ? "" : ` ${router.description}`;
+    return [
+      [
+        `${slug}.${toolPath(router.path)}`,
+        `${router.title} lists no tools for this caller.${about}`,
+      ],
+    ];
+  });
+
