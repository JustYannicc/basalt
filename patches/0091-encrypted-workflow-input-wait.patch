@@ -0,0 +1,29 @@
+/** No accounts, database or tools: the question must suspend its native workflow by itself. */
+import { appsManifest } from "./apps-release.ts";
+
+const source = `import { defineApp, workflow, object } from "apps";
+const acceptance = workflow({ input: object({}) }, async (ctx) => {
+  const question = await ctx.step.requestInput("acceptance-question", {
+    timeoutMs: 900000,
+    form: {
+      mode: "form",
+      message: "What should the Basalt HITL test return?",
+      requestedSchema: {
+        type: "object",
+        properties: { answer: { type: "string", title: "Test answer", minLength: 1 } },
+        required: ["answer"]
+      }
+    },
+    evidence: [{ label: "Purpose", value: "Single authorized acceptance test; no external actions." }]
+  });
+  const result = await ctx.step.waitForInput("acceptance-answer", question);
+  return { question: question.id, status: result.status,
+    answer: result.status === "answered" ? result.response : null };
+});
+export default defineApp({}, { workflows: { acceptance } });
+`;
+
+export const acceptanceFiles = (timeoutMs = 900000) => [
+  appsManifest,
+  { path: "index.ts", content: source.replace("timeoutMs: 900000", `timeoutMs: ${timeoutMs}`) },
+];
