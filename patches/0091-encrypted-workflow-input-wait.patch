diff --git a/e2e/tests/workflow-input-encrypted.spec.ts b/e2e/tests/workflow-input-encrypted.spec.ts
new file mode 100644
index 0000000..ee15a16
--- /dev/null
+++ b/e2e/tests/workflow-input-encrypted.spec.ts
@@ -0,0 +1,133 @@
+/** A question-only app must suspend the real encrypted Cloud workflow before anyone answers. */
+import { expect, layer } from "@effect/vitest";
+import { Clock, Effect, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { Evidence } from "../support/evidence.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { acceptanceFiles } from "../support/workflow-input-acceptance-app.ts";
+import { Input, Run } from "../support/workflow-input-fixture.ts";
+import { scenarios } from "../test-plan.ts";
+
+const fixture = (timeoutMs?: number) =>
+  Effect.gen(function* () {
+    const api = yield* Api;
+    const actors = yield* Actors;
+    const evidence = yield* Evidence;
+    const prefix = `/api/organizations/${actors.organization.id}`;
+    const files = acceptanceFiles(timeoutMs);
+    yield* evidence.json("authored-workflow", files);
+    const deploy = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+      name: "Human input acceptance",
+      files,
+    });
+    expect(deploy.status, JSON.stringify(deploy.body)).toBe(200);
+    const app = yield* body(Schema.Struct({ id: Schema.String }), deploy);
+    const path = `${prefix}/apps/${app.id}`;
+    yield* Effect.addFinalizer(() =>
+      Effect.gen(function* () {
+        expect((yield* api.request(actors.owner, "DELETE", path)).status).toBe(200);
+      }).pipe(Effect.orDie),
+    );
+    const started = yield* api.request(actors.owner, "POST", `${path}/workflow-runs`, {
+      workflow: "acceptance",
+      input: {},
+    });
+    expect(started.status, JSON.stringify(started.body)).toBe(200);
+    const run = yield* body(Run, started);
+    yield* Effect.addFinalizer(() =>
+      api
+        .request(actors.owner, "POST", `${path}/workflow-runs/${run.id}/terminate`)
+        .pipe(Effect.asVoid, Effect.orDie),
+    );
+    const wait = (status: "complete") =>
+      Effect.gen(function* () {
+        const deadline = (yield* Clock.currentTimeMillis) + 20000;
+        while (true) {
+          const response = yield* api.request(
+            actors.owner,
+            "GET",
+            `${path}/workflow-runs/${run.id}`,
+          );
+          expect(response.status, JSON.stringify(response.body)).toBe(200);
+          const current = yield* body(Run, response);
+          if (current.status === status) {
+            yield* evidence.json(`run-${status}`, current);
+            return current;
+          }
+          if (["errored", "terminated", "complete"].includes(current.status)) {
+            yield* evidence.json("unexpected-terminal-run", current);
+            expect(current.status, JSON.stringify(current)).toBe(status);
+          }
+          expect(yield* Clock.currentTimeMillis, JSON.stringify(current)).toBeLessThan(deadline);
+          yield* Effect.sleep("50 millis");
+        }
+      });
+    const pending = () =>
+      api.request(actors.owner, "GET", `${prefix}/workflow-inputs?pending=true`).pipe(
+        Effect.tap((response) => Effect.sync(() => expect(response.status).toBe(200))),
+        Effect.flatMap((response) => body(Schema.Struct({ items: Schema.Array(Input) }), response)),
+        Effect.map(({ items }) => items.filter((input) => input.run === run.id)),
+      );
+    const question = Effect.gen(function* () {
+      const deadline = (yield* Clock.currentTimeMillis) + 20000;
+      while (true) {
+        const inputs = yield* pending();
+        const response = yield* api.request(actors.owner, "GET", `${path}/workflow-runs/${run.id}`);
+        expect(response.status).toBe(200);
+        const current = yield* body(Run, response);
+        expect(["errored", "terminated", "complete"], JSON.stringify(current)).not.toContain(
+          current.status,
+        );
+        if (inputs.length > 0) {
+          expect(inputs).toHaveLength(1);
+          yield* evidence.json("pending-question", { input: inputs[0], run: current });
+          return inputs[0]!;
+        }
+        expect(yield* Clock.currentTimeMillis).toBeLessThan(deadline);
+        yield* Effect.sleep("50 millis");
+      }
+    });
+    return { api, actors, path, run, wait, pending, question };
+  });
+
+layer(RuntimeLive, { excludeTestServices: true })("Encrypted workflow input", (it) => {
+  it.effect(scenarios.encryptedWorkflowInputAnswer.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* fixture();
+        const input = yield* f.question;
+        const response = { action: "accept", content: { answer: "resumed from human input" } };
+        expect(
+          (yield* f.api.request(f.actors.owner, "POST", `${f.path}/workflow-inputs/${input.id}`, {
+            response,
+          })).status,
+        ).toBe(200);
+        expect((yield* f.wait("complete")).output).toEqual({
+          question: input.id,
+          status: "answered",
+          answer: response,
+        });
+        expect(yield* f.pending()).toEqual([]);
+      }),
+    ),
+  );
+  it.effect(scenarios.encryptedWorkflowInputExpiry.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* fixture(5000);
+        // No answer is ever sent, so completion must come from the native expiry timer.
+        const input = yield* f.question;
+        expect((yield* f.wait("complete")).output).toEqual({
+          question: input.id,
+          status: "expired",
+          answer: null,
+        });
+        expect(yield* f.pending()).toEqual([]);
+      }),
+    ),
+  );
+});
