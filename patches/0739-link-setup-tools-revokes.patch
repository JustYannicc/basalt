+import type { GenericEndpointContext } from "@better-auth/core";
+import { authCall } from "@executor-js/mcp-auth/oauth";
+import type { APIError } from "better-auth/api";
+import { Effect, Option, Schema } from "effect";
+
+/** The pool's control call, as the tools host's own service identity makes it. */
+export type PoolControl = <A>(
+  action: string,
+  value: Readonly<Record<string, unknown>>,
+  schema: Schema.Decoder<A>,
+) => Effect.Effect<A, APIError>;
+
+/** Rows one pass reads and deletes, the pool's own bound too. */
+const batch = 25;
+const Leftovers = Schema.Struct({
+  computers: Schema.Array(
+    Schema.Struct({
+      computer: Schema.NonEmptyString,
+      user: Schema.NonEmptyString,
+      toolsKeyId: Schema.NonEmptyString,
+    }),
+  ),
+});
+const Finished = Schema.Struct({ finished: Schema.Number });
+
+/**
+ * A computer set up with a link signs in with an ordinary tools key. When its person's revoke stops
+ * part-way, its pool row stays revoked or revoking while the key keeps working, until this pass,
+ * which deletes it. The pool names at most a batch of such rows; a key is deleted only when it is
+ * that row's person's own. A pool that doesn't answer, or an answer this can't read, deletes
+ * nothing: serving tools never asks the pool, so an outage only pauses the cleanup.
+ */
+export const finishLinkSetupRevokes = (ctx: GenericEndpointContext, control: PoolControl) =>
+  Effect.gen(function* () {
+    const result = { deleted: 0, finished: 0, unavailable: false };
+    const listed = yield* control("tools-leftovers", {}, Leftovers).pipe(Effect.option);
+    if (Option.isNone(listed)) {
+      result.unavailable = true;
+      yield* Effect.logWarning("native.tools_revokes.unavailable");
+      return result;
+    }
+    const gone: { computer: string; toolsKeyId: string }[] = [];
+    for (const left of listed.value.computers.slice(0, batch)) {
+      // Another person's key with this id is not this computer's; its person has none to lose.
+      const removed = yield* authCall(() =>
+        ctx.context.adapter.deleteMany({
+          model: "apikey",
+          where: [
+            { field: "id", value: left.toolsKeyId },
+            { field: "referenceId", value: left.user },
+          ],
+        }),
+      ).pipe(Effect.option);
+      if (Option.isNone(removed)) continue;
+      result.deleted += removed.value;
+      gone.push({ computer: left.computer, toolsKeyId: left.toolsKeyId });
+    }
+    if (gone.length > 0) {
+      // Unreported keys are found already gone and reported by the next pass.
+      const reported = yield* control("tools-deleted", { computers: gone }, Finished).pipe(
+        Effect.option,
+      );
+      if (Option.isSome(reported)) result.finished = reported.value.finished;
+      else result.unavailable = true;
+    }
+    if (result.deleted > 0 || result.finished > 0 || result.unavailable)
+      yield* Effect.logInfo("native.tools_revokes").pipe(Effect.annotateLogs(result));
+    return result;
+  });
