diff --git a/apps/hosted/cloud/src/implementation/organization-check.ts b/apps/hosted/cloud/src/implementation/organization-check.ts
new file mode 100644
index 0000000..ee16741
--- /dev/null
+++ b/apps/hosted/cloud/src/implementation/organization-check.ts
@@ -0,0 +1,44 @@
+import { APIError } from "better-auth/api";
+import { Effect } from "effect";
+import type { Onboarding, OrganizationCheckReason } from "../contracts/onboarding.ts";
+
+/** Why the check failed, or the v1 refusal it answered with `false`. */
+type Outcome = typeof OrganizationCheckReason.Type | "v1_member";
+
+/** Set the reason on the request's span and log it; the email, account and token never are. */
+const record = (reason: Outcome) =>
+  Effect.annotateCurrentSpan("onboarding.check.reason", reason).pipe(
+    Effect.andThen(
+      reason === "email_unverified" || reason === "v1_member"
+        ? Effect.logInfo("Organization creation refused")
+        : Effect.logWarning("Organization check unavailable"),
+    ),
+    Effect.annotateLogs("onboarding.check.reason", reason),
+  );
+
+/**
+ * Better Auth's create check. Fails closed. An unverified email is refused with what to do,
+ * because retrying cannot help; a dependency that did not answer stays the retryable 503. A v1
+ * member is refused by Better Auth itself. Each refusal and failure records its reason, so an
+ * operator can count them.
+ */
+export const organizationCreationCheck = (
+  onboarding: Pick<typeof Onboarding.Service, "allowsOrganization">,
+  userId: string,
+) =>
+  onboarding.allowsOrganization(userId).pipe(
+    Effect.tap((allowed) => (allowed ? Effect.void : record("v1_member"))),
+    Effect.tapError(({ reason }) => record(reason)),
+    Effect.mapError(({ reason }) =>
+      reason === "email_unverified"
+        ? new APIError("FORBIDDEN", {
+            code: "EMAIL_NOT_VERIFIED",
+            message:
+              "Verify your email by signing in with an email code, then create the organization.",
+          })
+        : new APIError("SERVICE_UNAVAILABLE", {
+            code: "ORGANIZATION_CHECK_UNAVAILABLE",
+            message: "We could not check your account. Try again.",
+          }),
+    ),
+  );
