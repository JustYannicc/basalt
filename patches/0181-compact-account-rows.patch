+          ["Needs re-auth", expect.stringMatching(/^Needs re-auth by Rejected fixture/)],
+          ["Not rechecked", expect.stringMatching(/before the credentials or app changed$/)],
+        ]);
+        expect(reauth).toContain(rejected.app.id);
+        expect(
+          yield* browser.use("Read the unchecked row's Health", (page) =>
+            accountRow(page, "Saved only")
+              .waitFor()
+              .then(() =>
+                accountRow(page, "Saved only").locator("[data-account-health-cell]").count(),
+              ),
+          ),
+          "a saved grant with no check never reads as healthy",
+        ).toBe(0);
+        expect(inlineRefresh, "Refresh moved into the row menu").toBe(0);
+        // On the app's own tab, its current rejection is the row's one inline recovery.
