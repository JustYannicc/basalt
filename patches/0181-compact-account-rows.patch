diff --git a/e2e/tests/account-compact-rows.spec.ts b/e2e/tests/account-compact-rows.spec.ts
new file mode 100644
index 0000000..e7bf9de
--- /dev/null
+++ b/e2e/tests/account-compact-rows.spec.ts
@@ -0,0 +1,482 @@
+/** Account rows are compact two-line rows: aligned columns, health in a word, actions in the menu. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { FetchHttpClient, HttpClient } from "effect/http";
+import type { Page } from "playwright";
+import { body } from "../support/api.ts";
+import { connectionsPath } from "../support/app-accounts.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { accountIdentityIssuer } from "../support/account-identity-issuer.ts";
+import { IdentityAccount } from "../support/account-identity-product.ts";
+import { Resource } from "../support/contracts.ts";
+import { Browser } from "../support/browser.ts";
+import { Evidence } from "../support/evidence.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { acquisitionFixture } from "../support/account-acquisition-fixture.ts";
+import { allowance, observationFixture } from "../support/account-observation-fixture.ts";
+import { accountRow, openRowMenu } from "../support/account-rows.ts";
+import { scenarios } from "../test-plan.ts";
+
+/**
+ * An OAuth account the host verified through the issuer, from an app that requests scopes, so its
+ * row has both a verified identity and requested access.
+ */
+const verifiedOAuthAccount = (
+  fixture: Pick<Effect.Success<ReturnType<typeof observationFixture>>, "api" | "actors" | "prefix">,
+) =>
+  Effect.gen(function* () {
+    const { api, actors, prefix } = fixture;
+    const http = yield* HttpClient.HttpClient,
+      issuer = yield* accountIdentityIssuer;
+    const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+      name: "Verified fixture",
+      files: [
+        appsManifest,
+        {
+          path: "index.ts",
+          content: `import { defineApp, defineProvider, oauth2, router } from "apps";
+const service=defineProvider({name:"Verified fixture",auth:{oauth:oauth2(${JSON.stringify({ authorizationUrl: issuer.origin + "/authorize", tokenUrl: issuer.origin + "/token", scopes: ["read", "write"], tokenEndpointAuthMethod: "none", identity: { issuer: issuer.origin, name: "Fixture identity" } })})}});
+export default defineApp({user:{accounts:{service}}},async()=>({tools:router({})}));`,
+        },
+      ],
+    });
+    expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+    const app = (yield* body(Resource, deployed)).id;
+    const appPath = `${prefix}/apps/${app}`;
+    const connection = (yield* body(
+      Resource,
+      yield* api.request(actors.owner, "POST", connectionsPath(appPath, "user", "service"), {}),
+    )).id;
+    const start = yield* api.request(
+      actors.owner,
+      "POST",
+      `${prefix}/connections/${connection}/oauth/start`,
+      { method: "oauth", client: { clientId: "compact-rows-client" } },
+    );
+    expect(start.status, JSON.stringify(start.body)).toBe(200);
+    const { authorizationUrl } = yield* body(
+      Schema.Struct({ authorizationUrl: Schema.String }),
+      start,
+    );
+    const callbackUrl = yield* Effect.scoped(
+      Effect.gen(function* () {
+        const response = yield* HttpClient.withScope(http).get(authorizationUrl);
+        if (response.headers.location === undefined)
+          return yield* Effect.die("Issuer omitted callback");
+        return response.headers.location;
+      }),
+    ).pipe(Effect.provideService(FetchHttpClient.RequestInit, { redirect: "manual" }));
+    const completed = yield* api.request(
+      actors.owner,
+      "POST",
+      `${prefix}/connections/${connection}/oauth/complete`,
+      { callbackUrl },
+    );
+    expect(completed.status, JSON.stringify(completed.body)).toBe(200);
+    const account = yield* body(IdentityAccount, completed);
+    expect(account.identity, "the issuer verified the sign-in").toBeDefined();
+    yield* Effect.addFinalizer(() =>
+      Effect.gen(function* () {
+        yield* api.request(actors.owner, "DELETE", appPath);
+        yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account.id}`);
+      }).pipe(Effect.orDie),
+    );
+    expect(
+      (yield* api.request(actors.owner, "PATCH", `${prefix}/accounts/${account.id}`, {
+        label: "Verified mail",
+      })).status,
+    ).toBe(200);
+    return account;
+  });
+
+const box = (page: Page, label: string, selector: string) =>
+  accountRow(page, label)
+    .locator(selector)
+    .first()
+    .evaluate((element) => {
+      const rect = element.getBoundingClientRect();
+      return { top: rect.top, bottom: rect.bottom, middle: rect.top + rect.height / 2 };
+    });
+
+layer(HostedLive, { excludeTestServices: true })("Compact account rows", (it) => {
+  it.effect(scenarios.accountCompactRows.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const browser = yield* Browser;
+        const evidence = yield* Evidence;
+        // A connector whose check reports an email but no host-verified identity.
+        // Declared as an API key, so its Type names it.
+        const plain = yield* observationFixture({
+          name: "Plain fixture",
+          observe: false,
+          health: true,
+          family: {
+            id: "compact-plain",
+            name: "Compact plain",
+            methods: { key: { mechanism: "api-key" } },
+          },
+        });
+        yield* plain.backend.health({
+          status: 200,
+          body: { accountInfo: { email: "reported@example.test" } },
+        });
+        // A connector whose current check rejects the sign-in.
+        const rejected = yield* observationFixture({
+          name: "Rejected fixture",
+          observe: false,
+          health: true,
+        });
+        yield* rejected.backend.health({ status: 401, body: {} });
+        // A connector whose only check predates its app's current version.
+        const outdated = yield* observationFixture({
+          name: "Outdated fixture",
+          observe: false,
+          health: true,
+        });
+        // A reporter with a plan label and one limited window.
+        // Declared as a subscription, so its Type names it.
+        const usage = yield* observationFixture({
+          name: "Usage fixture",
+          observe: true,
+          health: true,
+          family: {
+            id: "compact-usage",
+            name: "Compact usage",
+            methods: { key: { mechanism: "other", offering: "subscription" } },
+          },
+        });
+        const reading = allowance();
+        yield* usage.backend.answer({
+          status: 200,
+          body: {
+            ...reading,
+            observation: {
+              ...reading.observation,
+              plan: { label: "Max 20x", observedAt: reading.observedAt },
+            },
+          },
+        });
+        // A saved grant that nothing checks.
+        const savedOnly = yield* observationFixture({
+          name: "Saved fixture",
+          observe: false,
+          health: false,
+        });
+        expect(
+          (yield* savedOnly.api.request(savedOnly.actors.owner, "PATCH", savedOnly.accountPath, {
+            label: "Saved only",
+          })).status,
+        ).toBe(200);
+        for (const [fixture, label] of [
+          [plain, "Plain mail"],
+          [rejected, "Rejected mail"],
+          [outdated, "Outdated mail"],
+          [usage, "Usage account"],
+        ] as const) {
+          expect(
+            (yield* fixture.api.request(fixture.actors.owner, "PATCH", fixture.accountPath, {
+              label,
+            })).status,
+          ).toBe(200);
+          expect((yield* fixture.check()).status).toBe(200);
+        }
+        expect((yield* usage.refresh()).status).toBe(200);
+        expect((yield* outdated.deploy({ observe: true, health: true })).status).toBe(200);
+        const checkOf = (detail: { readonly body: unknown }) =>
+          JSON.stringify((detail.body as { health?: unknown }).health ?? null);
+        expect(checkOf(yield* outdated.detail()), "the redeploy outdates the check").toContain(
+          '"current":false',
+        );
+        expect(checkOf(yield* rejected.detail())).toContain('"credentials_rejected"');
+
+        // An OAuth row with a host-verified identity and requested scopes.
+        const verifiedAccount = yield* verifiedOAuthAccount(plain);
+
+        // A reporter with nothing retained, refreshed only from its row menu.
+        const driver = yield* acquisitionFixture();
+        const { account: reporter } = yield* driver.create(driver.actors.owner, {
+          kind: "shared",
+          audience: { kind: "everyone" },
+        });
+        expect(
+          (yield* driver.api.request(
+            driver.actors.owner,
+            "PATCH",
+            `${driver.prefix}/accounts/${reporter}`,
+            { label: "New reporter" },
+          )).status,
+        ).toBe(200);
+
+        const accounts = `/org/${plain.actors.organization.slug}/accounts`;
+        const ready = (page: Page) =>
+          Promise.all([
+            // Connectors have no check of their own, so Health shows their app checks.
+            accountRow(page, "Plain mail").locator('[data-health-state="healthy"]').waitFor(),
+            accountRow(page, "Rejected mail")
+              .locator('[data-health-state="credentials_rejected"]')
+              .waitFor(),
+            accountRow(page, "Outdated mail")
+              .locator('[data-health-state="not-rechecked"]')
+              .waitFor(),
+            accountRow(page, "Usage account").locator('[data-reading="requests"]').waitFor(),
+            accountRow(page, "Usage account").locator("[data-account-plan]").waitFor(),
+            accountRow(page, "New reporter").locator("[data-usage-unread]").waitFor(),
+            accountRow(page, "Verified mail").locator("[data-account-verified]").first().waitFor(),
+          ]);
+        yield* browser.login(plain.actors.owner);
+        const surfaces = [
+          ["accounts", accounts],
+          [
+            "app-accounts",
+            `/org/${plain.actors.organization.slug}/apps/${usage.app.id}?view=accounts`,
+          ],
+        ] as const;
+        for (const width of [1280, 390])
+          for (const scheme of ["light", "dark"] as const)
+            for (const [name, url] of surfaces) {
+              yield* browser.use(`Open ${name} at ${width}px in ${scheme} mode`, (page) =>
+                page
+                  .setViewportSize({ width, height: 900 })
+                  .then(() => page.emulateMedia({ colorScheme: scheme }))
+                  .then(() => page.goto(url))
+                  .then(async () => {
+                    if (name === "accounts") await ready(page);
+                    else
+                      await page
+                        .getByRole("region", { name: "Your accounts", exact: true })
+                        .locator('[data-reading="requests"]')
+                        .waitFor();
+                  }),
+              );
+              yield* evidence.attach(
