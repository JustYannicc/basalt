+          const row = page
+            .getByRole("region", { name: "Your accounts", exact: true })
+            .getByRole("listitem")
+            .filter({ hasText: "Rejected mail" });
+          return page
+            .goto(`/org/${plain.actors.organization.slug}/apps/${rejected.app.id}?view=accounts`)
+            .then(() => row.locator('[data-health-state="credentials_rejected"]').waitFor())
+            .then(() =>
+              Promise.all([
+                row.locator("[data-account-health-cell]").innerText(),
+                row
+                  .locator("[data-account-health-cell]")
+                  .getByRole("button", { name: "Reconnect", exact: true })
+                  .count(),
+              ]),
+            );
+        });
+        expect(appRejection[0]).toContain("Needs re-auth");
+        expect(appRejection[1]).toBe(1);
+        const access = yield* browser.use("Open the OAuth row's Details", (page) =>
+          page
+            .goto(accounts)
+            .then(() => ready(page))
+            .then(() => openRowMenu(page, accountRow(page, "Verified mail"), "Verified mail"))
+            .then((menu) => menu.getByRole("menuitem", { name: "Details", exact: true }).click())
+            .then(() => {
+              const shown = accountRow(page, "Verified mail").locator(".requested-access");
+              return shown.waitFor().then(() =>
+                Promise.all([
+                  shown.evaluate((element) => element.getBoundingClientRect().left),
+                  accountRow(page, "Verified mail")
+                    .locator("[data-account-name]")
+                    .evaluate((element) => element.getBoundingClientRect().left),
+                ]),
+              );
+            }),
+        );
+        expect(
+          Math.abs(access[0] - access[1]),
+          "Details align with the account name",
+        ).toBeLessThanOrEqual(1);
+        expect(verifiedAccount.identity).toBeDefined();
+
+        // The phone layout: logo, name and menu on the first line, the cells wrap under it.
+        const phone = yield* browser.use("Measure the rows at 390px", (page) =>
+          page
+            .setViewportSize({ width: 390, height: 900 })
+            .then(() => page.goto(accounts))
+            .then(() => ready(page))
+            .then(() =>
+              Promise.all([
+                page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth),
+                box(page, "Plain mail", "[data-account-name]"),
+                box(page, "Plain mail", "[data-account-row-menu] button"),
+                box(page, "Plain mail", ".app-references"),
+                page.locator(".inventory-header").isVisible(),
+              ]),
+            ),
+        );
+        expect(phone[0], "no horizontal scroll at 390px").toBe(true);
+        expect(Math.abs(phone[2].middle - phone[1].middle)).toBeLessThanOrEqual(2);
+        expect(phone[3].top).toBeGreaterThanOrEqual(phone[1].bottom);
+        expect(phone[4], "column names hide where the cells wrap").toBe(false);
+
+        // Refresh is a menu action, reachable from the keyboard.
+        const observed = () =>
+          driver.backend.calls.pipe(
+            Effect.map((calls) => calls.filter((call) => call.step === "observe").length),
+          );
+        expect(yield* observed()).toBe(0);
+        const menu = yield* browser.use("Read the reporter's menu", (page) =>
+          page
+            .setViewportSize({ width: 1280, height: 900 })
+            .then(() => page.goto(accounts))
+            .then(() => ready(page))
+            .then(() => openRowMenu(page, accountRow(page, "New reporter"), "New reporter"))
+            .then((open) =>
+              open
+                .getByRole("menuitem")
+                .allInnerTexts()
+                .then((items) => page.keyboard.press("Escape").then(() => items)),
+            ),
+        );
+        expect(menu.slice(0, 2)).toEqual(["Refresh usage", "Details"]);
+        yield* browser.use("Refresh the reporter from the keyboard", (page) => {
+          const trigger = accountRow(page, "New reporter").getByRole("button", {
+            name: "Manage New reporter",
+            exact: true,
+          });
