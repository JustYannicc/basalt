+                  page.screenshot({ fullPage: true }),
+                ),
+              );
+            }
+
+        const wide = yield* browser.use("Measure the rows at 1280px", (page) =>
+          page
+            .setViewportSize({ width: 1280, height: 900 })
+            .then(() => page.emulateMedia({ colorScheme: "light" }))
+            .then(() => page.goto(accounts))
+            .then(() => ready(page))
+            .then(() =>
+              Promise.all([
+                accountRow(page, "Plain mail").evaluate(
+                  (row) => row.getBoundingClientRect().height,
+                ),
+                accountRow(page, "Outdated mail").evaluate(
+                  (row) => row.getBoundingClientRect().height,
+                ),
+                accountRow(page, "Usage account").evaluate(
+                  (row) => row.getBoundingClientRect().height,
+                ),
+                Promise.all(
+                  ["Plain mail", "Usage account", "Rejected mail", "Outdated mail"].map((label) =>
+                    accountRow(page, label).locator("[data-account-type]").innerText(),
+                  ),
+                ),
+                accountRow(page, "Usage account").locator("[data-account-plan]").allInnerTexts(),
+                accountRow(page, "Plain mail").locator("[data-reading]").count(),
+                accountRow(page, "Rejected mail").locator("[data-reading]").count(),
+                accountRow(page, "Plain mail").locator("[data-account-identity]").innerText(),
+                accountRow(page, "Plain mail").locator("[data-account-verified]").count(),
+                accountRow(page, "Plain mail").locator("[data-account-name]").innerText(),
+                Promise.all(
+                  ["Plain mail", "Rejected mail", "Outdated mail"].map((label) =>
+                    accountRow(page, label)
+                      .locator("[data-account-health-cell]")
+                      .evaluate((cell) => [cell.textContent ?? "", cell.getAttribute("title")]),
+                  ),
+                ),
+                accountRow(page, "Rejected mail")
+                  .getByRole("link", { name: /^Needs re-auth/ })
+                  .getAttribute("href"),
+                accountRow(page, "Usage account")
+                  .getByRole("button", { name: "Refresh", exact: true })
+                  .count(),
+                accountRow(page, "Verified mail").evaluate(
+                  (row) => row.getBoundingClientRect().height,
+                ),
+                accountRow(page, "Verified mail").locator("[data-account-verified]").count(),
+                accountRow(page, "Verified mail").locator(".requested-access").count(),
+              ]),
+            ),
+        );
+        const [
+          plainHeight,
+          outdatedHeight,
+          usageHeight,
+          types,
+          plans,
+          plainCells,
+          rejectedCells,
+          reported,
+          verified,
+          title,
+          connectorHealth,
+          reauth,
+          inlineRefresh,
+          verifiedHeight,
+          verifiedMarks,
+          collapsedAccess,
+        ] = wide;
+        // A plain row is about 48 to 52px; a usage band adds roughly one more row's height.
+        for (const height of [plainHeight, outdatedHeight, verifiedHeight]) {
+          expect(height).toBeGreaterThanOrEqual(44);
+          expect(height).toBeLessThanOrEqual(56);
+        }
+        // One usage cell is about 50px, plus the band's gap under the line.
+        expect(usageHeight - plainHeight).toBeGreaterThanOrEqual(36);
+        expect(usageHeight - plainHeight).toBeLessThanOrEqual(66);
+        // Type names only declared kinds; an undeclared key stays blank, never guessed from its method.
+        expect(types).toEqual(["API key", "Subscription", "", ""]);
+        expect(plans).toEqual(["Max 20x"]);
+        // Usage cells only on the reporter's row.
+        expect([plainCells, rejectedCells]).toEqual([0, 0]);
+        // A reported email is muted secondary text with no verified mark.
+        expect(title).toBe("Plain mail");
+        expect(reported).toBe("reported@example.test");
+        expect(verified, "a reported email never carries the check mark").toBe(0);
+        expect(verifiedMarks, "the host-verified identity carries the check mark").toBe(1);
+        // Requested access opens with the row's Details, never as its own line.
+        expect(collapsedAccess).toBe(0);
+        // The app check's label, credited to its app; a rejection links to that app's accounts.
+        // An outdated check is never shown as current.
+        expect(connectorHealth).toEqual([
