+/**
+ * The compact account row: one aligned line of identity, type, plan, health and who uses the
+ * account, then full-width bands such as usage. The row renders from `AccountRowInput`, which maps
+ * one field to one field onto the saved account list's rows, so a page swaps only its adapter.
+ */
+import type { AccountAppHealth, AccountId, AppId } from "@executor-js/sdk";
+import { HugeiconsIcon } from "@hugeicons/react";
+import { Tick02Icon } from "@hugeicons/core-free-icons";
+import { createContext, useContext, useEffect, useMemo, useState, type ReactNode } from "react";
+import type { AccountSummary, Inventory } from "../../contracts/dashboard.ts";
+import { DropdownMenuItem, DropdownMenuSeparator } from "../components/dropdown-menu.tsx";
+import { cn } from "../lib/utils.ts";
+import { AccountLogo } from "./account-health.tsx";
+
+/** One app or pool using the account, with that consumer's own sign-in state and check. */
+export interface AccountRowBinding {
+  readonly id: AccountId;
+  readonly app: AppId;
+  readonly signIn?: AccountSummary["signIn"];
+  readonly check?: AccountAppHealth | undefined;
+}
+
+/** What the compact row renders: the saved account at the root, its offering and its bindings. */
+export interface AccountRowInput {
+  /** Saved-account fields with `providerName`, `providerUrl` and `health`. */
+  readonly account: AccountSummary;
+  /** The declared offering, such as a subscription. Today's adapter has none to give. */
+  readonly offering?: string | undefined;
+  readonly bindings: readonly AccountRowBinding[];
+}
+
+/** A row of the host's saved-account list: the saved account at the root, keyed by its ID. */
+export interface SavedAccountRowInput extends AccountSummary {
+  readonly offering?: string | undefined;
+  readonly bindings: readonly {
+    readonly app: AppId;
+    readonly signIn?: AccountSummary["signIn"];
+  }[];
+}
+
+/**
+ * The host's saved-account row. Each binding reads its app's own check record; one dot per app,
+ * however many scopes link the account there.
+ */
+export const accountRowFromSaved = (row: SavedAccountRowInput): AccountRowInput => {
+  // Scopes linking the same app merge into one binding that keeps the worst grant state.
+  const signIns = new Map<AppId, AccountSummary["signIn"]>();
+  for (const binding of row.bindings)
+    signIns.set(binding.app, worseSignIn(signIns.get(binding.app), binding.signIn));
+  return {
+    account: row,
+    ...(row.offering === undefined ? {} : { offering: row.offering }),
+    bindings: [...signIns].map(([app, signIn]) => ({
+      id: row.id,
+      app,
+      ...(signIn === undefined ? {} : { signIn }),
+      check: row.health?.apps.find((entry) => entry.app === app),
+    })),
+  };
+};
+
+/** Reconnect, then unavailable, then saved: the grant state that asks more of the person wins. */
+const signInRank = (signIn: AccountSummary["signIn"]) =>
+  signIn === undefined
+    ? 3
+    : signIn.state === "reconnect" ||
+        (signIn.state === "saved" &&
+          signIn.reconnectAt !== null &&
+          signIn.reconnectAt.getTime() <= Date.now())
+      ? 0
+      : signIn.state === "unavailable"
+        ? 1
+        : 2;
+
+const worseSignIn = (a: AccountSummary["signIn"], b: AccountSummary["signIn"]) =>
+  signInRank(b) < signInRank(a) ? b : a;
+
+/** One display group's rows as one input: its first account, with every member's bindings. */
+export const accountRowGroup = (rows: readonly AccountRowInput[]): AccountRowInput | undefined => {
+  const [first] = rows;
+  if (first === undefined) return undefined;
+  const seen = new Set<string>();
+  return {
+    ...first,
+    bindings: rows
+      .flatMap((row) => row.bindings)
+      .filter((binding) => {
+        const key = `${binding.id}:${binding.app}`;
+        if (seen.has(key)) return false;
+        seen.add(key);
+        return true;
+      }),
+  };
+};
+
+/** For hosts without the saved-account list: an account and its inventory links. */
+export const accountRowFromInventory = (
+  inventory: Inventory,
+  account: AccountSummary,
+): AccountRowInput => {
+  const links = [...inventory.links, ...(inventory.appLinks ?? [])];
+  return {
+    account,
+    // One binding per app, however many scopes link the account there.
+    bindings: [
+      ...new Set(links.filter((link) => link.account === account.id).map((link) => link.app)),
+    ].map((app) => ({
+      id: account.id,
+      app,
+      ...(account.signIn === undefined ? {} : { signIn: account.signIn }),
+      check: account.health?.apps.find((entry) => entry.app === app),
+    })),
+  };
+};
+
+/**
+ * The Type column's text: the declared kinds that `accountKindLabel` or `accountMethodKindLabel`
+ * give the row's sign-ins, once each. Unknown kinds add nothing, so an undeclared account stays
+ * blank; nothing is inferred from OAuth or the method name.
+ */
+export const accountRowType = (kinds: readonly (string | undefined)[]): string | undefined =>
+  [...new Set(kinds.filter((kind) => kind !== undefined))].join(", ") || undefined;
+
+/** A usage band's row-level actions, offered from the row's menu. */
+export interface AccountRowUsage {
+  /** Absent for an account with no usage reporter. */
+  readonly refresh?: (() => void) | undefined;
+  readonly pending: boolean;
+  readonly disabledReason?: string | undefined;
+}
+
+interface AccountRowState {
+  /** A row menu is mounted, so row-level actions move into it. */
+  readonly menu: boolean;
+  readonly setMenu: (present: boolean) => void;
+  readonly details: boolean;
+  readonly setDetails: (open: boolean) => void;
+  readonly usage: AccountRowUsage | undefined;
+  readonly setUsage: (usage: AccountRowUsage | undefined) => void;
+  /** Row content that only Details shows, such as requested access or the description. */
+  readonly extra: boolean;
+  readonly setExtra: (present: boolean) => void;
+}
+
+const AccountRowContext = createContext<AccountRowState | undefined>(undefined);
+
+/** The row's shared state; outside a row the usage band keeps its own inline controls. */
+export const useAccountRow = () => useContext(AccountRowContext);
+
+export function AccountRowProvider({ children }: { readonly children: ReactNode }) {
+  const [menu, setMenu] = useState(false);
+  const [details, setDetails] = useState(false);
+  const [usage, setUsage] = useState<AccountRowUsage>();
+  const [extra, setExtra] = useState(false);
+  const value = useMemo(
+    () => ({ menu, setMenu, details, setDetails, usage, setUsage, extra, setExtra }),
+    [menu, details, usage, extra],
+  );
+  return <AccountRowContext.Provider value={value}>{children}</AccountRowContext.Provider>;
+}
+
+/** Menus for one binding of a grouped row act on that binding only, never the row's usage. */
+export function OutsideAccountRow({ children }: { readonly children: ReactNode }) {
+  return <AccountRowContext.Provider value={undefined}>{children}</AccountRowContext.Provider>;
+}
+
+/** Rendered by a row's menu so the row knows its actions have a home there. */
+export function AccountRowMenuPresence() {
+  const setMenu = useAccountRow()?.setMenu;
+  useEffect(() => {
+    if (setMenu === undefined) return;
+    setMenu(true);
+    return () => setMenu(false);
+  }, [setMenu]);
+  return null;
+}
+
+/**
+ * Content shown under the row only while its Details are open. A row without its own menu has no
+ * Details, so it keeps the content in view unless `inline` is false.
+ */
+export function AccountRowDetails({
+  children,
+  inline = true,
+}: {
+  readonly children: ReactNode;
+  readonly inline?: boolean;
+}) {
+  const row = useAccountRow();
+  const setExtra = row?.setExtra;
+  useEffect(() => {
+    if (setExtra === undefined) return;
+    setExtra(true);
+    return () => setExtra(false);
+  }, [setExtra]);
+  const shown = row === undefined || (row.menu ? row.details : inline);
+  return shown ? children : null;
+}
+
+/** The row's own actions at the top of its menu: refreshing usage and opening details. */
+export function AccountRowMenuItems() {
+  const row = useAccountRow();
+  if (row === undefined || (row.usage === undefined && !row.extra)) return null;
+  const { refresh, pending = false, disabledReason } = row.usage ?? {};
+  return (
+    <>
+      {refresh !== undefined && (
+        <DropdownMenuItem
+          disabled={pending || disabledReason !== undefined}
+          onSelect={() => refresh()}
+        >
+          <span className="flex min-w-0 flex-col">
+            <span>{pending ? "Refreshing usage…" : "Refresh usage"}</span>
+            {!pending && disabledReason !== undefined && (
+              <span className="text-[11px] text-muted-foreground">{disabledReason}</span>
+            )}
+          </span>
+        </DropdownMenuItem>
+      )}
+      <DropdownMenuItem onSelect={() => row.setDetails(!row.details)}>
+        {row.details ? "Hide details" : "Details"}
+      </DropdownMenuItem>
+      <DropdownMenuSeparator />
+    </>
+  );
+}
+
+/** The list wrapper names the container the row's breakpoints measure. */
+export const accountRowsContainer = "@container/account-rows";
+
+const narrow = {
+  plain:
+    "@max-[640px]/account-rows:grid-cols-[24px_minmax(0,_1fr)_auto] @max-[640px]/account-rows:gap-y-1",
+  lead: "@max-[640px]/account-rows:grid-cols-[16px_24px_minmax(0,_1fr)_auto] @max-[640px]/account-rows:gap-y-1",
+};
+
+/** Columns: [choice] · logo · account · type · plan · health · used by · menu. */
+export const accountRowGrid = (lead: boolean) =>
+  cn(
+    "grid items-center gap-x-3",
+    lead
+      ? "grid-cols-[16px_24px_minmax(0,_1fr)_10rem_4.5rem_8.5rem_minmax(7rem,_12rem)_auto]"
+      : "grid-cols-[24px_minmax(0,_1fr)_10rem_4.5rem_8.5rem_minmax(7rem,_12rem)_auto]",
+    lead ? narrow.lead : narrow.plain,
+  );
+
+/** A full-width band under the line, aligned with the account name. */
+export const accountRowBand = (lead: boolean) =>
+  lead ? "col-start-3 col-end-[-1] min-w-0" : "col-start-2 col-end-[-1] min-w-0";
+
+/** The cells after the name: grid columns on wide lists, one wrapping line on narrow ones. */
+export function AccountRowCells({
+  lead = false,
+  type,
+  plan,
+  health,
+  users,
+  usersLabel,
+}: {
+  readonly lead?: boolean;
+  readonly type?: ReactNode;
+  readonly plan?: ReactNode;
+  readonly health?: ReactNode;
+  readonly users?: ReactNode;
+  /** Names the users cell where the column header is hidden, such as "Used by". */
+  readonly usersLabel?: string | undefined;
+}) {
+  const empty = "@max-[640px]/account-rows:empty:hidden";
+  return (
+    <div
+      className={cn(
+        "contents @max-[640px]/account-rows:row-start-2 @max-[640px]/account-rows:col-end-[-1] @max-[640px]/account-rows:flex @max-[640px]/account-rows:min-w-0 @max-[640px]/account-rows:flex-wrap @max-[640px]/account-rows:items-center @max-[640px]/account-rows:gap-x-2.5 @max-[640px]/account-rows:gap-y-1",
+        lead ? "@max-[640px]/account-rows:col-start-3" : "@max-[640px]/account-rows:col-start-2",
+      )}
+    >
+      <span
+        data-account-type
+        className={cn("text-[13px] leading-[1.3] text-foreground/80 wrap-anywhere", empty)}
+      >
+        {type}
+      </span>
+      <span data-account-plan-cell className={cn("flex min-w-0 flex-wrap gap-1", empty)}>
+        {plan}
+      </span>
+      <span className={cn("flex min-w-0 items-center", empty)}>{health}</span>
+      <span
+        className={cn(
+          "flex min-w-0 flex-wrap items-center gap-1 text-[12px] text-muted-foreground",
+          empty,
+        )}
+      >
+        {users !== undefined && users !== null && users !== false && usersLabel !== undefined && (
+          <span className="hidden @max-[640px]/account-rows:inline">{usersLabel}</span>
+        )}
+        {users}
+      </span>
+    </div>
+  );
+}
+
+/**
+ * The menu cell. On narrow lists it stays on the first line, centred on the name: the cell is one
+ * name line tall and a larger button overflows it evenly.
+ */
+export function AccountRowMenu({ children }: { readonly children?: ReactNode }) {
+  return (
+    <span
+      data-account-row-menu
+      className="flex min-w-7 items-center justify-end gap-2 @max-[640px]/account-rows:col-start-[-2] @max-[640px]/account-rows:row-start-1 @max-[640px]/account-rows:h-[16.9px] @max-[640px]/account-rows:self-start"
+    >
+      {children}
+    </span>
+  );
+}
+
+/** Column names for a list of rows without a choice column; hidden where the cells wrap. */
+export function AccountRowHeader({ users }: { readonly users: string }) {
+  return (
+    <div
+      className={cn(
+        accountRowGrid(false),
+        "inventory-header bg-muted px-2.5 py-2 text-[11px] text-muted-foreground @max-[640px]/account-rows:hidden",
+      )}
+    >
+      <span className="col-span-2">Account</span>
+      <span>Type</span>
+      <span>Plan</span>
+      <span>Health</span>
+      <span>{users}</span>
+      <span className="sr-only">Actions</span>
+    </div>
+  );
+}
+
+/**
+ * Two lines: the name `title` gives, then the verified identity, muted. Only the host's proof in
+ * `account.identity` earns the check mark; an email or username a check reported never does. An
+ * account whose title is its verified identity shows it alone, unless an authored label differs.
+ */
+export function AccountRowName({
+  account,
+  title,
+  tags,
+  secondaryClassName,
+}: {
+  readonly account: AccountSummary;
+  readonly title: string;
+  /** Small labels after the name, such as Personal or Shared. */
+  readonly tags?: ReactNode;
+  /** A page's hook on the second line. */
+  readonly secondaryClassName?: string;
+}) {
+  const verified = account.identity?.label;
+  const reported = [account.health?.info?.email, account.health?.info?.username].find(
+    (value) => value !== undefined && value !== title,
+  );
+  const secondary =
+    verified !== undefined && verified !== title
+      ? { text: verified, verified: true }
+      : verified === title
+        ? account.label.trim() !== "" && account.label !== title
+          ? { text: account.label, verified: false, authored: true }
+          : undefined
+        : reported === undefined
+          ? undefined
+          : { text: reported, verified: false };
+  return (
+    <div className="grid min-w-0 leading-[1.3] @max-[640px]/account-rows:self-start">
+      <span className="flex min-w-0 items-center gap-1.5">
+        <strong
+          className="min-w-0 truncate text-[13px] font-medium"
+          title={title}
+          data-account-name
+          {...(verified === title ? { "data-account-verified": "" } : {})}
+        >
+          {title}
+        </strong>
+        {verified === title && <VerifiedMark />}
+        {tags}
+      </span>
+      {secondary !== undefined && (
+        <span
+          className={cn(
+            "flex min-w-0 items-center gap-1 text-[12px] text-muted-foreground",
+            secondaryClassName,
+          )}
+        >
+          <span
+            className="min-w-0 truncate"
+            title={secondary.text}
+            {...("authored" in secondary ? {} : { "data-account-identity": "" })}
+            {...(secondary.verified ? { "data-account-verified": "" } : {})}
+          >
+            {secondary.text}
+          </span>
+          {secondary.verified && <VerifiedMark />}
+        </span>
+      )}
+    </div>
+  );
+}
+
+function VerifiedMark() {
+  return (
+    <span className="inline-flex shrink-0 text-muted-foreground" title="Verified at sign-in">
+      <HugeiconsIcon icon={Tick02Icon} size={12} strokeWidth={2.5} aria-hidden />
+      <span className="sr-only">, verified</span>
+    </span>
+  );
+}
+
+/** The account's own description, for its Details. */
+export function AccountRowDescription({ account }: { readonly account: AccountSummary }) {
+  if (!account.description) return null;
+  return (
+    <p
+      className="account-description min-w-0 text-[12px] whitespace-pre-line text-muted-foreground wrap-anywhere"
+      data-account-description
+    >
+      {account.description}
+    </p>
+  );
+}
+
+/** The compact logo, named for assistive technology and on hover, since Type can be blank. */
+export function AccountRowLogo({ account }: { readonly account: AccountSummary }) {
+  const name = account.providerName ?? account.identity?.name;
+  return (
+    <span
+      className="flex items-center"
+      {...(name === undefined ? {} : { role: "img", "aria-label": name, title: name })}
+    >
+      <AccountLogo account={account} compact />
+    </span>
+  );
+}
