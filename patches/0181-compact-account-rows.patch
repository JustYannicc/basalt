diff --git a/e2e/support/account-rows.ts b/e2e/support/account-rows.ts
new file mode 100644
index 0000000..9e6303a
--- /dev/null
+++ b/e2e/support/account-rows.ts
@@ -0,0 +1,31 @@
+/** Compact account rows: a row by its menu, and the row actions that menu holds. */
+import type { Locator, Page } from "playwright";
+
+/**
+ * The Accounts list row of the account saved as `label`, found by its ⋯ menu, which names the
+ * saved label whatever the row's title shows. An account saved without a label is "unnamed
+ * account".
+ */
+export const accountRow = (page: Page, label: string) =>
+  page
+    .locator(".inventory-row")
+    .filter({ has: page.getByRole("button", { name: `Manage ${label}`, exact: true }) });
+
+/** The row's ⋯ menu, opened; `label` is the saved label the menu button names. */
+export const openRowMenu = (page: Page, row: Locator, label: string) =>
+  row
+    .getByRole("button", { name: `Manage ${label}`, exact: true })
+    .click()
+    .then(() => page.getByRole("menu"));
+
+/** Opens the row's details: usage source and age, checks, balances and unlimited windows. */
+export const openRowDetails = (page: Page, row: Locator, label: string) =>
+  openRowMenu(page, row, label)
+    .then((menu) => menu.getByRole("menuitem", { name: "Details", exact: true }).click())
+    .then(() => row.locator("[data-account-details]").waitFor());
+
+/** Collects usage again from the row's menu, as a keyboard or pointer user would. */
+export const refreshRowUsage = (page: Page, row: Locator, label: string) =>
+  openRowMenu(page, row, label).then((menu) =>
+    menu.getByRole("menuitem", { name: "Refresh usage", exact: true }).click(),
+  );
