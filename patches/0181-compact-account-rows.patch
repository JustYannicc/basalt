@@ -0,0 +1,318 @@
+import type { AccountCheckStatus, AccountDriverHealth, AppId } from "@executor-js/sdk";
+import { HugeiconsIcon } from "@hugeicons/react";
+import { ArrowUpRight01Icon } from "@hugeicons/core-free-icons";
+import type { ReactNode } from "react";
+import { accountNeedsSignIn, type AccountSummary } from "../../contracts/dashboard.ts";
+import { shortMoment } from "../components/local-time.tsx";
+import { formatMoment, useDisplayFormat } from "../hooks/display-format.ts";
+import { cn } from "../lib/utils.ts";
+import { describeAccountCheck } from "./account-health.tsx";
+import type { AccountRowBinding, AccountRowInput } from "./account-row.tsx";
+import { useDashboard } from "./context.tsx";
+
+type Check = NonNullable<AccountDriverHealth["check"]>;
+
+/** One check behind the Health column: whose account, and which app reported it. */
+export interface AccountRowHealthSource {
+  readonly account: AccountSummary;
+  /** Absent for the account's own sign-in check. */
+  readonly app?: AppId | undefined;
+}
+
+/** What the Health column says. */
+export type AccountRowHealth =
+  | { readonly kind: "needs-sign-in" }
+  | { readonly kind: "unavailable" }
+  | {
+      readonly kind: "check";
+      readonly check: Check;
+      /** Every member and app whose check says this; the first app is the re-auth link. */
+      readonly sources: readonly AccountRowHealthSource[];
+      /** The row groups several saved accounts, so the tooltip names each member. */
+      readonly grouped: boolean;
+    }
+  | { readonly kind: "not-checked" }
+  /** Nothing can check the account, so the cell stays empty. */
+  | { readonly kind: "no-check" };
+
+const severity: readonly AccountCheckStatus[] = [
+  "credentials_rejected",
+  "tools_unavailable",
+  "forbidden",
+  "upstream_unavailable",
+  "check_failed",
+  "healthy",
+];
+
+/** Lower is worse: grant problems, then current results by severity, then outdated ones by severity. */
+const rank = (health: AccountRowHealth) =>
+  health.kind === "needs-sign-in"
+    ? 0
+    : health.kind === "unavailable"
+      ? 1
+      : health.kind === "check"
+        ? 2 + (health.check.current ? 0 : severity.length) + severity.indexOf(health.check.status)
+        : health.kind === "not-checked"
+          ? 2 + 2 * severity.length
+          : 3 + 2 * severity.length;
+
+const grant = (
+  account: AccountSummary,
+  bindings: readonly AccountRowBinding[],
+): AccountRowHealth | undefined => {
+  const signIns = [account.signIn, ...bindings.map((binding) => binding.signIn)].filter(
+    (signIn) => signIn !== undefined,
+  );
+  if (signIns.some((signIn) => accountNeedsSignIn({ ...account, signIn })))
+    return { kind: "needs-sign-in" };
+  if (signIns.some((signIn) => signIn.state === "unavailable")) return { kind: "unavailable" };
+  return undefined;
+};
+
+/** The worst of these app checks: current before outdated, then by severity. */
+const worstApp = (
+  account: AccountSummary,
+  bindings: readonly AccountRowBinding[],
+): AccountRowHealth | undefined => {
+  const results = bindings.flatMap((binding) =>
+    binding.check?.check == null ? [] : [{ check: binding.check.check, app: binding.app }],
+  );
+  for (const current of [true, false])
+    for (const status of severity) {
+      const matching = results.filter(
+        (result) => result.check.current === current && result.check.status === status,
+      );
+      const [first] = matching;
+      if (first !== undefined)
+        return {
+          kind: "check",
+          check: first.check,
+          sources: matching.map((result) => ({ account, app: result.app })),
+          grouped: false,
+        };
+    }
+  return undefined;
+};
+
+/** One saved account: its own check wins, then its app checks; a saved grant alone says nothing. */
+const memberHealth = (row: AccountRowInput): AccountRowHealth => {
+  const driver = row.account.health?.driver;
+  return (
+    grant(row.account, row.bindings) ??
+    (driver?.check == null
+      ? undefined
+      : {
+          kind: "check",
+          check: driver.check,
+          sources: [{ account: row.account }],
+          grouped: false,
+        }) ??
+    worstApp(row.account, row.bindings) ??
+    (driver?.checkable === true || row.bindings.some((binding) => binding.check?.checkable === true)
+      ? { kind: "not-checked" }
+      : { kind: "no-check" })
+  );
+};
+
+/**
+ * The Accounts list's Health column, for display only, from the checks as delivered. Each saved
+ * account in the row is read on its own, its own check before its app checks; the worst member
+ * wins, a current rejection first, and members in the same state share the cell's tooltip.
+ */
+export const accountRowHealth = (members: readonly AccountRowInput[]): AccountRowHealth => {
+  const states = members.map(memberHealth);
+  const worst = states.reduce<AccountRowHealth>(
+    (current, next) => (rank(next) < rank(current) ? next : current),
+    { kind: "no-check" },
+  );
+  if (worst.kind !== "check") return worst;
+  const same = states.filter(
+    (state): state is Extract<AccountRowHealth, { kind: "check" }> =>
+      state.kind === "check" &&
+      state.check.status === worst.check.status &&
+      state.check.current === worst.check.current,
+  );
+  return { ...worst, sources: same.flatMap((state) => state.sources), grouped: members.length > 1 };
+};
+
+/**
+ * An app's Accounts tab: a current result beats an outdated one, and among current results this
+ * app's own check comes before the account's own check. So neither the app's failure nor a current
+ * credential rejection, with its Reconnect, is hidden behind a stale result.
+ */
+export const appRowHealth = (row: AccountRowInput, own: AccountRowBinding): AccountRowHealth => {
+  const driver = row.account.health?.driver;
+  const app = worstApp(row.account, [own]);
+  const account: AccountRowHealth | undefined =
+    driver?.check == null
+      ? undefined
+      : { kind: "check", check: driver.check, sources: [{ account: row.account }], grouped: false };
+  const current = (state: AccountRowHealth | undefined) =>
+    state?.kind === "check" && state.check.current ? state : undefined;
+  return (
+    grant(row.account, [own]) ??
+    current(app) ??
+    current(account) ??
+    app ??
+    account ??
+    (driver?.checkable === true || own.check?.checkable === true
+      ? { kind: "not-checked" }
+      : { kind: "no-check" })
+  );
+};
+
+const dots = {
+  good: "bg-emerald-500",
+  bad: "bg-destructive",
+  warn: "bg-amber-500",
+  muted: "bg-muted-foreground/50",
+};
+const texts = {
+  good: "text-foreground",
+  bad: "text-destructive",
+  warn: "text-amber-700 dark:text-amber-400",
+  muted: "text-muted-foreground",
+};
+
+/**
+ * The account's health in a few words. A current rejection is the row's one inline recovery:
+ * `recover` where the page has one, or with `link` a "Needs re-auth ↗" link to the first rejecting
+ * member's app.
+ */
+export function AccountHealthCell({
+  health,
+  appName,
+  recover,
+  link = false,
+  unavailableLabel = "Account unavailable",
+}: {
+  readonly health: AccountRowHealth;
+  readonly appName: (app: AppId) => string;
+  readonly recover?: ReactNode;
+  /** Link an app's rejection to that app's accounts, where the account is reconnected. */
+  readonly link?: boolean;
+  readonly unavailableLabel?: string;
+}) {
+  const format = useDisplayFormat();
+  const { AppLink } = useDashboard();
+  const cell = "inline-flex min-w-0 items-center gap-1.5 text-[13px] whitespace-nowrap";
+  const dot = (tone: keyof typeof dots, hollow = false) => (
+    <span
+      aria-hidden
+      className={cn(
+        "size-1.5 shrink-0 rounded-full",
+        hollow ? "shadow-[inset_0_0_0_1.5px_var(--color-muted-foreground)]" : dots[tone],
+      )}
+    />
+  );
+  if (health.kind === "needs-sign-in" || health.kind === "unavailable")
+    return (
+      <span
+        className={cn(cell, "flex-wrap")}
+        data-account-health-cell
+        data-health-state={health.kind}
+      >
+        <span className="sign-in-status font-medium text-sign-in-warning">
+          {health.kind === "needs-sign-in" ? "Needs sign-in" : unavailableLabel}
+        </span>
+        {health.kind === "needs-sign-in" && recover}
+      </span>
+    );
+  if (health.kind === "no-check") return null;
+  if (health.kind !== "check")
+    return (
+      <span
+        className={cn(cell, "text-muted-foreground")}
+        data-account-health-cell
+        data-health-state={health.kind}
+      >
+        {dot("muted")}
+        Not checked
+      </span>
+    );
+  const { check, sources, grouped } = health;
+  const { label, tone } = describeAccountCheck(check.status);
+  const where = sources
+    .map((source) => {
+      const by = source.app === undefined ? "sign-in check" : appName(source.app);
+      return grouped ? `${by} (${source.account.label || "Unnamed account"})` : by;
+    })
+    .join(", ");
+  const when = formatMoment(new Date(check.checkedAt), format, shortMoment);
+  const title = check.current
+    ? `${label} by ${where} · checked ${when}${check.message === undefined ? "" : `\n${check.message}`}`
+    : `Last check ${when} by ${where}, before the credentials or app changed`;
+  const state = check.current ? check.status : "not-rechecked";
+  // The same attributes as the check badges this cell replaced.
+  const marks = { "data-check-status": check.status, "data-check-current": check.current };
+  if (!check.current)
+    return (
+      <span
+        className={cn(cell, "text-muted-foreground")}
+        title={title}
+        data-account-health-cell
+        data-health-state={state}
+        {...marks}
+        suppressHydrationWarning
+      >
+        {dot("muted", true)}
+        Not rechecked
+      </span>
+    );
+  const content = (
+    <>
+      {dot(tone)}
+      <span
+        className={cn(
+          "truncate",
+          tone === "good" ? "text-muted-foreground" : texts[tone],
+          tone === "bad" && "font-medium",
+        )}
+      >
+        {label}
+      </span>
+    </>
+  );
+  const rejected = check.status === "credentials_rejected";
+  const first = sources.find((source) => source.app !== undefined)?.app;
+  if (rejected && recover === undefined && link && first !== undefined)
+    return (
+      <span
+        className={cell}
+        title={title}
+        data-account-health-cell
+        data-health-state={state}
+        {...marks}
+        suppressHydrationWarning
+      >
+        <AppLink
+          app={first}
+          view="accounts"
+          className="-ml-1 inline-flex items-center gap-1.5 rounded-sm px-1 py-0.5 hover:bg-destructive/10"
+          aria-label={`Needs re-auth. Reconnect in ${appName(first)}`}
+        >
+          {content}
+          <HugeiconsIcon
+            icon={ArrowUpRight01Icon}
+            size={11}
+            strokeWidth={2}
+            aria-hidden
+            className="text-destructive"
+          />
+        </AppLink>
+      </span>
+    );
+  return (
+    <span
+      className={cn(cell, rejected && recover !== undefined && "flex-wrap")}
+      title={title}
+      data-account-health-cell
+      data-health-state={state}
+      {...marks}
+      suppressHydrationWarning
+    >
+      {content}
+      {rejected && recover}
+    </span>
+  );
+}
