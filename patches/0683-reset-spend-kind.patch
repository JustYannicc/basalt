+/**
+ * The window a banked reset refills, which is where it is counted and spent: a model's reset on
+ * that model's own window, a 5-hour reset on the account's 5-hour window, weekly and full resets
+ * on its 7-day window, and an account reset of no named kind on its longest window. A reset whose
+ * window wasn't reported, or whose scope is unknown, has no place, so it is never spent from a
+ * window it doesn't refill. A source that predates kinds names neither and keeps the longest
+ * window.
+ */
+export function resetPlacement(
+  reset: Pick<Balance, "scope"> & { readonly kind?: string | undefined },
+  windows: readonly Window[],
+): string | undefined {
+  if (reset.kind === undefined && reset.scope === undefined) return resetWindow(windows);
+  if (reset.kind === "model" || reset.scope?.kind === "model")
+    return resetWindow(
+      windows.filter((entry) => isModelWindow(entry) && entry.scope?.id === reset.scope?.id),
+    );
+  if (reset.scope?.kind !== "account") return undefined;
+  const own = windows.filter((entry) => !isModelWindow(entry));
+  const lasting = (seconds: number) =>
+    own.find((entry) => periodSeconds(entry.period) === seconds)?.id;
+  if (reset.kind === "session") return lasting(18_000);
+  // A reporter that names no periods keeps the longest-window rule it had before kinds.
+  if (reset.kind === "weekly" || reset.kind === "full")
+    return own.some((entry) => periodSeconds(entry.period) > 0)
+      ? lasting(604_800)
+      : resetWindow(own);
+  return resetWindow(own);
+}
