diff --git a/apps/hosted/server/src/implementation/catalog-service-search.ts b/apps/hosted/server/src/implementation/catalog-service-search.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/server/src/implementation/catalog-service-search.ts
@@ -0,0 +1,64 @@
+import type { CatalogEntry } from "@executor-js/catalog/contracts";
+
+const serviceIdPattern = /^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$/u;
+const emailLike = /[\p{L}\p{N}._%+-]+@[\p{L}\p{N}.-]+/giu;
+const wordCharacter = /[\p{L}\p{N}_.-]/u;
+
+/** Keep request text and catalog scans small; over-limit inputs abstain. */
+export const catalogServiceSearchLimits = {
+  queryLength: 256,
+  entries: 10_000,
+} as const;
+
+const normalize = (value: string) =>
+  value.normalize("NFKC").trim().replace(/\s+/gu, " ").toLowerCase();
+
+const isWordCharacter = (value: string | undefined) =>
+  value !== undefined && wordCharacter.test(value);
+
+const containsPhrase = (query: string, phrase: string) => {
+  let index = query.indexOf(phrase);
+  while (index !== -1) {
+    const before = query.slice(0, index).match(/.$/u)?.[0];
+    const after = query.slice(index + phrase.length).match(/^./u)?.[0];
+    if (!isWordCharacter(before) && !isWordCharacter(after)) return true;
+    index = query.indexOf(phrase, index + 1);
+  }
+  return false;
+};
+
+/** Match a query against catalog-owned identifiers and labels, returning only one safe ID. */
+export const catalogServiceIdForQuery = (
+  query: string,
+  entries: readonly CatalogEntry[],
+): string | undefined => {
+  if (
+    query.length > catalogServiceSearchLimits.queryLength ||
+    entries.length > catalogServiceSearchLimits.entries
+  )
+    return undefined;
+
+  // Do not infer a service from a name that appears only inside an email address.
+  const normalizedQuery = normalize(query.replace(emailLike, " "));
+  if (normalizedQuery === "") return undefined;
+
+  const matches = new Set<string>();
+  for (const entry of entries) {
+    if (!serviceIdPattern.test(entry.id)) continue;
+
+    const aliases = [entry.id, entry.name, entry.package]
+      .filter(
+        (value) =>
+          typeof value === "string" && value.length <= catalogServiceSearchLimits.queryLength,
+      )
+      .map(normalize)
+      .filter((value) => value !== "");
+
+    if (aliases.some((alias) => containsPhrase(normalizedQuery, alias))) {
+      matches.add(entry.id);
+      if (matches.size > 1) return undefined;
+    }
+  }
+
+  return matches.size === 1 ? matches.values().next().value : undefined;
+};
