+import { Context, Effect, Option, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import {
+  AppCodeId,
+  BlobKey,
+  SourceFiles,
+  type BlobStorage,
+  type RepositoryBackend,
+} from "@executor-js/sdk/core";
+import { pristineSource } from "../../../implementation/source-preservation.ts";
+import { readSourceFrontier } from "../../../implementation/source-write-frontiers.ts";
+import { canonical, sha256 } from "../crypto.ts";
+import type { Json } from "../contracts.ts";
+import { FamilyAdoption, familyOne, familyRefused } from "./atlassian-family-records.ts";
+
+export class FamilySourceRuntime extends Context.Service<
+  FamilySourceRuntime,
+  {
+    readonly repositories: RepositoryBackend;
+    readonly blobs: BlobStorage;
+  }
+>()("basalt/production-ops/FamilySourceRuntime") {}
+
+/** Read Git without a SQL lock, then publish its proof only if no writer crossed that read. */
+export const prepareFamilySource = (request: Json) =>
+  Effect.gen(function* () {
+    const input = yield* Schema.decodeUnknownEffect(FamilyAdoption)(request);
+    const sql = yield* SqlClient.SqlClient;
+    const runtime = yield* FamilySourceRuntime;
+    const apps = yield* sql`select id, code from executor_apps where id = ${input.umbrella.app}
+    and owner = ${`organization:${input.organization}`} and active_deployment = ${input.umbrella.version}`;
+    const app = yield* familyOne(
+      yield* Schema.decodeUnknownEffect(Schema.Array(Schema.Record(Schema.String, Schema.Json)))(
+        apps,
+      ),
+      input.umbrella.app,
+    );
+    const code = yield* Schema.decodeUnknownEffect(AppCodeId)(app.code);
+    // A code fence cannot retire one app while another live app still writes the same lineage.
+    const siblings =
+      yield* sql`select id from executor_apps where code = ${code} and id <> ${input.umbrella.app} limit 1`;
+    if (siblings.length !== 0)
+      return yield* familyRefused(
+        `${input.umbrella.app}/${code}: source lineage is shared by another installed app`,
+      );
+    yield* sql`insert into hosted_source_write_frontiers (code) values (${code}) on conflict do nothing`;
+    const rows = yield* readSourceFrontier(code);
+    const before = rows[0];
+    if (
+      rows.length !== 1 ||
+      before === undefined ||
+      before.generation === "-1" ||
+      before.active_writes !== 0
+    )
+      return yield* familyRefused(
+        `${input.umbrella.app}/${code}: source writes must be settled; active or uncertain writes prevent retirement`,
+      );
+    const proof = yield* Effect.gen(function* () {
+      const stored = yield* runtime.blobs.get(BlobKey.make(`app-source/${code}/initial.json`));
+      if (Option.isNone(stored))
+        return yield* familyRefused(
+          `${input.umbrella.app}/${code}: immutable initial source is missing`,
+        );
+      const initial = yield* Schema.decodeUnknownEffect(Schema.fromJsonString(SourceFiles))(
+        new TextDecoder().decode(stored.value),
+      );
+      return yield* pristineSource(runtime.repositories, code, initial);
+    }).pipe(
+      Effect.catchTag("SourcePreservationRefused", (error) =>
+        familyRefused(
+          `${input.umbrella.app}/${code}: ${error.property} changed; expected ${error.expected}, found ${error.actual}; source retained`,
+        ),
+      ),
+      Effect.catchTag("SourceError", (error) =>
+        familyRefused(
+          `${input.umbrella.app}/${code}: source proof unavailable (${error.reason}); source retained`,
+        ),
+      ),
+    );
+    const fingerprint = sha256(canonical(proof));
+    const recorded =
+      yield* sql`update hosted_source_write_frontiers set prepared_head = ${proof.head}, fingerprint = ${fingerprint}
+    where code = ${code} and generation::text = ${before.generation} and active_writes = 0 returning code`;
+    if (recorded.length !== 1)
+      return yield* familyRefused(
+        `${input.umbrella.app}/${code}: source write frontier changed during proof; source retained`,
+      );
+    return { code, generation: before.generation, head: proof.head, fingerprint };
+  });
