--- /dev/null
+++ b/apps/hosted/cloud/src/implementation/source-references.ts
@@ -0,0 +1,72 @@
+import { Effect } from "effect";
+import { SourceError, type AppCodeId, type RepositoryBackend } from "@executor-js/sdk/core";
+
+export interface SourceReference {
+  readonly commit: string;
+  readonly name: string;
+}
+
+/** Inspect every advertised ref; a main-branch read alone would miss saved branches and tags. */
+export const sourceReferences = (repositories: RepositoryBackend, code: AppCodeId) =>
+  Effect.gen(function* () {
+    const response = yield* repositories.request(
+      code,
+      new Request("https://repository.invalid/info/refs?service=git-upload-pack"),
+    );
+    return yield* Effect.tryPromise({
+      try: async () => {
+        if (!response.ok || response.body === null) throw new Error("Unreadable Git advertisement");
+        const reader = response.body.getReader();
+        const chunks: Uint8Array[] = [];
+        let size = 0;
+        try {
+          for (;;) {
+            const next = await reader.read();
+            if (next.done) break;
+            size += next.value.length;
+            if (size > 4 * 1024 * 1024) throw new Error("Git advertisement exceeds its bound");
+            chunks.push(next.value);
+          }
+        } finally {
+          await reader.cancel();
+        }
+        const bytes = new Uint8Array(size);
+        let copied = 0;
+        for (const chunk of chunks) {
+          bytes.set(chunk, copied);
+          copied += chunk.length;
+        }
+        return parseSourceReferences(bytes);
+      },
+      catch: () => new SourceError({ reason: "invalid-source" }),
+    });
+  });
+
+export const parseSourceReferences = (bytes: Uint8Array): readonly SourceReference[] => {
+  const decode = new TextDecoder("utf-8", { fatal: true });
+  const refs = new Map<string, string>();
+  let offset = 0;
+  while (offset < bytes.length) {
+    const prefix = decode.decode(bytes.subarray(offset, offset + 4));
+    if (!/^[a-f0-9]{4}$/iu.test(prefix)) throw new Error("Malformed Git packet length");
+    const length = Number.parseInt(prefix, 16);
+    if (length === 0) {
+      offset += 4;
+      continue;
+    }
+    if (length < 5 || length > 65520 || offset + length > bytes.length)
+      throw new Error("Incomplete Git reference packet");
+    const text = decode.decode(bytes.subarray(offset + 4, offset + length));
+    offset += length;
+    if (text === "# service=git-upload-pack\n") continue;
+    const match = /^([a-f0-9]{40}) (HEAD|refs\/[^\s\0]+)(?:\0[^\n]*)?\n?$/u.exec(text);
+    if (match?.[1] === undefined || match[2] === undefined || refs.has(match[2]))
+      throw new Error("Unrecognized or duplicate Git reference");
+    refs.set(match[2], match[1]);
+  }
+  if (refs.size === 0 || refs.size > 64)
+    throw new Error("Git reference count is outside its bound");
+  return [...refs]
+    .map(([name, commit]) => ({ name, commit }))
+    .toSorted((a, b) => a.name.localeCompare(b.name));
+};
