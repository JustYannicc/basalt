+import { Effect, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import {
+  FamilyRow,
+  familyAccounts,
+  familyApps,
+  familyRefused,
+  type FamilyAdoption,
+} from "./atlassian-family-records.ts";
+
+/** Full protected rows are hashed privately; adoption never rewrites credentials or identity. */
+export const familySnapshot = (input: FamilyAdoption) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const appIds = JSON.stringify(familyApps(input).map((app) => app.app));
+    const versions = JSON.stringify(familyApps(input).map((app) => app.version));
+    const accountIds = JSON.stringify(familyAccounts(input));
+    const selected = "select jsonb_array_elements_text($1::jsonb)";
+    const accounts = `select id from executor_accounts where id in (${selected})`;
+    const queries: Readonly<Record<string, readonly [string, readonly string[]]>> = {
+      organization: ["id = $1", [input.organization]],
+      member: ['"organizationId" = $1 and "userId" = $2', [input.organization, input.actor]],
+      hosted_source_write_frontiers: [
+        "code in (select code from executor_apps where id = $1 union select code from executor_deployments where id = $2)",
+        [input.umbrella.app, input.umbrella.version],
+      ],
+      executor_apps: [`id in (${selected})`, [appIds]],
+      executor_deployments: [
+        `code in (select code from executor_deployments where id in (${selected}))`,
+        [versions],
+      ],
+      hosted_app_access: [`id in (${selected})`, [appIds]],
+      hosted_app_groups: [`app_id in (${selected})`, [appIds]],
+      hosted_app_account_links: [
+        `app in (${selected}) or account in (select jsonb_array_elements_text($2::jsonb))`,
+        [appIds, accountIds],
+      ],
+      executor_accounts: [`id in (${selected})`, [accountIds]],
+      executor_account_identities: [
+        `id in (select identity_id from executor_accounts where id in (${accounts}))`,
+        [accountIds],
+      ],
+      executor_providers: [
+        `id in (select provider from executor_accounts where id in (${accounts}))`,
+        [accountIds],
+      ],
+      executor_oauth_grants: [
+        `id in (select coalesce(oauth_grant_id, id) from executor_accounts where id in (${accounts}))`,
+        [accountIds],
+      ],
+      hosted_account_access: [`account_id in (${accounts})`, [accountIds]],
+      hosted_account_groups: [`account_id in (${accounts})`, [accountIds]],
+    };
+    const snapshot: Record<string, readonly FamilyRow[]> = {};
+    for (const [table, [predicate, params]] of Object.entries(queries)) {
+      const rows = yield* sql.unsafe(
+        `select ${table === "hosted_source_write_frontiers" ? "to_jsonb(entry) || jsonb_build_object('generation', entry.generation::text)" : "to_jsonb(entry)"} as row from ${table} entry where ${predicate}
+        order by to_jsonb(entry)::text limit 2001`,
+        [...params],
+      );
+      if (rows.length > 2000) return yield* familyRefused(`${table}: snapshot exceeds 2000 rows`);
+      snapshot[table] = (yield* Schema.decodeUnknownEffect(
+        Schema.Array(Schema.Struct({ row: FamilyRow })),
+      )(rows)).map(({ row }) => row);
+    }
+    return snapshot;
+  });
+
+/** Declared databases and SQL are refused separately; these are the retained app-owned records. */
+export const requireStatelessUmbrella = (app: string) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const tables = [
+      "executor_app_records",
+      "executor_workflow_runs",
+      "executor_workflow_inputs",
+      "executor_schedules",
+      "executor_scheduled_runs",
+      "executor_webhooks",
+      "executor_events",
+      "executor_event_subscriptions",
+      "executor_app_call_receipts",
+      "executor_webhook_sources",
+      "executor_installations",
+      "executor_profile_app_copies",
+    ];
+    for (const table of tables) {
+      const rows = yield* sql.unsafe(`select 1 from ${table} where app = $1 limit 1`, [app]);
+      if (rows.length !== 0)
+        return yield* familyRefused(
+          `${app}: ${table} is non-empty; retirement would hide saved work`,
+        );
+    }
+    const dependents = yield* sql`select 'app connection' as kind from executor_app_connections
+      where app = ${app} or target = ${app}
+      union all select 'model binding' from hosted_model_bindings
+      where app_id = ${app} or pool_id = ${app}
+      union all select 'unfinished sign-in' from executor_account_connections
+      where target ->> 'app' = ${app} and state ->> 'status' not in ('completed','failed','cancelled','expired')
+
+      limit 1`;
+    if (dependents.length !== 0)
+      return yield* familyRefused(`${app}: ${String(dependents[0]?.kind)} prevents retirement`);
+  });
