+    const owner = `organization:${input.organization}`;
+    if (new Set(familyApps(input).map((app) => app.app)).size !== 3)
+      return yield* familyRefused("umbrella, Jira and Confluence must be three different app IDs");
+    if (new Set(input.bindings.map((binding) => binding.source)).size !== input.bindings.length)
+      return yield* familyRefused("each umbrella account must appear exactly once");
+    const organization = yield* by(snapshot, "organization", "id", input.organization);
