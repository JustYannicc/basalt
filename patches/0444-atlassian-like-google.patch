+  it.effect(scenarios.atlassianFamilyScreens.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const actors = yield* Actors,
+          browser = yield* Browser,
+          evidence = yield* Evidence;
+        const { atlassian, google, transport } = yield* familySetup;
+        const fixture = yield* deployFamilyApps([
+          "jira",
+          "confluence",
+          "serviceManagement",
+          "trello",
+          "gmail",
+          "calendar",
+        ]);
+        const urls = yield* openBrowser({ atlassian: atlassian.origin, google: google.origin });
+        const capture = (name: string) =>
+          Effect.flatMap(
+            browser.use(`Capture ${name}`, (page) => page.screenshot({ fullPage: true })),
+            (png) => evidence.attach(name, "image/png", png),
+          );
+        yield* browser.use("Use desktop width", (page) =>
+          page.setViewportSize({ width: 1280, height: 900 }),
+        );
+
+        // Google is the reference: one sign-in offers the other Google app, nothing else.
