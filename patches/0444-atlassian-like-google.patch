+
+const consentApps = (page: Page) => {
+  const boxes = page
+    .getByRole("group", { name: "Connect more apps in this sign-in" })
+    .getByRole("checkbox");
+  return page
+    .getByRole("button", { name: /^(Connect (Gmail|Jira)|Continue with (Google|Atlassian))$/ })
+    .waitFor()
+    .then(() =>
+      boxes.evaluateAll((items) =>
+        items.map((box) => box.closest("label")?.textContent?.trim() ?? "").sort(),
+      ),
+    );
+};
+
+const fits = (page: Page) =>
+  page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth);
