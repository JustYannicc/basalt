+            expect(trelloMark.name).not.toBe("Atlassian");
+            expect(fitted, `no horizontal overflow at ${width} px`).toBe(true);
+          });
+        yield* inspectAccounts(1280);
+        yield* inspectAccounts(390);
+
+        // Reuse: a later Atlassian app joins the saved identity without another consent.
+        yield* browser.use("Use desktop width for the row menu", (page) =>
+          page.setViewportSize({ width: 1280, height: 900 }),
+        );
+        yield* browser.use("Add an Atlassian app from the saved account", (page) =>
+          familyRows(page, ["Jira", "Confluence"])
+            .getByRole("button", { name: /^Manage / })
+            .click()
+            .then(() =>
+              page.getByRole("menuitem", { name: "Add Atlassian app", exact: true }).click(),
+            )
+            .then(() => page.getByRole("combobox", { name: "App", exact: true }).click())
+            .then(() =>
+              page.getByRole("option", { name: "Jira Service Management", exact: true }).click(),
+            )
+            .then(() => page.getByRole("button", { name: "Add app", exact: true }).waitFor()),
+        );
+        yield* capture("atlassian-family-add-app-1280.png");
+        yield* browser.use("Connect the covered app", (page) =>
+          page
+            .getByRole("button", { name: "Add app", exact: true })
+            .click()
