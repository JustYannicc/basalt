+++ b/e2e/support/atlassian-family-fixture.ts
@@ -0,0 +1,272 @@
+/**
+ * Atlassian family screens: apps declared as the official Jira, Confluence and Trello sources
+ * declare their sign-in (production endpoints, no explicit identity), the browser's trip to the
+ * provider's consent page answered by synthetic issuers, and the Accounts rows they produce.
+ */
+import { expect } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import type { BrowserContext, Page } from "playwright";
+import { Actors } from "./actors.ts";
+import { Api, body } from "./api.ts";
+import { appsManifest } from "./apps-release.ts";
+import { Resource } from "./contracts.ts";
+import { dismissAccountName } from "./name-account.ts";
+
+const atlassianOAuth = (scopes: readonly string[], audience?: string) =>
+  JSON.stringify({
+    authorizationUrl: "https://auth.atlassian.com/authorize",
+    tokenUrl: "https://auth.atlassian.com/oauth/token",
+    tokenEndpointAuthMethod: "client_secret_post",
+    tokenRequestFormat: "json",
+    authorizationParams: { ...(audience === undefined ? {} : { audience }), prompt: "consent" },
+    scopes,
+  });
+
+const googleOAuth = (scopes: readonly string[]) =>
+  JSON.stringify({
+    authorizationUrl: "https://accounts.google.com/o/oauth2/v2/auth",
+    tokenUrl: "https://oauth2.googleapis.com/token",
+    tokenEndpointAuthMethod: "client_secret_post",
+    scopes,
+  });
+
+/** Each app names its provider as its listing does; only the auth declaration matters here. */
+export const familyApps = {
+  jira: {
+    name: "Jira",
+    hosts: ["api.atlassian.com"],
+    oauth: atlassianOAuth(["read:me", "read:jira-work", "offline_access"], "api.atlassian.com"),
+  },
+  confluence: {
+    name: "Confluence",
+    hosts: ["api.atlassian.com"],
+    oauth: atlassianOAuth(
+      ["read:me", "read:confluence-content.all", "offline_access"],
+      "api.atlassian.com",
+    ),
+  },
+  serviceManagement: {
+    name: "Jira Service Management",
+    hosts: ["api.atlassian.com"],
+    // Covered by the Jira grant, so adding it from the saved identity needs no new consent.
+    oauth: atlassianOAuth(["read:me", "offline_access"], "api.atlassian.com"),
+  },
+  // Trello shares Atlassian's authorization server but not its API audience: a separate sign-in.
+  trello: {
+    name: "Trello",
+    hosts: ["api.trello.com"],
+    oauth: atlassianOAuth(["read:board:trello", "read:member:trello", "offline_access"]),
+  },
+  gmail: {
+    name: "Gmail",
+    hosts: ["gmail.googleapis.com"],
+    oauth: googleOAuth(["https://mail.google.com/"]),
+  },
+  calendar: {
+    name: "Google Calendar",
+    hosts: ["www.googleapis.com"],
+    oauth: googleOAuth(["https://www.googleapis.com/auth/calendar"]),
+  },
+} as const;
+
+export type FamilyApp = keyof typeof familyApps;
+
+export const deployFamilyApps = (names: readonly FamilyApp[]) =>
+  Effect.gen(function* () {
+    const api = yield* Api,
+      actors = yield* Actors;
+    const prefix = `/api/organizations/${actors.organization.id}`;
+    const deployed = {} as Record<FamilyApp, { id: string; path: string }>;
+    for (const key of names) {
+      const app = familyApps[key];
+      const response = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+        name: app.name,
+        files: [
+          appsManifest,
+          {
+            path: "index.ts",
+            content: `import { defineApp, defineProvider, oauth2, router } from "apps";
+const service = defineProvider({ name: ${JSON.stringify(app.name)}, hosts: ${JSON.stringify(app.hosts)}, auth: { oauth: oauth2(${app.oauth}) } });
+export default defineApp({ user: { accounts: { service } } }, { tools: router({}) });`,
+          },
+        ],
+      });
+      expect(response.status, JSON.stringify(response.body)).toBe(200);
+      const { id } = yield* body(Resource, response);
+      const path = `${prefix}/apps/${id}`;
+      yield* Effect.addFinalizer(() =>
+        api.request(actors.owner, "DELETE", path).pipe(Effect.orDie),
+      );
+      deployed[key] = { id, path };
+    }
+    const Account = Schema.Struct({
+      id: Schema.String,
+      identity: Schema.optionalKey(Schema.Struct({ id: Schema.String, label: Schema.String })),
+    });
+    const account = (id: string) =>
+      Effect.gen(function* () {
+        const answer = yield* api.request(actors.owner, "GET", `${prefix}/accounts/${id}`);
+        expect(answer.status, JSON.stringify(answer.body)).toBe(200);
+        return (yield* body(Schema.Struct({ account: Account }), answer)).account;
+      });
+    return { apps: deployed, account, prefix };
+  });
+
+/**
+ * The provider's consent page is the only step a browser cannot take on loopback: the shipped
+ * authorization URL is answered by the synthetic issuer, which returns to the product's callback.
+ */
+export const routeProviderConsent = (
+  context: BrowserContext,
+  issuers: { readonly atlassian: string; readonly google: string },
+) =>
+  Promise.all(
+    (
+      [
+        ["https://auth.atlassian.com/authorize**", issuers.atlassian],
+        ["https://accounts.google.com/o/oauth2/v2/auth**", issuers.google],
+      ] as const
+    ).map(([pattern, issuer]) =>
+      context.route(pattern, (route) => {
+        const consent = new URL("/authorize", issuer);
+        consent.search = new URL(route.request().url()).search;
+        return fetch(consent, { redirect: "manual" }).then((answer) => {
+          const location = answer.headers.get("location");
+          return location === null
+            ? route.fulfill({ status: answer.status })
+            : route.fulfill({ status: 302, headers: { location } });
+        });
+      }),
+    ),
+  );
+
+/** Deterministic local family marks stand in for the logo service; any other logo fails. */
+export const routeFamilyMarks = (context: BrowserContext) =>
+  context.route("https://integrations.sh/logo/**", (route) => {
+    const fill = (
+      { "google.com": "#4285f4", "atlassian.com": "#0052cc" } as Record<string, string>
+    )[new URL(route.request().url()).pathname.split("/").pop() ?? ""];
+    return fill === undefined
+      ? route.fulfill({ status: 404 })
+      : route.fulfill({
+          contentType: "image/svg+xml",
+          body: `<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48"><rect width="48" height="48" rx="8" fill="${fill}"/></svg>`,
+        });
+  });
+
+const exactly = (names: readonly string[]) =>
+  new RegExp(`^(${names.map((name) => name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("|")})$`);
+
+/** Accounts rows whose first visible app chip is one of `apps`; later apps may sit behind "+N more". */
+export const familyRows = (page: Page, apps: readonly string[]) =>
+  page.locator(".inventory-row").filter({
+    has: page
+      .locator("[data-used-by]")
+      .getByRole("link")
+      .filter({ hasText: exactly(apps) }),
+  });
+
+/** The row's mark: its accessible name and any family logo it loaded. */
+export const rowMark = (page: Page, apps: readonly string[]) =>
+  familyRows(page, apps)
+    .getByRole("img")
+    .first()
+    .evaluate((element) => ({
+      name: element.getAttribute("aria-label"),
+      logos: [...element.querySelectorAll("img")]
+        .filter((image) => image.complete && image.naturalWidth > 0)
+        .map((image) => image.currentSrc || image.src)
+        .filter((src) => src.includes("/logo/")),
+    }));
+
+export const familyMarkLoaded = (page: Page, apps: readonly string[], domain: string) =>
+  familyRows(page, apps)
+    .locator(`img[src*="/logo/${domain}"]`)
+    .evaluate((image: HTMLImageElement) =>
+      image.complete && image.naturalWidth > 0
+        ? Promise.resolve()
+        : new Promise<void>((resolve, reject) => {
+            image.addEventListener("load", () => resolve(), { once: true });
+            image.addEventListener("error", () => reject(new Error("family mark failed")), {
+              once: true,
+            });
+          }),
+    );
+
+/** Every app the row is used by, opening its "+N more" list when the cell is collapsed. */
+export const rowApps = (page: Page, apps: readonly string[]) => {
+  const row = familyRows(page, apps);
+  const more = row.locator("[data-used-by-more]");
+  return row
+    .locator("[data-used-by]")
+    .getByRole("link")
+    .allInnerTexts()
+    .then((visible) =>
+      more.count().then((count) =>
+        count === 0
+          ? visible.map((name) => name.trim()).sort()
+          : more
+              .click()
+              .then(() => page.locator("[data-used-by-list]").getByRole("link").allInnerTexts())
+              .then((hidden) =>
+                page.keyboard
+                  .press("Escape")
+                  .then(() => [...visible, ...hidden].map((name) => name.trim()).sort()),
+              ),
+      ),
+    );
+};
+
+/**
+ * A loopback callback makes the product open the provider in a new tab. The callback page in that
+ * tab completes the connection, asks to name a new account (a reconnect keeps its name) and
+ * returns that tab to the app's Accounts view. The starting tab stays on its paste-the-address
+ * step and is not used to finish. `start` is the click that opens the provider.
+ */
+export const finishInNewTab = (
+  page: Page,
+  appId: string,
+  start: () => Promise<unknown>,
+  named = true,
+) =>
+  Promise.all([page.context().waitForEvent("page"), start()]).then(([tab]) =>
+    tab
+      .waitForURL(
+        (url) =>
+          url.pathname.endsWith(`/apps/${appId}`) && url.searchParams.get("view") === "accounts",
+      )
+      .then(() => (named ? dismissAccountName(tab) : undefined))
+      .then(() => tab.close()),
+  );
+
+/** Connect a new account from the app's own Accounts view, including `include` in one sign-in. */
+export const signInFromApp = (
+  page: Page,
+  app: { readonly url: string; readonly id: string },
+  provider: string,
+  include: readonly string[] = [],
+) =>
+  page
+    .goto(app.url)
+    .then(() => page.getByRole("button", { name: "Connect new account", exact: true }).click())
+    .then(() =>
+      include.reduce(
+        (done, name) =>
+          done.then(() =>
+            page
+              .getByRole("group", { name: "Connect more apps in this sign-in" })
+              .getByRole("checkbox", { name, exact: true })
+              .check(),
+          ),
+        Promise.resolve(),
+      ),
+    )
+    .then(() =>
+      finishInNewTab(page, app.id, () =>
+        page
+          .getByRole("button", {
+            name: new RegExp(`^(Connect ${provider}|Continue with (Atlassian|Google))$`),
+          })
+          .click(),
+      ),
+    );
