+import { Effect, Schema } from "effect";
+import { ProductionOperationRefused } from "../contracts.ts";
+
+const Id = Schema.NonEmptyString.check(Schema.isMaxLength(256));
+const App = Schema.Struct({ app: Id, version: Id });
+export const FamilyAdoption = Schema.Struct({
+  organization: Id,
+  actor: Id,
+  umbrella: App,
+  jira: App,
+  confluence: App,
+  bindings: Schema.Array(
+    Schema.Struct({
+      source: Id,
+      requirement: Id,
+      jira: Schema.Struct({ account: Id, requirement: Id }),
+      confluence: Schema.Struct({ account: Id, requirement: Id }),
+    }),
+  ).check(Schema.isMaxLength(50)),
+});
+export type FamilyAdoption = typeof FamilyAdoption.Type;
+export const FamilyRow = Schema.Record(Schema.String, Schema.Json);
+export type FamilyRow = typeof FamilyRow.Type;
+export type FamilySnapshot = Readonly<Record<string, readonly FamilyRow[]>>;
+export const familyRecord = (value: unknown) => (Schema.is(FamilyRow)(value) ? value : undefined);
+export const familyRefused = (message: string) =>
+  Effect.fail(new ProductionOperationRefused({ message }));
+export const familyOne = (rows: readonly FamilyRow[], label: string) =>
+  rows.length === 1 && rows[0] !== undefined
+    ? Effect.succeed(rows[0])
+    : familyRefused(`${label}: expected exactly one row, found ${rows.length}`);
+
+export const familyApps = (input: FamilyAdoption) => [input.umbrella, input.jira, input.confluence];
+export const familyAccounts = (input: FamilyAdoption) =>
+  [
+    ...new Set(
+      input.bindings.flatMap((binding) => [
+        binding.source,
+        binding.jira.account,
+        binding.confluence.account,
+      ]),
+    ),
+  ].sort();
