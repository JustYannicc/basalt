+        expect(requests).toContainEqual({ method: "GET", host: "api.atlassian.com", path: "/me" });
+        yield* evidence.json("atlassian-family-transport.json", requests);
+      }),
+    ),
+  );
+
+  it.effect(scenarios.atlassianFamilyLegacyIdentity.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const actors = yield* Actors,
+          browser = yield* Browser,
+          evidence = yield* Evidence;
+        const { atlassian, google, transport } = yield* familySetup;
+        const fixture = yield* deployFamilyApps(["jira", "confluence"]);
+        const urls = yield* openBrowser({ atlassian: atlassian.origin, google: google.origin });
+        const capture = (name: string) =>
+          Effect.flatMap(
+            browser.use(`Capture ${name}`, (page) => page.screenshot({ fullPage: true })),
+            (png) => evidence.attach(name, "image/png", png),
+          );
+        yield* atlassian.configure({ subject: "jira-person" });
+        const jira = fixture.apps.jira;
+        yield* browser.use("Connect Jira on its own", (page) =>
+          signInFromApp(page, urls.app(jira.id), "Jira"),
+        );
+        const [retained] = yield* linkedAccountIds(actors.owner, fixture.apps.jira.path);
+        expect(retained).toBeDefined();
+        // A Jira sign-in saved before the host verified identities.
