+              shown === 0
+                ? undefined
+                : client
+                    .fill(atlassianFamilyClients.atlassian.id)
+                    .then(() =>
+                      page
+                        .getByLabel("Client secret", { exact: true })
+                        .fill(atlassianFamilyClients.atlassian.secret),
+                    ),
+            )
+            .then(() =>
+              finishInNewTab(page, trello.id, () =>
