+import { expect } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { randomUUID } from "node:crypto";
+import { Api, body } from "./api.ts";
+import { App } from "./contracts.ts";
+import { Workspace } from "./app-authoring.ts";
+import { Actors } from "./actors.ts";
+import { cloudLocks } from "./cloud-locks.ts";
+import { productionOpsAccount } from "./production-ops-account.ts";
+
+/** A stateless retained copy beside one real app/account, confined to this case's organization. */
+export const atlassianAdoptionRows = Effect.gen(function* () {
+  const actors = yield* Actors;
+  const database = yield* cloudLocks;
+  const original = yield* productionOpsAccount(actors.owner, actors.organization.id);
+  const users = yield* database
+    .run({
+      sql: 'select "userId" as id from member where "organizationId" = $1 and role = $2',
+      params: [actors.organization.id, "owner"],
+    })
+    .pipe(
+      Effect.flatMap(
+        Schema.decodeUnknownEffect(Schema.Array(Schema.Struct({ id: Schema.String }))),
+      ),
+    );
+  const user = users[0]?.id;
+  if (user === undefined) return yield* Effect.die("Fixture owner missing");
+  const own = {
+    organization: actors.organization.id,
+    user,
+    account: `acc_${randomUUID()}`,
+    app: `app_${randomUUID()}`,
+    deployment: `dpl_${randomUUID()}`,
+    grant: `acc_${randomUUID()}`,
+    identity: randomUUID(),
+  };
+  const api = yield* Api;
+  const prefix = `/api/organizations/${actors.organization.id}/apps`;
+  const originalRead = yield* api.request(
+    actors.owner,
+    "GET",
+    `${prefix}/${original.app}/workspace`,
+  );
+  expect(originalRead.status, JSON.stringify(originalRead.body)).toBe(200);
+  const originalSource = yield* body(Workspace, originalRead);
+  const deployed = yield* api.request(actors.owner, "POST", `${prefix}/deploy`, {
+    name: "Retained umbrella fixture",
+    files: originalSource.files,
+  });
+  expect(deployed.status).toBe(200);
+  const umbrella = yield* body(App, deployed);
+  own.app = umbrella.id;
+  const deployments = yield* database
+    .run({
+      sql: "select active_deployment as id from executor_apps where id = $1",
+      params: [own.app],
+    })
+    .pipe(
+      Effect.flatMap(
+        Schema.decodeUnknownEffect(Schema.Array(Schema.Struct({ id: Schema.String }))),
+      ),
+    );
+  if (deployments[0] === undefined) return yield* Effect.die("Umbrella deployment missing");
+  own.deployment = deployments[0].id;
+  // Initialize through the public source path, independently of migration preparation.
+  expect((yield* api.request(actors.owner, "GET", `${prefix}/${own.app}/workspace`)).status).toBe(
+    200,
+  );
+  const owner = `organization:${own.organization}`;
+  yield* Effect.addFinalizer(() =>
+    Effect.gen(function* () {
+      yield* database.run({
+        sql: "delete from hosted_app_account_links where app = $1",
+        params: [own.app],
+      });
+      yield* database.run({ sql: "delete from executor_apps where id = $1", params: [own.app] });
+      yield* database.run({
+        sql: "delete from executor_accounts where id = $1",
+        params: [own.account],
+      });
+      yield* database.run({
+        sql: "delete from executor_deployments where id = $1",
+        params: [own.deployment],
+      });
+      yield* database.run({
+        sql: "delete from executor_oauth_grants where id = $1",
+        params: [own.grant],
+      });
+      yield* database.run({
+        sql: "delete from executor_account_identities where id = $1",
+        params: [own.identity],
+      });
+    }).pipe(Effect.orDie),
+  );
+  yield* database.run({
+    sql: "insert into executor_accounts select (jsonb_populate_record(null::executor_accounts, to_jsonb(a) || jsonb_build_object('id', $2::text, 'identity_id', null, 'oauth_grant_id', null))).* from executor_accounts a where id = $1",
+    params: [original.account, own.account],
+  });
+  yield* database.run({
+    sql: "insert into executor_oauth_grants (id, owner, encrypted, status, updated_at) values ($1, $2, decode('00', 'hex'), 'active', now())",
+    params: [own.grant, owner],
+  });
+  yield* database.run({
+    sql: "insert into executor_account_identities (id, owner, placement, issuer, subject, name, label, verified_at, created_at) values ($1, $2, 'personal', 'https://auth.atlassian.com', 'verified-person', 'Atlassian', 'same@example.test', now(), now())",
+    params: [own.identity, owner],
+  });
+  yield* database.run({
+    sql: "insert into hosted_app_account_links (app, requirement, account, subject, linked_by) values ($1, 'service', $2, $3, $3)",
+    params: [own.app, own.account, own.user],
+  });
+  expect(
+    yield* database.run({ sql: "select id from executor_apps where id = $1", params: [own.app] }),
+  ).toHaveLength(1);
+  return { own, database, sourceTemplate: original.app };
+});
