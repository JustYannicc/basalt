new file mode 100644
--- /dev/null
+++ b/apps/hosted/cloud/src/implementation/source-preservation.ts
@@ -0,0 +1,74 @@
+import { Data, Effect } from "effect";
+import {
+  gitBlobId,
+  inlineBytes,
+  type AppCodeId,
+  type RepositoryBackend,
+  type SourceFiles,
+} from "@executor-js/sdk/core";
+import { sourceReferences } from "./source-references.ts";
+
+export class SourcePreservationRefused extends Data.TaggedError("SourcePreservationRefused")<{
+  readonly code: string;
+  readonly property: string;
+  readonly expected: string;
+  readonly actual: string;
+}> {}
+
+const sourceTree = (files: SourceFiles) =>
+  Effect.gen(function* () {
+    const entries = yield* Effect.forEach(
+      files,
+      (file) =>
+        Effect.gen(function* () {
+          const object = "object" in file ? file.object : yield* gitBlobId(inlineBytes(file));
+          return [file.path, object] as const;
+        }),
+      { concurrency: 4 },
+    );
+    const bytes = new TextEncoder().encode(
+      JSON.stringify(entries.toSorted((a, b) => a[0].localeCompare(b[0]))),
+    );
+    const digest = yield* Effect.promise(() => crypto.subtle.digest("SHA-256", bytes));
+    return Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, "0")).join(
+      "",
+    );
+  });
+
+/** The immutable seed, every retained version, and the complete editable history must agree. */
+export const pristineSource = (
+  repositories: RepositoryBackend,
+  code: AppCodeId,
+  initial: SourceFiles,
+) =>
+  Effect.gen(function* () {
+    const refuse = (property: string, expected: string, actual: string) =>
+      Effect.fail(new SourcePreservationRefused({ code, property, expected, actual }));
+    const refs = yield* sourceReferences(repositories, code);
+    for (const ref of refs) {
+      if (
+        ref.name !== "HEAD" &&
+        ref.name !== "refs/heads/main" &&
+        !/^refs\/heads\/__executor\/sources\/[a-f0-9]{64}$/u.test(ref.name)
+      )
+        return yield* refuse("saved ref", "only main and host-retained source", ref.name);
+    }
+    const head = refs.find((ref) => ref.name === "refs/heads/main")?.commit;
+    if (head === undefined || refs.find((ref) => ref.name === "HEAD")?.commit !== head)
+      return yield* refuse("main head", "one advertised main head", "missing or inconsistent");
+    const history = yield* repositories.history(code);
+    if (history.length !== 1 || history[0]?.commit !== head || history[0].message !== "Create app")
+      return yield* refuse(
+        "editable history",
+        "one unchanged initial commit",
+        `${history.length} commits, head ${history[0]?.commit ?? "missing"}`,
+      );
+    const tree = yield* sourceTree(initial);
+    for (const commit of new Set(refs.map((ref) => ref.commit))) {
+      const snapshot = yield* repositories.read(code, commit);
+      const actual = yield* sourceTree(snapshot.files);
+      if (snapshot.commit !== commit || actual !== tree)
+        return yield* refuse(`source ${commit}`, tree, actual);
+    }
+    return { head, tree, refs };
+  });
