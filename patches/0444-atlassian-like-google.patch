new file mode 100644
--- /dev/null
+++ b/apps/hosted/cloud/src/implementation/source-write-frontiers.ts
@@ -0,0 +1,66 @@
+import { Effect, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import { SourceError, type AppCodeId } from "@executor-js/sdk/core";
+
+// Fork table: Git writes do not change app SQL rows, so retirement needs its own write frontier.
+export const migrateSourceWriteFrontiers = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  yield* sql`create table if not exists hosted_source_write_frontiers (
+    code text primary key,
+    generation bigint not null default 0 check (generation >= -1),
+    active_writes integer not null default 0 check (active_writes >= 0),
+    prepared_head text,
+    fingerprint text,
+    check ((prepared_head is null) = (fingerprint is null)),
+    check (generation <> -1 or active_writes = 0)
+  )`;
+});
+
+export const SourceFrontier = Schema.Struct({
+  code: Schema.String,
+  // JSON row snapshots use strings so bigint generations never lose precision.
+  generation: Schema.String,
+  active_writes: Schema.Number,
+  prepared_head: Schema.NullOr(Schema.String),
+  fingerprint: Schema.NullOr(Schema.String),
+});
+export type SourceFrontier = typeof SourceFrontier.Type;
+
+/** -1 is a permanent tombstone. A failed write remains active; later app writes still proceed. */
+export const sourceWriteFrontier = (sql: SqlClient.SqlClient) => {
+  const begin = (code: AppCodeId) =>
+    sql
+      .withTransaction(
+        Effect.gen(function* () {
+          yield* sql`set local lock_timeout = '500ms'`;
+          yield* sql`set local statement_timeout = '5s'`;
+          yield* sql`insert into hosted_source_write_frontiers (code) values (${code}) on conflict do nothing`;
+          const rows = yield* sql`update hosted_source_write_frontiers set
+      generation = generation + 1, active_writes = active_writes + 1,
+      prepared_head = null, fingerprint = null
+      where code = ${code} and generation >= 0 returning code`;
+          if (rows.length !== 1) return yield* new SourceError({ reason: "conflict" });
+        }),
+      )
+      .pipe(Effect.mapError(() => new SourceError({ reason: "storage" })));
+  const complete = (code: AppCodeId) =>
+    sql`update hosted_source_write_frontiers
+    set active_writes = active_writes - 1 where code = ${code} and generation >= 0 and active_writes > 0
+    returning code`.pipe(
+      Effect.flatMap((rows) =>
+        rows.length === 1 ? Effect.void : Effect.fail(new SourceError({ reason: "storage" })),
+      ),
+      Effect.mapError(() => new SourceError({ reason: "storage" })),
+    );
+  return { begin, complete };
+};
+export type SourceWriteFrontier = ReturnType<typeof sourceWriteFrontier>;
+
+/** Stable SQL proof reads are separate from Git I/O; every writer invalidates the saved proof. */
+export const readSourceFrontier = (code: AppCodeId) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const rows = yield* sql`select code, generation::text, active_writes, prepared_head, fingerprint
+    from hosted_source_write_frontiers where code = ${code}`;
+    return yield* Schema.decodeUnknownEffect(Schema.Array(SourceFrontier))(rows);
+  });
