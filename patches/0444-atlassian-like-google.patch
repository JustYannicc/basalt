+        origin?.name !== (name === "atlassian" ? name : `@executor.sh/${name}`) ||
+        typeof origin.reference !== "string" ||
+        !URL.canParse(origin.reference) ||
+        new URL(origin.reference).pathname !== `/catalog/apps/${name}.json`
+      )
