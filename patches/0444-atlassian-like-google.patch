--- /dev/null
+++ b/apps/hosted/cloud/src/implementation/source-write-fence.ts
@@ -0,0 +1,44 @@
+import { Effect } from "effect";
+import { SourceError, type AppCodeId, type RepositoryBackend } from "@executor-js/sdk/core";
+import type { SourceWriteFrontier } from "./source-write-frontiers.ts";
+
+/** SQL marks admission and completion only. Concurrent writes never wait for another Git call. */
+export const sourceWriteFence = (
+  git: RepositoryBackend,
+  frontier: SourceWriteFrontier,
+): RepositoryBackend => {
+  const write = <A>(code: AppCodeId, work: Effect.Effect<A, SourceError>) =>
+    Effect.uninterruptibleMask((restore) =>
+      Effect.gen(function* () {
+        yield* frontier.begin(code);
+        const value = yield* restore(work);
+        // Failure or interruption may leave Git running remotely. Never expire that uncertainty.
+        yield* frontier.complete(code);
+        return value;
+      }),
+    );
+  return {
+    ...git,
+    create: (code) => write(code, git.create(code)),
+    commit: (input) => write(input.id, git.commit(input)),
+    request: (code, request) =>
+      request.method === "POST" && new URL(request.url).pathname.endsWith("/git-receive-pack")
+        ? write(
+            code,
+            Effect.gen(function* () {
+              const response = yield* git.request(code, request);
+              if (!response.ok) return yield* new SourceError({ reason: "git" });
+              // A streamed receive-pack is not finished until its report has arrived in full.
+              const body = yield* Effect.tryPromise({
+                try: () => response.arrayBuffer(),
+                catch: () => new SourceError({ reason: "git" }),
+              });
+              return new Response(response.body === null ? null : body, {
+                status: response.status,
+                headers: response.headers,
+              });
+            }),
+          )
+        : git.request(code, request),
+  };
+};
