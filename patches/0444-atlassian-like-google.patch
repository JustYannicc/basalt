+  const atlassian = yield* accountIdentityIssuer,
+    google = yield* accountIdentityIssuer;
+  const transport = yield* atlassianFamilyProduct({
+    atlassian: atlassian.origin,
+    google: google.origin,
+  });
+  return { atlassian, google, transport };
+});
+
+const openBrowser = (issuers: { atlassian: string; google: string }) =>
+  Effect.gen(function* () {
+    const browser = yield* Browser,
+      actors = yield* Actors;
+    yield* browser.omitNetworkTrace;
+    yield* browser.login(actors.owner);
+    yield* browser.use("Answer provider consent and family marks on loopback", (page) =>
+      Promise.all([
+        routeProviderConsent(page.context(), issuers),
+        routeFamilyMarks(page.context()),
+      ]),
+    );
+    return {
+      accounts: `/org/${actors.organization.slug}/accounts`,
+      app: (id: string) => ({
+        id,
+        url: `/org/${actors.organization.slug}/apps/${id}?view=accounts`,
+      }),
+    };
+  });
+
