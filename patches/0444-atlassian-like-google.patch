new file mode 100644
--- /dev/null
+++ b/e2e/support/atlassian-family-product.ts
@@ -0,0 +1,153 @@
+import { Effect, FileSystem, Path, Schema } from "effect";
+import { ChildProcess, ChildProcessSpawner } from "effect/process";
+import { Target } from "./platform.ts";
+import { serverControl } from "./server-control.ts";
+import { targetHosts } from "./role-hosts.ts";
+
+const Requests = Schema.Array(
+  Schema.Struct({ method: Schema.String, host: Schema.String, path: Schema.String }),
+);
+
+export const atlassianFamilyClients = {
+  atlassian: { id: "atlassian-family-fixture-client", secret: "atlassian-family-fixture-secret" },
+  google: {
+    id: "atlassian-family-fixture.apps.googleusercontent.com",
+    secret: "atlassian-family-google-secret",
+  },
+} as const;
+
+/**
+ * Keep the shipped Atlassian and Google clients, recipes and endpoints; replace only the external
+ * HTTP transport. Atlassian's JSON token request becomes the synthetic issuer's form request, and
+ * `api.atlassian.com/me` is the issuer's account profile, so subjects and emails stay the
+ * issuer's own.
+ */
+export const atlassianFamilyProduct = (issuers: {
+  readonly atlassian: string;
+  readonly google: string;
+}) =>
+  Effect.gen(function* () {
+    const target = yield* Target,
+      fs = yield* FileSystem.FileSystem,
+      path = yield* Path.Path,
+      processes = yield* ChildProcessSpawner.ChildProcessSpawner;
+    const entry = path.join(target.directory, "atlassian-family-product.ts");
+    const observations = path.join(target.directory, "atlassian-family-requests.jsonl");
+    yield* fs.writeFileString(observations, "");
+    yield* fs.writeFileString(
+      entry,
+      `import * as Runtime from "@effect/platform-bun/BunRuntime";
+import { main } from "@executor-js/hosted-self-host/server";
+import { appendFileSync } from "node:fs";
+const atlassian = ${JSON.stringify(issuers.atlassian)};
+const google = ${JSON.stringify(issuers.google)};
+const transport = globalThis.fetch;
+const forward = async (origin: string, destination: string, request: Request, body?: string) => {
+  const headers = new Headers(request.headers);
+  headers.delete("host");
+  headers.delete("content-length");
+  if (body !== undefined) headers.set("content-type", "application/x-www-form-urlencoded");
+  return transport(origin + destination, {
+    method: request.method,
+    headers,
+    ...(request.method === "GET" || request.method === "HEAD"
+      ? {}
+      : { body: body ?? (await request.text()) }),
+  });
+};
+globalThis.fetch = async (input, init) => {
+  const url = new URL(input instanceof Request ? input.url : String(input));
+  // The host's safe HTTP adapter pins the IP and preserves the original HTTP Host.
+  const headers = new Headers(init?.headers ?? (input instanceof Request ? input.headers : undefined));
+  const host = headers.get("host") ?? url.host;
+  const hosts = ["auth.atlassian.com", "api.atlassian.com", "accounts.google.com", "oauth2.googleapis.com", "openidconnect.googleapis.com"];
+  if (!hosts.includes(host)) return transport(input, init);
+  const request = new Request(input, init);
+  appendFileSync(${JSON.stringify(observations)}, JSON.stringify({ method: request.method, host, path: url.pathname }) + "\\n");
+  if (host === "auth.atlassian.com" && url.pathname === "/oauth/token" && request.method === "POST") {
+    // Atlassian takes a JSON token request; the synthetic issuer reads the same fields as a form.
+    const text = await request.text();
+    const json = request.headers.get("content-type")?.includes("json") === true;
+    const fields = json
+      ? new URLSearchParams(Object.entries(JSON.parse(text) as Record<string, unknown>).flatMap(([key, value]) =>
+          typeof value === "string" ? [[key, value]] : []))
+      : new URLSearchParams(text);
+    return forward(atlassian, "/token", request, fields.toString());
+  }
+  if (host === "api.atlassian.com" && url.pathname === "/me") return forward(atlassian, "/profile", request);
+  if (host === "api.atlassian.com" && url.pathname === "/oauth/token/accessible-resources") {
+    const answer = await forward(atlassian, "/resource", request);
+    return answer.ok
+      ? Response.json([{ id: "synthetic-cloud", name: "Synthetic site", url: "https://synthetic.example.test", scopes: [] }])
+      : new Response(null, { status: answer.status });
+  }
+  if (host === "accounts.google.com" && url.pathname === "/.well-known/oauth-authorization-server")
+    return new Response(null, { status: 404 });
+  if (host === "accounts.google.com" && url.pathname === "/.well-known/openid-configuration")
+    return Response.json({
+      issuer: "https://accounts.google.com",
+      authorization_endpoint: "https://accounts.google.com/o/oauth2/v2/auth",
+      token_endpoint: "https://oauth2.googleapis.com/token",
+      userinfo_endpoint: "https://openidconnect.googleapis.com/v1/userinfo",
+      code_challenge_methods_supported: ["S256"],
+      token_endpoint_auth_methods_supported: ["client_secret_post"],
+    });
+  if (host === "oauth2.googleapis.com" && url.pathname === "/token") return forward(google, "/token", request);
+  if (host === "openidconnect.googleapis.com" && url.pathname === "/v1/userinfo") return forward(google, "/userinfo", request);
+  throw new Error("Unexpected Atlassian family fixture request: " + host + url.pathname);
+};
+Runtime.runMain(main);
+`,
+    );
+    const packages = path.join(target.directory, "node_modules", "@executor-js");
+    yield* fs.makeDirectory(packages, { recursive: true });
+    const product = path.join(packages, "hosted-self-host");
+    if (!(yield* fs.exists(product)))
+      yield* fs.symlink(path.resolve("apps/hosted/self-host"), product);
+    const config = path.join(target.directory, "atlassian-family-product.json");
+    yield* fs.writeFileString(
+      config,
+      JSON.stringify({
+        extends: path.resolve("tsconfig.json"),
+        compilerOptions: { typeRoots: [path.resolve("node_modules/@types")] },
+        files: [entry],
+        include: [],
+        exclude: [],
+      }),
+    );
+    const checked = yield* processes.exitCode(
+      ChildProcess.make(path.resolve("node_modules/.bin/tsc-rs"), ["--noEmit", "-p", config], {
+        stdout: "inherit",
+        stderr: "inherit",
+      }),
+    );
+    if (checked !== 0) return yield* Effect.die("Atlassian family transport failed its typecheck");
+    yield* serverControl("stop");
+    yield* serverControl("environment", 200, {
+      EXECUTOR_E2E_PRODUCT_ENTRY: entry,
+      EXECUTOR_OAUTH_CALLBACK_URL: targetHosts(target).browser + "/oauth/callback",
+      EXECUTOR_OAUTH_ATLASSIAN_CLIENT_ID: atlassianFamilyClients.atlassian.id,
+      EXECUTOR_OAUTH_ATLASSIAN_CLIENT_SECRET: atlassianFamilyClients.atlassian.secret,
+      EXECUTOR_OAUTH_TRELLO_CLIENT_ID: atlassianFamilyClients.atlassian.id,
+      EXECUTOR_OAUTH_TRELLO_CLIENT_SECRET: atlassianFamilyClients.atlassian.secret,
+      EXECUTOR_OAUTH_GOOGLE_CLIENT_ID: atlassianFamilyClients.google.id,
+      EXECUTOR_OAUTH_GOOGLE_CLIENT_SECRET: atlassianFamilyClients.google.secret,
+    });
+    yield* serverControl("start");
+    return {
+      startAfterLegacyWrite: serverControl("environment", 200, {
+        EXECUTOR_OAUTH_CALLBACK_URL: targetHosts(target).browser + "/oauth/callback",
+      }).pipe(Effect.andThen(serverControl("start"))),
+      requests: fs.readFileString(observations).pipe(
+        Effect.flatMap((text) =>
+          Schema.decodeUnknownEffect(Requests)(
+            text
+              .trim()
+              .split("\n")
+              .filter(Boolean)
+              .map((line) => JSON.parse(line)),
+          ),
+        ),
+      ),
+    };
+  });
