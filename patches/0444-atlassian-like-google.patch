+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Api, body } from "../support/api.ts";
+import { Committed, Workspace } from "../support/app-authoring.ts";
+import { Actors } from "../support/actors.ts";
+import { Browser } from "../support/browser.ts";
+import { Evidence } from "../support/evidence.ts";
+import { routeFamilyMarks } from "../support/atlassian-family-fixture.ts";
+import { atlassianAdoptionFixture } from "../support/atlassian-adoption-fixture.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Applied, DryRun } from "../support/production-ops-migration-proof.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Atlassian family adoption", (it) => {
+  it.effect(scenarios.cloudAtlassianFamilyAdoption.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const p = yield* atlassianAdoptionFixture;
+        const browser = yield* Browser,
+          actors = yield* Actors,
+          evidence = yield* Evidence;
+        yield* browser.omitNetworkTrace;
+        yield* browser.login(actors.owner);
+        yield* browser.use("Use local fixture provider marks", (page) =>
+          routeFamilyMarks(page.context()),
+        );
+        const captureApps = (state: "before" | "after") =>
+          Effect.gen(function* () {
+            for (const width of [1280, 390] as const) {
+              const png = yield* browser.use(`Read ${state} adoption Apps at ${width} px`, (page) =>
+                page
+                  .setViewportSize({ width, height: width === 390 ? 844 : 900 })
+                  .then(() => page.goto(`/org/${actors.organization.slug}/apps`))
+                  .then(() => page.getByText("Jira", { exact: true }).waitFor())
+                  .then(() => page.getByText("Confluence", { exact: true }).waitFor())
+                  .then(() => page.getByText("Atlassian", { exact: true }).count())
+                  .then((count) => {
+                    expect(count).toBe(state === "before" ? 1 : 0);
+                  })
+                  .then(() => page.screenshot({ fullPage: true })),
+              );
+              yield* evidence.attach(`atlassian-apps-${state}-${width}.png`, "image/png", png);
+            }
+          });
+        yield* captureApps("before");
+        // The first dashboard read materializes its built-in account before the migration snapshot.
+        const before = yield* p.protectedRows;
+        const apply = (dry: typeof DryRun.Type) => ({
+          ...p.operation,
+          action: "apply",
+          artifact: dry.artifact,
+          planSha256: dry.artifact.sha256,
+          backupSha256: dry.backupSha256,
+          go: `GO ${dry.artifact.sha256}`,
+        });
+        // Unverified legacy accounts must reconnect, even when the label matches.
+        yield* p.database.run({
+          sql: "update executor_accounts set identity_id = null where id = $1",
+          params: [p.jira.account],
+        });
+        expect((yield* p.request(p.operation)).status).toBe(409);
+        yield* p.database.run({
+          sql: "update executor_accounts set identity_id = $2 where id = $1",
+          params: [p.jira.account, p.own.identity],
+        });
+        // A verified, different subject with the same label cannot be adopted by inference.
+        yield* p.database.run({
+          sql: "update executor_accounts set identity_id = $2 where id = $1",
+          params: [p.jira.account, p.alternateIdentity],
+        });
+        expect((yield* p.request(p.operation)).status).toBe(409);
+        yield* p.database.run({
+          sql: "update executor_accounts set identity_id = $2 where id = $1",
+          params: [p.jira.account, p.own.identity],
+        });
+        yield* p.database.run({
+          sql: "insert into executor_app_records (id, app, table_name, record_key, value) values ($1, $1, 'saved', 'work', '{}'::jsonb)",
+          params: [p.own.app],
+        });
+        expect((yield* p.request(p.operation)).status).toBe(409);
+        yield* p.database.run({
+          sql: "delete from executor_app_records where app = $1",
+          params: [p.own.app],
+        });
+        expect(yield* p.protectedRows).toEqual(before);
+        const response = yield* p.request(p.operation);
+        expect(response.status, JSON.stringify(response.body)).toBe(200);
+        const dry = yield* body(DryRun, response);
+        const plan = yield* Schema.decodeUnknownEffect(p.Plan)(p.decrypt(dry.artifact));
+        expect(plan.plan.changes.filter((change) => change.table === "executor_apps")).toEqual([
+          expect.objectContaining({ key: { id: p.own.app }, action: "delete" }),
+        ]);
+        expect(
+          plan.plan.changes.some((change) =>
+            ["executor_accounts", "executor_oauth_grants", "executor_deployments"].includes(
+              change.table,
+            ),
+          ),
+        ).toBe(false);
+        yield* p.database.run({
+          sql: "update executor_accounts set label = 'changed after review' where id = $1",
+          params: [p.jira.account],
+        });
+        const changed = yield* p.protectedRows;
+        expect((yield* p.request(apply(dry))).status).toBe(409);
+        expect(yield* p.protectedRows).toEqual(changed);
+        const freshResponse = yield* p.request(p.operation);
+        expect(freshResponse.status, JSON.stringify(freshResponse.body)).toBe(200);
+        const fresh = yield* body(DryRun, freshResponse);
+        const applied = yield* p.request(apply(fresh));
+        expect(applied.status, JSON.stringify(applied.body)).toBe(200);
+        expect(yield* body(Applied, applied)).toMatchObject({
+          repeated: false,
+          verification: { ok: true },
+        });
+        expect(yield* p.protectedRows).toEqual(changed);
+        expect(
+          yield* p.database.run({
+            sql: "select id from executor_apps where id = $1",
+            params: [p.own.app],
+          }),
+        ).toEqual([]);
+        yield* captureApps("after");
+        const replay = yield* p.request(apply(fresh));
+        expect(replay.status, JSON.stringify(replay.body)).toBe(200);
+        expect((yield* body(Applied, replay)).repeated).toBe(true);
+        expect(yield* p.protectedRows).toEqual(changed);
+      }),
+    ),
+  );
+
+  it.effect(scenarios.cloudAtlassianFamilySourcePreservation.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const p = yield* atlassianAdoptionFixture;
+        const actors = yield* Actors;
+        const api = yield* Api;
+        const response = yield* p.request(p.operation);
+        expect(response.status, JSON.stringify(response.body)).toBe(200);
+        const dry = yield* body(DryRun, response);
+        const path = `/api/organizations/${p.own.organization}/apps/${p.own.app}`;
+        const working = yield* body(
+          Workspace,
+          yield* api.request(actors.owner, "GET", `${path}/workspace`),
+        );
+        const files = [
+          ...working.files,
+          { path: "saved-work.md", content: "Keep this private source edit.\n" },
+        ];
+        const save = yield* api.request(actors.owner, "POST", `${path}/commits`, {
+          expected: working.revision.commit,
+          files,
+          message: "Save private app work",
+        });
+        expect(save.status).toBe(200);
+        const committed = yield* body(Committed, save);
+        const protectedRows = yield* p.protectedRows;
+        expect(
+          (yield* p.request({
+            ...p.operation,
+            action: "apply",
+            artifact: dry.artifact,
+            planSha256: dry.artifact.sha256,
+            backupSha256: dry.backupSha256,
+            go: `GO ${dry.artifact.sha256}`,
+          })).status,
+        ).toBe(409);
+        expect((yield* p.request(p.operation)).status).toBe(409);
+        const retained = yield* api.request(actors.owner, "GET", `${path}/workspace`);
+        expect(retained.status).toBe(200);
+        const source = yield* body(Workspace, retained);
+        expect(source.revision).toEqual(committed.revision);
+        expect(source.files).toEqual(
+          expect.arrayContaining([
+            { path: "saved-work.md", content: "Keep this private source edit.\n" },
+          ]),
+        );
+        expect(yield* p.protectedRows).toEqual(protectedRows);
+        // An uncertain earlier write fences retirement, not the person's subsequent saves.
+        const codes = yield* p.database
+          .run({ sql: "select code from executor_apps where id = $1", params: [p.own.app] })
+          .pipe(
+            Effect.flatMap(
+              Schema.decodeUnknownEffect(Schema.Array(Schema.Struct({ code: Schema.String }))),
+            ),
+          );
+        const code = codes[0]?.code;
+        if (code === undefined) return yield* Effect.die("Retained source lineage missing");
+        yield* p.database.run({
+          sql: "update hosted_source_write_frontiers set active_writes = 1 where code = $1",
+          params: [code],
+        });
+        expect((yield* p.request(p.operation)).status).toBe(409);
+        const continued = yield* api.request(actors.owner, "POST", `${path}/commits`, {
+          expected: source.revision.commit,
+          files: [
+            ...source.files,
+            { path: "continued-work.md", content: "Normal writes still work.\n" },
+          ],
+          message: "Continue after uncertain write",
+        });
+        expect(continued.status, JSON.stringify(continued.body)).toBe(200);
+        const continuedRevision = yield* body(Committed, continued);
+        const continuedSource = yield* body(
+          Workspace,
+          yield* api.request(actors.owner, "GET", `${path}/workspace`),
+        );
+        expect(continuedSource.revision).toEqual(continuedRevision.revision);
+        expect(continuedSource.files).toEqual(
+          expect.arrayContaining([
+            { path: "continued-work.md", content: "Normal writes still work.\n" },
+          ]),
+        );
+        expect(
+          yield* p.database.run({
+            sql: "select active_writes from hosted_source_write_frontiers where code = $1",
+            params: [code],
+          }),
+        ).toEqual([{ active_writes: 1 }]);
+        expect((yield* p.request(p.operation)).status).toBe(409);
+        expect(yield* p.protectedRows).toEqual(protectedRows);
+      }),
+    ),
+  );
+});
