+                ]),
+              );
+            expect(atlassianRows, "one Atlassian row").toBe(1);
+            expect(atlassianApps).toEqual(["Confluence", "Jira"]);
+            expect(atlassianMark.name).toBe("Atlassian");
+            expect(atlassianMark.logos).toHaveLength(1);
+            expect(atlassianMark.logos[0]).toContain("/logo/atlassian.com");
+            expect(googleApps).toEqual(["Gmail", "Google Calendar"]);
+            expect(googleMark.name).toBe("Google");
