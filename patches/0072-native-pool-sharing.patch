new file mode 100644
index 0000000..2983247
--- /dev/null
+++ b/apps/hosted/server/src/contracts/pool-usage.ts
@@ -0,0 +1,113 @@
+import { AppId, StorageError } from "@executor-js/sdk/core";
+import { ApiError } from "@executor-js/utils/api-error";
+import { Context, Schema } from "effect";
+import type { Redacted } from "effect";
+import { HttpApiEndpoint, HttpApiGroup } from "effect/http-api";
+import { Principal } from "./auth.ts";
+import { RequiredAction } from "./authorization.ts";
+import {
+  OrganizationForbidden,
+  OrganizationReference,
+  RequireOrganization,
+} from "./organization.ts";
+
+const nonnegative = Schema.Finite.check(Schema.isGreaterThanOrEqualTo(0));
+export const WeeklyPoolCap = Schema.Finite.check(
+  Schema.isGreaterThan(0),
+  Schema.isLessThanOrEqualTo(100_000),
+  Schema.makeFilter((value) => Math.round(value * 100) / 100 === value),
+);
+const Usage = Schema.Struct({
+  requests: nonnegative,
+  cost: nonnegative,
+  unpriced: nonnegative,
+  tokens: Schema.Struct({
+    input: nonnegative,
+    cacheRead: nonnegative,
+    cacheWrite: nonnegative,
+    output: nonnegative,
+    total: nonnegative,
+  }),
+});
+const ModelUsage = Schema.Struct({
+  ...Usage.fields,
+  provider: Schema.String,
+  model: Schema.String,
+});
+const Cap = Schema.Struct({
+  weekly: WeeklyPoolCap,
+  used: nonnegative,
+  remaining: Schema.Finite,
+  resetAt: Schema.NonEmptyString,
+});
+export const PoolMemberUsage = Schema.Struct({
+  ...Usage.fields,
+  member: Principal.fields.userId,
+  models: Schema.Array(ModelUsage),
+  days: Schema.Array(
+    Schema.Struct({ ...Usage.fields, day: Schema.String, models: Schema.Array(ModelUsage) }),
+  ),
+  cap: Schema.NullOr(Cap),
+});
+/** This host boundary deliberately excludes serving-account references and credentials. */
+export const PoolUsageSummary = Schema.Struct({
+  from: Schema.NonEmptyString,
+  to: Schema.NonEmptyString,
+  readAt: Schema.NullOr(Schema.NonEmptyString),
+  members: Schema.Array(PoolMemberUsage),
+});
+export const PoolUsagePage = Schema.Struct({
+  ...PoolUsageSummary.fields,
+  pool: AppId,
+  native: Schema.Boolean,
+  next: Schema.NullOr(Schema.NonEmptyString),
+  members: Schema.Array(
+    Schema.Struct({
+      ...PoolMemberUsage.fields,
+      name: Schema.String,
+      email: Schema.String,
+      owner: Schema.Boolean,
+    }),
+  ),
+});
+export type PoolUsagePage = typeof PoolUsagePage.Type;
+
+export const PoolUsageUnavailable = ApiError.define({
+  tag: "PoolUsageUnavailable",
+  status: 503,
+  message: "Pool usage could not be reached. Try again.",
+});
+export const PoolCapConflict = ApiError.define({
+  tag: "PoolCapConflict",
+  status: 409,
+  message: "Choose a current pool user. The pool owner has no cap.",
+});
+
+/** Hosts supply their pool origin; a local product can instead use its configured backend. */
+export const PoolUsageBackend = Context.Reference<
+  | {
+      readonly origin: string;
+      readonly key: Redacted.Redacted<string>;
+    }
+  | undefined
+>("hosted/PoolUsageBackend", { defaultValue: () => undefined });
+
+const params = { organization: OrganizationReference, app: AppId };
+export const HostedPoolUsage = HttpApiGroup.make("poolUsage")
+  .add(
+    HttpApiEndpoint.get("get", "/api/organizations/:organization/apps/:app/pool-usage", {
+      params,
+      query: { after: Schema.optional(Schema.NonEmptyString) },
+      success: Schema.NullOr(PoolUsagePage),
+      error: [OrganizationForbidden, StorageError, PoolUsageUnavailable],
+    }).annotate(RequiredAction, "read"),
+  )
+  .add(
+    HttpApiEndpoint.put("setCap", "/api/organizations/:organization/apps/:app/pool-caps/:member", {
+      params: { ...params, member: Principal.fields.userId },
+      payload: Schema.Struct({ weekly: Schema.NullOr(WeeklyPoolCap) }),
+      success: Schema.Struct({ success: Schema.Literal(true) }),
+      error: [OrganizationForbidden, StorageError, PoolUsageUnavailable, PoolCapConflict],
+    }).annotate(RequiredAction, "manage"),
+  )
+  .middleware(RequireOrganization);
