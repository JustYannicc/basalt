+++ b/e2e/tests/pool-sharing.spec.ts
@@ -0,0 +1,269 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body, type Session } from "../support/api.ts";
+import { App } from "../support/contracts.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { poolUsageBackend } from "../support/pool-usage-backend.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Access = Schema.Struct({
+  revision: Schema.String,
+  audience: Schema.Unknown,
+  canManage: Schema.Boolean,
+  canUse: Schema.Boolean,
+});
+const Group = Schema.Struct({ id: Schema.String, revision: Schema.String });
+const Members = Schema.Struct({
+  members: Schema.Array(
+    Schema.Struct({ id: Schema.String, userId: Schema.String, role: Schema.String }),
+  ),
+});
+const Page = Schema.Struct({
+  pool: Schema.String,
+  native: Schema.Boolean,
+  next: Schema.NullOr(Schema.String),
+  members: Schema.Array(
+    Schema.Struct({
+      member: Schema.String,
+      name: Schema.String,
+      cap: Schema.NullOr(Schema.Struct({ weekly: Schema.Number })),
+      models: Schema.Array(Schema.Unknown),
+      days: Schema.Array(Schema.Unknown),
+    }),
+  ),
+});
+const source = `import {defineApp,query,object,router} from "apps";
+export default defineApp({},{tools:router({identity:query({input:object({})},async()=>"allowed")})});`;
+
+layer(RuntimeLive, { excludeTestServices: true })("Native pool sharing", (it) => {
+  it.effect(scenarios.poolSharing.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          backend = yield* poolUsageBackend;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const read = <A>(
+          schema: Schema.ConstraintDecoder<A, never>,
+          ...args: Parameters<typeof api.request>
+        ) => api.request(...args).pipe(Effect.flatMap((response) => body(schema, response)));
+        const ids = yield* Effect.forEach([actors.owner, actors.admin, actors.member], (actor) =>
+          read(Schema.Struct({ userId: Schema.String }), actor, "GET", "/api/viewer"),
+        );
+        const [owner, admin, member] = ids.map((id) => id.userId);
+        if (owner === undefined || admin === undefined || member === undefined)
+          return yield* Effect.die("Missing actors");
+        const members = yield* read(
+          Members,
+          actors.owner,
+          "GET",
+          `/api/auth/organization/list-members?organizationId=${actors.organization.id}`,
+        );
+        const memberRow = members.members.find((row) => row.userId === member),
+          adminRow = members.members.find((row) => row.userId === admin);
+        if (memberRow === undefined || adminRow === undefined)
+          return yield* Effect.die("Missing memberships");
+        const deploy = (actor: Session, name: string) =>
+          read(App, actor, "POST", `${prefix}/apps/deploy`, {
+            name,
+            files: [{ path: "index.ts", content: source }, appsManifest],
+          });
+        const first = yield* deploy(actors.owner, "First private pool"),
+          second = yield* deploy(actors.admin, "Other private pool"),
+          ordinary = yield* deploy(actors.owner, "Ordinary app");
+        const path = (app: string) => `${prefix}/apps/${app}`;
+        const access = (app: string, actor = actors.owner) =>
+          read(Access, actor, "GET", `${path(app)}/access`);
+        const share = (app: string, audience: unknown) =>
+          Effect.gen(function* () {
+            const current = yield* access(app);
+            expect(
+              (yield* api.request(actors.owner, "PATCH", `${path(app)}/access`, {
+                revision: current.revision,
+                audience,
+              })).status,
+            ).toBe(200);
+          });
+        const page = (app: string, actor = actors.owner, after?: string) =>
+          read(
+            Page,
+            actor,
+            "GET",
+            `${path(app)}/pool-usage${after === undefined ? "" : `?after=${encodeURIComponent(after)}`}`,
+          );
+        const cap = (app: string, person: string, weekly: number | null, actor = actors.admin) =>
+          api.request(actor, "PUT", `${path(app)}/pool-caps/${person}`, { weekly });
+        const initialFirst = yield* access(first.id),
+          initialSecond = yield* access(second.id);
+        yield* serverControl("stop");
+        yield* legacyStorage([
+          {
+            sql: `update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb), '{basaltPools}', $1::jsonb)::text where id = $2`,
+            params: [
+              JSON.stringify({
+                [owner]: {
+                  app: first.id,
+                  version: "retained-version",
+                  authorization: "executor-app-v1",
+                },
+                [admin]: { app: second.id, version: "retained-version" },
+              }),
+              actors.organization.id,
+            ],
+          },
+        ]);
+        yield* serverControl("environment", 200, {
+          POOL_APP_SIGNING_KEY: "ab".repeat(32),
+          BASALT_POOL_ORIGIN: backend.origin,
+        });
+        yield* serverControl("start");
+        yield* Effect.addFinalizer(() => serverControl("start").pipe(Effect.orDie));
+
+        expect((yield* access(first.id)).audience).toEqual(initialFirst.audience);
+        expect((yield* access(second.id)).audience).toEqual(initialSecond.audience);
+        expect(yield* access(first.id, actors.admin)).toMatchObject({
+          canManage: true,
+          canUse: false,
+        });
+        expect(
+          (yield* api.request(actors.admin, "POST", `${path(first.id)}/tools/call`, {
+            tool: "identity",
+            kind: "query",
+            input: {},
+          })).status,
+        ).toBe(403);
+        expect((yield* page(first.id, actors.admin)).members.map((row) => row.member)).toEqual([
+          owner,
+        ]);
+        expect((yield* page(second.id)).native).toBe(false);
+        expect(
+          (yield* api.request(actors.owner, "GET", `${path(ordinary.id)}/pool-usage`)).body,
+        ).toBeNull();
+        expect(
+          (yield* api.request(actors.member, "GET", `${path(first.id)}/pool-usage`)).status,
+        ).toBe(403);
+        expect((yield* cap(first.id, owner, 10)).status).toBe(409);
+
+        const group = yield* read(Group, actors.owner, "POST", `${prefix}/groups`, {
+          name: "First pool users",
+          description: "",
+          memberIds: [memberRow.id],
+        });
+        yield* share(first.id, { kind: "groups", groups: [group.id] });
+        yield* share(second.id, { kind: "everyone" });
+        expect((yield* page(first.id)).members.map((row) => row.member)).toEqual([member]);
+        for (let retry = 0; retry < 2; retry++)
+          expect((yield* cap(first.id, member, 10)).status).toBe(200);
+        const saved = yield* api.request(actors.admin, "GET", `${path(first.id)}/pool-usage`);
+        expect((yield* body(Page, saved)).members[0]).toMatchObject({
+          member,
+          cap: { weekly: 10 },
+        });
+        expect(JSON.stringify(saved.body)).not.toContain("synthetic-private");
+        expect((yield* page(first.id)).members[0]?.models).toHaveLength(1);
+        expect((yield* page(first.id)).members[0]?.days).toHaveLength(1);
+        expect(
+          (yield* page(second.id)).members.find((row) => row.member === member)?.cap,
+        ).toBeNull();
+        expect((yield* cap(first.id, member, null)).status).toBe(200);
+        expect((yield* page(first.id)).members[0]?.cap).toBeNull();
+        expect((yield* cap(first.id, member, 15, actors.member)).status).toBe(403);
+        expect((yield* cap(first.id, admin, 15)).status).toBe(409);
+
+        expect(
+          (yield* api.request(actors.owner, "POST", "/api/auth/organization/update-member-role", {
+            organizationId: actors.organization.id,
+            memberId: adminRow.id,
+            role: "member",
+          })).status,
+        ).toBe(200);
+        const callsBefore = (yield* backend.calls).length;
+        expect((yield* cap(first.id, member, 20)).status).toBe(403);
+        expect(
+          (yield* api.request(actors.admin, "GET", `${path(first.id)}/pool-usage`)).status,
+        ).toBe(403);
+        expect((yield* backend.calls).length).toBe(callsBefore);
+        expect((yield* api.request(actors.admin, "GET", `${path(first.id)}/access`)).status).toBe(
+          403,
+        );
+        expect(
+          (yield* api.request(actors.owner, "POST", "/api/auth/organization/update-member-role", {
+            organizationId: actors.organization.id,
+            memberId: adminRow.id,
+            role: "admin",
+          })).status,
+        ).toBe(200);
+        expect((yield* cap(first.id, member, 20)).status).toBe(200);
+        const currentGroup = yield* read(
+          Group,
+          actors.owner,
+          "GET",
+          `${prefix}/groups/${group.id}`,
+        );
+        expect(
+          (yield* api.request(actors.owner, "PATCH", `${prefix}/groups/${group.id}`, {
+            revision: currentGroup.revision,
+            name: "First pool users",
+            description: "",
+            memberIds: [],
+          })).status,
+        ).toBe(200);
+        expect((yield* cap(first.id, member, 20)).status).toBe(409);
+        const stillMember = yield* read(
+          Members,
+          actors.owner,
+          "GET",
+          `/api/auth/organization/list-members?organizationId=${actors.organization.id}`,
+        );
+        expect(stillMember.members.find((row) => row.userId === member)?.id).toBe(memberRow.id);
+        expect((yield* access(second.id, actors.member)).canUse).toBe(true);
+        expect((yield* page(second.id)).native).toBe(false);
+        yield* share(first.id, { kind: "everyone" });
+        yield* backend.unavailable(true);
+        expect(
+          (yield* api.request(actors.admin, "GET", `${path(first.id)}/pool-usage`)).status,
+        ).toBe(503);
+        yield* backend.unavailable(false);
+        expect((yield* page(first.id, actors.admin)).native).toBe(true);
+        yield* serverControl("stop");
+        yield* legacyStorage([
+          {
