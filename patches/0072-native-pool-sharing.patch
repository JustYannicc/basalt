+          yield* browser.use("Open existing audience choices", (page) =>
+            page.getByRole("combobox", { name: "Who can use this app?" }).click(),
+          );
+          expect(
+            yield* browser.use("Keep every native audience choice", (page) =>
+              page.getByRole("option").allTextContents(),
+            ),
+          ).toEqual(["Only me", "Selected groups", "Everyone in the organization"]);
+          yield* browser.use("Choose existing Groups mode", (page) =>
+            page.getByRole("option", { name: "Selected groups", exact: true }).click(),
+          );
+          yield* browser.use("Show native group selection", (page) =>
+            page.getByRole("checkbox", { name: "Pool readers", exact: true }).waitFor(),
+          );
+          yield* browser.checkpoint(`Existing app audience and groups at ${width}px`);
+          yield* browser.use("Open existing Groups screen", (page) =>
+            page.goto(`/org/${actors.organization.slug}/groups`),
+          );
+          yield* browser.use("Wait for saved group", (page) =>
+            page.getByText("Pool readers", { exact: true }).waitFor(),
+          );
+          yield* browser.checkpoint(`Existing Groups screen at ${width}px`);
+          yield* browser.use("Open existing Members screen", (page) =>
+            page.goto(`/org/${actors.organization.slug}/organization`),
+          );
+          yield* browser.use("Wait for native member controls", (page) =>
+            page.getByRole("table", { name: "Members", exact: true }).waitFor(),
+          );
+          yield* browser.use("Open existing member role choices", (page) =>
+            page
+              .getByRole("combobox", { name: "Role for member@example.test", exact: true })
+              .click(),
+          );
+          yield* browser.use("Wait for member role menu", (page) =>
+            page.getByRole("option", { name: "Member", exact: true }).waitFor(),
+          );
+          yield* browser.use("Finish native role-menu animation", (page) =>
+            page
+              .getByRole("listbox")
+              .evaluate((element) =>
+                Promise.all(
+                  element.getAnimations({ subtree: true }).map((animation) => animation.finished),
+                ),
+              ),
+          );
+          yield* browser.checkpoint(`Existing member role choices at ${width}px`);
+          offered.push(
+            yield* browser.use("Read member role choices", (page) =>
+              page.getByRole("option").allTextContents(),
+            ),
+          );
+          yield* browser.use("Close member choices", (page) => page.keyboard.press("Escape"));
+          yield* browser.use("Open existing invitation dialog", (page) =>
+            page.getByRole("button", { name: "Add member", exact: true }).click(),
+          );
+          yield* browser.use("Open existing invitation roles", (page) =>
+            page.getByRole("combobox", { name: "Invitation role", exact: true }).click(),
+          );
+          yield* browser.use("Wait for invitation role menu", (page) =>
+            page.getByRole("option", { name: "Member", exact: true }).waitFor(),
+          );
+          yield* browser.use("Finish native invitation-menu animation", (page) =>
+            page
+              .getByRole("listbox")
+              .evaluate((element) =>
+                Promise.all(
+                  element.getAnimations({ subtree: true }).map((animation) => animation.finished),
+                ),
+              ),
+          );
+          yield* browser.checkpoint(`Existing invitation role choices at ${width}px`);
+          offered.push(
+            yield* browser.use("Read invitation role choices", (page) =>
+              page.getByRole("option").allTextContents(),
+            ),
+          );
+          yield* browser.use("Close invitation roles", (page) => page.keyboard.press("Escape"));
+          yield* browser.use("Close invitation", (page) =>
+            page.getByRole("dialog").getByRole("button", { name: "Cancel", exact: true }).click(),
+          );
+          expect(
+            yield* browser.use("Native controls fit the viewport", (page) =>
+              page.evaluate(() => document.documentElement.scrollWidth <= innerWidth),
+            ),
+          ).toBe(true);
+        }
+        for (const options of offered) expect(options).toEqual(["Member", "Admin"]);
+        yield* browser.use("Open member role control", (page) =>
+          page.getByRole("combobox", { name: "Role for member@example.test", exact: true }).click(),
+        );
+        yield* browser.use("Promote with the existing role control", (page) =>
+          page.getByRole("option", { name: "Admin", exact: true }).click(),
+        );
+        yield* browser.use("Wait for confirmed native role", (page) =>
+          page
+            .getByRole("combobox", { name: "Role for member@example.test", exact: true })
+            .filter({ hasText: "Admin" })
+            .waitFor(),
+        );
+        const members = yield* body(
+          Schema.Struct({
+            members: Schema.Array(
+              Schema.Struct({ role: Schema.String, user: Schema.Struct({ email: Schema.String }) }),
+            ),
+          }),
+          yield* api.request(
+            actors.owner,
+            "GET",
+            `/api/auth/organization/list-members?organizationId=${actors.organization.id}`,
+          ),
+        );
+        expect(
+          members.members.find((person) => person.user.email === "member@example.test")?.role,
+        ).toBe("admin");
+        yield* browser.checkpoint("Native member promotion confirmed");
+      }),
+    ),
+  );
+});
diff --git a/e2e/tests/pool-sharing.spec.ts b/e2e/tests/pool-sharing.spec.ts
