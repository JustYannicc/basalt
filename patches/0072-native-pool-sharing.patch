+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { App } from "../support/contracts.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Resource = Schema.Struct({ id: Schema.String, revision: Schema.String });
+const source = `import {defineApp,query,object,router} from "apps";
+export default defineApp({},{tools:router({identity:query({input:object({})},async()=>"allowed")})});`;
+
+layer(HostedLive, { excludeTestServices: true })("Native sharing controls", (it) => {
+  it.effect(scenarios.poolSharingUi.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          browser = yield* Browser;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const group = yield* body(
+          Resource,
+          yield* api.request(actors.owner, "POST", `${prefix}/groups`, {
+            name: "Pool readers",
+            description: "Synthetic sharing proof",
+            memberIds: [],
+          }),
+        );
+        const app = yield* body(
+          App,
+          yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+            name: "Native sharing proof",
+            files: [{ path: "index.ts", content: source }, appsManifest],
+          }),
+        );
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            expect(
+              (yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app.id}`)).status,
+            ).toBe(200);
+            expect(
+              (yield* api.request(actors.owner, "DELETE", `${prefix}/groups/${group.id}`, {
+                revision: group.revision,
+              })).status,
+            ).toBe(200);
+          }).pipe(Effect.orDie),
