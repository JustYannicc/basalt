diff --git a/e2e/support/pool-usage-backend.ts b/e2e/support/pool-usage-backend.ts
new file mode 100644
index 0000000..330e8ae
--- /dev/null
+++ b/e2e/support/pool-usage-backend.ts
@@ -0,0 +1,129 @@
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Clock, Deferred, Effect, Layer, Ref, Schema } from "effect";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { createHmac, timingSafeEqual } from "node:crypto";
+import { createServer } from "node:http";
+
+const Assertion = Schema.Struct({
+  action: Schema.Literals(["managed-usage", "managed-cap"]),
+  pool: Schema.NonEmptyString,
+  organization: Schema.NonEmptyString,
+  owner: Schema.NonEmptyString,
+  user: Schema.NonEmptyString,
+  expiresAt: Schema.Finite,
+  members: Schema.optionalKey(Schema.Array(Schema.String)),
+  member: Schema.optionalKey(Schema.String),
+  weekly: Schema.optionalKey(Schema.NullOr(Schema.Finite)),
+});
+
+/** Only the external pool boundary is synthetic; the hosted product owns every access decision. */
+export const poolUsageBackend = Effect.gen(function* () {
+  const calls = yield* Ref.make<readonly (typeof Assertion.Type)[]>([]);
+  const caps = new Map<string, number>();
+  let unavailable = false;
+  let gate: { started: Deferred.Deferred<void>; release: Deferred.Deferred<void> } | undefined;
+  const handler = Effect.gen(function* () {
+    const request = yield* HttpServerRequest.HttpServerRequest;
+    const { envelope } = yield* request.json.pipe(
+      Effect.flatMap(Schema.decodeUnknownEffect(Schema.Struct({ envelope: Schema.String }))),
+    );
+    const [prefix, encoded, signature, extra] = envelope.split(".");
+    if (
+      prefix !== "sbs1" ||
+      encoded === undefined ||
+      signature === undefined ||
+      extra !== undefined
+    )
+      return HttpServerResponse.empty({ status: 401 });
+    const actual = Buffer.from(signature, "base64url");
+    const expected = createHmac("sha256", Buffer.from("ab".repeat(32), "hex"))
+      .update(`${prefix}.${encoded}`)
+      .digest();
+    if (actual.length !== expected.length || !timingSafeEqual(actual, expected))
+      return HttpServerResponse.empty({ status: 401 });
+    const value = yield* Schema.decodeUnknownEffect(Schema.fromJsonString(Assertion))(
+      Buffer.from(encoded, "base64url").toString(),
+    );
+    const now = yield* Clock.currentTimeMillis;
+    if (
+      value.expiresAt <= now ||
+      value.expiresAt > now + 30_000 ||
+      !request.url.endsWith(`/${value.action}`)
+    )
+      return HttpServerResponse.empty({ status: 401 });
+    yield* Ref.update(calls, (items) => [...items, value]);
+    if (unavailable) return HttpServerResponse.empty({ status: 503 });
+    if (value.action === "managed-cap") {
+      const held = gate;
+      if (held !== undefined) {
+        yield* Deferred.succeed(held.started, undefined);
+        yield* Deferred.await(held.release);
+      }
+      const id = `${value.pool}:${value.member}`;
+      if (value.weekly === null) caps.delete(id);
+      else if (value.weekly !== undefined) caps.set(id, value.weekly);
+      return HttpServerResponse.jsonUnsafe({ success: true });
+    }
+    const usage = {
+      requests: 1,
+      cost: 0.5,
+      unpriced: 0,
+      tokens: { input: 75, cacheRead: 10, cacheWrite: 5, output: 10, total: 100 },
+    };
+    const model = { ...usage, provider: "codex", model: "synthetic-model" };
+    return HttpServerResponse.jsonUnsafe({
+      from: "2026-10-01T00:00:00Z",
+      to: "2026-10-31T00:00:00Z",
+      readAt: "2026-10-31T00:00:00Z",
+      members: (value.members ?? []).map((member) => {
+        const weekly = caps.get(`${value.pool}:${member}`);
+        return {
+          member,
+          ...usage,
+          models: [model],
+          days: [{ ...usage, day: "2026-10-30", models: [model] }],
+          cap:
+            weekly === undefined
+              ? null
+              : { weekly, used: 0.5, remaining: weekly - 0.5, resetAt: "2026-11-02T00:00:00Z" },
+        };
+      }),
+      accounts: [{ account: "synthetic-private-account-reference" }],
+      credential: "synthetic-private-credential",
+    });
+  });
+  const services = yield* Layer.build(
+    HttpRouter.serve(
+      Layer.mergeAll(
+        HttpRouter.add("POST", "/__setup/v1/managed-usage", handler),
+        HttpRouter.add("POST", "/__setup/v1/managed-cap", handler),
+      ),
+      { disableLogger: true, disableListenLog: true },
+    ).pipe(Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 }))),
+  );
+  const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+  if (!("port" in server.address)) return yield* Effect.die("Pool fixture requires TCP");
+  return {
+    origin: `http://127.0.0.1:${server.address.port}`,
+    calls: Ref.get(calls),
+    unavailable: (value: boolean) =>
+      Effect.sync(() => {
+        unavailable = value;
+      }),
+    hold: Effect.gen(function* () {
+      const held = { started: yield* Deferred.make<void>(), release: yield* Deferred.make<void>() };
+      gate = held;
+      yield* Effect.addFinalizer(() => Deferred.succeed(held.release, undefined));
+      return {
+        started: Deferred.await(held.started),
+        release: Deferred.succeed(held.release, undefined).pipe(
+          Effect.tap(() =>
+            Effect.sync(() => {
+              gate = undefined;
+            }),
+          ),
+        ),
+      };
+    }),
+  };
+});
