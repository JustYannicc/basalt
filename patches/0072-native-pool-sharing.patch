diff --git a/apps/hosted/server/src/implementation/pool-usage.ts b/apps/hosted/server/src/implementation/pool-usage.ts
new file mode 100644
index 0000000..0763291
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-usage.ts
@@ -0,0 +1,198 @@
+import { AppId, StorageError } from "@executor-js/sdk/core";
+import { Clock, Config, Effect, Option, Redacted, Schema } from "effect";
+import { FetchHttpClient, HttpBody, HttpClient, HttpClientResponse } from "effect/http";
+import { HttpApiBuilder } from "effect/http-api";
+import { HostedApi } from "../contracts/api.ts";
+import { Principal } from "../contracts/auth.ts";
+import {
+  PoolCapConflict,
+  PoolUsageBackend,
+  PoolUsagePage,
+  PoolUsageSummary,
+  PoolUsageUnavailable,
+} from "../contracts/pool-usage.ts";
+import { applicationAudiences } from "./application-audience.ts";
+import { lockCurrentActor, policyDatabase, requireAppAccessAs } from "./resource-policy.ts";
+import { signEnvelope } from "./pool-token.ts";
+
+const Pool = Schema.Struct({
+  owner: Principal.fields.userId,
+  authorization: Schema.NullOr(Schema.String),
+});
+const Person = Schema.Struct({
+  user: Principal.fields.userId,
+  name: Schema.String,
+  email: Schema.String,
+});
+const pageSize = 100;
+
+const backend = Effect.gen(function* () {
+  const supplied = yield* PoolUsageBackend;
+  if (supplied !== undefined) return supplied;
+  const key = yield* Config.Redacted("POOL_APP_SIGNING_KEY").pipe(Config.option);
+  const origin = yield* Config.String("BASALT_POOL_ORIGIN").pipe(Config.option);
+  if (Option.isNone(key) || Option.isNone(origin)) return yield* new PoolUsageUnavailable();
+  return { key: key.value, origin: origin.value };
+}).pipe(Effect.catch(() => new PoolUsageUnavailable()));
+
+const send = <A>(
+  action: "managed-usage" | "managed-cap",
+  payload: Record<string, unknown>,
+  responseSchema: Schema.ConstraintDecoder<A, never>,
+) =>
+  Effect.gen(function* () {
+    const { key, origin } = yield* backend;
+    const now = yield* Clock.currentTimeMillis;
+    const envelope = yield* Effect.tryPromise(() =>
+      signEnvelope(Redacted.value(key), "sbs1", {
+        ...payload,
+        action,
+        expiresAt: now + 30_000,
+      }),
+    );
+    const client = yield* HttpClient.HttpClient;
+    const response = yield* client.post(new URL(`/__setup/v1/${action}`, origin).href, {
+      body: HttpBody.jsonUnsafe({ envelope }),
+    });
+    if (response.status !== 200) return yield* new PoolUsageUnavailable();
+    return yield* HttpClientResponse.schemaBodyJson(responseSchema)(response);
+  }).pipe(
+    Effect.timeout("10 seconds"),
+    Effect.provide(FetchHttpClient.layer),
+    Effect.catch(() => new PoolUsageUnavailable()),
+  );
+
+/** The native policy and external cap write share the organization access lock. */
+const withPool = <A, E, R>(
+  app: AppId,
+  work: (pool: {
+    pool: AppId;
+    organization: string;
+    owner: string;
+    user: string;
+    native: boolean;
+    users: string[];
+  }) => Effect.Effect<A, E, R>,
+) =>
+  Effect.gen(function* () {
+    const sql = yield* policyDatabase;
+    return yield* sql.withTransaction(
+      Effect.gen(function* () {
+        const actor = yield* lockCurrentActor;
+        yield* requireAppAccessAs(actor, app, "manage");
+        const rows =
+          yield* sql`select entry.key as owner, entry.value ->> 'authorization' as authorization
+        from organization o
+        cross join lateral jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) entry
+        join executor_apps app on app.id = entry.value ->> 'app' and app.owner = 'organization:' || o.id
+        where o.id = ${actor.organization} and app.id = ${app}`;
+        if (rows.length === 0) return null;
+        const found = yield* Schema.decodeUnknownEffect(Schema.Array(Pool))(rows);
+        if (found.length !== 1 || found[0] === undefined) return yield* new StorageError();
+        const saved = found[0];
+        const native = saved.authorization === "executor-app-v1";
+        const audience = (yield* applicationAudiences(actor.organization, [app]))[0];
+        const users = [
+          ...new Set([...(native ? [] : [saved.owner]), ...(audience?.users ?? [])]),
+        ].sort();
+        return yield* work({
+          pool: app,
+          organization: actor.organization,
+          owner: saved.owner,
+          user: actor.user,
+          native,
+          users,
+        });
+      }),
+    );
+  });
+
+export const poolUsage = (app: AppId, after?: string) =>
+  withPool(app, (pool) =>
+    Effect.gen(function* () {
+      const sql = yield* policyDatabase;
+      const people = pool.users
+        .filter((id) => after === undefined || id > after)
+        .slice(0, pageSize + 1);
+      const page = people.slice(0, pageSize);
+      const rows =
+        page.length === 0
+          ? []
+          : yield* sql`select m."userId" as "user", u.name, u.email
+      from member m join "user" u on u.id = m."userId"
+      where m."organizationId" = ${pool.organization} and ${sql.in("m.userId", page)}`;
+      const names = yield* Schema.decodeUnknownEffect(Schema.Array(Person))(rows);
+      const usage = yield* send(
+        "managed-usage",
+        {
+          pool: pool.pool,
+          organization: pool.organization,
+          owner: pool.owner,
+          user: pool.user,
+          members: page,
+        },
+        PoolUsageSummary,
+      );
+      if (
+        usage.members.length !== page.length ||
+        !page.every((id) => usage.members.some((row) => row.member === id))
+      )
+        return yield* new PoolUsageUnavailable();
+      return yield* Schema.decodeUnknownEffect(PoolUsagePage)({
+        ...usage,
+        pool: pool.pool,
+        native: pool.native,
+        next: people.length > pageSize ? (page.at(-1) ?? null) : null,
+        members: page.flatMap((id) => {
+          const member = usage.members.find((row) => row.member === id);
+          if (member === undefined) return [];
+          const person = names.find((row) => row.user === id);
+          return [
+            {
+              ...member,
+              name: person?.name ?? "",
+              email: person?.email ?? "",
+              owner: id === pool.owner,
+            },
+          ];
+        }),
+      });
+    }),
+  ).pipe(
+    Effect.catchTags({
+      SqlError: () => new StorageError(),
+      SchemaError: () => new PoolUsageUnavailable(),
+    }),
+  );
+
+export const setPoolCap = (app: AppId, member: string, weekly: number | null) =>
+  withPool(app, (pool) =>
+    Effect.gen(function* () {
+      if (member === pool.owner || !pool.users.includes(member))
+        return yield* new PoolCapConflict();
+      yield* send(
+        "managed-cap",
+        {
+          pool: pool.pool,
+          organization: pool.organization,
+          owner: pool.owner,
+          user: pool.user,
+          member,
+          weekly,
+        },
+        Schema.Struct({ success: Schema.Literal(true) }),
+      );
+      return { success: true as const };
+    }),
+  ).pipe(
+    Effect.flatMap((result) => (result === null ? new PoolCapConflict() : Effect.succeed(result))),
+    Effect.catchTags({ SqlError: () => new StorageError(), SchemaError: () => new StorageError() }),
+  );
+
+export const hostedPoolUsageHandlers = HttpApiBuilder.group(HostedApi, "poolUsage", (handlers) =>
+  handlers
+    .handle("get", ({ params, query }) => poolUsage(params.app, query.after))
+    .handle("setCap", ({ params, payload }) =>
+      setPoolCap(params.app, params.member, payload.weekly),
+    ),
+);
