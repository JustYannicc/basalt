+/** Departures have their own outbox: old provisioning dispatchers never read these rows. */
+import { Effect } from "effect";
+import { SqlClient } from "effect/sql";
+
+/** Additive, journaled once, with no backfill or changes to the shared provisioning queue. */
+export const migrateContributedDepartures = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  yield* sql`create table hosted_contributed_departure_jobs (
+    id text primary key default gen_random_uuid()::text,
+    organization_id text not null references organization(id) on delete cascade,
+    user_id text not null,
+    status text not null default 'queued' check (status in ('queued', 'running', 'succeeded', 'failed')),
+    attempts integer not null default 0,
+    available_at timestamptz not null default now(),
+    updated_at timestamptz not null default now()
+  )`;
+  yield* sql`create index hosted_contributed_departure_pending on hosted_contributed_departure_jobs (available_at) where status in ('queued', 'running')`;
+  // Neither authority nor snapshots reference the departing user row.
+  yield* sql`create table hosted_contributed_departures (
+    job text not null references hosted_contributed_departure_jobs(id) on delete cascade,
+    app text not null,
+    requirement text not null,
+    account text not null,
+    linked_at timestamptz not null,
+    primary key (job, app, requirement, account)
+  )`;
+  yield* sql`create index hosted_contributed_departure_link on hosted_contributed_departures (app, requirement, account, linked_at)`;
+  yield* sql`create view hosted_personal_contributions as
+    select l.app, l.requirement, l.account, l.created_at as linked_at, l.linked_by as user_id,
+      p.organization_id
+    from hosted_app_account_links l
+    join hosted_account_access p on p.account_id = l.account
+      and p.kind = 'personal' and p.personal_user_id = l.linked_by
+    join executor_apps a on a.id = l.app and a.owner = 'organization:' || p.organization_id
+    join executor_deployments d on d.id = a.active_deployment
+    where l.subject is null
+      and d.requirements::jsonb -> 'accounts' -> l.requirement ->> 'scope' = 'app'
+      and d.requirements::jsonb -> 'accounts' -> l.requirement ->> 'contributed' = 'true'`;
+  yield* sql`create function hosted_snapshot_contributed_departures(team text, departing text, target_app text)
+    returns void language plpgsql as $$
+    declare contributor record; departure text;
+    begin
+      -- Link writers hold these app rows until their access check and link commit. Wait for
+      -- earlier writers before scanning; later writers will recheck the committed policy.
+      perform a.id from executor_apps a join hosted_app_access p on p.id = a.id
+        where (team is null or p.organization_id = team)
+          and (target_app is null or a.id = target_app)
+          and (departing is null or exists (select 1 from member m
+            where m."organizationId" = p.organization_id and m."userId" = departing)
+            or exists (select 1 from hosted_app_account_links l where l.app = a.id and l.linked_by = departing))
+        order by a.id for no key update of a;
+      for contributor in
+        select distinct c.organization_id, c.user_id from hosted_personal_contributions c
+        where (team is null or c.organization_id = team)
+          and (departing is null or c.user_id = departing)
+          and (target_app is null or c.app = target_app)
+      loop
+        departure := gen_random_uuid()::text;
+        insert into hosted_contributed_departure_jobs (id, organization_id, user_id)
+          values (departure, contributor.organization_id, contributor.user_id);
+        insert into hosted_contributed_departures (job, app, requirement, account, linked_at)
+          select departure, c.app, c.requirement, c.account, c.linked_at
+          from hosted_personal_contributions c
+          where c.organization_id = contributor.organization_id and c.user_id = contributor.user_id
+            and (target_app is null or c.app = target_app)
+            and (departing is not null or not exists (
+              select 1 from member m join hosted_app_access p on p.organization_id = m."organizationId"
+              where m."userId" = c.user_id and m."organizationId" = c.organization_id and p.id = c.app
+                and (p.audience = 'everyone' or (p.audience = 'private' and p.creator_id = c.user_id) or (p.audience = 'groups' and exists (
+                  select 1 from hosted_app_groups g join hosted_group_members gm on gm.group_id = g.group_id
+                  where g.app_id = c.app and gm.member_id = m.id)))))
+            and not exists (select 1 from hosted_contributed_departures prior
+              where prior.app = c.app and prior.requirement = c.requirement
+                and prior.account = c.account and prior.linked_at = c.linked_at);
+        if not found then delete from hosted_contributed_departure_jobs where id = departure; end if;
+      end loop;
+    end $$`;
+  // Separate triggers leave the existing auth provisioning functions and their accepted kinds intact.
+  yield* sql`create function hosted_contributed_member_departure() returns trigger language plpgsql as $$
+    begin
+      if exists (select 1 from organization where id = OLD."organizationId") then
+        perform hosted_snapshot_contributed_departures(OLD."organizationId", OLD."userId", null);
+      end if;
+      return OLD;
+    end $$`;
+  yield* sql`create trigger hosted_contributed_member_departure after delete on member
+    for each row execute function hosted_contributed_member_departure()`;
+  yield* sql`create function hosted_contributed_user_departure() returns trigger language plpgsql as $$
+    begin
+      perform hosted_snapshot_contributed_departures(null, OLD.id, null);
+      return OLD;
+    end $$`;
+  yield* sql`create trigger hosted_contributed_user_departure before delete on "user"
+    for each row execute function hosted_contributed_user_departure()`;
+  // Sharing/group writes replace grants inside one transaction. Check the final policy, not
+  // temporary deleted rows, and commit the snapshots before reporting the access change done.
+  yield* sql`create function hosted_contributed_access_departure() returns trigger language plpgsql as $$
+    begin
+      if TG_TABLE_NAME = 'hosted_app_access' then
+        perform hosted_snapshot_contributed_departures(NEW.organization_id, null, NEW.id);
+      elsif TG_TABLE_NAME = 'hosted_app_groups' then
+        perform hosted_snapshot_contributed_departures(OLD.organization_id, null, OLD.app_id);
+      else
+        perform hosted_snapshot_contributed_departures(m."organizationId", null, null)
+          from member m where m.id = OLD.member_id;
+      end if;
+      return null;
+    end $$`;
+  yield* sql`create constraint trigger hosted_contributed_app_access after update on hosted_app_access
+    deferrable initially deferred for each row execute function hosted_contributed_access_departure()`;
+  yield* sql`create constraint trigger hosted_contributed_app_groups after delete on hosted_app_groups
+    deferrable initially deferred for each row execute function hosted_contributed_access_departure()`;
+  yield* sql`create constraint trigger hosted_contributed_group_members after delete on hosted_group_members
+    deferrable initially deferred for each row execute function hosted_contributed_access_departure()`;
+});
