diff --git a/apps/hosted/server/src/implementation/contributed-account-departure.ts b/apps/hosted/server/src/implementation/contributed-account-departure.ts
new file mode 100644
index 0000000..114ffc3
--- /dev/null
+++ b/apps/hosted/server/src/implementation/contributed-account-departure.ts
@@ -0,0 +1,79 @@
+/** Committed departures retire only the personal contributions captured in their snapshots. */
+import {
+  AccountId,
+  AppId,
+  InteractiveHost,
+  StorageError,
+  StorageHost,
+} from "@executor-js/sdk/core";
+import { Effect, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import { HostedExecutor } from "../contracts/executor.ts";
+import { organizationOwner, type OrganizationId } from "../contracts/organization.ts";
+import { lockAppLinks, removeLink } from "./app-accounts.ts";
+import { ContributedDeparture } from "./contributed-account-policy.ts";
+
+class ContributionGone extends Schema.TaggedError<ContributionGone>()("ContributionGone", {}) {}
+const DepartureLink = Schema.Struct({
+  app: AppId,
+  requirement: Schema.String,
+  account: AccountId,
+});
+
+export const retireContributedDeparture = (input: {
+  readonly id: string;
+  readonly organization: OrganizationId;
+  readonly user: string;
+}) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const executor = yield* Effect.flatten(HostedExecutor);
+    const owner = organizationOwner(input.organization);
+    const snapshots = yield* Schema.decodeUnknownEffect(Schema.Array(DepartureLink))(
+      yield* sql`select app, requirement, account
+        from hosted_contributed_departures where job = ${input.id} order by app, requirement, account`,
+    );
+    for (const link of snapshots) {
+      const present = sql`select 1 from hosted_app_account_links l
+        join executor_accounts a on a.id = l.account and a.owner = ${owner}
+        join hosted_account_access p on p.account_id = a.id and p.organization_id = ${input.organization}
+        where l.app = ${link.app} and l.requirement = ${link.requirement} and l.account = ${link.account}
+          and l.subject is null and l.linked_by = ${input.user}
+          and l.created_at = (select linked_at from hosted_contributed_departures
+            where job = ${input.id} and app = l.app and requirement = l.requirement and account = l.account)
+          and p.kind = 'personal' and p.personal_user_id = ${input.user}`;
+      const settled = (outcome: "unlinked" | "retired" | "snapshot_no_longer_current") =>
+        Effect.logInfo("Contributed departure link settled", { job: input.id, ...link, outcome });
+      // The snapshot records contribution authority. Redeploying cannot revoke queued cleanup.
+      // Recheck the exact link under the lock so a later relink survives the stale job.
+      const change = executor[StorageHost].transaction(
+        Effect.gen(function* () {
+          yield* lockAppLinks(sql, link.app);
+          if ((yield* present).length === 0) return yield* new ContributionGone();
+          return yield* removeLink(sql, executor.webhooks, { ...link, subject: null });
+        }),
+      );
+      const live = yield* executor[StorageHost].transaction(
+        Effect.gen(function* () {
+          yield* lockAppLinks(sql, link.app);
+          return (yield* present).length > 0;
+        }),
+      );
+      if (!live) {
+        yield* settled("snapshot_no_longer_current");
+        continue;
+      }
+      const binding = yield* executor[InteractiveHost].binding({ owner, account: link.account });
+      const acquired = binding?.app === link.app;
+      const removed = yield* executor[InteractiveHost]
+        .retire({ owner, accounts: acquired ? [link.account] : [] }, change)
+        .pipe(Effect.catchTag("ContributionGone", () => Effect.succeed(false)));
+      yield* settled(removed ? (acquired ? "retired" : "unlinked") : "snapshot_no_longer_current");
+    }
+  }).pipe(
+    Effect.provideService(ContributedDeparture, {
+      organization: input.organization,
+      user: input.user,
+    }),
+    Effect.mapError(() => new StorageError()),
+  );
diff --git a/apps/hosted/server/src/implementation/contributed-account-policy.ts b/apps/hosted/server/src/implementation/contributed-account-policy.ts
new file mode 100644
index 0000000..f3fc16b
--- /dev/null
+++ b/apps/hosted/server/src/implementation/contributed-account-policy.ts
@@ -0,0 +1,173 @@
+import { CurrentUserId } from "../contracts/auth.ts";
+/** Opt-in app links keep their contributor's authority separate from app management. */
+import { AccountId, type AccountScope, AppId, StorageError } from "@executor-js/sdk/core";
+import { Context, Effect, Schema } from "effect";
+import type { SqlClient } from "effect/sql";
+import { OrganizationForbidden, type OrganizationId } from "../contracts/organization.ts";
+import {
+  applicationAccess,
+  currentResourceAuthority,
+  policyDatabase,
+  requireAppAccessAs,
+  type ResourceAuthority,
+} from "./resource-policy.ts";
+
+/** Read deployment metadata, including again inside the app's link lock. Old slots opt out. */
+export const isContributed = (sql: SqlClient.SqlClient, app: AppId, requirement: string) =>
+  Effect.gen(function* () {
+    const rows = yield* sql`select 1 from executor_apps a
+      join executor_deployments d on d.id = a.active_deployment
+      where a.id = ${app}
+        and d.requirements::jsonb -> 'accounts' -> ${requirement} ->> 'scope' = 'app'
+        and d.requirements::jsonb -> 'accounts' -> ${requirement} ->> 'contributed' = 'true'`;
+    return rows.length === 1;
+  }).pipe(Effect.catchTag("SqlError", () => new StorageError()));
+
+/** App requirements are manager-only unless this deployment explicitly accepts contributions. */
+export const requireRequirementAccessAs = (
+  actor: ResourceAuthority,
+  input: { readonly app: AppId; readonly requirement: string; readonly scope: AccountScope },
+) =>
+  Effect.gen(function* () {
+    const sql = yield* policyDatabase;
+    const contributed =
+      input.scope === "app" && (yield* isContributed(sql, input.app, input.requirement));
+    return yield* requireAppAccessAs(
+      actor,
+      input.app,
+      input.scope === "user" || contributed ? "use" : "manage",
+    );
+  });
+
+export const requireRequirementAccess = (input: Parameters<typeof requireRequirementAccessAs>[1]) =>
+  Effect.flatMap(currentResourceAuthority, (actor) => requireRequirementAccessAs(actor, input));
+
+/** Must run under the app's link lock. Only the original contributor or an editor may unlink. */
+export const requireLinkRemovalAs = (
+  sql: SqlClient.SqlClient,
+  actor: ResourceAuthority,
+  input: { readonly app: AppId; readonly requirement: string; readonly account: AccountId },
+) =>
+  Effect.gen(function* () {
+    const access = yield* applicationAccess(input.app, actor);
+    if (access.canManage) return;
+    if (yield* isContributed(sql, input.app, input.requirement)) {
+      const own = yield* sql`select 1 from hosted_app_account_links
+        where app = ${input.app} and requirement = ${input.requirement}
+          and account = ${input.account} and subject is null and linked_by = ${actor.user}`;
+      if (own.length === 1) return;
+    }
+    return yield* new OrganizationForbidden();
+  }).pipe(Effect.catchTag("SqlError", () => new StorageError()));
+
+/** Deleting a holder's credentials must pass the same contributed-link checks as unlinking. */
+export const checkContributedAccountRemoval = (sql: SqlClient.SqlClient, account: AccountId) =>
+  Effect.gen(function* () {
+    const rows = yield* sql`select l.app, l.requirement from hosted_app_account_links l
+      join executor_apps a on a.id = l.app
+      join executor_deployments d on d.id = a.active_deployment
+      where l.account = ${account} and l.subject is null
+        and d.requirements::jsonb -> 'accounts' -> l.requirement ->> 'scope' = 'app'
+        and d.requirements::jsonb -> 'accounts' -> l.requirement ->> 'contributed' = 'true'
+      order by l.app, l.requirement`;
+    const links = yield* Schema.decodeUnknownEffect(
+      Schema.Array(
+        Schema.Struct({
+          app: AppId,
+          requirement: Schema.String,
+        }),
+      ),
+    )(rows);
+    for (const link of links) {
+      // The SDK may already hold the account row. Refuse contention instead of waiting for
+      // an app lock whose link writer could be waiting for that account row.
+      yield* sql`select id from executor_apps where id = ${link.app} for no key update nowait`;
+      if (!(yield* isContributed(sql, link.app, link.requirement))) continue;
+      const departure = yield* ContributedDeparture;
+      if (departure !== undefined && (yield* departingPersonalAccount(sql, account))) {
+        const own = yield* sql`select 1 from hosted_app_account_links
+          where app = ${link.app} and requirement = ${link.requirement} and account = ${account}
+            and subject is null and linked_by = ${departure.user}`;
+        if (own.length === 1) continue;
+      }
+      const user = yield* CurrentUserId;
+      const members = yield* sql`select m.id from member m
+        join hosted_account_access p on p.organization_id = m."organizationId" and p.account_id = ${account}
+        join hosted_app_access a on a.organization_id = m."organizationId" and a.id = ${link.app}
+        where m."userId" = ${user ?? ""} and (m.role in ('owner', 'admin') or a.creator_id = m."userId"
+          or exists (select 1 from hosted_app_account_links l where l.app = ${link.app}
+            and l.requirement = ${link.requirement} and l.account = ${account}
+            and l.subject is null and l.linked_by = m."userId")) for share of m`;
+      if (members.length !== 1) return yield* new OrganizationForbidden();
+    }
+  }).pipe(
+    Effect.catchTags({
+      SqlError: () => new StorageError(),
+      SchemaError: () => new StorageError(),
+    }),
+  );
+
+/** Only the host's committed departure job supplies this, never a request or authored app. */
+export const ContributedDeparture = Context.Reference<
+  { readonly organization: OrganizationId; readonly user: string } | undefined
+>("hosted/ContributedDeparture", { defaultValue: () => undefined });
+
+/** The unlink route retains its checked link while retirement deletes the acquired reference. */
+export const ContributedUnlink = Context.Reference<
+  | {
+      readonly app: AppId;
+      readonly requirement: string;
+      readonly account: AccountId;
+      readonly linkedBy: string;
+    }
+  | undefined
+>("hosted/ContributedUnlink", { defaultValue: () => undefined });
+
+export const contributedUnlinkAllowed = (sql: SqlClient.SqlClient, account: AccountId) =>
+  Effect.gen(function* () {
+    const link = yield* ContributedUnlink;
+    if (
+      link === undefined ||
+      link.account !== account ||
+      !(yield* isContributed(sql, link.app, link.requirement))
+    )
+      return false;
+    const user = yield* CurrentUserId;
+    const rows = yield* sql`select m.id from member m
+      join hosted_app_access a on a.organization_id = m."organizationId" and a.id = ${link.app}
+      join hosted_account_access p on p.organization_id = m."organizationId" and p.account_id = ${account}
+      where m."userId" = ${user ?? ""}
+        and (m.role in ('owner','admin') or a.creator_id = m."userId" or ${link.linkedBy} = m."userId")
+      for share of m`;
+    return rows.length === 1;
+  }).pipe(Effect.catchTag("SqlError", () => new StorageError()));
+
+/** The retirement machinery may clean up the departed member's personal account only. */
+export const departingPersonalAccount = (sql: SqlClient.SqlClient, account: AccountId) =>
