new file mode 100644
index 0000000..28d54e1
--- /dev/null
+++ b/apps/hosted/server/src/implementation/contributed-departure-queue.ts
@@ -0,0 +1,72 @@
+/** Independent durable cleanup, recovered by Cloud's cron and self-host's queue worker. */
+import { StorageError } from "@executor-js/sdk/core";
+import { Effect, Exit, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import { OrganizationId } from "../contracts/organization.ts";
+import { retireContributedDeparture } from "./contributed-account-departure.ts";
+
+const Departure = Schema.Struct({
+  id: Schema.String,
+  organization_id: OrganizationId,
+  user_id: Schema.String,
+  attempts: Schema.Number,
+});
+
+/** Claim once; killed runners expire, and failed hooks retain their immutable link snapshots. */
+export const runContributedDeparture = (id: string) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const [job] = yield* sql`update hosted_contributed_departure_jobs
+      set status = 'running', attempts = attempts + 1, updated_at = now()
+      where id = ${id} and (status = 'queued' or
+        (status = 'running' and updated_at < now() - interval '10 minutes'))
+      returning id, organization_id, user_id, attempts`.pipe(
+      Effect.flatMap(Schema.decodeUnknownEffect(Schema.Array(Departure))),
+    );
+    if (job === undefined) return;
+    yield* retireContributedDeparture({
+      id: job.id,
+      organization: job.organization_id,
+      user: job.user_id,
+    }).pipe(
+      Effect.andThen(sql`update hosted_contributed_departure_jobs
+        set status = 'succeeded', updated_at = now()
+        where id = ${id} and status = 'running' and attempts = ${job.attempts}`),
+      Effect.onExit((exit) =>
+        Exit.isSuccess(exit)
+          ? Effect.void
+          : sql`update hosted_contributed_departure_jobs
+              set status = case when attempts >= 8 then 'failed' else 'queued' end,
+                available_at = now() + least(300, power(2, attempts)) * interval '1 second',
+                updated_at = now()
+              where id = ${id} and status = 'running' and attempts = ${job.attempts}`.pipe(
+              Effect.ignore,
+            ),
+      ),
+    );
+  }).pipe(
+    Effect.mapError(() => new StorageError()),
+    Effect.asVoid,
+  );
+
+/** Read a bounded batch. Atomic claims let overlapping cron/process wakes share the queue. */
+export const drainContributedDepartures = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  const jobs = yield* sql`select id from hosted_contributed_departure_jobs
+    where (status = 'queued' and available_at <= now())
+      or (status = 'running' and updated_at < now() - interval '10 minutes')
+    order by available_at limit 20`.pipe(
+    Effect.flatMap(Schema.decodeUnknownEffect(Schema.Array(Schema.Struct({ id: Schema.String })))),
+  );
+  yield* Effect.forEach(
+    jobs,
+    (job) =>
+      runContributedDeparture(job.id).pipe(
+        Effect.timeout("5 minutes"),
+        Effect.catch(() =>
+          Effect.logWarning("Contributed departure attempt failed", { job: job.id }),
+        ),
+      ),
+    { concurrency: 2, discard: true },
+  );
+}).pipe(Effect.mapError(() => new StorageError()));
