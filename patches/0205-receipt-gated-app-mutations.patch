+import { Context, Effect } from "effect";
+import type { AppCallWorkflowIdentity, AppProtectedDispatch } from "../contracts/app-calls.ts";
+import type { AppCallEffectIdentity, makeAppCallEffect } from "./app-call-effects.ts";
+
+export const AppCallWorkflow = Context.Reference<AppCallWorkflowIdentity | undefined>(
+  "executor/AppCallWorkflow",
+  { defaultValue: () => undefined },
+);
+export const AppCallEffectScope = Context.Reference<AppCallEffectIdentity | undefined>(
+  "executor/AppCallEffectScope",
+  { defaultValue: () => undefined },
+);
+export const AppCallProtection = Context.Reference<
+  | (Omit<AppProtectedDispatch, "decodedInput" | "appPolicy"> & {
+      readonly effect?: ReturnType<typeof makeAppCallEffect>;
+    })
+  | undefined
+>("executor/AppCallProtection", { defaultValue: () => undefined });
+
+/** Product policy reads are independent invocations, not continuations of the target effect. */
+export const withoutAppCallContext = <A, E, R>(effect: Effect.Effect<A, E, R>) =>
+  effect.pipe(
+    Effect.provideService(AppCallProtection, undefined),
+    Effect.provideService(AppCallEffectScope, undefined),
+    Effect.provideService(AppCallWorkflow, undefined),
+  );
