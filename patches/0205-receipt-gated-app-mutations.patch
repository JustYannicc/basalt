+import { expect, layer } from "@effect/vitest";
+import { Effect, Fiber, Schema } from "effect";
+import { appCallDelivery } from "../support/app-call-delivery.ts";
+import { appCallSdkHost } from "../support/app-call-sdk.ts";
+import { appCallEffectsSdkSource } from "../support/app-call-effects-sdk-source.ts";
+import { TestLive, withCase } from "../support/case.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(TestLive, { excludeTestServices: true })("Receipt-gated app effects", (it) => {
+  it.effect(scenarios.appCallEffects.title, (context) =>
+    withCase(
+      context,
+      Effect.gen(function* () {
+        const delivery = yield* appCallDelivery;
+        const sdk = yield* appCallSdkHost(
+          appCallEffectsSdkSource.replace("DELIVERY_ORIGIN", JSON.stringify(delivery.origin)),
+          "app-call-effects-sdk",
+        );
+        yield* Effect.addFinalizer(() => delivery.releaseAll);
+        const setup = yield* sdk.request("setup", null);
+        expect(setup.status, JSON.stringify(setup.body)).toBe(200);
+        const ids = yield* Schema.decodeUnknownEffect(
+          Schema.Struct({
+            source: Schema.String,
+            slug: Schema.String,
+            target: Schema.String,
+            account: Schema.String,
+            revision: Schema.Int,
+          }),
+        )(setup.body);
+        const configure = Effect.gen(function* () {
+          const pending = yield* sdk.request("configure", {
+            app: ids.source,
+            scope: JSON.stringify([
+              {
+                workflow: "notify",
+                step: "send",
+                connection: "mail",
+                target: ids.target,
+                tool: "send",
+                account: ids.account,
+                to: ["owner@example.test"],
+                cc: [],
+                bcc: [],
+              },
+            ]),
+          });
+          expect(pending.status, JSON.stringify(pending.body)).toBe(200);
+          const approval = yield* Schema.decodeUnknownEffect(
+            Schema.Struct({
+              status: Schema.Literal("approval-required"),
+              requestId: Schema.String,
+            }),
+          )(pending.body);
+          const accepted = yield* sdk.request("resume", {
+            requestId: approval.requestId,
+            response: { action: "accept" },
+          });
+          expect(accepted.status, JSON.stringify(accepted.body)).toBe(200);
+        });
+        yield* configure;
+        const payload = (subject: string, to = "owner@example.test") => ({
+          account: ids.account,
+          to: [to],
+          cc: [],
+          bcc: [],
+          subject,
+          body: "Synthetic delivery",
+        });
+        const start = (subject: string, park: boolean) =>
+          sdk.request("start", {
+            app: ids.source,
+            target: ids.target,
+            payload: payload(subject),
+            park,
+          });
+        // A real native workflow crosses the private workerd callback and the normal target tool host.
+        expect((yield* start("native", false)).status).toBe(200);
+        expect(yield* delivery.finished("native")).toEqual({
+          sent: true,
+          subject: "native",
+          sequence: 1,
+        });
+        expect(yield* delivery.count("native")).toBe(1);
+        expect((yield* sdk.request("configuration-reads", null)).body).toBeGreaterThanOrEqual(2);
+        // Unsupported entry points must refuse before dispatch, even when the response is lost.
+        for (const entry of ["sdk", "http", "mcp"] as const) {
+          const subject = `entry-${entry}`;
+          const input = {
+            entry,
+            app: ids.source,
+            slug: ids.slug,
+            target: ids.target,
+            payload: payload(subject),
+            key: subject,
+          };
+          const lost = yield* sdk.request("lost-entry", input).pipe(Effect.exit, Effect.forkChild);
+          yield* sdk.request("entry-settled", subject);
+          expect(yield* delivery.count(subject)).toBe(0);
+          yield* sdk.restart;
+          yield* Fiber.join(lost);
+          const retry = yield* sdk.request("entry", input);
+          expect(JSON.stringify(retry.body)).toContain("effects_unavailable");
+          expect(yield* delivery.count(subject)).toBe(0);
+        }
+        expect(yield* delivery.count("native")).toBe(1);
+        const started = yield* start("parked", true);
+        const run = yield* Schema.decodeUnknownEffect(Schema.Struct({ id: Schema.String }))(
+          started.body,
+        );
+        const call = (stepId: string, subject: string, to = "owner@example.test") =>
+          sdk.request("call", {
+            run: run.id,
+            step: "send",
+            stepId,
+            call: 0,
+            command: {
+              operation: "app-call",
+              connection: "mail",
+              target: ids.target,
+              tool: "send",
+              kind: "mutation",
+              input: payload(subject, to),
+            },
+          });
+        const completed = yield* call("completed", "completed");
+        expect(completed).toEqual({
+          status: 200,
+          body: { sent: true, subject: "completed", sequence: 1 },
+        });
+        expect((yield* call("completed", "changed")).body).toEqual({ reason: "identity_conflict" });
+        expect(yield* delivery.count("changed")).toBe(0);
+        for (const [stepId, subject, to] of [
+          ["ask", "ask", "someone-else@example.test"],
+          ["native-deny", "native-deny", "owner@example.test"],
+        ]) {
+          expect((yield* call(stepId!, subject!, to!)).body).toEqual({ reason: "denied" });
+          expect(yield* delivery.count(subject!)).toBe(0);
+        }
+        const query = yield* sdk.request("query", {
+          app: ids.source,
+          target: ids.target,
+          payload: payload("read-only"),
+        });
+        expect(query.status).toBe(409);
+        expect(query.body).toMatchObject({
+          failure: { errorName: "AppCallFailed", code: "effects_unavailable" },
+        });
+        expect(yield* delivery.count("read-only")).toBe(0);
+        // Rebinding the same saved account changes its authority and invalidates the old confirmation.
+        expect(
+          (yield* sdk.request("rebind", {
+            app: ids.source,
+            target: ids.target,
+            account: ids.account,
+            revision: ids.revision,
+          })).status,
+        ).toBe(200);
+        expect((yield* call("stale", "stale")).body).toEqual({ reason: "denied" });
+        expect(yield* delivery.count("stale")).toBe(0);
+        yield* configure;
+        yield* delivery.hold("concurrent");
+        const first = yield* call("concurrent", "concurrent").pipe(Effect.forkChild);
+        yield* delivery.arrived("concurrent");
+        const contender = yield* Effect.raceFirst(
+          call("concurrent", "concurrent").pipe(
+            Effect.map((reply) => ({ status: "reply" as const, reply })),
+          ),
+          delivery.duplicate("concurrent").pipe(Effect.as({ status: "duplicate" as const })),
+        );
+        expect(contender.status).toBe("reply");
+        if (contender.status !== "reply")
+          return yield* Effect.die("A concurrent call delivered twice");
+        expect(contender.reply.body).toEqual({ reason: "in_progress" });
+        expect(yield* delivery.count("concurrent")).toBe(1);
+        yield* delivery.release("concurrent");
+        expect((yield* Fiber.join(first)).body).toEqual({
+          sent: true,
+          subject: "concurrent",
+          sequence: 1,
+        });
+        yield* sdk.restart;
+        expect((yield* call("concurrent", "concurrent")).body).toEqual({
+          sent: true,
+          subject: "concurrent",
+          sequence: 1,
+        });
+        expect(yield* delivery.count("concurrent")).toBe(1);
+        // A stopped host cannot infer whether an external delivery finished. Reopening never resends it.
+        yield* delivery.hold("interrupted");
+        const interrupted = yield* call("interrupted", "interrupted").pipe(
+          Effect.exit,
+          Effect.forkChild,
+        );
+        yield* delivery.arrived("interrupted");
+        yield* sdk.restart;
+        yield* sdk.request("advance", 600_000);
+        yield* delivery.release("interrupted");
+        yield* Fiber.join(interrupted);
+        expect((yield* call("interrupted", "interrupted")).body).toEqual({
+          reason: "outcome_unknown",
+        });
+        expect(yield* delivery.count("interrupted")).toBe(1);
+      }),
+    ),
+  );
+});
