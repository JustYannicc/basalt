+++ b/e2e/support/app-call-delivery.ts
@@ -0,0 +1,101 @@
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Deferred, Effect, Layer, Schema } from "effect";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { createServer } from "node:http";
+
+/** An external delivery boundary survives the SDK process stopping or replaying a step. */
+export const appCallDelivery = Effect.gen(function* () {
+  const makeSlot = Effect.gen(function* () {
+    return {
+      arrived: yield* Deferred.make<void>(),
+      duplicate: yield* Deferred.make<void>(),
+      released: yield* Deferred.make<void>(),
+      finished: yield* Deferred.make<Schema.Json>(),
+      held: false,
+      count: 0,
+    };
+  });
+  const slots = new Map<string, Effect.Success<typeof makeSlot>>();
+  const slot = (subject: string) =>
+    Effect.gen(function* () {
+      const existing = slots.get(subject);
+      if (existing !== undefined) return existing;
+      const value = yield* makeSlot;
+      slots.set(subject, value);
+      return value;
+    });
+  const routes = Layer.mergeAll(
+    HttpRouter.add(
+      "POST",
+      "/send",
+      Effect.gen(function* () {
+        const request = yield* HttpServerRequest.HttpServerRequest;
+        const input = yield* request.json.pipe(
+          Effect.flatMap(Schema.decodeUnknownEffect(Schema.Struct({ subject: Schema.String }))),
+        );
+        const value = yield* slot(input.subject);
+        value.count++;
+        if (value.count > 1) yield* Deferred.succeed(value.duplicate, undefined);
+        yield* Deferred.succeed(value.arrived, undefined);
+        if (value.held) yield* Deferred.await(value.released);
+        return yield* HttpServerResponse.json({
+          sent: true,
+          subject: input.subject,
+          sequence: value.count,
+        });
+      }).pipe(Effect.orDie),
+    ),
+    HttpRouter.add(
+      "POST",
+      "/finished",
+      Effect.gen(function* () {
+        const request = yield* HttpServerRequest.HttpServerRequest;
+        const input = yield* request.json.pipe(
+          Effect.flatMap(
+            Schema.decodeUnknownEffect(
+              Schema.Struct({ subject: Schema.String, value: Schema.Json }),
+            ),
+          ),
+        );
+        const value = yield* slot(input.subject);
+        yield* Deferred.succeed(value.finished, input.value);
+        return yield* HttpServerResponse.json(null);
+      }).pipe(Effect.orDie),
+    ),
+  );
+  const services = yield* Layer.build(
+    HttpRouter.serve(routes, { disableLogger: true, disableListenLog: true }).pipe(
+      Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 })),
+    ),
+  );
+  const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+  if (!("port" in server.address)) return yield* Effect.die("Expected TCP delivery fixture");
+  const releaseAll = Effect.suspend(() =>
+    Effect.forEach(slots.values(), (value) => Deferred.succeed(value.released, undefined)).pipe(
+      Effect.asVoid,
+    ),
+  );
+  yield* Effect.addFinalizer(() => releaseAll);
+  return {
+    origin: `http://127.0.0.1:${server.address.port}`,
+    hold: (subject: string) =>
+      slot(subject).pipe(
+        Effect.tap((value) =>
+          Effect.sync(() => {
+            value.held = true;
+          }),
+        ),
+        Effect.asVoid,
+      ),
+    duplicate: (subject: string) =>
+      slot(subject).pipe(Effect.flatMap((value) => Deferred.await(value.duplicate))),
+    arrived: (subject: string) =>
+      slot(subject).pipe(Effect.flatMap((value) => Deferred.await(value.arrived))),
+    finished: (subject: string) =>
+      slot(subject).pipe(Effect.flatMap((value) => Deferred.await(value.finished))),
+    release: (subject: string) =>
+      slot(subject).pipe(Effect.flatMap((value) => Deferred.succeed(value.released, undefined))),
+    count: (subject: string) => slot(subject).pipe(Effect.map((value) => value.count)),
+    releaseAll,
+  };
+});
