+import {StreamableHTTPClientTransport} from "@modelcontextprotocol/sdk/client/streamableHttp.js";
+import { pgliteLayer } from "fumadb-effect/pglite";
+import { createServer } from "node:http";
+const input = INPUT;
+const deliveryOrigin = DELIVERY_ORIGIN;
+Runtime.runMain(Effect.scoped(Effect.gen(function* () {
+  const path = yield* Path.Path;
+  const fs = yield* FileSystem.FileSystem;
+  const clockFile = path.join(input.directory,"clock");
+  const liveClock = yield* Clock.Clock;
+  const initialNow = yield* Clock.currentTimeMillis;
+  let now = Number(yield* fs.readFileString(clockFile).pipe(Effect.catch(()=>Effect.succeed(String(initialNow)))));
+  const clock:Clock.Clock = {...liveClock,currentTimeMillisUnsafe:()=>now,currentTimeMillis:Effect.sync(()=>now),currentTimeNanosUnsafe:()=>BigInt(now)*1000000n,currentTimeNanos:Effect.sync(()=>BigInt(now)*1000000n)};
+  const database = yield* Layer.build(pgliteLayer({dataDir:path.join(input.directory,"postgres")}));
+  const storage = yield* makeExecutorStorage({provider:"postgresql"}).pipe(Effect.provideContext(database));
+  yield* storage.migrate;
+  const secret = Redacted.make("d".repeat(64));
+  const blobs = filesystemBlobStore({directory:path.join(input.directory,"blobs")});
+  const ready = yield* Deferred.make<Executor>();
+  const runtime = yield* workerdApps({directory:path.join(input.directory,"workerd"),blobs,
+    executor:Deferred.await(ready),npmRegistry:input.npmRegistry,encryptionKey:secret,allowPrivateAppFetch:true});
+  const owner = OwnerId.make("effects-owner");
+  let configurationReads = 0;
+  const Settings = Schema.Struct({revision:Schema.NonEmptyString,deliveryEnabled:Schema.Boolean,current:Schema.Boolean});
+  const hooks = workflowApprovalHooks({
+    configuration: event => Effect.gen(function* () {
+      const sdk = yield* Deferred.await(ready);
+      const source = "source" in event ? event.source : event;
+      const result = yield* sdk.tools.call({app:source.app,version:source.version,tool:ToolName.make("settings"),kind:"query",input:{}});
+      if(result.status !== "completed" || result.toolError === true || !Schema.is(Settings)(result.value) || !result.value.current) return undefined;
+      configurationReads++;
+      return {revision:result.value.revision,enabled:result.value.deliveryEnabled};
+    }).pipe(Effect.mapError(()=>new StorageError())),
+    personalEmailAccount: value => Effect.gen(function* () {
+      const sdk = yield* Deferred.await(ready);
+      const target = yield* sdk.apps.source({app:AppId.make(value.target)});
+      return {owner:"effects-owner",recipient:"owner@example.test",targetVersion:target.id,inspectedCompose:true};
+    }).pipe(Effect.mapError(()=>new StorageError())),
+  });
+  const executor = yield* createExecutor({database:storage,secret,blobs,appCalls:hooks,
+    git:nativeRepositories(path.join(input.directory,"repositories")),runtime:runtime.runtime,
+    workflows:runtime.workflows,registry:memoryRegistry()}).pipe(Effect.provide(NodeCrypto.layer));
+  yield* Deferred.succeed(ready,executor);
+  const httpClient=yield* HttpClient.HttpClient;
+  let selfOrigin = "";
+  const completedEntries = new Map<string,Deferred.Deferred<void>>();
+  const milestone = (key:string) => Effect.gen(function* () {
+    let deferred=completedEntries.get(key);
+    if(deferred===undefined){deferred=yield* Deferred.make<void>();completedEntries.set(key,deferred);}
+    return deferred;
+  });
+  const backend = {
+    eventDefinitions:i=>executor.events.definitions(i),
+    findEventSubscription:key=>executor.events.find({...key,principal:"effects-owner"}),
+    subscribeEvent:({key,...i})=>executor.events.subscribe({...i,key:{...key,principal:"effects-owner"},subject:"effects-owner"}),
+    unsubscribeEvent:({key})=>executor.events.unsubscribe({...key,principal:"effects-owner"}),
+    listSkills:(i,o)=>executor.skills.list(i,o),readSkill:i=>executor.skills.read(i),authorizeElicitation:()=>Effect.void,
+    listApps:(i={})=>executor.apps.list({...i,owner}),
+    listAccounts:i=>executor.apps.get({app:i.app}).pipe(Effect.flatMap(app=>Object.values(app.requirements.accounts).every(requirement=>requirement.scope!=="user")?Effect.succeed({}):Effect.fail(new Error("Fixture has no user account links")))),
+    listTools:(i,o)=>executor.tools.list(i,o),searchableTools:(i,o)=>executor.tools.searchable(i,o),searchTools:i=>executor.tools.search(i),
+    callTool:(i,o)=>executor.tools.call(i,o).pipe(Effect.provideService(CurrentActor,"effects-owner")),
+    resumeInvocation:(r,response,o)=>executor.tools.resume({requestId:r.requestId,response},o),
+  } satisfies McpBackend<Error>;
+  const mcp=yield* makeMcp({backend,caller:Effect.succeed("effects-owner"),instructions:"Synthetic receipt test",limits:defaultMcpLimits,annotateSkillRead:()=>Effect.void});
+  const Entry = Schema.Struct({entry:Schema.Literals(["sdk","http","mcp"]),app:AppId,slug:Schema.String,target:AppId,payload:Schema.Json,key:Schema.String});
+  const enter=(value:typeof Entry.Type)=>Effect.gen(function* () {
+    const call={app:value.app,tool:ToolName.make("direct"),kind:"mutation" as const,input:{target:value.target,payload:value.payload}};
+    if(value.entry==="sdk") return yield* executor.tools.call(call).pipe(Effect.match({onSuccess:value=>value,onFailure:error=>Schema.is(ToolCallFailed)(error)?{failure:error.failure}:{failed:true}}));
+    if(value.entry==="http") {
+      const request=yield* HttpClientRequest.bodyJson(call)(HttpClientRequest.post(selfOrigin+"/v1/tools/call"));
+      const response=yield* httpClient.execute(request);
+      return {status:response.status,body:yield* response.json};
+    }
+    return yield* Effect.acquireUseRelease(
+      Effect.sync(()=>new Client({name:"Receipt entry test",version:"1"})),
+      client=>Effect.tryPromise(async()=>{
+        const compatible: Omit<StreamableHTTPClientTransport,"sessionId">=new StreamableHTTPClientTransport(new URL(selfOrigin+"/mcp"));
+        await client.connect(compatible);
+        const result=await client.callTool({name:"call",arguments:{calls:{path:\`tools[\${JSON.stringify(value.slug)}].direct\`,input:call.input}}});
+        return result;
+      }),
+      client=>Effect.promise(()=>client.close()),
+    );
+  });
+  const setup = Effect.gen(function* () {
+    const targetSource = 'import {defineApp,defineProvider,secrets,mutation,object,string,array,router} from "apps"; const mail=defineProvider({name:"Synthetic receipt mail",auth:{key:secrets({label:"Key",fields:object({token:string()})})}}); const send=mutation({input:object({account:string(),to:array(string()),cc:array(string()),bcc:array(string()),subject:string(),body:string()}),approval:({toolInput})=>toolInput.subject==="native-deny"?"denied":"user-approval"},async(ctx,value)=>{const response=await ctx.fetch('+JSON.stringify(deliveryOrigin+"/send")+', {method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(value)});return await response.json();}); const open=mutation({input:object({account:string(),to:array(string()),cc:array(string()),bcc:array(string()),subject:string(),body:string()})},async(ctx,value)=>{const response=await ctx.fetch('+JSON.stringify(deliveryOrigin+"/send")+',{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(value)});return await response.json();});export default defineApp({app:{accounts:{mail}}},{tools:router({send,open})});';
+    const target = (yield* executor.apps.deploy({owner,name:"Synthetic receipt mail",files:[{path:"index.ts",content:targetSource},input.files[1]]})).app;
+    const provider = target.requirements.accounts.mail;
+    if (provider === undefined) return yield* Effect.die("Missing synthetic mail provider");
+    const account = yield* executor.managedAccounts.add({owner,provider:provider.provider,method:"key",fields:Redacted.make({token:"synthetic"})});
+    const sourceText = 'import {defineApp,query,mutation,workflow,object,boolean,string,array,router} from "apps"; const message=object({account:string(),to:array(string()),cc:array(string()),bcc:array(string()),subject:string(),body:string()}); const settings=query({input:object({})},async()=>({revision:"owner-r1",deliveryEnabled:true,current:true}));const direct=mutation({input:object({target:string(),payload:message})},async(ctx,input)=>ctx.apps.call({connection:"mail",target:input.target,tool:"open",kind:"mutation",input:input.payload})); const configure=mutation({input:object({deliveryEnabled:boolean(),deliveryScope:string()}),approval:()=>"user-approval"},async(_ctx,input)=>({revision:"owner-r1",...input})); const invoke=query({input:object({target:string(),payload:message})},async(ctx,input)=>ctx.apps.call({connection:"mail",target:input.target,tool:"send",kind:"mutation",input:input.payload})); const notify=workflow({input:object({target:string(),payload:message,park:boolean()})},async(ctx,input)=>{if(input.park){await ctx.step.sleep("park","1 day");return null;}const value=await ctx.step.do("send",{retries:{limit:0,delay:0}},step=>step.apps.call({connection:"mail",target:input.target,tool:"send",kind:"mutation",input:input.payload}));await ctx.step.do("observed",async step=>{const response=await step.fetch('+JSON.stringify(deliveryOrigin+"/finished")+',{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({subject:input.payload.subject,value})});return await response.json();});return value;}); export default defineApp({dependencies:{mail:{scope:"user",configuration:{tool:"configure",policy:{envelope:"self-email",workflow:"notify",step:"send"}},tools:{send:{kind:"mutation"},open:{kind:"mutation"}}}}},{tools:router({configure,invoke,settings,direct}),workflows:{notify}});';
+    const source = (yield* executor.apps.deploy({owner,name:"Receipt workflow caller",files:[{path:"index.ts",content:sourceText},input.files[1]]})).app;
+    const connection = yield* executor.appConnections.save({app:source.id,owner,dependency:"mail",scope:"user",target:target.id,revision:0,accounts:{app:{mail:[account.id]}}});
+    return {source:source.id,slug:source.slug,target:target.id,account:account.id,connection:connection.id,revision:connection.revision};
+  });
+  const Call = Schema.Struct({run:WorkflowRunId,step:Schema.String,stepId:Schema.String,call:Schema.Int,command:AppCallCommand});
+  const route = <A,I,B,E>(name:string,schema:Schema.Codec<A,I>,run:(value:A)=>Effect.Effect<B,E>) =>
+    HttpRouter.add("POST",\`/_fixture/\${name}\`,Effect.gen(function* () {
+      const req = yield* HttpServerRequest.HttpServerRequest;
+      const value = yield* req.json.pipe(Effect.flatMap(Schema.decodeUnknownEffect(schema)));
+      return yield* run(value).pipe(Effect.provideService(CurrentActor,"effects-owner"),Effect.provideService(Clock.Clock,clock),Effect.flatMap(value=>HttpServerResponse.json(value)),Effect.catch(error=>HttpServerResponse.json(Schema.is(AppCallFailed)(error)?{reason:error.reason}:Schema.is(ToolCallFailed)(error)?{failure:error.failure}:{failed:true},{status:409})));
+    }).pipe(Effect.orDie));
+  const routes = Layer.mergeAll(
+    HttpApiBuilder.layer(ExecutorApi).pipe(Layer.provide(executorHandlers(executor))),
+    HttpRouter.add("*","/mcp",mcp.http),
+    route("entry",Entry,enter),
+    // The client loses the response after the real entry has settled, then restarts the host.
+    route("lost-entry",Entry,value=>enter(value).pipe(Effect.exit,Effect.andThen(milestone(value.key)),Effect.flatMap(d=>Deferred.succeed(d,undefined)),Effect.andThen(Effect.never))),
+    route("entry-settled",Schema.String,key=>milestone(key).pipe(Effect.flatMap(Deferred.await),Effect.as(null))),
+    route("setup",Schema.Null,()=>setup),
+    route("configuration-reads",Schema.Null,()=>Effect.succeed(configurationReads)),
+    route("advance",Schema.Number,millis=>Effect.gen(function* () {now+=millis;yield* fs.writeFileString(clockFile,String(now));return now;})),
+    route("configure",Schema.Struct({app:AppId,scope:Schema.String}),value=>executor.tools.call({app:value.app,tool:ToolName.make("configure"),kind:"mutation",input:{deliveryEnabled:true,deliveryScope:value.scope}})),
+    route("resume",ToolInputs.resume,value=>executor.tools.resume(value)),
+    route("start",Schema.Struct({app:AppId,target:AppId,payload:Schema.Json,park:Schema.Boolean}),value=>executor.apps.workflowRuns.start({app:value.app,workflow:"notify",input:{target:value.target,payload:value.payload,park:value.park}})),
+    // This is the same public host callback used by the native workflow transport. Only the host supplies step identity.
+    route("call",Call,value=>Effect.gen(function* () {const context=yield* executor[WorkflowHost].context(value.run,{step:value.step,stepId:value.stepId,call:value.call});const call=context.workflowControls?.appCall;if(call===undefined)return yield* new AppCallFailed({reason:"denied",retryable:false});return yield* call(value.command);})),
+    route("query",Schema.Struct({app:AppId,target:AppId,payload:Schema.Json}),value=>executor.tools.call({app:value.app,tool:ToolName.make("invoke"),kind:"query",input:{target:value.target,payload:value.payload}})),
+    route("rebind",Schema.Struct({app:AppId,target:AppId,account:AccountId,revision:Schema.Int}),value=>executor.appConnections.save({app:value.app,owner,dependency:"mail",scope:"user",target:value.target,revision:value.revision,accounts:{app:{mail:[value.account]}}})),
+  );
+  const services = yield* Layer.build(HttpRouter.serve(Layer.merge(routes,HttpRouter.middleware(effect=>effect.pipe(Effect.provideService(CurrentActor,"effects-owner")),{global:true})),{disableLogger:true,disableListenLog:true}).pipe(Layer.provideMerge(NodeHttpServer.layer(createServer,{host:"127.0.0.1",port:0}))));
+  const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+  if (!("port" in server.address)) return yield* Effect.die("Expected TCP");
+  selfOrigin=\`http://127.0.0.1:\${server.address.port}\`;
+  yield* Console.log(JSON.stringify({port:server.address.port}));
+  return yield* Effect.never;
+})).pipe(Effect.provide(Layer.mergeAll(NodeServices.layer,FetchHttpClient.layer))));
+`;
