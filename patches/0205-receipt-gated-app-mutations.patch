new file mode 100644
index 0000000..6da4818
--- /dev/null
+++ b/packages/sdk/src/implementation/app-call-effects.ts
@@ -0,0 +1,113 @@
+import { Hex } from "effect/encoding";
+import { Clock, type Crypto, Effect, Exit } from "effect";
+import { AppCallFailed } from "apps/contracts";
+import { AppCallReceiptId, type AppCallsHost } from "../contracts/app-calls.ts";
+import type { AppId, Json, OwnerId } from "../contracts/shared.ts";
+
+/** Assigned by the invocation host. Replayed steps start their ordinal at zero again. */
+export interface AppCallEffectIdentity {
+  readonly invocation: string;
+  readonly call: number;
+}
+
+const canonical = (value: Json): Json =>
+  Array.isArray(value)
+    ? value.map(canonical)
+    : value !== null && typeof value === "object"
+      ? Object.fromEntries(
+          Object.entries(value)
+            .sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0))
+            .map(([key, item]) => [key, canonical(item)]),
+        )
+      : value;
+
+/** One normal tool invocation shares its durable fence with its postdecode callback. */
+export const makeAppCallEffect = (
+  receipts: AppCallsHost["receipts"],
+  crypto: Crypto.Crypto,
+  identity: AppCallEffectIdentity,
+  input: { readonly app: AppId; readonly owner: OwnerId; readonly connection: string },
+) => {
+  const digest = (value: Json) =>
+    crypto.digest("SHA-256", new TextEncoder().encode(JSON.stringify(canonical(value)))).pipe(
+      Effect.map(Hex.encode),
+      Effect.mapError(() => new AppCallFailed({ reason: "outcome_unknown", retryable: false })),
+    );
+  let closed = false;
+  let entered = false;
+  let reservation: { readonly id: AppCallReceiptId; readonly dispatch: string } | undefined;
+  let refusal: AppCallFailed | undefined;
+  let replay: { readonly value: Json } | undefined;
+  const unknown = () => new AppCallFailed({ reason: "outcome_unknown", retryable: false });
+  const finish = (result?: Json) =>
+    Effect.suspend(() => {
+      if (reservation === undefined) return Effect.succeed({ status: "outcome_unknown" as const });
+      return receipts.finish({
+        ...input,
+        ...reservation,
+        ...(result === undefined ? {} : { result }),
+      });
+    });
+  const enter = (evidence: Json) =>
+    Effect.uninterruptible(
+      Effect.gen(function* () {
+        if (closed || entered) return yield* unknown();
+        entered = true;
+        const id = AppCallReceiptId.make(
+          `acr_${yield* digest([input.owner, input.app, identity.invocation, identity.call])}`,
+        );
+        const reserved = yield* receipts.reserve({
+          ...input,
+          id,
+          fingerprint: yield* digest(evidence),
+          deadline: (yield* Clock.currentTimeMillis) + 300_000,
+        });
+        if (reserved.status === "reserved") {
+          reservation = { id, dispatch: reserved.dispatch };
+          if (closed) {
+            yield* finish();
+            return yield* unknown();
+          }
+          return {};
+        }
+        if (reserved.status === "completed") {
+          replay = { value: reserved.value };
+          return { replay: reserved.value };
+        }
+        return yield* new AppCallFailed({ reason: reserved.status, retryable: false });
+      }).pipe(
+        Effect.mapError((error) => (error._tag === "AppCallFailed" ? error : unknown())),
+        Effect.tapError((error) =>
+          Effect.sync(() => {
+            refusal = error;
+          }),
+        ),
+      ),
+    );
+  const run = <E, R>(call: Effect.Effect<Json, E, R>) =>
+    Effect.uninterruptibleMask((restore) =>
+      Effect.gen(function* () {
+        const result = yield* restore(call).pipe(Effect.exit);
+        closed = true;
+        if (refusal !== undefined) return yield* refusal;
+        if (replay !== undefined) return replay.value;
+        if (reservation === undefined)
+          return Exit.isFailure(result)
