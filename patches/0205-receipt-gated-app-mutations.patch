+import { Hex } from "effect/encoding";
+import { Effect, Schema, type Crypto } from "effect";
+import { AppCallFailed, AppDependency, type AppToolPolicyHost } from "apps/contracts";
+import { Json } from "../contracts/shared.ts";
+import type { AppCallHooks, AppProtectedDispatch } from "../contracts/app-calls.ts";
+import type { ResourceLifecycle } from "../contracts/executor.ts";
+import { storedApp, storedVersion } from "./apps.ts";
+import { appCallAccountVersions } from "./app-call-accounts.ts";
+import type { Query } from "./database.ts";
+import type { makeAppConnections } from "./app-connections.ts";
+import { AppCallProtection, withoutAppCallContext } from "./app-call-context.ts";
+export const sameAppCallAuthority = (left: unknown, right: unknown): boolean => {
+  if (left === right) return true;
+  if (left === null || right === null || typeof left !== "object" || typeof right !== "object")
+    return false;
+  if (Array.isArray(left) || Array.isArray(right))
+    return (
+      Array.isArray(left) &&
+      Array.isArray(right) &&
+      left.length === right.length &&
+      left.every((value, index) => sameAppCallAuthority(value, right[index]))
+    );
+  const a = Object.entries(left),
+    b = Object.entries(right);
+  return (
+    a.length === b.length &&
+    a.every(
+      ([key, value]) =>
+        Object.hasOwn(right, key) && sameAppCallAuthority(value, Reflect.get(right, key)),
+    )
+  );
+};
+export const makeAppCallProtection = (options: {
+  readonly db: Query;
+  readonly connections: ReturnType<typeof makeAppConnections>;
+  readonly crypto: Crypto.Crypto;
+  readonly hooks?: ResourceLifecycle;
+  readonly policy?: AppCallHooks;
+}) => {
+  return (identity: { readonly app: string; readonly build: string }): AppToolPolicyHost =>
+    (command) =>
+      Effect.gen(function* () {
+        if (command.decision === "denied" || command.decision === "failed")
+          return { decision: command.decision };
+        const protectedCall = yield* AppCallProtection;
+        if (protectedCall === undefined) return { decision: command.decision };
+        const { source, target, connection } = protectedCall;
+        if (
+          identity.app !== target.app ||
+          identity.build !== target.build ||
+          command.tool !== target.tool ||
+          command.kind !== target.kind
+        )
+          return yield* new AppCallFailed({ reason: "denied", retryable: false });
+        const readAuthority = Effect.gen(function* () {
+          const sourceApp = yield* storedApp(options.db, { app: source.app });
+          const sourceVersion = yield* storedVersion(options.db, sourceApp);
+          const targetApp = yield* storedApp(options.db, {
+            app: target.app,
+            owner: sourceApp.owner,
+          });
+          const targetVersion = yield* storedVersion(options.db, targetApp);
+          const current = yield* options.connections.find(
+            source.app,
+            connection.dependency,
+            connection.scope === "app" ? "" : (source.caller ?? "local"),
+          );
+          if (
+            sourceVersion.id !== source.version ||
+            targetVersion.id !== target.version ||
+            current === null ||
+            current.id !== connection.id ||
+            current.revision !== connection.revision ||
+            !current.enabled ||
+            current.target !== target.app
+          )
+            return yield* new AppCallFailed({ reason: "stale", retryable: false });
+          const accepted = yield* options.connections.payload(current);
+          if (
+            !sameAppCallAuthority(accepted.accounts, target.accounts) ||
+            !Schema.toEquivalence(AppDependency)(accepted.declaration, protectedCall.declaration)
+          )
+            return yield* new AppCallFailed({ reason: "stale", retryable: false });
+          const accountVersions = yield* appCallAccountVersions(
+            options.db,
+            target.app,
+            accepted.accounts,
+          );
+          if (!sameAppCallAuthority(accountVersions, target.accountVersions))
+            return yield* new AppCallFailed({ reason: "stale", retryable: false });
+          return { sourceApp, current, accepted, accountVersions };
+        });
+        const { sourceApp, current, accepted, accountVersions } = yield* readAuthority;
+        const confirmation = accepted.confirmation;
+        const valid =
+          confirmation !== undefined &&
+          confirmation.sourceVersion === source.version &&
+          confirmation.targetVersion === target.version &&
+          confirmation.connectionRevision === connection.revision &&
+          sameAppCallAuthority(confirmation.accounts, target.accounts) &&
+          sameAppCallAuthority(confirmation.accountVersions, accountVersions) &&
+          Schema.toEquivalence(AppDependency)(confirmation.declaration, accepted.declaration);
+        const { confirmation: _oldConfirmation, effect, ...currentCall } = protectedCall;
+        const event: AppProtectedDispatch = {
+          ...currentCall,
+          decodedInput: command.input,
+          appPolicy: "user-approval",
+          ...(valid ? { confirmation } : {}),
+        };
+        const check = Effect.gen(function* () {
+          const decision =
+            command.decision === "user-approval" && options.policy?.protectedDispatch !== undefined
+              ? yield* withoutAppCallContext(options.policy.protectedDispatch(event))
+              : command.decision;
+          if (decision !== "approved" || target.kind !== "mutation") return { decision };
+          if (effect === undefined)
+            return yield* new AppCallFailed({ reason: "effects_unavailable", retryable: false });
+          // Approval hooks may await product facts. Recheck what they approved before reserving.
+          const latest = yield* readAuthority;
+          if (!sameAppCallAuthority(latest.current.encrypted, current.encrypted))
+            return yield* new AppCallFailed({ reason: "stale", retryable: false });
+          const authority = Hex.encode(yield* options.crypto.digest("SHA-256", current.encrypted));
+          const evidence = yield* Schema.decodeUnknownEffect(Json)({
+            source,
+            connection: currentCall.connection,
+            target,
+            declaration: accepted.declaration,
+            confirmation: valid ? confirmation : null,
+            authority,
+            decodedInput: command.input,
+          });
+          return { decision, ...(yield* effect.enter(evidence)) };
+        });
+        if (options.hooks === undefined) return yield* check;
+        if (options.hooks.appCallAs === undefined)
+          return yield* new AppCallFailed({ reason: "denied", retryable: false });
+        return yield* options.hooks.appCallAs(
+          {
+            app: source.app,
+            owner: sourceApp.owner,
+            target: target.app,
+            scope: connection.scope,
+            authorizer: current.authorizer,
+            ...(source.caller === undefined ? {} : { caller: source.caller }),
+          },
+          check,
+        );
+      }).pipe(
+        Effect.mapError((error) =>
+          Schema.is(AppCallFailed)(error)
+            ? error
+            : new AppCallFailed({ reason: "denied", retryable: false }),
+        ),
+        Effect.tapError((error) =>
+          Effect.gen(function* () {
+            const call = yield* AppCallProtection;
+            if (call?.effect !== undefined) yield* call.effect.reject(error);
+          }),
+        ),
+      );
+};
