+    appCallReply: AppCallReply,
+    appToolPolicy: AppToolPolicyCommand,
+    appToolPolicyReply: AppToolPolicyReply,
+    modelRequest: ModelCommand,
+    modelReply: ModelReply,
+    cacheCommand: CacheCommand,
+    cacheReply: CacheReply,
+    accountCheck: AccountCheckResult,
+    accountObservation: Schema.NullOr(AccountObservationResult),
+    accounts: ResolvedAccounts,
+    migrate: MigrateResult,
+  },
+} as const satisfies {
+  readonly version: number;
+  readonly schemas: Partial<Record<MessageName, Schema.Top>>;
+};
