@@ -0,0 +1,144 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Fiber, Schema } from "effect";
+import { randomUUID } from "node:crypto";
+import { body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { appLinksFixture, keyProvider, LinkRequirement } from "../support/app-links.ts";
+import { blocked, Backends } from "../support/account-delete-contention.ts";
+import { googleDuplicateBindingFixture } from "../support/google-duplicate-binding-fixture.ts";
+import { Artifact } from "../support/production-ops-client.ts";
+import { boundary } from "../support/provider-adoption-steps.ts";
+import { Evidence } from "../support/evidence.ts";
+import { scenarios } from "../test-plan.ts";
+
+const source = `import { defineApp, defineProvider, oauth2, secrets, object, string, router } from "apps";
+const primary = ${keyProvider("Primary webhook source")};
+const secondary = defineProvider({ name: "Secondary Google", auth: { oauth: oauth2({
+  authorizationUrl: "https://accounts.google.com/o/oauth2/v2/auth",
+  tokenUrl: "https://oauth2.googleapis.com/token", scopes: ["openid","email"], tokenEndpointAuthMethod: "none"
+}) } });
+export default defineApp({ user: { accounts: { primary, secondary: secondary.many() } } }, {
+  tools: router({}), webhooks: { primaryHook: { account: { user: "primary" },
+    config: object({}), state: object({}), register: async () => ({}),
+    unregister: async () => {}, handle: async () => new Response("ok") } }
+});`;
+const Subscription = Schema.Struct({ id: Schema.String, status: Schema.String });
+const DryRun = Schema.Struct({ artifact: Artifact, backupSha256: Schema.String });
+
+layer(HostedLive, { excludeTestServices: true })("Duplicate retirement registration race", (it) => {
+  it.effect(scenarios.googleDuplicateBindingRace.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const p = yield* googleDuplicateBindingFixture;
+        const f = yield* appLinksFixture([{ path: "index.ts", content: source }]);
+        const { api, actors, path } = f;
+        const primary = yield* f.connect(actors.owner, "user", "primary", "synthetic-primary");
+        const created = yield* api.request(actors.owner, "POST", `${path}/webhooks`, {
+          name: "primaryHook",
+          sourceAccount: primary,
+          key: `race-${randomUUID()}`,
+          config: {},
+        });
+        expect(created.status, JSON.stringify(created.body)).toBe(200);
+        const hook = yield* body(Subscription, created);
+        expect(hook.status).toBe("active");
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* p.rows("delete from executor_webhook_accounts where subscription=$1", [hook.id]);
+            yield* p.rows("delete from executor_webhooks where id=$1", [hook.id]);
+          }).pipe(Effect.orDie),
+        );
+        const requirement = yield* body(
+          LinkRequirement,
+          yield* api.request(actors.owner, "GET", `${path}/accounts/user/secondary`),
+        );
+        const otherApp = path.split("/").at(-1)!;
+        for (const id of [p.remove, p.retain]) {
+          yield* p.rows("update executor_accounts set provider=$2 where id=$1", [
+            id,
+            requirement.provider,
+          ]);
+          yield* p.rows(
+            `insert into hosted_app_account_links (app,requirement,subject,account,linked_by)
+          values ($1,'secondary',$2,$3,$2)`,
+            [otherApp, p.person, id],
+          );
+        }
+        // Retry an ordinary registration with a different primary and both many() secondary choices.
+        yield* p.rows(
+          "update executor_webhooks set status='pending',lease_until=now() where id=$1",
+          [hook.id],
+        );
+        const before = yield* p.snapshot(p.retain);
+        const dryResponse = yield* p.operation("dry-run");
+        expect(dryResponse.status, JSON.stringify(dryResponse.body)).toBe(200);
+        const dry = yield* body(DryRun, dryResponse);
+        const scan = yield* boundary("duplicate-consumers", p.remove);
+        const applying = yield* p
+          .operation("apply", p.request, {
+            artifact: dry.artifact,
+            planSha256: dry.artifact.sha256,
+            backupSha256: dry.backupSha256,
+            go: `GO ${dry.artifact.sha256}`,
+          })
+          .pipe(Effect.forkChild);
+        yield* Effect.raceFirst(
+          scan.entered,
+          Fiber.join(applying).pipe(
+            Effect.flatMap((response) =>
+              Effect.die(
+                `Apply missed consumer boundary: ${response.status} ${JSON.stringify(response.body)}`,
+              ),
+            ),
+          ),
+        );
+        const applyingBackend = yield* p
+          .rows(`select pid,query from pg_stat_activity
+        where state='idle in transaction' and query ilike '%executor_workflow_accounts%executor_webhook_accounts%'`)
+          .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Backends)));
+        expect(applyingBackend).toHaveLength(1);
+        const registering = yield* api
+          .request(actors.owner, "POST", `${path}/webhooks/${hook.id}/reconcile`)
+          .pipe(Effect.forkChild);
+        const registrationWaited = yield* Effect.raceFirst(
+          blocked(p.database, [applyingBackend[0]!.pid], "%executor_accounts%").pipe(
+            Effect.as(true),
+          ),
+          Fiber.join(registering).pipe(Effect.as(false)),
+        );
+        yield* scan.release;
+        const applied = yield* Fiber.join(applying);
+        const registered = yield* Fiber.join(registering);
+        const orphans = yield* p.rows(
+          `select d.account,d.subscription from executor_webhook_accounts d
+        left join executor_accounts a on a.id=d.account
+        where d.subscription=$1 and a.id is null`,
+          [hook.id],
+        );
+        const registration = yield* p.rows(
+          "select registered_accounts from executor_webhooks where id=$1",
+          [hook.id],
+        );
+        yield* (yield* Evidence).json("duplicate-secondary-registration-race.json", {
+          signedApplyPausedAfterConsumerScan: true,
+          differentPrimary: primary !== p.remove,
+          registrationWaited,
+          applyStatus: applied.status,
+          registerStatus: registered.status,
+          orphanDependencies: orphans,
+          registration,
+        });
+        expect(applied.status, JSON.stringify(applied.body)).toBe(200);
+        expect(
+          orphans,
+          "retirement must never leave a committed webhook dependency on a deleted account",
+        ).toEqual([]);
+        expect(registrationWaited).toBe(true);
+        expect(JSON.stringify(registration)).not.toContain(p.remove);
+        expect(yield* p.snapshot(p.remove)).toEqual([]);
+        expect(yield* p.snapshot(p.retain)).toEqual(before);
+      }),
+    ),
+  );
+});
