--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/production-ops/migrations/duplicate-binding-rows.ts
@@ -0,0 +1,81 @@
+import { Effect, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import { canonical, sha256 } from "../crypto.ts";
+import { ProductionOperationRefused } from "../contracts.ts";
+
+export const refuse = (message: string) => Effect.fail(new ProductionOperationRefused({ message }));
+export const Row = Schema.Record(Schema.String, Schema.Json);
+export const Entry = Schema.Struct({
+  table: Schema.String,
+  key: Schema.Record(Schema.String, Schema.NullOr(Schema.String)),
+  sha256: Schema.String,
+});
+export type Entry = typeof Entry.Type;
+
+/** Closed table/key registry: requests can select IDs, never SQL or columns. */
+export const retirementTables = {
+  hosted_app_account_links: {
+    keys: ["app", "requirement", "account", "subject"],
+    column: "account",
+  },
+  hosted_account_groups: { keys: ["account_id", "group_id"], column: "account_id" },
+  hosted_account_observation_access: { keys: ["account_id"], column: "account_id" },
+  executor_account_checks: { keys: ["id"], column: "account" },
+  executor_account_reports: { keys: ["id"], column: "id" },
+  executor_account_observations: { keys: ["id"], column: "account" },
+  executor_account_driver_checks: { keys: ["account"], column: "account" },
+  executor_webhook_sources: { keys: ["id"], column: "account" },
+  hosted_account_access: { keys: ["account_id"], column: "account_id" },
+  executor_accounts: { keys: ["id"], column: "id" },
+  executor_oauth_grants: { keys: ["id"], column: "id" },
+} as const;
+export type RetirementTable = keyof typeof retirementTables;
+
+export const readRows = (table: string, predicate: string, params: readonly string[]) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const result = yield* sql.unsafe(
+      `select to_jsonb(entry) as row from "${table}" entry where ${predicate} limit 1001`,
+      params,
+    );
+    const decoded = yield* Schema.decodeUnknownEffect(Schema.Array(Schema.Struct({ row: Row })))(
+      result,
+    );
+    if (decoded.length > 1000)
+      return yield* refuse("Duplicate binding evidence exceeds its row bound");
+    return decoded.map(({ row }) => row).sort((a, b) => canonical(a).localeCompare(canonical(b)));
+  });
+
+export const entry = (table: string, keys: readonly string[], row: typeof Row.Type): Entry => ({
+  table,
+  key: Object.fromEntries(keys.map((key) => [key, row[key] === null ? null : String(row[key])])),
+  sha256: sha256(canonical(row)),
+});
+
+export const readEntry = (item: Entry) => {
+  const keys =
+    item.table === "executor_account_identities" || item.table === "executor_providers"
+      ? ["id"]
+      : Object.hasOwn(retirementTables, item.table)
+        ? retirementTables[item.table as RetirementTable].keys
+        : undefined;
+  if (keys === undefined || [...keys].sort().join() !== Object.keys(item.key).sort().join())
+    return refuse("Unknown duplicate binding row identity");
+  const { predicate, params } = whereKey(item);
+  return readRows(item.table, predicate, params).pipe(
+    Effect.map((rows) => rows.map((row) => entry(item.table, keys, row))),
+  );
+};
+
+/** Nullable app subjects retain SQL NULL semantics, including on replay. */
+export const whereKey = (item: Entry) => {
+  const params: string[] = [];
+  const predicate = Object.entries(item.key)
+    .map(([key, value]) => {
+      if (value === null) return `"${key}" is null`;
+      params.push(value);
+      return `"${key}" = $${params.length}`;
+    })
+    .join(" and ");
+  return { predicate, params };
+};
diff --git a/apps/hosted/cloud/src/infrastructure/production-ops/migrations/google-duplicate-bindings-v1.ts b/apps/hosted/cloud/src/infrastructure/production-ops/migrations/google-duplicate-bindings-v1.ts
new file mode 100644
index 0000000..1c91c22
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/production-ops/migrations/google-duplicate-bindings-v1.ts
@@ -0,0 +1,199 @@
+import { Effect, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import { ProviderDefinition } from "@executor-js/sdk/core";
+import type { Json, ProductionMigration } from "../contracts.ts";
+import { canonical } from "../crypto.ts";
+import { contention } from "../locking.ts";
+import { readRetainedAccount } from "./retained-identity-records.ts";
+import {
+  Entry,
+  entry,
+  readEntry,
+  readRows,
+  refuse,
+  retirementTables,
+  whereKey,
+} from "./duplicate-binding-rows.ts";
+
+const Id = Schema.NonEmptyString.check(Schema.isMaxLength(256));
+const Request = Schema.Struct({
+  organization: Id,
+  pairs: Schema.Array(Schema.Struct({ remove: Id, retain: Id, identity: Id })).check(
+    Schema.isMinLength(1),
+    Schema.isMaxLength(20),
+  ),
+});
+const Data = Schema.Struct({ removed: Schema.Array(Entry), retained: Schema.Array(Entry) });
+const decode = (input: Json) => Schema.decodeUnknownEffect(Request)(input);
+
+const read = (input: Json) =>
+  Effect.gen(function* () {
+    const request = yield* decode(input),
+      sql = yield* SqlClient.SqlClient;
+    const all = request.pairs.flatMap((pair) => [pair.remove, pair.retain]);
+    if (new Set(all).size !== all.length)
+      return yield* refuse("Duplicate or overlapping remove and retain IDs");
+    const removed: Entry[] = [],
+      retained = new Map<string, Entry>();
+    const keep = (item: Entry) => retained.set(canonical([item.table, item.key]), item);
+    for (const pair of [...request.pairs].sort((a, b) => a.remove.localeCompare(b.remove))) {
+      const old = yield* readRetainedAccount(pair.remove),
+        saved = yield* readRetainedAccount(pair.retain);
+      if (
+        old.owner !== `organization:${request.organization}` ||
+        saved.owner !== old.owner ||
+        old.organization !== request.organization ||
+        saved.organization !== request.organization ||
+        old.identity !== null ||
+        saved.identity !== pair.identity ||
+        old.provider !== saved.provider ||
+        old.method !== saved.method ||
+        old.placement !== saved.placement ||
+        old.site !== saved.site ||
+        old.grantReference !== null ||
+        old.grant !== old.account ||
+        old.grant === saved.grant
+      )
+        return yield* refuse(
+          "Selected bindings are not an unverified legacy copy and its verified replacement",
+        );
+      const definition = yield* Schema.decodeUnknownEffect(ProviderDefinition)(saved.definition);
+      const method = definition.auth[saved.method];
+      if (
+        method?.type !== "oauth2" ||
+        method.grant === "client_credentials" ||
+        !(
+          method.discover === "https://accounts.google.com" ||
+          (method.authorizationUrl === "https://accounts.google.com/o/oauth2/v2/auth" &&
+            method.tokenUrl === "https://oauth2.googleapis.com/token")
+        )
+      )
+        return yield* refuse("Duplicate retirement supports only matching Google OAuth bindings");
+      const identities = yield* readRows("executor_account_identities", "id = $1", [pair.identity]);
+      const identity = identities[0];
+      if (
+        identities.length !== 1 ||
+        identity?.owner !== old.owner ||
+        identity.placement !== saved.placement ||
+        identity.issuer !== "https://accounts.google.com" ||
+        typeof identity.subject !== "string" ||
+        identity.subject.length === 0
+      )
+        return yield* refuse("Replacement identity is not verified in the same placement");
+      keep(entry("executor_account_identities", ["id"], identity));
+      const provider = yield* readRows("executor_providers", "id = $1", [saved.provider]);
+      if (provider.length !== 1) return yield* refuse("Replacement provider is missing");
+      keep(entry("executor_providers", ["id"], provider[0]!));
+      const consumers =
+        yield* sql`select 1 from executor_workflow_accounts where account = ${pair.remove}
+      union all select 1 from executor_webhook_accounts where account = ${pair.remove}
+      union all select 1 from executor_webhooks where source_account = ${pair.remove}
+      union all select 1 from executor_account_acquisitions where account = ${pair.remove}
+      union all select 1 from executor_account_connections where
+        (reconnect_account = ${pair.remove} or source_account = ${pair.remove} or state -> 'account' ->> 'id' = ${pair.remove})
+        and expires_at > now() and coalesce(state ->> 'status','pending') not in ('completed','failed','cancelled')
+      union all select 1 from executor_accounts where coalesce(oauth_grant_id,id) = ${old.grant} and id <> ${pair.remove} limit 1`;
+      if (consumers.length !== 0)
+        return yield* refuse(
+          "Legacy binding has active consumers, acquisition, connection or shared grant",
+        );
+      const oldLinks = yield* readRows("hosted_app_account_links", "account = $1", [pair.remove]);
+      const newLinks = yield* readRows("hosted_app_account_links", "account = $1", [pair.retain]);
+      if (
+        oldLinks.length === 0 ||
+        oldLinks.some(
+          (link) =>
+            !newLinks.some((replacement) =>
+              ["app", "requirement", "subject"].every((key) => replacement[key] === link[key]),
+            ),
+        )
+      )
+        return yield* refuse("Verified replacement does not cover every removed app binding");
+      for (const link of [...oldLinks, ...newLinks]) {
+        const apps = yield* readRows("executor_apps", "id = $1", [String(link.app)]);
+        if (apps.length !== 1 || apps[0]?.owner !== old.owner)
+          return yield* refuse("App binding leaves the selected organization");
+      }
+      for (const [table, descriptor] of Object.entries(retirementTables)) {
+        const oldRows = yield* readRows(table, `"${descriptor.column}" = $1`, [
+          table === "executor_oauth_grants" ? old.grant : pair.remove,
+        ]);
+        const newRows = yield* readRows(table, `"${descriptor.column}" = $1`, [
+          table === "executor_oauth_grants" ? saved.grant : pair.retain,
+        ]);
+        if (
+          table === "executor_accounts" &&
+          canonical(oldRows[0]?.allowed_hosts ?? null) !==
+            canonical(newRows[0]?.allowed_hosts ?? null)
+        )
+          return yield* refuse("Credential host policy differs");
+        if (
+          table === "executor_webhook_sources" &&
+          oldRows.some(
+            (row) =>
+              row.owner !== old.owner ||
+              row.status !== "ready" ||
+              row.failure !== null ||
+              row.lease !== null,
+          )
+        )
+          return yield* refuse("Webhook source is unsettled");
+        for (const row of oldRows) removed.push(entry(table, descriptor.keys, row));
+        for (const row of newRows) keep(entry(table, descriptor.keys, row));
+      }
+    }
+    const data = {
+      removed,
+      retained: [...retained.values()].sort((a, b) => canonical(a).localeCompare(canonical(b))),
+    };
+    return {
+      changes: removed.map((item) => ({
+        table: item.table,
+        key: item.key,
+        action: "delete" as const,
+        beforeSha256: item.sha256,
+        afterSha256: null,
+      })),
+      data,
+    };
+  });
+
+/** Retire explicit redundant copies only; never infer their subject or revoke upstream consent. */
+export const googleDuplicateBindingsV1: ProductionMigration = {
+  name: "google-duplicate-bindings-v1",
+  revision: "1",
+  tables: [...Object.keys(retirementTables), "executor_account_identities", "executor_providers"],
+  inspect: read,
+  lockAuthority: (input) =>
+    Effect.gen(function* () {
+      const request = yield* decode(input),
+        sql = yield* SqlClient.SqlClient;
+      yield* sql`select pg_advisory_xact_lock(hashtextextended(${`executor-access:${request.organization}`},0))`;
+      for (const id of request.pairs.flatMap((pair) => [pair.remove, pair.retain]).sort())
+        yield* sql`select id from executor_accounts where id = ${id} for update nowait`;
+    }).pipe(Effect.mapError(contention)),
+  apply: (input, plan) =>
+    Effect.gen(function* () {
+      const current = yield* read(input);
+      if (canonical(current) !== canonical(plan))
+        return yield* refuse("Duplicate retirement plan changed");
+      const data = yield* Schema.decodeUnknownEffect(Data)(plan.data),
+        sql = yield* SqlClient.SqlClient;
+      for (const item of data.removed) {
+        const { predicate, params } = whereKey(item);
+        yield* sql.unsafe(`delete from "${item.table}" where ${predicate}`, params);
+      }
+    }),
+  verify: (_input, plan) =>
+    Effect.gen(function* () {
+      const data = yield* Schema.decodeUnknownEffect(Data)(plan.data);
+      let removed = true,
+        retained = true;
+      for (const item of data.removed) removed &&= (yield* readEntry(item)).length === 0;
+      for (const item of data.retained) {
+        const rows = yield* readEntry(item);
+        retained &&= rows.length === 1 && rows[0]?.sha256 === item.sha256;
+      }
+      return { ok: removed && retained, checks: { removed, retained } };
+    }),
+};
