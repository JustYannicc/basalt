+++ b/e2e/support/google-duplicate-binding-fixture.ts
@@ -0,0 +1,165 @@
+import { expect } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { randomUUID } from "node:crypto";
+import { Api, body } from "./api.ts";
+import { Actors } from "./actors.ts";
+import { cloudLocks } from "./cloud-locks.ts";
+import { appsManifest } from "./apps-release.ts";
+import { productionOpsClient } from "./production-ops-client.ts";
+
+/** Seed retained legacy rows; all operations under test use the real signed HTTP boundary. */
+export const googleDuplicateBindingFixture = Effect.gen(function* () {
+  const api = yield* Api,
+    actors = yield* Actors,
+    database = yield* cloudLocks;
+  const client = yield* productionOpsClient;
+  const organization = actors.organization.id,
+    owner = `organization:${organization}`;
+  const rows = (sql: string, params: readonly (string | number | null)[] = []) =>
+    database.run({ sql, params });
+  const remove = `acc_${randomUUID()}`,
+    retain = `acc_${randomUUID()}`;
+  const provider = `prv_${randomUUID()}`,
+    identity = `aid_${randomUUID()}`;
+  const person = (yield* body(
+    Schema.Struct({ user: Schema.Struct({ id: Schema.String }) }),
+    yield* api.request(actors.owner, "GET", "/api/auth/get-session"),
+  )).user.id;
+  const deployment = yield* api.request(
+    actors.owner,
+    "POST",
+    `/api/organizations/${organization}/apps/deploy`,
+    {
+      name: `Retirement ${randomUUID()}`,
+      files: [
+        appsManifest,
+        {
+          path: "index.ts",
+          content:
+            'import { defineApp, router } from "apps"; export default defineApp({}, {tools:router({})});',
+        },
+      ],
+    },
+  );
+  expect(deployment.status, JSON.stringify(deployment.body)).toBe(200);
+  const app = (yield* body(Schema.Struct({ id: Schema.String }), deployment)).id;
+  yield* Effect.addFinalizer(() =>
+    Effect.gen(function* () {
+      yield* rows("delete from executor_workflow_accounts where account=$1", [remove]);
+      for (const id of [remove, retain]) {
+        yield* rows("delete from executor_account_checks where account=$1", [id]);
+        yield* rows("delete from hosted_app_account_links where account=$1", [id]);
+        yield* rows("delete from hosted_account_access where account_id=$1", [id]);
+        yield* rows("delete from executor_accounts where id=$1", [id]);
+        yield* rows("delete from executor_oauth_grants where id=$1", [id]);
+      }
+      yield* rows("delete from executor_account_identities where id=$1", [identity]);
+      yield* rows("delete from executor_providers where id=$1", [provider]);
+      yield* api.request(actors.owner, "DELETE", `/api/organizations/${organization}/apps/${app}`);
+    }).pipe(Effect.orDie),
+  );
+  yield* rows("insert into executor_providers (id,definition) values ($1,$2::jsonb)", [
+    provider,
+    JSON.stringify({
+      name: "Google retirement fixture",
+      auth: {
+        oauth: {
+          type: "oauth2",
+          authorizationUrl: "https://accounts.google.com/o/oauth2/v2/auth",
+          tokenUrl: "https://oauth2.googleapis.com/token",
+          scopes: ["openid", "email"],
+          tokenEndpointAuthMethod: "none",
+          response: {
+            type: "object",
+            properties: {
+              access_token: { type: "string" },
+            },
+            required: ["access_token"],
+          },
+        },
+      },
+    }),
+  ]);
+  yield* rows(
+    `insert into executor_account_identities
+        (id,owner,placement,issuer,subject,name,label,verified_at,created_at)
+        values ($1,$2,$3,'https://accounts.google.com',$4,'Google','person@example.test',now(),now())`,
+    [
+      identity,
+      owner,
+      JSON.stringify([organization, "personal", person, null, []]),
+      `subject-${retain}`,
+    ],
+  );
+  for (const id of [remove, retain]) {
+    yield* rows(
+      `insert into executor_accounts
+          (id,owner,provider,method,label,encrypted_credentials,created_at,credential_generation,identity_id)
+          values ($1,$2,$3,'oauth','Saved Google',decode('123456','hex'),now(),3,$4)`,
+      [id, owner, provider, id === retain ? identity : null],
+    );
+    yield* rows(
+      `insert into executor_oauth_grants (id,encrypted,status,updated_at,owner)
+          values ($1,decode('abcdef','hex'),'ready_fixture',now(),$2)`,
+      [id, owner],
+    );
+    yield* rows(
+      `insert into hosted_account_access (account_id,organization_id,creator_id,kind,personal_user_id)
+          values ($1,$2,$3,'personal',$3)`,
+      [id, organization, person],
+    );
+    yield* rows(
+      `insert into hosted_app_account_links (app,requirement,subject,account,linked_by)
+          values ($1,'google',$2,$3,$2)`,
+      [app, person, id],
+    );
+    yield* rows(
+      `insert into executor_account_checks
+          (id,account,app,deployment,credential_generation,status,checked_at)
+          values ($1,$2,$3,'fixture',3,'unknown',now())`,
+      [`check-${id}`, id, app],
+    );
+  }
+  const snapshot = (id: string) =>
+    rows(
+      `select to_jsonb(a) as account,to_jsonb(g) as grant,to_jsonb(h) as access,
+        (select jsonb_agg(to_jsonb(l) order by l.app,l.requirement) from hosted_app_account_links l where l.account=a.id) as links,
+        (select jsonb_agg(to_jsonb(c) order by c.id) from executor_account_checks c where c.account=a.id) as checks,
+        (select to_jsonb(i) from executor_account_identities i where i.id=$2) as identity,
+        (select to_jsonb(p) from executor_providers p where p.id=a.provider) as provider
+        from executor_accounts a join executor_oauth_grants g on g.id=a.id
+        join hosted_account_access h on h.account_id=a.id where a.id=$1`,
+      [id, identity],
+    );
+  const oldBefore = yield* snapshot(remove),
+    keepBefore = yield* snapshot(retain);
+  const request = { organization, pairs: [{ remove, retain, identity }] };
+  const operation = (action: string, input: unknown = request, extra: object = {}) =>
+    client.request({
+      action,
+      selection: "google-duplicate-bindings-v1",
+      request: input,
+      recipient: client.recipient,
+      ...extra,
+    });
+  return {
+    api,
+    actors,
+    database,
+    client,
+    organization,
+    owner,
+    person,
+    app,
+    provider,
+    remove,
+    retain,
+    identity,
+    rows,
+    snapshot,
+    oldBefore,
+    keepBefore,
+    request,
+    operation,
+  };
+});
