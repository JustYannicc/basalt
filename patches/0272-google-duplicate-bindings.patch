@@ -0,0 +1,151 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { randomUUID } from "node:crypto";
+import { body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Artifact, Backup } from "../support/production-ops-client.ts";
+import { googleDuplicateBindingFixture } from "../support/google-duplicate-binding-fixture.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Google duplicate retirement", (it) => {
+  it.effect(scenarios.googleDuplicateBindings.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const {
+          rows,
+          remove,
+          retain,
+          identity,
+          person,
+          app,
+          client,
+          snapshot,
+          oldBefore,
+          keepBefore,
+          request,
+          operation,
+        } = yield* googleDuplicateBindingFixture;
+        for (const invalid of [
+          { ...request, pairs: [{ remove, retain: remove, identity }] },
+          { ...request, pairs: [...request.pairs, ...request.pairs] },
+          { ...request, pairs: [{ remove: retain, retain: remove, identity }] },
+          { ...request, pairs: [{ remove, retain, identity: `aid_${randomUUID()}` }] },
+          { ...request, organization: randomUUID() },
+        ])
+          expect((yield* operation("dry-run", invalid)).status).toBe(409);
+        yield* rows("delete from hosted_app_account_links where account=$1", [retain]);
+        expect((yield* operation("dry-run")).status).toBe(409);
+        yield* rows(
+          `insert into hosted_app_account_links (app,requirement,subject,account,linked_by)
+        values ($1,'google',$2,$3,$2)`,
+          [app, person, retain],
+        );
+        yield* rows("update hosted_account_access set personal_user_id=$2 where account_id=$1", [
+          remove,
+          `other-${person}`,
+        ]);
+        expect((yield* operation("dry-run")).status).toBe(409);
+        yield* rows("update hosted_account_access set personal_user_id=$2 where account_id=$1", [
+          remove,
+          person,
+        ]);
+        yield* rows("update executor_accounts set oauth_grant_id=$2 where id=$1", [retain, remove]);
+        expect((yield* operation("dry-run")).status).toBe(409);
+        yield* rows("update executor_accounts set oauth_grant_id=null where id=$1", [retain]);
+        const consumer = `consumer-${randomUUID()}`;
+        yield* rows("insert into executor_workflow_accounts (id,account,run) values ($1,$2,$3)", [
+          consumer,
+          remove,
+          `run-${randomUUID()}`,
+        ]);
+        expect((yield* operation("dry-run")).status).toBe(409);
+        yield* rows("delete from executor_workflow_accounts where id=$1", [consumer]);
+        const dry = yield* operation("dry-run");
+        expect(dry.status, JSON.stringify(dry.body)).toBe(200);
+        const plan = yield* body(
+          Schema.Struct({
+            changes: Schema.Number,
+            artifact: Artifact,
+            backup: Artifact,
+            backupSha256: Schema.String,
+          }),
+          dry,
+        );
+        const decoded = Schema.decodeUnknownSync(
+          Schema.Struct({
+            plan: Schema.Struct({
+              changes: Schema.Array(
+                Schema.Struct({
+                  table: Schema.String,
+                  action: Schema.String,
+                  key: Schema.Record(Schema.String, Schema.NullOr(Schema.String)),
+                }),
+              ),
+            }),
+          }),
+        )(client.decrypt(plan.artifact));
+        expect(plan.changes).toBe(5);
+        expect(decoded.plan.changes.map((change) => change.table).sort()).toEqual([
+          "executor_account_checks",
+          "executor_accounts",
+          "executor_oauth_grants",
+          "hosted_account_access",
+          "hosted_app_account_links",
+        ]);
+        expect(
+          decoded.plan.changes.every(
+            (change) =>
+              change.action === "delete" &&
+              Object.values(change.key).includes(
+                change.table === "executor_account_checks" ? `check-${remove}` : remove,
+              ),
+          ),
+        ).toBe(true);
+        const backup = Schema.decodeUnknownSync(Backup)(client.decrypt(plan.backup));
+        expect(backup.tables).toContain("executor_account_checks");
+        expect(JSON.stringify(backup.rows.executor_account_checks)).toContain(`check-${remove}`);
+        expect(yield* snapshot(remove)).toEqual(oldBefore);
+        const reviewedKeep = yield* snapshot(retain);
+        expect(reviewedKeep[0]?.account).toEqual(keepBefore[0]?.account);
+        const apply = (go = `GO ${plan.artifact.sha256}`) =>
+          operation("apply", request, {
+            artifact: plan.artifact,
+            planSha256: plan.artifact.sha256,
+            backupSha256: plan.backupSha256,
+            go,
+          });
+        expect((yield* apply("GO wrong-plan")).status).toBe(409);
+        yield* rows("update executor_accounts set credential_generation=4 where id=$1", [retain]);
+        expect((yield* apply()).status).toBe(409);
+        expect(yield* snapshot(remove)).toEqual(oldBefore);
+        yield* rows("update executor_accounts set credential_generation=3 where id=$1", [retain]);
+        const applied = yield* apply();
+        expect(applied.status, JSON.stringify(applied.body)).toBe(200);
+        expect(
+          yield* body(
+            Schema.Struct({
+              repeated: Schema.Boolean,
+              verification: Schema.Struct({ ok: Schema.Boolean }),
+            }),
+            applied,
+          ),
+        ).toEqual({ repeated: false, verification: { ok: true } });
+        expect(yield* snapshot(remove)).toEqual([]);
+        expect(yield* rows("select id from executor_oauth_grants where id=$1", [remove])).toEqual(
+          [],
+        );
+        expect(
+          yield* rows("select id from executor_account_checks where account=$1", [remove]),
+        ).toEqual([]);
+        expect(yield* snapshot(retain)).toEqual(reviewedKeep);
+        const repeated = yield* apply();
+        expect(repeated.status, JSON.stringify(repeated.body)).toBe(200);
+        expect((yield* body(Schema.Struct({ repeated: Schema.Boolean }), repeated)).repeated).toBe(
+          true,
+        );
+        expect(yield* snapshot(retain)).toEqual(reviewedKeep);
+      }),
+    ),
+  );
+});
