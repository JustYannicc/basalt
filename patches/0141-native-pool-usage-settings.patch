diff --git a/e2e/tests/pool-usage-navigation.spec.ts b/e2e/tests/pool-usage-navigation.spec.ts
new file mode 100644
index 0000000..8d51fd6
--- /dev/null
+++ b/e2e/tests/pool-usage-navigation.spec.ts
@@ -0,0 +1,465 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import type { Page, Route } from "playwright";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { openInApp } from "../support/in-app-navigation.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { poolUsageUiFixture } from "../support/pool-usage-ui-fixture.ts";
+import {
+  advanceToReconciliation,
+  holdQuery,
+  installBrowserClock,
+  refreshVisiblePage,
+} from "../support/query-transition.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Resource = Schema.Struct({ id: Schema.String });
+const Access = Schema.Struct({
+  revision: Schema.String,
+  canManage: Schema.Boolean,
+  canUse: Schema.Boolean,
+});
+const UsagePage = Schema.Struct({
+  next: Schema.NullOr(Schema.String),
+  members: Schema.Array(Schema.Struct({ member: Schema.String })),
+});
+const section = (page: Page) => page.getByRole("region", { name: "Pool usage", exact: true });
+const people = (page: Page) =>
+  section(page).locator('ul[aria-label="People who can use this pool"]');
+const member = (page: Page) =>
+  people(page).locator(":scope > li").filter({ hasText: "member@example.test" });
+
+layer(HostedLive, { excludeTestServices: true })("Native pool usage navigation", (it) => {
+  it.effect(scenarios.poolUsageNavigation.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const {
+          api,
+          actors,
+          backend,
+          prefix,
+          read,
+          deploy,
+          owner,
+          admin,
+          person,
+          retained,
+          paging,
+        } = yield* poolUsageUiFixture;
+        const browser = yield* Browser;
+        const first = yield* deploy(actors.owner, "First usage navigation pool"),
+          second = yield* deploy(actors.admin, "Second usage navigation pool"),
+          ordinary = yield* deploy(actors.owner, "Ordinary navigation app");
+        const group = yield* read(Resource, actors.owner, "POST", `${prefix}/groups`, {
+          name: "Empty native pool audience",
+          description: "",
+          memberIds: [],
+        });
+        const appPath = (app: string) => `${prefix}/apps/${app}`;
+        const share = (app: string, audience: unknown) =>
+          Effect.gen(function* () {
+            const access = yield* read(Access, actors.owner, "GET", `${appPath(app)}/access`);
+            expect(
+              (yield* api.request(actors.owner, "PATCH", `${appPath(app)}/access`, {
+                revision: access.revision,
+                audience,
+              })).status,
+            ).toBe(200);
+          });
+        yield* share(first.id, { kind: "everyone" });
+        yield* share(second.id, { kind: "groups", groups: [group.id] });
+        yield* serverControl("stop");
+        yield* legacyStorage([
+          retained([
+            { owner, app: first.id },
+            { owner: admin, app: second.id },
+          ]),
+          ...paging,
+        ]);
+        yield* serverControl("environment", 200, {
+          POOL_APP_SIGNING_KEY: "ab".repeat(32),
+          BASALT_POOL_ORIGIN: backend.origin,
+        });
+        yield* serverControl("start");
+        yield* Effect.addFinalizer(() => serverControl("start").pipe(Effect.orDie));
+        const firstPage = yield* read(
+          UsagePage,
+          actors.owner,
+          "GET",
+          `${appPath(first.id)}/pool-usage`,
+        );
+        expect(firstPage.members).toHaveLength(100);
+        expect(firstPage.members.map((row) => row.member)).toEqual(
+          expect.arrayContaining([owner, admin, person]),
+        );
+        expect(firstPage.next).not.toBeNull();
+        const paths = (app: string) =>
+          [actors.organization.id, actors.organization.slug].map(
+            (organization) => `/api/organizations/${organization}/apps/${app}/pool-usage`,
+          );
+        const settings = (app: string) =>
+          `/org/${actors.organization.slug}/apps/${app}?view=settings`;
+        yield* browser.login(actors.owner);
+        yield* installBrowserClock;
+        yield* browser.use("Start from a hydrated dashboard", (page) =>
+          page.goto(`/org/${actors.organization.slug}/connect`),
+        );
+
+        yield* Effect.scoped(
+          Effect.gen(function* () {
+            const observed = yield* Effect.acquireRelease(
+              browser.use("Observe any ordinary-app pool section flash", (page) =>
+                page.evaluateHandle(() => {
+                  const state = { seen: false };
+                  const observer = new MutationObserver(() => {
+                    state.seen ||= Array.from(document.querySelectorAll("section h2")).some(
+                      (heading) => heading.textContent === "Pool usage",
+                    );
+                  });
+                  observer.observe(document.body, { childList: true, subtree: true });
+                  return { state, observer };
+                }),
+              ),
+              (handle) =>
+                browser
+                  .use("Stop the ordinary-app section observer", () =>
+                    handle
+                      .evaluate((value) => value.observer.disconnect())
+                      .then(() => handle.dispose()),
+                  )
+                  .pipe(Effect.orDie),
+            );
+            const held = yield* holdQuery(paths(ordinary.id), "continue");
+            yield* openInApp("Open ordinary Settings in the running app", settings(ordinary.id));
+            yield* held.requested;
+            expect(
+              yield* browser.use("Ordinary app has no section while its first read waits", (page) =>
+                section(page).count(),
+              ),
+            ).toBe(0);
+            const response = yield* browser.use(
+              "Observe the real ordinary-app null response",
+              (page) =>
+                Promise.resolve({
+                  read: page.waitForResponse(
+                    (value) =>
+                      paths(ordinary.id).includes(new URL(value.url()).pathname) && value.ok(),
+                  ),
+                }),
+            );
+            yield* held.release;
+            expect(
+              yield* browser.use("The hosted service identifies the ordinary app as null", () =>
+                response.read.then((value) => value.json()),
+              ),
+            ).toBeNull();
+            yield* browser.use("Ordinary Settings is available after the read", (page) =>
+              page.getByRole("heading", { name: "App access", exact: true }).waitFor(),
+            );
+            expect(
+              yield* browser.use("Ordinary app still has no pool section", (page) =>
+                section(page).count(),
+              ),
+            ).toBe(0);
+            expect(
+              yield* browser.use("No pool section flashed during the ordinary read", () =>
+                observed.evaluate((value) => value.state.seen),
+              ),
+            ).toBe(false);
+          }),
+        );
+
+        expect(
+          yield* read(Access, actors.owner, "GET", `${appPath(second.id)}/access`),
+        ).toMatchObject({
+          canManage: true,
+          canUse: false,
+        });
+        expect(
+          (yield* api.request(actors.owner, "POST", `${appPath(second.id)}/tools/call`, {
+            tool: "identity",
+            kind: "query",
+            input: {},
+          })).status,
+        ).toBe(403);
+        yield* openInApp("Open the empty native pool", settings(second.id));
+        yield* browser.use("Empty native usage points to App access", (page) =>
+          section(page)
+            .getByText("Nobody can use this pool yet. Choose who can under App access.", {
+              exact: true,
+            })
+            .waitFor(),
+        );
+        yield* browser.use("Management does not grant use", (page) =>
+          section(page)
+            .getByText(
+              "You manage this pool but can't use it. Managing it doesn't let you send requests through it or use its accounts.",
+              { exact: true },
+            )
+            .waitFor(),
+        );
+        expect(
+          yield* browser.use("Empty pool lists nobody", (page) =>
+            people(page).locator(":scope > li").count(),
+          ),
+        ).toBe(0);
+        yield* share(second.id, { kind: "everyone" });
+        yield* refreshVisiblePage;
+        yield* browser.use("The second real pool now includes the same draft person", (page) =>
+          member(page).waitFor(),
+        );
+
+        yield* backend.unavailable(true);
+        yield* openInApp("Open the first pool with its first read unavailable", settings(first.id));
+        yield* browser.use("The first-read failure is visible", (page) =>
+          section(page)
+            .getByText("Pool usage could not be reached. Try again.", { exact: true })
+            .waitFor(),
+        );
+        yield* browser.use("The first-read failure offers a retry", (page) =>
+          section(page).getByRole("button", { name: "Retry", exact: true }).waitFor(),
+        );
+        expect(
+          yield* browser.use("Failed first read has no invented people", (page) =>
+            people(page).locator(":scope > li").count(),
+          ),
+        ).toBe(0);
+        yield* backend.unavailable(false);
+        yield* browser.use("Retry the first read with the real service", (page) =>
+          section(page).getByRole("button", { name: "Retry", exact: true }).press("Enter"),
+        );
+        yield* browser.use("Recovered usage shows the actual member", (page) =>
+          member(page).waitFor(),
+        );
+        expect(
+          yield* browser.use("Recovered usage lists the first hundred", (page) =>
+            people(page).locator(":scope > li").count(),
+          ),
+        ).toBe(100);
+        expect(
+          yield* browser.use("Recovery clears the failure", (page) =>
+            section(page).getByRole("button", { name: "Retry", exact: true }).count(),
+          ),
+        ).toBe(0);
+        yield* browser.use("Open a keyboard cap draft", (page) =>
+          member(page)
+            .getByRole("button", { name: /Set weekly cap/ })
+            .press("Enter"),
+        );
+        yield* browser.use("Keep an unsaved amount", (page) =>
+          page.getByRole("textbox", { name: /Weekly cap for/ }).fill("37.25"),
+        );
+        yield* browser.use("Expand this person's usage", (page) =>
+          member(page)
+            .getByRole("button", { name: /Show usage details/ })
+            .click(),
+        );
+        yield* Effect.scoped(
+          Effect.gen(function* () {
+            const held = yield* holdQuery(paths(first.id), "continue", {
+              query: { after: firstPage.next! },
+            });
+            yield* browser.use("Page forward with the keyboard", (page) =>
+              section(page).getByRole("button", { name: "Next", exact: true }).press("Enter"),
+            );
+            yield* held.requested;
+            yield* browser.use("Paging marks the old list busy", (page) =>
+              section(page)
+                .locator('ul[aria-label="People who can use this pool"][aria-busy="true"]')
+                .waitFor(),
+            );
+            expect(
+              yield* browser.use("Paging disables old rows", (page) =>
+                people(page).getAttribute("inert"),
+              ),
+            ).not.toBeNull();
+            expect(
+              yield* browser.use("Paging retains the old hundred rows", (page) =>
+                people(page).locator(":scope > li").count(),
+              ),
+            ).toBe(100);
+            expect(
+              yield* browser.use("Paging retains the unsaved draft", (page) =>
+                people(page).locator('input[aria-label^="Weekly cap for"]').inputValue(),
+              ),
+            ).toBe("37.25");
+            yield* held.release;
+            yield* browser.use("The next page loads", (page) =>
+              section(page)
+                .getByRole("status")
+                .filter({ hasText: /People 101.104/ })
+                .waitFor(),
+            );
+            expect(
+              yield* browser.use("The last four people are listed", (page) =>
+                people(page).locator(":scope > li").count(),
+              ),
+            ).toBe(4);
+            expect(
+              yield* browser.use("The new page receives heading focus", (page) =>
+                section(page)
+                  .getByRole("heading", { name: "Pool usage", exact: true })
+                  .evaluate((heading) => heading === document.activeElement),
+              ),
+            ).toBe(true);
+            expect(
+              yield* browser.use("The first-page draft is not on another person's page", (page) =>
+                page.getByRole("textbox", { name: /Weekly cap for/ }).count(),
+              ),
+            ).toBe(0);
+          }),
+        );
+        yield* browser.use("Page back with the keyboard", (page) =>
+          section(page).getByRole("button", { name: "Previous", exact: true }).press("Enter"),
+        );
+        yield* browser.use("The previous page restores its editor", (page) =>
+          page.getByRole("textbox", { name: /Weekly cap for/ }).waitFor(),
+        );
+        expect(
+          yield* browser.use("The previous page restores the same draft", (page) =>
+            page.getByRole("textbox", { name: /Weekly cap for/ }).inputValue(),
+          ),
+        ).toBe("37.25");
+        expect(
+          yield* browser.use("The previous page restores a hundred people", (page) =>
+            people(page).locator(":scope > li").count(),
+          ),
+        ).toBe(100);
+        expect(
+          yield* browser.use("The previous page restores expansion", (page) =>
+            member(page)
+              .getByRole("button", { name: /Hide usage details/ })
+              .getAttribute("aria-expanded"),
+          ),
+        ).toBe("true");
+        expect(
+          yield* browser.use("The previous page receives heading focus", (page) =>
+            section(page)
+              .getByRole("heading", { name: "Pool usage", exact: true })
+              .evaluate((heading) => heading === document.activeElement),
+          ),
+        ).toBe(true);
+
+        for (const app of [second, first]) {
+          yield* openInApp("Switch between the two actual pool Settings pages", settings(app.id));
+          yield* browser.use("The app identity changed", (page) =>
+            page.getByRole("link", { name: `${app.name} overview`, exact: true }).waitFor(),
+          );
+          yield* browser.use("The new pool includes the same person", (page) =>
+            member(page).waitFor(),
+          );
+          expect(
+            yield* browser.use("Changing pools clears the draft", (page) =>
+              page.getByRole("textbox", { name: /Weekly cap for/ }).count(),
+            ),
+          ).toBe(0);
+          expect(
+            yield* browser.use("Changing pools collapses details", (page) =>
+              member(page)
+                .getByRole("button", { name: /Show usage details/ })
+                .getAttribute("aria-expanded"),
+            ),
+          ).toBe("false");
+          expect(
+            yield* browser.use("Changing pools removes the old chart", (page) =>
+              section(page)
+                .getByRole("group", { name: "Usage of Test member", exact: true })
+                .count(),
+            ),
+          ).toBe(0);
+          expect(
+            yield* browser.use("Changing pools starts at the first page", (page) =>
+              section(page).getByRole("button", { name: "Previous", exact: true }).isDisabled(),
+            ),
+          ).toBe(true);
+        }
+
+        yield* browser.use(
+          "Finish any retained-page reconciliation before measuring polling",
+          (page) =>
+            section(page)
+              .getByRole("status")
+              .filter({ hasText: "updating" })
+              .waitFor({ state: "hidden" }),
+        );
+        const usageCalls = () =>
+          backend.calls.pipe(
+            Effect.map(
+              (calls) =>
+                calls.filter((call) => call.action === "managed-usage" && call.pool === first.id)
+                  .length,
+            ),
+          );
+        yield* Effect.scoped(
+          Effect.gen(function* () {
+            const held = yield* holdQuery(paths(first.id), "continue");
+            const before = yield* usageCalls();
+            yield* advanceToReconciliation;
+            yield* held.requested;
+            yield* browser.use("Visible polling keeps usage on screen while updating", (page) =>
+              section(page).getByRole("status").filter({ hasText: "updating" }).waitFor(),
+            );
+            expect(yield* usageCalls()).toBe(before);
+            yield* held.release;
+            yield* browser.use("Visible polling completes through the real backend", (page) =>
+              section(page)
+                .getByRole("status")
+                .filter({ hasText: "updating" })
+                .waitFor({ state: "hidden" }),
+            );
+            expect(yield* usageCalls()).toBe(before + 1);
+          }),
+        );
+        yield* Effect.scoped(
+          Effect.gen(function* () {
+            let hiddenReads = 0;
+            const match = (url: URL) => paths(first.id).includes(url.pathname);
+            const observe = (route: Route) => {
+              hiddenReads++;
+              return route.fallback();
+            };
+            yield* Effect.acquireRelease(
+              browser.use("Observe actual hidden pool reads", (page) => page.route(match, observe)),
+              () =>
+                browser
+                  .use("Stop observing hidden pool reads", (page) => page.unroute(match, observe))
+                  .pipe(Effect.orDie),
+            );
+            yield* Effect.acquireRelease(
+              browser.use("Hide the page from the product's visibility timer", (page) =>
+                page.evaluate(() => {
+                  Object.defineProperty(document, "visibilityState", {
+                    configurable: true,
+                    get: () => "hidden",
+                  });
+                  window.dispatchEvent(new Event("visibilitychange"));
+                }),
+              ),
+              () =>
+                browser
+                  .use("Restore page visibility and the browser clock", (page) =>
+                    page
+                      .evaluate(() => {
+                        Reflect.deleteProperty(document, "visibilityState");
+                      })
+                      .then(() => page.context().clock.resume()),
+                  )
+                  .pipe(Effect.orDie),
+            );
+            const before = yield* usageCalls();
+            yield* advanceToReconciliation;
+            yield* advanceToReconciliation;
+            expect(hiddenReads).toBe(0);
+            expect(yield* usageCalls()).toBe(before);
+          }),
+        );
+        expect((yield* backend.calls).filter((call) => call.action === "managed-cap")).toHaveLength(
+          0,
+        );
+      }),
+    ),
+  );
+});
diff --git a/e2e/tests/pool-usage-ui.spec.ts b/e2e/tests/pool-usage-ui.spec.ts
