index 0000000..a7dee51
--- /dev/null
+++ b/apps/hosted/web/src/contracts/pool-usage.ts
@@ -0,0 +1,88 @@
+/** A pool's per-person usage and weekly caps, read through the host and never by running the pool. */
+import { hydrated } from "@executor-js/ui/contracts/http";
+import { revalidated } from "@executor-js/ui/contracts/refresh";
+import { pollingQuery } from "@executor-js/ui/contracts/polling";
+import { Data, Effect, Option } from "effect";
+import { AsyncResult, Atom } from "effect/reactivity";
+import type { AppId } from "@executor-js/sdk";
+import type { OrganizationReference } from "@executor-js/hosted-server/organization";
+import type { PoolUsagePage } from "@executor-js/hosted-server/pool-usage";
+import { HostedClient } from "./api.ts";
+import { protectedQuery } from "./protected-query.ts";
+
+export type { PoolUsagePage } from "@executor-js/hosted-server/pool-usage";
+export type PoolUsageMember = PoolUsagePage["members"][number];
+export type PoolMemberId = PoolUsageMember["member"];
+
+class PageKey extends Data.Class<{
+  readonly organization: OrganizationReference;
+  readonly app: AppId;
+  /** The last person on the previous page, in the backend's order; none for the first page. */
+  readonly after: string | undefined;
+}> {}
+class MemberKey extends Data.Class<{
+  readonly organization: OrganizationReference;
+  readonly app: AppId;
+  readonly member: PoolMemberId;
+}> {}
+
+const source = Atom.family((key: PageKey) =>
+  HostedClient.query(
+    "poolUsage",
+    "get",
+    hydrated({
+      params: { organization: key.organization, app: key.app },
+      query: { after: key.after },
+    }),
+  ).pipe(revalidated, protectedQuery),
+);
+const polled = Atom.family((key: PageKey) => pollingQuery(source(key)));
+const page = Atom.family((key: PageKey) =>
+  Atom.readable(
+    (get) => {
+      const result = get(source(key));
+      // Only a pool reconciles while the page is visible, including while a refresh fails; an
+      // ordinary app's null answer is read once.
+      const current = AsyncResult.value(result);
+      if (Option.isSome(current) && current.value !== null) get(polled(key));
+      return result;
+    },
+    (refresh) => refresh(source(key)),
+  ),
+);
+/** One page of a pool's people, or null when the app is not a pool. Managers only. */
+export const poolUsagePageAtom = (key: {
+  readonly organization: OrganizationReference;
+  readonly app: AppId;
+  readonly after: string | undefined;
+}) => page(new PageKey(key));
+
+const setCap = Atom.family((key: MemberKey) =>
+  HostedClient.runtime.fn(
+    (input: { readonly weekly: number | null; readonly after: string | undefined }, get) =>
+      Effect.flatMap(HostedClient, (client) =>
+        client.poolUsage.setCap({
+          params: { organization: key.organization, app: key.app, member: key.member },
+          payload: { weekly: input.weekly },
+        }),
+      ).pipe(
+        // The response carries no usage, so the page the person was edited on is read again.
+        // A conflict or lost access also means that page is out of date.
+        Effect.ensuring(
+          Effect.sync(() =>
+            get.refresh(
+              source(
+                new PageKey({ organization: key.organization, app: key.app, after: input.after }),
+              ),
+            ),
+          ),
+        ),
+      ),
+  ),
+);
+/** Set or remove one person's weekly cap; each person has an independent write. */
+export const setPoolCapAtom = (key: {
+  readonly organization: OrganizationReference;
+  readonly app: AppId;
+  readonly member: PoolMemberId;
+}) => setCap(new MemberKey(key));
