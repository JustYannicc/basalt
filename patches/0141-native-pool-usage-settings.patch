+import { expect, layer } from "@effect/vitest";
+import { Effect, Fiber, Schema } from "effect";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { poolUsageUiFixture } from "../support/pool-usage-ui-fixture.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Native pool usage UI", (it) => {
+  it.effect(scenarios.poolUsageUi.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const { api, actors, backend, prefix, read, deploy, owner, retained } =
+          yield* poolUsageUiFixture;
+        const browser = yield* Browser;
+        yield* backend.rich;
+        const app = yield* deploy(actors.owner, "Pool usage proof");
+        const access = yield* read(
+          Schema.Struct({ revision: Schema.String }),
+          actors.owner,
+          "GET",
+          `${prefix}/apps/${app.id}/access`,
+        );
+        expect(
+          (yield* api.request(actors.owner, "PATCH", `${prefix}/apps/${app.id}/access`, {
+            revision: access.revision,
+            audience: { kind: "everyone" },
+          })).status,
+        ).toBe(200);
+        yield* serverControl("stop");
+        yield* legacyStorage([retained([{ owner, app: app.id }])]);
+        yield* serverControl("environment", 200, {
+          POOL_APP_SIGNING_KEY: "ab".repeat(32),
+          BASALT_POOL_ORIGIN: backend.origin,
+        });
+        yield* serverControl("start");
+        yield* Effect.addFinalizer(() => serverControl("start").pipe(Effect.orDie));
+        yield* browser.login(actors.owner);
+        yield* browser.use("Open pool Settings", (page) =>
+          page.goto(`/org/${actors.organization.slug}/apps/${app.id}?view=settings`),
+        );
+        yield* browser.use("Wait for actual usage", (page) =>
+          page.getByRole("region", { name: "Pool usage", exact: true }).waitFor(),
+        );
+        expect(
+          yield* browser.use("Owner has no cap editor", (page) =>
+            page
+              .getByRole("list", { name: "People who can use this pool" })
+              .getByRole("listitem")
+              .filter({ hasText: "owner@example.test" })
+              .getByRole("button", { name: /weekly cap/ })
+              .count(),
+          ),
+        ).toBe(0);
+        const editAdmin = () =>
+          browser.use("Edit the admin's cap", (page) =>
+            page
+              .getByRole("listitem")
+              .filter({ hasText: "admin@example.test" })
+              .getByRole("button", { name: /Set weekly cap/ })
+              .click(),
+          );
+        yield* editAdmin();
+        yield* browser.use("Enter an invalid cap", (page) =>
+          page.getByRole("textbox", { name: /Weekly cap for/ }).fill("0"),
+        );
+        yield* browser.use("Reject an invalid cap before any write", (page) =>
+          page.getByRole("button", { name: "Save weekly cap", exact: true }).click(),
+        );
+        yield* browser.use("Show cap validation", (page) =>
+          page.getByRole("alert").filter({ hasText: "Enter an amount" }).waitFor(),
+        );
+        expect((yield* backend.calls).filter((call) => call.action === "managed-cap")).toHaveLength(
+          0,
+        );
+        yield* browser.use("Keep a valid draft", (page) =>
+          page.getByRole("textbox", { name: /Weekly cap for/ }).fill("20.50"),
+        );
+        yield* backend.unavailable(true);
+        yield* browser.use("Try the unavailable backend", (page) =>
+          page.getByRole("button", { name: "Save weekly cap", exact: true }).click(),
+        );
+        yield* browser.use("Show the failed save", (page) =>
+          page.getByText("Cap not saved", { exact: true }).waitFor(),
+        );
+        expect(
+          yield* browser.use("Keep the draft after failure", (page) =>
+            page.getByRole("textbox", { name: /Weekly cap for/ }).inputValue(),
+          ),
+        ).toBe("20.50");
+        yield* backend.unavailable(false);
+        const hold = yield* backend.hold;
+        const saving = yield* browser
+          .use("Retry the saved draft", (page) =>
+            page.getByRole("button", { name: "Save weekly cap", exact: true }).click(),
+          )
+          .pipe(Effect.forkChild);
+        yield* hold.started;
+        expect(
+          yield* browser.use("Saving cannot be submitted twice", (page) =>
+            page.getByRole("button", { name: "Save weekly cap", exact: true }).isDisabled(),
+          ),
+        ).toBe(true);
+        yield* hold.release;
+        yield* Fiber.join(saving);
+        yield* browser.use("Confirm the saved cap", (page) =>
+          page.getByText("Cap saved", { exact: false }).waitFor(),
+        );
+        expect(
+          yield* browser.use("Saving returns focus to the original person's edit button", (page) =>
+            page
+              .getByRole("listitem")
+              .filter({ hasText: "admin@example.test" })
+              .getByRole("button", { name: /Change weekly cap/ })
+              .evaluate((button) => button === document.activeElement),
+          ),
+        ).toBe(true);
+        yield* browser.use("Open per-model usage", (page) =>
+          page
+            .getByRole("listitem")
+            .filter({ hasText: "admin@example.test" })
+            .getByRole("button", { name: /Show usage details/ })
+            .click(),
+        );
+        yield* browser.use("Show cost without losing model identity", (page) =>
+          page
+            .getByRole("group", { name: "Chart and list show" })
+            .getByRole("button", { name: "API cost", exact: true })
+            .click(),
+        );
+        // Checkpoints need the settled theme and chevron, without changing product motion.
+        yield* browser.use("Disable transitions only for the screenshot checkpoints", (page) =>
+          page.evaluate(() => {
+            const style = document.createElement("style");
+            style.id = "checkpoint-no-transitions";
+            style.textContent = "*, *::before, *::after { transition: none !important; }";
+            document.head.append(style);
+          }),
+        );
+        for (const width of [1280, 390])
+          for (const theme of ["light", "dark"] as const) {
+            yield* browser.use("Set the native viewport", (page) =>
+              page.setViewportSize({ width, height: 1000 }),
+            );
+            yield* browser.use("Set the colour preference", (page) =>
+              page.emulateMedia({ colorScheme: theme }),
+            );
+            // Start each capture at the section heading; the previous pass left the page scrolled.
+            // Scroll only the content scroller, so the app shell stays in place.
+            yield* browser.use("Show the usage section from its heading", (page) =>
+              page.getByRole("region", { name: "Pool usage", exact: true }).evaluate((section) => {
+                let scroller = section.parentElement;
+                while (scroller && !/(auto|scroll)/.test(getComputedStyle(scroller).overflowY))
+                  scroller = scroller.parentElement;
+                if (scroller)
+                  scroller.scrollTop +=
+                    section.getBoundingClientRect().top - scroller.getBoundingClientRect().top;
+              }),
+            );
+            const layout = yield* browser.use("Inspect pool usage layout", (page) =>
+              page.getByRole("region", { name: "Pool usage", exact: true }).evaluate((section) => ({
+                document: document.documentElement.scrollWidth,
+                viewport: innerWidth,
+                section: section.getBoundingClientRect().width,
+                client: section.clientWidth,
+                scroll: section.scrollWidth,
+                overflow: Array.from(section.querySelectorAll("*")).flatMap((node) => {
+                  const bounds = node.getBoundingClientRect();
+                  return bounds.width > 0 &&
+                    bounds.right > section.getBoundingClientRect().right + 1
+                    ? [
+                        {
+                          tag: node.tagName,
+                          classes: node.className,
+                          width: bounds.width,
+                          right: bounds.right,
+                          text: node.textContent?.slice(0, 120),
+                        },
+                      ]
+                    : [];
+                }),
+              })),
+            );
+            expect(layout.document, JSON.stringify(layout)).toBeLessThanOrEqual(layout.viewport);
+            expect(layout.scroll, JSON.stringify(layout)).toBeLessThanOrEqual(layout.client + 1);
+            yield* browser.checkpoint(`Pool usage ${width}px ${theme}`);
+            yield* browser.use("Inspect the chart and model breakdown", (page) =>
+              page
+                .getByRole("group", { name: "Usage of Test admin", exact: true })
+                .scrollIntoViewIfNeeded(),
+            );
+            yield* browser.checkpoint(`Model breakdown ${width}px ${theme}`);
+          }
+        yield* browser.use("Restore transitions after the checkpoints", (page) =>
+          page.evaluate(() => document.getElementById("checkpoint-no-transitions")?.remove()),
+        );
+        yield* browser.use("Open a second draft", (page) =>
+          page
+            .getByRole("listitem")
+            .filter({ hasText: "admin@example.test" })
+            .getByRole("button", { name: /Change weekly cap/ })
+            .click(),
+        );
+        yield* browser.use("Change the draft", (page) =>
+          page.getByRole("textbox", { name: /Weekly cap for/ }).fill("99"),
+        );
+        yield* browser.use("Cancel the edit", (page) =>
+          page.getByRole("button", { name: "Cancel", exact: true }).press("Enter"),
+        );
+        expect(
+          yield* browser.use("Cancel returns focus to the original person's edit button", (page) =>
+            page
+              .getByRole("listitem")
+              .filter({ hasText: "admin@example.test" })
+              .getByRole("button", { name: /Change weekly cap/ })
+              .evaluate((button) => button === document.activeElement),
+          ),
+        ).toBe(true);
+        expect(
+          yield* browser.use("Cancel keeps the saved cap", (page) =>
+            page.getByRole("listitem").filter({ hasText: "admin@example.test" }).textContent(),
+          ),
+        ).toContain("20.50");
+      }),
+    ),
+  );
+});
