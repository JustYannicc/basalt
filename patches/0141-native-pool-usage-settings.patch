diff --git a/apps/hosted/web/src/implementation/pages/pool-usage-cap.tsx b/apps/hosted/web/src/implementation/pages/pool-usage-cap.tsx
new file mode 100644
index 0000000..f0448ea
--- /dev/null
+++ b/apps/hosted/web/src/implementation/pages/pool-usage-cap.tsx
@@ -0,0 +1,297 @@
+/** A person's weekly cap: its summary, the inline editor and the drafts that survive paging. */
+import { useAtomSet } from "@effect/atom-react";
+import { Exit } from "effect";
+import { useEffect, useId, useRef } from "react";
+import type { AppId } from "@executor-js/sdk";
+import type { OrganizationReference } from "@executor-js/hosted-server/organization";
+import { Button } from "@executor-js/ui/components/button";
+import { Input } from "@executor-js/ui/components/input";
+import { LocalTime } from "@executor-js/ui/components/local-time";
+import { setPoolCapAtom, type PoolUsageMember } from "../../contracts/pool-usage.ts";
+import { appError, type HostedError } from "../../contracts/errors.ts";
+import { SharingFailure } from "../components/sharing.tsx";
+import { resetDay, resetMoment } from "./pool-usage-details.tsx";
+import {
+  capInput,
+  capText,
+  capTone,
+  parseCap,
+  successText,
+  type Formats,
+} from "./pool-usage-format.ts";
+
+/** An unsaved cap change. `attempt` ties a save's answer to the draft that sent it. */
+export interface CapDraft {
+  readonly mode: "none" | "cap";
+  readonly value: string;
+  readonly invalid: boolean;
+  readonly status: "editing" | "saving" | "failed";
+  readonly error?: string | undefined;
+  readonly attempt: number;
+}
+/**
+ * The section keeps every person's draft and last confirmed save, so a draft survives closing the
+ * details or leaving the page, and a save's answer reaches only the person it was sent for.
+ */
+export interface CapEdits {
+  readonly drafts: ReadonlyMap<string, CapDraft>;
+  /** Confirmed saves, shown until the person edits that cap again. */
+  readonly saved: ReadonlyMap<string, { readonly weekly: number | null }>;
+}
+export const noEdits = (): CapEdits => ({ drafts: new Map(), saved: new Map() });
+
+const put = <V,>(map: ReadonlyMap<string, V>, key: string, value: V | undefined) => {
+  const next = new Map(map);
+  if (value === undefined) next.delete(key);
+  else next.set(key, value);
+  return next;
+};
+/** Starting or changing a draft clears the last save's confirmation. */
+export const editDraft = (
+  edits: CapEdits,
+  member: string,
+  change: (draft: CapDraft | undefined) => CapDraft | undefined,
+): CapEdits => ({
+  drafts: put(edits.drafts, member, change(edits.drafts.get(member))),
+  saved: put(edits.saved, member, undefined),
+});
+/** A save's answer applies only to the draft that is still waiting for it. */
+export const settleSave = (
+  edits: CapEdits,
+  member: string,
+  attempt: number,
+  weekly: number | null,
+  exit: Exit.Exit<unknown, HostedError>,
+): CapEdits => {
+  const draft = edits.drafts.get(member);
+  if (draft?.attempt !== attempt || draft.status !== "saving") return edits;
+  return Exit.isSuccess(exit)
+    ? { drafts: put(edits.drafts, member, undefined), saved: put(edits.saved, member, { weekly }) }
+    : {
+        ...edits,
+        drafts: put(edits.drafts, member, {
+          ...draft,
+          status: "failed",
+          error: appError(exit.cause),
+        }),
+      };
+};
+export const savingAny = (edits: CapEdits) =>
+  [...edits.drafts.values()].some((draft) => draft.status === "saving");
+
+export function CapSummary({
+  member,
+  saved,
+  format,
+}: {
+  readonly member: PoolUsageMember;
+  readonly saved: { readonly weekly: number | null } | undefined;
+  readonly format: Formats;
+}) {
+  if (member.owner) return <span className="block">No cap for the pool owner</span>;
+  const cap = member.cap;
+  // A confirmed save shows its own value until the page reads it back, never the old cap.
+  if (saved !== undefined && (cap?.weekly ?? null) !== saved.weekly)
+    return (
+      <span role="status" className="block">
+        <span className={successText}>
+          Saved: {saved.weekly === null ? "no cap" : `${format.cost(saved.weekly)} a week`}
+        </span>{" "}
+        · updating usage…
+      </span>
+    );
+  const confirmation = saved !== undefined && (
+    <span role="status" className={successText}>
+      {" "}
+      · Cap saved
+    </span>
+  );
+  if (cap === null)
+    return (
+      <span className="block">
+        No cap
+        {confirmation}
+      </span>
+    );
+  const tone = capTone(cap);
+  return (
+    <>
+      <span className="block">
+        <span className={capText[tone]}>{format.cost(cap.used)}</span> of {format.cost(cap.weekly)}
+        {confirmation}
+      </span>
+      <span className="block">
+        {tone === "reached" ? (
+          <span className="text-destructive">Cap reached</span>
+        ) : (
+          `${format.cost(cap.remaining)} left`
+        )}{" "}
+        · resets <LocalTime value={cap.resetAt} options={resetDay} title={resetMoment} />
+      </span>
+    </>
+  );
+}
+
+/** The first draft for a person starts from their saved cap. */
+export const openDraft = (member: PoolUsageMember, previous: CapDraft | undefined): CapDraft => ({
+  mode: "cap",
+  value: member.cap === null ? "" : capInput(member.cap.weekly),
+  invalid: false,
+  status: "editing",
+  attempt: previous?.attempt ?? 0,
+});
+
+/**
+ * Normal form controls with explicit Save and Cancel. Saving disables the form, so one draft has at
+ * most one write in flight; a failure keeps the draft for another try.
+ */
+export function CapEditor({
+  organization,
+  app,
+  after,
+  member,
+  label,
+  draft,
+  onDraft,
+  onSettled,
+}: {
+  readonly organization: OrganizationReference;
+  readonly app: AppId;
+  /** The cursor of the page this person is on; a save reads that page again. */
+  readonly after: string | undefined;
+  readonly member: PoolUsageMember;
+  readonly label: string;
+  readonly draft: CapDraft;
+  readonly onDraft: (change: (draft: CapDraft | undefined) => CapDraft | undefined) => void;
+  readonly onSettled: (
+    attempt: number,
+    weekly: number | null,
+    exit: Exit.Exit<unknown, HostedError>,
+  ) => void;
+}) {
+  const id = useId();
+  const amountInput = useRef<HTMLInputElement>(null);
+  const save = useAtomSet(setPoolCapAtom({ organization, app, member: member.member }), {
+    mode: "promiseExit",
+  });
+  useEffect(() => {
+    // Opening replaced the focused "Set cap" control, so focus has nowhere else to be. A draft
+    // shown again with its page leaves focus where the person put it.
+    const active = document.activeElement;
+    if (active === null || active === document.body) amountInput.current?.focus();
+  }, []);
+  const saving = draft.status === "saving";
+  const submit = async () => {
+    if (saving) return;
+    let weekly: number | null = null;
+    if (draft.mode === "cap") {
+      const parsed = parseCap(draft.value);
+      if (parsed === undefined) {
+        onDraft((current) => current && { ...current, invalid: true });
+        amountInput.current?.focus();
+        return;
+      }
+      weekly = parsed;
+    }
+    const attempt = draft.attempt + 1;
+    onDraft(
+      (current) =>
+        current && { ...current, invalid: false, status: "saving", error: undefined, attempt },
+    );
+    onSettled(attempt, weekly, await save({ weekly, after }));
+  };
+  return (
+    <form
+      noValidate
+      aria-busy={saving}
+      className="mx-1 mb-3 grid gap-3 rounded-lg border bg-muted/60 px-4 py-3"
+      onSubmit={(event) => {
+        event.preventDefault();
+        void submit();
+      }}
+    >
+      <fieldset disabled={saving} className="m-0 grid gap-2.5 border-0 p-0">
+        <legend className="mb-2.5 p-0 text-sm font-medium">Weekly cap for {label}</legend>
+        <label className="flex items-center gap-2.5 text-sm">
+          <input
+            type="radio"
+            name={`${id}-mode`}
+            className="size-4 accent-foreground"
+            checked={draft.mode === "none"}
+            onChange={() =>
+              onDraft((current) => current && { ...current, mode: "none", invalid: false })
+            }
+          />
+          No cap
+        </label>
+        <div className="flex flex-wrap items-center gap-x-2.5 gap-y-2 text-sm">
+          <input
+            id={`${id}-cap`}
+            type="radio"
+            name={`${id}-mode`}
+            className="size-4 accent-foreground"
+            checked={draft.mode === "cap"}
+            onChange={() => {
+              onDraft((current) => current && { ...current, mode: "cap" });
+              amountInput.current?.focus();
+            }}
+          />
+          <label htmlFor={`${id}-cap`}>Cap at</label>
+          <span className="relative w-34">
+            <span
+              aria-hidden="true"
+              className="pointer-events-none absolute top-1/2 left-2.5 -translate-y-1/2 text-muted-foreground"
+            >
+              $
+            </span>
+            <Input
+              ref={amountInput}
+              inputMode="decimal"
+              autoComplete="off"
+              className="pl-5.5 tabular-nums"
+              aria-label={`Weekly cap for ${label}, in US dollars`}
+              aria-invalid={draft.invalid || undefined}
+              aria-describedby={draft.invalid ? `${id}-invalid` : undefined}
+              value={draft.value}
+              onChange={(event) => {
+                const value = event.target.value;
+                // Typing an amount means capping, whichever option was chosen before.
+                onDraft((current) => current && { ...current, value, mode: "cap", invalid: false });
+              }}
+            />
+          </span>
+          <span className="text-muted-foreground">a week</span>
+          {draft.invalid && (
+            <span
+              id={`${id}-invalid`}
+              role="alert"
+              className="basis-full pl-6.5 text-xs text-destructive"
+            >
+              Enter an amount from $0.01 to $100,000, to the cent.
+            </span>
+          )}
+        </div>
+      </fieldset>
+      {draft.status === "failed" && draft.error !== undefined && (
+        <SharingFailure
+          title="Cap not saved"
+          message={`${draft.error} Your change is kept; save again to retry.`}
+        />
+      )}
+      <div className="flex flex-wrap items-center gap-3">
+        <Button type="submit" size="sm" loading={saving} aria-label="Save weekly cap">
+          Save
+        </Button>
+        <Button
+          type="button"
+          variant="outline"
+          size="sm"
+          disabled={saving}
+          onClick={() => onDraft(() => undefined)}
+        >
+          Cancel
+        </Button>
+      </div>
+    </form>
+  );
+}
diff --git a/apps/hosted/web/src/implementation/pages/pool-usage-details.tsx b/apps/hosted/web/src/implementation/pages/pool-usage-details.tsx
new file mode 100644
index 0000000..d13c1a9
--- /dev/null
+++ b/apps/hosted/web/src/implementation/pages/pool-usage-details.tsx
@@ -0,0 +1,333 @@
+/** One person's pool usage: a daily chart by model, the per-model list and their weekly cap. */
+import { LocalTime } from "@executor-js/ui/components/local-time";
+import type { PoolUsageMember } from "../../contracts/pool-usage.ts";
+import {
+  amount,
+  capBar,
+  capText,
+  capTone,
+  chartColumns,
+  chartSeries,
+  dayRange,
+  modelKey,
+  modelShade,
+  otherShade,
+  providerName,
+  rankModels,
+  share,
+  type Cap,
+  type Formats,
+  type Metric,
+  type ModelUsage,
+} from "./pool-usage-format.ts";
+
+const percent = (fraction: number) => `${Math.round(fraction * 10_000) / 100}%`;
+/** Reset moments read in the reader's own time zone, with the exact time on hover. */
+export const resetDay: Intl.DateTimeFormatOptions = {
+  weekday: "short",
+  day: "numeric",
+  month: "short",
+};
+export const resetMoment: Intl.DateTimeFormatOptions = {
+  ...resetDay,
+  hour: "numeric",
+  minute: "2-digit",
+  timeZoneName: "short",
+};
+
+export function PoolMemberDetails({
+  id,
+  label,
+  member,
+  from,
+  to,
+  metric,
+  onMetric,
+  format,
+}: {
+  readonly id: string;
+  readonly label: string;
+  readonly member: PoolUsageMember;
+  readonly from: string;
+  readonly to: string;
+  readonly metric: Metric;
+  readonly onMetric: (metric: Metric) => void;
+  readonly format: Formats;
+}) {
+  const { tokens } = member;
+  return (
+    <div id={id} role="group" aria-label={`Usage of ${label}`} className="grid gap-4 px-1 pb-4">
+      <div className="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
+        <MetricSwitch metric={metric} onChange={onMetric} />
+        <span className="text-xs text-muted-foreground tabular-nums">
+          {format.tokens(tokens.input)} input · {format.tokens(tokens.cacheRead)} cached ·{" "}
+          {format.tokens(tokens.cacheWrite)} cache writes · {format.tokens(tokens.output)} output
+        </span>
+      </div>
+      {member.cap !== null && <CapMeter cap={member.cap} format={format} />}
+      <UsageChart member={member} from={from} to={to} metric={metric} format={format} />
+      <ModelList
+        models={member.models}
+        total={amount(member, metric)}
+        metric={metric}
+        format={format}
+      />
+    </div>
+  );
+}
+
+function MetricSwitch({
+  metric,
+  onChange,
+}: {
+  readonly metric: Metric;
+  readonly onChange: (metric: Metric) => void;
+}) {
+  const options = [
+    { id: "tokens", label: "Tokens" },
+    { id: "cost", label: "API cost" },
+  ] as const;
+  return (
+    <div
+      role="group"
+      aria-label="Chart and list show"
+      className="inline-flex h-8 w-fit rounded-md border p-0.5 max-[740px]:h-11"
+    >
+      {options.map((option) => (
+        // A two-state toggle reads as pressed or not, so plain buttons keep Tab order simple.
+        <button
+          key={option.id}
+          type="button"
+          aria-pressed={metric === option.id}
+          onClick={() => onChange(option.id)}
+          className="rounded-[4px] px-3 text-xs font-medium text-muted-foreground outline-none transition-colors hover:text-foreground focus-visible:ring-[3px] focus-visible:ring-ring/50 aria-pressed:bg-accent aria-pressed:text-foreground"
+        >
+          {option.label}
+        </button>
+      ))}
+    </div>
+  );
+}
+
+function CapMeter({ cap, format }: { readonly cap: Cap; readonly format: Formats }) {
+  const tone = capTone(cap);
+  const left = share(cap.remaining, cap.weekly);
+  const remaining = format.cost(Math.max(0, cap.remaining));
+  return (
+    <div className="grid gap-2 rounded-md border px-4 py-3">
+      <div className="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5 text-sm">
+        <span className="font-medium">Weekly cap</span>
+        <span className="text-xs text-muted-foreground tabular-nums">
+          {tone === "reached" ? (
+            <span className={capText.reached}>Cap reached</span>
+          ) : (
+            <>
+              <span className={capText[tone]}>{remaining}</span> of {format.cost(cap.weekly)} left
+            </>
+          )}{" "}
+          · {format.cost(cap.used)} used · resets{" "}
+          <LocalTime value={cap.resetAt} options={resetMoment} />
+        </span>
+      </div>
+      <div
+        role="meter"
+        aria-label="Weekly cap left"
+        aria-valuemin={0}
+        aria-valuemax={100}
+        aria-valuenow={Math.round(left * 100)}
+        aria-valuetext={`${remaining} of ${format.cost(cap.weekly)} left`}
+        className={`h-1.5 rounded-full ${tone === "reached" ? "bg-destructive/20" : "bg-accent"}`}
+      >
+        <div className={`h-full rounded-full ${capBar[tone]}`} style={{ width: percent(left) }} />
+      </div>
+    </div>
+  );
+}
+
+function Swatch({ className }: { readonly className: string }) {
+  return <span aria-hidden="true" className={`size-2 shrink-0 rounded-[2px] ${className}`} />;
+}
+
+function UsageChart({
+  member,
+  from,
+  to,
+  metric,
+  format,
+}: {
+  readonly member: PoolUsageMember;
+  readonly from: string;
+  readonly to: string;
+  readonly metric: Metric;
+  readonly format: Formats;
+}) {
+  const range = dayRange(from, to);
+  const first = range[0];
+  const last = range.at(-1);
+  const { top, other } = chartSeries(member.models, metric);
+  const keys = top.map(modelKey);
+  const shadeOf = new Map(top.map((model) => [modelKey(model), modelShade(model)]));
+  const columns = chartColumns(member.days, range, keys, metric);
+  const peak = Math.max(0, ...columns.map((column) => column.total));
+  const metricLabel = metric === "tokens" ? "Tokens" : "API cost";
+  if (peak === 0)
+    return (
+      <p className="text-sm text-muted-foreground">
+        {metric === "cost"
+          ? "None of these requests has a known API price."
+          : "No tokens recorded in this period."}
+      </p>
+    );
+  return (
+    <figure className="m-0 grid gap-2">
+      <div
+        aria-hidden="true"
+        className="grid h-28 grid-flow-col items-end gap-[3px] border-b"
+        style={{ gridAutoColumns: "minmax(0, 1fr)" }}
+      >
+        {columns.map((column) => (
+          <div
+            key={column.day}
+            className="flex h-full flex-col-reverse rounded-t-[2px] [@media(pointer:fine)]:hover:bg-accent/60"
+            title={`${format.day(column.day)}: ${format.metric(column.total, metric)}`}
+          >
+            {column.parts.map((part) => (
+              <div
+                key={part.key}
+                className={`w-full last:rounded-t-[2px] ${shadeOf.get(part.key) ?? otherShade}`}
+                style={{ height: percent(part.amount / peak) }}
+              />
+            ))}
+          </div>
+        ))}
+      </div>
+      <div
+        aria-hidden="true"
+        className="flex justify-between text-xs text-muted-foreground tabular-nums"
+      >
+        <span>{first !== undefined && format.day(first)}</span>
+        <span>{last !== undefined && format.day(last)}</span>
+      </div>
+      <figcaption className="flex flex-wrap gap-x-4 gap-y-1 text-xs text-muted-foreground">
+        <span className="sr-only">{metricLabel} per day by model:</span>
+        {top.map((model) => (
+          <span key={modelKey(model)} className="inline-flex min-w-0 items-center gap-1.5">
+            <Swatch className={modelShade(model)} />
+            <span className="truncate" title={`${model.model} · ${providerName(model.provider)}`}>
+              {model.model}
+            </span>
+          </span>
+        ))}
+        {other && (
+          <span className="inline-flex items-center gap-1.5">
+            <Swatch className={otherShade} />
+            Other models
+          </span>
+        )}
+      </figcaption>
+      {/* The wrapper clips the table's minimum width without hiding its accessible rows. */}
+      <div className="sr-only">
+        <table>
+          <caption>{metricLabel} per day</caption>
+          <thead>
+            <tr>
+              <th scope="col">Day</th>
+              <th scope="col">Total</th>
+              {top.map((model) => (
+                <th key={modelKey(model)} scope="col">
+                  {model.model}
+                </th>
+              ))}
+              {other && <th scope="col">Other models</th>}
+            </tr>
+          </thead>
+          <tbody>
+            {columns
+              .filter((column) => column.total > 0)
+              .map((column) => (
+                <tr key={column.day}>
+                  <th scope="row">{format.day(column.day)}</th>
+                  <td>{format.metric(column.total, metric)}</td>
+                  {keys.map((key) => (
+                    <td key={key}>
+                      {format.metric(
+                        column.parts.find((part) => part.key === key)?.amount ?? 0,
+                        metric,
+                      )}
+                    </td>
+                  ))}
+                  {other && (
+                    <td>
+                      {format.metric(
+                        column.parts.find((part) => part.key === "")?.amount ?? 0,
+                        metric,
+                      )}
+                    </td>
+                  )}
+                </tr>
+              ))}
+          </tbody>
+        </table>
+      </div>
+    </figure>
+  );
+}
+
+function ModelList({
+  models,
+  total,
+  metric,
+  format,
+}: {
+  readonly models: readonly ModelUsage[];
+  readonly total: number;
+  readonly metric: Metric;
+  readonly format: Formats;
+}) {
+  if (models.length === 0) return null;
+  return (
+    <div className="grid gap-1">
+      <h3 className="text-sm font-medium">By model</h3>
+      <ul aria-label="By model" className="m-0 list-none border-t p-0">
+        {rankModels(models, metric).map((model) => {
+          const value = amount(model, metric);
+          return (
+            <li
+              key={modelKey(model)}
+              className="grid grid-cols-[minmax(0,12rem)_1fr_minmax(9rem,auto)] items-center gap-x-6 gap-y-1.5 border-b px-1 py-2.5 max-[740px]:grid-cols-[minmax(0,1fr)_auto]"
+            >
+              <div className="min-w-0">
+                <span className="block truncate font-medium" title={model.model}>
+                  {model.model}
+                </span>
+                <span className="flex items-center gap-1.5 text-xs text-muted-foreground">
+                  <Swatch className={modelShade(model)} />
+                  {providerName(model.provider)}
+                </span>
+              </div>
+              <div
+                aria-hidden="true"
+                className="h-1.5 rounded-full bg-accent max-[740px]:order-last max-[740px]:col-span-2"
+              >
+                <div
+                  className={`h-full rounded-full ${modelShade(model)}`}
+                  style={{ width: percent(share(value, total)) }}
+                />
+              </div>
+              <span className="text-right text-xs text-muted-foreground tabular-nums">
+                <span className="font-medium text-foreground">{format.metric(value, metric)}</span>
+                {" · "}
+                {metric === "tokens"
+                  ? `${format.cost(model.cost)} API cost`
+                  : `${format.tokens(model.tokens.total)} tokens`}
+                {" · "}
+                {format.count(model.requests)} {model.requests === 1 ? "request" : "requests"}
+                {model.unpriced > 0 && <> · {format.count(model.unpriced)} unpriced</>}
+              </span>
+            </li>
+          );
+        })}
+      </ul>
+    </div>
+  );
+}
diff --git a/apps/hosted/web/src/implementation/pages/pool-usage-format.ts b/apps/hosted/web/src/implementation/pages/pool-usage-format.ts
new file mode 100644
index 0000000..a555958
--- /dev/null
+++ b/apps/hosted/web/src/implementation/pages/pool-usage-format.ts
@@ -0,0 +1,214 @@
+/**
+ * Formatting, chart series and model colours for pool usage in Settings. The pool's own usage view
+ * formats the same backend data the same way; it ships separately, so nothing is shared at runtime.
+ */
+import { Schema } from "effect";
+import { WeeklyPoolCap } from "@executor-js/hosted-server/pool-usage";
+import { formatMoment } from "@executor-js/ui/hooks/display-format";
+import type { DisplayFormat } from "@executor-js/ui/contracts/display";
+import type { PoolUsageMember } from "../../contracts/pool-usage.ts";
+
+export type Metric = "tokens" | "cost";
+type Usage = Pick<PoolUsageMember, "requests" | "cost" | "unpriced" | "tokens">;
+export type ModelUsage = PoolUsageMember["models"][number];
+export type DayUsage = PoolUsageMember["days"][number];
+export type Cap = NonNullable<PoolUsageMember["cap"]>;
+
+/** Number and day formats in the reader's locale. Days are UTC calendar days, as the backend counts. */
+export const formats = (format: DisplayFormat) => {
+  const compact = new Intl.NumberFormat(format.locale, {
+    notation: "compact",
+    maximumFractionDigits: 1,
+  });
+  const dollars = new Intl.NumberFormat(format.locale, {
+    style: "currency",
+    currency: "USD",
+    minimumFractionDigits: 2,
+    maximumFractionDigits: 2,
+  });
+  const whole = new Intl.NumberFormat(format.locale);
+  const tokens = (value: number) => compact.format(Math.max(0, value));
+  // Under a cent reads "<$0.01" so a small spend never looks free.
+  const cost = (value: number) =>
+    value <= 0
+      ? dollars.format(0)
+      : value < 0.01
+        ? `<${dollars.format(0.01)}`
+        : dollars.format(value);
+  const day = (value: string) => {
+    const at = Date.parse(`${value}T00:00:00Z`);
+    return Number.isNaN(at)
+      ? value
+      : formatMoment(at, format, { day: "numeric", month: "short", timeZone: "UTC" });
+  };
+  return {
+    tokens,
+    cost,
+    count: (value: number) => whole.format(value),
+    day,
+    metric: (amount: number, metric: Metric) =>
+      metric === "tokens" ? tokens(amount) : cost(amount),
+  };
+};
+export type Formats = ReturnType<typeof formats>;
+
+export const amount = (usage: Usage, metric: Metric) =>
+  metric === "tokens" ? usage.tokens.total : usage.cost;
+
+/** Every UTC day from `from` up to `to`, so the chart keeps the days nobody used. */
+export const dayRange = (from: string, to: string): readonly string[] => {
+  const start = Date.parse(from);
+  const end = Date.parse(to);
+  if (Number.isNaN(start) || Number.isNaN(end)) return [];
+  const first = new Date(start);
+  const days: string[] = [];
+  for (
+    let at = Date.UTC(first.getUTCFullYear(), first.getUTCMonth(), first.getUTCDate());
+    at < end && days.length < 31;
+    at += 86_400_000
+  )
+    days.push(new Date(at).toISOString().slice(0, 10));
+  return days;
+};
+
+/** One model through one provider; the same model name can come through two. */
+export const modelKey = (model: Pick<ModelUsage, "provider" | "model">) =>
+  `${model.provider}:${model.model}`;
+
+/** Biggest first by the chosen metric, then by name, so ties never reorder between reads. */
+export const rankModels = (models: readonly ModelUsage[], metric: Metric) =>
+  [...models].sort(
+    (left, right) =>
+      amount(right, metric) - amount(left, metric) || left.model.localeCompare(right.model),
+  );
+
+/** The biggest models get their own series; the rest fold into Other. */
+export const chartSeries = (models: readonly ModelUsage[], metric: Metric, limit = 4) => {
+  const ranked = rankModels(models, metric).filter((model) => amount(model, metric) > 0);
+  return { top: ranked.slice(0, limit), other: ranked.length > limit };
+};
+
+export interface Column {
+  readonly day: string;
+  readonly total: number;
+  /** Per model key, then "" for Other models when any remain. */
+  readonly parts: readonly { readonly key: string; readonly amount: number }[];
+}
+export const chartColumns = (
+  days: readonly DayUsage[],
+  range: readonly string[],
+  keys: readonly string[],
+  metric: Metric,
+): readonly Column[] => {
+  const byDay = new Map(days.map((day) => [day.day, day]));
+  return range.map((day) => {
+    const usage = byDay.get(day);
+    if (usage === undefined) return { day, total: 0, parts: [] };
+    const parts = keys.map((key) => ({
+      key,
+      amount: usage.models
+        .filter((model) => modelKey(model) === key)
+        .reduce((sum, model) => sum + amount(model, metric), 0),
+    }));
+    const named = parts.reduce((sum, part) => sum + part.amount, 0);
+    const total = amount(usage, metric);
+    return {
+      day,
+      total,
+      parts: total - named > 1e-9 ? [...parts, { key: "", amount: total - named }] : parts,
+    };
+  });
+};
+
+export const share = (part: number, whole: number) =>
+  whole > 0 ? Math.min(1, Math.max(0, part / whole)) : 0;
+
+/**
+ * Provider ids are the pool backend's own. Two are named here because their product names differ
+ * from their ids; any other id is shown as sent rather than guessed.
+ */
+const providerNames: Readonly<Record<string, string>> = { claude: "Claude", codex: "ChatGPT" };
+export const providerName = (provider: string) => providerNames[provider] ?? provider;
+
+type Lab = "anthropic" | "openai" | "google" | "other";
+/**
+ * The model's maker decides its colour family, read from the model name first because one
+ * provider can serve another lab's models. An unrecognised model gets a neutral colour.
+ */
+const lab = (model: ModelUsage): Lab => {
+  const name = model.model.toLowerCase();
+  if (name.startsWith("claude")) return "anthropic";
+  if (/^(gpt|chatgpt|codex|o\d)/.test(name)) return "openai";
+  if (name.startsWith("gemini")) return "google";
+  if (model.provider === "claude") return "anthropic";
+  if (model.provider === "codex") return "openai";
+  return "other";
+};
+// Tailwind only sees complete class names, so every shade is written out. Light and dark pairs keep
+// the same order. Claude is orange; OpenAI is black on light and white on dark.
+const shades: Readonly<Record<Lab, readonly string[]>> = {
+  anthropic: [
+    "bg-[#b95533] dark:bg-[#f1b198]",
+    "bg-[#d97757] dark:bg-[#d97757]",
+    "bg-[#9f705c] dark:bg-[#a36e58]",
+    "bg-[#e8a487] dark:bg-[#c25f3c]",
+  ],
+  openai: [
+    "bg-[#111111] dark:bg-[#f5f5f5]",
+    "bg-[#626262] dark:bg-[#b2b2b2]",
+    "bg-[#3a3a3a] dark:bg-[#dcdcdc]",
+  ],
+  google: ["bg-[#1a73e8] dark:bg-[#8ab4f8]", "bg-[#5e97f6] dark:bg-[#aecbfa]"],
+  other: ["bg-slate-500 dark:bg-slate-400", "bg-stone-500 dark:bg-stone-400"],
+};
+/** Models outside the chart's named series. */
+export const otherShade = "bg-muted-foreground/35";
+
+const hash = (text: string) => {
+  let value = 0;
+  for (const char of text) value = (value * 31 + char.charCodeAt(0)) >>> 0;
+  return value;
+};
+/**
+ * A model keeps one colour wherever it appears, whatever its rank, page or metric: the shade
+ * comes from its name alone. Known tiers get fixed shades; the rest are spread by a stable hash.
+ */
+export const modelShade = (model: ModelUsage) => {
+  const family = lab(model);
+  const palette = shades[family];
+  const name = model.model.toLowerCase();
+  const tier =
+    family === "anthropic"
+      ? ["opus", "sonnet", "haiku"].findIndex((word) => name.includes(word))
+      : family === "openai" && /mini|nano|luna/.test(name)
+        ? 1
+        : -1;
+  return palette[tier >= 0 ? tier : hash(modelKey(model)) % palette.length] ?? otherShade;
+};
+
+/** Spent, close to spent, or within the cap. Close means under 15% of the cap left. */
+export type CapTone = "reached" | "low" | "ok";
+export const capTone = (cap: Cap): CapTone =>
+  cap.remaining <= 0 ? "reached" : cap.remaining / cap.weekly < 0.15 ? "low" : "ok";
+export const capText: Readonly<Record<CapTone, string>> = {
+  reached: "font-medium text-destructive",
+  low: "font-medium text-amber-700 dark:text-amber-400",
+  ok: "font-medium text-foreground",
+};
+export const capBar: Readonly<Record<CapTone, string>> = {
+  reached: "bg-destructive",
+  low: "bg-amber-500 dark:bg-amber-400",
+  ok: "bg-emerald-600 dark:bg-emerald-400",
+};
+export const successText = "text-emerald-700 dark:text-emerald-400";
+
+/** Dollars a week as typed: positive, to the cent, at most the backend's limit. */
+export const parseCap = (text: string): number | undefined => {
+  const plain = text.replace(/[$,\s]/g, "");
+  if (!/^\d+(\.\d{1,2})?$/.test(plain)) return undefined;
+  const value = Number(plain);
+  return Schema.is(WeeklyPoolCap)(value) ? value : undefined;
+};
+/** The saved cap as an editable amount, such as "50" or "12.50". */
+export const capInput = (weekly: number) =>
+  Number.isInteger(weekly) ? String(weekly) : weekly.toFixed(2);
