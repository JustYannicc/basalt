@@ -0,0 +1,303 @@
+/** Pool usage and weekly caps in an app's Settings. Ordinary apps answer null and show nothing. */
+import { useAtomValue } from "@effect/atom-react";
+import { Option } from "effect";
+import { AsyncResult } from "effect/reactivity";
+import { useEffect, useId, useRef, useState } from "react";
+import type { AppId } from "@executor-js/sdk";
+import { Button } from "@executor-js/ui/components/button";
+import { LocalTime } from "@executor-js/ui/components/local-time";
+import { useQuery } from "@executor-js/ui/dashboard/context";
+import { useDisplayFormat } from "@executor-js/ui/hooks/display-format";
+import { sessionAtom } from "../../contracts/auth.ts";
+import { poolUsagePageAtom, type PoolUsagePage } from "../../contracts/pool-usage.ts";
+import { HostedFailure } from "../components/dashboard-bindings.tsx";
+import { useOrganizationRoute } from "../components/organization.tsx";
+import { editDraft, noEdits, savingAny, settleSave } from "./pool-usage-cap.tsx";
+import { dayRange, formats, type Formats, type Metric } from "./pool-usage-format.ts";
+import { PoolMemberRow, rowColumns } from "./pool-usage-row.tsx";
+
+/** A page is its cursor and how many people came before it, in the backend's order. */
+interface PageEntry {
+  readonly after: string | undefined;
+  readonly offset: number;
+}
+
+/**
+ * Managers only: the read requires manage access. `canUse` is the caller's own app access, which
+ * says whether managing this pool also lets them use it.
+ */
+export function PoolUsageSection({
+  app,
+  canUse,
+}: {
+  readonly app: AppId;
+  readonly canUse: boolean;
+}) {
+  const { organization } = useOrganizationRoute();
+  const format = formats(useDisplayFormat());
+  const session = AsyncResult.value(useAtomValue(sessionAtom));
+  const viewer = Option.isSome(session) ? session.value?.user.id : undefined;
+  const titleId = useId();
+
+  // Every page stays reachable: Next pushes the backend's cursor, Previous pops back to the last.
+  const [pages, setPages] = useState<readonly [PageEntry, ...PageEntry[]]>(() => [
+    { after: undefined, offset: 0 },
+  ]);
+  const current = pages[pages.length - 1] ?? pages[0];
+  const query = useQuery(poolUsagePageAtom({ organization, app, after: current.after }));
+  const result = query.result;
+  const loaded = Option.getOrUndefined(query.data);
+  const failed = AsyncResult.isFailure(result);
+
+  // While the next page loads, the page being left stays in view, marked busy, not a skeleton.
+  const [shown, setShown] = useState<{ readonly entry: PageEntry; readonly page: PoolUsagePage }>();
+  if (loaded != null && (shown?.page !== loaded || shown.entry !== current))
+    setShown({ entry: current, page: loaded });
+  const paging = loaded === undefined && !failed && shown !== undefined && shown.entry !== current;
+  const page = loaded ?? (paging ? shown?.page : undefined);
+  const rowsAfter = paging ? shown?.entry.after : current.after;
+
+  const [edits, setEdits] = useState(noEdits);
+  const [expanded, setExpanded] = useState<ReadonlySet<string>>(() => new Set());
+  const [metrics, setMetrics] = useState<ReadonlyMap<string, Metric>>(() => new Map());
+  const saving = savingAny(edits);
+
+  // A new page moves focus to the heading, so keyboard focus is not left on a control that just
+  // disappeared or became disabled.
+  const heading = useRef<HTMLHeadingElement>(null);
+  const moved = useRef(false);
+  useEffect(() => {
+    if (!moved.current || loaded == null) return;
+    moved.current = false;
+    heading.current?.focus();
+  }, [loaded]);
+  const go = (next: readonly [PageEntry, ...PageEntry[]]) => {
+    moved.current = true;
+    setPages(next);
+  };
+
+  if (loaded === null) return null;
+  // An app's first read shows nothing until it says the app is a pool, so ordinary apps never
+  // flash a pool section.
+  if (page === undefined && !failed) return null;
+
+  const busyReason = saving ? "Wait for the cap to finish saving." : undefined;
+  const range = page === undefined ? null : rangeOf(page);
+  return (
+    <section aria-labelledby={titleId} className="rounded-lg border p-5">
+      <div className="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
+        <h2 ref={heading} id={titleId} tabIndex={-1} className="text-base font-medium outline-none">
+          Pool usage
+        </h2>
+        {page !== undefined && (
+          <span className="text-xs text-muted-foreground tabular-nums">
+            {range !== null && (
+              <>
+                Last {format.count(range.days)} days · {format.day(range.first)} –{" "}
+                {format.day(range.last)}
+              </>
+            )}
+            {page.readAt !== null && (
+              <>
+                {range !== null && " · "}as of{" "}
+                <LocalTime
+                  value={page.readAt}
+                  options={{ hour: "numeric", minute: "2-digit" }}
+                  title={{ dateStyle: "medium", timeStyle: "long" }}
+                />
+              </>
+            )}
+            {loaded !== undefined && result.waiting && <span role="status"> · updating…</span>}
+          </span>
+        )}
+      </div>
+      <p className="mt-2 max-w-xl text-sm text-pretty text-muted-foreground">
+        Each person&apos;s requests through this pool. API cost is what the same tokens would cost
+        at the providers&apos; API prices; unpriced requests used a model without a known price. A
+        weekly cap stops a person&apos;s requests through this pool until it resets.
+      </p>
+      {!canUse &&
+        page !== undefined &&
+        !page.members.some((member) => member.member === viewer) && (
+          <p className="mt-3 text-xs text-muted-foreground">
+            You manage this pool but can&apos;t use it. Managing it doesn&apos;t let you send
+            requests through it or use its accounts.
+          </p>
+        )}
+      {failed && (
+        <div className="mt-4">
+          <HostedFailure
+            cause={result.cause}
+            retry={query.refresh}
+            retrying={result.waiting}
+            layout={page === undefined ? undefined : "compact"}
+          />
+        </div>
+      )}
+      {page !== undefined &&
+        (page.members.length === 0 && current.offset === 0 ? (
+          <p className="mt-4 rounded-lg border border-dashed p-6 text-sm text-pretty text-muted-foreground">
+            {page.native
+              ? "Nobody can use this pool yet. Choose who can under App access."
+              : "Nobody can use this pool yet."}
+          </p>
+        ) : (
+          <>
+            <Totals
+              page={page}
+              offset={(paging ? shown?.entry.offset : undefined) ?? current.offset}
+              paged={pages.length > 1 || page.next !== null}
+              format={format}
+            />
+            <div
+              aria-hidden="true"
+              className={`${rowColumns} mt-4 px-1 pb-2 text-xs text-muted-foreground max-[740px]:hidden`}
+            >
+              <span>Person</span>
+              <span className="text-right">Requests</span>
+              <span className="text-right">Tokens</span>
+              <span className="text-right">API cost</span>
+              <span>Weekly cap</span>
+              <span />
+            </div>
+            <ul
+              aria-label="People who can use this pool"
+              aria-busy={paging}
+              inert={paging}
+              className={`m-0 list-none border-t p-0 max-[740px]:mt-4 ${paging ? "opacity-60" : ""}`}
+            >
+              {page.members.map((member) => (
+                <PoolMemberRow
+                  key={member.member}
+                  organization={organization}
+                  app={app}
+                  after={rowsAfter}
+                  member={member}
+                  you={member.member === viewer}
+                  expanded={expanded.has(member.member)}
+                  onToggle={() =>
+                    setExpanded((open) => {
+                      const next = new Set(open);
+                      if (!next.delete(member.member)) next.add(member.member);
+                      return next;
+                    })
+                  }
+                  metric={metrics.get(member.member) ?? "tokens"}
+                  onMetric={(metric) =>
+                    setMetrics((all) => new Map(all).set(member.member, metric))
+                  }
+                  draft={edits.drafts.get(member.member)}
+                  onDraft={(change) => setEdits((all) => editDraft(all, member.member, change))}
+                  onSettled={(attempt, weekly, exit) =>
+                    setEdits((all) => settleSave(all, member.member, attempt, weekly, exit))
+                  }
+                  saved={edits.saved.get(member.member)}
+                  from={page.from}
+                  to={page.to}
+                  format={format}
+                />
+              ))}
+            </ul>
+          </>
+        ))}
+      {(pages.length > 1 || loaded?.next != null) && (
+        <nav
+          aria-label="Pool usage pages"
+          className="mt-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-2"
+        >
+          <span role="status" className="text-xs text-muted-foreground tabular-nums">
+            {paging
+              ? `Loading people from ${format.count(current.offset + 1)}…`
+              : loaded !== undefined && loaded.members.length > 0
+                ? `People ${format.count(current.offset + 1)}–${format.count(current.offset + loaded.members.length)}`
+                : null}
+          </span>
+          <div className="flex gap-2">
+            <Button
+              type="button"
+              variant="outline"
+              size="sm"
+              disabled={pages.length < 2 || paging}
+              disabledReason={busyReason}
+              onClick={() => {
+                const [first, ...rest] = pages;
+                go([first, ...rest.slice(0, -1)]);
+              }}
+            >
+              Previous
+            </Button>
+            <Button
+              type="button"
+              variant="outline"
+              size="sm"
+              disabled={loaded?.next == null}
+              disabledReason={busyReason}
+              onClick={() => {
+                if (loaded?.next == null) return;
+                go([
+                  ...pages,
+                  { after: loaded.next, offset: current.offset + loaded.members.length },
+                ]);
+              }}
+            >
+              Next
+            </Button>
+          </div>
+        </nav>
+      )}
+    </section>
+  );
+}
+
+/** The backend's own interval as UTC days; the last one is the day still in progress. */
+const rangeOf = (page: PoolUsagePage) => {
+  const days = dayRange(page.from, page.to);
+  const first = days[0];
+  const last = days.at(-1);
+  return first === undefined || last === undefined ? null : { days: days.length, first, last };
+};
+
+/** What the listed people used, summed from the backend's per-person totals. */
+function Totals({
+  page,
+  offset,
+  paged,
+  format,
+}: {
+  readonly page: PoolUsagePage;
+  readonly offset: number;
+  readonly paged: boolean;
+  readonly format: Formats;
+}) {
+  const sum = page.members.reduce(
+    (total, member) => ({
+      requests: total.requests + member.requests,
+      tokens: total.tokens + member.tokens.total,
+      cost: total.cost + member.cost,
+      unpriced: total.unpriced + member.unpriced,
+      active: total.active + (member.requests > 0 ? 1 : 0),
+    }),
+    { requests: 0, tokens: 0, cost: 0, unpriced: 0, active: 0 },
+  );
+  const people = page.members.length;
+  return (
+    <p className="mt-4 text-sm text-muted-foreground tabular-nums">
+      {paged ? (
+        <>
+          Of people {format.count(offset + 1)}–{format.count(offset + people)},{" "}
+          <span className="font-medium text-foreground">{format.count(sum.active)}</span> used it
+        </>
+      ) : (
+        <>
+          <span className="font-medium text-foreground">
+            {format.count(sum.active)} of {format.count(people)}
+          </span>{" "}
+          {people === 1 ? "person" : "people"} used it
+        </>
+      )}{" "}
+      · {format.count(sum.requests)} {sum.requests === 1 ? "request" : "requests"} ·{" "}
+      {format.tokens(sum.tokens)} tokens · {format.cost(sum.cost)} API cost
+      {sum.unpriced > 0 && <> · {format.count(sum.unpriced)} unpriced</>}
+    </p>
+  );
+}
