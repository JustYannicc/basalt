+import { Effect, Schema } from "effect";
+import { Actors } from "./actors.ts";
+import { Api, body, type Session } from "./api.ts";
+import { appsManifest } from "./apps-release.ts";
+import { App } from "./contracts.ts";
+import { poolUsageBackend } from "./pool-usage-backend.ts";
+
+const source = `import {defineApp,query,object,router} from "apps";
+export default defineApp({},{tools:router({identity:query({input:object({})},async()=>"allowed")})});`;
+
+/** Both UI journeys deploy actual apps and boot them over the same retained pool format. */
+export const poolUsageUiFixture = Effect.gen(function* () {
+  const api = yield* Api,
+    actors = yield* Actors,
+    backend = yield* poolUsageBackend;
+  const prefix = `/api/organizations/${actors.organization.id}`;
+  const read = <A>(
+    schema: Schema.ConstraintDecoder<A, never>,
+    ...args: Parameters<typeof api.request>
+  ) => api.request(...args).pipe(Effect.flatMap((response) => body(schema, response)));
+  const deploy = (actor: Session, name: string) =>
+    read(App, actor, "POST", `${prefix}/apps/deploy`, {
+      name,
+      files: [{ path: "index.ts", content: source }, appsManifest],
+    });
+  const identities = yield* Effect.forEach([actors.owner, actors.admin, actors.member], (actor) =>
+    read(Schema.Struct({ userId: Schema.String }), actor, "GET", "/api/viewer"),
+  );
+  const [owner, admin, person] = identities.map((value) => value.userId);
+  if (owner === undefined || admin === undefined || person === undefined)
+    return yield* Effect.die("Missing pool UI actors");
+  const retained = (pools: readonly { readonly owner: string; readonly app: string }[]) => ({
+    sql: `update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb), '{basaltPools}', $1::jsonb)::text where id = $2`,
+    params: [
+      JSON.stringify(
+        Object.fromEntries(
+          pools.map((pool) => [
+            pool.owner,
+            { app: pool.app, version: "retained-version", authorization: "executor-app-v1" },
+          ]),
+        ),
+      ),
+      actors.organization.id,
+    ],
+  });
+  // The real actors must stay on page one regardless of their randomly assigned IDs.
+  const seedPrefix = `${[owner, admin, person].sort().at(-1)}-pool-ui-`;
+  const paging = [
+    {
+      sql: `insert into "user" (id, name, email, "emailVerified", "createdAt", "updatedAt")
+        select $1 || lpad(n::text, 3, '0'), 'Pool UI person ' || n,
+          'pool-ui-person-' || n || '@example.test', true, now(), now()
+        from generate_series(1, 101) n`,
+      params: [seedPrefix],
+    },
+    {
+      sql: `insert into member (id, "organizationId", "userId", role, "createdAt")
+        select $1 || 'member-' || n, $2, $1 || lpad(n::text, 3, '0'), 'member', now()
+        from generate_series(1, 101) n`,
+      params: [seedPrefix, actors.organization.id],
+    },
+  ];
+  return { api, actors, backend, prefix, read, deploy, owner, admin, person, retained, paging };
+});
