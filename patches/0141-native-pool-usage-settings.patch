+/** One person in a pool's usage list: their totals, weekly cap and expandable details. */
+import type { Exit } from "effect";
+import { useEffect, useId, useRef } from "react";
+import { HugeiconsIcon } from "@hugeicons/react";
+import { ArrowDown01Icon } from "@hugeicons/core-free-icons";
+import type { AppId } from "@executor-js/sdk";
+import type { OrganizationReference } from "@executor-js/hosted-server/organization";
+import { Button } from "@executor-js/ui/components/button";
+import type { PoolUsageMember } from "../../contracts/pool-usage.ts";
+import type { HostedError } from "../../contracts/errors.ts";
+import { CapEditor, CapSummary, openDraft, type CapDraft } from "./pool-usage-cap.tsx";
+import { PoolMemberDetails } from "./pool-usage-details.tsx";
+import type { Formats, Metric } from "./pool-usage-format.ts";
+
+/** Shared by the column header and every row, so they stay aligned. */
+export const rowColumns =
+  "grid grid-cols-[minmax(0,1fr)_4.5rem_4.5rem_6rem_11.5rem_2.25rem] items-start gap-x-4 max-[740px]:grid-cols-3 max-[740px]:gap-y-2";
+// Column headers are visual only; each value carries its own label for screen readers and phones.
+const valueLabel =
+  "sr-only max-[740px]:not-sr-only max-[740px]:block text-xs text-muted-foreground";
+
+/** A person has a name, an email, or both; the backend sends empty strings for missing ones. */
+const personLabel = (member: Pick<PoolUsageMember, "name" | "email">) =>
+  member.name.trim() || member.email || "Unnamed person";
+
+export function PoolMemberRow({
+  organization,
+  app,
+  after,
+  member,
+  you,
+  expanded,
+  onToggle,
+  metric,
+  onMetric,
+  draft,
+  onDraft,
+  onSettled,
+  saved,
+  from,
+  to,
+  format,
+}: {
+  readonly organization: OrganizationReference;
+  readonly app: AppId;
+  readonly after: string | undefined;
+  readonly member: PoolUsageMember;
+  readonly you: boolean;
+  readonly expanded: boolean;
+  readonly onToggle: () => void;
+  readonly metric: Metric;
+  readonly onMetric: (metric: Metric) => void;
+  readonly draft: CapDraft | undefined;
+  readonly onDraft: (change: (draft: CapDraft | undefined) => CapDraft | undefined) => void;
+  readonly onSettled: (
+    attempt: number,
+    weekly: number | null,
+    exit: Exit.Exit<unknown, HostedError>,
+  ) => void;
+  readonly saved: { readonly weekly: number | null } | undefined;
+  readonly from: string;
+  readonly to: string;
+  readonly format: Formats;
+}) {
+  const id = useId();
+  const label = personLabel(member);
+  const row = useRef<HTMLLIElement>(null);
+  const edit = useRef<HTMLButtonElement>(null);
+  // Closing the editor, by Cancel or a confirmed save, returns focus to the control that opened
+  // it, unless the person has already moved elsewhere.
+  const hadDraft = useRef(draft !== undefined);
+  useEffect(() => {
+    const active = document.activeElement;
+    if (
+      hadDraft.current &&
+      draft === undefined &&
+      (active === null || active === document.body || row.current?.contains(active) === true)
+    )
+      edit.current?.focus();
+    hadDraft.current = draft !== undefined;
+  }, [draft]);
+
+  return (
+    <li ref={row} className="border-b">
+      <div className={`${rowColumns} px-1 py-3 max-[740px]:relative max-[740px]:pr-12`}>
+        <div className="min-w-0 max-[740px]:col-span-3">
+          <span className="block truncate font-medium" title={label}>
+            {label}
+            {you && <span className="font-normal text-muted-foreground"> (you)</span>}
+            {member.owner && <span className="font-normal text-muted-foreground"> · Owner</span>}
+          </span>
+          {member.name.trim() !== "" && member.email !== "" && (
+            <span className="block truncate text-xs text-muted-foreground" title={member.email}>
+              {member.email}
+            </span>
+          )}
+        </div>
+        <div className="text-right tabular-nums max-[740px]:text-left">
+          <span className={valueLabel}>Requests</span>
+          {format.count(member.requests)}
+        </div>
+        <div className="text-right tabular-nums max-[740px]:text-left">
+          <span className={valueLabel}>Tokens</span>
+          {member.requests > 0 ? format.tokens(member.tokens.total) : "—"}
+        </div>
+        <div className="text-right tabular-nums max-[740px]:text-left">
+          <span className={valueLabel}>API cost</span>
+          {format.cost(member.cost)}
+          {member.unpriced > 0 && (
+            <span className="block text-xs text-muted-foreground">
+              {format.count(member.unpriced)} unpriced
+            </span>
+          )}
+        </div>
+        <div className="pt-0.5 text-xs text-muted-foreground tabular-nums max-[740px]:col-span-3">
+          <span className="sr-only">Weekly cap: </span>
+          <CapSummary member={member} saved={saved} format={format} />
+          {!member.owner && draft === undefined && (
+            <Button
+              ref={edit}
+              type="button"
+              variant="link"
+              size="xs"
+              className="mt-0.5 h-auto px-0 text-xs text-muted-foreground hover:text-foreground"
+              aria-label={`${member.cap === null ? "Set" : "Change"} weekly cap for ${label}`}
+              onClick={() => onDraft((previous) => openDraft(member, previous))}
+            >
+              {member.cap === null ? "Set cap" : "Change cap"}
+            </Button>
+          )}
+        </div>
+        <div className="max-[740px]:absolute max-[740px]:top-1 max-[740px]:right-0">
+          {member.requests > 0 && (
+            <Button
+              type="button"
+              variant="ghost"
+              size="icon-sm"
+              aria-expanded={expanded}
+              aria-controls={`${id}-details`}
+              aria-label={`${expanded ? "Hide" : "Show"} usage details for ${label}`}
+              onClick={onToggle}
+            >
+              <HugeiconsIcon
+                icon={ArrowDown01Icon}
+                className={`transition-transform duration-150 motion-reduce:transition-none ${expanded ? "rotate-180" : ""}`}
+                aria-hidden
+              />
+            </Button>
+          )}
+        </div>
+      </div>
+      {draft !== undefined && !member.owner && (
+        <CapEditor
+          organization={organization}
+          app={app}
+          after={after}
+          member={member}
+          label={label}
+          draft={draft}
+          onDraft={onDraft}
+          onSettled={onSettled}
+        />
+      )}
+      {expanded && member.requests > 0 && (
+        <PoolMemberDetails
+          id={`${id}-details`}
+          label={label}
+          member={member}
+          from={from}
+          to={to}
+          metric={metric}
+          onMetric={onMetric}
+          format={format}
+        />
+      )}
+    </li>
+  );
+}
