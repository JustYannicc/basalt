index 0000000..696c3be
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/account-traffic-text.ts
@@ -0,0 +1,118 @@
+/**
+ * The words of an account's traffic: the Requests 7d cell's tooltip and screen-reader label, the
+ * Health column's tooltip, the Details line, and the token footer's unit and note. A count names
+ * one thing in the singular.
+ */
+import type { DisplayFormat } from "../../contracts/display.ts";
+import { age, amount, countedUnit } from "./account-observation-format.ts";
+
+/** One recent bucket: any failure is bad, requests without one are good, no requests is none. */
+export type TrafficTick = "good" | "bad" | "none";
+
+/** An account's requests as its gateways counted them. */
+export interface AccountRowTraffic {
+  /** Requests in the last 7 days. */
+  readonly requests: number;
+  readonly failed: number;
+  /** The last hours, oldest first; the newest is the current, partial hour. */
+  readonly ticks: readonly TrafficTick[];
+  /** The latest successful request; null when none is recorded, undefined when unread. */
+  readonly lastSuccessAt: string | null | undefined;
+  /** The gateways that counted, such as the pool's name. */
+  readonly gateways: readonly string[];
+}
+
+/** Tokens a gateway counted in one usage window. `missing` requests reported no token count. */
+export interface WindowTokens {
+  readonly total: number | null;
+  readonly known: number;
+  readonly missing: number;
+  readonly gateways: readonly string[];
+}
+
+/** "1 request", "2 requests", by the same singular rule as an account's reported amounts. */
+const requestCount = (count: number, format: DisplayFormat) =>
+  amount(count, "requests", format, true);
+
+/** The 7-day success share, or null without requests. */
+export const successShare = (traffic: AccountRowTraffic) =>
+  traffic.requests === 0 ? null : (traffic.requests - traffic.failed) / traffic.requests;
+
+/** Truncated, never rounded up: one failure in thousands never reads as 100%. */
+export const percent = (share: number, format: DisplayFormat) =>
+  `${new Intl.NumberFormat(format.locale, { maximumFractionDigits: 1 }).format(
+    Math.floor(share * 1000) / 10,
+  )}%`;
+
+const via = (gateways: readonly string[]) =>
+  gateways.length === 0 ? "" : `, counted by ${gateways.join(" and ")}`;
+
+const lastSuccess = (traffic: AccountRowTraffic, now: number) =>
+  traffic.lastSuccessAt === undefined
+    ? undefined
+    : traffic.lastSuccessAt === null
+      ? "no successful request recorded"
+      : `last success ${age(traffic.lastSuccessAt, now)}`;
+
+/** What a screen reader hears after the Requests 7d cell's count. */
+export const requestsLabel = (requests: number) =>
+  ` ${countedUnit(requests, "requests")} in the last 7 days`;
+
+/** The token footer's unit after its figure: "1 token", "1.2M tokens". */
+export const tokensUnit = (total: number) => ` ${countedUnit(total, "tokens")}`;
+
+/** The Requests 7d cell's tooltip. */
+export const requestsTitle = (traffic: AccountRowTraffic, now: number, format: DisplayFormat) => {
+  const success = lastSuccess(traffic, now);
+  return traffic.requests === 0
+    ? `No requests in the last 7 days${via(traffic.gateways)}${success === undefined ? "" : ` · ${success}`}`
+    : `${requestCount(traffic.requests, format)} in the last 7 days${via(traffic.gateways)}`;
+};
+
+/** The Health column's tooltip while the account has requests; `check` follows on its own line. */
+export const healthTitle = (
+  traffic: AccountRowTraffic,
+  check: string | undefined,
+  now: number,
+  format: DisplayFormat,
+) =>
+  `${[
+    `${requestCount(traffic.requests, format)} in 7 days`,
+    `${percent(successShare(traffic) ?? 1, format)} succeeded`,
+    lastSuccess(traffic, now),
+  ]
+    .filter((part) => part !== undefined)
+    .join(" · ")}${via(traffic.gateways)}${check === undefined ? "" : `\n${check}`}`;
+
+/** Details' Requests line, in the same words as the cells' tooltips. */
+export const trafficSummary = (traffic: AccountRowTraffic, now: number, format: DisplayFormat) => {
+  const share = successShare(traffic);
+  return [
+    traffic.requests === 0
+      ? "None in 7 days"
+      : `${new Intl.NumberFormat(format.locale).format(traffic.requests)} in 7 days`,
+    share === null ? undefined : `${percent(share, format)} succeeded`,
+    lastSuccess(traffic, now),
+    traffic.gateways.length === 0 ? undefined : `counted by ${traffic.gateways.join(" and ")}`,
+  ]
+    .filter((part) => part !== undefined)
+    .join(" · ");
+};
+
+/** The token footer's tooltip: who counted, and how many requests left the total a minimum. */
+export const tokensTitle = (
+  tokens: WindowTokens,
+  provider: string | undefined,
+  format: DisplayFormat,
+) => {
+  const requests = tokens.known + tokens.missing;
+  return [
+    `Counted by ${tokens.gateways.join(" and ") || "the gateway"} from its own requests in this window${provider === undefined ? "" : `, not reported by ${provider}`}.`,
+    tokens.missing > 0
+      ? `${new Intl.NumberFormat(format.locale).format(tokens.missing)} of ${requestCount(requests, format)} didn't report tokens, so this is a minimum.`
+      : undefined,
+    "API-equivalent cost isn't available yet.",
+  ]
+    .filter((part) => part !== undefined)
+    .join("\n");
+};
