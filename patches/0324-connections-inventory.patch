+  // Account connections as metadata only: their status, never the rest of their state, their
+  // sign-in attempt or their account. A pending connection past its expiry reads `expired`.
+  // `produced_account` is any completed sign-in: a new, reconnected or reused account.
+  connections: `select c.id, c.provider, c.target ->> 'app' as app,
+    c.target ->> 'requirement' as requirement, c.state ->> 'status' as status,
+    c.expires_at <= now() as expired,
+    coalesce(c.state ->> 'status' = 'completed', false) as produced_account,
+    c.created_at::text, c.expires_at::text from executor_account_connections c
+    where c.owner = 'organization:' || $1 order by c.id limit 2001`,
+  // The same connections as counts, so an organization with more than the row bound still gets
+  // its numbers.
+  "connections-summary": `select c.state ->> 'status' as status, c.expires_at <= now() as expired,
+    c.target ->> 'app' as app, c.provider, count(*)::int as connections,
+    min(c.created_at)::text as first_created_at, max(c.created_at)::text as last_created_at
+    from executor_account_connections c where c.owner = 'organization:' || $1
+    group by 1, 2, 3, 4 order by 3, 4, 1, 2 limit 2001`,
 } as const;
 
