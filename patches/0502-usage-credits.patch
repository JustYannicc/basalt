diff --git a/apps/hosted/server/src/implementation/pool-backend.ts b/apps/hosted/server/src/implementation/pool-backend.ts
new file mode 100644
index 0000000..12000e2
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-backend.ts
@@ -0,0 +1,139 @@
+import { AppId, StorageError } from "@executor-js/sdk/core";
+import { Clock, Config, Effect, Option, Redacted, Schema } from "effect";
+import { FetchHttpClient, HttpBody, HttpClient, HttpClientResponse } from "effect/http";
+import { Principal } from "../contracts/auth.ts";
+import { PoolUsageBackend, PoolUsageUnavailable } from "../contracts/pool-usage.ts";
+import { applicationAudiences } from "./application-audience.ts";
+import { lockCurrentActor, policyDatabase, requireAppAccessAs } from "./resource-policy.ts";
+import { hostAssertionTtlMs, signEnvelope } from "./pool-token.ts";
+import { appUiPhase } from "./app-ui-phase-timing.ts";
+
+const Pool = Schema.Struct({
+  owner: Principal.fields.userId,
+  authorization: Schema.NullOr(Schema.String),
+});
+
+const backend = Effect.gen(function* () {
+  const supplied = yield* PoolUsageBackend;
+  if (supplied !== undefined) return supplied;
+  const key = yield* Config.Redacted("POOL_APP_SIGNING_KEY").pipe(Config.option);
+  const origin = yield* Config.String("BASALT_POOL_ORIGIN").pipe(Config.option);
+  if (Option.isNone(key) || Option.isNone(origin)) return yield* new PoolUsageUnavailable();
+  return { key: key.value, origin: origin.value };
+}).pipe(Effect.catch(() => new PoolUsageUnavailable()));
+
+export const sendPoolCommand = <A>(
+  action:
+    | "accountRouting"
+    | "setCreditPolicy"
+    | "managed-usage"
+    | "managed-cap"
+    | "poolUsageSeries"
+    | "lastSuccessAt"
+    | "poolOverview"
+    | "poolPersonalOverview",
+  payload: Record<string, unknown>,
+  responseSchema: Schema.ConstraintDecoder<A, never>,
+) =>
+  Effect.gen(function* () {
+    const { key, origin } = yield* backend;
+    const now = yield* Clock.currentTimeMillis;
+    const envelope = yield* Effect.tryPromise(() =>
+      signEnvelope(Redacted.value(key), "sbs1", {
+        ...payload,
+        action,
+        expiresAt: now + hostAssertionTtlMs,
+      }),
+    );
+    const client = yield* HttpClient.HttpClient;
+    // Match the public pool usage paths in Basalt's src/pool/model-history/series-http.ts.
+    const path =
+      action === "poolUsageSeries"
+        ? "/pool/v1/usage/series"
+        : action === "lastSuccessAt"
+          ? "/pool/v1/usage/last-success"
+          : action === "poolOverview"
+            ? "/pool/v1/usage/overview"
+            : action === "poolPersonalOverview"
+              ? "/pool/v1/usage/personal-overview"
+              : `/pool/v1/${action}`;
+    const response = yield* client.post(new URL(path, origin).href, {
+      body: HttpBody.jsonUnsafe({ envelope }),
+    });
+    if (response.status !== 200) return yield* new PoolUsageUnavailable();
+    return yield* HttpClientResponse.schemaBodyJson(responseSchema)(response);
+  }).pipe(
+    Effect.timeout("10 seconds"),
+    Effect.provide(FetchHttpClient.layer),
+    Effect.catch(() => new PoolUsageUnavailable()),
+  );
+
+/** The native policy and external cap write share the organization access lock. */
+export const withPool = <A, E, R>(
+  app: AppId,
+  work: (pool: {
+    pool: AppId;
+    organization: string;
+    owner: string;
+    user: string;
+    native: boolean;
+    users: string[];
+  }) => Effect.Effect<A, E, R>,
+  access: "manage" | "use" = "manage",
+) =>
+  Effect.gen(function* () {
+    const sql = yield* policyDatabase;
+    return yield* appUiPhase(
+      "overview-transaction",
+      sql.withTransaction(
+        Effect.gen(function* () {
+          const pool = yield* appUiPhase(
+            "overview-policy",
+            Effect.gen(function* () {
+              const actor = yield* lockCurrentActor;
+              yield* requireAppAccessAs(actor, app, access);
+              const rows =
+                yield* sql`select coalesce(entry.value ->> 'owner', entry.key) as owner, entry.value ->> 'authorization' as authorization
+        from organization o
+        cross join lateral jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) entry
+        join executor_apps app on app.id = entry.value ->> 'app' and app.owner = 'organization:' || o.id
+        where o.id = ${actor.organization} and app.id = ${app}`;
+              if (rows.length === 0) return null;
+              const found = yield* Schema.decodeUnknownEffect(Schema.Array(Pool))(rows);
+              if (found.length !== 1 || found[0] === undefined) return yield* new StorageError();
+              const saved = found[0];
+              const native = saved.authorization === "executor-app-v1";
+              const audience = (yield* applicationAudiences(actor.organization, [app]))[0];
+              const delegated =
+                yield* sql`select distinct app_id as app, authorizer from hosted_model_bindings
+          where pool_id = ${app} and subject = ''`;
+              const appIds = yield* Schema.decodeUnknownEffect(Schema.Array(AppId))(
+                delegated.map((row) => row.app),
+              );
+              const audiences = yield* applicationAudiences(actor.organization, appIds);
+              const authors = yield* Schema.decodeUnknownEffect(Schema.Array(Schema.String))(
+                delegated.map((row) => row.authorizer),
+              );
+              const users = [
+                ...new Set([
+                  ...(native ? [] : [saved.owner]),
+                  ...(audience?.users ?? []),
+                  ...authors,
+                  ...audiences.flatMap((entry) => entry.users),
+                ]),
+              ].sort();
+              return {
+                pool: app,
+                organization: actor.organization,
+                owner: saved.owner,
+                user: actor.user,
+                native,
+                users,
+              };
+            }),
+          );
+          return pool === null ? null : yield* work(pool);
+        }),
+      ),
+    );
+  });
