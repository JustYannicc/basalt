@@ -0,0 +1,71 @@
+import { StorageHost, type AppId } from "@executor-js/sdk/core";
+import type { UsageCreditPolicy } from "apps/contracts";
+import { Effect, Schema } from "effect";
+import { PoolAccountRouting, PoolCreditPolicyUnavailable } from "../contracts/pool-usage.ts";
+import { OrganizationForbidden } from "../contracts/organization.ts";
+import { HostedExecutor } from "../contracts/executor.ts";
+import { sendPoolCommand, withPool } from "./pool-backend.ts";
+import { creditRoutingAccounts } from "./pool-usage-series-accounts.ts";
+
+export const poolAccountRouting = (app: AppId) =>
+  withPool(
+    app,
+    (pool) =>
+      Effect.gen(function* () {
+        const accounts = yield* creditRoutingAccounts(pool);
+        return yield* sendPoolCommand(
+          "accountRouting",
+          {
+            pool: pool.pool,
+            organization: pool.organization,
+            user: pool.user,
+            owner: pool.owner,
+            canEdit: pool.owner === pool.user,
+            accounts,
+          },
+          PoolAccountRouting,
+        );
+      }),
+    "use",
+  ).pipe(
+    tracked,
+    Effect.catchTags({
+      SqlError: () => new PoolCreditPolicyUnavailable(),
+      SchemaError: () => new PoolCreditPolicyUnavailable(),
+      PoolUsageUnavailable: () => new PoolCreditPolicyUnavailable(),
+    }),
+  );
+
+export const setPoolCreditPolicy = (app: AppId, usageCreditPolicy: UsageCreditPolicy) =>
+  withPool(app, (pool) =>
+    Effect.gen(function* () {
+      if (pool.owner !== pool.user) return yield* new OrganizationForbidden();
+      yield* sendPoolCommand(
+        "setCreditPolicy",
+        {
+          pool: pool.pool,
+          organization: pool.organization,
+          user: pool.user,
+          owner: pool.owner,
+          usageCreditPolicy,
+        },
+        Schema.Struct({ success: Schema.Literal(true) }),
+      );
+      return { success: true as const };
+    }),
+  ).pipe(
+    Effect.flatMap((result) =>
+      result === null ? new OrganizationForbidden() : Effect.succeed(result),
+    ),
+    Effect.catchTags({
+      SqlError: () => new PoolCreditPolicyUnavailable(),
+      SchemaError: () => new PoolCreditPolicyUnavailable(),
+      PoolUsageUnavailable: () => new PoolCreditPolicyUnavailable(),
+    }),
+  );
+
+const tracked = <A, E, R>(read: Effect.Effect<A, E, R>) =>
+  Effect.gen(function* () {
+    const executor = yield* Effect.flatten(HostedExecutor);
+    return yield* executor[StorageHost].transaction(read);
+  });
