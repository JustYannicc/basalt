+        if (account.homeReference === null || !(yield* inspect(account.account))) return [];
+        const home = yield* Effect.try(() => poolHomeReferences(account.homeReference!)).pipe(
+          Effect.mapError(() => new StorageError()),
+        );
+        return [{ account: account.account, home }];
+      }),
+    ).pipe(Effect.map((groups) => groups.flat()));
+  });
