+  yield* fs.writeFileString(runtimeFile, JSON.stringify({ ...runtime, protocol: 17 }));
+  const { base, archives } = yield* loopbackArchives;
+  archives.set("/protocol17.tgz", yield* packDirectory(path.join(extracted, "package"), directory));
+  return `${base}/protocol17.tgz`;
+});
