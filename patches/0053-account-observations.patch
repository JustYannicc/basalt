diff --git a/packages/sdk/src/implementation/account-observation-read.ts b/packages/sdk/src/implementation/account-observation-read.ts
new file mode 100644
index 000000000..1e748916c
--- /dev/null
+++ b/packages/sdk/src/implementation/account-observation-read.ts
@@ -0,0 +1,104 @@
+import { Clock, Effect, Redacted, Schema } from "effect";
+import {
+  AccountObservationResult,
+  HostOperationNotFound,
+  HostOutputInvalid,
+  type HostAccounts,
+} from "apps/contracts";
+import { privateObservationStrings } from "@executor-js/utils/account-display-privacy";
+import type { UrlPolicy } from "@executor-js/utils/url-policy";
+import type { ResourceLifecycle } from "../contracts/executor.ts";
+import type { App } from "../contracts/apps.ts";
+import type { FirstPartyOAuthClient } from "../contracts/oauth.ts";
+import type { Runtime } from "../contracts/runtime.ts";
+import { StoredVersion, type StoredAccount } from "../contracts/storage.ts";
+import { StorageError } from "../contracts/shared.ts";
+import { query, type Query } from "./database.ts";
+import { invocationAccount } from "./provider.ts";
+import { interactiveBinding } from "./interactive-state.ts";
+import { checkInteractiveAccount } from "./interactive-check.ts";
+import type { makeOAuth } from "./oauth.ts";
+
+/** Invoke only a host-resolved account and requirement. Neither result nor caller chooses its provenance. */
+export const makeObservationReader =
+  (
+    db: Query,
+    runtime: Runtime,
+    oauth: Pick<ReturnType<typeof makeOAuth>, "resolve" | "resolveSelected">,
+    clients: ReadonlyMap<string, FirstPartyOAuthClient>,
+    sitePolicy: UrlPolicy,
+    lifecycle?: ResourceLifecycle,
+  ) =>
+  (account: StoredAccount, app: App) =>
+    Effect.gen(function* () {
+      const target = Object.entries(app.requirements.accounts)
+        .filter(([, required]) => required.provider === account.provider)
+        .sort(([a], [b]) => a.localeCompare(b))[0];
+      if (target === undefined || app.activeVersion === null)
+        return yield* new HostOperationNotFound();
+      const [slot, required] = target;
+      const row = yield* query(() =>
+        db.findFirst("deployments", { where: (b) => b("id", "=", app.activeVersion!) }),
+      );
+      if (row === null) return yield* new StorageError();
+      const version = yield* Schema.decodeUnknownEffect(StoredVersion)(row).pipe(
+        Effect.mapError(() => new StorageError()),
+      );
+      const deadline = (yield* Clock.currentTimeMillis) + 14_000;
+      const acquired = yield* interactiveBinding(db, { account: account.id, owner: account.owner });
+      if (acquired?.app === app.id && required.interactiveHealth === true) {
+        const result = yield* checkInteractiveAccount(
+          db,
+          runtime,
+          oauth.resolveSelected,
+          lifecycle,
+          {
+            app: app.id,
+            version,
+            acquired,
+            method: account.method,
+            deadline,
+          },
+        );
+        if (result === undefined) return yield* new HostOperationNotFound();
+        if (result.observationInvalid === true) return yield* new HostOutputInvalid();
+        return result?.observation ?? null;
+      }
+      if (runtime.observeAccount === undefined) return yield* new HostOperationNotFound();
+      const credential = yield* oauth.resolve(account, required.definition);
+      const bound = invocationAccount(
+        account,
+        required.definition,
+        credential,
+        clients,
+        sitePolicy,
+      );
+      const accounts: HostAccounts =
+        required.scope === "app"
+          ? { app: { [slot]: bound } }
+          : { app: {}, user: { [slot]: bound } };
+      const result = yield* runtime.observeAccount({
+        app: app.id,
+        build: version.build,
+        requirement: slot,
+        deadline,
+        accounts: Redacted.make(accounts),
+      });
+      if (result === null) return null;
+      const parsed = yield* Schema.decodeUnknownEffect(AccountObservationResult)(result).pipe(
+        Effect.mapError(() => new HostOutputInvalid()),
+      );
+      if (
+        !privateObservationStrings(parsed, {
+          app: {
+            checked: {
+              provider: required.definition,
+              method: account.method,
+              fields: Redacted.value(credential.fields),
+            },
+          },
+        })
+      )
+        return yield* new HostOutputInvalid();
+      return parsed;
+    }).pipe(Effect.timeout(15_000));
