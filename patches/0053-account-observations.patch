index 000000000..7b2234dab
--- /dev/null
+++ b/e2e/tests/account-observation-legacy.spec.ts
@@ -0,0 +1,81 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { accountStatusSource } from "../support/account-status-fixture.ts";
+import { allowance, ObservationView } from "../support/account-observation-fixture.ts";
+import { statusAccount } from "../support/status-account.ts";
+import { interactiveBackendKey } from "../support/interactive-account-backend.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Health = Schema.Struct({
+  apps: Schema.Array(
+    Schema.Struct({ check: Schema.NullOr(Schema.Struct({ status: Schema.String })) }),
+  ),
+});
+layer(HostedLive, { excludeTestServices: true })("Legacy account observations", (it) => {
+  it.effect(scenarios.accountObservationLegacy.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors;
+        const source = (origin: string, check: string) =>
+          accountStatusSource(origin, check).replace(
+            "return await response.json();",
+            'throw { _tag: "HostOperationNotFound" };',
+          );
+        const f = yield* statusAccount(source);
+        const path = `/api/organizations/${actors.organization.id}/accounts/${f.account}`;
+        const failed = yield* api.request(actors.owner, "POST", `${path}/observations/refresh`);
+        expect(failed.status, JSON.stringify(failed.body)).toBe(200);
+        const attempt = yield* body(ObservationView, failed);
+        expect(attempt.reports).toHaveLength(1);
+        expect(attempt.reports[0]?.lastAttempt?.outcome).toBe("unavailable");
+        expect((yield* f.read()).body).toMatchObject({ health: { apps: [{ check: null }] } });
+        expect((yield* f.deploy(accountStatusSource(f.connectOrigin, f.checkOrigin))).status).toBe(
+          200,
+        );
+        for (const observation of [
+          { broken: true },
+          {
+            ...allowance(),
+            observation: { ...allowance().observation, summary: interactiveBackendKey },
+          },
+        ]) {
+          yield* f.statusBackend.answer({
+            status: 200,
+            body: { accountInfo: { displayName: "Kept identity" }, observation },
+          });
+          const checked = yield* f.check();
+          expect(checked.status, JSON.stringify(checked.body)).toBe(200);
+          expect((yield* body(Health, checked)).apps[0]?.check?.status).toBe("healthy");
+          const read = yield* api.request(actors.owner, "GET", `${path}/observations`);
+          expect(JSON.stringify(read.body)).not.toContain(interactiveBackendKey);
+          expect((yield* body(ObservationView, read)).reports[0]?.lastAttempt?.outcome).toBe(
+            "invalid",
+          );
+        }
+        for (const response of [false, null, "invalid check"]) {
+          yield* f.statusBackend.answer({ status: 200, body: response });
+          const failedCheck = yield* f.check();
+          expect(failedCheck.status).toBe(200);
+          expect((yield* body(Health, failedCheck)).apps[0]?.check?.status).toBe("check_failed");
+        }
+        const nonJson = accountStatusSource(f.connectOrigin, f.checkOrigin).replace(
+          "return await response.json();",
+          'return { accountInfo: { displayName: "Non-JSON allowance" }, observation: () => undefined };',
+        );
+        expect((yield* f.deploy(nonJson)).status).toBe(200);
+        const checked = yield* f.check();
+        expect(checked.status, JSON.stringify(checked.body)).toBe(200);
+        expect((yield* body(Health, checked)).apps[0]?.check?.status).toBe("healthy");
+        const invalid = yield* api.request(actors.owner, "GET", `${path}/observations`);
+        expect((yield* body(ObservationView, invalid)).reports[0]?.lastAttempt?.outcome).toBe(
+          "invalid",
+        );
+      }),
+    ),
+  );
+});
