@@ -0,0 +1,14 @@
+import { Effect } from "effect";
+import { SqlClient } from "effect/sql";
+
+/** Additive: existing account use grants do not expose global allowance. */
+export const migrateAccountObservations = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  yield* sql`create table if not exists hosted_account_observation_access (
+    account_id text primary key references executor_accounts(id) on delete cascade,
+    organization_id text not null references organization(id) on delete cascade,
+    read_audience jsonb not null,
+    refresh_audience jsonb not null,
+    revision text not null default gen_random_uuid()::text
+  )`;
+});
