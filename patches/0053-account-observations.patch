diff --git a/e2e/tests/account-observations-local.spec.ts b/e2e/tests/account-observations-local.spec.ts
new file mode 100644
index 000000000..ada601b49
--- /dev/null
+++ b/e2e/tests/account-observations-local.spec.ts
@@ -0,0 +1,120 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Fiber, Schema } from "effect";
+import { body } from "../support/api.ts";
+import { TestLive, withCase } from "../support/case.ts";
+import {
+  observationBackend,
+  observationSource,
+  observationToken,
+  ObservationView,
+} from "../support/account-observation-fixture.ts";
+import { connectLocalAccount } from "../support/app-accounts.ts";
+import { localAgent } from "../support/local-links.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+const View = Schema.Struct({ account: Schema.String, reports: ObservationView.fields.reports });
+const Resource = Schema.Struct({ id: Schema.String });
+layer(TestLive, { excludeTestServices: true })("Local account observations", (it) => {
+  it.effect(scenarios.accountObservationsLocal.title, (context) =>
+    withCase(
+      context,
+      Effect.gen(function* () {
+        const { agent } = yield* localAgent;
+        const backend = yield* observationBackend;
+        const deployed = yield* agent.send("POST", "/v1/apps/deploy", {
+          owner: "local",
+          name: "Allowance fixture",
+          files: [
+            {
+              path: "index.ts",
+              content: observationSource(backend.origin, { observe: true, health: true }),
+            },
+            appsManifest,
+          ],
+        });
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const { app } = yield* body(Schema.Struct({ app: Resource }), deployed);
+        const account = yield* connectLocalAccount(agent, {
+          app: app.id,
+          requirement: "service",
+          method: "key",
+          fields: { token: observationToken },
+        });
+        const path = `/v1/accounts/${account.id}`;
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* serverControl("start");
+            yield* agent.send("DELETE", `/v1/apps/${app.id}`);
+            yield* agent.send("DELETE", path);
+          }).pipe(Effect.orDie),
+        );
+        const read = () =>
+          agent
+            .send(
+              "GET",
+              `${path}/observations?apps=${encodeURIComponent(JSON.stringify([app.id]))}`,
+            )
+            .pipe(
+              Effect.flatMap((r) => {
+                expect(r.status, JSON.stringify(r.body)).toBe(200);
+                return body(View, r);
+              }),
+            );
+        const empty = yield* agent.send("GET", `${path}/observations?apps=%5B%5D`);
+        expect(empty.status, JSON.stringify(empty.body)).toBe(200);
+        expect((yield* body(View, empty)).reports).toEqual([]);
+        expect(yield* backend.calls).toBe(0);
+        const first = yield* agent.send("POST", `${path}/observations/refresh`, { apps: [app.id] });
+        expect(first.status, JSON.stringify(first.body)).toBe(200);
+        const saved = yield* body(View, first);
+        expect(saved.reports[0]?.result).toMatchObject({
+          observation: { windows: [{ id: "requests" }] },
+        });
+        yield* serverControl("restart");
+        expect(yield* read()).toEqual(saved);
+        // A retained host-owned app can report on the user's account, as health checks do.
+        yield* legacyStorage([
+          {
+            sql: "UPDATE executor_apps SET owner = 'fixture-host' WHERE id = $1",
+            params: [app.id],
+          },
+        ]);
+        yield* serverControl("start");
+        expect((yield* read()).reports).toEqual(saved.reports);
+        const crossOwner = yield* agent.send("POST", `${path}/observations/refresh`, {
+          apps: [app.id],
+        });
+        expect(crossOwner.status, JSON.stringify(crossOwner.body)).toBe(200);
+        expect((yield* body(View, crossOwner)).reports).toHaveLength(1);
+        yield* legacyStorage([
+          { sql: "UPDATE executor_apps SET owner = 'local' WHERE id = $1", params: [app.id] },
+        ]);
+        yield* serverControl("start");
+
+        // A refresh started with old credentials cannot publish into a later credential generation.
+        yield* serverControl("stop");
+        yield* serverControl("clock/advance", 200, { milliseconds: 6 * 60_000 });
+        yield* serverControl("start");
+        const held = yield* backend.hold;
+        const refresh = yield* agent
+          .send("POST", `${path}/observations/refresh`, { apps: [app.id] })
+          .pipe(Effect.forkChild);
+        yield* held.entered;
+        const replaced = yield* connectLocalAccount(agent, {
+          app: app.id,
+          requirement: "service",
+          method: "key",
+          account: account.id,
+          fields: { token: "synthetic-replacement-credential" },
+        });
+        expect(replaced.id).toBe(account.id);
+        yield* held.release;
+        expect((yield* Fiber.join(refresh)).status).toBe(200);
+        expect((yield* read()).reports).toEqual([]);
+      }),
+    ),
+  );
+});
diff --git a/e2e/tests/account-observations.spec.ts b/e2e/tests/account-observations.spec.ts
new file mode 100644
index 000000000..b5d738768
