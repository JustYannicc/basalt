diff --git a/e2e/tests/account-observation-access.spec.ts b/e2e/tests/account-observation-access.spec.ts
new file mode 100644
index 000000000..d060bea39
--- /dev/null
+++ b/e2e/tests/account-observation-access.spec.ts
@@ -0,0 +1,199 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { observationFixture, ObservationView } from "../support/account-observation-fixture.ts";
+import { linkAccount } from "../support/app-accounts.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Revision = Schema.Struct({ revision: Schema.String });
+const legacy = {
+  badges: [{ label: "Global allowance", tone: "neutral" }],
+  meters: [{ label: "Global requests", remaining: 0.5 }],
+  stats: [],
+};
+const Check = Schema.Struct({
+  status: Schema.String,
+  checkedAt: Schema.String,
+  current: Schema.Boolean,
+  displayStatus: Schema.optionalKey(Schema.Unknown),
+});
+const Health = Schema.Struct({
+  apps: Schema.Array(Schema.Struct({ app: Schema.String, check: Schema.NullOr(Check) })),
+});
+const Detail = Schema.Struct({ health: Health });
+
+layer(HostedLive, { excludeTestServices: true })("Observation access", (it) => {
+  it.effect(scenarios.accountObservationAccess.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* observationFixture({ observe: true, health: true, shared: true });
+        const appAccess = yield* body(
+          Revision,
+          yield* f.api.request(f.actors.owner, "GET", `${f.appPath}/access`),
+        );
+        expect(
+          (yield* f.api.request(f.actors.owner, "PATCH", `${f.appPath}/access`, {
+            revision: appAccess.revision,
+            audience: { kind: "everyone" },
+          })).status,
+        ).toBe(200);
+        yield* linkAccount(f.actors.member, f.appPath, "service", f.account);
+        yield* f.backend.health({
+          status: 200,
+          body: { accountInfo: { displayName: "Shared identity" }, status: legacy },
+        });
+        expect((yield* f.check()).body).toMatchObject({
+          apps: [{ check: { status: "healthy", displayStatus: legacy } }],
+        });
+        expect((yield* f.refresh()).status).toBe(200);
+        const member = (method: "GET" | "POST", path: string) =>
+          f.api.request(f.actors.member, method, path);
+        const denied = yield* body(
+          ObservationView,
+          yield* member("GET", `${f.accountPath}/observations`),
+        );
+        expect(denied).toMatchObject({ canInspect: false, canRefresh: false, reports: [] });
+        expect((yield* member("POST", `${f.accountPath}/observations/refresh`)).status).toBe(403);
+        expect((yield* member("GET", `${f.accountPath}/observations/access`)).status).toBe(403);
+        expect(yield* f.backend.calls).toBe(1);
+
+        const stripped = (health: typeof Health.Type) => {
+          expect(health.apps).toHaveLength(1);
+          expect(health.apps[0]?.check).toMatchObject({
+            status: "healthy",
+            current: true,
+            checkedAt: expect.any(String),
+          });
+          expect(health.apps[0]?.check?.displayStatus).toBeUndefined();
+        };
+        stripped((yield* body(Detail, yield* member("GET", f.accountPath))).health);
+        stripped(yield* body(Health, yield* member("POST", `${f.accountPath}/health`)));
+        const inventory = yield* body(
+          Schema.Struct({
+            accounts: Schema.Array(
+              Schema.Struct({ id: Schema.String, health: Schema.optionalKey(Health) }),
+            ),
+          }),
+          yield* member("GET", `${f.prefix}/inventory`),
+        );
+        const inventoryHealth = inventory.accounts.find(
+          (account) => account.id === f.account,
+        )?.health;
+        expect(inventoryHealth).toBeDefined();
+        if (inventoryHealth !== undefined) stripped(inventoryHealth);
+        const directory = yield* body(
+          Schema.Struct({
+            accounts: Schema.Array(
+              Schema.Struct({
+                account: Schema.Struct({ id: Schema.String }),
+                health: Schema.optionalKey(Health),
+              }),
+            ),
+          }),
+          yield* member("GET", `${f.prefix}/resources?view=available`),
+        );
+        const directoryHealth = directory.accounts.find(
+          (entry) => entry.account.id === f.account,
+        )?.health;
+        expect(directoryHealth).toBeDefined();
+        if (directoryHealth !== undefined) stripped(directoryHealth);
+        const links = yield* body(
+          Schema.Array(
+            Schema.Struct({
+              account: Schema.Struct({ id: Schema.String }),
+              health: Schema.optionalKey(Health),
+            }),
+          ),
+          yield* member("GET", `${f.appPath}/accounts/user`),
+        );
+        const linkHealth = links.find((entry) => entry.account.id === f.account)?.health;
+        expect(linkHealth).toBeDefined();
+        if (linkHealth !== undefined) stripped(linkHealth);
+        // Projection never removes the owner's retained meters.
+        expect((yield* f.detail()).body).toMatchObject({
+          health: { apps: [{ check: { displayStatus: legacy } }] },
+        });
+
+        const path = `${f.accountPath}/observations/access`;
+        const policy = yield* body(Revision, yield* f.api.request(f.actors.owner, "GET", path));
+        const readable = yield* f.api.request(f.actors.owner, "PUT", path, {
+          revision: policy.revision,
+          read: { kind: "everyone" },
+          refresh: { kind: "owners" },
+        });
+        expect(readable.status, JSON.stringify(readable.body)).toBe(200);
+        const view = yield* body(
+          ObservationView,
+          yield* member("GET", `${f.accountPath}/observations`),
+        );
+        expect(view).toMatchObject({
+          canInspect: true,
+          canRefresh: false,
+          reports: [{ source: { id: f.app.id } }],
+        });
+        expect((yield* member("POST", `${f.accountPath}/observations/refresh`)).status).toBe(403);
+        expect((yield* member("GET", f.accountPath)).body).toMatchObject({
+          health: { apps: [{ check: { displayStatus: legacy } }] },
+        });
+        const revision = (yield* body(Revision, readable)).revision;
+        const canRefresh = yield* f.api.request(f.actors.owner, "PUT", path, {
+          revision,
+          read: { kind: "everyone" },
+          refresh: { kind: "everyone" },
+        });
+        expect(canRefresh.status, JSON.stringify(canRefresh.body)).toBe(200);
+        expect((yield* member("POST", `${f.accountPath}/observations/refresh`)).status).toBe(200);
+        expect(
+          yield* f.backend.calls,
+          "coalescing remains authoritative after access changes",
+        ).toBe(1);
+        const appPolicy = yield* body(
+          Revision,
+          yield* f.api.request(f.actors.owner, "GET", `${f.appPath}/access`),
+        );
+        expect(
+          (yield* f.api.request(f.actors.owner, "PATCH", `${f.appPath}/access`, {
+            revision: appPolicy.revision,
+            audience: { kind: "private" },
+          })).status,
+        ).toBe(200);
+        const hidden = yield* member("GET", `${f.accountPath}/observations`);
+        expect(hidden.status).toBe(200);
+        expect((yield* body(ObservationView, hidden)).reports).toEqual([]);
+        expect(JSON.stringify(hidden.body)).not.toContain(f.app.id);
+        expect((yield* body(ObservationView, yield* f.read())).reports).toHaveLength(1);
+        const privatePolicy = yield* body(
+          Revision,
+          yield* f.api.request(f.actors.owner, "GET", `${f.appPath}/access`),
+        );
+        expect(
+          (yield* f.api.request(f.actors.owner, "PATCH", `${f.appPath}/access`, {
+            revision: privatePolicy.revision,
+            audience: { kind: "everyone" },
+          })).status,
+        ).toBe(200);
+        const revoked = yield* f.api.request(f.actors.owner, "PUT", path, {
+          revision: (yield* body(Revision, canRefresh)).revision,
+          read: { kind: "owners" },
+          refresh: { kind: "everyone" },
+        });
+        expect(revoked.status, JSON.stringify(revoked.body)).toBe(200);
+        expect(
+          (yield* body(ObservationView, yield* member("GET", `${f.accountPath}/observations`)))
+            .reports,
+        ).toEqual([]);
+        expect((yield* member("POST", `${f.accountPath}/observations/refresh`)).status).toBe(403);
+        stripped((yield* body(Detail, yield* member("GET", f.accountPath))).health);
+        expect(
+          (yield* f.api.request(f.actors.owner, "PUT", path, {
+            revision,
+            read: { kind: "everyone" },
+            refresh: { kind: "everyone" },
+          })).status,
+        ).toBe(409);
+      }),
+    ),
+  );
+});
diff --git a/e2e/tests/account-observation-legacy.spec.ts b/e2e/tests/account-observation-legacy.spec.ts
