+import { Effect } from "effect";
+import { HostedExecutor } from "../contracts/executor.ts";
+import { AccountGrants } from "./proofs/account-access.ts";
+import { linkedApps } from "./accounts.ts";
+import { observationAccess, requireObservationAccess } from "./account-observation-policy.ts";
+
+export const getAccountObservations = Effect.gen(function* () {
+  const { owner, account } = yield* AccountGrants.inspect;
+  const access = yield* observationAccess(account);
+  if (!access.canInspect) return { account, reports: [], canInspect: false, canRefresh: false };
+  const executor = yield* Effect.flatten(HostedExecutor);
+  const apps = yield* linkedApps(owner, account);
+  const view = yield* executor.accounts.observations({
+    owner,
+    account,
+    apps: apps.map((app) => app.id),
+  });
+  yield* requireObservationAccess(account);
+  return { ...view, canInspect: true, canRefresh: access.canRefresh };
+});
+
+export const refreshAccountObservations = Effect.gen(function* () {
+  const { owner, account } = yield* AccountGrants.use;
+  yield* requireObservationAccess(account, true);
+  const executor = yield* Effect.flatten(HostedExecutor);
+  const apps = yield* linkedApps(owner, account);
+  const view = yield* executor.accounts.refreshObservations({
+    owner,
+    account,
+    apps: apps.map((app) => app.id),
+  });
+  yield* requireObservationAccess(account, true);
+  return { ...view, canInspect: true, canRefresh: true };
+});
