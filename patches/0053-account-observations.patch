@@ -0,0 +1,103 @@
+import { Effect, Result, Schema } from "effect";
+import { HostOperationNotFound, HostOutputInvalid, ProviderError } from "apps/contracts";
+import type { Crypto } from "effect";
+import type { App } from "../contracts/apps.ts";
+import type { AccountObservationInput } from "../contracts/account-observation.ts";
+import { StorageError, type AppId, type OwnerId } from "../contracts/shared.ts";
+import type { StoredAccount } from "../contracts/storage.ts";
+import { storedAccount } from "./accounts.ts";
+import type { Query } from "./database.ts";
+import { makeObservationStore } from "./account-observation-store.ts";
+import type { makeObservationReader } from "./account-observation-read.ts";
+
+type Input = typeof AccountObservationInput.Type;
+type ListApps = (input: {
+  readonly owner?: OwnerId;
+  readonly ids?: readonly AppId[];
+}) => Effect.Effect<readonly App[], StorageError>;
+
+export const makeAccountObservations = (
+  db: Query,
+  crypto: Crypto.Crypto,
+  listApps: ListApps,
+  read: ReturnType<typeof makeObservationReader>,
+) => {
+  const store = makeObservationStore(db, crypto);
+  const appsFor = (input: Input) =>
+    input.apps.length === 0 ? Effect.succeed([]) : listApps({ ids: input.apps });
+  const refreshApp = (account: StoredAccount, app: App) =>
+    Effect.gen(function* () {
+      if (
+        app.activeVersion === null ||
+        !Object.values(app.requirements.accounts).some(
+          (required) => required.provider === account.provider,
+        )
+      )
+        return;
+      const version = app.activeVersion;
+      const claim = yield* store.begin(account, app);
+      if (claim === undefined) return;
+      yield* Effect.gen(function* () {
+        const result = yield* read(account, app).pipe(Effect.result);
+        if (Result.isFailure(result) && Schema.is(StorageError)(result.failure))
+          return yield* result.failure;
+        if (Result.isFailure(result) && Schema.is(HostOperationNotFound)(result.failure)) {
+          yield* store.unsupported(claim);
+          return;
+        }
+        const value = Result.isSuccess(result) ? (result.success ?? undefined) : undefined;
+        const error = Result.isFailure(result) ? result.failure : undefined;
+        const outcome =
+          value !== undefined
+            ? ("success" as const)
+            : Schema.is(HostOutputInvalid)(error)
+              ? ("invalid" as const)
+              : Schema.is(ProviderError)(error) && error.reason === "rate_limited"
+                ? ("rate_limited" as const)
+                : typeof error === "object" &&
+                    error !== null &&
+                    "_tag" in error &&
+                    error._tag === "TimeoutError"
+                  ? ("timed_out" as const)
+                  : ("unavailable" as const);
+        yield* store.save({
+          account,
+          app: app.id,
+          version,
+          result: value,
+          outcome,
+          startedAt: claim.startedAt,
+          lease: claim,
+        });
+      }).pipe(
+        Effect.ensuring(
+          store
+            .release(claim)
+            .pipe(
+              Effect.catchTag("StorageError", () =>
+                Effect.logWarning("Account observation lease release failed; it will expire"),
+              ),
+            ),
+        ),
+      );
+    });
+  return {
+    fromHealth: store.fromHealth,
+    observations: (input: Input) =>
+      Effect.gen(function* () {
+        const account = yield* storedAccount(db, input.account, input.owner);
+        return yield* store.report(account, yield* appsFor(input));
+      }).pipe(Effect.withSpan("sdk.accounts.observations")),
+    refreshObservations: (input: Input) =>
+      Effect.gen(function* () {
+        const account = yield* storedAccount(db, input.account, input.owner);
+        const apps = yield* appsFor(input);
+        yield* Effect.forEach(apps, (app) => refreshApp(account, app), {
+          concurrency: 4,
+          discard: true,
+        });
+        const current = yield* storedAccount(db, input.account, input.owner);
+        return yield* store.report(current, apps);
+      }).pipe(Effect.withSpan("sdk.accounts.refreshObservations")),
+  };
+};
