+import { Schema } from "effect";
+import {
+  AccountObservationResult,
+  AccountObservationAttempt,
+  AccountObservationInstant,
+} from "apps/contracts";
+import { AccountId, AppId, OwnerId, VersionId } from "./shared.ts";
+
+const Source = Schema.Struct({
+  kind: Schema.Literals(["app", "driver"]),
+  id: Schema.NonEmptyString,
+  label: Schema.String,
+  version: Schema.String,
+});
+
+/** Host-attributed readings and refresh attempts. No provider credential or backend reference. */
+export const AccountObservationRecord = Schema.Struct({
+  source: Source,
+  credentialGeneration: Schema.Int,
+  result: Schema.NullOr(AccountObservationResult),
+  checkedAt: Schema.NullOr(AccountObservationInstant),
+  lastAttempt: Schema.NullOr(AccountObservationAttempt),
+  freshness: Schema.Literals(["fresh", "stale", "outdated", "unavailable"]),
+  collecting: Schema.Boolean,
+  nextAllowedAt: Schema.NullOr(AccountObservationInstant),
+});
+export type AccountObservationRecord = typeof AccountObservationRecord.Type;
+
+export const AccountObservationView = Schema.Struct({
+  account: AccountId,
+  reports: Schema.Array(AccountObservationRecord),
+});
+export type AccountObservationView = typeof AccountObservationView.Type;
+
+/** Only products supply the account's authorized reporter apps, as for credential checks. */
+export const AccountObservationInput = Schema.Struct({
+  account: AccountId,
+  owner: Schema.optional(OwnerId),
+  apps: Schema.Array(AppId),
+});
+
+export const StoredObservationData = Schema.Struct({
+  version: VersionId,
+  result: Schema.NullOr(AccountObservationResult),
+  lastAttempt: Schema.NullOr(AccountObservationAttempt),
+});
