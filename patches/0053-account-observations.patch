@@ -0,0 +1,32 @@
+import { Effect, Option, Schema } from "effect";
+import { privateObservationStrings } from "@executor-js/utils/account-display-privacy";
+import { AccountObservationResult } from "../contracts/account-observation.ts";
+import { HostOutputInvalid } from "../contracts/host.ts";
+
+/** Invalid allowance is discarded independently of a passing credential check. */
+export const optionalObservationOutput = (value: unknown, accounts: unknown, ref?: string) => {
+  if (value === undefined) return {};
+  const parsed = Schema.decodeUnknownOption(AccountObservationResult)(value);
+  return Option.isSome(parsed) && privateObservationStrings(parsed.value, accounts, ref)
+    ? { observation: parsed.value }
+    : { observationInvalid: true as const };
+};
+
+export const observationOutput = (value: unknown, accounts: unknown, ref?: string) =>
+  Effect.gen(function* () {
+    const result = yield* Schema.decodeUnknownEffect(AccountObservationResult)(value).pipe(
+      Effect.mapError(() => new HostOutputInvalid()),
+    );
+    if (!privateObservationStrings(result, accounts, ref)) return yield* new HostOutputInvalid();
+    return yield* Schema.encodeEffect(AccountObservationResult)(result).pipe(
+      Effect.mapError(() => new HostOutputInvalid()),
+    );
+  });
+
+/** Preserve invalid whole check results for the original health decoder. */
+export const splitAccountObservation = (value: unknown) => {
+  if (typeof value !== "object" || value === null || Array.isArray(value))
+    return { health: value, observation: undefined };
+  const { observation, ...health } = value as { readonly observation?: unknown };
+  return { health, observation };
+};
