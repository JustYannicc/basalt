diff --git a/apps/hosted/server/src/implementation/account-observation-policy.ts b/apps/hosted/server/src/implementation/account-observation-policy.ts
new file mode 100644
index 000000000..be5882b82
--- /dev/null
+++ b/apps/hosted/server/src/implementation/account-observation-policy.ts
@@ -0,0 +1,152 @@
+import { Effect, Schema } from "effect";
+import {
+  StorageError,
+  StorageHost,
+  type AccountId,
+  type AccountHealth,
+} from "@executor-js/sdk/core";
+import { ObservationAudience, ObservationPolicy } from "../contracts/account-observations.ts";
+import { OrganizationForbidden } from "../contracts/organization.ts";
+import { AccessConflict } from "../contracts/resource-access.ts";
+import { HostedExecutor } from "../contracts/executor.ts";
+import {
+  accountAccess,
+  currentResourceAuthority,
+  lockCurrentActor,
+  policyDatabase,
+  type ResourceAuthority,
+} from "./resource-policy.ts";
+import { requireGroupSharing } from "./group-sharing.ts";
+
+const table = "hosted_account_observation_access";
+const defaults: ObservationPolicy = {
+  read: { kind: "owners" },
+  refresh: { kind: "owners" },
+  revision: "unconfigured",
+};
+const PolicyRow = Schema.Struct({
+  read_audience: ObservationAudience,
+  refresh_audience: ObservationAudience,
+  revision: Schema.String,
+});
+
+const savedPolicy = (account: AccountId, actor: ResourceAuthority) =>
+  Effect.gen(function* () {
+    const sql = yield* policyDatabase;
+    const records =
+      yield* sql`select read_audience, refresh_audience, revision from hosted_account_observation_access
+    where account_id = ${account} and organization_id = ${actor.organization}`;
+    const found = (yield* Schema.decodeUnknownEffect(Schema.Array(PolicyRow))(records))[0];
+    return found === undefined
+      ? defaults
+      : { read: found.read_audience, refresh: found.refresh_audience, revision: found.revision };
+  }).pipe(
+    Effect.catchTags({ SqlError: () => new StorageError(), SchemaError: () => new StorageError() }),
+  );
+
+const granted = (audience: typeof ObservationAudience.Type, actor: ResourceAuthority) =>
+  Effect.gen(function* () {
+    if (audience.kind === "owners") return false;
+    if (audience.kind === "everyone") return true;
+    if (audience.groups.length === 0) return false;
+    const sql = yield* policyDatabase;
+    const rows =
+      yield* sql`select 1 from hosted_group_members m join hosted_groups g on g.id = m.group_id
+    where m.member_id = ${actor.member} and g.organization_id = ${actor.organization} and ${sql.in("g.id", audience.groups)} limit 1`;
+    return rows.length > 0;
+  }).pipe(Effect.catchTag("SqlError", () => new StorageError()));
+
+/** Account use, pool management and app access never imply global allowance inspection. */
+export const observationAccess = (account: AccountId) =>
+  Effect.gen(function* () {
+    const actor = yield* currentResourceAuthority;
+    const access = yield* accountAccess(account, actor);
+    const executor = yield* Effect.flatten(HostedExecutor);
+    return yield* executor[StorageHost].read(
+      [table],
+      Effect.gen(function* () {
+        const policy = yield* savedPolicy(account, actor);
+        const canInspect =
+          access.canManage || (access.canUse && (yield* granted(policy.read, actor)));
+        const canRefresh =
+          canInspect &&
+          access.canUse &&
+          (access.canManage || (yield* granted(policy.refresh, actor)));
+        return { actor, access, policy, canInspect, canRefresh };
+      }),
+    );
+  });
+
+export const requireObservationAccess = (account: AccountId, refresh = false) =>
+  observationAccess(account).pipe(
+    Effect.flatMap((access) =>
+      (refresh ? access.canRefresh : access.canInspect)
+        ? Effect.succeed(access)
+        : Effect.fail(new OrganizationForbidden()),
+    ),
+  );
+
+export const readObservationPolicy = (account: AccountId) =>
+  observationAccess(account).pipe(
+    Effect.flatMap((state) =>
+      state.access.canManage
+        ? Effect.succeed(state.policy)
+        : Effect.fail(new OrganizationForbidden()),
+    ),
+  );
+
+export const updateObservationPolicy = (account: AccountId, input: ObservationPolicy) =>
+  Effect.gen(function* () {
+    const sql = yield* policyDatabase;
+    const executor = yield* Effect.flatten(HostedExecutor);
+    yield* executor[StorageHost].write(
+      [table],
+      sql.withTransaction(
+        Effect.gen(function* () {
+          const actor = yield* lockCurrentActor;
+          const access = yield* accountAccess(account, actor);
+          if (!access.canManage) return yield* new OrganizationForbidden();
+          for (const audience of [input.read, input.refresh]) {
+            if (access.ownership.kind === "personal" && audience.kind !== "owners")
+              return yield* new OrganizationForbidden();
+            if (audience.kind === "groups")
+              yield* requireGroupSharing(sql, actor.organization, actor.user, audience.groups);
+          }
+          const previous = yield* savedPolicy(account, actor);
+          if (previous.revision !== input.revision)
+            return yield* new AccessConflict({ reason: "changed" });
+          const read = JSON.stringify(input.read),
+            refresh = JSON.stringify(input.refresh);
+          const changed =
+            yield* sql`insert into hosted_account_observation_access (account_id, organization_id, read_audience, refresh_audience)
+      values (${account}, ${actor.organization}, ${read}::jsonb, ${refresh}::jsonb)
+      on conflict (account_id) do update set read_audience = ${read}::jsonb, refresh_audience = ${refresh}::jsonb, revision = gen_random_uuid()::text
+      where hosted_account_observation_access.organization_id = ${actor.organization} and hosted_account_observation_access.revision = ${input.revision}
+      returning account_id`;
+          if (changed.length !== 1) return yield* new AccessConflict({ reason: "changed" });
+        }),
+      ),
+    );
+    return yield* readObservationPolicy(account);
+  }).pipe(
+    Effect.catchTags({ SqlError: () => new StorageError(), SchemaError: () => new StorageError() }),
+  );
+
+/** Legacy displayStatus also contains allowance; keep app health visible without leaking it. */
+export const visibleObservationHealth = (health: AccountHealth) =>
+  Effect.gen(function* () {
+    if (!health.apps.some((entry) => entry.check?.displayStatus !== undefined)) return health;
+    const canInspect = yield* observationAccess(health.account).pipe(
+      Effect.map((access) => access.canInspect),
+      Effect.catchTag("OrganizationForbidden", () => Effect.succeed(false)),
+    );
+    if (canInspect) return health;
+    return {
+      ...health,
+      apps: health.apps.map((entry) => {
+        if (entry.check === null) return entry;
+        const { displayStatus: _display, ...check } = entry.check;
+        return { ...entry, check };
+      }),
+    };
+  });
