+        label: "Requests per minute",
+        observedAt: at,
+        measure: { unit: "requests", used: 12, remaining: 88, limit: 100, remainingRatio: 0.88 },
+        period: { mode: "fixed", seconds: 60 },
+      },
+    ],
+    balances: [
+      {
+        id: "credits",
+        label: "Credits",
+        unit: "USD",
+        available: 25,
+        observedAt: at,
+        expiresAt: new Date(Date.parse(at) + 86_400_000).toISOString(),
+      },
+    ],
+  },
+});
+const Answer = Schema.Struct({ status: Schema.Number, body: Schema.Json });
+type Answer = typeof Answer.Type;
+
+/** A scoped service controls allowance independently of health and can hold one read in flight. */
+export const observationBackend = Effect.gen(function* () {
+  const answer = yield* Ref.make<Answer>({ status: 200, body: allowance() });
+  const health = yield* Ref.make<Answer>({
+    status: 200,
+    body: { accountInfo: { displayName: "Observed identity" } },
+  });
+  const calls = yield* Ref.make(0);
+  const held = yield* Ref.make<
+    { entered: Deferred.Deferred<void>; release: Deferred.Deferred<void> } | undefined
+  >(undefined);
+  const endpoint = (path: "/observation" | "/health") =>
+    HttpRouter.add(
+      "GET",
+      path,
+      Effect.gen(function* () {
+        const request = yield* HttpServerRequest.HttpServerRequest;
+        if (request.headers.authorization !== `Bearer ${observationToken}`)
+          return HttpServerResponse.empty({ status: 401 });
+        if (path === "/observation") {
+          yield* Ref.update(calls, (count) => count + 1);
+          const gate = yield* Ref.get(held);
+          if (gate !== undefined) {
+            yield* Deferred.succeed(gate.entered, undefined);
+            yield* Deferred.await(gate.release);
+          }
+        }
+        const result = yield* Ref.get(path === "/health" ? health : answer);
+        return yield* HttpServerResponse.json(result.body, { status: result.status });
+      }),
+    );
+  const services = yield* Layer.build(
+    HttpRouter.serve(Layer.mergeAll(endpoint("/observation"), endpoint("/health")), {
+      disableLogger: true,
+      disableListenLog: true,
+    }).pipe(Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 }))),
+  );
+  const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+  if (!("port" in server.address)) return yield* Effect.die("Fixture must listen on TCP");
+  return {
+    origin: `http://127.0.0.1:${server.address.port}`,
+    calls: Ref.get(calls),
+    answer: (value: Answer) => Ref.set(answer, value),
+    health: (value: Answer) => Ref.set(health, value),
+    hold: Effect.gen(function* () {
+      const entered = yield* Deferred.make<void>(),
+        release = yield* Deferred.make<void>();
+      yield* Ref.set(held, { entered, release });
+      const releaseHold = Deferred.succeed(release, undefined).pipe(
+        Effect.andThen(Ref.set(held, undefined)),
+      );
+      yield* Effect.addFinalizer(() => releaseHold);
+      return { entered: Deferred.await(entered), release: releaseHold };
+    }),
+  };
+});
+
+/** Hook changes intentionally leave the provider's declaration identical. */
+export const observationSource = (
+  origin: string,
+  options: { observe?: boolean; health?: boolean } = {},
+) => `import { defineApp, defineProvider, secrets, object, string, router, query, ProviderError } from "apps";
+const read = async (context, path) => {
+  const response = await context.fetch(${JSON.stringify(origin)} + path, {
+    signal: context.signal, headers: { authorization: "Bearer " + context.account.fields.token },
+  });
+  if (!response.ok) throw new ProviderError({ reason: response.status === 401 ? "unauthorized" : response.status === 429 ? "rate_limited" : "unavailable", status: response.status });
+  return await response.json();
+};
+const service = defineProvider({ name: "Observation service", auth: { key: secrets({label:"API key",fields:object({token:string()})}) },
+${options.health ? 'health: context => read(context, "/health"),' : ""}
+${options.observe ? 'observeAccount: context => read(context, "/observation"),' : ""}
+});
+export default defineApp({ user:{accounts:{service}} }, { tools:router({ ping:query({input:object({})},async()=>true) }) });`;
+
+export const observationFixture = (
+  options: { observe?: boolean; health?: boolean; shared?: boolean; framework?: string } = {
+    observe: true,
+    health: true,
+  },
+) =>
+  Effect.gen(function* () {
+    const api = yield* Api,
+      actors = yield* Actors,
+      backend = yield* observationBackend;
+    const prefix = `/api/organizations/${actors.organization.id}`;
+    const files = (content: string) => [
+      { path: "index.ts", content },
+      options.framework === undefined
+        ? appsManifest
+        : {
+            path: "package.json",
+            content: JSON.stringify({ dependencies: { apps: options.framework } }),
+          },
+    ];
+    const created = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+      name: "Observation fixture",
+      files: files(observationSource(backend.origin, options)),
+    });
+    expect(created.status, JSON.stringify(created.body)).toBe(200);
+    const app = yield* body(
+      Schema.Struct({
+        ...App.fields,
+        requirements: Schema.Struct({
+          accounts: Schema.Record(Schema.String, Schema.Struct({ provider: Schema.String })),
+        }),
+      }),
+      created,
+    );
+    const appPath = `${prefix}/apps/${app.id}`;
+    let account: string | undefined;
+    yield* Effect.addFinalizer(() =>
+      Effect.gen(function* () {
+        yield* serverControl("start");
+        yield* api.request(actors.owner, "DELETE", appPath);
+        if (account !== undefined)
+          yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`);
+      }).pipe(Effect.orDie),
+    );
+    const pending = yield* body(
+      Resource,
+      yield* api.request(
+        actors.owner,
+        "POST",
+        connectionsPath(appPath, "user", "service"),
+        options.shared ? { destination: { kind: "shared", audience: { kind: "everyone" } } } : {},
+      ),
+    );
+    const saved = yield* api.request(
+      actors.owner,
+      "POST",
+      `${prefix}/connections/${pending.id}/submit`,
+      { method: "key", fields: { token: observationToken } },
+    );
+    expect(saved.status, JSON.stringify(saved.body)).toBe(200);
+    account = (yield* body(Resource, saved)).id;
+    const accountPath = `${prefix}/accounts/${account}`;
+    return {
+      api,
+      actors,
+      prefix,
+      app,
+      appPath,
+      account,
+      accountPath,
+      backend,
+      deploy: (options: { observe?: boolean; health?: boolean }) =>
+        api.request(actors.owner, "POST", `${appPath}/deploy`, {
+          files: files(observationSource(backend.origin, options)),
+        }),
+      read: () => api.request(actors.owner, "GET", `${accountPath}/observations`),
+      refresh: () => api.request(actors.owner, "POST", `${accountPath}/observations/refresh`),
+      check: () => api.request(actors.owner, "POST", `${accountPath}/health`),
+      detail: () => api.request(actors.owner, "GET", accountPath),
+    };
+  });
+
+export const ObservationView = Schema.Struct({
+  account: Schema.String,
+  canInspect: Schema.Boolean,
+  canRefresh: Schema.Boolean,
+  reports: Schema.Array(
+    Schema.Struct({
+      source: Schema.Struct({ kind: Schema.String, id: Schema.String, version: Schema.String }),
+      credentialGeneration: Schema.Number,
+      result: Schema.NullOr(Schema.Json),
+      freshness: Schema.String,
+      checkedAt: Schema.NullOr(Schema.String),
+      lastAttempt: Schema.NullOr(
+        Schema.Struct({ attemptedAt: Schema.String, outcome: Schema.String }),
+      ),
+      collecting: Schema.Boolean,
+      nextAllowedAt: Schema.NullOr(Schema.String),
+    }),
+  ),
+});
