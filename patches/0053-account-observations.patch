+++ b/e2e/tests/account-observations.spec.ts
@@ -0,0 +1,202 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Fiber, Schema } from "effect";
+import { body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import {
+  allowance,
+  observationFixture,
+  ObservationView,
+} from "../support/account-observation-fixture.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Account observations", (it) => {
+  it.effect(scenarios.accountObservations.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* observationFixture();
+        const read = () =>
+          f.read().pipe(
+            Effect.flatMap((response) => {
+              expect(response.status).toBe(200);
+              return body(ObservationView, response);
+            }),
+          );
+        const refresh = () =>
+          f.refresh().pipe(
+            Effect.flatMap((response) => {
+              expect(response.status, JSON.stringify(response.body)).toBe(200);
+              return body(ObservationView, response);
+            }),
+          );
+        expect((yield* read()).reports).toEqual([]);
+        expect(yield* f.backend.calls).toBe(0);
+        const health = yield* f.check();
+        expect(health.status, JSON.stringify(health.body)).toBe(200);
+        expect(yield* f.backend.calls).toBe(0);
+        const pending = yield* f.backend.hold;
+        const requests = yield* Effect.all([refresh(), refresh(), refresh(), refresh()], {
+          concurrency: 4,
+        }).pipe(Effect.forkChild);
+        yield* pending.entered;
+        expect((yield* read()).reports[0]?.collecting).toBe(true);
+        yield* pending.release;
+        yield* Fiber.join(requests);
+        const first = yield* read();
+        expect(first.reports).toHaveLength(1);
+        expect(first.reports[0]).toMatchObject({
+          freshness: "fresh",
+          collecting: false,
+          lastAttempt: { outcome: "success" },
+        });
+        expect(first.reports[0]?.result).toMatchObject({
+          observation: {
+            windows: [{ id: "requests", measure: { limit: 100, remainingRatio: 0.88 } }],
+          },
+        });
+        expect(yield* f.backend.calls).toBe(1);
+        expect((yield* f.detail()).body).toMatchObject({ health: health.body });
+        yield* f.backend.answer({ status: 503, body: {} });
+        yield* refresh();
+        expect(yield* f.backend.calls).toBe(1);
+        yield* serverControl("stop");
+        yield* serverControl("clock/advance", 200, { milliseconds: 6 * 60_000 });
+        yield* serverControl("start");
+        const failed = yield* refresh();
+        expect(failed.reports[0]).toMatchObject({
+          freshness: "stale",
+          lastAttempt: { outcome: "unavailable" },
+          result: first.reports[0]?.result,
+        });
+        expect(yield* f.backend.calls).toBe(2);
+        expect((yield* f.detail()).body).toMatchObject({ health: health.body });
+        // Invalid optional allowance must not turn a successful credential check into a failure.
+        yield* f.backend.health({
+          status: 200,
+          body: {
+            accountInfo: { displayName: "Observed identity" },
+            observation: { broken: true },
+          },
+        });
+        const invalid = yield* f.check();
+        expect(invalid.body).toMatchObject({ apps: [{ check: { status: "healthy" } }] });
+        expect((yield* read()).reports[0]).toMatchObject({
+          lastAttempt: { outcome: "invalid" },
+          result: first.reports[0]?.result,
+        });
+        const provider = f.app.requirements.accounts.service?.provider;
+        const changed = yield* f.deploy({ health: true });
+        expect(changed.status, JSON.stringify(changed.body)).toBe(200);
+        const metadata = yield* body(
+          Schema.Struct({
+            requirements: Schema.Struct({
+              accounts: Schema.Record(Schema.String, Schema.Struct({ provider: Schema.String })),
+            }),
+          }),
+          yield* f.api.request(f.actors.owner, "GET", f.appPath),
+        );
+        expect(metadata.requirements.accounts.service?.provider).toBe(provider);
+        expect((yield* read()).reports[0]?.freshness).toBe("outdated");
+        yield* f.backend.health({ status: 200, body: {} });
+        expect((yield* f.check()).status).toBe(200);
+        expect((yield* f.detail()).body).toMatchObject({ account: { id: f.account, provider } });
+      }),
+    ),
+  );
+  it.effect(scenarios.accountObservationsOptional.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* observationFixture({ observe: true });
+        expect((yield* f.check()).body).toMatchObject({
+          apps: [{ checkable: false, check: null }],
+        });
+        const refreshed = yield* f.refresh();
+        expect(refreshed.status, JSON.stringify(refreshed.body)).toBe(200);
+        const first = yield* body(ObservationView, refreshed);
+        expect(first.reports[0]?.result).toMatchObject({
+          observation: { offering: "metered_api" },
+        });
+        expect((yield* f.detail()).body).toMatchObject({
+          health: { apps: [{ checkable: false, check: null }] },
+        });
+        const changed = yield* f.deploy({ health: true });
+        expect(changed.status, JSON.stringify(changed.body)).toBe(200);
+        yield* serverControl("stop");
+        yield* serverControl("clock/advance", 200, { milliseconds: 6 * 60_000 });
+        yield* serverControl("start");
+        const unsupported = yield* f.refresh();
+        expect(unsupported.status, JSON.stringify(unsupported.body)).toBe(200);
+        expect((yield* body(ObservationView, unsupported)).reports[0]).toMatchObject({
+          freshness: "outdated",
+          result: first.reports[0]?.result,
+        });
+        expect(yield* f.backend.calls).toBe(1);
+        expect((yield* f.check()).body).toMatchObject({
+          apps: [{ checkable: true, check: { status: "healthy" } }],
+        });
+      }),
+    ),
+  );
+  it.effect(scenarios.accountObservationRecovery.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* observationFixture();
+        const initial = yield* f.refresh();
+        const first = yield* body(ObservationView, initial);
+        const initialVersion = first.reports[0]?.source.version;
+        const changed = yield* f.deploy({ observe: true });
+        expect(changed.status).toBe(200);
+        yield* f.backend.answer({ status: 503, body: {} });
+        yield* serverControl("stop");
+        yield* serverControl("clock/advance", 200, { milliseconds: 6 * 60_000 });
+        yield* serverControl("start");
+        const failed = yield* f.refresh();
+        expect((yield* body(ObservationView, failed)).reports[0]).toMatchObject({
+          source: { version: initialVersion },
+          freshness: "outdated",
+          result: first.reports[0]?.result,
+          lastAttempt: { outcome: "unavailable" },
+        });
+        const now = new Date().toISOString();
+        const future = new Date(Date.now() + 365 * 86_400_000).toISOString();
+        yield* f.backend.answer({
+          status: 200,
+          body: { ...allowance(now), collection: { attemptedAt: future, outcome: "success" } },
+        });
+        yield* serverControl("stop");
+        yield* serverControl("clock/advance", 200, { milliseconds: 2 * 60_000 });
+        yield* serverControl("start");
+        expect((yield* body(ObservationView, yield* f.refresh())).reports[0]).toMatchObject({
+          lastAttempt: { outcome: "invalid" },
+          result: first.reports[0]?.result,
+        });
+        yield* f.backend.answer({ status: 200, body: allowance(now) });
+        yield* serverControl("stop");
+        yield* serverControl("clock/advance", 200, { milliseconds: 2 * 60_000 });
+        yield* serverControl("start");
+        const recovered = yield* body(ObservationView, yield* f.refresh());
+        expect(recovered.reports[0]?.lastAttempt?.outcome).toBe("success");
+        expect(recovered.reports[0]?.source.version).not.toBe(initialVersion);
+      }),
+    ),
+  );
+  it.effect(scenarios.accountObservationInvalidHealth.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* observationFixture();
+        for (const value of [false, "invalid check", ["unexpected array"]]) {
+          yield* f.backend.health({ status: 200, body: value });
+          const checked = yield* f.check();
+          expect(checked.status, JSON.stringify(checked.body)).toBe(200);
+          expect(checked.body).toMatchObject({ apps: [{ check: { status: "check_failed" } }] });
+        }
+        yield* f.backend.health({ status: 200, body: {} });
+        expect((yield* f.check()).body).toMatchObject({ apps: [{ check: { status: "healthy" } }] });
+      }),
+    ),
+  );
+});
