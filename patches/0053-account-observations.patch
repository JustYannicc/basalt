@@ -0,0 +1,17 @@
+import { Schema } from "effect";
+import { column, idColumn, table } from "fumadb-effect/schema";
+import { AccountId, OwnerId } from "../contracts/shared.ts";
+
+/** Separate from health JSON so a failed refresh cannot erase the last successful reading. */
+export const accountObservations = table("executor_account_observations", {
+  id: idColumn("id", Schema.String, { type: "varchar(255)" }),
+  account: column("account", AccountId, { type: "varchar(255)" }),
+  owner: column("owner", OwnerId, { type: "varchar(255)" }),
+  source: column("source", Schema.String, { type: "varchar(255)" }),
+  generation: column("generation", Schema.Int),
+  data: column("data", Schema.NullOr(Schema.Json)).default(null),
+  checkedAt: column("checked_at", Schema.NullOr(Schema.Date)).default(null),
+  nextAllowedAt: column("next_allowed_at", Schema.Date),
+  lease: column("lease", Schema.NullOr(Schema.String), { type: "varchar(255)" }).default(null),
+  leaseUntil: column("lease_until", Schema.NullOr(Schema.Date)).default(null),
+}).unique("executor_account_observations_source_generation", ["account", "source", "generation"]);
diff --git a/packages/sdk/src/implementation/account-observation-store.ts b/packages/sdk/src/implementation/account-observation-store.ts
new file mode 100644
index 000000000..4b11e0e17
--- /dev/null
+++ b/packages/sdk/src/implementation/account-observation-store.ts
@@ -0,0 +1,290 @@
+import { Clock, type Crypto, Effect, Option, Schema } from "effect";
+import type { AccountCheckResult, AccountObservationResult } from "apps/contracts";
+import { StoredObservationData } from "../contracts/account-observation.ts";
+import type { App } from "../contracts/apps.ts";
+import type { StoredAccount } from "../contracts/storage.ts";
+import { AppId, StorageError, type AccountId, type VersionId } from "../contracts/shared.ts";
+import { query, transaction, type Query } from "./database.ts";
+import { storedAccount } from "./accounts.ts";
+
+const decode = Schema.decodeUnknownOption(StoredObservationData);
+const encode = Schema.encodeSync(StoredObservationData);
+const freshnessMillis = 5 * 60_000;
+export const observationLeaseMillis = 20_000;
+export const observationId = (account: StoredAccount, app: AppId) =>
+  `${account.id}:${account.credentialGeneration}:${app}`;
+
+/** Freshness belongs to each source instant, including when a cached request succeeded just now. */
+const fresh = (result: AccountObservationResult, now: number) => {
+  const readings = [
+    { observedAt: result.observedAt },
+    ...(result.observation.plan === undefined ? [] : [result.observation.plan]),
+    ...result.observation.windows,
+    ...result.observation.balances,
+  ];
+  return readings.every((reading) => {
+    const observed = Date.parse(reading.observedAt);
+    const stale =
+      "staleAt" in reading && reading.staleAt !== undefined
+        ? Date.parse(reading.staleAt)
+        : Infinity;
+    const reset =
+      "resetsAt" in reading && typeof reading.resetsAt === "string"
+        ? Date.parse(reading.resetsAt)
+        : Infinity;
+    const expiry =
+      "expiresAt" in reading && typeof reading.expiresAt === "string"
+        ? Date.parse(reading.expiresAt)
+        : Infinity;
+    return (
+      observed <= now + 60_000 && now < Math.min(observed + freshnessMillis, stale, reset, expiry)
+    );
+  });
+};
+
+export const validObservationTime = (result: AccountObservationResult, now: number) =>
+  [
+    result.observedAt,
+    result.observation.plan?.observedAt,
+    ...result.observation.windows.map((window) => window.observedAt),
+    ...result.observation.balances.map((balance) => balance.observedAt),
+    result.collection?.attemptedAt,
+  ].every((value) => value === undefined || Date.parse(value) <= now + 60_000);
+
+export const makeObservationStore = (db: Query, crypto: Crypto.Crypto) => {
+  const rows = (account: AccountId) =>
+    query(() =>
+      db.findMany("accountObservations", {
+        where: (b) => b("account", "=", account),
+      }),
+    );
+  const report = (account: StoredAccount, apps: readonly App[]) =>
+    Effect.gen(function* () {
+      const now = yield* Clock.currentTimeMillis;
+      const all = yield* rows(account.id);
+      const authorized = new Set<string>(apps.map((app) => app.id));
+      const current = all.filter(
+        (row) => row.generation === account.credentialGeneration && authorized.has(row.source),
+      );
+      return {
+        account: account.id,
+        reports: current.flatMap((row) => {
+          const data = decode(row.data);
+          if (Option.isNone(data)) return [];
+          const value = data.value;
+          const app = apps.find((app) => app.id === row.source);
+          const outdated = app === undefined || app.activeVersion !== value.version;
+          const failed = value.lastAttempt !== null && value.lastAttempt.outcome !== "success";
+          return [
+            {
+              source: {
+                kind: "app" as const,
+                id: row.source,
+                label: app?.name ?? "Unavailable app",
+                version: value.version,
+              },
+              credentialGeneration: row.generation,
+              result: value.result,
+              checkedAt: row.checkedAt?.toISOString() ?? null,
+              lastAttempt: value.lastAttempt,
+              freshness:
+                value.result === null
+                  ? ("unavailable" as const)
+                  : outdated
+                    ? ("outdated" as const)
+                    : failed || !fresh(value.result, now)
+                      ? ("stale" as const)
+                      : ("fresh" as const),
+              collecting: row.lease !== null && (row.leaseUntil?.getTime() ?? 0) > now,
+              nextAllowedAt:
+                row.nextAllowedAt.getTime() > now ? row.nextAllowedAt.toISOString() : null,
+            },
+          ];
+        }),
+      };
+    });
+
+  const begin = (account: StoredAccount, app: App) =>
+    transaction(db, () =>
+      Effect.gen(function* () {
+        const now = yield* Clock.currentTimeMillis;
+        const id = observationId(account, app.id);
+        const token = yield* crypto.randomUUIDv4.pipe(Effect.mapError(() => new StorageError()));
+        yield* query(() =>
+          db.upsert("accountObservations", {
+            where: (b) => b("id", "=", id),
+            create: {
+              id,
+              account: account.id,
+              owner: account.owner,
+              source: app.id,
+              generation: account.credentialGeneration,
+              data: encode({ version: app.activeVersion!, result: null, lastAttempt: null }),
+              checkedAt: null,
+              nextAllowedAt: new Date(0),
+              lease: null,
+              leaseUntil: null,
+            },
+            update: { source: app.id },
+          }),
+        );
+        yield* query(() =>
+          db.updateMany("accountObservations", {
+            where: (b) =>
+              b.and(
+                b("id", "=", id),
+                b("nextAllowedAt", "<=", new Date(now)),
+                b.or(b("lease", "is", null), b("leaseUntil", "<", new Date(now))),
+              ),
+            set: {
+              lease: token,
+              leaseUntil: new Date(now + observationLeaseMillis),
+              nextAllowedAt: new Date(now + 60_000),
+            },
+          }),
+        );
+        const row = yield* query(() =>
+          db.findFirst("accountObservations", { where: (b) => b("id", "=", id) }),
+        );
+        return row?.lease === token ? { id, token, startedAt: now } : undefined;
+      }),
+    );
+
+  const save = (input: {
+    readonly account: StoredAccount;
+    readonly app: AppId;
+    readonly version: VersionId;
+    readonly result?: AccountObservationResult | undefined;
+    readonly outcome: "success" | "unavailable" | "rate_limited" | "invalid" | "timed_out";
+    readonly startedAt: number;
+    readonly lease?: { readonly id: string; readonly token: string };
+  }) =>
+    transaction(db, () =>
+      Effect.gen(function* () {
+        const now = yield* Clock.currentTimeMillis;
+        const current = yield* storedAccount(db, input.account.id, input.account.owner).pipe(
+          Effect.catchTag("AccountNotFound", () => Effect.succeed(undefined)),
+        );
+        const app = yield* query(() =>
+          db.findFirst("apps", { where: (b) => b("id", "=", input.app) }),
+        );
+        if (
+          current === undefined ||
+          current.credentialGeneration !== input.account.credentialGeneration ||
+          app?.activeDeployment !== input.version
+        )
+          return;
+        const id = observationId(current, input.app);
+        const row = yield* query(() =>
+          db.findFirst("accountObservations", { where: (b) => b("id", "=", id) }),
+        );
+        if (input.lease !== undefined && row?.lease !== input.lease.token) return;
+        if (
+          input.lease === undefined &&
+          row?.lease !== null &&
+          row?.lease !== undefined &&
+          (row.leaseUntil?.getTime() ?? 0) > now
+        )
+          return;
+        const previous = decode(row?.data);
+        const old = Option.isSome(previous) ? previous.value : undefined;
+        if (
+          row?.checkedAt !== null &&
+          row?.checkedAt !== undefined &&
+          row.checkedAt.getTime() > input.startedAt
+        )
+          return;
+        const sourceAttempt = input.result?.collection;
+        const valid = input.result !== undefined && validObservationTime(input.result, now);
+        const outcome =
+          input.result !== undefined && !valid
+            ? "invalid"
+            : (sourceAttempt?.outcome ?? input.outcome);
+        const result =
+          valid &&
+          (old?.result == null ||
+            Date.parse(input.result.observedAt) >= Date.parse(old.result.observedAt))
+            ? input.result
+            : (old?.result ?? null);
+        const attemptedAt =
+          valid && sourceAttempt !== undefined
+            ? sourceAttempt.attemptedAt
+            : new Date(input.startedAt).toISOString();
+        const retry = valid ? sourceAttempt?.retryAt : undefined;
+        const nextAllowedAt = new Date(
+          Math.max(
+            now + (outcome === "success" ? freshnessMillis : 60_000),
+            retry === undefined ? 0 : Date.parse(retry),
+          ),
+        );
+        const state = {
+          data: encode({
+            version: result === input.result ? input.version : (old?.version ?? input.version),
+            result,
+            lastAttempt: {
+              attemptedAt,
+              outcome,
+              ...(retry === undefined ? {} : { retryAt: retry }),
+            },
+          }),
+          checkedAt: new Date(now),
+          nextAllowedAt,
+          lease: null,
+          leaseUntil: null,
+        };
+        yield* query(() =>
+          db.upsert("accountObservations", {
+            where: (b) => b("id", "=", id),
+            create: {
+              id,
+              account: current.id,
+              owner: current.owner,
+              source: input.app,
+              generation: current.credentialGeneration,
+              ...state,
+            },
+            update: state,
+          }),
+        );
+      }),
+    );
+
+  const release = (claim: { readonly id: string; readonly token: string }) =>
+    query(() =>
+      db.updateMany("accountObservations", {
+        where: (b) => b.and(b("id", "=", claim.id), b("lease", "=", claim.token)),
+        set: { lease: null, leaseUntil: null },
+      }),
+    );
+  const unsupported = (claim: { readonly id: string; readonly token: string }) =>
+    transaction(db, () =>
+      Effect.gen(function* () {
+        const row = yield* query(() =>
+          db.findFirst("accountObservations", { where: (b) => b("id", "=", claim.id) }),
+        );
+        if (row?.lease !== claim.token) return;
+        const state = decode(row.data);
+        if (Option.isSome(state) && state.value.result !== null) return;
+        yield* query(() =>
+          db.deleteMany("accountObservations", {
