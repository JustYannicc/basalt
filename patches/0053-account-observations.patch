@@ -0,0 +1,51 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect } from "effect";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { observationFixture } from "../support/account-observation-fixture.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Observation storage upgrade", (it) => {
+  it.effect(scenarios.accountObservationMigration.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* observationFixture();
+        const health = yield* f.check();
+        expect(health.status).toBe(200);
+        // Reconstruct the supported 4.0.16 layout; existing account, health and app rows remain intact.
+        yield* legacyStorage([
+          { sql: "DROP TABLE hosted_account_observation_access" },
+          { sql: "DROP TABLE executor_account_observations" },
+          { sql: "UPDATE private_executor_settings SET value = '4.0.16' WHERE key = 'version'" },
+          { sql: "DELETE FROM private_hosted_migrations WHERE migration_id = 10" },
+        ]);
+        yield* serverControl("start");
+        expect((yield* f.detail()).body).toMatchObject({
+          account: { id: f.account },
+          health: health.body,
+        });
+        expect((yield* f.refresh()).status).toBe(200);
+        const saved = (yield* f.read()).body;
+        const [versions, steps, tables] = yield* legacyStorage([
+          { sql: "SELECT value FROM private_executor_settings WHERE key = 'version'" },
+          { sql: "SELECT name FROM private_hosted_migrations WHERE migration_id = 10" },
+          {
+            sql: "SELECT table_name FROM information_schema.tables WHERE table_name IN ('executor_account_observations', 'hosted_account_observation_access') ORDER BY table_name",
+          },
+        ]);
+        expect(versions).toEqual([{ value: "4.0.17" }]);
+        expect(steps).toEqual([{ name: "account_observations" }]);
+        expect(tables).toEqual([
+          { table_name: "executor_account_observations" },
+          { table_name: "hosted_account_observation_access" },
+        ]);
+        yield* serverControl("start");
+        yield* serverControl("restart");
+        expect((yield* f.read()).body).toEqual(saved);
+        expect((yield* f.detail()).body).toMatchObject({ health: health.body });
+      }),
+    ),
+  );
+});
