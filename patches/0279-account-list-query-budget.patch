new file mode 100644
index 0000000..3d132e0
--- /dev/null
+++ b/apps/hosted/web/src/contracts/account-polling.ts
@@ -0,0 +1,108 @@
+/** One mounted clock reconciles account views; failures never create a faster polling lane. */
+import type { AccountHealth } from "@executor-js/sdk";
+import { Effect } from "effect";
+import { Atom, AsyncResult } from "effect/reactivity";
+
+const interval = 30_000;
+const maximumBackoff = 10;
+const activeInterval = 5_000;
+const cadence = Atom.readable((get) => {
+  if (typeof window === "undefined") return 0;
+  let tick = 0;
+  get.addFinalizer(
+    Effect.runCallback(
+      Effect.forever(
+        Effect.sleep(interval).pipe(Effect.andThen(() => Effect.sync(() => get.setSelf(++tick)))),
+      ),
+    ),
+  );
+  return tick;
+});
+
+/** Focus and acknowledged writes still refresh immediately; only periodic reconciliation backs off. */
+export const accountPolling = <A, E>(
+  source: Atom.Atom<AsyncResult.AsyncResult<A, E>>,
+  pending?: (value: A) => boolean,
+  unavailableHealth?: (value: A) => boolean,
+  options: { readonly active?: boolean } = {},
+): Atom.Atom<AsyncResult.AsyncResult<A, E>> =>
+  Atom.readable(
+    (get) => {
+      if (typeof window === "undefined") return get(source);
+      let value = get.once(source);
+      let tick = get.once(cadence);
+      let readAt = tick;
+      let unsettledAt: number | undefined;
+      let backoff = 2;
+      const unavailable = () =>
+        AsyncResult.isFailure(value) ||
+        (AsyncResult.isSuccess(value) && unavailableHealth?.(value.value) === true);
+      const unsettled = () =>
+        unavailable() || (AsyncResult.isSuccess(value) && pending?.(value.value) === true);
+      const active = () =>
+        options.active === true && AsyncResult.isSuccess(value) && pending?.(value.value) === true;
+      const observe = () => {
+        if (!unsettled()) {
+          unsettledAt = undefined;
+          backoff = 2;
+        } else unsettledAt ??= tick;
+      };
+      observe();
+      get.subscribe(source, (next) => {
+        value = next;
+        readAt = tick;
+        observe();
+        get.setSelf(next);
+      });
+      if (options.active)
+        get.addFinalizer(
+          Effect.runCallback(
+            Effect.forever(
+              Effect.sleep(activeInterval).pipe(
+                Effect.andThen(() =>
+                  Effect.sync(() => {
+                    if (active() && !value.waiting && document.visibilityState === "visible") {
+                      readAt = tick;
+                      get.refresh(source);
+                    }
+                  }),
+                ),
+              ),
+            ),
+          ),
+        );
+      get.subscribe(cadence, (next) => {
+        tick = next;
+        const age = unsettledAt === undefined ? 0 : tick - unsettledAt;
+        // Unavailable reads wait two ticks; prolonged pending work uses the same bounded backoff.
+        const delay = unsettled() && (unavailable() || age >= 1) ? backoff : 1;
+        if (
+          !active() &&
+          !value.waiting &&
+          document.visibilityState === "visible" &&
+          tick - readAt >= delay
+        ) {
+          readAt = tick;
+          if (unsettled()) backoff = Math.min(maximumBackoff, backoff * 2);
+          get.refresh(source);
+        }
+      });
+      return value;
+    },
+    (refresh) => refresh(source),
+  );
+
+/** A failed or missing watched check gives no reason to increase reconciliation traffic. */
+export const unavailableAccountHealth = (health: AccountHealth | undefined) => {
+  const checks = [
+    ...(health?.apps ?? []),
+    ...(health?.driver === undefined ? [] : [health.driver]),
+  ];
+  return checks.some(
+    ({ checkable, check }) =>
+      checkable &&
+      (check === null ||
+        !check.current ||
+        ["upstream_unavailable", "check_failed", "tools_unavailable"].includes(check.status)),
+  );
+};
