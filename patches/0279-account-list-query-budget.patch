+/** Resolve all public identity metadata with one storage read per list. */
+export const accountIdentities = (
+  db: Query,
+  accounts: readonly Pick<StoredAccount, "id" | "owner" | "identityId">[],
+  lifecycle: ResourceLifecycle | undefined,
+) =>
+  Effect.gen(function* () {
+    const identified = accounts.filter((account) => account.identityId !== null);
+    if (identified.length === 0) return new Map<StoredAccount["id"], AccountIdentity>();
+    const placements =
+      lifecycle?.accountIdentityPlacements === undefined
+        ? new Map(
+            yield* Effect.forEach(identified, (account) =>
+              identityPlacement(account, lifecycle).pipe(
+                Effect.map((placement) => [account.id, placement] as const),
+              ),
+            ),
+          )
+        : yield* lifecycle.accountIdentityPlacements(identified);
+    const placed = identified.filter((account) => placements.get(account.id) != null);
+    if (placed.length === 0) return new Map<StoredAccount["id"], AccountIdentity>();
+    const identityIds = [
+      ...new Set(
+        placed.flatMap((account) => (account.identityId === null ? [] : [account.identityId])),
+      ),
+    ];
+    const rows = yield* query(() =>
+      db.findMany("accountIdentities", {
+        select: ["id", "owner", "placement", "issuer", "name", "label"],
+        where: (b) => b("id", "in", identityIds),
+      }),
+    );
+    const byId = new Map(rows.map((row) => [row.id, row]));
+    const entries = yield* Effect.forEach(identified, (account) =>
+      Effect.gen(function* () {
+        const row = account.identityId === null ? undefined : byId.get(account.identityId);
+        if (
+          row === undefined ||
+          row.owner !== account.owner ||
+          row.placement !== placements.get(account.id)
+        )
+          return [];
+        const identity = yield* Schema.decodeUnknownEffect(AccountIdentity)(row).pipe(
+          Effect.mapError(() => new StorageError()),
+        );
+        return [[account.id, identity] as const];
+      }),
+    );
+    return new Map(entries.flat());
+  });
