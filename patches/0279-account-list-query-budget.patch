@@ -0,0 +1,26 @@
+import type { SqlClient } from "effect/sql/SqlClient";
+import type { Statement } from "effect/sql";
+import type { Provider } from "../../contracts/provider.ts";
+
+/** PostgreSQL text sets must not exhaust the bind-message parameter limit. */
+export const stringSet = (
+  sql: SqlClient,
+  left: Statement.Fragment | Statement.Identifier,
+  input: readonly string[],
+  provider: Provider,
+): Statement.Fragment => {
+  const values = [...new Set(input)];
+  if (values.length === 0) return sql.literal("1=0");
+  if (provider === "postgresql" || provider === "cockroachdb") {
+    // Bind a quoted array literal as text, then let PostgreSQL type it. This also works on
+    // SqlClient implementations without a driver-specific array parameter constructor.
+    const array = `{${values.map((value) => `"${value.replaceAll("\\", "\\\\").replaceAll('"', '\\"')}"`).join(",")}}`;
+    return sql`${left} = ANY(CAST(${array} AS text[]))`;
+  }
+  // Native parameters preserve MySQL's column collation and do not truncate long values.
+  if (provider === "mysql")
+    return sql`${left} IN (${sql.csv(values.map((value) => sql`${value}`))})`;
+  const json = JSON.stringify(values);
+  if (provider === "sqlite") return sql`${left} IN (SELECT value FROM json_each(${json}))`;
+  return sql`${left} IN (SELECT value FROM OPENJSON(${json}))`;
+};
