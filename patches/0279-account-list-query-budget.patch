+import { stringSet } from "fumadb-effect/sql";
+import { Effect } from "effect";
+import type { SqlClient } from "effect/sql";
+import { StorageError, type Account, type AccountId } from "@executor-js/sdk/core";
+
+/** The ordered groups are part of the durable identity placement key. */
+export const accountIdentityPlacements =
+  (sql: SqlClient.SqlClient) => (accounts: readonly Pick<Account, "id" | "owner">[]) =>
+    Effect.gen(function* () {
+      if (accounts.length === 0) return new Map<AccountId, string | null>();
+      const rows = yield* sql<{
+        account_id: AccountId;
+        organization_id: string;
+        kind: string;
+        personal_user_id: string | null;
+        audience: string | null;
+        groups: string[];
+      }>`
+      select a.account_id, a.organization_id, a.kind, a.personal_user_id, a.audience,
+        coalesce((select json_agg(g.group_id order by g.group_id)
+          from hosted_account_groups g where g.account_id = a.account_id), '[]'::json) as groups
+      from hosted_account_access a where ${stringSet(
+        sql,
+        sql("a.account_id"),
+        accounts.map((account) => account.id),
+        "postgresql",
+      )}`;
+      return new Map(
+        rows.map((row) => [
+          row.account_id,
+          JSON.stringify([
+            row.organization_id,
+            row.kind,
+            row.personal_user_id ?? null,
+            row.audience ?? null,
+            row.groups,
+          ]),
+        ]),
+      );
+    }).pipe(Effect.catchTag("SqlError", () => new StorageError()));
