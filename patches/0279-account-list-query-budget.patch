index 0000000..f53552e
--- /dev/null
+++ b/apps/hosted/testing/string-set-fixture.ts
@@ -0,0 +1,48 @@
+/** Loopback test host only: drive the public adapter with a bind-limit-sized account set. */
+import { Effect, Schema } from "effect";
+import { HttpRouter, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { SqlClient } from "effect/sql";
+import { fumadb } from "fumadb-effect";
+import { schema, table, idColumn } from "fumadb-effect/schema";
+import { sqlAdapter, stringSet } from "fumadb-effect/sql";
+
+const shape = schema({
+  version: "1.0.0",
+  tables: {
+    accounts: table("executor_accounts", {
+      id: idColumn("id", Schema.String, { type: "varchar(255)" }),
+    }),
+  },
+});
+const orm = fumadb({ namespace: "set-boundary", schemas: [shape] })
+  .client(sqlAdapter({ provider: "postgresql" }))
+  .orm("1.0.0");
+export const stringSetFixture = HttpRouter.add(
+  "POST",
+  "/api/devtools/string-set-boundary",
+  Effect.gen(function* () {
+    const { values } = yield* HttpServerRequest.schemaBodyJson(
+      Schema.Struct({ values: Schema.Array(Schema.String) }),
+    );
+    const sql = yield* SqlClient.SqlClient;
+    const rows = yield* orm.findMany("accounts", { where: (b) => b("id", "in", values) });
+    const direct = yield* sql<{ id: string }>`select id from executor_accounts
+      where ${stringSet(sql, sql("id"), values, "postgresql")}`;
+    const excluded = yield* orm.findMany("accounts", { where: (b) => b("id", "not in", values) });
+    const escaped = yield* Effect.forEach(
+      ["", "NULL", "a,b", "a\\b", 'a"b', "a\nb", "x'); SELECT 1; --"],
+      (value) =>
+        sql<{
+          found: boolean;
+        }>`select ${stringSet(sql, sql`${value}`, values, "postgresql")} as found`.pipe(
+          Effect.map((rows) => rows[0]?.found ?? false),
+        ),
+    );
+    return HttpServerResponse.jsonUnsafe({
+      escaped,
+      ids: rows.map(({ id }) => id),
+      direct: direct.map(({ id }) => id),
+      excluded: excluded.map(({ id }) => id),
+    });
+  }).pipe(Effect.withSpan("storage.stringSetBoundary"), Effect.orDie),
+);
