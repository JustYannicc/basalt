+/** Cleanup defects can follow a typed failure. Inspect every reason before falling back to unknown. */
+export function diagnostic(cause: Cause.Cause<unknown>, phase: Phase): FailureReceipt {
+  const causeKind =
+    cause.reasons.length > 1
+      ? "composite"
+      : cause.reasons.some(Cause.isDieReason)
+        ? "defect"
+        : cause.reasons.some(Cause.isFailReason)
+          ? "failure"
+          : "interrupted";
+  const receipts = cause.reasons.flatMap((reason) => {
+    const receipt = Cause.isFailReason(reason)
+      ? classified(reason.error, phase)
+      : Cause.isDieReason(reason)
+        ? classified(reason.defect, phase)
+        : undefined;
+    return receipt === undefined ? [] : [receipt];
+  });
+  const known =
+    receipts.find((receipt) => receipt.category === "sql" && receipt.sqlStateClass !== undefined) ??
+    receipts.find((receipt) => receipt.category !== "unknown") ??
+    receipts[0];
+  if (known !== undefined) return { ...known, causeKind: known.causeKind ?? causeKind };
   return {
     format: "basalt-production-ops-failure-v1",
-    category: phase === "sql" || phase === "forward" ? "unknown" : phase,
+    category:
+      causeKind === "interrupted"
+        ? "interrupted"
+        : cause.reasons.some(Cause.isDieReason)
+          ? "defect"
+          : phase === "sql" || phase === "forward"
+            ? "unknown"
+            : phase,
     phase,
+    causeKind,
   };
 }
 
