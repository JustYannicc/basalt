new file mode 100644
index 00000000..0a4c918b
--- /dev/null
+++ b/e2e/support/production-ops-database-fixture.ts
@@ -0,0 +1,162 @@
+import { Data, Effect, FileSystem, Schema, Scope } from "effect";
+import { ChildProcess, ChildProcessSpawner } from "effect/process";
+import { startCloudPostgres } from "./cloud-postgres.ts";
+import { freePort } from "./ports.ts";
+
+export const ProductionDatabaseState = Schema.Struct({
+  name: Schema.String,
+  oid: Schema.String,
+  role: Schema.String,
+  identity: Schema.String,
+  accounts: Schema.String,
+  receipts: Schema.Array(Schema.String),
+});
+
+class ProductionDatabaseFixtureFailed extends Data.TaggedError("ProductionDatabaseFixtureFailed") {}
+
+/** Only the managed production-ops runner owns these disposable database controls. */
+export const productionOpsDatabaseFixture = (input: {
+  readonly container: string;
+  readonly databasePassword: string;
+  readonly directory: string;
+  readonly dockerEnv: {
+    readonly PATH: string;
+    readonly DOCKER_HOST: string;
+    readonly DOCKER_CONFIG: string;
+  };
+}) =>
+  Effect.gen(function* () {
+    const processes = yield* ChildProcessSpawner.ChildProcessSpawner;
+    const scope = yield* Effect.scope;
+    const services = yield* Effect.context<
+      ChildProcessSpawner.ChildProcessSpawner | FileSystem.FileSystem
+    >();
+    const targetContainer = `${input.container}-target`;
+    const targetPort = yield* freePort;
+    let targetStarted = false;
+    let roleCreated = false;
+    const command = (args: ReadonlyArray<string>) =>
+      ChildProcess.make("docker", args, {
+        env: input.dockerEnv,
+        extendEnv: false,
+        stdout: "ignore",
+        stderr: "ignore",
+      });
+    const checked = <E, R>(work: Effect.Effect<number, E, R>) =>
+      work.pipe(
+        Effect.flatMap((code) =>
+          code === 0 ? Effect.void : Effect.fail(new ProductionDatabaseFixtureFailed()),
+        ),
+      );
+    const role = (server: boolean) =>
+      Effect.gen(function* () {
+        if (!roleCreated) {
+          yield* checked(
+            processes.exitCode(
+              command([
+                "exec",
+                input.container,
+                "sh",
+                "-c",
+                `sed -i '1i host all executor_ops_other 0.0.0.0/0 trust' "$PGDATA/pg_hba.conf" && psql -v ON_ERROR_STOP=1 -U executor -d executor -c 'create role executor_ops_other login; grant pg_read_all_data, pg_write_all_data to executor_ops_other; select pg_reload_conf()'`,
+              ]),
+            ),
+          );
+          roleCreated = true;
+        }
+        yield* checked(
+          processes.exitCode(
+            command([
+              "exec",
+              input.container,
+              "psql",
+              "-v",
+              "ON_ERROR_STOP=1",
+              "-U",
+              "executor",
+              "-d",
+              "executor",
+              "-c",
+              `${server ? "grant execute on function pg_catalog.pg_control_system() to" : "revoke execute on function pg_catalog.pg_control_system() from"} executor_ops_other`,
+            ]),
+          ),
+        );
+      });
+    const target = Effect.gen(function* () {
+      if (!targetStarted) {
+        yield* startCloudPostgres({
+          container: targetContainer,
+          databasePort: targetPort,
+          databasePassword: input.databasePassword,
+          dockerEnv: input.dockerEnv,
+          log: `${input.directory}/target-postgres.log`,
+        }).pipe(Scope.provide(scope), Effect.provideContext(services));
+        // Copy the reviewed rows, but let the other physical database own its UUID.
+        yield* checked(
+          processes.exitCode(
+            ChildProcess.make(
+              "bash",
+              [
+                "-o",
+                "pipefail",
+                "-c",
+                `docker exec ${input.container} pg_dump -U executor -d executor --no-owner --no-privileges --exclude-table-data=public.production_ops_database_identity | docker exec -i ${targetContainer} psql -v ON_ERROR_STOP=1 -U executor -d executor`,
+              ],
+              { env: input.dockerEnv, extendEnv: false, stdout: "ignore", stderr: "ignore" },
+            ),
+          ),
+        );
+        yield* checked(
+          processes.exitCode(
+            command([
+              "exec",
+              targetContainer,
+              "psql",
+              "-v",
+              "ON_ERROR_STOP=1",
+              "-U",
+              "executor",
+              "-d",
+              "executor",
+              "-c",
+              "insert into production_ops_database_identity (id) values (gen_random_uuid())",
+            ]),
+          ),
+        );
+        targetStarted = true;
+      }
+      return targetPort;
+    });
+    const state = (target: boolean) =>
+      processes
+        .string(
+          ChildProcess.make(
+            "docker",
+            [
+              "exec",
+              target ? targetContainer : input.container,
+              "psql",
+              "-t",
+              "-A",
+              "-U",
+              "executor",
+              "-d",
+              "executor",
+              "-c",
+              `select json_build_object('name', current_database(), 'oid', d.oid::text,
+      'role', (select oid::text from pg_roles where rolname = session_user),
+      'identity', (select id::text from production_ops_database_identity),
+      'accounts', (select md5(coalesce(string_agg(to_jsonb(a)::text, '' order by id), '')) from executor_accounts a),
+      'receipts', coalesce((select json_agg(plan_sha256 order by plan_sha256) from private_production_ops_receipts), '[]'::json))
+      from pg_database d where datname = current_database()`,
+            ],
+            { env: input.dockerEnv, extendEnv: false, stderr: "ignore" },
+          ),
+        )
+        .pipe(
+          Effect.flatMap(
+            Schema.decodeUnknownEffect(Schema.fromJsonString(ProductionDatabaseState)),
+          ),
+        );
+    return { role, target, state };
+  });
