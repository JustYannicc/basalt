+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Api, body } from "../support/api.ts";
+import { Actors } from "../support/actors.ts";
+import { Target } from "../support/platform.ts";
+import { fixtureRequest } from "../sdk/fixtures.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Inventory, Response } from "../support/production-ops-client.ts";
+import { productionMigrationProof } from "../support/production-ops-migration-proof.ts";
+import { ProductionDatabaseState } from "../support/production-ops-database-fixture.ts";
+import { scenarios } from "../test-plan.ts";
+
+const setup = Effect.gen(function* () {
+  const p = yield* productionMigrationProof;
+  const target = yield* Target;
+  if (target.fixtures === undefined) return yield* Effect.die("Cloud fixture required");
+  const fixtures = target.fixtures;
+  const change = (binding: string) =>
+    fixtureRequest(fixtures, "/runtime/database-binding", { binding }, "5 minutes");
+  yield* Effect.addFinalizer(() => change("original").pipe(Effect.orDie));
+  const observed = () =>
+    Effect.gen(function* () {
+      const response = yield* p.request(p.read("organizations"));
+      expect(response.status).toBe(200);
+      return yield* Schema.decodeUnknownEffect(Inventory)(
+        p.decrypt((yield* body(Response, response)).artifact),
+      );
+    });
+  const noReceipt = (hash: string) =>
+    p.database.run({
+      sql: "select plan_sha256 from private_production_ops_receipts where plan_sha256 = $1",
+      params: [hash],
+    });
+  return { ...p, change, observed, noReceipt };
+});
+
+layer(HostedLive, { excludeTestServices: true })("Production database identity", (it) => {
+  it.effect(scenarios.cloudProductionOpsRoleIdentity.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const p = yield* setup;
+        const valid = p.operation("increment");
+        const before = yield* p.account();
+        const dry = yield* p.dryRun(valid);
+        const original = yield* p.observed();
+        yield* p.change("role");
+        const changed = yield* p.observed();
+        expect(changed.database.name).toBe(original.database.name);
+        expect(changed.database.targetSha256).not.toBe(original.database.targetSha256);
+        expect((yield* p.request(p.apply(valid, dry))).status).toBe(409);
+        expect(yield* p.account()).toEqual(before);
+        expect(yield* p.noReceipt(dry.artifact.sha256)).toEqual([]);
+      }),
+    ),
+  );
+
+  it.effect(scenarios.cloudProductionOpsPhysicalDatabase.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const p = yield* setup;
+        const valid = p.operation("increment");
+        const before = yield* p.account();
+        const dry = yield* p.dryRun(valid);
+        const original = yield* p.observed();
+        const states = yield* p.change("target").pipe(
+          Effect.flatMap(
+            Schema.decodeUnknownEffect(
+              Schema.Struct({
+                original: ProductionDatabaseState,
+                target: ProductionDatabaseState,
+              }),
+            ),
+          ),
+        );
+        expect(states.target.name).toBe(states.original.name);
+        expect(states.target.oid).toBe(states.original.oid);
+        expect(states.target.role).toBe(states.original.role);
+        expect(states.target.accounts).toBe(states.original.accounts);
+        expect(states.target.receipts).toEqual(states.original.receipts);
+        expect(states.target.identity).not.toBe(states.original.identity);
+        const changed = yield* p.observed();
+        expect(changed.database.name).toBe(original.database.name);
+        expect(changed.database.targetSha256).not.toBe(original.database.targetSha256);
+        const api = yield* Api;
+        const actors = yield* Actors;
+        const [unrelated] = yield* p.database
+          .run({
+            sql: "select id from executor_accounts where provider = (select provider from executor_accounts where id = $1) and method = 'apiKey'",
+            params: [p.own.account],
