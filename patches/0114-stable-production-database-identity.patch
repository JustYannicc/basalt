@@ -0,0 +1,85 @@
+/** Database identity excludes login secrets and invocation-local Hyperdrive routing. */
+import { Data, Effect, Redacted, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import { canonical, sha256 } from "./crypto.ts";
+
+export interface DatabaseOrigin {
+  readonly host: string;
+  readonly port: number;
+  readonly database: string;
+}
+
+class DatabaseIdentityUnavailable extends Data.TaggedError("DatabaseIdentityUnavailable") {}
+
+/** Only these allowlisted fields can enter a target hash; URL credentials and options never do. */
+export const databaseOrigin = (connectionString: Redacted.Redacted<string>) =>
+  Effect.try({
+    try: (): DatabaseOrigin => {
+      const url = new URL(Redacted.value(connectionString));
+      const database = decodeURIComponent(url.pathname.slice(1));
+      if (
+        !["postgres:", "postgresql:"].includes(url.protocol) ||
+        !url.hostname ||
+        !database ||
+        database.includes("\0")
+      )
+        throw new DatabaseIdentityUnavailable();
+      return {
+        host: url.hostname.toLowerCase().replace(/\.$/, ""),
+        port: url.port === "" ? 5432 : Number(url.port),
+        database,
+      };
+    },
+    catch: () => new DatabaseIdentityUnavailable(),
+  });
+
+const ObservedDatabase = Schema.Struct({
+  name: Schema.NonEmptyString,
+  oid: Schema.NonEmptyString,
+  role: Schema.NonEmptyString,
+  identity: Schema.String.check(Schema.isUUID()),
+});
+
+/** Run inside the operation's transaction, including apply's write transaction. */
+export const databaseIdentity = (origin: DatabaseOrigin) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const rows = yield* sql`
+      select current_database() as name, d.oid::text as oid, r.oid::text as role, i.id::text as identity
+      from pg_catalog.pg_database d
+      cross join pg_catalog.pg_roles r
+      cross join production_ops_database_identity i
+      where d.datname = current_database() and r.rolname = session_user
+    `.pipe(Effect.flatMap(Schema.decodeUnknownEffect(Schema.Array(ObservedDatabase))));
+    const observed = rows[0];
+    if (observed === undefined || rows.length !== 1)
+      return yield* new DatabaseIdentityUnavailable();
+    // Every database owns a persistent UUID because providers may withhold pg_control_system.
+    // Bind the login's catalog OID too; the optional server ID is never the sole target identity.
+    const server = yield* sql
+      .withTransaction(
+        sql`
+      select (pg_catalog.pg_control_system()).system_identifier::text as server
+    `.pipe(
+          Effect.flatMap(
+            Schema.decodeUnknownEffect(
+              Schema.Array(Schema.Struct({ server: Schema.NonEmptyString })),
+            ),
+          ),
+          Effect.map((rows) => rows[0]?.server ?? null),
+        ),
+      )
+      .pipe(Effect.orElseSucceed(() => null));
+    // This identifies dataset lineage: a byte-restored clone can retain the UUID and catalog OIDs.
+    // Rotate the identity row after any restore, before running production-ops plans.
+    return {
+      name: observed.name,
+      targetSha256: sha256(
+        canonical({
+          context: "basalt-production-database-v3",
+          origin,
+          observed: { ...observed, ...(server === null ? {} : { server }) },
+        }),
+      ),
+    };
+  });
