diff --git a/e2e/support/production-ops-credentials-proof.ts b/e2e/support/production-ops-credentials-proof.ts
new file mode 100644
index 00000000..e2118571
--- /dev/null
+++ b/e2e/support/production-ops-credentials-proof.ts
@@ -0,0 +1,92 @@
+/** One credential restart fits one case; the stable-key case restores before its own proof. */
+import { expect } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { createHash } from "node:crypto";
+import { body } from "./api.ts";
+import { Target } from "./platform.ts";
+import { fixtureRequest } from "../sdk/fixtures.ts";
+import { Inventory, Response } from "./production-ops-client.ts";
+import { Applied, productionMigrationProof } from "./production-ops-migration-proof.ts";
+
+export const productionOpsCredentialsProof = Effect.gen(function* () {
+  const p = yield* productionMigrationProof;
+  const valid = p.operation("increment");
+  const before = yield* p.account();
+  const dry = yield* p.dryRun(valid);
+  expect(yield* p.account()).toEqual(before);
+  const target = yield* Target;
+  if (target.fixtures === undefined) return yield* Effect.die("Cloud fixture required");
+  const fixtures = target.fixtures;
+  const changeBinding = (binding: "original" | "alternate" | "credentials" | "host" | "database") =>
+    fixtureRequest(fixtures, "/runtime/database-binding", { binding }, "5 minutes");
+  const observed = () =>
+    Effect.gen(function* () {
+      const response = yield* p.request(p.read("organizations"));
+      expect(response.status).toBe(200);
+      return yield* Schema.decodeUnknownEffect(Inventory)(
+        p.decrypt((yield* body(Response, response)).artifact),
+      );
+    });
+  const original = yield* observed();
+  const configured = yield* Schema.decodeUnknownEffect(
+    Schema.Struct({
+      origin: Schema.Struct({
+        host: Schema.String,
+        port: Schema.Number,
+        database: Schema.String,
+      }),
+    }),
+  )(yield* changeBinding("original"));
+  const observedDatabase = yield* Schema.decodeUnknownEffect(
+    Schema.Array(
+      Schema.Struct({
+        name: Schema.String,
+        oid: Schema.String,
+        role: Schema.String,
+        identity: Schema.String,
+        server: Schema.NullOr(Schema.String),
+      }),
+    ),
+  )(
+    yield* p.database.run({
+      sql: "select current_database() as name, d.oid::text as oid, r.oid::text as role, i.id::text as identity, (pg_control_system()).system_identifier::text as server from pg_database d cross join pg_roles r cross join production_ops_database_identity i where d.datname = current_database() and r.rolname = session_user",
+    }),
+  );
+  const independentHashInput = {
+    context: "basalt-production-database-v3",
+    origin: configured.origin,
+    observed: observedDatabase[0],
+  };
+  const expectedTarget = createHash("sha256")
+    .update(
+      JSON.stringify(independentHashInput, (_key, value: unknown) =>
+        value !== null && typeof value === "object" && !Array.isArray(value)
+          ? Object.fromEntries(Object.entries(value).sort(([a], [b]) => a.localeCompare(b, "en")))
+          : value,
+      ),
+    )
+    .digest("hex");
+  expect(original.database.targetSha256).toBe(expectedTarget);
+  yield* changeBinding("credentials");
+  const rotated = yield* observed();
+  expect(rotated.database).toEqual(original.database);
+  const applied = yield* p.request(p.apply(valid, dry));
+  expect(applied.status).toBe(200);
+  expect((yield* body(Applied, applied)).repeated).toBe(false);
+  const after = yield* p.account();
+  expect(after).not.toEqual(before);
+  const replay = yield* p.request(p.apply(valid, dry));
+  expect(replay.status).toBe(200);
+  expect((yield* body(Applied, replay)).repeated).toBe(true);
+  expect(yield* p.account()).toEqual(after);
+  const receipts = yield* p.database.run({
+    sql: "select to_jsonb(r) as row from private_production_ops_receipts r where plan_sha256 = $1",
+    params: [dry.artifact.sha256],
+  });
+  const receiptText = JSON.stringify(receipts);
+  expect(receiptText).not.toContain("hyperdrive-invocation-password-two");
+  expect(receiptText).not.toContain("synthetic-per-request-query-secret");
+  expect(receiptText).not.toContain("targetSha256");
+  expect(receiptText).not.toContain("postgresql://");
+  expect(receiptText).not.toContain("postgres://");
+});
