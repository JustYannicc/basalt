+        const audienceSet = yield* api.request(actor, "PATCH", path, {
+          revision: access.revision,
+          audience: { kind: audience },
+        });
+        expect(audienceSet.status, JSON.stringify(audienceSet.body)).toBe(200);
+        return app;
+      });
+    const connect = (actor: Session, app: string, label: string, token: string) =>
+      Effect.gen(function* () {
+        const started = yield* api.request(
+          actor,
