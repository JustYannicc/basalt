diff --git a/apps/hosted/server/src/implementation/default-managed-access.ts b/apps/hosted/server/src/implementation/default-managed-access.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/server/src/implementation/default-managed-access.ts
@@ -0,0 +1,26 @@
+import { Effect } from "effect";
+import { SqlClient } from "effect/sql";
+
+/** Revisit every retained default-key holder once, including members demoted since setup. */
+export const queueDefaultManagedAccess = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  const name = "basalt-default-managed-access";
+  yield* sql.withTransaction(
+    Effect.gen(function* () {
+      yield* sql`insert into private_hosted_data_steps (name, run, mode) values (${name}, 'apply', 'apply') on conflict do nothing`;
+      const [step] = yield* sql<{
+        completed: boolean;
+      }>`select completed_at is not null as completed from private_hosted_data_steps where name = ${name} and run = 'apply' for update`;
+      if (step?.completed) return;
+      yield* sql`insert into hosted_provisioning (kind, organization_id, user_id, available_at)
+      select 'member', team.id, holder.key, now() + interval '15 minutes'
+      from organization team
+      cross join lateral jsonb_each_text(coalesce(team.metadata::jsonb -> 'executorKeyAccounts', '{}'::jsonb)) holder
+      join member on member."organizationId" = team.id and member."userId" = holder.key
+      join "user" on "user".id = member."userId" and "user"."emailVerified" = true
+      join executor_accounts account on account.id = holder.value and account.owner = 'organization:' || team.id
+      where team.metadata::jsonb -> 'executorDefaults' ->> 'deployment' is not null`;
+      yield* sql`update private_hosted_data_steps set completed_at = now() where name = ${name} and run = 'apply'`;
+    }),
+  );
+});
