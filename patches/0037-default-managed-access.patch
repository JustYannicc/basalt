+/** Revoke only the replaced host key, after its saved account has no remaining app links. */
+export const revokeManagedAccountKey = (
+  organization: OrganizationId,
+  user: string,
+  token: Redacted.Redacted<string>,
+) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const hash = yield* Effect.tryPromise({
+      try: () => defaultKeyHasher(Redacted.value(token)),
+      catch: () => new StorageError(),
+    });
+    yield* sql`update apikey set enabled = false, "updatedAt" = now()
+      where key = ${hash} and "referenceId" = ${user}
+        and metadata::jsonb ->> 'organization' = ${organization}`;
+  }).pipe(Effect.mapError(() => new StorageError()));
