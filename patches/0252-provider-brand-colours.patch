diff --git a/packages/ui/src/implementation/lib/provider-brand.ts b/packages/ui/src/implementation/lib/provider-brand.ts
index ce7b13a..38d5311 100644
--- a/packages/ui/src/implementation/lib/provider-brand.ts
+++ b/packages/ui/src/implementation/lib/provider-brand.ts
@@ -53,3 +53,56 @@ const brands: ReadonlyMap<string, ProviderBrand> = new Map([
 /** The brand of a provider or app by its display name, or undefined for every other name. */
 export const providerBrand = (name: string): ProviderBrand | undefined =>
   brands.get(name.toLowerCase().trim());
+
+/**
+ * The labs whose identity colour also fills healthy usage bars and pool chart series. The colour
+ * lives once in `dashboard.css` (`--brand-<lab>`), which provider icon tiles use too.
+ */
+export type BrandLab = "openai" | "anthropic" | "kimi" | "google";
+
+const labOf: Readonly<Record<string, BrandLab>> = {
+  openai: "openai",
+  anthropic: "anthropic",
+  kimi: "kimi",
+  gemini: "google",
+  vertex: "google",
+  antigravity: "google",
+};
+
+/** A model's maker from its name's family prefix, such as `claude-…` or `gpt-…`; never a guess. */
+const modelFamilies: readonly (readonly [RegExp, BrandLab])[] = [
+  [/^claude(?:[-._\s]|$)/, "anthropic"],
+  [/^(?:gpt|chatgpt|codex)(?:[-._\s\d]|$)/, "openai"],
+  [/^o\d+(?:[-._\s]|$)/, "openai"],
+  [/^(?:kimi|moonshot)(?:[-._\s]|$)/, "kimi"],
+  [/^gemini(?:[-._\s]|$)/, "google"],
+];
+
+/**
+ * The lab behind a usage reading: the model's family first, since one provider can serve another
+ * lab's models, then the first provider name that is exactly one of the lab's known names. A
+ * gateway or unknown name has no lab.
+ */
+export const brandLab = (input: {
+  readonly model?: string | undefined;
+  readonly providers?: readonly (string | null | undefined)[];
+}): BrandLab | undefined => {
+  const model = input.model?.trim().toLowerCase();
+  const family = model ? modelFamilies.find(([pattern]) => pattern.test(model)) : undefined;
+  if (family !== undefined) return family[1];
+  for (const name of input.providers ?? []) {
+    const key = name === null || name === undefined ? undefined : providerBrand(name)?.key;
+    const lab = key === undefined ? undefined : labOf[key];
+    if (lab !== undefined) return lab;
+  }
+  return undefined;
+};
+
+/** How many tints of one lab `dashboard.css` defines for series that need telling apart. */
+export const brandShadeCount = 3;
+
+/** The class that fills a bar or swatch with the lab's colour, or one of its tints. */
+export const brandFill = (lab: BrandLab | undefined, shade = 0) =>
+  lab === undefined
+    ? undefined
+    : `brand-fill brand-${lab}${shade > 0 ? ` brand-shade-${Math.min(shade, brandShadeCount - 1)}` : ""}`;
