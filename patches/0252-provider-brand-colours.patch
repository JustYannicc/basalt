diff --git a/packages/ui/src/contracts/provider-brand.ts b/packages/ui/src/contracts/provider-brand.ts
new file mode 100644
index 0000000..d59ace8
--- /dev/null
+++ b/packages/ui/src/contracts/provider-brand.ts
@@ -0,0 +1,51 @@
+/**
+ * The one mapping from a provider or model to its lab's brand colours, shared by account usage
+ * bars and the pool's usage chart so a lab reads the same everywhere: OpenAI green, Anthropic
+ * orange, Kimi blue, Google blue. Colours are extra cues; every place keeps its text label.
+ */
+export type BrandLab = "openai" | "anthropic" | "kimi" | "google";
+
+const labs: readonly (readonly [BrandLab, RegExp])[] = [
+  ["anthropic", /anthropic|claude/],
+  ["openai", /openai|chatgpt|codex|^gpt|^o\d/],
+  ["kimi", /kimi|moonshot/],
+  ["google", /google|gemini|vertex|antigravity/],
+];
+
+/**
+ * The lab behind the first name that names one, such as a model name, a provider id or a provider's
+ * display name. Read the most specific name first: one provider can serve another lab's models.
+ */
+export const brandLab = (
+  ...names: readonly (string | null | undefined)[]
+): BrandLab | undefined => {
+  for (const name of names) {
+    const value = name?.trim().toLowerCase();
+    if (!value) continue;
+    const found = labs.find(([, pattern]) => pattern.test(value));
+    if (found !== undefined) return found[0];
+  }
+  return undefined;
+};
+
+// Tailwind only sees complete class names, so every shade is written out. The first shade is the
+// lab's own colour; light and dark pairs keep the same order.
+export const brandShades: Readonly<Record<BrandLab, readonly string[]>> = {
+  openai: [
+    "bg-[#10a37f] dark:bg-[#19c37d]",
+    "bg-[#0d8a6a] dark:bg-[#5fd4a6]",
+    "bg-[#5fbf9f] dark:bg-[#0f9e73]",
+  ],
+  anthropic: [
+    "bg-[#d97757] dark:bg-[#d97757]",
+    "bg-[#b95533] dark:bg-[#f1b198]",
+    "bg-[#9f705c] dark:bg-[#a36e58]",
+    "bg-[#e8a487] dark:bg-[#c25f3c]",
+  ],
+  kimi: ["bg-[#1783ff] dark:bg-[#5aa7ff]", "bg-[#0f5fc2] dark:bg-[#93c5ff]"],
+  google: ["bg-[#1a73e8] dark:bg-[#8ab4f8]", "bg-[#5e97f6] dark:bg-[#aecbfa]"],
+};
+
+/** The lab's own colour for a bar or swatch, or undefined for a lab without one. */
+export const brandFill = (lab: BrandLab | undefined) =>
+  lab === undefined ? undefined : brandShades[lab][0];
