+            set: { lease: token, leaseUntil },
+          }),
+        );
+        const claimed = (yield* query(() =>
+          input.db.findMany("accountReports", {
+            where: (b) =>
+              b.and(
+                b("clientFingerprint", "=", clientFingerprint),
+                b("externalIdFingerprint", "=", fingerprint),
+                b("status", "=", "active"),
