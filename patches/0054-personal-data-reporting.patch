+import { McpClient } from "./mcp-client.ts";
+import { mcpAppFiles } from "./mcp-app-fixture.ts";
+
+const Key = Schema.Struct({ id: Schema.String, key: Schema.RedactedFromValue(Schema.String) });
+const Captured = Schema.Struct({
+  views: Schema.Array(Schema.Struct({ id: Schema.String })),
+});
+const Shown = Schema.Struct({
+  "executor/app-view": Schema.Struct({
+    input: Schema.Struct({ text: Schema.String }),
+    result: Schema.Struct({
+      structuredContent: Schema.Struct({ source: Schema.String, text: Schema.String }),
+    }),
+  }),
+});
+
+export const reportingUpgradeFixture = Effect.gen(function* () {
+  const observation = yield* observationFixture();
+  expect((yield* observation.refresh()).status).toBe(200);
+  const before = yield* observation
+    .read()
+    .pipe(Effect.flatMap((response) => body(ObservationView, response)));
+  expect(before.reports).toHaveLength(1);
+  const saved = before.reports[0]?.result;
+  expect(saved).not.toBeNull();
+  const { api, actors, prefix } = observation;
+  const key = yield* api
+    .request(actors.owner, "POST", "/api/auth/api-key/create", {
+      name: "Reporting upgrade MCP retention",
+    })
+    .pipe(Effect.flatMap((response) => body(Key, response)));
+  yield* Effect.addFinalizer(() =>
+    api
+      .request(actors.owner, "POST", "/api/auth/api-key/delete", {
+        keyId: key.id,
+      })
+      .pipe(Effect.orDie),
+  );
+  const app = yield* api
+    .request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+      name: "Reporting upgrade retained MCP view",
+      files: mcpAppFiles,
+    })
+    .pipe(Effect.flatMap((response) => body(App, response)));
+  const mcp = yield* McpClient;
+  const connect = () =>
+    mcp.connect(key.key, "reporting-upgrade-retention", {
+      organization: actors.organization.id,
+      mode: "native",
+      ui: true,
+    });
+  const client = yield* connect();
+  const execution = yield* client.use("Capture the pre-upgrade MCP view", (client, signal) =>
+    client.callTool(
+      {
+        name: "execute",
+        arguments: {
+          code: `return await tools[${JSON.stringify(app.slug)}].alpha.open({ text: "Retained across 4.0.18 to 4.0.19" });`,
+        },
+      },
+      undefined,
+      { signal },
+    ),
+  );
+  const captured = yield* Schema.decodeUnknownEffect(Captured)(execution.structuredContent);
+  const view = captured.views[0];
+  if (view === undefined) return yield* Effect.die("The public MCP call did not retain its view");
+  return {
+    verify: Effect.gen(function* () {
+      const after = yield* observation
+        .read()
+        .pipe(Effect.flatMap((response) => body(ObservationView, response)));
+      expect(after.reports).toHaveLength(1);
+      expect(after.reports[0]?.result).toEqual(saved);
+      const restarted = yield* connect();
+      const shown = yield* restarted.use(
+        "Read the same MCP view after storage upgrade",
+        (client, signal) =>
+          client.callTool({ name: "show-app", arguments: { view: view.id } }, undefined, {
+            signal,
+          }),
+      );
+      expect(shown.isError, JSON.stringify(shown.content)).not.toBe(true);
+      const payload = (yield* Schema.decodeUnknownEffect(Shown)(shown._meta))["executor/app-view"];
+      expect(payload.input).toEqual({ text: "Retained across 4.0.18 to 4.0.19" });
+      expect(payload.result.structuredContent).toEqual({
+        source: "Alpha",
+        text: "Retained across 4.0.18 to 4.0.19",
+      });
+    }),
+  };
+});
