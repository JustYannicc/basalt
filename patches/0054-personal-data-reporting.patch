--- /dev/null
+++ b/packages/sdk/src/implementation/personal-data-reporting-close.ts
@@ -0,0 +1,144 @@
+/** Erase a closed registration's subject copies in one transaction, then revoke their grants. */
+import { Effect, Option, Schema } from "effect";
+import { OwnerId, StorageError, type AccountId } from "../contracts/shared.ts";
+import { StoredAccount, StoredConnectionState } from "../contracts/storage.ts";
+import type { makeOAuth } from "./oauth.ts";
+import { query, transaction, type Query } from "./database.ts";
+import type { ReportRow } from "./personal-data-reporting-state.ts";
+
+const closedMessage =
+  "The service closed this account. Stored credentials and identity were removed.";
+
+export const makeCloseReportedSubject = (input: {
+  readonly db: Query;
+  readonly oauth: Pick<ReturnType<typeof makeOAuth>, "revokeRemoved">;
+}) => {
+  const closeSubject = (clientFingerprint: string, fingerprint: string, lease: string, now: Date) =>
+    Effect.gen(function* () {
+      const rows = (yield* query(() =>
+        input.db.findMany("accountReports", {
+          where: (b) =>
+            b.and(
+              b("clientFingerprint", "=", clientFingerprint),
+              b("externalIdFingerprint", "=", fingerprint),
+              b("lease", "=", lease),
+            ),
+        }),
+      )) as ReportRow[];
+      const removed: { account: AccountId; provider: string; encrypted: Uint8Array }[] = [];
+      yield* transaction(input.db, (tx) =>
+        Effect.gen(function* () {
+          for (const row of rows) {
+            const accountRow = yield* query(() =>
+              tx.findFirst("accounts", {
+                where: (b) => b.and(b("id", "=", row.id), b("owner", "=", OwnerId.make(row.owner))),
+              }),
+            );
+            if (accountRow === null) continue;
+            const account = yield* Schema.decodeUnknownEffect(StoredAccount)(accountRow).pipe(
+              Effect.mapError(() => new StorageError()),
+            );
+            const grant = yield* query(() =>
+              tx.findFirst("oauthGrants", { where: (b) => b("id", "=", account.id) }),
+            );
+            const generation = account.credentialGeneration + 1;
+            const connections = yield* query(() =>
+              tx.findMany("accountConnections", {
+                select: ["id", "state"],
+                where: (b) => b("reconnectAccount", "=", account.id),
+              }),
+            );
+            const pendingConnections = connections.flatMap((connection) => {
+              const state = Schema.decodeUnknownOption(StoredConnectionState)(connection.state);
+              return Option.isSome(state) && state.value.status === "pending"
+                ? [connection.id]
+                : [];
+            });
+            if (pendingConnections.length > 0)
+              yield* query(() =>
+                tx.updateMany("accountConnections", {
+                  where: (b) => b("id", "in", pendingConnections),
+                  set: { state: { status: "cancelled" }, oauthAttempt: null },
+                }),
+              );
+            yield* query(() =>
+              tx.updateMany("accounts", {
+                where: (b) => b("id", "=", account.id),
+                set: {
+                  label: "Closed account",
+                  description: null,
+                  encryptedCredentials: new Uint8Array(),
+                  credentialGeneration: generation,
+                },
+              }),
+            );
+            yield* query(() =>
+              tx.deleteMany("oauthGrants", { where: (b) => b("id", "=", account.id) }),
+            );
+            yield* query(() =>
+              tx.updateMany("accountChecks", {
+                where: (b) => b("account", "=", account.id),
+                set: {
+                  credentialGeneration: generation,
+                  status: "credentials_rejected",
+                  checkedAt: now,
+                  info: null,
+                  infoCheckedAt: null,
+                  message: closedMessage,
+                },
+              }),
+            );
+            yield* query(() =>
+              tx.updateMany("accountReports", {
+                where: (b) =>
+                  b.and(b("id", "=", account.id), b("clientFingerprint", "=", clientFingerprint)),
+                set: {
+                  credentialGeneration: generation,
+                  status: "closed",
+                  encryptedExternalId: null,
+                  externalIdFingerprint: null,
+                  retrievedAt: null,
+                  reportedAt: now,
+                  nextReportAt: null,
+                  retryAt: null,
+                  retries: 0,
+                  lease: null,
+                  leaseUntil: null,
+                },
+              }),
+            );
+            if (grant !== null)
+              removed.push({
+                account: account.id,
+                provider: account.provider,
+                encrypted: grant.encrypted,
+              });
+          }
+          yield* query(() =>
+            tx.updateMany("accountReports", {
+              where: (b) =>
+                b.and(
+                  b("clientFingerprint", "=", clientFingerprint),
+                  b("externalIdFingerprint", "=", fingerprint),
+                ),
+              set: {
+                status: "closed",
+                encryptedExternalId: null,
+                externalIdFingerprint: null,
+                retrievedAt: null,
+                reportedAt: now,
+                nextReportAt: null,
+                retryAt: null,
+                retries: 0,
+                lease: null,
+                leaseUntil: null,
+              },
+            }),
+          );
+        }),
+      );
+      yield* Effect.forEach(removed, input.oauth.revokeRemoved, { concurrency: 1, discard: true });
+    });
+
+  return closeSubject;
+};
diff --git a/packages/sdk/src/implementation/personal-data-reporting-http.ts b/packages/sdk/src/implementation/personal-data-reporting-http.ts
new file mode 100644
--- /dev/null
+++ b/packages/sdk/src/implementation/personal-data-reporting-http.ts
@@ -0,0 +1,205 @@
+/** Bounded HTTP operations for the host-owned account reporting protocol. */
+import { Effect, Option, Result, Schema, Stream } from "effect";
+import { FetchHttpClient, HttpClient, HttpClientRequest, HttpClientResponse } from "effect/http";
+import * as Headers from "effect/http/Headers";
+import { parseDestination, type UrlPolicy } from "@executor-js/utils/url-policy";
+import type { PersonalDataReporting } from "../contracts/oauth.ts";
+
+const maxBodyBytes = 64 * 1024;
+const accountIdPattern = /^[A-Za-z0-9:-]{1,128}$/u;
+
+export interface ReportAccount {
+  readonly accountId: string;
+  readonly updatedAt: Date;
+}
+
+export type AccountAction = { readonly accountId: string; readonly status: "closed" | "updated" };
+
+export type HttpFailure = {
+  readonly kind: "failed";
+  readonly status: number | null;
+  readonly retryAfterSeconds: number | undefined;
+};
+
+export type IdentityResult = { readonly kind: "ok"; readonly accountId: string } | HttpFailure;
+
+export type ReportResult =
+  | { readonly kind: "no_action"; readonly cycleDays: number }
+  | {
+      readonly kind: "actions";
+      readonly cycleDays: number;
+      readonly actions: readonly AccountAction[];
+    }
+  | HttpFailure;
+
+const responseText = (response: HttpClientResponse.HttpClientResponse) =>
+  Effect.gen(function* () {
+    let size = 0;
+    const chunks: Uint8Array[] = [];
+    let overflow = false;
+    const read = yield* response.stream.pipe(
+      Stream.takeWhile((chunk) => {
+        size += chunk.byteLength;
+        if (size > maxBodyBytes) {
+          overflow = true;
+          return false;
+        }
+        chunks.push(chunk);
+        return true;
+      }),
+      Stream.runDrain,
+      Effect.result,
+    );
+    if (Result.isFailure(read)) return undefined;
+    if (overflow) return undefined;
+    const bytes = new Uint8Array(size);
+    let offset = 0;
+    for (const chunk of chunks) {
+      bytes.set(chunk, offset);
+      offset += chunk.byteLength;
+    }
+    return new TextDecoder().decode(bytes);
+  });
+
+const header = (headers: Headers.Headers, name: string) =>
+  Option.getOrUndefined(Headers.get(headers, name));
+
+const retryAfter = (headers: Headers.Headers) => {
+  const value = header(headers, "retry-after");
+  if (value === undefined || !/^\d+(?:\.\d+)?$/u.test(value)) return undefined;
+  const seconds = Number(value);
+  return Number.isFinite(seconds) && seconds >= 0 ? seconds : undefined;
+};
+
+const failed = (status: number | null, headers?: Headers.Headers): HttpFailure => ({
+  kind: "failed",
+  status,
+  retryAfterSeconds: headers === undefined ? undefined : retryAfter(headers),
+});
+
+const Identity = Schema.fromJsonString(Schema.Record(Schema.String, Schema.Unknown));
+const Action = Schema.Struct({
+  accountId: Schema.String.check(Schema.isPattern(accountIdPattern)),
+  status: Schema.Literals(["closed", "updated"]),
+});
+const ReportResponse = Schema.fromJsonString(
+  Schema.Struct({
+    accounts: Schema.Array(Action).check(Schema.isMaxLength(90)),
+  }),
+);
+
+const identityId = (text: string | undefined, field: string) =>
+  Effect.gen(function* () {
+    if (text === undefined) return undefined;
+    const decoded = yield* Schema.decodeUnknownEffect(Identity)(text).pipe(Effect.option);
+    if (Option.isNone(decoded)) return undefined;
+    const id = decoded.value[field];
+    return typeof id === "string" && id !== "unknown" && accountIdPattern.test(id) ? id : undefined;
+  });
+
+const cycleDays = (headers: Headers.Headers): number | undefined => {
+  const value = header(headers, "cycle-period");
+  if (value === undefined) return 7;
+  const days = Number(value);
+  return Number.isFinite(days) && days > 0 && days <= 100_000_000 ? days : undefined;
+};
+
+const actions = (text: string | undefined, requested: ReadonlySet<string>) =>
+  Effect.gen(function* () {
+    if (text === undefined) return undefined;
+    const decoded = yield* Schema.decodeUnknownEffect(ReportResponse)(text, {
+      onExcessProperty: "error",
+    }).pipe(Effect.option);
+    if (Option.isNone(decoded)) return undefined;
+    const seen = new Set<string>();
+    for (const action of decoded.value.accounts) {
+      if (!requested.has(action.accountId) || seen.has(action.accountId)) return undefined;
+      seen.add(action.accountId);
+    }
+    return decoded.value.accounts;
+  });
+
+const send = (
+  client: HttpClient.HttpClient,
+  policy: UrlPolicy,
+  url: string,
+  token: string,
+  body?: unknown,
+) =>
+  Effect.gen(function* () {
+    const destination = parseDestination(url, policy);
+    if (destination === undefined) return undefined;
+    const request =
+      body === undefined
+        ? HttpClientRequest.get(destination.href).pipe(
+            HttpClientRequest.setHeader("authorization", `Bearer ${token}`),
+            HttpClientRequest.setHeader("accept", "application/json"),
+          )
+        : HttpClientRequest.post(destination.href).pipe(
+            HttpClientRequest.setHeader("authorization", `Bearer ${token}`),
+            HttpClientRequest.setHeader("accept", "application/json"),
+            HttpClientRequest.bodyText(JSON.stringify(body), "application/json"),
+          );
+    const result = yield* HttpClient.withScope(client)
+      .execute(request)
+      .pipe(
+        Effect.provideService(FetchHttpClient.RequestInit, { redirect: "manual" }),
+        Effect.result,
+      );
+    if (Result.isFailure(result)) return undefined;
+    return result.success;
+  });
+
+export const fetchIdentity = (
+  client: HttpClient.HttpClient,
+  policy: UrlPolicy,
+  config: PersonalDataReporting,
+  token: string,
+): Effect.Effect<IdentityResult> =>
+  Effect.scoped(
+    Effect.gen(function* () {
+      const response = yield* send(client, policy, config.identityUrl, token);
+      if (response === undefined) return failed(null);
+      if (response.status !== 200) return failed(response.status, response.headers);
+      const id = yield* identityId(yield* responseText(response), config.accountIdField);
+      return id === undefined
+        ? failed(response.status, response.headers)
+        : { kind: "ok", accountId: id };
+    }),
+  );
+
+export const reportAccounts = (
+  client: HttpClient.HttpClient,
+  policy: UrlPolicy,
+  config: PersonalDataReporting,
+  token: string,
+  accounts: readonly ReportAccount[],
+): Effect.Effect<ReportResult> =>
+  Effect.scoped(
+    Effect.gen(function* () {
+      if (accounts.length === 0 || accounts.length > 90) return failed(null);
+      const requested = new Set(accounts.map((account) => account.accountId));
+      if (
+        requested.size !== accounts.length ||
+        accounts.some(
+          (account) => !accountIdPattern.test(account.accountId) || account.accountId === "unknown",
+        )
+      )
+        return failed(null);
+      const response = yield* send(client, policy, config.reportUrl, token, {
+        accounts: accounts.map((account) => ({
+          accountId: account.accountId,
+          updatedAt: account.updatedAt.toISOString(),
+        })),
+      });
+      if (response === undefined) return failed(null);
+      const cycle = cycleDays(response.headers);
+      if (response.status === 204 && cycle !== undefined)
+        return { kind: "no_action", cycleDays: cycle };
+      if (response.status === 200 && cycle !== undefined) {
+        const parsed = yield* actions(yield* responseText(response), requested);
+        if (parsed !== undefined) return { kind: "actions", cycleDays: cycle, actions: parsed };
+      }
+      return failed(response.status, response.headers);
+    }),
+  );
