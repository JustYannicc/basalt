+    clientFingerprint: string,
+    fingerprints: readonly string[],
+    lease: string,
+    cycleDays: number,
+    now: Date,
+  ) =>
+    Effect.forEach(
+      fingerprints,
+      (fingerprint) =>
+        updateBySubject(
+          clientFingerprint,
+          [fingerprint],
+          {
+            status: "active",
+            reportedAt: now,
+            cycleDays,
+            nextReportAt: delayForCycle(cycleDays, fingerprint, now),
+            retryAt: null,
+            retries: 0,
+            lease: null,
+            leaseUntil: null,
+          },
+          lease,
+        ),
+      { concurrency: 1, discard: true },
+    ).pipe(Effect.asVoid);
+
+  return {
+    updateBySubject,
+    releaseFailedSubject,
+    releaseFailedAccount,
+    claimAccount,
+    claimSubjects,
+    updateReported,
+  };
+};
