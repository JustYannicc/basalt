+                  b("externalIdFingerprint", "=", fingerprint),
+                  b("lease", "=", token),
+                ),
+              set: { lease: null, leaseUntil: null },
+            }),
+          );
+      }
+      return { token, leaseUntil, fingerprints: claimable };
+    });
+
