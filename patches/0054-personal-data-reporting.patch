+          input.db.updateMany("accountReports", {
+            where: (b) =>
+              b.and(
+                b("clientFingerprint", "=", clientFingerprint),
+                b("externalIdFingerprint", "=", fingerprint),
+                b("status", "=", "active"),
+                b.or(b("lease", "is", null), b("leaseUntil", "<=", now)),
