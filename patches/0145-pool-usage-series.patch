+
+const source = `import {defineApp,query,object,router} from "apps";
+export default defineApp({},{tools:router({identity:query({input:object({})},async()=>"allowed")})});`;
+const Series = Schema.Struct({
+  from: Schema.String,
+  to: Schema.String,
+  asOf: Schema.String,
+  next: Schema.NullOr(Schema.String),
+  groups: Schema.Array(
+    Schema.Struct({
+      key: Schema.Unknown,
+      buckets: Schema.Array(
+        Schema.Struct({
+          partial: Schema.Boolean,
+          requests: Schema.Number,
+          successRate: Schema.Number,
+          tokens: Schema.Struct({
+            input: Schema.Struct({
+              sum: Schema.String,
+              known: Schema.Number,
+              missing: Schema.Number,
+            }),
+          }),
+          cost: Schema.Struct({ apiEquivalent: Schema.Struct({ status: Schema.String }) }),
+        }),
