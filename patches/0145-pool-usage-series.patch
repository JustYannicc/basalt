+          attribution: Schema.optionalKey(Schema.Null),
+          source: Schema.optionalKey(Schema.Null),
+        }),
+        buckets: Schema.Array(counts),
+      }),
+    ]),
+  ),
+  next: Schema.NullOr(Schema.String),
+});
+export const LastSuccessAtInput = Schema.Struct({
+  accounts: Schema.Array(AccountId).check(Schema.isMaxLength(500)),
