@@ -0,0 +1,149 @@
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Clock, Effect, Layer, Ref, Schema } from "effect";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { createHmac, timingSafeEqual } from "node:crypto";
+import { createServer } from "node:http";
+
+const Assertion = Schema.Struct({
+  action: Schema.Literals(["poolUsageSeries", "lastSuccessAt"]),
+  pool: Schema.String,
+  organization: Schema.String,
+  user: Schema.String,
+  expiresAt: Schema.Number,
+  input: Schema.Unknown,
+  authority: Schema.Struct({
+    canManage: Schema.Literal(true),
+    accounts: Schema.Array(Schema.Unknown),
+  }),
+});
+
+/** The hosted server is real; this loopback peer implements only the external pool protocol. */
+export const poolUsageSeriesBackend = Effect.gen(function* () {
+  const calls = yield* Ref.make<readonly (typeof Assertion.Type)[]>([]);
+  const handler = Effect.gen(function* () {
+    const request = yield* HttpServerRequest.HttpServerRequest;
+    const body = yield* request.json.pipe(
+      Effect.flatMap(Schema.decodeUnknownEffect(Schema.Struct({ envelope: Schema.String }))),
+    );
+    const [prefix, encoded, signature, extra] = body.envelope.split(".");
+    if (
+      prefix !== "sbs1" ||
+      encoded === undefined ||
+      signature === undefined ||
+      extra !== undefined
+    )
+      return HttpServerResponse.empty({ status: 401 });
+    const actual = Buffer.from(signature, "base64url");
+    const expected = createHmac("sha256", Buffer.from("ab".repeat(32), "hex"))
+      .update(`${prefix}.${encoded}`)
+      .digest();
+    if (actual.length !== expected.length || !timingSafeEqual(actual, expected))
+      return HttpServerResponse.empty({ status: 401 });
+    const assertion = yield* Schema.decodeUnknownEffect(Schema.fromJsonString(Assertion))(
+      Buffer.from(encoded, "base64url").toString(),
+    );
+    const now = yield* Clock.currentTimeMillis;
+    if (
+      assertion.expiresAt <= now ||
+      assertion.expiresAt > now + 30_000 ||
+      !request.url.endsWith(`/${assertion.action}`)
+    )
+      return HttpServerResponse.empty({ status: 401 });
+    yield* Ref.update(calls, (values) => [...values, assertion]);
+    const mapping = { current: true, historicalGenerations: "unknown", proof: "unavailable" };
+    if (assertion.action === "lastSuccessAt")
+      return HttpServerResponse.jsonUnsafe({ asOf: "2026-01-02T00:00:00Z", mapping, accounts: [] });
+    const unavailable = {
+      status: "unavailable",
+      reason: "Synthetic source has no provider API valuation proof.",
+    };
+    const token = { sum: "9007199254740993", known: 1, missing: 1 };
+    const absent = { amount: null, currency: "USD", priced: 0, unpriced: 1 };
+    return HttpServerResponse.jsonUnsafe({
+      from: "2026-01-01T00:15:00Z",
+      to: "2026-01-01T01:15:00Z",
+      bucket: "hour",
+      asOf: "2026-01-02T00:00:00Z",
+      coverage: {
+        sources: [
+          {
+            source: "a".repeat(64),
+            kind: "import",
+            firstAt: "2026-01-01T00:45:00Z",
+            lastAt: "2026-01-01T00:45:00Z",
+            backfillComplete: null,
+            sweep: null,
+          },
+        ],
+        firstAt: "2026-01-01T00:45:00Z",
+        lastAt: "2026-01-01T00:45:00Z",
+        capturedThrough: null,
+        mapping: { ...mapping, mapped: 0, unmapped: 2, otherAccounts: 0 },
+        pricing: {
+          homeCharge: 0,
+          importedApiPrice: 1,
+          unpriced: 1,
+          missing: 0,
+          missingSnapshot: 1,
+          missingVersion: 1,
+          apiEquivalent: unavailable,
+        },
+        priceProjection: unavailable,
+        percentiles: unavailable,
+        seasonalTrainingRange: unavailable,
+      },
+      groups: [
+        {
+          key: { account: "unmapped", currency: "USD", model: null },
+          buckets: [
+            {
+              at: "2026-01-01T00:00:00Z",
+              partial: true,
+              requests: 2,
+              failed: 1,
+              unassignedFailures: 0,
+              successRate: 0.5,
+              lastSuccessAtInRange: "2026-01-01T00:45:00Z",
+              tokens: {
+                input: token,
+                output: token,
+                cacheRead: token,
+                cacheWrite: token,
+                reasoning: token,
+                total: token,
+              },
+              tokenQuality: { complete: 1, legacy: 0, unclassified: 1, inconsistent: 0 },
+              cost: {
+                homeCharge: absent,
+                importedApiPrice: {
+                  amount: "0.123456789012",
+                  currency: "USD",
+                  priced: 1,
+                  unpriced: 1,
+                },
+                apiEquivalent: unavailable,
+                unpricedRequests: 1,
+              },
+              attribution: { chargeSnapshot: 0, keyAtCapture: 0, importOwner: 2, unknown: 0 },
+              homeReference: "private-reference-sentinel",
+            },
+          ],
+        },
+      ],
+      next: null,
+      hostReference: "private-reference-sentinel",
+    });
+  });
+  const services = yield* Layer.build(
+    HttpRouter.serve(
+      Layer.mergeAll(
+        HttpRouter.add("POST", "/__setup/v1/poolUsageSeries", handler),
+        HttpRouter.add("POST", "/__setup/v1/lastSuccessAt", handler),
+      ),
+      { disableLogger: true, disableListenLog: true },
+    ).pipe(Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 }))),
+  );
+  const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+  if (!("port" in server.address)) return yield* Effect.die("Pool series fixture requires TCP");
+  return { origin: `http://127.0.0.1:${server.address.port}`, calls: Ref.get(calls) };
+});
