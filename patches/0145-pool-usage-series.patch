@@ -0,0 +1,83 @@
+import { AccountId, StorageError, type AppId } from "@executor-js/sdk/core";
+import { Effect } from "effect";
+import { SqlClient } from "effect/sql";
+import { AccountTargets } from "../contracts/account-grants.ts";
+import { HostedExecutor } from "../contracts/executor.ts";
+import { OrganizationForbidden } from "../contracts/organization.ts";
+import { AccountGrants } from "./proofs/account-access.ts";
+import { nativePoolMembership } from "./pool-membership.ts";
+import { policyDatabase } from "./resource-policy.ts";
+
+const inspect = (account: AccountId) =>
+  AccountGrants.inspect.pipe(
+    Effect.provideService(AccountTargets.inspect, { account }),
+    Effect.as(true),
+    Effect.catchTag("OrganizationForbidden", () => Effect.succeed(false)),
+  );
+
+const digest = async (value: string) => {
+  const bytes = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(value));
+  return Array.from(new Uint8Array(bytes), (byte) => byte.toString(16).padStart(2, "0")).join("");
+};
+
+/** Same opaque reference format as the private pool membership reader, bounded to 32 IDs. */
+const references = (reference: string) => {
+  const prefix = "sbhrefs1:";
+  const value: unknown = reference.startsWith(prefix)
+    ? JSON.parse(reference.slice(prefix.length))
+    : [reference];
+  if (
+    !Array.isArray(value) ||
+    value.length === 0 ||
+    value.length > 32 ||
+    !value.every(
+      (id): id is string =>
+        typeof id === "string" && id.length > 0 && id.length <= 256 && !id.startsWith(prefix),
+    ) ||
+    new Set(value).size !== value.length
+  )
+    throw new Error("Invalid host account reference");
+  return value;
+};
+
+/** Only after pool management and requested-account inspection; no raw reference leaves the host. */
+export const usageSeriesAccounts = (
+  pool: { readonly pool: AppId; readonly organization: string },
+  requested: readonly AccountId[] | undefined,
+) =>
+  Effect.gen(function* () {
+    for (const account of requested ?? []) {
+      if (!(yield* inspect(account))) return yield* new OrganizationForbidden();
+    }
+    const executor = yield* Effect.flatten(HostedExecutor);
+    const sql = yield* policyDatabase;
+    // This service resolves only AccountAcquisitionHost.source and rechecks its current binding.
+    const membership = yield* nativePoolMembership(pool.organization, pool.pool, executor).pipe(
+      Effect.provideService(SqlClient.SqlClient, sql),
+    );
+    const accounts = [
+      ...new Map(membership.accounts.map((account) => [account.account, account])).values(),
+    ];
+    if (accounts.length > 500) return yield* new StorageError();
+    if (requested?.some((id) => !accounts.some((account) => account.account === id)))
+      return yield* new OrganizationForbidden();
+    const source = yield* Effect.tryPromise(() => digest("home-local-v1")).pipe(
+      Effect.mapError(() => new StorageError()),
+    );
+    return yield* Effect.forEach(accounts, (account) =>
+      Effect.gen(function* () {
+        const allowed = yield* inspect(account.account);
+        const history =
+          account.homeReference === null
+            ? []
+            : yield* Effect.tryPromise(async () =>
+                Promise.all(
+                  references(account.homeReference!).map((id) =>
+                    digest(JSON.stringify([source, "account", id])),
+                  ),
+                ),
+              ).pipe(Effect.mapError(() => new StorageError()));
+        return { account: allowed ? account.account : null, history };
+      }),
+    );
+  });
