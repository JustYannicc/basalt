+/** Scenario certificates are trusted at launch; Chromium never has to retry a rejected handshake. */
+import { createHash, X509Certificate } from "node:crypto";
+import { chromium, type Browser, type BrowserType } from "playwright";
+import { Effect, FileSystem } from "effect";
+import { driver, type Target } from "./platform.ts";
+
+const trustedKeys = new WeakMap<Browser, string>();
+const certificateKey = (file: string) =>
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem;
+    const certificate = new X509Certificate(yield* fs.readFileString(file));
+    return createHash("sha256")
+      .update(certificate.publicKey.export({ type: "spki", format: "der" }))
+      .digest("base64");
+  });
+
+type LaunchOptions = { readonly headless: boolean; readonly slowMo: number };
+const acquireBrowser = (options: LaunchOptions, engine: BrowserType, key?: string) =>
+  Effect.acquireRelease(
+    driver("launch browser", () =>
+      engine.launch({
+        ...options,
+        ...(key === undefined ? {} : { args: [`--ignore-certificate-errors-spki-list=${key}`] }),
+      }),
+    ).pipe(
+      Effect.tap((browser) =>
+        Effect.sync(() => {
+          if (key !== undefined) trustedKeys.set(browser, key);
+        }),
+      ),
+    ),
+    (browser) => driver("close browser", () => browser.close()).pipe(Effect.orDie),
+  );
+
+/** A browser without a target remains usable for rendering saved evidence. */
+export const launchBrowser = (
+  options: LaunchOptions,
+  engine: BrowserType = chromium,
+  certificate?: string,
+) =>
+  Effect.gen(function* () {
+    const key =
+      certificate !== undefined && engine === chromium
+        ? yield* certificateKey(certificate)
+        : undefined;
+    return yield* acquireBrowser(options, engine, key);
+  });
+
+/** A suite may launch its shared browser before a case creates its own certificate. */
+export const fixtureBrowser = (shared: Browser, target: typeof Target.Service) =>
+  Effect.gen(function* () {
+    if (target.tlsCertificate === undefined || shared.browserType().name() !== "chromium")
+      return shared;
+    const key = yield* certificateKey(target.tlsCertificate);
+    if (trustedKeys.get(shared) === key) return shared;
+    return yield* acquireBrowser(
+      {
+        headless: target.headless ?? !target.metadata.interactive,
+        slowMo: target.recordingPaceMs,
+      },
+      chromium,
+      key,
+    );
+  });
