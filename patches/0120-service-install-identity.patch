+/** Service identity belongs to the install, independently of its transport or display name. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Inventory } from "../support/contracts.ts";
+import { officialApps } from "../support/public-catalogs.ts";
+import { McpClient } from "../support/mcp-client.ts";
+import {
+  Installed,
+  serviceInstallClient,
+  legacyServiceInstalls,
+} from "../support/service-install-fixture.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Service install identity", (it) => {
+  it.effect(scenarios.serviceInstallIdentity.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api;
+        const actors = yield* Actors;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const created = new Set<string>();
+        yield* Effect.addFinalizer(() =>
+          Effect.forEach([...created], (app) =>
+            api.request(actors.owner, "DELETE", `${prefix}/apps/${app}`).pipe(Effect.orDie),
+          ),
+        );
+        const install = (name: string, newInstance = false) =>
+          api
+            .request(actors.owner, "POST", `${prefix}/apps/install`, {
+              entry: officialApps.tracker.id,
+              name,
+              ...(newInstance ? { newInstance } : {}),
+            })
+            .pipe(
+              Effect.flatMap((response) => {
+                expect(response.status, JSON.stringify(response.body)).toBe(200);
+                return body(Installed, response).pipe(
+                  Effect.tap((app) => Effect.sync(() => created.add(app.id))),
+                );
+              }),
+            );
+        const first = yield* install("Tracker");
+        const again = yield* install("Tracker through another transport");
+        expect(
+          again.id,
+          "A different name is not permission to create another service install",
+        ).toBe(first.id);
+        expect(first.reused).toBe(false);
+        expect(again.reused).toBe(true);
+        expect(again.activeVersion).toBe(first.activeVersion);
+        yield* api.request(actors.owner, "PATCH", `${prefix}/apps/${first.id}/name`, {
+          name: "Our tracker",
+        });
+        const imported = yield* api.request(actors.owner, "POST", `${prefix}/apps/import`, {
+          source: { kind: "mcp", name: "Tracker MCP", url: "https://tracker.example.test/mcp" },
+        });
+        expect(imported.status, JSON.stringify(imported.body)).toBe(200);
+        const reused = yield* body(Installed, imported);
+        expect(reused).toMatchObject({
+          id: first.id,
+          name: "Our tracker",
+          reused: true,
+          activeVersion: first.activeVersion,
+        });
+        const another = yield* install("Another tracker", true);
+        expect(another.id).not.toBe(first.id);
+        expect(another.reused).toBe(false);
+        const final = yield* install("Tracker once more");
+        expect(final).toMatchObject({ id: first.id, reused: true });
+        const get = yield* api.request(actors.owner, "GET", `${prefix}/apps/${first.id}`);
+        expect(get.body).toMatchObject({
+          service: { id: officialApps.tracker.package, newInstance: false },
+        });
+        const memberImport = yield* api.request(actors.member, "POST", `${prefix}/apps/import`, {
+          source: { kind: "mcp", name: "Private tracker", url: "https://tracker.example.test/mcp" },
+        });
+        expect(memberImport.status).toBe(403);
+        expect(JSON.stringify(memberImport.body)).not.toContain(first.id);
+        const collision = yield* api.request(actors.owner, "POST", `${prefix}/apps/install`, {
+          entry: officialApps.tracker.id,
+          name: another.name,
+          newInstance: true,
+        });
+        expect(collision.status).not.toBe(200);
+        const inventory = yield* body(
+          Inventory,
+          yield* api.request(actors.owner, "GET", `${prefix}/inventory`),
+        );
+        expect(
+          inventory.apps
+            .filter((app) => created.has(app.id))
+            .map((app) => app.id)
+            .sort(),
+        ).toEqual([first.id, another.id].sort());
+        expect(
+          (yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${first.id}`)).status,
+        ).toBe(200);
+        created.delete(first.id);
+        const remaining = yield* install("Use the remaining instance");
+        expect(remaining).toMatchObject({
+          id: another.id,
+          reused: true,
+          service: { id: officialApps.tracker.package, newInstance: true },
+        });
+        expect(
+          (yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${another.id}`)).status,
+        ).toBe(200);
+        created.delete(another.id);
+
+        const catalog = yield* body(
+          Schema.Array(
+            Schema.Struct({
+              id: Schema.String,
+              service: Schema.optionalKey(Schema.Struct({ mcp: Schema.Array(Schema.String) })),
+            }),
+          ),
+          yield* api.request(actors.owner, "GET", `${prefix}/catalog`),
+        );
+        expect(catalog.filter((entry) => entry.id === "synthetic-legacy-tracker")).toEqual([]);
+        const aliasSearch = yield* api.request(
+          actors.owner,
+          "GET",
+          `${prefix}/catalog?search=${encodeURIComponent("@executor.sh/synthetic-legacy-tracker")}`,
+        );
+        expect(aliasSearch.body).toEqual(
+          expect.arrayContaining([expect.objectContaining({ id: officialApps.tracker.id })]),
+        );
+        const endpoint = catalog
+          .find((entry) => entry.id === officialApps.tracker.id)
+          ?.service?.mcp.find((url) => url.startsWith("http://127.0.0.1:"));
+        if (endpoint === undefined)
+          return yield* Effect.die(
+            "The trusted catalog fixture must publish its real MCP endpoint",
+          );
+        const importMcp = (name: string) =>
+          api
+            .request(actors.owner, "POST", `${prefix}/apps/import`, {
+              source: { kind: "mcp", name, url: endpoint },
+            })
+            .pipe(
+              Effect.flatMap((response) => {
+                expect(response.status, JSON.stringify(response.body)).toBe(200);
+                return body(Installed, response).pipe(
+                  Effect.tap((app) => Effect.sync(() => created.add(app.id))),
+                );
+              }),
+            );
+        const mcpFirst = yield* importMcp("MCP first");
+        const nativeAfter = yield* install("Native after MCP");
+        expect(nativeAfter).toMatchObject({
+          id: mcpFirst.id,
+          reused: true,
+          activeVersion: mcpFirst.activeVersion,
+        });
+        expect(
+          (yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${mcpFirst.id}`)).status,
+        ).toBe(200);
+        created.delete(mcpFirst.id);
+        const concurrent = yield* Effect.all(
+          [
+            install("Concurrent native"),
+            importMcp("Concurrent MCP"),
+            install("Concurrent native second"),
+          ],
+          { concurrency: "unbounded" },
+        );
+        expect(new Set(concurrent.map((app) => app.id)).size).toBe(1);
+        expect(concurrent.filter((app) => app.reused === false)).toHaveLength(1);
+        const winner = concurrent[0]!;
+        expect(
+          (yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${winner.id}`)).status,
+        ).toBe(200);
+        created.delete(winner.id);
+        const mcpInstall = yield* serviceInstallClient;
+        const toolApp = yield* mcpInstall(officialApps.tracker.id, "MCP tool install");
+        created.add(toolApp.id);
+        const viaHttp = yield* install("After MCP tool");
+        expect(viaHttp.id).toBe(toolApp.id);
+        const toolReuse = yield* mcpInstall(officialApps.tracker.id, "MCP tool reuse");
+        expect(toolReuse).toMatchObject({ id: viaHttp.id, reused: true });
+        expect(
+          (yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${viaHttp.id}`)).status,
+        ).toBe(200);
+        created.delete(viaHttp.id);
+        const sameName = yield* Effect.all([install("Same name"), install("Same name")], {
+          concurrency: "unbounded",
+        });
+        expect(sameName[0]?.id).toBe(sameName[1]?.id);
+        expect(sameName.filter((app) => app.reused === false)).toHaveLength(1);
+        yield* legacyServiceInstalls(sameName[0]!.id, created);
+      }).pipe(Effect.provide(McpClient.layer)),
+    ),
+  );
+});
