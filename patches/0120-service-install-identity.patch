diff --git a/apps/hosted/server/src/implementation/service-install-records.ts b/apps/hosted/server/src/implementation/service-install-records.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/server/src/implementation/service-install-records.ts
@@ -0,0 +1,85 @@
+import { HostedCatalog } from "../contracts/catalog.ts";
+import { Context, Effect, Schema } from "effect";
+import { AppId, StorageError, type App } from "@executor-js/sdk/core";
+import { type SqlClient } from "effect/sql";
+import { AppServiceIdentity } from "../contracts/service-install.ts";
+
+export const serviceInstallsKey = "basaltServiceInstalls";
+export const poolServiceId = "@signalbox/pool";
+type InstallCommit = (app: App, sql: SqlClient.SqlClient) => Effect.Effect<void, StorageError>;
+const InstallCommit = Context.Reference<InstallCommit | undefined>("hosted/ServiceInstallCommit", {
+  defaultValue: () => undefined,
+});
+/** The SDK calls this inside the transaction that inserts the app, after compilation. */
+export const commitServiceInstall = (app: App, sql: SqlClient.SqlClient) =>
+  Effect.flatMap(InstallCommit, (commit) =>
+    commit === undefined ? Effect.void : commit(app, sql),
+  );
+export const withServiceInstallCommit =
+  (commit: InstallCommit) =>
+  <A, E, R>(operation: Effect.Effect<A, E, R>) =>
+    operation.pipe(Effect.provideService(InstallCommit, commit));
+
+const Recorded = Schema.Struct({ app: AppId, service: AppServiceIdentity });
+/** Only requested, already-visible app IDs leave the metadata projection. */
+export const recordedServiceInstalls = (sql: SqlClient.SqlClient, apps: readonly App[]) =>
+  Effect.gen(function* () {
+    if (apps.length === 0) return new Map<AppId, AppServiceIdentity>();
+    const rows = yield* sql`select app.id as app,
+      coalesce(o.metadata::jsonb -> ${serviceInstallsKey} -> app.id,
+        case when exists (
+          select 1 from jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) pool
+          where pool.value ->> 'app' = app.id
+        ) then jsonb_build_object('id', ${poolServiceId}::text, 'newInstance', true) end) as service
+      from executor_apps app join organization o on app.owner = 'organization:' || o.id
+      where ${sql.in(
+        "app.id",
+        apps.map((app) => app.id),
+      )}`;
+    const recorded = yield* Schema.decodeUnknownEffect(Schema.Array(Recorded))(
+      rows.filter((row) => row.service !== null),
+    );
+    return new Map(recorded.map((row) => [row.app, row.service]));
+  }).pipe(
+    Effect.catchTags({ SqlError: () => new StorageError(), SchemaError: () => new StorageError() }),
+  );
+
+/** Removing an app frees its default claim while leaving the service's other instances intact. */
+export const removeServiceInstall = (sql: SqlClient.SqlClient, app: AppId) =>
+  sql`update organization o set metadata = jsonb_set(coalesce(o.metadata::jsonb, '{}'::jsonb),
+    array[${serviceInstallsKey}], coalesce(o.metadata::jsonb -> ${serviceInstallsKey}, '{}'::jsonb) - ${app})::text
+    from executor_apps a where a.id = ${app} and a.owner = 'organization:' || o.id
+      and (o.metadata::jsonb -> ${serviceInstallsKey}) ? ${app}`.pipe(
+    Effect.asVoid,
+    Effect.catchTag("SqlError", () => new StorageError()),
+  );
+
+/** Existing catalog copies keep their exact package identity until an explicit claim records one. */
+export const projectAppServices = (sql: SqlClient.SqlClient, apps: readonly App[]) =>
+  Effect.gen(function* () {
+    const recorded = yield* recordedServiceInstalls(sql, apps);
+    const needsLegacy = apps.some((app) => !recorded.has(app.id) && app.copiedFrom !== null);
+    const entries = needsLegacy
+      ? yield* Effect.flatMap(HostedCatalog, (catalog) => catalog.list).pipe(
+          Effect.catch(() => Effect.succeed([])),
+        )
+      : [];
+    const packages = new Map(
+      entries.flatMap((entry) =>
+        [entry.package, ...(entry.service?.packages ?? [])].map(
+          (name) => [name, entry.service?.id ?? entry.package] as const,
+        ),
+      ),
+    );
+    return apps.map((app) => {
+      const service =
+        recorded.get(app.id) ??
+        (app.copiedFrom === null
+          ? undefined
+          : {
+              id: packages.get(app.copiedFrom.name) ?? app.copiedFrom.name,
+              newInstance: false,
+            });
+      return { ...app, ...(service === undefined ? {} : { service }) };
+    });
+  });
diff --git a/apps/hosted/server/src/implementation/service-installs.ts b/apps/hosted/server/src/implementation/service-installs.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/server/src/implementation/service-installs.ts
@@ -0,0 +1,128 @@
+import { type CatalogEntry, type CatalogService } from "@executor-js/catalog/contracts";
+import { AppId, AppNameTaken, StorageError, type App, type OwnerId } from "@executor-js/sdk/core";
+import { Effect, Ref, Schema } from "effect";
+import { type SqlClient } from "effect/sql";
+import { CurrentOrganization } from "../contracts/organization.ts";
+import { HostedExecutor } from "../contracts/executor.ts";
+import { policyDatabase, requireAppAccess } from "./resource-policy.ts";
+import {
+  poolServiceId,
+  serviceInstallsKey,
+  withServiceInstallCommit,
+} from "./service-install-records.ts";
+
+export const catalogService = (entry: CatalogEntry): CatalogService => ({
+  id: entry.service?.id ?? entry.package,
+  mcp: entry.service?.mcp ?? [],
+  packages: [...new Set([entry.package, ...(entry.service?.packages ?? [])])],
+});
+/** URL syntax is canonicalized; paths and products are never guessed from hosts or names. */
+export const mcpService = (entries: readonly CatalogEntry[], endpoint: string): CatalogService => {
+  const url = new URL(endpoint).href;
+  const entry = entries.find((entry) =>
+    entry.service?.mcp.some((alias) => new URL(alias).href === url),
+  );
+  return entry === undefined
+    ? { id: `mcp:${url}`, mcp: [url], packages: [] }
+    : catalogService(entry);
+};
+
+const existingApp = (
+  sql: SqlClient.SqlClient,
+  organization: string,
+  owner: OwnerId,
+  service: CatalogService,
+  exclude?: AppId,
+) =>
+  Effect.gen(function* () {
+    const rows = yield* sql`select app.id,
+      case when (o.metadata::jsonb -> ${serviceInstallsKey}) ? app.id
+        then o.metadata::jsonb -> ${serviceInstallsKey} -> app.id ->> 'newInstance' = 'true'
+        else ${service.id === poolServiceId}::boolean and exists (
+          select 1 from jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) pool
+          where pool.value ->> 'app' = app.id
+        ) end as new_instance
+      from executor_apps app
+      join organization o on o.id = ${organization} and app.owner = 'organization:' || o.id
+      where app.owner = ${owner} and app.id <> ${exclude ?? ""}
+        and case when (o.metadata::jsonb -> ${serviceInstallsKey}) ? app.id
+          then o.metadata::jsonb -> ${serviceInstallsKey} -> app.id ->> 'id' = ${service.id}
+          else (${service.packages?.length ? sql`app.copied_from ->> 'name' in (select jsonb_array_elements_text(${JSON.stringify(service.packages)}::jsonb))` : sql`false`}
+            or (${service.id === poolServiceId}::boolean and exists (
+              select 1 from jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) pool
+              where pool.value ->> 'app' = app.id
+            )))
+        end
+      order by new_instance, app.created_at, app.id limit 1`;
+    return (yield* Schema.decodeUnknownEffect(
+      Schema.Array(
+        Schema.Struct({
+          id: AppId,
+          new_instance: Schema.Boolean,
+        }),
+      ),
+    )(rows))[0];
+  }).pipe(
+    Effect.catchTags({ SqlError: () => new StorageError(), SchemaError: () => new StorageError() }),
+  );
+
+/** Compilation owns no SQL transaction. Only its app-create commit claims the default service. */
+export const installService = <E, R>(
+  owner: OwnerId,
+  service: CatalogService,
+  newInstance: boolean,
+  create: Effect.Effect<App, E, R>,
+) =>
+  Effect.gen(function* () {
+    const { organization } = yield* CurrentOrganization;
+    const sql = yield* policyDatabase;
+    const executor = yield* Effect.flatten(HostedExecutor);
+    const reused = (existing: { readonly id: AppId; readonly new_instance: boolean }) =>
+      Effect.gen(function* () {
+        yield* requireAppAccess(existing.id, "read");
+        const app = yield* executor.apps.get({ owner, app: existing.id });
+        return {
+          ...app,
+          reused: true,
+          service: { id: service.id, newInstance: existing.new_instance },
+        };
+      });
+    if (!newInstance) {
+      const existing = yield* existingApp(sql, organization, owner, service);
+      if (existing !== undefined) return yield* reused(existing);
+    }
+    const conflict = yield* Ref.make<
+      { readonly id: AppId; readonly new_instance: boolean } | undefined
+    >(undefined);
+    const commit = (app: App, tx: SqlClient.SqlClient) =>
+      Effect.gen(function* () {
+        yield* tx`select pg_advisory_xact_lock(hashtextextended(${`service-install:${organization}:${service.id}`}, 0))`;
+        if (!newInstance) {
+          const existing = yield* existingApp(tx, organization, owner, service, app.id);
+          if (existing !== undefined) {
+            yield* Ref.set(conflict, existing);
+            return yield* new StorageError();
+          }
+        }
+        yield* tx`update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb),
+          array[${serviceInstallsKey}], coalesce(metadata::jsonb -> ${serviceInstallsKey}, '{}'::jsonb)
+            || jsonb_build_object(${app.id}::text, jsonb_build_object('id', ${service.id}::text, 'newInstance', ${newInstance}::boolean)))::text
+          where id = ${organization}`;
+      }).pipe(Effect.catchTag("SqlError", () => new StorageError()));
+    return yield* create.pipe(
+      withServiceInstallCommit(commit),
+      Effect.map((app) => ({ ...app, reused: false, service: { id: service.id, newInstance } })),
+      Effect.catch((error) =>
+        Effect.gen(function* () {
+          const conflicted = yield* Ref.get(conflict);
+          if (Schema.is(StorageError)(error) && conflicted !== undefined)
+            return yield* reused(conflicted);
+          if (!newInstance && Schema.is(AppNameTaken)(error)) {
+            const existing = yield* existingApp(sql, organization, owner, service);
+            if (existing !== undefined) return yield* reused(existing);
+          }
+          return yield* Effect.fail(error);
+        }),
+      ),
+    );
+  });
