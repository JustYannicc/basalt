+        Schema.Struct({ metadata: Schema.NullOr(Schema.String) }),
+      )(prior[0]?.[0]);
+      yield* Effect.addFinalizer(() =>
+        Effect.gen(function* () {
+          yield* legacyStorage([
+            {
+              sql: "update organization set metadata = $2 where id = $1",
+              params: [actors.organization.id, oldMetadata.metadata],
+            },
+          ]);
+          yield* serverControl("start");
+        }).pipe(Effect.orDie),
+      );
+      yield* legacyStorage([
+        {
+          sql: "update organization set metadata = jsonb_set((coalesce(metadata::jsonb, '{}'::jsonb) #- array['basaltServiceInstalls', $2]), '{basaltPools}', $3::jsonb)::text where id = $1",
+          params: [
+            actors.organization.id,
+            legacyApp,
+            JSON.stringify({ oldA: { app: pools[0] }, oldB: { app: pools[1] } }),
+          ],
+        },
+        {
+          sql: "update executor_apps set copied_from = jsonb_set(copied_from::jsonb, '{name}', to_jsonb($2::text)) where id = $1",
+          params: [legacyApp, "@executor.sh/synthetic-legacy-tracker"],
+        },
+      ]);
+      yield* serverControl("start");
+      const legacyResponse = yield* api.request(actors.owner, "POST", `${prefix}/apps/install`, {
+        entry: officialApps.tracker.id,
+        name: "Existing legacy catalog copy",
+      });
+      expect(legacyResponse.status).toBe(200);
+      const legacyReused = yield* body(Installed, legacyResponse);
+      expect(legacyReused).toMatchObject({
+        id: legacyApp,
+        reused: true,
+        service: { id: officialApps.tracker.package, newInstance: false },
+      });
+      const legacyInventory = yield* api.request(actors.owner, "GET", `${prefix}/inventory`);
+      const projection = yield* body(
+        Schema.Struct({
+          apps: Schema.Array(
+            Schema.Struct({
+              id: Schema.String,
+              service: Schema.optionalKey(
+                Schema.Struct({ id: Schema.String, newInstance: Schema.Boolean }),
+              ),
+            }),
+          ),
+        }),
+        legacyInventory,
+      );
+      for (const pool of pools)
+        expect(projection.apps.find((app) => app.id === pool)?.service).toEqual({
+          id: "@signalbox/pool",
+          newInstance: true,
+        });
