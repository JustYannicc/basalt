+            },
+            appsManifest,
+          ],
+        });
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const pool = yield* body(Schema.Struct({ id: Schema.String }), deployed);
+        pools.push(pool.id);
+        created.add(pool.id);
+      }
+      // Only an older server could leave these installs without the new service claims.
+      const prior = yield* legacyStorage([
