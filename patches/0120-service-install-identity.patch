+      );
+      const after = yield* legacyStorage([
+        {
+          sql: "select metadata from organization where id = $1",
+          params: [actors.organization.id],
+        },
+      ]);
+      const stored = yield* Schema.decodeUnknownEffect(Schema.Struct({ metadata: Schema.String }))(
+        after[0]?.[0],
