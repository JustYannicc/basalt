+});
+
+/** Native MCP runs the actual management app and returns its install result unchanged. */
+export const serviceInstallClient = Effect.gen(function* () {
+  const api = yield* Api,
+    actors = yield* Actors;
+  yield* managementApp(actors.owner);
+  const key = yield* body(
+    Schema.Struct({ id: Schema.String, key: Schema.RedactedFromValue(Schema.String) }),
+    yield* api.request(actors.owner, "POST", "/api/auth/api-key/create", {
+      name: "Service identity proof",
+    }),
+  );
+  yield* Effect.addFinalizer(() =>
+    api
+      .request(actors.owner, "POST", "/api/auth/api-key/delete", { keyId: key.id })
+      .pipe(Effect.orDie),
+  );
+  const client = yield* (yield* McpClient).connect(key.key, "service-install-identity", {
+    organization: actors.organization.id,
+    mode: "native",
+  });
+  return (entry: string, name: string) =>
+    Effect.gen(function* () {
+      const call = yield* client.use("Install a catalog service through MCP", (client, signal) =>
+        client.callTool(
+          {
+            name: "execute",
+            arguments: {
+              code: `return await tools.executor.apps.install({body:${JSON.stringify({ entry, name })}});`,
+            },
+          },
+          undefined,
+          { signal },
+        ),
+      );
+      const outcome = yield* Schema.decodeUnknownEffect(
+        Schema.Struct({
+          status: Schema.Literal("completed"),
+          execution: Schema.Struct({ ok: Schema.Literal(true), value: Installed }),
+        }),
+      )(call.structuredContent);
+      return outcome.execution.value;
+    });
+});
+
