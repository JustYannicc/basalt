+import { Effect } from "effect";
+import { CatalogUnavailable, type CatalogEntry } from "../contracts/catalog.ts";
+
+/** A service lists once; endpoint and package aliases survive the merge. */
+export const catalogServices = (entries: readonly CatalogEntry[]) =>
+  Effect.gen(function* () {
+    const services = new Map<string, CatalogEntry>();
+    const endpoints = new Map<string, string>();
+    for (const entry of entries) {
+      const id = entry.service?.id ?? entry.package;
+      const earlier = services.get(id);
+      const mcp = [
+        ...new Set([
+          ...(earlier?.service?.mcp ?? []),
+          ...(entry.service?.mcp ?? []).map((url) => new URL(url).href),
+        ]),
+      ];
+      for (const url of mcp) {
+        const service = endpoints.get(url);
+        if (service !== undefined && service !== id) return yield* new CatalogUnavailable();
+        endpoints.set(url, id);
+      }
+      services.set(id, {
+        ...(earlier === undefined || entry.package === id ? entry : earlier),
+        service: {
+          id,
+          mcp,
+          packages: [
+            ...new Set([
+              ...(earlier?.service?.packages ?? []),
+              ...(entry.service?.packages ?? []),
+              entry.package,
+            ]),
+          ],
+        },
+      });
+    }
+    return [...services.values()];
+  });
