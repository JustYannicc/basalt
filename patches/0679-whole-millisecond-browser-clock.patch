diff --git a/e2e/support/browser-clock.ts b/e2e/support/browser-clock.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/browser-clock.ts
@@ -0,0 +1,36 @@
+import type { Page } from "playwright";
+
+/**
+ * Playwright's controlled clock keeps fractional timer delays, such as a jittered reconnect, so its
+ * `Date.now()` can land between milliseconds; a browser truncates delays and reports whole ones.
+ * Effect converts `Date.now()` to a `BigInt` for every span, so a fractional value fails a request
+ * before it is sent. Runs after the clock replaces `Date`, so it wraps the controlled one.
+ */
+const wholeMilliseconds = () => {
+  const now = Date.now;
+  Date.now = () => Math.floor(now.call(Date));
+};
+
+/** The only way scenarios install the browser clock; `executor/clock-through-helper` enforces it. */
+export const installClock = (page: Page, options?: Parameters<Page["clock"]["install"]>[0]) => {
+  const context = page.context();
+  return context.clock
+    .install(options)
+    .then(() => context.addInitScript(wholeMilliseconds))
+    .then(() =>
+      Promise.all(
+        context
+          .pages()
+          .flatMap((open) => open.frames())
+          .map((frame) =>
+            frame.evaluate(wholeMilliseconds).catch((error: unknown) => {
+              // A frame that navigates meanwhile gets the init script on its next document.
+              if (frame.isDetached() || /context was destroyed|navigat/i.test(String(error)))
+                return;
+              throw error;
+            }),
+          ),
+      ),
+    )
+    .then(() => undefined);
+};
