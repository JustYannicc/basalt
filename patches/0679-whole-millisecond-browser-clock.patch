 /** Hosted pages re-read idle queries every 30 seconds while visible. */
 export const idleReconciliationMillis = 30_000;
+/**
+ * Playwright's controlled clock keeps fractional timer delays, such as a jittered reconnect, so its
+ * `Date.now()` can land between milliseconds; a browser truncates delays and reports whole ones.
+ * Effect converts `Date.now()` to a `BigInt` for every span, so a fractional value fails a request
+ * before it is sent. Runs after the clock replaces `Date`, so it wraps the controlled one.
+ */
+const wholeMilliseconds = () => {
+  const now = Date.now;
+  Date.now = () => Math.floor(now.call(Date));
+};
 /** Install before navigation so scenarios can reach periodic reconciliation without waiting. */
 export const installBrowserClock = Effect.flatMap(Browser, (browser) =>
-  browser.use("Control the browser clock", (page) => page.context().clock.install()),
+  browser.use("Control the browser clock", (page) => {
+    const context = page.context();
+    return context.clock
+      .install()
+      .then(() => context.addInitScript(wholeMilliseconds))
+      .then(() =>
+        Promise.all(
+          context
+            .pages()
+            .flatMap((open) => open.frames())
+            .map((frame) => frame.evaluate(wholeMilliseconds)),
+        ),
+      )
+      .then(() => undefined);
+  }),
 );
