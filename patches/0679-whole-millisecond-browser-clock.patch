+/** `<anything>.clock.install(...)`, from a page or its browser context. */
+const installsClock = (callee: ESTree.Node) =>
+  callee.type === "MemberExpression" &&
+  !callee.computed &&
+  callee.property.type === "Identifier" &&
+  callee.property.name === "install" &&
+  callee.object.type === "MemberExpression" &&
+  !callee.object.computed &&
+  callee.object.property.type === "Identifier" &&
+  callee.object.property.name === "clock";
+
+const clockThroughHelper = defineRule({
+  meta: {
+    type: "problem",
+    docs: {
+      description:
+        "Install Playwright's browser clock explicitly only through installClock; methods that install it implicitly are not checked.",
+    },
+    messages: {
+      direct:
+        "Use installClock from e2e/support/browser-clock.ts: Playwright's controlled Date.now() can return fractional milliseconds, which fail every Effect span, and the helper keeps it whole like a browser.",
+    },
+  },
+  create: (context) => ({
+    CallExpression(node) {
+      if (installsClock(node.callee)) context.report({ node: node.callee, messageId: "direct" });
+    },
+  }),
+});
+
 /** The flags `Schema.isPattern` can export: Unicode, optionally with `d`, `g` or `y`. */
 const exportableFlags = /^[dg]*uy?$/u;
 
