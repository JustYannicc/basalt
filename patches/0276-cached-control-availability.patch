+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Provider account policy", (it) => {
+  for (const width of [1440, 390]) {
+    const scenario =
+      width === 1440 ? scenarios.cachedProviderPolicyDesktop : scenarios.cachedProviderPolicyPhone;
+    it.effect(scenario.title, (context) =>
+      withHostedCase(
+        context,
+        Effect.gen(function* () {
+          const api = yield* Api,
+            actors = yield* Actors,
+            browser = yield* Browser;
+          const catalog = yield* providerAppsCatalog;
+          yield* providerAccountProduct(catalog.origin, `${catalog.origin}/catalog/index.json`);
+          const prefix = `/api/organizations/${actors.organization.id}`;
+          const installed = yield* api.request(actors.owner, "POST", `${prefix}/apps/install`, {
+            entry: "provider-openai",
+            name: "Provider policy choices",
+          });
+          expect(installed.status, JSON.stringify(installed.body)).toBe(200);
+          const app = yield* body(Resource, installed);
+          yield* Effect.addFinalizer(() =>
+            api.request(actors.owner, "DELETE", `${prefix}/apps/${app.id}`).pipe(Effect.orDie),
+          );
+          yield* browser.login(actors.owner);
+          yield* browser.use("Open provider account choices", (page) =>
+            page
+              .setViewportSize({ width, height: 960 })
+              .then(() =>
+                page.goto(`/org/${actors.organization.slug}/apps/${app.id}?view=accounts`),
+              ),
+          );
+          yield* browser.use("The initial policy allows Connect", (page) =>
+            page.getByRole("button", { name: "Connect new account", exact: true }).waitFor(),
+          );
+          const path = new RegExp(`/apps/${app.id}/accounts/methods$`);
+          const committed = browser.use("Commit the policy transition", (page) =>
+            page.evaluate(
+              () =>
+                new Promise<void>((resolve) =>
+                  requestAnimationFrame(() => requestAnimationFrame(() => resolve())),
+                ),
+            ),
+          );
+          const noConnect = (phase: string) =>
+            Effect.gen(function* () {
+              yield* committed;
+              expect(
