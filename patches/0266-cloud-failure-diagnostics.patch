diff --git a/e2e/support/transport-diagnostic.ts b/e2e/support/transport-diagnostic.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/transport-diagnostic.ts
@@ -0,0 +1,55 @@
+import { Schema } from "effect";
+
+export const TransportCode = Schema.Literals([
+  "ECONNREFUSED",
+  "ECONNRESET",
+  "ECONNABORTED",
+  "ETIMEDOUT",
+  "EHOSTUNREACH",
+  "ENETUNREACH",
+  "ENOTFOUND",
+  "EAI_AGAIN",
+  "EPIPE",
+  "EMFILE",
+  "ENFILE",
+  "ENOBUFS",
+  "ENOMEM",
+  "ERR_SOCKET_CLOSED",
+  "UND_ERR_SOCKET",
+  "UND_ERR_CONNECT_TIMEOUT",
+  "UND_ERR_HEADERS_TIMEOUT",
+  "UND_ERR_BODY_TIMEOUT",
+  "ERR_TLS_CERT_ALTNAME_INVALID",
+  "DEPTH_ZERO_SELF_SIGNED_CERT",
+  "UNABLE_TO_VERIFY_LEAF_SIGNATURE",
+  "CERT_HAS_EXPIRED",
+  "UNKNOWN",
+]);
+export const TransportDiagnostic = Schema.Struct({
+  code: TransportCode,
+  errno: Schema.optional(Schema.Int.check(Schema.isBetween({ minimum: -65535, maximum: 65535 }))),
+});
+
+/** Error messages and request objects can contain capabilities; retain only closed OS codes. */
+export const transportDiagnostic = (cause: unknown): typeof TransportDiagnostic.Type => {
+  const pending: unknown[] = [cause];
+  for (let inspected = 0; pending.length > 0 && inspected < 16; inspected++) {
+    const value = pending.shift();
+    if (typeof value !== "object" || value === null) continue;
+    const code =
+      "code" in value ? TransportCode.literals.find((code) => code === value.code) : undefined;
+    if (code !== undefined) {
+      const errno = "errno" in value ? value.errno : undefined;
+      return {
+        code,
+        ...(typeof errno === "number" && Number.isInteger(errno) && Math.abs(errno) <= 65535
+          ? { errno }
+          : {}),
+      };
+    }
+    if ("cause" in value) pending.push(value.cause);
+    if ("reason" in value) pending.push(value.reason);
+    if ("errors" in value && Array.isArray(value.errors)) pending.push(...value.errors.slice(0, 8));
+  }
+  return { code: "UNKNOWN" };
+};
