--- /dev/null
+++ b/scripts/e2e-collector-bun.ts
@@ -0,0 +1,23 @@
+import { execFileSync } from "node:child_process";
+
+/** The collector has a separate frozen lockfile and compiler from the app framework. */
+export function collectorBun() {
+  const binary = process.env.EXECUTOR_MOTEL_BUN;
+  if (!binary) throw new Error("EXECUTOR_MOTEL_BUN must name the collector's Bun 1.4.4 executable");
+  let version: string;
+  try {
+    version = execFileSync(binary, ["--version"], {
+      encoding: "utf8",
+      stdio: ["ignore", "pipe", "pipe"],
+    }).trim();
+  } catch {
+    throw new Error(
+      `Cannot execute EXECUTOR_MOTEL_BUN (${binary}); the collector requires Bun 1.4.4`,
+    );
+  }
+  if (version !== "1.4.4")
+    throw new Error(
+      `EXECUTOR_MOTEL_BUN must be Bun 1.4.4; received ${/^\d+\.\d+\.\d+$/.test(version) ? version : "an unrecognized version"}`,
+    );
+  return { command: [binary, "packages/telemetry/scripts/build-motel.ts"], version };
+}
