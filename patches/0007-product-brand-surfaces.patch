+/**
+ * The document under the deployment's own name. People read its title and agents read its prose,
+ * so under another brand the title names the product and descriptions and summaries say its name
+ * instead of Executor. Identifiers, paths and scopes stay as they are, and the built-in app is
+ * named by its slug, which agents use to reach it.
+ */
+export const brandApiDocument = (
+  document: HostedApiDocument,
+  brand: ProductBrand,
+): HostedApiDocument => {
+  if (isDefaultProductBrand(brand)) return document;
+  const branded: HostedApiDocument = JSON.parse(JSON.stringify(document), (key, value) =>
+    typeof value === "string" && (key === "description" || key === "summary")
+      ? value
+          .replace(/\bExecutor app\b/g, "`executor` app")
+          .replace(/\bExecutor\b/g, () => brand.name)
+      : value,
+  );
+  return { ...branded, info: { ...branded.info, title: `${brand.name} API` } };
+};
