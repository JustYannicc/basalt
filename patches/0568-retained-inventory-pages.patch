+export const retainedReasonCodes = [
+  "binding_unavailable",
+  "malformed_references",
+  "inconsistent_references",
+  "reference_count_bound",
+  "record_count_bound",
+  "object_count_bound",
+  "metadata_page_bound",
+  "invalid_metadata_cursor",
+  "malformed_metadata",
+  "unreadable_metadata",
+  "invalid_build_key",
+  "malformed_record_size",
+  "native_body_unavailable",
+  "record_size_changed",
+  "object_byte_bound",
+  "stream_byte_bound",
+  "total_byte_bound",
+  "byte_bound",
+  "time_bound",
+  "read_timeout",
+  "invalid_continuation",
+  "continuation_scope_changed",
+  "snapshot_changed",
+  "metadata_changed",
+  "cursor_not_progressing",
+  "operation_timeout",
+  "sql_query_timeout",
+  "sql_failure",
+  "page_protocol_invalid",
+  "page_sequence_invalid",
+  "page_incomplete",
+  "page_count_bound",
+] as const;
