@@ -0,0 +1,43 @@
+import { Effect } from "effect";
+import { protectArtifact } from "./crypto.ts";
+import { databaseIdentity } from "./database-identity.ts";
+import { atPhase } from "./diagnostics.ts";
+import { inventorySnapshot, resolveInventory } from "./inventory.ts";
+import { readOnly } from "./read-only.ts";
+import { retainedFrameworkPage } from "./retained-frameworks-page.ts";
+import type { Operation, OpsSettings } from "./runner.ts";
+
+/** Every inventory releases its SQL snapshot before external record reads or encryption. */
+export const inventoryOperation = (settings: OpsSettings, operation: Operation, now: number) =>
+  Effect.gen(function* () {
+    if (operation.selection === "retained-frameworks")
+      return yield* retainedFrameworkPage(settings, operation, now);
+    const captured = yield* readOnly(
+      Effect.gen(function* () {
+        const database = yield* databaseIdentity(settings.databaseOrigin);
+        return {
+          snapshot: yield* inventorySnapshot(operation.selection, operation.request.organization),
+          database,
+        };
+      }),
+    );
+    const result = { ...(yield* resolveInventory(captured.snapshot)), database: captured.database };
+    return {
+      action: "inventory",
+      rows: result.rows.length,
+      artifact: yield* Effect.tryPromise(() =>
+        protectArtifact(
+          {
+            format: "basalt-production-inventory-v1",
+            target: settings.target,
+            release: settings.release,
+            observedAt: now,
+            ...result,
+          },
+          settings.encryptionKey,
+          operation.recipient,
+          settings.target,
+        ),
+      ).pipe(atPhase("encryption")),
+    };
+  });
diff --git a/apps/hosted/cloud/src/infrastructure/production-ops/retained-frameworks-page-query.ts b/apps/hosted/cloud/src/infrastructure/production-ops/retained-frameworks-page-query.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/production-ops/retained-frameworks-page-query.ts
@@ -0,0 +1,64 @@
+import { Effect, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import { retainedFrameworkRefused } from "./retained-frameworks.ts";
+
+export const retainedFrameworkPageSize = 64;
+const Id = (prefix: string) =>
+  Schema.String.check(Schema.isPattern(new RegExp(`^${prefix}_[A-Za-z0-9_-]{1,251}$`, "u")));
+const Reference = Schema.Struct({ app: Id("app"), deployment: Id("dpl"), build: Id("bld") });
+export const ReferenceCoverage = Schema.Struct({
+  references: Schema.Int.check(Schema.isBetween({ minimum: 0, maximum: 2147483647 })),
+  checksum: Schema.String.check(Schema.isPattern(/^[01]{128}$/u)),
+});
+export const ReferenceSnapshot = Schema.Struct({
+  ...ReferenceCoverage.fields,
+  fingerprint: Schema.String.check(Schema.isPattern(/^[a-f0-9]{32}$/u)),
+});
+const scope = `from executor_apps a join executor_deployments d on d.code = a.code and d.owner = a.owner
+  where a.owner = 'organization:' || $1 and d.owner = 'organization:' || $1`;
+const checksum = `coalesce(bit_xor(('x' || md5(app || chr(31) || deployment || chr(31) || build))::bit(128))::text, repeat('0', 128))`;
+
+/** Only the first and final pages fingerprint the scoped associations; no record bodies enter SQL. */
+export const referenceSnapshot = (organization: string) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const rows = yield* sql.unsafe(
+      `select count(*)::int as "references", ${checksum} as checksum,
+    md5(coalesce(string_agg(app || chr(31) || deployment || chr(31) || build, chr(30)
+      order by app collate "C", deployment collate "C"), '')) as fingerprint
+    from (select a.id as app, d.id as deployment, d.build ${scope}) refs`,
+      [organization],
+    );
+    return yield* Schema.decodeUnknownEffect(ReferenceSnapshot)(rows[0]).pipe(
+      Effect.mapError(() => new Error("Invalid retained reference snapshot")),
+    );
+  });
+
+/** Keyset by distinct build prevents copied or inactive associations from rereading a build. */
+export const referencePage = (organization: string, after: string) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const result = yield* sql.unsafe(
+      `with selected as (
+    select distinct d.build collate "C" as build ${scope} and d.build collate "C" > $2 collate "C"
+    order by build limit ${retainedFrameworkPageSize + 1}
+  ), page as (select build from selected order by build limit ${retainedFrameworkPageSize}), refs as (
+    select a.id as app, d.id as deployment, d.build ${scope}
+    and d.build in (select build from page) order by d.build collate "C", a.id collate "C", d.id collate "C" limit 2001
+  ) select coalesce((select jsonb_agg(refs order by build collate "C", app collate "C", deployment collate "C") from refs), '[]'::jsonb) as rows,
+    (select ${checksum} from refs) as checksum,
+    (select count(*) > ${retainedFrameworkPageSize} from selected) as more`,
+      [organization, after],
+    );
+    const decoded = yield* Schema.decodeUnknownEffect(
+      Schema.Struct({
+        rows: Schema.Array(Reference),
+        more: Schema.Boolean,
+        checksum: ReferenceCoverage.fields.checksum,
+      }),
+    )(result[0]).pipe(Effect.catch(() => retainedFrameworkRefused("malformed references")));
+    if (decoded.rows.length > 2000) return yield* retainedFrameworkRefused("reference count bound");
+    if (decoded.more && decoded.rows.length === 0)
+      return yield* retainedFrameworkRefused("cursor not progressing");
+    return { ...decoded, last: decoded.rows.at(-1)?.build ?? after };
+  });
diff --git a/apps/hosted/cloud/src/infrastructure/production-ops/retained-frameworks-page.ts b/apps/hosted/cloud/src/infrastructure/production-ops/retained-frameworks-page.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/production-ops/retained-frameworks-page.ts
@@ -0,0 +1,157 @@
+import { randomUUID } from "node:crypto";
+import { Effect, Schema } from "effect";
+import { canonical, openArtifact, protectArtifact, sha256 } from "./crypto.ts";
+import { databaseIdentity } from "./database-identity.ts";
+import { atPhase } from "./diagnostics.ts";
+import { readOnly } from "./read-only.ts";
+import {
+  referencePage,
+  referenceSnapshot,
+  ReferenceCoverage,
+  ReferenceSnapshot,
+} from "./retained-frameworks-page-query.ts";
+import { retainedFrameworks, retainedFrameworkRefused } from "./retained-frameworks.ts";
+import { retainedFrameworkReadBudget } from "./retained-frameworks-read.ts";
+import type { Operation, OpsSettings } from "./runner.ts";
+
+const Digest = Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/u));
+const Cursor = Schema.Struct({
+  format: Schema.Literal("basalt-retained-inventory-cursor-v1"),
+  target: Schema.String,
+  organization: Schema.String,
+  release: Schema.String,
+  recipient: Digest,
+  database: Schema.Json,
+  session: Schema.NonEmptyString,
+  index: Schema.Int.check(Schema.isBetween({ minimum: 1, maximum: 2000 })),
+  after: Schema.String.check(Schema.isPattern(/^bld_[A-Za-z0-9_-]{1,251}$/u)),
+  snapshot: ReferenceSnapshot,
+  covered: ReferenceCoverage,
+  metadataSha256: Digest,
+  prior: Digest,
+  startedAt: Schema.Number,
+  expiresAt: Schema.Number,
+});
+
+/** A sealed constant-size cursor carries authority and progress, never the completed build set. */
+export const retainedFrameworkPage = (settings: OpsSettings, operation: Operation, now: number) =>
+  Effect.gen(function* () {
+    const organization = operation.request.organization;
+    const prior =
+      operation.continuation === undefined
+        ? undefined
+        : yield* Effect.tryPromise(() =>
+            openArtifact(operation.continuation!, settings.encryptionKey, settings.target),
+          ).pipe(
+            Effect.flatMap(Schema.decodeUnknownEffect(Cursor)),
+            Effect.catch(() => retainedFrameworkRefused("invalid continuation")),
+          );
+    if (
+      prior &&
+      (prior.target !== settings.target ||
+        prior.organization !== organization ||
+        prior.release !== settings.release ||
+        prior.recipient !== sha256(operation.recipient) ||
+        prior.startedAt > now ||
+        prior.expiresAt <= now ||
+        prior.expiresAt !== prior.startedAt + 3600000)
+    )
+      return yield* retainedFrameworkRefused("continuation scope changed");
+    const captured = yield* readOnly(
+      Effect.gen(function* () {
+        const database = yield* databaseIdentity(settings.databaseOrigin);
+        if (prior && canonical(prior.database) !== canonical(database))
+          return yield* retainedFrameworkRefused("continuation scope changed");
+        const page = yield* referencePage(organization, prior?.after ?? "");
+        const snapshot = prior?.snapshot ?? (yield* referenceSnapshot(organization));
+        const covered = {
+          references: (prior?.covered.references ?? 0) + page.rows.length,
+          checksum: (BigInt(`0b${prior?.covered.checksum ?? "0"}`) ^ BigInt(`0b${page.checksum}`))
+            .toString(2)
+            .padStart(128, "0"),
+        };
+        // Endpoint snapshots can match after a temporary edit; also bind the rows read by every page.
+        if (
+          covered.references > snapshot.references ||
+          (!page.more &&
+            (covered.references !== snapshot.references ||
+              covered.checksum !== snapshot.checksum ||
+              (prior && canonical(snapshot) !== canonical(yield* referenceSnapshot(organization)))))
+        )
+          return yield* retainedFrameworkRefused("snapshot changed");
+        return { database, page, snapshot, covered };
+      }),
+    );
+    if (!settings.retainedFrameworkObjects)
+      return yield* retainedFrameworkRefused("binding unavailable");
+    const result = yield* retainedFrameworks(
+      captured.page.rows,
+      settings.retainedFrameworkObjects,
+      yield* retainedFrameworkReadBudget(now),
+    );
+    const metadataSha256 = sha256(canonical(result.frameworks));
+    if (prior && prior.metadataSha256 !== metadataSha256)
+      return yield* retainedFrameworkRefused("metadata changed");
+    const index = prior?.index ?? 0;
+    const session = prior?.session ?? randomUUID();
+    const protect = (value: unknown) =>
+      Effect.tryPromise(() =>
+        protectArtifact(value, settings.encryptionKey, operation.recipient, settings.target),
+      ).pipe(atPhase("encryption"));
+    const page = {
+      index,
+      session,
+      prior: prior?.prior ?? null,
+      more: captured.page.more,
+      after: prior?.after ?? "",
+      last: captured.page.last,
+      references: captured.page.rows.length,
+      snapshot: captured.snapshot,
+      checksum: captured.page.checksum,
+      metadataSha256,
+    };
+    const artifact = yield* protect({
+      format: "basalt-production-inventory-v1",
+      target: settings.target,
+      release: settings.release,
+      observedAt: now,
+      selection: "retained-frameworks",
+      organization,
+      database: captured.database,
+      page,
+      ...result,
+    });
+    const continuation = captured.page.more
+      ? yield* protect({
+          format: "basalt-retained-inventory-cursor-v1",
+          target: settings.target,
+          organization,
+          release: settings.release,
+          recipient: sha256(operation.recipient),
+          database: captured.database,
+          session,
+          index: index + 1,
+          after: captured.page.last,
+          snapshot: captured.snapshot,
+          covered: captured.covered,
+          metadataSha256,
+          prior: artifact.sha256,
+          startedAt: prior?.startedAt ?? now,
+          expiresAt: (prior?.startedAt ?? now) + 3600000,
+        })
+      : undefined;
+    return {
+      action: "inventory",
+      rows: result.rows.length,
+      artifact,
+      pagination: {
+        index,
+        session,
+        more: captured.page.more,
+        complete: result.complete,
+        builds: result.builds.length,
+        references: captured.page.rows.length,
+      },
+      ...(continuation === undefined ? {} : { continuation }),
+    };
+  });
