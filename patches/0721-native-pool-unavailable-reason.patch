   unauthorized = false,
-) =>
-  Effect.logWarning("native.control.failed").pipe(
-    Effect.annotateLogs({ action, ...details }),
+) => {
+  // A pool refusal it chose to send (4xx) or a host signing fault is not the pool being down.
+  const poolUnavailable =
+    !unauthorized &&
+    details.stage !== "native_control_signing" &&
+    (details.dependencyStatus === undefined || details.dependencyStatus >= 500);
+  const reported = poolUnavailable
+    ? { ...details, reason: "NATIVE_POOL_UNAVAILABLE" as const }
+    : details;
+  return Effect.logWarning("native.control.failed").pipe(
+    Effect.annotateLogs({ action, ...reported }),
     Effect.andThen(
       Effect.fail(
         new APIError(unauthorized ? "UNAUTHORIZED" : "SERVICE_UNAVAILABLE", {
@@ -16,11 +24,12 @@ export const nativeControlFailure = (
