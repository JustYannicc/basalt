@@ -0,0 +1,392 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect } from "effect";
+import { randomUUID } from "node:crypto";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { App } from "../support/contracts.ts";
+import { Evidence } from "../support/evidence.ts";
+import { openThroughBrowser } from "../support/in-app-navigation.ts";
+import {
+  type InstantContent,
+  type InstantObservation,
+  type InstantStart,
+  observeNavigation,
+  inspectFrameLayout,
+} from "../support/instant-navigation.ts";
+import { holdQuery, installBrowserClock, refreshVisiblePage } from "../support/query-transition.ts";
+import { workflowInputFixture } from "../support/workflow-input-fixture.ts";
+import { waitForAppUrl } from "../support/app-pages.ts";
+import type { Request, Route } from "playwright";
+import { scenarios } from "../test-plan.ts";
+
+const screenFiles = [
+  {
+    path: "index.ts",
+    content: `import { defineApp } from "apps"; export default defineApp({}, {});`,
+  },
+  {
+    path: "ui/index.html",
+    content: `<!doctype html><html><head><title>Screen fixture</title></head><body><main><h1>Screen fixture</h1></main></body></html>`,
+  },
+  appsManifest,
+];
+
+layer(HostedLive, { excludeTestServices: true })("Instant console navigation", (it) => {
+  it.effect(scenarios.instantConsoleRevisit.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const actors = yield* Actors;
+        const api = yield* Api;
+        const browser = yield* Browser;
+        const evidence = yield* Evidence;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const name = `Instant ${randomUUID().slice(0, 8)}`;
+        const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name,
+          files: [
+            {
+              path: "index.ts",
+              content: `
+import { defineApp, query, router } from "apps";
+export default defineApp({}, async () => ({
+  tools: router({ ping: query({ description: "Ping" }, async () => "pong") })
+}));
+`,
+            },
+            appsManifest,
+          ],
+        });
+        expect(deployed.status).toBe(200);
+        const app = yield* body(App, deployed);
+        yield* Effect.addFinalizer(() =>
+          api.request(actors.owner, "DELETE", `${prefix}/apps/${app.id}`).pipe(
+            Effect.tap((response) => Effect.sync(() => expect(response.status).toBe(200))),
+            Effect.orDie,
+          ),
+        );
+        const organization = `/org/${actors.organization.slug}`;
+        const pages: readonly {
+          readonly page: string;
+          readonly start: InstantStart;
+          readonly content: InstantContent;
+        }[] = [
+          {
+            page: "Accounts",
+            start: { kind: "sidebar", link: "Accounts" },
+            content: { text: "No accounts available" },
+          },
+          {
+            page: "Human in the loop",
+            start: { kind: "sidebar", link: "Human in the loop" },
+            content: { text: "Nothing needs you right now" },
+          },
+          {
+            page: "App settings",
+            start: { kind: "path", path: `${organization}/apps/${app.id}?view=settings` },
+            content: { text: "Rename" },
+          },
+          {
+            page: "App workflows",
+            start: { kind: "path", path: `${organization}/apps/${app.id}?view=workflows` },
+            content: { selector: '[aria-label="App workflows"]' },
+          },
+          {
+            page: "Apps",
+            start: { kind: "sidebar", link: "Apps" },
+            content: { selector: `[aria-label^="Open ${name}"]` },
+          },
+        ];
+        yield* browser.login(actors.owner);
+        yield* openThroughBrowser("Open the apps list", `${organization}/apps`);
+        yield* browser.use("The apps list has loaded", (page) =>
+          page.getByText(name, { exact: true }).first().waitFor({ state: "visible" }),
+        );
+        const results: { pass: string; page: string; observation: InstantObservation }[] = [];
+        const visit = (pass: "first" | "return") =>
+          Effect.forEach(pages, ({ page, start, content }) =>
+            Effect.gen(function* () {
+              const observation = yield* observeNavigation(
+                `${pass === "first" ? "Open" : "Return to"} ${page}`,
+                start,
+                content,
+              );
+              results.push({ pass, page, observation });
+              expect(observation.contentAtStart, `${page} has its own content marker`).toBe(false);
+              expect(observation.contentMs, `${page} content appears`).not.toBeNull();
+              if (pass === "return") yield* browser.checkpoint(`${page} on return`);
+            }),
+          );
+        yield* visit("first");
+        yield* visit("return");
+
+        // An opened app's document keeps running while other console pages are shown.
+        const screen = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: "Kept screen fixture",
+          files: screenFiles,
+        });
+        expect(screen.status, JSON.stringify(screen.body)).toBe(200);
+        const screenApp = yield* body(App, screen);
+        yield* Effect.addFinalizer(() =>
+          api.request(actors.owner, "DELETE", `${prefix}/apps/${screenApp.id}`).pipe(Effect.orDie),
+        );
+        const screenUrl = new URL(
+          yield* waitForAppUrl(actors.owner, `${prefix}/apps/${screenApp.id}/ui`),
+        );
+        const frame = `iframe[title="${screenApp.name} app"]`;
+        let documentLoads = 0;
+        const countDocument = (request: Request) => {
+          const url = new URL(request.url());
+          if (request.resourceType() === "document" && url.origin === screenUrl.origin)
+            documentLoads += 1;
+        };
+        yield* Effect.acquireRelease(
+          browser.use("Count the app's document loads", (page) =>
+            Promise.resolve(void page.on("request", countDocument)),
+          ),
+          () =>
+            browser
+              .use("Stop counting the app's document loads", (page) =>
+                Promise.resolve(void page.off("request", countDocument)),
+              )
+              .pipe(Effect.orDie),
+        );
+        const screenPath = `${organization}/apps/${screenApp.id}`;
+        const opened = yield* observeNavigation(
+          "Open the app screen",
+          { kind: "path", path: screenPath },
+          { selector: frame },
+        );
+        expect(opened.contentMs, "The app screen is shown").not.toBeNull();
+        yield* browser.use("The app document has loaded", (page) =>
+          page.frameLocator(frame).getByRole("heading", { name: "Screen fixture" }).waitFor(),
+        );
+        const original = yield* browser.use("Remember the app's frame", (page) =>
+          page.locator(frame).elementHandle(),
+        );
+        const loadsBefore = documentLoads;
+        // Opening an app signs it in on its own origin, which takes several document requests.
+        expect(loadsBefore, "The app document loaded").toBeGreaterThan(0);
+        const elsewhere = yield* observeNavigation(
+          "Open Accounts while the app is open",
+          { kind: "sidebar", link: "Accounts" },
+          { text: "No accounts available" },
+        );
+        expect(elsewhere.contentMs).not.toBeNull();
+        const hidden = yield* browser.use("Check the app's frame while Accounts is shown", () =>
+          original.evaluate((element) => ({
+            connected: element.isConnected,
+            visible: element.checkVisibility({ visibilityProperty: true }),
+          })),
+        );
+        const returned = yield* observeNavigation(
+          "Return to the app screen",
+          { kind: "path", path: screenPath },
+          { selector: frame },
+        );
+        results.push({ pass: "return", page: "App screen", observation: returned });
+        expect(returned.contentMs, "The app screen is shown").not.toBeNull();
+        yield* browser.checkpoint("App screen on return");
+        const same = yield* browser.use("Compare the shown frame with the original", (page) =>
+          page.evaluate(([selector, previous]) => document.querySelector(selector) === previous, [
+            frame,
+            original,
+          ] as const),
+        );
+        const layout = yield* inspectFrameLayout(frame);
+        expect(layout.dialogReceivesInput, "The dialog receives input above the frame").toBe(true);
+        expect(layout.frameWithinPage, "The frame stays inside its resized page").toBe(true);
+        // Asserted at the end, so a run against older code still records the later journeys.
+        // A kept document closes once its app can no longer be opened, even with its page closed.
+        const closedPage = yield* observeNavigation(
+          "Leave the app screen again",
+          { kind: "sidebar", link: "Accounts" },
+          { text: "No accounts available" },
+        );
+        expect(closedPage.contentMs).not.toBeNull();
+        const removed = yield* api.request(
+          actors.owner,
+          "DELETE",
+          `${prefix}/apps/${screenApp.id}`,
+        );
+        expect(removed.status).toBe(200);
+        yield* refreshVisiblePage;
+        const closedOnRemoval = yield* browser.use(
+          "The removed app's kept document closes",
+          (page) =>
+            page
+              .waitForFunction((element) => !element.isConnected, original, { timeout: 10_000 })
+              .then(
+                () => true,
+                () => false,
+              ),
+        );
+        const kept = {
+          documentLoads,
+          loadsBefore,
+          away: hidden,
+          sameFrame: same,
+          closedOnRemoval,
+        };
+        yield* evidence.json("instant-console-frame.json", kept);
+
+        // A review whose code failed to download offers Try again. Chromium keeps a failed dynamic
+        // import in its module map, so Try again cannot fetch the same chunk again; the outcome is
+        // recorded rather than asserted until the product reloads or re-addresses failed chunks.
+        const reviewChunk = (url: URL) =>
+          /\/assets\/approvals-list-client-[^/]+\.js$/.test(url.pathname);
+        let blockedLoads = 0;
+        const blockChunk = (route: Route) => {
+          blockedLoads += 1;
+          return route.abort("failed");
+        };
+        yield* browser.use("Start a fresh dashboard document", (page) =>
+          page.goto(`${organization}/connect`),
+        );
+        yield* Effect.acquireRelease(
+          browser.use("Fail the review code download", (page) =>
+            page.route(reviewChunk, blockChunk),
+          ),
+          () =>
+            browser
+              .use("Stop failing the review code download", (page) =>
+                page.unroute(reviewChunk, blockChunk),
+              )
+              .pipe(Effect.orDie),
+        );
+        const failed = yield* observeNavigation(
+          "Open Human in the loop while its code cannot load",
+          { kind: "sidebar", link: "Human in the loop" },
+          { text: "This page could not load" },
+        );
+        expect(failed.contentMs, "The load failure offers a retry").not.toBeNull();
+        expect(blockedLoads, "The review code download was attempted").toBe(1);
+        yield* browser.checkpoint("Human in the loop after its code failed to load");
+        yield* browser.use("Let the review code download", (page) =>
+          page.unroute(reviewChunk, blockChunk),
+        );
+        let chunkRequestsAfterRetry = 0;
+        const countChunk = (request: { url: () => string }) => {
+          if (reviewChunk(new URL(request.url()))) chunkRequestsAfterRetry += 1;
+        };
+        const retry = yield* browser.use("Try loading the review again", (page) => {
+          page.on("request", countChunk);
+          return page
+            .getByRole("button", { name: "Try again", exact: true })
+            .click()
+            .then(() =>
+              page
+                .getByText("Nothing needs you right now", { exact: true })
+                .waitFor({ timeout: 5_000 })
+                .then(
+                  () => true,
+                  () => false,
+                ),
+            )
+            .finally(() => page.off("request", countChunk));
+        });
+        yield* browser.checkpoint("Human in the loop after Try again");
+        // Leaving and returning must call the loader again, never hold a spinner on a failed load.
+        const away = yield* observeNavigation(
+          "Leave the failed review",
+          { kind: "sidebar", link: "Apps" },
+          { selector: `[aria-label^="Open ${name}"]` },
+        );
+        expect(away.contentMs).not.toBeNull();
+        const again = yield* observeNavigation(
+          "Return to the failed review",
+          { kind: "sidebar", link: "Human in the loop" },
+          { text: retry ? "Nothing needs you right now" : "This page could not load" },
+        );
+        expect(
+          again.contentMs,
+          "A failed review settles instead of loading forever",
+        ).not.toBeNull();
+        results.push(
+          { pass: "retry-failure", page: "Human in the loop", observation: failed },
+          { pass: "retry-again", page: "Human in the loop", observation: again },
+        );
+        yield* evidence.json("instant-console-navigation.json", results);
+        yield* evidence.json("instant-console-retry.json", {
+          blockedLoads,
+          recoveredOnTryAgain: retry,
+          chunkRequestsAfterRetry,
+        });
+
+        // A stale queue stays on screen while its refresh is held, then takes the new answer.
+        // The browser clock cannot be removed again, so this leg runs last.
+        const inputs = yield* workflowInputFixture;
+        const queue = '[aria-label="Requests for you"]';
+        const requests = (label: string) =>
+          browser.use(label, (page) => page.locator(`${queue} > li`).count());
+        yield* inputs.pending((yield* inputs.start()).id);
+        yield* installBrowserClock;
+        yield* browser.use("Start a dashboard document with a controlled clock", (page) =>
+          page.goto(`${organization}/connect`),
+        );
+        const loaded = yield* observeNavigation(
+          "Open Human in the loop with one request",
+          { kind: "sidebar", link: "Human in the loop" },
+          { selector: queue },
+        );
+        expect(loaded.contentMs).not.toBeNull();
+        expect(yield* requests("The queue shows one request")).toBe(1);
+        const left = yield* observeNavigation(
+          "Leave Human in the loop",
+          { kind: "sidebar", link: "Apps" },
+          { selector: `[aria-label^="Open ${name}"]` },
+        );
+        expect(left.contentMs).not.toBeNull();
+        yield* inputs.pending((yield* inputs.start()).id);
+        yield* browser.use("Leave the queue until it is stale", (page) =>
+          page.clock.runFor(31_000),
+        );
+        const refresh = yield* holdQuery(
+          /^\/api\/organizations\/[^/]+\/workflow-inputs$/,
+          "continue",
+          {
+            query: { pending: "true" },
+          },
+        );
+        const stale = yield* observeNavigation(
+          "Return to the stale queue with its refresh held",
