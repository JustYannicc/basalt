+++ b/e2e/support/instant-navigation.ts
@@ -0,0 +1,174 @@
+/** Observe every committed DOM state between a dashboard navigation and its content. */
+import { Effect } from "effect";
+import { Browser } from "./browser.ts";
+
+/** How the navigation starts inside the running page, so its start time is exact. */
+export type InstantStart =
+  | { readonly kind: "sidebar"; readonly link: string }
+  | { readonly kind: "path"; readonly path: string };
+
+/** What only the loaded page renders inside `main`: a visible selector match, text, or both. */
+export type InstantContent = { readonly selector?: string; readonly text?: string };
+
+export type InstantObservation = {
+  readonly contentMs: number | null;
+  /** True when the departing page already matched the content marker, which makes it ambiguous. */
+  readonly contentAtStart: boolean;
+  /** Loading states that were committed inside the main region, with when they first appeared. */
+  readonly loading: readonly {
+    readonly label: string;
+    /** Tag and first class, which tell apart loading states that share a label. */
+    readonly element: string;
+    readonly atMs: number;
+  }[];
+  readonly samples: number;
+};
+
+/**
+ * The probe samples on every DOM mutation and every animation frame, so a loading state that is
+ * committed and replaced before the next frame is still recorded. Sampling continues for a short
+ * window after the content appears so a loading state that replaces content is also caught.
+ */
+const probe = (input: { readonly start: InstantStart; readonly content: InstantContent }) =>
+  new Promise<InstantObservation>((resolve, reject) => {
+    const loadingSelector = '[role="status"][aria-label^="Loading"], [data-slot="skeleton"]';
+    const loading: { label: string; element: string; atMs: number }[] = [];
+    let contentMs: number | null = null;
+    let samples = 0;
+    let started = 0;
+    // The departing page's own loading states are not part of the destination.
+    const departing = new WeakSet<Element>();
+    const hasContent = (main: Element) =>
+      (input.content.selector === undefined ||
+        [...main.querySelectorAll(input.content.selector)].some((element) =>
+          element.checkVisibility({ visibilityProperty: true }),
+        )) &&
+      (input.content.text === undefined || (main.textContent ?? "").includes(input.content.text));
+    const initial = document.querySelector("main");
+    const contentAtStart = initial !== null && hasContent(initial);
+    for (const element of initial?.querySelectorAll(loadingSelector) ?? []) departing.add(element);
+    const sample = () => {
+      samples++;
+      const main = document.querySelector("main");
+      if (main === null) return;
+      const atMs = performance.now() - started;
+      for (const element of main.querySelectorAll(loadingSelector)) {
+        if (departing.has(element)) continue;
+        const label =
+          element.closest("[aria-label]")?.getAttribute("aria-label") ?? "Unlabelled skeleton";
+        const kind = `${element.tagName.toLowerCase()}.${element.getAttribute("class")?.split(" ")[0] ?? ""}`;
+        if (!loading.some((entry) => entry.label === label && entry.element === kind))
+          loading.push({ label, element: kind, atMs });
+      }
+      if (
+        contentMs === null &&
+        hasContent(main) &&
+        [...main.querySelectorAll(loadingSelector)].every((element) => departing.has(element))
+      )
+        contentMs = atMs;
+    };
+    const observer = new MutationObserver(sample);
+    observer.observe(document.documentElement, {
+      subtree: true,
+      childList: true,
+      attributes: true,
+      characterData: true,
+    });
+    const settleMs = 750;
+    const timeoutMs = 20_000;
+    const frame = () => {
+      sample();
+      const elapsed = performance.now() - started;
+      if ((contentMs !== null && elapsed > contentMs + settleMs) || elapsed > timeoutMs) {
+        observer.disconnect();
+        resolve({ contentMs, contentAtStart, loading, samples });
+        return;
+      }
+      requestAnimationFrame(frame);
+    };
+    started = performance.now();
+    if (input.start.kind === "sidebar") {
+      const name = input.start.link;
+      const link = [
+        ...document.querySelectorAll<HTMLAnchorElement>('nav[aria-label="Main navigation"] a'),
+      ].find((anchor) => anchor.textContent?.trim() === name && anchor.offsetParent !== null);
+      if (link === undefined) {
+        observer.disconnect();
+        reject(new Error(`No visible sidebar link named ${name}`));
+        return;
+      }
+      link.click();
+    } else {
+      window.history.pushState(window.history.state, "", input.start.path);
+    }
+    sample();
+    requestAnimationFrame(frame);
+  });
+
+/** Navigate inside the hydrated dashboard and record every loading state before the content. */
+export const observeNavigation = (label: string, start: InstantStart, content: InstantContent) =>
+  Effect.flatMap(Browser, (browser) =>
+    browser.use(label, (page) => page.evaluate(probe, { start, content })),
+  );
+
+/** Observe the retained app layer through the shared navigation sheet and viewport change. */
+export const inspectFrameLayout = (selector: string) =>
+  Effect.gen(function* () {
+    const browser = yield* Browser;
+    return yield* Effect.acquireUseRelease(
+      browser.use("Remember the viewport", (page) => Promise.resolve(page.viewportSize())),
+      () =>
+        Effect.gen(function* () {
+          yield* browser.use("Resize the app's page", (page) =>
+            page.setViewportSize({ width: 640, height: 680 }),
+          );
+          yield* browser.use("Capture the frame after resizing", (page) =>
+            page.locator(selector).screenshot(),
+          );
+          const frameWithinPage = yield* browser.use(
+            "Observe the app inside its resized page",
+            (page) =>
+              page.locator(selector).evaluate((element) => {
+                const rect = element.getBoundingClientRect();
+                const main = document.querySelector("main")?.getBoundingClientRect();
+                return (
+                  main !== undefined &&
+                  rect.width > 0 &&
+                  rect.height > 0 &&
+                  rect.left >= main.left - 1 &&
+                  rect.right <= main.right + 1 &&
+                  rect.top >= main.top - 1 &&
+                  rect.bottom <= main.bottom + 1
+                );
+              }),
+          );
+          yield* browser.use("Open the navigation sheet above the app", (page) =>
+            page.getByRole("button", { name: "Menu", exact: true }).click(),
+          );
+          yield* browser.use("The navigation sheet is visible", (page) =>
+            page.getByRole("dialog", { name: "Menu", exact: true }).waitFor({ state: "visible" }),
+          );
+          const dialogReceivesInput = yield* browser.use(
+            "The sheet receives input above the frame",
+            (page) =>
+              page.getByRole("dialog", { name: "Menu", exact: true }).evaluate((element) => {
+                const rect = element.getBoundingClientRect();
+                return element.contains(
+                  document.elementFromPoint(rect.x + rect.width / 2, rect.y + rect.height / 2),
+                );
+              }),
+          );
+          yield* browser.use("Close the navigation sheet", (page) => page.keyboard.press("Escape"));
+          yield* browser.use("The navigation sheet closes", (page) =>
+            page.getByRole("dialog", { name: "Menu", exact: true }).waitFor({ state: "hidden" }),
+          );
+          return { dialogReceivesInput, frameWithinPage };
+        }),
+      (previous) =>
+        previous === null
+          ? Effect.void
+          : browser
+              .use("Restore the viewport", (page) => page.setViewportSize(previous))
+              .pipe(Effect.orDie),
+    );
+  });
