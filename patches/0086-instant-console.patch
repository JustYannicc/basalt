diff --git a/apps/hosted/web/src/implementation/components/app-frame-view.tsx b/apps/hosted/web/src/implementation/components/app-frame-view.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..4df130ed9107d2ddc1740e64f67979c198fcdc73
--- /dev/null
+++ b/apps/hosted/web/src/implementation/components/app-frame-view.tsx
@@ -0,0 +1,96 @@
+/** One embedded app document with its loading, failure and shown-or-hidden messages. */
+import { Button } from "@executor-js/ui/components/button";
+import { Skeleton } from "@executor-js/ui/components/skeleton";
+import { useEffect, useLayoutEffect, useRef } from "react";
+
+export type FrameState = "loading" | "ready" | "failed";
+
+export function AppSkeleton() {
+  return (
+    <div role="status" aria-label="Loading app" className="relative flex min-h-0 flex-1">
+      <Skeleton className="absolute inset-0 size-full rounded-none motion-reduce:animate-none" />
+    </div>
+  );
+}
+
+/** A document still loading has another origin, so the target origin drops the message to it. */
+const tell = (frame: HTMLIFrameElement | null, url: string, active: boolean) =>
+  frame?.contentWindow?.postMessage({ type: "executor:app-active", active }, new URL(url).origin);
+
+/**
+ * A host-owned readiness message catches blocked frames and HTTP errors, which do not fire onError.
+ * Each document that reports ready, including one its version watcher reloaded, and each app client
+ * that asks then hears whether the host shows it, so the client can pause its polling while the
+ * frame is not shown. The owner keeps `state`, so a document that stays mounted keeps its answer.
+ */
+export function FrameView({
+  url,
+  name,
+  active,
+  state,
+  onSettle,
+  onRetry,
+}: {
+  readonly url: string;
+  readonly name: string;
+  readonly active: boolean;
+  readonly state: FrameState;
+  readonly onSettle: (state: FrameState) => void;
+  readonly onRetry: () => void;
+}) {
+  const frame = useRef<HTMLIFrameElement>(null);
+  const shown = useRef(active);
+  const settle = useRef(onSettle);
+  useLayoutEffect(() => {
+    settle.current = onSettle;
+  }, [onSettle]);
+  useEffect(() => {
+    shown.current = active;
+    tell(frame.current, url, active);
+  }, [active, url]);
+  useEffect(() => {
+    const timer = window.setTimeout(() => settle.current("failed"), 30000);
+    const ready = (event: MessageEvent) => {
+      if (event.origin !== new URL(url).origin || event.source !== frame.current?.contentWindow)
+        return;
+      // An app client asks when it starts, which may be after the document loaded.
+      if (event.data?.type === "executor:app-client") tell(frame.current, url, shown.current);
+      if (event.data?.type !== "executor:app-ready") return;
+      window.clearTimeout(timer);
+      settle.current("ready");
+      tell(frame.current, url, shown.current);
+    };
+    window.addEventListener("message", ready);
+    return () => {
+      window.clearTimeout(timer);
+      window.removeEventListener("message", ready);
+    };
+  }, [url]);
+  return (
+    <div className="relative flex min-h-0 flex-1 flex-col">
+      {state === "loading" && (
+        <div className="absolute inset-0 z-10 flex">
+          <AppSkeleton />
+        </div>
+      )}
+      {state === "failed" && (
+        <div role="alert" className="flex items-center gap-3 border-b p-3 text-sm">
+          <span>The app did not finish loading. Retry or open it in a new tab.</span>
+          <Button variant="outline" onClick={onRetry}>
+            Retry
+          </Button>
+        </div>
+      )}
+      <iframe
+        ref={frame}
+        src={url}
+        title={`${name} app`}
+        className="min-h-0 w-full flex-1 border-0"
+        sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox allow-downloads"
+        allow="clipboard-write"
+        referrerPolicy="no-referrer"
+        onError={() => onSettle("failed")}
+      />
+    </div>
+  );
+}
diff --git a/apps/hosted/web/src/implementation/components/app-frames.tsx b/apps/hosted/web/src/implementation/components/app-frames.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a70ed3e1d5e23974c9695554c446b33a5795b60e
--- /dev/null
+++ b/apps/hosted/web/src/implementation/components/app-frames.tsx
@@ -0,0 +1,322 @@
+/**
+ * Embedded app documents belong to the organization layout, not to the page that shows them, so
+ * returning to an app from another console page shows its running document at once.
+ *
+ * Moving an iframe in the DOM reloads its document. The layout therefore keeps every frame in one
+ * fixed layer, in a stable order, and places each over the slot its page renders. A frame with no
+ * visible slot stays loaded but hidden, inert and told it is inactive, so its client can pause.
+ */
+import {
+  createContext,
+  useContext,
+  useEffect,
+  useLayoutEffect,
+  useRef,
+  useState,
+  useSyncExternalStore,
+  type CSSProperties,
+  type ReactNode,
+} from "react";
+import { useAtomValue } from "@effect/atom-react";
+import type { OrganizationReference } from "@executor-js/hosted-server/organization";
+import type { AppId } from "@executor-js/sdk";
+import { AsyncResult } from "effect/reactivity";
+import { retainProtectedFailure } from "../../contracts/protected-query.ts";
+import { appAccessAtom } from "../../contracts/resource-access.ts";
+import { FrameView, type FrameState } from "./app-frame-view.tsx";
+
+type Entry = {
+  readonly app: AppId;
+  readonly url: string;
+  readonly name: string;
+  readonly attempt: number;
+  readonly state: FrameState;
+  readonly slot: HTMLElement | null;
+  readonly active: boolean;
+  readonly shownAt: number;
+};
+/** Hidden documents kept running; the least recently shown beyond this are closed. */
+const hiddenLimit = 2;
+
+class FrameStore {
+  private entries: readonly Entry[] = [];
+  private readonly listeners = new Set<() => void>();
+  readonly subscribe = (listener: () => void) => {
+    this.listeners.add(listener);
+    return () => void this.listeners.delete(listener);
+  };
+  readonly snapshot = () => this.entries;
+  private set(entries: readonly Entry[]) {
+    const hidden = entries
+      .filter((entry) => entry.slot === null)
+      .sort((a, b) => b.shownAt - a.shownAt)
+      .slice(hiddenLimit);
+    // Removing an entry never moves the others, so their documents keep running.
+    this.entries = hidden.length === 0 ? entries : entries.filter((e) => !hidden.includes(e));
+    for (const listener of this.listeners) listener();
+  }
+  private change(app: AppId, update: (entry: Entry) => Entry) {
+    this.set(this.entries.map((entry) => (entry.app === app ? update(entry) : entry)));
+  }
+  claim(app: AppId, url: string, name: string, slot: HTMLElement, active: boolean) {
+    const existing = this.entries.find((entry) => entry.app === app);
+    const shown = { name, slot, active, shownAt: Date.now() };
+    if (existing === undefined)
+      this.set([...this.entries, { app, url, attempt: 0, state: "loading", ...shown }]);
+    // A new location, such as a new active version, replaces the document in place.
+    else
+      this.change(app, (entry) =>
+        entry.url === url ? { ...entry, ...shown } : { ...entry, ...shown, url, state: "loading" },
+      );
+  }
+  show(app: AppId, slot: HTMLElement, active: boolean) {
+    this.change(app, (entry) => (entry.slot === slot ? { ...entry, active } : entry));
+  }
+  release(app: AppId, slot: HTMLElement) {
+    this.change(app, (entry) =>
+      entry.slot === slot ? { ...entry, slot: null, active: false, shownAt: Date.now() } : entry,
+    );
+  }
+  evict(app: AppId) {
+    if (this.entries.some((entry) => entry.app === app))
+      this.set(this.entries.filter((entry) => entry.app !== app));
+  }
+  clear() {
+    if (this.entries.length > 0) this.set([]);
+  }
+  settle(app: AppId, url: string, attempt: number, state: FrameState) {
+    this.change(app, (entry) =>
+      entry.url === url && entry.attempt === attempt ? { ...entry, state } : entry,
+    );
+  }
+  retry(app: AppId) {
+    this.change(app, (entry) => ({ ...entry, attempt: entry.attempt + 1, state: "loading" }));
+  }
+}
+
+const FrameContext = createContext<FrameStore | null>(null);
+
+/** Owns the organization's app documents; changing organization closes them all. */
+export function AppFrameHost({
+  organization,
+  reference,
+  children,
+}: {
+  /** The URL slug, which names the organization while its reference resolves to an ID. */
+  readonly organization: string;
+  readonly reference: OrganizationReference;
+  readonly children: ReactNode;
+}) {
+  const [store] = useState(() => new FrameStore());
+  const entries = useSyncExternalStore(store.subscribe, store.snapshot, store.snapshot);
+  const owner = useRef(organization);
+  useEffect(() => {
+    if (owner.current === organization) return;
+    owner.current = organization;
+    store.clear();
+  }, [organization, store]);
+  useEffect(() => () => store.clear(), [store]);
+  return (
+    <FrameContext.Provider value={store}>
+      {children}
+      {entries.map((entry) => (
+        <PlacedFrame
+          key={`${entry.app}\n${entry.url}\n${entry.attempt}`}
+          entry={entry}
+          store={store}
+          organization={reference}
+        />
+      ))}
+    </FrameContext.Provider>
+  );
+}
+
+/** Close an app's document once the person can no longer open its screen. */
+export function useEvictAppFrame(app: AppId, evict: boolean) {
+  const store = useContext(FrameContext);
+  useEffect(() => {
+    if (evict) store?.evict(app);
+  }, [app, evict, store]);
+}
+
+/**
+ * Where a page shows an app's document. Inside an organization the layout owns the document; a
+ * page outside one, such as the app's own window, holds it in place.
+ */
+export function AppFrameSlot(props: {
+  readonly app: AppId;
+  readonly url: string;
+  readonly name: string;
+  readonly active: boolean;
+}) {
+  const store = useContext(FrameContext);
+  return store === null ? (
+    <InlineFrame url={props.url} name={props.name} active={props.active} />
+  ) : (
+    <Slot store={store} {...props} />
+  );
+}
+
+function Slot({
+  store,
+  app,
+  url,
+  name,
+  active,
+}: {
+  readonly store: FrameStore;
+  readonly app: AppId;
+  readonly url: string;
+  readonly name: string;
+  readonly active: boolean;
+}) {
+  const slot = useRef<HTMLDivElement>(null);
+  // Showing or hiding the slot must not release the document, so `active` is read, not tracked.
+  const shown = useRef(active);
+  useLayoutEffect(() => {
+    shown.current = active;
+  }, [active]);
+  useLayoutEffect(() => {
+    const element = slot.current;
+    if (element === null) return;
+    store.claim(app, url, name, element, shown.current);
+    return () => store.release(app, element);
+  }, [store, app, url, name]);
+  useLayoutEffect(() => {
+    if (slot.current !== null) store.show(app, slot.current, active);
+  }, [store, app, active]);
+  return <div ref={slot} className="flex min-h-0 flex-1" />;
+}
+
+function InlineFrame({
+  url,
+  name,
+  active,
+}: {
+  readonly url: string;
+  readonly name: string;
+  readonly active: boolean;
+}) {
+  const [attempt, setAttempt] = useState(0);
+  const [state, setState] = useState<FrameState>("loading");
+  return (
+    <FrameView
+      key={attempt}
+      url={url}
+      name={name}
+      active={active}
+      state={state}
+      onSettle={setState}
+      onRetry={() => {
+        setState("loading");
+        setAttempt((value) => value + 1);
+      }}
+    />
+  );
+}
+
+type Box = {
+  readonly left: number;
+  readonly top: number;
+  readonly width: number;
+  readonly height: number;
+  readonly clip: string;
+};
+const sameBox = (a: Box | null, b: Box | null) =>
+  a === b ||
+  (a !== null &&
+    b !== null &&
+    a.left === b.left &&
+    a.top === b.top &&
+    a.width === b.width &&
+    a.height === b.height &&
+    a.clip === b.clip);
+
+/** The slot's viewport box, clipped to the scrolling main region it sits in. */
+function useSlotBox(slot: HTMLElement | null) {
+  const [box, setBox] = useState<Box | null>(null);
+  useLayoutEffect(() => {
+    if (slot === null) return;
+    const measure = () => {
+      const rect = slot.getBoundingClientRect();
+      const main = slot.closest("main")?.getBoundingClientRect();
+      const clip =
+        main === undefined
+          ? "none"
+          : `inset(${Math.max(0, main.top - rect.top)}px ${Math.max(0, rect.right - main.right)}px ${Math.max(0, rect.bottom - main.bottom)}px ${Math.max(0, main.left - rect.left)}px)`;
+      const next =
+        rect.width === 0 || rect.height === 0
+          ? null
+          : { left: rect.left, top: rect.top, width: rect.width, height: rect.height, clip };
+      setBox((current) => (sameBox(current, next) ? current : next));
+    };
+    measure();
+    const observer = new ResizeObserver(measure);
+    observer.observe(slot);
+    const main = slot.closest("main");
+    if (main !== null) observer.observe(main);
+    window.addEventListener("resize", measure);
+    // Scroll events do not bubble; capturing sees scrolling in any container above the slot.
+    document.addEventListener("scroll", measure, true);
+    return () => {
+      observer.disconnect();
+      window.removeEventListener("resize", measure);
+      document.removeEventListener("scroll", measure, true);
+    };
+  }, [slot]);
+  return slot === null ? null : box;
+}
+
+function PlacedFrame({
+  entry,
+  store,
+  organization,
+}: {
+  readonly entry: Entry;
+  readonly store: FrameStore;
+  readonly organization: OrganizationReference;
+}) {
+  const box = useSlotBox(entry.slot);
+  // A kept document follows the app's access while its page is closed. An authoritative denial,
+  // such as a removed or unshared app, hides it at once and closes it; a transport failure keeps it,
+  // so its drafts survive.
+  const access = useAtomValue(appAccessAtom({ organization, app: entry.app }));
+  const denied =
+    (AsyncResult.isFailure(access) && !retainProtectedFailure(access.cause)) ||
+    (AsyncResult.isSuccess(access) && !access.value.canUse);
+  useEffect(() => {
+    if (denied) store.evict(entry.app);
+  }, [denied, entry.app, store]);
+  const visible = !denied && entry.active && box !== null;
+  const style: CSSProperties = visible
+    ? {
+        position: "fixed",
+        left: box.left,
+        top: box.top,
+        width: box.width,
+        height: box.height,
+        clipPath: box.clip,
+      }
+    : // A hidden document keeps a real size so its layout does not collapse while it waits.
+      {
+        position: "fixed",
+        left: 0,
+        top: 0,
+        width: "100vw",
+        height: "100dvh",
+        visibility: "hidden",
+        pointerEvents: "none",
+      };
+  return (
+    <div style={style} className="flex flex-col bg-background" inert={!visible}>
+      <FrameView
+        url={entry.url}
+        name={entry.name}
+        active={visible}
+        state={entry.state}
+        onSettle={(state) => store.settle(entry.app, entry.url, entry.attempt, state)}
+        onRetry={() => store.retry(entry.app)}
+      />
+    </div>
+  );
+}
