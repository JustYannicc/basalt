diff --git a/e2e/support/sql-wire-requests.ts b/e2e/support/sql-wire-requests.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/sql-wire-requests.ts
@@ -0,0 +1,49 @@
+export interface SqlWireRequest {
+  readonly start: number;
+  readonly generation?: number;
+  readonly query: string;
+  readonly trace?: string;
+  readonly span?: string;
+  readonly cycle: number;
+  readonly blocked?: () => boolean;
+}
+
+/** PostgreSQL Parse/Bind/Sync and simple Query cycles, independently of TCP chunk boundaries. */
+export const sqlWireRequests = (record: (query: string) => SqlWireRequest) => {
+  let startup = true;
+  let front = Buffer.alloc(0);
+  let query = "";
+  const statements = new Map<string, string>();
+  const requests: SqlWireRequest[] = [];
+  const text = (frame: Buffer, offset: number) =>
+    frame.toString("utf8", offset, frame.indexOf(0, offset));
+  return {
+    requests,
+    push: (bytes: Buffer) => {
+      front = Buffer.concat([front, bytes]);
+      while (front.length >= (startup ? 4 : 5)) {
+        const size = startup ? front.readInt32BE(0) : front.readInt32BE(1) + 1;
+        if (size < (startup ? 4 : 5)) throw new Error("Invalid PostgreSQL request frame");
+        if (front.length < size) break;
+        const frame = front.subarray(0, size);
+        front = front.subarray(size);
+        if (startup) {
+          startup = false;
+        } else if (frame[0] === 80) {
+          const name = text(frame, 5);
+          query = text(frame, 6 + Buffer.byteLength(name));
+          statements.set(name, query);
+        } else if (frame[0] === 66) {
+          const portal = text(frame, 5);
+          query = statements.get(text(frame, 6 + Buffer.byteLength(portal))) ?? "";
+        } else if (frame[0] === 81) {
+          requests.push(record(text(frame, 5)));
+          query = "";
+        } else if (frame[0] === 83) {
+          requests.push(record(query));
+          query = "";
+        }
+      }
+    },
+  };
+};
