+++ b/e2e/support/sql-wire-cohorts.ts
@@ -0,0 +1,113 @@
+import { Schema } from "effect";
+
+const Member = Schema.Struct({ id: Schema.String, contains: Schema.String });
+const Cohort = Schema.Struct({ id: Schema.String, members: Schema.Array(Member) });
+const Arm = Schema.Struct({ trace: Schema.String, cohorts: Schema.Array(Cohort) });
+const Select = Schema.Struct({ id: Schema.String });
+
+export const poolViewCohorts = [
+  {
+    id: "authority-and-links",
+    members: [
+      { id: "membership", contains: "select id, role from member" },
+      { id: "links", contains: "select l.app, l.account, l.requirement, l.subject" },
+    ],
+  },
+  {
+    id: "metadata-and-policies",
+    members: [
+      { id: "apps", contains: 'WHERE ("executor_apps"."owner" = $1 AND "executor_apps"."id" = ANY' },
+      { id: "app-policy", contains: "select p.id as app, p.creator_id as creator" },
+      { id: "account-policy", contains: "select p.account_id as account, p.creator_id as creator" },
+    ],
+  },
+  {
+    id: "presentation-facts",
+    members: [
+      { id: "services", contains: "select app.id as app," },
+      { id: "pools", contains: "select a.id as app from organization" },
+      { id: "groups", contains: "select gm.group_id as" },
+      { id: "observation-access", contains: "select account_id as account, read_audience as read" },
+      { id: "labels", contains: "select c.state::jsonb -> 'account' ->> 'id' as account" },
+    ],
+  },
+];
+
+/** A response stays held until every independently issued member is on the wire. */
+export const sqlWireCohorts = () => {
+  let trace: string | undefined;
+  let groups: {
+    id: string;
+    members: typeof Member.Type[];
+    arrived: Map<string, number>;
+    released: boolean;
+  }[] = [];
+  const listeners = new Set<() => void>();
+  const wake = () => {
+    for (const listener of [...listeners]) listener();
+  };
+  const receipt = (group: (typeof groups)[number]) => ({
+    id: group.id,
+    arrived: [...group.arrived.keys()],
+    cycles: [...group.arrived.values()],
+    missing: group.members.filter((member) => !group.arrived.has(member.id)).map((member) => member.id),
+    released: group.released,
+  });
+  return {
+    arrive: (owner: string | undefined, sql: string, cycle: number) => {
+      if (owner !== trace) return undefined;
+      for (const group of groups) {
+        if (group.released) continue;
+        const member = group.members.find((member) => sql.includes(member.contains));
+        if (member === undefined) continue;
+        if (group.arrived.has(member.id)) throw new Error(`Duplicate SQL cohort member ${group.id}/${member.id}`);
+        group.arrived.set(member.id, cycle);
+        wake();
+        return () => !group.released;
+      }
+      return undefined;
+    },
+    onRelease: (listener: () => void) => {
+      listeners.add(listener);
+      return () => listeners.delete(listener);
+    },
+    control: async (path: string, value: unknown) => {
+      if (path === "/cohorts/arm") {
+        const input = Schema.decodeUnknownSync(Arm)(value);
+        trace = input.trace;
+        groups = input.cohorts.map((group) => ({ ...group, members: [...group.members], arrived: new Map(), released: false }));
+        return groups.map(receipt);
+      }
+      const { id } = Schema.decodeUnknownSync(Select)(value);
+      const group = groups.find((group) => group.id === id);
+      if (group === undefined) throw new Error(`Unknown SQL cohort ${id}`);
+      if (path === "/cohorts/release") {
+        if (receipt(group).missing.length !== 0) throw new Error(`Incomplete SQL cohort ${id}`);
+        group.released = true;
+        wake();
+        return receipt(group);
+      }
+      if (path !== "/cohorts/wait") throw new Error("Unknown SQL cohort operation");
+      return await new Promise<ReturnType<typeof receipt>>((resolve) => {
+        const finish = () => {
+          clearTimeout(timer);
+          listeners.delete(changed);
+          resolve(receipt(group));
+        };
+        const changed = () => {
+          if (receipt(group).missing.length === 0) finish();
+        };
+        // Deadlock watchdog only. Successful proofs depend on arrivals, never elapsed time.
+        const timer = setTimeout(finish, 15_000);
+        listeners.add(changed);
+        changed();
+      });
+    },
+    reset: () => {
+      for (const group of groups) group.released = true;
+      wake();
+      groups = [];
+      trace = undefined;
+    },
+  };
+};
