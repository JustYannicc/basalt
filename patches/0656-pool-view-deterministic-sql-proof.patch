@@ -0,0 +1,31 @@
+import { Effect, FileSystem, Redacted, Schema } from "effect";
+import { cloudLocksFor } from "./cloud-locks.ts";
+import { Target } from "./platform.ts";
+
+/** Read-only foreign traffic crosses the same observer without triggering product setup jobs. */
+export const sqlWireNoise = (port: number) =>
+  Effect.gen(function* () {
+    const target = yield* Target,
+      fs = yield* FileSystem.FileSystem;
+    const config = yield* fs
+      .readFileString(`${target.directory}/sso-database.json`)
+      .pipe(
+        Effect.flatMap(
+          Schema.decodeUnknownEffect(
+            Schema.fromJsonString(
+              Schema.Struct({ database: Schema.RedactedFromValue(Schema.String) }),
+            ),
+          ),
+        ),
+      );
+    const url = new URL(Redacted.value(config.database));
+    url.port = String(port);
+    const path = `${target.directory}/wire-noise-database.json`;
+    yield* fs.writeFileString(path, JSON.stringify({ database: url.href }), { mode: 0o600 });
+    yield* Effect.addFinalizer(() => fs.remove(path, { force: true }).pipe(Effect.orDie));
+    const database = yield* cloudLocksFor(path);
+    return (trace: string, marker = "background") =>
+      database.run({
+        sql: `select 1 as background /*${marker}*/ /*traceparent='00-${trace}-${trace.slice(0, 16)}-01'*/`,
+      });
+  });
