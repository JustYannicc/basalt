--- /dev/null
+++ b/e2e/support/pool-account-view-query.ts
@@ -0,0 +1,64 @@
+import { expect } from "@effect/vitest";
+import { Effect, Fiber } from "effect";
+import { Actors } from "./actors.ts";
+import { Api } from "./api.ts";
+import { Browser } from "./browser.ts";
+import { Evidence } from "./evidence.ts";
+import { sqlWireProof } from "./sql-wire-proof.ts";
+import { randomUUID } from "node:crypto";
+
+/** Hold each real SQL cohort until all its members arrive, then add separately traced traffic. */
+export const readPoolAccountView = (
+  fresh: boolean,
+  trace: string,
+  wire: Effect.Success<typeof sqlWireProof>,
+) => Effect.gen(function* () {
+  const browser = yield* Browser, api = yield* Api, actors = yield* Actors, evidence = yield* Evidence;
+  yield* wire.arm(trace);
+    const pending = yield* browser.use("Read the shipped pool view with SQL latency", (page) =>
+            page.evaluate(
+              ({ trace, fresh }) => {
+                const context = JSON.parse(
+                  document.getElementById("executor-context")?.textContent ?? "{}",
+                );
+                const start = performance.now();
+                return fetch("/_executor/api/query", {
+                  method: "POST",
+                  headers: {
+                    "content-type": "application/json",
+                    traceparent: `00-${trace}-${trace.slice(0, 16)}-01`,
+                  },
+                  body: JSON.stringify({
+                    version: context.version ?? context.deployment,
+                    name: "view",
+                    input: { fresh },
+                  }),
+                }).then((response) =>
+                  response.json().then((body) => ({
+                    status: response.status,
+                    body,
+                    milliseconds: performance.now() - start,
+                    timing: response.headers.get("server-timing"),
+                  })),
+                );
+              },
+              { trace, fresh },
+            ),
+          ).pipe(Effect.forkChild);
+  for (const cohort of wire.cohorts) {
+    const arrived = yield* wire.wait(cohort.id);
+    yield* evidence.json(`${fresh ? "fresh" : "initial"}-${cohort.id}.json`, arrived);
+    expect(arrived.missing, `Parallel SQL cohort ${cohort.id} missing ${arrived.missing.join(", ")}; arrived ${arrived.arrived.join(", ")}`).toEqual([]);
+    expect(arrived.released).toBe(false);
+    expect(new Set(arrived.cycles).size).toBe(cohort.members.length);
+    const other = randomUUID().replaceAll("-", "");
+    for (let index = 0; index < 4; index++) {
+      const result = yield* api.request(actors.owner, "GET", "/api/viewer", undefined, {
+        traceparent: `00-${other}-${other.slice(0, 16)}-01`,
+      });
+      expect(result.status).toBe(200);
+    }
+    yield* wire.release(cohort.id);
+  }
+  return yield* Fiber.join(pending);
+});
