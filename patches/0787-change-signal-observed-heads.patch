+ * serves one set of server-scoped resources, so a resource `held` lacks is not one it missed.
+ * Revisions are decimal strings, compared the way app-data's `newerRevision` does.
+ */
+const provesBehind = (receipt: ChangeReceipt, held: ChangeReceipt, topics: readonly string[]) =>
+  receipt.revisions.some((hint) => {
