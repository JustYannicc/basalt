diff --git a/packages/ui/src/contracts/account-identities.ts b/packages/ui/src/contracts/account-identities.ts
new file mode 100644
index 00000000..614ea957
--- /dev/null
+++ b/packages/ui/src/contracts/account-identities.ts
@@ -0,0 +1,32 @@
+/** Group only verified identities already visible in the product's authorized inventory. */
+import type { AccountSummary, Inventory } from "./dashboard.ts";
+
+export interface AccountGroup {
+  readonly account: AccountSummary;
+  readonly bindings: readonly AccountSummary[];
+}
+
+export const accountGroups = (accounts: readonly AccountSummary[]): readonly AccountGroup[] => {
+  const groups = new Map<string, AccountSummary[]>();
+  for (const account of accounts) {
+    const key = account.identity?.id ?? account.id;
+    const group = groups.get(key);
+    if (group === undefined) groups.set(key, [account]);
+    else group.push(account);
+  }
+  return [...groups.values()].map((bindings) => {
+    const sorted = bindings.toSorted((a, b) => a.createdAt.getTime() - b.createdAt.getTime());
+    const account = sorted[0]!;
+    return { account, bindings: sorted };
+  });
+};
+
+/** App labels come from the visible inventory, never an identity-wide unfiltered count. */
+export const bindingApps = (inventory: Inventory, bindings: readonly AccountSummary[]) => {
+  const ids = new Set(bindings.map((account) => account.id));
+  return inventory.apps.filter((app) =>
+    [...inventory.links, ...(inventory.appLinks ?? [])].some(
+      (link) => link.app === app.id && ids.has(link.account),
+    ),
+  );
+};
diff --git a/packages/ui/src/contracts/identity-consent.ts b/packages/ui/src/contracts/identity-consent.ts
new file mode 100644
index 00000000..a3223cdf
--- /dev/null
+++ b/packages/ui/src/contracts/identity-consent.ts
@@ -0,0 +1,55 @@
+/** The browser proposes visible targets; each host creates and authorizes its own saved request. */
+import type {
+  AccountId,
+  AccountScope,
+  AppId,
+  OAuthConnectionPlan,
+  OAuthGrantReuseResult,
+  Provider,
+} from "@executor-js/sdk";
+import type { Exit } from "effect";
+import type { Inventory } from "./dashboard.ts";
+
+export interface IdentityAppTarget {
+  readonly app: AppId;
+  readonly requirement: string;
+  readonly scope: AccountScope;
+  readonly method: string;
+}
+export interface IdentityConsentSelection {
+  readonly sourceAccount?: AccountId | null | undefined;
+  readonly additionalTargets?: readonly IdentityAppTarget[] | undefined;
+}
+export interface IdentityConsentBindings<E> {
+  readonly plan: (
+    input: IdentityConsentSelection & { readonly method: string },
+  ) => Promise<Exit.Exit<OAuthConnectionPlan, E>>;
+  readonly reuse: (
+    input: IdentityConsentSelection & {
+      readonly method: string;
+      readonly sourceAccount: AccountId;
+    },
+  ) => Promise<Exit.Exit<typeof OAuthGrantReuseResult.Type, E>>;
+}
+
+export const identityAppTargets = (inventory: Inventory, issuer: string, exclude?: AppId) =>
+  inventory.apps.flatMap((app) =>
+    app.id === exclude
+      ? []
+      : Object.entries(app.requirements.accounts).flatMap(([requirement, target]) => {
+          if (target.definition.site !== undefined) return [];
+          const methods = Object.entries(target.definition.auth).filter(
+            ([, method]) =>
+              method.type === "oauth2" &&
+              method.grant !== "client_credentials" &&
+              method.identity?.issuer === issuer,
+          );
+          const method = methods[0]?.[0];
+          return method === undefined ? [] : [{ app, requirement, target, method }];
+        }),
+  );
+export const identityMethod = (provider: Provider, method: string) => {
+  if (provider.definition.site !== undefined) return undefined;
+  const auth = provider.definition.auth[method];
+  return auth?.type === "oauth2" && auth.grant !== "client_credentials" ? auth.identity : undefined;
+};
diff --git a/packages/ui/src/contracts/identity-requests.ts b/packages/ui/src/contracts/identity-requests.ts
new file mode 100644
index 00000000..21607e18
--- /dev/null
+++ b/packages/ui/src/contracts/identity-requests.ts
@@ -0,0 +1,38 @@
+/** Concurrent permission reads share the same independently created requests within one dialog. */
+import { Effect, Semaphore } from "effect";
+import type { AccountConnection } from "@executor-js/sdk";
+import type { IdentityAppTarget, IdentityConsentSelection } from "./identity-consent.ts";
+
+type Target = Omit<IdentityAppTarget, "method">;
+export const identityRequests = <E, R>(
+  primary: Target,
+  create: (target: Target) => Effect.Effect<AccountConnection, E, R>,
+) => {
+  const lock = Semaphore.makeUnsafe(1);
+  const requests = new Map<string, AccountConnection>();
+  const request = (target: Target) =>
+    lock.withPermits(1)(
+      Effect.gen(function* () {
+        const key = JSON.stringify([target.app, target.scope, target.requirement]);
+        const existing = requests.get(key);
+        if (existing !== undefined) return existing;
+        const saved = yield* create(target);
+        requests.set(key, saved);
+        return saved;
+      }),
+    );
+  return (selection: IdentityConsentSelection) =>
+    Effect.gen(function* () {
+      const connection = yield* request(primary);
+      const additionalConnections = yield* Effect.forEach(
+        selection.additionalTargets ?? [],
+        (target) =>
+          Effect.map(request(target), (saved) => ({ connection: saved.id, method: target.method })),
+      );
+      return {
+        connection: connection.id,
+        additionalConnections,
+        sourceAccount: selection.sourceAccount ?? null,
+      };
+    });
+};
