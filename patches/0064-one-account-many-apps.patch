new file mode 100644
index 00000000..4652af8c
--- /dev/null
+++ b/e2e/support/account-identity-issuer.ts
@@ -0,0 +1,191 @@
+/** An external OIDC issuer with rotating grants and stable subjects; all product state stays in the real server. */
+import { createServer } from "node:http";
+import { createHash, randomUUID } from "node:crypto";
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Deferred, Effect, Layer, Queue } from "effect";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+
+type Grant = { subject: string; scopes: string[]; client: string };
+type Code = Grant & { challenge: string; redirect: string };
+
+export const accountIdentityIssuer = Effect.gen(function* () {
+  const address = yield* Deferred.make<string>();
+  const revoked = yield* Queue.unbounded<void>();
+  let subject = "person-one";
+  let profileFails = false;
+  let denied = false;
+  let expiresIn = 3600;
+  let omitRefreshToken = false;
+  let confirmedScopes: string[] | undefined;
+  let authorizations = 0,
+    exchanges = 0,
+    refreshes = 0,
+    revocations = 0;
+  const codes = new Map<string, Code>();
+  const access = new Map<string, Grant>();
+  const refresh = new Map<string, Grant>();
+  const routes = Layer.mergeAll(
+    HttpRouter.add(
+      "GET",
+      "/.well-known/oauth-authorization-server",
+      Effect.gen(function* () {
+        const origin = yield* Deferred.await(address);
+        return yield* HttpServerResponse.json({
+          issuer: origin,
+          authorization_endpoint: origin + "/authorize",
+          token_endpoint: origin + "/token",
+          userinfo_endpoint: origin + "/userinfo",
+          revocation_endpoint: origin + "/revoke",
+          code_challenge_methods_supported: ["S256"],
+          token_endpoint_auth_methods_supported: ["none"],
+        });
+      }),
+    ),
+    HttpRouter.add(
+      "GET",
+      "/authorize",
+      Effect.gen(function* () {
+        const request = yield* HttpServerRequest.HttpServerRequest;
+        const params = new URL(request.url, "http://localhost").searchParams;
+        const redirect = params.get("redirect_uri"),
+          challenge = params.get("code_challenge"),
+          client = params.get("client_id");
+        if (
+          redirect === null ||
+          challenge === null ||
+          client === null ||
+          params.get("code_challenge_method") !== "S256"
+        )
+          return HttpServerResponse.empty({ status: 400 });
+        authorizations++;
+        const callback = new URL(redirect);
+        callback.searchParams.set("state", params.get("state") ?? "");
+        if (denied) callback.searchParams.set("error", "access_denied");
+        else {
+          const code = randomUUID();
+          codes.set(code, {
+            subject,
+            scopes: params.get("scope")?.split(" ").filter(Boolean) ?? [],
+            client,
+            redirect,
+            challenge,
+          });
+          callback.searchParams.set("code", code);
+        }
+        return HttpServerResponse.empty({ status: 302, headers: { location: callback.href } });
+      }),
+    ),
+    HttpRouter.add(
+      "POST",
+      "/token",
+      Effect.gen(function* () {
+        const request = yield* HttpServerRequest.HttpServerRequest;
+        const params = new URLSearchParams(yield* request.text);
+        const code = params.get("code"),
+          token = params.get("refresh_token");
+        const issued = code === null ? undefined : codes.get(code);
+        const renewal = token === null ? undefined : refresh.get(token);
+        const grant = issued ?? renewal;
+        const verifier = params.get("code_verifier");
+        if (
+          grant === undefined ||
+          params.get("client_id") !== grant.client ||
+          (issued !== undefined &&
+            (verifier === null ||
+              issued.redirect !== params.get("redirect_uri") ||
+              createHash("sha256").update(verifier).digest("base64url") !== issued.challenge))
+        )
+          return yield* HttpServerResponse.json({ error: "invalid_grant" }, { status: 400 });
+        if (issued !== undefined) {
+          codes.delete(code ?? "");
+          exchanges++;
+        } else {
+          refresh.delete(token ?? "");
+          refreshes++;
+        }
+        const saved = { ...grant, scopes: confirmedScopes ?? grant.scopes };
+        const accessToken = `synthetic-access-${randomUUID()}`,
+          refreshToken = `synthetic-refresh-${randomUUID()}`;
+        access.set(accessToken, saved);
+        const omitted = issued !== undefined && omitRefreshToken;
+        if (omitted) {
+          for (const [token, held] of refresh)
+            if (held.subject === saved.subject && held.client === saved.client)
+              refresh.set(token, saved);
+        } else refresh.set(refreshToken, saved);
+        return yield* HttpServerResponse.json({
+          access_token: accessToken,
+          ...(omitted ? {} : { refresh_token: refreshToken }),
+          token_type: "Bearer",
+          expires_in: issued === undefined ? 3600 : expiresIn,
+          scope: saved.scopes.join(" "),
+        });
+      }),
+    ),
+    HttpRouter.add(
+      "GET",
+      "/userinfo",
+      Effect.gen(function* () {
+        const request = yield* HttpServerRequest.HttpServerRequest;
+        const grant = access.get(request.headers.authorization?.replace(/^Bearer /, "") ?? "");
+        if (grant === undefined || profileFails) return HttpServerResponse.empty({ status: 401 });
+        // Deliberately identical email for different subjects: it cannot be a grouping key.
+        return yield* HttpServerResponse.json({ sub: grant.subject, email: "same@example.test" });
+      }),
+    ),
+    HttpRouter.add(
+      "GET",
+      "/resource",
+      Effect.gen(function* () {
+        const request = yield* HttpServerRequest.HttpServerRequest;
+        const grant = access.get(request.headers.authorization?.replace(/^Bearer /, "") ?? "");
+        if (grant === undefined) return HttpServerResponse.empty({ status: 401 });
+        return yield* HttpServerResponse.json({ subject: grant.subject, scopes: grant.scopes });
+      }),
+    ),
+    HttpRouter.add(
+      "POST",
+      "/revoke",
+      Effect.gen(function* () {
+        const request = yield* HttpServerRequest.HttpServerRequest;
+        const params = new URLSearchParams(yield* request.text);
+        const token = params.get("token") ?? "";
+        revocations++;
+        access.delete(token);
+        refresh.delete(token);
+        yield* Queue.offer(revoked, undefined);
+        return HttpServerResponse.empty({ status: 200 });
+      }),
+    ),
+  );
+  const serverLayer = NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 });
+  const services = yield* Layer.build(
+    HttpRouter.serve(routes).pipe(Layer.provideMerge(serverLayer)),
+  );
+  const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+  if (!("port" in server.address))
+    return yield* Effect.die("Identity fixture needs a TCP listener");
+  const origin = `http://127.0.0.1:${server.address.port}`;
+  yield* Deferred.succeed(address, origin);
+  return {
+    origin,
+    awaitRevocation: Queue.take(revoked),
+    configure: (input: {
+      subject?: string;
+      profileFails?: boolean;
+      denied?: boolean;
+      expiresIn?: number;
+      omitRefreshToken?: boolean;
+      scopes?: string[];
+    }) =>
+      Effect.sync(() => {
+        if (input.subject !== undefined) subject = input.subject;
+        if (input.profileFails !== undefined) profileFails = input.profileFails;
+        if (input.denied !== undefined) denied = input.denied;
+        if (input.expiresIn !== undefined) expiresIn = input.expiresIn;
+        if (input.omitRefreshToken !== undefined) omitRefreshToken = input.omitRefreshToken;
+        confirmedScopes = input.scopes;
+      }),
+    metrics: Effect.sync(() => ({ authorizations, exchanges, refreshes, revocations })),
+  };
+});
diff --git a/e2e/support/account-identity-product.ts b/e2e/support/account-identity-product.ts
new file mode 100644
index 00000000..d504b6a5
--- /dev/null
+++ b/e2e/support/account-identity-product.ts
@@ -0,0 +1,212 @@
+/** Public local APIs used by the identity scenarios, including the real OAuth callback and app invocation. */
+import { expect } from "@effect/vitest";
+import { Effect, Redacted, Schema } from "effect";
+import { FetchHttpClient, HttpClient } from "effect/http";
+import { Api, body, type Session } from "./api.ts";
+import { Target } from "./platform.ts";
+import { appsManifest } from "./apps-release.ts";
+
+export const IdentityAccount = Schema.Struct({
+  id: Schema.String,
+  provider: Schema.String,
+  identity: Schema.optionalKey(
+    Schema.Struct({ id: Schema.String, name: Schema.String, label: Schema.String }),
+  ),
+});
+const Resource = Schema.Struct({ id: Schema.String });
+const Published = Schema.Struct({ app: Resource });
+const Started = Schema.Struct({ authorizationUrl: Schema.String });
+
+export const accountIdentityProduct = Effect.gen(function* () {
+  const api = yield* Api,
+    target = yield* Target,
+    http = yield* HttpClient.HttpClient;
+  const raw = yield* api.session();
+  const headers = { authorization: `Bearer ${Redacted.value(target.apiKey)}` };
+  const agent: Session = {
+    ...raw,
+    send: (method, path, data, extra = {}) => {
+      const { origin: _origin, ...rest } = extra;
+      return raw.send(method, path, data, { ...rest, ...headers });
+    },
+  };
+  const apps: string[] = [],
+    accounts = new Set<string>();
+  yield* Effect.addFinalizer(() =>
+    Effect.gen(function* () {
+      for (const app of apps) yield* api.request(agent, "DELETE", `/v1/apps/${app}`);
+      for (const account of accounts)
+        yield* api.request(agent, "DELETE", `/v1/accounts/${account}`);
+    }).pipe(Effect.orDie),
+  );
+  const request = (method: "GET" | "POST" | "DELETE", path: string, data?: unknown) =>
+    api.request(agent, method, path, data);
+  const deploy = (
+    origin: string,
+    name: string,
+    scopes: string[],
+    extra: object = {},
+    existing?: string,
+  ) =>
+    Effect.gen(function* () {
+      const config = {
+        authorizationUrl: origin + "/authorize",
+        tokenUrl: origin + "/token",
+        revocationUrl: origin + "/revoke",
+        tokenEndpointAuthMethod: "none",
+        scopes,
+        identity: { issuer: origin, name: "Fixture identity" },
+        ...extra,
+      };
+      const response = yield* request("POST", "/v1/apps/deploy", {
+        owner: "local",
+        ...(existing === undefined ? { name } : { app: existing }),
+        files: [
+          appsManifest,
+          {
+            path: "index.ts",
+            content: `import { defineApp, defineProvider, oauth2, query, object, router } from "apps";
+const service = defineProvider({ name: ${JSON.stringify(name)}, auth: { oauth: oauth2(${JSON.stringify(config)}) }, async health({ account, fetch }) {
+  const response = await fetch(${JSON.stringify(origin + "/resource")}, { headers: { authorization: "Bearer " + account.fields.access_token } });
+  if (!response.ok) throw new Error("Fixture account refused");
+} });
+export default defineApp({ user: { accounts: { service } } }, async ({ user: { accounts } }) => ({ tools: router({
+  read: query({ input: object({}) }, async ({ fetch }) => await (await fetch(${JSON.stringify(origin + "/resource")}, { headers: { authorization: "Bearer " + accounts.service.fields.access_token } })).json()),
+}) }));`,
+          },
+        ],
+      });
+      expect(response.status, JSON.stringify(response.body)).toBe(200);
+      const { app } = yield* body(Published, response);
+      apps.push(app.id);
+      return app.id;
+    });
+  const connection = (app: string, account?: string) =>
+    Effect.gen(function* () {
+      const response = yield* request("POST", "/v1/account-connections", {
+        owner: "ignored-owner",
+        target: { app, requirement: "service" },
+        ...(account === undefined ? {} : { account }),
+      });
+      expect(response.status, JSON.stringify(response.body)).toBe(200);
+      return (yield* body(Resource, response)).id;
+    });
+  const authorize = (
+    connection: string,
+    selection: {
+      readonly clientId?: string;
+      readonly sourceAccount?: string | null;
+      readonly additionalConnections?: readonly {
+        readonly connection: string;
+        readonly method: string;
+      }[];
+    } = {},
+  ) =>
+    Effect.gen(function* () {
+      const started = yield* request("POST", "/v1/account-connections/oauth/start", {
+        connection,
+        method: "oauth",
+        redirectUri: target.metadata.origin + "/api/oauth/callback",
+        ...(selection.clientId !== undefined
+          ? { client: { clientId: selection.clientId } }
+          : selection.sourceAccount == null
+            ? { client: { clientId: "synthetic-client" } }
+            : {}),
+        ...(selection.sourceAccount === undefined
+          ? {}
+          : { sourceAccount: selection.sourceAccount }),
+        ...(selection.additionalConnections === undefined
+          ? {}
+          : { additionalConnections: selection.additionalConnections }),
+      });
+      expect(started.status, JSON.stringify(started.body)).toBe(200);
+      const { authorizationUrl } = yield* body(Started, started);
+      const callback = yield* Effect.scoped(
+        Effect.gen(function* () {
+          const response = yield* HttpClient.withScope(http).get(authorizationUrl);
+          expect(response.status).toBe(302);
+          const location = response.headers.location;
+          if (location === undefined) return yield* Effect.die("Issuer omitted callback");
+          return location;
+        }),
+      ).pipe(Effect.provideService(FetchHttpClient.RequestInit, { redirect: "manual" }));
+      return { callbackUrl: callback, authorizationUrl };
+    });
+  const complete = (connection: string, authorization: { readonly callbackUrl: string }) =>
+    Effect.gen(function* () {
+      const response = yield* request("POST", "/v1/account-connections/oauth/complete", {
+        connection,
+        callbackUrl: authorization.callbackUrl,
+      });
+      if (response.status === 200) accounts.add((yield* body(IdentityAccount, response)).id);
+      return response;
+    });
+  const consent = (connection: string, selection?: string | Parameters<typeof authorize>[1]) =>
+    Effect.gen(function* () {
+      const authorization = yield* authorize(
+        connection,
+        typeof selection === "string" ? { clientId: selection } : selection,
+      );
+      return yield* complete(connection, authorization);
+    });
+  const connect = (app: string, clientId?: string) =>
+    Effect.gen(function* () {
+      const pending = yield* connection(app);
+      const response = yield* consent(pending, clientId);
+      expect(response.status, JSON.stringify(response.body)).toBe(200);
+      const account = yield* body(IdentityAccount, response);
+      accounts.add(account.id);
+      return yield* body(IdentityAccount, yield* request("GET", `/v1/accounts/${account.id}`));
+    });
+  const reuseConnection = (
+    pending: string,
+    account: string,
+    additionalConnections?: readonly { readonly connection: string; readonly method: string }[],
+  ) =>
+    Effect.gen(function* () {
+      const response = yield* request("POST", "/v1/account-connections/oauth/reuse", {
+        connection: pending,
+        account,
+        method: "oauth",
+        ...(additionalConnections === undefined ? {} : { additionalConnections }),
+      });
+      expect(response.status, JSON.stringify(response.body)).toBe(200);
+      const result = yield* body(
+        Schema.Union([
+          Schema.Struct({ status: Schema.Literal("completed"), account: IdentityAccount }),
+          Schema.Struct({ status: Schema.Literal("consent-required"), reason: Schema.String }),
+        ]),
+        response,
+      );
+      if (result.status === "completed") accounts.add(result.account.id);
+      return result;
+    });
+  const reuse = (app: string, account: string) =>
+    Effect.flatMap(connection(app), (pending) => reuseConnection(pending, account));
+  const connectionAccount = (connection: string) =>
+    Effect.gen(function* () {
+      const response = yield* request("GET", `/v1/account-connections/${connection}`);
+      const completed = yield* body(
+        Schema.Struct({
+          state: Schema.Struct({ status: Schema.Literal("completed"), account: IdentityAccount }),
+        }),
+        response,
+      );
+      accounts.add(completed.state.account.id);
+      return completed.state.account;
+    });
+  return {
+    request,
+    deploy,
+    connection,
+    consent,
+    authorize,
+    complete,
+    connect,
+    reuse,
+    reuseConnection,
+    connectionAccount,
+    remove: (account: string) => request("DELETE", `/v1/accounts/${account}`),
+    read: (app: string) => request("POST", "/v1/tools/call", { app, tool: "read", input: {} }),
+  };
+});
