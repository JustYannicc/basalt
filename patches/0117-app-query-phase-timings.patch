diff --git a/apps/hosted/server/src/implementation/app-ui-query-timing.ts b/apps/hosted/server/src/implementation/app-ui-query-timing.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/server/src/implementation/app-ui-query-timing.ts
@@ -0,0 +1,25 @@
+import { Clock, Effect, Option } from "effect";
+
+type QueryPhase = "session_access" | "caller_accounts" | "dispatch";
+
+/** Annotate the request span captured before the operation opens any child spans. */
+export const queryPhase = <A, E, R>(phase: QueryPhase, operation: Effect.Effect<A, E, R>) =>
+  Effect.gen(function* () {
+    const span = yield* Effect.currentSpan.pipe(Effect.option);
+    if (Option.isNone(span)) return yield* operation;
+    const request = span.value;
+    const start = yield* Clock.currentTimeNanos;
+    return yield* operation.pipe(
+      Effect.onExit(() =>
+        Effect.gen(function* () {
+          const elapsed = Number((yield* Clock.currentTimeNanos) - start) / 1_000_000;
+          request.attribute(`app.ui.query.${phase}.duration_ms`, Math.max(0, elapsed));
+          const order = request.attributes.get("app.ui.query.phase_order");
+          request.attribute(
+            "app.ui.query.phase_order",
+            typeof order === "string" ? `${order},${phase}` : phase,
+          );
+        }),
+      ),
+    );
+  });
