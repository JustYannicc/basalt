+      onFocus={(event) => {
+        onFocus?.(event);
+        // Browsers leave a focused element where it is while any part of it shows, so arrowing
+        // onto a tab at the strip's edge would select it half hidden.
+        if (overflow === "scroll" && event.target instanceof HTMLElement)
+          event.target.scrollIntoView({ block: "nearest", inline: "nearest" });
+      }}
       {...props}
