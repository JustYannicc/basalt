new file mode 100644
index 0000000000000000000000000000000000000000..c68fa1e9768902152069118a70c9e4776c79c575
--- /dev/null
+++ b/e2e/support/cloud-app-listener-fixtures.ts
@@ -0,0 +1,33 @@
+import { Effect } from "effect";
+import { createServer } from "node:http";
+import { driver } from "./platform.ts";
+
+/** A real private HTTP destination bound from the runtime's configured app port. */
+export const appHttpBackend = (
+  environment: { readonly CLOUD_DEV_APP_UI_PORT: string },
+  body: string,
+) =>
+  Effect.gen(function* () {
+    const backend = yield* Effect.acquireRelease(
+      Effect.sync(() =>
+        createServer((request, response) => response.end(`${body} ${request.headers.host}`)),
+      ),
+      (server) =>
+        Effect.promise(() => new Promise<void>((resolve) => server.close(() => resolve()))),
+    );
+    const backendPort = yield* driver(
+      "bind app HTTP fixture",
+      () =>
+        new Promise<number>((resolve, reject) => {
+          backend.once("error", reject);
+          backend.listen(Number(environment.CLOUD_DEV_APP_UI_PORT), "127.0.0.1", () => {
+            backend.off("error", reject);
+            const address = backend.address();
+            if (address === null || typeof address === "string")
+              reject(new Error("No app fixture port"));
+            else resolve(address.port);
+          });
+        }),
+    );
+    return { url: new URL(`http://127.0.0.1:${backendPort}`) };
+  });
diff --git a/e2e/support/cloud-app-listener.ts b/e2e/support/cloud-app-listener.ts
new file mode 100644
index 0000000000000000000000000000000000000000..65c86e0312830fd05cb0525fb382ae4d980d0c7c
--- /dev/null
+++ b/e2e/support/cloud-app-listener.ts
@@ -0,0 +1,23 @@
+import { Effect } from "effect";
+import { cloudListener } from "./cloud-listener.ts";
+
+/** Keep app origins stable while Alchemy owns and replaces its private listener. */
+export const cloudAppListener = Effect.gen(function* () {
+  const listener = yield* cloudListener;
+  return {
+    ...listener,
+    environment: {
+      CLOUD_DEV_APP_UI_PORT: "0",
+      EXECUTOR_APP_UI_BASE_URL: listener.url.origin,
+    },
+    forward: (line: string) => {
+      // oxlint-disable-next-line no-control-regex -- Alchemy colors its resource announcements.
+      const plain = line.replace(/\u001b\[[0-9;]*m/g, "");
+      const match =
+        /^\s*\[AppPages\] Started in [^\n]* → (http:\/\/(?:localhost|127\.0\.0\.1):[0-9]+)\/?(?:\s|$)/u.exec(
+          plain,
+        );
+      return match === null ? Effect.void : listener.set(new URL(match[1]!));
+    },
+  };
+});
