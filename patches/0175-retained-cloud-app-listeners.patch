diff --git a/e2e/tests/cloud-app-listener.spec.ts b/e2e/tests/cloud-app-listener.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b4f617d312e89bde6375cc7aec3d33c8baff1e64
--- /dev/null
+++ b/e2e/tests/cloud-app-listener.spec.ts
@@ -0,0 +1,90 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect } from "effect";
+import { FetchHttpClient, HttpClient } from "effect/http";
+import { cloudAppListener } from "../support/cloud-app-listener.ts";
+import { appHttpBackend } from "../support/cloud-app-listener-fixtures.ts";
+import { freePort, holdPort } from "../support/ports.ts";
+
+layer(FetchHttpClient.layer, { excludeTestServices: true })("Cloud app listeners", (it) => {
+  it.effect("serves the held origin despite an occupied earlier allocation", () =>
+    Effect.gen(function* () {
+      const stalePort = yield* freePort;
+      yield* holdPort(stalePort);
+      const apps = yield* cloudAppListener;
+      const worker = yield* appHttpBackend(apps.environment, "app");
+      expect(Number(apps.url.port)).not.toBe(stalePort);
+      expect(Number(worker.url.port)).not.toBe(stalePort);
+      expect(Number(worker.url.port)).not.toBe(Number(apps.url.port));
+      const collision = yield* Effect.exit(Effect.scoped(holdPort(Number(apps.url.port))));
+      expect(collision._tag).toBe("Failure");
+      yield* apps.forward(`[AppPages] Started in 1ms → ${worker.url.origin}`);
+      const http = yield* HttpClient.HttpClient;
+      const response = yield* http.get(apps.environment.EXECUTOR_APP_UI_BASE_URL, {
+        headers: { Host: `example.${apps.url.host}`, Connection: "close" },
+      });
+      expect(response.status).toBe(200);
+      expect(yield* response.text).toBe(`app example.${apps.url.host}`);
+    }).pipe(Effect.scoped),
+  );
+
+  it.effect("ignores other resources and keeps distinct origins through preboot and restart", () =>
+    Effect.gen(function* () {
+      const http = yield* HttpClient.HttpClient;
+      const original = yield* cloudAppListener;
+      const changed = yield* cloudAppListener;
+      const first = yield* appHttpBackend(original.environment, "original");
+      const second = yield* appHttpBackend(changed.environment, "changed");
+      const restarted = yield* appHttpBackend(original.environment, "restarted");
+      expect(original.url.origin).not.toBe(changed.url.origin);
+      yield* original.forward(`\u001b[32m[AppPages] Started in 1ms → ${first.url.origin}\u001b[0m`);
+      yield* changed.forward(`[AppPages] Started in 1ms → ${second.url.origin}`);
+      for (const line of [
+        `[Api] Started in 1ms → ${second.url.origin}`,
+        `[AppPages] creating → ${second.url.origin}`,
+        `[Other] quoted [AppPages] Started in 1ms → ${second.url.origin}`,
+      ])
+        yield* original.forward(line);
+      const read = (origin: string) =>
+        http
+          .get(origin, { headers: { Connection: "close" } })
+          .pipe(Effect.flatMap((response) => response.text));
+      expect(yield* read(original.environment.EXECUTOR_APP_UI_BASE_URL)).toBe(
+        `original ${original.url.host}`,
+      );
+      expect(yield* read(changed.environment.EXECUTOR_APP_UI_BASE_URL)).toBe(
+        `changed ${changed.url.host}`,
+      );
+      yield* original.unset();
+      yield* original.forward(`[AppPages] Started in 1ms → ${restarted.url.origin}/`);
+      expect(yield* read(original.environment.EXECUTOR_APP_UI_BASE_URL)).toBe(
+        `restarted ${original.url.host}`,
+      );
+      expect(yield* read(changed.environment.EXECUTOR_APP_UI_BASE_URL)).toBe(
+        `changed ${changed.url.host}`,
+      );
+      yield* original.unset();
+      yield* original.forward(`[AppPages] Started in 1ms → ${first.url.origin}`);
+      expect(yield* read(original.environment.EXECUTOR_APP_UI_BASE_URL)).toBe(
+        `original ${original.url.host}`,
+      );
+    }).pipe(Effect.scoped),
+  );
+
+  for (const fail of [false, true]) {
+    it.effect(`releases the held origin on scope ${fail ? "failure" : "completion"}`, () =>
+      Effect.gen(function* () {
+        let port = 0;
+        const exit = yield* Effect.exit(
+          Effect.scoped(
+            Effect.gen(function* () {
+              port = Number((yield* cloudAppListener).url.port);
+              if (fail) return yield* Effect.fail("Synthetic later setup failure");
+            }),
+          ),
+        );
+        expect(exit._tag).toBe(fail ? "Failure" : "Success");
+        expect(yield* holdPort(port)).toBe(port);
+      }).pipe(Effect.scoped),
+    );
+  }
+});
