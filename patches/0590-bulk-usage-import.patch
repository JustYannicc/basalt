new file mode 100644
index 0000000..e6605d3
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-usage-bulk-import.ts
@@ -0,0 +1,109 @@
+import { AppId, StorageError } from "@executor-js/sdk/core";
+import { Clock, Config, Effect, Option, Redacted, Schema } from "effect";
+import { HttpServerRequest, HttpServerResponse } from "effect/http";
+import { SqlClient } from "effect/sql";
+import { Principal } from "../contracts/auth.ts";
+import { OrganizationForbidden, OrganizationId } from "../contracts/organization.ts";
+import { OrganizationTombstones } from "../contracts/organization-removal.ts";
+import {
+  PoolUsageBulkImportStatus,
+  type PoolUsageBulkImportInput,
+} from "../contracts/pool-usage-bulk-import.ts";
+import { PoolUsageImportRejected } from "../contracts/pool-usage-import.ts";
+import { PoolUsageUnavailable } from "../contracts/pool-usage.ts";
+import { lockOrganizationReadAccess } from "./organization-access-lock.ts";
+import { readPool, sendPoolCommandResponse } from "./pool-backend.ts";
+import { openEnvelope } from "./pool-token.ts";
+import { policyDatabase, requireAppAccessAs, resourceAuthority } from "./resource-policy.ts";
+
+const Refusal = Schema.Struct({
+  error: Schema.Literals(["invalid_query", "identity_conflict", "unauthorized"]),
+});
+
+export const importPoolUsageBulk = (app: AppId, input: PoolUsageBulkImportInput) =>
+  Effect.gen(function* () {
+    // Release the policy transaction before the backend can call admission on the same host.
+    const pool = yield* readPool(app, (current) =>
+      current.user !== current.owner
+        ? Effect.fail(new OrganizationForbidden())
+        : Effect.succeed(current),
+    );
+    if (pool === null) return yield* new OrganizationForbidden();
+    const response = yield* sendPoolCommandResponse("importUsageBulk", {
+      pool: pool.pool,
+      organization: pool.organization,
+      owner: pool.owner,
+      user: pool.user,
+      input,
+    });
+    if (response.status !== 200) {
+      const refused = Schema.decodeUnknownOption(Refusal)(response.body);
+      return yield* new PoolUsageImportRejected({
+        reason: Option.isSome(refused) ? refused.value.error : "unavailable",
+      });
+    }
+    return yield* Schema.decodeUnknownEffect(PoolUsageBulkImportStatus)(response.body);
+  }).pipe(
+    Effect.catchTags({
+      SqlError: () => new StorageError(),
+      SchemaError: () => new PoolUsageUnavailable(),
+    }),
+  );
+
+export const poolUsageImportAdmissionPath = "/api/internal/pool-usage-import-admission";
+const Admission = Schema.Struct({
+  action: Schema.Literal("usageImportAdmission"),
+  pool: AppId,
+  organization: OrganizationId,
+  owner: Principal.fields.userId,
+  job: Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/u)),
+  at: Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)),
+  expiresAt: Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)),
+});
+const Owner = Schema.Struct({ owner: Principal.fields.userId });
+const admissionResponse = (status: 204 | 403 | 503) =>
+  HttpServerResponse.empty({ status, headers: { "cache-control": "no-store" } });
+
+/** Each chunk asks again; a signed request never replaces current product authority. */
+export const readPoolUsageImportAdmission = Effect.gen(function* () {
+  const key = yield* Config.Redacted("POOL_APP_SIGNING_KEY").pipe(Config.option);
+  if (Option.isNone(key)) return admissionResponse(503);
+  const body = yield* HttpServerRequest.schemaBodyJson(
+    Schema.Struct({ envelope: Schema.NonEmptyString }),
+  ).pipe(Effect.option);
+  if (Option.isNone(body)) return admissionResponse(403);
+  const raw = yield* Effect.tryPromise(() =>
+    openEnvelope(Redacted.value(key.value), "sbq1", body.value.envelope),
+  );
+  const decoded = Schema.decodeUnknownOption(Admission)(raw);
+  if (Option.isNone(decoded)) return admissionResponse(403);
+  const value = decoded.value;
+  const now = yield* Clock.currentTimeMillis;
+  if (value.at > now || value.expiresAt <= now || value.expiresAt - value.at > 30_000)
+    return admissionResponse(403);
+  const removed = yield* OrganizationTombstones;
+  if (yield* removed(value.organization)) return admissionResponse(403);
+  const sql = yield* policyDatabase;
+  const allowed = yield* sql.withTransaction(
+    Effect.gen(function* () {
+      yield* lockOrganizationReadAccess(value.organization).pipe(
+        Effect.provideService(SqlClient.SqlClient, sql),
+      );
+      const actor = yield* resourceAuthority(value.organization, value.owner);
+      yield* requireAppAccessAs(actor, value.pool, "manage");
+      const rows = yield* sql`select coalesce(entry.value ->> 'owner', entry.key) as owner
+          from organization o
+          cross join lateral jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) entry
+          join executor_apps app on app.id = entry.value ->> 'app' and app.owner = 'organization:' || o.id
+          where o.id = ${value.organization} and app.id = ${value.pool}`;
+      const found = yield* Schema.decodeUnknownEffect(Schema.Array(Owner))(rows);
+      return found.length === 1 && found[0]?.owner === value.owner;
+    }),
+  );
+  const checkedAt = yield* Clock.currentTimeMillis;
+  return admissionResponse(allowed && value.expiresAt > checkedAt ? 204 : 403);
+}).pipe(
+  Effect.timeout("5 seconds"),
+  Effect.catchTag("OrganizationForbidden", () => Effect.succeed(admissionResponse(403))),
+  Effect.catch(() => Effect.succeed(admissionResponse(503))),
+);
