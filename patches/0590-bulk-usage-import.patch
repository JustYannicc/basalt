+            sql: `update organization set metadata=jsonb_set(metadata::jsonb,array['basaltPools',$1,'owner'],to_jsonb($2::text))::text where id=$3 returning metadata::jsonb #>> array['basaltPools',$1,'owner'] as owner`,
+            params: [viewer.userId, admin.userId, actors.organization.id],
