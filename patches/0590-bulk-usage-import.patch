@@ -0,0 +1,81 @@
+import { Schema } from "effect";
+
+const count = Schema.Int.check(Schema.isGreaterThanOrEqualTo(0));
+const hash = Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/u));
+const label = Schema.NonEmptyString.check(Schema.isMaxLength(256));
+const job = { job: hash };
+const chunkBytes = 8 * 1024 * 1024;
+
+export const PoolUsageBulkImportInput = Schema.Union([
+  Schema.Struct({
+    operation: Schema.Literal("begin"),
+    manifest: Schema.Struct({
+      version: Schema.Literal(1),
+      source: Schema.String.check(
+        Schema.isPattern(/^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/u),
+      ),
+      sourceHash: hash,
+      approvedManifestSha256: hash,
+      accountMappingDigest: hash,
+      totalRows: count,
+      chunks: Schema.Array(
+        Schema.Struct({
+          sha256: hash,
+          idsSha256: hash,
+          rows: count.check(Schema.isLessThanOrEqualTo(5000)),
+          bytes: count.check(Schema.isLessThanOrEqualTo(chunkBytes)),
+        }),
+      ),
+    }),
+    accountMappings: Schema.Array(
+      Schema.Struct({
+        sourceAccountRef: hash,
+        targetAccountId: label,
+        provider: label,
+      }),
+    ).check(Schema.isMaxLength(500)),
+  }),
+  Schema.Struct({
+    operation: Schema.Literal("upload"),
+    ...job,
+    chunk: count,
+    data: Schema.String.check(Schema.isMaxLength(chunkBytes)),
+  }),
+  Schema.Struct({
+    operation: Schema.Literal("approve"),
+    ...job,
+    manifestDigest: hash,
+    accountMappingDigest: hash,
+  }),
+  Schema.Struct({
+    operation: Schema.Literal("guard"),
+    ...job,
+    observation: Schema.Struct({
+      observedAt: count,
+      expiresAt: count,
+      ready: Schema.Boolean,
+      cpu: Schema.Finite.check(Schema.isGreaterThanOrEqualTo(0)),
+      poolErrors: count,
+      queryErrors: count,
+    }),
+  }),
+  Schema.Struct({ operation: Schema.Literal("status"), ...job }),
+  Schema.Struct({ operation: Schema.Literal("pause"), ...job }),
+  Schema.Struct({ operation: Schema.Literal("resume"), ...job }),
+]);
+export type PoolUsageBulkImportInput = typeof PoolUsageBulkImportInput.Type;
+
+export const PoolUsageBulkImportStatus = Schema.Struct({
+  job: hash,
+  state: Schema.String,
+  manifestDigest: hash,
+  accountMappingDigest: hash,
+  totalRows: count,
+  totalChunks: count,
+  uploadedChunks: count,
+  committedChunks: count,
+  inserted: count,
+  existing: count,
+  reason: Schema.NullOr(Schema.String),
+});
+export type PoolUsageBulkImportStatus = typeof PoolUsageBulkImportStatus.Type;
