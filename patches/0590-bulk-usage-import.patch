+        const callback = yield* api.session();
+        const admissionPath = "/api/internal/pool-usage-import-admission";
+        const signedAdmission = (assertion: Record<string, unknown>) => {
+          const payload = `sbq1.${Buffer.from(JSON.stringify(assertion)).toString("base64url")}`;
+          const signature = createHmac("sha256", Buffer.from("ab".repeat(32), "hex"))
+            .update(payload)
+            .digest("base64url");
+          return { envelope: `${payload}.${signature}` };
+        };
+        const admissionAt = yield* Clock.currentTimeMillis;
