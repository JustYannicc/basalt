+import { AccountId, StorageError, type AppId, type Executor } from "@executor-js/sdk/core";
+import { Effect, Schema } from "effect";
+import {
+  HostedRoutesConfiguration,
+  hostedRoutesMethod,
+  hostedRoutesRequirement,
+} from "../contracts/hosted-routes.ts";
+import { organizationOwner } from "../contracts/organization.ts";
+import { lockedChange, provisionAccountLink } from "./app-accounts.ts";
+import { ensureHostedRoutesAccount, isHostedRoutesApp } from "./hosted-routes-accounts.ts";
+
+const Retained = Schema.Struct({ account: AccountId });
+
+// Acquisition stays unavailable. Only the host's retained mapping can authorize restoration.
+export const restoreHostedRoutesLink = (
+  executor: Executor,
+  input: { readonly app: AppId; readonly requirement: string; readonly account: AccountId },
+) =>
+  Effect.gen(function* () {
+    const configuration = yield* HostedRoutesConfiguration;
+    const identity = configuration?.identity;
+    if (
+      input.requirement !== hostedRoutesRequirement ||
+      configuration === undefined ||
+      identity === undefined ||
+      !configuration.enabled
+    )
+      return undefined;
+
+    return yield* lockedChange(
+      executor,
+      { app: input.app, account: input.account, access: "use" },
+      (sql, actor) =>
+        Effect.gen(function* () {
+          const app = yield* executor.apps.get({
+            owner: organizationOwner(actor.organization),
+            app: input.app,
+          });
+          if (!isHostedRoutesApp(app, configuration)) return undefined;
+          const rows = yield* sql`
+          select mapping.account_id as account
+          from basalt_hosted_routes_accounts mapping
+          join executor_accounts account on account.id = mapping.account_id
+            and account.owner = ${organizationOwner(actor.organization)}
+          join hosted_account_access access on access.account_id = account.id
+          where mapping.app = ${app.id} and mapping.organization = ${actor.organization}
+            and mapping.user_id = ${actor.user} and mapping.account_id = ${input.account}
+            and mapping.state in ('linked', 'retired')
+            and account.provider = ${identity.provider} and account.method = ${hostedRoutesMethod}
+            and access.organization_id = ${actor.organization} and access.kind = 'personal'
+            and access.personal_user_id = ${actor.user}
+          for update of mapping`;
+          const retained = yield* Schema.decodeUnknownEffect(Schema.Array(Retained))(rows);
+          if (retained.length !== 1 || retained[0] === undefined) return undefined;
+          const changed = yield* provisionAccountLink(sql, executor.webhooks, {
+            app: app.id,
+            requirement: hostedRoutesRequirement,
+            account: retained[0].account,
+            subject: actor.user,
+            linkedBy: actor.user,
+          });
+          const restored = yield* ensureHostedRoutesAccount(executor, sql, {
+            organization: actor.organization,
+            user: actor.user,
+            app,
+          });
+          if (restored !== retained[0].account) return yield* new StorageError();
+          return changed;
+        }),
+    );
+  }).pipe(
+    Effect.catchTags({
+      SqlError: () => new StorageError(),
+      SchemaError: () => new StorageError(),
+    }),
+  );
