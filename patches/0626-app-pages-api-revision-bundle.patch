@@ -0,0 +1,16 @@
+import * as BrowserCrypto from "@effect/platform-browser/BrowserCrypto";
+import { hostedApiRevision } from "@executor-js/hosted-server";
+import { Effect } from "effect";
+import { servesBuiltApiDocument } from "../contracts/browser.ts";
+import api from "../../.generated/executor-api-revision.json" with { type: "json" };
+
+/** Origins with different session cookies retain their exact served document's hash. */
+export const cloudApiRevision = (origin: string | undefined) =>
+  origin === undefined || servesBuiltApiDocument(origin)
+    ? Effect.succeed(api.revision)
+    : Effect.promise(() => import("../contracts/api.ts")).pipe(
+        Effect.flatMap(({ executorCloudApiDocument }) =>
+          hostedApiRevision(JSON.stringify(executorCloudApiDocument(origin))),
+        ),
+        Effect.provide(BrowserCrypto.layer),
+      );
