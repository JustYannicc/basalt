diff --git a/apps/hosted/cloud/src/infrastructure/production-ops/retained-frameworks-records.ts b/apps/hosted/cloud/src/infrastructure/production-ops/retained-frameworks-records.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/production-ops/retained-frameworks-records.ts
@@ -0,0 +1,81 @@
+import { Deferred, Effect } from "effect";
+import { ProductionOperationRefused } from "./contracts.ts";
+import {
+  retainedFrameworkReadBounds,
+  retryRetainedFrameworkRead,
+  type RetainedFrameworkReadProgress,
+} from "./retained-frameworks-read.ts";
+import type { RetainedFrameworkObjects } from "./retained-frameworks.ts";
+
+/** Reservations bound concurrent buffers; a failed attempt keeps its whole debit. */
+export const retainedFrameworkRecordReader = (
+  progress: RetainedFrameworkReadProgress,
+  objects: RetainedFrameworkObjects,
+  bounds: { readonly objectBytes: number; readonly totalBytes: number },
+) =>
+  Effect.gen(function* () {
+    let bytes = 0;
+    let active = 0;
+    let changed = yield* Deferred.make<void>();
+    const refused = (reason: string) =>
+      Effect.fail(new ProductionOperationRefused({ message: `Retained frameworks: ${reason}` }));
+    const reserve = Effect.gen(function* () {
+      for (;;) {
+        const max = Math.min(bounds.objectBytes, bounds.totalBytes - bytes);
+        if (active > 0 && max < bounds.objectBytes) {
+          // Another successful read can refund its unused allowance. Do not mistake its
+          // in-flight reservation for a permanent byte limit on this record.
+          yield* Deferred.await(changed);
+          continue;
+        }
+        if (max <= 0) return yield* refused("total byte bound");
+        bytes += max;
+        active++;
+        return max;
+      }
+    });
+    const release = Effect.gen(function* () {
+      const next = yield* Deferred.make<void>();
+      active--;
+      const previous = changed;
+      changed = next;
+      yield* Deferred.succeed(previous, undefined);
+    });
+    return (key: string) => {
+      const position = {
+        objectClass: key.endsWith("/worker.json")
+          ? ("split_record" as const)
+          : ("legacy_record" as const),
+        readPhase: "read" as const,
+      };
+      const capture = Effect.sync(() => {
+        // Peer cancellation must not replace the position that produced the refusal.
+        progress.refusalPosition ??= position;
+      });
+      return retryRetainedFrameworkRead(
+        Effect.acquireUseRelease(
+          Effect.interruptible(reserve),
+          (max) =>
+            Effect.gen(function* () {
+              progress.work.recordAttempts++;
+              const body = yield* objects
+                .read(key, max)
+                .pipe(Effect.timeout(retainedFrameworkReadBounds.attemptMs));
+              if (body !== null) {
+                if (body.byteLength > max) return yield* refused("byte bound");
+                bytes -= max - body.byteLength;
+              } else {
+                bytes -= max;
+              }
+              return body;
+            }),
+          () => release,
+        ),
+      ).pipe(
+        Effect.tapError((error) =>
+          error instanceof ProductionOperationRefused ? capture : Effect.void,
+        ),
+        Effect.onInterrupt(() => capture),
+      );
+    };
+  });
