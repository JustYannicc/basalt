+/** Logins a release opens alongside the running pool, each bounded by its own client limit. */
+const releaseLogins = {
+  productMigration: 1,
+  betterAuthMigration: 2,
+  poolProvisioning: 2,
+  toolsVerifier: 1,
+  poolVerifier: 1,
 } as const;
+
+/**
+ * One local transaction pooler fronts both logical databases, and its limits apply to each database
+ * across every runtime login. Release preflight, this budget and its verifier all derive from this
+ * plan. When production's real `max_connections` differs from its declaration the release refuses,
+ * so raising the provider limit and raising the budget happen together.
+ */
+export const databaseConnectionPlan = {
+  /** The production branch; the margin keeps a release admissible while the pool is fully busy. */
+  production: { maxConnections: 50, margin: 4 },
+  /** PlanetScale's default; a preview branch's budget follows the limit it actually reports. */
+  preview: { maxConnections: 25, margin: 0 },
+  superuserReservedConnections: 3,
+  reservedConnections: 0,
+  logicalDatabases: 2,
+  /**
+   * Connections outside PgBouncer at steady state, such as provider monitoring. A release saw 13
+   * in use with at most 10 pooled, so at least 3; the production margin covers a few more.
+   */
+  unpooledConnections: 4,
+  releaseLogins,
+  releaseConnections: Object.values(releaseLogins).reduce((sum, logins) => sum + logins, 0),
+} as const;
+
+export function databaseBackendBudgetFor(target: { maxConnections: number; margin: number }) {
+  const plan = databaseConnectionPlan;
+  const available =
+    target.maxConnections -
+    plan.superuserReservedConnections -
+    plan.reservedConnections -
+    plan.unpooledConnections -
+    plan.releaseConnections -
+    target.margin;
+  const budget = Math.floor(available / plan.logicalDatabases);
+  if (!Number.isSafeInteger(budget) || budget < 1)
+    throw new Error(
+      `No PgBouncer backend budget fits max_connections ${target.maxConnections}: ` +
+        `${available} connections remain for ${plan.logicalDatabases} databases`,
+    );
+  return budget;
+}
+
+export const databaseBackendBudget = databaseBackendBudgetFor(databaseConnectionPlan.production);
+export const previewDatabaseBackendBudget = databaseBackendBudgetFor(
+  databaseConnectionPlan.preview,
+);
+export const retirement = { lifetimeSeconds: 60, idleSeconds: 15, verificationMs: 90_000 } as const;
+export function databasePoolParametersFor(budget: number) {
+  return {
+    default_pool_size: String(budget),
+    max_db_connections: String(budget),
+    min_pool_size: "0",
+    reserve_pool_size: "0",
+    server_lifetime: String(retirement.lifetimeSeconds),
+    server_idle_timeout: String(retirement.idleSeconds),
+  } as const;
+}
+export const databasePoolParameters = databasePoolParametersFor(databaseBackendBudget);
