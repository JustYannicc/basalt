diff --git a/apps/hosted/cloud/src/infrastructure/release-command-attempt.ts b/apps/hosted/cloud/src/infrastructure/release-command-attempt.ts
new file mode 100644
index 000000000..15fccc74c
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/release-command-attempt.ts
@@ -0,0 +1,17 @@
+import { Effect } from "effect";
+
+/** Config reads during Worker initialization become bindings; attempt identity belongs only to release Commands. */
+export const releaseCommandAttempt = Effect.sync(() => {
+  if (globalThis.__ALCHEMY_RUNTIME__) return "";
+  const attempt = process.env.BASALT_RELEASE_ATTEMPT ?? "";
+  if (attempt && !/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/.test(attempt))
+    throw new Error("Invalid release Command attempt identity");
+  return attempt;
+});
+
+export const requiredReleaseCommandAttempt = releaseCommandAttempt.pipe(
+  Effect.map((attempt) => {
+    if (!attempt) throw new Error("Release Command attempt identity is missing");
+    return attempt;
+  }),
+);
