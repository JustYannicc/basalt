diff --git a/e2e/tests/pool-app-removal.spec.ts b/e2e/tests/pool-app-removal.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/pool-app-removal.spec.ts
@@ -0,0 +1,123 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schedule, Schema } from "effect";
+import { HttpClient, HttpBody } from "effect/http";
+import { Api, body } from "../support/api.ts";
+import { Actors } from "../support/actors.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { Evidence } from "../support/evidence.ts";
+import { RuntimeLive, Target } from "../support/platform.ts";
+import { scenarios } from "../test-plan.ts";
+
+const App = Schema.Struct({ id: Schema.String });
+const Account = Schema.Struct({ account: Schema.Struct({ id: Schema.String }) });
+class StillListed extends Schema.TaggedError<StillListed>()("StillListed", {}) {}
+
+layer(RuntimeLive, { excludeTestServices: true })("Pool app removal", (it) => {
+  it.effect(scenarios.cloudPoolAppRemovalFailure.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          evidence = yield* Evidence;
+        const target = yield* Target,
+          http = yield* HttpClient.HttpClient;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const created = yield* api.request(actors.owner, "POST", `${prefix}/pools`, {
+          name: "Removal recovery pool",
+          requestId: crypto.randomUUID(),
+          newInstance: true,
+        });
+        expect(created.status, JSON.stringify(created.body)).toBe(200);
+        const app = yield* body(App, created);
+        const refuse = (refused: boolean) =>
+          Effect.scoped(
+            http
+              .post(`${target.metadata.origin}/native-provider-fixture/membership-refusal`, {
+                body: HttpBody.jsonUnsafe({ pool: app.id, refused }),
+              })
+              .pipe(Effect.tap((response) => Effect.sync(() => expect(response.status).toBe(200)))),
+          );
+        yield* Effect.addFinalizer(() => refuse(false).pipe(Effect.orDie));
+        const path = `${prefix}/apps/${app.id}`;
+        const choices = () =>
+          api
+            .request(actors.owner, "GET", `${path}/accounts/app/pool`)
+            .pipe(
+              Effect.flatMap((response) =>
+                body(Schema.Struct({ accounts: Schema.Array(Account) }), response),
+              ),
+            );
+        const accounts = yield* choices();
+        expect(accounts.accounts.length).toBeGreaterThan(0);
+        yield* refuse(true);
+        const refused = yield* api.request(actors.owner, "DELETE", path);
+        yield* evidence.json("pool-delete-refused.json", {
+          status: refused.status,
+          body: refused.body,
+        });
+        const observed = yield* Effect.scoped(
+          http.get(`${target.metadata.origin}/native-provider-fixture/backend-events`).pipe(
+            Effect.flatMap((response) => response.json),
+            Effect.flatMap(
+              Schema.decodeUnknownEffect(
+                Schema.Array(
+                  Schema.Struct({
+                    action: Schema.String,
+                    pool: Schema.optionalKey(Schema.String),
+                    refused: Schema.Boolean,
+                  }),
+                ),
+              ),
+            ),
+          ),
+        );
+        expect(
+          observed.some(
+            (event) => event.action === "membership" && event.pool === app.id && event.refused,
+          ),
+        ).toBe(true);
+        expect(refused.status, JSON.stringify(refused.body)).toBe(503);
+        expect(refused.body).toMatchObject({ _tag: "AppRemovalUnavailable", app: app.id });
+        expect((yield* api.request(actors.owner, "GET", path)).status).toBe(200);
+        expect(yield* choices()).toEqual(accounts);
+        yield* refuse(false);
+        const removed = yield* api.request(actors.owner, "DELETE", path);
+        expect(removed.status, JSON.stringify(removed.body)).toBe(200);
+        expect((yield* api.request(actors.owner, "GET", path)).status).toBe(403);
+        const remaining = yield* body(
+          Schema.Array(App),
+          yield* api.request(actors.owner, "GET", `${prefix}/apps`),
+        );
+        expect(remaining.some((entry) => entry.id === app.id)).toBe(false);
+        for (const entry of accounts.accounts) {
+          expect(
+            (yield* api.request(actors.owner, "GET", `${prefix}/accounts/${entry.account.id}`))
+              .status,
+          ).toBe(200);
+        }
+        const deletion = yield* api.request(actors.owner, "DELETE", prefix);
+        expect(deletion.status, JSON.stringify(deletion.body)).toBe(200);
+        expect((yield* api.request(actors.owner, "GET", `${prefix}/access`)).status).toBe(403);
+        expect((yield* api.request(actors.owner, "GET", path)).status).toBe(403);
+        yield* api.request(actors.owner, "GET", "/api/auth/organization/list").pipe(
+          Effect.flatMap((response) =>
+            body(Schema.Array(Schema.Struct({ id: Schema.String })), response),
+          ),
+          Effect.flatMap((remaining) =>
+            remaining.some((org) => org.id === actors.organization.id)
+              ? Effect.fail(new StillListed())
+              : Effect.void,
+          ),
+          Effect.retry({ while: Schema.is(StillListed), schedule: Schedule.spaced("250 millis") }),
+          Effect.timeout("20 seconds"),
+        );
+        yield* evidence.json("pool-delete-recovered.json", {
+          app: app.id,
+          accountsPreserved: true,
+          organizationGone: true,
+        });
+      }),
+    ),
+  );
+});
