diff --git a/apps/hosted/server/src/implementation/pool-membership-hook.ts b/apps/hosted/server/src/implementation/pool-membership-hook.ts
new file mode 100644
index 0000000..ff2ab01
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-membership-hook.ts
@@ -0,0 +1,51 @@
+import { AppId, StorageError } from "@executor-js/sdk/core";
+import { Clock, Effect, Option, Redacted, Schema } from "effect";
+import { FetchHttpClient, HttpBody, HttpClient } from "effect/http";
+import { SqlClient } from "effect/sql";
+import { withOrganizationAccessLock } from "./organization-access-lock.ts";
+import { signEnvelope } from "./pool-token.ts";
+
+const Pool = Schema.Struct({ pool: AppId, organization: Schema.String });
+export const poolMembershipPath = "/pool/v1/membership";
+export const poolMembershipPrefix = "sbm1";
+
+/** Mark use unavailable before the native write commits. The receiver pulls committed links. */
+export const invalidatePoolMemberships = (
+  key: Option.Option<Redacted.Redacted<string>>,
+  origin: string,
+  input: { readonly organization?: string; readonly apps?: readonly AppId[] },
+) =>
+  Effect.gen(function* () {
+    if (input.apps?.length === 0) return;
+    const sql = yield* SqlClient.SqlClient;
+    const rows = yield* sql`select app.id as pool, o.id as organization from organization o
+      cross join lateral jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) entry
+      join executor_apps app on app.id = entry.value ->> 'app' and app.owner = 'organization:' || o.id
+      where entry.value ->> 'membership' = 'executor-links-v1'
+        ${input.organization === undefined ? sql`` : sql`and o.id = ${input.organization}`}
+        ${input.apps === undefined ? sql`` : sql`and ${sql.in("app.id", input.apps)}`}
+      order by o.id, app.id`;
+    const pools = yield* Schema.decodeUnknownEffect(Schema.Array(Pool))(rows);
+    if (pools.length === 0) return;
+    if (Option.isNone(key)) return yield* new StorageError();
+    const secret = Redacted.value(key.value);
+    for (const pool of pools)
+      yield* withOrganizationAccessLock(
+        pool.organization,
+        Effect.gen(function* () {
+          const at = yield* Clock.currentTimeMillis;
+          const envelope = yield* Effect.tryPromise(() =>
+            signEnvelope(secret, poolMembershipPrefix, { ...pool, at, expiresAt: at + 30_000 }),
+          );
+          const client = yield* HttpClient.HttpClient;
+          const response = yield* client.post(new URL(poolMembershipPath, origin).href, {
+            body: HttpBody.jsonUnsafe({ envelope }),
+          });
+          if (response.status < 200 || response.status >= 300) return yield* new StorageError();
+        }),
+      );
+  }).pipe(
+    Effect.timeout("10 seconds"),
+    Effect.provide(FetchHttpClient.layer),
+    Effect.catch(() => new StorageError()),
+  );
diff --git a/apps/hosted/server/src/implementation/pool-membership.ts b/apps/hosted/server/src/implementation/pool-membership.ts
new file mode 100644
index 0000000..84b1527
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-membership.ts
@@ -0,0 +1,171 @@
+import {
+  AccountAcquisitionHost,
+  AccountId,
+  AppId,
+  OwnerId,
+  ProviderId,
+  StorageError,
+  StorageHost,
+  type Executor,
+} from "@executor-js/sdk/core";
+import { Clock, Config, Effect, Option, Redacted, Schema } from "effect";
+import { HttpServerRequest, HttpServerResponse } from "effect/http";
+import { SqlClient } from "effect/sql";
+import { HostedExecutor } from "../contracts/executor.ts";
+import { withOrganizationAccessLock } from "./organization-access-lock.ts";
+import { policyDatabase, usableAppLinks } from "./resource-policy.ts";
+import { openEnvelope } from "./pool-token.ts";
+
+const NativePoolAccountFields = {
+  account: AccountId,
+  requirement: Schema.String,
+  provider: ProviderId,
+  method: Schema.String,
+  generation: Schema.Int,
+  driver: Schema.NullOr(Schema.String),
+  driverRevision: Schema.NullOr(Schema.String),
+  bindingRevision: Schema.NullOr(Schema.String),
+};
+export const NativePoolAccount = Schema.Struct({
+  ...NativePoolAccountFields,
+  /** Opaque reference exposed only to the signed private pool reader. */
+  homeReference: Schema.NullOr(Schema.NonEmptyString),
+});
+const NativePoolAccountRow = Schema.Struct({
+  ...NativePoolAccountFields,
+  owner: OwnerId,
+  requirementScope: Schema.NullOr(Schema.String),
+  requirementProvider: Schema.NullOr(ProviderId),
+});
+
+const homeReference = (executor: Executor, row: typeof NativePoolAccountRow.Type) =>
+  Effect.gen(function* () {
+    if (row.driver !== "basalt-home" || row.driverRevision === null || row.bindingRevision === null)
+      return null;
+    const source = yield* executor[AccountAcquisitionHost]
+      .source({ account: row.account, owner: row.owner })
+      .pipe(
+        Effect.catchTags({
+          AccountAcquisitionUnavailable: () => Effect.succeed(undefined),
+          AccountNotFound: () => Effect.succeed(undefined),
+        }),
+      );
+    if (
+      source === undefined ||
+      source.hostReference === undefined ||
+      source.source.id !== "basalt-home" ||
+      source.source.version !== row.driverRevision
+    )
+      return null;
+    const matches = (binding: typeof source.binding) =>
+      binding.account === row.account &&
+      binding.owner === row.owner &&
+      binding.provider === row.provider &&
+      binding.method === row.method &&
+      binding.generation === row.generation &&
+      binding.driver === "basalt-home" &&
+      binding.driverRevision === row.driverRevision &&
+      binding.revision === row.bindingRevision &&
+      binding.removal === null;
+    if (!matches(source.binding)) return null;
+    const current = yield* source.current.pipe(
+      Effect.catchTags({
+        AccountAcquisitionUnavailable: () => Effect.succeed(undefined),
+        AccountNotFound: () => Effect.succeed(undefined),
+      }),
+    );
+    return current !== undefined && matches(current) ? Redacted.value(source.hostReference) : null;
+  });
+
+/** Host-only identity read. It returns no credentials, labels, personal identity or inferred bindings. */
+export const nativePoolMembership = (organization: string, pool: AppId, executor: Executor) =>
+  withOrganizationAccessLock(
+    organization,
+    Effect.gen(function* () {
+      const sql = yield* SqlClient.SqlClient;
+      const found = yield* sql`select app.id from organization o
+        cross join lateral jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) entry
+        join executor_apps app on app.id = entry.value ->> 'app'
+          and app.owner = 'organization:' || o.id
+        where o.id = ${organization} and app.id = ${pool}
+          and entry.value ->> 'membership' = 'executor-links-v1'`;
+      if (found.length === 0) return { pool, organization, native: false, accounts: [] };
+      const rows = yield* sql`select a.id as account, a.owner, l.requirement, a.provider, a.method,
+          a.credential_generation as generation,
+          (select driver from executor_account_acquisitions where account = a.id) as driver,
+          (select driver_revision from executor_account_acquisitions where account = a.id) as "driverRevision",
+          (select revision from executor_account_acquisitions where account = a.id) as "bindingRevision",
+          (select d.requirements::jsonb -> 'accounts' -> l.requirement ->> 'scope'
+            from executor_deployments d where d.id = app.active_deployment) as "requirementScope",
+          (select d.requirements::jsonb -> 'accounts' -> l.requirement ->> 'provider'
+            from executor_deployments d where d.id = app.active_deployment) as "requirementProvider"
+        from ${usableAppLinks(sql, [pool])}
+          and not exists (select 1 from executor_account_acquisitions retiring
+            where retiring.account = a.id and retiring.removal is not null)
+          and not exists (select 1 from executor_account_acquisitions stale
+            where stale.account = a.id and (stale.owner <> a.owner or stale.provider <> a.provider
+              or stale.method <> a.method or stale.generation <> a.credential_generation))
+        order by l.requirement, l.created_at, a.id`;
+      const linked = yield* Schema.decodeUnknownEffect(Schema.Array(NativePoolAccountRow))(rows);
+      const accounts = yield* Effect.forEach(linked, (row) =>
+        Effect.gen(function* () {
+          if (row.requirementScope !== "app" || row.requirementProvider !== row.provider)
+            return undefined;
+          const reference = yield* homeReference(executor, row);
+          return {
+            account: row.account,
+            requirement: row.requirement,
+            provider: row.provider,
+            method: row.method,
+            generation: row.generation,
+            driver: row.driver,
+            driverRevision: row.driverRevision,
+            bindingRevision: row.bindingRevision,
+            homeReference: reference,
+          };
+        }),
+      );
+      return {
+        pool,
+        organization,
+        native: true,
+        accounts: accounts.filter((row) => row !== undefined),
+      };
+    }),
+  ).pipe(
+    // Binding rechecks write through the ORM, so its tracked boundary must own the SQL lock.
+    executor[StorageHost].transaction,
+    Effect.catch(() => new StorageError()),
+  );
+
+export const poolMembershipReadPath = "/api/internal/pool-membership";
+const Read = Schema.Struct({
+  pool: AppId,
+  organization: Schema.NonEmptyString,
+  at: Schema.Finite,
+  expiresAt: Schema.Finite,
+});
+
+/** Only the signed host-to-host request reaches the private account identity read. */
+export const readNativePoolMembership = Effect.gen(function* () {
+  const key = yield* Config.Redacted("POOL_APP_SIGNING_KEY").pipe(Config.option);
+  if (Option.isNone(key)) return HttpServerResponse.empty({ status: 503 });
+  const body = yield* HttpServerRequest.schemaBodyJson(
+    Schema.Struct({ envelope: Schema.NonEmptyString }),
+  );
+  const raw = yield* Effect.tryPromise(() =>
+    openEnvelope(Redacted.value(key.value), "sbq1", body.envelope),
+  );
+  const value = yield* Schema.decodeUnknownEffect(Read)(raw);
+  const now = yield* Clock.currentTimeMillis;
+  if (value.at > now || value.expiresAt <= now || value.expiresAt > now + 30_000)
+    return HttpServerResponse.empty({ status: 401 });
+  const sql = yield* policyDatabase;
+  const executor = yield* Effect.flatten(HostedExecutor);
+  const membership = yield* nativePoolMembership(value.organization, value.pool, executor).pipe(
+    Effect.provideService(SqlClient.SqlClient, sql),
+  );
+  return yield* HttpServerResponse.json(membership, {
+    headers: { "cache-control": "no-store" },
+  });
+}).pipe(Effect.catch(() => Effect.succeed(HttpServerResponse.empty({ status: 503 }))));
