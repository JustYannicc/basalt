diff --git a/e2e/support/pool-overview-query-proof.ts b/e2e/support/pool-overview-query-proof.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/pool-overview-query-proof.ts
@@ -0,0 +1,60 @@
+import { Effect, FileSystem, Path, Schema } from "effect";
+import { Target } from "./platform.ts";
+
+const Statement = Schema.Struct({
+  trace: Schema.String,
+  membership: Schema.Boolean,
+  fingerprint: Schema.Boolean,
+});
+
+/** Count the real server's membership SQL per HTTP trace without retaining SQL or values. */
+export const poolOverviewQueryProof = Effect.gen(function* () {
+  const target = yield* Target,
+    fs = yield* FileSystem.FileSystem,
+    path = yield* Path.Path;
+  const entry = path.join(target.directory, "pool-overview-product.ts");
+  const measurement = path.join(target.directory, "pool-overview-statements.jsonl");
+  yield* fs.writeFileString(
+    entry,
+    `import * as Runtime from "@effect/platform-bun/BunRuntime";
+import { main } from "@executor-js/hosted-self-host/server";
+import { Effect } from "effect";
+import * as Statement from "effect/sql/Statement";
+import { appendFileSync, writeFileSync } from "node:fs";
+const measurement = ${JSON.stringify(measurement)};
+writeFileSync(measurement, "");
+const transformer: Statement.Transformer = (statement, _sql, _fiber, span) => Effect.sync(() => {
+  const [text] = statement.compile();
+  const membership = text.includes("current_database() as database,current_schema() as schema");
+  const fingerprint = text.includes('as "referenceDigest"') && text.includes("a.credential_generation as generation");
+  if (membership || fingerprint)
+    appendFileSync(measurement, JSON.stringify({ trace: span.traceId, membership, fingerprint }) + "\\n");
+  return statement;
+});
+Runtime.runMain(main.pipe(Effect.provideService(Statement.CurrentTransformer, transformer)));
+`,
+  );
+  const links = path.join(target.directory, "node_modules", "@executor-js");
+  yield* fs.makeDirectory(links, { recursive: true });
+  const product = path.join(links, "hosted-self-host");
+  if (!(yield* fs.exists(product)))
+    yield* fs.symlink(path.resolve("apps/hosted/self-host"), product);
+  return {
+    entry,
+    read: (trace: string) =>
+      fs.readFileString(measurement).pipe(
+        Effect.map((text) =>
+          text
+            .trim()
+            .split("\n")
+            .filter(Boolean)
+            .map((line) => Schema.decodeUnknownSync(Schema.fromJsonString(Statement))(line))
+            .filter((record) => record.trace === trace),
+        ),
+        Effect.map((records) => ({
+          membershipReads: records.filter((record) => record.membership).length,
+          fingerprintReads: records.filter((record) => record.fingerprint).length,
+        })),
+      ),
+  };
+});
