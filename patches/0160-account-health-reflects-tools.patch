diff --git a/e2e/tests/account-tools-health.spec.ts b/e2e/tests/account-tools-health.spec.ts
new file mode 100644
index 0000000..cfc8def
--- /dev/null
+++ b/e2e/tests/account-tools-health.spec.ts
@@ -0,0 +1,130 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { connectionsPath } from "../support/app-accounts.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { toolLoaderUpstream } from "../support/tool-loader-upstream.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Check = Schema.Struct({
+  status: Schema.String,
+  current: Schema.Boolean,
+  message: Schema.optionalKey(Schema.String),
+});
+const Health = Schema.Struct({
+  apps: Schema.Array(Schema.Struct({ app: Schema.String, check: Schema.NullOr(Check) })),
+});
+const Detail = Schema.Struct({ health: Health });
+
+/** A provider check that never reads the tools, and a tool loader that fails while it is told to. */
+const source = (
+  origin: string,
+) => `import { defineApp, defineProvider, object, ProviderError, query, router, secrets, string } from "apps";
+const service = defineProvider({
+  name: "Service with a tool loader",
+  auth: { apiKey: secrets({ label: "API key", fields: object({ token: string() }) }) },
+  async health({ fetch, signal }) {
+    const answer = await (await fetch(${JSON.stringify(`${origin}/health`)}, { signal })).text();
+    if (answer !== "ok") throw new ProviderError({ reason: "unauthorized", status: 401 });
+    return {};
+  },
+});
+export default defineApp({ user: { accounts: { service } } }, async ({ fetch, signal }) => {
+  const answer = await (await fetch(${JSON.stringify(`${origin}/tools`)}, { signal })).text();
+  if (answer !== "ok") throw new Error("Tool loader failed: " + answer);
+  return { tools: router({ ping: query({ input: object({}) }, async () => ({ ok: true })) }) };
+});`;
+
+layer(HostedLive, { excludeTestServices: true })("Account tools health", (it) => {
+  it.effect(scenarios.accountToolsHealth.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors;
+        const fixture = yield* toolLoaderUpstream;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const created = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: "Tool loader health",
+          files: [{ path: "index.ts", content: source(fixture.origin) }, appsManifest],
+        });
+        expect(created.status, JSON.stringify(created.body)).toBe(200);
+        const app = (yield* body(Resource, created)).id;
+        const appPath = `${prefix}/apps/${app}`;
+        yield* Effect.addFinalizer(() =>
+          api.request(actors.owner, "DELETE", appPath).pipe(Effect.orDie),
+        );
+        const connection = yield* body(
+          Resource,
+          yield* api.request(actors.owner, "POST", connectionsPath(appPath, "user", "service"), {}),
+        );
+        const saved = yield* api.request(
+          actors.owner,
+          "POST",
+          `${prefix}/connections/${connection.id}/submit`,
+          {
+            method: "apiKey",
+            fields: { token: "synthetic-key" },
+          },
+        );
+        expect(saved.status, JSON.stringify(saved.body)).toBe(200);
+        const accountPath = `${prefix}/accounts/${(yield* body(Resource, saved)).id}`;
+        yield* Effect.addFinalizer(() =>
+          api.request(actors.owner, "DELETE", accountPath).pipe(Effect.orDie),
+        );
+
+        const ofApp = (health: typeof Health.Type) =>
+          health.apps.find((entry) => entry.app === app)?.check;
+        /** The badge as the dashboard reads it; reading never checks. */
+        const badge = () =>
+          Effect.flatMap(api.request(actors.owner, "GET", accountPath), (response) =>
+            Effect.map(body(Detail, response), (detail) => ofApp(detail.health)),
+          );
+        const check = () =>
+          Effect.gen(function* () {
+            const response = yield* api.request(actors.owner, "POST", `${accountPath}/health`);
+            expect(response.status, JSON.stringify(response.body)).toBe(200);
+            return ofApp(yield* body(Health, response));
+          });
+        /** Agents' discovery: the app's catalog with the caller's linked accounts. */
+        const discover = () =>
+          Effect.map(api.request(actors.owner, "GET", `${appPath}/tools`), (r) => r.status);
+
+        expect(yield* check()).toMatchObject({ status: "healthy", current: true });
+
+        // Discovery that cannot load the tools shows on the badge, with the reason agents get.
+        yield* fixture.tools("broken");
+        expect(yield* discover()).toBe(502);
+        const marked = yield* badge();
+        expect(marked).toMatchObject({ status: "tools_unavailable", current: true });
+        expect(marked?.message).toContain("Tool loader failed: broken");
+
+        // Once discovery loads them again, the mark it set is cleared.
+        yield* fixture.tools("ok");
+        expect(yield* discover()).toBe(200);
+        expect(yield* badge()).toEqual({ status: "healthy", current: true });
+
+        // A check whose credentials pass still reports tools that do not load.
+        yield* fixture.tools("broken");
+        const probed = yield* check();
+        expect(probed).toMatchObject({ status: "tools_unavailable", current: true });
+        expect(probed?.message).toContain("Tool loader failed: broken");
+        // Discovery clears only its own marks; the check's result stands until the next check.
+        yield* fixture.tools("ok");
+        expect(yield* discover()).toBe(200);
+        expect(yield* badge()).toMatchObject({ status: "tools_unavailable" });
+        expect(yield* check()).toEqual({ status: "healthy", current: true });
+
+        // A rejected sign-in is never replaced by what discovery found.
+        yield* fixture.health("rejected");
+        expect(yield* check()).toMatchObject({ status: "credentials_rejected" });
+        yield* fixture.tools("broken");
+        expect(yield* discover()).toBe(502);
+        expect(yield* badge()).toMatchObject({ status: "credentials_rejected" });
+      }),
+    ),
+  );
+});
