diff --git a/packages/sdk/src/implementation/account-tools-health.ts b/packages/sdk/src/implementation/account-tools-health.ts
new file mode 100644
index 0000000..5daac7d
--- /dev/null
+++ b/packages/sdk/src/implementation/account-tools-health.ts
@@ -0,0 +1,165 @@
+/**
+ * Whether an app's tools load for agents, kept on the app's account checks. A provider check can
+ * accept credentials while the app's tool loader fails, so the check also reads the app's catalog,
+ * and every catalog read records what it found.
+ *
+ * Each kind of read keeps its own entry: the account check, and each catalog context agents'
+ * discovery reads (MCP with app UI or without, user or app scope, which caller). A read sets its
+ * entry when the tools fail and removes it when they load, so one context loading never hides
+ * another that fails. While the credentials pass, the check shows `tools_unavailable` exactly when
+ * some entry is present. Entries older than a day are ignored, the longest a kept listing is
+ * served, so a context nobody reads any more cannot hold the badge.
+ */
+import { Clock, Effect, Option, Schema } from "effect";
+import type { AccountCheckStatus } from "../contracts/account.ts";
+import { JsonObject, type AccountId, type AppId, type VersionId } from "../contracts/shared.ts";
+import {
+  AppEvaluationFailed,
+  AppProviderFailed,
+  ToolListingTimedOut,
+  routerFailure,
+  type ToolRouter,
+} from "../contracts/tools.ts";
+import { query, type Query } from "./database.ts";
+
+// App text can be long, such as one line per failed router; the badge keeps a readable summary.
+const limit = 1_000;
+const bounded = (text: string) => (text.length > limit ? `${text.slice(0, limit - 1)}…` : text);
+const retainedMillis = 24 * 60 * 60 * 1_000;
+
+/** The entry the account check's own catalog read keeps. */
+export const checkContext = "check";
+
+/** What agents are told about the routers that could not list their tools, or undefined. */
+export const toolsProblem = (
+  identity: { app: AppId; version: VersionId },
+  routers: readonly ToolRouter[],
+) => {
+  const failed = routers.flatMap((router) =>
+    router.error === undefined ? [] : [routerFailure(identity, router.error).message],
+  );
+  return failed.length === 0 ? undefined : bounded([...new Set(failed)].join(" "));
+};
+
+/**
+ * What agents are told when a catalog read fails because the app's tools do not load, or
+ * undefined for a failure that is not the tools', such as a missing account.
+ */
+export const toolsFailure = (error: unknown) =>
+  Schema.is(AppEvaluationFailed)(error) ||
+  Schema.is(AppProviderFailed)(error) ||
+  Schema.is(ToolListingTimedOut)(error)
+    ? bounded(error.message)
+    : undefined;
+
+const Entries = Schema.Record(
+  Schema.String,
+  Schema.Struct({ reason: Schema.String, at: Schema.Number }),
+);
+type Entries = typeof Entries.Type;
+const Stored = Schema.Struct({ toolsUnavailable: Schema.optionalKey(Entries) });
+
+/** The entries kept in a check's info that are recent enough to count at `now`. */
+export const toolsEntries = (info: unknown, now: number): Entries =>
+  Object.fromEntries(
+    Object.entries(
+      Option.getOrUndefined(Schema.decodeUnknownOption(Stored)(info))?.toolsUnavailable ?? {},
+    ).filter(([, entry]) => now - entry.at < retainedMillis),
+  );
+
+/** Entries after one read of `context`: set with `reason` when the tools failed, else removed. */
+export const recordRead = (
+  entries: Entries,
+  context: string,
+  reason: string | undefined,
+  now: number,
+): Entries => {
+  const { [context]: _previous, ...others } = entries;
+  return reason === undefined ? others : { ...others, [context]: { reason, at: now } };
+};
+
+/** Why the tools do not load, from every entry, or undefined when none is kept. */
+export const toolsReason = (entries: Entries) => {
+  const reasons = [...new Set(Object.values(entries).map((entry) => entry.reason))];
+  return reasons.length === 0 ? undefined : bounded(reasons.join(" "));
+};
+
+/** A check's info with these entries, without the key once none is kept. */
+export const withToolsEntries = (info: JsonObject | null, entries: Entries) => {
+  const { toolsUnavailable: _previous, ...rest } = info ?? {};
+  const kept = Object.keys(entries).length === 0 ? rest : { ...rest, toolsUnavailable: entries };
+  return Object.keys(kept).length === 0 ? null : kept;
+};
+
+/** Credentials that passed leave the status to the tools; a failed sign-in keeps its own. */
+const statusWith = (status: string, reason: string | undefined) =>
+  status === "healthy" || status === "tools_unavailable"
+    ? reason === undefined
+      ? ("healthy" satisfies AccountCheckStatus)
+      : ("tools_unavailable" satisfies AccountCheckStatus)
+    : status;
+
+/**
+ * Record what one catalog read of `context` found on the checks of the accounts it used, at the
+ * version and credential generations it read. A check written since this read is never changed.
+ * Two reads that overlap may leave the earlier one's finding until the next read of its context.
+ */
+export const observeToolLoad = (
+  db: Query,
+  input: {
+    readonly app: AppId;
+    readonly version: VersionId;
+    readonly accounts: readonly { readonly id: AccountId; readonly credentialGeneration: number }[];
+    /** Identifies who read which kind of catalog, as the listing store keys it. */
+    readonly context: string;
+    readonly problem: string | undefined;
+  },
+) =>
+  Effect.gen(function* () {
+    if (input.accounts.length === 0) return;
+    const now = yield* Clock.currentTimeMillis;
+    const generation = new Map(
+      input.accounts.map((account) => [account.id, account.credentialGeneration]),
+    );
+    const rows = yield* query(() =>
+      db.findMany("accountChecks", {
+        where: (b) =>
+          b.and(
+            b("app", "=", input.app),
+            b("deployment", "=", input.version),
+            b("account", "in", [...generation.keys()]),
+          ),
+      }),
+    );
+    for (const row of rows) {
+      if (generation.get(row.account as AccountId) !== row.credentialGeneration) continue;
+      const entries = toolsEntries(row.info, now);
+      if (input.problem === undefined && !Object.hasOwn(entries, input.context)) continue;
+      const next = recordRead(entries, input.context, input.problem, now);
+      const reason = toolsReason(next);
+      const status = statusWith(row.status, reason);
+      const info = withToolsEntries(
+        Option.getOrNull(Schema.decodeUnknownOption(JsonObject)(row.info)),
+        next,
+      );
+      yield* query(() =>
+        db.updateMany("accountChecks", {
+          where: (b) =>
+            b.and(
+              b("id", "=", row.id),
+              b("status", "=", row.status),
+              b("deployment", "=", row.deployment),
+              b("credentialGeneration", "=", row.credentialGeneration),
+              b("checkedAt", "=", row.checkedAt),
+            ),
+          set: {
+            status,
+            info,
+            ...(status === "tools_unavailable" || row.status === "tools_unavailable"
+              ? { message: status === "tools_unavailable" ? (reason ?? null) : null }
+              : {}),
+          },
+        }),
+      );
+    }
+  });
