diff --git a/packages/sdk/src/implementation/account-tools-health.ts b/packages/sdk/src/implementation/account-tools-health.ts
new file mode 100644
index 0000000..2157d39
--- /dev/null
+++ b/packages/sdk/src/implementation/account-tools-health.ts
@@ -0,0 +1,123 @@
+/**
+ * Whether an app's tools load for agents, kept on the app's account checks. A provider check can
+ * accept credentials while the app's tool loader fails, so the check that shows an account as
+ * healthy also reads the app's catalog, and every catalog read marks or clears what it found.
+ */
+import { Effect, Option, Schema } from "effect";
+import type { AccountCheckStatus } from "../contracts/account.ts";
+import { JsonObject, type AccountId, type AppId, type VersionId } from "../contracts/shared.ts";
+import {
+  AppEvaluationFailed,
+  AppProviderFailed,
+  ToolListingTimedOut,
+  routerFailure,
+  type ToolRouter,
+} from "../contracts/tools.ts";
+import { recordedDiscoveryMark } from "./account-check-record.ts";
+import { query, type Query } from "./database.ts";
+
+// App text can be long, such as one line per failed router; the badge keeps a readable summary.
+const limit = 1_000;
+const bounded = (text: string) => (text.length > limit ? `${text.slice(0, limit - 1)}…` : text);
+
+/** What agents are told about the routers that could not list their tools, or undefined. */
+export const toolsProblem = (
+  identity: { app: AppId; version: VersionId },
+  routers: readonly ToolRouter[],
+) => {
+  const failed = routers.flatMap((router) =>
+    router.error === undefined ? [] : [routerFailure(identity, router.error).message],
+  );
+  return failed.length === 0 ? undefined : bounded([...new Set(failed)].join(" "));
+};
+
+/**
+ * What agents are told when a catalog read fails because the app's tools do not load, or
+ * undefined for a failure that is not the tools', such as a missing account. Only a check's own
+ * read can time out; discovery's listing store reports that to its reader.
+ */
+export const toolsFailure = (error: unknown) =>
+  Schema.is(AppEvaluationFailed)(error) ||
+  Schema.is(AppProviderFailed)(error) ||
+  Schema.is(ToolListingTimedOut)(error)
+    ? bounded(error.message)
+    : undefined;
+
+type Row = {
+  readonly status: string;
+  readonly info: unknown;
+  readonly message: string | null;
+};
+
+/** The row discovery's finding leaves, or undefined when it must not change it. */
+const marked = (row: Row, problem: string | undefined) => {
+  const mark = recordedDiscoveryMark(row.info);
+  const info = Option.getOrElse(
+    Schema.decodeUnknownOption(JsonObject)(row.info),
+    (): JsonObject => ({}),
+  );
+  if (problem !== undefined) {
+    if (row.status !== "healthy" && !(mark && row.message !== problem)) return undefined;
+    return {
+      status: "tools_unavailable" satisfies AccountCheckStatus,
+      message: problem,
+      info: { ...info, toolsUnavailableFromDiscovery: true },
+    };
+  }
+  if (row.status !== "tools_unavailable" || !mark) return undefined;
+  const { toolsUnavailableFromDiscovery: _mark, ...rest } = info;
+  return {
+    status: "healthy" satisfies AccountCheckStatus,
+    message: null,
+    info: Object.keys(rest).length === 0 ? null : rest,
+  };
+};
+
+/**
+ * Record what one catalog read found on the checks of the accounts it used, at the generation it
+ * read them with. A failure marks a current healthy check as `tools_unavailable`; a success clears
+ * only a mark a read set. A check that ran since the read is never changed.
+ */
+export const observeToolLoad = (
+  db: Query,
+  input: {
+    readonly app: AppId;
+    readonly version: VersionId;
+    readonly accounts: readonly { readonly id: AccountId; readonly credentialGeneration: number }[];
+    readonly problem: string | undefined;
+  },
+) =>
+  Effect.gen(function* () {
+    if (input.accounts.length === 0) return;
+    const generation = new Map(
+      input.accounts.map((account) => [account.id, account.credentialGeneration]),
+    );
+    const rows = yield* query(() =>
+      db.findMany("accountChecks", {
+        where: (b) =>
+          b.and(
+            b("app", "=", input.app),
+            b("deployment", "=", input.version),
+            b("account", "in", [...generation.keys()]),
+          ),
+      }),
+    );
+    for (const row of rows) {
+      if (generation.get(row.account as AccountId) !== row.credentialGeneration) continue;
+      const update = marked(row, input.problem);
+      if (update === undefined) continue;
+      yield* query(() =>
+        db.updateMany("accountChecks", {
+          where: (b) =>
+            b.and(
+              b("id", "=", row.id),
+              b("status", "=", row.status),
+              b("deployment", "=", row.deployment),
+              b("credentialGeneration", "=", row.credentialGeneration),
+              b("checkedAt", "=", row.checkedAt),
+            ),
+          set: update,
+        }),
+      );
+    }
+  });
