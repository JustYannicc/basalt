@@ -0,0 +1,31 @@
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Effect, Layer, Ref } from "effect";
+import { HttpRouter, HttpServer, HttpServerResponse } from "effect/http";
+import { createServer } from "node:http";
+
+/**
+ * A service an app asks whether its tool loader may work (`/tools`) and whether its account check
+ * accepts the key (`/health`). Each answers "ok" until a scenario sets another answer.
+ */
+export const toolLoaderUpstream = Effect.gen(function* () {
+  const tools = yield* Ref.make("ok");
+  const health = yield* Ref.make("ok");
+  const answer = (ref: Ref.Ref<string>) =>
+    Effect.map(Ref.get(ref), (value) => HttpServerResponse.text(value));
+  const services = yield* Layer.build(
+    HttpRouter.serve(
+      Layer.mergeAll(
+        HttpRouter.add("GET", "/tools", answer(tools)),
+        HttpRouter.add("GET", "/health", answer(health)),
+      ),
+      { disableLogger: true, disableListenLog: true },
+    ).pipe(Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 }))),
+  );
+  const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+  if (!("port" in server.address)) return yield* Effect.die("Fixture must listen on TCP");
+  return {
+    origin: `http://127.0.0.1:${server.address.port}`,
+    tools: (value: string) => Ref.set(tools, value),
+    health: (value: string) => Ref.set(health, value),
+  };
+});
