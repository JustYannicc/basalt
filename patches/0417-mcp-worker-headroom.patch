index 0000000..813dfec
--- /dev/null
+++ b/apps/hosted/cloud/src/contracts/mcp-grant-rpc.ts
@@ -0,0 +1,71 @@
+/** Private grant operations return codecs so Worker RPC preserves their typed refusals. */
+import {
+  AuthenticationUnavailable,
+  McpAccess,
+  McpApprovalForbidden,
+  McpUnauthorized,
+  type McpAuthentication,
+} from "@executor-js/hosted-server";
+import { ConnectedAgent, ConnectedAgentNotFound } from "@executor-js/mcp-auth/agents";
+import {
+  Connection,
+  ConnectionIdTaken,
+  ConnectionNotFound,
+} from "@executor-js/mcp-auth/connections";
+import type { RpcCallError } from "alchemy/Rpc";
+import { Schema, type Context, type Effect } from "effect";
+
+export type GrantReply<A, E> =
+  | { readonly ok: true; readonly value: A }
+  | { readonly ok: false; readonly error: E };
+const reply = <A extends Schema.Top, E extends Schema.Top>(value: A, error: E) =>
+  Schema.toCodecJson(
+    Schema.Union([
+      Schema.Struct({ ok: Schema.Literal(true), value }),
+      Schema.Struct({ ok: Schema.Literal(false), error }),
+    ]),
+  );
+export const grantReplies = {
+  browser: reply(
+    McpAccess,
+    Schema.Union([McpUnauthorized, McpApprovalForbidden, AuthenticationUnavailable]),
+  ),
+  metadata: reply(Schema.Unknown, AuthenticationUnavailable),
+  list: reply(Schema.Array(Connection), AuthenticationUnavailable),
+  create: reply(Connection, Schema.Union([ConnectionIdTaken, AuthenticationUnavailable])),
+  update: reply(Connection, Schema.Union([ConnectionNotFound, AuthenticationUnavailable])),
+  revoke: reply(Schema.Void, Schema.Union([ConnectionNotFound, AuthenticationUnavailable])),
+  agents: reply(Schema.Array(ConnectedAgent), AuthenticationUnavailable),
+  revokeAgent: reply(
+    Schema.Void,
+    Schema.Union([ConnectedAgentNotFound, AuthenticationUnavailable]),
+  ),
+};
+type Identity = Context.Service.Shape<typeof McpAuthentication>;
+type Store = Identity["connections"];
+type Reply<S extends Schema.Top> = Effect.Effect<S["Encoded"], RpcCallError>;
+export type McpGrantRpc = {
+  readonly mcpGrantBrowser: (
+    headers: Readonly<Record<string, string>>,
+    id: Parameters<Identity["browserGrant"]>[1],
+  ) => Reply<typeof grantReplies.browser>;
+  readonly mcpGrantMetadata: () => Reply<typeof grantReplies.metadata>;
+  readonly mcpConnectionList: (
+    ...input: Parameters<Store["list"]>
+  ) => Reply<typeof grantReplies.list>;
+  readonly mcpConnectionCreate: (
+    ...input: Parameters<Store["create"]>
+  ) => Reply<typeof grantReplies.create>;
+  readonly mcpConnectionUpdate: (
+    ...input: Parameters<Store["update"]>
+  ) => Reply<typeof grantReplies.update>;
+  readonly mcpConnectionRevoke: (
+    ...input: Parameters<Store["revoke"]>
+  ) => Reply<typeof grantReplies.revoke>;
+  readonly mcpConnectionAgents: (
+    ...input: Parameters<Store["agents"]>
+  ) => Reply<typeof grantReplies.agents>;
+  readonly mcpConnectionRevokeAgent: (
+    ...input: Parameters<Store["revokeAgent"]>
+  ) => Reply<typeof grantReplies.revokeAgent>;
+};
