index 0000000..f086052
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/mcp-grant-client.ts
@@ -0,0 +1,17 @@
+/** A failed private call is unavailable, and a grant refusal keeps its original typed error. */
+import { AuthenticationUnavailable } from "@executor-js/hosted-server";
+import type { RpcCallError } from "alchemy/Rpc";
+import { Effect, type Schema } from "effect";
+import type { GrantReply } from "../contracts/mcp-grant-rpc.ts";
+
+export const readGrantReply = <A, E, R>(
+  decode: (input: unknown) => Effect.Effect<GrantReply<A, E>, Schema.SchemaError>,
+  call: Effect.Effect<unknown, RpcCallError, R>,
+) =>
+  call.pipe(
+    Effect.mapError(() => new AuthenticationUnavailable()),
+    Effect.flatMap((value) =>
+      decode(value).pipe(Effect.mapError(() => new AuthenticationUnavailable())),
+    ),
+    Effect.flatMap((reply) => (reply.ok ? Effect.succeed(reply.value) : Effect.fail(reply.error))),
+  );
diff --git a/apps/hosted/cloud/src/infrastructure/mcp-grant-server.ts b/apps/hosted/cloud/src/infrastructure/mcp-grant-server.ts
new file mode 100644
index 0000000..86d65c2
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/mcp-grant-server.ts
@@ -0,0 +1,36 @@
+/** The API already owns this auth service; MCP borrows it only through its private binding. */
+import { McpAuthentication } from "@executor-js/hosted-server";
+import { Effect, Schema, type Layer } from "effect";
+import { grantReplies, type GrantReply, type McpGrantRpc } from "../contracts/mcp-grant-rpc.ts";
+
+const answer = <A, E, Encoded>(
+  encode: (reply: GrantReply<A, E>) => Encoded,
+  work: Effect.Effect<A, E>,
+) =>
+  work.pipe(
+    Effect.match({
+      onSuccess: (value) => encode({ ok: true, value }),
+      onFailure: (error) => encode({ ok: false, error }),
+    }),
+  );
+
+export const makeMcpGrantRpc = Effect.fn(function* (identity: Layer.Layer<McpAuthentication>) {
+  const auth = yield* McpAuthentication.pipe(Effect.provide(identity));
+  return {
+    mcpGrantBrowser: (headers, id) =>
+      answer(Schema.encodeSync(grantReplies.browser), auth.browserGrant(new Headers(headers), id)),
+    mcpGrantMetadata: () => answer(Schema.encodeSync(grantReplies.metadata), auth.metadata),
+    mcpConnectionList: (...input) =>
+      answer(Schema.encodeSync(grantReplies.list), auth.connections.list(...input)),
+    mcpConnectionCreate: (...input) =>
+      answer(Schema.encodeSync(grantReplies.create), auth.connections.create(...input)),
+    mcpConnectionUpdate: (...input) =>
+      answer(Schema.encodeSync(grantReplies.update), auth.connections.update(...input)),
+    mcpConnectionRevoke: (...input) =>
+      answer(Schema.encodeSync(grantReplies.revoke), auth.connections.revoke(...input)),
+    mcpConnectionAgents: (...input) =>
+      answer(Schema.encodeSync(grantReplies.agents), auth.connections.agents(...input)),
+    mcpConnectionRevokeAgent: (...input) =>
+      answer(Schema.encodeSync(grantReplies.revokeAgent), auth.connections.revokeAgent(...input)),
+  } satisfies McpGrantRpc;
+});
diff --git a/apps/hosted/cloud/src/infrastructure/mcp-session-auth.ts b/apps/hosted/cloud/src/infrastructure/mcp-session-auth.ts
new file mode 100644
index 0000000..19ca71e
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/mcp-session-auth.ts
@@ -0,0 +1,100 @@
+/** Bearers stay local. The API owns the infrequent browser, metadata and connection operations. */
+import { McpAuthentication, mcpBearerAccess } from "@executor-js/hosted-server";
+import * as Cloudflare from "alchemy/Cloudflare";
+import { Effect, Layer, Schema } from "effect";
+import { isV1Forward, v1ForwardAccess } from "../implementation/v1-mcp-forward.ts";
+import { grantReplies } from "../contracts/mcp-grant-rpc.ts";
+import { Api } from "./api-worker.ts";
+import { invocationSql } from "./invocation-database.ts";
+import { v1McpForwardSecret } from "./secrets.ts";
+import { cloudHosts } from "./stage.ts";
+import { readGrantReply } from "./mcp-grant-client.ts";
+
+export const cloudMcpIdentity = Effect.gen(function* () {
+  const hosts = yield* cloudHosts.pipe(Effect.orDie);
+  const origins = {
+    origin: hosts.browser,
+    resourceOrigins: hosts.resourceOrigins,
+    issuer: hosts.issuer,
+  };
+  const worker = yield* Cloudflare.Workers.bindWorker(Api);
+  const environment = yield* Cloudflare.WorkerEnvironment;
+  const withSql = yield* invocationSql;
+  const v1Forward = yield* v1McpForwardSecret;
+  const bound = <A, E>(work: Effect.Effect<A, E, Cloudflare.WorkerEnvironment>) =>
+    work.pipe(Effect.provideService(Cloudflare.WorkerEnvironment, environment));
+  return Layer.succeed(
+    McpAuthentication,
+    McpAuthentication.of({
+      ...origins,
+      authenticate: (headers, mode, organization) =>
+        withSql(
+          isV1Forward(headers)
+            ? v1ForwardAccess(v1Forward, { headers, mode, organization })
+            : mcpBearerAccess(origins, { headers, mode, organization }),
+        ).pipe(
+          Effect.tap(({ access }) =>
+            Effect.annotateCurrentSpan("executor.organization.id", access.organization),
+          ),
+          Effect.withSpan("auth.authenticate"),
+        ),
+      browserGrant: (headers, id) =>
+        bound(
+          readGrantReply(
+            Schema.decodeUnknownEffect(grantReplies.browser),
+            worker.mcpGrantBrowser(Object.fromEntries(headers), id),
+          ),
+        ),
+      metadata: bound(
+        readGrantReply(
+          Schema.decodeUnknownEffect(grantReplies.metadata),
+          worker.mcpGrantMetadata(),
+        ),
+      ),
+      connections: {
+        list: (...input) =>
+          bound(
+            readGrantReply(
+              Schema.decodeUnknownEffect(grantReplies.list),
+              worker.mcpConnectionList(...input),
+            ),
+          ),
+        create: (...input) =>
+          bound(
+            readGrantReply(
+              Schema.decodeUnknownEffect(grantReplies.create),
+              worker.mcpConnectionCreate(...input),
+            ),
+          ),
+        update: (...input) =>
+          bound(
+            readGrantReply(
+              Schema.decodeUnknownEffect(grantReplies.update),
+              worker.mcpConnectionUpdate(...input),
+            ),
+          ),
+        revoke: (...input) =>
+          bound(
+            readGrantReply(
+              Schema.decodeUnknownEffect(grantReplies.revoke),
+              worker.mcpConnectionRevoke(...input),
+            ),
+          ),
+        agents: (...input) =>
+          bound(
+            readGrantReply(
+              Schema.decodeUnknownEffect(grantReplies.agents),
+              worker.mcpConnectionAgents(...input),
+            ),
+          ),
+        revokeAgent: (...input) =>
+          bound(
+            readGrantReply(
+              Schema.decodeUnknownEffect(grantReplies.revokeAgent),
+              worker.mcpConnectionRevokeAgent(...input),
+            ),
+          ),
+      },
+    }),
+  );
+});
