+
+  it.effect(scenarios.listedBindingCompactRow.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const actors = yield* Actors;
+        const browser = yield* Browser;
+        const evidence = yield* Evidence;
+        const fixture = yield* verifiedBindings;
+        const groupTitle = fixture.first.identity?.label ?? fixture.first.label;
+        yield* browser.login(actors.owner);
+        for (const width of [1280, 390]) {
+          const collapsed = yield* browser.use(`Read the grouped row at ${width}px`, (page) => {
+            const row = accountRow(page, groupTitle);
+            return page
+              .setViewportSize({ width, height: 900 })
+              .then(() => page.goto(`/org/${actors.organization.slug}/accounts`))
+              .then(() => row.locator("[data-account-name]").waitFor())
+              .then(() =>
+                Promise.all([
+                  row.evaluate((element) => element.getBoundingClientRect().height),
+                  row.locator(".requested-access").count(),
+                  row.locator("[data-account-health]").count(),
+                  row.getByRole("button", { name: /^Check now$|^Details$/ }).count(),
+                  page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth),
+                ]),
+              );
+          });
+          yield* evidence.attach(
+            `listed-binding-compact-${width}.png`,
+            "image/png",
+            yield* browser.use("Capture the grouped row", (page) =>
+              page.screenshot({ fullPage: true }),
+            ),
+          );
+          const [height, access, health, inline, fits] = collapsed;
+          expect(
+            { access, health, inline },
+            "requested access, checks, Check now and Details wait behind the row's menu",
+          ).toEqual({ access: 0, health: 0, inline: 0 });
+          expect(fits, `no horizontal scroll at ${width}px`).toBe(true);
+          if (width === 390)
+            expect(height, "the grouped row stays compact on a phone").toBeLessThanOrEqual(110);
+          const opened = yield* browser.use(
+            `Open the grouped row's Details at ${width}px`,
+            (page) => {
+              const row = accountRow(page, groupTitle);
+              return openRowMenu(page, row, groupTitle)
+                .then((menu) =>
+                  menu
+                    .getByRole("menuitem")
+                    .allInnerTexts()
+                    .then((items) =>
+                      menu
+                        .getByRole("menuitem", { name: "Details", exact: true })
+                        .click()
+                        .then(() => items),
+                    ),
+                )
+                .then((items) =>
+                  row
+                    .locator(".requested-access")
+                    .waitFor()
+                    .then(() =>
+                      Promise.all([
+                        Promise.resolve(items),
+                        row.locator("[data-account-health]").count(),
+                        row
+                          .locator("[data-account-health]")
+                          .getByRole("button", { name: "Check now", exact: true })
+                          .count(),
+                      ]),
+                    ),
+                );
+            },
+          );
+          expect(opened[0]).toEqual(expect.arrayContaining(["Details", "Manage apps"]));
+          expect(opened.slice(1), "Details hold the checks and Check now").toEqual([1, 1]);
+        }
+      }),
+    ),
+  );
 });
