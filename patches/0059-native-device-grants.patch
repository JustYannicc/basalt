+        expect((yield* p.access(renewed)).status).toBe(401);
+        expect((yield* p.refresh(renewed)).status).toBe(400);
+        expect(
+          (yield* p.api.request(
+            p.anonymous,
+            "GET",
+            "/mcp",
+            undefined,
+            p.headers(tokens.access_token),
+          )).status,
