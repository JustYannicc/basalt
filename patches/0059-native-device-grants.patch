+} from "@better-auth/oauth-provider";
+import { APIError } from "better-auth/api";
+import { Effect, Schema } from "effect";
+import { GrantId } from "../contracts/grant.ts";
+import { authCall, parse, runAuth } from "./auth-call.ts";
+
+/** Kept outside GrantPolicy so an older server cannot interpret a device as API authority. */
+export const NativeGrantPolicy = Schema.Struct({
+  kind: Schema.Literal("native"),
+  models: Schema.Boolean,
+  computer: Schema.NonEmptyString,
+  pool: Schema.NonEmptyString,
+  toolsOrganization: Schema.optionalKey(Schema.NonEmptyString),
+}).check(Schema.makeFilter((policy) => policy.models || policy.toolsOrganization !== undefined));
+export type NativeGrantPolicy = typeof NativeGrantPolicy.Type;
+export const NativeGrantAccess = Schema.Struct({
+  id: GrantId,
+  userId: Schema.NonEmptyString,
+  clientId: Schema.NonEmptyString,
+  policy: NativeGrantPolicy,
+});
+export type NativeGrantAccess = typeof NativeGrantAccess.Type;
+export interface NativeGrantHost {
+  readonly audience: string;
+  /** Resolve the approving person's pool and optional personal tools, never device input. */
+  readonly approve: (
+    context: GenericEndpointContext,
