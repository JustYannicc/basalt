+        expect(content).toContain("native client");
+        const paused = yield* client.use("Native grants preserve tool approval", (client, signal) =>
+          client.callTool(
+            {
+              name: "execute",
+              arguments: { code: `return await tools[${JSON.stringify(app.slug)}].approved({})` },
+            },
+            undefined,
+            { signal },
