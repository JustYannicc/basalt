+import { createServer } from "node:http";
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Effect, Layer, Schema } from "effect";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+
+const Envelope = Schema.Struct({ envelope: Schema.String });
+const Assertion = Schema.Struct({
+  action: Schema.String,
+  user: Schema.String,
+  grant: Schema.String,
+  computer: Schema.optionalKey(Schema.String),
+  pool: Schema.optionalKey(Schema.String),
+  intent: Schema.optionalKey(Schema.String),
+  tools: Schema.optionalKey(Schema.Boolean),
+  models: Schema.optionalKey(Schema.Boolean),
+});
+
+/** An external pool protocol fixture; OAuth, consent, membership and tokens stay in the real host. */
+export const nativePool = (organization: string, pool: string) =>
+  Effect.gen(function* () {
+    let refused = false;
+    let created = 0;
+    const records = new Map<string, { user: string; computer: string; active: boolean }>();
+    const services = yield* Layer.build(
+      HttpRouter.serve(
+        HttpRouter.add(
+          "POST",
+          "/native/v1/control",
+          Effect.gen(function* () {
+            const request = yield* HttpServerRequest.HttpServerRequest;
+            const { envelope } = yield* request.json.pipe(
+              Effect.flatMap(Schema.decodeUnknownEffect(Envelope)),
+            );
+            const pieces = envelope.split(".");
+            if (pieces.length !== 3 || pieces[0] !== "sbn1")
+              return HttpServerResponse.empty({ status: 401 });
+            const decoded = yield* Schema.decodeUnknownEffect(Schema.StringFromBase64Url)(
+              pieces[1],
+            );
+            const value = yield* Schema.decodeUnknownEffect(Schema.fromJsonString(Assertion))(
+              decoded,
+            );
+            if (value.action === "register") {
+              if (
+                value.intent !== "approved-native-intent" ||
+                (value.pool !== undefined && value.pool !== pool)
+              )
+                return HttpServerResponse.empty({ status: 403 });
+              const computer = `native-computer-${++created}`;
+              records.set(value.grant, { user: value.user, computer, active: true });
+              return HttpServerResponse.jsonUnsafe({
+                computer: { id: computer },
+                pool,
+                models: value.models,
+                ...(value.tools ? { toolsOrganization: organization } : {}),
+              });
+            }
+            const record = records.get(value.grant);
+            if (
+              record === undefined ||
+              record.user !== value.user ||
+              record.computer !== value.computer ||
+              value.pool !== pool
+            )
+              return HttpServerResponse.empty({ status: 401 });
