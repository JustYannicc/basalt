+import { expect } from "@effect/vitest";
+import { Crypto, Effect, Redacted, Schema } from "effect";
+import { Base64Url } from "effect/encoding";
+import { HttpClient, HttpClientRequest } from "effect/http";
+import { Actors } from "./actors.ts";
+import { Api, body, type Session } from "./api.ts";
+import { Target } from "./platform.ts";
+import { targetHosts } from "./role-hosts.ts";
+import { serverControl } from "./server-control.ts";
+import { nativePool } from "./native-pool.ts";
+
+export const NativeTokens = Schema.Struct({
+  access_token: Schema.RedactedFromValue(Schema.NonEmptyString),
+  refresh_token: Schema.RedactedFromValue(Schema.NonEmptyString),
+});
+export const NativeAccess = Schema.Struct({
+  id: Schema.String,
+  policy: Schema.Struct({
+    kind: Schema.Literal("native"),
+    models: Schema.Boolean,
+    computer: Schema.String,
+    pool: Schema.String,
+    toolsOrganization: Schema.optionalKey(Schema.String),
+  }),
+});
+export const startNativeProtocol = (session: Session) =>
+  Effect.gen(function* () {
+    const api = yield* Api,
+      actors = yield* Actors,
+      http = yield* HttpClient.HttpClient;
+    const target = yield* Target;
+    const hosts = targetHosts(target);
+    const resource = `${hosts.browser}/native`;
+    const pool = "pool-native-integration";
+    const upstream = yield* nativePool(actors.organization.id, pool);
+    yield* serverControl("stop");
+    yield* serverControl("environment", 200, {
+      POOL_APP_SIGNING_KEY: "ab".repeat(32),
+      BASALT_POOL_ORIGIN: upstream.origin,
+    });
+    yield* serverControl("start");
+    const anonymous = yield* api.session();
+    const form = (path: string, fields: Record<string, string>) =>
+      Effect.scoped(
+        Effect.gen(function* () {
+          const response = yield* http.execute(
+            HttpClientRequest.post(`${hosts.browser}/api/auth${path}`).pipe(
+              HttpClientRequest.bodyUrlParams(fields),
+            ),
+          );
+          const value: unknown = yield* response.json;
+          return { status: response.status, body: value };
+        }),
+      ).pipe(Effect.orDie);
+    const registration = yield* api.request(anonymous, "POST", "/api/auth/oauth2/register", {
+      client_name: "Native grant protocol client",
+      token_endpoint_auth_method: "none",
+      grant_types: ["urn:ietf:params:oauth:grant-type:device_code", "refresh_token"],
+      response_types: [],
+      scope: "native offline_access",
+    });
+    expect(registration.status).toBe(201);
+    const { client_id } = yield* body(Schema.Struct({ client_id: Schema.String }), registration);
+    const crypto = yield* Crypto.Crypto;
+    const verifier = Base64Url.encode(yield* crypto.randomBytes(32));
+    const challenge = Base64Url.encode(
+      yield* crypto.digest("SHA-256", new TextEncoder().encode(verifier)),
+    );
+    const headers = (token: Redacted.Redacted<string>) => ({
+      authorization: `Bearer ${Redacted.value(token)}`,
+    });
+    const refresh = (tokens: typeof NativeTokens.Type, extra: Record<string, string> = {}) =>
+      form("/oauth2/token", {
+        grant_type: "refresh_token",
+        client_id,
+        resource,
+        refresh_token: Redacted.value(tokens.refresh_token),
+        ...extra,
+      });
+    return {
+      api,
+      actors,
+      anonymous,
+      upstream,
+      pool,
+      resource,
+      verifier,
+      headers,
+      refresh,
+      form,
+      start: (proof = true) =>
+        form("/oauth2/device-authorization", {
+          client_id,
+          scope: "native offline_access",
+          resource,
+          ...(proof ? { code_challenge: challenge, code_challenge_method: "S256" } : {}),
+        }),
+      approve: (user_code: string, tools = true, models = true) =>
+        api.request(
+          session,
+          "POST",
+          "/api/auth/device/decide",
+          {
+            user_code,
+            accept: true,
+          },
+          {
+            "x-basalt-native-intent": "approved-native-intent",
+            "x-basalt-native-name": "Native protocol device",
+            "x-basalt-native-pool": pool,
+            "x-basalt-native-tools": String(tools),
+            "x-basalt-native-models": String(models),
+          },
+        ),
+      poll: (device_code: string, extra: Record<string, string> = { code_verifier: verifier }) =>
+        form("/oauth2/token", {
+          grant_type: "urn:ietf:params:oauth:grant-type:device_code",
+          client_id,
+          device_code,
+          ...extra,
+        }),
+      access: (tokens: typeof NativeTokens.Type) =>
+        api.request(
+          anonymous,
+          "GET",
+          "/api/auth/native/access",
+          undefined,
+          headers(tokens.access_token),
+        ),
+    };
+  });
+export const approveNative = (
+  p: Effect.Success<ReturnType<typeof startNativeProtocol>>,
+  tools = true,
+  models = true,
+) =>
+  Effect.gen(function* () {
+    const response = yield* p.start();
+    expect(response.status).toBe(200);
+    const started = yield* body(
+      Schema.Struct({
+        device_code: Schema.String,
+        user_code: Schema.String,
+        verification_uri: Schema.String,
+      }),
+      response,
+    );
+    expect(new URL(started.verification_uri).pathname).toBe("/native/device");
+    expect((yield* p.approve(started.user_code, tools, models)).status).toBe(200);
+    const issued = yield* p.poll(started.device_code);
+    expect(issued.status).toBe(200);
+    return yield* body(NativeTokens, issued);
+  });
