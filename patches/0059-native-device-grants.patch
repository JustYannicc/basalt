+        );
+        const client = yield* mcp.connect(tokens.access_token, "native-grant");
+        const call = () =>
+          client.use("Execute through a native tools grant", (client, signal) =>
+            client.callTool(
+              {
+                name: "execute",
+                arguments: {
+                  code: `return await tools[${JSON.stringify(app.slug)}].echo({message:"native client"})`,
+                },
+              },
+              undefined,
+              { signal },
