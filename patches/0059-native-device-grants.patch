+import { expect, layer } from "@effect/vitest";
+import { Crypto, Effect, Redacted, Schema } from "effect";
+import { Base64Url } from "effect/encoding";
+import { HttpClient, HttpClientRequest } from "effect/http";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Evidence } from "../support/evidence.ts";
+import { Target } from "../support/platform.ts";
+import { targetHosts } from "../support/role-hosts.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+const deviceGrant = "urn:ietf:params:oauth:grant-type:device_code";
+const Started = Schema.Struct({ device_code: Schema.String, user_code: Schema.String });
+const OAuthError = Schema.Struct({ error: Schema.String });
+const Tokens = Schema.Struct({
+  access_token: Schema.RedactedFromValue(Schema.NonEmptyString),
+  refresh_token: Schema.RedactedFromValue(Schema.NonEmptyString),
+});
+const protocol = Effect.gen(function* () {
+  const api = yield* Api,
+    actors = yield* Actors,
+    http = yield* HttpClient.HttpClient,
+    evidence = yield* Evidence;
+  const hosts = targetHosts(yield* Target);
+  const resource = `${hosts.api}/api`;
+  const crypto = yield* Crypto.Crypto;
+  let sequence = 0;
+  const form = (path: string, fields: Record<string, string>) =>
+    Effect.scoped(
+      Effect.gen(function* () {
+        const response = yield* http.execute(
+          HttpClientRequest.post(`${hosts.browser}/api/auth${path}`).pipe(
+            HttpClientRequest.bodyUrlParams(fields),
+          ),
+        );
+        const value: unknown = yield* response.json;
+        yield* evidence.json(`proof-${++sequence}.json`, { status: response.status });
+        return { status: response.status, body: value };
+      }),
+    ).pipe(Effect.orDie);
+  const register = Effect.scoped(
+    Effect.gen(function* () {
+      const response = yield* http.execute(
+        yield* HttpClientRequest.bodyJson(
+          HttpClientRequest.post(`${hosts.browser}/api/auth/oauth2/register`),
+          {
+            client_name: "Device proof protocol client",
+            token_endpoint_auth_method: "none",
+            grant_types: [deviceGrant, "refresh_token"],
+            response_types: [],
+            scope: "executor offline_access",
+          },
+        ),
+      );
+      expect(response.status).toBe(201);
+      const value: unknown = yield* response.json;
+      return yield* Schema.decodeUnknownEffect(Schema.Struct({ client_id: Schema.String }))(value);
+    }),
+  ).pipe(Effect.orDie);
+  const { client_id } = yield* register;
+  yield* Effect.addFinalizer(() =>
+    Effect.gen(function* () {
+      const consents = yield* body(
+        Schema.Array(Schema.Struct({ id: Schema.String })),
+        yield* api.request(actors.owner, "GET", "/api/auth/oauth2/get-consents"),
+      );
+      for (const consent of consents)
+        yield* api.request(actors.owner, "POST", "/api/auth/oauth2/delete-consent", {
+          id: consent.id,
+        });
+    }).pipe(Effect.orDie),
+  );
+  const verifier = Base64Url.encode(yield* crypto.randomBytes(32));
+  const challenge = Base64Url.encode(
+    yield* crypto.digest("SHA-256", new TextEncoder().encode(verifier)),
+  );
+  const start = (
+    proof: Record<string, string> = { code_challenge: challenge, code_challenge_method: "S256" },
+  ) =>
+    form("/oauth2/device-authorization", {
+      client_id,
+      scope: "executor offline_access",
+      resource,
+      ...proof,
+    });
+  const poll = (deviceCode: string, input: Record<string, string> = {}) =>
+    form("/oauth2/token", {
+      grant_type: deviceGrant,
+      device_code: deviceCode,
+      client_id,
+      ...input,
+    });
+  const approve = (userCode: string) =>
+    api.request(
+      actors.owner,
+      "POST",
+      "/api/auth/device/decide",
+      { user_code: userCode, accept: true },
+      { "x-executor-organization": actors.organization.id },
+    );
+  const errorOf = (value: { status: number; body: unknown }) =>
+    Effect.gen(function* () {
+      expect(value.status).toBe(400);
+      return (yield* body(OAuthError, value)).error;
+    });
+  return {
+    api,
+    actors,
+    form,
+    register,
+    start,
+    poll,
+    approve,
+    errorOf,
+    verifier,
+    resource,
+    client_id,
+  };
+});
+
+layer(HostedLive, { excludeTestServices: true })("Device proof", (it) => {
+  it.effect(scenarios.deviceCodeProof.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const p = yield* protocol;
+        const started = yield* body(Started, yield* p.start());
+        expect(
+          yield* p.errorOf(yield* p.poll(started.device_code, { code_verifier: "x".repeat(43) })),
+        ).toBe("invalid_grant");
+        expect((yield* p.approve(started.user_code)).status).toBe(200);
+        const invalidPolls: ReadonlyArray<Record<string, string>> = [
+          {},
+          { code_verifier: "short" },
+          { code_verifier: "x".repeat(43) },
+        ];
+        for (const input of invalidPolls)
+          expect(yield* p.errorOf(yield* p.poll(started.device_code, input))).toBe("invalid_grant");
+        const other = yield* p.register;
+        expect(
+          yield* p.errorOf(
+            yield* p.poll(started.device_code, {
+              code_verifier: p.verifier,
+              client_id: other.client_id,
+            }),
+          ),
+        ).toBe("invalid_grant");
+        const issued = yield* p.poll(started.device_code, { code_verifier: p.verifier });
+        expect(issued.status).toBe(200);
+        const tokens = yield* body(Tokens, issued);
+        expect(
+          yield* p.errorOf(yield* p.poll(started.device_code, { code_verifier: p.verifier })),
+        ).toBe("invalid_grant");
+        const refreshed = yield* p.form("/oauth2/token", {
+          grant_type: "refresh_token",
+          client_id: p.client_id,
+          refresh_token: Redacted.value(tokens.refresh_token),
+          resource: p.resource,
+        });
+        expect(refreshed.status).toBe(200);
+        const legacy = yield* body(Started, yield* p.start({}));
+        expect((yield* p.approve(legacy.user_code)).status).toBe(200);
+        expect((yield* p.poll(legacy.device_code)).status).toBe(200);
+        const invalidProofs: ReadonlyArray<Record<string, string>> = [
+          { code_challenge: "x".repeat(43), code_challenge_method: "plain" },
+          { code_challenge: "short", code_challenge_method: "S256" },
+          { code_challenge: "x".repeat(43) },
+          { code_challenge_method: "S256" },
+        ];
+        for (const proof of invalidProofs)
+          expect(yield* p.errorOf(yield* p.start(proof))).toBe("invalid_request");
+      }),
+    ),
+  );
+
+  it.effect(scenarios.deviceCodeProofRestart.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const p = yield* protocol;
+        const approved = yield* body(Started, yield* p.start());
+        expect((yield* p.approve(approved.user_code)).status).toBe(200);
+        yield* serverControl("restart");
+        expect(yield* p.errorOf(yield* p.poll(approved.device_code))).toBe("invalid_grant");
+        expect((yield* p.poll(approved.device_code, { code_verifier: p.verifier })).status).toBe(
+          200,
+        );
+        const expired = yield* body(Started, yield* p.start());
+        yield* serverControl("stop");
+        yield* serverControl("clock/advance", 200, { milliseconds: 601_000 });
+        yield* serverControl("start");
+        expect(
+          yield* p.errorOf(yield* p.poll(expired.device_code, { code_verifier: p.verifier })),
+        ).toBe("expired_token");
+        expect(
+          yield* p.errorOf(yield* p.poll(expired.device_code, { code_verifier: p.verifier })),
+        ).toBe("invalid_grant");
+      }),
+    ),
+  );
+});
