@@ -0,0 +1,11 @@
+import * as Command from "alchemy/Command";
+import type { Input } from "alchemy/Input";
+
+/** Runtime URLs depend on this receipt, rather than resource declaration order. */
+export const databasePoolBudget = (id: string, database: Input<string>, branch: Input<string>) =>
+  Command.Exec(id, {
+    command: "node scripts/database-pool-budget.ts",
+    env: { POOL_BUDGET_DATABASE: database, POOL_BUDGET_BRANCH: branch },
+    memo: false,
+    timeout: "7 minutes",
+  });
