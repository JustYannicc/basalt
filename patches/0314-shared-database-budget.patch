index 0000000..e24cdea
--- /dev/null
+++ b/apps/hosted/cloud/scripts/database-pool-budget.ts
@@ -0,0 +1,91 @@
+import * as NodeRuntime from "@effect/platform-node/NodeRuntime";
+import { Config, Effect, Redacted, Schedule, Schema } from "effect";
+import { FetchHttpClient, HttpClient, HttpClientRequest } from "effect/http";
+import { databasePoolParameters } from "../src/infrastructure/database-pool-policy.ts";
+
+class PoolBudgetFailed extends Schema.TaggedError<PoolBudgetFailed>()("PoolBudgetFailed", {
+  message: Schema.String,
+}) {}
+const Parameters = Schema.Array(
+  Schema.Struct({ namespace: Schema.String, name: Schema.String, value: Schema.String }),
+);
+const Change = Schema.Struct({ id: Schema.String, state: Schema.String });
+const Changes = Schema.Struct({ data: Schema.Array(Change) });
+
+export const configureDatabasePoolBudget = Effect.gen(function* () {
+  const organization = yield* Config.NonEmptyString("PLANETSCALE_ORGANIZATION");
+  const database = yield* Config.NonEmptyString("POOL_BUDGET_DATABASE");
+  const branch = yield* Config.NonEmptyString("POOL_BUDGET_BRANCH");
+  const id = yield* Config.Redacted("PLANETSCALE_API_TOKEN_ID");
+  const token = yield* Config.Redacted("PLANETSCALE_API_TOKEN");
+  if (branch !== "main" && !/^test-[a-z0-9-]+$/.test(branch))
+    return yield* new PoolBudgetFailed({
+      message: "The database budget requires main or an isolated test branch",
+    });
+  const client = yield* HttpClient.HttpClient;
+  const base = `https://api.planetscale.com/v1/organizations/${encodeURIComponent(organization)}/databases/${encodeURIComponent(database)}/branches/${encodeURIComponent(branch)}`;
+  const send = (request: HttpClientRequest.HttpClientRequest) =>
+    Effect.gen(function* () {
+      const response = yield* client.execute(
+        HttpClientRequest.setHeader(
+          request,
+          "authorization",
+          `${Redacted.value(id)}:${Redacted.value(token)}`,
+        ),
+      );
+      if (response.status !== 200)
+        return yield* new PoolBudgetFailed({ message: `PlanetScale returned ${response.status}` });
+      return yield* response.json;
+    }).pipe(
+      Effect.catchTag("HttpClientError", () =>
+        Effect.fail(new PoolBudgetFailed({ message: "PlanetScale request failed" })),
+      ),
+    );
+  const parameters = () =>
+    send(HttpClientRequest.get(`${base}/parameters`)).pipe(
+      Effect.flatMap(Schema.decodeUnknownEffect(Parameters)),
+    );
+  const matches = (rows: typeof Parameters.Type) =>
+    Object.entries(databasePoolParameters).every(([name, value]) =>
+      rows.some((row) => row.namespace === "pgbouncer" && row.name === name && row.value === value),
+    );
+  const current = yield* parameters();
+  if (
+    !current.some(
+      (row) =>
+        row.namespace === "pgbouncer" && row.name === "pool_mode" && row.value === "transaction",
+    )
+  )
+    return yield* new PoolBudgetFailed({
+      message: "The database budget requires transaction pooling",
+    });
+  if (matches(current)) return;
+  const change = yield* send(
+    yield* HttpClientRequest.patch(`${base}/changes`).pipe(
+      HttpClientRequest.bodyJson({ parameters: { pgbouncer: databasePoolParameters } }),
+    ),
+  ).pipe(Effect.flatMap(Schema.decodeUnknownEffect(Change)));
+  // PlanetScale reloads the managed pooler. Warm server retirement is verified after deployment.
+  yield* send(HttpClientRequest.get(`${base}/changes`)).pipe(
+    Effect.flatMap(Schema.decodeUnknownEffect(Changes)),
+    Effect.flatMap(({ data }) => {
+      const state = data.find((entry) => entry.id === change.id)?.state;
+      return state === "completed"
+        ? Effect.void
+        : Effect.fail(
+            new PoolBudgetFailed({ message: `PgBouncer change is ${state ?? "missing"}` }),
+          );
+    }),
+    Effect.retry({ schedule: Schedule.spaced("5 seconds"), times: 60 }),
+  );
+  if (!matches(yield* parameters()))
+    return yield* new PoolBudgetFailed({ message: "PgBouncer budget readback did not match" });
+});
+
+if (import.meta.main)
+  NodeRuntime.runMain(
+    configureDatabasePoolBudget.pipe(
+      Effect.timeout("6 minutes"),
+      Effect.provide(FetchHttpClient.layer),
+    ),
+  );
