+/** One local transaction pooler fronts both logical databases; limits span every runtime login. */
+export const databaseBackendBudget = 5;
+export const retirement = { lifetimeSeconds: 60, idleSeconds: 15, verificationMs: 90_000 } as const;
+export const databasePoolParameters = {
+  default_pool_size: String(databaseBackendBudget),
+  max_db_connections: String(databaseBackendBudget),
+  min_pool_size: "0",
+  reserve_pool_size: "0",
+  server_lifetime: String(retirement.lifetimeSeconds),
+  server_idle_timeout: String(retirement.idleSeconds),
+} as const;
