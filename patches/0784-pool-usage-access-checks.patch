diff --git a/e2e/tests/pool-usage-access-checks.spec.ts b/e2e/tests/pool-usage-access-checks.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/pool-usage-access-checks.spec.ts
@@ -0,0 +1,160 @@
+import { expect, layer } from "@effect/vitest";
+import { Clock, Effect } from "effect";
+import { randomUUID } from "node:crypto";
+import { Actors } from "../support/actors.ts";
+import { Api } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Evidence } from "../support/evidence.ts";
+import { legacyPoolHome } from "../support/legacy-pool-home.ts";
+import {
+  installLegacyPoolHandoffSetup,
+  legacyPoolHandoffFixture,
+} from "../support/legacy-pool-handoff-setup.ts";
+import { Target } from "../support/platform.ts";
+import { poolHistoryDatabase } from "../support/pool-history-database.ts";
+import { poolWorkerRuntime } from "../support/pool-worker-runtime.ts";
+import { openPrivateApp, waitForAppUrl } from "../support/app-pages.ts";
+import { sqlWireProof } from "../support/sql-wire-proof.ts";
+import { scenarios } from "../test-plan.ts";
+
+/** Account policy reads: one per batch, never one per account. */
+const policyRead = /from hosted_account_access p/i;
+
+layer(HostedLive, { excludeTestServices: true })(
+  "Pool usage reads check account access once",
+  (it) => {
+    installLegacyPoolHandoffSetup({ nativeSources: true });
+    it.effect(scenarios.poolUsageAccessChecks.title, (context) =>
+      withHostedCase(
+        context,
+        Effect.gen(function* () {
+          const api = yield* Api,
+            actors = yield* Actors,
+            target = yield* Target,
+            browser = yield* Browser,
+            evidence = yield* Evidence;
+          const wire = yield* sqlWireProof;
+          const { pool, accounts } = legacyPoolHandoffFixture(context);
+          const home = yield* legacyPoolHome(
+            pool.id,
+            ["codex", "claude", "claude", "claude", "xai"].map((provider, index) => ({
+              id: `synthetic-cloud-native-reference-${index + 1}`,
+              provider,
+            })),
+          );
+          const history = yield* poolHistoryDatabase;
+          const worker = yield* poolWorkerRuntime(
+            target.metadata.origin,
+            home.origin,
+            history.connection,
+          );
+          const peer = (origin: string | null) =>
+            api.request(actors.owner, "POST", "/native-provider-fixture/product-peer", {
+              pool: pool.id,
+              origin,
+            });
+          expect((yield* peer(worker.origin)).status).toBe(200);
+          yield* Effect.addFinalizer(() => peer(null).pipe(Effect.asVoid, Effect.orDie));
+          expect((yield* worker.operations("/model-history/schema/catalog")).status).toBe(200);
+          yield* history.applySchema;
+
+          const path = `/api/organizations/${actors.organization.id}/apps/${pool.id}`;
+          const ids = accounts.map((account) => account.id);
+          expect(ids.length).toBeGreaterThan(1);
+          const now = yield* Clock.currentTimeMillis;
+          const iso = (at: number) => new Date(at).toISOString();
+          const week = { from: iso(now - 7 * 86_400_000), to: iso(now) };
+          yield* browser.login(actors.owner);
+          yield* browser.use("Keep reads explicit", (page) =>
+            page.route("**/*.js", (route) => route.abort()),
+          );
+          yield* openPrivateApp(yield* waitForAppUrl(actors.owner, `${path}/ui`));
+
+          const reads = {
+            // The Accounts tab's reads name every visible account.
+            series: (traceparent: string) =>
+              api
+                .request(
+                  actors.owner,
+                  "POST",
+                  `${path}/pool-usage/series`,
+                  { ...week, bucket: "day", by: ["account"], accounts: ids },
+                  { traceparent },
+                )
+                .pipe(Effect.map((response) => response.status)),
+            lastSuccess: (traceparent: string) =>
+              api
+                .request(
+                  actors.owner,
+                  "POST",
+                  `${path}/pool-usage/last-success`,
+                  { accounts: ids },
+                  { traceparent },
+                )
+                .pipe(Effect.map((response) => response.status)),
+            // The overview's summary names none; it inspects every account in the pool.
+            summary: (traceparent: string) =>
+              browser.use("Overview summary", (page) =>
+                page.evaluate(
+                  ({ input, traceparent }) => {
+                    const context = JSON.parse(
+                      document.getElementById("executor-context")?.textContent ?? "{}",
+                    );
+                    return fetch("/_executor/api/pool-usage/summary", {
+                      method: "POST",
+                      credentials: "same-origin",
+                      headers: { "content-type": "application/json", traceparent },
+                      body: JSON.stringify({
+                        version: context.version ?? context.deployment,
+                        input,
+                      }),
+                    }).then((response) => response.status);
+                  },
+                  { input: week, traceparent },
+                ),
+              ),
+          };
+          const counted: Record<string, { status: number; statements: number; policy: number }> =
+            {};
+          for (const [name, read] of Object.entries(reads)) {
+            const trace = randomUUID().replaceAll("-", "");
+            yield* wire.begin(0);
+            const status = yield* read(`00-${trace}-${trace.slice(0, 16)}-01`);
+            yield* wire.end(trace);
+            const statements = wire.global().filter((item) => item.trace === trace);
+            counted[name] = {
+              status,
+              statements: statements.length,
+              policy: statements.filter((item) => policyRead.test(item.query)).length,
+            };
+          }
+          yield* evidence.json("access-checks.json", { accounts: ids.length, counted });
+          // Requested accounts and the pool's accounts are each checked in one read, so the work
+          // no longer grows with the number of accounts.
+          expect(counted.series).toMatchObject({ status: 200, policy: 2 });
+          expect(counted.lastSuccess).toMatchObject({ status: 200, policy: 2 });
+          expect(counted.summary).toMatchObject({ status: 200, policy: 1 });
+
+          // The administrator may inspect none of the owner's (personal) accounts: naming them must
+          // refuse the read, and reading the whole pool must still answer. Which pool account ids the
+          // answer carries is not checked here.
+          const admin = (body: unknown) =>
+            api
+              .request(
+                actors.admin,
+                "POST",
+                `${path}/pool-usage/${body === undefined ? "series" : "last-success"}`,
+                body ?? { ...week, bucket: "day", by: ["account"] },
+              )
+              .pipe(Effect.map((response) => response.status));
+          const refused = yield* admin({ accounts: ids });
+          const wholePool = yield* admin(undefined);
+          yield* evidence.json("access-checks-admin.json", { refused, wholePool });
+          expect(refused).toBe(403);
+          expect(wholePool).toBe(200);
+        }),
+      ),
+    );
+  },
+);
