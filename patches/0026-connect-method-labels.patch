diff --git a/packages/ui/src/implementation/dashboard/method-labels.ts b/packages/ui/src/implementation/dashboard/method-labels.ts
new file mode 100644
index 0000000..df2cbf8
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/method-labels.ts
@@ -0,0 +1,51 @@
+/**
+ * The label each sign-in method shows in a connect form. A lone OAuth method signs in with the
+ * service; key and token methods keep their app's label. Methods that would share a label each
+ * add what tells them apart, such as a region, so no two methods ever read the same.
+ */
+
+/** What tells a method from its others: its name without an OAuth prefix, in words. */
+export const methodVariant = (name: string) => {
+  const words = name
+    .replace(/^oauth2?/i, "")
+    .replace(/[_-]+/g, " ")
+    .replace(/([a-z])([A-Z])/g, "$1 $2")
+    .trim()
+    .split(/\s+/)
+    .filter((word) => word !== "");
+  if (words.length === 0) return "OAuth";
+  // A lone short code such as a region (`oauthEu`, `us1`) reads in capitals.
+  if (words.length === 1 && /^[a-z]{2}\d*$/i.test(words[0]!)) return words[0]!.toUpperCase();
+  return words
+    .map((word) => (/^oauth$/i.test(word) ? "OAuth" : word[0]!.toUpperCase() + word.slice(1)))
+    .join(" ");
+};
+
+/** Labels by method name, in the order given; every label is distinct. */
+export const methodLabels = (
+  provider: string,
+  methods: ReadonlyArray<readonly [string, { readonly type: string; readonly label?: string }]>,
+): ReadonlyMap<string, string> => {
+  const base = methods.map(
+    ([name, auth]) =>
+      [
+        name,
+        auth.type === "oauth2" || auth.label === undefined
+          ? `Sign in with ${provider}`
+          : auth.label,
+      ] as const,
+  );
+  const count = (labels: ReadonlyArray<readonly [string, string]>, label: string) =>
+    labels.filter(([, other]) => other === label).length;
+  const qualified = base.map(
+    ([name, label]) =>
+      [name, count(base, label) > 1 ? `${label} (${methodVariant(name)})` : label] as const,
+  );
+  // Names that read alike, such as `oauth` and `oauth2`, fall back to the method's own name.
+  return new Map(
+    qualified.map(([name, label]) => [
+      name,
+      count(qualified, label) > 1 ? `${label} [${name}]` : label,
+    ]),
+  );
+};
