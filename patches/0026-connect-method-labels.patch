@@ -31,4 +31,23 @@ import { useProductBrand } from "../hooks/product-brand.ts";
 import { siteCredentialHosts } from "@executor-js/utils/account-site";
 
+/**
+ * What tells one OAuth method of a service from its others, such as a region: the method's name
+ * without its OAuth prefix, with two-letter codes such as regions in capitals.
+ */
+const methodVariant = (name: string) => {
+  const words = name
+    .replace(/^oauth2?/i, "")
+    .replace(/[_-]+/g, " ")
+    .replace(/([a-z])([A-Z])/g, "$1 $2")
+    .trim();
+  if (words === "") return "OAuth";
+  return words
+    .split(/\s+/)
+    .map((word) =>
+      word.length === 2 ? word.toUpperCase() : word[0]!.toUpperCase() + word.slice(1),
+    )
+    .join(" ");
+};
+
