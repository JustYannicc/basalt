diff --git a/e2e/tests/pool-empty-home.spec.ts b/e2e/tests/pool-empty-home.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..738ea0c88fe5f379df03ad149f997cd689127633
--- /dev/null
+++ b/e2e/tests/pool-empty-home.spec.ts
@@ -0,0 +1,219 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Fiber, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { Evidence } from "../support/evidence.ts";
+import { driver, RuntimeLive, Target } from "../support/platform.ts";
+import { poolWorkerRuntime } from "../support/pool-worker-runtime.ts";
+import {
+  emptyHomeAccount,
+  homeSecret,
+  observedAt,
+  poolEmptyHome,
+  poolMessage,
+  unrelatedHomeAccount,
+} from "../support/pool-empty-home.ts";
+import { scenarios } from "../test-plan.ts";
+
+const View = Schema.Struct({
+  isOwner: Schema.Boolean,
+  accounts: Schema.Array(
+    Schema.Struct({
+      id: Schema.String,
+      observedAt: Schema.NullOr(Schema.String),
+      freshness: Schema.String,
+      windows: Schema.Array(Schema.Struct({ remainingRatio: Schema.NullOr(Schema.Number) })),
+    }),
+  ),
+  reading: Schema.Struct({
+    source: Schema.Literals(["snapshot", "live"]),
+    revalidationFailed: Schema.Boolean,
+    readAt: Schema.Struct({
+      membership: Schema.String,
+      credentials: Schema.optionalKey(Schema.String),
+      quota: Schema.optionalKey(Schema.String),
+    }),
+  }),
+});
+const credentials = "GET /v8/management/credentials";
+const quota = `GET /v8/management/quota/credentials/${emptyHomeAccount}`;
+
+layer(RuntimeLive, { excludeTestServices: true })("Empty Home pool reads", (it) => {
+  it.effect(scenarios.poolEmptyHome.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const actors = yield* Actors,
+          api = yield* Api,
+          target = yield* Target,
+          evidence = yield* Evidence;
+        const pool = `app_${crypto.randomUUID()}`;
+        const identities = yield* Effect.forEach(
+          [actors.owner, actors.member, actors.admin],
+          (actor) =>
+            api
+              .request(actor, "GET", "/api/viewer")
+              .pipe(
+                Effect.flatMap((response) =>
+                  body(Schema.Struct({ userId: Schema.String }), response),
+                ),
+              ),
+        );
+        const owner = identities[0]!.userId,
+          member = identities[1]!.userId,
+          outsider = identities[2]!.userId;
+        const home = yield* poolEmptyHome(pool);
+        const worker = yield* poolWorkerRuntime(target.metadata.origin, home.origin);
+        // This is a retained-token contract fixture, not a second account-link implementation.
+        const token = poolMessage("sbp1", { pool, owner, organization: actors.organization.id });
+        const headers = (user: string) => ({
+          authorization: `Bearer ${token}`,
+          "x-signalbox-caller": user,
+        });
+        const signed = (path: string, kind: string, value: object) => {
+          const at = Date.now();
+          return worker.request(path, {
+            method: "POST",
+            headers: { "content-type": "application/json" },
+            body: JSON.stringify({
+              envelope: poolMessage(kind, { ...value, at, expiresAt: at + 30_000 }),
+            }),
+          });
+        };
+        const audience = (users: readonly string[]) =>
+          signed("/pool/v1/access", "sba1", {
+            action: "audience",
+            pools: [
+              {
+                pool,
+                owner,
+                organization: actors.organization.id,
+                name: "Empty Home test pool",
+                authorization: "executor-app-v1",
+                users,
+                managers: [owner],
+              },
+            ],
+          });
+        const invalidate = () =>
+          signed("/pool/v1/membership", "sbm1", {
+            pool,
+            organization: actors.organization.id,
+          });
+        const timings: { phase: string; durationMs: number }[] = [];
+        const read = (user: string, phase: string, fresh = true) =>
+          Effect.gen(function* () {
+            const started = performance.now();
+            const response = yield* worker.request(`/pool/v1/pool${fresh ? "?fresh=true" : ""}`, {
+              headers: headers(user),
+            });
+            expect(response.status).toBe(200);
+            const raw = yield* driver("read public pool view", () => response.text());
+            timings.push({ phase, durationMs: performance.now() - started });
+            expect(raw).not.toContain(homeSecret);
+            expect(raw).not.toContain(unrelatedHomeAccount);
+            expect(raw).not.toContain("Unrelated private label");
+            return yield* Schema.decodeUnknownEffect(Schema.fromJsonString(View))(raw);
+          });
+        expect((yield* audience([owner, member])).status).toBe(200);
+        yield* home.credentialsAvailable(false);
+        yield* home.clearCalls;
+        const empty = yield* read(owner, "empty-fresh");
+        expect(
+          (yield* home.calls).filter((call) => call === credentials).length,
+        ).toBeLessThanOrEqual(1);
+        expect((yield* home.calls).some((call) => call.includes("/quota/credentials/"))).toBe(
+          false,
+        );
+        expect(empty.accounts).toEqual([]);
+        expect(empty.reading.source).toBe("live");
+        expect(Number.isFinite(Date.parse(empty.reading.readAt.membership))).toBe(true);
+        expect(empty.reading.readAt).not.toHaveProperty("credentials");
+        expect(empty.reading.readAt).not.toHaveProperty("quota");
+        expect((yield* read(member, "empty-member")).isOwner).toBe(false);
+        expect(empty.isOwner).toBe(true);
+        const beforeDenied = yield* home.calls;
+        expect(
+          (yield* worker.request("/pool/v1/pool", { headers: headers(outsider) })).status,
+        ).toBe(403);
+        expect(
+          (yield* worker.request(`/pool/v1/accounts/${emptyHomeAccount}`, {
+            method: "DELETE",
+            headers: headers(member),
+          })).status,
+        ).toBe(403);
+        expect(
+          (yield* worker.request("/pool/v1/pool", {
+            headers: {
+              authorization: "Bearer invalid",
+              "x-signalbox-caller": owner,
+            },
+          })).status,
+        ).toBe(401);
+        expect(yield* home.calls).toEqual(beforeDenied);
+
+        // Home owns actual channel membership; its signed reservation invalidates the old empty view.
+        yield* home.credentialsAvailable(true);
+        yield* home.link;
+        expect((yield* invalidate()).status).toBe(204);
+        yield* home.clearCalls;
+        const held = yield* home.hold;
+        const pending = yield* read(owner, "linked-live", false).pipe(Effect.forkChild);
+        yield* Effect.all([held.credentials, held.quota], { concurrency: 2 });
+        yield* held.release;
+        const linked = yield* Fiber.join(pending);
+        expect(linked.reading.source).toBe("live");
+        expect(linked.accounts.map((account) => account.id)).toEqual([emptyHomeAccount]);
+        expect(linked.accounts[0]!.observedAt).toBe(observedAt);
+        expect(linked.accounts[0]!.windows[0]!.remainingRatio).toBe(0.75);
+        expect(Number.isFinite(Date.parse(linked.reading.readAt.credentials ?? ""))).toBe(true);
+        expect(Number.isFinite(Date.parse(linked.reading.readAt.quota ?? ""))).toBe(true);
+        expect((yield* home.calls).filter((call) => call === credentials)).toHaveLength(1);
+        expect((yield* home.calls).filter((call) => call === quota)).toHaveLength(1);
+        expect(
+          (yield* home.calls).some((call) =>
+            call.includes(`/quota/credentials/${unrelatedHomeAccount}`),
+          ),
+        ).toBe(false);
+        yield* home.remaining(0.25);
+        const reread = yield* read(member, "linked-fresh");
+        expect(reread.accounts[0]!.windows[0]!.remainingRatio).toBe(0.25);
+        expect(reread.accounts[0]!.observedAt).toBe(observedAt);
+        expect((yield* home.calls).filter((call) => call === credentials)).toHaveLength(2);
+        expect((yield* home.calls).filter((call) => call === quota)).toHaveLength(2);
+
+        // Unlink retains both global accounts and makes the populated saved view unusable immediately.
+        yield* home.unlink;
+        expect((yield* invalidate()).status).toBe(204);
+        yield* home.credentialsAvailable(false);
+        yield* home.clearCalls;
+        const unlinked = yield* read(owner, "unlinked-live", false);
+        expect(unlinked.reading.source).toBe("live");
+        expect(unlinked.accounts).toEqual([]);
+        expect(unlinked.reading.readAt).not.toHaveProperty("credentials");
+        expect(unlinked.reading.readAt).not.toHaveProperty("quota");
+        expect(
+          (yield* home.calls).filter((call) => call === credentials).length,
+        ).toBeLessThanOrEqual(1);
+        expect((yield* home.calls).includes(quota)).toBe(false);
+        const retained = yield* read(member, "empty-snapshot", false);
+        expect(retained.reading.source).toBe("snapshot");
+        expect(retained.reading.readAt).toEqual(unlinked.reading.readAt);
+        expect(retained.accounts).toEqual([]);
+        expect((yield* audience([owner])).status).toBe(200);
+        expect((yield* worker.request("/pool/v1/pool", { headers: headers(member) })).status).toBe(
+          403,
+        );
+        yield* evidence.json("pool-empty-home-public-proof.json", {
+          timings,
+          calls: yield* home.calls,
+          emptyIndependentOfCredentialFailure: true,
+          credentialReadMayStartSpeculatively: true,
+          nonemptyReadsConcurrent: true,
+          retainedSnapshotInvalidatedOnLinkAndUnlink: true,
+        });
+      }),
+    ),
+  );
+});
