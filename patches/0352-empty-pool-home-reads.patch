@@ -0,0 +1,183 @@
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Deferred, Effect, Layer, Ref, Schema } from "effect";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { createHmac } from "node:crypto";
+import { createServer } from "node:http";
+
+const key = Buffer.from("ab".repeat(32), "hex");
+export const poolMessage = (kind: string, value: unknown) => {
+  const signed = `${kind}.${Buffer.from(JSON.stringify(value)).toString("base64url")}`;
+  return `${signed}.${createHmac("sha256", key).update(signed).digest("base64url")}`;
+};
+export const emptyHomeAccount = "synthetic-linked-account";
+export const unrelatedHomeAccount = "synthetic-unrelated-account";
+export const homeSecret = "synthetic-private-home-secret";
+export const observedAt = "2026-11-01T12:00:00.000Z";
+
+/** Only Home's external HTTP and container lifecycle are synthetic. Worker policy stays real. */
+export const poolEmptyHome = (pool: string) =>
+  Effect.gen(function* () {
+    const calls = yield* Ref.make<readonly string[]>([]);
+    let linked = false;
+    let remaining = 0.75;
+    let credentialsAvailable = true;
+    const users: { id: number; username: string }[] = [];
+    let gate:
+      | {
+          credentials: Deferred.Deferred<void>;
+          quota: Deferred.Deferred<void>;
+          release: Deferred.Deferred<void>;
+        }
+      | undefined;
+    const handler = Effect.gen(function* () {
+      const request = yield* HttpServerRequest.HttpServerRequest;
+      const url = new URL(request.url, "http://home.test");
+      const path = url.pathname;
+      yield* Ref.update(calls, (items) => [...items, `${request.method} ${path}`]);
+      if (path === "/ready")
+        return HttpServerResponse.jsonUnsafe({
+          boot_id: "synthetic-home-boot",
+          started_at: observedAt,
+        });
+      if (path === "/native-policy") {
+        const body = yield* request.json.pipe(
+          Effect.flatMap(Schema.decodeUnknownEffect(Schema.Struct({ projection: Schema.String }))),
+        );
+        const [kind, encoded] = body.projection.split(".");
+        if (kind !== "sbm-policy1" || encoded === undefined)
+          return HttpServerResponse.empty({ status: 401 });
+        const signed = `${kind}.${encoded}`;
+        const expected = `${signed}.${createHmac("sha256", key).update(signed).digest("base64url")}`;
+        if (expected !== body.projection) return HttpServerResponse.empty({ status: 401 });
+        const value = yield* Schema.decodeUnknownEffect(
+          Schema.fromJsonString(Schema.Struct({ revision: Schema.Number })),
+        )(Buffer.from(encoded, "base64url").toString());
+        return HttpServerResponse.jsonUnsafe({ installed: true, revision: value.revision });
+      }
+      if (request.headers["x-management-key"] !== "synthetic-management-key")
+        return HttpServerResponse.empty({ status: 401 });
+      if (path === "/v8/management/users") {
+        if (request.method === "POST") {
+          const user = yield* request.json.pipe(
+            Effect.flatMap(Schema.decodeUnknownEffect(Schema.Struct({ username: Schema.String }))),
+          );
+          users.push({ id: users.length + 1, username: user.username });
+        }
+        return HttpServerResponse.jsonUnsafe({ users });
+      }
+      if (path === "/v8/management/channel-groups")
+        return HttpServerResponse.jsonUnsafe({
+          channel_groups: [
+            { id: 1, channel_name: `signalbox-pool-${pool}` },
+            { id: 2, channel_name: "signalbox-pool-unrelated" },
+          ],
+        });
+      if (path === "/v8/management/channel-group-details") {
+        const group = url.searchParams.get("channel_group_id");
+        return HttpServerResponse.jsonUnsafe({
+          channel_group_details:
+            group === "2"
+              ? [{ id: 2, channel_group_id: 2, auth_id: unrelatedHomeAccount }]
+              : linked
+                ? [{ id: 1, channel_group_id: 1, auth_id: emptyHomeAccount }]
+                : [],
+        });
+      }
+      if (path === "/v8/management/credentials") {
+        const held = gate;
+        if (held) {
+          yield* Deferred.succeed(held.credentials, undefined);
+          yield* Deferred.await(held.release);
+        }
+        if (!credentialsAvailable) return HttpServerResponse.empty({ status: 503 });
+        return HttpServerResponse.jsonUnsafe({
+          files: [
+            {
+              id: emptyHomeAccount,
+              provider: "codex",
+              label: "Selected account",
+              token: homeSecret,
+            },
+            {
+              id: unrelatedHomeAccount,
+              provider: "codex",
+              label: "Unrelated private label",
+              token: homeSecret,
+            },
+          ],
+        });
+      }
+      if (path === `/v8/management/quota/credentials/${emptyHomeAccount}`) {
+        const held = gate;
+        if (held) {
+          yield* Deferred.succeed(held.quota, undefined);
+          yield* Deferred.await(held.release);
+        }
+        return HttpServerResponse.jsonUnsafe({
+          credential: { credential_id: emptyHomeAccount, token: homeSecret },
+          windows: [
+            {
+              id: "five-hour",
+              scope: "account",
+              scope_id: "codex",
+              window_seconds: 18_000,
+              remaining_ratio: remaining,
+              observed_at: observedAt,
+            },
+          ],
+          collection: { status: "success", freshness: "fresh", observed_at: observedAt },
+          reset_credits: null,
+        });
+      }
+      return HttpServerResponse.jsonUnsafe({ error: "unexpected_home_request" }, { status: 404 });
+    });
+    const services = yield* Layer.build(
+      HttpRouter.serve(HttpRouter.add("*", "/*", handler), {
+        disableLogger: true,
+        disableListenLog: true,
+      }).pipe(
+        Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 })),
+      ),
+    );
+    const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+    if (!("port" in server.address)) return yield* Effect.die("Home fixture requires TCP");
+    return {
+      origin: `http://127.0.0.1:${server.address.port}`,
+      calls: Ref.get(calls),
+      clearCalls: Ref.set(calls, []),
+      link: Effect.sync(() => {
+        linked = true;
+      }),
+      unlink: Effect.sync(() => {
+        linked = false;
+      }),
+      remaining: (value: number) =>
+        Effect.sync(() => {
+          remaining = value;
+        }),
+      credentialsAvailable: (value: boolean) =>
+        Effect.sync(() => {
+          credentialsAvailable = value;
+        }),
+      hold: Effect.gen(function* () {
+        const held = {
+          credentials: yield* Deferred.make<void>(),
+          quota: yield* Deferred.make<void>(),
+          release: yield* Deferred.make<void>(),
+        };
+        gate = held;
+        yield* Effect.addFinalizer(() => Deferred.succeed(held.release, undefined));
+        return {
+          credentials: Deferred.await(held.credentials),
+          quota: Deferred.await(held.quota),
+          release: Deferred.succeed(held.release, undefined).pipe(
+            Effect.tap(() =>
+              Effect.sync(() => {
+                if (gate === held) gate = undefined;
+              }),
+            ),
+          ),
+        };
+      }),
+    };
+  });
