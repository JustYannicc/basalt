diff --git a/e2e/tests/query-hold.spec.ts b/e2e/tests/query-hold.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/query-hold.spec.ts
@@ -0,0 +1,69 @@
+/** The query hold against a real browser page and a local server, without a product target. */
+import { expect, layer } from "@effect/vitest";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { Effect } from "effect";
+import {
+  browserOn,
+  heldReadReport,
+  holdFixturePage,
+  holdFixtureServer,
+  sendFrom,
+  sendFromNow,
+  unanswered,
+} from "../support/query-hold-fixture.ts";
+import { holdQuery } from "../support/query-transition.ts";
+
+layer(NodeServices.layer, { excludeTestServices: true })("Query hold", (it) => {
+  it.effect("removing a hold leaves no request unanswered, held or sent while it is removed", () =>
+    Effect.gen(function* () {
+      const { origin } = yield* holdFixtureServer;
+      const page = yield* holdFixturePage(origin);
+      // Each round holds three reads, releases them while an unrelated read is sent, and
+      // removes the hold. Before the hold kept the page intercepting, 300 rounds always met a
+      // read that never got an answer, at round 55 to 100 in eight runs.
+      for (let round = 0; round < 300; round++) {
+        const held = [1, 2, 3].map((n) => `/held/${round}-${n}`);
+        const other = `/other/${round}`;
+        yield* Effect.scoped(
+          Effect.gen(function* () {
+            yield* holdQuery(/^\/held\//, "continue", { method: "POST", allRequests: true });
+            yield* sendFrom(page, held);
+            // Finalizers run last-added first: this starts the unrelated read just before the
+            // hold's own finalizer releases and removes the hold, so it is in flight meanwhile.
+            yield* Effect.addFinalizer(() => sendFromNow(page, [other]));
+          }),
+        ).pipe(Effect.provide(browserOn(page)));
+        expect(
+          yield* unanswered(page, [...held, other]),
+          `round ${round}: requests that never answered`,
+        ).toEqual([]);
+      }
+    }).pipe(Effect.scoped),
+  );
+
+  it.effect("a held read's error answer and a read that never answers are named apart", () =>
+    Effect.gen(function* () {
+      const { origin } = yield* holdFixtureServer;
+      const page = yield* holdFixturePage(origin);
+      const report = (path: string) =>
+        Effect.scoped(
+          Effect.gen(function* () {
+            const hold = yield* holdQuery([path], "continue", {
+              method: "POST",
+              allRequests: true,
+            });
+            yield* sendFrom(page, [path]);
+            yield* hold.requested;
+            return hold;
+          }),
+        ).pipe(
+          Effect.provide(browserOn(page)),
+          Effect.flatMap((hold) => heldReadReport(page, hold)),
+        );
+      expect(yield* report("/held/error")).toEqual({ held: "POST /held/error: answered 503" });
+      expect(yield* report("/held/never")).toEqual({
+        held: "POST /held/never: no answer (TimeoutError)",
+      });
+    }).pipe(Effect.scoped),
+  );
+});
