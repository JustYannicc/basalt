+/** A real browser page and a local server for proving the query hold without a product target. */
+import { Effect, Layer } from "effect";
+import { createServer } from "node:http";
+import type { AddressInfo } from "node:net";
+import { chromium, type Page } from "playwright";
+import { Browser } from "./browser.ts";
+import { driver } from "./platform.ts";
+import { whenHeldReadsAnswer } from "./query-transition.ts";
+
+/** Answers every POST after 20 ms, `/held/error` with 503, and never answers `/held/never`. */
+export const holdFixtureServer = Effect.acquireRelease(
+  Effect.callback<{ readonly origin: string; readonly close: () => void }>((resume) => {
+    const http = createServer((request, response) => {
+      if (request.url === "/") {
+        response.writeHead(200, { "content-type": "text/html" }).end("<p>page</p>");
+        return;
+      }
+      if (request.url === "/held/never") return;
+      setTimeout(() => {
+        response
+          .writeHead(request.url === "/held/error" ? 503 : 200, {
+            "content-type": "application/json",
+          })
+          .end("{}");
+      }, 20);
+    });
+    const close = () => {
+      http.closeAllConnections();
+      http.close();
+    };
+    http.listen(0, "127.0.0.1", () =>
+      resume(
+        Effect.succeed({
+          origin: `http://127.0.0.1:${(http.address() as AddressInfo).port}`,
+          close,
+        }),
+      ),
+    );
+    return Effect.sync(close);
+  }),
+  ({ close }) => Effect.sync(close),
+);
+
+/** One page of a fresh browser, open at `origin`. */
+export const holdFixturePage = (origin: string) =>
+  Effect.acquireRelease(
+    driver("Launch the hold's browser", () => chromium.launch()),
+    (browser) => driver("Close the hold's browser", () => browser.close()).pipe(Effect.orDie),
+  ).pipe(
+    Effect.flatMap((browser) => driver("Open the hold's page", () => browser.newPage())),
+    Effect.tap((page) => driver("Load the hold's page", () => page.goto(origin))),
+  );
+
+/** The hold drives this page directly; the scenario browser's capture is not part of this. */
+export const browserOn = (page: Page) =>
+  Layer.succeed(Browser, {
+    use: (label, action) => driver(label, () => action(page)),
+    login: () => Effect.void,
+    checkpoint: () => Effect.void,
+    omitNetworkTrace: Effect.void,
+  });
+
+const send = (page: Page, paths: readonly string[]) =>
+  page.evaluate((list) => {
+    const state = window as unknown as { done?: Record<string, number> };
+    state.done ??= {};
+    for (const path of list)
+      void fetch(path, { method: "POST" }).then((response) => {
+        state.done![path] = response.status;
+      });
+  }, paths);
+
+/** Send POSTs from the page without waiting for them; the page records each answer's status. */
+export const sendFrom = (page: Page, paths: readonly string[]) =>
+  driver("Send reads from the page", () => send(page, paths));
+
+/**
+ * The same, without waiting for the page to start them: they leave while whatever runs next does,
+ * as a page's own reads do when a hold is released.
+ */
+export const sendFromNow = (page: Page, paths: readonly string[]) =>
+  Effect.sync(() => {
+    void send(page, paths).catch(() => undefined);
+  });
+
+/** The paths still without an answer once every one answered, or after five seconds. */
+export const unanswered = (page: Page, paths: readonly string[]) =>
+  driver("Wait for the reads' answers", () =>
+    page
+      .waitForFunction(
+        (list) => {
+          const done = (window as unknown as { done?: Record<string, number> }).done ?? {};
+          return list.every((path) => path in done);
+        },
+        paths,
+        { timeout: 5_000 },
+      )
+      .then(
+        () => [],
+        () =>
+          page.evaluate((list) => {
+            const done = (window as unknown as { done?: Record<string, number> }).done ?? {};
+            return list.filter((path) => !(path in done));
+          }, paths),
+      ),
+  );
+
+/** What a step would report for a held read when the page never shows its answer. */
+export const heldReadReport = (page: Page, hold: Parameters<typeof whenHeldReadsAnswer>[0]) =>
+  driver("Report the held read", () =>
+    whenHeldReadsAnswer(hold, page.locator("#never-shown").waitFor({ timeout: 2_000 })),
+  );
