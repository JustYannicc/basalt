new file mode 100644
index 0000000..aef0bae
--- /dev/null
+++ b/apps/hosted/server/src/implementation/account-identity.ts
@@ -0,0 +1,217 @@
+/** Redact at the host boundary, before a dashboard or an API caller receives account status. */
+import {
+  AccountId,
+  StorageError,
+  type Account,
+  type AccountHealth,
+  AppId,
+} from "@executor-js/sdk/core";
+import { Effect, Schema } from "effect";
+import { CurrentUserId } from "../contracts/auth.ts";
+import { CurrentOrganization } from "../contracts/organization.ts";
+import { accountHolders } from "./contributed-account-policy.ts";
+import {
+  accountAccesses,
+  applicationAccesses,
+  currentResourceAuthority,
+  policyDatabase,
+} from "./resource-policy.ts";
+
+/** Only a label copied from acquisition identity is private; typed names stay useful. */
+const redactAccount = (
+  account: Account,
+  identityLabels: ReadonlySet<string> | undefined,
+): Account => ({
+  ...account,
+  label: identityLabels?.has(account.label) ? "Connected account" : account.label,
+});
+
+/** Use retained acquisition identity only to find copied labels, never to authorize identity. */
+const acquisitionLabels = (accounts: readonly AccountId[]) =>
+  Effect.gen(function* () {
+    if (accounts.length === 0) return new Map<AccountId, Set<string>>();
+    const { owner } = yield* CurrentOrganization;
+    const sql = yield* policyDatabase;
+    const rows = yield* sql`select c.state::jsonb -> 'account' ->> 'id' as account,
+        c.state::jsonb -> 'interactive' -> 'accountInfo' as info
+      from executor_account_connections c
+      where c.owner = ${owner}
+        and c.state::jsonb ->> 'status' = 'completed'
+        and c.state::jsonb -> 'interactive' is not null
+        and c.state::jsonb -> 'account' ->> 'id' in ${sql.in(accounts)}`;
+    const acquired = yield* Schema.decodeUnknownEffect(
+      Schema.Array(
+        Schema.Struct({
+          account: AccountId,
+          info: Schema.NullOr(
+            Schema.Struct({
+              displayName: Schema.optionalKey(Schema.String),
+              username: Schema.optionalKey(Schema.String),
+              email: Schema.optionalKey(Schema.String),
+            }),
+          ),
+        }),
+      ),
+    )(rows);
+    const privateLabels = new Map<AccountId, Set<string>>();
+    for (const { account, info } of acquired) {
+      const label = (info?.displayName ?? info?.username ?? info?.email)?.trim().slice(0, 120);
+      const labels = privateLabels.get(account) ?? new Set<string>();
+      if (label) labels.add(label);
+      privateLabels.set(account, labels);
+    }
+    return privateLabels;
+  }).pipe(Effect.mapError(() => new StorageError()));
+
+export const redactAccountHealth = (health: AccountHealth): AccountHealth => ({
+  ...health,
+  info: null,
+  infoCheckedAt: null,
+  apps: health.apps.map((entry) => ({
+    ...entry,
+    check:
+      entry.check === null || entry.check.displayStatus === undefined
+        ? entry.check
+        : {
+            ...entry.check,
+            displayStatus: {
+              ...entry.check.displayStatus,
+              badges: [],
+              stats: [],
+            },
+          },
+  })),
+});
+
+/** Resolve the caller's own accounts once for a whole link list. */
+export const heldAccounts = (accounts: readonly AccountId[]) =>
+  Effect.gen(function* () {
+    const user = yield* CurrentUserId;
+    return new Set(
+      (yield* accountHolders(
+        yield* policyDatabase,
+        (yield* CurrentOrganization).organization,
+        accounts,
+      ))
+        .filter((row) => row.holder === user)
+        .map((row) => row.account),
+    );
+  });
+
+export const identityAccounts = (accounts: readonly AccountId[]) =>
+  Effect.gen(function* () {
+    const held = yield* heldAccounts(accounts);
+    const actor = yield* currentResourceAuthority;
+    const access = yield* accountAccesses(accounts, actor);
+    return new Set([
+      ...held,
+      ...access.filter((entry) => entry.canManage).map((entry) => entry.account),
+    ]);
+  });
+
+/**
+ * The apps each account is linked to for everyone. Their editors see its identity even where the
+ * read shows no check by those apps, such as directory lists.
+ */
+const appScopeLinks = (accounts: readonly AccountId[]) =>
+  Effect.gen(function* () {
+    if (accounts.length === 0) return new Map<AccountId, AppId[]>();
+    const sql = yield* policyDatabase;
+    const rows = yield* sql`select distinct account, app from hosted_app_account_links
+      where subject is null and account in ${sql.in(accounts)}`;
+    const links = yield* Schema.decodeUnknownEffect(
+      Schema.Array(Schema.Struct({ account: AccountId, app: AppId })),
+    )(rows);
+    const byAccount = new Map<AccountId, AppId[]>();
+    for (const { account, app } of links)
+      byAccount.set(account, [...(byAccount.get(account) ?? []), app]);
+    return byAccount;
+  }).pipe(Effect.mapError(() => new StorageError()));
+
+/** Batch identity policy for directory reads rather than looking it up once per account. */
+const visibleStatuses = (health: readonly AccountHealth[], apps: readonly AppId[] = []) =>
+  Effect.gen(function* () {
+    const ids = health.map((entry) => entry.account);
+    const held = yield* heldAccounts(ids);
+    const linked = yield* appScopeLinks(ids);
+    const privateLabels = yield* acquisitionLabels(ids);
+    const actor = yield* currentResourceAuthority;
+    const managers = new Set(
+      (yield* accountAccesses(ids, actor))
+        .filter((access) => access.canManage)
+        .map((access) => access.account),
+    );
+    const editors = new Set(
+      (yield* applicationAccesses(
+        [
+          ...new Set([
+            ...apps,
+            ...health.flatMap((entry) => entry.apps.map((app) => app.app)),
+            ...[...linked.values()].flat(),
+          ]),
+        ],
+        actor,
+      ))
+        .filter((access) => access.canManage)
+        .map((access) => access.app),
+    );
+    return health.map((entry) => {
+      const identityLabels = privateLabels.get(entry.account);
+      if (
+        held.has(entry.account) ||
+        managers.has(entry.account) ||
+        apps.some((app) => editors.has(app))
+      )
+        return { identity: true, identityLabels, health: entry };
+      const identity =
+        entry.apps.some((app) => editors.has(app.app)) ||
+        (linked.get(entry.account) ?? []).some((app) => editors.has(app));
+      const redacted = redactAccountHealth(entry);
+      return {
+        identity,
+        identityLabels,
+        health: {
+          ...redacted,
+          ...(identity ? { info: entry.info, infoCheckedAt: entry.infoCheckedAt } : {}),
+          apps: entry.apps.map((app, index) =>
+            editors.has(app.app) ? app : redacted.apps[index]!,
+          ),
+        },
+      };
+    });
+  });
+
+export const visibleAccountHealth = (health: AccountHealth) =>
+  visibleStatuses([health]).pipe(Effect.map(([entry]) => entry!.health));
+
+/** Hide copied upstream labels while preserving authored account names and descriptions. */
+export const visibleAccountStatuses = <
+  A extends { readonly account: Account; readonly health?: AccountHealth },
+>(
+  entries: readonly A[],
+  apps: readonly AppId[] = [],
+) =>
+  Effect.gen(function* () {
+    const visible = yield* visibleStatuses(
+      entries.map(
+        (entry) =>
+          entry.health ?? {
+            account: entry.account.id,
+            info: null,
+            infoCheckedAt: null,
+            apps: [],
+          },
+      ),
+      apps,
+    );
+    return entries.map((entry, index) => {
+      const checked = visible[index]!;
+      return {
+        ...entry,
+        account: checked.identity
+          ? entry.account
+          : redactAccount(entry.account, checked.identityLabels),
+        ...(entry.health === undefined ? {} : { health: checked.health }),
+      };
+    });
+  });
