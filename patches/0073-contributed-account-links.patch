@@ -0,0 +1,96 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { body } from "../support/api.ts";
+import { requirementPath } from "../support/app-accounts.ts";
+import { ok } from "../support/app-links.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { Contribution, contributedApp, contributedSource } from "../support/contributed-app.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Revision = Schema.Struct({ revision: Schema.String });
+
+layer(RuntimeLive, { excludeTestServices: true })("Contributed account access", (it) => {
+  it.effect(scenarios.contributedAppAccess.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* contributedApp;
+        const { api, actors, prefix, ids } = f;
+        const other = yield* f.another(contributedSource);
+        const otherLink = (account: string) =>
+          api.request(
+            actors.member,
+            "PUT",
+            `${requirementPath(other, "app", "shared")}/${account}`,
+          );
+        const otherLinks = () =>
+          api.request(actors.owner, "GET", `${other}/accounts/app`).pipe(
+            Effect.tap(ok),
+            Effect.flatMap((response) => body(Schema.Array(Contribution), response)),
+          );
+        const ordinary = yield* f.connect(
+          actors.owner,
+          "app",
+          "ordinary",
+          "Ordinary retained account",
+        );
+        const personal = yield* f.connect(actors.member, "app", "shared", "Reusable in two apps");
+        yield* ok(yield* otherLink(personal));
+        yield* ok(yield* f.unlink(actors.member, "shared", personal));
+        yield* ok(yield* api.request(actors.member, "GET", `${prefix}/accounts/${personal}`));
+        expect((yield* otherLinks()).map((link) => link.account.id)).toEqual([personal]);
+        const otherCall = () =>
+          api.request(actors.owner, "POST", `${other}/tools/call`, {
+            tool: "accounts",
+            kind: "query",
+            input: {},
+          });
+        expect((yield* otherCall()).body).toMatchObject({ shared: [personal] });
+        yield* ok(yield* f.link(actors.member, "shared", personal));
+
+        const group = yield* f.group([ids.owner, ids.member]);
+        const current = yield* body(
+          Revision,
+          yield* api.request(actors.owner, "GET", `${f.path}/access`),
+        );
+        yield* ok(
+          yield* api.request(actors.owner, "PATCH", `${f.path}/access`, {
+            revision: current.revision,
+            audience: { kind: "groups", groups: [group.id] },
+          }),
+        );
+        yield* group.set([ids.owner]);
+        yield* f.waitForLinks([ordinary]);
+        yield* ok(yield* api.request(actors.member, "GET", `${prefix}/access`));
+        yield* ok(yield* api.request(actors.member, "GET", `${prefix}/accounts/${personal}`));
+        expect((yield* otherCall()).body).toMatchObject({ shared: [personal] });
+        yield* group.set([ids.owner, ids.member]);
+        yield* ok(yield* f.link(actors.member, "shared", personal));
+        expect((yield* f.call(actors.owner, "accounts")).body).toMatchObject({
+          shared: [personal],
+        });
+
+        const accountGroup = yield* f.group([ids.owner, ids.member]);
+        const shared = yield* f.connect(actors.owner, "user", "own", "Shared reusable account", {
+          kind: "shared",
+          audience: { kind: "groups", groups: [accountGroup.id] },
+        });
+        yield* ok(yield* f.link(actors.member, "shared", shared));
+        yield* ok(yield* otherLink(shared));
+        yield* accountGroup.set([ids.owner]);
+        yield* f.waitForLinks([ordinary, personal]);
+        expect((yield* otherCall()).body).toMatchObject({ shared: [personal] });
+        expect(
+          (yield* api.request(actors.member, "GET", `${prefix}/accounts/${shared}`)).status,
+        ).toBe(403);
+        yield* ok(yield* api.request(actors.owner, "GET", `${prefix}/accounts/${shared}`));
+        yield* accountGroup.set([ids.owner, ids.member]);
+        yield* ok(yield* f.link(actors.member, "shared", shared));
+        expect((yield* f.call(actors.owner, "accounts")).body).toMatchObject({
+          shared: [personal, shared],
+        });
+      }),
+    ),
+  );
+});
