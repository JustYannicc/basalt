+/** Bound retained acquisition-identity reads by owner and the accounts being rendered. */
+import { Effect } from "effect";
+import { SqlClient } from "effect/sql";
+
+export const migrateAccountIdentityIndex = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  yield* sql`create index if not exists hosted_account_connection_identity
+    on executor_account_connections (owner, ((state::jsonb -> 'account') ->> 'id'))
+    where state::jsonb ->> 'status' = 'completed' and state::jsonb -> 'interactive' is not null`;
+});
