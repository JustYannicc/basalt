@@ -0,0 +1,64 @@
+/** Authored app input for the hosted connection isolation scenarios. */
+export const interactiveIsolationSource = (
+  legacyOrigin: string,
+  backendOrigin: string,
+  fault: "none" | "handler" | "output" = "none",
+) => `import {
+  defineApp, defineProvider, oauth2, interactive, secrets, bearer,
+  object, string, query, router,
+  type ConnectContext, type QueryContext, type InteractiveStart, type InteractiveStatus
+} from "apps";
+const legacy = defineProvider({
+  name: "Synthetic legacy AWS",
+  hosts: [${JSON.stringify(new URL(legacyOrigin).host)}],
+  auth: { oauth: oauth2({ discover: ${JSON.stringify(legacyOrigin + "/mcp")} }) },
+});
+const identityCenter = defineProvider({
+  name: "Synthetic Identity Center",
+  auth: {
+    device: interactive({ label: "Identity Center" }),
+    oauth: oauth2({ discover: ${JSON.stringify(legacyOrigin + "/mcp")} }),
+  },
+});
+const backend = defineProvider({
+  name: "Synthetic sign-in backend",
+  hosts: [${JSON.stringify(new URL(backendOrigin).host)}],
+  auth: { key: secrets({
+    label: "Key", fields: object({ token: string() }),
+    request: ({ token }) => bearer(token),
+  }) },
+});
+const requirements = {
+  app: { accounts: { backend } },
+  user: { accounts: { aws: legacy.many(), identityCenter: identityCenter.many() } },
+};
+const handlers = {
+  start: async (ctx: ConnectContext<typeof requirements>): Promise<InteractiveStart> => {
+    const account = ctx.app.accounts.backend;
+    if (account === undefined) throw new Error("Missing synthetic backend");
+    const response = await ctx.fetch(${JSON.stringify(backendOrigin + "/resource")}, {
+      headers: account.headers(), signal: ctx.signal,
+    });
+    if (!response.ok) throw new Error("Synthetic backend refused start");
+    ${fault === "handler" ? 'throw new Error("PRIVATE_INTERACTIVE_ERROR synthetic-backend-key");' : ""}
+    return {
+      session: ${JSON.stringify(fault === "output" ? "" : "private-session-identity-center")},
+      form: { submitLabel: "Continue", fields: [{ name: "startUrl", label: "Start URL", type: "url" }] },
+    };
+  },
+  status: async (): Promise<InteractiveStatus> => ({ state: "waiting" }),
+  cancel: async () => {},
+};
+const strict = query({ input: object({}) }, async (ctx: QueryContext<typeof requirements>) => {
+  for (const account of ctx.user.accounts.aws) {
+    const response = await ctx.fetch(${JSON.stringify(legacyOrigin + "/resource")}, {
+      headers: { authorization: "Bearer " + account.fields.access_token }, signal: ctx.signal,
+    });
+    if (!response.ok) throw new Error("Synthetic legacy resource refused read");
+  }
+  return { read: "legacy-readable" };
+});
+export default defineApp(requirements, {
+  tools: router({ strict }),
+  connect: { identityCenter: handlers },
+});`;
diff --git a/e2e/tests/interactive-account-isolation.spec.ts b/e2e/tests/interactive-account-isolation.spec.ts
new file mode 100644
index 0000000..82e82bc
--- /dev/null
+++ b/e2e/tests/interactive-account-isolation.spec.ts
@@ -0,0 +1,271 @@
+/** Hosted connection startup isolates unrelated OAuth failures and returns closed receipts. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Evidence } from "../support/evidence.ts";
+import { captureInteractiveIsolation } from "../support/interactive-isolation-browser.ts";
+import {
+  assertInteractivePrivate,
+  interactiveIsolationFixture,
+} from "../support/interactive-account-isolation.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Form = Schema.Struct({
+  form: Schema.Struct({
+    submitLabel: Schema.String,
+    fields: Schema.Array(
+      Schema.Struct({
+        name: Schema.String,
+        label: Schema.String,
+        type: Schema.String,
+      }),
+    ),
+  }),
+});
+const StrictFailure = Schema.Struct({
+  _tag: Schema.Literal("OAuthRenewalFailed"),
+  account: Schema.String,
+  reason: Schema.Literal("client_rejected"),
+  cause: Schema.Struct({
+    stage: Schema.Literal("refresh"),
+    status: Schema.Literal(400),
+    providerError: Schema.Literal("invalid_client"),
+  }),
+});
+const Receipt = Schema.Struct({
+  phase: Schema.Literals([
+    "request",
+    "state",
+    "credentials",
+    "attribution",
+    "oauth_start",
+    "oauth_status",
+    "oauth_callback",
+    "oauth_cancel",
+    "cleanup",
+  ]),
+  errorClass: Schema.Literals([
+    "runtime_unhealthy",
+    "transport",
+    "timeout",
+    "home_unavailable",
+    "home_rejected",
+    "invalid_code",
+    "binding_changed",
+    "invalid_response",
+    "internal",
+  ]),
+  retryable: Schema.Boolean,
+  step: Schema.Literal("start"),
+  boundary: Schema.Literals(["context", "handler", "output", "runtime"]),
+  cause: Schema.Literals([
+    "account_reconnect",
+    "account_renewal",
+    "handler_failed",
+    "type_error",
+    "invalid_output",
+    "storage",
+    "access_denied",
+    "timeout",
+    "transport",
+    "runtime_failed",
+    "operation_missing",
+    "invalid_input",
+    "unknown",
+  ]),
+  oauthRenewal: Schema.optionalKey(
+    Schema.Struct({
+      reason: Schema.Literal("client_rejected"),
+      cause: Schema.Struct({
+        stage: Schema.Literal("refresh"),
+        status: Schema.Literal(400),
+        providerError: Schema.Literal("invalid_client"),
+      }),
+    }),
+  ),
+});
+const Failure = Schema.Struct({
+  _tag: Schema.Literal("InteractiveConnectionFailed"),
+  reason: Schema.Literal("step"),
+  receipt: Receipt,
+});
+const RawReceipt = Schema.Struct({ receipt: Schema.Record(Schema.String, Schema.Unknown) });
+
+layer(HostedLive, { excludeTestServices: true })("Interactive account isolation", (it) => {
+  it.effect(scenarios.interactiveAccountIsolation.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const fixture = yield* interactiveIsolationFixture();
+        const evidence = yield* Evidence;
+        const legacy = yield* fixture.connectOAuth();
+        const previous = yield* fixture.account(legacy),
+          links = yield* fixture.links();
+        expect(links).toContainEqual(["aws", legacy]);
+        yield* fixture.refuse;
+        const pending = yield* fixture.pending();
+        const before = yield* fixture.counts;
+        const started = yield* fixture.start(pending.id);
+        assertInteractivePrivate(started.body);
+        const after = yield* fixture.counts;
+        // Retain the actual public failure before the RED assertion exits the scenario.
+        yield* evidence.json("interactive-start-isolation.json", {
+          slot: "identityCenter",
+          legacy,
+          status: started.status,
+          response: started.body,
+          deltas: {
+            refreshes: after.refreshes - before.refreshes,
+            exchanges: after.exchanges - before.exchanges,
+            reads: after.reads - before.reads,
+            writes: after.writes - before.writes,
+            revocations: after.revocations - before.revocations,
+            backendReads: after.backendReads - before.backendReads,
+          },
+        });
+        yield* captureInteractiveIsolation(fixture.pageUrl(pending.id), started.status === 200);
+        expect(started.status, "Unrelated legacy OAuth must not block the setup form").toBe(200);
+        expect(yield* body(Form, started)).toEqual({
+          form: {
+            submitLabel: "Continue",
+            fields: [{ name: "startUrl", label: "Start URL", type: "url" }],
+          },
+        });
+        expect(after.backendReads).toBe(before.backendReads + 1);
+        expect(after.backendAuthorized).toBe(true);
+        expect(after.refreshes - before.refreshes).toBeGreaterThanOrEqual(0);
+        expect(after.refreshes - before.refreshes).toBeLessThanOrEqual(1);
+        expect(after.exchanges).toBe(before.exchanges);
+        expect(after.reads).toBe(before.reads);
+        expect(after.writes).toBe(before.writes);
+        expect(after.revocations).toBe(before.revocations);
+        expect(yield* fixture.links()).toEqual(links);
+        expect(yield* fixture.account(legacy)).toEqual(previous);
+        const publicConnection = yield* fixture.connection(pending.id);
+        assertInteractivePrivate(publicConnection.body);
+        expect(publicConnection.status).toBe(200);
+
+        const strict = yield* fixture.strict();
+        assertInteractivePrivate(strict.body);
+        yield* evidence.json("interactive-isolation-strict-call.json", {
+          status: strict.status,
+          response: strict.body,
+        });
+        expect(
+          strict.status,
+          "Ordinary tool calls must still reject the broken OAuth account",
+        ).toBe(502);
+        expect(yield* body(StrictFailure, strict)).toEqual({
+          _tag: "OAuthRenewalFailed",
+          account: legacy,
+          reason: "client_rejected",
+          cause: { stage: "refresh", status: 400, providerError: "invalid_client" },
+        });
+        const afterStrict = yield* fixture.counts;
+        expect(afterStrict.reads).toBe(before.reads);
+        expect(afterStrict.writes).toBe(before.writes);
+        expect(afterStrict.revocations).toBe(before.revocations);
+        expect(yield* fixture.links()).toEqual(links);
+        expect(yield* fixture.account(legacy)).toEqual(previous);
+        const cancelled = yield* fixture.cancel(pending.id);
+        assertInteractivePrivate(cancelled.body);
+        expect(cancelled.status).toBe(200);
+      }),
+    ),
+  );
+
+  it.effect(scenarios.interactiveAccountStartReceipts.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const evidence = yield* Evidence;
+        const receipts = yield* Effect.forEach(
+          [
+            { fault: "none", boundary: "context", cause: "account_renewal" },
+            { fault: "handler", boundary: "handler", cause: "handler_failed" },
+            { fault: "output", boundary: "output", cause: "invalid_output" },
+          ] as const,
+          (row) =>
+            Effect.scoped(
+              Effect.gen(function* () {
+                const fixture = yield* interactiveIsolationFixture(row.fault);
+                const own =
+                  row.boundary === "context"
+                    ? yield* fixture.connectOAuth("identityCenter")
+                    : undefined;
+                const previous = own === undefined ? undefined : yield* fixture.account(own);
+                const links = yield* fixture.links();
+                if (own !== undefined) yield* fixture.refuse;
+                const pending = yield* fixture.pending();
+                const before = yield* fixture.counts;
+                const failed = yield* fixture.start(pending.id);
+                assertInteractivePrivate(failed.body);
+                const after = yield* fixture.counts;
+                yield* evidence.json(`interactive-start-${row.boundary}.json`, {
+                  status: failed.status,
+                  response: failed.body,
+                  backendReads: after.backendReads - before.backendReads,
+                });
+                expect(failed.status, `${row.boundary} must return a typed sign-in failure`).toBe(
+                  422,
+                );
+                const failure = yield* body(Failure, failed);
+                const raw = yield* body(RawReceipt, failed);
+                expect(Object.keys(raw.receipt).sort()).toEqual(
+                  [
+                    "boundary",
+                    "cause",
+                    "errorClass",
+                    "phase",
+                    "retryable",
+                    "step",
+                    ...(row.boundary === "context" ? ["oauthRenewal"] : []),
+                  ].sort(),
+                );
+                expect(failure.receipt).toMatchObject({
+                  step: "start",
+                  boundary: row.boundary,
+                  cause: row.cause,
+                });
+                if (row.boundary === "context")
+                  expect(failure.receipt.oauthRenewal).toEqual({
+                    reason: "client_rejected",
+                    cause: { stage: "refresh", status: 400, providerError: "invalid_client" },
+                  });
+                expect(after.backendReads - before.backendReads).toBe(
+                  row.boundary === "context" ? 0 : 1,
+                );
+                expect(after.backendAuthorized).toBe(true);
+                expect(after.reads).toBe(before.reads);
+                expect(after.writes).toBe(before.writes);
+                expect(after.revocations).toBe(before.revocations);
+                expect(yield* fixture.links()).toEqual(links);
+                if (own !== undefined) expect(yield* fixture.account(own)).toEqual(previous);
+                yield* captureInteractiveIsolation(fixture.pageUrl(pending.id), false, {
+                  cause: row.cause,
+                  description:
+                    row.boundary === "context"
+                      ? "The service did not accept the sign-in setup used to renew an account needed for this step."
+                      : row.boundary === "handler"
+                        ? "The app's code for this step stopped with an error."
+                        : "The app returned a result in the wrong format.",
+                });
+                const publicConnection = yield* fixture.connection(pending.id);
+                assertInteractivePrivate(publicConnection.body);
+                expect(publicConnection.status).toBe(200);
+                const cancelled = yield* fixture.cancel(pending.id);
+                assertInteractivePrivate(cancelled.body);
+                expect(cancelled.status).toBe(200);
+                return failure.receipt;
+              }),
+            ),
+          { concurrency: 1 },
+        );
+        expect(
+          new Set(receipts.map((receipt) => `${receipt.boundary}/${receipt.cause}`)).size,
+        ).toBe(3);
+      }),
+    ),
+  );
+});
diff --git a/packages/apps/src/implementation/connect-failure.ts b/packages/apps/src/implementation/connect-failure.ts
