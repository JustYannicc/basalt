+++ b/packages/apps/src/implementation/connect-failure.ts
@@ -0,0 +1,15 @@
+/** Connect failures cross the runtime as closed classes, never the handler's message. */
+import { AppDatabaseError, DatabaseLimitExceeded } from "@executor-js/app-data/contracts";
+import { Schema } from "effect";
+import { HostOperationFailed } from "../contracts/host.ts";
+
+export const connectFailure = (error: unknown) =>
+  Schema.is(AppDatabaseError)(error) || Schema.is(DatabaseLimitExceeded)(error)
+    ? new HostOperationFailed({ source: "storage", code: "interactive.storage" })
+    : error instanceof TypeError
+      ? new HostOperationFailed({
+          source: "app",
+          code: "interactive.type_error",
+          errorName: "TypeError",
