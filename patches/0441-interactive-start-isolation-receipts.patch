+++ b/e2e/support/interactive-account-isolation.ts
@@ -0,0 +1,193 @@
+/** A real hosted app with unrelated legacy OAuth and a healthy sign-in backend. */
+import { expect } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { FetchHttpClient, HttpClient } from "effect/http";
+import { randomUUID } from "node:crypto";
+import { Actors } from "./actors.ts";
+import { Api, body } from "./api.ts";
+import { accountLinks, connectionsPath } from "./app-accounts.ts";
+import { appsManifest } from "./apps-release.ts";
+import { Resource } from "./contracts.ts";
+import { interactiveIsolationSource } from "./interactive-isolation-source.ts";
+import { oauthSetupIssuer } from "./oauth-setup-issuer.ts";
+import { settleWebhookSources } from "./webhook-sources.ts";
+
+const Authorization = Schema.Struct({ authorizationUrl: Schema.String });
+const SavedAccount = Schema.Struct({
+  id: Schema.String,
+  provider: Schema.String,
+  method: Schema.String,
+  label: Schema.String,
+  description: Schema.NullOr(Schema.String),
+});
+
+/** Check public values before decoding or retaining them, without printing a leaked value. */
+export const assertInteractivePrivate = (value: unknown) => {
+  const json = JSON.stringify(value);
+  for (const marker of [
+    "PRIVATE_PROVIDER_ERROR",
+    "PRIVATE_INTERACTIVE_ERROR",
+    "private-session-",
+    "synthetic-access-token",
+    "synthetic-refreshed-token-",
+    "synthetic-refresh-",
+    "synthetic-client-secret",
+    "synthetic-backend-key",
+  ])
+    expect(json.includes(marker), `Public response exposed the ${marker} marker`).toBe(false);
+};
+
+export const interactiveIsolationFixture = (
+  fault: Parameters<typeof interactiveIsolationSource>[2] = "none",
+) =>
+  Effect.gen(function* () {
+    const api = yield* Api,
+      actors = yield* Actors,
+      http = yield* HttpClient.HttpClient;
+    const issuer = yield* oauthSetupIssuer;
+    const backend = yield* oauthSetupIssuer;
+    yield* issuer.configure({ refreshTokens: true, expiresIn: 1, revocation: "recorded" });
+    const prefix = `/api/organizations/${actors.organization.id}`;
+    const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+      name: `Interactive isolation ${randomUUID().slice(0, 8)}`,
+      files: [
+        {
+          path: "index.ts",
+          content: interactiveIsolationSource(issuer.origin, backend.origin, fault),
+        },
+        appsManifest,
+      ],
+    });
+    assertInteractivePrivate(deployed.body);
+    expect(deployed.status).toBe(200);
+    const app = yield* body(Resource, deployed),
+      path = `${prefix}/apps/${app.id}`,
+      accounts: string[] = [];
+    yield* Effect.addFinalizer(() =>
+      Effect.gen(function* () {
+        expect((yield* api.request(actors.owner, "DELETE", path)).status).toBe(200);
+        for (const account of accounts)
+          expect(
+            (yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`)).status,
+          ).toBe(200);
+      }).pipe(Effect.orDie),
+    );
+    const connectionPath = (id: string) => `${prefix}/connections/${id}`;
+    const pending = (slot = "identityCenter", scope: "app" | "user" = "user") =>
+      Effect.gen(function* () {
+        const response = yield* api.request(
+          actors.owner,
+          "POST",
+          connectionsPath(path, scope, slot),
+          {},
+        );
+        assertInteractivePrivate(response.body);
+        expect(response.status).toBe(200);
+        return yield* body(Resource, response);
+      });
+    const key = yield* pending("backend", "app");
+    const submitted = yield* api.request(actors.owner, "POST", `${connectionPath(key.id)}/submit`, {
+      method: "key",
+      fields: { token: "synthetic-backend-key" },
+    });
+    assertInteractivePrivate(submitted.body);
+    expect(submitted.status).toBe(200);
+    accounts.push((yield* body(Resource, submitted)).id);
+
+    const connectOAuth = (slot: "aws" | "identityCenter" = "aws") =>
+      Effect.gen(function* () {
+        const connection = yield* pending(slot);
+        const started = yield* api.request(
+          actors.owner,
+          "POST",
+          `${connectionPath(connection.id)}/oauth/start`,
+          { method: "oauth", label: `Synthetic ${slot}` },
+        );
+        assertInteractivePrivate(started.body);
+        expect(started.status).toBe(200);
+        const authorization = yield* body(Authorization, started);
+        const callbackUrl = yield* Effect.scoped(
+          Effect.gen(function* () {
+            const consent = yield* HttpClient.withScope(http).get(authorization.authorizationUrl);
+            expect(consent.status).toBe(302);
+            const callback = consent.headers.location;
+            if (callback === undefined) return yield* Effect.die("Issuer omitted its callback");
+            return callback;
+          }),
+        ).pipe(Effect.provideService(FetchHttpClient.RequestInit, { redirect: "manual" }));
+        const completed = yield* api.request(
+          actors.owner,
+          "POST",
+          `${connectionPath(connection.id)}/oauth/complete`,
+          { callbackUrl },
+        );
+        assertInteractivePrivate(completed.body);
+        expect(completed.status).toBe(200);
+        const account = yield* body(Resource, completed);
+        accounts.push(account.id);
+        yield* settleWebhookSources(actors.owner, path, (sources) =>
+          sources.some((source) => source.account === account.id && source.status !== "pending"),
+        );
+        return account.id;
+      });
+    const account = (id: string) =>
+      Effect.gen(function* () {
+        const response = yield* api.request(actors.owner, "GET", `${prefix}/accounts/${id}`);
+        assertInteractivePrivate(response.body);
+        expect(response.status).toBe(200);
+        return (yield* body(Schema.Struct({ account: SavedAccount }), response)).account;
+      });
+    const start = (id: string) =>
+      api.request(actors.owner, "POST", `${connectionPath(id)}/interactive/start`, {
+        method: "device",
+      });
+    const connection = (id: string) => api.request(actors.owner, "GET", connectionPath(id));
+    const cancel = (id: string) =>
+      api.request(actors.owner, "POST", `${connectionPath(id)}/interactive/cancel`);
+    const strict = () =>
+      api.request(actors.owner, "POST", `${path}/tools/call`, {
+        tool: "strict",
+        kind: "query",
+        input: {},
+      });
+    const counts = Effect.gen(function* () {
+      const legacy = yield* issuer.metrics,
+        healthy = yield* backend.metrics;
+      return {
+        refreshes: legacy.refreshes,
+        exchanges: legacy.tokenExchanges,
+        reads: legacy.resourceRequests.GET,
+        writes: legacy.resourceRequests.POST,
+        revocations: legacy.revocations.length,
+        backendReads: healthy.resourceRequests.GET,
+        backendAuthorized: healthy.resourceAuthorizations.every(
+          (authorization) => authorization === "Bearer synthetic-backend-key",
+        ),
+      };
+    });
+    return {
+      pending,
+      connectOAuth,
+      account,
+      start,
+      connection,
+      cancel,
+      strict,
+      counts,
+      pageUrl: (id: string) => `/org/${actors.organization.slug}/connections/${id}`,
+      links: () => accountLinks(actors.owner, path),
+      refuse: issuer
+        .configure({
+          tokenError: {
+            status: 400,
+            body: { error: "invalid_client", error_description: "PRIVATE_PROVIDER_ERROR" },
+          },
+        })
+        .pipe(
+          // The real server uses a live clock. Wait past this fixture's one-second token;
+          // expires_in: 0 means an unstated lifetime, not immediate expiry.
+          Effect.andThen(Effect.sleep("1200 millis")),
+        ),
+      recover: issuer.configure({ tokenError: null }),
+    };
+  });
