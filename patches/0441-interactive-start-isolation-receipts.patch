+/** Retain the real hosted connection dialog at desktop and phone widths. */
+import { Effect } from "effect";
+import { Actors } from "./actors.ts";
+import { Browser } from "./browser.ts";
+import { Evidence } from "./evidence.ts";
+
+export const captureInteractiveIsolation = (
+  url: string,
+  ready: boolean,
+  failure?: { readonly cause: string; readonly description: string },
+) =>
+  Effect.gen(function* () {
+    const actors = yield* Actors,
+      browser = yield* Browser,
+      evidence = yield* Evidence;
+    yield* browser.login(actors.owner);
+    yield* browser.use("Open the pending Identity Center connection", (page) => page.goto(url));
+    yield* browser.use("Choose Identity Center", (page) => page.getByRole("combobox").click());
+    yield* browser.use("Select the interactive method", (page) =>
+      page.getByRole("option", { name: "Identity Center", exact: true }).click(),
+    );
+    yield* browser.use("Start Identity Center sign-in", (page) =>
+      page.getByRole("button", { name: "Sign in with Identity Center", exact: true }).click(),
+    );
+    yield* browser.use("The connection shows its actual result", (page) =>
+      ready
+        ? page.getByLabel("Start URL", { exact: true }).waitFor()
+        : page
+            .getByText(
+              failure === undefined ? "Sign-in could not finish" : "Sign-in could not start",
+              { exact: true },
+            )
+            .waitFor(),
+    );
+    if (failure !== undefined)
+      yield* browser.use("The error explains the recorded cause", (page) =>
+        page.getByText(failure.description, { exact: true }).waitFor(),
+      );
+    for (const width of [1280, 390]) {
+      yield* browser.use("Set the evidence viewport", (page) =>
+        page.setViewportSize({ width, height: 900 }),
+      );
+      yield* evidence.attach(
+        `interactive-isolation-${failure?.cause ?? (ready ? "after" : "before")}-${width}.png`,
+        "image/png",
+        yield* browser.use("Capture the connection dialog", (page) => page.screenshot()),
+      );
+    }
+  });
