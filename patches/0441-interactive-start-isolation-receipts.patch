@@ -0,0 +1,180 @@
+/** Step-specific recovery, using only closed diagnostics retained by the host. */
+import type { ErrorPresentation } from "@executor-js/utils/user-facing-error";
+
+import type { AcquisitionFailureReceipt } from "./interactive-accounts.ts";
+
+type StepReceipt = AcquisitionFailureReceipt;
+type Step = NonNullable<StepReceipt["step"]>;
+type Boundary = NonNullable<StepReceipt["boundary"]>;
+type Cause = NonNullable<StepReceipt["cause"]>;
+
+const steps: Record<Step, { readonly title: string; readonly verb: string }> = {
+  start: { title: "Sign-in could not start", verb: "start sign-in" },
+  status: { title: "Could not check sign-in progress", verb: "check sign-in progress" },
+  submit: { title: "Sign-in could not finish", verb: "finish sign-in" },
+  cancel: { title: "Could not cancel sign-in", verb: "cancel sign-in" },
+  check: { title: "Could not check this account", verb: "check this account" },
+  remove: { title: "Could not remove this account", verb: "remove this account" },
+};
+
+const boundaries: Record<Boundary, string> = {
+  context: "while preparing the request",
+  runtime: "in the app's runtime",
+  handler: "in the app's code",
+  output: "while reading the app's result",
+};
+
+type CauseCopy = {
+  readonly description: (step: Step, boundary: Boundary | undefined) => string;
+  /** Text when the receipt is retryable. Omitted means a retry cannot help. */
+  readonly retry?: string;
+  readonly fixed: (step: Step) => string;
+  readonly investigate: string;
+};
+
+const appFix = "The app needs a fix. Trying again will not help.";
+
+const causes: Record<Cause, CauseCopy> = {
+  account_reconnect: {
+    description: () => "An account this step depends on needs to be reconnected.",
+    fixed: () => "Reconnect that account from Accounts, then try again.",
+    investigate:
+      "Identify the dependency account whose health requires reconnection. Do not touch healthy accounts.",
+  },
+  account_renewal: {
+    description: () =>
+      "Access for an account this step depends on could not be renewed. The service may be unavailable, or it did not accept the renewal.",
+    retry: "Try again in a few minutes. If it keeps failing, check that account in Accounts.",
+    fixed: () => "Check that account in Accounts before trying again.",
+    investigate:
+      "Renewal failed. Distinguish a client-side refusal from a service outage. Do not treat it as an ended grant without evidence.",
+  },
+  handler_failed: {
+    description: () => "The app's code for this step stopped with an error.",
+    retry: "Try again. If it fails the same way, the app needs a fix.",
+    fixed: () => "The app needs a fix before this step can work.",
+    investigate: "Inspect the app's handler for this step and its logs.",
+  },
+  type_error: {
+    description: () => "The app's code for this step has a bug.",
+    fixed: () => appFix,
+    investigate: "The handler threw a TypeError. Find and fix the programming error.",
+  },
+  invalid_output: {
+    description: () => "The app returned a result in the wrong format.",
+    fixed: () => appFix,
+    investigate: "The handler's result failed its output schema. Compare it with the contract.",
+  },
+  storage: {
+    description: () => "Saved state for this step could not be read or written.",
+    retry: "Try again in a moment.",
+    fixed: () => "Try again later. Report it if it keeps happening.",
+    investigate: "Check the connection state storage for this step.",
+  },
+  access_denied: {
+    description: () => "Access was denied during this step.",
+    retry: "Try again. If it keeps failing, check this account's permissions.",
+    fixed: () => "Check this account's permissions, then try again.",
+    investigate:
+      "Find which party denied access. Do not assume the provider or revoked credentials.",
+  },
+  timeout: {
+    description: () => "This step did not finish in time.",
+    retry: "Try again.",
+    fixed: () => "Try again later.",
+    investigate: "Find which call in this step exceeded its deadline.",
+  },
+  transport: {
+    description: () => "A network request in this step failed before an answer arrived.",
+    retry: "Try again.",
+    fixed: () => "Try again later.",
+    investigate: "A request in this step got no response. Check network and runtime connectivity.",
+  },
+  runtime_failed: {
+    description: () => "The app stopped running before this step finished.",
+    retry: "Try again in a moment.",
+    fixed: () => "Try again later. If it keeps failing, the app needs a fix.",
+    investigate: "Inspect the app runtime's health and its exit for this step.",
+  },
+  operation_missing: {
+    description: (step) => `This app does not include a way to ${steps[step].verb}.`,
+    fixed: () => "The app needs an update. Trying again will not help.",
+    investigate: "The installed app version declares no handler for this step.",
+  },
+  invalid_input: {
+    description: (step) =>
+      step === "submit"
+        ? "The app did not accept what you entered."
+        : "The app did not accept the details for this step.",
+    fixed: (step) =>
+      step === "submit"
+        ? "Check what you entered and try again."
+        : "Check the details and try again.",
+    investigate: "The handler rejected its input. Compare the input with the method's form.",
+  },
+  unknown: {
+    description: (_, boundary) =>
+      boundary === undefined
+        ? "The cause was not recorded."
+        : `It failed ${boundaries[boundary]}. The cause was not recorded.`,
+    retry: "Try again. Report it if it fails the same way.",
+    fixed: () => "Report it if it keeps happening.",
+    investigate: "No cause was recorded. Use the step and boundary to find the failing call.",
+  },
+};
+
+const renewalDescriptions = {
+  client_rejected:
+    "The service did not accept the sign-in setup used to renew an account needed for this step.",
+  renewal_rejected:
+    "The service rejected a request to renew access for an account needed for this step.",
+  rate_limited: "The service is limiting requests to renew an account needed for this step.",
+  service_unavailable:
+    "The service was unavailable while renewing access for an account needed for this step.",
+  incompatible_response:
+    "The service returned an access renewal response that this app could not use.",
+};
+const runtimeDescriptions = {
+  "cold-start": "The app could not start.",
+  memory: "The app ran out of memory.",
+  cpu: "The app used too much processing time.",
+  timeout: "The app did not answer in time.",
+  overloaded: "The app is too busy to run this step.",
+  reset: "The app was restarted before this step finished.",
+  disconnected: "The connection to the app was lost.",
+  hung: "The app stopped responding.",
+  internal: "The app's runtime failed.",
+  "invalid-reply": "The app returned a result this server could not read.",
+  "too-large": "The app sent or received more data than this step allows.",
+  data: "The app's saved state could not be accessed.",
+  build: "The app's installed build could not be read.",
+  unsupported: "The app's installed build is incompatible with this server.",
+  managed: "The app needs an update before it can use this account's sign-in.",
+  unrecognized: "The app stopped for an unrecognized runtime reason.",
+} satisfies Record<NonNullable<StepReceipt["runtimeReason"]>, string>;
+
+/** Step-aware copy. Undefined keeps the existing presentation for receipts without a step. */
+export const interactiveStepPresentation = (
+  receipt: StepReceipt | undefined,
+): ErrorPresentation | undefined => {
+  if (receipt?.step === undefined) return undefined;
+  if (receipt.errorClass === "binding_changed" || receipt.errorClass === "invalid_code")
+    return undefined;
+  const { step, boundary } = receipt;
+  const cause = causes[receipt.cause ?? "unknown"];
+  const retry = receipt.retryable ? cause.retry : undefined;
+  return {
+    title: steps[step].title,
+    description:
+      receipt.oauthRenewal?.reason !== undefined
+        ? renewalDescriptions[receipt.oauthRenewal.reason]
+        : receipt.runtimeReason !== undefined
+          ? runtimeDescriptions[receipt.runtimeReason]
+          : cause.description(step, boundary),
+    retryable: retry !== undefined,
+    recovery: {
+      action: retry ?? cause.fixed(step),
+      instructions: `The ${step} step failed at the ${boundary ?? "unrecorded"} boundary with cause ${receipt.cause ?? "unknown"}. ${cause.investigate} Safe renewal evidence: ${JSON.stringify(receipt.oauthRenewal ?? {})}. Runtime reason: ${receipt.runtimeReason ?? "not recorded"}. Keep the session private.`,
+    },
+  };
+};
