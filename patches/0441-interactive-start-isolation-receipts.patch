diff --git a/packages/sdk/src/implementation/interactive-step-failure.ts b/packages/sdk/src/implementation/interactive-step-failure.ts
new file mode 100644
index 0000000..2f36f28
--- /dev/null
+++ b/packages/sdk/src/implementation/interactive-step-failure.ts
@@ -0,0 +1,140 @@
+/** Classify before the interactive runner discards a failure's private details. */
+import { Cause, Effect, Schema } from "effect";
+import {
+  HostInputInvalid,
+  HostOperationFailed,
+  HostOperationNotFound,
+  HostOutputInvalid,
+  type ConnectCommand,
+} from "apps/contracts";
+import {
+  InteractiveConnectionFailed,
+  type AcquisitionFailureReceipt,
+  type InteractiveBinding,
+} from "../contracts/interactive-accounts.ts";
+import { OAuthReconnectRequired, OAuthRenewalFailed } from "../contracts/oauth.ts";
+import {
+  RuntimeBuildUnavailable,
+  RuntimeProtocolFailed,
+  RuntimeProtocolUnsupported,
+} from "../contracts/runtime.ts";
+import { CredentialsError, StorageError } from "../contracts/shared.ts";
+import { accountCheckFailure } from "./account-check-failure.ts";
+
+type Boundary = NonNullable<AcquisitionFailureReceipt["boundary"]>;
+type FailureCause = NonNullable<AcquisitionFailureReceipt["cause"]>;
+
+/** Only the framework's fixed codes classify a handler error; arbitrary app codes stay private. */
+const handlerCause = (error: HostOperationFailed): FailureCause => {
+  switch (error.code) {
+    case "interactive.handler_failed":
+      return "handler_failed";
+    case "interactive.type_error":
+      return "type_error";
+    case "interactive.storage":
+      return "storage";
+    default:
+      return "unknown";
+  }
+};
+
+const failureCause = (error: unknown, boundary: Boundary): FailureCause => {
+  if (Cause.isTimeoutError(error)) return "timeout";
+  if (Schema.is(OAuthReconnectRequired)(error)) return "account_reconnect";
+  if (Schema.is(OAuthRenewalFailed)(error)) return "account_renewal";
+  if (Schema.is(CredentialsError)(error) || Schema.is(StorageError)(error)) return "storage";
+  if (Schema.is(HostOutputInvalid)(error) || (boundary === "output" && Schema.isSchemaError(error)))
+    return "invalid_output";
+  if (Schema.is(HostOperationNotFound)(error)) return "operation_missing";
+  if (Schema.is(HostInputInvalid)(error)) return "invalid_input";
+  if (Schema.is(HostOperationFailed)(error)) return handlerCause(error);
+  if (Schema.is(RuntimeProtocolFailed)(error)) {
+    if (error.reason === "timeout") return "timeout";
+    if (error.reason === "invalid-reply") return "invalid_output";
+    if (error.reason === "disconnected") return "transport";
+    return "runtime_failed";
+  }
+  if (Schema.is(RuntimeBuildUnavailable)(error) || Schema.is(RuntimeProtocolUnsupported)(error))
+    return "runtime_failed";
+  return "unknown";
+};
+
+export const interactiveStepFailure = (
+  command: ConnectCommand,
+  boundary: Boundary,
+  error: unknown,
+) => {
+  if (Schema.is(InteractiveConnectionFailed)(error)) return error;
+  const runtime = Schema.is(RuntimeProtocolFailed)(error)
+    ? error.reason
+    : Schema.is(RuntimeBuildUnavailable)(error)
+      ? "build"
+      : Schema.is(RuntimeProtocolUnsupported)(error)
+        ? "unsupported"
+        : undefined;
+  const oauthRenewal =
+    Schema.is(OAuthRenewalFailed)(error) || Schema.is(OAuthReconnectRequired)(error)
+      ? accountCheckFailure(error).oauthRenewal
+      : undefined;
+  const cause = failureCause(error, boundary);
+  const classifiedBoundary =
+    cause === "invalid_output"
+      ? "output"
+      : Schema.is(HostOperationFailed)(error) && cause !== "unknown"
+        ? "handler"
+        : boundary;
+  const receipt: AcquisitionFailureReceipt = {
+    phase: classifiedBoundary === "context" ? "credentials" : "request",
+    errorClass:
+      cause === "timeout"
+        ? "timeout"
+        : cause === "transport"
+          ? "transport"
+          : cause === "invalid_output"
+            ? "invalid_response"
+            : "internal",
+    retryable:
+      cause === "timeout" ||
+      cause === "transport" ||
+      (cause === "runtime_failed" && runtime !== "unsupported") ||
+      cause === "storage" ||
+      (Schema.is(OAuthRenewalFailed)(error) &&
+        (error.reason === "service_unavailable" || error.reason === "rate_limited")),
+    step: command.step,
+    boundary: classifiedBoundary,
+    cause,
+    ...(oauthRenewal === undefined ? {} : { oauthRenewal }),
+    ...(runtime === undefined ? {} : { runtimeReason: runtime }),
+  };
