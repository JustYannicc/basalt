--- a/e2e/support/cloud-postgres-fixtures.ts
+++ b/e2e/support/cloud-postgres-fixtures.ts
@@ -64,3 +64,56 @@ esac
       dockerEnv: { PATH: directory, DOCKER_HOST: "unix:///synthetic", DOCKER_CONFIG: directory },
     };
   });
+
+/**
+ * Refuse the first `refusals` image pulls with `refusal`, counting every pull in `pulls`. After
+ * that, hand each call to the real Docker named by `real`, or answer like an empty daemon. A pull of
+ * an image the real daemon already has answers at once, so the proof never waits on a registry.
+ */
+export const refusingPulls = (
+  refusal: string,
+  refusals: number,
+  real?: {
+    readonly docker: string;
+    readonly dockerEnv: {
+      readonly PATH: string;
+      readonly DOCKER_HOST: string;
+      readonly DOCKER_CONFIG: string;
+    };
+  },
+) =>
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem;
+    const directory = yield* fs.makeTempDirectoryScoped();
+    yield* fs.writeFileString(`${directory}/refusal`, `${refusal}\n`);
+    yield* fs.writeFileString(
+      `${directory}/docker`,
+      `#!/bin/sh
+case "$1" in
+  image) exit 1 ;;
+  pull)
+    n=0
+    [ -f "${directory}/pulls" ] && read -r n < "${directory}/pulls"
+    n=$((n + 1))
+    printf '%s\n' "$n" > "${directory}/pulls"
+    if [ "$n" -le ${refusals} ]; then
+      while IFS= read -r line; do printf '%s\n' "$line" >&2; done < "${directory}/refusal"
+      exit 1
+    fi ;;
+esac
+${real ? `[ "$1" = pull ] && "${real.docker}" image inspect "$2" >/dev/null 2>&1 && exit 0\nexec "${real.docker}" "$@"` : `case "$1" in rm) : > "${directory}/removed" ;; esac\nexit 0`}
+`,
+      { mode: 0o700 },
+    );
+    // Only shell builtins: the synthetic daemon's PATH holds nothing but this script.
+    const pulls = fs
+      .readFileString(`${directory}/pulls`)
+      .pipe(Effect.map((text) => Number(text.trim())));
+    return {
+      directory,
+      pulls,
+      dockerEnv: real
+        ? { ...real.dockerEnv, PATH: `${directory}:${real.dockerEnv.PATH}` }
+        : { PATH: directory, DOCKER_HOST: "unix:///synthetic", DOCKER_CONFIG: directory },
+    };
+  });
