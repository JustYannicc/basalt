@@ -0,0 +1,49 @@
+import { Context, Effect, Option, Schema } from "effect";
+import { AccountId, AppId, type App, type Executor } from "@executor-js/sdk/core";
+import type { ObservationPolicy } from "../contracts/account-observations.ts";
+import { GroupDatabase, type GroupId } from "../contracts/groups.ts";
+import type { AppServiceIdentity } from "../contracts/service-install.ts";
+import type { AppPolicy } from "./app-policy.ts";
+import type { AccountPolicy, ResourceAuthority } from "./resource-policy.ts";
+
+export const AccountFactLink = Schema.Struct({
+  app: AppId,
+  account: AccountId,
+  requirement: Schema.String,
+  subject: Schema.NullOr(Schema.String),
+});
+
+/** Raw facts belong to one fenced pool query. Every check still derives its own verdict. */
+export const AccountFactReads = Context.Reference<
+  | {
+      readonly token: symbol;
+      readonly actor: ResourceAuthority;
+      readonly accounts: ReadonlySet<AccountId>;
+      readonly apps: ReadonlyMap<AppId, App>;
+      readonly appPolicies: ReadonlyMap<AppId, Omit<typeof AppPolicy.Type, "granted">>;
+      readonly accountPolicies: ReadonlyMap<AccountId, Omit<typeof AccountPolicy.Type, "granted">>;
+      readonly groups: ReadonlySet<GroupId>;
+      readonly observations: ReadonlyMap<AccountId, ObservationPolicy>;
+      readonly labels: ReadonlyMap<AccountId, ReadonlySet<string>>;
+      readonly links: readonly (typeof AccountFactLink.Type)[];
+      readonly services: ReadonlyMap<AppId, AppServiceIdentity>;
+      readonly pools: ReadonlySet<AppId>;
+      readonly executor: Executor;
+    }
+  | undefined
+>("hosted/AccountFactReads", { defaultValue: () => undefined });
+
+/** A write's locked checks must never consult a query's speculative facts. */
+export const currentAccountFactReads = Effect.gen(function* () {
+  const facts = yield* AccountFactReads;
+  if (facts === undefined) return undefined;
+  const service = yield* Effect.serviceOption(GroupDatabase);
+  if (Option.isNone(service)) return undefined;
+  const sql = yield* service.value.pipe(Effect.option);
+  if (
+    Option.isNone(sql) ||
+    Option.isSome(yield* Effect.serviceOption(sql.value.transactionService))
+  )
+    return undefined;
+  return facts;
+});
