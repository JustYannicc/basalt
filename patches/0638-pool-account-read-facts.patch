+import { Context, Effect, Option } from "effect";
+import { SqlClient } from "effect/sql";
+import type { AccountId, AppId } from "../contracts/shared.ts";
+import type { uncachedConnectionRow, uncachedConnectionRows } from "./app-connections.ts";
+import type { Query } from "./database.ts";
+import type { uncachedAppRow } from "./tools.ts";
+import type { uncachedVersionRow, uncachedStoredAppRow, uncachedAppListRows } from "./apps.ts";
+import type { uncachedStoredAccountRow } from "./accounts.ts";
+import type {
+  uncachedAcquisitionRows,
+  uncachedAcquisitionRecord,
+} from "./account-acquisition-bindings.ts";
+import type { uncachedSelectionRows } from "./selection.ts";
+
+type Reads<A, E> = WeakMap<Query, Map<string, Effect.Effect<A, E>>>;
+const makeReads = <A, E>(): Reads<A, E> => new WeakMap<Query, Map<string, Effect.Effect<A, E>>>();
+/** Hosts may provide raw rows for one fenced read. Selections, grants and checks are never stored. */
+export const SelectionReadFacts = Context.Reference<
+  | {
+      readonly accounts: ReadonlySet<AccountId>;
+      readonly apps: ReadonlySet<AppId>;
+      readonly appRows: Reads<
+        Effect.Success<ReturnType<typeof uncachedAppRow>>,
+        Effect.Error<ReturnType<typeof uncachedAppRow>>
+      >;
+      readonly versions: Reads<
+        Effect.Success<ReturnType<typeof uncachedVersionRow>>,
+        Effect.Error<ReturnType<typeof uncachedVersionRow>>
+      >;
+      readonly storedApps: Reads<
+        Effect.Success<ReturnType<typeof uncachedStoredAppRow>>,
+        Effect.Error<ReturnType<typeof uncachedStoredAppRow>>
+      >;
+      readonly storedAccounts: Reads<
+        Effect.Success<ReturnType<typeof uncachedStoredAccountRow>>,
+        Effect.Error<ReturnType<typeof uncachedStoredAccountRow>>
+      >;
+      readonly acquisitions: Reads<
+        Effect.Success<ReturnType<typeof uncachedAcquisitionRows>>,
+        Effect.Error<ReturnType<typeof uncachedAcquisitionRows>>
+      >;
+      readonly connections: Reads<
+        Effect.Success<ReturnType<typeof uncachedConnectionRow>>,
+        Effect.Error<ReturnType<typeof uncachedConnectionRow>>
+      >;
+      readonly connectionLists: Reads<
+        Effect.Success<ReturnType<typeof uncachedConnectionRows>>,
+        Effect.Error<ReturnType<typeof uncachedConnectionRows>>
+      >;
+      readonly appLists: Reads<
+        Effect.Success<ReturnType<typeof uncachedAppListRows>>,
+        Effect.Error<ReturnType<typeof uncachedAppListRows>>
+      >;
+      readonly acquisitionRecords: Reads<
+        Effect.Success<ReturnType<typeof uncachedAcquisitionRecord>>,
+        Effect.Error<ReturnType<typeof uncachedAcquisitionRecord>>
+      >;
+      readonly accountRows: Reads<
+        Effect.Success<ReturnType<typeof uncachedSelectionRows>>,
+        Effect.Error<ReturnType<typeof uncachedSelectionRows>>
+      >;
+    }
+  | undefined
+>("executor/SelectionReadFacts", { defaultValue: () => undefined });
+
+export const cachedFact = <A, E>(
+  cache: Reads<A, E>,
+  db: Query,
+  key: string,
+  read: Effect.Effect<A, E>,
+) =>
+  Effect.gen(function* () {
+    const sql = yield* Effect.serviceOption(SqlClient.SqlClient);
+    if (
+      Option.isSome(sql) &&
+      Option.isSome(yield* Effect.serviceOption(sql.value.transactionService))
+    )
+      return yield* read;
+    const rows = cache.get(db) ?? new Map<string, Effect.Effect<A, E>>();
+    cache.set(db, rows);
+    const previous = rows.get(key);
+    if (previous !== undefined)
+      return yield* previous.pipe(Effect.map((value) => structuredClone(value)));
+    if (rows.size >= 128) return yield* read;
+    return yield* Effect.cached(read).pipe(
+      Effect.flatMap((fresh) => {
+        const existing = rows.get(key);
+        if (existing !== undefined) return existing;
+        rows.set(key, fresh);
+        return fresh;
+      }),
+      Effect.map((value) => structuredClone(value)),
+    );
+  });
+
+export const withSelectionReadFacts =
+  (accounts: readonly AccountId[], apps: readonly AppId[]) =>
+  <A, E, R>(read: Effect.Effect<A, E, R>) =>
+    Effect.suspend(() =>
+      read.pipe(
+        Effect.provideService(SelectionReadFacts, {
+          accounts: new Set(accounts),
+          apps: new Set(apps),
+          appRows: makeReads<
+            Effect.Success<ReturnType<typeof uncachedAppRow>>,
+            Effect.Error<ReturnType<typeof uncachedAppRow>>
+          >(),
+          versions: makeReads<
+            Effect.Success<ReturnType<typeof uncachedVersionRow>>,
+            Effect.Error<ReturnType<typeof uncachedVersionRow>>
+          >(),
+          accountRows: makeReads<
+            Effect.Success<ReturnType<typeof uncachedSelectionRows>>,
+            Effect.Error<ReturnType<typeof uncachedSelectionRows>>
+          >(),
+          storedApps: makeReads<
+            Effect.Success<ReturnType<typeof uncachedStoredAppRow>>,
+            Effect.Error<ReturnType<typeof uncachedStoredAppRow>>
+          >(),
+          storedAccounts: makeReads<
+            Effect.Success<ReturnType<typeof uncachedStoredAccountRow>>,
+            Effect.Error<ReturnType<typeof uncachedStoredAccountRow>>
+          >(),
+          acquisitions: makeReads<
+            Effect.Success<ReturnType<typeof uncachedAcquisitionRows>>,
+            Effect.Error<ReturnType<typeof uncachedAcquisitionRows>>
+          >(),
+          connections: makeReads<
+            Effect.Success<ReturnType<typeof uncachedConnectionRow>>,
+            Effect.Error<ReturnType<typeof uncachedConnectionRow>>
+          >(),
+          connectionLists: makeReads<
+            Effect.Success<ReturnType<typeof uncachedConnectionRows>>,
+            Effect.Error<ReturnType<typeof uncachedConnectionRows>>
+          >(),
+          appLists: makeReads<
+            Effect.Success<ReturnType<typeof uncachedAppListRows>>,
+            Effect.Error<ReturnType<typeof uncachedAppListRows>>
+          >(),
+          acquisitionRecords: makeReads<
+            Effect.Success<ReturnType<typeof uncachedAcquisitionRecord>>,
+            Effect.Error<ReturnType<typeof uncachedAcquisitionRecord>>
+          >(),
+        }),
+      ),
+    );
