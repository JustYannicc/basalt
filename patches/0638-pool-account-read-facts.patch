diff --git a/apps/hosted/server/src/implementation/pool-account-read-facts.ts b/apps/hosted/server/src/implementation/pool-account-read-facts.ts
new file mode 100644
index 000000000..c9354bfba
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-account-read-facts.ts
@@ -0,0 +1,144 @@
+import {
+  AppId,
+  invocationEntries,
+  withSelectionReadFacts,
+  type App,
+  type AppAccounts,
+} from "@executor-js/sdk/core";
+import { Effect, Schema } from "effect";
+import { GroupId } from "../contracts/groups.ts";
+import { ObservationPolicy } from "../contracts/account-observations.ts";
+import { AccountId } from "@executor-js/sdk/core";
+import { acquisitionLabels } from "./account-identity.ts";
+import { CurrentUserId } from "../contracts/auth.ts";
+import { HostedExecutor } from "../contracts/executor.ts";
+import { CurrentOrganization } from "../contracts/organization.ts";
+import { recordedServiceInstalls } from "./service-install-records.ts";
+import { AccountFactLink, AccountFactReads } from "./account-fact-reads.ts";
+import { changeJournalPrepared } from "./change-projection.ts";
+import { RevisionHint } from "apps/ui/contracts";
+import { organizationChangeKeys } from "./organization-changes.ts";
+import { registeredPool } from "./provider-account-policy.ts";
+import {
+  policyDatabase,
+  resourceAuthority,
+  readApplicationPolicies,
+  readAccountPolicies,
+} from "./resource-policy.ts";
+import { poolFactExecutor } from "./pool-fact-executor.ts";
+
+/** A moving head discards the speculative answer, then runs once without shared facts. */
+export const readWithStableFacts = <A, E, R, F, E2, R2, E3, R3, E4 = never, R4 = never>(
+  head: Effect.Effect<string | undefined, E2, R2>,
+  facts: Effect.Effect<F, E3, R3>,
+  read: Effect.Effect<A, E, R>,
+  scoped: (facts: F, read: Effect.Effect<A, E, R>) => Effect.Effect<A, E, R>,
+  fresh?: Effect.Effect<A, E4, R4>,
+) =>
+  Effect.gen(function* () {
+    const before = yield* head.pipe(Effect.option);
+    if (before._tag === "None" || before.value === undefined) return yield* read;
+    const loaded = yield* facts.pipe(Effect.result);
+    if (loaded._tag === "Failure") return yield* fresh ?? read;
+    const result = yield* scoped(loaded.success, read).pipe(Effect.exit);
+    const after = yield* head.pipe(Effect.option);
+    if (after._tag === "None" || after.value !== before.value) return yield* fresh ?? read;
+    return yield* result;
+  });
+
+export const withPoolAccountReadFacts = <A, E, R, E2 = never, R2 = never>(
+  app: App,
+  accepted: AppAccounts,
+  read: Effect.Effect<A, E, R>,
+  fresh?: Effect.Effect<A, E2, R2>,
+) =>
+  Effect.gen(function* () {
+    if (app.requirements.dependencies?.accountView?.cardinality !== "many") return yield* read;
+    if (!(yield* registeredPool(app.id))) return yield* read;
+    const { organization, owner } = yield* CurrentOrganization;
+    const user = yield* CurrentUserId;
+    if (user === undefined) return yield* read;
+    const accounts = [...new Set(invocationEntries(accepted).flatMap(([, ids]) => ids))];
+    if (accounts.length === 0) return yield* read;
+    const sql = yield* policyDatabase;
+    const head = Effect.gen(function* () {
+      if (!(yield* changeJournalPrepared(sql))) return undefined;
+      const rows =
+        yield* sql`select topic, resource, hosted_change_revision(${owner}, topic, resource)::text as revision
+      from jsonb_to_recordset(${JSON.stringify(organizationChangeKeys)}::jsonb) as requested(topic text, resource text)
+      order by topic, resource`;
+      return JSON.stringify(yield* Schema.decodeUnknownEffect(Schema.Array(RevisionHint))(rows));
+    });
+    const facts = Effect.gen(function* () {
+      const executor = yield* Effect.flatten(HostedExecutor);
+      const actor = yield* resourceAuthority(organization, user);
+      const links = yield* Schema.decodeUnknownEffect(Schema.Array(AccountFactLink))(
+        yield* sql`select l.app, l.account, l.requirement, l.subject from hosted_app_account_links l
+        join executor_apps a on a.id = l.app and a.owner = ${owner}
+        where ${sql.in("l.account", accounts)} and (l.subject is null or l.subject = ${user})
+        order by l.app, l.requirement, l.account`,
+      );
+      const ids = [...new Set([app.id, ...links.map((link) => link.app)])];
+      const [apps, appPolicies, accountPolicies] = yield* Effect.all(
+        [
+          executor.apps.list({ owner, ids }),
+          readApplicationPolicies(ids, actor),
+          readAccountPolicies(accounts, actor),
+        ],
+        { concurrency: "unbounded" },
+      );
+      const metadata = new Map(apps.map((app) => [app.id, app]));
+      const services = yield* recordedServiceInstalls(sql, apps);
+      const registered = yield* Schema.decodeUnknownEffect(
+        Schema.Array(Schema.Struct({ app: AppId })),
+      )(
+        yield* sql`select a.id as app from organization o join executor_apps a on a.owner = 'organization:' || o.id
+        where o.id = ${organization} and ${sql.in("a.id", ids)} and exists (
+          select 1 from jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) pool
+          where pool.value ->> 'app' = a.id)`,
+      );
+      const pools = new Set(registered.map((row) => row.app));
+      const groups = yield* Schema.decodeUnknownEffect(
+        Schema.Array(Schema.Struct({ group: GroupId })),
+      )(
+        yield* sql`select gm.group_id as "group" from hosted_group_members gm join hosted_groups g on g.id=gm.group_id
+        where gm.member_id=${actor.member} and g.organization_id=${organization}`,
+      );
+      const observations = yield* Schema.decodeUnknownEffect(
+        Schema.Array(Schema.Struct({ account: AccountId, ...ObservationPolicy.fields })),
+      )(
+        yield* sql`select account_id as account, read_audience as read, refresh_audience as refresh, revision
+        from hosted_account_observation_access where organization_id=${organization} and ${sql.in("account_id", accounts)}`,
+      );
+      const token = Symbol();
+      return {
+        token,
+        groups: new Set(groups.map((row) => row.group)),
+        observations: new Map(observations.map(({ account, ...policy }) => [account, policy])),
+        labels: yield* acquisitionLabels(accounts),
+        actor,
+        accounts: new Set(accounts),
+        apps: metadata,
+        links,
+        services,
+        pools,
+        appPolicies: new Map(appPolicies.map(({ granted: _granted, ...row }) => [row.app, row])),
+        accountPolicies: new Map(
+          accountPolicies.map(({ granted: _granted, ...row }) => [row.account, row]),
+        ),
+        executor: yield* poolFactExecutor(executor, owner, accounts, metadata, token),
+      };
+    });
+    return yield* readWithStableFacts(
+      head,
+      facts,
+      read,
+      (facts, work) =>
+        work.pipe(
+          withSelectionReadFacts([...facts.accounts], [...facts.apps.keys()]),
+          Effect.provideService(AccountFactReads, facts),
+          Effect.provideService(HostedExecutor, Effect.succeed(facts.executor)),
+        ),
+      fresh,
+    );
+  });
