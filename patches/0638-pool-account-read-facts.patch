diff --git a/e2e/support/sql-critical-path.ts b/e2e/support/sql-critical-path.ts
new file mode 100644
index 000000000..b6966dee4
--- /dev/null
+++ b/e2e/support/sql-critical-path.ts
@@ -0,0 +1,43 @@
+interface WireSpan {
+  readonly operationName: string;
+  readonly startTime: string;
+  readonly durationMs: number;
+  readonly tags: Readonly<Record<string, unknown>>;
+}
+
+/**
+ * A causal chain cannot overlap its own wire waits. Its length is therefore bounded by the
+ * largest disjoint set of wire intervals. Independent requests that happened sequentially,
+ * including zero-duration waits rounded by the shared host clock, only increase this bound.
+ */
+export const sqlCriticalPath = (spans: readonly { readonly span: WireSpan }[]) => {
+  const wires = spans.filter(({ span }) => span.operationName === "sql.wire");
+  const intervals = wires
+    .map(({ span }) => {
+      const start = Date.parse(span.startTime);
+      if (
+        span.tags["db.wire.clock"] !== "date-now" ||
+        !Number.isFinite(start) ||
+        !Number.isFinite(span.durationMs) ||
+        span.durationMs < 0
+      )
+        throw new Error(
+          "SQL critical-path proof needs complete wire intervals on the shared host clock",
+        );
+      return { start, end: start + span.durationMs };
+    })
+    .sort((a, b) => a.end - b.end || a.start - b.start);
+  let end = -Infinity;
+  let sequentialRoundTrips = 0;
+  for (const interval of intervals) {
+    if (interval.start < end) continue;
+    sequentialRoundTrips++;
+    end = interval.end;
+  }
+  if (wires.length === 0) throw new Error("SQL critical-path proof contains no wire requests");
+  return {
+    wireRequests: wires.length,
+    sequentialRoundTrips,
+    sqlMillisAt8ms: sequentialRoundTrips * 8,
+  };
+};
