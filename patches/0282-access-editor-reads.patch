diff --git a/e2e/support/read-dispatch.ts b/e2e/support/read-dispatch.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/read-dispatch.ts
@@ -0,0 +1,63 @@
+/**
+ * When the page asks for one public read, whether it sends it on its own or inside a dashboard
+ * batch. Watching changes no request, so the batching a scenario sees is the product's own.
+ */
+import { Deferred, Effect } from "effect";
+import type { Request } from "playwright";
+import { Browser } from "./browser.ts";
+import { batchedReads, batchPath } from "./read-batches.ts";
+
+export const watchRead = (read: {
+  /** The API group and endpoint a batch names the read by. */
+  readonly group: string;
+  readonly endpoint: string;
+  /** The organization it reads, by URL slug and by verified ID. */
+  readonly organizations: ReadonlyArray<string>;
+  /** The read's own request paths, for each of those references. */
+  readonly paths: ReadonlyArray<string>;
+}) =>
+  Effect.gen(function* () {
+    const browser = yield* Browser;
+    const arrived = yield* Deferred.make<"alone" | "batched">();
+    let count = 0;
+    const requested = (request: Request) => {
+      const url = new URL(request.url());
+      const via =
+        request.method() === "GET" && read.paths.includes(url.pathname)
+          ? "alone"
+          : request.method() === "POST" &&
+              url.pathname === batchPath &&
+              batchedReads(request.postData()).some(
+                (entry) =>
+                  entry.group === read.group &&
+                  entry.endpoint === read.endpoint &&
+                  read.organizations.includes(entry.params.organization ?? ""),
+              )
+            ? "batched"
+            : undefined;
+      if (via === undefined) return;
+      count += 1;
+      // oxlint-disable-next-line executor/no-manual-effect-runtime-in-tests -- Playwright request listeners are plain callbacks
+      Effect.runSync(Deferred.succeed(arrived, via));
+    };
+    const label = `${read.group}.${read.endpoint}`;
+    yield* browser.use(`Observe ${label} reads`, (page) =>
+      Promise.resolve(page.context().on("request", requested)),
+    );
+    yield* Effect.addFinalizer(() =>
+      browser
+        .use(`Stop observing ${label} reads`, (page) =>
+          Promise.resolve(page.context().off("request", requested)),
+        )
+        .pipe(Effect.orDie),
+    );
+    return {
+      /** Reads the page has asked for since the watch began. */
+      count: Effect.sync(() => count),
+      /**
+       * How the first read went out, or none when the page sends none within the same 30 seconds
+       * a held query waits for its request.
+       */
+      dispatched: Deferred.await(arrived).pipe(Effect.timeoutOption("30 seconds")),
+    };
+  });
diff --git a/e2e/tests/access-editor-reads.spec.ts b/e2e/tests/access-editor-reads.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/access-editor-reads.spec.ts
@@ -0,0 +1,258 @@
+/**
+ * App Settings and a shared account's Manage access each show a sharing form that needs an access
+ * read and the organization's groups. The groups read must not wait for the reads in front of the
+ * form: while those are held, the page has already asked for the groups. Each journey starts from
+ * a fresh Accounts document, which reads no groups; the Apps list would read them first.
+ */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Option, Schema } from "effect";
+import { randomUUID } from "node:crypto";
+import type { Locator, Page } from "playwright";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { connectionsPath } from "../support/app-accounts.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { App, Resource } from "../support/contracts.ts";
+import { openInApp } from "../support/in-app-navigation.ts";
+import { holdQuery } from "../support/query-transition.ts";
+import { watchRead } from "../support/read-dispatch.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Group = Schema.Struct({ id: Schema.String, revision: Schema.String });
+const source = `import { defineApp, defineProvider, secrets, query, object, string, router } from "apps";
+const service = defineProvider({name:"Access reads fixture",auth:{key:secrets({label:"Key",fields:object({token:string()})})}});
+export default defineApp({user: { accounts:{service:service.many()} }},{tools: router({ hello:query({input:object({})},async()=>"Hello") })});`;
+
+/** An owner's app, group and shared account, removed when the case ends. */
+const ownedFixture = Effect.gen(function* () {
+  const api = yield* Api,
+    actors = yield* Actors;
+  const prefix = `/api/organizations/${actors.organization.id}`;
+  const name = `Access reads ${randomUUID().slice(0, 8)}`;
+  const groupName = `${name} group`;
+  const group = yield* body(
+    Group,
+    yield* api.request(actors.owner, "POST", `${prefix}/groups`, {
+      name: groupName,
+      description: "",
+      memberIds: [],
+    }),
+  );
+  const app = yield* body(
+    App,
+    yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+      name,
+      files: [{ path: "index.ts", content: source }, appsManifest],
+    }),
+  );
+  const accounts: string[] = [];
+  yield* Effect.addFinalizer(() =>
+    Effect.gen(function* () {
+      expect((yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app.id}`)).status).toBe(
+        200,
+      );
+      for (const id of accounts)
+        expect(
+          (yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${id}`)).status,
+        ).toBe(200);
+      expect(
+        (yield* api.request(actors.owner, "DELETE", `${prefix}/groups/${group.id}`, {
+          revision: group.revision,
+        })).status,
+      ).toBe(200);
+    }).pipe(Effect.orDie),
+  );
+  const connection = yield* body(
+    Resource,
+    yield* api.request(
+      actors.owner,
+      "POST",
+      connectionsPath(`${prefix}/apps/${app.id}`, "user", "service"),
+      { destination: { kind: "shared", audience: { kind: "everyone" } } },
+    ),
+  );
+  const account = yield* body(
+    Resource,
+    yield* api.request(actors.owner, "POST", `${prefix}/connections/${connection.id}/submit`, {
+      method: "key",
+      label: name,
+      fields: { token: "synthetic" },
+    }),
+  );
+  accounts.push(account.id);
+  return { name, groupName, app: app.id, account: account.id };
+});
+
+type Fixture = Effect.Success<typeof ownedFixture>;
+
+/** The organization's API paths, by URL slug and by verified ID. */
+const organizationPaths = Effect.map(
+  Actors,
+  (actors) => (path: string) =>
+    [actors.organization.slug, actors.organization.id].map(
+      (reference) => `/api/organizations/${reference}${path}`,
+    ),
+);
+
+/**
+ * A new Accounts document, ready once the shared account's row is listed, with a watch on the
+ * groups read that the page has not yet used.
+ */
+const freshAccounts = (fixture: Fixture, label: string) =>
+  Effect.gen(function* () {
+    const actors = yield* Actors,
+      browser = yield* Browser;
+    const groups = yield* watchRead({
+      group: "groups",
+      endpoint: "list",
+      organizations: [actors.organization.slug, actors.organization.id],
+      paths: (yield* organizationPaths)("/groups"),
+    });
+    yield* browser.use(label, (page) =>
+      page
+        .goto(`/org/${actors.organization.slug}/accounts`)
+        .then(() =>
+          page.getByRole("button", { name: `Manage ${fixture.name}`, exact: true }).waitFor(),
+        ),
+    );
+    expect(yield* groups.count, "Accounts reads no groups").toBe(0);
+    return groups;
+  });
+
+/** The released form offers the organization's group and lets its owner change access. */
+const usableForm = (
+  fixture: Fixture,
+  subject: "app" | "account",
+  within: (page: Page) => Locator,
+) =>
+  Effect.gen(function* () {
+    const browser = yield* Browser;
+    const audience = (page: Page) =>
+      within(page).getByRole("combobox", { name: `Who can use this ${subject}?`, exact: true });
+    const offered = (page: Page) =>
+      within(page).getByRole("checkbox", { name: fixture.groupName, exact: true });
+    expect(
+      yield* browser.use(`The ${subject} owner may change access`, (page) =>
+        audience(page)
+          .waitFor()
+          .then(() => audience(page).isEnabled()),
+      ),
+    ).toBe(true);
+    yield* browser.use(`Choose groups for the ${subject}`, (page) =>
+      audience(page)
+        .click()
+        .then(() => page.getByRole("option", { name: "Selected groups", exact: true }).click()),
+    );
+    expect(
+      yield* browser.use(`The ${subject} form offers the organization's group`, (page) =>
+        offered(page)
+          .waitFor()
+          .then(() => offered(page).isEnabled()),
+      ),
+    ).toBe(true);
+  });
+
+/** App Settings, opened from Accounts, while the app's access read is held. */
+const appSettings = (fixture: Fixture, width: number) =>
+  Effect.scoped(
+    Effect.gen(function* () {
+      const actors = yield* Actors,
+        browser = yield* Browser;
+      const paths = yield* organizationPaths;
+      const groups = yield* freshAccounts(fixture, "Open Accounts in a new document");
+      const access = yield* holdQuery(paths(`/apps/${fixture.app}/access`), "continue", {
+        allRequests: true,
+      });
+      yield* openInApp(
+        "Open the app's Settings from Accounts",
+        `/org/${actors.organization.slug}/apps/${fixture.app}?view=settings`,
+      );
+      yield* access.requested;
+      expect(
+        Option.isSome(yield* groups.dispatched),
+        "Settings asks for the groups while the app's access is held",
+      ).toBe(true);
+      expect(
+        yield* browser.use("The sharing form waits for the held access", (page) =>
+          page.getByRole("combobox", { name: "Who can use this app?", exact: true }).count(),
+        ),
+      ).toBe(0);
+      yield* access.release;
+      yield* usableForm(fixture, "app", (page) => page.locator("body"));
+      yield* browser.checkpoint(`${width} app sharing form`);
+    }),
+  );
+
+/** Manage access, opened from the account's row, while the account and its access are held. */
+const manageAccess = (fixture: Fixture, width: number) =>
+  Effect.scoped(
+    Effect.gen(function* () {
+      const browser = yield* Browser;
+      const paths = yield* organizationPaths;
+      const groups = yield* freshAccounts(fixture, "Open Accounts in a new document");
+      const detail = yield* holdQuery(paths(`/accounts/${fixture.account}`), "continue", {
+        allRequests: true,
+      });
+      const access = yield* holdQuery(paths(`/accounts/${fixture.account}/access`), "continue", {
+        allRequests: true,
+      });
+      yield* browser.use("Open Manage access from the account's row", (page) =>
+        page
+          .getByRole("button", { name: `Manage ${fixture.name}`, exact: true })
+          .click()
+          .then(() => page.getByRole("menuitem", { name: "Manage access", exact: true }).click())
+          .then(() => page.getByRole("dialog").waitFor()),
+      );
+      yield* detail.requested;
+      expect(
+        Option.isSome(yield* groups.dispatched),
+        "Manage access asks for the groups while the account and its access are held",
+      ).toBe(true);
+      yield* access.requested;
+      expect(
+        yield* browser.use("The sharing form waits for the held reads", (page) =>
+          page
+            .getByRole("dialog")
+            .getByRole("combobox", { name: "Who can use this account?", exact: true })
+            .count(),
+        ),
+      ).toBe(0);
+      yield* detail.release;
+      yield* access.release;
+      yield* usableForm(fixture, "account", (page) => page.getByRole("dialog"));
+      yield* browser.checkpoint(`${width} account sharing form`);
+      yield* browser.use("Close Manage access", (page) =>
+        page
+          .getByRole("dialog")
+          .getByRole("button", { name: "Close", exact: true })
+          .click()
+          .then(() => page.getByRole("dialog").waitFor({ state: "hidden" })),
+      );
+    }),
+  );
+
+layer(HostedLive, { excludeTestServices: true })("Access editor reads", (it) => {
+  for (const [scenario, journey, width] of [
+    [scenarios.appSettingsGroupsRead, appSettings, 1440],
+    [scenarios.appSettingsGroupsReadMobile, appSettings, 390],
+    [scenarios.manageAccessGroupsRead, manageAccess, 1440],
+    [scenarios.manageAccessGroupsReadMobile, manageAccess, 390],
+  ] as const)
+    it.effect(scenario.title, (context) =>
+      withHostedCase(
+        context,
+        Effect.gen(function* () {
+          const actors = yield* Actors,
+            browser = yield* Browser;
+          const fixture = yield* ownedFixture;
+          yield* browser.login(actors.owner);
+          yield* browser.use("Set the viewport", (page) =>
+            page.setViewportSize({ width, height: 900 }),
+          );
+          yield* journey(fixture, width);
+        }),
+      ),
+    );
+});
