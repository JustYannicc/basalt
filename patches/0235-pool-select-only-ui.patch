+++ b/apps/hosted/web/src/implementation/pages/import-login-file.tsx
@@ -0,0 +1,211 @@
+import { useEffect, useId, useMemo, useRef, useState } from "react";
+import { useAtomSet, useAtomValue } from "@effect/atom-react";
+import { AsyncResult } from "effect/reactivity";
+import { Exit, Option, Redacted, Schema } from "effect";
+import { JsonObject, type AccountRequirement, type App } from "@executor-js/sdk";
+import { Button } from "@executor-js/ui/components/button";
+import { Input } from "@executor-js/ui/components/input";
+import { Textarea } from "@executor-js/ui/components/textarea";
+import { DialogDescription, DialogFooter, DialogTitle } from "@executor-js/ui/components/dialog";
+import {
+  Select,
+  SelectContent,
+  SelectItem,
+  SelectTrigger,
+  SelectValue,
+} from "@executor-js/ui/components/select";
+import { HostedFailure } from "../components/dashboard-bindings.tsx";
+import { useOrganizationRoute } from "../components/organization.tsx";
+import { importLoginFileAtoms } from "../../contracts/apps.ts";
+
+/** The host refuses larger files; checking first saves an upload that can't succeed. */
+const maxBytes = 1_048_576;
+const decodeFile = Schema.decodeUnknownOption(Schema.fromJsonString(JsonObject));
+
+const readable = (text: string, oversized: boolean) => {
+  if (!oversized && text.trim() === "") return { problem: undefined };
+  if (oversized || new TextEncoder().encode(text).length > maxBytes)
+    return { problem: "This login file is larger than 1 MiB. Export it again and use that file." };
+  const file = decodeFile(text);
+  return Option.isSome(file)
+    ? { file: file.value }
+    : { problem: "This isn't a login file. Choose the JSON file you exported." };
+};
+
+const methodLabel = (requirement: AccountRequirement, name: string) => {
+  const auth = requirement.definition.auth[name];
+  return auth !== undefined && "label" in auth && typeof auth.label === "string"
+    ? auth.label
+    : name;
+};
+
+/**
+ * Import a login file exported from a subscription's own tool as a new saved account. The file
+ * stays in this form: it is never shown back, put in chat or kept by the app. The host checks that
+ * it matches the chosen method.
+ */
+export function ImportLoginFile({
+  app,
+  slot,
+  requirement,
+  methods,
+  onPendingChange,
+  onDone,
+}: {
+  readonly app: App;
+  readonly slot: string;
+  readonly requirement: AccountRequirement;
+  /** The methods the host can import for this requirement. */
+  readonly methods: readonly string[];
+  readonly onPendingChange: (pending: boolean) => void;
+  readonly onDone: () => void;
+}) {
+  const { organization } = useOrganizationRoute();
+  const [run] = useState(() =>
+    importLoginFileAtoms({
+      organization,
+      app: app.id,
+      version: app.activeVersion,
+      requirement: slot,
+    }),
+  );
+  const submit = useAtomSet(run, { mode: "promiseExit" });
+  const result = useAtomValue(run);
+  const pending = AsyncResult.isWaiting(result);
+  useEffect(() => onPendingChange(pending), [onPendingChange, pending]);
+  // Closing the form never leaves the page waiting on it.
+  useEffect(() => () => onPendingChange(false), [onPendingChange]);
+  const [method, setMethod] = useState(methods[0]);
+  const [text, setText] = useState("");
+  const [label, setLabel] = useState("");
+  const [fileName, setFileName] = useState<string>();
+  const [oversized, setOversized] = useState(false);
+  const [unreadable, setUnreadable] = useState(false);
+  // Only the latest chosen file may fill the form.
+  const picked = useRef(0);
+  const ids = { file: useId(), paste: useId(), label: useId() };
+  const state = useMemo(() => readable(text, oversized), [text, oversized]);
+  const ready = method !== undefined && "file" in state && !pending;
+  return (
+    <form
+      className="flex flex-col gap-4"
+      onSubmit={(event) => {
+        event.preventDefault();
+        if (!ready || !("file" in state)) return;
+        void submit({
+          method,
+          file: Redacted.make(state.file),
+          label: label.trim() === "" ? undefined : label.trim(),
+        }).then((exit) => {
+          if (Exit.isSuccess(exit)) {
+            onPendingChange(false);
+            onDone();
+          }
+        });
+      }}
+    >
+      <div className="grid gap-1.5">
+        <DialogTitle>Import {requirement.definition.name} login file</DialogTitle>
+        <DialogDescription>
+          Use the login file your {requirement.definition.name} tool exported. It's saved as a new
+          account here, and pools can pick it like any other.
+        </DialogDescription>
+      </div>
+      {methods.length > 1 && (
+        <Select value={method ?? ""} onValueChange={setMethod} disabled={pending}>
+          <SelectTrigger aria-label="Sign-in method">
+            <SelectValue />
+          </SelectTrigger>
+          <SelectContent>
+            {methods.map((name) => (
+              <SelectItem key={name} value={name}>
+                {methodLabel(requirement, name)}
+              </SelectItem>
+            ))}
+          </SelectContent>
+        </Select>
+      )}
+      <label htmlFor={ids.file} className="grid gap-2 text-[13px] font-medium">
+        Login file
+        <Input
+          id={ids.file}
+          type="file"
+          accept="application/json,.json"
+          disabled={pending}
+          onChange={(event) => {
+            const file = event.currentTarget.files?.[0];
+            if (file === undefined) return;
+            const turn = (picked.current += 1);
+            setFileName(file.name);
+            setOversized(file.size > maxBytes);
+            setUnreadable(false);
+            setText("");
+            if (file.size <= maxBytes)
+              void file.text().then(
+                (content) => turn === picked.current && setText(content),
+                () => turn === picked.current && setUnreadable(true),
+              );
+          }}
+        />
+      </label>
+      {fileName !== undefined && (
+        <div>
+          <Button
+            type="button"
+            variant="link"
+            size="xs"
+            disabled={pending}
+            onClick={() => {
+              picked.current += 1;
+              setFileName(undefined);
+              setOversized(false);
+              setUnreadable(false);
+              setText("");
+            }}
+          >
+            Paste the contents instead
+          </Button>
+        </div>
+      )}
+      {fileName === undefined && (
+        <label htmlFor={ids.paste} className="grid gap-2 text-[13px] font-medium">
+          Or paste its contents
+          <Textarea
+            id={ids.paste}
+            rows={4}
+            spellCheck={false}
+            autoComplete="off"
+            disabled={pending}
+            value={text}
+            onChange={(event) => setText(event.currentTarget.value)}
+          />
+        </label>
+      )}
+      <label htmlFor={ids.label} className="grid gap-2 text-[13px] font-medium">
+        Name (optional)
+        <Input
+          id={ids.label}
+          autoComplete="off"
+          placeholder="Work subscription"
+          disabled={pending}
+          value={label}
+          onChange={(event) => setLabel(event.currentTarget.value)}
+        />
+      </label>
+      {(unreadable || state.problem !== undefined) && (
+        <p role="alert" className="text-sm text-destructive">
+          {unreadable ? "This file couldn't be read. Choose it again." : state.problem}
+        </p>
+      )}
+      {AsyncResult.isFailure(result) && <HostedFailure cause={result.cause} layout="compact" />}
+      <DialogFooter>
+        <Button type="button" variant="outline" disabled={pending} onClick={onDone}>
+          Cancel
+        </Button>
+        <Button type="submit" loading={pending} disabled={!ready}>
+          Import
+        </Button>
+      </DialogFooter>
+    </form>
+  );
+}
