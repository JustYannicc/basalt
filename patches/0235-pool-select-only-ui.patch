+import { useEffect, useId, useState } from "react";
+import { HugeiconsIcon } from "@hugeicons/react";
+import { ArrowLeft02Icon, ArrowRight01Icon } from "@hugeicons/core-free-icons";
+import { Option, Schema } from "effect";
+import { AppId, type AccountRequirement, type App } from "@executor-js/sdk";
+import {
+  requirementMethods,
+  type ProviderAccountDestination,
+} from "../../contracts/app-accounts.ts";
+import type { Inventory } from "../../contracts/dashboard.ts";
+import {
+  accountMethodKindLabel,
+  accountTitle,
+  bindingApps,
+} from "../../contracts/account-identities.ts";
+import { appDisplayName } from "../../contracts/product-brand.ts";
+import { useProductBrand } from "../hooks/product-brand.ts";
+import { useDashboard } from "./context.tsx";
+import { methodLabels } from "./method-labels.ts";
+
+const linkClass =
+  "inline-flex items-center gap-1 font-medium text-foreground underline-offset-4 hover:underline";
+
+/**
+ * The app a person left to connect an account, so the provider app can send them back once. Kept
+ * per tab; storage that throws or is empty just drops the way back.
+ */
+const originKey = "executor:provider-accounts:origin";
+const Origin = Schema.Struct({ app: AppId, name: Schema.String });
+type Origin = typeof Origin.Type;
+// Stored with the workspace it was left from; app ids mean nothing in another one.
+const Stored = Schema.Struct({ ...Origin.fields, workspace: Schema.NullOr(Schema.String) });
+const decodeOrigin = Schema.decodeUnknownOption(Schema.fromJsonString(Stored));
+const rememberOrigin = (origin: Origin, workspace: string | undefined) => {
+  try {
+    sessionStorage.setItem(originKey, JSON.stringify({ ...origin, workspace: workspace ?? null }));
+  } catch {
+    // Without storage the provider app shows no way back; the browser's own Back still works.
+  }
+};
+const readOrigin = (workspace: string | undefined): Origin | undefined => {
+  try {
+    const stored = Option.getOrUndefined(decodeOrigin(sessionStorage.getItem(originKey)));
+    return stored !== undefined && stored.workspace === (workspace ?? null)
+      ? { app: stored.app, name: stored.name }
+      : undefined;
+  } catch {
+    return undefined;
+  }
+};
+const forgetOrigin = () => {
+  try {
+    sessionStorage.removeItem(originKey);
+  } catch {
+    // Nothing was stored, so there is nothing to forget.
+  }
+};
+
+/**
+ * The way back to the app that sent the person here to connect an account. It shows on the first
+ * visit after that hand-off, in the same workspace, so a later visit never offers it.
+ */
+export function ProviderReturnLink({ app }: { readonly app: App }) {
+  const { AppLink, workspace } = useDashboard();
+  const [origin] = useState(() => {
+    const value = readOrigin(workspace);
+    return value !== undefined && value.app !== app.id ? value : undefined;
+  });
+  useEffect(forgetOrigin, []);
+  if (origin === undefined) return null;
+  return (
+    <p className="text-[13px] text-muted-foreground">
+      <AppLink app={origin.app} view="accounts" className={linkClass}>
+        <HugeiconsIcon icon={ArrowLeft02Icon} size={12} strokeWidth={2} aria-hidden />
+        Back to {origin.name} to pick accounts
+      </AppLink>
+    </p>
+  );
+}
+
+/**
+ * Where to connect or repair accounts for a requirement that only selects them. One provider app
+ * opens directly; several are each offered, never one picked for the person.
+ */
+export function ProviderDestination({
+  destination,
+  provider,
+  verb,
+  origin,
+}: {
+  readonly destination: ProviderAccountDestination;
+  /** The requirement's provider, such as OpenAI, for copy that names no app. */
+  readonly provider: string;
+  readonly verb: "Connect" | "Reconnect";
+  /** The app the person is in, remembered so the provider app can send them back. */
+  readonly origin?: Origin | undefined;
+}) {
+  const { AppLink, CatalogLink, workspace } = useDashboard();
+  const remember = () => origin && rememberOrigin(origin, workspace);
+  const arrow = <HugeiconsIcon icon={ArrowRight01Icon} size={12} strokeWidth={2} aria-hidden />;
+  if (destination.kind === "unavailable") return <>{destination.reason}</>;
+  if (destination.kind === "catalog")
+    return CatalogLink === undefined ? (
+      <>
+        Add the {provider} app, then {verb.toLowerCase()} the account there.
+      </>
+    ) : (
+      <span onClickCapture={remember}>
+        <CatalogLink entry={destination.entry} className={linkClass}>
+          Add the {provider} app to {verb.toLowerCase()} {verb === "Connect" ? "accounts" : "it"}
+          {arrow}
+        </CatalogLink>
+      </span>
+    );
+  const [only, ...more] = destination.apps;
+  if (only === undefined) return <>No {provider} app is available to you.</>;
+  const link = (entry: typeof only, label: string) => (
+    <span key={entry.app} onClickCapture={remember}>
+      <AppLink app={entry.app} view="accounts" className={linkClass}>
+        {label}
+        {arrow}
+      </AppLink>
+    </span>
+  );
+  if (more.length === 0) return link(only, `${verb} in the ${only.name} app`);
+  return (
+    <span className="inline-flex flex-wrap items-center gap-x-3 gap-y-1">
+      <span>
+        {verb} in one of your {provider} apps:
+      </span>
+      {destination.apps.map((entry) => link(entry, entry.name))}
+    </span>
+  );
+}
+
+/**
+ * A provider app's own view of its accounts: each of the caller's accounts for its provider, with
+ * its kind and the other apps and pools that use it. Reads the visible inventory only.
+ */
+export function ProviderAccountUsage({
+  app,
+  requirement,
+  inventory,
+}: {
+  readonly app: App;
+  readonly requirement: AccountRequirement;
+  readonly inventory: Inventory;
+}) {
+  const brand = useProductBrand();
+  const { AppLink } = useDashboard();
+  const accounts = inventory.accounts.filter(
+    (account) => account.provider === requirement.provider,
+  );
+  const name = requirement.definition.name;
+  const labels = methodLabels(name, requirementMethods(requirement));
+  const heading = useId();
+  return (
+    <section aria-labelledby={heading} className="space-y-3">
+      <div>
+        <h2 id={heading} className="text-sm font-medium">
+          Where your {name} accounts are used
+        </h2>
+        <p className="text-xs text-muted-foreground">
+          The same accounts every app sees. Pools pick them in their own Accounts tab.
+        </p>
+      </div>
+      <div className="overflow-hidden rounded-lg border">
+        <table className="w-full table-fixed text-left text-[13px]">
+          <thead className="text-xs text-muted-foreground">
+            <tr className="border-b">
+              <th scope="col" className="px-3.5 py-2 font-normal">
+                Account
+              </th>
+              <th scope="col" className="px-3.5 py-2 font-normal">
+                Used by
+              </th>
+            </tr>
+          </thead>
+          <tbody className="divide-y divide-border/50">
+            {accounts.length === 0 ? (
+              <tr>
+                <td colSpan={2} className="px-3.5 py-2.5 text-muted-foreground">
+                  No accounts yet.
+                </td>
+              </tr>
+            ) : (
+              accounts.map((account) => {
+                const used = bindingApps(inventory, [account]).filter((item) => item.id !== app.id);
+                return (
+                  <tr key={account.id} className="align-top">
+                    <td className="min-w-0 px-3.5 py-2.5">
+                      <span className="block truncate font-medium">{accountTitle(account)}</span>
+                      <span className="block truncate text-xs text-muted-foreground">
+                        {labels.get(account.method) ??
+                          accountMethodKindLabel(requirement.definition, account.method) ??
+                          account.method}
+                      </span>
+                    </td>
+                    <td className="min-w-0 px-3.5 py-2.5">
+                      {used.length === 0 ? (
+                        <span className="text-muted-foreground">No other app</span>
+                      ) : (
+                        <span className="flex flex-wrap gap-x-3 gap-y-1">
+                          {used.map((item) => (
+                            <AppLink
+                              key={item.id}
+                              app={item.id}
+                              view="accounts"
+                              className={linkClass}
+                            >
+                              {appDisplayName(item, brand)}
+                            </AppLink>
+                          ))}
+                        </span>
+                      )}
+                    </td>
+                  </tr>
+                );
+              })
+            )}
+          </tbody>
+        </table>
+      </div>
+    </section>
+  );
+}
