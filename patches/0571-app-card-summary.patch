@@ -108,3 +108,32 @@ export const deviceSync = (sync: VaultSync, device: ObsidianDevice): DeviceSync
 export const syncTool = "devices";
 export const hasSyncTool = (tools: readonly { readonly name: string }[]) =>
   tools.some((tool) => tool.name === syncTool);
+
+export type DeviceActivity =
+  | { readonly kind: "synced"; readonly at: string; readonly current: boolean }
+  | { readonly kind: "active"; readonly at: string };
+
+/**
+ * A device's latest sign of life: its own sync record, else its grant's last token refresh, the
+ * only sign before the drive recorded syncs. Null when it has neither.
+ */
+export const deviceActivity = (
+  device: ObsidianDevice,
+  sync: VaultSync | undefined,
+): DeviceActivity | null => {
+  const own = sync === undefined ? null : deviceSync(sync, device);
+  if (own !== null) return { kind: "synced", at: own.at, current: own.current };
+  return device.lastActiveAt === null ? null : { kind: "active", at: device.lastActiveAt };
+};
+
+/** The newest sign of life any of the vault's devices shows, by each device's own rule. */
+export const latestActivity = (
+  devices: readonly ObsidianDevice[],
+  sync: VaultSync | undefined,
+): DeviceActivity | null =>
+  devices.reduce<DeviceActivity | null>((newest, device) => {
+    const activity = deviceActivity(device, sync);
+    return activity !== null && (newest === null || Date.parse(activity.at) > Date.parse(newest.at))
+      ? activity
+      : newest;
+  }, null);
