@@ -0,0 +1,32 @@
+import { RelativeTime } from "@executor-js/ui/components/local-time";
+import { AppCardLine, AppCardNote } from "@executor-js/ui/dashboard/apps";
+import {
+  latestActivity,
+  type ObsidianDevice,
+  type VaultSync,
+} from "../../contracts/obsidian-devices.ts";
+
+/** A vault's devices on its Apps card, worded like an app's linked accounts. */
+export function VaultCardLine({
+  devices,
+  sync,
+}: {
+  readonly devices: readonly ObsidianDevice[];
+  readonly sync: VaultSync | undefined;
+}) {
+  if (devices.length === 0) return <AppCardNote>No devices yet · Connect one</AppCardNote>;
+  const latest = latestActivity(devices, sync);
+  return (
+    <AppCardLine>
+      {devices.length === 1 ? "1 device" : `${devices.length} devices`}
+      {latest === null ? (
+        " · no sync yet"
+      ) : (
+        <>
+          {latest.kind === "synced" ? " · synced " : " · active "}
+          <RelativeTime value={latest.at} />
+        </>
+      )}
+    </AppCardLine>
+  );
+}
