+/**
+ * A vault's line on its Apps card, from the same devices and activity its Accounts tab lists.
+ * Apps that don't speak the Obsidian sync protocol show `fallback`.
+ */
+export function ObsidianCardSummary({
+  app,
+  fallback,
+}: {
+  readonly app: App;
+  readonly fallback: ReactNode;
