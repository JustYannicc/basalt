@@ -0,0 +1,55 @@
+import { AccountAcquisitionHost, type Executor } from "@executor-js/sdk/core";
+import { Redacted } from "effect";
+import type { NativePoolAccount } from "./pool-membership.ts";
+
+type Accounts = readonly (typeof NativePoolAccount.Type)[];
+const views = new Map<string, { fingerprint: string; accounts: Accounts }>();
+const runtimes = new WeakMap<object, string>();
+const registrations = new WeakMap<object, string>();
+
+/** Hosts opt in only while their registration configuration and credential key are unchanged. */
+export async function bindPoolMembershipReferenceRuntime(
+  executor: Executor,
+  registration: object,
+  key: Redacted.Redacted<string>,
+) {
+  const identity = registrations.get(registration) ?? crypto.randomUUID();
+  registrations.set(registration, identity);
+  const hash = new Uint8Array(
+    await crypto.subtle.digest("SHA-256", new TextEncoder().encode(Redacted.value(key))),
+  );
+  runtimes.set(
+    executor[AccountAcquisitionHost],
+    JSON.stringify([
+      identity,
+      Array.from(hash, (byte) => byte.toString(16).padStart(2, "0")).join(""),
+    ]),
+  );
+}
+
+/** Only opaque reference material is reused. Authority and row locks are read live. */
+export const poolMembershipReferences = {
+  scope(executor: Executor, scope: string) {
+    const runtime = runtimes.get(executor[AccountAcquisitionHost]);
+    return runtime === undefined ? undefined : JSON.stringify([runtime, scope]);
+  },
+  get(scope: string | undefined, fingerprint: string) {
+    if (scope === undefined) return undefined;
+    const cached = views.get(scope);
+    if (cached?.fingerprint !== fingerprint) return undefined;
+    views.delete(scope);
+    views.set(scope, cached);
+    return cached.accounts;
+  },
+  put(scope: string | undefined, fingerprint: string, accounts: Accounts) {
+    if (
+      scope === undefined ||
+      new TextEncoder().encode(JSON.stringify([fingerprint, accounts])).byteLength > 262_144 ||
+      accounts.some((row) => row.homeReference === null)
+    )
+      return;
+    views.delete(scope);
+    views.set(scope, { fingerprint, accounts });
+    while (views.size > 16) views.delete(views.keys().next().value!);
+  },
+};
