diff --git a/e2e/tests/saved-account-projection.spec.ts b/e2e/tests/saved-account-projection.spec.ts
new file mode 100644
index 000000000..58f59e76b
--- /dev/null
+++ b/e2e/tests/saved-account-projection.spec.ts
@@ -0,0 +1,161 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { body, type Session } from "../support/api.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { ok } from "../support/app-links.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { contributedApp, contributedSource } from "../support/contributed-app.ts";
+import { Resource } from "../support/contracts.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Access = Schema.Struct({ canUse: Schema.Boolean, canManage: Schema.Boolean });
+const Rows = Schema.Array(
+  Schema.Struct({
+    id: Schema.String,
+    label: Schema.String,
+    identity: Schema.optionalKey(Schema.Unknown),
+    bindings: Schema.Array(
+      Schema.Struct({
+        id: Schema.String,
+        app: Schema.String,
+        scope: Schema.String,
+        requirement: Schema.String,
+        access: Access,
+        canReconnect: Schema.Boolean,
+        canRemove: Schema.Boolean,
+      }),
+    ),
+  }),
+);
+
+layer(RuntimeLive, { excludeTestServices: true })("Saved-account projection", (it) => {
+  it.effect(scenarios.savedAccountProjection.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* contributedApp;
+        const { api, actors, prefix } = f;
+        const personal = yield* f.connect(actors.member, "app", "shared", "Same label");
+        const other = yield* f.connect(actors.owner, "app", "shared", "Same label");
+        const third = yield* f.connect(actors.owner, "user", "own", "Unlinked to pools");
+        yield* ok(yield* f.link(actors.owner, "ordinary", other));
+        const deployed = yield* api.request(actors.member, "POST", `${prefix}/apps/deploy`, {
+          name: "Member's private pool",
+          files: [{ path: "index.ts", content: contributedSource }, appsManifest],
+        });
+        yield* ok(deployed);
+        const privatePool = (yield* body(Resource, deployed)).id;
+        const privatePath = `${prefix}/apps/${privatePool}`;
+        yield* Effect.addFinalizer(() =>
+          api.request(actors.owner, "DELETE", privatePath).pipe(Effect.asVoid, Effect.orDie),
+        );
+        yield* ok(
+          yield* api.request(
+            actors.member,
+            "PUT",
+            `${privatePath}/accounts/app/shared/${personal}`,
+          ),
+        );
+        // Retained pool records predate the projection; activation and credential migration are separate.
+        yield* legacyStorage([
+          {
+            sql: "update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb), '{basaltPools}', $1::jsonb)::text where id = $2",
+            params: [
+              JSON.stringify({ first: { app: f.app.id }, second: { app: privatePool } }),
+              actors.organization.id,
+            ],
+          },
+        ]);
+        yield* serverControl("start");
+        const projection = (actor: Session, pool?: string) =>
+          api
+            .request(
+              actor,
+              "GET",
+              `${prefix}/resources/accounts${pool === undefined ? "" : `?pool=${encodeURIComponent(pool)}`}`,
+            )
+            .pipe(Effect.tap(ok));
+        const rows = (actor: Session, pool?: string) =>
+          projection(actor, pool).pipe(Effect.flatMap((response) => body(Rows, response)));
+        yield* ok(
+          yield* api.request(actors.member, "POST", `${prefix}/accounts/${personal}/health`),
+        );
+        const memberRows = yield* rows(actors.member, f.app.id);
+        expect(
+          memberRows
+            .filter((row) => [personal, other].includes(row.id))
+            .map((row) => row.id)
+            .sort(),
+        ).toEqual([personal, other].sort());
+        expect(memberRows.find((row) => row.id === personal)?.label).toBe("Same label");
+        expect(memberRows.find((row) => row.id === other)?.label).toBe("Same label");
+        expect(memberRows.every((row) => row.identity === undefined)).toBe(true);
+        expect(memberRows.some((row) => row.id === third)).toBe(false);
+        const ownBindings = memberRows.find((row) => row.id === personal)!.bindings;
+        expect(ownBindings).toHaveLength(2);
+        expect(new Set(ownBindings.map((binding) => binding.id)).size).toBe(2);
+        expect(ownBindings.every((binding) => binding.canReconnect)).toBe(true);
+        const foreign = memberRows.find((row) => row.id === other)!;
+        expect(foreign.bindings.every((binding) => !binding.canReconnect)).toBe(true);
+        expect(foreign.bindings.every((binding) => !binding.canRemove)).toBe(true);
+        const native = yield* api.request(actors.member, "GET", `${f.path}/accounts/app`);
+        yield* ok(native);
+        expect(native.body).toEqual(
+          expect.arrayContaining([
+            expect.objectContaining({
+              account: expect.objectContaining({ id: other }),
+              canReconnect: false,
+            }),
+          ]),
+        );
+        expect(
+          (yield* api.request(actors.member, "POST", `${f.path}/accounts/app/shared/connections`, {
+            account: other,
+          })).status,
+        ).toBe(403);
+        const reconnect = yield* api.request(
+          actors.member,
+          "POST",
+          `${f.path}/accounts/app/shared/connections`,
+          { account: personal },
+        );
+        yield* ok(reconnect);
+        const access = yield* body(
+          Access,
+          yield* api.request(actors.owner, "GET", `${privatePath}/access`),
+        );
+        expect(access).toMatchObject({ canManage: true, canUse: false });
+        const managed = yield* rows(actors.owner, privatePool);
+        expect(managed.map((row) => row.id)).toEqual([personal]);
+        expect(managed[0]!.bindings).toEqual(
+          expect.arrayContaining([
+            expect.objectContaining({
+              app: privatePool,
+              access: { canManage: true, canUse: false },
+              canReconnect: false,
+            }),
+          ]),
+        );
+        expect((yield* rows(actors.owner)).find((row) => row.id === personal)?.bindings).toEqual(
+          expect.arrayContaining([expect.objectContaining({ app: privatePool })]),
+        );
+        const raw = (yield* projection(actors.owner, privatePool)).body;
+        const text = JSON.stringify(raw);
+        for (const key of ["canInspect", "canRefresh", "windows", "displayStatus"])
+          expect(text).not.toContain(`"${key}":`);
+        yield* ok(yield* f.unlink(actors.member, "shared", personal));
+        expect((yield* rows(actors.member, f.app.id)).some((row) => row.id === personal)).toBe(
+          false,
+        );
+        const remaining = (yield* rows(actors.member, privatePool)).find(
+          (row) => row.id === personal,
+        )!;
+        expect(remaining.bindings.map((binding) => binding.app)).toEqual([privatePool]);
+        yield* ok(yield* api.request(actors.member, "GET", `${prefix}/accounts/${personal}`));
+      }),
+    ),
+  );
+});
