@@ -0,0 +1,51 @@
+import { permitsAction } from "@executor-js/authorization";
+import {
+  InteractiveHost,
+  type Account,
+  type AccountScope,
+  type App,
+  type Executor,
+  type OwnerId,
+} from "@executor-js/sdk/core";
+import { Effect } from "effect";
+import { AccountTargets } from "../contracts/account-grants.ts";
+import { CurrentAuthorization } from "../contracts/authorization.ts";
+import { checkDestination } from "./connection-policy.ts";
+import { requireRequirementAccess } from "./contributed-account-policy.ts";
+import { AccountGrants } from "./proofs/account-access.ts";
+import { requireProviderAccountMethod } from "./provider-account-methods.ts";
+
+/** Match reconnect's account grant, destination requirement and supported acquisition method. */
+export const canReconnectAccount = (
+  executor: Executor,
+  owner: OwnerId,
+  app: App,
+  scope: AccountScope,
+  requirement: string,
+  account: Account,
+) =>
+  Effect.gen(function* () {
+    if (!permitsAction(yield* CurrentAuthorization, "manage")) return false;
+    const required = app.requirements.accounts[requirement];
+    if (
+      required === undefined ||
+      required.scope !== scope ||
+      required.provider !== account.provider ||
+      !Object.hasOwn(required.definition.auth, account.method)
+    )
+      return false;
+    const grant = yield* AccountGrants.reconnect.pipe(
+      Effect.provideService(AccountTargets.reconnect, { account: account.id }),
+    );
+    yield* checkDestination(
+      grant.access.ownership.kind === "personal" ? { kind: "personal" } : grant.access.ownership,
+    );
+    yield* requireRequirementAccess({ app: app.id, scope, requirement });
+    yield* requireProviderAccountMethod(app, requirement, account.method);
+    return (yield* executor[InteractiveHost].binding({ owner, account: account.id })) === undefined;
+  }).pipe(
+    Effect.catchTags({
+      OrganizationForbidden: () => Effect.succeed(false),
+      AuthMethodInvalid: () => Effect.succeed(false),
+    }),
+  );
