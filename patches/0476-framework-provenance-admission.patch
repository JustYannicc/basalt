--- /dev/null
+++ b/packages/sdk/src/implementation/app-protocol-accounts.ts
@@ -0,0 +1,55 @@
+import { Effect } from "effect";
+import type {
+  HostAccounts,
+  ResolvedAccount,
+  ResolvedAccounts,
+  ResolvedAccountSlots,
+} from "apps/contracts";
+import { RuntimeProtocolFailed, runtimeFailures } from "../contracts/runtime.ts";
+import type { AppProtocol } from "./app-protocols.ts";
+import { sealAccounts, unsealedAccounts } from "./credential-handles.ts";
+
+const strictAccount = (account: ResolvedAccount): ResolvedAccount => {
+  const hosts = account.provider.hosts;
+  return hosts?.some((host) => host.includes("_"))
+    ? {
+        ...account,
+        provider: { ...account.provider, hosts: hosts.filter((host) => !host.includes("_")) },
+      }
+    : account;
+};
+
+const strictSlots = (slots: ResolvedAccountSlots): ResolvedAccountSlots =>
+  Object.fromEntries(
+    Object.entries(slots).map(([slot, selected]) => [
+      slot,
+      "provider" in selected ? strictAccount(selected) : selected.map(strictAccount),
+    ]),
+  );
+
+/** Retained bundles reject underscore metadata; their sealed handles retain the actual grant. */
+export const retainedCredentialHosts = (accounts: ResolvedAccounts): ResolvedAccounts => ({
+  app: strictSlots(accounts.app),
+  ...(accounts.user === undefined ? {} : { user: strictSlots(accounts.user) }),
+});
+
+/** Invocation and Workflow accounts cross the same boundary after credential sealing. */
+export const bundleAccounts = (
+  protocol: Pick<AppProtocol, "accounts" | "sealedCredentials">,
+  app: string,
+  key: Effect.Effect<CryptoKey>,
+  accounts: HostAccounts,
+): Effect.Effect<ResolvedAccounts, RuntimeProtocolFailed> => {
+  const prepared = protocol.sealedCredentials
+    ? sealAccounts(accounts, { app, key })
+    : Effect.gen(function* () {
+        const unsealed = unsealedAccounts(accounts);
+        if (unsealed !== undefined) return unsealed;
+        yield* Effect.annotateCurrentSpan({
+          "executor.runtime.failure": "managed",
+          "executor.runtime.cause": runtimeFailures.managed,
+        });
+        return yield* new RuntimeProtocolFailed({ reason: "managed" });
+      });
+  return prepared.pipe(Effect.map(protocol.accounts));
+};
