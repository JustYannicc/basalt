new file mode 100644
index 0000000..13a2e3b
--- /dev/null
+++ b/packages/sdk/src/implementation/framework-identity.ts
@@ -0,0 +1,18 @@
+/** Canonical module identity, independent of JSON storage encoding. */
+import { Effect } from "effect";
+import type { FrameworkIdentity, WorkerFramework } from "../contracts/worker-build.ts";
+
+/** Shared by publication, admission and the retained-framework migration. */
+export const frameworkIdentity = (framework: Pick<WorkerFramework, "version" | "modules">) =>
+  Effect.promise(async () => {
+    const canonical = JSON.stringify(
+      Object.keys(framework.modules)
+        .sort()
+        .map((name) => [name, framework.modules[name]]),
+    );
+    const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(canonical));
+    const sha256 = Array.from(new Uint8Array(digest), (byte) =>
+      byte.toString(16).padStart(2, "0"),
+    ).join("");
+    return { version: framework.version, sha256 } satisfies FrameworkIdentity;
+  });
diff --git a/packages/sdk/src/implementation/framework-provenance.ts b/packages/sdk/src/implementation/framework-provenance.ts
new file mode 100644
index 0000000..3c13abb
--- /dev/null
+++ b/packages/sdk/src/implementation/framework-provenance.ts
@@ -0,0 +1,232 @@
+/** Source-bound Basalt admission shared by compilation, retained loading and runners. */
+import { Context, Effect, Schema } from "effect";
+import {
+  FrameworkProvenance,
+  type FrameworkProvenance as Provenance,
+} from "../contracts/framework-provenance.ts";
+import { FrameworkProvenanceRefused } from "../contracts/runtime.ts";
+import type {
+  FrameworkIdentity,
+  LoadedWorkerBuild,
+  WorkerBundle,
+  WorkerFramework,
+} from "../contracts/worker-build.ts";
+import { frameworkIdentity } from "./framework-identity.ts";
+import { appProtocol } from "./app-protocols.ts";
+import { approvedFrameworkReleases } from "./basalt-framework-releases.ts";
+
+/** Only host initialization supplies reviewed release artifacts; public build input cannot. */
+export const FrameworkProvenanceRegistry = Context.Reference<readonly Provenance[]>(
+  "basalt/FrameworkProvenanceRegistry",
+  { defaultValue: () => approvedFrameworkReleases },
+);
+
+/** Snapshot host-owned inputs so later mutation cannot change an admitted release. */
+export const frameworkProvenanceRegistry = (releases: readonly Provenance[]) =>
+  Schema.decodeUnknownEffect(Schema.Array(FrameworkProvenance))(releases).pipe(
+    Effect.map((decoded) =>
+      Object.freeze(
+        decoded.map((release) =>
+          Object.freeze({ ...release, source: Object.freeze({ ...release.source }) }),
+        ),
+      ),
+    ),
+  );
+
+export const sameFrameworkProvenance = (left: Provenance, right: Provenance) =>
+  left.version === right.version &&
+  left.sha256 === right.sha256 &&
+  left.protocol === right.protocol &&
+  left.browserSha256 === right.browserSha256 &&
+  left.source.origin === right.source.origin &&
+  left.source.revision === right.source.revision &&
+  left.source.sha256 === right.source.sha256;
+
+interface AdmissionInput {
+  readonly framework: Pick<WorkerFramework, "version" | "modules">;
+  readonly protocol: number;
+  readonly identity?: FrameworkIdentity;
+  readonly claimed?: Provenance;
+  readonly browser?: Readonly<Record<string, string>>;
+  readonly build?: string;
+}
+
+/** Recompute bytes before comparing the exact release tuple and its approved source origin. */
+export const admitFramework = (input: AdmissionInput) =>
+  Effect.gen(function* () {
+    const computed = yield* frameworkIdentity(input.framework);
+    const fields = {
+      version: input.framework.version,
+      protocol: input.protocol,
+      computedHash: computed.sha256,
+      ...(input.build === undefined ? {} : { build: input.build }),
+      ...(input.identity === undefined ? {} : { declaredHash: input.identity.sha256 }),
+    };
+    const refuse = (reason: FrameworkProvenanceRefused["reason"], comparison: string) =>
+      new FrameworkProvenanceRefused({ ...fields, reason, comparison });
+    if (!input.framework.version || Object.keys(input.framework.modules).length === 0)
+      return yield* refuse("missing-identity", "The framework has no version or server modules.");
+    if (input.identity !== undefined) {
+      if (input.identity.version !== computed.version)
+        return yield* refuse(
+          "conflicting-lineage",
+          `Build version ${input.identity.version} differs from framework version ${computed.version}.`,
+        );
+      if (input.identity.sha256 !== computed.sha256)
+        return yield* refuse(
+          "content-mismatch",
+          "The stored server hash differs from its module bytes.",
+        );
+    }
+    const registry = yield* FrameworkProvenanceRegistry;
+    const releases = registry.filter((release) => release.version === computed.version);
+    if (releases.length === 0)
+      return yield* refuse(
+        "unknown-identity",
+        "No approved source-bound release has this version and server hash.",
+      );
+    const release = releases[0]!;
+    if (
+      !Schema.is(FrameworkProvenance)(release) ||
+      releases.some(
+        (other) =>
+          !Schema.is(FrameworkProvenance)(other) || !sameFrameworkProvenance(release, other),
+      )
+    )
+      return yield* refuse(
+        "conflicting-lineage",
+        "The host registry has conflicting release evidence for this version.",
+      );
+    if (release.sha256 !== computed.sha256)
+      return yield* refuse(
+        "content-mismatch",
+        `Approved server SHA-256 ${release.sha256} differs from the computed server hash.`,
+      );
+    if (release.protocol !== input.protocol)
+      return yield* refuse(
+        "protocol-mismatch",
+        `Approved protocol ${release.protocol} differs from recorded protocol ${input.protocol}.`,
+      );
+    if (
+      input.claimed !== undefined &&
+      (!Schema.is(FrameworkProvenance)(input.claimed) ||
+        !sameFrameworkProvenance(release, input.claimed))
+    )
+      return yield* refuse(
+        "conflicting-lineage",
+        "The supplied release tuple or source origin differs from the host registry.",
+      );
+    if (input.browser !== undefined) {
+      const browser = yield* frameworkIdentity({
+        version: computed.version,
+        modules: input.browser,
+      });
+      if (browser.sha256 !== release.browserSha256)
+        return yield* refuse(
+          "content-mismatch",
+          `Approved browser SHA-256 ${release.browserSha256} differs from computed browser SHA-256 ${browser.sha256}.`,
+        );
+    }
+    return Object.freeze({ ...release, source: Object.freeze({ ...release.source }) });
+  });
+
+/** Framework paths are release-owned. A non-string module at one is not published framework code. */
+export const inlinedFramework = (bundle: WorkerBundle, version: string, build?: string) =>
+  Effect.gen(function* () {
+    const modules: Record<string, string> = {};
+    for (const [name, module] of Object.entries(bundle.modules)) {
+      if (!name.startsWith("node_modules/apps/") || !name.endsWith(".js")) continue;
+      if (typeof module !== "string" || name.split("/").includes(".."))
+        return yield* new FrameworkProvenanceRefused({
+          reason: "content-mismatch",
+          version,
+          ...(build === undefined ? {} : { build }),
+          comparison: `Framework module ${name} is not a published JavaScript module.`,
+        });
+      modules[name] = module;
+    }
+    return { version, modules };
+  });
+
+/** Format 1 has no trustworthy label: match exact inlined bytes to approved immutable evidence. */
+export const admitInlinedFramework = (bundle: WorkerBundle, protocol: number, build?: string) =>
+  Effect.gen(function* () {
+    const framework = yield* inlinedFramework(bundle, "unlabelled", build);
+    const computed = yield* frameworkIdentity(framework);
+    if (Object.keys(framework.modules).length === 0)
+      return yield* new FrameworkProvenanceRefused({
+        reason: "missing-identity",
+        protocol,
+        computedHash: computed.sha256,
+        ...(build === undefined ? {} : { build }),
+        comparison: "The inlined build has no published framework modules.",
+      });
+    const registry = yield* FrameworkProvenanceRegistry;
+    const releases = registry.filter((release) => release.sha256 === computed.sha256);
+    const release = releases[0];
+    if (
+      release === undefined ||
+      !Schema.is(FrameworkProvenance)(release) ||
+      releases.some(
+        (other) =>
+          !Schema.is(FrameworkProvenance)(other) || !sameFrameworkProvenance(release, other),
+      )
+    )
+      return yield* new FrameworkProvenanceRefused({
+        reason: release === undefined ? "unknown-identity" : "conflicting-lineage",
+        protocol,
+        computedHash: computed.sha256,
+        ...(build === undefined ? {} : { build }),
+        comparison:
+          "The exact inlined framework has no unambiguous approved Basalt release or inventory evidence.",
+      });
+    return yield* admitFramework({
+      framework: { ...framework, version: release.version },
+      protocol,
+      ...(build === undefined ? {} : { build }),
+    });
+  });
+
+/** Revalidate transports as well as storage. A tuple is evidence only after byte comparison. */
+export const admitLoadedFramework = (
+  loaded: LoadedWorkerBuild,
+  options: { readonly build?: string; readonly previous?: Provenance } = {},
+) =>
+  Effect.gen(function* () {
+    const claimed = loaded.framework;
+    if (claimed === undefined || !Schema.is(FrameworkProvenance)(claimed))
+      return yield* new FrameworkProvenanceRefused({
+        reason: "missing-identity",
+        protocol: loaded.protocol,
+        ...(options.build === undefined ? {} : { build: options.build }),
+        comparison: "The loaded build carries no valid framework tuple.",
+      });
+    const framework = yield* inlinedFramework(loaded, claimed.version, options.build);
+    const admitted = yield* admitFramework({
+      framework,
+      protocol: loaded.protocol,
+      identity: claimed,
+      claimed,
+      ...(options.build === undefined ? {} : { build: options.build }),
+    });
+    if (options.previous !== undefined && !sameFrameworkProvenance(options.previous, admitted))
+      return yield* new FrameworkProvenanceRefused({
+        reason: "conflicting-lineage",
+        version: admitted.version,
+        protocol: loaded.protocol,
+        declaredHash: options.previous.sha256,
+        computedHash: admitted.sha256,
+        ...(options.build === undefined ? {} : { build: options.build }),
+        comparison: "An immutable build changed its previously admitted framework tuple.",
+      });
+    return admitted;
+  });
+
+/** The shared runner hook. Numeric protocol alone never selects a Basalt adapter. */
+export const selectFrameworkProtocol = (
+  loaded: LoadedWorkerBuild,
+  options: { readonly build?: string; readonly previous?: Provenance } = {},
+) =>
+  admitLoadedFramework(loaded, options).pipe(
+    Effect.flatMap((release) => appProtocol(release.protocol)),
+  );
