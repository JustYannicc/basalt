+/** Exact reviewed publication bytes. New builds must match; they never grant themselves admission. */
+import type { FrameworkProvenance } from "../contracts/framework-provenance.ts";
+const releases: readonly FrameworkProvenance[] = [
+  {
+    version: "0.0.1-beta.104-basalt.13",
+    sha256: "4820bfe41e955ad2f684e82fc56083899603ad7e71125b05bf2a01e3959638b4",
+    protocol: 39,
+    browserSha256: "bcac44f049ab9b8ce6f7ce5cdec89b637c0226fb1d176c6b080d9cde56dbe126",
+    source: {
+      origin: "basalt",
+      revision: "92dacc187d657426a121441241189cc9734ea1f8",
+      sha256: "5fc439a9ad05bd999e5df2e4ed4fe6f6cb05288920e8d6a646651c5d684c55f0",
+    },
+  },
+  {
+    version: "0.0.1-beta.104-basalt.16",
+    sha256: "8620f39052102d1f58e9041e808efd9aadb139fda19a6e8693f5fba7713841ce",
+    protocol: 42,
+    browserSha256: "e1e0f8c54a07acf946053720ab96fe317f2edad34aa3e84018c55e1e2162d777",
+    source: {
+      origin: "basalt",
+      revision: "source-sha256:54d19593e2d033418a8ea64e7be12e3d3dc2dfff7839e5c533456b4853fcd465",
