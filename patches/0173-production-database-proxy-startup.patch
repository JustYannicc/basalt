new file mode 100644
--- /dev/null
+++ b/e2e/support/production-ops-proxy-fixtures.ts
@@ -0,0 +1,44 @@
+import { Effect } from "effect";
+import { createServer, type Server } from "node:http";
+import { createServer as tcpServer } from "node:net";
+import { driver } from "./platform.ts";
+
+const close = (server: Server) =>
+  Effect.promise(() => new Promise<void>((resolve) => server.close(() => resolve())));
+
+/** A real HTTP backend owned by the calling proof's scope. */
+export const proxyHttpBackend = (body: string, port = 0) =>
+  Effect.gen(function* () {
+    const server = yield* Effect.acquireRelease(
+      Effect.sync(() => createServer((_request, response) => response.end(body))),
+      close,
+    );
+    return yield* driver(
+      "bind database proxy HTTP backend",
+      () =>
+        new Promise<number>((resolve, reject) => {
+          server.once("error", reject);
+          server.listen(port, "127.0.0.1", () => {
+            server.off("error", reject);
+            const address = server.address();
+            if (address === null || typeof address === "string")
+              reject(new Error("No HTTP fixture port"));
+            else resolve(address.port);
+          });
+        }),
+    );
+  });
+
+/** A competitor must fail with a real bind collision while the proxy owns its listener. */
+export const proxyPortIsHeld = (port: number) =>
+  driver(
+    "contend for database proxy port",
+    () =>
+      new Promise<boolean>((resolve) => {
+        const contender = tcpServer();
+        contender.once("error", (error) => {
+          resolve("code" in error && error.code === "EADDRINUSE");
+        });
+        contender.listen(port, "127.0.0.1", () => contender.close(() => resolve(false)));
+      }),
+  );
diff --git a/e2e/tests/production-ops-database-proxy.spec.ts b/e2e/tests/production-ops-database-proxy.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/production-ops-database-proxy.spec.ts
@@ -0,0 +1,65 @@
+import { expect, layer } from "@effect/vitest";
+import { Cause, Effect } from "effect";
+import { FetchHttpClient, HttpClient } from "effect/http";
+import { productionOpsDatabaseProxy } from "../support/production-ops-database-proxy.ts";
+import { proxyHttpBackend, proxyPortIsHeld } from "../support/production-ops-proxy-fixtures.ts";
+
+layer(FetchHttpClient.layer, { excludeTestServices: true })("database proxy startup", (it) => {
+  it.effect("owns its port before backend startup and forwards both target directions", () =>
+    Effect.gen(function* () {
+      const port = yield* Effect.scoped(
+        Effect.gen(function* () {
+          const http = yield* HttpClient.HttpClient;
+          const proxy = yield* productionOpsDatabaseProxy();
+          const original = yield* proxyHttpBackend("original");
+          const replacement = yield* proxyHttpBackend("replacement");
+          expect(yield* proxyPortIsHeld(proxy.port)).toBe(true);
+          expect(proxy.port).not.toBe(original);
+          expect(proxy.port).not.toBe(replacement);
+          for (const [target, body] of [
+            [original, "original"],
+            [replacement, "replacement"],
+            [original, "original"],
+          ] as const) {
+            yield* proxy.select(target);
+            const response = yield* http.get(`http://127.0.0.1:${proxy.port}`, {
+              headers: { Connection: "close" },
+            });
+            expect(yield* response.text).toBe(body);
+          }
+          return proxy.port;
+        }),
+      );
+      expect(yield* proxyHttpBackend("released", port)).toBe(port);
+    }).pipe(Effect.scoped),
+  );
+
+  it.effect("retains the OS cause instead of an empty failure message", () =>
+    Effect.gen(function* () {
+      const port = yield* proxyHttpBackend("occupied");
+      const exit = yield* Effect.exit(Effect.scoped(productionOpsDatabaseProxy(port)));
+      expect(exit._tag).toBe("Failure");
+      if (exit._tag === "Failure") {
+        const text = Cause.pretty(exit.cause);
+        expect(text).toContain("Database proxy listen failed: EADDRINUSE");
+        expect(text).not.toContain("127.0.0.1");
+      }
+    }).pipe(Effect.scoped),
+  );
+
+  it.effect("releases its listener when later environment setup fails", () =>
+    Effect.gen(function* () {
+      let port = 0;
+      const exit = yield* Effect.exit(
+        Effect.scoped(
+          Effect.gen(function* () {
+            port = (yield* productionOpsDatabaseProxy()).port;
+            return yield* Effect.fail("Synthetic later setup failure");
+          }),
+        ),
+      );
+      expect(exit._tag).toBe("Failure");
+      expect(yield* proxyHttpBackend("released", port)).toBe(port);
+    }).pipe(Effect.scoped),
+  );
+});
