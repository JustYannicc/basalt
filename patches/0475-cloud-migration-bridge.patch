new file mode 100644
index 0000000..b00eafe
--- /dev/null
+++ b/apps/hosted/server/src/implementation/migration-lineage.ts
@@ -0,0 +1,56 @@
+import { Effect } from "effect";
+import { SqlClient } from "effect/sql";
+
+type Journal = "private_hosted_migrations" | "private_cloud_migrations";
+type Entry = { readonly migration_id: number; readonly name: string };
+
+const safeName = (name: string) =>
+  /^[a-z0-9_]{1,100}$/.test(name) ? name : "[invalid migration name]";
+
+/** Effect only checks the largest ID. A missing row or a reused ID must stop the upgrade. */
+export const migrationLineageIssues = (
+  table: Journal,
+  keys: ReadonlyArray<string>,
+  rows: ReadonlyArray<Entry>,
+) => {
+  const issues: Array<string> = [];
+  const expected = new Map<number, string>();
+  for (const key of keys) {
+    const match = /^([1-9][0-9]*)_([a-z0-9_]+)$/.exec(key);
+    if (!match || !Number.isSafeInteger(Number(match[1]))) {
+      issues.push(`${table}: invalid registered migration key`);
+      continue;
+    }
+    const id = Number(match[1]);
+    if (expected.has(id)) issues.push(`${table}: duplicate registered ID ${id}`);
+    expected.set(id, match[2]!);
+  }
+  const applied = new Set<number>();
+  let latest = 0;
+  for (const row of rows) {
+    latest = Math.max(latest, row.migration_id);
+    applied.add(row.migration_id);
+    const name = expected.get(row.migration_id);
+    if (name !== row.name)
+      issues.push(
+        `${table}: ${row.migration_id}_${safeName(row.name)} observed; expected ${name === undefined ? "no operation at this ID" : `${row.migration_id}_${name}`}`,
+      );
+  }
+  for (const [id, name] of expected)
+    if (id <= latest && !applied.has(id))
+      issues.push(`${table}: missing ${id}_${name} below recorded maximum ${latest}`);
+  return issues;
+};
+
+/** Read without creating a journal, so an unsupported history causes no bootstrap writes. */
+export const readMigrationJournal = (table: Journal) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const relation = yield* sql<{ relation: string | null }>`select
+      to_regclass(${`public.${table}`})::text as relation`;
+    if (relation[0]?.relation == null) return [];
+    return yield* sql<Entry>`select migration_id, name from ${sql(table)} order by migration_id`;
+  });
+
+export const checkMigrationLineage = (table: Journal, keys: ReadonlyArray<string>) =>
+  Effect.map(readMigrationJournal(table), (rows) => migrationLineageIssues(table, keys, rows));
