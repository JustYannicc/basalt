diff --git a/apps/hosted/cloud/src/implementation/executor-version-gate.ts b/apps/hosted/cloud/src/implementation/executor-version-gate.ts
new file mode 100644
index 0000000..df3409a
--- /dev/null
+++ b/apps/hosted/cloud/src/implementation/executor-version-gate.ts
@@ -0,0 +1,164 @@
+import { chmod, mkdir, rename, writeFile } from "node:fs/promises";
+import { resolve } from "node:path";
+import { PgClient } from "@effect/sql-pg";
+import { Console, Duration, Effect, Redacted } from "effect";
+import { SqlClient } from "effect/sql";
+
+import {
+  executorVersionPolicy,
+  type ExecutorMarkerPrecondition,
+} from "./executor-version-policy.ts";
+
+export type ExecutorMarkerReceipt = {
+  readonly schemaVersion: 1;
+  readonly transition: ExecutorMarkerPrecondition["transition"];
+  readonly attempt: string;
+  readonly marker: ExecutorMarkerPrecondition["marker"];
+  readonly expected: ExecutorMarkerPrecondition["expected"];
+  readonly observed: string | null;
+  readonly outcome: "accepted" | "refused" | "read_failed";
+  readonly reason?:
+    | "missing"
+    | "multiple_rows"
+    | "invalid_value"
+    | "version_mismatch"
+    | "query_failed";
+};
+
+const safeVersion = (value: unknown): value is string =>
+  typeof value === "string" && /^[0-9]+\.[0-9]+\.[0-9]+$/.test(value);
+
+export const evaluateMarkerRows = (
+  rows: ReadonlyArray<{ readonly value: unknown }>,
+  precondition: ExecutorMarkerPrecondition,
+  attempt: string,
+): ExecutorMarkerReceipt => {
+  const raw = rows.length === 1 ? rows[0]?.value : undefined;
+  const observed = safeVersion(raw) ? raw : null;
+  const reason =
+    rows.length === 0
+      ? "missing"
+      : rows.length > 1
+        ? "multiple_rows"
+        : observed === null
+          ? "invalid_value"
+          : observed !== precondition.expected
+            ? "version_mismatch"
+            : undefined;
+  return {
+    schemaVersion: 1,
+    transition: precondition.transition,
+    attempt,
+    marker: precondition.marker,
+    expected: precondition.expected,
+    observed,
+    outcome: reason === undefined ? "accepted" : "refused",
+    ...(reason === undefined ? {} : { reason }),
+  };
+};
+
+const readFailedReceipt = (
+  precondition: ExecutorMarkerPrecondition,
+  attempt: string,
+): ExecutorMarkerReceipt => ({
+  schemaVersion: 1,
+  transition: precondition.transition,
+  attempt,
+  marker: precondition.marker,
+  expected: precondition.expected,
+  observed: null,
+  outcome: "read_failed",
+  reason: "query_failed",
+});
+
+export const retainExecutorMarkerReceipt = (directory: string, receipt: ExecutorMarkerReceipt) =>
+  Effect.tryPromise({
+    try: async () => {
+      await mkdir(directory, { recursive: true, mode: 0o700 });
+      await chmod(directory, 0o700);
+      const path = resolve(directory, "executor-version-" + receipt.attempt + ".json");
+      const temporary = path + ".tmp";
+      await writeFile(temporary, JSON.stringify(receipt, null, 2) + "\n", { mode: 0o600 });
+      await chmod(temporary, 0o600);
+      await rename(temporary, path);
+    },
+    catch: () => new Error("Executor marker receipt could not be retained; migration not started"),
+  });
+
+/** Injectable core keeps the policy decision testable without SQL or production credentials. */
+export const requireVersionMarker = (options: {
+  readonly precondition: ExecutorMarkerPrecondition;
+  readonly attempt: string;
+  readonly read: Effect.Effect<ReadonlyArray<{ readonly value: unknown }>, unknown>;
+  readonly retain: (receipt: ExecutorMarkerReceipt) => Effect.Effect<void, unknown>;
+}) =>
+  Effect.gen(function* () {
+    const receipt = yield* options.read.pipe(
+      Effect.match({
+        onSuccess: (rows) => evaluateMarkerRows(rows, options.precondition, options.attempt),
+        onFailure: () => readFailedReceipt(options.precondition, options.attempt),
+      }),
+    );
+    yield* options.retain(receipt);
+    if (receipt.outcome === "accepted") return;
+    const observed = receipt.observed ?? "unavailable";
+    const message =
+      "Executor marker " +
+      receipt.marker +
+      " expected " +
+      receipt.expected +
+      ", observed " +
+      observed +
+      "; migration not started";
+    yield* Console.error(message);
+    return yield* Effect.fail(new Error(message));
+  });
+
+export const preflightExecutorVersion = (options: {
+  readonly url: Redacted.Redacted<string>;
+  readonly directory: string;
+  readonly precondition: ExecutorMarkerPrecondition;
+  readonly attempt: string;
+}) => {
+  const read = Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    return yield* sql.unsafe<{ value: unknown }>(
+      "select value from public.private_executor_settings where key = $1 limit 2",
+      ["version"],
+    );
+  }).pipe(
+    Effect.provide(
+      PgClient.layer({
+        url: options.url,
+        maxConnections: 1,
+        connectTimeout: Duration.seconds(10),
+      }),
+    ),
+    Effect.scoped,
+    Effect.timeout(Duration.seconds(20)),
+  );
+  return requireVersionMarker({
+    precondition: options.precondition,
+    attempt: options.attempt,
+    read,
+    retain: (receipt) => retainExecutorMarkerReceipt(options.directory, receipt),
+  });
+};
+
+/** The command supplies the policy selected from the freshly verified production ledger. */
+export const productionExecutorVersionPreflight = (url: Redacted.Redacted<string>) =>
+  Effect.gen(function* () {
+    const policy = yield* Effect.try({
+      try: () =>
+        executorVersionPolicy({
+          attempt: process.env.BASALT_RELEASE_ATTEMPT,
+          candidate: process.env.BASALT_RELEASE_CANDIDATE,
+          policy: process.env.BASALT_EXECUTOR_MARKER_POLICY,
+          directory: process.env.BASALT_RELEASE_EVIDENCE_DIRECTORY,
+        }),
+      catch: () =>
+        new Error("Executor migration marker policy is missing or invalid; migration not started"),
+    });
+    if (policy?.precondition)
+      yield* preflightExecutorVersion({ url, ...policy, precondition: policy.precondition });
+  });
diff --git a/apps/hosted/cloud/src/implementation/executor-version-policy.ts b/apps/hosted/cloud/src/implementation/executor-version-policy.ts
new file mode 100644
index 0000000..3e7677f
--- /dev/null
+++ b/apps/hosted/cloud/src/implementation/executor-version-policy.ts
@@ -0,0 +1,49 @@
+import { Schema } from "effect";
+
+const Commit = Schema.String.check(Schema.isPattern(/^[a-f0-9]{40}$/u));
+const Precondition = Schema.Struct({
+  transition: Schema.Struct({
+    baseGitCommit: Commit,
+    candidateGitCommit: Commit,
+    baseToolsCommit: Schema.Literal("f69c667936e4c02c75f9d7cc79fb750c230839b9"),
+    candidateToolsCommit: Schema.Literal("2f4c398f3906e0570f0e25a16fa3602329baba29"),
+  }),
+  marker: Schema.Literal("public.private_executor_settings.key=version"),
+  expected: Schema.Literal("4.0.29"),
+});
+export type ExecutorMarkerPrecondition = typeof Precondition.Type;
+
+const Policy = Schema.fromJsonString(
+  Schema.Struct({ candidate: Commit, precondition: Schema.NullOr(Precondition) }),
+);
+const Attempt = /^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/;
+
+/** Preview and self-host setup have no production attempt or verified production release plan. */
+export const executorVersionPolicy = (input: {
+  readonly attempt?: string | undefined;
+  readonly candidate?: string | undefined;
+  readonly policy?: string | undefined;
+  readonly directory?: string | undefined;
+}) => {
+  if (!input.attempt) return undefined;
+  try {
+    if (!Attempt.test(input.attempt) || !input.directory)
+      throw new Error("Invalid release identity");
+    const policy = Schema.decodeUnknownSync(Policy)(input.policy);
+    if (
+      policy.candidate !== input.candidate ||
+      (policy.precondition !== null &&
+        policy.precondition.transition.candidateGitCommit !== policy.candidate)
+    )
+      throw new Error("Release candidate mismatch");
+    return {
+      attempt: input.attempt,
+      directory: input.directory,
+      precondition: policy.precondition,
+    };
+  } catch {
+    throw new Error(
+      "Executor migration marker policy is missing or invalid; migration not started",
+    );
+  }
+};
