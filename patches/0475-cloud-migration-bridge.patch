@@ -0,0 +1,218 @@
+import { Effect } from "effect";
+import { SqlClient } from "effect/sql";
+import {
+  migrationLineageIssues,
+  readMigrationJournal,
+} from "@executor-js/hosted-server/migrations";
+
+const operations: ReadonlyArray<readonly [number, string, Readonly<Record<string, string>>]> = [
+  [
+    1,
+    "baseline",
+    {
+      cloud_company_profile: "domain status profile attempts lease retry_at",
+      cloud_organization_setup: "user_id organization_id domain name_edited logo_edited applied",
+      cloud_email_preferences: "user_id optional_emails_unsubscribed_at",
+      cloud_welcome_email: "user_id status created_at attempted_at sent_at",
+    },
+  ],
+  [
+    2,
+    "billing_seats",
+    { cloud_billing_seats: "organization_id synced_count seat_plan checked_at" },
+  ],
+  [3, "app_domain_records", { cloud_app_domain: "organization_id slug status checked_at" }],
+  [
+    4,
+    "organization_removal_starts",
+    { cloud_organization_removal_start: "organization_id instance_id started_at" },
+  ],
+  [
+    5,
+    "v1_import_map",
+    {
+      private_v1_import_map:
+        "v1_org_id v1_kind v1_id v2_kind v2_id status reason source_hash updated_at",
+    },
+  ],
+  [
+    6,
+    "setup_assignments",
+    { cloud_setup_assignment: "user_id organization_id variant assigned_at exposed_at" },
+  ],
+  [
+    7,
+    "v1_import_orgs",
+    { private_v1_import_org: "v1_org_id v2_org_id state run_id report updated_at" },
+  ],
+  [
+    8,
+    "production_ops_receipts",
+    {
+      private_production_ops_receipts:
+        "plan_sha256 organization_id migration revision release backup_sha256 verification applied_at",
+    },
+  ],
+  [9, "production_ops_database_identity", { production_ops_database_identity: "id created_at" }],
+  [
+    10,
+    "tool_policies",
+    {
+      hosted_tool_policies: "id organization_id revision definition",
+      hosted_tool_policy_history:
+        "sequence organization_id policy_id actor action snapshot changed_at",
+    },
+  ],
+  [14, "v1_session_handoffs", { private_v1_session_handoff: "jti expires_at used_at" }],
+  [15, "v1_import_allowed", { private_v1_import_allowed: "v1_org_id added_at note" }],
+  [
+    16,
+    "setup_skip_assignments",
+    {
+      cloud_setup_skip_assignment:
+        "user_id organization_id variant assigned_at exposed_at completed_at",
+    },
+  ],
+  [
+    17,
+    "v1_import_billing",
+    {
+      private_v1_import_billing:
+        "organization_id v1_org_id state subscription stripe_subscription_id updated_at",
+    },
+  ],
+  [18, "v1_import_displacement", { private_v1_import_allowed: "displace_v2_org_id" }],
+  [19, "v1_import_into", { private_v1_import_allowed: "into_v2_org_id into_mode" }],
+];
+
+const indexes = [
+  [
+    1,
+    "baseline",
+    "cloud_welcome_email_pending",
+    "cloud_welcome_email (created_at, user_id) where status = 'pending'",
+    false,
+  ],
+  [5, "v1_import_map", "private_v1_import_map_org", "private_v1_import_map (v1_org_id)", false],
+  [
+    8,
+    "production_ops_receipts",
+    "private_production_ops_receipts_organization",
+    "private_production_ops_receipts (organization_id, applied_at desc)",
+    false,
+  ],
+  [
+    9,
+    "production_ops_database_identity",
+    "production_ops_database_identity_singleton",
+    "production_ops_database_identity ((true))",
+    true,
+  ],
+  [
+    10,
+    "tool_policies",
+    "hosted_tool_policies_organization",
+    "hosted_tool_policies (organization_id, id)",
+    false,
+  ],
+  [
+    10,
+    "tool_policies",
+    "hosted_tool_policy_history_policy",
+    "hosted_tool_policy_history (organization_id, policy_id, sequence)",
+    false,
+  ],
+  [
+    14,
+    "v1_session_handoffs",
+    "private_v1_session_handoff_expires",
+    "private_v1_session_handoff (expires_at)",
+    false,
+  ],
+] as const;
+
+const normalizeIndex = (definition: string) =>
+  definition.toLowerCase().replace(/::text|public\.|[\s"()]/g, "");
+
+/** Check the stored operations too. A receipt alone cannot establish that its SQL survived. */
+export const cloudMigrationStateIssues = (keys: ReadonlyArray<string>) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const rows = yield* readMigrationJournal("private_cloud_migrations");
+    const issues = migrationLineageIssues("private_cloud_migrations", keys, rows);
+    const applied = new Set(rows.map((row) => row.migration_id));
+    const hosted = yield* readMigrationJournal("private_hosted_migrations");
+    const sharedPolicies = hosted.some(
+      (row) => row.migration_id === 16 && row.name === "tool_policies",
+    );
+    const columns = yield* sql<{
+      table_name: string;
+      column_name: string;
+      data_type: string;
+      is_nullable: string;
+      column_default: string | null;
+    }>`select table_name, column_name, data_type, is_nullable, column_default
+      from information_schema.columns where table_schema = 'public'`;
+    for (const [id, name, tables] of operations) {
+      for (const [table, required] of Object.entries(tables)) {
+        for (const column of required.split(" ")) {
+          const actual = columns.find(
+            (item) => item.table_name === table && item.column_name === column,
+          );
+          if (applied.has(id) && !actual) issues.push(`${id}_${name}: missing ${table}.${column}`);
+          // Hosted 16 also owns the policy tables. Their presence before Cloud 10 is supported.
+          if (!applied.has(id) && actual && !(id === 10 && sharedPolicies))
+            issues.push(`${id}_${name}: unjournaled ${table}.${column}`);
+          if (
+            actual &&
+            id >= 18 &&
+            (actual.data_type !== "text" ||
+              actual.is_nullable !== "YES" ||
+              actual.column_default !== null)
+          )
+            issues.push(
+              `${id}_${name}: ${table}.${column} must be nullable text without a default`,
+            );
+          if (actual && id === 9 && column === "id" && actual.data_type !== "uuid")
+            issues.push(
+              "9_production_ops_database_identity: production_ops_database_identity.id must retain its UUID type",
+            );
+        }
+      }
+    }
+    const actualIndexes = yield* sql<{
+      indexname: string;
+      valid: boolean;
+      definition: string;
+    }>`select
+      c.relname as indexname, i.indisvalid as valid, pg_get_indexdef(i.indexrelid) as definition from pg_index i
+      join pg_class c on c.oid = i.indexrelid join pg_namespace n on n.oid = c.relnamespace
+      where n.nspname = 'public'`;
+    for (const [id, name, index, target, unique] of indexes) {
+      if (!applied.has(id)) continue;
+      const actual = actualIndexes.find((item) => item.indexname === index && item.valid);
+      if (!actual) issues.push(`${id}_${name}: missing valid index ${index}`);
+      else {
+        const [table, ...rest] = target.split(" ");
+        const expected = `create ${unique ? "unique " : ""}index ${index} on ${table} using btree ${rest.join(" ")}`;
+        if (normalizeIndex(actual.definition) !== normalizeIndex(expected))
+          issues.push(`${id}_${name}: changed definition of index ${index}; expected ${expected}`);
+      }
+    }
+    if (
+      applied.has(9) &&
+      columns.some(
+        (item) =>
+          item.table_name === "production_ops_database_identity" && item.column_name === "id",
+      )
+    ) {
+      const identity = yield* sql<{
+        count: number;
+      }>`select count(*)::int as count from production_ops_database_identity`;
+      if (identity[0]?.count !== 1)
+        issues.push(
+          "9_production_ops_database_identity: expected exactly one retained UUID; refusing to generate a replacement",
+        );
+    }
+    return issues;
+  });
