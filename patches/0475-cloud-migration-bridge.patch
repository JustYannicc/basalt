+import { Effect } from "effect";
+import { SqlClient } from "effect/sql";
+import {
+  HostedMigrationFailed,
+  migrateProductSteps,
+  migrationFailed,
+} from "@executor-js/hosted-server/migrations";
+import { cloudMigrationStateIssues } from "./cloud-migration-state.ts";
+
+/** The deployment caller holds the hosted advisory lock around this transaction. */
+export const migrateCloudProductSteps = (
+  steps: Record<string, Effect.Effect<void, unknown, SqlClient.SqlClient>>,
+) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const verify = Effect.gen(function* () {
+      const issues = yield* cloudMigrationStateIssues(Object.keys(steps));
+      if (issues.length > 0)
+        return yield* new HostedMigrationFailed({ stage: "product", lineageIssues: issues });
+    });
+    yield* sql.withTransaction(
+      verify.pipe(
+        Effect.andThen(migrateProductSteps("private_cloud_migrations", steps)),
+        Effect.andThen(verify),
+      ),
+    );
+  }).pipe(Effect.mapError(migrationFailed("product")));
diff --git a/apps/hosted/cloud/src/implementation/cloud-migration-state.ts b/apps/hosted/cloud/src/implementation/cloud-migration-state.ts
