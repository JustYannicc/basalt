+/**
+ * The role hosts the API Worker serves itself. A host product that fronts the `app` host with its
+ * own router (`EXECUTOR_APP_HOST_ROUTER`, set only by that product's disposable stages) keeps that
+ * host: its router's custom domain cannot attach to a hostname that already has a record, and a
+ * route on it would take every request before the router sees it. Unset, every role is the API's.
+ */
+const apiRoleHosts = Effect.gen(function* () {
+  const routed = yield* Config.String("EXECUTOR_APP_HOST_ROUTER").pipe(Config.withDefault(""));
