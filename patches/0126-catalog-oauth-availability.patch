diff --git a/e2e/tests/catalog-oauth-deferrals.spec.ts b/e2e/tests/catalog-oauth-deferrals.spec.ts
new file mode 100644
index 0000000..21ed999
--- /dev/null
+++ b/e2e/tests/catalog-oauth-deferrals.spec.ts
@@ -0,0 +1,146 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { randomUUID } from "node:crypto";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { officialApps } from "../support/public-catalogs.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Catalog = Schema.Array(
+  Schema.Struct({
+    id: Schema.String,
+    oauthDeferrals: Schema.optional(
+      Schema.Array(
+        Schema.Struct({
+          method: Schema.String,
+          message: Schema.String,
+        }),
+      ),
+    ),
+  }),
+);
+
+layer(HostedLive, { excludeTestServices: true })("Catalog OAuth deferrals", (it) => {
+  it.effect(scenarios.catalogOAuthDeferrals.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          browser = yield* Browser;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const entries = yield* body(
+          Catalog,
+          yield* api.request(actors.owner, "GET", "/api/catalog"),
+        );
+        expect(
+          entries.find((entry) => entry.id === officialApps.tracker.id)?.oauthDeferrals,
+        ).toEqual(officialApps.tracker.oauthDeferrals);
+        const installed = yield* api.request(actors.owner, "POST", `${prefix}/apps/install`, {
+          entry: officialApps.tracker.id,
+          name: `Tracker guidance ${randomUUID().slice(0, 8)}`,
+        });
+        expect(installed.status, JSON.stringify(installed.body)).toBe(200);
+        const app = yield* body(Resource, installed);
+        yield* Effect.addFinalizer(() =>
+          api.request(actors.owner, "DELETE", `${prefix}/apps/${app.id}`).pipe(Effect.orDie),
+        );
+        yield* browser.login(actors.owner);
+        yield* browser.use("Open Add app", (page) =>
+          page.goto(`/org/${actors.organization.slug}/apps/add`),
+        );
+        yield* browser.use("Wait for the catalog row", (page) =>
+          page.locator(".catalog-row", { hasText: officialApps.tracker.name }).waitFor(),
+        );
+        expect(
+          yield* browser.use("Deferrals stay out of catalog cards", (page) =>
+            page.getByText(officialApps.tracker.oauthDeferrals[1].message, { exact: true }).count(),
+          ),
+        ).toBe(0);
+
+        const open = browser.use("Open installed app Connect", (page) =>
+          page
+            .goto(`/org/${actors.organization.slug}/apps/${app.id}?view=accounts`)
+            .then(() =>
+              page.getByRole("button", { name: "Connect new account", exact: true }).click(),
+            ),
+        );
+        yield* open;
+        yield* browser.use("Wait for resolved client setup", (page) =>
+          page
+            .getByRole("dialog")
+            .getByRole("button", { name: "Register OAuth client", exact: true })
+            .waitFor(),
+        );
+        yield* browser.use("Wait for dialog motion to settle", (page) =>
+          page.waitForFunction(() =>
+            document.getAnimations().every((animation) => animation.playState !== "running"),
+          ),
+        );
+        yield* browser.checkpoint("Catalog OAuth missing-client guidance");
+        expect(
+          yield* browser.use(
+            "The exact method's deferral replaces the generic explanation",
+            (page) => page.getByRole("dialog").innerText(),
+          ),
+        ).toContain(officialApps.tracker.oauthDeferrals[1].message);
+        expect(
+          yield* browser.use("Other methods' guidance stays hidden", (page) =>
+            page.getByRole("dialog").innerText(),
+          ),
+        ).not.toContain(officialApps.tracker.oauthDeferrals[0].message);
+        yield* browser.use("Open Advanced client choices", (page) =>
+          page.getByRole("dialog").locator("summary").filter({ hasText: "Advanced" }).click(),
+        );
+        yield* browser.use("Keep the personal developer app choice", (page) =>
+          page
+            .getByRole("dialog")
+            .getByRole("checkbox", { name: "Use your own Synthetic Tracker app for this account" })
+            .click(),
+        );
+        yield* browser.use("Manual client entry remains available", (page) =>
+          page.getByRole("dialog").getByLabel("Client ID", { exact: true }).waitFor(),
+        );
+        yield* browser.use("Wait for dialog motion to settle", (page) =>
+          page.waitForFunction(() =>
+            document.getAnimations().every((animation) => animation.playState !== "running"),
+          ),
+        );
+        yield* browser.checkpoint("Catalog OAuth personal client guidance");
+        const registered = yield* api.request(actors.owner, "POST", `${prefix}/oauth-clients`, {
+          issuer: "https://tracker.example.test/oauth/token",
+          clientId: "synthetic-guidance-client",
+          clientSecret: "synthetic-guidance-secret",
+        });
+        expect(registered.status, JSON.stringify(registered.body)).toBe(200);
+        const client = yield* body(Schema.Struct({ client: Resource }), registered);
+        yield* Effect.addFinalizer(() =>
+          api
+            .request(actors.owner, "DELETE", `${prefix}/oauth-clients/${client.client.id}`)
+            .pipe(Effect.orDie),
+        );
+        yield* open;
+        yield* browser.use("A registered client restores Connect", (page) =>
+          page
+            .getByRole("dialog")
+            .getByRole("button", { name: "Connect Synthetic Tracker", exact: true })
+            .waitFor(),
+        );
+        expect(
+          yield* browser.use("Working client suppresses the deferral", (page) =>
+            page.getByRole("dialog").innerText(),
+          ),
+        ).not.toContain(officialApps.tracker.oauthDeferrals[1].message);
+        yield* browser.use("Wait for dialog motion to settle", (page) =>
+          page.waitForFunction(() =>
+            document.getAnimations().every((animation) => animation.playState !== "running"),
+          ),
+        );
+        yield* browser.checkpoint("Catalog OAuth registered client");
+      }),
+    ),
+  );
+});
