 import type { AppId } from "@executor-js/sdk/core";
-import { Effect } from "effect";
+import { Effect, Schema } from "effect";
 import { SqlClient } from "effect/sql";
 import { AccessLifecycle } from "../contracts/access-lifecycle.ts";
+
+const Registration = Schema.Struct({
+  database: Schema.String,
+  schema: Schema.String,
+  native: Schema.Boolean,
+  legacy: Schema.Boolean,
+});
+
+const poolRegistrations = (organization: string, pool: AppId) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const rows = yield* sql`select current_database() as database,current_schema() as schema,
+      coalesce(entry.value ->> 'membership' = 'executor-links-v1',false) as native,
+      (app.active_deployment is not null
+        and entry.value ->> 'membership' is distinct from 'executor-links-v1') as legacy
+      from organization o
+      cross join lateral jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) entry
+      join executor_apps app on app.id = entry.value ->> 'app' and app.owner = 'organization:' || o.id
+      where o.id = ${organization} and app.id = ${pool}`;
+    return yield* Schema.decodeUnknownEffect(Schema.Array(Registration))(rows);
+  });
+
+const handoff = (pool: AppId) =>
+  Effect.gen(function* () {
+    const lifecycle = yield* AccessLifecycle;
+    yield* lifecycle.appAccountLinksChanged?.({ apps: [pool] }) ?? Effect.void;
+  });
+
+/** The organization lock protects this read; a handoff must finish before native authority is read. */
+export const readNativePoolRegistration = (organization: string, pool: AppId) =>
+  Effect.gen(function* () {
+    let registrations = yield* poolRegistrations(organization, pool);
+    if (registrations.some((registration) => registration.legacy)) {
+      yield* handoff(pool);
+      registrations = yield* poolRegistrations(organization, pool);
+    }
+    return registrations.find((registration) => registration.native);
+  });
 
