diff --git a/e2e/tests/local-account-connect-no-write.spec.ts b/e2e/tests/local-account-connect-no-write.spec.ts
new file mode 100644
index 0000000..bb572a7
--- /dev/null
+++ b/e2e/tests/local-account-connect-no-write.spec.ts
@@ -0,0 +1,150 @@
+/** The local dashboard's account forms open and close without saving anything. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import type { Page } from "playwright";
+import { TestLive, withCase } from "../support/case.ts";
+import { accountFamilyProduct } from "../support/account-family-product.ts";
+import { accountIdentityIssuer } from "../support/account-identity-issuer.ts";
+import { accountIdentityProduct } from "../support/account-identity-product.ts";
+import { Browser } from "../support/browser.ts";
+import { body } from "../support/api.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(TestLive, { excludeTestServices: true })("Local account connect writes", (it) => {
+  it.effect(scenarios.localAccountConnectNoWrite.title, (context) =>
+    withCase(
+      context,
+      Effect.gen(function* () {
+        const issuer = yield* accountIdentityIssuer;
+        yield* accountFamilyProduct(issuer.origin);
+        const product = yield* accountIdentityProduct,
+          browser = yield* Browser;
+        const existing = yield* product.deploy(issuer.origin, "Existing reader", ["read"]);
+        yield* product.connect(existing, "own-client");
+        yield* product.deploy(issuer.origin, "Writer", ["write"]);
+        // An OAuth provider with no identity and no registered client: its form asks for the
+        // person's own client. The same at a site provider that starts at its default origin.
+        const plainOAuth = { identity: undefined, tokenEndpointAuthMethod: undefined };
+        const plain = yield* product.deploy(
+          "https://oauth.example.test",
+          "Connect writes",
+          ["read"],
+          plainOAuth,
+        );
+        const site = yield* product.deploy(
+          "https://site.example.test",
+          "Connect writes site",
+          ["read"],
+          plainOAuth,
+          undefined,
+          {
+            site: {
+              label: "Account site",
+              origin: "https://site.example.test",
+              defaultOrigin: true,
+            },
+          },
+        );
+        const paired = yield* body(
+          Schema.Struct({ url: Schema.String }),
+          yield* product.request("POST", "/auth/pair"),
+        );
+        yield* browser.use("Pair the local browser", (page) =>
+          page.goto(paired.url).then(() => page.getByRole("link", { name: /^Accounts/ }).waitFor()),
+        );
+        // Every write the page sends while a form opens and closes, and every reuse plan's answer.
+        const writes: string[] = [];
+        const plans: string[] = [];
+        yield* browser.use("Record the page's writes", (page) =>
+          page.route(/\/(?:dashboard\/api|v1)\//, (route) => {
+            const method = route.request().method();
+            const path = new URL(route.request().url()).pathname;
+            if (/\/oauth\/plan(?:-target)?$/.test(path))
+              return route.fetch().then((response) =>
+                response
+                  .json()
+                  .then((plan: { readonly status?: unknown }) => {
+                    plans.push(`${response.status()} ${String(plan.status)}`);
+                  })
+                  .then(() => route.fulfill({ response })),
+              );
+            // A provider's OAuth setup is read with a POST body naming the provider or connection.
+            if (
+              method !== "GET" &&
+              method !== "HEAD" &&
+              !path.includes("/telemetry/") &&
+              path !== "/dashboard/api/accounts/oauth/setup"
+            )
+              writes.push(`${method} ${path}`);
+            return route.continue();
+          }),
+        );
+        const openAndClose = (
+          label: string,
+          open: (page: Page) => Promise<unknown>,
+          reopened: (page: Page) => Promise<unknown>,
+        ) =>
+          Effect.gen(function* () {
+            writes.length = 0;
+            yield* browser.use(`Open ${label}`, open);
+            yield* browser.use(`Close ${label} without signing in`, (page) =>
+              page.keyboard
+                .press("Escape")
+                .then(() => page.getByRole("dialog").waitFor({ state: "hidden" }))
+                // A full reload starts after any request the closing form sent, so the record is
+                // complete before it is read.
+                .then(() => page.reload())
+                .then(() => reopened(page)),
+            );
+            return [...writes];
+          });
+        const connectNew = (app: string) => (page: Page) =>
+          page
+            .goto(`/apps/${app}?view=accounts`)
+            .then(() =>
+              page.getByRole("button", { name: "Connect new account", exact: true }).click(),
+            )
+            .then(() =>
+              page.getByRole("dialog").getByLabel("Client ID", { exact: true }).waitFor(),
+            );
+        const connectButton = (page: Page) =>
+          page.getByRole("button", { name: "Connect new account", exact: true }).waitFor();
+        const plainWrites = yield* openAndClose("the plain form", connectNew(plain), connectButton);
+        const siteWrites = yield* openAndClose("the site form", connectNew(site), connectButton);
+        const familyWrites = yield* openAndClose(
+          "the saved identity's form for Writer",
+          (page) =>
+            page
+              .goto("/accounts")
+              .then(() =>
+                page.getByRole("button", { name: "Manage same@example.test", exact: true }).click(),
+              )
+              .then(() =>
+                page
+                  .getByRole("menuitem", { name: "Add Fixture identity app", exact: true })
+                  .click(),
+              )
+              .then(() => page.getByRole("combobox", { name: "App", exact: true }).click())
+              .then(() => page.getByRole("option", { name: "Writer", exact: true }).click())
+              // The saved identity stays preselected and its reuse is planned: Writer needs
+              // access the saved sign-in never granted.
+              .then(() =>
+                page
+                  .getByRole("dialog")
+                  .getByText(/^Continue to approve the additional access/)
+                  .waitFor(),
+              ),
+          (page) =>
+            page.getByRole("button", { name: "Manage same@example.test", exact: true }).waitFor(),
+        );
+        expect(
+          { plain: plainWrites, site: siteWrites, family: familyWrites },
+          "Opening and closing each form sends no write",
+        ).toEqual({ plain: [], site: [], family: [] });
+        expect([...new Set(plans)], "The saved identity's reuse was planned to an answer").toEqual([
+          "200 consent-required",
+        ]);
+      }),
+    ),
+  );
+});
