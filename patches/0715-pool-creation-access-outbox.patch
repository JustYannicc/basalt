+/**
+ * Send a new pool's audience to the pool Worker. The hook reads the audience when it runs, so a
+ * sharing change made since the pool was created is included. A pool Worker that refuses or does
+ * not answer fails the attempt, and the job is tried again. It never runs member setup.
+ */
+const deliverPoolAccess = (job: {
+  readonly id: string;
+  readonly organization_id: OrganizationId;
+}) =>
+  Effect.gen(function* () {
+    const lifecycle = yield* AccessLifecycle;
+    yield* (
+      lifecycle.appAccessChanged?.({
+        organization: job.organization_id,
+        apps: [job.id.slice(poolAccessJobPrefix.length)],
+      }) ?? Effect.void
+    );
+  });
+
+/**
+ * Run a pool's access job now, in the request that queued or repeated it, so the pool Worker
+ * normally knows a new pool before its creation answers. An attempt that fails or is cut short
+ * returns the job to `queued` for the queue's runner, which Cloud starts after the request; a
+ * killed attempt waits for the stale-claim scan. A job already delivered, and any other job, is
+ * left untouched.
+ */
+export const provisionPoolAccess = (pool: string) =>
+  attempt(poolAccessJobPrefix + pool, "request", "member", (job) =>
+    job.kind === "member" && job.id.startsWith(poolAccessJobPrefix)
+      ? deliverPoolAccess(job)
+      : Effect.die(new Error("Claimed a job of another kind")),
+  );
+
