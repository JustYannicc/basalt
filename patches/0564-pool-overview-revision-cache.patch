+      organization.role,
+      user,
+      JSON.stringify(policy),
+      app.id,
+      app.activeVersion ?? "",
+      JSON.stringify(operation.input),
+    ]);
+    return yield* cached(key, current(app), read, registeredPool(app.id));
+  });
