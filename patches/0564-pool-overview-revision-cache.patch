new file mode 100644
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-view-cache.ts
@@ -0,0 +1,190 @@
+import { Clock, Effect, Schema, Semaphore } from "effect";
+import { StorageError, observationDeadline, type App } from "@executor-js/sdk/core";
+import { AccountObservationResult } from "apps/contracts";
+import { HttpServerRequest } from "effect/http";
+import { CurrentAuthorization } from "../contracts/authorization.ts";
+import { CurrentOrganization, organizationOwner } from "../contracts/organization.ts";
+import { CurrentUserId } from "../contracts/auth.ts";
+import { GroupDatabase } from "../contracts/groups.ts";
+import { makeChangeJournal } from "./change-revisions.ts";
+import { organizationChangeKeys } from "./organization-changes.ts";
+import { ChangeSnapshot, changeIdentity } from "./scoped-changes.ts";
+import { registeredPool } from "./provider-account-policy.ts";
+import { sendPoolCommand } from "./pool-backend.ts";
+
+type Snapshot = typeof ChangeSnapshot.Type;
+const reusable = (value: Schema.Json): boolean => {
+  if (value === null || typeof value !== "object") return true;
+  if (("ok" in value && value.ok === false) || ("state" in value && value.state === "denied"))
+    return false;
+  return Object.values(value).every(reusable);
+};
+const fingerprint = (head: Snapshot) => JSON.stringify([head.identity, head.revisions]);
+const isObservationResult = Schema.is(AccountObservationResult);
+
+/** Expiry changes the presentation even without a write to the change journal. */
+const presentationDeadline = (value: Schema.Json, now: number): number => {
+  if (value === null || typeof value !== "object") return Infinity;
+  const observation = isObservationResult(value) ? observationDeadline(value) : Infinity;
+  return Math.min(
+    observation > now ? observation : Infinity,
+    ...Object.entries(value).map(([key, child]) => {
+      const deadline =
+        typeof child === "string" && ["staleAt", "expiresAt", "resetsAt", "resetAt"].includes(key)
+          ? Date.parse(child)
+          : NaN;
+      return Number.isFinite(deadline) && deadline > now
+        ? deadline
+        : presentationDeadline(child, now);
+    }),
+  );
+};
+
+/** Callers authorize each request first. Only equal authoritative heads can reuse a result. */
+export const makePoolViewCache = () => {
+  const entries = new Map<
+    string,
+    { value: Schema.Json; head: string; until: number; bytes: number }
+  >();
+  let bytes = 0;
+  const locks = new Map<string, { semaphore: Semaphore.Semaphore; users: number }>();
+  const drop = (key: string) => {
+    bytes -= entries.get(key)?.bytes ?? 0;
+    entries.delete(key);
+  };
+  const load = <E, R, E2, R2, E3, R3>(
+    key: string,
+    guard: Effect.Effect<Snapshot, E, R>,
+    read: Effect.Effect<Schema.Json, E2, R2>,
+    eligible: Effect.Effect<boolean, E3, R3>,
+  ) =>
+    Effect.gen(function* () {
+      if (!entries.has(key) && !(yield* eligible)) return yield* read;
+      const head = yield* guard.pipe(Effect.onError(() => Effect.sync(() => drop(key))));
+      const now = yield* Clock.currentTimeMillis;
+      if (head.validUntil !== undefined && head.validUntil <= now) {
+        drop(key);
+        return yield* new StorageError();
+      }
+      const saved = entries.get(key);
+      if (saved && saved.head === fingerprint(head) && saved.until > now) {
+        // Refresh insertion order for the bounded LRU; never share mutable runtime results.
+        entries.delete(key);
+        entries.set(key, saved);
+        return structuredClone(saved.value);
+      }
+      drop(key);
+      if (!(yield* eligible)) return yield* read;
+      const value = yield* read;
+      const after = yield* guard;
+      const completed = yield* Clock.currentTimeMillis;
+      if (
+        fingerprint(head) !== fingerprint(after) ||
+        (after.validUntil !== undefined && after.validUntil <= completed)
+      )
+        return yield* new StorageError();
+      const size = new TextEncoder().encode(JSON.stringify(value)).byteLength;
+      // A cutoff crossed during the fill must still prevent caching its old verdict.
+      const until = Math.min(
+        head.validUntil ?? Infinity,
+        after.validUntil ?? Infinity,
+        presentationDeadline(value, now),
+      );
+      if (reusable(value) && size <= 1024 * 1024 && until > completed) {
+        while (entries.size >= 64 || bytes + size > 16 * 1024 * 1024) {
+          const oldest = entries.keys().next().value;
+          if (oldest === undefined) break;
+          drop(oldest);
+        }
+        entries.set(key, {
+          value: structuredClone(value),
+          head: fingerprint(after),
+          until,
+          bytes: size,
+        });
+        bytes += size;
+      }
+      return value;
+    });
+  return <E, R, E2, R2, E3 = never, R3 = never>(
+    key: string,
+    guard: Effect.Effect<Snapshot, E, R>,
+    read: Effect.Effect<Schema.Json, E2, R2>,
+    eligible: Effect.Effect<boolean, E3, R3> = Effect.succeed(true),
+  ) =>
+    Effect.suspend(() => {
+      const lock = locks.get(key) ?? { semaphore: Semaphore.makeUnsafe(1), users: 0 };
+      if (!locks.has(key) && locks.size >= 64) return read;
+      locks.set(key, lock);
+      lock.users++;
+      return lock.semaphore.withPermit(load(key, guard, read, eligible)).pipe(
+        Effect.ensuring(
+          Effect.sync(() => {
+            lock.users--;
+            if (lock.users === 0) locks.delete(key);
+          }),
+        ),
+      );
+    });
+};
+const cached = makePoolViewCache();
+
+/** Request ingress rechecks sessions; this guard follows organization data and sharing. */
+const current = (app: App) =>
+  Effect.gen(function* () {
+    const access = yield* CurrentOrganization;
+    const user = yield* CurrentUserId;
+    if (user === undefined) return yield* new StorageError();
+    const sql = yield* Effect.flatten(GroupDatabase);
+    const native = yield* sendPoolCommand("changeRevisions", { pool: app.id }, ChangeSnapshot);
+    return {
+      ...native,
+      revisions: [
+        ...native.revisions,
+        ...(yield* makeChangeJournal(sql).current(
+          organizationOwner(access.organization),
+          organizationChangeKeys,
+        )),
+      ],
+    };
+  }).pipe(Effect.catch(() => new StorageError()));
+
+export const withPoolViewCache = <E, R>(
+  app: App,
+  operation: {
+    readonly name: string;
+    readonly version?: string | undefined;
+    readonly input: Schema.Json;
+  },
+  read: Effect.Effect<Schema.Json, E, R>,
+) =>
+  Effect.gen(function* () {
+    // The shape is a cheap candidate filter; a miss checks the saved pool registration.
+    if (
+      operation.name !== "view" ||
+      app.requirements.dependencies?.accountView === undefined ||
+      app.requirements.accounts.pool === undefined ||
+      (operation.version !== undefined && operation.version !== app.activeVersion)
+    )
+      return yield* read;
+    const request = yield* Effect.serviceOption(HttpServerRequest.HttpServerRequest);
+    if (request._tag === "None") return yield* read;
+    const organization = yield* CurrentOrganization;
+    const user = yield* CurrentUserId;
+    if (user === undefined) return yield* read;
+    const policy = yield* CurrentAuthorization;
+    const key = yield* changeIdentity([
+      request.value.originalUrl.split("?")[0]!,
+      request.value.headers.host ?? "",
+      request.value.headers.authorization ?? "",
+      request.value.headers.cookie ?? "",
+      organization.organization,
+      organization.role,
+      user,
+      JSON.stringify(policy),
+      app.id,
+      app.activeVersion ?? "",
+      JSON.stringify(operation.input),
+    ]);
+    return yield* cached(key, current(app), read, registeredPool(app.id));
+  });
