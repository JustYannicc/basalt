diff --git a/scripts/build-basalt-framework.ts b/scripts/build-basalt-framework.ts
new file mode 100644
index 0000000..1dc5410
--- /dev/null
+++ b/scripts/build-basalt-framework.ts
@@ -0,0 +1,31 @@
+/** Production uses the same unpublished framework package assets as hosted test stages. */
+import * as NodeRuntime from "@effect/platform-node/NodeRuntime";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { Effect, FileSystem, Path } from "effect";
+import { ChildProcess, ChildProcessSpawner } from "effect/process";
+import { packedAppsFramework } from "../apps/hosted/cloud/src/implementation/test-stage-commands.ts";
+
+NodeRuntime.runMain(
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem;
+    const path = yield* Path.Path;
+    const processes = yield* ChildProcessSpawner.ChildProcessSpawner;
+    const archive = path.resolve(".local/test-runtime/apps.tgz");
+    yield* fs.makeDirectory(path.dirname(archive), { recursive: true });
+    const code = yield* processes.exitCode(
+      ChildProcess.make("bun", ["pm", "pack", "--ignore-scripts", "--filename", archive], {
+        cwd: path.resolve("packages/apps/dist"),
+        stdout: "inherit",
+        stderr: "inherit",
+      }),
+    );
+    if (Number(code) !== 0) return yield* Effect.die(new Error("Framework packing failed"));
+    const framework = yield* packedAppsFramework;
+    const destination = path.resolve(".local/basalt-framework");
+    yield* fs.makeDirectory(destination, { recursive: true });
+    yield* fs.copyFile(
+      path.join(framework.EXECUTOR_APPS_FRAMEWORK, "framework.json"),
+      path.join(destination, "framework.json"),
+    );
+  }).pipe(Effect.provide(NodeServices.layer)),
+);
