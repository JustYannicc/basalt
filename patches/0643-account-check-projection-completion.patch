--- /dev/null
+++ b/packages/ui/src/contracts/observed-result.ts
@@ -0,0 +1,45 @@
+/** Join a view's in-flight result without activating a closed view's retained query. */
+import { Effect } from "effect";
+import { Atom, AtomRegistry, AsyncResult } from "effect/reactivity";
+
+const observed = (
+  node: AtomRegistry.Node<unknown> | undefined,
+  visited = new Set<object>(),
+): boolean => {
+  if (node === undefined || visited.has(node)) return false;
+  visited.add(node);
+  return node.listeners.size > 0 || [...node.children].some((child) => observed(child, visited));
+};
+
+/** Retained derived nodes are not observers; only a live listener justifies joining the read. */
+export const settleObserved = <A, E>(
+  registry: AtomRegistry.AtomRegistry,
+  query: Atom.Atom<AsyncResult.AsyncResult<A, E>>,
+) => {
+  const key = Atom.isSerializable(query) ? query[Atom.SerializableTypeId].key : query;
+  if (!observed(registry.getNodes().get(key))) return Effect.void;
+  const previous = registry.get(query);
+  return Effect.callback<void, E>((resume) => {
+    let done = false;
+    let cancel = () => {};
+    const complete = (result: Effect.Effect<void, E>) => {
+      if (done) return;
+      done = true;
+      cancel();
+      resume(result);
+    };
+    const changed = (result: AsyncResult.AsyncResult<A, E>) => {
+      if (result === previous || result.waiting) return;
+      if (AsyncResult.isFailure(result)) complete(Effect.failCause(result.cause));
+      else if (AsyncResult.isSuccess(result)) complete(Effect.void);
+    };
+    cancel = registry.subscribe(query, changed);
+    if (done) cancel();
+    changed(registry.get(query));
+    // Effect.callback runs its returned cleanup only on interruption.
+    return Effect.sync(() => {
+      done = true;
+      cancel();
+    });
+  });
+};
