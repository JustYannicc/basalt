+/**
+ * List values this page published from its own confirmed saves. The read a save starts only
+ * reconciles the setting against the catalog already on screen, so that catalog stays; every
+ * other read, such as a return to the page or a linked-account change, shows none until it answers.
+ */
+const acknowledgedLists = new WeakSet<object>();
+
+const ownSave = <A extends object, E>(
+  result: AsyncResult.AsyncResult<A, E>,
+): AsyncResult.AsyncResult<A, E> =>
+  AsyncResult.isSuccess(result) && result.waiting && acknowledgedLists.has(result.value)
+    ? AsyncResult.success<A, E>(result.value, { timestamp: result.timestamp })
+    : result;
+
