+import {
+  AccountAcquisitionHost,
+  AccountFieldsInvalid,
+  AccountId,
+  StorageError,
+  type AccountScope,
+  type AppId,
+} from "@executor-js/sdk/core";
+import { Effect } from "effect";
+import { HostedExecutor } from "../contracts/executor.ts";
+import { RequirementMismatch, type ImportRequirementLoginFile } from "../contracts/app-accounts.ts";
+import { currentOwner } from "./access.ts";
+import { checkDestination } from "./connection-policy.ts";
+import {
+  requireRequirementAccess,
+  requireRequirementAccessAs,
+} from "./contributed-account-policy.ts";
+import { lockCurrentActor, policyDatabase, requireAccountAccessAs } from "./resource-policy.ts";
+import { lockAppLinks } from "./app-accounts.ts";
+import { accountDestination } from "./resource-lifecycle.ts";
+import {
+  registeredPool,
+  requireProviderConnectionTarget,
+  requirementConnectionPolicies,
+} from "./provider-account-policy.ts";
+import { providerLoginFile } from "./provider-login-file.ts";
+import { recordedServiceInstalls } from "./service-install-records.ts";
+
+export const importRequirementLoginFile = (
+  scope: AccountScope,
+  input: { readonly app: AppId; readonly requirement: string },
+  payload: typeof ImportRequirementLoginFile.Type,
+) =>
+  Effect.gen(function* () {
+    const owner = yield* currentOwner;
+    const executor = yield* Effect.flatten(HostedExecutor);
+    const destination = payload.destination ?? { kind: "personal" as const };
+    const target = Effect.gen(function* () {
+      yield* requireRequirementAccess({ ...input, scope });
+      const app = yield* executor.apps.get({ owner, app: input.app });
+      const requirement = app.requirements.accounts[input.requirement];
+      if (scope !== "app" || requirement?.scope !== scope)
+        return yield* new RequirementMismatch({ ...input, scope, reason: "requirement" });
+      yield* requireProviderConnectionTarget(app, input.requirement);
+      const policies = yield* requirementConnectionPolicies(app);
+      if (
+        !policies.some(
+          (policy) =>
+            policy.requirement === input.requirement &&
+            policy.importMethods.includes(payload.method),
+        )
+      )
+        return yield* new AccountFieldsInvalid({
+          provider: requirement.provider,
+          method: payload.method,
+        });
+      yield* checkDestination(destination);
+      const service = (yield* recordedServiceInstalls(yield* policyDatabase, [app])).get(app.id);
+      return { app, provider: requirement.provider, service };
+    });
+    const initial = yield* target;
+    const { provider } = initial;
+    const fields = yield* Effect.try({
+      try: () => providerLoginFile(payload.method, payload.file),
+      catch: () => new AccountFieldsInvalid({ provider, method: payload.method }),
+    });
+    const authorize = (account?: AccountId) =>
+      Effect.gen(function* () {
+        const sql = yield* policyDatabase;
+        const actor = yield* lockCurrentActor;
+        yield* lockAppLinks(sql, input.app);
+        yield* requireRequirementAccessAs(actor, { ...input, scope });
+        const app = yield* executor.apps.get({ owner, app: input.app });
+        const service = (yield* recordedServiceInstalls(yield* policyDatabase, [app])).get(app.id);
+        if (
+          (yield* registeredPool(app.id)) ||
+          app.activeVersion !== initial.app.activeVersion ||
+          app.requirements.accounts[input.requirement]?.provider !== provider ||
+          JSON.stringify(service) !== JSON.stringify(initial.service)
+        )
+          return yield* new StorageError();
+        yield* checkDestination(destination);
+        if (account !== undefined) yield* requireAccountAccessAs(actor, account, "manage");
+      }).pipe(Effect.mapError(() => new StorageError()));
+    const context = yield* Effect.context<Effect.Services<ReturnType<typeof authorize>>>();
+    return yield* executor[AccountAcquisitionHost]
+      .importCredentials({
+        account: AccountId.make(`acc_${payload.creation.toLowerCase()}`),
+        owner,
+        provider,
+        method: payload.method,
+        fields,
+        identity: JSON.stringify([
+          input.app,
+          scope,
+          input.requirement,
+          destination,
+          payload.label ?? null,
+        ]),
+        ...(payload.label === undefined ? {} : { label: payload.label }),
+        authorize: (account) => authorize(account).pipe(Effect.provideContext(context)),
+      })
+      .pipe(accountDestination(destination));
+  });
