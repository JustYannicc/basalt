diff --git a/apps/hosted/server/src/implementation/provider-account-policy.ts b/apps/hosted/server/src/implementation/provider-account-policy.ts
new file mode 100644
index 0000000..32cf7b1
--- /dev/null
+++ b/apps/hosted/server/src/implementation/provider-account-policy.ts
@@ -0,0 +1,99 @@
+import { permitsAction } from "@executor-js/authorization";
+import {
+  AccountAcquisitionConfiguration,
+  StorageError,
+  type App,
+  type AppId,
+} from "@executor-js/sdk/core";
+import { Effect } from "effect";
+import { CurrentAuthorization } from "../contracts/authorization.ts";
+import { CurrentOrganization } from "../contracts/organization.ts";
+import { ProviderAppConnectionRequired } from "../contracts/provider-account-policy.ts";
+import { HostedExecutor } from "../contracts/executor.ts";
+import { currentOwner } from "./access.ts";
+import { providerAccountDestination } from "./provider-account-destination.ts";
+import { policyDatabase, requireCurrentAppAccess } from "./resource-policy.ts";
+import { providerAppIdentity } from "./provider-app-identity.ts";
+
+export const registeredPool = (app: AppId) =>
+  Effect.gen(function* () {
+    const sql = yield* policyDatabase;
+    const { organization } = yield* CurrentOrganization;
+    const rows = yield* sql`select a.id from organization o
+      join executor_apps a on a.owner = 'organization:' || o.id
+      where o.id = ${organization} and a.id = ${app}
+        and exists (select 1 from jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) pool
+          where pool.value ->> 'app' = a.id)`;
+    return rows.length !== 0;
+  }).pipe(Effect.catchTag("SqlError", () => new StorageError()));
+
+export const requirementConnectionPolicies = (
+  app: App,
+  identity?: Effect.Success<ReturnType<typeof providerAppIdentity>>,
+) =>
+  Effect.gen(function* () {
+    const pool = yield* registeredPool(app.id);
+    const { access } = yield* requireCurrentAppAccess(app.id, "read");
+    const manage = permitsAction(yield* CurrentAuthorization, "manage");
+    const { registrations } = yield* AccountAcquisitionConfiguration;
+    const providerApp = pool
+      ? null
+      : identity === undefined
+        ? yield* providerAppIdentity(app)
+        : identity;
+    return yield* Effect.forEach(Object.entries(app.requirements.accounts), ([requirement, slot]) =>
+      Effect.gen(function* () {
+        const allowed =
+          manage &&
+          (slot.scope === "user" || (slot.contributed ? access.canUse : access.canManage));
+        const automatic = Object.values(slot.definition.auth).every(
+          (method) => method.type === "secrets" && method.provisioned === true,
+        );
+        const destination = yield* providerAccountDestination(app, requirement);
+        const importMethod =
+          slot.definition.family?.id === "openai"
+            ? "codex"
+            : slot.definition.family?.id === "anthropic"
+              ? "claude"
+              : undefined;
+        return {
+          requirement,
+          canConnect: allowed && !pool && !automatic,
+          canSelect: allowed && !automatic && !(pool && requirement === "subscriptions"),
+          importMethods:
+            allowed &&
+            !pool &&
+            providerApp?.requirements.includes(requirement) &&
+            importMethod !== undefined &&
+            registrations.some(
+              (entry) =>
+                entry.current &&
+                entry.provider === slot.provider &&
+                entry.method === importMethod &&
+                entry.driver.importCredentials !== undefined,
+            )
+              ? [importMethod]
+              : [],
+          destination,
+        };
+      }),
+    );
+  });
+
+/** Recheck persisted targets at completion, so an old form cannot acquire into a pool. */
+export const requireProviderConnectionTarget = (app: App, requirement: string) =>
+  Effect.gen(function* () {
+    if (!(yield* registeredPool(app.id))) return;
+    return yield* new ProviderAppConnectionRequired({
+      app: app.id,
+      requirement,
+      destination: yield* providerAccountDestination(app, requirement),
+    });
+  });
+
+export const requireSavedConnectionTarget = (app: AppId, requirement: string) =>
+  Effect.gen(function* () {
+    const owner = yield* currentOwner;
+    const executor = yield* Effect.flatten(HostedExecutor);
+    yield* requireProviderConnectionTarget(yield* executor.apps.get({ owner, app }), requirement);
+  });
diff --git a/apps/hosted/server/src/implementation/provider-app-identity.ts b/apps/hosted/server/src/implementation/provider-app-identity.ts
new file mode 100644
index 0000000..50c34fc
--- /dev/null
+++ b/apps/hosted/server/src/implementation/provider-app-identity.ts
@@ -0,0 +1,46 @@
+import { identifyProvider, StorageError, type App } from "@executor-js/sdk/core";
+import { providerDeclaration } from "apps/host";
+import { Crypto, Effect, Option } from "effect";
+import { HostedCatalog } from "../contracts/catalog.ts";
+import { providers } from "./pool-provider-definitions.ts";
+import { policyDatabase } from "./resource-policy.ts";
+import { recordedServiceInstalls } from "./service-install-records.ts";
+
+/** Classification uses the configured installation and canonical declaration, including on read-only views. */
+export const providerAppIdentity = (app: App) =>
+  Effect.gen(function* () {
+    const catalog = yield* Effect.serviceOption(HostedCatalog);
+    if (app.activeVersion === null || Option.isNone(catalog)) return null;
+    const entries = yield* catalog.value.list.pipe(Effect.catch(() => Effect.succeed([])));
+    const installed = (yield* recordedServiceInstalls(yield* policyDatabase, [app])).get(app.id);
+    const crypto = yield* Crypto.Crypto;
+    const matches = yield* Effect.forEach(
+      Object.entries(app.requirements.accounts),
+      ([requirement, slot]) =>
+        Effect.gen(function* () {
+          const family = slot.definition.family?.id;
+          if (family === undefined || slot.scope !== "app" || !Object.hasOwn(providers, family))
+            return undefined;
+          const entry = entries.find((entry) => entry.id === `provider-${family}`);
+          if (
+            entry === undefined ||
+            (installed === undefined
+              ? app.copiedFrom?.name !== entry.package
+              : installed.id !== (entry.service?.id ?? entry.package))
+          )
+            return undefined;
+          const definition = yield* providerDeclaration(
+            providers[family as keyof typeof providers],
+          );
+          const id = yield* identifyProvider(definition, crypto);
+          return slot.provider === id.identity || slot.provider === id.legacy
+            ? { family, requirement }
+            : undefined;
+        }),
+    );
+    const found = matches.filter((match) => match !== undefined);
+    const family = found[0]?.family;
+    return family === undefined || found.some((match) => match.family !== family)
+      ? null
+      : { family, requirements: found.map((match) => match.requirement) };
+  }).pipe(Effect.mapError(() => new StorageError()));
