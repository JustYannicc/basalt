new file mode 100644
index 0000000000000000000000000000000000000000..b7ccaa6c3d84c899a17583025e5909a47ea9055e
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-retained-subscriptions.ts
@@ -0,0 +1,46 @@
+import {
+  AppRequirements,
+  StorageError,
+  VersionId,
+  type AppId,
+  type OwnerId,
+} from "@executor-js/sdk/core";
+import { Effect, Schema } from "effect";
+import type { SqlClient } from "effect/sql";
+
+const Retained = Schema.Struct({ version: VersionId, requirements: AppRequirements });
+
+/** Registered pools with old links must keep the declaration that adoption verifies. */
+export const retainedPoolSubscriptions = (sql: SqlClient.SqlClient, owner: OwnerId, app: AppId) =>
+  Effect.gen(function* () {
+    const rows = yield* sql`select d.id as version, d.requirements from organization o
+      join executor_apps a on a.owner = 'organization:' || o.id
+      left join executor_deployments d on d.id = a.active_deployment
+      where a.id = ${app} and a.owner = ${owner}
+        and exists (select 1 from jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) pool
+          where pool.value ->> 'app' = a.id)
+        and exists (select 1 from hosted_app_account_links l
+          where l.app = a.id and l.requirement = 'subscriptions' and l.subject is null)`;
+    const retained = yield* Schema.decodeUnknownEffect(Schema.Array(Retained))(rows);
+    if (retained.length > 1) return yield* new StorageError();
+    const previous = retained[0]?.requirements.accounts.subscriptions;
+    if (retained.length === 1 && previous === undefined) return yield* new StorageError();
+    return retained[0];
+  }).pipe(
+    Effect.catchTags({ SqlError: () => new StorageError(), SchemaError: () => new StorageError() }),
+  );
+
+export const requireRetainedPoolDeclaration = (
+  sql: SqlClient.SqlClient,
+  input: {
+    readonly owner: OwnerId;
+    readonly app: AppId;
+    readonly version: VersionId;
+    readonly requirements: typeof AppRequirements.Type;
+  },
+) =>
+  Effect.gen(function* () {
+    const previous = yield* retainedPoolSubscriptions(sql, input.owner, input.app);
+    if (previous === undefined) return;
+    if (input.version !== previous.version) return yield* new StorageError();
+  });
