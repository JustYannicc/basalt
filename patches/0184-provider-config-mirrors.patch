+        and exists (select 1 from jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) pool
+          where pool.value ->> 'app' = a.id)`;
+    return rows.length !== 0;
+  }).pipe(Effect.catchTag("SqlError", () => new StorageError()));
+
+export const requirementConnectionPolicies = (
+  app: App,
+  identity?: Effect.Success<ReturnType<typeof providerAppIdentity>>,
+) =>
+  Effect.gen(function* () {
+    const pool = yield* registeredPool(app.id);
+    const { access } = yield* requireCurrentAppAccess(app.id, "read");
+    const manage = permitsAction(yield* CurrentAuthorization, "manage");
+    const { registrations } = yield* AccountAcquisitionConfiguration;
+    const providerApp = pool
+      ? null
+      : identity === undefined
+        ? yield* providerAppIdentity(app)
+        : identity;
+    return yield* Effect.forEach(Object.entries(app.requirements.accounts), ([requirement, slot]) =>
+      Effect.gen(function* () {
+        const allowed =
+          manage &&
+          (slot.scope === "user" || (slot.contributed ? access.canUse : access.canManage));
+        const automatic = Object.values(slot.definition.auth).every(
+          (method) => method.type === "secrets" && method.provisioned === true,
+        );
+        const destination = yield* providerAccountDestination(app, requirement);
+        const importMethod =
+          slot.definition.family?.id === "openai"
+            ? "codex"
+            : slot.definition.family?.id === "anthropic"
+              ? "claude"
+              : undefined;
+        return {
+          requirement,
+          canConnect: allowed && !pool && !automatic,
+          canSelect: allowed && !automatic && !(pool && requirement === "subscriptions"),
+          importMethods:
+            allowed &&
+            !pool &&
+            providerApp?.requirements.includes(requirement) &&
+            importMethod !== undefined &&
+            registrations.some(
+              (entry) =>
+                entry.current &&
+                entry.provider === slot.provider &&
+                entry.method === importMethod &&
+                entry.driver.importCredentials !== undefined,
+            )
+              ? [importMethod]
+              : [],
+          destination,
+        };
+      }),
+    );
+  });
+
+/** Recheck persisted targets at completion, so an old form cannot acquire into a pool. */
+export const requireProviderConnectionTarget = (app: App, requirement: string) =>
+  Effect.gen(function* () {
+    if (!(yield* registeredPool(app.id))) return;
+    return yield* new ProviderAppConnectionRequired({
+      app: app.id,
+      requirement,
+      destination: yield* providerAccountDestination(app, requirement),
+    });
+  });
+
+export const requireSavedConnectionTarget = (app: AppId, requirement: string) =>
+  Effect.gen(function* () {
+    const owner = yield* currentOwner;
+    const executor = yield* Effect.flatten(HostedExecutor);
+    yield* requireProviderConnectionTarget(yield* executor.apps.get({ owner, app }), requirement);
+  });
diff --git a/apps/hosted/server/src/implementation/provider-app-identity.ts b/apps/hosted/server/src/implementation/provider-app-identity.ts
