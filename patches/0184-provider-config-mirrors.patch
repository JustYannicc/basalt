index 0000000000000000000000000000000000000000..12e7bfd49ee7d19a4c504914821df1282a438482
--- /dev/null
+++ b/e2e/support/provider-import-journey.ts
@@ -0,0 +1,288 @@
+import { expect } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "./actors.ts";
+import { Api, body } from "./api.ts";
+import { Resource } from "./contracts.ts";
+import type { providerAppsCatalog } from "./provider-apps-catalog.ts";
+
+const Methods = Schema.Struct({
+  providerApp: Schema.NullOr(
+    Schema.Struct({ family: Schema.String, requirements: Schema.Array(Schema.String) }),
+  ),
+  connections: Schema.Array(
+    Schema.Struct({
+      requirement: Schema.String,
+      canConnect: Schema.Boolean,
+      canSelect: Schema.Boolean,
+      importMethods: Schema.Array(Schema.String),
+      destination: Schema.Unknown,
+    }),
+  ),
+});
+const Links = Schema.Array(
+  Schema.Struct({
+    account: Resource,
+    credentialScope: Schema.String,
+    canReconnect: Schema.Boolean,
+  }),
+);
+
+export const providerImportJourney = (
+  catalog: Effect.Success<typeof providerAppsCatalog>,
+  pools: readonly string[],
+  resources: { readonly apps: string[]; readonly accounts: string[] },
+) =>
+  Effect.gen(function* () {
+    const api = yield* Api,
+      actors = yield* Actors;
+    const prefix = `/api/organizations/${actors.organization.id}`;
+    const { apps, accounts } = resources;
+    for (const [lab, method] of [
+      ["openai", "codex"],
+      ["anthropic", "claude"],
+    ] as const) {
+      const installed = yield* api.request(actors.owner, "POST", `${prefix}/apps/install`, {
+        entry: `provider-${lab}`,
+        name: `Renamed ${lab}`,
+      });
+      expect(installed.status, JSON.stringify(installed.body)).toBe(200);
+      const app = (yield* body(Resource, installed)).id;
+      apps.push(app);
+      const provider = `${prefix}/apps/${app}/accounts/app/${lab}`;
+      const methods = yield* body(
+        Methods,
+        yield* api.request(actors.owner, "GET", `${prefix}/apps/${app}/accounts/methods`),
+      );
+      expect(methods.providerApp).toEqual({ family: lab, requirements: [lab] });
+      const other = yield* api.request(actors.owner, "POST", `${prefix}/apps/install`, {
+        entry: `provider-${lab}`,
+        name: `Another ${lab}`,
+        newInstance: true,
+      });
+      expect(other.status, JSON.stringify(other.body)).toBe(200);
+      const otherApp = (yield* body(Resource, other)).id;
+      apps.push(otherApp);
+      expect(methods.connections).toContainEqual(
+        expect.objectContaining({
+          requirement: lab,
+          canConnect: true,
+          importMethods: [method],
+        }),
+      );
+      const poolMethods = yield* body(
+        Methods,
+        yield* api.request(actors.owner, "GET", `${prefix}/apps/${pools[0]}/accounts/methods`),
+      );
+      expect(poolMethods.providerApp).toBeNull();
+      expect(poolMethods.connections).toContainEqual(
+        expect.objectContaining({
+          requirement: lab,
+          canConnect: false,
+          canSelect: true,
+          importMethods: [],
+          destination: {
+            kind: "apps",
+            apps: expect.arrayContaining([
+              { app, name: `Renamed ${lab}`, requirement: lab },
+              { app: otherApp, name: `Another ${lab}`, requirement: lab },
+            ]),
+          },
+        }),
+      );
+      const payload = {
+        creation: crypto.randomUUID(),
+        method,
+        file: {
+          type: method,
+          token: `synthetic-import-${lab}`,
+          uuid: "foreign-uuid",
+          id: "foreign-id",
+          auth_index: "foreign-index",
+        },
+      };
+      const mirrorCount = (yield* catalog.mirrors).length;
+      expect(
+        (yield* api.request(actors.owner, "POST", `${provider}/import-login-file`, {
+          ...payload,
+          file: { type: method === "codex" ? "claude" : "codex" },
+        })).status,
+      ).toBe(422);
+      expect(
+        (yield* api.request(actors.owner, "POST", `${provider}/import-login-file`, {
+          ...payload,
+          file: { type: method, token: "x".repeat(1_048_577) },
+        })).status,
+      ).toBe(422);
+      expect(yield* catalog.mirrors).toHaveLength(mirrorCount);
+      yield* catalog.failNextMirror;
+      const uncertain = yield* api.request(
+        actors.owner,
+        "POST",
+        `${provider}/import-login-file`,
+        payload,
+      );
+      expect(uncertain.status, JSON.stringify(uncertain.body)).toBe(503);
+      const saved = `acc_${payload.creation}`;
+      accounts.push(saved);
+      expect((yield* api.request(actors.owner, "PUT", `${provider}/${saved}`)).status).toBe(422);
+      const retried = yield* api.request(
+        actors.owner,
+        "POST",
+        `${provider}/import-login-file`,
+        payload,
+      );
+      expect(retried.status, JSON.stringify(retried.body)).toBe(200);
+      expect((yield* body(Resource, retried)).id).toBe(saved);
+      const mirrors = yield* catalog.mirrors;
+      expect(mirrors.slice(-2).map((item) => item.reference)).toEqual([
+        mirrors.at(-1)!.reference,
+        mirrors.at(-1)!.reference,
+      ]);
+      expect(mirrors.at(-1)?.credential).toEqual({
+        type: method,
+        token: `synthetic-import-${lab}`,
+      });
+      expect(mirrors.at(-1)?.reference).toMatch(/^[0-9a-f-]{36}$/);
+      expect(JSON.stringify(retried.body)).not.toContain(`synthetic-import-${lab}`);
+      expect(
+        (yield* api.request(actors.owner, "POST", `${provider}/import-login-file`, payload)).status,
+      ).toBe(200);
+      expect(yield* catalog.mirrors).toHaveLength(mirrors.length);
+      expect(
+        (yield* api.request(actors.owner, "POST", `${provider}/import-login-file`, {
+          ...payload,
+          file: { type: method, token: "changed" },
+        })).status,
+      ).toBe(422);
+      expect(yield* catalog.mirrors).toHaveLength(mirrors.length);
+      expect(
+        yield* body(
+          Links,
+          yield* api.request(actors.owner, "GET", `${prefix}/apps/${app}/accounts/app`),
+        ),
+      ).toEqual([]);
+      for (const pool of pools)
+        expect(
+          yield* body(
+            Links,
+            yield* api.request(actors.owner, "GET", `${prefix}/apps/${pool}/accounts/app`),
+          ),
+        ).toEqual([]);
+      expect((yield* api.request(actors.owner, "PUT", `${provider}/${saved}`)).status).toBe(200);
+      for (const pool of pools) {
+        const linked = yield* api.request(
+          actors.owner,
+          "PUT",
+          `${prefix}/apps/${pool}/accounts/app/${lab}/${saved}`,
+        );
+        expect(linked.status, JSON.stringify(linked.body)).toBe(200);
+        expect(linked.body).toMatchObject({
+          account: { id: saved },
+          credentialScope: "saved",
+          canReconnect: false,
+        });
+      }
+      expect(
+        (yield* api.request(
+          actors.owner,
+          "DELETE",
+          `${prefix}/apps/${pools[0]}/accounts/app/${lab}/${saved}`,
+        )).status,
+      ).toBe(200);
+      expect(
+        yield* body(
+          Links,
+          yield* api.request(actors.owner, "GET", `${prefix}/apps/${pools[1]}/accounts/app`),
+        ),
+      ).toContainEqual(
+        expect.objectContaining({ account: { id: saved }, credentialScope: "saved" }),
+      );
+      expect((yield* api.request(actors.owner, "GET", `${prefix}/accounts/${saved}`)).status).toBe(
+        200,
+      );
+      expect(yield* catalog.mirrors).toHaveLength(mirrors.length);
+      expect(
+        (yield* api.request(
+          actors.owner,
+          "DELETE",
