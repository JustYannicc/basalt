diff --git a/apps/hosted/server/src/implementation/pool-provider-mirror.ts b/apps/hosted/server/src/implementation/pool-provider-mirror.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1ed490fa4b6bfa4f0f43e6cc10596df091177240
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-provider-mirror.ts
@@ -0,0 +1,193 @@
+import type { AccountAcquisitionMirrorContext, JsonObject } from "@executor-js/sdk/core";
+import { Redacted } from "effect";
+import type { ProviderCapability } from "./pool-provider-capabilities.ts";
+import { homeAccountKeyMirror } from "./account-key-mirror.ts";
+
+const object = (value: unknown): value is JsonObject =>
+  typeof value === "object" && value !== null && !Array.isArray(value);
+const missing = (): never => {
+  throw new Error("Provider account configuration unavailable");
+};
+const nativeFamilies: Readonly<Record<string, string>> = {
+  openai: "codex",
+  anthropic: "claude",
+  gemini: "gemini",
+  vertex: "vertex",
+  xai: "xai",
+  meta: "meta",
+};
+function field(context: AccountAcquisitionMirrorContext, name: string): string {
+  const value = Redacted.value(context.fields)[name];
+  return typeof value === "string" && value.length > 0 ? value : missing();
+}
+async function read(
+  context: AccountAcquisitionMirrorContext,
+  url: string,
+  token: string,
+): Promise<JsonObject> {
+  const signal = AbortSignal.any([
+    context.signal,
+    AbortSignal.timeout(Math.max(1, Math.min(15_000, context.deadline - Date.now()))),
+  ]);
+  const response = await context.fetch(url, {
+    signal,
+    redirect: "error",
+    headers: { authorization: `Bearer ${token}`, accept: "application/json" },
+  });
+  if (!response.ok) {
+    await response.body?.cancel();
+    return missing();
+  }
+  const reader = response.body?.getReader();
+  if (!reader) return missing();
+  const chunks: Uint8Array[] = [];
+  let size = 0;
+  try {
+    for (;;) {
+      const next = await reader.read();
+      if (next.done) break;
+      size += next.value.byteLength;
+      if (size > 2_000_000) return missing();
+      chunks.push(next.value);
+    }
+  } finally {
+    await reader.cancel();
+  }
+  const data = new Uint8Array(size);
+  let offset = 0;
+  for (const chunk of chunks) {
+    data.set(chunk, offset);
+    offset += chunk.byteLength;
+  }
+  try {
+    const value: unknown = JSON.parse(new TextDecoder().decode(data));
+    return object(value) ? value : missing();
+  } catch {
+    return missing();
+  }
+}
+function models(value: unknown): JsonObject[] {
+  if (!Array.isArray(value) || !value.length || value.length > 2000) return missing();
+  const ids = value.map((row: unknown) => (object(row) ? row.id : undefined));
+  if (ids.some((id) => typeof id !== "string" || !id || id.length > 256)) return missing();
+  return [...new Set(ids)].map((id) => ({ name: String(id), alias: String(id) }));
+}
+async function cloudflare(
+  context: AccountAcquisitionMirrorContext,
+  method: string,
+  token: string,
+): Promise<JsonObject> {
+  const origin = "https://api.cloudflare.com/client/v4";
+  let accountId: string;
+  if (method === "accountToken") accountId = field(context, "accountId");
+  else {
+    const accounts = await read(context, `${origin}/accounts?per_page=2&page=1`, token);
+    if (
+      accounts.success !== true ||
+      !Array.isArray(accounts.result) ||
+      accounts.result.length !== 1 ||
+      !object(accounts.result[0]) ||
+      typeof accounts.result[0].id !== "string" ||
+      (object(accounts.result_info) &&
+        typeof accounts.result_info.total_count === "number" &&
+        accounts.result_info.total_count !== 1)
+    )
+      throw new Error(
+        "Choose an account API token when a user token can access multiple Cloudflare accounts",
+      );
+    accountId = accounts.result[0].id;
+  }
+  if (!/^[0-9a-f]{32}$/.test(accountId)) return missing();
+  const found: JsonObject[] = [];
+  for (let page = 1; page <= 20; page++) {
+    const result = await read(
+      context,
+      `${origin}/accounts/${accountId}/ai/models/search?per_page=100&page=${page}`,
+      token,
+    );
+    if (result.success !== true || !Array.isArray(result.result)) return missing();
+    for (const row of result.result) {
+      if (!object(row)) return missing();
+      if (
+        object(row.task) &&
+        (row.task.name === "Text Generation" || row.task.name === "text-generation") &&
+        typeof row.name === "string"
+      )
+        found.push({ id: row.name });
+    }
+    const info = object(result.result_info) ? result.result_info : undefined;
+    if (
+      (info && typeof info.total_pages === "number" && page >= info.total_pages) ||
+      result.result.length < 100
+    )
+      return { "base-url": `${origin}/accounts/${accountId}/ai/v1`, models: models(found) };
+  }
+  return missing();
+}
+
+export function providerMirror(
+  capability: ProviderCapability,
+  options: {
+    readonly origin: string;
+    readonly signingKey: Redacted.Redacted<string>;
+  },
+) {
+  const family = nativeFamilies[capability.lab] ?? "openai-compatibility";
+  const serviceAccount = capability.lab === "vertex" && capability.method === "serviceAccount";
+  return homeAccountKeyMirror({
+    ...options,
+    fields: {},
+    ...(serviceAccount ? {} : { removalCredential: { type: "config", family } }),
+    credential: async (context): Promise<JsonObject> => {
+      if (serviceAccount) {
+        const source = field(context, "serviceAccount");
+        if (source.length > 48_000) return missing();
+        let account: unknown;
+        try {
+          account = JSON.parse(source);
+        } catch {
+          return missing();
+        }
+        if (
+          !object(account) ||
+          account.type !== "service_account" ||
+          typeof account.project_id !== "string" ||
+          !account.project_id ||
+          typeof account.client_email !== "string" ||
+          !account.client_email ||
+          typeof account.private_key !== "string" ||
+          !account.private_key.startsWith("-----BEGIN PRIVATE KEY-----") ||
+          account.token_uri !== "https://oauth2.googleapis.com/token"
+        )
+          return missing();
+        return {
+          type: "vertex",
+          service_account: account,
+          project_id: account.project_id,
+          email: account.client_email,
+          location: "us-central1",
+        };
+      }
+      const token = field(context, "token");
+      let group: JsonObject = {};
+      if (capability.lab === "openai") group = { "base-url": "https://api.openai.com/v1" };
+      if (capability.lab === "cloudflare")
+        group = await cloudflare(context, capability.method, token);
+      if (capability.lab === "kimi" || capability.lab === "openrouter") {
+        const endpoint =
+          capability.lab === "kimi" ? "https://api.moonshot.ai/v1" : "https://openrouter.ai/api/v1";
+        const result = await read(context, `${endpoint}/models`, token);
+        group = { "base-url": endpoint, models: models(result.data) };
+      }
+      return {
+        type: "config",
+        family,
+        token,
+        group:
+          family === "openai-compatibility"
+            ? { ...group, name: `basalt-${capability.lab}-${Redacted.value(context.reference)}` }
+            : group,
+      };
+    },
+  });
+}
