diff --git a/apps/hosted/server/src/implementation/pool-provider-mirror.ts b/apps/hosted/server/src/implementation/pool-provider-mirror.ts
new file mode 100644
index 0000000..6a13a94
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-provider-mirror.ts
@@ -0,0 +1,216 @@
+import type { AccountAcquisitionMirrorContext, JsonObject } from "@executor-js/sdk/core";
+import { Effect, Redacted, Schema } from "effect";
+import type { ProviderCapability } from "./pool-provider-capabilities.ts";
+import { homeAccountKeyMirror } from "./account-key-mirror.ts";
+
+class ProviderMirrorUnavailable extends Schema.TaggedError<ProviderMirrorUnavailable>()(
+  "ProviderMirrorUnavailable",
+  { reason: Schema.Literals(["configuration", "multipleAccounts"]) },
+) {
+  override get message() {
+    return this.reason === "multipleAccounts"
+      ? "Choose an account API token when a user token can access multiple Cloudflare accounts"
+      : "Provider account configuration unavailable";
+  }
+}
+const missing = (): never => {
+  throw new ProviderMirrorUnavailable({ reason: "configuration" });
+};
+const decode = <A, I>(schema: Schema.Codec<A, I>, value: unknown) =>
+  Effect.runPromise(
+    Schema.decodeUnknownEffect(schema)(value).pipe(
+      Effect.mapError(() => new ProviderMirrorUnavailable({ reason: "configuration" })),
+    ),
+  );
+const JsonRecord = Schema.Record(Schema.String, Schema.Json);
+const ModelRows = Schema.Array(
+  Schema.Struct({
+    id: Schema.NonEmptyString.check(Schema.isMaxLength(256)),
+  }),
+).check(Schema.isMinLength(1), Schema.isMaxLength(2000));
+const AccountRows = Schema.Struct({
+  success: Schema.Literal(true),
+  result: Schema.Array(Schema.Struct({ id: Schema.String })),
+  result_info: Schema.optionalKey(
+    Schema.Struct({ total_count: Schema.optionalKey(Schema.Number) }),
+  ),
+});
+const CloudflareModels = Schema.Struct({
+  success: Schema.Literal(true),
+  result: Schema.Array(
+    Schema.Struct({
+      name: Schema.optionalKey(Schema.String),
+      task: Schema.optionalKey(Schema.Struct({ name: Schema.optionalKey(Schema.String) })),
+    }),
+  ),
+  result_info: Schema.optionalKey(
+    Schema.Struct({ total_pages: Schema.optionalKey(Schema.Number) }),
+  ),
+});
+const ServiceAccount = Schema.Struct({
+  type: Schema.Literal("service_account"),
+  project_id: Schema.NonEmptyString,
+  client_email: Schema.NonEmptyString,
+  private_key: Schema.String.check(Schema.isPattern(/^-----BEGIN PRIVATE KEY-----/u)),
+  token_uri: Schema.Literal("https://oauth2.googleapis.com/token"),
+});
+const nativeFamilies: Readonly<Record<string, string>> = {
+  openai: "codex",
+  anthropic: "claude",
+  gemini: "gemini",
+  vertex: "vertex",
+  xai: "xai",
+  meta: "meta",
+};
+function field(context: AccountAcquisitionMirrorContext, name: string): string {
+  const value = Redacted.value(context.fields)[name];
+  return typeof value === "string" && value.length > 0 ? value : missing();
+}
+async function readResponse(
+  context: AccountAcquisitionMirrorContext,
+  url: string,
+  token: string,
+): Promise<JsonObject> {
+  const signal = AbortSignal.any([
+    context.signal,
+    AbortSignal.timeout(Math.max(1, Math.min(15_000, context.deadline - Date.now()))),
+  ]);
+  const response = await context.fetch(url, {
+    signal,
+    redirect: "error",
+    headers: { authorization: `Bearer ${token}`, accept: "application/json" },
+  });
+  if (!response.ok) {
+    await response.body?.cancel();
+    return missing();
+  }
+  const reader = response.body?.getReader();
+  if (!reader) return missing();
+  const chunks: Uint8Array[] = [];
+  let size = 0;
+  try {
+    for (;;) {
+      const next = await reader.read();
+      if (next.done) break;
+      size += next.value.byteLength;
+      if (size > 2_000_000) return missing();
+      chunks.push(next.value);
+    }
+  } finally {
+    await reader.cancel();
+  }
+  const data = new Uint8Array(size);
+  let offset = 0;
+  for (const chunk of chunks) {
+    data.set(chunk, offset);
+    offset += chunk.byteLength;
+  }
+  return decode(Schema.fromJsonString(JsonRecord), new TextDecoder().decode(data));
+}
+async function read(context: AccountAcquisitionMirrorContext, url: string, token: string) {
+  try {
+    return await readResponse(context, url, token);
+  } catch {
+    return missing();
+  }
+}
+async function models(value: unknown): Promise<JsonObject[]> {
+  const rows = await decode(ModelRows, value);
+  return [...new Set(rows.map((row) => row.id))].map((id) => ({ name: id, alias: id }));
+}
+async function cloudflare(
+  context: AccountAcquisitionMirrorContext,
+  method: string,
+  token: string,
+): Promise<JsonObject> {
+  const origin = "https://api.cloudflare.com/client/v4";
+  let accountId: string;
+  if (method === "accountToken") accountId = field(context, "accountId");
+  else {
+    const accounts = await decode(
+      AccountRows,
+      await read(context, `${origin}/accounts?per_page=2&page=1`, token),
+    );
+    if (
+      accounts.result.length !== 1 ||
+      (accounts.result_info?.total_count !== undefined && accounts.result_info.total_count !== 1)
+    )
+      throw new ProviderMirrorUnavailable({ reason: "multipleAccounts" });
+    accountId = accounts.result[0]!.id;
+  }
+  if (!/^[0-9a-f]{32}$/.test(accountId)) return missing();
+  const found: JsonObject[] = [];
+  for (let page = 1; page <= 20; page++) {
+    const result = await decode(
+      CloudflareModels,
+      await read(
+        context,
+        `${origin}/accounts/${accountId}/ai/models/search?per_page=100&page=${page}`,
+        token,
+      ),
+    );
+    for (const row of result.result) {
+      if (
+        (row.task?.name === "Text Generation" || row.task?.name === "text-generation") &&
+        row.name !== undefined
+      )
+        found.push({ id: row.name });
+    }
+    if (
+      (result.result_info?.total_pages !== undefined && page >= result.result_info.total_pages) ||
+      result.result.length < 100
+    )
+      return { "base-url": `${origin}/accounts/${accountId}/ai/v1`, models: await models(found) };
+  }
+  return missing();
+}
+
+export function providerMirror(
+  capability: ProviderCapability,
+  options: {
+    readonly origin: string;
+    readonly signingKey: Redacted.Redacted<string>;
+  },
+) {
+  const family = nativeFamilies[capability.lab] ?? "openai-compatibility";
+  const serviceAccount = capability.lab === "vertex" && capability.method === "serviceAccount";
+  return homeAccountKeyMirror({
+    ...options,
+    fields: {},
+    ...(serviceAccount ? {} : { removalCredential: { type: "config", family } }),
+    credential: async (context): Promise<JsonObject> => {
+      if (serviceAccount) {
+        const source = field(context, "serviceAccount");
+        if (source.length > 48_000) return missing();
+        const account = await decode(Schema.fromJsonString(ServiceAccount), source);
+        return {
+          type: "vertex",
+          service_account: account,
+          project_id: account.project_id,
+          email: account.client_email,
+          location: "us-central1",
+        };
+      }
+      const token = field(context, "token");
+      let group: JsonObject = {};
+      if (capability.lab === "openai") group = { "base-url": "https://api.openai.com/v1" };
+      if (capability.lab === "cloudflare")
+        group = await cloudflare(context, capability.method, token);
+      if (capability.lab === "kimi" || capability.lab === "openrouter") {
+        const endpoint =
+          capability.lab === "kimi" ? "https://api.moonshot.ai/v1" : "https://openrouter.ai/api/v1";
+        const result = await read(context, `${endpoint}/models`, token);
+        group = { "base-url": endpoint, models: await models(result.data) };
+      }
+      return {
+        type: "config",
+        family,
+        token,
+        group:
+          family === "openai-compatibility"
+            ? { ...group, name: `basalt-${capability.lab}-${Redacted.value(context.reference)}` }
+            : group,
+      };
+    },
+  });
+}
