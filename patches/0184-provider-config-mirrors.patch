diff --git a/apps/hosted/server/src/contracts/provider-account-policy.ts b/apps/hosted/server/src/contracts/provider-account-policy.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fba02234fecbb71574c1be57d3357bc9f54e0a2a
--- /dev/null
+++ b/apps/hosted/server/src/contracts/provider-account-policy.ts
@@ -0,0 +1,44 @@
+import { AppId } from "@executor-js/sdk/core";
+import { UserFacingError } from "@executor-js/utils/user-facing-error";
+import { Schema } from "effect";
+
+export const ProviderAccountDestination = Schema.Union([
+  Schema.Struct({
+    kind: Schema.Literal("apps"),
+    apps: Schema.Array(
+      Schema.Struct({ app: AppId, name: Schema.String, requirement: Schema.NonEmptyString }),
+    ),
+  }),
+  Schema.Struct({ kind: Schema.Literal("catalog"), entry: Schema.NonEmptyString }),
+  Schema.Struct({ kind: Schema.Literal("unavailable"), reason: Schema.String }),
+]);
+export type ProviderAccountDestination = typeof ProviderAccountDestination.Type;
+
+export const RequirementConnectionPolicy = Schema.Struct({
+  requirement: Schema.NonEmptyString,
+  canConnect: Schema.Boolean,
+  canSelect: Schema.Boolean,
+  importMethods: Schema.Array(Schema.String),
+  destination: ProviderAccountDestination,
+});
+
+export const CredentialScope = Schema.Literals(["saved", "app"]);
+
+export const ProviderAppConnectionRequired = UserFacingError.define({
+  tag: "ProviderAppConnectionRequired",
+  status: 409,
+  fields: {
+    app: AppId,
+    requirement: Schema.NonEmptyString,
+    destination: ProviderAccountDestination,
+  },
+  title: "Connect this account on its provider app",
+  description:
+    "Pools select accounts that are already connected. This connection cannot continue here.",
+  recovery: {
+    action:
+      "Open the provider app, connect the account there, then return to select it in this pool.",
+    instructions:
+      "Use the authorized provider destination in this response. Keep the current saved account and pool links. Do not retry this pool connection, create a replacement account, or run an adoption without approval.",
+  },
+});
