+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Version = Schema.Struct({ id: Schema.String, activeVersion: Schema.String });
+const Connected = Schema.Struct({ state: Schema.Literal("connected"), account: Resource });
+const Rows = Schema.Array(
+  Schema.Struct({
+    requirement: Schema.String,
+    account: Resource,
+    credentialScope: Schema.String,
+    canReconnect: Schema.Boolean,
+  }),
+);
+const files = (source: string) => [appsManifest, { path: "index.ts", content: source }];
+const stripped = `import { defineApp } from "apps"; export default defineApp({}, {});`;
+const retained = `import { defineApp, defineProvider, interactive, object, query, router } from "apps";
+const subscription = defineProvider({ name: "Retained test Subscription", auth: { codex: interactive({ label: "Subscription" }) },
+  async health() { return { accountInfo: { displayName: "Retained synthetic subscription" } }; }
+});
+const requirements = { app: { accounts: { subscriptions: subscription.many() } } };
+export default defineApp(requirements, {
+  tools: router({ selected: query({ input: object({}) }, async ctx => ({ accounts: ctx.app.accounts.subscriptions.map(account => account.id) })) }),
+  connect: { subscriptions: {
+    start: async () => ({ session: "synthetic-retained-session", paste: { label: "Callback" } }),
+    status: async () => ({ state: "waiting" }),
+    submit: async () => ({ state: "connected", ref: "synthetic-retained-private-reference" }),
+    cancel: async () => {}, remove: async () => {}
+  } }
+});`;
+
+layer(HostedLive, { excludeTestServices: true })("Retained pool subscriptions", (it) => {
+  it.effect(scenarios.poolRetainedSubscriptions.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        let app: string | undefined, account: string | undefined;
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* serverControl("start");
+            if (app !== undefined)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app}`);
+            if (account !== undefined)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`);
+          }).pipe(Effect.orDie),
+        );
+        const created = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: "Retained subscription pool",
+          files: files(stripped),
+        });
+        expect(created.status, JSON.stringify(created.body)).toBe(200);
+        const initial = yield* body(Version, created);
+        app = initial.id;
+        const path = `${prefix}/apps/${app}`;
+        const deployed = yield* api.request(actors.owner, "POST", `${path}/deploy`, {
+          files: files(retained),
+        });
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const previous = (yield* body(Schema.Struct({ app: Version }), deployed)).app;
+        const pending = yield* api.request(
+          actors.owner,
+          "POST",
+          `${path}/accounts/app/subscriptions/connections`,
+          {},
+        );
+        expect(pending.status, JSON.stringify(pending.body)).toBe(200);
+        const connection = (yield* body(Resource, pending)).id;
+        expect(
+          (yield* api.request(
+            actors.owner,
+            "POST",
+            `${prefix}/connections/${connection}/interactive/start`,
+            { method: "codex" },
+          )).status,
+        ).toBe(200);
+        const connected = yield* api.request(
+          actors.owner,
+          "POST",
+          `${prefix}/connections/${connection}/interactive/submit`,
+          { value: "synthetic-callback" },
+        );
+        expect(connected.status, JSON.stringify(connected.body)).toBe(200);
+        account = (yield* body(Connected, connected)).account.id;
+        yield* serverControl("stop");
+        yield* legacyStorage([
+          {
+            sql: `update organization set metadata = jsonb_set(coalesce(metadata::jsonb,'{}'::jsonb),'{basaltPools}',coalesce(metadata::jsonb -> 'basaltPools','{}'::jsonb) || $1::jsonb)::text where id = $2`,
+            params: [
+              JSON.stringify({
+                retained: {
+                  app,
+                  version: previous.activeVersion,
+                  bundle: "retained-legacy-bundle",
+                },
+              }),
+              actors.organization.id,
+            ],
+          },
+        ]);
+        yield* serverControl("start");
+        const linkedPath = `${path}/accounts/app/subscriptions/${account}`;
+        const rows = yield* body(
+          Rows,
+          yield* api.request(actors.owner, "GET", `${path}/accounts/app`),
+        );
+        expect(rows).toContainEqual({
+          requirement: "subscriptions",
+          account: { id: account },
+          credentialScope: "app",
+          canReconnect: false,
+        });
+        const policy = yield* api.request(actors.owner, "GET", `${path}/accounts/methods`);
+        expect(policy.status, JSON.stringify(policy.body)).toBe(200);
+        expect(policy.body).toMatchObject({
+          connections: [
+            {
+              requirement: "subscriptions",
+              canConnect: false,
+              canSelect: false,
+              importMethods: [],
+              destination: { kind: "unavailable" },
+            },
+          ],
+        });
+        expect((yield* api.request(actors.owner, "PUT", linkedPath)).status).toBe(200);
+        expect(
+          (yield* api.request(
+            actors.owner,
+            "POST",
+            `${path}/accounts/app/subscriptions/connections`,
+            {},
+          )).status,
+        ).toBe(409);
+        const health = yield* api.request(
+          actors.owner,
+          "POST",
+          `${prefix}/accounts/${account}/health`,
+        );
+        expect(health.status, JSON.stringify(health.body)).toBe(200);
+        expect(health.body).toMatchObject({
+          info: { displayName: "Retained synthetic subscription" },
+        });
+        for (const source of [
+          stripped,
+          `${retained}\n// Changed source must also wait for adoption.\n`,
+        ]) {
+          const refused = yield* api.request(actors.owner, "POST", `${path}/deploy`, {
+            files: files(source),
+          });
+          expect(refused.status, JSON.stringify(refused.body)).toBe(500);
+          expect(
+            (yield* body(Version, yield* api.request(actors.owner, "GET", path))).activeVersion,
+          ).toBe(previous.activeVersion);
+        }
+        const activation = yield* api.request(actors.owner, "POST", `${path}/activate`, {
+          version: initial.activeVersion,
+          expectedVersion: previous.activeVersion,
+        });
+        expect(activation.status, JSON.stringify(activation.body)).toBe(500);
+        expect(
+          (yield* body(Version, yield* api.request(actors.owner, "GET", path))).activeVersion,
+        ).toBe(previous.activeVersion);
+        const serving = yield* api.request(actors.owner, "POST", `${path}/tools/call`, {
+          tool: "selected",
+          kind: "query",
+          input: {},
+        });
+        expect(serving.status, JSON.stringify(serving.body)).toBe(200);
+        expect(serving.body).toEqual({ accounts: [account] });
+        expect((yield* api.request(actors.owner, "DELETE", linkedPath)).status).toBe(200);
+        expect(
+          yield* body(Rows, yield* api.request(actors.owner, "GET", `${path}/accounts/app`)),
+        ).toEqual([]);
+        expect(
+          (yield* api.request(actors.owner, "POST", `${path}/activate`, {
+            version: initial.activeVersion,
+            expectedVersion: previous.activeVersion,
+          })).status,
+        ).toBe(200);
+      }),
+    ),
+  );
+});
