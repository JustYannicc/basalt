+import { appsManifest } from "./apps-release.ts";
+
+export const files = (source: string) => [appsManifest, { path: "index.ts", content: source }];
+export const stripped = `import { defineApp } from "apps"; export default defineApp({}, {});`;
+const source = (
+  withPool: boolean,
+) => `import { defineApp, defineProvider, interactive, object, query, router, secrets, string } from "apps";
+const subscription = defineProvider({ name: "Retained test Subscription", auth: { codex: interactive({ label: "Subscription" }) },
+  async health() { return { accountInfo: { displayName: "Retained synthetic subscription" } }; }
+});
+const pool = defineProvider({ name: "Retained test pool access", auth: { token: secrets({ label: "Pool token", fields: object({ token: string() }) }) } });
+const requirements = { app: { accounts: { ${withPool ? "pool, " : ""}subscriptions: subscription.many() } } };
+export default defineApp(requirements, {
+  tools: router({ selected: query({ input: object({}) }, async ctx => ({ accounts: ctx.app.accounts.subscriptions.map(account => account.id) })) }),
+  connect: { subscriptions: {
+    start: async () => ({ session: "synthetic-retained-session", paste: { label: "Callback" } }),
+    status: async () => ({ state: "waiting" }),
+    submit: async () => ({ state: "connected", ref: "synthetic-retained-private-reference" }),
+    cancel: async () => {}, remove: async () => {}
+  } }
+});`;
+
+export const retained = source(false);
+export const retainedWithPool = source(true);
