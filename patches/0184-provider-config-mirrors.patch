diff --git a/e2e/tests/pool-account-selection.spec.ts b/e2e/tests/pool-account-selection.spec.ts
new file mode 100644
index 0000000..8a54a7c
--- /dev/null
+++ b/e2e/tests/pool-account-selection.spec.ts
@@ -0,0 +1,154 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { providerAccountProduct } from "../support/provider-account-product.ts";
+import { providerAppsCatalog } from "../support/provider-apps-catalog.ts";
+import { serverControl } from "../support/server-control.ts";
+import { providerImportJourney } from "../support/provider-import-journey.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Pool selection", (it) => {
+  it.effect(scenarios.poolAccountSelection.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          catalog = yield* providerAppsCatalog;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const apps: string[] = [],
+          accounts: string[] = [];
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* serverControl("start");
+            for (const app of apps)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app}`);
+            for (const account of accounts)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`);
+          }).pipe(Effect.orDie),
+        );
+        yield* providerAccountProduct(catalog.origin, `${catalog.origin}/catalog/index.json`);
+        const canonical = catalog.sources
+          .get("openai")!
+          .files.find((file) => file.path === "providers.ts")!;
+        const pools: string[] = [];
+        for (const name of ["Selection first", "Selection second"]) {
+          const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+            name,
+            files: [
+              appsManifest,
+              canonical,
+              {
+                path: "index.ts",
+                content: `import { defineApp } from "apps";
+import { providers } from "./providers.ts";
+export default defineApp({ app: { accounts: { openai: providers.openai.many().contributed(), anthropic: providers.anthropic.many().contributed() } } }, {});`,
+              },
+            ],
+          });
+          expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+          const pool = (yield* body(Resource, deployed)).id;
+          apps.push(pool);
+          pools.push(pool);
+          const access = yield* api.request(actors.owner, "GET", `${prefix}/apps/${pool}/access`);
+          const revision = (yield* body(Schema.Struct({ revision: Schema.String }), access))
+            .revision;
+          expect(
+            (yield* api.request(actors.owner, "PATCH", `${prefix}/apps/${pool}/access`, {
+              revision,
+              audience: { kind: "everyone" },
+            })).status,
+          ).toBe(200);
+        }
+        const first = `${prefix}/apps/${pools[0]}/accounts/app/openai`;
+        const stale: string[] = [];
+        for (let index = 0; index < 3; index++) {
+          const pending = yield* api.request(actors.owner, "POST", `${first}/connections`, {});
+          expect(pending.status, JSON.stringify(pending.body)).toBe(200);
+          stale.push((yield* body(Resource, pending)).id);
+        }
+        expect(
+          (yield* api.request(
+            actors.owner,
+            "POST",
+            `${prefix}/connections/${stale[1]}/interactive/start`,
+            { method: "codex" },
+          )).status,
+        ).toBe(200);
+        yield* serverControl("stop");
+        yield* legacyStorage([
+          {
+            sql: `update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb), '{basaltPools}', coalesce(metadata::jsonb -> 'basaltPools','{}'::jsonb) || $1::jsonb)::text where id = $2`,
+            params: [
+              JSON.stringify(
+                Object.fromEntries(
+                  pools.map((app) => [
+                    app,
+                    { app, membership: "executor-links-v1", authorization: "executor-app-v1" },
+                  ]),
+                ),
+              ),
+              actors.organization.id,
+            ],
+          },
+        ]);
+        yield* serverControl("start");
+        const beforeCalls = yield* catalog.calls,
+          beforeMirrors = yield* catalog.mirrors;
+        for (const path of [`${first}/connections`, `${first}/import-login-file`, first]) {
+          const result = yield* api.request(
+            actors.owner,
+            "POST",
+            path,
+            path.endsWith("connections")
+              ? {}
+              : path.endsWith("import-login-file")
+                ? {
+                    creation: crypto.randomUUID(),
+                    method: "codex",
+                    file: { type: "codex", token: "synthetic-refused" },
+                  }
+                : {
+                    creation: crypto.randomUUID(),
+                    method: "apiKey",
+                    fields: { token: "synthetic-refused" },
+                  },
+          );
+          expect(result.status, JSON.stringify(result.body)).toBe(409);
+          expect(result.body).toMatchObject({ _tag: "ProviderAppConnectionRequired" });
+        }
+        for (const [method, suffix, payload] of [
+          ["POST", `${stale[0]}/interactive/start`, { method: "codex" }],
+          ["GET", `${stale[1]}/interactive/status`, undefined],
+          ["POST", `${stale[1]}/interactive/submit`, { value: "synthetic-callback" }],
+          [
+            "POST",
+            `${stale[2]}/submit`,
+            { method: "apiKey", fields: { token: "synthetic-refused" } },
+          ],
+        ] as const) {
+          const refused = yield* api.request(
+            actors.owner,
+            method,
+            `${prefix}/connections/${suffix}`,
+            payload,
+          );
+          expect(refused.status, JSON.stringify(refused.body)).toBe(409);
+        }
+        expect(yield* catalog.calls).toEqual(beforeCalls);
+        expect(yield* catalog.mirrors).toEqual(beforeMirrors);
+        for (const connection of stale)
+          expect(
+            (yield* api.request(actors.owner, "POST", `${prefix}/connections/${connection}/cancel`))
+              .status,
+          ).toBe(200);
+        yield* providerImportJourney(catalog, pools, { apps, accounts });
+      }),
+    ),
+  );
+});
diff --git a/e2e/tests/pool-retained-defaults.spec.ts b/e2e/tests/pool-retained-defaults.spec.ts
new file mode 100644
index 0000000..f091e79
--- /dev/null
+++ b/e2e/tests/pool-retained-defaults.spec.ts
@@ -0,0 +1,253 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schedule, Schema } from "effect";
+import { HttpClient } from "effect/http";
+import { randomUUID } from "node:crypto";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { cloudLocks } from "../support/cloud-locks.ts";
+import { Evidence } from "../support/evidence.ts";
+import { Target } from "../support/platform.ts";
+import { files, retainedWithPool } from "../support/retained-pool-source.ts";
+import { scenarios } from "../test-plan.ts";
+
+const App = Schema.Struct({ id: Schema.String, activeVersion: Schema.String });
+class Pending extends Schema.TaggedError<Pending>()("Pending", {}) {}
+
+layer(HostedLive, { excludeTestServices: true })("Retained pool default reconciliation", (it) => {
+  it.effect(scenarios.cloudPoolRetainedDefaults.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          database = yield* cloudLocks,
+          target = yield* Target,
+          http = yield* HttpClient.HttpClient,
+          evidence = yield* Evidence;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const viewer = yield* body(
+          Schema.Struct({ userId: Schema.String }),
+          yield* api.request(actors.owner, "GET", "/api/viewer"),
+        );
+        const rows = (sql: string, params: readonly string[] = []) => database.run({ sql, params });
+        const defer = () =>
+          rows(
+            `update hosted_provisioning set available_at = now() + interval '1 day'
+        where organization_id = $1 and status = 'queued'`,
+            [actors.organization.id],
+          );
+        yield* defer();
+        const [original] = yield* rows(`select metadata from organization where id = $1`, [
+          actors.organization.id,
+        ]);
+        expect(typeof original?.metadata).toBe("string");
+        const created = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: "Retained recovery's pool",
+          files: files(retainedWithPool),
+        });
+        expect(created.status, JSON.stringify(created.body)).toBe(200);
+        const app = yield* body(App, created),
+          path = `${prefix}/apps/${app.id}`;
+        let requirements: string | undefined;
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* defer();
+            if (requirements !== undefined)
+              yield* rows(`update executor_deployments set requirements = $1::json where id = $2`, [
+                requirements,
+                app.activeVersion,
+              ]);
+            yield* rows(`update organization set metadata = $1 where id = $2`, [
+              String(original?.metadata),
+              actors.organization.id,
+            ]);
+            yield* api.request(actors.owner, "DELETE", path);
+          }).pipe(Effect.orDie),
+        );
+        const token = yield* api.request(actors.owner, "POST", `${path}/accounts/app/pool`, {
+          creation: randomUUID(),
+          method: "token",
+          fields: { token: "synthetic-retained-access" },
+        });
+        expect(token.status, JSON.stringify(token.body)).toBe(200);
+        const tokenId = (yield* body(Schema.Struct({ id: Schema.String }), token)).id;
+        expect(
+          (yield* api.request(actors.owner, "PUT", `${path}/accounts/app/pool/${tokenId}`)).status,
+        ).toBe(200);
+        const pending = yield* api.request(
+          actors.owner,
+          "POST",
+          `${path}/accounts/app/subscriptions/connections`,
+          {},
+        );
+        expect(pending.status, JSON.stringify(pending.body)).toBe(200);
+        const connection = (yield* body(Schema.Struct({ id: Schema.String }), pending)).id;
+        expect(
+          (yield* api.request(
+            actors.owner,
+            "POST",
+            `${prefix}/connections/${connection}/interactive/start`,
+            { method: "codex" },
+          )).status,
+        ).toBe(200);
+        const connected = yield* api.request(
+          actors.owner,
+          "POST",
+          `${prefix}/connections/${connection}/interactive/submit`,
+          { value: "synthetic-callback" },
+        );
+        expect(connected.status, JSON.stringify(connected.body)).toBe(200);
+        const account = (yield* body(
+          Schema.Struct({ account: Schema.Struct({ id: Schema.String }) }),
+          connected,
+        )).account.id;
+        const register = () =>
+          rows(
+            `update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb),
+        '{basaltPools}', $1::jsonb)::text where id = $2`,
+            [
+              JSON.stringify({
+                [viewer.userId]: {
+                  app: app.id,
+                  version: app.activeVersion,
+                  bundle: "retained-old-bundle",
+                },
+              }),
+              actors.organization.id,
+            ],
+          );
+        yield* register();
+        yield* rows(`update "user" set "emailVerified" = true where id = $1`, [viewer.userId]);
+        const [deployment] = yield* rows(
+          `select requirements::text as requirements from executor_deployments where id = $1`,
+          [app.activeVersion],
+        );
+        if (typeof deployment?.requirements !== "string")
+          return yield* Effect.die("Missing retained declaration");
+        requirements = deployment.requirements;
+        const before = yield* rows(
+          `select id from executor_deployments where code = (select code from executor_apps where id = $1) order by id`,
+          [app.id],
+        );
+        const dispatch = (expected: "succeeded" | "queued") =>
+          Effect.gen(function* () {
+            yield* defer();
+            const id = randomUUID();
+            yield* rows(
+              `insert into hosted_provisioning (id, kind, organization_id, user_id, available_at)
+          values ($1, 'member', $2, $3, now())`,
+              [id, actors.organization.id, viewer.userId],
+            );
+            yield* Effect.scoped(
+              http
+                .get(
+                  `${target.metadata.origin}/cdn-cgi/handler/scheduled?cron=${encodeURIComponent("* * * * *")}`,
+                )
+                .pipe(Effect.flatMap((response) => response.text)),
+            );
+            const observed = yield* Effect.gen(function* () {
+              const [job] = yield* rows(
+                `select status, attempts from hosted_provisioning where id = $1`,
+                [id],
+              );
+              return job?.status === expected && Number(job.attempts) > 0
+                ? job
+                : yield* new Pending();
+            }).pipe(
+              Effect.retry({
+                while: Schema.is(Pending),
+                schedule: Schedule.spaced("250 millis"),
+                times: 80,
+              }),
+            );
+            yield* rows(
+              `update hosted_provisioning set available_at = now() + interval '1 day' where id = $1`,
+              [id],
+            );
+            return observed;
+          });
+        const unchanged = Effect.gen(function* () {
+          expect(
+            (yield* body(App, yield* api.request(actors.owner, "GET", path))).activeVersion,
+          ).toBe(app.activeVersion);
+          expect(
+            yield* rows(
+              `select id from executor_deployments where code = (select code from executor_apps where id = $1) order by id`,
+              [app.id],
+            ),
+          ).toEqual(before);
+          const serving = yield* api.request(actors.owner, "POST", `${path}/tools/call`, {
+            tool: "selected",
+            kind: "query",
+            input: {},
+          });
+          expect(serving.status, JSON.stringify(serving.body)).toBe(200);
+          expect(serving.body).toEqual({ accounts: [account] });
+        });
+        const held = yield* dispatch("succeeded");
+        yield* unchanged;
+        // Recovery has no metadata proving a fresh creation. It must keep legacy policy too.
+        yield* rows(`update executor_apps set copied_from = $1::json where id = $2`, [
+          JSON.stringify({
+            reference: "https://github.com/JustYannicc/basalt/tree/main/apps/pool",
+            name: "Basalt pool",
+            commit: null,
+          }),
+          app.id,
+        ]);
+        yield* rows(`update "user" set name = 'Retained recovery' where id = $1`, [viewer.userId]);
+        yield* rows(
+          `update organization set metadata = (metadata::jsonb - 'basaltPools')::text where id = $1`,
+          [actors.organization.id],
+        );
+        const recovered = yield* dispatch("succeeded");
+        const [saved] = yield* rows(
+          `select metadata::jsonb -> 'basaltPools' as pools from organization where id = $1`,
+          [actors.organization.id],
+        );
+        expect(saved?.pools).toEqual({
+          [app.id]: expect.objectContaining({
+            app: app.id,
+            owner: viewer.userId,
+            version: app.activeVersion,
+          }),
+        });
+        expect(JSON.stringify(saved?.pools)).not.toContain("executor-links-v1");
+        expect(JSON.stringify(saved?.pools)).not.toContain("executor-app-v1");
+        yield* unchanged;
+        yield* register();
+        // A retained row with an unreadable declaration cannot establish zero legacy reliance.
+        yield* rows(`update executor_deployments set requirements = 'null'::json where id = $1`, [
+          app.activeVersion,
+        ]);
+        const unknown = yield* dispatch("queued");
+        expect(
+          yield* rows(`select active_deployment as version from executor_apps where id = $1`, [
+            app.id,
+          ]),
+        ).toEqual([{ version: app.activeVersion }]);
+        expect(
+          yield* rows(
+            `select id from executor_deployments where code = (select code from executor_apps where id = $1) order by id`,
+            [app.id],
+          ),
+        ).toEqual(before);
+        yield* rows(`update executor_deployments set requirements = $1::json where id = $2`, [
+          requirements,
+          app.activeVersion,
+        ]);
+        yield* unchanged;
+        yield* evidence.json("retained-default-reconciliation.json", {
+          app: app.id,
+          version: app.activeVersion,
+          explicitOwnerDispatch: true,
+          held,
+          recovered,
+          unknown,
+          sourceUnchanged: true,
+        });
+      }),
+    ),
+  );
+});
diff --git a/e2e/tests/pool-retained-subscriptions.spec.ts b/e2e/tests/pool-retained-subscriptions.spec.ts
new file mode 100644
index 0000000..448769b
--- /dev/null
+++ b/e2e/tests/pool-retained-subscriptions.spec.ts
@@ -0,0 +1,181 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Version = Schema.Struct({ id: Schema.String, activeVersion: Schema.String });
+const Connected = Schema.Struct({ state: Schema.Literal("connected"), account: Resource });
+const Rows = Schema.Array(
+  Schema.Struct({
+    requirement: Schema.String,
+    account: Resource,
+    credentialScope: Schema.String,
+    canReconnect: Schema.Boolean,
+  }),
+);
+import { files, stripped, retained } from "../support/retained-pool-source.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Retained pool subscriptions", (it) => {
+  it.effect(scenarios.poolRetainedSubscriptions.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const viewer = yield* body(
+          Schema.Struct({ userId: Schema.String }),
+          yield* api.request(actors.owner, "GET", "/api/viewer"),
+        );
+        let app: string | undefined, account: string | undefined;
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* serverControl("start");
+            if (app !== undefined)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app}`);
+            if (account !== undefined)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`);
+          }).pipe(Effect.orDie),
+        );
+        const created = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: "Retained subscription pool",
+          files: files(stripped),
+        });
+        expect(created.status, JSON.stringify(created.body)).toBe(200);
+        const initial = yield* body(Version, created);
+        app = initial.id;
+        const path = `${prefix}/apps/${app}`;
+        const deployed = yield* api.request(actors.owner, "POST", `${path}/deploy`, {
+          files: files(retained),
+        });
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const previous = (yield* body(Schema.Struct({ app: Version }), deployed)).app;
+        const pending = yield* api.request(
+          actors.owner,
+          "POST",
+          `${path}/accounts/app/subscriptions/connections`,
+          {},
+        );
+        expect(pending.status, JSON.stringify(pending.body)).toBe(200);
+        const connection = (yield* body(Resource, pending)).id;
+        expect(
+          (yield* api.request(
+            actors.owner,
+            "POST",
+            `${prefix}/connections/${connection}/interactive/start`,
+            { method: "codex" },
+          )).status,
+        ).toBe(200);
+        const connected = yield* api.request(
+          actors.owner,
+          "POST",
+          `${prefix}/connections/${connection}/interactive/submit`,
+          { value: "synthetic-callback" },
+        );
+        expect(connected.status, JSON.stringify(connected.body)).toBe(200);
+        account = (yield* body(Connected, connected)).account.id;
+        yield* serverControl("stop");
+        yield* legacyStorage([
+          {
+            sql: `update organization set metadata = jsonb_set(coalesce(metadata::jsonb,'{}'::jsonb),'{basaltPools}',coalesce(metadata::jsonb -> 'basaltPools','{}'::jsonb) || $1::jsonb)::text where id = $2`,
+            params: [
+              JSON.stringify({
+                [viewer.userId]: {
+                  app,
+                  version: previous.activeVersion,
+                  bundle: "retained-legacy-bundle",
+                },
+              }),
+              actors.organization.id,
+            ],
+          },
+        ]);
+        yield* serverControl("start");
+        const linkedPath = `${path}/accounts/app/subscriptions/${account}`;
+        const rows = yield* body(
+          Rows,
+          yield* api.request(actors.owner, "GET", `${path}/accounts/app`),
+        );
+        expect(rows).toContainEqual({
+          requirement: "subscriptions",
+          account: { id: account },
+          credentialScope: "app",
+          canReconnect: false,
+        });
+        const policy = yield* api.request(actors.owner, "GET", `${path}/accounts/methods`);
+        expect(policy.status, JSON.stringify(policy.body)).toBe(200);
+        expect(policy.body).toMatchObject({
+          connections: [
+            {
+              requirement: "subscriptions",
+              canConnect: false,
+              canSelect: false,
+              importMethods: [],
+              destination: { kind: "unavailable" },
+            },
+          ],
+        });
+        expect((yield* api.request(actors.owner, "PUT", linkedPath)).status).toBe(200);
+        expect(
+          (yield* api.request(
+            actors.owner,
+            "POST",
+            `${path}/accounts/app/subscriptions/connections`,
+            {},
+          )).status,
+        ).toBe(409);
+        const health = yield* api.request(
+          actors.owner,
+          "POST",
+          `${prefix}/accounts/${account}/health`,
+        );
+        expect(health.status, JSON.stringify(health.body)).toBe(200);
+        expect(health.body).toMatchObject({
+          info: { displayName: "Retained synthetic subscription" },
+        });
+        for (const source of [
+          stripped,
+          `${retained}\n// Changed source must also wait for adoption.\n`,
+        ]) {
+          const refused = yield* api.request(actors.owner, "POST", `${path}/deploy`, {
+            files: files(source),
+          });
+          expect(refused.status, JSON.stringify(refused.body)).toBe(500);
+          expect(
+            (yield* body(Version, yield* api.request(actors.owner, "GET", path))).activeVersion,
+          ).toBe(previous.activeVersion);
+        }
+        const activation = yield* api.request(actors.owner, "POST", `${path}/activate`, {
+          version: initial.activeVersion,
+          expectedVersion: previous.activeVersion,
+        });
+        expect(activation.status, JSON.stringify(activation.body)).toBe(500);
+        expect(
+          (yield* body(Version, yield* api.request(actors.owner, "GET", path))).activeVersion,
+        ).toBe(previous.activeVersion);
+        const serving = yield* api.request(actors.owner, "POST", `${path}/tools/call`, {
+          tool: "selected",
+          kind: "query",
+          input: {},
+        });
+        expect(serving.status, JSON.stringify(serving.body)).toBe(200);
+        expect(serving.body).toEqual({ accounts: [account] });
+        expect((yield* api.request(actors.owner, "DELETE", linkedPath)).status).toBe(200);
+        expect(
+          yield* body(Rows, yield* api.request(actors.owner, "GET", `${path}/accounts/app`)),
+        ).toEqual([]);
+        expect(
+          (yield* api.request(actors.owner, "POST", `${path}/activate`, {
+            version: initial.activeVersion,
+            expectedVersion: previous.activeVersion,
+          })).status,
+        ).toBe(200);
+      }),
+    ),
+  );
+});
