@@ -0,0 +1,154 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { providerAccountProduct } from "../support/provider-account-product.ts";
+import { providerAppsCatalog } from "../support/provider-apps-catalog.ts";
+import { serverControl } from "../support/server-control.ts";
+import { providerImportJourney } from "../support/provider-import-journey.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Pool selection", (it) => {
+  it.effect(scenarios.poolAccountSelection.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          catalog = yield* providerAppsCatalog;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const apps: string[] = [],
+          accounts: string[] = [];
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* serverControl("start");
+            for (const app of apps)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app}`);
+            for (const account of accounts)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`);
+          }).pipe(Effect.orDie),
+        );
+        yield* providerAccountProduct(catalog.origin, `${catalog.origin}/catalog/index.json`);
+        const canonical = catalog.sources
+          .get("openai")!
+          .files.find((file) => file.path === "providers.ts")!;
+        const pools: string[] = [];
+        for (const name of ["Selection first", "Selection second"]) {
+          const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+            name,
+            files: [
+              appsManifest,
+              canonical,
+              {
+                path: "index.ts",
+                content: `import { defineApp } from "apps";
+import { providers } from "./providers.ts";
+export default defineApp({ app: { accounts: { openai: providers.openai.many().contributed(), anthropic: providers.anthropic.many().contributed() } } }, {});`,
+              },
+            ],
+          });
+          expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+          const pool = (yield* body(Resource, deployed)).id;
+          apps.push(pool);
+          pools.push(pool);
+          const access = yield* api.request(actors.owner, "GET", `${prefix}/apps/${pool}/access`);
+          const revision = (yield* body(Schema.Struct({ revision: Schema.String }), access))
+            .revision;
+          expect(
+            (yield* api.request(actors.owner, "PATCH", `${prefix}/apps/${pool}/access`, {
+              revision,
+              audience: { kind: "everyone" },
+            })).status,
+          ).toBe(200);
+        }
+        const first = `${prefix}/apps/${pools[0]}/accounts/app/openai`;
+        const stale: string[] = [];
+        for (let index = 0; index < 3; index++) {
+          const pending = yield* api.request(actors.owner, "POST", `${first}/connections`, {});
+          expect(pending.status, JSON.stringify(pending.body)).toBe(200);
+          stale.push((yield* body(Resource, pending)).id);
+        }
+        expect(
+          (yield* api.request(
+            actors.owner,
+            "POST",
+            `${prefix}/connections/${stale[1]}/interactive/start`,
+            { method: "codex" },
+          )).status,
+        ).toBe(200);
+        yield* serverControl("stop");
+        yield* legacyStorage([
+          {
+            sql: `update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb), '{basaltPools}', coalesce(metadata::jsonb -> 'basaltPools','{}'::jsonb) || $1::jsonb)::text where id = $2`,
+            params: [
+              JSON.stringify(
+                Object.fromEntries(
+                  pools.map((app) => [
+                    app,
+                    { app, membership: "executor-links-v1", authorization: "executor-app-v1" },
+                  ]),
+                ),
+              ),
+              actors.organization.id,
+            ],
+          },
+        ]);
+        yield* serverControl("start");
+        const beforeCalls = yield* catalog.calls,
+          beforeMirrors = yield* catalog.mirrors;
+        for (const path of [`${first}/connections`, `${first}/import-login-file`, first]) {
+          const result = yield* api.request(
+            actors.owner,
+            "POST",
+            path,
+            path.endsWith("connections")
+              ? {}
+              : path.endsWith("import-login-file")
+                ? {
+                    creation: crypto.randomUUID(),
+                    method: "codex",
+                    file: { type: "codex", token: "synthetic-refused" },
+                  }
+                : {
+                    creation: crypto.randomUUID(),
+                    method: "apiKey",
+                    fields: { token: "synthetic-refused" },
+                  },
+          );
+          expect(result.status, JSON.stringify(result.body)).toBe(409);
+          expect(result.body).toMatchObject({ _tag: "ProviderAppConnectionRequired" });
+        }
+        for (const [method, suffix, payload] of [
+          ["POST", `${stale[0]}/interactive/start`, { method: "codex" }],
+          ["GET", `${stale[1]}/interactive/status`, undefined],
+          ["POST", `${stale[1]}/interactive/submit`, { value: "synthetic-callback" }],
+          [
+            "POST",
+            `${stale[2]}/submit`,
+            { method: "apiKey", fields: { token: "synthetic-refused" } },
+          ],
+        ] as const) {
+          const refused = yield* api.request(
+            actors.owner,
+            method,
+            `${prefix}/connections/${suffix}`,
+            payload,
+          );
+          expect(refused.status, JSON.stringify(refused.body)).toBe(409);
+        }
+        expect(yield* catalog.calls).toEqual(beforeCalls);
+        expect(yield* catalog.mirrors).toEqual(beforeMirrors);
+        for (const connection of stale)
+          expect(
+            (yield* api.request(actors.owner, "POST", `${prefix}/connections/${connection}/cancel`))
+              .status,
+          ).toBe(200);
+        yield* providerImportJourney(catalog, pools, { apps, accounts });
+      }),
+    ),
+  );
+});
