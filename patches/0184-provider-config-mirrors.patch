+import type { JsonObject } from "@executor-js/sdk/core";
+import { Redacted } from "effect";
+
+export const loginFileMaxBytes = 1_048_576;
+
+/** Exported credential selectors belong to another install; only the host assigns the new ID. */
+export const providerLoginFile = (method: string, file: Redacted.Redacted<JsonObject>) => {
+  const value = Redacted.value(file);
+  if (
+    (method !== "codex" && method !== "claude") ||
+    value.type !== method ||
+    new TextEncoder().encode(JSON.stringify(value)).byteLength > loginFileMaxBytes
+  )
+    throw new Error("Invalid provider login file");
+  const { uuid: _uuid, id: _id, auth_index: _authIndex, ...credential } = value;
+  return Redacted.make(credential);
+};
