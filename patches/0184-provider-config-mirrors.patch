+          const account = {
+            id: input.account,
+            owner: input.owner,
+            provider: input.provider,
+            method: input.method,
+            label: input.label ?? (yield* defaultLabel(db, input.owner, input.provider)),
+            description: null,
+            createdAt: new Date(yield* Clock.currentTimeMillis),
+            site: null,
+          };
