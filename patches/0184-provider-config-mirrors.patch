diff --git a/packages/sdk/src/implementation/account-acquisition-import.ts b/packages/sdk/src/implementation/account-acquisition-import.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c3f626b327bc44f292400225ef54a19498b14c91
--- /dev/null
+++ b/packages/sdk/src/implementation/account-acquisition-import.ts
@@ -0,0 +1,227 @@
+import { Clock, Effect, Redacted, Schema, type Crypto } from "effect";
+import {
+  AccountAcquisitionUnavailable,
+  type AccountAcquisitionHost,
+} from "../contracts/account-acquisition-driver.ts";
+import { AccountFieldsInvalid } from "../contracts/account.ts";
+import type { ResourceLifecycle } from "../contracts/executor.ts";
+import { Provider } from "../contracts/provider.ts";
+import { StorageError } from "../contracts/shared.ts";
+import type { Credentials } from "../contracts/storage.ts";
+import {
+  acquisitionRecord,
+  requireAcquisitionBinding,
+  resolveAcquisitionBinding,
+} from "./account-acquisition-bindings.ts";
+import type { AcquisitionRegistry } from "./account-acquisition-registry.ts";
+import { invokeAcquisitionDriver } from "./account-acquisition-runtime.ts";
+import { accountMetadata, defaultLabel } from "./accounts.ts";
+import { query, transaction, type Query } from "./database.ts";
+
+type Input = Parameters<AccountAcquisitionHost["importCredentials"]>[0];
+
+const operation = (input: Input) =>
+  Effect.tryPromise({
+    try: async () => {
+      const canonical = JSON.stringify(
+        [input.owner, input.provider, input.method, input.identity, Redacted.value(input.fields)],
+        (_key, value: unknown) =>
+          value !== null && typeof value === "object" && !Array.isArray(value)
+            ? Object.fromEntries(
+                Object.entries(value).sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0)),
+              )
+            : value,
+      );
+      const digest = await globalThis.crypto.subtle.digest(
+        "SHA-256",
+        new TextEncoder().encode(canonical),
+      );
+      return `import:${Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, "0")).join("")}`;
+    },
+    catch: () => new StorageError(),
+  });
+
+/** Retain one reference before uploading. An uncertain response must never allocate a replacement. */
+export const makeAccountImports =
+  (
+    db: Query,
+    credentials: Credentials,
+    crypto: Crypto.Crypto,
+    registry: AcquisitionRegistry,
+    lifecycle?: ResourceLifecycle,
+  ): AccountAcquisitionHost["importCredentials"] =>
+  (input) =>
+    Effect.gen(function* () {
+      const key = yield* operation(input);
+      const invalid = () =>
+        new AccountFieldsInvalid({ provider: input.provider, method: input.method });
+      const claim = yield* transaction(db, () =>
+        Effect.gen(function* () {
+          const record = yield* acquisitionRecord(db, { account: input.account });
+          const existing = yield* query(() =>
+            db.findFirst("accounts", { where: (b) => b("id", "=", input.account) }),
+          );
+          if (existing !== null) {
+            if (
+              existing.owner !== input.owner ||
+              existing.provider !== input.provider ||
+              existing.method !== input.method ||
+              record?.mirrorOperation !== key
+            )
+              return yield* invalid();
+            yield* input.authorize(input.account);
+            const saved = yield* resolveAcquisitionBinding(
+              db,
+              credentials,
+              true,
+            )(input).pipe(
+              Effect.mapError(() => new AccountAcquisitionUnavailable({ reason: "binding" })),
+            );
+            if (
+              saved === undefined ||
+              saved.binding.removal !== null ||
+              saved.binding.generation !== 0 ||
+              record?.mirrorReference !== null
+            )
+              return yield* invalid();
+            yield* requireAcquisitionBinding(db, saved.binding, false, true);
+            const registration = yield* registry.retained(saved.binding);
+            if (registration.driver.importCredentials === undefined)
+              return yield* new AccountAcquisitionUnavailable({ reason: "unsupported" });
+            return { ...saved, registration, ready: record?.mirrorReady === true };
+          }
+          if (record !== null) return yield* invalid();
+          yield* input.authorize();
+          const registration = registry.current(input.provider, input.method);
+          if (registration?.driver.importCredentials === undefined)
+            return yield* new AccountAcquisitionUnavailable({ reason: "unsupported" });
+          const row = yield* query(() =>
+            db.findFirst("providers", { where: (b) => b("id", "=", input.provider) }),
+          );
+          if (row === null) return yield* invalid();
+          const provider = yield* Schema.decodeUnknownEffect(Provider)(row).pipe(
+            Effect.mapError(() => new StorageError()),
+          );
+          if (provider.definition.auth[input.method]?.type !== "interactive")
+            return yield* invalid();
+          const reference = yield* crypto.randomUUIDv4.pipe(
+            Effect.mapError(() => new StorageError()),
+          );
+          const account = {
+            id: input.account,
+            owner: input.owner,
+            provider: input.provider,
+            method: input.method,
+            label: input.label ?? (yield* defaultLabel(db, input.owner, input.provider)),
+            description: null,
+            createdAt: new Date(yield* Clock.currentTimeMillis),
+            site: null,
+          };
+          const binding = {
+            account: account.id,
+            owner: account.owner,
+            provider: account.provider,
+            method: account.method,
+            driver: registration.driver.id,
+            driverRevision: registration.driver.revision,
+            generation: 0,
+            revision: yield* crypto.randomUUIDv4.pipe(Effect.mapError(() => new StorageError())),
+            removal: null,
+          };
+          const encryptedCredentials = yield* credentials
+            .encrypt(account.id, Redacted.make({ ref: reference }))
+            .pipe(Effect.mapError(() => new StorageError()));
+          yield* query(() => db.create("accounts", { ...account, encryptedCredentials }));
+          yield* query(() =>
+            db.create("accountAcquisitions", {
+              ...binding,
+              mirrorReference: null,
+              mirrorReady: false,
+              mirrorOperation: key,
+            }),
+          );
+          yield* lifecycle?.accountCreated(accountMetadata(account)) ?? Effect.void;
+          return {
+            account,
+            binding,
+            registration,
+            reference: Redacted.make(reference),
+            ready: false,
+          };
+        }),
+      );
+      if (claim.ready) return accountMetadata(claim.account);
+      const upload = claim.registration.driver.importCredentials;
+      if (upload === undefined)
+        return yield* new AccountAcquisitionUnavailable({ reason: "unsupported" });
+      const cleanIfStale = Effect.gen(function* () {
+        const current = yield* resolveAcquisitionBinding(
+          db,
+          credentials,
+          true,
+        )(input).pipe(
+          Effect.catchTags({
+            AccountNotFound: () => Effect.succeed(undefined),
+            AccountAcquisitionUnavailable: () => Effect.succeed(undefined),
+          }),
+        );
+        if (
+          current !== undefined &&
+          Redacted.value(current.reference) === Redacted.value(claim.reference) &&
+          current.binding.removal === null
+        )
+          return;
+        yield* invokeAcquisitionDriver(
+          claim.registration,
+          {
+            owner: input.owner,
+            provider: input.provider,
+            method: input.method,
+            operation: `import-retire:${claim.binding.revision}`,
+            deadline: (yield* Clock.currentTimeMillis) + 15_000,
+          },
+          (context) =>
+            claim.registration.driver.remove({
+              ...context,
+              binding: claim.binding,
+              reference: claim.reference,
+            }),
+        );
+      }).pipe(Effect.catch(() => Effect.logWarning("Stale imported account cleanup needs retry")));
+      return yield* Effect.gen(function* () {
+        yield* invokeAcquisitionDriver(
+          claim.registration,
+          {
+            owner: input.owner,
+            provider: input.provider,
+            method: input.method,
+            operation: key,
+            deadline: (yield* Clock.currentTimeMillis) + 15_000,
+          },
+          (context) =>
+            upload({
+              ...context,
+              binding: claim.binding,
+              reference: claim.reference,
+              fields: input.fields,
+            }),
+        ).pipe(Effect.mapError(() => new AccountAcquisitionUnavailable({ reason: "binding" })));
+        return yield* transaction(db, () =>
+          Effect.gen(function* () {
+            yield* input.authorize(input.account);
+            yield* requireAcquisitionBinding(db, claim.binding, false, true);
+            yield* query(() =>
+              db.updateMany("accountAcquisitions", {
+                where: (b) =>
+                  b.and(
+                    b("account", "=", input.account),
+                    b("revision", "=", claim.binding.revision),
+                  ),
+                set: { mirrorReady: true },
+              }),
+            );
+            return accountMetadata(claim.account);
+          }),
+        );
+      }).pipe(Effect.ensuring(cleanIfStale));
+    });
