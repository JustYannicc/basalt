+import {
+  accountAcquisitionDriver,
+  AccountAcquisitionUnavailable,
+  identifyProvider,
+  type AccountAcquisitionContext,
+  type AccountAcquisitionAccountContext,
+  type AccountAcquisitionRegistration,
+} from "@executor-js/sdk/core";
+import { providerDeclaration } from "apps/host";
+import { AccountCheckResult, AccountObservationResult, ProviderError } from "apps/contracts";
+import { Crypto, Effect, Option, Redacted, Schema } from "effect";
+import { acquisitionProviders } from "./pool-provider-definitions.ts";
+import { availableProviderCapabilities } from "./pool-provider-capabilities.ts";
+import {
+  accountAcquisitionPath,
+  accountAcquisitionPrefix,
+} from "./pool-account-acquisition-contract.ts";
+import { signEnvelope } from "./pool-token.ts";
+import { homeAccountRemoval } from "./account-key-mirror.ts";
+import type { providerLoginFile } from "./provider-login-file.ts";
+import type { makeAccountImports } from "@executor-js/sdk/account-imports";
+import type { poolAccountConnections } from "./pool-account-acquisition.ts";
+
+const unavailable = async (): Promise<never> => {
+  throw new AccountAcquisitionUnavailable({ reason: "unsupported" });
+};
+const failure = Schema.Struct({ failure: ProviderError.fields.reason });
+const health = Schema.Struct({
+  accountInfo: AccountCheckResult.fields.accountInfo,
+  status: AccountCheckResult.fields.status,
+});
+const healthResponse = Schema.Struct({ result: health });
+
+const nativeProviderFamilies: Readonly<Record<string, string>> = {
+  openai: "codex",
+  anthropic: "claude",
+  gemini: "gemini",
+  vertex: "vertex",
+  xai: "xai",
+  meta: "meta",
+};
+
+/** Registration is host-owned; an app can request a canonical method, never a driver or URL. */
+export const poolAccountRegistry = (
+  key: Option.Option<Redacted.Redacted<string>>,
+  origin: string,
+  imports?: {
+    readonly makeImports?: typeof makeAccountImports;
+    readonly loginFile?: typeof providerLoginFile;
+    readonly connections?: typeof poolAccountConnections;
+  },
+) =>
+  Effect.gen(function* () {
+    if (Option.isNone(key)) return { registrations: [] };
+    const secret = key.value;
+    const crypto = yield* Crypto.Crypto;
+    const registrations: AccountAcquisitionRegistration[] = [];
+    for (const capability of availableProviderCapabilities) {
+      if (capability.connection === "unavailable") continue;
+      const definition = yield* providerDeclaration(
+        acquisitionProviders[capability.lab as keyof typeof acquisitionProviders],
+      );
+      const identified = yield* identifyProvider(definition, crypto);
+      const send = async (
+        context: AccountAcquisitionContext,
+        action: string,
+        input: Record<string, unknown> = {},
+      ) => {
+        const at = Date.now();
+        const envelope = await signEnvelope(Redacted.value(secret), accountAcquisitionPrefix, {
+          owner: context.owner,
+          operation: context.operation,
+          action,
+          provider: capability.backend,
+          at,
+          expiresAt: Math.min(context.deadline, at + 30_000),
+          ...input,
+        });
+        const response = await context.fetch(new URL(accountAcquisitionPath, origin), {
+          method: "POST",
+          signal: context.signal,
+          headers: { "content-type": "application/json" },
+          body: JSON.stringify({ envelope }),
+        });
+        if (!response.ok) {
+          await response.body?.cancel();
+          throw new Error("Account backend unavailable");
+        }
+        return await response.json();
+      };
+      const oauth = capability.connection === "home-oauth";
+      const family = nativeProviderFamilies[capability.lab] ?? "openai-compatibility";
+      const remove = homeAccountRemoval({
+        origin,
+        signingKey: secret,
+        ...(capability.connection === "credential-mirror" ||
+        capability.connection === "token-mirror"
+          ? {}
+          : { credential: { type: "config", family } }),
+      });
+      const driver = accountAcquisitionDriver({
+        id: "basalt-home",
+        revision: oauth
+          ? "oauth-v1"
+          : capability.connection === "token-mirror"
+            ? "key-mirror-v1"
+            : "provider-mirror-v1",
+        ...(imports?.connections?.(capability, { origin, signingKey: secret }, send, imports) ?? {
+          start: unavailable,
+          status: unavailable,
+          cancel: async (context, input) => {
+            if (oauth) await send(context, "cancel", input);
+          },
+        }),
+        remove: async (context) => {
+          if (oauth)
+            await send(context, "remove", { reference: Redacted.value(context.reference) });
+          else await remove(context);
+        },
+        ...(capability.connection === "config-mirror"
+          ? {}
+          : {
+              observeAccount: async (context) => {
+                const answer = await send(context, "observe", {
+                  reference: Redacted.value(context.reference),
+                });
+                if (Schema.is(failure)(answer)) throw new ProviderError({ reason: answer.failure });
+                const { result } = Schema.decodeUnknownSync(
+                  Schema.Struct({ result: Schema.NullOr(AccountObservationResult) }),
+                )(answer);
+                if (result === null) return undefined;
+                return oauth
+                  ? result
+                  : {
+                      ...result,
+                      observation: { ...result.observation, offering: "metered_api" as const },
+                    };
+              },
+            }),
+        ...(oauth
+          ? {
+              check: async (context: AccountAcquisitionAccountContext) => {
+                const answer = await send(context, "check", {
+                  reference: Redacted.value(context.reference),
+                });
+                if (Schema.is(failure)(answer)) throw new ProviderError({ reason: answer.failure });
+                const { result: validHealth } = Schema.decodeUnknownSync(healthResponse)(answer);
+                const result = (answer as { result: unknown }).result;
+                const combined = Schema.decodeUnknownOption(AccountCheckResult)(result);
+                return Option.isSome(combined)
+                  ? combined.value
+                  : { ...validHealth, observationInvalid: true as const };
+              },
+            }
+          : {}),
+      });
+      // The previous label-sensitive identity can still name an account deployed by an older app.
+      for (const provider of new Set([identified.identity, identified.legacy]))
+        registrations.push({
+          provider,
+          method: capability.method,
+          capabilities: ["model-inference"],
+          ...(capability.protocol === "typesafe-systemone"
+            ? { capabilityLabels: { "model-inference": "System One" } }
+            : {}),
+          current: true,
+          exposeHostReference: true,
+          driver,
+          fetch: (input, init) => globalThis.fetch(input, init),
+        });
+    }
+    return {
+      registrations,
+      ...(imports === undefined ? {} : { importCredentials: imports.makeImports }),
+    };
+  }).pipe(Effect.mapError(() => new AccountAcquisitionUnavailable({ reason: "registration" })));
