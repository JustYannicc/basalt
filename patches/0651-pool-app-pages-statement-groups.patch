+      Effect.promise(
+        () =>
+          new Promise<void>((resolve, reject) => {
+            configure.once("error", reject);
+            configure.listen(0, "127.0.0.1", () => {
+              configure.off("error", reject);
+              resolve();
+            });
+          }),
+      ),
+      () =>
+        Effect.promise(
+          () =>
+            new Promise<void>((resolve, reject) =>
+              configure.close((error) => (error ? reject(error) : resolve())),
+            ),
+        ),
+    );
+    const control = configure.address();
+    if (control === null || typeof control === "string")
+      return yield* Effect.die("Missing wire control");
