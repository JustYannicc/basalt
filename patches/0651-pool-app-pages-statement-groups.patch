--- /dev/null
+++ b/e2e/tests/pool-account-view-latency.spec.ts
@@ -0,0 +1,262 @@
+import { expect, layer } from "@effect/vitest";
+import { Clock, Effect, Schedule, Schema } from "effect";
+import { randomUUID } from "node:crypto";
+import { Actors } from "../support/actors.ts";
+import { Api } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Evidence, Telemetry } from "../support/evidence.ts";
+import { legacyPoolHome } from "../support/legacy-pool-home.ts";
+import {
+  installLegacyPoolHandoffSetup,
+  legacyPoolHandoffFixture,
+} from "../support/legacy-pool-handoff-setup.ts";
+import { Target, driver } from "../support/platform.ts";
+import { poolHistoryDatabase } from "../support/pool-history-database.ts";
+import { poolWorkerRuntime } from "../support/pool-worker-runtime.ts";
+import { openPrivateApp, waitForAppUrl } from "../support/app-pages.ts";
+import { sqlCriticalPath } from "../support/sql-critical-path.ts";
+import { sqlWireProof } from "../support/sql-wire-proof.ts";
+import { poolObservation } from "../support/pool-account-view-observations.ts";
+import { scenarios } from "../test-plan.ts";
+
+const View = Schema.Struct({
+  ok: Schema.Literal(true),
+  value: Schema.Struct({
+    accounts: Schema.Array(
+      Schema.Struct({
+        nativeAccountId: Schema.String,
+        nativeView: Schema.Struct({
+          state: Schema.Literal("available"),
+          account: Schema.Struct({ id: Schema.String }),
+          sourceApp: Schema.Struct({ id: Schema.String }),
+          observations: Schema.Struct({
+            account: Schema.String,
+            reports: Schema.Array(
+              Schema.Struct({
+                result: Schema.Struct({
+                  observation: Schema.Struct({ plan: Schema.Struct({ label: Schema.String }) }),
+                }),
+              }),
+            ),
+          }),
+        }),
+      }),
+    ),
+  }),
+});
+
+layer(HostedLive, { excludeTestServices: true })("Pool account view SQL latency", (it) => {
+  installLegacyPoolHandoffSetup({ nativeSources: true });
+  it.effect(scenarios.poolAccountViewLatency.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          target = yield* Target;
+        const evidence = yield* Evidence,
+          browser = yield* Browser,
+          telemetry = yield* Telemetry;
+        const wire = yield* sqlWireProof;
+        const { pool, accounts, database } = legacyPoolHandoffFixture(context);
+        const providers = ["codex", "claude", "claude", "claude", "xai"];
+        const home = yield* legacyPoolHome(
+          pool.id,
+          providers.map((provider, index) => ({
+            id: `synthetic-cloud-native-reference-${index + 1}`,
+            provider,
+          })),
+        );
+        const history = yield* poolHistoryDatabase;
+        const worker = yield* poolWorkerRuntime(
+          target.metadata.origin,
+          home.origin,
+          history.connection,
+        );
+        expect(
+          (yield* api.request(actors.owner, "POST", "/native-provider-fixture/product-peer", {
+            pool: pool.id,
+            origin: worker.origin,
+          })).status,
+        ).toBe(200);
+        yield* Effect.addFinalizer(() =>
+          api
+            .request(actors.owner, "POST", "/native-provider-fixture/product-peer", {
+              pool: pool.id,
+              origin: null,
+            })
+            .pipe(Effect.asVoid, Effect.orDie),
+        );
+        const plan = yield* worker.operations("/model-history/schema/catalog");
+        expect(plan.status).toBe(200);
+        const hashes = yield* driver("Read isolated schema plan", () => plan.json()).pipe(
+          Effect.flatMap(
+            Schema.decodeUnknownEffect(
+              Schema.Struct({ schemaHash: Schema.String, catalogHash: Schema.String }),
+            ),
+          ),
+        );
+        expect(
+          (yield* worker.operations("/model-history/schema", {
+            method: "POST",
+            headers: { "content-type": "application/json" },
+            body: JSON.stringify({ go: true, ...hashes }),
+          })).status,
+        ).toBe(200);
+        const now = yield* Clock.currentTimeMillis;
+        for (const account of accounts) {
+          const result = poolObservation(account.requirement, now);
+          yield* database.run({
+            sql: `insert into executor_account_observations (id,account,owner,source,generation,data,checked_at,next_allowed_at)
+        select a.id||':'||a.credential_generation||':driver:'||encode(sha256(convert_to(b.driver,'UTF8')),'hex'),
+          a.id,a.owner,'driver:'||encode(sha256(convert_to(b.driver,'UTF8')),'hex'),a.credential_generation,
+          jsonb_build_object('kind','driver','id',b.driver,'version',b.driver_revision,'bindingRevision',b.revision,
+            'result',$2::jsonb,'lastAttempt',null,'attemptSource',jsonb_build_object('version',b.driver_revision,'bindingRevision',b.revision)),
+          now(),now()+interval '1 hour'
+        from executor_accounts a join executor_account_acquisitions b on b.account=a.id where a.id=$1
+        on conflict (account,source,generation) do update
+          set data=excluded.data,checked_at=excluded.checked_at,next_allowed_at=excluded.next_allowed_at`,
+            params: [account.id, JSON.stringify(result)],
+          });
+        }
+        const path = `/api/organizations/${actors.organization.id}/apps/${pool.id}`;
+        yield* browser.login(actors.owner);
+        // Measure only the explicit public query, without a UI auto-read racing it.
+        yield* browser.use("Keep query measurement explicit", (page) =>
+          page.route("**/*.js", (route) => route.abort()),
+        );
+        yield* openPrivateApp(yield* waitForAppUrl(actors.owner, `${path}/ui`));
+        const timings: number[] = [];
+        for (const fresh of [false, true]) {
+          const trace = randomUUID().replaceAll("-", "");
+          yield* wire.begin(15);
+          const start = yield* Clock.currentTimeMillis;
+          const reply = yield* browser.use("Read the shipped pool view with SQL latency", (page) =>
+            page.evaluate(
+              ({ trace, fresh }) => {
+                const context = JSON.parse(
+                  document.getElementById("executor-context")?.textContent ?? "{}",
+                );
+                const start = performance.now();
+                return fetch("/_executor/api/query", {
+                  method: "POST",
+                  headers: {
+                    "content-type": "application/json",
+                    traceparent: `00-${trace}-${trace.slice(0, 16)}-01`,
+                  },
+                  body: JSON.stringify({
+                    version: context.version ?? context.deployment,
+                    name: "view",
+                    input: { fresh },
+                  }),
+                }).then((response) =>
+                  response.json().then((body) => ({
+                    status: response.status,
+                    body,
+                    milliseconds: performance.now() - start,
+                    timing: response.headers.get("server-timing"),
+                  })),
+                );
+              },
+              { trace, fresh },
+            ),
+          );
+          const end = yield* Clock.currentTimeMillis;
+          const wires = yield* wire.end(trace);
+          const name = fresh ? "fresh" : "initial";
+          yield* evidence.json(`${name}.json`, reply);
+          yield* evidence.json(`${name}-sql-wire.json`, wires);
+          expect(reply.status, JSON.stringify(reply.body)).toBe(200);
+          const value = yield* Schema.decodeUnknownEffect(View)(reply.body);
+          expect(value.value.accounts.map((account) => account.nativeAccountId).sort()).toEqual(
+            accounts.map((account) => account.id).sort(),
+          );
+          const sources = new Set<string>();
+          for (const account of value.value.accounts) {
+            expect(account.nativeView.account.id).toBe(account.nativeAccountId);
+            expect(account.nativeView.observations.account).toBe(account.nativeAccountId);
+            expect(account.nativeView.observations.reports).toHaveLength(1);
+            const selected = accounts.find((selected) => selected.id === account.nativeAccountId)!;
+            expect(account.nativeView.observations.reports[0]!.result.observation.plan.label).toBe(
+              `Synthetic ${selected.requirement}`,
+            );
+            sources.add(account.nativeView.sourceApp.id);
+          }
+          expect(sources.size).toBe(3);
+          expect(
+            yield* telemetry.export([
+              {
+                traceId: trace,
+                spanId: trace.slice(0, 16),
+                name: "POST /_executor/api/query",
+                kind: 3,
+                startTimeUnixNano: String(BigInt(start) * 1000000n),
+                endTimeUnixNano: String(BigInt(end) * 1000000n),
+                status: { code: 1 },
+              },
+            ]),
+          ).toBe(200);
+          const spans = yield* telemetry.query(trace).pipe(
+            Effect.tap((result) => evidence.json(`${name}-captured-trace.json`, result.data)),
+            Effect.flatMap((result) => {
+              const spans = result.data.map((item) => item.span),
+                ids = new Set(spans.map((span) => span.spanId));
+              const server = reply.timing?.match(/executor-span;desc="([a-f0-9]{16})"/)?.[1];
+              return server !== undefined &&
+                spans.some(
+                  (span) => span.spanId === server && span.operationName === "http.server POST",
+                ) &&
+                spans.filter((span) => span.operationName === "runtime.app.rpc.release").length >=
+                  6 &&
+                spans.every(
+                  (span) =>
+                    !span.operationName.startsWith("[missing parent") &&
+                    (span.parentSpanId === null || ids.has(span.parentSpanId)),
+                )
+                ? Effect.succeed(result.data)
+                : Effect.fail(new Error("Incomplete pool query trace"));
+            }),
+            Effect.retry({ schedule: Schedule.spaced("250 millis"), times: 40 }),
+          );
+          const operations = [
+            "sql.execute",
+            "sdk.apps.get",
+            "sdk.apps.list",
+            "sdk.accounts.health",
+            "sdk.accounts.observations",
+            "runtime.app.remote.invoke",
+            "catalog.lookup",
+          ];
+          const work = Object.fromEntries(
+            operations.map((name) => [
+              name,
+              spans.filter((item) => item.span.operationName === name).length,
+            ]),
+          );
+          const criticalPath = sqlCriticalPath(wires);
+          yield* evidence.json(`${name}-work.json`, {
+            milliseconds: reply.milliseconds,
+            timing: reply.timing,
+            work,
+            criticalPath,
+            spans,
+          });
+          expect(
+            criticalPath.sequentialRoundTrips,
+            "Full pool query round-trip budget at 15 ms SQL latency",
+          ).toBeLessThanOrEqual(80);
+          expect(work["sql.execute"]).toBeLessThanOrEqual(204);
+          expect(work["sdk.apps.get"]).toBeLessThanOrEqual(1);
+          expect(work["sdk.apps.list"]).toBeLessThanOrEqual(11);
+          expect(work["sdk.accounts.health"]).toBe(5);
+          expect(work["sdk.accounts.observations"]).toBe(5);
+          expect(work["runtime.app.remote.invoke"]).toBe(6);
+          expect(work["catalog.lookup"]).toBe(1);
+          timings.push(reply.milliseconds);
+        }
+        yield* evidence.json("query-times.json", { milliseconds: timings, sqlDelayMs: 15 });
+      }),
+    ),
+  );
+});
