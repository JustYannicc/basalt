+++ b/e2e/support/sql-wire-proof.ts
@@ -0,0 +1,35 @@
+import { Effect, FileSystem, Schema } from "effect";
+import { HttpBody, HttpClient } from "effect/http";
+import { randomUUID } from "node:crypto";
+import { Target } from "./platform.ts";
+
+const Wire = Schema.Struct({ start: Schema.Number, end: Schema.Number });
+
+/** Observe the actual local Postgres protocol, including statements the multiplexed client pipelines. */
+export const sqlWireProof = Effect.gen(function* () {
+  const target = yield* Target;
+  const fs = yield* FileSystem.FileSystem;
+  const http = yield* HttpClient.HttpClient;
+  const control = yield* fs.readFileString(`${target.directory}/sql-wire.json`).pipe(
+    Effect.flatMap(Schema.decodeUnknownEffect(Schema.fromJsonString(Schema.Struct({ url: Schema.String })))),
+  );
+  const configure = (delay: number, measuring: boolean) =>
+    http.post(control.url, { body: HttpBody.jsonUnsafe({ delay, measuring }) }).pipe(
+      Effect.flatMap(response => response.status === 200 ? response.json : Effect.die("SQL wire control refused")),
+      Effect.flatMap(Schema.decodeUnknownEffect(Schema.Struct({ wires: Schema.Array(Wire) }))),
+    );
+  yield* Effect.addFinalizer(() => configure(0, false).pipe(Effect.orDie));
+  return {
+    begin: (delay = 0) => configure(delay, true).pipe(Effect.asVoid),
+    end: (trace: string) => configure(0, false).pipe(Effect.map(({ wires }) => wires.map(wire => ({
+      span: {
+        spanId: randomUUID().replaceAll("-", "").slice(0, 16),
+        parentSpanId: trace.slice(0, 16),
+        operationName: "sql.wire",
+        startTime: new Date(wire.start).toISOString(),
+        durationMs: wire.end - wire.start,
+        tags: { "db.wire.clock": "date-now", "db.wire.observer": "local-protocol" },
+      },
+    })))),
+  };
+});
