+        expect(account.nativeView.observations.account).toBe(account.nativeAccountId);
+        expect(account.nativeView.observations.reports).toHaveLength(1);
+        const selected = accounts.find(selected => selected.id === account.nativeAccountId)!;
+        expect(account.nativeView.observations.reports[0]!.result.observation.plan.label).toBe(`Synthetic ${selected.requirement}`);
