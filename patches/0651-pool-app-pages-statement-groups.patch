@@ -0,0 +1,28 @@
+/** Synthetic retained readings with the same nested windows and balances as provider reports. */
+export const poolObservation = (provider: string, now: number) => {
+  const observedAt = new Date(now).toISOString();
+  const staleAt = new Date(now + 3600000).toISOString();
+  return {
+    observedAt,
+    observation: {
+      offering: "subscription",
+      plan: { label: `Synthetic ${provider}`, observedAt, staleAt },
+      usageCredits: {
+        state: "available", balance: { value: "20", unit: "credits" }, observedAt, staleAt,
+        freshness: "fresh", extraUsage: null,
+      },
+      windows: [18000, 604800].map(seconds => ({
+        id: `window-${seconds}`, label: `Synthetic window ${seconds}`, observedAt, staleAt,
+        scope: { kind: "account" },
+        measure: { unit: "requests", used: 25, remaining: 75, limit: 100, remainingRatio: 0.75, unlimited: false },
+        period: { mode: "rolling", seconds }, resetsAt: staleAt,
+      })),
+      balances: [1, 2].map(index => ({
+        id: `reset-${index}`, label: `Synthetic reset ${index}`, unit: "resets", observedAt, staleAt,
+        available: 1, scope: { kind: "account" }, reset: { kind: "full", clears: ["window-18000", "window-604800"] },
+        expiresAt: staleAt,
+      })),
+    },
+    collection: { attemptedAt: observedAt, outcome: "success", retryAt: staleAt },
+  };
+};
diff --git a/e2e/support/sql-latency-proxy.ts b/e2e/support/sql-latency-proxy.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/sql-latency-proxy.ts
@@ -0,0 +1,129 @@
+import { Effect, FileSystem } from "effect";
+import { connect, createServer, type Socket } from "node:net";
+import { createServer as createHttpServer } from "node:http";
+
+interface Wire {
+  readonly start: number;
+  readonly end: number;
+}
+
+/** Local SQL response latency and wire intervals, excluding the connection handshake. */
+export const sqlLatencyProxy = (controlFile: string) =>
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem;
+    let delay = 0;
+    let generation = 0;
+    let measuring = false;
+    let wires: Wire[] = [];
+    const configure = createHttpServer((request, response) => {
+      const chunks: Buffer[] = [];
+      request.on("data", (chunk) => chunks.push(chunk));
+      request.on("end", () => {
+        try {
+          const value: unknown = JSON.parse(Buffer.concat(chunks).toString());
+          if (typeof value !== "object" || value === null || !("delay" in value) ||
+              typeof value.delay !== "number" || value.delay < 0 || value.delay > 100 ||
+              !("measuring" in value) || typeof value.measuring !== "boolean")
+            throw new Error("Invalid wire control");
+          delay = value.delay;
+          if (value.measuring) {
+            generation++;
+            wires = [];
+          }
+          measuring = value.measuring;
+          response.writeHead(200, { "content-type": "application/json" });
+          response.end(JSON.stringify({ wires }));
+        } catch {
+          response.writeHead(400);
+          response.end();
+        }
+      });
+    });
+    yield* Effect.acquireRelease(
+      Effect.promise(() => new Promise<void>((resolve, reject) => {
+        configure.once("error", reject);
+        configure.listen(0, "127.0.0.1", () => { configure.off("error", reject); resolve(); });
+      })),
+      () => Effect.promise(() => new Promise<void>((resolve, reject) =>
+        configure.close(error => error ? reject(error) : resolve()))),
+    );
+    const control = configure.address();
+    if (control === null || typeof control === "string") return yield* Effect.die("Missing wire control");
+    yield* fs.writeFileString(controlFile, JSON.stringify({ url: `http://127.0.0.1:${control.port}` }));
+    yield* Effect.addFinalizer(() => fs.remove(controlFile, { force: true }).pipe(Effect.orDie));
+    let target: number | undefined;
+    const sockets = new Set<Socket>();
+    const timers = new Set<ReturnType<typeof setTimeout>>();
+    const server = createServer(incoming => {
+      if (target === undefined) return incoming.destroy();
+      const outgoing = connect({ host: "127.0.0.1", port: target });
+      incoming.setNoDelay(true);
+      outgoing.setNoDelay(true);
+      sockets.add(incoming);
+      sockets.add(outgoing);
+      let startup = true;
+      let initialized = false;
+      let front = Buffer.alloc(0);
+      let back = Buffer.alloc(0);
+      let deliveryAt = 0;
+      const requests: { readonly start: number; readonly generation?: number }[] = [];
+      const close = () => {
+        incoming.destroy(); outgoing.destroy(); sockets.delete(incoming); sockets.delete(outgoing);
+      };
+      incoming.once("close", close); outgoing.once("close", close);
+      incoming.on("error", close); outgoing.on("error", close);
+      incoming.on("data", chunk => {
+        front = Buffer.concat([front, chunk]);
+        while (front.length >= (startup ? 4 : 5)) {
+          const size = startup ? front.readInt32BE(0) : front.readInt32BE(1) + 1;
+          if (size < (startup ? 4 : 5)) return close();
+          if (front.length < size) break;
+          const frame = front.subarray(0, size); front = front.subarray(size);
+          if (startup) startup = false;
+          else if (frame[0] === 83 || frame[0] === 81)
+            requests.push({ start: Date.now(), ...(measuring ? { generation } : {}) });
+        }
+        outgoing.write(chunk);
+      });
+      outgoing.on("data", chunk => {
+        const now = Date.now();
+        const milliseconds = initialized ? delay : 0;
+        // A later zero-delay chunk must never overtake one already waiting.
+        deliveryAt = Math.max(deliveryAt, now + milliseconds);
+        const end = deliveryAt;
+        back = Buffer.concat([back, chunk]);
+        while (back.length >= 5) {
+          const size = back.readInt32BE(1) + 1;
+          if (size < 5) return close();
+          if (back.length < size) break;
+          const kind = back[0]; back = back.subarray(size);
+          if (kind !== 90) continue;
+          if (!initialized) { initialized = true; continue; }
+          const request = requests.shift();
+          if (request?.generation === generation && measuring)
+            wires.push({ start: request.start, end });
+        }
+        const wait = end - now;
+        if (wait <= 0) { incoming.write(chunk); return; }
+        const timer = setTimeout(() => {
+          timers.delete(timer);
+          if (!incoming.destroyed) incoming.write(chunk);
+        }, wait);
+        timers.add(timer);
+      });
+    });
+    yield* Effect.acquireRelease(
+      Effect.promise(() => new Promise<void>((resolve, reject) => {
+        server.once("error", reject);
+        server.listen(0, "127.0.0.1", () => { server.off("error", reject); resolve(); });
+      })),
+      () => Effect.promise(() => new Promise<void>((resolve, reject) => {
+        for (const timer of timers) clearTimeout(timer);
+        for (const socket of sockets) socket.destroy();
+        server.close(error => error ? reject(error) : resolve());
+      })),
+    );
+    const address = server.address();
+    if (address === null || typeof address === "string") return yield* Effect.die("Missing SQL proxy address");
+    return { port: address.port, select: (port: number) => Effect.sync(() => { target = port; }) };
+  });
