+          a.id,a.owner,'driver:'||encode(sha256(convert_to(b.driver,'UTF8')),'hex'),a.credential_generation,
+          jsonb_build_object('kind','driver','id',b.driver,'version',b.driver_revision,'bindingRevision',b.revision,
+            'result',$2::jsonb,'lastAttempt',null,'attemptSource',jsonb_build_object('version',b.driver_revision,'bindingRevision',b.revision)),
+          now(),now()+interval '1 hour'
+        from executor_accounts a join executor_account_acquisitions b on b.account=a.id where a.id=$1
+        on conflict (account,source,generation) do update
