+    const timers = new Set<ReturnType<typeof setTimeout>>();
+    const server = createServer((incoming) => {
+      if (target === undefined) return incoming.destroy();
+      const outgoing = connect({ host: "127.0.0.1", port: target });
+      incoming.setNoDelay(true);
+      outgoing.setNoDelay(true);
+      sockets.add(incoming);
+      sockets.add(outgoing);
+      let startup = true;
+      let initialized = false;
+      let front = Buffer.alloc(0);
+      let back = Buffer.alloc(0);
+      let deliveryAt = 0;
+      const requests: { readonly start: number; readonly generation?: number }[] = [];
+      const close = () => {
+        incoming.destroy();
+        outgoing.destroy();
+        sockets.delete(incoming);
+        sockets.delete(outgoing);
+      };
+      incoming.once("close", close);
+      outgoing.once("close", close);
+      incoming.on("error", close);
+      outgoing.on("error", close);
+      incoming.on("data", (chunk) => {
+        const bytes = typeof chunk === "string" ? Buffer.from(chunk) : chunk;
+        front = Buffer.concat([front, bytes]);
+        while (front.length >= (startup ? 4 : 5)) {
+          const size = startup ? front.readInt32BE(0) : front.readInt32BE(1) + 1;
+          if (size < (startup ? 4 : 5)) return close();
+          if (front.length < size) break;
+          const frame = front.subarray(0, size);
+          front = front.subarray(size);
+          if (startup) startup = false;
+          else if (frame[0] === 83 || frame[0] === 81)
+            requests.push({ start: Date.now(), ...(measuring ? { generation } : {}) });
+        }
+        outgoing.write(bytes);
+      });
+      outgoing.on("data", (chunk) => {
+        const bytes = typeof chunk === "string" ? Buffer.from(chunk) : chunk;
+        const now = Date.now();
+        const milliseconds = initialized ? delay : 0;
+        // A later zero-delay chunk must never overtake one already waiting.
+        deliveryAt = Math.max(deliveryAt, now + milliseconds);
+        const end = deliveryAt;
+        back = Buffer.concat([back, bytes]);
+        while (back.length >= 5) {
+          const size = back.readInt32BE(1) + 1;
+          if (size < 5) return close();
+          if (back.length < size) break;
+          const kind = back[0];
+          back = back.subarray(size);
+          if (kind !== 90) continue;
+          if (!initialized) {
+            initialized = true;
+            continue;
+          }
+          const request = requests.shift();
+          if (request?.generation === generation && measuring)
+            wires.push({ start: request.start, end });
+        }
+        const wait = end - now;
+        if (wait <= 0) {
+          incoming.write(bytes);
+          return;
+        }
+        const timer = setTimeout(() => {
+          timers.delete(timer);
+          if (!incoming.destroyed) incoming.write(bytes);
+        }, wait);
+        timers.add(timer);
+      });
+    });
+    yield* Effect.acquireRelease(
+      Effect.promise(
+        () =>
+          new Promise<void>((resolve, reject) => {
+            server.once("error", reject);
+            server.listen(0, "127.0.0.1", () => {
+              server.off("error", reject);
+              resolve();
+            });
+          }),
+      ),
+      () =>
+        Effect.promise(
+          () =>
+            new Promise<void>((resolve, reject) => {
+              for (const timer of timers) clearTimeout(timer);
+              for (const socket of sockets) socket.destroy();
+              server.close((error) => (error ? reject(error) : resolve()));
+            }),
+        ),
+    );
+    const address = server.address();
+    if (address === null || typeof address === "string")
+      return yield* Effect.die("Missing SQL proxy address");
+    return {
+      port: address.port,
+      select: (port: number) =>
+        Effect.sync(() => {
+          target = port;
+        }),
+    };
+  });
diff --git a/e2e/support/sql-wire-proof.ts b/e2e/support/sql-wire-proof.ts
new file mode 100644
index 000000000..4a691e35e
--- /dev/null
+++ b/e2e/support/sql-wire-proof.ts
@@ -0,0 +1,46 @@
+import { Effect, FileSystem, Schema } from "effect";
+import { HttpBody, HttpClient } from "effect/http";
+import { randomUUID } from "node:crypto";
+import { Target } from "./platform.ts";
+
+const Wire = Schema.Struct({ start: Schema.Number, end: Schema.Number });
+
+/** Observe the actual local Postgres protocol, including statements the multiplexed client pipelines. */
+export const sqlWireProof = Effect.gen(function* () {
+  const target = yield* Target;
+  const fs = yield* FileSystem.FileSystem;
+  const http = yield* HttpClient.HttpClient;
+  const control = yield* fs
+    .readFileString(`${target.directory}/sql-wire.json`)
+    .pipe(
+      Effect.flatMap(
+        Schema.decodeUnknownEffect(Schema.fromJsonString(Schema.Struct({ url: Schema.String }))),
+      ),
+    );
+  const configure = (delay: number, measuring: boolean) =>
+    http.post(control.url, { body: HttpBody.jsonUnsafe({ delay, measuring }) }).pipe(
+      Effect.flatMap((response) =>
+        response.status === 200 ? response.json : Effect.die("SQL wire control refused"),
+      ),
+      Effect.flatMap(Schema.decodeUnknownEffect(Schema.Struct({ wires: Schema.Array(Wire) }))),
+    );
+  yield* Effect.addFinalizer(() => configure(0, false).pipe(Effect.orDie));
+  return {
+    begin: (delay = 0) => configure(delay, true).pipe(Effect.asVoid),
+    end: (trace: string) =>
+      configure(0, false).pipe(
+        Effect.map(({ wires }) =>
+          wires.map((wire) => ({
+            span: {
+              spanId: randomUUID().replaceAll("-", "").slice(0, 16),
+              parentSpanId: trace.slice(0, 16),
+              operationName: "sql.wire",
+              startTime: new Date(wire.start).toISOString(),
+              durationMs: wire.end - wire.start,
+              tags: { "db.wire.clock": "date-now", "db.wire.observer": "local-protocol" },
+            },
+          })),
+        ),
+      ),
+  };
+});
