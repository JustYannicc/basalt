diff --git a/e2e/tests/account-usage-cells.spec.ts b/e2e/tests/account-usage-cells.spec.ts
new file mode 100644
index 0000000..1453a80
--- /dev/null
+++ b/e2e/tests/account-usage-cells.spec.ts
@@ -0,0 +1,231 @@
+/** Usage cells show only the windows an account reports, in color, and nothing for accounts without limits. */
+import { expect, layer } from "@effect/vitest";
+import { Clock, Effect } from "effect";
+import type { Page } from "playwright";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { observationFixture } from "../support/account-observation-fixture.ts";
+import { scenarios } from "../test-plan.ts";
+
+const hour = 3_600_000;
+const day = 24 * hour;
+const iso = (at: number) => new Date(at).toISOString();
+const percentWindow = (
+  id: string,
+  label: string,
+  remaining: number,
+  seconds: number,
+  resetsIn: number,
+  at: number,
+  stale?: number,
+) => ({
+  id,
+  label,
+  observedAt: iso(at),
+  ...(stale === undefined ? {} : { staleAt: iso(stale) }),
+  measure: { unit: "%", used: 100 - remaining, remainingRatio: remaining / 100 },
+  period: { mode: "fixed", seconds },
+  resetsAt: iso(at + resetsIn),
+});
+const subscription = <const W, const B = readonly []>(at: number, windows: W, balances?: B) => ({
+  observedAt: iso(at),
+  observation: { offering: "subscription", windows, balances: balances ?? [] },
+});
+const banked = (index: number, at: number, expiresIn: number) => ({
+  id: `resets-${index}`,
+  label: "Banked resets",
+  unit: "resets",
+  available: 1,
+  observedAt: iso(at),
+  expiresAt: iso(at + expiresIn),
+});
+
+layer(HostedLive, { excludeTestServices: true })("Account usage cells", (it) => {
+  it.effect(scenarios.accountUsageCells.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const browser = yield* Browser;
+        const now = yield* Clock.currentTimeMillis;
+        // Two windows that both exist, plus one the provider calls unlimited.
+        const studio = yield* observationFixture({
+          name: "Studio fixture",
+          observe: true,
+          health: true,
+        });
+        yield* studio.backend.answer({
+          status: 200,
+          body: subscription(now, [
+            percentWindow("five_hour", "5-hour", 34, 5 * hour, 2 * hour + 14 * 60_000, now),
+            percentWindow("seven_day", "Weekly", 96, 7 * day, 4 * day + hour, now),
+            {
+              id: "daily",
+              label: "Daily",
+              observedAt: iso(now),
+              measure: { unit: "requests", unlimited: true },
+            },
+          ]),
+        });
+        // Weekly only, nearly spent, with two banked resets.
+        const spare = yield* observationFixture({
+          name: "Spare fixture",
+          observe: true,
+          health: true,
+        });
+        yield* spare.backend.answer({
+          status: 200,
+          body: subscription(
+            now,
+            [percentWindow("seven_day", "Weekly", 8, 7 * day, 2 * day + hour, now)],
+            [banked(0, now, 27 * day), banked(1, now, 28 * day)],
+          ),
+        });
+        // A reading three hours old that its source marked stale an hour ago.
+        const old = now - 3 * hour;
+        const stale = yield* observationFixture({
+          name: "Default fixture",
+          observe: true,
+          health: true,
+        });
+        yield* stale.backend.answer({
+          status: 200,
+          body: subscription(old, [
+            percentWindow("seven_day", "Weekly", 89, 7 * day, 6 * day, old, now - hour),
+          ]),
+        });
+        // A connector: health, no usage reporter.
+        const connector = yield* observationFixture({
+          name: "Work mail fixture",
+          observe: false,
+          health: true,
+        });
+        const named = [
+          [studio, "Studio"],
+          [spare, "Spare"],
+          [stale, "Default"],
+          [connector, "Work mail"],
+        ] as const;
+        for (const [fixture, label] of named) {
+          expect(
+            (yield* fixture.api.request(fixture.actors.owner, "PATCH", fixture.accountPath, {
+              label,
+            })).status,
+          ).toBe(200);
+          expect((yield* fixture.refresh()).status).toBe(200);
+        }
+        expect(yield* connector.backend.calls, "a connector has nothing to collect").toBe(0);
+
+        const accounts = `/org/${studio.actors.organization.slug}/accounts`;
+        const block = (page: Page, label: string) =>
+          page.getByRole("group", { name: `Usage and health of ${label}`, exact: true });
+        const cell = (page: Page, label: string, window: string) =>
+          block(page, label).locator(`[data-reading="${window}"]`);
+        const ready = (page: Page) =>
+          Promise.all([
+            cell(page, "Studio", "seven_day").waitFor(),
+            cell(page, "Spare", "seven_day").waitFor(),
+            cell(page, "Default", "seven_day").waitFor(),
+            block(page, "Work mail").locator("[data-account-health]").waitFor(),
+          ]);
+
+        yield* browser.login(studio.actors.owner);
+        for (const width of [1280, 390])
+          for (const scheme of ["light", "dark"] as const) {
+            yield* browser.use(`Open Accounts at ${width}px in ${scheme} mode`, (page) =>
+              page
+                .setViewportSize({ width, height: 900 })
+                .then(() => page.emulateMedia({ colorScheme: scheme }))
+                .then(() => page.goto(accounts))
+                .then(() => ready(page))
+                .then(() => cell(page, "Studio", "seven_day").scrollIntoViewIfNeeded()),
+            );
+            yield* browser.checkpoint(`usage cells ${width} ${scheme}`);
+          }
+
+        const read = yield* browser.use("Read every cell", (page) =>
+          page
+            .setViewportSize({ width: 1280, height: 900 })
+            .then(() => page.emulateMedia({ colorScheme: "light" }))
+            .then(() => page.goto(accounts))
+            .then(() => ready(page))
+            .then(() => {
+              const view = (label: string) =>
+                block(page, label)
+                  .locator("[data-reading]")
+                  .evaluateAll((cells) =>
+                    cells.map((element) => ({
+                      id: element.getAttribute("data-reading"),
+                      state: element.getAttribute("data-meter-state"),
+                      stale: element.hasAttribute("data-stale"),
+                      value: element.querySelector("[data-reading-value]")?.textContent ?? "",
+                      age: element.querySelector("[data-stale-age]")?.textContent ?? null,
+                      fill: (() => {
+                        const bar = element.querySelector('[role="meter"] > span');
+                        return bar === null ? null : getComputedStyle(bar).backgroundColor;
+                      })(),
+                      reset: element.querySelector("[data-reset]")?.textContent ?? null,
+                      resetTitle:
+                        element.querySelector("[data-reset]")?.getAttribute("title") ?? null,
+                      count: element.querySelector("[data-reset-count]")?.textContent ?? null,
+                      countTitle:
+                        element.querySelector("[data-reset-count]")?.getAttribute("title") ?? null,
+                      buttons: element.querySelectorAll("button").length,
+                    })),
+                  );
+              return Promise.all([
+                view("Studio"),
+                view("Spare"),
+                view("Default"),
+                view("Work mail"),
+                block(page, "Work mail").innerText(),
+                block(page, "Work mail").locator("[data-usage]").count(),
+                block(page, "Work mail").getByRole("meter").count(),
+              ]);
+            }),
+        );
+        const [
+          studioCells,
+          spareCells,
+          staleCells,
+          connectorCells,
+          connectorText,
+          ...connectorParts
+        ] = read;
+
+        // Only reported, limited windows render; the unlimited one gets no cell.
+        expect(studioCells.map((entry) => entry.id)).toEqual(["five_hour", "seven_day"]);
+        expect(spareCells.map((entry) => entry.id)).toEqual(["seven_day"]);
+        // Thresholds: green from 70% remaining, amber from 30%, red below with "Low".
+        expect(studioCells.map((entry) => [entry.state, entry.value])).toEqual([
+          ["warn", "Rem 34%"],
+          ["good", "Rem 96%"],
+        ]);
+        expect([spareCells[0]?.state, spareCells[0]?.value]).toEqual(["bad", "Rem 8% · Low"]);
+        const fills = new Set([studioCells[0]?.fill, studioCells[1]?.fill, spareCells[0]?.fill]);
+        expect(fills.size, "green, amber and red are distinct fills").toBe(3);
+        // The reset reads as a countdown with the exact moment on hover.
+        expect(studioCells[0]?.reset).toMatch(/^in [12] h \d+ min$/);
+        expect(studioCells[1]?.reset).toBe("in 4 days");
+        expect(studioCells[1]?.resetTitle).toMatch(/^Resets /);
+        // Stale only when stale: fresh cells name no age and keep their color.
+        expect(
+          [...studioCells, ...spareCells].every((entry) => !entry.stale && entry.age === null),
+        ).toBe(true);
+        expect(staleCells).toHaveLength(1);
+        expect(staleCells[0]?.stale).toBe(true);
+        expect(staleCells[0]?.age).toBe("last read 3 h ago");
+        expect(staleCells[0]?.value, "a stale cell keeps its exact amount").toBe("Rem 89%");
+        expect(fills.has(staleCells[0]?.fill), "a stale bar is grey").toBe(false);
+        // Banked resets are a count on the window they refill, never a control.
+        expect(spareCells[0]?.count).toContain("↻ 2");
+        expect(spareCells[0]?.countTitle).toMatch(/^2 banked resets · soonest expires /);
+        expect(spareCells[0]?.buttons).toBe(0);
+        expect(studioCells.every((entry) => entry.count === null)).toBe(true);
+        // A connector without a usage reporter has no usage area or text.
+        expect(connectorCells).toEqual([]);
+        expect(connectorParts).toEqual([0, 0]);
+        expect(connectorText).not.toMatch(/usage/i);
+      }),
+    ),
+  );
+});
