--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/account-usage-cell.tsx
@@ -0,0 +1,143 @@
+import type { AccountObservationRecord } from "@executor-js/sdk";
+import type { DisplayFormat } from "../../contracts/display.ts";
+import { cn } from "../lib/utils.ts";
+import { age, windowView, type ObservationMeterState } from "./account-observation-format.ts";
+
+type Window = NonNullable<AccountObservationRecord["result"]>["observation"]["windows"][number];
+
+const fills = {
+  good: "bg-emerald-500",
+  warn: "bg-amber-500",
+  bad: "bg-destructive",
+  exhausted: "",
+  unknown: "",
+  unlimited: "",
+} satisfies Record<ObservationMeterState, string>;
+const valueTones: Partial<Record<ObservationMeterState, string>> = {
+  warn: "text-amber-700 dark:text-amber-400",
+  bad: "text-destructive",
+  exhausted: "text-destructive",
+};
+
+/**
+ * One limited window: its label, what remains, the bar and when it resets. A stale reading keeps
+ * its exact amount and drawn width, greys the bar and says how old it is. `resets` is the banked
+ * reset count for the window they refill; it is a count only, never a control.
+ */
+export function UsageCell({
+  entry,
+  stale,
+  resets,
+  now,
+  format,
+}: {
+  readonly entry: Window;
+  readonly stale: boolean;
+  readonly resets?: { readonly count: number; readonly title: string } | undefined;
+  readonly now: number;
+  readonly format: DisplayFormat;
+}) {
+  const reading = windowView(entry, now, format);
+  const read = age(entry.observedAt, now);
+  const value = reading.lead === undefined ? reading.figure : `${reading.lead} ${reading.figure}`;
+  return (
+    <div
+      className="flex min-w-0 flex-col gap-1.25 text-xs"
+      data-reading={entry.id}
+      data-meter-state={reading.state}
+      {...(stale ? { "data-stale": "" } : {})}
+    >
+      <div className="flex min-h-5.5 min-w-0 items-center gap-2">
+        <span
+          className="truncate rounded border bg-muted px-1.5 text-[11px] leading-[18px] font-medium text-foreground"
+          title={entry.label}
+        >
+          {entry.label}
+        </span>
+        {stale && (
+          <span className="shrink-0 text-sign-in-warning" data-stale-age>
+            last read <time dateTime={entry.observedAt}>{read}</time>
+          </span>
+        )}
+        <span className="flex-1" />
+        {resets !== undefined && (
+          <>
+            <span
+              className="shrink-0 font-semibold text-foreground tabular-nums"
+              title={resets.title}
+              data-reset-count={resets.count}
+            >
+              <span aria-hidden>↻ {resets.count}</span>
+              <span className="sr-only">{resets.title}</span>
+            </span>
+            <span className="h-3 w-px shrink-0 bg-border" aria-hidden />
+          </>
+        )}
+        <span className="shrink-0 text-muted-foreground tabular-nums" data-reading-value>
+          {reading.lead !== undefined && `${reading.lead} `}
+          <span
+            className={cn("font-semibold text-foreground", !stale && valueTones[reading.state])}
+          >
+            {reading.figure}
+          </span>
+          {reading.flag !== undefined && !stale && (
+            <span className={cn("font-medium", valueTones[reading.state])}> · {reading.flag}</span>
+          )}
+        </span>
+      </div>
+      <span
+        role="meter"
+        aria-label={stale ? `${entry.label}, stale` : entry.label}
+        aria-valuemin={0}
+        aria-valuemax={reading.aria.max}
+        {...(reading.aria.now === undefined ? {} : { "aria-valuenow": reading.aria.now })}
+        aria-valuetext={[
+          value,
+          stale ? undefined : reading.flag,
+          stale ? `when last read ${read}` : undefined,
+          reading.reset === undefined ? undefined : `resets ${reading.reset.text}`,
+        ]
+          .filter((part) => part !== undefined)
+          .join(", ")}
+        className={cn(
+          "block h-1.5 overflow-hidden rounded-full bg-border",
+          reading.state === "unknown" &&
+            "bg-[repeating-linear-gradient(135deg,var(--color-muted)_0_3px,var(--color-muted-foreground)_3px_4px)] opacity-55",
+          reading.state === "exhausted" &&
+            (stale
+              ? "ring-1 ring-muted-foreground/60 ring-inset"
+              : "bg-destructive/20 ring-1 ring-destructive/40 ring-inset"),
+        )}
+      >
+        {reading.width !== undefined && reading.width > 0 && (
+          <span
+            className={cn(
+              "block h-full rounded-full",
+              stale ? "bg-muted-foreground/45" : fills[reading.state],
+            )}
+            style={{ width: `${reading.width}%` }}
+          />
+        )}
+      </span>
+      {/* The left of this line is reserved for the pool's own token and cost counts. */}
+      {reading.reset !== undefined && (
+        <div className="flex min-w-0 justify-end text-muted-foreground tabular-nums">
+          <span
+            className={cn(
+              "truncate",
+              reading.reset.due ? "text-sign-in-warning" : "text-foreground",
+            )}
+            {...(reading.reset.title === undefined ? {} : { title: reading.reset.title })}
+            data-reset
+          >
+            {reading.reset.at === undefined ? (
+              reading.reset.text
+            ) : (
+              <time dateTime={reading.reset.at}>{reading.reset.text}</time>
+            )}
+          </span>
+        </div>
+      )}
+    </div>
+  );
+}
