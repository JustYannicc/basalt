   "organization:read_audit_logs",
+  "user:read_organizations",
+  "organization:promote_branches",
+  "database:demote_branches",
+  "organization:write_members",
+  "organization:manage_sso",
+  "organization:read_payment_method",
+  "organization:write_payment_method",
+  "organization:read_invoices",
 ];
 
+// PlanetScale advertises each unprefixed scope as an alias of its resource-prefixed form and may
+// report either one in a grant.
+const scopeImplications = {
+  read_user: ["user:read_user"],
+  "user:read_user": ["read_user"],
+  write_user: ["user:write_user"],
+  "user:write_user": ["write_user"],
+  read_organizations: ["user:read_organizations"],
+  "user:read_organizations": ["read_organizations"],
+  read_organization: ["organization:read_organization"],
+  "organization:read_organization": ["read_organization"],
+  write_organization: ["organization:write_organization"],
+  "organization:write_organization": ["write_organization"],
+  read_databases: ["organization:read_databases"],
+  "organization:read_databases": ["read_databases"],
+  write_databases: ["organization:write_databases"],
+  "organization:write_databases": ["write_databases"],
+};
+
 /** Shared hosted client for the catalog app; credentials remain optional host settings. */
 export const planetScaleOAuthClient: FirstPartyOAuthClientDefinition = {
   id: "planetscale",
@@ -39,9 +68,17 @@ export const planetScaleOAuthClient: FirstPartyOAuthClientDefinition = {
     issuer: "https://api.planetscale.com",
     authorizationUrl: "https://app.planetscale.com/oauth/authorize",
     tokenUrl: "https://auth.planetscale.com/oauth/token",
