new file mode 100644
--- /dev/null
+++ b/packages/sdk/src/implementation/app-protocol-oauth-scopes.ts
@@ -0,0 +1,36 @@
+import { Effect, Redacted } from "effect";
+import type { HostAccount, HostAccounts, HostAccountSlots } from "apps/contracts";
+import type { AppProtocol } from "./app-protocols.ts";
+
+/** Retained bundles receive their original account shape, including workflow step contexts. */
+const withoutOAuthScopes = (accounts: HostAccounts): HostAccounts => {
+  const account = ({ oauthScopes: _scopes, ...rest }: HostAccount): HostAccount => rest;
+  const slots = (values: HostAccountSlots): HostAccountSlots =>
+    Object.fromEntries(
+      Object.entries(values).map(([name, selected]) => [
+        name,
+        "id" in selected ? account(selected) : selected.map(account),
+      ]),
+    );
+  return {
+    app: slots(accounts.app),
+    ...(accounts.user === undefined ? {} : { user: slots(accounts.user) }),
+  };
+};
+
+export const withoutOAuthScopeMetadata = (protocol: AppProtocol): AppProtocol => ({
+  ...protocol,
+  invocation: (input) =>
+    protocol.invocation({ ...input, accounts: withoutOAuthScopes(input.accounts) }),
+  workflow: (execution) =>
+    protocol.workflow({
+      ...execution,
+      resolve: () =>
+        execution.resolve().pipe(
+          Effect.map((context) => ({
+            ...context,
+            accounts: Redacted.make(withoutOAuthScopes(Redacted.value(context.accounts))),
+          })),
+        ),
+    }),
+});
