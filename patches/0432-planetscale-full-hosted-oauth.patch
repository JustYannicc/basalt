 import type { FirstPartyOAuthClientDefinition } from "./first-party-oauth.ts";
 
+/**
+ * The hosted app's configured permissions. Each one lets a token call at least one operation in
+ * PlanetScale's API document, and `user:read_organizations` covers the account check. The app's
+ * PlanetScale OAuth application must have exactly these selected.
+ */
 const scopes = [
   "read_user",
   "read_organization",
@@ -17,20 +22,44 @@ const scopes = [
