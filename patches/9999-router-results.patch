+/**
+ * Choose an approval for each operation a router contains, including tools a dynamic router
+ * resolves later. `policy` receives the operation and its name relative to this router; returning
+ * undefined keeps the operation's own approval. Read hints with `toolAnnotations(operation)`.
+ * Apply it to each account's router before `accountRouter` combines them, so every account keeps
+ * its own tools' hints.
+ */
+export const withApprovals = <Query, Mutation>(
+  source: RouterDeclaration<Query, Mutation>,
+  policy: (
+    operation: OperationDeclaration<"query" | "mutation", never>,
+    name: string,
+  ) => Approval | undefined,
+): RouterDeclaration<Query, Mutation> =>
+  eachOperation(source, "withApprovals", (node, name) => {
+    const approval = policy(operationDeclaration(node), name);
+    return approval === undefined ? node : approvedOperation(node, approval);
+  });
+
+/**
+ * Change what each operation a router contains returns, including tools a dynamic router resolves
+ * later. `map` runs synchronously on each successful result with the operation's name relative to
+ * this router; what it returns replaces the result before the host checks it against the
+ * operation's `output`, when it declares one. A `map` that throws fails the call. Apply it to each
+ * account's router before `accountRouter` combines them, as with `withApprovals`.
+ */
+export const mapResults = <Query, Mutation>(
+  source: RouterDeclaration<Query, Mutation>,
+  map: (result: unknown, name: string) => unknown,
+): RouterDeclaration<Query, Mutation> =>
+  eachOperation(source, "mapResults", (node, name) => {
+    // Copied by descriptor, not spread, so getters stay lazy: an OpenAPI tool builds its output
+    // schema only when read.
+    // SAFETY: the copy has every own property of `node`, with only `run` replaced below.
+    const copy = Object.defineProperties(
+      {},
+      Object.getOwnPropertyDescriptors(node),
+    ) as AppOperation;
+    return Object.defineProperty(copy, "run", {
+      enumerable: true,
+      value: (context: Parameters<AppOperation["run"]>[0], input: unknown) =>
+        node
+          .run(context, input)
+          .pipe(
+            Effect.flatMap((result) =>
+              Effect.try({ try: () => map(result, name), catch: (error) => error }),
+            ),
+          ),
+    });
+  });
+
