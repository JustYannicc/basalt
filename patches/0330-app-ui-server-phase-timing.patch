diff --git a/e2e/support/app-phase-timings.ts b/e2e/support/app-phase-timings.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/app-phase-timings.ts
@@ -0,0 +1,22 @@
+import { expect } from "@effect/vitest";
+
+/** Only the closed phase fields, never the header's existing correlation identifiers. */
+export const appPhaseTimings = (header: string | null | undefined) => {
+  const fields = (header ?? "").split(/,\s*/u).filter((field) => field.startsWith("app-ui-"));
+  expect(fields.length).toBeGreaterThan(0);
+  expect(fields.length).toBeLessThanOrEqual(24);
+  expect(fields.join(", ").length).toBeLessThan(2048);
+  const result: Record<string, number> = {};
+  for (const field of fields) {
+    const parsed = /^app-ui-([a-z-]+);dur=([0-9]+\.[0-9]{3})$/u.exec(field);
+    if (parsed === null) throw new Error("A phase must contain only its fixed name and duration");
+    const name = parsed[1]!;
+    expect(Object.hasOwn(result, name), "a phase appears once per request").toBe(false);
+    const duration = Number(parsed[2]);
+    expect(Number.isFinite(duration)).toBe(true);
+    expect(duration).toBeGreaterThanOrEqual(0);
+    expect(duration).toBeLessThanOrEqual(60_000);
+    result[name] = duration;
+  }
+  return result;
+};
