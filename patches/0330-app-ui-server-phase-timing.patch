+const queryPhases = ["query-session-access", "query-caller-accounts", "query-dispatch"].sort();
+const Deployment = Schema.Struct({ ...App.fields, activeVersion: Schema.String });
+
+layer(HostedLive, { excludeTestServices: true })("App UI phase headers", (it) => {
+  it.effect(scenarios.appUiPhaseHeaders.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          browser = yield* Browser,
+          evidence = yield* Evidence;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: `Phase headers ${randomUUID().slice(0, 8)}`,
+          files: [
+            appsManifest,
+            {
+              path: "index.ts",
+              content: `import {defineApp,query,object,string,router} from "apps";
+export default defineApp({}, {tools:router({read:query({input:object({}),output:string()},async()=>"Query is ready")})});`,
+            },
+            {
+              path: "ui/index.html",
+              content: "<!doctype html><title>Phase headers</title><p>Document is ready</p>",
+            },
+          ],
+        });
+        expect(deployed.status).toBe(200);
+        const app = yield* body(Deployment, deployed);
+        yield* Effect.addFinalizer(() =>
+          api.request(actors.owner, "DELETE", `${prefix}/apps/${app.id}`).pipe(Effect.orDie),
+        );
+        const url = yield* waitForAppUrl(actors.owner, `${prefix}/apps/${app.id}/ui`);
+        yield* browser.login(actors.owner);
+        const traceparent = `00-${randomUUID().replaceAll("-", "")}-${randomUUID().replaceAll("-", "").slice(0, 16)}-00`;
+        yield* browser.use("Send an unsampled trace", (page) =>
+          page.setExtraHTTPHeaders({ traceparent }),
+        );
+        const document = yield* browser.use("Open a normal unsampled app document", (page) =>
+          page.goto(url).then((response) => {
+            if (response === null) throw new Error("Missing app document response");
+            return response
+              .headerValue("server-timing")
+              .then((timing) => ({ status: response.status(), timing }));
+          }),
+        );
+        expect(document.status).toBe(200);
+        yield* browser.use("The normal document is unchanged", (page) =>
+          page.getByText("Document is ready", { exact: true }).waitFor(),
+        );
+        const first = appPhaseTimings(document.timing);
+        expect(Object.keys(first).sort()).toEqual(documentPhases);
+        // Concurrent document/query requests must each own a collector, even in one Worker isolate.
+        const responses = yield* browser.use("Read concurrent unsampled app requests", (page) =>
+          page.evaluate(
+            ({ version, traceparent }) => {
+              const read = (kind: "document" | "query" | "stale") => {
+                const response =
+                  kind === "document"
+                    ? fetch(location.href, { headers: { traceparent } })
+                    : fetch("/_executor/api/query", {
+                        method: "POST",
+                        headers: { "content-type": "application/json", traceparent },
+                        body: JSON.stringify({
+                          version: kind === "stale" ? "dpl_stale" : version,
+                          name: "read",
+                          input: {},
+                        }),
+                      });
+                return response.then((response) =>
+                  response.text().then((text) => ({
+                    kind,
+                    status: response.status,
+                    timing: response.headers.get("server-timing"),
+                    result: kind === "query" ? JSON.parse(text) : undefined,
+                  })),
+                );
+              };
+              return Promise.all([read("document"), read("query"), read("query"), read("stale")]);
+            },
+            { version: app.activeVersion, traceparent },
+          ),
+        );
+        const safe = responses.map((response) => {
+          const phases = appPhaseTimings(response.timing);
+          const expected =
+            response.kind === "document"
+              ? documentPhases
+              : response.kind === "query"
+                ? queryPhases
+                : ["query-session-access"];
+          expect(Object.keys(phases).sort()).toEqual(expected);
+          expect(response.status).toBe(response.kind === "stale" ? 409 : 200);
+          expect(response.timing).toContain("executor;dur=");
+          // The product records all requests, including incoming 00. Keep its correlation fields.
+          expect(response.timing).toContain(`executor-trace;desc="${traceparent.slice(3, 35)}"`);
+          expect(response.timing).toContain('executor-sampled;desc="1"');
+          if (response.kind === "query") expect(response.result).toBe("Query is ready");
+          return { kind: response.kind, status: response.status, phases, unsampledInput: true };
+        });
+        yield* evidence.json("app-ui-phase-headers.json", { document: first, requests: safe });
+      }),
+    ),
+  );
+});
