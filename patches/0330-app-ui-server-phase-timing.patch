+import { Clock, Context, Effect } from "effect";
+import { HttpEffect, HttpServerResponse } from "effect/http";
+
+type Phase =
+  | "document-authorize"
+  | "document-version"
+  | "document-file"
+  | "document-caller-accounts"
+  | "document-account-notice"
+  | "document-asset"
+  | "document-usage"
+  | "query-session-access"
+  | "query-caller-accounts"
+  | "query-dispatch"
+  | "overview-authorize"
+  | "overview-policy"
+  | "overview-transaction"
+  | "overview-directory"
+  | "overview-membership"
+  | "overview-history-membership"
+  | "overview-history-inspect"
+  | "overview-history-references"
+  | "overview-offerings"
+  | "overview-backend";
+
+const Timings = Context.Reference<Map<Phase, number> | undefined>("hosted/AppUiPhaseTimings", {
+  defaultValue: () => undefined,
+});
+const maximumDuration = 60_000;
+
+/** The closed names and aggregated durations cannot grow with accounts or repeated reads. */
+export const appUiPhase = <A, E, R>(phase: Phase, operation: Effect.Effect<A, E, R>) =>
+  Effect.gen(function* () {
+    const timings = yield* Timings;
+    if (timings === undefined) return yield* operation;
+    const start = yield* Clock.currentTimeNanos;
+    return yield* operation.pipe(
+      Effect.onExit(() =>
+        Effect.gen(function* () {
+          const elapsed = Number((yield* Clock.currentTimeNanos) - start) / 1_000_000;
+          if (!Number.isFinite(elapsed)) return;
+          timings.set(
+            phase,
+            Math.min(maximumDuration, (timings.get(phase) ?? 0) + Math.max(0, elapsed)),
+          );
+        }),
+      ),
+    );
+  });
+
+/**
+ * Capture per request without a trace/exporter. Nested phases are not additive wall time.
+ * Workers advance their clock on I/O; native invocation CPU/wall evidence still bounds CPU work.
+ */
+export const appUiPhaseHeaders = <E, R>(
+  handler: Effect.Effect<HttpServerResponse.HttpServerResponse, E, R>,
+) =>
+  Effect.gen(function* () {
+    const timings = new Map<Phase, number>();
+    yield* HttpEffect.appendPreResponseHandler((_request, response) => {
+      if (timings.size === 0) return Effect.succeed(response);
+      const phases = [...timings]
+        .map(([phase, duration]) => `app-ui-${phase};dur=${duration.toFixed(3)}`)
+        .join(", ");
+      const existing = response.headers["server-timing"];
+      return Effect.succeed(
+        HttpServerResponse.setHeader(
+          response,
+          "server-timing",
+          existing === undefined ? phases : `${existing}, ${phases}`,
+        ),
+      );
+    });
+    return yield* handler.pipe(Effect.provideService(Timings, timings));
+  });
