+                radio(page, "Use quota before it resets").isDisabled(),
+                selection(page).getByText("Only the pool's owner can change this.").count(),
+              ]),
+            ),
+        );
+        expect(member).toEqual([["false", "true", balancedNote, "false"], true, 1]);
+        yield* capture("account-selection-member");
+        expect(
+          (yield* api.request(
+            actors.member,
+            "PATCH",
+            `${prefix}/apps/${app}/pool-selection-policy`,
+            {
+              accountSelectionPolicy: "reset_aware",
+            },
+          )).status,
+        ).toBe(403);
+        expect(yield* saves("setSelectionPolicy")).toEqual([
+          "balanced",
+          "balanced",
+          "reset_aware",
+          "reset_aware",
+          "balanced",
+          "reset_aware",
+          "reset_aware",
+          "balanced",
+        ]);
+      }),
+    ),
+  );
+});
