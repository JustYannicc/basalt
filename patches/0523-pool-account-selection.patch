 /**
- * The pool's Subscription credits setting above its accounts. Other apps read null and show
- * nothing; people who use the pool but can't edit it see the policy that applies to them.
+ * One pool policy's save: the choice in flight, a failure with its retry, and the value to show.
+ * Each policy owns its own, so saving one never holds or fails the other.
+ */
+function usePolicySave<P extends string>(
+  current: P,
+  read: object,
+  save: (policy: P) => Promise<Exit.Exit<unknown, HostedError>>,
+) {
+  // A save in flight, with the policy the pool reported when it started and, once acknowledged,
+  // the read that was current then.
+  const [pending, setPending] = useState<{
+    readonly policy: P;
+    readonly from: P;
+    readonly settledOn?: object;
+  }>();
+  const [error, setError] = useState<{
+    readonly policy: P;
+    readonly cause: Cause.Cause<HostedError>;
+  }>();
+  const latestRead = useRef(read);
+  useEffect(() => {
+    latestRead.current = read;
+  }, [read]);
+  // External reads cannot unlock an unacknowledged save. Once acknowledged, the next read ends
+  // the optimistic value even if another device returned the setting to its old value.
+  const live =
+    pending !== undefined &&
+    (pending.settledOn === undefined || (current === pending.from && pending.settledOn === read));
+  const saving = live ? pending.policy : undefined;
+  const change = async (policy: P) => {
+    const started = { policy, from: current };
+    setPending(started);
+    setError(undefined);
+    const exit = await save(policy);
+    if (Exit.isFailure(exit)) {
+      setPending((now) => (now === started ? undefined : now));
+      setError({ policy, cause: exit.cause });
+    } else
+      setPending((now) => (now === started ? { ...started, settledOn: latestRead.current } : now));
+  };
+  const failure: ReactNode =
+    error === undefined ? undefined : (
+      <HostedFailure
+        cause={error.cause}
+        retry={() => void change(error.policy)}
+        retrying={saving !== undefined}
+        layout="compact"
+      />
+    );
+  return { policy: saving ?? current, pending: saving !== undefined, change, failure };
