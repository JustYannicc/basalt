+        // server refuses the member's own save.
+        expect(
+          (yield* api.request(
+            actors.owner,
+            "PATCH",
+            `${prefix}/apps/${app}/pool-selection-policy`,
+            {
+              accountSelectionPolicy: "balanced",
+            },
+          )).status,
