+                shown(page),
+                selection(page)
+                  .getByText("Pool routing policy could not be confirmed", { exact: false })
+                  .count(),
+              ]),
+            ),
+        );
+        expect(retried).toEqual([["true", "false", resetNote, "false"], 0]);
+        expect(yield* saves("setSelectionPolicy")).toEqual([
+          "balanced",
+          "balanced",
+          "reset_aware",
+          "reset_aware",
+          "balanced",
+          "reset_aware",
+          "reset_aware",
