+        yield* browser.login(actors.member);
+        const member = yield* browser.use("Open the pool as a member", (page) =>
+          page
+            .goto(poolTab)
+            .then(() => note(page, balancedNote).waitFor())
+            .then(() =>
+              Promise.all([
