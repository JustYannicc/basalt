diff --git a/apps/hosted/web/src/implementation/pages/loopback-oauth.tsx b/apps/hosted/web/src/implementation/pages/loopback-oauth.tsx
new file mode 100644
index 00000000..7b25a2f5
--- /dev/null
+++ b/apps/hosted/web/src/implementation/pages/loopback-oauth.tsx
@@ -0,0 +1,209 @@
+import type { HostedError } from "../../contracts/errors.ts";
+import type { HostedOAuthSignIn } from "@executor-js/hosted-server";
+import type { Account, Provider } from "@executor-js/sdk";
+import { useAtomSet } from "@effect/atom-react";
+import { useEffect, useState, type ReactNode } from "react";
+import { Cause, Exit, Redacted } from "effect";
+import { Button } from "@executor-js/ui/components/button";
+import { Input } from "@executor-js/ui/components/input";
+import { HostedFailure } from "../components/dashboard-bindings.tsx";
+import { accountToNameAtom } from "../../contracts/accounts.ts";
+import { completeOAuthAtom, PendingOAuth } from "../../contracts/apps.ts";
+
+const pendingKey = "executor:hosted:oauth";
+const loopbackHosts = new Set(["localhost", "127.0.0.1", "[::1]"]);
+
+/**
+ * Some providers only accept an HTTP loopback callback. Nothing listens there: the browser lands
+ * on a page that fails to load, and the person pastes that address back here.
+ */
+export const isLoopbackRedirect = (redirectUri: string) => {
+  try {
+    const url = new URL(redirectUri);
+    return url.protocol === "http:" && loopbackHosts.has(url.hostname);
+  } catch {
+    return false;
+  }
+};
+
+type SignIn = Pick<HostedOAuthSignIn, "authorizationUrl" | "expiresAt">;
+
+/**
+ * Hand an OAuth sign-in to the provider. A normal callback leaves this page and returns through
+ * `/oauth/callback`; a loopback callback opens sign-in in a new tab and keeps this page, which
+ * renders `step` in place of the form until the pasted address completes the connection. OAuth
+ * state and the verifier stay on the server; only the return context is kept here.
+ */
+export function useOAuthHandoff({
+  provider,
+  onSaved,
+  onPendingChange,
+}: {
+  readonly provider: Provider;
+  readonly onSaved: (account: Account) => void;
+  readonly onPendingChange?: ((pending: boolean) => void) | undefined;
+}) {
+  const [loopback, setLoopback] = useState<{
+    readonly pending: typeof PendingOAuth.Type;
+    readonly signIn: SignIn;
+  }>();
+  const open = (pending: typeof PendingOAuth.Type, signIn: SignIn): "navigating" | "done" => {
+    sessionStorage.setItem(pendingKey, JSON.stringify(pending));
+    if (!isLoopbackRedirect(pending.redirectUri)) {
+      window.location.assign(signIn.authorizationUrl);
+      return "navigating";
+    }
+    window.open(signIn.authorizationUrl, "_blank", "noopener,noreferrer");
+    setLoopback({ pending, signIn });
+    return "done";
+  };
+  const step: ReactNode = loopback && (
+    <LoopbackOAuthStep
+      key={loopback.pending.connection}
+      pending={loopback.pending}
+      signIn={loopback.signIn}
+      provider={provider}
+      onPendingChange={onPendingChange}
+      onCancel={() => setLoopback(undefined)}
+      onSaved={(account) => {
+        setLoopback(undefined);
+        onSaved(account);
+      }}
+    />
+  );
+  return { open, step, active: loopback !== undefined };
+}
+
+function LoopbackOAuthStep({
+  pending,
+  signIn,
+  provider,
+  onPendingChange,
+  onCancel,
+  onSaved,
+}: {
+  readonly pending: typeof PendingOAuth.Type;
+  readonly signIn: SignIn;
+  readonly provider: Provider;
+  readonly onPendingChange?: ((pending: boolean) => void) | undefined;
+  readonly onCancel: () => void;
+  readonly onSaved: (account: Account) => void;
+}) {
+  const complete = useAtomSet(
+    completeOAuthAtom({ organization: pending.organization, connection: pending.connection }),
+    { mode: "promiseExit" },
+  );
+  const requestName = useAtomSet(accountToNameAtom);
+  const [value, setValue] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [invalid, setInvalid] = useState(false);
+  const [error, setError] = useState<Cause.Cause<HostedError>>();
+  const [expired, setExpired] = useState(() => signIn.expiresAt.getTime() <= Date.now());
+  useEffect(() => {
+    if (expired) return;
+    const timer = window.setTimeout(
+      () => setExpired(true),
+      Math.max(0, signIn.expiresAt.getTime() - Date.now()),
+    );
+    return () => window.clearTimeout(timer);
+  }, [expired, signIn.expiresAt]);
+
+  // Catch an obviously wrong paste here; the server still validates the whole callback.
+  const matchesCallback = (pasted: string) => {
+    try {
+      const url = new URL(pasted);
+      const expected = new URL(pending.redirectUri);
+      return url.origin === expected.origin && url.pathname === expected.pathname;
+    } catch {
+      return false;
+    }
+  };
+  const submit = () => {
+    const pasted = value.trim();
+    if (busy || pasted === "") return;
+    if (!matchesCallback(pasted)) {
+      setInvalid(true);
+      return;
+    }
+    setInvalid(false);
+    setError(undefined);
+    setBusy(true);
+    onPendingChange?.(true);
+    void complete({ callbackUrl: Redacted.make(pasted), app: pending.app }).then((exit) => {
+      setBusy(false);
+      onPendingChange?.(false);
+      if (Exit.isFailure(exit)) return setError(exit.cause);
+      sessionStorage.removeItem(pendingKey);
+      // Reconnects keep their name; a new account is named once saved, as the redirect path does.
+      if (pending.reconnect !== true)
+        requestName({
+          organization: pending.organization,
+          account: exit.value.id,
+          saved: { account: exit.value, provider },
+        });
+      onSaved(exit.value);
+    });
+  };
+
+  if (expired && !busy)
+    return (
+      <div className="flex flex-col gap-4">
+        <p role="alert" className="text-sm text-muted-foreground">
+          This sign-in expired. Start again to get a new sign-in link.
+        </p>
+        <Button type="button" className="w-full" onClick={onCancel}>
+          Start again
+        </Button>
+      </div>
+    );
+  return (
+    <form
+      className="flex flex-col gap-4"
+      onSubmit={(event) => {
+        event.preventDefault();
+        submit();
+      }}
+    >
+      <p className="text-sm text-muted-foreground">
+        Sign in to {provider.definition.name} in the new tab. It ends on a page that won’t load:
+        copy that page’s full address and paste it here.
+      </p>
+      <label className="field-label flex flex-col gap-2.25 text-[13px] font-medium">
+        Address of the page you landed on
+        <Input
+          autoComplete="off"
+          spellCheck={false}
+          inputMode="url"
+          placeholder={`${pending.redirectUri}?code=…`}
+          required
+          disabled={busy}
+          aria-invalid={invalid || error !== undefined}
+          value={value}
+          onChange={(event) => {
+            setValue(event.currentTarget.value);
+            setInvalid(false);
+          }}
+        />
+      </label>
+      {invalid && (
+        <p role="alert" className="text-xs leading-relaxed text-muted-foreground">
+          Paste the full address. It starts with {pending.redirectUri}.
+        </p>
+      )}
+      {error !== undefined && <HostedFailure cause={error} layout="compact" />}
+      <Button type="submit" className="w-full" disabled={busy || value.trim() === ""}>
+        {busy ? "Connecting…" : "Connect account"}
+      </Button>
+      <div className="flex items-center justify-between gap-3">
+        <Button type="button" variant="ghost" disabled={busy} onClick={onCancel}>
+          Cancel
+        </Button>
+        <Button variant="outline" asChild>
+          <a href={signIn.authorizationUrl} target="_blank" rel="noopener noreferrer">
+            Open sign-in page
+          </a>
+        </Button>
+      </div>
+    </form>
+  );
+}
