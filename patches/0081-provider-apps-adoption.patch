+++ b/e2e/support/provider-adoption-locks.ts
@@ -0,0 +1,176 @@
+import { expect } from "@effect/vitest";
+import { Effect, Fiber, Schedule, Schema } from "effect";
+import { body } from "./api.ts";
+import { Target } from "./platform.ts";
+import { FixtureActors, fixtureRequest } from "../sdk/fixtures.ts";
+import { Evidence } from "./evidence.ts";
+import { productionOpsClient } from "./production-ops-client.ts";
+import { providerAdoptionFixture } from "./provider-adoption-fixture.ts";
+import { DryRun, Plan } from "./provider-adoption-refusals.ts";
+
+const Backend = Schema.Array(Schema.Struct({ pid: Schema.Number }));
+const Failure = Schema.Struct({
+  error: Schema.Literal("operation_refused"),
+  failure: Schema.Struct({
+    category: Schema.String,
+    sqlStateClass: Schema.optionalKey(Schema.String),
+  }),
+});
+const apply = (operation: unknown, dry: typeof DryRun.Type) => ({
+  ...(typeof operation === "object" && operation !== null ? operation : {}),
+  action: "apply",
+  artifact: dry.artifact,
+  planSha256: dry.artifact.sha256,
+  backupSha256: dry.backupSha256,
+  go: `GO ${dry.artifact.sha256}`,
+});
+
+/** Observe actual blocked database statements, so no timing assumption orders the two HTTP requests. */
+export const proveConcurrentUnlink = Effect.gen(function* () {
+  const p = yield* providerAdoptionFixture,
+    client = yield* productionOpsClient,
+    evidence = yield* Evidence;
+  const operation = {
+    action: "dry-run",
+    selection: "provider-apps-openai-anthropic-v1",
+    recipient: client.recipient,
+    request: p.request,
+  };
+  const dry = yield* body(DryRun, yield* client.request(operation));
+  expect(
+    (yield* Schema.decodeUnknownEffect(Plan)(client.decrypt(dry.artifact))).plan.data.prerequisites
+      .ready,
+  ).toBe(true);
+  const [holder] = yield* p.database
+    .hold({
+      sql: "select pg_backend_pid() as pid, id from executor_apps where owner = $1 and id = $2 for no key update",
+      params: [`organization:${p.request.organization}`, p.pool],
+    })
+    .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Backend)));
+  expect(holder).toBeDefined();
+  yield* Effect.addFinalizer(() => p.database.release.pipe(Effect.orDie));
+  const blockedBy = (pid: number, query: string) =>
+    p.database
+      .run({
+        sql: "select pid from pg_stat_activity where $1::integer = any(pg_blocking_pids(pid)) and query ilike $2",
+        params: [pid, query],
+      })
+      .pipe(
+        Effect.flatMap(Schema.decodeUnknownEffect(Backend)),
+        Effect.filterOrFail(
+          (rows) => rows.length === 1,
+          () => new Error("Expected the selected HTTP statement to wait on its authority lock"),
+        ),
+        Effect.retry({ schedule: Schedule.spaced("10 millis"), times: 100 }),
+      );
+  const selected = p.request.accounts[0]!;
+  const unlink = yield* p.api
+    .request(
+      p.actors.owner,
+      "DELETE",
+      `${p.prefix}/apps/${p.pool}/accounts/app/subscriptions/${selected.account}`,
+    )
+    .pipe(Effect.forkChild);
+  const [unlinkBackend] = yield* blockedBy(holder!.pid, "%executor_apps%");
+  const applying = yield* client.request(apply(operation, dry)).pipe(Effect.forkChild);
+  const [applyBackend] = yield* blockedBy(unlinkBackend!.pid, "%pg_advisory_xact_lock%");
+  const locks = yield* p.database
+    .run({
+      sql: "select exists(select 1 from pg_locks where pid = $1 and granted and relation in ('hosted_app_account_links'::regclass, 'executor_accounts'::regclass) and mode in ('RowShareLock','RowExclusiveLock')) as rows_locked",
+      params: [applyBackend!.pid],
+    })
+    .pipe(
+      Effect.flatMap(
+        Schema.decodeUnknownEffect(Schema.Array(Schema.Struct({ rows_locked: Schema.Boolean }))),
+      ),
+    );
+  yield* evidence.json("adoption-unlink-lock-order.json", {
+    unlinkWaitsOnApp: true,
+    applyWaitsOnOrganization: true,
+    scopedRowsLockedBeforeAuthority: locks[0]!.rows_locked,
+  });
+  expect(locks[0]!.rows_locked).toBe(false);
+  yield* p.database.release;
+  const unlinked = yield* Fiber.join(unlink);
+  expect(unlinked.status, JSON.stringify(unlinked.body)).toBe(200);
+  const refused = yield* Fiber.join(applying);
+  expect(refused.status, JSON.stringify(refused.body)).toBe(409);
+  const failure = yield* body(Failure, refused);
+  expect(failure.failure.sqlStateClass).not.toBe("55");
+  const rows = yield* p.database.run({
+    sql: "select account from hosted_app_account_links where app = $1 and account = $2 and requirement = 'subscriptions'",
+    params: [p.pool, selected.account],
+  });
+  expect(rows).toEqual([]);
+  expect(
+    yield* p.database.run({
+      sql: "select account from executor_account_acquisitions where account = $1",
+      params: [selected.account],
+    }),
+  ).toEqual([]);
+});
+
+/** Hold foreign rows throughout the blocked GO; it must refuse without waiting on or changing them. */
+export const proveForeignPlanLocks = Effect.gen(function* () {
+  const p = yield* providerAdoptionFixture,
+    client = yield* productionOpsClient,
+    evidence = yield* Evidence;
+  const target = yield* Target;
+  if (target.fixtures === undefined) return yield* Effect.die("Managed Cloud required");
+  const outsideId = crypto.randomUUID().replaceAll("-", "");
+  yield* Effect.addFinalizer(() =>
+    fixtureRequest(target.fixtures!, "/remove", { id: outsideId }).pipe(Effect.orDie),
+  );
+  const outside = yield* fixtureRequest(target.fixtures, "/actors", {
+    id: outsideId,
+    label: "Blocked adoption organization",
+  }).pipe(Effect.flatMap(Schema.decodeUnknownEffect(FixtureActors)));
+  const organization = outside.organization;
+  yield* Effect.addFinalizer(() => p.database.release.pipe(Effect.orDie));
+  const operation = {
+    action: "dry-run",
+    selection: "provider-apps-openai-anthropic-v1",
+    recipient: client.recipient,
+    request: { ...p.request, organization: organization.id },
+  };
+  const dry = yield* body(DryRun, yield* client.request(operation));
+  const plan = yield* Schema.decodeUnknownEffect(Plan)(client.decrypt(dry.artifact));
+  expect(plan.plan.changes).toEqual([]);
+  expect(plan.plan.data.prerequisites.ready).toBe(false);
+  const before = yield* p.snapshot;
+  const heldApps = yield* p.database.hold({
+    sql: "select id from executor_apps where owner = $1 and id in ($2,$3,$4) order by id for update",
+    params: [
+      `organization:${p.request.organization}`,
+      p.pool,
+      p.request.apps.openai,
+      p.request.apps.anthropic,
+    ],
+  });
+  expect(heldApps).toHaveLength(3);
+  const heldAccounts = yield* p.database.hold({
+    sql: "select id from executor_accounts where owner = $1 and id = any(string_to_array($2, ',')) order by id for update",
+    params: [
+      `organization:${p.request.organization}`,
+      p.request.accounts.map((a) => a.account).join(","),
+    ],
+  });
+  expect(heldAccounts).toHaveLength(2);
+  const refused = yield* client.request(apply(operation, dry));
+  expect(refused.status, JSON.stringify(refused.body)).toBe(409);
+  const failure = yield* body(Failure, refused);
+  yield* evidence.json("adoption-blocked-foreign-locks.json", {
+    heldForeignApps: heldApps.length,
+    heldForeignAccounts: heldAccounts.length,
+    failure: failure.failure,
+  });
+  expect(failure.failure).toEqual({ category: "unknown" });
+  expect(yield* p.snapshot).toEqual(before);
+  expect(
+    yield* p.database.run({
+      sql: "select plan_sha256 from private_production_ops_receipts where organization_id = $1",
+      params: [organization.id],
+    }),
+  ).toEqual([]);
+  yield* p.database.release;
+});
