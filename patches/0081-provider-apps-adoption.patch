+import { Data, DateTime, Effect, Option, Schema } from "effect";
+import type { Json } from "../contracts.ts";
+import { canonical, sha256 } from "../crypto.ts";
+export { canonical } from "../crypto.ts";
+
+const Link = Schema.Struct({
+  app: Schema.NonEmptyString,
+  version: Schema.NonEmptyString,
+  requirement: Schema.NonEmptyString,
+  subject: Schema.NullOr(Schema.NonEmptyString),
+});
+export const ProviderAppsRequest = Schema.Struct({
+  organization: Schema.NonEmptyString,
+  actor: Schema.NonEmptyString,
+  at: Schema.NonEmptyString,
+  apps: Schema.Struct({ openai: Schema.NonEmptyString, anthropic: Schema.NonEmptyString }),
+  versions: Schema.Struct({ openai: Schema.NonEmptyString, anthropic: Schema.NonEmptyString }),
+  accounts: Schema.Array(
+    Schema.Struct({
+      account: Schema.NonEmptyString,
+      lab: Schema.Literals(["openai", "anthropic"]),
+      provider: Schema.NonEmptyString,
+      method: Schema.Literals(["codex", "claude"]),
+      generation: Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)),
+      links: Schema.Array(Link).check(Schema.isMinLength(1), Schema.isMaxLength(100)),
+    }),
+  ).check(Schema.isMinLength(1), Schema.isMaxLength(100)),
+});
+export type ProviderAppsRequest = typeof ProviderAppsRequest.Type;
+export type Row = { readonly [key: string]: Json };
+export const Rows = Schema.Array(Schema.Struct({ row: Schema.Record(Schema.String, Schema.Json) }));
+export const record = (value: Json | undefined): Row | undefined =>
+  value !== null && typeof value === "object" && !Array.isArray(value) ? (value as Row) : undefined;
+export const same = (left: unknown, right: unknown) => canonical(left) === canonical(right);
+class ProviderAppsRefused extends Data.TaggedError("ProviderAppsRefused")<{
+  readonly message: string;
+}> {}
+export const failure = (message: string) => new ProviderAppsRefused({ message });
+export const refuse = (reason: string) =>
+  Effect.fail(failure(`Provider adoption refused: ${reason}`));
+
+export const hash = (value: unknown) => Effect.sync(() => sha256(canonical(value)));
+
+// PostgreSQL and JavaScript spell the same timestamp differently. Hash its instant consistently.
+const timestamp = (value: Json) => {
+  if (typeof value !== "string") return value;
+  const parsed = DateTime.make(value);
+  return Option.isSome(parsed) ? DateTime.formatIso(parsed.value) : value;
+};
+export const rowHash = (row: Row) =>
+  hash(
+    Object.fromEntries(
+      Object.entries(row).map(([key, value]) => [
+        key,
+        ["created_at", "expires_at"].includes(key) ? timestamp(value) : value,
+      ]),
+    ),
+  );
+export const linkKey = (row: Pick<typeof Link.Type, "app" | "requirement" | "subject">) =>
+  canonical({ app: row.app, requirement: row.requirement, subject: row.subject });
+export const migrationName = "provider-apps-openai-anthropic-v1";
+export const migrationRevision = "1";
+
+export const decodeRequest = (input: Json) =>
+  Effect.gen(function* () {
+    const request = yield* Schema.decodeUnknownEffect(ProviderAppsRequest)(input);
+    const at = DateTime.make(request.at);
+    if (Option.isNone(at) || DateTime.formatIso(at.value) !== request.at)
+      return yield* refuse("at must be an exact ISO timestamp");
+    if (request.apps.openai === request.apps.anthropic)
+      return yield* refuse("provider apps must be distinct");
+    if (
+      new Set(request.accounts.map((account) => account.account)).size !== request.accounts.length
+    )
+      return yield* refuse("duplicate account IDs");
+    for (const account of request.accounts) {
+      if (account.method !== (account.lab === "openai" ? "codex" : "claude"))
+        return yield* refuse("the source method does not identify the selected lab");
+      if (new Set(account.links.map(linkKey)).size !== account.links.length)
+        return yield* refuse("duplicate link mappings");
+    }
+    return request;
+  });
