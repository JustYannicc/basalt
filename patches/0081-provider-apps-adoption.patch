+import { Effect } from "effect";
+import { SqlClient } from "effect/sql";
+import { record, refuse, type ProviderAppsRequest, type Row } from "./provider-apps-schema.ts";
+import { decodedRows, one, type RecordRow } from "./provider-apps-rows.ts";
+
+/** Capture active source and policy together so every app precondition enters the snapshot hash. */
+export const providerAppReader = (request: ProviderAppsRequest, save: RecordRow) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const owner = `organization:${request.organization}`;
+    const apps = new Map<string, Row>();
+    const loadApp = (id: string) =>
+      Effect.gen(function* () {
+        const cached = apps.get(id);
+        if (cached !== undefined) return cached;
+        const app = yield* one(
+          yield* decodedRows(sql`select to_jsonb(a) as row from executor_apps a where id = ${id}`),
+          "app",
+        );
+        if (app.owner !== owner || typeof app.active_deployment !== "string")
+          return yield* refuse("app must be active in this organization");
+        save("executor_apps", { id }, app);
+        const deployment = yield* one(
+          yield* decodedRows(
+            sql`select to_jsonb(d) as row from executor_deployments d where id = ${app.active_deployment}`,
+          ),
+          "active deployment",
+        );
+        if (deployment.owner !== owner || deployment.code !== app.code)
+          return yield* refuse("deployment ownership changed");
+        const requirements = record(deployment.requirements);
+        if (requirements === undefined) return yield* refuse("active requirements are unreadable");
+        save("executor_deployments", { id: String(deployment.id) }, deployment);
+        const policy = yield* one(
+          yield* decodedRows(
+            sql`select to_jsonb(p) as row from hosted_app_access p where id = ${id}`,
+          ),
+          "app access",
+        );
+        if (policy.organization_id !== request.organization)
+          return yield* refuse("app policy belongs to another organization");
+        save("hosted_app_access", { id }, policy);
+        const groups = yield* decodedRows(
+          sql`select to_jsonb(g) as row from hosted_app_groups g where app_id = ${id} order by group_id`,
+        );
+        for (const row of groups)
+          save("hosted_app_groups", { app_id: id, group_id: String(row.group_id) }, row);
+        const value: Row = { ...app, requirements, policy };
+        apps.set(id, value);
+        return value;
+      });
+    return loadApp;
+  });
diff --git a/apps/hosted/cloud/src/infrastructure/production-ops/migrations/provider-apps-consumers.ts b/apps/hosted/cloud/src/infrastructure/production-ops/migrations/provider-apps-consumers.ts
