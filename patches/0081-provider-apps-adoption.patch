+import { Effect, Schema } from "effect";
+import { canonical, failure, record, refuse, Rows, type Row } from "./provider-apps-schema.ts";
+
+export interface StoredRow {
+  readonly table: string;
+  readonly key: Readonly<Record<string, string | null>>;
+  readonly row: Row;
+}
+export const storedKey = (row: Pick<StoredRow, "table" | "key">) =>
+  canonical({ table: row.table, key: row.key });
+export const storedLink = (row: Row): StoredRow => ({
+  table: "hosted_app_account_links",
+  key: {
+    app: String(row.app),
+    requirement: String(row.requirement),
+    account: String(row.account),
+    subject: row.subject === null ? null : String(row.subject),
+  },
+  row,
+});
+
+export const decodedRows = <E, R>(query: Effect.Effect<readonly unknown[], E, R>) =>
+  query.pipe(
+    Effect.flatMap((rows) =>
+      Schema.decodeUnknownEffect(Rows)(rows).pipe(
+        Effect.mapError(() => failure("Provider adoption data is unreadable")),
+      ),
+    ),
+    Effect.map((rows) => rows.map(({ row }) => row)),
+  );
+export const one = (rows: readonly Row[], label: string) =>
+  rows.length === 1 && rows[0] !== undefined
+    ? Effect.succeed(rows[0])
+    : refuse(`missing or ambiguous ${label}`);
+export const definition = (app: Row) => record(record(app.requirements)?.accounts);
+
+export type RecordRow = (
+  table: string,
+  key: Readonly<Record<string, string | null>>,
+  row: Row,
+) => Row;
