+import { Effect } from "effect";
+import { SqlClient } from "effect/sql";
+import { decodedRows, type RecordRow } from "./provider-apps-rows.ts";
+import { refuse, type ProviderAppsRequest } from "./provider-apps-schema.ts";
+
+/** Linking creates source intent even without webhooks. Keep settled empty intent; refuse real consumers. */
+export const requireIdleProviderConsumers = (
+  request: ProviderAppsRequest,
+  account: ProviderAppsRequest["accounts"][number],
+  save: RecordRow,
+) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const sources = yield* decodedRows(
+      sql`select to_jsonb(s) as row from executor_webhook_sources s where account = ${account.account} order by id`,
+    );
+    for (const source of sources) {
+      const link = account.links.find((item) => item.app === source.app);
+      if (
+        source.owner !== `organization:${request.organization}` ||
+        source.actor !== null ||
+        source.status !== "ready" ||
+        source.failure !== null ||
+        source.lease !== null ||
+        link === undefined ||
+        source.reconciled_deployment !== link.version
+      )
+        return yield* refuse(
+          "account has unsettled, leased or mismatched webhook source bookkeeping",
+        );
+      save("executor_webhook_sources", { id: String(source.id) }, source);
+    }
+    const consumers =
+      yield* sql`select 1 from executor_webhooks where source_account = ${account.account}
+    union all select 1 from executor_webhook_accounts where account = ${account.account}
+    union all select 1 from executor_workflow_accounts a join executor_workflow_runs r on r.id = a.run
+      where a.account = ${account.account} and r.status in ('queued','running') limit 1`;
+    if (consumers.length !== 0)
+      return yield* refuse("account has webhook or active workflow consumers");
+  });
diff --git a/apps/hosted/cloud/src/infrastructure/production-ops/migrations/provider-apps-openai-anthropic-v1.ts b/apps/hosted/cloud/src/infrastructure/production-ops/migrations/provider-apps-openai-anthropic-v1.ts
