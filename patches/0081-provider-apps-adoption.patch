diff --git a/e2e/tests/provider-adoption.spec.ts b/e2e/tests/provider-adoption.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/provider-adoption.spec.ts
@@ -0,0 +1,206 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { productionOpsClient } from "../support/production-ops-client.ts";
+import { providerAdoptionFixture } from "../support/provider-adoption-fixture.ts";
+import { DryRun, Plan, proveAdoptionRefusals } from "../support/provider-adoption-refusals.ts";
+import {
+  proveConcurrentUnlink,
+  proveForeignPlanLocks,
+} from "../support/provider-adoption-locks.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Applied = Schema.Struct({
+  action: Schema.Literal("apply"),
+  repeated: Schema.Boolean,
+  verification: Schema.Struct({ ok: Schema.Boolean }),
+});
+const Snapshot = Schema.Array(
+  Schema.Struct({
+    accounts: Schema.Array(Schema.Record(Schema.String, Schema.Json)),
+    access: Schema.Array(Schema.Record(Schema.String, Schema.Json)),
+    sources: Schema.Array(Schema.Record(Schema.String, Schema.Json)),
+    links: Schema.Array(Schema.Record(Schema.String, Schema.Json)),
+    connections: Schema.Array(Schema.Record(Schema.String, Schema.Json)),
+    acquisitions: Schema.NullOr(Schema.Array(Schema.Record(Schema.String, Schema.Json))),
+  }),
+);
+
+layer(HostedLive, { excludeTestServices: true })("Existing provider adoption", (it) => {
+  it.effect(scenarios.providerAdoptionLocks.title, (context) =>
+    withHostedCase(context, proveConcurrentUnlink),
+  );
+  it.effect(scenarios.providerAdoptionForeign.title, (context) =>
+    withHostedCase(context, proveForeignPlanLocks),
+  );
+  it.effect(scenarios.providerAdoption.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const p = yield* providerAdoptionFixture,
+          client = yield* productionOpsClient;
+        const operation = {
+          action: "dry-run",
+          selection: "provider-apps-openai-anthropic-v1",
+          recipient: client.recipient,
+          request: p.request,
+        };
+        const snapshot = () =>
+          p.snapshot.pipe(
+            Effect.flatMap(Schema.decodeUnknownEffect(Snapshot)),
+            Effect.map((rows) => rows[0]!),
+          );
+        const before = yield* snapshot();
+        expect(before.sources.length).toBeGreaterThan(0);
+        yield* proveAdoptionRefusals(p, client);
+        expect(yield* snapshot()).toEqual(before);
+        const dry = yield* client.request(operation);
+        expect(dry.status, JSON.stringify(dry.body)).toBe(200);
+        const prepared = yield* body(DryRun, dry);
+        const plan = yield* Schema.decodeUnknownEffect(Plan)(client.decrypt(prepared.artifact));
+        expect(plan.plan.data.prerequisites.ready).toBe(true);
+        const apply = {
+          ...operation,
+          action: "apply",
+          artifact: prepared.artifact,
+          planSha256: prepared.artifact.sha256,
+          backupSha256: prepared.backupSha256,
+          go: `GO ${prepared.artifact.sha256}`,
+        };
+        expect(yield* snapshot()).toEqual(before);
+        expect(
+          plan.plan.changes
+            .filter((c) => c.table === "executor_accounts")
+            .map((c) => c.key.id)
+            .sort(),
+        ).toEqual(p.request.accounts.map((a) => a.account).sort());
+        for (const change of plan.plan.changes.filter(
+          (c) => c.table === "hosted_app_account_links",
+        ))
+          expect(Object.keys(change.key).sort()).toEqual([
+            "account",
+            "app",
+            "requirement",
+            "subject",
+          ]);
+        // A reviewed deployment ID is required, and later account changes invalidate the plan.
+        const stale = yield* client.request({
+          ...operation,
+          request: {
+            ...p.request,
+            accounts: p.request.accounts.map((a) => ({
+              ...a,
+              links: a.links.map((l) => ({ ...l, version: "changed-deployment" })),
+            })),
+          },
+        });
+        expect(stale.status).toBe(200);
+        const stalePlan = yield* body(DryRun, stale);
+        expect(
+          (yield* Schema.decodeUnknownEffect(Plan)(client.decrypt(stalePlan.artifact))).plan.data
+            .prerequisites.ready,
+        ).toBe(false);
+        const account = p.request.accounts[0]!.account;
+        yield* p.database.run({
+          sql: "update executor_accounts set credential_generation = credential_generation + 1 where id = $1",
+          params: [account],
+        });
+        expect((yield* client.request(apply)).status).toBe(409);
+        yield* p.database.run({
+          sql: "update executor_accounts set credential_generation = credential_generation - 1 where id = $1",
+          params: [account],
+        });
+        expect(yield* snapshot()).toEqual(before);
+        const applied = yield* client.request(apply);
+        expect(applied.status, JSON.stringify(applied.body)).toBe(200);
+        expect(yield* body(Applied, applied)).toMatchObject({
+          repeated: false,
+          verification: { ok: true },
+        });
+        const after = yield* snapshot();
+        expect(after.access).toEqual(before.access);
+        expect(after.sources).toEqual(before.sources);
+        expect(after.accounts).toHaveLength(2);
+        for (const original of before.accounts) {
+          const adopted = after.accounts.find((a) => a.id === original.id)!;
+          const { provider: _provider, method: _method, ...retained } = original;
+          expect(adopted).toMatchObject(retained);
+          expect(adopted.provider).not.toBe(original.provider);
+          expect(adopted.method).toBe(original.method);
+        }
+        expect(after.acquisitions).toHaveLength(2);
+        for (const original of before.links)
+          expect(after.links).toContainEqual({
+            ...original,
+            requirement:
+              before.accounts.find((a) => a.id === original.account)!.method === "codex"
+                ? "openai"
+                : "anthropic",
+          });
+        for (const selected of p.request.accounts) {
+          const links = yield* p.api.request(
+            p.actors.owner,
+            "GET",
+            `${p.prefix}/apps/${p.request.apps[selected.lab === "openai" ? "openai" : "anthropic"]}/accounts/app`,
+          );
+          expect(links.status, JSON.stringify(links.body)).toBe(200);
+          expect(JSON.stringify(links.body)).toContain(selected.account);
+        }
+        const readback = yield* p.api.request(
+          p.actors.owner,
+          "POST",
+          `${p.prefix}/apps/${p.pool}/tools/call`,
+          { tool: "accounts", kind: "query", input: {} },
+        );
+        expect(readback.status, JSON.stringify(readback.body)).toBe(200);
+        expect(readback.body).toEqual({
+          openai: [
+            {
+              id: p.request.accounts.find((a) => a.lab === "openai")!.account,
+              method: "codex",
+              fields: ["ref"],
+            },
+          ],
+          anthropic: [
+            {
+              id: p.request.accounts.find((a) => a.lab === "anthropic")!.account,
+              method: "claude",
+              fields: ["ref"],
+            },
+          ],
+        });
+        const replay = yield* client.request(apply);
+        expect(replay.status, JSON.stringify(replay.body)).toBe(200);
+        expect(yield* body(Applied, replay)).toMatchObject({
+          repeated: true,
+          verification: { ok: true },
+        });
+        expect(yield* snapshot()).toEqual(after);
+        expect(
+          (yield* client.request({
+            ...apply,
+            request: { ...p.request, organization: "another-organization" },
+          })).status,
+        ).toBe(409);
+        expect(yield* snapshot()).toEqual(after);
+        for (const selected of p.request.accounts) {
+          const reused = yield* p.api.request(
+            p.actors.owner,
+            "PUT",
+            `${p.prefix}/apps/${p.second}/accounts/app/${selected.lab}/${selected.account}`,
+          );
+          expect(reused.status, JSON.stringify(reused.body)).toBe(200);
+        }
+        const secondPool = yield* p.api.request(
+          p.actors.owner,
+          "POST",
+          `${p.prefix}/apps/${p.second}/tools/call`,
+          { tool: "accounts", kind: "query", input: {} },
+        );
+        expect(secondPool.status, JSON.stringify(secondPool.body)).toBe(200);
+        expect(secondPool.body).toEqual(readback.body);
+      }),
+    ),
+  );
+});
