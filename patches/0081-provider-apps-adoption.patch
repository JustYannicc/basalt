+++ b/e2e/support/provider-adoption-refusals.ts
@@ -0,0 +1,147 @@
+import { expect } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { body } from "./api.ts";
+import { Artifact, productionOpsClient } from "./production-ops-client.ts";
+import { providerAdoptionFixture } from "./provider-adoption-fixture.ts";
+
+export const DryRun = Schema.Struct({
+  action: Schema.Literal("dry-run"),
+  artifact: Artifact,
+  backupSha256: Schema.String,
+});
+export const Plan = Schema.Struct({
+  plan: Schema.Struct({
+    changes: Schema.Array(
+      Schema.Struct({
+        table: Schema.String,
+        key: Schema.Record(Schema.String, Schema.NullOr(Schema.String)),
+      }),
+    ),
+    data: Schema.Struct({
+      prerequisites: Schema.Struct({
+        ready: Schema.Boolean,
+        checks: Schema.Array(
+          Schema.Struct({ app: Schema.String, missing: Schema.Array(Schema.String) }),
+        ),
+      }),
+    }),
+  }),
+});
+
+/** Existing dependencies and incomplete deployments must block account adoption. */
+export const proveAdoptionRefusals = (
+  p: Effect.Success<typeof providerAdoptionFixture>,
+  client: Effect.Success<typeof productionOpsClient>,
+) =>
+  Effect.gen(function* () {
+    const operation = {
+      action: "dry-run",
+      selection: "provider-apps-openai-anthropic-v1",
+      recipient: client.recipient,
+      request: p.request,
+    };
+    const snapshot = () => p.snapshot;
+    const before = yield* snapshot();
+    const held = p.request.accounts[0]!;
+    const dependency = `hook_${crypto.randomUUID()}`;
+    yield* p.database.run({
+      sql: "insert into executor_webhooks (id,app,owner,subscription_key,deployment,name,source_account,callback_url,accounts,status,revision,lease_until,failure,encrypted,created_at,actor,registered_actor,registered_accounts) values ($1,$2,$3,$1,$4,'adoption-proof',$5,'https://callback.example.test/adoption','{}'::jsonb,'ready','synthetic',now(),null,decode('00','hex'),now(),null,null,'{}'::jsonb)",
+      params: [
+        dependency,
+        p.pool,
+        `organization:${p.request.organization}`,
+        held.links[0]!.version,
+        held.account,
+      ],
+    });
+    yield* Effect.addFinalizer(() =>
+      Effect.gen(function* () {
+        yield* p.database.run({
+          sql: "delete from executor_webhook_accounts where subscription = $1",
+          params: [dependency],
+        });
+        yield* p.database.run({
+          sql: "delete from executor_webhooks where id = $1",
+          params: [dependency],
+        });
+      }).pipe(Effect.orDie),
+    );
+    yield* p.database.run({
+      sql: "insert into executor_webhook_accounts (id,account,subscription) values ($1,$2,$1)",
+      params: [dependency, held.account],
+    });
+    expect((yield* client.request(operation)).status).toBe(409);
+    expect(yield* snapshot()).toEqual(before);
+    yield* p.database.run({
+      sql: "delete from executor_webhook_accounts where subscription = $1",
+      params: [dependency],
+    });
+    yield* p.database.run({
+      sql: "delete from executor_webhooks where id = $1",
+      params: [dependency],
+    });
+
+    const selectedApp = p.request.apps.openai;
+    const deployment = p.request.accounts[0]!.links[0]!.version;
+    const appState = yield* p.database.run({
+      sql: "select active_deployment from executor_apps where id = $1",
+      params: [selectedApp],
+    });
+    const appDeployment = yield* Schema.decodeUnknownEffect(
+      Schema.Struct({ active_deployment: Schema.String }),
+    )(appState[0]);
+    yield* p.database.run({
+      sql: "update executor_apps set active_deployment = null where id = $1",
+      params: [selectedApp],
+    });
+    const inactive = yield* client.request(operation);
+    expect(inactive.status, JSON.stringify(inactive.body)).toBe(200);
+    const blocked = yield* body(DryRun, inactive);
+    const missing = yield* Schema.decodeUnknownEffect(Plan)(client.decrypt(blocked.artifact));
+    expect(missing.plan.data.prerequisites.ready).toBe(false);
+    expect(
+      missing.plan.data.prerequisites.checks.find((check) => check.app === selectedApp)!.missing,
+    ).toContain("no active deployment");
+    expect(missing.plan.changes).toEqual([]);
+    expect(
+      (yield* client.request({
+        ...operation,
+        action: "apply",
+        artifact: blocked.artifact,
+        planSha256: blocked.artifact.sha256,
+        backupSha256: blocked.backupSha256,
+        go: `GO ${blocked.artifact.sha256}`,
+      })).status,
+    ).toBe(409);
+    yield* p.database.run({
+      sql: "update executor_apps set active_deployment = $2 where id = $1",
+      params: [selectedApp, appDeployment.active_deployment],
+    });
+    const sources = yield* p.database.run({
+      sql: "select requirements from executor_deployments where id = $1",
+      params: [deployment],
+    });
+    const source = yield* Schema.decodeUnknownEffect(Schema.Struct({ requirements: Schema.Json }))(
+      sources[0],
+    );
+    yield* p.database.run({
+      sql: "update executor_deployments set requirements = requirements::jsonb #- '{accounts,openai}' where id = $1",
+      params: [deployment],
+    });
+    const unprepared = yield* client.request(operation);
+    expect(unprepared.status, JSON.stringify(unprepared.body)).toBe(200);
+    const unpreparedPlan = yield* body(DryRun, unprepared);
+    const missingSlot = yield* Schema.decodeUnknownEffect(Plan)(
+      client.decrypt(unpreparedPlan.artifact),
+    );
+    expect(missingSlot.plan.data.prerequisites.ready).toBe(false);
+    expect(
+      missingSlot.plan.data.prerequisites.checks.find((check) => check.app === p.pool)!.missing,
+    ).toContain("active openai requirement is not the canonical contributed app-scoped many slot");
+    expect(missingSlot.plan.changes).toEqual([]);
+    yield* p.database.run({
+      sql: "update executor_deployments set requirements = $2::jsonb where id = $1",
+      params: [deployment, JSON.stringify(source.requirements)],
+    });
+    expect(yield* snapshot()).toEqual(before);
+  });
