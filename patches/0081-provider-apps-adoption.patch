+import { identifyProvider } from "@executor-js/sdk/core";
+import { providerDeclaration } from "apps/host";
+import { Crypto, Effect } from "effect";
+import { providers } from "./pool-provider-definitions.ts";
+
+/** Operations use the same identity producer as the apps and host driver registry. */
+export const providerAccountDefinitions = Effect.gen(function* () {
+  const crypto = yield* Crypto.Crypto;
+  return yield* Effect.forEach(["openai", "anthropic"] as const, (lab) =>
+    Effect.gen(function* () {
+      const declaration = yield* providerDeclaration(providers[lab]);
+      const identified = yield* identifyProvider(declaration, crypto);
+      return { lab, method: lab === "openai" ? "codex" : "claude", ...identified };
+    }),
+  );
+});
