+import * as BrowserCrypto from "@effect/platform-browser/BrowserCrypto";
+import { providerAccountDefinitions } from "@executor-js/hosted-server/provider-account-definitions";
+import { Effect } from "effect";
+import { SqlClient } from "effect/sql";
+import { decodedRows, definition } from "./provider-apps-rows.ts";
+import { record, same, type ProviderAppsRequest, type Row } from "./provider-apps-schema.ts";
+
+/** Missing prerequisites remain visible inside the encrypted dry-run artifact without proposing writes. */
+export const providerAppsPrerequisites = (request: ProviderAppsRequest) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const identities = yield* providerAccountDefinitions.pipe(Effect.provide(BrowserCrypto.layer));
+    const pools = new Map<string, { versions: Set<string>; providers: Set<string> }>();
+    for (const account of request.accounts)
+      for (const link of account.links) {
+        const pool = pools.get(link.app) ?? {
+          versions: new Set<string>(),
+          providers: new Set<string>(),
+        };
+        pool.versions.add(link.version);
+        pool.providers.add(account.provider);
+        pools.set(link.app, pool);
+      }
+    const targets = [
+      ...identities.map((identity) => ({
+        app: request.apps[identity.lab],
+        kind: identity.lab,
+        versions: new Set([request.versions[identity.lab]]),
+        providers: new Set<string>(),
+      })),
+      ...[...pools].map(([app, pool]) => ({ app, kind: "pool", ...pool })),
+    ];
+    const checks: Array<{
+      app: string;
+      kind: string;
+      expectedVersions: string[];
+      activeVersion: string | null;
+      missing: string[];
+    }> = [];
+    for (const target of targets) {
+      const missing: string[] = [];
+      const appRows = yield* decodedRows(
+        sql`select to_jsonb(a) as row from executor_apps a where id = ${target.app} and owner = ${`organization:${request.organization}`}`,
+      );
+      const app = appRows.length === 1 ? appRows[0] : undefined;
+      const active = typeof app?.active_deployment === "string" ? app.active_deployment : null;
+      if (app === undefined) missing.push("app missing or ambiguous");
+      if (active === null) missing.push("no active deployment");
+      if (target.versions.size !== 1 || active === null || !target.versions.has(active))
+        missing.push("active deployment differs from the expected version");
+      let deployment: Row | undefined;
+      if (active !== null) {
+        const rows = yield* decodedRows(
+          sql`select to_jsonb(d) as row from executor_deployments d where id = ${active} and owner = ${`organization:${request.organization}`} and code = ${app?.code ?? null}`,
+        );
+        deployment = rows.length === 1 ? rows[0] : undefined;
+      }
+      if (deployment === undefined) missing.push("active deployment record missing or ambiguous");
+      const policies = yield* decodedRows(
+        sql`select to_jsonb(p) as row from hosted_app_access p where id = ${target.app} and organization_id = ${request.organization}`,
+      );
+      const policy = policies.length === 1 ? policies[0] : undefined;
+      if (policy === undefined) missing.push("organization app policy missing or inconsistent");
+      if (
+        target.kind !== "pool" &&
+        (policy?.audience !== "private" || policy.creator_id !== request.actor)
+      )
+        missing.push("provider app is not private to the selected actor");
+      const slots =
+        deployment === undefined
+          ? undefined
+          : definition({ requirements: deployment.requirements ?? null });
+      for (const identity of identities) {
+        if (target.kind !== "pool" && target.kind !== identity.lab) continue;
+        const slot = record(slots?.[identity.lab]);
+        if (
+          slot?.provider !== identity.identity ||
+          slot.scope !== "app" ||
+          slot.cardinality !== "many" ||
+          (target.kind === "pool" && slot.contributed !== true) ||
+          !same(slot.definition ?? null, identity.definition)
+        )
+          missing.push(
+            `active ${identity.lab} requirement is not the canonical ${target.kind === "pool" ? "contributed " : ""}app-scoped many slot`,
+          );
+      }
+      if (target.kind === "pool") {
+        const legacy = record(slots?.subscriptions);
+        if (
+          target.providers.size !== 1 ||
+          typeof legacy?.provider !== "string" ||
+          !target.providers.has(legacy.provider) ||
+          legacy.scope !== "app" ||
+          legacy.cardinality !== "many"
+        )
+          missing.push(
+            "active legacy subscriptions requirement is missing or differs from the selected provider",
+          );
+      }
+      checks.push({
+        app: target.app,
+        kind: target.kind,
+        expectedVersions: [...target.versions].sort(),
+        activeVersion: active,
+        missing,
+      });
+    }
+    return { ready: checks.every((check) => check.missing.length === 0), checks };
+  });
