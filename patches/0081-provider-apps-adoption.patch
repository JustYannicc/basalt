--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/production-ops/migrations/provider-apps-plan.ts
@@ -0,0 +1,223 @@
+import { Effect } from "effect";
+import type { Change, Json, MigrationPlan } from "../contracts.ts";
+import {
+  canonical,
+  failure,
+  hash,
+  migrationName,
+  migrationRevision,
+  record,
+  refuse,
+  rowHash,
+  same,
+  type Row,
+} from "./provider-apps-schema.ts";
+import type { ProviderAppsSnapshot } from "./provider-apps-read.ts";
+import { storedKey, storedLink, type StoredRow } from "./provider-apps-rows.ts";
+
+export const stateHash = (rows: readonly StoredRow[]) =>
+  Effect.gen(function* () {
+    const parts = yield* Effect.forEach(
+      [...rows].sort((a, b) => storedKey(a).localeCompare(storedKey(b))),
+      (entry) =>
+        Effect.map(rowHash(entry.row), (sha256) => ({
+          table: entry.table,
+          key: entry.key,
+          sha256,
+        })),
+    );
+    return yield* hash(parts);
+  });
+export const adoptionRevision = (request: ProviderAppsSnapshot["request"], account: string) =>
+  Effect.map(
+    hash({ name: migrationName, revision: migrationRevision, request, account }),
+    (value) => `adopt:${value}`,
+  );
+
+/** Private rows exist only in memory. The public plan carries exact keys and hashes. */
+export const planProviderApps = (snapshot: ProviderAppsSnapshot) =>
+  Effect.gen(function* () {
+    const { request } = snapshot;
+    const after = new Map(snapshot.stored.map((entry) => [storedKey(entry), entry]));
+    const mutations: Array<{ before: StoredRow | undefined; after: StoredRow | undefined }> = [];
+    const replace = (entry: StoredRow, row: Row) => {
+      const updated = { ...entry, row };
+      mutations.push({ before: entry, after: updated });
+      after.set(storedKey(updated), updated);
+    };
+    const insert = (entry: StoredRow) => {
+      if (after.has(storedKey(entry)))
+        throw failure("Provider adoption plan contains a duplicate destination");
+      mutations.push({ before: undefined, after: entry });
+      after.set(storedKey(entry), entry);
+    };
+    const find = (table: string, key: Readonly<Record<string, string | null>>) =>
+      after.get(storedKey({ table, key }))!;
+    for (const item of snapshot.accounts) {
+      const { input, account, acquisition } = item;
+      const identity = snapshot.identities.find((entry) => entry.lab === input.lab)!;
+      const revision = yield* adoptionRevision(request, input.account);
+      const native: Row = {
+        account: input.account,
+        owner: account.owner!,
+        provider: identity.identity,
+        method: identity.method,
+        driver: "basalt-home",
+        driver_revision: "oauth-v1",
+        generation: input.generation,
+        revision,
+        removal: null,
+        mirror_reference: null,
+        mirror_ready: true,
+        mirror_operation: null,
+      };
+      const applied = acquisition !== undefined;
+      if (applied) {
+        if (
+          !same(acquisition, native) ||
+          account.provider !== identity.identity ||
+          account.method !== identity.method
+        )
+          return yield* refuse("an existing acquisition is not this exact migration result");
+      } else {
+        if (
+          account.provider !== input.provider ||
+          account.method !== input.method ||
+          typeof account.encrypted_credentials !== "string" ||
+          account.encrypted_credentials.length === 0
+        )
+          return yield* refuse("source account no longer matches its expected provider and method");
+        replace(find("executor_accounts", { id: input.account }), {
+          ...account,
+          provider: identity.identity,
+          method: identity.method,
+        });
+        insert({
+          table: "executor_account_acquisitions",
+          key: { account: input.account },
+          row: native,
+        });
+      }
+      let retained = 0;
+      const references = new Set<string>();
+      for (const connection of item.connections) {
+        const state = record(connection.state);
+        if (state?.status !== "completed" || record(state.account)?.id !== input.account) continue;
+        const binding = record(state.interactive);
+        const archived = record(state.providerAppAdoption);
+        if (applied) {
+          if (
+            binding !== undefined ||
+            archived?.migration !== migrationName ||
+            archived.revision !== revision ||
+            record(archived.provenance)?.method !== input.method ||
+            connection.provider !== identity.identity
+          )
+            return yield* refuse("completed provenance differs from this migration");
+          retained++;
+          continue;
+        }
+        if (
+          binding === undefined ||
+          binding.method !== input.method ||
+          typeof binding.ref !== "string" ||
+          binding.ref.length === 0 ||
+          binding.retirement !== undefined ||
+          !input.links.some(
+            (link) => link.app === binding.app && link.requirement === binding.slot,
+          ) ||
+          connection.provider !== input.provider ||
+          record(state.account)?.provider !== input.provider ||
+          record(state.account)?.method !== input.method ||
+          record(state.account)?.owner !== account.owner
+        )
+          return yield* refuse("legacy acquisition provenance is missing, retired or inconsistent");
+        references.add(binding.ref);
+        retained++;
+        const savedAccount = record(state.account)!;
+        const { interactive: _interactive, ...rest } = state;
+        replace(find("executor_account_connections", { id: String(connection.id) }), {
+          ...connection,
+          provider: identity.identity,
+          revision,
+          state: {
+            ...rest,
+            account: { ...savedAccount, provider: identity.identity, method: identity.method },
+            providerAppAdoption: { migration: migrationName, revision, provenance: binding },
+          },
+        });
+      }
+      if (retained === 0 || (!applied && references.size !== 1))
+        return yield* refuse("no unambiguous completed Home acquisition proves this account");
+      for (const link of input.links) {
+        const old = item.links.filter(
+          (row) =>
+            row.app === link.app &&
+            row.requirement === link.requirement &&
+            row.subject === link.subject,
+        );
+        const existing = item.links.filter(
+          (row) =>
+            row.app === link.app && row.requirement === input.lab && row.subject === link.subject,
+        );
+        if (applied) {
+          if (old.length !== 0 || existing.length !== 1)
+            return yield* refuse("adopted pool link changed");
+          continue;
+        }
+        if (old.length !== 1 || existing.length !== 0 || old[0] === undefined)
+          return yield* refuse("link mapping is missing or its destination is occupied");
+        const before = storedLink(old[0]);
+        const updated = storedLink({ ...old[0], requirement: input.lab });
+        mutations.push({ before, after: undefined }, { before: undefined, after: updated });
+        after.delete(storedKey(before));
+        after.set(storedKey(updated), updated);
+      }
+      const app = request.apps[input.lab];
+      const existing = item.links.filter(
+        (link) => link.app === app && link.requirement === input.lab && link.subject === null,
+      );
+      if (existing.length > 1 || (!applied && existing.length !== 0))
+        return yield* refuse("provider app already has an unexpected legacy link");
+      if (existing.length === 0) {
+        if (applied) return yield* refuse("adopted provider app link was removed");
+        insert(
+          storedLink({
+            app,
+            requirement: input.lab,
+            subject: null,
+            account: input.account,
+            linked_by: request.actor,
+            created_at: request.at,
+          }),
+        );
+      }
+    }
+    const changes: Change[] = yield* Effect.forEach(mutations, ({ before, after: updated }) =>
+      Effect.gen(function* () {
+        const entry = updated ?? before!;
+        return {
+          table: entry.table,
+          key: entry.key,
+          action:
+            before === undefined
+              ? ("insert" as const)
+              : updated === undefined
+                ? ("delete" as const)
+                : ("update" as const),
+          beforeSha256: before === undefined ? null : yield* rowHash(before.row),
+          afterSha256: updated === undefined ? null : yield* rowHash(updated.row),
+        };
+      }),
+    );
+    changes.sort((a, b) => canonical(a).localeCompare(canonical(b)));
+    const data: Json = {
+      name: migrationName,
+      revision: migrationRevision,
+      requestSha256: yield* hash(request),
+      beforeStateSha256: yield* stateHash(snapshot.stored),
+      afterStateSha256: yield* stateHash([...after.values()]),
+      accounts: request.accounts.map(({ account, lab }) => ({ account, lab })),
+    };
+    return { changes, data } satisfies MigrationPlan;
+  });
