+import { expect } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "./actors.ts";
+import { Api, body } from "./api.ts";
+import { Resource } from "./contracts.ts";
+import { appsManifest } from "./apps-release.ts";
+import { cloudLocks } from "./cloud-locks.ts";
+import { providerAppsCatalog } from "./provider-apps-catalog.ts";
+import { settleWebhookSources, removeAppWhenStopped } from "./webhook-sources.ts";
+
+const Saved = Schema.Struct({ state: Schema.Literal("connected"), account: Resource });
+const AccountRows = Schema.Array(
+  Schema.Struct({
+    id: Schema.String,
+    provider: Schema.String,
+    method: Schema.String,
+    credential_generation: Schema.Number,
+  }),
+);
+const Deployment = Schema.Array(Schema.Struct({ active_deployment: Schema.String }));
+const Viewer = Schema.Struct({ userId: Schema.String });
+const poolReference = "https://github.com/JustYannicc/basalt/tree/main/apps/pool";
+
+/** Public sign-in creates encrypted references; only predecessor metadata is seeded in disposable SQL. */
+export const providerAdoptionFixture = Effect.gen(function* () {
+  const api = yield* Api,
+    actors = yield* Actors,
+    database = yield* cloudLocks;
+  const catalog = yield* providerAppsCatalog;
+  const prefix = `/api/organizations/${actors.organization.id}`;
+  const actor = (yield* body(Viewer, yield* api.request(actors.owner, "GET", "/api/viewer")))
+    .userId;
+  const apps: string[] = [],
+    accounts: string[] = [];
+  const migration = "provider-apps-openai-anthropic-v1";
+  const original = yield* database.run({
+    sql: "select metadata from organization where id = $1",
+    params: [actors.organization.id],
+  });
+  yield* Effect.addFinalizer(() =>
+    Effect.gen(function* () {
+      yield* database.run({
+        sql: "delete from private_production_ops_receipts where organization_id = $1 and migration = $2",
+        params: [actors.organization.id, migration],
+      });
+      yield* database.run({
+        sql: "update organization set metadata = $2 where id = $1",
+        params: [
+          actors.organization.id,
+          typeof original[0]?.metadata === "string"
+            ? original[0].metadata
+            : JSON.stringify(original[0]?.metadata ?? {}),
+        ],
+      });
+      for (const app of [...apps].reverse())
+        expect(yield* removeAppWhenStopped(actors.owner, `${prefix}/apps/${app}`)).toBe(200);
+      for (const account of accounts) {
+        const present = yield* api
+          .request(actors.owner, "GET", `${prefix}/inventory`)
+          .pipe(
+            Effect.flatMap((response) =>
+              body(Schema.Struct({ accounts: Schema.Array(Resource) }), response),
+            ),
+          );
+        if (present.accounts.some((row) => row.id === account)) {
+          const removed = yield* api.request(
+            actors.owner,
+            "DELETE",
+            `${prefix}/accounts/${account}`,
+          );
+          expect(removed.status, JSON.stringify(removed.body)).toBe(200);
+        }
+        const after = yield* api
+          .request(actors.owner, "GET", `${prefix}/inventory`)
+          .pipe(
+            Effect.flatMap((response) =>
+              body(Schema.Struct({ accounts: Schema.Array(Resource) }), response),
+            ),
+          );
+        expect(after.accounts).not.toContainEqual(expect.objectContaining({ id: account }));
+      }
+    }).pipe(Effect.orDie),
+  );
+  const deploy = (name: string, files: readonly { path: string; content: string }[]) =>
+    Effect.gen(function* () {
+      const response = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+        name,
+        files,
+      });
+      expect(response.status, JSON.stringify(response.body)).toBe(200);
+      const app = (yield* body(Resource, response)).id;
+      apps.push(app);
+      return app;
+    });
+  const canonical = catalog.sources
+    .get("openai")!
+    .files.find((file) => file.path === "providers.ts")!;
+  const poolFiles = [
+    appsManifest,
+    canonical,
+    {
+      path: "index.ts",
+      content: `import { defineApp, defineProvider, interactive, object, query, router } from "apps";
+import { providers } from "./providers.ts";
+const legacy = defineProvider({ name: "Subscription", auth: {
+  codex: interactive({ label: "ChatGPT subscription" }),
+  claude: interactive({ label: "Claude subscription" })
+} });
+const requirements = { app: { accounts: {
+  subscriptions: legacy.many(), openai: providers.openai.many().contributed(), anthropic: providers.anthropic.many().contributed()
+} } };
+export default defineApp(requirements, {
+  connect: { subscriptions: {
+    start: async (_ctx, input) => ({ session: "synthetic-" + input.method }),
+    status: async (_ctx, input) => ({ state: "connected", ref: "synthetic-private-" + input.method }),
+    cancel: async () => {}, remove: async () => {}
+  } },
+  tools: router({ accounts: query({ input: object({}) }, async (ctx) => ({
+    openai: ctx.app.accounts.openai.map((a) => ({ id: a.id, method: a.method, fields: Object.keys(a.fields) })),
+    anthropic: ctx.app.accounts.anthropic.map((a) => ({ id: a.id, method: a.method, fields: Object.keys(a.fields) }))
+  })) })
+});`,
+    },
+  ];
+  const pool = yield* deploy("Legacy pool prepared for native accounts", poolFiles);
+  const providerApps = { openai: "", anthropic: "" };
+  for (const lab of ["openai", "anthropic"] as const) {
+    providerApps[lab] = yield* deploy(`Adoption ${lab}`, catalog.sources.get(lab)!.files);
+    yield* database.run({
+      sql: "update executor_apps set copied_from = $2::jsonb where id = $1",
+      params: [
+        providerApps[lab],
+        JSON.stringify({
+          name: `provider-${lab}`,
+          reference: `https://catalog.example.test/provider-${lab}`,
+          commit: null,
+        }),
+      ],
+    });
+  }
+  for (const method of ["codex", "claude"]) {
+    const pending = yield* api.request(
+      actors.owner,
+      "POST",
+      `${prefix}/apps/${pool}/accounts/app/subscriptions/connections`,
+      { destination: { kind: "personal" } },
+    );
+    expect(pending.status, JSON.stringify(pending.body)).toBe(200);
+    const connection = (yield* body(Resource, pending)).id;
+    const path = `${prefix}/connections/${connection}/interactive`;
+    const started = yield* api.request(actors.owner, "POST", `${path}/start`, { method });
+    expect(started.status, JSON.stringify(started.body)).toBe(200);
+    const saved = yield* api.request(actors.owner, "GET", `${path}/status`);
+    expect(saved.status, JSON.stringify(saved.body)).toBe(200);
+    accounts.push((yield* body(Saved, saved)).account.id);
+  }
+  const second = yield* deploy("Second prepared legacy pool", poolFiles);
+  yield* settleWebhookSources(
+    actors.owner,
+    `${prefix}/apps/${pool}`,
+    (sources) =>
+      sources.length === 2 &&
+      sources.every((source) => source.status === "ready" && source.failure === null),
+  );
+  for (const app of [pool, second]) {
+    yield* database.run({
+      sql: "update executor_apps set copied_from = $2::jsonb where id = $1",
+      params: [
+        app,
+        JSON.stringify({ reference: poolReference, name: "Prepared pool", commit: null }),
+      ],
+    });
+    yield* database.run({
+      sql: "update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb), '{basaltPools}', coalesce(metadata::jsonb -> 'basaltPools', '{}'::jsonb) || jsonb_build_object($2::text, jsonb_build_object('app', $3::text)))::text where id = $1",
+      params: [actors.organization.id, app, app],
+    });
+  }
+  const versions = new Map<string, string>();
+  for (const app of [pool, second]) {
+    const rows = yield* database
+      .run({ sql: "select active_deployment from executor_apps where id = $1", params: [app] })
+      .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Deployment)));
+    versions.set(app, rows[0]!.active_deployment);
+  }
+  const rows = yield* database
+    .run({
+      sql: "select id,provider,method,credential_generation from executor_accounts where id = any($1::text[]) order by id",
+      params: [`{${accounts.join(",")}}`],
+    })
+    .pipe(Effect.flatMap(Schema.decodeUnknownEffect(AccountRows)));
+  const providerVersions = { openai: "", anthropic: "" };
+  for (const lab of ["openai", "anthropic"] as const) {
+    const rows = yield* database
+      .run({
+        sql: "select active_deployment from executor_apps where id = $1",
+        params: [providerApps[lab]],
+      })
+      .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Deployment)));
+    providerVersions[lab] = rows[0]!.active_deployment;
+  }
+  const request = {
+    organization: actors.organization.id,
+    actor,
+    at: new Date().toISOString(),
+    apps: providerApps,
+    versions: providerVersions,
+    accounts: rows.map((row) => ({
+      account: row.id,
+      lab: row.method === "codex" ? "openai" : "anthropic",
+      provider: row.provider,
+      method: row.method,
+      generation: row.credential_generation,
+      links: [pool].map((app) => ({
+        app,
+        version: versions.get(app)!,
+        requirement: "subscriptions",
+        subject: null,
+      })),
+    })),
+  };
+  const snapshot = database.run({
+    sql: `select
+    (select jsonb_agg(to_jsonb(a) order by id) from executor_accounts a where id = any($1::text[])) as accounts,
+    (select jsonb_agg(to_jsonb(a) order by account_id) from hosted_account_access a where account_id = any($1::text[])) as access,
+    (select jsonb_agg(to_jsonb(a) order by id) from executor_webhook_sources a where account = any($1::text[])) as sources,
+    (select jsonb_agg(to_jsonb(a) order by app,requirement,account) from hosted_app_account_links a where account = any($1::text[])) as links,
+    (select jsonb_agg(to_jsonb(a) order by id) from executor_account_connections a where state -> 'account' ->> 'id' = any($1::text[])) as connections,
+    (select jsonb_agg(to_jsonb(a) order by account) from executor_account_acquisitions a where account = any($1::text[])) as acquisitions`,
+    params: [`{${accounts.join(",")}}`],
+  });
+  return { api, actors, database, prefix, pool, second, request, snapshot };
+});
