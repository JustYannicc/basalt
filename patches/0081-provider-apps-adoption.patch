+++ b/apps/hosted/cloud/src/infrastructure/production-ops/migrations/provider-apps-read.ts
@@ -0,0 +1,284 @@
+import * as BrowserCrypto from "@effect/platform-browser/BrowserCrypto";
+import { providerAccountDefinitions } from "@executor-js/hosted-server/provider-account-definitions";
+import { Effect, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import {
+  failure,
+  record,
+  refuse,
+  same,
+  type ProviderAppsRequest,
+  type Row,
+} from "./provider-apps-schema.ts";
+import { providerAppReader } from "./provider-apps-apps.ts";
+import { requireIdleProviderConsumers } from "./provider-apps-consumers.ts";
+import {
+  decodedRows,
+  definition,
+  one,
+  storedKey,
+  storedLink,
+  type StoredRow,
+} from "./provider-apps-rows.ts";
+
+const poolReference = "https://github.com/JustYannicc/basalt/tree/main/apps/pool";
+
+/** Read-only snapshots are also used after commit; locks belong to the apply path. */
+export const readProviderApps = (request: ProviderAppsRequest) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const identities = yield* providerAccountDefinitions.pipe(Effect.provide(BrowserCrypto.layer));
+    const stored = new Map<string, StoredRow>();
+    const save = (table: string, key: Readonly<Record<string, string | null>>, row: Row) => {
+      const entry = { table, key, row };
+      stored.set(storedKey(entry), entry);
+      return row;
+    };
+    const owner = `organization:${request.organization}`;
+    const org = yield* one(
+      yield* decodedRows(
+        sql`select to_jsonb(o) as row from organization o where id = ${request.organization}`,
+      ),
+      "organization",
+    );
+    save("organization", { id: request.organization }, org);
+    const metadata = yield* Schema.decodeUnknownEffect(Schema.Json)(
+      typeof org.metadata === "string"
+        ? yield* Schema.decodeUnknownEffect(Schema.fromJsonString(Schema.Json))(org.metadata).pipe(
+            Effect.mapError(() => failure("Organization metadata is unreadable")),
+          )
+        : (org.metadata ?? {}),
+    );
+    const poolEntries = Object.values(record(record(metadata)?.basaltPools) ?? {}).flatMap(
+      (value) => (record(value) ? [record(value)!] : []),
+    );
+    const actor = yield* one(
+      yield* decodedRows(sql`select to_jsonb(m) as row from member m
+    where m."organizationId" = ${request.organization} and m."userId" = ${request.actor}`),
+      "actor membership",
+    );
+    if (actor.role !== "owner" && actor.role !== "admin")
+      return yield* refuse("actor must be a current organization owner or admin");
+    save("member", { id: String(actor.id) }, actor);
+
+    const loadApp = yield* providerAppReader(request, save);
+    for (const identity of identities) {
+      const app = yield* loadApp(request.apps[identity.lab]);
+      const policy = record(app.policy)!;
+      if (
+        record(app.copied_from)?.name !== `provider-${identity.lab}` ||
+        policy.audience !== "private" ||
+        policy.creator_id !== request.actor
+      )
+        return yield* refuse("provider app must be the actor's private catalog installation");
+      const slot = record(definition(app)?.[identity.lab]);
+      if (
+        slot?.provider !== identity.identity ||
+        slot.scope !== "app" ||
+        slot.cardinality !== "many" ||
+        !same(slot.definition ?? null, identity.definition)
+      )
+        return yield* refuse("provider app has no exact canonical active requirement");
+      const provider = yield* one(
+        yield* decodedRows(
+          sql`select to_jsonb(p) as row from executor_providers p where id = ${identity.identity}`,
+        ),
+        "canonical provider",
+      );
+      if (!same(provider.definition ?? null, identity.shared))
+        return yield* refuse("canonical provider definition changed");
+      save("executor_providers", { id: identity.identity }, provider);
+    }
+
+    const accounts: Array<{
+      input: ProviderAppsRequest["accounts"][number];
+      account: Row;
+      connections: readonly Row[];
+      links: readonly Row[];
+      acquisition: Row | undefined;
+    }> = [];
+    for (const input of [...request.accounts].sort((a, b) => a.account.localeCompare(b.account))) {
+      const identity = identities.find((entry) => entry.lab === input.lab)!;
+      const account = yield* one(
+        yield* decodedRows(
+          sql`select to_jsonb(a) as row from executor_accounts a where id = ${input.account}`,
+        ),
+        "account",
+      );
+      if (
+        account.owner !== owner ||
+        account.credential_generation !== input.generation ||
+        account.site !== null ||
+        account.oauth_grant_id !== null ||
+        account.identity_id !== null
+      )
+        return yield* refuse(
+          "account ownership, generation or credential kind is not the reviewed legacy binding",
+        );
+      save("executor_accounts", { id: input.account }, account);
+      const access = yield* one(
+        yield* decodedRows(
+          sql`select to_jsonb(p) as row from hosted_account_access p where account_id = ${input.account}`,
+        ),
+        "account access",
+      );
+      // This first migration never adds a route to someone else's private account.
+      if (
+        access.organization_id !== request.organization ||
+        access.kind !== "personal" ||
+        access.personal_user_id !== request.actor
+      )
+        return yield* refuse("account must remain the actor's personal account");
+      save("hosted_account_access", { account_id: input.account }, access);
+      const groups = yield* decodedRows(
+        sql`select to_jsonb(g) as row from hosted_account_groups g where account_id = ${input.account} order by group_id`,
+      );
+      for (const row of groups)
+        save(
+          "hosted_account_groups",
+          { account_id: input.account, group_id: String(row.group_id) },
+          row,
+        );
+      if (groups.length !== 0)
+        return yield* refuse("personal account has inconsistent group grants");
+      const sourceProvider = yield* one(
+        yield* decodedRows(
+          sql`select to_jsonb(p) as row from executor_providers p where id = ${input.provider}`,
+        ),
+        "source provider",
+      );
+      const source = record(sourceProvider.definition);
+      if (
+        source?.name !== "Subscription" ||
+        record(record(source.auth)?.[input.method])?.type !== "interactive"
+      )
+        return yield* refuse("source is not the reviewed legacy subscription method");
+      save("executor_providers", { id: input.provider }, sourceProvider);
+
+      const connections =
+        yield* decodedRows(sql`select to_jsonb(c) as row from executor_account_connections c
+      where c.owner = ${owner} and (c.state -> 'account' ->> 'id' = ${input.account}
+        or c.reconnect_account = ${input.account} or c.source_account = ${input.account}) order by c.id`);
+      for (const row of connections) {
+        if (
+          record(row.state)?.status === "pending" ||
+          row.oauth_attempt !== null ||
+          (Array.isArray(row.additional_targets) && row.additional_targets.length !== 0)
+        )
+          return yield* refuse("account has a pending or batched connection");
+        save("executor_account_connections", { id: String(row.id) }, row);
+      }
+      const links = yield* decodedRows(
+        sql`select to_jsonb(l) as row from hosted_app_account_links l where account = ${input.account} order by app, requirement, subject nulls first`,
+      );
+      for (const row of links) {
+        const entry = storedLink(row);
+        stored.set(storedKey(entry), entry);
+      }
+      for (const link of input.links) {
+        if (
+          link.requirement !== "subscriptions" ||
+          (link.subject !== null && link.subject !== request.actor)
+        )
+          return yield* refuse("only explicit actor-owned legacy subscription links can move");
+        const app = yield* loadApp(link.app);
+        if (
+          app.active_deployment !== link.version ||
+          record(app.copied_from)?.reference !== poolReference
+        )
+          return yield* refuse(
+            "pool source or active deployment differs from the reviewed preparation",
+          );
+        const entries = poolEntries.filter((entry) => entry.app === link.app);
+        if (
+          entries.length !== 1 ||
+          entries.some((entry) => entry.membership === "executor-links-v1")
+        )
+          return yield* refuse("pool preparation must precede native membership activation");
+        const slot = record(definition(app)?.[input.lab]);
+        const legacy = record(definition(app)?.subscriptions);
+        if (
+          slot?.provider !== identity.identity ||
+          slot.scope !== "app" ||
+          slot.cardinality !== "many" ||
+          slot.contributed !== true ||
+          !same(slot.definition ?? null, identity.definition) ||
+          legacy?.provider !== input.provider ||
+          legacy.scope !== "app" ||
+          legacy.cardinality !== "many"
+        )
+          return yield* refuse(
+            "pool is missing compatible canonical and retained legacy requirements",
+          );
+        if (link.subject !== null)
+          return yield* refuse("user-scoped legacy links require a separate migration");
+        const pending =
+          yield* sql`select id from executor_account_connections where owner = ${owner}
+        and target ->> 'app' = ${link.app} and target ->> 'requirement' = ${link.requirement}
+        and (state ->> 'status' = 'pending' or oauth_attempt is not null) limit 1`;
+        if (pending.length !== 0) return yield* refuse("legacy pool sign-in is still in flight");
+      }
+      for (const connection of connections) {
+        const state = record(connection.state);
+        if (state?.status !== "completed" || record(state.account)?.id !== input.account) continue;
+        const provenance =
+          record(state.interactive) ?? record(record(state.providerAppAdoption)?.provenance);
+        const target = record(connection.target);
+        if (
+          provenance === undefined ||
+          typeof provenance.version !== "string" ||
+          target === undefined ||
+          target?.app !== provenance.app ||
+          target.requirement !== provenance.slot ||
+          !input.links.some(
+            (link) => link.app === provenance.app && link.requirement === provenance.slot,
+          )
+        )
+          return yield* refuse("connection provenance has no matching saved target");
+        const historical = yield* one(
+          yield* decodedRows(
+            sql`select to_jsonb(d) as row from executor_deployments d where id = ${provenance.version}`,
+          ),
+          "acquiring deployment",
+        );
+        const requirement = record(
+          record(record(historical.requirements)?.accounts)?.[String(provenance.slot)],
+        );
+        if (
+          historical.owner !== owner ||
+          requirement?.provider !== input.provider ||
+          record(record(record(requirement.definition)?.auth)?.[input.method])?.type !==
+            "interactive"
+        )
+          return yield* refuse("acquiring deployment does not prove the legacy provider method");
+        save("executor_deployments", { id: String(historical.id) }, historical);
+      }
+      for (const row of links) {
+        const isProvider =
+          row.app === request.apps[input.lab] &&
+          row.requirement === input.lab &&
+          row.subject === null;
+        const mapped =
+          typeof row.app === "string" &&
+          input.links.some(
+            (link) =>
+              link.app === row.app &&
+              (row.requirement === link.requirement || row.requirement === input.lab) &&
+              row.subject === link.subject,
+          );
+        if (!isProvider && !mapped)
+          return yield* refuse("account has an unrelated or unmapped link");
+      }
+      const acquisitionRows = yield* decodedRows(
+        sql`select to_jsonb(r) as row from executor_account_acquisitions r where account = ${input.account}`,
+      );
+      if (acquisitionRows.length > 1) return yield* refuse("ambiguous native acquisition");
+      const acquisition = acquisitionRows[0];
+      if (acquisition !== undefined)
+        save("executor_account_acquisitions", { account: input.account }, acquisition);
+      yield* requireIdleProviderConsumers(request, input, save);
+      accounts.push({ input, account, connections, links, acquisition });
+    }
+    return { request, identities, accounts, stored: [...stored.values()] };
+  });
+export type ProviderAppsSnapshot = Effect.Success<ReturnType<typeof readProviderApps>>;
