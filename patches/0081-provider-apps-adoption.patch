+++ b/apps/hosted/cloud/src/infrastructure/production-ops/migrations/provider-apps-openai-anthropic-v1.ts
@@ -0,0 +1,153 @@
+import { Effect } from "effect";
+import { SqlClient } from "effect/sql";
+import type { Json, MigrationPlan, ProductionMigration } from "../contracts.ts";
+import { adoptionRevision, planProviderApps, stateHash } from "./provider-apps-plan.ts";
+import { readProviderApps } from "./provider-apps-read.ts";
+import { providerAppsPrerequisites } from "./provider-apps-prerequisites.ts";
+import {
+  decodeRequest,
+  hash,
+  migrationName,
+  migrationRevision,
+  record,
+  refuse,
+  same,
+  type ProviderAppsRequest,
+} from "./provider-apps-schema.ts";
+
+const inspect = (input: Json) =>
+  Effect.gen(function* () {
+    const request = yield* decodeRequest(input);
+    const prerequisites = yield* providerAppsPrerequisites(request);
+    if (!prerequisites.ready)
+      return {
+        changes: [],
+        data: {
+          name: migrationName,
+          revision: migrationRevision,
+          requestSha256: yield* hash(request),
+          prerequisites,
+        },
+      };
+    const plan = yield* planProviderApps(yield* readProviderApps(request));
+    return { ...plan, data: { ...record(plan.data), prerequisites } };
+  });
+
+/** Match the normal organization/app/account lock order before checking any mutable authority. */
+const lockAuthority = (request: ProviderAppsRequest) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const owner = `organization:${request.organization}`;
+    yield* sql`select pg_advisory_xact_lock(hashtextextended(${`executor-access:${request.organization}`}, 0))`;
+    yield* sql`select id from organization where id = ${request.organization} for share`;
+    yield* sql`select id from member where "organizationId" = ${request.organization} and "userId" = ${request.actor} for share`;
+    const apps = [
+      ...new Set([
+        request.apps.openai,
+        request.apps.anthropic,
+        ...request.accounts.flatMap((item) => item.links.map((link) => link.app)),
+      ]),
+    ].sort();
+    for (const app of apps) {
+      yield* sql`select id from executor_apps where id = ${app} and owner = ${owner} for no key update`;
+      yield* sql`select d.id from executor_deployments d join executor_apps a on a.active_deployment = d.id where a.id = ${app} and a.owner = ${owner} and d.owner = ${owner} for share of d`;
+      yield* sql`select p.id from hosted_app_access p join executor_apps a on a.id = p.id where p.id = ${app} and p.organization_id = ${request.organization} and a.owner = ${owner} for share of p`;
+    }
+  });
+
+const lockAccounts = (request: ProviderAppsRequest) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const owner = `organization:${request.organization}`;
+    for (const item of [...request.accounts].sort((a, b) => a.account.localeCompare(b.account))) {
+      yield* sql`select id from executor_accounts where id = ${item.account} and owner = ${owner} for update`;
+      yield* sql`select p.account_id from hosted_account_access p join executor_accounts a on a.id = p.account_id where p.account_id = ${item.account} and p.organization_id = ${request.organization} and a.owner = ${owner} for share of p`;
+      yield* sql`select r.account from executor_account_acquisitions r join executor_accounts a on a.id = r.account where r.account = ${item.account} and r.owner = ${owner} and a.owner = ${owner} for update of r`;
+      yield* sql`select s.id from executor_webhook_sources s join executor_accounts a on a.id = s.account join executor_apps app on app.id = s.app where s.account = ${item.account} and s.owner = ${owner} and a.owner = ${owner} and app.owner = ${owner} order by s.id for update of s`;
+      yield* sql`select id from executor_account_connections where owner = ${`organization:${request.organization}`}
+      and (state -> 'account' ->> 'id' = ${item.account} or reconnect_account = ${item.account} or source_account = ${item.account}) order by id for update`;
+    }
+  });
+
+const verify = (input: Json, plan: MigrationPlan) =>
+  Effect.gen(function* () {
+    const request = yield* decodeRequest(input);
+    const data = record(plan.data);
+    const prerequisites = yield* providerAppsPrerequisites(request);
+    if (!prerequisites.ready || record(data?.prerequisites)?.ready !== true)
+      return { ok: false, checks: { prerequisitesReady: false } };
+    const requestMatches = data?.requestSha256 === (yield* hash(request));
+    const actual = yield* stateHash((yield* readProviderApps(request)).stored);
+    const stateMatches = data?.afterStateSha256 === actual;
+    return { ok: requestMatches && stateMatches, checks: { requestMatches, stateMatches } };
+  });
+
+export const providerAppsOpenAIAnthropic: ProductionMigration = {
+  name: migrationName,
+  revision: migrationRevision,
+  tables: [
+    "executor_accounts",
+    "executor_account_acquisitions",
+    "executor_account_connections",
+    "hosted_app_account_links",
+  ],
+  inspect,
+  lockAuthority: (input, plan) =>
+    Effect.gen(function* () {
+      if (record(record(plan.data)?.prerequisites)?.ready !== true)
+        return yield* refuse("reviewed plan has blocked prerequisites");
+      const request = yield* decodeRequest(input);
+      yield* lockAuthority(request);
+      if (!(yield* providerAppsPrerequisites(request)).ready)
+        return yield* refuse("provider app or pool prerequisites are missing");
+    }),
+  apply: (input, plan) =>
+    Effect.gen(function* () {
+      const request = yield* decodeRequest(input);
+      const sql = yield* SqlClient.SqlClient;
+      const owner = `organization:${request.organization}`;
+      yield* lockAccounts(request);
+      const prerequisites = yield* providerAppsPrerequisites(request);
+      if (!prerequisites.ready)
+        return yield* refuse("provider app or pool prerequisites are missing");
+      const snapshot = yield* readProviderApps(request);
+      const planned = yield* planProviderApps(snapshot);
+      const current = { ...planned, data: { ...record(planned.data), prerequisites } };
+      if (!same(current, plan)) return yield* refuse("reviewed plan changed under the write locks");
+      if (current.changes.length === 0) return;
+      for (const { input: item, acquisition } of snapshot.accounts) {
+        if (acquisition !== undefined) continue;
+        const identity = snapshot.identities.find((entry) => entry.lab === item.lab)!;
+        const revision = yield* adoptionRevision(request, item.account);
+        const updated =
+          yield* sql`update executor_accounts set provider = ${identity.identity}, method = ${identity.method}
+        where id = ${item.account} and owner = ${owner} and provider = ${item.provider} and method = ${item.method} and credential_generation = ${item.generation} returning id`;
+        if (updated.length !== 1) return yield* refuse("account changed during apply");
+        yield* sql`insert into executor_account_acquisitions
+        (account,owner,provider,method,driver,driver_revision,generation,revision,removal,mirror_reference,mirror_ready,mirror_operation)
+        select a.id, a.owner, ${identity.identity}, ${identity.method},
+          'basalt-home','oauth-v1',${item.generation},${revision},null,null,true,null
+        from executor_accounts a where a.id = ${item.account} and a.owner = ${owner}`;
+        yield* sql`update executor_account_connections set provider = ${identity.identity}, revision = ${revision},
+        state = ((state::jsonb - 'interactive') || jsonb_build_object(
+          'account', (state::jsonb -> 'account') || jsonb_build_object('provider',${identity.identity}::text,'method',${identity.method}::text),
+          'providerAppAdoption',jsonb_build_object('migration',${migrationName}::text,'revision',${revision}::text,'provenance',state -> 'interactive')))::json
+        where owner = ${`organization:${request.organization}`} and state ->> 'status' = 'completed' and state -> 'account' ->> 'id' = ${item.account}`;
+        for (const link of item.links) {
+          const remapped =
+            yield* sql`update hosted_app_account_links l set requirement = ${item.lab}
+          from executor_apps app, executor_accounts a
+          where l.app = ${link.app} and l.requirement = ${link.requirement} and l.subject is null and l.account = ${item.account}
+            and app.id = l.app and app.owner = ${owner} and a.id = l.account and a.owner = ${owner} returning l.account`;
+          if (remapped.length !== 1) return yield* refuse("reviewed link changed during apply");
+        }
+        yield* sql`insert into hosted_app_account_links (app,requirement,subject,account,linked_by,created_at)
+        select app.id, ${item.lab}, null, a.id, ${request.actor}, ${request.at}::timestamptz
+        from executor_apps app, executor_accounts a
+        where app.id = ${request.apps[item.lab]} and app.owner = ${owner} and a.id = ${item.account} and a.owner = ${owner}`;
+      }
+      const result = yield* verify(input, plan);
+      if (!result.ok) return yield* refuse("post-write preservation checks failed");
+    }),
+  verify,
+};
diff --git a/apps/hosted/cloud/src/infrastructure/production-ops/migrations/provider-apps-plan.ts b/apps/hosted/cloud/src/infrastructure/production-ops/migrations/provider-apps-plan.ts
