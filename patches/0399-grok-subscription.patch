diff --git a/e2e/support/grok-subscription-ui.ts b/e2e/support/grok-subscription-ui.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/grok-subscription-ui.ts
@@ -0,0 +1,129 @@
+import { expect } from "@effect/vitest";
+import { Effect } from "effect";
+import { Actors } from "./actors.ts";
+import { Browser } from "./browser.ts";
+import { Evidence } from "./evidence.ts";
+
+export const grokSubscriptionUi = (input: {
+  app: string;
+  width: number;
+  legacy: Effect.Effect<void>;
+  code: Effect.Effect<void>;
+  device: Effect.Effect<void>;
+  complete: Effect.Effect<void>;
+}) =>
+  Effect.gen(function* () {
+    const actors = yield* Actors,
+      browser = yield* Browser,
+      evidence = yield* Evidence;
+    const width = input.width;
+    yield* browser.login(actors.owner);
+    yield* browser.use("Set the xAI account viewport", (page) =>
+      page.setViewportSize({ width, height: 900 }),
+    );
+    yield* browser.use("Open xAI Accounts", (page) =>
+      page.goto(`/org/${actors.organization.slug}/apps/${input.app}?view=accounts`),
+    );
+    const connect = Effect.gen(function* () {
+      yield* browser.use("Connect a Grok subscription", (page) =>
+        page.getByRole("button", { name: "Connect new account", exact: true }).click(),
+      );
+      yield* browser.use("Open sign-in methods", (page) =>
+        page.getByRole("dialog").getByRole("combobox").click(),
+      );
+      yield* browser.use("Choose Grok subscription", (page) =>
+        page.getByRole("option", { name: "Grok subscription", exact: true }).click(),
+      );
+      yield* browser.use("Start Grok sign-in", (page) =>
+        page
+          .getByRole("dialog")
+          .getByRole("button", { name: "Sign in with Grok subscription", exact: true })
+          .click(),
+      );
+    });
+    const keepName = Effect.gen(function* () {
+      yield* browser.use("The saved account asks for a name", (page) =>
+        page.getByRole("dialog", { name: "Name this account" }).waitFor(),
+      );
+      yield* browser.use("Keep its name", (page) => page.keyboard.press("Escape"));
+    });
+    // A retained pre-upgrade prompt supplies the before image with synthetic accounts.
+    yield* input.legacy;
+    yield* connect;
+    yield* browser.use("The retained prompt asks for a callback", (page) =>
+      page.getByRole("dialog").getByLabel("Callback URL").waitFor(),
+    );
+    yield* evidence.attach(
+      `grok-before-${width}.png`,
+      "image/png",
+      yield* browser.use("Capture the old prompt", (page) => page.screenshot()),
+    );
+    yield* browser.use("Leave the old attempt", (page) => page.keyboard.press("Escape"));
+    yield* browser.use("The old dialog closed", (page) =>
+      page.getByRole("dialog").waitFor({ state: "detached" }),
+    );
+
+    yield* input.code;
+    yield* connect;
+    yield* browser.use("Paste the consent address by mistake", (page) =>
+      page
+        .getByRole("dialog")
+        .getByLabel("Paste the code xAI shows you")
+        .fill("https://accounts.x.ai/oauth2/consent?response_type=code"),
+    );
+    yield* browser.use("Submit the wrong paste", (page) =>
+      page.getByRole("dialog").getByRole("button", { name: "Connect", exact: true }).click(),
+    );
+    yield* browser.use("The error explains which code to copy", (page) =>
+      page
+        .getByRole("dialog")
+        .getByText(/The consent page address does not contain a code/)
+        .waitFor(),
+    );
+    expect(
+      yield* browser.use("The rejected paste is still editable", (page) =>
+        page.getByRole("dialog").getByLabel("Paste the code xAI shows you").inputValue(),
+      ),
+    ).toContain("/consent");
+    yield* evidence.attach(
+      `grok-correctable-${width}.png`,
+      "image/png",
+      yield* browser.use("Capture the correctable input error", (page) => page.screenshot()),
+    );
+    yield* browser.use("Correct the code in the same dialog", (page) =>
+      page
+        .getByRole("dialog")
+        .getByLabel("Paste the code xAI shows you")
+        .fill("synthetic-callback"),
+    );
+    yield* browser.use("Connect with the corrected code", (page) =>
+      page.getByRole("dialog").getByRole("button", { name: "Connect", exact: true }).click(),
+    );
+    yield* keepName;
+
+    yield* input.device;
+    yield* connect;
+    yield* browser.use("Device sign-in shows the code to enter", (page) =>
+      page.getByRole("dialog").getByText("USER-CODE", { exact: true }).waitFor(),
+    );
+    expect(
+      yield* browser.use("Device sign-in asks for no pasted callback", (page) =>
+        page.getByRole("dialog").getByRole("textbox").count(),
+      ),
+    ).toBe(0);
+    expect(
+      yield* browser.use("The button opens device verification", (page) =>
+        page
+          .getByRole("dialog")
+          .getByRole("link", { name: "Open Grok subscription" })
+          .getAttribute("href"),
+      ),
+    ).toBe("https://accounts.x.ai/oauth2/device");
+    yield* evidence.attach(
+      `grok-after-${width}.png`,
+      "image/png",
+      yield* browser.use("Capture device sign-in", (page) => page.screenshot()),
+    );
+    yield* input.complete;
+    yield* keepName;
+  });
diff --git a/e2e/tests/grok-subscription.spec.ts b/e2e/tests/grok-subscription.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/grok-subscription.spec.ts
@@ -0,0 +1,63 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { providerAccountProduct } from "../support/provider-account-product.ts";
+import { providerAppsCatalog } from "../support/provider-apps-catalog.ts";
+import { grokSubscriptionUi } from "../support/grok-subscription-ui.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Links = Schema.Array(Schema.Struct({ account: Resource }));
+
+layer(HostedLive, { excludeTestServices: true })("Grok subscription", (it) => {
+  for (const [scenario, width] of [
+    [scenarios.grokSubscriptionDesktop, 1280],
+    [scenarios.grokSubscriptionMobile, 390],
+  ] as const) {
+    it.effect(scenario.title, (context) =>
+      withHostedCase(
+        context,
+        Effect.gen(function* () {
+          const api = yield* Api,
+            actors = yield* Actors;
+          const catalog = yield* providerAppsCatalog;
+          const prefix = `/api/organizations/${actors.organization.id}`;
+          yield* providerAccountProduct(catalog.origin, `${catalog.origin}/catalog/index.json`);
+          const installed = yield* api.request(actors.owner, "POST", `${prefix}/apps/install`, {
+            entry: "provider-xai",
+            name: "xAI",
+          });
+          expect(installed.status, JSON.stringify(installed.body)).toBe(200);
+          const app = (yield* body(Resource, installed)).id;
+          const appPath = `${prefix}/apps/${app}`;
+          yield* Effect.addFinalizer(() =>
+            Effect.gen(function* () {
+              const links = yield* body(
+                Links,
+                yield* api.request(actors.owner, "GET", `${appPath}/accounts/app`),
+              );
+              yield* api.request(actors.owner, "DELETE", appPath);
+              for (const link of links)
+                yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${link.account.id}`);
+            }).pipe(Effect.orDie),
+          );
+          yield* grokSubscriptionUi({
+            app,
+            width,
+            legacy: catalog.xaiFlow("legacy"),
+            code: catalog.xaiFlow("code"),
+            device: catalog.xaiFlow("device"),
+            complete: catalog.completeXai,
+          });
+          const links = yield* body(
+            Links,
+            yield* api.request(actors.owner, "GET", `${appPath}/accounts/app`),
+          );
+          expect(new Set(links.map((link) => link.account.id)).size).toBe(2);
+        }),
+      ),
+    );
+  }
+});
