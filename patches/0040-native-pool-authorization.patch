@@ -0,0 +1,36 @@
+import { withOrganizationAccessLock } from "@executor-js/hosted-server/pool-access-hook";
+import { Effect, Option, Schema } from "effect";
+
+const target = Schema.Struct({ organizationId: Schema.NonEmptyString });
+const membershipWrites = ["update-member-role", "remove-member", "leave"];
+
+/** The host lends its locked transaction through the entire native membership write. */
+export const withOrganizationAccessRequest = <A, E, R>(
+  request: Request,
+  operation: (transaction: boolean) => Effect.Effect<A, E, R>,
+) =>
+  Effect.gen(function* () {
+    const path = new URL(request.url).pathname;
+    if (
+      request.method !== "POST" ||
+      !membershipWrites.some((name) => path.endsWith(`/organization/${name}`))
+    )
+      return yield* operation(false);
+    const body = yield* Effect.tryPromise(async () => {
+      const copy = request.clone();
+      const type = copy.headers.get("content-type")?.toLowerCase() ?? "";
+      // Native auth accepts JSON and forms. Each encoding must take the same transaction path.
+      return type.includes("application/x-www-form-urlencoded") ||
+        type.includes("multipart/form-data")
+        ? Object.fromEntries(await copy.formData())
+        : copy.json();
+    }).pipe(Effect.catch(() => Effect.succeed(undefined)));
+    const decoded = Schema.decodeUnknownOption(target)(body);
+    if (Option.isNone(decoded)) return yield* operation(false);
+    // Auth's explicit-target guard validates this same organization before any membership write.
+    // Native Promise work can finish after its caller disconnects. Keep the lock until it settles.
+    return yield* withOrganizationAccessLock(
+      decoded.value.organizationId,
+      operation(true).pipe(Effect.uninterruptible),
+    );
+  });
