@@ -0,0 +1,56 @@
+import { AppId, StorageError } from "@executor-js/sdk/core";
+import { Effect, Schema } from "effect";
+import { Principal } from "../contracts/auth.ts";
+import { GroupMemberId } from "../contracts/groups.ts";
+import { OrganizationId, OrganizationRole } from "../contracts/organization.ts";
+import { AppPolicy, appAccessOf } from "./app-policy.ts";
+import { policyDatabase } from "./resource-policy.ts";
+
+const MemberPolicy = Schema.Struct({
+  ...AppPolicy.fields,
+  member: GroupMemberId,
+  user: Principal.fields.userId,
+  role: OrganizationRole,
+});
+
+/** External access projections use the same decision as an authenticated app request. */
+export const applicationAudiences = (
+  organization: OrganizationId,
+  apps: readonly AppId[],
+  removing?: GroupMemberId,
+  changing?: { readonly member: GroupMemberId; readonly role: typeof OrganizationRole.Type },
+) =>
+  Effect.gen(function* () {
+    if (apps.length === 0) return [];
+    const sql = yield* policyDatabase;
+    const rows = yield* sql`select p.id as app, p.creator_id as creator, p.audience, p.revision,
+      array(select g.group_id from hosted_app_groups g where g.app_id = p.id order by g.group_id) as groups,
+      m.id as member, m."userId" as "user", m.role,
+      exists(select 1 from hosted_app_groups g
+        join hosted_group_members gm on gm.group_id = g.group_id
+        where g.app_id = p.id and gm.member_id = m.id) as granted
+      from hosted_app_access p
+      join member m on m."organizationId" = p.organization_id
+      where p.organization_id = ${organization} and ${sql.in("p.id", apps)}
+        and m.id is distinct from ${removing ?? null}
+      order by p.id, m."userId"`;
+    const policies = yield* Schema.decodeUnknownEffect(Schema.Array(MemberPolicy))(rows);
+    return apps.map((app) => {
+      const users: string[] = [];
+      const managers: string[] = [];
+      for (const policy of policies) {
+        if (policy.app !== app) continue;
+        const access = appAccessOf(policy, {
+          organization,
+          user: policy.user,
+          member: policy.member,
+          role: policy.member === changing?.member ? changing.role : policy.role,
+        });
+        if (access.canUse) users.push(policy.user);
+        if (access.canManage) managers.push(policy.user);
+      }
+      return { app, users, managers };
+    });
+  }).pipe(
+    Effect.catchTags({ SqlError: () => new StorageError(), SchemaError: () => new StorageError() }),
+  );
