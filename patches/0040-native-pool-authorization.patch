@@ -0,0 +1,20 @@
+import { Effect } from "effect";
+import { SqlClient } from "effect/sql";
+
+/** Hold before membership row locks and until the corresponding projection is acknowledged. */
+export const lockOrganizationAccess = (organization: string) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    yield* sql`select pg_advisory_xact_lock(hashtextextended(${`executor-access:${organization}`}, 0))`;
+  });
+
+export const withOrganizationAccessLock = <A, E, R>(
+  organization: string,
+  operation: Effect.Effect<A, E, R>,
+) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    return yield* sql.withTransaction(
+      lockOrganizationAccess(organization).pipe(Effect.andThen(operation)),
+    );
+  });
