@@ -0,0 +1,33 @@
+/** Common questions produce ordinary editable MCP forms with the same answer validation. */
+import type { FormElicitation } from "../contracts/elicitation.ts";
+import type { WorkflowInputDisplay, WorkflowInputLink } from "../contracts/workflow-input.ts";
+
+const question = (
+  kind: Exclude<WorkflowInputDisplay["kind"], "mcp-app">,
+  message: string,
+  requestedSchema: FormElicitation["requestedSchema"],
+) => ({
+  form: { mode: "form" as const, message, requestedSchema },
+  display: { kind },
+});
+const empty = { type: "object" as const, properties: {} };
+const field = (value: FormElicitation["requestedSchema"]["properties"][string]) => ({
+  type: "object" as const,
+  properties: { value },
+  required: ["value"],
+});
+
+/** Replies use content.value; confirm/reconnect use the standard accept/decline/cancel action. */
+export const workflowInputQuestions = {
+  text: (message: string) => question("text", message, field({ type: "string" })),
+  choice: (message: string, choices: readonly [string, ...string[]]) =>
+    question("choice", message, field({ type: "string", enum: [...choices] })),
+  confirm: (message: string) => question("confirm", message, empty),
+  number: (message: string) => question("number", message, field({ type: "number" })),
+  date: (message: string) => question("date", message, field({ type: "string", format: "date" })),
+  // Acknowledgement asks the workflow to recheck. It cannot establish that reconnection succeeded.
+  reconnectAccount: (message: string, link: WorkflowInputLink) => ({
+    ...question("reconnect-account", message, empty),
+    links: [link],
+  }),
+};
