+
+const sameText = (left: string, right: string) =>
+  left.trim().toLowerCase() === right.trim().toLowerCase();
+
+const addressShaped = /^[^\s@]+@[^\s@]+\.[^\s@]+$/u;
+
+/** Whether `text` names `address` as a whole address, not as part of a longer one. */
+const namesAddress = (text: string, address: string) => {
+  const exact = address.trim();
+  if (!addressShaped.test(exact)) return false;
+  const escaped = exact.replace(/[.*+?^${}()|[\]\\]/gu, "\\$&");
+  return new RegExp(`(?:^|[^\\w.%+-])${escaped}(?:$|[^\\w.-]|\\.(?:$|\\s))`, "iu").test(text);
+};
+
+/**
+ * The label and description to keep when a reconnect verifies another identity than the account
+ * had. A label equal to the replaced identity's address or name, or a "Default" one, was derived
+ * from it and follows the new identity; a label the person typed stays. A description naming the
+ * replaced address is cleared. Only changed fields are returned.
+ */
+const replacedIdentityMetadata = (
+  account: { readonly label: string; readonly description: string | null },
+  replaced: { readonly label: string; readonly name: string },
+  label: string,
+) => {
+  const derived =
+    sameText(account.label, replaced.label) ||
+    sameText(account.label, replaced.name) ||
+    /^default(?: account| \d+)?$/iu.test(account.label);
+  const namesReplaced =
+    account.description !== null && namesAddress(account.description, replaced.label);
+  return {
+    ...(derived && !sameText(account.label, label) ? { label } : {}),
+    ...(namesReplaced ? { description: null } : {}),
+  };
+};
