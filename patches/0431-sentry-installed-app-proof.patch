+++ b/e2e/tests/sentry-both.spec.ts
@@ -0,0 +1,332 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { FetchHttpClient, HttpClient } from "effect/http";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { connectionsPath } from "../support/app-accounts.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { Evidence } from "../support/evidence.ts";
+import { nameConnectedAccount } from "../support/name-account.ts";
+import { oauthSetupIssuer } from "../support/oauth-setup-issuer.ts";
+import { serverControl } from "../support/server-control.ts";
+import { sentryCatalog } from "../support/sentry-catalog.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Redirect = Schema.Struct({ authorizationUrl: Schema.String, redirectUri: Schema.String });
+const Tools = Schema.Struct({ items: Schema.Array(Schema.Struct({ name: Schema.String })) });
+
+layer(HostedLive, { excludeTestServices: true })("Sentry MCP and API", (it) => {
+  for (const [scenario, width] of [
+    [scenarios.sentryBothDesktop, 1280],
+    [scenarios.sentryBothPhone, 390],
+  ] as const)
+    it.effect(scenario.title, (context) =>
+      withHostedCase(
+        context,
+        Effect.gen(function* () {
+          const api = yield* Api,
+            actors = yield* Actors,
+            browser = yield* Browser,
+            evidence = yield* Evidence,
+            http = yield* HttpClient.HttpClient,
+            issuer = yield* oauthSetupIssuer;
+          const catalog = yield* sentryCatalog(issuer.origin);
+          yield* serverControl("stop");
+          yield* serverControl("environment", 200, { EXECUTOR_CATALOG_URL: catalog.url });
+          yield* serverControl("start");
+          const prefix = `/api/organizations/${actors.organization.id}`;
+          const installed = yield* api.request(actors.owner, "POST", `${prefix}/apps/install`, {
+            entry: "sentry",
+            name: `Sentry ${width}`,
+          });
+          expect(installed.status, JSON.stringify(installed.body)).toBe(200);
+          const app = yield* body(Resource, installed),
+            path = `${prefix}/apps/${app.id}`;
+          const accounts: string[] = [];
+          yield* Effect.addFinalizer(() =>
+            Effect.gen(function* () {
+              expect((yield* api.request(actors.owner, "DELETE", path)).status).toBe(200);
+              for (const account of accounts)
+                expect(
+                  (yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`))
+                    .status,
+                ).toBe(200);
+            }).pipe(Effect.orDie),
+          );
+          const connection = yield* body(
+            Resource,
+            yield* api.request(actors.owner, "POST", connectionsPath(path, "user", "sentry"), {}),
+          );
+          const started = yield* api.request(
+            actors.owner,
+            "POST",
+            `${prefix}/connections/${connection.id}/oauth/start`,
+            { method: "oauth" },
+          );
+          expect(started.status, JSON.stringify(started.body)).toBe(200);
+          const redirect = yield* body(Redirect, started);
+          expect((yield* issuer.metrics).registrations).toBeGreaterThan(0);
+          const callbackUrl = yield* Effect.scoped(
+            Effect.gen(function* () {
+              const consent = yield* HttpClient.withScope(http).get(redirect.authorizationUrl);
+              expect(consent.status).toBe(302);
+              if (consent.headers.location === undefined)
+                return yield* Effect.die("Missing callback");
+              return consent.headers.location;
+            }),
+          ).pipe(Effect.provideService(FetchHttpClient.RequestInit, { redirect: "manual" }));
+          const completed = yield* api.request(
+            actors.owner,
+            "POST",
+            `${prefix}/connections/${connection.id}/oauth/complete`,
+            { callbackUrl },
+          );
+          expect(completed.status, JSON.stringify(completed.body)).toBe(200);
+          accounts.push((yield* body(Resource, completed)).id);
+          const before = yield* body(
+            Tools,
+            yield* api.request(actors.owner, "GET", `${path}/tools/index`),
+          );
+          expect(before.items.map((tool) => tool.name)).toEqual(["mcp.read", "mcp.write"]);
+          yield* browser.login(actors.owner);
+          yield* browser.use("Open OAuth-only tools", (page) =>
+            page
+              .setViewportSize({ width, height: 900 })
+              .then(() => page.goto(`/org/${actors.organization.slug}/apps/${app.id}?view=tools`))
+              .then(() => page.getByRole("button", { name: "Add token", exact: true }).waitFor()),
+          );
+          yield* browser.use("Wait for the missing-section action to be ready", (page) =>
+            page.getByRole("button", { name: "Add token", exact: true }).click({ trial: true }),
+          );
+          yield* browser.checkpoint(`OAuth-only tool sections ${width}`);
+          expect(
+            yield* browser.use("Missing API section remains visible", (page) =>
+              page.getByRole("region", { name: "Sentry API", exact: true }).count(),
+            ),
+          ).toBe(1);
+          yield* browser.use("One click opens the token method", (page) =>
+            page.getByRole("button", { name: "Add token", exact: true }).click(),
+          );
+          const dialog = yield* browser.use(
+            "Normal account form opens with token selected",
+            (page) => {
+              const dialog = page.getByRole("dialog", {
+                name: "Connect Sentry",
+                exact: true,
+              });
+              return dialog
+                .getByLabel("Personal token", { exact: true })
+                .waitFor()
+                .then(() => dialog);
+            },
+          );
+          expect(
+            yield* browser.use("Shared token steps are visible", () => dialog.innerText()),
+          ).toContain(
+            "In Sentry, open User settings > Personal Tokens and choose Create New Token.",
+          );
+          expect(
+            yield* browser.use("Shared scope guidance is visible", () => dialog.innerText()),
+          ).toContain("org:read, project:write, team:write, event:write, and alerts:write");
+          expect(
+            yield* browser.use("Shared token guidance links to Sentry", () =>
+              dialog
+                .getByRole("link", {
+                  name: "Open Sentry Personal Tokens",
+                  exact: true,
+                })
+                .getAttribute("href"),
+            ),
+          ).toBe("https://sentry.io/settings/account/api/auth-tokens/");
+          expect(
+            yield* browser.use("Token guidance fits the phone and desktop", (page) =>
+              page.evaluate(() => {
+                const dialog = document.querySelector('[role="dialog"]');
+                return (
+                  document.documentElement.scrollWidth <= window.innerWidth &&
+                  dialog !== null &&
+                  dialog.scrollWidth <= dialog.clientWidth
+                );
+              }),
+            ),
+          ).toBe(true);
+          expect(
+            yield* browser.use("Token coverage is stated in the normal form", () =>
+              dialog.innerText(),
+            ),
+          ).toContain("A personal token provides Sentry MCP and Sentry API tools.");
+          yield* browser.use("Choose sign-in for MCP tools without starting authorization", () =>
+            dialog
+              .getByRole("button", { name: "Sign in for MCP tools", exact: true })
+              .click()
+              .then(() =>
+                dialog
+                  .getByText(
+                    "Sentry MCP tools through Sentry sign-in. The REST API needs a personal token.",
+                    { exact: true },
+                  )
+                  .waitFor(),
+              ),
+          );
+          expect(
+            yield* browser.use("OAuth coverage is stated before sign-in", () => dialog.innerText()),
+          ).toContain(
+            "Sentry MCP tools through Sentry sign-in. The REST API needs a personal token.",
+          );
+          yield* browser.checkpoint(`Sentry sign-in coverage ${width}`);
+          yield* browser.use("Choose a personal token for both tool sections", () =>
+            dialog
+              .getByRole("button", { name: "Use a personal token for MCP and API", exact: true })
+              .click()
+              .then(() => dialog.getByLabel("Personal token", { exact: true }).waitFor()),
+          );
+          yield* browser.use("Set Sentry region", () =>
+            dialog.getByLabel("Region", { exact: true }).fill("us"),
+          );
+          yield* browser.checkpoint(`Missing-section connection form ${width}`);
+          yield* browser.use("Cancel preserves the OAuth account", (page) =>
+            page.keyboard.press("Escape").then(() => dialog.waitFor({ state: "hidden" })),
+          );
+          expect(
+            yield* browser.use("Cancel restores focus to Add token", (page) =>
+              page
+                .waitForFunction(() => document.activeElement?.textContent === "Add token")
+                .then(() => page.evaluate(() => document.activeElement?.textContent)),
+            ),
+          ).toBe("Add token");
+          expect(
+            (yield* body(Tools, yield* api.request(actors.owner, "GET", `${path}/tools/index`)))
+              .items,
+          ).toEqual(before.items);
+          yield* browser.use("Open token form again", (page) =>
+            page.getByRole("button", { name: "Add token", exact: true }).click(),
+          );
+          yield* browser.use("Set the token region", () =>
+            dialog.getByLabel("Region", { exact: true }).fill("us"),
+          );
+          yield* browser.use("Validate a synthetic personal token", () =>
+            dialog
+              .getByLabel("Personal token", { exact: true })
+              .fill("synthetic-sentry-personal")
+              .then(() =>
+                dialog.getByRole("button", { name: "Validate Auth token", exact: true }).click(),
+              )
+              .then(() => dialog.getByRole("button", { name: "Continue", exact: true }).waitFor()),
+          );
+          yield* browser.use("Connect a synthetic personal token", (page) =>
+            dialog
+              .getByLabel("Personal token", { exact: true })
+              .fill("synthetic-sentry-personal")
+              .then(() =>
+                Promise.all([
+                  page.waitForResponse(
+                    (response) =>
+                      response.request().method() === "POST" &&
+                      new URL(response.url()).pathname === `${path}/accounts/user/sentry`,
+                  ),
+                  dialog.getByRole("button", { name: "Continue", exact: true }).click(),
+                ])
+                  .then(([response]) => response.json())
+                  .then((value) => {
+                    accounts.push(Schema.decodeUnknownSync(Resource)(value).id);
+                  }),
+              ),
+          );
+          yield* browser.use("Name the saved token", (page) =>
+            nameConnectedAccount(page, "API token"),
+          );
+          yield* browser.use("Token connection refreshes both sections", (page) =>
+            page
+              .getByRole("region", { name: "Sentry API", exact: true })
+              .waitFor({ state: "hidden" }),
+          );
+          const after = yield* body(
+            Tools,
+            yield* api.request(actors.owner, "GET", `${path}/tools/index`),
+          );
+          expect(after.items.map((tool) => tool.name).sort()).toEqual([
+            "api.read.getRead",
+            "api.write.postWrite",
+            "mcp.read",
+            "mcp.write",
+          ]);
+          for (const tool of after.items.filter((tool) =>
+            ["mcp.read", "api.read.getRead"].includes(tool.name),
+          )) {
+            const called = yield* api.request(actors.owner, "POST", `${path}/tools/call`, {
+              tool: tool.name,
+              kind: "query",
+              input: { accountId: accounts[1], input: {} },
+            });
+            expect(called.status, JSON.stringify(called.body)).toBe(200);
+            expect(JSON.stringify(called.body)).toContain(
+              tool.name === "api.read.getRead" ? '"region":"us"' : "read through MCP",
+            );
+          }
+          expect(
+            catalog.calls.some(
+              (call) =>
+                call.transport === "mcp" &&
+                call.method === "tools/call" &&
+                call.scheme === "Sentry-Bearer" &&
+                call.token === "personal",
+            ),
+          ).toBe(true);
+          expect(
+            catalog.calls.some(
+              (call) =>
+                call.transport === "mcp" && call.scheme === "Bearer" && call.token === "oauth",
+            ),
+          ).toBe(true);
+          expect(
+            catalog.calls
+              .filter((call) => call.transport === "api")
+              .every((call) => call.scheme === "Bearer" && call.token === "personal"),
+          ).toBe(true);
+          for (const tool of ["mcp.write", "api.write.postWrite"]) {
+            const callsBefore = catalog.calls.filter(
+              (call) => call.method === "tools/call" || call.method === "POST",
+            ).length;
+            const paused = yield* api.request(actors.owner, "POST", `${path}/tools/run`, {
+              tool,
+              kind: "mutation",
+              input: { accountId: accounts[1], input: {} },
+            });
+            expect(paused.status, JSON.stringify(paused.body)).toBe(200);
+            expect(paused.body).toMatchObject({ status: "approval-required" });
+            expect(
+              catalog.calls.filter((call) => call.method === "tools/call" || call.method === "POST")
+                .length,
+            ).toBe(callsBefore);
+          }
+          yield* evidence.json(`sentry-peer-calls-${width}.json`, catalog.calls);
+          yield* browser.checkpoint(`Both tool sections ${width}`);
+          expect(
+            yield* browser.use("No page overflow", (page) =>
+              page.evaluate(() => document.documentElement.scrollWidth > innerWidth),
+            ),
+          ).toBe(false);
+          expect(
+            (yield* api.request(
+              actors.owner,
+              "DELETE",
+              `${path}/accounts/user/sentry/${accounts[1]}`,
+            )).status,
+          ).toBe(200);
+          yield* browser.use("Return after token unlink", (page) =>
+            page
+              .reload()
+              .then(() => page.getByRole("button", { name: "Add token", exact: true }).waitFor()),
+          );
+          const remaining = yield* body(
+            Tools,
+            yield* api.request(actors.owner, "GET", `${path}/tools/index`),
+          );
+          expect(remaining.items.map((tool) => tool.name)).toEqual(["mcp.read", "mcp.write"]);
+          yield* browser.checkpoint(`Unlink restores API guidance ${width}`);
+        }),
+      ),
+    );
+});
diff --git a/e2e/tests/sentry-regional.spec.ts b/e2e/tests/sentry-regional.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/sentry-regional.spec.ts
@@ -0,0 +1,147 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { oauthSetupIssuer } from "../support/oauth-setup-issuer.ts";
+import { serverControl } from "../support/server-control.ts";
+import { Evidence } from "../support/evidence.ts";
+import { connectSentryToken } from "../support/sentry-account.ts";
+import { sentryCatalog } from "../support/sentry-catalog.ts";
+import { scenarios } from "../test-plan.ts";
+
+const App = Schema.Struct({
+  id: Schema.String,
+  requirements: Schema.Struct({
+    accounts: Schema.Record(Schema.String, Schema.Struct({ provider: Schema.String })),
+  }),
+});
+const Tools = Schema.Struct({
+  items: Schema.Array(Schema.Struct({ name: Schema.String })),
+  routers: Schema.Array(
+    Schema.Struct({
+      path: Schema.String,
+      error: Schema.optional(Schema.Struct({ accountId: Schema.String, status: Schema.Number })),
+    }),
+  ),
+});
+
+layer(HostedLive, { excludeTestServices: true })("Sentry regional recovery", (it) => {
+  it.effect(scenarios.sentryRegionalRecovery.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          browser = yield* Browser,
+          evidence = yield* Evidence,
+          issuer = yield* oauthSetupIssuer;
+        const catalog = yield* sentryCatalog(issuer.origin);
+        catalog.failMcp();
+        yield* serverControl("stop");
+        yield* serverControl("environment", 200, { EXECUTOR_CATALOG_URL: catalog.url });
+        yield* serverControl("start");
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const installed = yield* api.request(actors.owner, "POST", `${prefix}/apps/install`, {
+          entry: "sentry",
+          name: "Regional Sentry",
+        });
+        expect(installed.status, JSON.stringify(installed.body)).toBe(200);
+        const app = yield* body(App, installed),
+          path = `${prefix}/apps/${app.id}`;
+        const accounts: string[] = [];
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            expect((yield* api.request(actors.owner, "DELETE", path)).status).toBe(200);
+            for (const account of accounts)
+              expect(
+                (yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`))
+                  .status,
+              ).toBe(200);
+          }).pipe(Effect.orDie),
+        );
+        const provider = app.requirements.accounts.sentry?.provider;
+        expect(provider).toBeDefined();
+        for (const [token, status] of [
+          ["synthetic-sentry-rejected", "credentials_rejected"],
+          ["synthetic-sentry-denied", "check_failed"],
+        ] as const) {
+          const checked = yield* api.request(actors.owner, "POST", `${path}/credential-checks`, {
+            provider,
+            method: "authToken",
+            fields: { token, region: "us" },
+          });
+          expect(checked.status, JSON.stringify(checked.body)).toBe(200);
+          expect(checked.body).toMatchObject({ status });
+          expect(JSON.stringify(checked.body)).not.toContain(token);
+        }
+        for (const region of ["us", "de"]) {
+          const account = yield* connectSentryToken(actors.owner, prefix, path, {
+            token: "synthetic-sentry-personal",
+            region,
+          });
+          accounts.push(account.id);
+          const index = yield* body(
+            Tools,
+            yield* api.request(actors.owner, "GET", `${path}/tools/index`),
+          );
+          const failures = index.routers
+            .filter((router) => router.path === "mcp" || router.path.startsWith("mcp."))
+            .flatMap((router) => (router.error === undefined ? [] : [router.error]));
+          expect(failures).toHaveLength(accounts.length);
+          for (const id of accounts)
+            expect(failures).toContainEqual({ accountId: id, status: 503 });
+          expect(index.items.map((tool) => tool.name).sort()).toEqual([
+            "api.read.getRead",
+            "api.write.postWrite",
+          ]);
+          const read = yield* api.request(actors.owner, "POST", `${path}/tools/call`, {
+            tool: "api.read.getRead",
+            kind: "query",
+            input: { accountId: account.id, input: {} },
+          });
+          expect(read.status, JSON.stringify(read.body)).toBe(200);
+          expect(read.body).toEqual({ transport: "api", region });
+        }
+        const limitedId = (yield* connectSentryToken(actors.owner, prefix, path, {
+          token: "synthetic-sentry-scope",
+          region: "us",
+        })).id;
+        accounts.push(limitedId);
+        const denied = yield* api.request(actors.owner, "POST", `${path}/tools/call`, {
+          tool: "api.read.getRead",
+          kind: "query",
+          input: { accountId: limitedId, input: {} },
+        });
+        expect(denied.status, JSON.stringify(denied.body)).toBe(502);
+        expect(denied.body).toMatchObject({
+          _tag: "AppProviderFailed",
+          reason: "forbidden",
+          status: 403,
+          phase: "call",
+          upstream: { code: "insufficient_scope" },
+        });
+        expect(JSON.stringify(denied.body)).not.toContain("synthetic-sentry-scope");
+        expect(
+          catalog.calls
+            .filter((call) => call.transport === "api")
+            .every((call) => call.scheme === "Bearer" && call.token === "personal"),
+        ).toBe(true);
+        yield* browser.login(actors.owner);
+        yield* browser.use("Working REST remains visible during an MCP outage", (page) =>
+          page
+            .goto(`/org/${actors.organization.slug}/apps/${app.id}?view=tools`)
+            .then(() => page.getByRole("heading", { name: "Get read", exact: true }).waitFor()),
+        );
+        expect(
+          yield* browser.use("Provider failures do not invent a missing token", (page) =>
+            page.getByRole("button", { name: "Add token", exact: true }).count(),
+          ),
+        ).toBe(0);
+        yield* browser.checkpoint("MCP failure preserves regional REST tools");
+        yield* evidence.json("sentry-regional-peer-calls.json", catalog.calls);
+      }),
+    ),
+  );
+});
diff --git a/e2e/tests/sentry-upgrade.spec.ts b/e2e/tests/sentry-upgrade.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/sentry-upgrade.spec.ts
@@ -0,0 +1,143 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { FetchHttpClient, HttpClient } from "effect/http";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { accountLinks, connectionsPath } from "../support/app-accounts.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { Evidence } from "../support/evidence.ts";
+import { oauthSetupIssuer } from "../support/oauth-setup-issuer.ts";
+import { serverControl } from "../support/server-control.ts";
+import { connectSentryToken } from "../support/sentry-account.ts";
+import { sentryCatalog } from "../support/sentry-catalog.ts";
+import { scenarios } from "../test-plan.ts";
+
+const App = Schema.Struct({
+  id: Schema.String,
+  requirements: Schema.Struct({
+    accounts: Schema.Record(Schema.String, Schema.Struct({ provider: Schema.String })),
+  }),
+});
+const Redirect = Schema.Struct({ authorizationUrl: Schema.String, redirectUri: Schema.String });
+
+layer(HostedLive, { excludeTestServices: true })("Sentry retained accounts", (it) => {
+  it.effect(scenarios.sentryRetainedUpgrade.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          http = yield* HttpClient.HttpClient,
+          issuer = yield* oauthSetupIssuer,
+          evidence = yield* Evidence;
+        const catalog = yield* sentryCatalog(issuer.origin, true);
+        yield* serverControl("stop");
+        yield* serverControl("environment", 200, { EXECUTOR_CATALOG_URL: catalog.url });
+        yield* serverControl("start");
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const installed = yield* api.request(actors.owner, "POST", `${prefix}/apps/install`, {
+          entry: "sentry",
+          name: "Retained Sentry",
+        });
+        expect(installed.status, JSON.stringify(installed.body)).toBe(200);
+        const before = yield* body(App, installed),
+          path = `${prefix}/apps/${before.id}`;
+        const accounts: string[] = [];
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            expect((yield* api.request(actors.owner, "DELETE", path)).status).toBe(200);
+            for (const account of accounts)
+              expect(
+                (yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`))
+                  .status,
+              ).toBe(200);
+          }).pipe(Effect.orDie),
+        );
+        for (const index of [0, 1]) {
+          const connection = yield* body(
+            Resource,
+            yield* api.request(actors.owner, "POST", connectionsPath(path, "user", "sentry"), {}),
+          );
+          const client = {
+            clientId: `sentry-retained-${index}`,
+            clientSecret: `synthetic-secret-${index}`,
+          };
+          const started = yield* api.request(
+            actors.owner,
+            "POST",
+            `${prefix}/connections/${connection.id}/oauth/start`,
+            { method: "oauth", client },
+          );
+          expect(started.status, JSON.stringify(started.body)).toBe(200);
+          const redirect = yield* body(Redirect, started);
+          yield* issuer.allowClient({ ...client, redirect: redirect.redirectUri });
+          const callbackUrl = yield* Effect.scoped(
+            Effect.gen(function* () {
+              const consent = yield* HttpClient.withScope(http).get(redirect.authorizationUrl);
+              expect(consent.status).toBe(302);
+              if (consent.headers.location === undefined)
+                return yield* Effect.die("Missing OAuth callback");
+              return consent.headers.location;
+            }),
+          ).pipe(Effect.provideService(FetchHttpClient.RequestInit, { redirect: "manual" }));
+          const completed = yield* api.request(
+            actors.owner,
+            "POST",
+            `${prefix}/connections/${connection.id}/oauth/complete`,
+            { callbackUrl },
+          );
+          expect(completed.status, JSON.stringify(completed.body)).toBe(200);
+          accounts.push((yield* body(Resource, completed)).id);
+        }
+        const links = yield* accountLinks(actors.owner, path);
+        expect(links.map(([, account]) => account).sort()).toEqual([...accounts].sort());
+        const read = (accountId: string) =>
+          api.request(actors.owner, "POST", `${path}/tools/call`, {
+            tool: "mcp.read",
+            kind: "query",
+            input: { accountId, input: {} },
+          });
+        for (const account of accounts) expect((yield* read(account)).status).toBe(200);
+        const upgraded = yield* api.request(actors.owner, "POST", `${path}/deploy`, {
+          files: catalog.carriedFiles,
+        });
+        expect(upgraded.status, JSON.stringify(upgraded.body)).toBe(200);
+        const after = yield* body(App, yield* api.request(actors.owner, "GET", path));
+        expect(after.requirements.accounts.sentry?.provider).toBe(
+          before.requirements.accounts.sentry?.provider,
+        );
+        expect(yield* accountLinks(actors.owner, path)).toEqual(links);
+        for (const account of accounts) {
+          const called = yield* read(account);
+          expect(called.status, JSON.stringify(called.body)).toBe(200);
+          expect(JSON.stringify(called.body)).toContain("read through MCP");
+        }
+        const token = (yield* connectSentryToken(actors.owner, prefix, path, {
+          token: "synthetic-sentry-personal",
+          region: "us",
+        })).id;
+        accounts.push(token);
+        for (const tool of ["mcp.read", "api.read.getRead"]) {
+          const called = yield* api.request(actors.owner, "POST", `${path}/tools/call`, {
+            tool,
+            kind: "query",
+            input: { accountId: token, input: {} },
+          });
+          expect(called.status, JSON.stringify(called.body)).toBe(200);
+        }
+        expect(
+          (yield* accountLinks(actors.owner, path)).map(([, account]) => account).sort(),
+        ).toEqual([...accounts].sort());
+        yield* evidence.json("retained-sentry-upgrade.json", {
+          sameProvider:
+            after.requirements.accounts.sentry?.provider ===
+            before.requirements.accounts.sentry?.provider,
+          retainedOAuthSelections: 2,
+          retainedOAuthCalls: 2,
+          newTokenTransports: 2,
+        });
+      }),
+    ),
+  );
+});
