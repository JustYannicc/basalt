+++ b/e2e/support/sentry-account.ts
@@ -0,0 +1,28 @@
+import { expect } from "@effect/vitest";
+import { Effect } from "effect";
+import { Api, body, type Session } from "./api.ts";
+import { connectionsPath } from "./app-accounts.ts";
+import { Resource } from "./contracts.ts";
+
+/** Complete the ordinary hosted connection so saving and account selection both commit. */
+export const connectSentryToken = (
+  actor: Session,
+  prefix: string,
+  appPath: string,
+  fields: { token: string; region: string },
+) =>
+  Effect.gen(function* () {
+    const api = yield* Api;
+    const connection = yield* body(
+      Resource,
+      yield* api.request(actor, "POST", connectionsPath(appPath, "user", "sentry"), {}),
+    );
+    const completed = yield* api.request(
+      actor,
+      "POST",
+      `${prefix}/connections/${connection.id}/submit`,
+      { method: "authToken", fields },
+    );
+    expect(completed.status, JSON.stringify(completed.body)).toBe(200);
+    return yield* body(Resource, completed);
+  });
diff --git a/e2e/support/sentry-catalog.ts b/e2e/support/sentry-catalog.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/sentry-catalog.ts
@@ -0,0 +1,266 @@
+/** The shipped Sentry source, with only network destinations replaced by controlled peers. */
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Effect, FileSystem, Layer, Path, Schema } from "effect";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { createServer } from "node:http";
+import { appsVersion } from "./apps-release.ts";
+
+const Source = Schema.Struct({
+  package: Schema.String,
+  files: Schema.Array(Schema.Struct({ path: Schema.String, content: Schema.String })),
+});
+const Message = Schema.Struct({
+  id: Schema.optional(Schema.Union([Schema.Number, Schema.String])),
+  method: Schema.String,
+  params: Schema.optional(Schema.Struct({ name: Schema.optional(Schema.String) })),
+});
+const json = HttpServerResponse.jsonUnsafe;
+const listen = <E, R>(routes: Layer.Layer<never, E, R>) =>
+  Effect.gen(function* () {
+    const listener = createServer();
+    const services = yield* Layer.build(
+      HttpRouter.serve(routes, { disableLogger: true, disableListenLog: true }).pipe(
+        Layer.provideMerge(NodeHttpServer.layer(() => listener, { host: "127.0.0.1", port: 0 })),
+      ),
+    );
+    yield* Effect.addFinalizer(() => Effect.sync(() => listener.closeAllConnections()));
+    const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+    if (!("port" in server.address)) return yield* Effect.die("Peer needs a TCP listener");
+    return `http://127.0.0.1:${server.address.port}`;
+  });
+
+export const sentryCatalog = (issuer: string, published = false) =>
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem,
+      path = yield* Path.Path;
+    const source = yield* fs
+      .readFileString(path.resolve("..", "src/catalog/sentry.json"))
+      .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Schema.fromJsonString(Source))));
+    const original = yield* fs
+      .readFileString(path.resolve("..", "src/catalog/sentry.published.json"))
+      .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Schema.fromJsonString(Source))));
+    const connections = yield* fs
+      .readFileString(path.resolve("..", "src/catalog/sentry.connections.json"))
+      .pipe(
+        Effect.flatMap(
+          Schema.decodeUnknownEffect(
+            Schema.fromJsonString(Schema.Record(Schema.String, Schema.Json)),
+          ),
+        ),
+      );
+    const calls: {
+      transport: "mcp" | "api";
+      method: string;
+      region?: string;
+      scheme: string;
+      token: "personal" | "oauth" | "none";
+    }[] = [];
+    let failMcp = false;
+    const classify = (authorization: string | undefined) => ({
+      scheme: authorization?.split(" ")[0] ?? "none",
+      token: authorization?.split(" ")[1]?.startsWith("synthetic-sentry-")
+        ? ("personal" as const)
+        : authorization
+          ? ("oauth" as const)
+          : ("none" as const),
+    });
+    const rest = (region: string) =>
+      listen(
+        HttpRouter.add(
+          "*",
+          "/*",
+          Effect.gen(function* () {
+            const request = yield* HttpServerRequest.HttpServerRequest;
+            const auth = classify(request.headers.authorization);
+            calls.push({ transport: "api", method: request.method, region, ...auth });
+            if (request.headers.authorization?.endsWith("synthetic-sentry-rejected"))
+              return json({ detail: "Invalid token" }, { status: 401 });
+            if (
+              request.headers.authorization?.endsWith("synthetic-sentry-scope") &&
+              request.url.startsWith("/read")
+            )
+              return json(
+                { detail: "Missing event:read" },
+                {
+                  status: 403,
+                  headers: {
+                    "www-authenticate": 'Bearer error="insufficient_scope", scope="event:read"',
+                  },
+                },
+              );
+            if (request.headers.authorization?.endsWith("synthetic-sentry-denied"))
+              return json({ detail: "Access denied" }, { status: 403 });
+            if (auth.scheme !== "Bearer" || auth.token !== "personal")
+              return json({ detail: "Invalid token" }, { status: 401 });
+            if (request.url.startsWith("/api/0/organizations/"))
+              return json([
+                { id: `org-${region}`, slug: `fixture-${region}`, name: `Fixture ${region}` },
+              ]);
+            if (request.url.startsWith("/read")) return json({ transport: "api", region });
+            return json({ wrote: true, region });
+          }),
+        ),
+      );
+    const us = yield* rest("us"),
+      de = yield* rest("de");
+    let mcp = "";
+    mcp = yield* listen(
+      Layer.mergeAll(
+        HttpRouter.add(
+          "GET",
+          "/.well-known/oauth-protected-resource/mcp",
+          Effect.sync(() => json({ resource: `${mcp}/mcp`, authorization_servers: [issuer] })),
+        ),
+        HttpRouter.add(
+          "GET",
+          "/openapi.json",
+          Effect.sync(() =>
+            json({
+              openapi: "3.0.3",
+              info: { title: "Sentry controlled API peer", version: "1" },
+              servers: [{ url: us }],
+              paths: Object.fromEntries(
+                ["read", "write"].map((name) => [
+                  `/${name}`,
+                  {
+                    [name === "read" ? "get" : "post"]: {
+                      operationId: name,
+                      responses: {
+                        "200": {
+                          description: "OK",
+                          content: { "application/json": { schema: { type: "object" } } },
+                        },
+                      },
+                    },
+                  },
+                ]),
+              ),
+            }),
+          ),
+        ),
+        HttpRouter.add(
+          "GET",
+          "/mcp",
+          Effect.sync(() =>
+            HttpServerResponse.empty({
+              status: 401,
+              headers: {
+                "www-authenticate": `Bearer resource_metadata="${mcp}/.well-known/oauth-protected-resource/mcp"`,
+              },
+            }),
+          ),
+        ),
+        HttpRouter.add(
+          "POST",
+          "/mcp",
+          Effect.gen(function* () {
+            const request = yield* HttpServerRequest.HttpServerRequest;
+            if (failMcp) return HttpServerResponse.empty({ status: 503 });
+            const auth = classify(request.headers.authorization);
+            if (
+              !(
+                (auth.scheme === "Sentry-Bearer" && auth.token === "personal") ||
+                (auth.scheme === "Bearer" && auth.token === "oauth")
+              )
+            )
+              return HttpServerResponse.empty({
+                status: 401,
+                headers: {
+                  "www-authenticate": `Bearer resource_metadata="${mcp}/.well-known/oauth-protected-resource/mcp"`,
+                },
+              });
+            const message = yield* request.json.pipe(
+              Effect.flatMap(Schema.decodeUnknownEffect(Message)),
+            );
+            calls.push({ transport: "mcp", method: message.method, ...auth });
+            if (message.id === undefined) return HttpServerResponse.empty({ status: 202 });
+            const result =
+              message.method === "initialize"
+                ? {
+                    protocolVersion: "2025-11-25",
+                    capabilities: { tools: {} },
+                    serverInfo: { name: "sentry-peer", version: "1" },
+                  }
+                : message.method === "tools/list"
+                  ? {
+                      tools: ["read", "write"].map((name) => ({
+                        name,
+                        description: `${name} through Sentry MCP`,
+                        inputSchema: { type: "object", properties: {} },
+                        ...(name === "read" ? { annotations: { readOnlyHint: true } } : {}),
+                      })),
+                    }
+                  : { content: [{ type: "text", text: `${message.params?.name} through MCP` }] };
+            return json({ jsonrpc: "2.0", id: message.id, result });
+          }),
+        ),
+      ),
+    );
+    const replacements = new Map([
+      ["https://mcp.sentry.dev", mcp],
+      ["https://us.sentry.io", us],
+      ["https://de.sentry.io", de],
+      [
+        "https://raw.githubusercontent.com/getsentry/sentry-api-schema/main/openapi-derefed.json",
+        `${mcp}/openapi.json`,
+      ],
+    ]);
+    const localFiles = (source: typeof original) =>
+      source.files.map((file) => {
+        if (file.path === "package.json") {
+          const manifest = Schema.decodeUnknownSync(
+            Schema.fromJsonString(Schema.Record(Schema.String, Schema.Json)),
+          )(file.content);
+          const dependencies = Schema.decodeUnknownSync(
+            Schema.Record(Schema.String, Schema.String),
+          )(manifest.dependencies);
+          return {
+            ...file,
+            content: JSON.stringify({
+              ...manifest,
+              dependencies: { ...dependencies, apps: appsVersion },
+            }),
+          };
+        }
+        if (!["index.ts", "openapi.ts"].includes(file.path)) return file;
+        let content = file.content;
+        for (const [from, to] of replacements) content = content.replaceAll(from, to);
+        if (file.path === "index.ts")
+          content = content.replace(
+            'hosts: ["mcp.sentry.dev", "us.sentry.io", "de.sentry.io"]',
+            `hosts: ${JSON.stringify([mcp, us, de].map((origin) => new URL(origin).host))}`,
+          );
+        return { ...file, content };
+      });
+    const entry = {
+      id: "sentry",
+      package: source.package,
+      name: "Sentry",
+      description: "Error tracking with MCP and REST tools.",
+      icons: [],
+      auth: [
+        { method: "oauth", kind: "oauth2" },
+        { method: "authToken", kind: "secrets" },
+      ],
+      source: "apps/sentry.json",
+      ...connections,
+    };
+    const origin = yield* listen(
+      Layer.mergeAll(
+        HttpRouter.add("GET", "/index.json", json({ version: 1, apps: [entry] })),
+        HttpRouter.add(
+          "GET",
+          "/apps/sentry.json",
+          json({ ...source, files: localFiles(published ? original : source) }),
+        ),
+      ),
+    );
+    return {
+      url: `${origin}/index.json`,
+      carriedFiles: localFiles(source),
+      calls,
+      failMcp: () => {
+        failMcp = true;
+      },
+    };
+  });
diff --git a/e2e/tests/sentry-both.spec.ts b/e2e/tests/sentry-both.spec.ts
