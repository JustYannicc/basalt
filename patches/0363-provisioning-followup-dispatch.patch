+++ b/apps/hosted/cloud/src/infrastructure/provisioning-followup.ts
@@ -0,0 +1,48 @@
+/** Durable follow-up dispatch after provisioning has committed its writes. */
+import * as Cloudflare from "alchemy/Cloudflare";
+import { Cause, Effect } from "effect";
+import { encryptedWorkflowTask, type WorkflowResults } from "./workflow-results.ts";
+
+export const provisioningFollowup = <E>(input: {
+  readonly id: string;
+  readonly results: WorkflowResults | undefined;
+  readonly request: (job: "provisioning" | "schedule-wake") => Effect.Effect<void, E>;
+}) =>
+  Effect.gen(function* () {
+    const step = yield* Cloudflare.Workflows.WorkflowStep;
+    // Member setup can commit another team's lifecycle jobs. No request finalizer follows a workflow.
+    for (const job of ["provisioning", "schedule-wake"] as const) {
+      const name = job === "provisioning" ? "provisioning-dispatch" : job;
+      const requested = input.request(job);
+      const work = job === "schedule-wake" ? requested.pipe(Effect.orDie) : requested;
+      const options = {
+        retries: { limit: 5, delay: "2 seconds", backoff: "exponential" as const },
+        timeout: "1 minute",
+      };
+      const dispatch =
+        input.results === undefined
+          ? step.do({ name, ...options, effect: work })
+          : encryptedWorkflowTask({
+              results: input.results,
+              name,
+              options,
+              work: () => work,
+              encodeFailure: (error) =>
+                error instanceof Error ? error.message : "Schedule wake failed",
+              isRetryable: () => job === "provisioning",
+              restoreFailure: (failure) => new Error(failure.message),
+            });
+      yield* dispatch.pipe(
+        Effect.catchCause((cause) =>
+          Cause.hasInterrupts(cause)
+            ? Effect.interrupt
+            : Effect.logError(
+                job === "provisioning"
+                  ? "Provisioning dispatch after provisioning failed"
+                  : "Schedule wake after provisioning failed",
+                { job: input.id },
+              ),
+        ),
+      );
+    }
+  });
