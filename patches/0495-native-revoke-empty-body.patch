--- /dev/null
+++ b/packages/mcp-auth/src/implementation/native-revoke-body.ts
@@ -0,0 +1,28 @@
+/** Transport adapters may represent a bodyless POST as an empty stream. */
+export async function normalizeNativeRevokeBody(request: Request, baseURL: string) {
+  if (
+    request.method !== "POST" ||
+    request.headers.has("content-type") ||
+    new URL(request.url).pathname !==
+      new URL("native/revoke", `${baseURL.replace(/\/$/, "")}/`).pathname
+  )
+    return;
+  if (request.body !== null) {
+    const reader = request.clone().body!.getReader();
+    try {
+      for (;;) {
+        const { done, value } = await reader.read();
+        if (done) break;
+        if (value.byteLength > 0) return;
+      }
+    } finally {
+      // A cloned body's cancellation waits for the original branch, which the router still owns.
+      void reader.cancel().catch(() => undefined);
+      reader.releaseLock();
+    }
+  }
+  const headers = new Headers(request.headers);
+  headers.set("content-type", "application/json");
+  headers.delete("content-length");
+  return { request: new Request(request, { headers, body: "{}" }) };
+}
