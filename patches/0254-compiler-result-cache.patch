index 0000000..e24f2c1
--- /dev/null
+++ b/e2e/fixtures/compiler-cache-worker.ts
@@ -0,0 +1,109 @@
+/** Test-only HTTP entry around the production compiler service and the real Workers Cache API. */
+import { CodeFiles } from "@executor-js/sdk/core";
+import { ConfigProvider, Effect, Schema } from "effect";
+import { compilerRuntime } from "../../apps/hosted/cloud/src/implementation/compiler-runtime.ts";
+import { compilerCacheConfiguration } from "../../apps/hosted/cloud/src/implementation/compiler-cache-config.ts";
+
+interface Environment {
+  readonly CONFIGURATION: string;
+  readonly ASSETS: { readonly fetch: (request: Request) => Promise<Response> };
+}
+const realStorage = caches;
+const cacheActions: string[] = [];
+let lastEntry: { readonly cache: Cache; readonly key: RequestInfo } | undefined;
+// Record the key while every operation still reaches workerd's native Cache API.
+Object.defineProperty(globalThis, "caches", {
+  value: {
+    open: async (name: string) => {
+      cacheActions.push(`open:${name}`);
+      const cache = await realStorage.open(name);
+      return {
+        match: async (key: RequestInfo) => {
+          const value = await cache.match(key);
+          cacheActions.push(`match:${String(key)}:${value !== undefined}`);
+          return value;
+        },
+        put: async (key: RequestInfo, response: Response) => {
+          cacheActions.push(`put:${String(key)}`);
+          lastEntry = { cache, key };
+          await cache.put(key, response);
+        },
+      };
+    },
+  },
+});
+
+export default {
+  async fetch(request: Request, env: Environment) {
+    const route = new URL(request.url).pathname;
+    if (route === "/corrupt") {
+      if (lastEntry === undefined)
+        return new Response("No retained compiler entry", { status: 409 });
+      const response = await lastEntry.cache.match(lastEntry.key);
+      if (response === undefined)
+        return new Response("No retained compiler entry", { status: 409 });
+      const envelope = Schema.decodeUnknownSync(
+        Schema.Struct({ format: Schema.Literal(2), payload: Schema.String, digest: Schema.String }),
+      )(await response.json());
+      const value = JSON.parse(envelope.payload);
+      value.bundle.modules[value.bundle.mainModule] = "export default {{{ damaged";
+      const corrupted = { ...envelope, payload: JSON.stringify(value) };
+      await lastEntry.cache.put(lastEntry.key, new Response(JSON.stringify(corrupted), response));
+      return Response.json({ corrupted: true, validJson: true });
+    }
+    if (route !== "/create" && route !== "/release-two" && route !== "/test-stage")
+      return new Response("Not found", { status: 404 });
+    const configuration = JSON.parse(env.CONFIGURATION);
+    if (route === "/release-two") configuration.EXECUTOR_COMPILER_CACHE_RELEASE = "b".repeat(40);
+    if (route === "/test-stage") {
+      configuration.ALCHEMY_STAGE = "test-e2e-cache";
+      configuration.EXECUTOR_APPS_FRAMEWORK = "/test/framework-override";
+    }
+    const provider = ConfigProvider.layer(ConfigProvider.fromUnknown(configuration));
+    // Cloudflare calls fetch as a Promise API; this is the Worker service boundary.
+    // oxlint-disable-next-line executor/no-manual-effect-runtime-in-tests
+    const release = await Effect.runPromise(
+      compilerCacheConfiguration(configuration.ALCHEMY_STAGE).pipe(Effect.provide(provider)),
+    );
+    const runtimeProvider = ConfigProvider.layer(
+      ConfigProvider.fromUnknown({
+        ...configuration,
+        EXECUTOR_COMPILER_CACHE_ENABLED: String(release !== undefined),
+        EXECUTOR_COMPILER_CACHE_RELEASE: release,
+      }),
+    );
+    const input = Schema.decodeUnknownSync(
+      Schema.Struct({ files: CodeFiles, publicPaths: Schema.Array(Schema.String) }),
+    )(await request.json());
+    const phases: string[] = [];
+    const log = console.log;
+    console.log = (...values: unknown[]) => {
+      const first = values[0];
+      if (typeof first === "string" && first.startsWith('{"type":"executor.compiler.phase"'))
+        phases.push(JSON.parse(first).phase);
+      log(...values);
+    };
+    try {
+      // Cloudflare fetch requires a Promise; the compiled service runs inside this request.
+      // oxlint-disable-next-line executor/no-manual-effect-runtime-in-tests
+      const result = await Effect.runPromise(
+        Effect.gen(function* () {
+          const compiler = yield* compilerRuntime({
+            ASSETS: env.ASSETS,
+            EXECUTOR_COMPILER_CACHE_ENABLED: String(release !== undefined),
+          });
+          return yield* compiler.compile(input.files, input.publicPaths, {});
+        }).pipe(Effect.provide(runtimeProvider)),
+      );
+      return Response.json({
+        result,
+        phases,
+        cacheActions,
+        eligible: release !== undefined,
+        release: release ?? null,
+      });
+    } finally {
+      console.log = log;
+    }
+  },
+};
