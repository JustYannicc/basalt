+/** Isolated development host for the real compiler deployment and native cache controls. */
+import { createServer } from "node:http";
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import * as NodeRuntime from "@effect/platform-node/NodeRuntime";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { Cause, Console, Effect, Layer } from "effect";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { compilerCacheServer } from "./runtime.ts";
+
+NodeRuntime.runMain(
+  Effect.scoped(
+    Effect.gen(function* () {
+      const compiler = yield* compilerCacheServer;
+      const handle = Effect.gen(function* () {
+        const request = yield* HttpServerRequest.HttpServerRequest;
+        const result = yield* compiler.request(request.url, yield* request.json);
+        return HttpServerResponse.jsonUnsafe(result);
+      }).pipe(
+        Effect.tapCause((cause) => Console.error(Cause.pretty(cause))),
+        Effect.orDie,
+      );
+      const services = yield* Layer.build(
+        HttpRouter.serve(
+          Layer.mergeAll(
+            HttpRouter.add("POST", "/create", handle),
+            HttpRouter.add("POST", "/release-two", handle),
+            HttpRouter.add("POST", "/test-stage", handle),
+            HttpRouter.add("POST", "/corrupt", handle),
+          ),
+          { disableLogger: true, disableListenLog: true },
+        ).pipe(
+          Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 })),
+        ),
+      );
+      const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+      if (!("port" in server.address)) return yield* Effect.die("Compiler proof host requires TCP");
+      yield* Console.log(
+        JSON.stringify({
+          type: "compiler-cache-proof.ready",
+          port: server.address.port,
+          version: compiler.version,
+          configuration: compiler.configuration,
+        }),
+      );
+      return yield* Effect.never;
+    }),
+  ).pipe(Effect.provide(NodeServices.layer)),
+);
diff --git a/scripts/compiler-cache-proof/runtime.ts b/scripts/compiler-cache-proof/runtime.ts
new file mode 100644
index 0000000..ab27fce
--- /dev/null
+++ b/scripts/compiler-cache-proof/runtime.ts
@@ -0,0 +1,131 @@
+/** Run normal compiler deployments in isolated workerd and call their generated RPC client. */
+import { createRequire } from "node:module";
+import { Miniflare } from "miniflare";
+import { Effect, FileSystem, Path, Schema } from "effect";
+import { driver } from "./driver.ts";
+import { compilerCacheDeployment } from "./deployment.ts";
+import { compilerCacheKeys, corruptCompilerCache } from "./storage.ts";
+
+const Phase = Schema.Struct({
+  type: Schema.Literal("executor.compiler.phase"),
+  phase: Schema.String,
+});
+export const compilerCacheServer = Effect.gen(function* () {
+  const path = yield* Path.Path;
+  const fs = yield* FileSystem.FileSystem;
+  const framework = path.resolve(".local/basalt-framework");
+  const packageFiles = Schema.decodeUnknownSync(
+    Schema.fromJsonString(Schema.Record(Schema.String, Schema.String)),
+  )(yield* fs.readFileString(path.join(framework, "framework.json")));
+  const { version } = Schema.decodeUnknownSync(
+    Schema.fromJsonString(Schema.Struct({ version: Schema.String })),
+  )(packageFiles["package.json"]);
+  const configuration = {
+    ALCHEMY_STAGE: "production",
+    EXECUTOR_COMPILER_CACHE_RELEASE: "a".repeat(40),
+    EXECUTOR_APPS_FRAMEWORK: framework,
+    EXECUTOR_COMPILER_CACHE_FRAMEWORK: framework,
+    EXECUTOR_APPS_VERSION: version,
+    EXECUTOR_COMPILER_CACHE_APPS_VERSION: version,
+    DO_NOT_TRACK: "1",
+    SENTRY_ENABLED: "false",
+    POSTHOG_ENABLED: "false",
+  };
+  const deployments = {
+    "/create": yield* compilerCacheDeployment("production", configuration),
+    "/release-two": yield* compilerCacheDeployment("production", {
+      ...configuration,
+      EXECUTOR_COMPILER_CACHE_RELEASE: "b".repeat(40),
+    }),
+    // Every other eligibility input is identical to production, including released assets.
+    "/test-stage": yield* compilerCacheDeployment("test-e2e-cache", configuration),
+  };
+  const loaded = Schema.decodeUnknownSync(
+    Schema.Union([Schema.String, Schema.Struct({ default: Schema.String })]),
+  )(createRequire(import.meta.url)("workerd"));
+  const workerd = typeof loaded === "string" ? loaded : loaded.default;
+  const previousWorkerd = process.env.MINIFLARE_WORKERD_PATH;
+  yield* Effect.acquireRelease(
+    Effect.sync(() => {
+      process.env.MINIFLARE_WORKERD_PATH = workerd;
+    }),
+    () =>
+      Effect.sync(() => {
+        if (previousWorkerd === undefined) delete process.env.MINIFLARE_WORKERD_PATH;
+        else process.env.MINIFLARE_WORKERD_PATH = previousWorkerd;
+      }),
+  );
+  const directory = yield* fs.makeTempDirectoryScoped({ prefix: "compiler-cache-proof-" });
+  const cachePersist = path.join(directory, "cache");
+  yield* fs.makeDirectory(cachePersist);
+  const phases: string[] = [];
+  let complete: (() => void) | undefined;
+  const options = (workers: (typeof deployments)["/create"]["workers"]) => ({
+    workers,
+    cachePersist,
+    handleStructuredLogs: (log: { readonly message: string }) => {
+      const start = log.message.indexOf('{"type":"executor.compiler.phase"');
+      if (start === -1) {
+        console.error(log.message);
+        return;
+      }
+      const decoded = Schema.decodeUnknownOption(Schema.fromJsonString(Phase))(
+        log.message.slice(start),
+      );
+      if (decoded._tag === "None") return;
+      phases.push(decoded.value.phase);
+      if (decoded.value.phase === "released" || decoded.value.phase === "error") complete?.();
+    },
+  });
+  let selected = "/create";
+  let deployment = deployments["/create"];
+  const runtime = yield* Effect.acquireRelease(
+    Effect.sync(() => new Miniflare(options(deployment.workers))),
+    (runtime) => driver("dispose compiler fixture", () => runtime.dispose()).pipe(Effect.orDie),
+  );
+  let lastKey: string | undefined;
+  const request = (route: string, input?: unknown) => {
+    if (route === "/corrupt")
+      return driver("corrupt native compiler cache", async () => {
+        if (lastKey === undefined) throw new Error("No retained release entry");
+        return corruptCompilerCache(runtime, lastKey);
+      });
+    const target =
+      route === "/create" || route === "/release-two" || route === "/test-stage"
+        ? deployments[route]
+        : undefined;
+    if (target === undefined) return Effect.die(`Unknown compiler fixture route ${route}`);
+    return driver("call generated compiler RPC client", async () => {
+      if (selected !== route) {
+        await runtime.setOptions(options(target.workers));
+        selected = route;
+        deployment = target;
+      }
+      const before = new Set(await compilerCacheKeys(cachePersist));
+      phases.length = 0;
+      const done = new Promise<void>((resolve) => {
+        complete = resolve;
+      });
+      const response = await runtime.dispatchFetch("http://compiler-fixture.local/compile", {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify(input ?? {}),
+      });
+      if (response.status !== 200)
+        throw new Error(`Compiler fixture returned ${response.status}: ${await response.text()}`);
+      const result: unknown = await response.json();
+      await done;
+      complete = undefined;
+      const keys = await compilerCacheKeys(cachePersist);
+      lastKey = keys.find((key) => !before.has(key)) ?? lastKey;
+      return {
+        result,
+        phases: [...phases],
+        eligible: deployment.compilerBindings.EXECUTOR_COMPILER_CACHE_ENABLED === "true",
+        release: deployment.release,
+        stage: deployment.stage,
+      };
+    });
+  };
+  return { request, version, configuration };
+});
diff --git a/scripts/compiler-cache-proof/storage.ts b/scripts/compiler-cache-proof/storage.ts
new file mode 100644
index 0000000..a7c8273
--- /dev/null
+++ b/scripts/compiler-cache-proof/storage.ts
@@ -0,0 +1,77 @@
+/** Corrupt native test-cache bytes from the host, without modifying the compiler Worker. */
+import { readdir } from "node:fs/promises";
+import { join } from "node:path";
+import { DatabaseSync } from "node:sqlite";
+import { Headers, Response, type Miniflare } from "miniflare";
+import { Schema } from "effect";
+
+const Keys = Schema.Array(Schema.Struct({ key: Schema.String }));
+export const compilerCacheKeys = async (directory: string): Promise<string[]> => {
+  const entries = await readdir(directory, { withFileTypes: true });
+  const keys: string[] = [];
+  for (const entry of entries) {
+    const file = join(directory, entry.name);
+    if (entry.isDirectory()) keys.push(...(await compilerCacheKeys(file)));
+    else if (entry.name.endsWith(".sqlite")) {
+      // Read only this fixture's cache metadata; content still goes through native Cache API.
+      const db = new DatabaseSync(file, { readOnly: true });
+      try {
+        // workerd also creates metadata databases before a cache namespace has any entries.
+        if (
+          db
+            .prepare("SELECT name FROM sqlite_master WHERE type = 'table' AND name = '_mf_entries'")
+            .get() === undefined
+        )
+          continue;
+        const rows = Schema.decodeUnknownSync(Keys)(
+          db
+            .prepare(
+              "SELECT key FROM _mf_entries WHERE key LIKE 'https://compiler-cache.invalid/v2/%'",
+            )
+            .all(),
+        );
+        keys.push(...rows.map((row) => row.key));
+      } finally {
+        db.close();
+      }
+    }
+  }
+  return keys;
+};
+const Envelope = Schema.Struct({
+  format: Schema.Literal(2),
+  payload: Schema.String,
+  digest: Schema.String,
+});
+const ObjectValue = Schema.Record(Schema.String, Schema.Unknown);
+export const corruptCompilerCache = async (runtime: Miniflare, key: string) => {
+  const cache = await (await runtime.getCaches()).open("executor-private-compiler-results-v2");
+  const response = await cache.match(key);
+  if (response === undefined) throw new Error("Compiler entry was not in native Cache API");
+  const envelope = Schema.decodeUnknownSync(Envelope)(await response.json());
+  const payload = Schema.decodeUnknownSync(Schema.fromJsonString(ObjectValue))(envelope.payload);
+  const bundle = Schema.decodeUnknownSync(ObjectValue)(payload.bundle);
+  const main = Schema.decodeUnknownSync(Schema.String)(bundle.mainModule);
+  const modules = Schema.decodeUnknownSync(ObjectValue)(bundle.modules);
+  const corrupted = {
+    ...envelope,
+    payload: JSON.stringify({
+      ...payload,
+      bundle: {
+        ...bundle,
+        modules: { ...modules, [main]: "export default {{{ damaged" },
+      },
+    }),
+  };
+  // Preserve valid envelope JSON and its old digest, changing only JavaScript payload bytes.
+  const headers = new Headers(response.headers);
+  headers.delete("content-length");
+  await cache.put(
+    key,
+    new Response(JSON.stringify(corrupted), {
+      status: response.status,
+      headers,
+    }),
+  );
+  return { corrupted: true, validJson: true };
+};
