index 0000000..ce3d2c7
--- /dev/null
+++ b/e2e/tests/cloud-compiler-cache.spec.ts
@@ -0,0 +1,96 @@
+/** Production reuse and inherited-stage bypass through a real HTTP compiler Worker. */
+import { expect, layer } from "@effect/vitest";
+import { FetchHttpClient } from "effect/http";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { Effect, FileSystem, Config, Option, Schema, Layer } from "effect";
+import { scenarios } from "../test-plan.ts";
+import { compilerCacheServer } from "../support/compiler-cache-server.ts";
+
+const Reply = Schema.Struct({
+  result: Schema.Struct({ ok: Schema.Boolean, value: Schema.Unknown }),
+  phases: Schema.Array(Schema.String),
+  eligible: Schema.Boolean,
+  release: Schema.NullOr(Schema.String),
+  stage: Schema.String,
+});
+layer(Layer.mergeAll(NodeServices.layer, FetchHttpClient.layer), { excludeTestServices: true })(
+  "Compiler cache",
+  (it) => {
+    it.effect(
+      scenarios.cloudCompilerCache.title,
+      () =>
+        Effect.gen(function* () {
+          const fs = yield* FileSystem.FileSystem;
+          const server = yield* compilerCacheServer;
+          const input = {
+            files: [
+              {
+                path: "index.ts",
+                content: `import { defineApp, router, query, object } from "apps";
+export default defineApp({}, { tools: router({ read: query({input:object({})}, async () => "cache-proof") }) });`,
+              },
+              {
+                path: "package.json",
+                content: JSON.stringify({ dependencies: { apps: server.version } }),
+              },
+            ],
+            publicPaths: [],
+          };
+          const create = (route: string) =>
+            server.request(route, input).pipe(Effect.flatMap(Schema.decodeUnknownEffect(Reply)));
+          const cold = yield* create("/create");
+          expect(cold.stage).toBe("production");
+          expect(cold.eligible).toBe(true);
+          expect(cold.release).toBe("a".repeat(40));
+          expect(cold.result.ok).toBe(true);
+          expect(cold.phases).toContain("bundle");
+          expect(cold.phases).not.toContain("cache-hit");
+          const warm = yield* create("/create");
+          expect(warm.result.ok).toBe(true);
+          expect(warm.phases).toContain("cache-hit");
+          expect(warm.phases).not.toContain("bundle");
+          expect(JSON.stringify(warm.result.value)).toBe(JSON.stringify(cold.result.value));
+          const release = yield* create("/release-two");
+          expect(release.release).toBe("b".repeat(40));
+          expect(release.phases).toContain("bundle");
+          expect(release.phases).not.toContain("cache-hit");
+          expect(JSON.stringify(release.result.value)).toBe(JSON.stringify(cold.result.value));
+          const corrupted = yield* server.request("/corrupt");
+          expect(corrupted).toEqual({ corrupted: true, validJson: true });
+          const repaired = yield* create("/release-two");
+          expect(repaired.result.ok).toBe(true);
+          expect(repaired.phases).toContain("bundle");
+          expect(repaired.phases).not.toContain("cache-hit");
+          expect(JSON.stringify(repaired.result.value)).toBe(JSON.stringify(cold.result.value));
+          // The same native Cache API already contains both release entries.
+          const testStageCalls = [];
+          for (let attempt = 0; attempt < 2; attempt++) {
+            const test = yield* create("/test-stage");
+            testStageCalls.push(test);
+            expect(test.stage).toBe("test-e2e-cache");
+            expect(server.configuration.ALCHEMY_STAGE).toBe("production");
+            expect(test.eligible).toBe(false);
+            expect(test.result.ok).toBe(true);
+            expect(test.phases).toContain("bundle");
+            expect(test.phases).not.toContain("cache-hit");
+            expect(JSON.stringify(test.result.value)).toBe(JSON.stringify(cold.result.value));
+          }
+          const directory = yield* Config.String("EXECUTOR_E2E_RUN").pipe(Config.option);
+          if (Option.isSome(directory))
+            yield* fs.writeFileString(
+              `${directory.value}/compiler-cache-production.json`,
+              JSON.stringify({
+                configuration: server.configuration,
+                cold,
+                warm,
+                release,
+                corrupted,
+                repaired,
+                testStageCalls,
+              }),
+            );
+        }),
+      { timeout: 180_000 },
+    );
+  },
+);
