+/** HTTP test client using the same generated private binding as the app runtime. */
+import * as Cloudflare from "alchemy/Cloudflare";
+import { CodeFiles } from "@executor-js/sdk/core";
+import { Effect, Schema } from "effect";
+import { HttpServerRequest, HttpServerResponse } from "effect/http";
+import { AppCompiler } from "../../apps/hosted/cloud/src/infrastructure/compiler.ts";
+
+export default class CompilerCacheClient extends Cloudflare.Worker<CompilerCacheClient>()(
+  "CompilerCacheClient",
+  { main: import.meta.url, compatibility: { date: "2026-09-08", flags: ["nodejs_compat"] } },
+  Effect.gen(function* () {
+    const compiler = yield* Cloudflare.Workers.bindWorker(AppCompiler);
+    return {
+      fetch: Effect.gen(function* () {
+        const request = yield* HttpServerRequest.HttpServerRequest;
+        const input = yield* Schema.decodeUnknownEffect(
+          Schema.Struct({ files: CodeFiles, publicPaths: Schema.Array(Schema.String) }),
+        )(yield* request.json);
+        const result = yield* compiler.compile(input.files, input.publicPaths, {});
+        return HttpServerResponse.jsonUnsafe(result);
+      }).pipe(Effect.orDie),
+    };
+  }),
+) {}
