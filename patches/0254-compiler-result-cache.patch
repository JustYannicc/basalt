+import { Config, Effect, Option } from "effect";
+
+/** A test stage may inherit release settings, but never production's reuse permission. */
+export const compilerCacheRelease = (input: {
+  readonly stage: string | undefined;
+  readonly release: string | undefined;
+  readonly registry: string | undefined;
+  readonly framework: string | undefined;
+  readonly expectedFramework: string | undefined;
+  readonly version: string | undefined;
+  readonly expectedVersion: string | undefined;
+}) =>
+  input.stage === "production" &&
+  /^[a-f0-9]{40}$/.test(input.release ?? "") &&
+  input.registry === undefined &&
+  input.framework !== undefined &&
+  input.framework === input.expectedFramework &&
+  input.version !== undefined &&
+  input.version === input.expectedVersion
+    ? input.release
+    : undefined;
+
+/** Provisioning alone grants reuse. A runtime receives only the qualified release binding. */
+export const compilerCacheConfiguration = (stage: string | undefined) =>
+  Effect.gen(function* () {
+    const setting = (name: string) =>
+      Config.String(name).pipe(Config.option, Effect.map(Option.getOrUndefined));
+    return compilerCacheRelease({
+      stage,
+      release: yield* setting("EXECUTOR_COMPILER_CACHE_RELEASE"),
+      registry: yield* setting("EXECUTOR_NPM_REGISTRY"),
+      framework: yield* setting("EXECUTOR_APPS_FRAMEWORK"),
+      expectedFramework: yield* setting("EXECUTOR_COMPILER_CACHE_FRAMEWORK"),
+      version: yield* setting("EXECUTOR_APPS_VERSION"),
+      expectedVersion: yield* setting("EXECUTOR_COMPILER_CACHE_APPS_VERSION"),
+    });
+  });
