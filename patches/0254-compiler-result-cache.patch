index 0000000..135d348
--- /dev/null
+++ b/apps/hosted/cloud/src/implementation/compiler-runtime.ts
@@ -0,0 +1,139 @@
+/** The compiler's real Worker service. HTTP fixtures and the private RPC use the same runtime. */
+import { CodeFiles, RuntimeBuildFailed } from "@executor-js/sdk/core";
+import {
+  compilerCompileBudget,
+  compilerQueueBudget,
+  compileWithinDeadline,
+} from "./compiler-request.ts";
+import { CloudCompileResult } from "../contracts/builds.ts";
+import { captureTelemetry, withRemoteSpan } from "@executor-js/telemetry";
+import { Config, Effect, Option, Predicate, Schema } from "effect";
+import { compileCloudApp } from "./app-build.ts";
+import { makeBuildAdmission } from "./build-admission.ts";
+import { compilerPhases } from "./compiler-phases.ts";
+import type { CloudCompiler } from "../contracts/builds.ts";
+const FrameworkAssets = Schema.declare(
+  (value): value is { readonly fetch: (request: Request) => Promise<Response> } =>
+    Predicate.isObject(value) && "fetch" in value && typeof value.fetch === "function",
+);
+const FrameworkFiles = Schema.Record(Schema.String, Schema.String);
+export const compilerRuntime = (env: Readonly<Record<string, unknown>>) =>
+  Effect.gen(function* () {
+    // Framework files are deployment assets. A custom registry is never eligible for reuse.
+    const registry = Option.getOrUndefined(
+      yield* Config.String("EXECUTOR_NPM_REGISTRY").pipe(Config.option),
+    );
+    const version = yield* Config.String("EXECUTOR_APPS_VERSION").pipe(Config.option);
+    const release = yield* Config.String("EXECUTOR_COMPILER_CACHE_RELEASE").pipe(Config.option);
+    const cacheEnabled = env.EXECUTOR_COMPILER_CACHE_ENABLED === "true";
+    const read = Effect.gen(function* () {
+      const assets = yield* Schema.decodeUnknownEffect(FrameworkAssets)(env.ASSETS);
+      const response = yield* Effect.tryPromise(() =>
+        assets.fetch(new Request("https://framework.invalid/framework.json")),
+      );
+      return yield* Schema.decodeUnknownEffect(Schema.fromJsonString(FrameworkFiles))(
+        yield* Effect.tryPromise(() => response.text()),
+      );
+    }).pipe(
+      Effect.mapError(() => new RuntimeBuildFailed({ stage: "dependencies", dependency: "apps" })),
+    );
+    // Only read files are kept for later compiles. A compile that finds none reads them itself:
+    // waiting on another request's read would resume in that request's I/O context, whose timers
+    // are dropped when it ends, and the compile would never finish.
+    let kept: typeof FrameworkFiles.Type | undefined;
+    const files = Effect.suspend(() =>
+      kept !== undefined
+        ? Effect.succeed(kept)
+        : read.pipe(
+            Effect.tap((value) =>
+              Effect.sync(() => {
+                kept = value;
+              }),
+            ),
+          ),
+    );
+    // Two builds still overlap one's npm downloads with the other's bundling, and a build
+    // stalled on the registry leaves the other slot free. The lease starts at admission and
+    // expires when that compile's deadline ends, even if request cleanup never runs.
+    const admitted = makeBuildAdmission(2, compilerCompileBudget, compilerQueueBudget);
+    const isolate = crypto.randomUUID();
+    const host = {
+      ...(registry === undefined ? {} : { registry }),
+      ...(Option.isSome(version) ? { apps: { version: version.value, files } } : {}),
+    };
+    const compile = (
+      files: typeof CodeFiles.Type,
+      publicPaths: ReadonlyArray<string>,
+      headers: Readonly<Record<string, string>>,
+      signal?: AbortSignal,
+    ) =>
+      Effect.suspend(() => {
+        let replied = () => {};
+        let failed = () => {};
+        return Schema.decodeUnknownEffect(
+          Schema.Struct({ files: CodeFiles, publicPaths: Schema.Array(Schema.String) }),
+        )({ files, publicPaths }).pipe(
+          Effect.mapError(() => new RuntimeBuildFailed({ stage: "source" })),
+          Effect.flatMap((input) =>
+            Effect.gen(function* () {
+              const { phase, fingerprint } = yield* compilerPhases(
+                input.files,
+                input.publicPaths,
+                isolate,
+              );
+              replied = () => phase("replied");
+              failed = () => phase("error");
+              return yield* admitted(
+                compileWithinDeadline(
+                  fingerprint.pipe(
+                    Effect.andThen(
+                      compileCloudApp(
+                        input.files,
+                        { ...host, onPhase: phase },
+                        input.publicPaths,
+                        cacheEnabled && registry === undefined
+                          ? Option.getOrUndefined(release)
+                          : undefined,
+                      ),
+                    ),
+                  ),
+                ),
+                phase,
+                signal,
+              );
+            }),
+          ),
+          Effect.tapCause(() => Effect.sync(() => failed())),
+          Effect.map((value) => ({ ok: true as const, value })),
+          Effect.catchTags({
+            BuildBusy: (error) => Effect.succeed({ ok: false as const, error }),
+            RuntimeBuildFailed: (error) => Effect.succeed({ ok: false as const, error }),
+            RuntimeProtocolUnsupported: (error) => Effect.succeed({ ok: false as const, error }),
+            RuntimeAppsDependencyMissing: (error) => Effect.succeed({ ok: false as const, error }),
+          }),
+          Effect.flatMap(Schema.encodeEffect(CloudCompileResult)),
+          Effect.tap(() => Effect.sync(() => replied())),
+          Effect.orDie,
+        );
+      }).pipe(
+        withRemoteSpan(new Request("https://compiler.internal", { headers }), "compiler.compile"),
+      );
+    return {
+      compile,
+      request: () =>
+        Effect.gen(function* () {
+          const { CompilerRequest } = yield* Effect.promise(
+            () => import("./compiler-request-target.ts"),
+          );
