@@ -0,0 +1,176 @@
+/** Private, release-bound reuse of successful compilation. App declarations still run per create. */
+import type { CodeFiles } from "@executor-js/sdk/core";
+import { Effect, Option, Schema } from "effect";
+import { CloudBundle, CompiledCloudApp } from "../contracts/builds.ts";
+
+const Package = Schema.Struct({
+  dependencies: Schema.Record(Schema.String, Schema.String),
+  devDependencies: Schema.optionalKey(Schema.Record(Schema.String, Schema.String)),
+  optionalDependencies: Schema.optionalKey(Schema.Record(Schema.String, Schema.String)),
+  peerDependencies: Schema.optionalKey(Schema.Record(Schema.String, Schema.String)),
+});
+const exactVersion =
+  /^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$/u;
+export const cacheableSource = (files: CodeFiles) => {
+  const manifests = files.filter(
+    ({ path }) => path === "package.json" || path.endsWith("/package.json"),
+  );
+  if (!manifests.some(({ path }) => path === "package.json")) return false;
+  return manifests.every(({ content }) => {
+    const decoded = Schema.decodeUnknownOption(Schema.fromJsonString(Package))(content);
+    return (
+      Option.isSome(decoded) &&
+      Object.values(decoded.value).every(
+        (group) =>
+          group === undefined ||
+          Object.values(group).every((version) => exactVersion.test(version)),
+      )
+    );
+  });
+};
+
+const CachedOutput = Schema.fromJsonString(
+  Schema.Struct({
+    ...CompiledCloudApp.fields,
+    bundle: CloudBundle,
+    ui: Schema.optional(
+      Schema.Array(
+        Schema.Struct({
+          path: Schema.String,
+          contentType: Schema.String,
+          body: Schema.Uint8ArrayFromBase64,
+        }),
+      ),
+    ),
+  }),
+);
+class CacheUnavailable extends Schema.TaggedError<CacheUnavailable>()(
+  "CompilerCacheUnavailable",
+  {},
+) {}
+const attempt = <A>(work: () => Promise<A>) =>
+  Effect.tryPromise({ try: work, catch: () => new CacheUnavailable() });
+const Envelope = Schema.fromJsonString(
+  Schema.Struct({
+    format: Schema.Literal(2),
+    digest: Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/u)),
+    payload: Schema.String,
+  }),
+);
+const digest = (text: string) =>
+  Effect.promise(async () => {
+    const hash = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(text));
+    return Array.from(new Uint8Array(hash), (byte) => byte.toString(16).padStart(2, "0")).join("");
+  });
+const validBundle = (value: typeof CompiledCloudApp.Type) => {
+  const entry = value.bundle.modules[value.bundle.mainModule];
+  const safeName = (name: string) =>
+    name.length > 0 &&
+    !name.startsWith("/") &&
+    !name.split("/").some((part) => part === ".." || part === "." || part === "");
+  return (
+    Object.hasOwn(value.bundle.modules, value.bundle.mainModule) &&
+    (typeof entry === "string" || (entry !== undefined && "js" in entry)) &&
+    [...Object.keys(value.bundle.modules), ...Object.keys(value.framework.modules)].every(safeName)
+  );
+};
+const maximumBytes = 8 * 1024 * 1024;
+const optional = <A, E, R>(work: Effect.Effect<A, E, R>) =>
+  work.pipe(
+    Effect.option,
+    Effect.timeoutOrElse({
+      duration: "250 millis",
+      orElse: () => Effect.succeed(Option.none<A>()),
+    }),
+  );
+
+/** Each caller owns its I/O. No pending promise or request context is shared. */
+export const cachedCompilerResult = <E, R>(
+  input: {
+    readonly files: CodeFiles;
+    readonly publicPaths: ReadonlyArray<string>;
+    readonly release: string | undefined;
+    readonly enabled: boolean;
+    readonly dependencyFiles: ReadonlyArray<{
+      readonly path: string;
+      readonly content: string | null;
+      readonly bytes?: ReadonlyArray<number>;
+    }>;
+    readonly onHit?: () => void;
+  },
+  compile: Effect.Effect<typeof CompiledCloudApp.Type, E, R>,
+) =>
+  Effect.gen(function* () {
+    if (!input.enabled || input.release === undefined || !cacheableSource(input.files))
+      return yield* compile;
+    const cache = yield* optional(
+      attempt(() => caches.open("executor-private-compiler-results-v2")),
+    );
+    if (Option.isNone(cache)) return yield* compile;
+    const key = yield* digest(
+      JSON.stringify([
+        input.release,
+        input.files
+          .map(({ path, content }) => ({ path, content }))
+          .sort((a, b) => a.path.localeCompare(b.path)),
+        [...input.publicPaths].sort(),
+        [...input.dependencyFiles].sort((a, b) => a.path.localeCompare(b.path)),
+      ]),
+    );
+    const url = `https://compiler-cache.invalid/v2/${key}`;
+    const hit = yield* optional(
+      attempt(() => cache.value.match(url)).pipe(
+        Effect.flatMap((response) =>
+          response === undefined
+            ? Effect.fail(new CacheUnavailable())
+            : Effect.gen(function* () {
+                const body = yield* attempt(() => response.text());
+                if (body.length * 2 > maximumBytes) return yield* new CacheUnavailable();
+                const envelope = yield* Schema.decodeUnknownEffect(Envelope)(body);
+                if ((yield* digest(envelope.payload)) !== envelope.digest)
+                  return yield* new CacheUnavailable();
+                const decoded = yield* Schema.decodeUnknownEffect(CachedOutput)(envelope.payload);
+                const value = { ...decoded, ui: decoded.ui };
+                if (!validBundle(value)) return yield* new CacheUnavailable();
+                return value;
+              }),
+        ),
+      ),
+    );
+    yield* Effect.annotateCurrentSpan(
+      "executor.compiler.cache",
+      Option.isSome(hit) ? "hit" : "miss",
+    );
+    if (Option.isSome(hit)) {
+      input.onHit?.();
+      return hit.value;
+    }
+    const value = yield* compile;
+    yield* optional(
+      Schema.encodeEffect(CachedOutput)(value).pipe(
+        Effect.flatMap((payload) =>
+          digest(payload).pipe(
+            Effect.flatMap((hash) =>
+              Schema.encodeEffect(Envelope)({ format: 2, digest: hash, payload }),
+            ),
+          ),
+        ),
+        Effect.flatMap((body) =>
+          body.length * 2 > maximumBytes
+            ? Effect.void
+            : attempt(() =>
+                cache.value.put(
+                  url,
+                  new Response(body, {
+                    headers: {
+                      "content-type": "application/json",
+                      "cache-control": "public, max-age=604800",
+                    },
+                  }),
+                ),
+              ),
+        ),
+      ),
+    );
+    return value;
+  });
