+++ b/scripts/compiler-cache-proof/driver.ts
@@ -0,0 +1,11 @@
+/** Keep native runtime failures attached to the operation the isolated host attempted. */
+import { Effect, Schema } from "effect";
+class CompilerProofFailed extends Schema.TaggedError<CompilerProofFailed>()("CompilerProofFailed", {
+  operation: Schema.String,
+  cause: Schema.Unknown,
+}) {}
+export const driver = <A>(operation: string, run: () => Promise<A>) =>
+  Effect.tryPromise({
+    try: run,
+    catch: (cause) => new CompilerProofFailed({ operation, cause }),
+  });
