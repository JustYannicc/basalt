index 0000000..56c0018
--- /dev/null
+++ b/scripts/compiler-cache-proof/deployment.ts
@@ -0,0 +1,183 @@
+/** Evaluate the real compiler stack and bundle its normal Alchemy RPC entry points. */
+import * as Alchemy from "alchemy";
+import * as Cloudflare from "alchemy/Cloudflare";
+import * as Output from "alchemy/Output";
+import { AlchemyContextLive } from "alchemy/AlchemyContext";
+import { provideFreshArtifactStore } from "alchemy/Artifacts";
+import { layerNonInteractive } from "alchemy/Interaction";
+import { unpackEnvValue } from "alchemy/RuntimeContext";
+import { evalStack } from "alchemy/Stack";
+import { ConfigProvider, Effect, FileSystem, Layer, Path, Redacted, Schema } from "effect";
+import type { WorkerOptions } from "miniflare";
+import CompilerLive from "../../apps/hosted/cloud/src/compiler.ts";
+import Client from "./worker.ts";
+
+interface WorkerProps {
+  readonly main: string;
+  readonly exports?: Record<string, unknown>;
+  readonly build?: object;
+  readonly env?: Record<string, unknown>;
+  readonly assets?: { readonly directory: string };
+}
+const alchemyEntry = import.meta.resolve("alchemy");
+const alchemyModule = (name: string) =>
+  import(
+    new URL(`${name}${alchemyEntry.endsWith(".ts") ? ".ts" : ".js"}`, new URL("./", alchemyEntry))
+      .href
+  );
+const {
+  WorkerBundle,
+}: {
+  readonly WorkerBundle: Effect.Effect<
+    {
+      readonly build: (options: object) => Effect.Effect<
+        {
+          readonly files: ReadonlyArray<{
+            readonly path: string;
+            readonly content: string | Uint8Array;
+          }>;
+        },
+        Error
+      >;
+    },
+    never,
+    FileSystem.FileSystem | Path.Path
+  >;
+} = await alchemyModule("Cloudflare/Workers/Sources/Rolldown");
+const {
+  getCompatibility,
+}: {
+  readonly getCompatibility: (props: WorkerProps) => { date: string; flags: string[] };
+} = await alchemyModule("Cloudflare/Workers/Compatibility");
+
+const stack = Alchemy.Stack(
+  "compiler-cache-proof",
+  {
+    providers: Cloudflare.providers(),
+    state: Alchemy.localState(),
+  },
+  Client.pipe(Effect.provide(CompilerLive)),
+);
+const Binding = Schema.Union([
+  Schema.Struct({
+    type: Schema.Literals(["plain_text", "secret_text"]),
+    name: Schema.String,
+    text: Schema.String,
+  }),
+  Schema.Struct({ type: Schema.Literal("json"), name: Schema.String, json: Schema.Unknown }),
+  Schema.Struct({ type: Schema.Literal("service"), name: Schema.String, service: Schema.String }),
+]);
+const BindingData = Schema.Struct({ bindings: Schema.optional(Schema.Array(Binding)) });
+
+export const compilerCacheDeployment = (
+  stage: string,
+  configuration: Readonly<Record<string, string>>,
+) =>
+  evalStack(
+    stack,
+    (compiled) =>
+      Effect.gen(function* () {
+        const path = yield* Path.Path;
+        const bundler = yield* WorkerBundle;
+        const resources = Object.values(compiled.resources);
+        // Local physical identities replace only Cloudflare-assigned script names.
+        const upstream = Object.fromEntries(
+          resources.map((resource) => [
+            resource.FQN,
+            {
+              workerName: resource.LogicalId,
+            },
+          ]),
+        );
+        const workers: WorkerOptions[] = [];
+        let compilerBindings: Record<string, unknown> | undefined;
+        for (const resource of resources) {
+          if (resource.Type !== "Cloudflare.Worker")
+            return yield* Effect.die(`Unexpected resource in compiler fixture: ${resource.Type}`);
+          const props = resource.Props as WorkerProps;
+          const bundle = yield* bundler.build({
+            id: resource.LogicalId,
+            main: props.main,
+            compatibility: getCompatibility(props),
+            entry: { kind: "effect", exports: props.exports ?? {} },
+            stack: { name: compiled.name, stage: compiled.stage },
+            extraOptions: props.build,
+          });
+          // The same reserved runtime metadata the Worker provider adds on upload.
+          const bindings: Record<string, unknown> = {
+            ALCHEMY_PHASE: "runtime",
+            ALCHEMY_WORKER_NAME: resource.LogicalId,
+            ALCHEMY_STACK_NAME: compiled.name,
+            ALCHEMY_STAGE: compiled.stage,
+            ALCHEMY_CLOUDFLARE_ACCOUNT_ID: "0".repeat(32),
+          };
+          const serviceBindings: Record<string, string> = {};
+          const env = yield* Output.evaluate(props.env ?? {}, upstream);
+          for (const [name, value] of Object.entries(env)) {
+            if (!(name in bindings))
+              bindings[name] = Redacted.isRedacted(value) ? Redacted.value(value) : value;
+          }
+          for (const binding of compiled.bindings[resource.FQN] ?? []) {
+            const data = yield* Schema.decodeUnknownEffect(BindingData)(
+              yield* Output.evaluate(binding.data, upstream),
+            );
+            for (const item of data.bindings ?? []) {
+              if (item.type === "service") serviceBindings[item.name] = item.service;
+              else if (item.type === "json") bindings[item.name] = item.json;
+              else bindings[item.name] = item.text;
+            }
+          }
+          if (resource.LogicalId === "AppCompiler") {
+            if (props.assets?.directory !== configuration.EXECUTOR_APPS_FRAMEWORK)
+              return yield* Effect.die("Compiler did not provision the released framework assets");
+            compilerBindings = bindings;
+          }
+          const modulesRoot = path.resolve(".local/compiler-cache-fixture", resource.LogicalId);
+          workers.push({
+            name: resource.LogicalId,
+            modulesRoot,
+            compatibilityDate: getCompatibility(props).date,
+            compatibilityFlags: getCompatibility(props).flags,
+            bindings,
+            serviceBindings,
+            ...(props.assets === undefined
+              ? {}
+              : { assets: { directory: props.assets.directory, binding: "ASSETS" } }),
+            // Alchemy also excludes source maps from its local executable module list.
+            modules: bundle.files
+              .filter((file) => !file.path.endsWith(".map"))
+              .map((file) => ({
+                type: file.path.endsWith(".wasm")
+                  ? ("CompiledWasm" as const)
+                  : ("ESModule" as const),
+                path: path.resolve(modulesRoot, file.path),
+                contents: file.content,
+              })),
+          });
+        }
+        const client = workers.find((worker) => worker.name === "CompilerCacheClient");
+        if (
+          client?.serviceBindings?.AppCompiler !== "AppCompiler" ||
+          compilerBindings === undefined
+        )
+          return yield* Effect.die("Alchemy did not generate the compiler RPC service binding");
+        const releaseBinding = compilerBindings.EXECUTOR_COMPILER_CACHE_RELEASE;
+        const release =
+          releaseBinding === undefined
+            ? null
+            : unpackEnvValue(Schema.decodeUnknownSync(Schema.String)(releaseBinding));
+        return {
+          workers: [client, ...workers.filter((worker) => worker !== client)],
+          compilerBindings,
+          stage: compiled.stage,
+          release: Redacted.isRedacted(release) ? Redacted.value(release) : release,
+        };
+      }),
+    { stage },
+  ).pipe(
+    Effect.provide(
+      ConfigProvider.layerAdd(ConfigProvider.fromUnknown(configuration), { asPrimary: true }),
+    ),
+    provideFreshArtifactStore,
+    Effect.provide(Layer.mergeAll(AlchemyContextLive, layerNonInteractive(), Alchemy.localState())),
+  );
