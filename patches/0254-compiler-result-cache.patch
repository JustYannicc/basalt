diff --git a/e2e/support/compiler-cache-server.ts b/e2e/support/compiler-cache-server.ts
new file mode 100644
index 0000000..5b0ad83
--- /dev/null
+++ b/e2e/support/compiler-cache-server.ts
@@ -0,0 +1,66 @@
+/** Scoped HTTP adapter to the separately launched production compiler proof host. */
+import { Deferred, Effect, FileSystem, Option, Path, Schema, Stream, Config } from "effect";
+import { ChildProcess, ChildProcessSpawner } from "effect/process";
+import { HttpClient, HttpClientRequest } from "effect/http";
+import { outputLines } from "./alchemy-dev-output.ts";
+
+const Ready = Schema.Struct({
+  type: Schema.Literal("compiler-cache-proof.ready"),
+  port: Schema.Number,
+  version: Schema.String,
+  configuration: Schema.Record(Schema.String, Schema.String),
+});
+export const compilerCacheServer = Effect.gen(function* () {
+  const path = yield* Path.Path;
+  const fs = yield* FileSystem.FileSystem;
+  const processes = yield* ChildProcessSpawner.ChildProcessSpawner;
+  const http = yield* HttpClient.HttpClient;
+  const directory = yield* Config.String("EXECUTOR_E2E_RUN").pipe(Config.option);
+  const ready = yield* Deferred.make<typeof Ready.Type>();
+  const child = yield* processes.spawn(
+    ChildProcess.make("node", [path.resolve("scripts/compiler-cache-proof/main.ts")], {
+      stdout: "pipe",
+      stderr: "pipe",
+      killSignal: "SIGTERM",
+      forceKillAfter: "15 seconds",
+    }),
+  );
+  yield* outputLines(child).pipe(
+    Stream.runForEach((line) =>
+      Effect.gen(function* () {
+        if (Option.isSome(directory))
+          yield* fs.writeFileString(
+            path.join(directory.value, "compiler-cache-host.log"),
+            `${line}\n`,
+            { flag: "a" },
+          );
+        if (!line.startsWith('{"type":"compiler-cache-proof.ready"')) return;
+        const value = yield* Schema.decodeUnknownEffect(Schema.fromJsonString(Ready))(line);
+        yield* Deferred.succeed(ready, value);
+      }),
+    ),
+    Effect.forkScoped,
+  );
+  const started = yield* Deferred.await(ready).pipe(
+    Effect.raceFirst(
+      child.exitCode.pipe(
+        Effect.flatMap((code) =>
+          Effect.die(`Compiler proof host exited before readiness (${code})`),
+        ),
+      ),
+    ),
+  );
+  const request = (route: string, input?: unknown) =>
+    Effect.gen(function* () {
+      const configured = yield* HttpClientRequest.bodyJson(
+        HttpClientRequest.post(`http://127.0.0.1:${started.port}${route}`),
+        input ?? {},
+      );
+      const response = yield* http.execute(configured);
+      const text = yield* response.text;
+      if (response.status !== 200)
+        return yield* Effect.die(`Compiler proof host returned ${response.status}: ${text}`);
+      return yield* Schema.decodeUnknownEffect(Schema.fromJsonString(Schema.Unknown))(text);
+    });
+  return { request, version: started.version, configuration: started.configuration };
+});
