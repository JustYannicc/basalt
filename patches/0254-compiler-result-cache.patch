new file mode 100644
index 0000000..1829fad
--- /dev/null
+++ b/e2e/support/compiler-cache-server.ts
@@ -0,0 +1,89 @@
+/** Bundle and run the production compiler service in real workerd, with its released asset binding. */
+import { createRequire } from "node:module";
+import { build } from "esbuild";
+import { Miniflare, Response as RuntimeResponse } from "miniflare";
+import { Effect, FileSystem, Path, Schema } from "effect";
+import { driver } from "./platform.ts";
+
+export const compilerCacheServer = Effect.gen(function* () {
+  const path = yield* Path.Path;
+  const fs = yield* FileSystem.FileSystem;
+  const root = path.resolve(".");
+  const framework = path.join(root, ".local/basalt-framework");
+  const assets = yield* fs.readFileString(path.join(framework, "framework.json"));
+  const packageFiles = JSON.parse(assets);
+  const version: string = JSON.parse(packageFiles["package.json"]).version;
+  const configuration = {
+    ALCHEMY_STAGE: "production",
+    EXECUTOR_COMPILER_CACHE_RELEASE: "a".repeat(40),
+    EXECUTOR_APPS_FRAMEWORK: framework,
+    EXECUTOR_COMPILER_CACHE_FRAMEWORK: framework,
+    EXECUTOR_APPS_VERSION: version,
+    EXECUTOR_COMPILER_CACHE_APPS_VERSION: version,
+  };
+  const outdir = path.join(root, ".local/compiler-cache-fixture");
+  const bundle = yield* driver("bundle real compiler fixture", () =>
+    build({
+      entryPoints: [path.join(root, "e2e/fixtures/compiler-cache-worker.ts")],
+      outdir,
+      bundle: true,
+      format: "esm",
+      platform: "browser",
+      conditions: ["workerd"],
+      target: "es2023",
+      write: false,
+      external: ["cloudflare:*", "node:*"],
+      loader: { ".wasm": "copy" },
+    }),
+  );
+  const loaded = Schema.decodeUnknownSync(
+    Schema.Union([Schema.String, Schema.Struct({ default: Schema.String })]),
+  )(createRequire(import.meta.url)("workerd"));
+  const workerd = typeof loaded === "string" ? loaded : loaded.default;
+  const previousWorkerd = process.env.MINIFLARE_WORKERD_PATH;
+  yield* Effect.acquireRelease(
+    Effect.sync(() => {
+      process.env.MINIFLARE_WORKERD_PATH = workerd;
+    }),
+    () =>
+      Effect.sync(() => {
+        if (previousWorkerd === undefined) delete process.env.MINIFLARE_WORKERD_PATH;
+        else process.env.MINIFLARE_WORKERD_PATH = previousWorkerd;
+      }),
+  );
+  const runtime = yield* Effect.acquireRelease(
+    Effect.sync(
+      () =>
+        new Miniflare({
+          compatibilityDate: "2026-09-08",
+          compatibilityFlags: ["nodejs_compat"],
+          modules: [...bundle.outputFiles]
+            .sort((a, b) => Number(a.path.endsWith(".wasm")) - Number(b.path.endsWith(".wasm")))
+            .map((file) => ({
+              type: file.path.endsWith(".wasm") ? ("CompiledWasm" as const) : ("ESModule" as const),
+              path: file.path,
+              contents: file.contents,
+            })),
+          modulesRoot: outdir,
+          bindings: { CONFIGURATION: JSON.stringify(configuration) },
+          serviceBindings: {
+            ASSETS: () =>
+              new RuntimeResponse(assets, { headers: { "content-type": "application/json" } }),
+          },
+        }),
+    ),
+    (runtime) => driver("dispose compiler fixture", () => runtime.dispose()).pipe(Effect.orDie),
+  );
+  const request = (route: string, input?: unknown) =>
+    driver("request real compiler fixture", async () => {
+      const response = await runtime.dispatchFetch(`http://compiler-fixture.local${route}`, {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify(input ?? {}),
+      });
+      if (response.status !== 200)
+        throw new Error(`Compiler fixture returned ${response.status}: ${await response.text()}`);
+      return response.json();
+    });
+  return { request, version, configuration };
+});
