diff --git a/packages/apps/src/contracts/protocols/drive-before-devices.ts b/packages/apps/src/contracts/protocols/drive-before-devices.ts
new file mode 100644
--- /dev/null
+++ b/packages/apps/src/contracts/protocols/drive-before-devices.ts
@@ -0,0 +1,104 @@
+/**
+ * The drive commands of protocols 38 to 40, frozen. Protocol 41 adds `devices` and a `path` on
+ * history; released protocols keep exactly this union.
+ */
+import { Schema } from "effect";
+import { bound, oid } from "../drive-values.ts";
+import { NativeWorkflowRpcCommand } from "../workflows.ts";
+import {
+  DriveApplyInput,
+  DriveAttachmentInput,
+  DriveChangeCommand,
+  DriveImportCommand,
+  DriveListInput,
+  DriveMoveInput,
+  DriveReadInput,
+  DriveReceiptInput,
+  DriveRemoveInput,
+  DriveResolveInput,
+  DriveRestoreInput,
+  DriveSearchInput,
+  DriveUploadCommand,
+  DriveWriteInput,
+} from "../drive.ts";
+
+const historyInput = Schema.Struct({
+  at: Schema.optionalKey(oid),
+  limit: Schema.optionalKey(bound(100)),
+});
+
+export const DriveCommand = Schema.Union([
+  DriveImportCommand,
+  DriveUploadCommand,
+  DriveChangeCommand,
+  Schema.Struct({
+    operation: Schema.Literal("drive"),
+    method: Schema.Literal("apply"),
+    input: DriveApplyInput,
+  }),
+  Schema.Struct({
+    operation: Schema.Literal("drive"),
+    method: Schema.Literal("attachment"),
+    input: DriveAttachmentInput,
+  }),
+  Schema.Struct({
+    operation: Schema.Literal("drive"),
+    method: Schema.Literal("receipt"),
+    input: DriveReceiptInput,
+  }),
+  Schema.Struct({
+    operation: Schema.Literal("drive"),
+    method: Schema.Literal("resolve"),
+    input: DriveResolveInput,
+  }),
+  Schema.Struct({
+    operation: Schema.Literal("drive"),
+    method: Schema.Literal("list"),
+    input: DriveListInput,
+  }),
+  Schema.Struct({
+    operation: Schema.Literal("drive"),
+    method: Schema.Literal("read"),
+    input: DriveReadInput,
+  }),
+  Schema.Struct({
+    operation: Schema.Literal("drive"),
+    method: Schema.Literal("search"),
+    input: DriveSearchInput,
+  }),
+  Schema.Struct({
+    operation: Schema.Literal("drive"),
+    method: Schema.Literal("history"),
+    input: historyInput,
+  }),
+  Schema.Struct({
+    operation: Schema.Literal("drive"),
+    method: Schema.Literal("write"),
+    input: DriveWriteInput,
+  }),
+  Schema.Struct({
+    operation: Schema.Literal("drive"),
+    method: Schema.Literal("move"),
+    input: DriveMoveInput,
+  }),
+  Schema.Struct({
+    operation: Schema.Literal("drive"),
+    method: Schema.Literal("remove"),
+    input: DriveRemoveInput,
+  }),
+  Schema.Struct({
+    operation: Schema.Literal("drive"),
+    method: Schema.Literal("restore"),
+    input: DriveRestoreInput,
+  }),
+]);
+
+/** Workflow steps of protocols 38 to 40 carry the drive commands above. */
+export const DriveWorkflowRpcCommand = Schema.Union([
+  Schema.Struct({
+    operation: Schema.Literal("drive"),
+    stepId: Schema.NonEmptyString,
+    command: DriveCommand,
+  }),
+  NativeWorkflowRpcCommand,
+]);
