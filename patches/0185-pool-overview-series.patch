@@ -0,0 +1,54 @@
+import { AccountId, AppId } from "@executor-js/sdk/core";
+import { Schema } from "effect";
+
+const hash = Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/u));
+const count = Schema.Int.check(Schema.isBetween({ minimum: 0, maximum: 500 }));
+
+export const PoolOverviewOffering = Schema.Literals([
+  "subscription",
+  "metered_api",
+  "prepaid",
+  "other",
+  "unknown",
+]);
+export type PoolOverviewOffering = typeof PoolOverviewOffering.Type;
+
+export const PoolOverviewInput = Schema.Struct({
+  from: Schema.NonEmptyString,
+  to: Schema.NonEmptyString,
+  days: Schema.Literals([7, 30]),
+});
+export type PoolOverviewInput = typeof PoolOverviewInput.Type;
+
+const Directory = Schema.Struct({
+  members: Schema.Array(
+    Schema.Struct({
+      person: hash,
+      displayName: Schema.String.check(Schema.isMaxLength(256)),
+      active: Schema.Boolean,
+    }),
+  ).check(Schema.isMaxLength(500)),
+  activeCount: count,
+  totalCount: count,
+});
+
+const Authority = Schema.Struct({
+  canManage: Schema.Literal(true),
+  accounts: Schema.Array(
+    Schema.Struct({
+      account: Schema.NullOr(AccountId),
+      history: Schema.Array(hash).check(Schema.isMaxLength(32)),
+      offering: PoolOverviewOffering,
+    }),
+  ).check(Schema.isMaxLength(500)),
+  mappingProven: Schema.Boolean,
+});
+
+/** Exact signed input sent to the native pool overview endpoint. */
+export const PoolOverviewSignedInput = Schema.Struct({
+  ...PoolOverviewInput.fields,
+  pool: AppId,
+  directory: Directory,
+  authority: Authority,
+});
+export type PoolOverviewSignedInput = typeof PoolOverviewSignedInput.Type;
diff --git a/apps/hosted/server/src/implementation/pool-usage-overview.ts b/apps/hosted/server/src/implementation/pool-usage-overview.ts
new file mode 100644
index 0000000..86447bd
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-usage-overview.ts
@@ -0,0 +1,141 @@
+import {
+  AppId,
+  StorageError,
+  identifyProvider,
+} from "@executor-js/sdk/core";
+import { Crypto, Effect, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import { providerDeclaration } from "apps/host";
+import { Principal } from "../contracts/auth.ts";
+import { HostedExecutor } from "../contracts/executor.ts";
+import {
+  PoolOverviewOffering,
+  PoolOverviewSignedInput,
+  type PoolOverviewInput,
+} from "../contracts/pool-usage-overview.ts";
+import { nativePoolMembership } from "./pool-membership.ts";
+import { policyDatabase } from "./resource-policy.ts";
+import { usageSeriesAccounts } from "./pool-usage-series-accounts.ts";
+import { providers } from "./pool-provider-definitions.ts";
+
+const DirectoryPerson = Schema.Struct({
+  user: Principal.fields.userId,
+  displayName: Schema.String,
+});
+const digest = async (value: string) => {
+  const bytes = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(value));
+  return Array.from(new Uint8Array(bytes), (byte) => byte.toString(16).padStart(2, "0")).join("");
+};
+
+type Pool = {
+  readonly pool: AppId;
+  readonly organization: string;
+  readonly users: readonly string[];
+};
+
+/** Offerings are hints in an exact provider declaration, never inferred from its auth mechanism. */
+const providerOfferings = Effect.gen(function* () {
+  const cryptoService = yield* Crypto.Crypto;
+  const declared = yield* Effect.forEach(Object.entries(providers), ([lab, provider]) =>
+    Effect.gen(function* () {
+      const definition = yield* providerDeclaration(provider);
+      const identified = yield* identifyProvider(definition, cryptoService);
+      return Object.keys(definition.auth).map((method) => ({
+        lab,
+        provider: identified.identity,
+        method,
+        offering: definition.family?.methods?.[method]?.offering ?? "unknown",
+      }));
+    }),
+  );
+  const candidates = declared.flat().sort(
+    (left, right) => left.lab.localeCompare(right.lab) || left.method.localeCompare(right.method),
+  );
+  const byBinding = new Map<string, Set<PoolOverviewOffering>>();
+  for (const entry of candidates) {
+    const key = JSON.stringify([entry.provider, entry.method]);
+    const found = byBinding.get(key) ?? new Set<PoolOverviewOffering>();
+    found.add(entry.offering);
+    byBinding.set(key, found);
+  }
+  return new Map(
+    [...byBinding].map(([key, values]) => {
+      const [offering] = values;
+      return [
+        key,
+        values.size === 1 && offering !== undefined && offering !== "unknown"
+          ? offering
+          : "unknown",
+      ] as const;
+    }),
+  );
+});
+
+/** Construct and validate the host-only identity authority for one signed overview read. */
+export const poolOverviewSignedInput = (pool: Pool, input: PoolOverviewInput) =>
+  Effect.gen(function* () {
+    const users = [...new Set(pool.users)].sort();
+    if (users.length > 500) return yield* new StorageError();
+    const sql = yield* policyDatabase;
+    const rows =
+      users.length === 0
+        ? []
+        : yield* sql`select m."userId" as "user", coalesce(u.name, '') as "displayName"
+            from member m join "user" u on u.id = m."userId"
+            where m."organizationId" = ${pool.organization}
+              and ${sql.in("m.userId", users)}
+            order by m."userId"`;
+    const people = yield* Schema.decodeUnknownEffect(Schema.Array(DirectoryPerson))(rows);
+    const members = yield* Effect.forEach(people, (person) =>
+      Effect.tryPromise(() => digest(person.user)).pipe(
+        Effect.mapError(() => new StorageError()),
+        Effect.map((personHash) => ({
+          person: personHash,
+          displayName: person.displayName,
+          active: true as const,
+        })),
+      ),
+    );
+
+    const executor = yield* Effect.flatten(HostedExecutor);
+    const membership = yield* nativePoolMembership(pool.organization, pool.pool, executor).pipe(
+      Effect.provideService(SqlClient.SqlClient, sql),
+    );
+    const history = yield* usageSeriesAccounts(pool, undefined);
+    const bindingByAccount = new Map<string, { readonly provider: string; readonly method: string }>();
+    const conflictingBindings = new Set<string>();
+    for (const account of membership.accounts) {
+      const previous = bindingByAccount.get(account.account);
+      if (previous === undefined) {
+        bindingByAccount.set(account.account, { provider: account.provider, method: account.method });
+      } else if (previous.provider !== account.provider || previous.method !== account.method) {
+        conflictingBindings.add(account.account);
+      }
+    }
+    const nativeAccounts = new Set(bindingByAccount.keys());
+    const namedAccounts = history.flatMap((entry) => entry.account === null ? [] : [entry.account]);
+    const mappingProven =
+      membership.native &&
+      conflictingBindings.size === 0 &&
+      history.length === nativeAccounts.size &&
+      new Set(namedAccounts).size === namedAccounts.length &&
+      namedAccounts.every((account) => nativeAccounts.has(account));
+    const offerings = yield* providerOfferings;
+    const accounts = history.map((entry) => {
+      if (entry.account === null) return { ...entry, offering: "unknown" as const };
+      const binding = bindingByAccount.get(entry.account);
+      const key = binding === undefined ? undefined : JSON.stringify([binding.provider, binding.method]);
+      const offering =
+        binding === undefined || conflictingBindings.has(entry.account) || key === undefined
+          ? "unknown"
+          : offerings.get(key) ?? "unknown";
+      return { ...entry, offering };
+    });
+
+    return yield* Schema.decodeUnknownEffect(PoolOverviewSignedInput)({
+      ...input,
+      pool: pool.pool,
+      directory: { members, activeCount: members.length, totalCount: members.length },
+      authority: { canManage: true, accounts, mappingProven },
+    });
+  });
