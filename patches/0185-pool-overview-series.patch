diff --git a/apps/hosted/server/src/implementation/pool-app-ui.ts b/apps/hosted/server/src/implementation/pool-app-ui.ts
new file mode 100644
index 0000000..ad42ca1
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-app-ui.ts
@@ -0,0 +1,63 @@
+/** App-origin transport reuses the native pool policy and signed usage service. */
+import type { App } from "@executor-js/sdk/core";
+import { VersionId } from "@executor-js/sdk/core";
+import { fullAuthority } from "@executor-js/authorization";
+import { appPrivateHeaders } from "apps/ui/auth";
+import { UiForbidden, UiUnauthorized } from "apps/ui/contracts";
+import { Effect, Schema } from "effect";
+import { HttpServerRequest, HttpServerResponse } from "effect/http";
+import { CurrentAuthorization } from "../contracts/authorization.ts";
+import { CurrentUserId } from "../contracts/auth.ts";
+import {
+  CurrentOrganization,
+  OrganizationForbidden,
+  type OrganizationAccess,
+} from "../contracts/organization.ts";
+import { PoolUsageSeriesInput } from "../contracts/pool-usage-series.ts";
+import { poolUsageSeries } from "./pool-usage.ts";
+
+export const poolAppUsagePath = "/_executor/api/pool-usage/series";
+const Request = Schema.Struct({ version: VersionId, input: PoolUsageSeriesInput });
+const json = (body: unknown, status = 200) =>
+  HttpServerResponse.jsonUnsafe(body, { status, headers: appPrivateHeaders });
+
+/** The origin resolves the app and viewer. Request input cannot supply another pool or identity. */
+export const poolAppUsage = <E, R>(
+  authorize: Effect.Effect<
+    {
+      readonly app: Pick<App, "id" | "activeVersion">;
+      readonly access: OrganizationAccess & { readonly userId: string };
+    },
+    E,
+    R
+  >,
+) =>
+  Effect.gen(function* () {
+    const current = yield* authorize;
+    if (typeof current.access.userId !== "string" || !current.access.userId)
+      return json({ _tag: "UiUnauthorized" }, 401);
+    const payload = yield* HttpServerRequest.schemaBodyJson(Request).pipe(
+      Effect.catch(() => Effect.succeed(undefined)),
+    );
+    if (payload === undefined)
+      return json(
+        { error: "invalid_query", message: "Provide usage bounds and this page's version." },
+        400,
+      );
+    if (payload.version !== current.app.activeVersion)
+      return json({ _tag: "UiDeploymentChanged" }, 409);
+    const result = yield* poolUsageSeries(current.app.id, payload.input).pipe(
+      Effect.provideService(CurrentOrganization, current.access),
+      Effect.provideService(CurrentUserId, current.access.userId),
+      Effect.provideService(CurrentAuthorization, fullAuthority),
+    );
+    return json(result);
+  }).pipe(
+    Effect.catch((error) => {
+      if (Schema.is(UiUnauthorized)(error))
+        return Effect.succeed(json({ _tag: "UiUnauthorized" }, 401));
+      if (Schema.is(UiForbidden)(error) || Schema.is(OrganizationForbidden)(error))
+        return Effect.succeed(json({ _tag: "UiForbidden" }, 403));
+      return Effect.succeed(json({ _tag: "UiFailed", reason: "unavailable" }, 503));
+    }),
+  );
