diff --git a/packages/ui/src/implementation/dashboard/moment-format.ts b/packages/ui/src/implementation/dashboard/moment-format.ts
new file mode 100644
index 000000000..2fd84e704
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/moment-format.ts
@@ -0,0 +1,69 @@
+/**
+ * Every date and time a person reads, in one shape: day-month-year on a 24-hour clock, such as
+ * "21.11.2026 14:30", whatever order or clock the reader's locale would pick. Intl does the
+ * calendar and time-zone work; only the order and separators are fixed here, so a server render
+ * and the browser that hydrates it print the same text for the same zone.
+ *
+ * Pure, with no imports, and kept beside `account-observation-text.ts` so the pool app packages
+ * both and writes moments exactly as the host does.
+ */
+
+/** Where a moment is read; structurally the host's `DisplayFormat`. */
+export interface MomentZone {
+  readonly timeZone: string;
+}
+
+const dateOptions = ["weekday", "era", "year", "month", "day", "dateStyle"] as const;
+const timeOptions = [
+  "hour",
+  "minute",
+  "second",
+  "fractionalSecondDigits",
+  "dayPeriod",
+  "timeStyle",
+] as const;
+
+/**
+ * `options` choose which parts show, never their order or clock: any date field shows the date,
+ * any time field the time, `second` or a medium or longer `timeStyle` the seconds, and
+ * `timeZoneName` or a long `timeStyle` the zone. No options, or none of these, show both.
+ */
+export const formatMoment = (
+  value: Date | number | string,
+  zone: MomentZone,
+  options?: Intl.DateTimeFormatOptions,
+) => {
+  const at = new Date(value);
+  if (Number.isNaN(at.getTime())) return String(at);
+  const asked = (keys: readonly (keyof Intl.DateTimeFormatOptions)[]) =>
+    keys.some((key) => options?.[key] !== undefined);
+  const long = options?.timeStyle === "long" || options?.timeStyle === "full";
+  const seconds = options?.second !== undefined || options?.timeStyle === "medium" || long;
+  const named = options?.timeZoneName !== undefined || long;
+  const date = asked(dateOptions);
+  const time = asked(timeOptions);
+  const parts = new Intl.DateTimeFormat("en-GB", {
+    timeZone: options?.timeZone ?? zone.timeZone,
+    calendar: "gregory",
+    numberingSystem: "latn",
+    hourCycle: "h23",
+    day: "2-digit",
+    month: "2-digit",
+    year: "numeric",
+    hour: "2-digit",
+    minute: "2-digit",
+    second: "2-digit",
+    ...(named ? { timeZoneName: "short" } : {}),
+  }).formatToParts(at);
+  const part = (type: Intl.DateTimeFormatPartTypes) =>
+    parts.find((entry) => entry.type === type)?.value ?? "";
+  return [
+    date || !time ? `${part("day")}.${part("month")}.${part("year")}` : undefined,
+    time || !date
+      ? `${part("hour")}:${part("minute")}${seconds ? `:${part("second")}` : ""}`
+      : undefined,
+    named ? part("timeZoneName") : undefined,
+  ]
+    .filter((text) => text !== undefined)
+    .join(" ");
+};
