diff --git a/e2e/tests/resource-prefetch.spec.ts b/e2e/tests/resource-prefetch.spec.ts
new file mode 100644
index 0000000..f799324
--- /dev/null
+++ b/e2e/tests/resource-prefetch.spec.ts
@@ -0,0 +1,118 @@
+import { expect, layer } from "@effect/vitest";
+import { Deferred, Effect } from "effect";
+import { randomUUID } from "node:crypto";
+import type { Request } from "playwright";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { App } from "../support/contracts.ts";
+import { Evidence } from "../support/evidence.ts";
+import { openInApp } from "../support/in-app-navigation.ts";
+import { holdQuery, installBrowserClock } from "../support/query-transition.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Organization resource prefetch", (it) => {
+  it.effect(scenarios.resourcePrefetch.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const actors = yield* Actors;
+        const api = yield* Api;
+        const browser = yield* Browser;
+        const evidence = yield* Evidence;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const name = `Prefetched ${randomUUID().slice(0, 8)}`;
+        const response = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name,
+          files: [
+            {
+              path: "index.ts",
+              content: 'import { defineApp } from "apps"; export default defineApp({}, {});',
+            },
+            appsManifest,
+          ],
+        });
+        expect(response.status).toBe(200);
+        const app = yield* body(App, response);
+        yield* Effect.addFinalizer(() =>
+          api.request(actors.owner, "DELETE", `${prefix}/apps/${app.id}`).pipe(
+            Effect.tap((result) => Effect.sync(() => expect(result.status).toBe(200))),
+            Effect.orDie,
+          ),
+        );
+        yield* browser.login(actors.owner);
+        yield* installBrowserClock;
+        let completed = yield* Deferred.make<void>();
+        const requests: string[] = [];
+        const resources = /^\/api\/organizations\/[^/]+\/resources$/;
+        const record = (request: Request) => {
+          const path = new URL(request.url()).pathname;
+          if (request.method() === "GET" && resources.test(path)) requests.push(path);
+        };
+        const finished = (request: Request) => {
+          if (resources.test(new URL(request.url()).pathname))
+            Deferred.doneUnsafe(completed, Effect.void);
+        };
+        yield* browser.use("Observe the ordinary resource read", (page) => {
+          page.on("request", record);
+          page.on("requestfinished", finished);
+          return Promise.resolve();
+        });
+        yield* Effect.addFinalizer(() =>
+          browser
+            .use("Remove resource observers", (page) => {
+              page.off("request", record);
+              page.off("requestfinished", finished);
+              return Promise.resolve();
+            })
+            .pipe(Effect.orDie),
+        );
+        const held = yield* holdQuery(resources, "continue");
+        const organization = `/org/${actors.organization.slug}`;
+        yield* browser.use("Enter organization settings", (page) =>
+          page.goto(`${organization}/organization`),
+        );
+        yield* held.requested;
+        yield* browser.use("Settings stay usable while prefetch waits", (page) =>
+          page.getByRole("table", { name: "Members", exact: true }).waitFor(),
+        );
+        expect(requests).toEqual([`${prefix}/resources`]);
+        yield* held.release;
+        yield* Deferred.await(completed);
+        yield* openInApp("Open the prefetched Apps list", `${organization}/apps`);
+        yield* browser.use("The prefetched directory supplies the app card", (page) =>
+          page.getByText(name, { exact: true }).first().waitFor(),
+        );
+        expect(requests).toHaveLength(1);
+        yield* evidence.json("resource-prefetch-navigation.json", { requests });
+        // A new document has never visited Apps, so route-intent preloads cannot keep its poll alive.
+        completed = yield* Deferred.make<void>();
+        const unused = yield* holdQuery(resources, "continue");
+        yield* browser.use("Start an independent settings-only document", (page) =>
+          page.goto(`${organization}/organization`),
+        );
+        yield* unused.requested;
+        yield* unused.release;
+        yield* Deferred.await(completed);
+        expect(requests).toHaveLength(2);
+        yield* browser.use("Advance beyond two idle directory polls", (page) =>
+          page.context().clock.runFor(60_001),
+        );
+        expect(requests).toHaveLength(2);
+        yield* openInApp(
+          "Enter an organization without access",
+          `/org/prefetch-missing-${randomUUID()}/organization`,
+        );
+        yield* browser.use("A refused entry stays refused", (page) =>
+          page.getByText("Organization unavailable", { exact: true }).waitFor(),
+        );
+        yield* browser.use("A refused destination starts no directory poll", (page) =>
+          page.context().clock.runFor(60_001),
+        );
+        expect(requests).toHaveLength(2);
+      }),
+    ),
+  );
+});
