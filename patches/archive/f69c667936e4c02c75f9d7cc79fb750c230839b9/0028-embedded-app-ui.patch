+                page
+                  .getByRole("navigation", { name: "App navigation" })
+                  .getByRole("link", { name: "App", exact: true })
+                  .count(),
+                page.locator("iframe").count(),
+              ]),
+            )
+            .then((counts) => {
+              expect(counts).toEqual([0, 0]);
+              expect(adminLocationReads).toBe(0);
+            })
+            .finally(() => page.off("request", count));
+        });
+      }),
+    ),
+  );
+});
