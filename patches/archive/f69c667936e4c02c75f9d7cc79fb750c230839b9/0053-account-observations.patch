+
+layer(HostedLive, { excludeTestServices: true })("Optional observation protocol", (it) => {
+  for (const { scenario, retained } of [
+    { scenario: scenarios.accountObservationProtocol, retained: protocol17Framework },
+    { scenario: scenarios.accountObservationProtocol18, retained: protocol18Framework },
+  ]) {
+    it.effect(scenario.title, (context) =>
+      withHostedCase(
+        context,
+        Effect.gen(function* () {
+          const framework = yield* retained;
+          const f = yield* observationFixture({ observe: true, health: true, framework });
+          expect((yield* f.check()).body).toMatchObject({
+            apps: [{ check: { status: "healthy" } }],
+          });
+          const tool = yield* f.api.request(f.actors.owner, "POST", `${f.appPath}/tools/call`, {
+            tool: "ping",
+            kind: "query",
+            input: {},
+          });
+          expect(tool.status, JSON.stringify(tool.body)).toBe(200);
+          expect(tool.body).toBe(true);
+          const refreshed = yield* f.refresh();
+          expect(refreshed.status, JSON.stringify(refreshed.body)).toBe(200);
+          expect(refreshed.body).toMatchObject({ reports: [] });
+          expect(yield* f.backend.calls).toBe(0);
