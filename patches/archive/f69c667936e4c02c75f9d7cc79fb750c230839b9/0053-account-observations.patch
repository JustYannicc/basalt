+
+/** Advertise a compatible bundle as retained to exercise refusal before dispatch. */
+const retainedObservationFramework = (protocol: 17 | 18) =>
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem,
+      path = yield* Path.Path;
+    const processes = yield* ChildProcessSpawner.ChildProcessSpawner;
+    const directory = yield* fs.makeTempDirectoryScoped();
+    const extracted = path.join(directory, "retained");
+    yield* fs.makeDirectory(extracted);
+    yield* processes.string(
+      ChildProcess.make("tar", ["-xzf", ".local/test-runtime/apps.tgz", "-C", extracted]),
+    );
+    const runtimeFile = path.join(extracted, "package", "runtime.json");
+    const runtime = yield* fs
+      .readFileString(runtimeFile)
+      .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Schema.fromJsonString(RuntimePackage))));
+    yield* fs.writeFileString(runtimeFile, JSON.stringify({ ...runtime, protocol }));
+    const { base, archives } = yield* loopbackArchives;
+    const route = `/protocol${protocol}.tgz`;
+    archives.set(route, yield* packDirectory(path.join(extracted, "package"), directory));
+    return `${base}${route}`;
+  });
+
+export const protocol17Framework = retainedObservationFramework(17);
+export const protocol18Framework = retainedObservationFramework(18);
