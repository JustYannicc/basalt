index 0000000000000000000000000000000000000000..26b3d27638e63822a6b489f137bd0382ba362254
--- /dev/null
+++ b/e2e/tests/contributed-app-departures.spec.ts
@@ -0,0 +1,213 @@
+/** Departure snapshots detach contributions without deleting their reusable accounts. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schedule, Schema } from "effect";
+import { body } from "../support/api.ts";
+import { ok } from "../support/app-links.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { RuntimeLive, Target } from "../support/platform.ts";
+import { contributedApp } from "../support/contributed-app.ts";
+import { cloudLocks } from "../support/cloud-locks.ts";
+import { Evidence } from "../support/evidence.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(RuntimeLive, { excludeTestServices: true })("Contributed departures", (it) => {
+  it.effect(scenarios.contributedAppDepartures.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* contributedApp;
+        const { api, actors, prefix } = f;
+        const personal = yield* f.connect(
+          actors.admin,
+          "app",
+          "shared",
+          "Departing personal account",
+        );
+        const shared = yield* f.connect(actors.admin, "app", "shared", "Departing shared account", {
+          kind: "shared",
+          audience: { kind: "everyone" },
+        });
+        const ordinary = yield* f.connect(
+          actors.admin,
+          "app",
+          "ordinary",
+          "Ordinary personal account",
+        );
+        const admin = yield* body(
+          Schema.Struct({ user: Schema.Struct({ email: Schema.String }) }),
+          yield* api.request(actors.admin, "GET", "/api/auth/get-session"),
+        );
+        const target = yield* Target;
+        const evidence = yield* Evidence;
+        const locks =
+          target.metadata.target === "cloud" && target.metadata.mode === "managed"
+            ? yield* cloudLocks
+            : undefined;
+        const departure = (status: "queued" | "succeeded") =>
+          locks === undefined
+            ? Effect.succeed([])
+            : locks
+                .run({
+                  sql: "SELECT id, status, attempts FROM hosted_contributed_departure_jobs WHERE organization_id = $1 AND user_id = $2",
+                  params: [actors.organization.id, f.ids.admin],
+                })
+                .pipe(
+                  Effect.flatMap(
+                    Schema.decodeUnknownEffect(
+                      Schema.Array(
+                        Schema.Struct({
+                          id: Schema.String,
+                          status: Schema.String,
+                          attempts: Schema.Number,
+                        }),
+                      ),
+                    ),
+                  ),
+                  Effect.repeat({
+                    schedule: Schedule.spaced("100 millis"),
+                    while: (jobs) =>
+                      jobs.length !== 1 ||
+                      jobs[0]?.status !== status ||
+                      (jobs[0]?.attempts ?? 0) < 1,
+                  }),
+                  Effect.timeout("15 seconds"),
+                );
+        // Force the contention seen when a connection's background hook still holds the app.
+        if (locks !== undefined)
+          yield* locks.hold({
+            sql: "SELECT id FROM executor_apps WHERE id = $1 FOR NO KEY UPDATE",
+            params: [f.app.id],
+          });
+        yield* ok(
+          yield* api.request(actors.owner, "POST", "/api/auth/organization/remove-member", {
+            organizationId: actors.organization.id,
+            memberIdOrEmail: admin.user.email,
+          }),
+        );
+        if (locks !== undefined) {
+          const queued = yield* evidence.step(
+            "Lock contention persists a queued departure retry",
+            departure("queued"),
+          );
+          expect(queued[0]?.attempts).toBeGreaterThanOrEqual(1);
+          yield* evidence.json("queued-departure.json", queued);
+          yield* locks.release;
+        }
+        yield* f.waitForLinks([ordinary]);
+        if (locks !== undefined) {
+          const completed = yield* evidence.step(
+            "The released departure retry reaches persisted success",
+            departure("succeeded"),
+          );
+          expect(completed[0]?.attempts).toBeGreaterThanOrEqual(2);
+          yield* evidence.json("completed-departure.json", completed);
+        }
+        expect((yield* f.call(actors.owner, "accounts")).body).toMatchObject({ shared: [] });
+        yield* f.rejoin(actors.admin);
+        for (const account of [personal, shared]) {
+          yield* ok(yield* api.request(actors.admin, "GET", `${prefix}/accounts/${account}`));
+          yield* ok(yield* f.link(actors.admin, "shared", account));
+        }
+        expect((yield* f.call(actors.owner, "accounts")).body).toMatchObject({
+          shared: [personal, shared],
+        });
+        yield* ok(yield* f.unlink(actors.admin, "shared", personal));
+        yield* ok(yield* f.unlink(actors.admin, "shared", shared));
+        const own = yield* f.connect(actors.member, "app", "shared", "Leaving member's account");
+        yield* ok(
+          yield* api.request(actors.member, "POST", "/api/auth/organization/leave", {
+            organizationId: actors.organization.id,
+          }),
+        );
+        const remaining = yield* f.waitForLinks([ordinary]);
+        expect(remaining.map((link) => link.account.id)).not.toContain(own);
+        yield* f.rejoin(actors.member);
+        yield* ok(yield* api.request(actors.member, "GET", `${prefix}/accounts/${own}`));
+        yield* ok(yield* f.link(actors.member, "shared", own));
+        expect((yield* f.call(actors.owner, "accounts")).body).toMatchObject({ shared: [own] });
+      }),
+    ),
+  );
+
+  it.effect(scenarios.contributedAppDepartureRecovery.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* contributedApp;
+        const { api, actors, prefix, ids } = f;
+        yield* Effect.addFinalizer(() => serverControl("start").pipe(Effect.orDie));
+        const removed = yield* f.connect(actors.member, "app", "shared", "Old server contribution");
+        const retained = yield* f.connect(
+          actors.member,
+          "app",
+          "shared",
+          "Rejoined member's new link",
+        );
+        const ordinary = yield* f.connect(actors.owner, "app", "ordinary", "Ordinary account");
+        // An older dispatcher can finish its ordinary jobs without seeing the separate outbox.
+        const [departures, sharedQueue, snapshots] = yield* legacyStorage([
+          {
+            sql: 'DELETE FROM member WHERE "organizationId" = $1 AND "userId" = $2',
+            params: [actors.organization.id, ids.member],
+          },
+          {
+            sql: "UPDATE hosted_provisioning SET status = 'succeeded' WHERE organization_id = $1 RETURNING id, kind",
+            params: [actors.organization.id],
+          },
+          // This contribution has since been replaced with a new link. A stale snapshot must not remove it.
+          {
+            sql: "UPDATE hosted_contributed_departures SET linked_at = linked_at - interval '1 second' WHERE account = $1",
+            params: [retained],
+          },
+          {
+            sql: "UPDATE hosted_contributed_departure_jobs SET status = 'running', attempts = 1, updated_at = now() - interval '11 minutes' WHERE organization_id = $1 RETURNING id",
+            params: [actors.organization.id],
+          },
+          {
+            sql: "SELECT kind, status FROM hosted_provisioning WHERE organization_id = $1",
+            params: [actors.organization.id],
+          },
+          { sql: "SELECT account FROM hosted_contributed_departures ORDER BY account" },
+        ]).pipe(Effect.map((results) => [results[3], results[4], results[5]]));
+        expect(departures).toHaveLength(1);
+        expect(sharedQueue?.length).toBeGreaterThan(0);
+        for (const job of sharedQueue ?? []) {
+          expect(["user", "team", "member", "billing", "domain"]).toContain(job.kind);
+          expect(job.status).toBe("succeeded");
+        }
+        expect(snapshots?.map((row) => row.account).sort()).toEqual([removed, retained].sort());
+        const original = yield* Schema.decodeUnknownEffect(Schema.Struct({ id: Schema.String }))(
+          departures?.[0],
+        );
+        yield* serverControl("start");
+        yield* f.waitForLinks([retained, ordinary]);
+        // Another restart does not replay completed cleanup or remove the preserved link.
+        yield* serverControl("restart");
+        yield* f.waitForLinks([retained, ordinary]);
+        const [pending, completed, credentials] = yield* legacyStorage([
+          { sql: "SELECT account FROM hosted_contributed_departures" },
+          {
+            sql: "SELECT status, attempts FROM hosted_contributed_departure_jobs WHERE id = $1",
+            params: [original.id],
+          },
+          { sql: "SELECT id FROM executor_accounts WHERE id = $1", params: [removed] },
+        ]);
+        expect(pending).toEqual([]);
+        expect(completed).toEqual([{ status: "succeeded", attempts: 2 }]);
+        expect(credentials).toEqual([{ id: removed }]);
+        yield* serverControl("start");
+        yield* f.rejoin(actors.member);
+        yield* ok(yield* api.request(actors.member, "GET", `${prefix}/accounts/${removed}`));
+        yield* ok(yield* f.link(actors.member, "shared", removed));
+        expect((yield* f.call(actors.owner, "accounts")).body).toMatchObject({
+          shared: [retained, removed],
+        });
+        expect((yield* api.request(actors.owner, "GET", `${prefix}/apps/${f.app.id}`)).status).toBe(
+          200,
+        );
+      }),
+    ),
+  );
+});
diff --git a/e2e/tests/contributed-app-requirements.spec.ts b/e2e/tests/contributed-app-requirements.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..aaeb815ac80ff1de084405fac4c4fc8b14bbd3a8
--- /dev/null
+++ b/e2e/tests/contributed-app-requirements.spec.ts
@@ -0,0 +1,291 @@
+/** Members contribute only to opted-in collections. Authorization is checked on every route. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { body } from "../support/api.ts";
+import { ok, refused } from "../support/app-links.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import {
+  Contribution,
+  Health,
+  contributedApp,
+  contributedSource,
+} from "../support/contributed-app.ts";
+import { Resource } from "../support/contracts.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(RuntimeLive, { excludeTestServices: true })("Contributed app requirements", (it) => {
+  it.effect(scenarios.contributedAppRequirements.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* contributedApp;
+        const { api, actors, prefix, ids, member, readLinks } = f;
+        // The second member can use the app but cannot edit it or remove someone else's link.
+        yield* f.role(ids.admin, "member");
+        const account = yield* f.connect(actors.member, "app", "shared", "Member's typed label", {
+          kind: "shared",
+          audience: { kind: "everyone" },
+        });
+        yield* refused(
+          yield* f.start(actors.member, "app", "ordinary", { kind: "personal" }),
+          403,
+          "OrganizationForbidden",
+        );
+        yield* refused(
+          yield* f.get(actors.member, "app", "ordinary"),
+          403,
+          "OrganizationForbidden",
+        );
+        const choices = yield* f.get(actors.member, "app", "shared");
+        yield* ok(choices);
+        expect(choices.body).toMatchObject({
+          canContribute: true,
+          cardinality: "many",
+          scope: "app",
+        });
+        const [own] = yield* readLinks(actors.member);
+        expect(own).toMatchObject({
+          linkedBy: { id: ids.member, name: member.name },
+          canRemove: true,
+        });
+        expect((yield* readLinks(actors.owner))[0]?.canRemove).toBe(true);
+        expect((yield* readLinks(actors.admin))[0]?.canRemove).toBe(false);
+        yield* refused(
+          yield* f.unlink(actors.admin, "shared", account),
+          403,
+          "OrganizationForbidden",
+        );
+        const sameLink = yield* f.link(actors.admin, "shared", account);
+        yield* ok(sameLink);
+        expect(sameLink.body).toMatchObject({ linkedBy: { id: ids.member }, canRemove: false });
+        const personal = yield* f.connect(actors.member, "user", "own", "Personal account");
+        yield* refused(
+          yield* f.link(actors.admin, "shared", personal),
+          403,
+          "OrganizationForbidden",
+        );
+        yield* ok(yield* f.unlink(actors.member, "shared", account));
+        const relink = yield* f.link(actors.member, "shared", account);
+        expect(yield* body(Contribution, relink)).toMatchObject({
+          linkedBy: { id: ids.member },
+          canRemove: true,
+        });
+        yield* refused(
+          yield* f.link(actors.member, "ordinary", account),
+          403,
+          "OrganizationForbidden",
+        );
+
+        yield* ok(
+          yield* api.request(actors.member, "PATCH", `${prefix}/accounts/${account}`, {
+            description: "A person typed this description",
+          }),
+        );
+        yield* ok(
+          yield* api.request(actors.member, "POST", `${prefix}/accounts/${account}/health`),
+        );
+        const [view] = yield* readLinks(actors.admin);
+        expect(view).toMatchObject({
+          account: {
+            label: "Member's typed label",
+            description: "A person typed this description",
+          },
+          health: { info: null, infoCheckedAt: null },
+        });
+        expect((yield* readLinks(actors.member))[0]?.health?.info).toEqual({
+          email: "upstream@example.test",
+        });
+        expect((yield* readLinks(actors.owner))[0]?.health?.info).toEqual({
+          email: "upstream@example.test",
+        });
+        const detail = yield* api.request(actors.admin, "GET", `${prefix}/accounts/${account}`);
+        expect(detail.body).toMatchObject({
+          account: {
+            label: "Member's typed label",
+            description: "A person typed this description",
+          },
+          health: { info: null },
+        });
+        const checked = yield* body(
+          Health,
+          yield* api.request(actors.admin, "POST", `${prefix}/accounts/${account}/health`),
+        );
+        expect(checked.info).toBeNull();
+        expect(checked.apps.some((entry) => entry.check?.status === "healthy")).toBe(true);
+        for (const endpoint of ["inventory", "resources"]) {
+          const directory = yield* api.request(actors.admin, "GET", `${prefix}/${endpoint}`);
+          const entries = yield* body(
+            Schema.Struct({ accounts: Schema.Array(Schema.Unknown) }),
+            directory,
+          );
+          expect(entries.accounts).toContainEqual(
+            expect.objectContaining(
+              endpoint === "resources"
+                ? {
+                    account: expect.objectContaining({
+                      id: account,
+                      label: "Member's typed label",
+                    }),
+                    health: expect.objectContaining({ info: null }),
+                  }
+                : {
+                    id: account,
+                    label: "Member's typed label",
+                    health: expect.objectContaining({ info: null }),
+                  },
+            ),
+          );
+        }
+        // Account management alone permits identity even when no linked app is editable or visible.
+        yield* f.role(ids.admin, "admin");
+        yield* ok(yield* f.unlink(actors.owner, "shared", account));
+        const managed = yield* api.request(actors.admin, "GET", `${prefix}/accounts/${account}`);
+        expect(managed.body).toMatchObject({
+          health: { info: { email: "upstream@example.test" } },
+        });
+
+        // Deletion follows the linker's authority, independently of who holds the credentials.
+        yield* ok(yield* f.link(actors.owner, "shared", account));
+        yield* refused(
+          yield* api.request(actors.member, "DELETE", `${prefix}/accounts/${account}`),
+          403,
+          "OrganizationForbidden",
+        );
+        yield* ok(yield* f.unlink(actors.owner, "shared", account));
+        yield* ok(yield* f.link(actors.member, "shared", account));
+        yield* ok(yield* api.request(actors.member, "DELETE", `${prefix}/accounts/${account}`));
+        expect(yield* readLinks()).toEqual([]);
+        const ordinary = yield* f.connect(actors.owner, "app", "ordinary", "Ordinary account");
+        yield* ok(
+          yield* api.request(actors.owner, "POST", `${prefix}/accounts/${ordinary}/health`),
+        );
+        expect((yield* readLinks(actors.member))[0]).toMatchObject({
+          requirement: "ordinary",
+          account: { id: ordinary, label: "Ordinary account" },
+          health: { info: null, infoCheckedAt: null },
+        });
+        expect((yield* readLinks(actors.owner))[0]?.health).toMatchObject({
+          info: { email: "upstream@example.test" },
+          infoCheckedAt: expect.any(String),
+        });
+
+        // Holding an account does not reveal its identity through an ordinary app link.
+        // The same holder can still see identity through a contributed requirement.
+        const held = yield* f.connect(actors.member, "user", "own", "Member's ordinary account", {
+          kind: "shared",
+          audience: { kind: "everyone" },
+        });
+        yield* ok(yield* f.link(actors.owner, "ordinary", held));
+        yield* ok(yield* f.link(actors.member, "shared", held));
+        yield* ok(yield* api.request(actors.member, "POST", `${prefix}/accounts/${held}/health`));
+        const heldLinks = (yield* readLinks(actors.member)).filter(
+          (link) => link.account.id === held,
+        );
+        expect(heldLinks.find((link) => link.requirement === "ordinary")?.health).toMatchObject({
+          info: null,
+          infoCheckedAt: null,
+        });
+        expect(heldLinks.find((link) => link.requirement === "shared")?.health).toMatchObject({
+          info: { email: "upstream@example.test" },
+          infoCheckedAt: expect.any(String),
+        });
+        const poolSlot = yield* f.another(
+          contributedSource
+            .replace("shared: service.many()", "pool: service.many()")
+            .replace("ctx.app.accounts.shared", "ctx.app.accounts.pool"),
+        );
+        const poolChoices = yield* api.request(
+          actors.member,
+          "GET",
+          `${poolSlot}/accounts/app/pool`,
+        );
+        yield* ok(poolChoices);
+        expect(poolChoices.body).toMatchObject({ canContribute: true, requirement: "pool" });
+        yield* refused(
+          yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${ordinary}`),
+          409,
+          "AccountLinkedToApp",
+        );
+      }),
+    ),
+  );
+
+  it.effect(scenarios.contributedAppConnections.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* contributedApp;
+        const { api, actors, path, prefix } = f;
+        const started = yield* f.start(actors.member, "app", "shared", { kind: "personal" });
+        const pending = (yield* body(Resource, started)).id;
+        const revision = yield* body(
+          Schema.Struct({ revision: Schema.String }),
+          yield* api.request(actors.owner, "GET", `${path}/access`),
+        );
+        yield* ok(
+          yield* api.request(actors.owner, "PATCH", `${path}/access`, {
+            revision: revision.revision,
+            audience: { kind: "private" },
+          }),
+        );
+        yield* refused(
+          yield* f.submit(actors.member, pending, "No longer allowed"),
+          403,
+          "OrganizationForbidden",
+        );
+        const current = yield* body(
+          Schema.Struct({ revision: Schema.String }),
+          yield* api.request(actors.owner, "GET", `${path}/access`),
+        );
+        yield* ok(
+          yield* api.request(actors.owner, "PATCH", `${path}/access`, {
+            revision: current.revision,
+            audience: { kind: "everyone" },
+          }),
+        );
+        yield* ok(
+          yield* api.request(actors.owner, "POST", `${path}/deploy`, {
+            files: [
+              {
+                path: "index.ts",
+                content: contributedSource.replace(
+                  "service.many().contributed()",
+                  "service.many()",
+                ),
+              },
+              appsManifest,
+            ],
+          }),
+        );
+        yield* refused(
+          yield* f.submit(actors.member, pending, "Opt-in was removed"),
+          403,
+          "OrganizationForbidden",
+        );
+        expect(yield* f.readLinks()).toEqual([]);
+        const invalid = contributedSource
+          .replace("app: { accounts: { shared:", "user: { accounts: { shared:")
+          .replace(", user: { accounts: { own: service.many() } }", "");
+        const rejected = yield* api.request(actors.owner, "POST", `${path}/deploy`, {
+          files: [{ path: "index.ts", content: invalid }, appsManifest],
+        });
+        expect(rejected.status).not.toBe(200);
+        expect(JSON.stringify(rejected.body)).toContain("must be in app.accounts");
+        const malformed = contributedSource.replace(
+          "service.many().contributed()",
+          "Object.assign(service, { isContributed: true })",
+        );
+        const plain = yield* api.request(actors.owner, "POST", `${path}/deploy`, {
+          files: [{ path: "index.ts", content: malformed }, appsManifest],
+        });
+        expect(plain.status).not.toBe(200);
+        expect(JSON.stringify(plain.body)).toContain("must use provider.many().contributed()");
+        expect(
+          (yield* api.request(actors.member, "GET", `${prefix}/apps/${f.app.id}`)).status,
+        ).toBe(200);
+      }),
+    ),
+  );
+});
