@@ -0,0 +1,34 @@
+import { StorageError, type AppId } from "@executor-js/sdk/core";
+import { Effect } from "effect";
+import type { SqlClient } from "effect/sql";
+
+/** Current app links, with contribution policy required only by opted-in deployments. */
+export const usableAppLinks = (sql: SqlClient.SqlClient, apps: readonly AppId[]) =>
+  Effect.gen(function* () {
+    const contributed = yield* sql`select 1 from executor_apps app
+      join executor_deployments d on d.id = app.active_deployment
+      cross join lateral jsonb_each(coalesce(d.requirements::jsonb -> 'accounts', '{}'::jsonb)) requirement
+      where ${sql.in("app.id", apps)} and requirement.value ->> 'contributed' = 'true'
+      limit 1`;
+    const ordinary = sql`coalesce(contribution_deployment.requirements::jsonb -> 'accounts' -> l.requirement ->> 'contributed', 'false') <> 'true'`;
+    // SQL resolves columns, functions and tables before evaluating OR. Ordinary SDK hosts must
+    // not need the hosted contribution schema. Recheck opt-in in the final read so a concurrent
+    // deployment cannot turn that smaller query into an unchecked contribution read.
+    const policy =
+      contributed.length === 0
+        ? ordinary
+        : sql`(${ordinary} or (hosted_contribution_access(l.app, l.account, l.linked_by)
+            and not exists (select 1 from hosted_contributed_departures revoked
+              where revoked.app = l.app and revoked.requirement = l.requirement
+                and revoked.account = l.account and revoked.linked_at = l.created_at)))`;
+    return sql`hosted_app_account_links l
+      join executor_apps app on app.id = l.app
+      join executor_accounts a on a.id = l.account and a.owner = app.owner
+      join hosted_account_access p on p.account_id = a.id
+        and a.owner = 'organization:' || p.organization_id
+      left join executor_deployments contribution_deployment on contribution_deployment.id = app.active_deployment
+      where l.subject is null and ${sql.in("l.app", apps)} and ${policy}
+        and (p.kind <> 'personal' or exists(select 1 from member owner_member
+          where owner_member."organizationId" = p.organization_id
+            and owner_member."userId" = p.personal_user_id))`;
+  }).pipe(Effect.catchTag("SqlError", () => new StorageError()));
