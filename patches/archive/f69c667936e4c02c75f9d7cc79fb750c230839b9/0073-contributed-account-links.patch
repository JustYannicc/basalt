index 0000000000000000000000000000000000000000..52b8423218d68f1870d9ca5a46d798bf4fee4eee
--- /dev/null
+++ b/e2e/tests/contributed-app-accounts.spec.ts
@@ -0,0 +1,180 @@
+/** The Accounts tab offers member actions only on contributed requirements and their own links. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import type { Page } from "playwright";
+import { ok } from "../support/app-links.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { contributedApp } from "../support/contributed-app.ts";
+import { Resource } from "../support/contracts.ts";
+import { nameConnectedAccount } from "../support/name-account.ts";
+import { scenarios } from "../test-plan.ts";
+
+const ordinaryNote = "Only people who can edit this app can change these accounts.";
+
+/**
+ * Both app requirements use the same provider, so their sections share its name. A member sees
+ * the permission note only on the requirement they cannot change.
+ */
+const requirementSection = (page: Page, kind: "contributed" | "ordinary") =>
+  page
+    .getByRole("region", { name: "App accounts", exact: true })
+    .getByRole("region", { name: "Contributed service", exact: true })
+    .filter(kind === "ordinary" ? { hasText: ordinaryNote } : { hasNotText: ordinaryNote });
+
+layer(HostedLive, { excludeTestServices: true })("Contributed Accounts tab", (it) => {
+  it.effect(scenarios.contributedAppAccountsBrowser.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* contributedApp;
+        const browser = yield* Browser;
+        const { actors, ids } = f;
+        yield* f.role(ids.admin, "member");
+        const own = yield* f.connect(actors.member, "app", "shared", "My service account");
+        yield* f.connect(actors.owner, "app", "shared", "Another member's account");
+        yield* f.connect(actors.owner, "app", "ordinary", "Manager-only account");
+        yield* browser.login(actors.member);
+        yield* browser.use("Open contributed accounts", (page) =>
+          page.goto(`/org/${actors.organization.slug}/apps/${f.app.id}?view=accounts`),
+        );
+        yield* browser.use("My contribution names me", (page) =>
+          page.getByText("Added by you", { exact: true }).waitFor(),
+        );
+        yield* browser.use("Members can add an account to the contributed requirement", (page) =>
+          requirementSection(page, "contributed")
+            .getByRole("button", { name: "Connect new account", exact: true })
+            .waitFor(),
+        );
+        // Rows stay disabled until the requirement's choices arrive.
+        yield* browser.use("My contribution becomes changeable", (page) =>
+          requirementSection(page, "contributed")
+            .getByRole("checkbox", { name: "My service account", disabled: false, exact: true })
+            .waitFor(),
+        );
+        expect(
+          yield* browser.use("Read contributed account controls", (page) => {
+            const contributed = requirementSection(page, "contributed");
+            const ordinary = requirementSection(page, "ordinary");
+            return Promise.all([
+              contributed
+                .getByRole("checkbox", { name: "My service account", exact: true })
+                .isEnabled(),
+              contributed
+                .getByRole("checkbox", { name: "Another member's account", exact: true })
+                .isDisabled(),
+              contributed
+                .getByRole("button", { name: "Manage Another member's account", exact: true })
+                .count(),
+              ordinary.getByRole("button", { name: "Connect new account", exact: true }).count(),
+            ]);
+          }),
+        ).toEqual([true, true, 0, 0]);
+        yield* browser.use("The ordinary requirement explains its permission", (page) =>
+          requirementSection(page, "ordinary").getByText(ordinaryNote, { exact: true }).waitFor(),
+        );
+        yield* browser.checkpoint(
+          "Contributed and ordinary requirements have different member actions",
+        );
+        expect(
+          yield* browser.use("Other contributors' upstream identity stays private", (page) => {
+            const row = requirementSection(page, "contributed")
+              .getByRole("listitem")
+              .filter({ hasText: "Another member's account" });
+            return Promise.all([row.innerText(), row.locator("[data-account-identity]").count()]);
+          }),
+        ).toEqual([expect.not.stringContaining("upstream@example.test"), 0]);
+        yield* browser.use("Connect another account as a contributor", (page) =>
+          requirementSection(page, "contributed")
+            .getByRole("button", { name: "Connect new account", exact: true })
+            .click(),
+        );
+        yield* browser.use("Enter credentials in the native connection dialog", (page) =>
+          page.getByRole("dialog").getByLabel("Token", { exact: true }).fill("synthetic-ui-key"),
+        );
+        const validated = yield* browser.use("Validate the contributor's credentials", (page) =>
+          Promise.all([
+            page.waitForResponse(
+              (response) =>
+                response.request().method() === "POST" &&
+                new URL(response.url()).pathname.endsWith("/credential-checks"),
+            ),
+            page
+              .getByRole("dialog")
+              .getByRole("button", { name: "Validate Key", exact: true })
+              .click(),
+          ]).then(([response]) => response.status()),
+        );
+        expect(validated).toBe(200);
+        const submitted = yield* browser.use("Save the contributor's new account", (page) =>
+          Promise.all([
+            page.waitForResponse(
+              (response) =>
+                response.request().method() === "POST" &&
+                /\/connections\/[^/]+\/submit$/.test(new URL(response.url()).pathname),
+            ),
+            page.getByRole("dialog").getByRole("button", { name: "Continue", exact: true }).click(),
+          ]).then(([response]) =>
+            response.json().then((value: unknown) => ({ status: response.status(), body: value })),
+          ),
+        );
+        expect(submitted.status).toBe(200);
+        const created = yield* Schema.decodeUnknownEffect(Resource)(submitted.body);
+        yield* f.saved(actors.member, created.id);
+        yield* browser.use("Name the new contribution", (page) =>
+          nameConnectedAccount(page, "Connected from the Accounts tab"),
+        );
+        yield* browser.use("The new contribution appears linked", (page) =>
+          requirementSection(page, "contributed")
+            .getByRole("checkbox", {
+              name: "Connected from the Accounts tab",
+              checked: true,
+              disabled: false,
+              exact: true,
+            })
+            .waitFor(),
+        );
+        const connected = (yield* f.readLinks()).find((link) => link.account.id === created.id);
+        expect(connected).toMatchObject({ linkedBy: { id: ids.member }, canRemove: true });
+        yield* browser.use("Inspect contributions at phone width", (page) =>
+          page.setViewportSize({ width: 390, height: 844 }),
+        );
+        expect(
+          yield* browser.use("Contribution controls fit the phone viewport", (page) =>
+            page.evaluate(() => document.documentElement.scrollWidth <= innerWidth),
+          ),
+        ).toBe(true);
+        yield* browser.checkpoint("Member contributions at phone width");
+        yield* browser.use("Return to desktop width", (page) =>
+          page.setViewportSize({ width: 1440, height: 960 }),
+        );
+        yield* browser.use("Open my contribution's menu", (page) =>
+          page.getByRole("button", { name: "Manage My service account", exact: true }).click(),
+        );
+        yield* browser.use("Remove the contribution I added", (page) =>
+          page.getByRole("menuitem", { name: "Unlink", exact: true }).click(),
+        );
+        yield* browser.use("Keep the saved account", (page) =>
+          page.getByRole("button", { name: "Keep account", exact: true }).click(),
+        );
+        yield* browser.use("My account remains as an unlinked choice", (page) =>
+          requirementSection(page, "contributed")
+            .getByRole("checkbox", { name: "My service account", checked: false, exact: true })
+            .waitFor(),
+        );
+        expect((yield* f.readLinks()).map((link) => link.account.id)).not.toContain(own);
+        yield* ok(yield* f.link(actors.member, "shared", own));
+        yield* browser.login(actors.owner);
+        yield* browser.use("Open the editor's Accounts tab", (page) =>
+          page.goto(`/org/${actors.organization.slug}/apps/${f.app.id}?view=accounts`),
+        );
+        // The checkbox unlinks it, so an enabled one is the editor's removal control.
+        yield* browser.use("Editors may remove another member's contribution", (page) =>
+          page
+            .getByRole("checkbox", { name: "My service account", disabled: false, exact: true })
+            .waitFor(),
+        );
+      }),
+    ),
+  );
+});
diff --git a/e2e/tests/contributed-app-departures.spec.ts b/e2e/tests/contributed-app-departures.spec.ts
