--- /dev/null
+++ b/apps/hosted/server/src/implementation/contributed-account-policy.ts
@@ -0,0 +1,116 @@
+/** App authors opt in to member contributions; ordinary app requirements need management. */
+import { AccountId, AppId, StorageError, type AccountScope } from "@executor-js/sdk/core";
+import { Effect, Schema } from "effect";
+import type { SqlClient } from "effect/sql";
+import { CurrentUserId } from "../contracts/auth.ts";
+import { OrganizationForbidden, type OrganizationId } from "../contracts/organization.ts";
+import {
+  applicationAccess,
+  currentResourceAuthority,
+  policyDatabase,
+  requireAppAccessAs,
+  type ResourceAuthority,
+} from "./resource-policy.ts";
+
+/** Read the active deployment again under the link lock. Existing requirements opt out. */
+export const isContributed = (sql: SqlClient.SqlClient, app: AppId, requirement: string) =>
+  sql`select 1 from executor_apps a
+    join executor_deployments d on d.id = a.active_deployment
+    where a.id = ${app}
+      and d.requirements::jsonb -> 'accounts' -> ${requirement} ->> 'scope' = 'app'
+      and d.requirements::jsonb -> 'accounts' -> ${requirement} ->> 'cardinality' = 'many'
+      and d.requirements::jsonb -> 'accounts' -> ${requirement} ->> 'contributed' = 'true'`.pipe(
+    Effect.map((rows) => rows.length === 1),
+    Effect.catchTag("SqlError", () => new StorageError()),
+  );
+
+export const requireRequirementAccessAs = (
+  actor: ResourceAuthority,
+  input: { readonly app: AppId; readonly requirement: string; readonly scope: AccountScope },
+) =>
+  Effect.gen(function* () {
+    const contributed =
+      input.scope === "app" &&
+      (yield* isContributed(yield* policyDatabase, input.app, input.requirement));
+    return yield* requireAppAccessAs(
+      actor,
+      input.app,
+      input.scope === "user" || contributed ? "use" : "manage",
+    );
+  });
+
+export const requireRequirementAccess = (input: Parameters<typeof requireRequirementAccessAs>[1]) =>
+  Effect.flatMap(currentResourceAuthority, (actor) => requireRequirementAccessAs(actor, input));
+
+/** Under the app's link lock, the linker or an editor can remove a contributed link. */
+export const requireLinkRemovalAs = (
+  sql: SqlClient.SqlClient,
+  actor: ResourceAuthority,
+  input: { readonly app: AppId; readonly requirement: string; readonly account: AccountId },
+) =>
+  Effect.gen(function* () {
+    const access = yield* applicationAccess(input.app, actor);
+    if (access.canManage) return;
+    if (yield* isContributed(sql, input.app, input.requirement)) {
+      const own = yield* sql`select 1 from hosted_app_account_links
+        where app = ${input.app} and requirement = ${input.requirement}
+          and account = ${input.account} and subject is null and linked_by = ${actor.user}`;
+      if (own.length === 1) return;
+    }
+    return yield* new OrganizationForbidden();
+  }).pipe(Effect.catchTag("SqlError", () => new StorageError()));
+
+const Contribution = Schema.Struct({ app: AppId, requirement: Schema.String, account: AccountId });
+
+/** Deleting saved credentials must pass the same checks as removing each contributed link. */
+export const checkContributedAccountRemoval = (sql: SqlClient.SqlClient, account: AccountId) =>
+  Effect.gen(function* () {
+    const links = yield* Schema.decodeUnknownEffect(Schema.Array(Contribution))(
+      yield* sql`select l.app, l.requirement, l.account from hosted_app_account_links l
+        join executor_apps a on a.id = l.app
+        join executor_deployments d on d.id = a.active_deployment
+        where l.account = ${account} and l.subject is null
+          and d.requirements::jsonb -> 'accounts' -> l.requirement ->> 'scope' = 'app'
+          and d.requirements::jsonb -> 'accounts' -> l.requirement ->> 'contributed' = 'true'
+        order by l.app, l.requirement`,
+    );
+    if (links.length === 0) return;
+    // The SDK already holds the account row. Fail contention rather than deadlocking with a
+    // link writer holding the app row while waiting for this account.
+    for (const link of links)
+      yield* sql`select id from executor_apps where id = ${link.app} for no key update nowait`;
+    const user = yield* CurrentUserId;
+    for (const link of links) {
+      const permitted = yield* sql`select m.id from member m
+        join hosted_account_access p on p.organization_id = m."organizationId" and p.account_id = ${account}
+        join hosted_app_access a on a.organization_id = m."organizationId" and a.id = ${link.app}
+        where m."userId" = ${user ?? ""} and (m.role in ('owner', 'admin') or a.creator_id = m."userId"
+          or exists (select 1 from hosted_app_account_links l where l.app = ${link.app}
+            and l.requirement = ${link.requirement} and l.account = ${account}
+            and l.subject is null and l.linked_by = m."userId")) for share of m`;
+      if (permitted.length !== 1) return yield* new OrganizationForbidden();
+    }
+  }).pipe(
+    Effect.catchTags({ SqlError: () => new StorageError(), SchemaError: () => new StorageError() }),
+  );
+
+/** Sharing an account for use does not make another member its holder. */
+export const accountHolders = (
+  sql: SqlClient.SqlClient,
+  organization: OrganizationId,
+  accounts: readonly AccountId[],
+) =>
+  accounts.length === 0
+    ? Effect.succeed([])
+    : sql`select account_id as account, coalesce(personal_user_id, creator_id) as holder
+        from hosted_account_access
+        where organization_id = ${organization} and ${sql.in("account_id", accounts)}`.pipe(
+        Effect.flatMap(
+          Schema.decodeUnknownEffect(
+            Schema.Array(
+              Schema.Struct({ account: AccountId, holder: Schema.NullOr(Schema.String) }),
+            ),
+          ),
+        ),
+        Effect.mapError(() => new StorageError()),
+      );
diff --git a/apps/hosted/server/src/implementation/contributed-departure-queue.ts b/apps/hosted/server/src/implementation/contributed-departure-queue.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8df3865a62abfeff52507497312d18b3d9395556
--- /dev/null
+++ b/apps/hosted/server/src/implementation/contributed-departure-queue.ts
@@ -0,0 +1,72 @@
+/** Independent durable cleanup, recovered by Cloud's cron and self-host's queue worker. */
+import { StorageError } from "@executor-js/sdk/core";
+import { Effect, Exit, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import { OrganizationId } from "../contracts/organization.ts";
+import { removeContributedDeparture } from "./contributed-account-departure.ts";
+
+const Departure = Schema.Struct({
+  id: Schema.String,
+  organization_id: OrganizationId,
+  user_id: Schema.String,
+  attempts: Schema.Number,
+});
+
+/** Claim once; killed runners expire, and failed hooks retain their immutable link snapshots. */
+export const runContributedDeparture = (id: string) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const [job] = yield* sql`update hosted_contributed_departure_jobs
+      set status = 'running', attempts = attempts + 1, updated_at = now()
+      where id = ${id} and (status = 'queued' or
+        (status = 'running' and updated_at < now() - interval '10 minutes'))
+      returning id, organization_id, user_id, attempts`.pipe(
+      Effect.flatMap(Schema.decodeUnknownEffect(Schema.Array(Departure))),
+    );
+    if (job === undefined) return;
+    yield* removeContributedDeparture({
+      id: job.id,
+      organization: job.organization_id,
+      user: job.user_id,
+    }).pipe(
+      Effect.andThen(sql`update hosted_contributed_departure_jobs
+        set status = 'succeeded', updated_at = now()
+        where id = ${id} and status = 'running' and attempts = ${job.attempts}`),
+      Effect.onExit((exit) =>
+        Exit.isSuccess(exit)
+          ? Effect.void
+          : sql`update hosted_contributed_departure_jobs
+              set status = case when attempts >= 8 then 'failed' else 'queued' end,
+                available_at = now() + least(300, power(2, attempts)) * interval '1 second',
+                updated_at = now()
+              where id = ${id} and status = 'running' and attempts = ${job.attempts}`.pipe(
+              Effect.ignore,
+            ),
+      ),
+    );
+  }).pipe(
+    Effect.mapError(() => new StorageError()),
+    Effect.asVoid,
+  );
+
+/** Read a bounded batch. Atomic claims let overlapping cron/process wakes share the queue. */
+export const drainContributedDepartures = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  const jobs = yield* sql`select id from hosted_contributed_departure_jobs
+    where (status = 'queued' and available_at <= now())
+      or (status = 'running' and updated_at < now() - interval '10 minutes')
+    order by available_at limit 20`.pipe(
+    Effect.flatMap(Schema.decodeUnknownEffect(Schema.Array(Schema.Struct({ id: Schema.String })))),
+  );
+  yield* Effect.forEach(
+    jobs,
+    (job) =>
+      runContributedDeparture(job.id).pipe(
+        Effect.timeout("5 minutes"),
+        Effect.catch(() =>
+          Effect.logWarning("Contributed departure attempt failed", { job: job.id }),
+        ),
+      ),
+    { concurrency: 2, discard: true },
+  );
+}).pipe(Effect.mapError(() => new StorageError()));
diff --git a/apps/hosted/server/src/implementation/contributed-departure-schema.ts b/apps/hosted/server/src/implementation/contributed-departure-schema.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1ca43f6d7cf594d399bae8cfd4ab3e3cf8d61272
--- /dev/null
+++ b/apps/hosted/server/src/implementation/contributed-departure-schema.ts
@@ -0,0 +1,128 @@
+/** Departures have their own outbox: old provisioning dispatchers never read these rows. */
+import { Effect } from "effect";
+import { SqlClient } from "effect/sql";
+
+/** Additive, journaled once, with no backfill or changes to the shared provisioning queue. */
+export const migrateContributedDepartures = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  yield* sql`create table hosted_contributed_departure_jobs (
+    id text primary key default gen_random_uuid()::text,
+    organization_id text not null references organization(id) on delete cascade,
+    user_id text not null,
+    status text not null default 'queued' check (status in ('queued', 'running', 'succeeded', 'failed')),
+    attempts integer not null default 0,
+    available_at timestamptz not null default now(),
+    updated_at timestamptz not null default now()
+  )`;
+  yield* sql`create index hosted_contributed_departure_pending on hosted_contributed_departure_jobs (available_at) where status in ('queued', 'running')`;
+  // Neither authority nor snapshots reference the departing user row.
+  yield* sql`create table hosted_contributed_departures (
+    job text not null references hosted_contributed_departure_jobs(id) on delete cascade,
+    app text not null,
+    requirement text not null,
+    account text not null,
+    linked_at timestamptz not null,
+    primary key (job, app, requirement, account)
+  )`;
+  yield* sql`create index hosted_contributed_departure_link on hosted_contributed_departures (app, requirement, account, linked_at)`;
+  yield* sql`create view hosted_contributions as
+    select l.app, l.requirement, l.account, l.created_at as linked_at, l.linked_by as user_id,
+      p.organization_id
+    from hosted_app_account_links l
+    join hosted_account_access p on p.account_id = l.account
+
+    join executor_apps a on a.id = l.app and a.owner = 'organization:' || p.organization_id
+    join executor_deployments d on d.id = a.active_deployment
+    where l.subject is null
+      and d.requirements::jsonb -> 'accounts' -> l.requirement ->> 'scope' = 'app'
+      and d.requirements::jsonb -> 'accounts' -> l.requirement ->> 'cardinality' = 'many'
+      and d.requirements::jsonb -> 'accounts' -> l.requirement ->> 'contributed' = 'true'`;
+  yield* sql`create function hosted_contribution_access(target_app text, target_account text, contributor text)
+    returns boolean language sql stable as $$
+      select exists (
+        select 1 from hosted_app_access app
+        join member m on m."organizationId" = app.organization_id and m."userId" = contributor
+        join hosted_account_access account on account.organization_id = app.organization_id
+          and account.account_id = target_account
+        where app.id = target_app
+          and (app.audience = 'everyone' or (app.audience = 'private' and app.creator_id = contributor)
+            or (app.audience = 'groups' and exists (
+              select 1 from hosted_app_groups g join hosted_group_members gm on gm.group_id = g.group_id
+              where g.app_id = target_app and gm.member_id = m.id)))
+          and ((account.kind = 'personal' and account.personal_user_id = contributor)
+            or (account.kind = 'shared' and (account.audience = 'everyone' or exists (
+              select 1 from hosted_account_groups g join hosted_group_members gm on gm.group_id = g.group_id
+              where g.account_id = target_account and gm.member_id = m.id))))
+      )
+    $$`;
+  yield* sql`create function hosted_snapshot_contributed_departures(team text, departing text, target_app text)
+    returns void language plpgsql as $$
+    declare contributor record; departure text;
+    begin
+      for contributor in
+        select distinct c.organization_id, c.user_id from hosted_contributions c
+        where (team is null or c.organization_id = team)
+          and (departing is null or c.user_id = departing)
+          and (target_app is null or c.app = target_app)
+      loop
+        departure := gen_random_uuid()::text;
+        insert into hosted_contributed_departure_jobs (id, organization_id, user_id)
+          values (departure, contributor.organization_id, contributor.user_id);
+        insert into hosted_contributed_departures (job, app, requirement, account, linked_at)
+          select departure, c.app, c.requirement, c.account, c.linked_at
+          from hosted_contributions c
+          where c.organization_id = contributor.organization_id and c.user_id = contributor.user_id
+            and (target_app is null or c.app = target_app)
+            and (departing is not null or not hosted_contribution_access(c.app, c.account, c.user_id))
+            and not exists (select 1 from hosted_contributed_departures prior
+              where prior.app = c.app and prior.requirement = c.requirement
+                and prior.account = c.account and prior.linked_at = c.linked_at);
+        if not found then delete from hosted_contributed_departure_jobs where id = departure; end if;
+      end loop;
+    end $$`;
+  // Separate triggers leave the existing auth provisioning functions and their accepted kinds intact.
+  yield* sql`create function hosted_contributed_member_departure() returns trigger language plpgsql as $$
+    begin
+      if exists (select 1 from organization where id = OLD."organizationId") then
+        perform hosted_snapshot_contributed_departures(OLD."organizationId", OLD."userId", null);
+      end if;
+      return OLD;
+    end $$`;
+  yield* sql`create trigger hosted_contributed_member_departure after delete on member
+    for each row execute function hosted_contributed_member_departure()`;
+  yield* sql`create function hosted_contributed_user_departure() returns trigger language plpgsql as $$
+    begin
+      perform hosted_snapshot_contributed_departures(null, OLD.id, null);
+      return OLD;
+    end $$`;
+  yield* sql`create trigger hosted_contributed_user_departure before delete on "user"
+    for each row execute function hosted_contributed_user_departure()`;
+  // Sharing/group writes replace grants inside one transaction. Check the final policy, not
+  // temporary deleted rows, and commit the snapshots before reporting the access change done.
+  yield* sql`create function hosted_contributed_access_departure() returns trigger language plpgsql as $$
+    begin
+      if TG_TABLE_NAME = 'hosted_app_access' then
+        perform hosted_snapshot_contributed_departures(NEW.organization_id, null, NEW.id);
+      elsif TG_TABLE_NAME = 'hosted_app_groups' then
+        perform hosted_snapshot_contributed_departures(OLD.organization_id, null, OLD.app_id);
+      elsif TG_TABLE_NAME = 'hosted_account_access' then
+        perform hosted_snapshot_contributed_departures(NEW.organization_id, null, null);
+      elsif TG_TABLE_NAME = 'hosted_account_groups' then
+        perform hosted_snapshot_contributed_departures(OLD.organization_id, null, null);
+      else
+        perform hosted_snapshot_contributed_departures(m."organizationId", null, null)
+          from member m where m.id = OLD.member_id;
+      end if;
+      return null;
+    end $$`;
+  yield* sql`create constraint trigger hosted_contributed_app_access after update on hosted_app_access
+    deferrable initially deferred for each row execute function hosted_contributed_access_departure()`;
+  yield* sql`create constraint trigger hosted_contributed_app_groups after delete on hosted_app_groups
+    deferrable initially deferred for each row execute function hosted_contributed_access_departure()`;
+  yield* sql`create constraint trigger hosted_contributed_account_access after update on hosted_account_access
+    deferrable initially deferred for each row execute function hosted_contributed_access_departure()`;
+  yield* sql`create constraint trigger hosted_contributed_account_groups after delete on hosted_account_groups
+    deferrable initially deferred for each row execute function hosted_contributed_access_departure()`;
+  yield* sql`create constraint trigger hosted_contributed_group_members after delete on hosted_group_members
+    deferrable initially deferred for each row execute function hosted_contributed_access_departure()`;
+});
