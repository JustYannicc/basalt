@@ -0,0 +1,293 @@
+import type { AccountObservationRecord, App } from "@executor-js/sdk";
+import { useAtomValue } from "@effect/atom-react";
+import { Exit, Option, type Cause } from "effect";
+import { AsyncResult, Atom } from "effect/reactivity";
+import { useEffect, useId, useState, type ComponentType } from "react";
+import { HugeiconsIcon } from "@hugeicons/react";
+import { ArrowDown01Icon } from "@hugeicons/core-free-icons";
+import type { AccountSummary, FailureProps, Query } from "../../contracts/dashboard.ts";
+import type { DisplayFormat } from "../../contracts/display.ts";
+import { Button } from "../components/button.tsx";
+import { useDisplayFormat } from "../hooks/display-format.ts";
+import { cn } from "../lib/utils.ts";
+import { AccountHealthLine } from "./account-health-line.tsx";
+import { ObservationDetails } from "./account-observation-details.tsx";
+import {
+  age,
+  attemptNote,
+  moment,
+  planLabel,
+  readingTimes,
+  refreshBlocked,
+} from "./account-observation-format.ts";
+import { ObservationReadings } from "./account-observation-readings.tsx";
+import { useQuery } from "./context.tsx";
+
+/** What a product lets the caller see of an account's reported usage. */
+export interface AccountObservationsView {
+  /** False: the caller may use the account but not see its usage; `reports` is then empty. */
+  readonly canInspect: boolean;
+  readonly canRefresh: boolean;
+  readonly reports: readonly AccountObservationRecord[];
+}
+
+/** One slow clock for every visible block: ages and countdowns move by the half minute. */
+const clock = Atom.readable((get) => {
+  if (typeof window === "undefined") return Date.now();
+  const timer = window.setInterval(() => get.setSelf(Date.now()), 30_000);
+  get.addFinalizer(() => window.clearInterval(timer));
+  return Date.now();
+});
+
+/**
+ * An account's reported usage under its row, with the latest credential checks when the row does
+ * not already show them. Usage and health have their own times, actions and failures, so a usage
+ * failure never reads as a sign-in problem. Products own both mutations and their authority.
+ */
+export function AccountObservations<E>({
+  account,
+  query,
+  refresh,
+  health,
+  plan = false,
+  Failure,
+}: {
+  readonly account: AccountSummary;
+  readonly query: Query<AccountObservationsView, E>;
+  /** Collect usage again; the product updates `query` from the response. */
+  readonly refresh: () => Promise<Exit.Exit<unknown, E>>;
+  /** The apps using the account and their check, where the row has no check of its own. */
+  readonly health?: {
+    readonly apps: readonly App[];
+    readonly check: () => Promise<Exit.Exit<unknown, E>>;
+    readonly showStatus?: boolean;
+    readonly canReconnect?: (app: App) => boolean;
+  };
+  /** Name the reported plan on the usage line, where the row has no metadata line for it. */
+  readonly plan?: boolean;
+  readonly Failure: ComponentType<FailureProps<NoInfer<E>>>;
+}) {
+  const { result, refresh: reload } = useQuery(query);
+  const now = useAtomValue(clock);
+  const format = useDisplayFormat();
+  const [open, setOpen] = useState(false);
+  const details = useId();
+  const view = Option.getOrUndefined(AsyncResult.value(result));
+  const inspected = view?.canInspect === true ? view : undefined;
+  const collecting = inspected?.reports.some((report) => report.collecting) === true;
+  // Another request's collection is under a short lease; read again on the next clock tick.
+  useEffect(() => {
+    if (collecting) reload();
+  }, [collecting, now, reload]);
+  const label = account.label || "Unnamed account";
+  return (
+    <div
+      role="group"
+      aria-label={`${health === undefined ? "Usage" : "Usage and health"} of ${label}`}
+      data-account-observations
+      className="@container grid min-w-0 grid-cols-[minmax(0,_1fr)] gap-2.5 text-[11px] text-foreground/80"
+    >
+      {inspected?.reports.map(
+        (report) =>
+          report.result !== null && (
+            <ObservationReadings
+              key={report.source.id}
+              record={report}
+              {...(inspected.reports.length > 1 ? { source: report.source.label } : {})}
+              now={now}
+              format={format}
+            />
+          ),
+      )}
+      <div
+        className={cn(
+          "grid min-w-0 grid-cols-[minmax(0,_1fr)] items-start gap-x-6 gap-y-1.5 text-muted-foreground",
+          health === undefined
+            ? "@[740px]:grid-cols-[minmax(0,_1fr)_auto]"
+            : "@[740px]:grid-cols-[minmax(0,_1fr)_minmax(0,_1fr)_auto]",
+        )}
+      >
+        {health !== undefined && (
+          <AccountHealthLine account={account} {...health} Failure={Failure} />
+        )}
+        <UsageFact
+          result={result}
+          retry={reload}
+          refresh={refresh}
+          plan={plan}
+          now={now}
+          format={format}
+          Failure={Failure}
+        />
+        {(inspected !== undefined && inspected.reports.length > 0) || health !== undefined ? (
+          <Button
+            variant="ghost"
+            size="xs"
+            className="justify-self-start text-muted-foreground hover:text-foreground"
+            aria-expanded={open}
+            aria-controls={details}
+            onClick={() => setOpen((value) => !value)}
+          >
+            Details
+            <HugeiconsIcon
+              icon={ArrowDown01Icon}
+              strokeWidth={2}
+              aria-hidden
+              className={cn("transition-transform", open && "rotate-180")}
+            />
+          </Button>
+        ) : null}
+      </div>
+      {open && (
+        <ObservationDetails
+          id={details}
+          reports={inspected?.reports ?? []}
+          account={account}
+          apps={health?.apps}
+          now={now}
+          format={format}
+        />
+      )}
+    </div>
+  );
+}
+
+/** The plan or offering a source reported, for the account's metadata line. */
+export function AccountObservationPlan<E>({
+  query,
+}: {
+  readonly query: Query<AccountObservationsView, E>;
+}) {
+  const view = Option.getOrUndefined(AsyncResult.value(useAtomValue(query)));
+  return view?.canInspect === true ? <PlanTags view={view} /> : null;
+}
+
+function PlanTags({ view }: { readonly view: AccountObservationsView }) {
+  const labels = new Set(
+    view.reports.flatMap((report) => {
+      const label = report.result === null ? undefined : planLabel(report.result.observation);
+      return label === undefined ? [] : [label];
+    }),
+  );
+  return [...labels].map((label) => (
+    <span
+      key={label}
+      data-account-plan
+      className="rounded border px-1.5 py-0.5 text-[10px] text-foreground"
+    >
+      {label}
+    </span>
+  ));
+}
+
+/**
+ * Where usage came from and how old it is, with Refresh. Retained readings keep their original
+ * age after a failed refresh, and a denied caller sees no source, time or attempt.
+ */
+function UsageFact<E>({
+  result,
+  retry,
+  refresh,
+  plan,
+  now,
+  format,
+  Failure,
+}: {
+  readonly result: AsyncResult.AsyncResult<AccountObservationsView, E>;
+  readonly retry: () => void;
+  readonly refresh: () => Promise<Exit.Exit<unknown, E>>;
+  readonly plan: boolean;
+  readonly now: number;
+  readonly format: DisplayFormat;
+  readonly Failure: ComponentType<FailureProps<NoInfer<E>>>;
+}) {
+  const [pending, setPending] = useState(false);
+  const [error, setError] = useState<Cause.Cause<E>>();
+  const view = Option.getOrUndefined(AsyncResult.value(result));
+  const line = "flex min-h-6 min-w-0 flex-wrap items-center gap-x-1.5 gap-y-0.5";
+  if (view === undefined)
+    return AsyncResult.isFailure(result) ? (
+      <div className="min-w-0">
+        <Failure cause={result.cause} retry={retry} retrying={result.waiting} layout="compact" />
+      </div>
+    ) : (
+      <div role="status" className={line}>
+        Loading usage…
+      </div>
+    );
+  if (!view.canInspect)
+    return (
+      <div className={line} data-usage-restricted>
+        Usage isn't shared with you. Ask the owner if you need it.
+      </div>
+    );
+  const run = async () => {
+    if (pending) return;
+    setPending(true);
+    setError(undefined);
+    const exit = await refresh();
+    setPending(false);
+    if (Exit.isFailure(exit)) setError(exit.cause);
+  };
+  const blocked = refreshBlocked(view, now, format);
+  const action = (
+    <Button
+      variant="outline"
+      size="xs"
+      className="ml-1"
+      loading={pending}
+      disabledReason={pending ? undefined : blocked}
+      onClick={() => void run()}
+    >
+      Refresh
+    </Button>
+  );
+  return (
+    <div className="flex min-w-0 flex-col gap-0.75" data-usage>
+      {view.reports.length === 0 && (
+        <div className={line}>
+          <span>No usage reported for this account.</span>
+          {action}
+        </div>
+      )}
+      {view.reports.map((report, index) => {
+        const read = report.result === null ? undefined : readingTimes(report.result)[0];
+        const stale = report.freshness !== "fresh";
+        const note = attemptNote(report, now, format);
+        return (
+          <div key={report.source.id} className="flex min-w-0 flex-col gap-0.75">
+            <div className={line} data-usage-source={report.source.id}>
+              {index === 0 && plan && <PlanTags view={view} />}
+              <span>Usage from {report.source.label}</span>
+              <span aria-hidden>·</span>
+              {read === undefined ? (
+                <span>no reading yet</span>
+              ) : (
+                <span
+                  className={stale ? "text-sign-in-warning" : undefined}
+                  data-freshness={report.freshness}
+                >
+                  {stale ? "last read " : "read "}
+                  <time dateTime={read} title={moment(read, now, format)}>
+                    {age(read, now)}
+                  </time>
+                  {report.freshness === "outdated" && " by an earlier app version"}
+                </span>
+              )}
+              {index === 0 && action}
+            </div>
+            {note !== undefined && (
+              <span className="wrap-anywhere text-foreground/80" data-attempt-note>
+                {note}
+              </span>
+            )}
+          </div>
+        );
+      })}
+      {error && <Failure cause={error} layout="compact" />}
+      {AsyncResult.isFailure(result) && (
+        <Failure cause={result.cause} retry={retry} retrying={result.waiting} layout="compact" />
+      )}
+    </div>
+  );
+}
