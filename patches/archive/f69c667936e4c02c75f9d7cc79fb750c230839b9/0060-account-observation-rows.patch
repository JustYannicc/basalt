@@ -0,0 +1,81 @@
+/** Account usage reads and refreshes. Seeing usage and refreshing it are separate hosted grants. */
+import type { AccountId } from "@executor-js/sdk";
+import type { OrganizationReference } from "@executor-js/hosted-server/organization";
+import type { ObservationPolicy } from "@executor-js/hosted-server/account-observations";
+export type { ObservationPolicy } from "@executor-js/hosted-server/account-observations";
+export type ObservationAudience = ObservationPolicy["read"];
+import { browserOnly } from "@executor-js/ui/contracts/http";
+import { acknowledge, invalidate } from "@executor-js/ui/contracts/mutations";
+import { Data, Effect } from "effect";
+import { Atom } from "effect/reactivity";
+import { HostedClient } from "./api.ts";
+import { protectedQuery } from "./protected-query.ts";
+
+class AccountKey extends Data.Class<{
+  readonly organization: OrganizationReference;
+  readonly account: AccountId;
+}> {}
+
+// Neither sent with the page nor kept after the row closes: every view reads the current policy
+// verdict, so a revoked grant never shows readings fetched under the old one. Reads never collect.
+const observations = Atom.family((key: AccountKey) =>
+  protectedQuery(browserOnly(HostedClient.query("accounts", "observations", { params: key }))),
+);
+/** The caller's view of an account's retained usage, with what the policy lets them do. */
+export const accountObservationsAtom = (key: {
+  readonly organization: OrganizationReference;
+  readonly account: AccountId;
+}) => observations(new AccountKey(key));
+
+const refreshObservations = Atom.family((key: AccountKey) =>
+  HostedClient.runtime.fn((_: void, get) =>
+    Effect.flatMap(HostedClient, (client) =>
+      client.accounts.refreshObservations({ params: key }),
+    ).pipe(
+      // The response holds the new readings; the query read after it states the caller's grants.
+      Effect.tap((view) => Effect.sync(() => acknowledge(get, observations(key), () => view))),
+      // Access ended while the row was open: read the verdict again so its readings go too.
+      Effect.tapError((error) =>
+        error._tag === "OrganizationForbidden"
+          ? Effect.sync(() => get.refresh(observations(key)))
+          : Effect.void,
+      ),
+    ),
+  ),
+);
+/** Collect usage again where the policy allows it; the source's own limits still apply. */
+export const refreshAccountObservationsAtom = (key: {
+  readonly organization: OrganizationReference;
+  readonly account: AccountId;
+}) => refreshObservations(new AccountKey(key));
+
+const policy = Atom.family((key: AccountKey) =>
+  protectedQuery(HostedClient.query("accounts", "observationPolicy", { params: key })),
+);
+/** Who besides the account's managers may see and refresh its usage; managers only. */
+export const observationPolicyAtom = (key: {
+  readonly organization: OrganizationReference;
+  readonly account: AccountId;
+}) => policy(new AccountKey(key));
+
+const savePolicy = Atom.family((key: AccountKey) =>
+  HostedClient.runtime.fn((payload: ObservationPolicy, get) =>
+    Effect.flatMap(HostedClient, (client) =>
+      client.accounts.setObservationPolicy({ params: key, payload }),
+    ).pipe(
+      Effect.tap((saved) =>
+        Effect.sync(() => {
+          acknowledge(get, policy(key), () => saved);
+          invalidate(get, observations(key));
+        }),
+      ),
+      // A conflicting edit means the draft's revision is old; read the saved policy again.
+      Effect.tapError(() => Effect.sync(() => get.refresh(policy(key)))),
+    ),
+  ),
+);
+/** Policy saves compare the revision the editor loaded, like account sharing. */
+export const saveObservationPolicyAtom = (key: {
+  readonly organization: OrganizationReference;
+  readonly account: AccountId;
+}) => savePolicy(new AccountKey(key));
