+import type { AccountObservationRecord } from "@executor-js/sdk";
+import type { DisplayFormat } from "../../contracts/display.ts";
+import { cn } from "../lib/utils.ts";
+import {
+  age,
+  balanceView,
+  readingTimes,
+  windowView,
+  type ObservationMeterState,
+} from "./account-observation-format.ts";
+
+const fills = {
+  good: "bg-emerald-500",
+  warn: "bg-amber-500",
+  bad: "bg-destructive",
+  exhausted: "",
+  unknown: "",
+  unlimited: "",
+} satisfies Record<ObservationMeterState, string>;
+const flagTone = (flag: string, stale: boolean) =>
+  stale
+    ? ""
+    : flag === "Low"
+      ? "font-medium text-amber-700 dark:text-amber-400"
+      : "font-medium text-destructive";
+
+/** One cell per window or balance; a stale reading keeps its exact amount and drawn width. */
+export function ObservationReadings({
+  record,
+  source,
+  now,
+  format,
+}: {
+  readonly record: AccountObservationRecord;
+  readonly source?: string;
+  readonly now: number;
+  readonly format: DisplayFormat;
+}) {
+  const result = record.result;
+  if (result === null) return null;
+  const { windows, balances } = result.observation;
+  if (windows.length === 0 && balances.length === 0) return null;
+  const stale = record.freshness !== "fresh";
+  const newest = Date.parse(readingTimes(result)[0] ?? result.observedAt);
+  // A reading older than the rest of its read names its own age.
+  const ownAge = (observedAt: string) =>
+    newest - Date.parse(observedAt) >= 60_000 ? (
+      <span className={stale ? "text-sign-in-warning" : undefined}>
+        read <time dateTime={observedAt}>{age(observedAt, now)}</time>
+      </span>
+    ) : null;
+  return (
+    <div
+      {...(source === undefined ? {} : { "aria-label": `Usage from ${source}`, role: "group" })}
+      data-observation-source={record.source.id}
+      data-freshness={record.freshness}
+      className="grid max-w-[900px] grid-cols-[repeat(auto-fill,_minmax(190px,_1fr))] gap-x-6 gap-y-2.5 max-[740px]:grid-cols-[minmax(0,_1fr)]"
+    >
+      {windows.map((entry) => {
+        const reading = windowView(entry, now, format);
+        const sub = [reading.timing, reading.note].filter((part) => part !== undefined);
+        return (
+          <div
+            key={entry.id}
+            className="flex min-w-0 flex-col gap-1"
+            data-reading={entry.id}
+            data-meter-state={reading.state}
+            {...(stale ? { "data-stale": "" } : {})}
+          >
+            <div className="flex min-w-0 items-baseline justify-between gap-2">
+              <span className="truncate font-medium text-foreground" title={entry.label}>
+                {entry.label}
+              </span>
+              <span className="shrink-0 tabular-nums" data-reading-value>
+                {reading.value}
+                {reading.flag !== undefined && (
+                  <>
+                    {" · "}
+                    <span className={flagTone(reading.flag, stale)}>{reading.flag}</span>
+                  </>
+                )}
+              </span>
+            </div>
+            {reading.state !== "unlimited" && (
+              <span
+                role="meter"
+                aria-label={stale ? `${entry.label}, stale` : entry.label}
+                aria-valuemin={0}
+                aria-valuemax={reading.aria.max}
+                {...(reading.aria.now === undefined ? {} : { "aria-valuenow": reading.aria.now })}
+                aria-valuetext={[
+                  reading.value,
+                  reading.flag,
+                  stale ? `when last read ${age(entry.observedAt, now)}` : undefined,
+                  reading.timing,
+                ]
+                  .filter((part) => part !== undefined)
+                  .join(", ")}
+                className={cn(
+                  "block h-1.5 overflow-hidden rounded-full bg-border",
+                  reading.state === "unknown" &&
+                    "bg-[repeating-linear-gradient(135deg,var(--color-muted)_0_3px,var(--color-muted-foreground)_3px_4px)] opacity-55",
+                  reading.state === "exhausted" &&
+                    (stale
+                      ? "ring-1 ring-inset ring-muted-foreground/60"
+                      : "bg-destructive/20 ring-1 ring-inset ring-destructive/40"),
+                )}
+              >
+                {reading.width !== undefined && reading.width > 0 && (
+                  <span
+                    className={cn(
+                      "block h-full rounded-full",
+                      stale ? "bg-muted-foreground/45" : fills[reading.state],
+                    )}
+                    style={{ width: `${reading.width}%` }}
+                  />
+                )}
+              </span>
+            )}
+            <div className="flex min-w-0 flex-wrap justify-between gap-x-2 gap-y-0.5 text-muted-foreground">
+              {sub.length > 0 && <span className="wrap-anywhere">{sub.join(" · ")}</span>}
+              {ownAge(entry.observedAt)}
+            </div>
+          </div>
+        );
+      })}
+      {balances.map((entry) => {
+        const balance = balanceView(entry, now, format);
+        return (
+          <div
+            key={entry.id}
+            className="flex min-w-0 flex-col gap-1"
+            data-reading={entry.id}
+            data-balance
+            {...(stale || balance.expired ? { "data-stale": "" } : {})}
+          >
+            <div className="flex min-w-0 items-baseline justify-between gap-2">
+              <span className="truncate font-medium text-foreground" title={entry.label}>
+                {entry.label}
+              </span>
+              <span className="shrink-0 tabular-nums" data-reading-value>
+                {balance.value}
+              </span>
+            </div>
+            <span className="flex h-1.5 gap-[3px]" aria-hidden>
+              {Array.from({ length: balance.pips }, (_, index) => (
+                <i
+                  key={index}
+                  className={cn(
+                    "w-4 rounded-full",
+                    stale || balance.expired ? "bg-muted-foreground/45" : "bg-foreground/55",
+                  )}
+                />
+              ))}
+            </span>
+            <div className="flex min-w-0 flex-wrap justify-between gap-x-2 gap-y-0.5 text-muted-foreground">
+              {balance.timing !== undefined && (
+                <span className="wrap-anywhere">{balance.timing}</span>
+              )}
+              {ownAge(entry.observedAt)}
+            </div>
+          </div>
+        );
+      })}
+    </div>
+  );
+}
