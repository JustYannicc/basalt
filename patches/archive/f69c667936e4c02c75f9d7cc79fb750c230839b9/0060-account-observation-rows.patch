+import { lazy, Suspense } from "react";
+import { useHydrated } from "@executor-js/ui/hooks/hydrated";
+import type {
+  LocalAccountObservations as LocalAccountObservationsClient,
+  LocalAccountPlan as LocalAccountPlanClient,
+} from "./account-observations-client.tsx";
+
+// The SSR guard removes the renderer from the Worker; a server-side lazy chunk still uploads.
+const loadObservations = () =>
+  import.meta.env.SSR
+    ? Promise.reject(new Error("Account observations render only in a browser"))
+    : import("./account-observations-client.tsx");
+
+const ObservationsView = lazy(() =>
+  loadObservations().then((module) => ({ default: module.LocalAccountObservations })),
+);
+const PlanView = lazy(() =>
+  loadObservations().then((module) => ({ default: module.LocalAccountPlan })),
+);
+
+export function LocalAccountObservations(
+  props: Parameters<typeof LocalAccountObservationsClient>[0],
+) {
+  const hydrated = useHydrated();
+  return hydrated ? (
+    <Suspense fallback={null}>
+      <ObservationsView {...props} />
+    </Suspense>
+  ) : null;
+}
+
+export function LocalAccountPlan(props: Parameters<typeof LocalAccountPlanClient>[0]) {
+  const hydrated = useHydrated();
+  return hydrated ? (
+    <Suspense fallback={null}>
+      <PlanView {...props} />
+    </Suspense>
+  ) : null;
+}
