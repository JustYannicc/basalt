+import type { AccountCheckStatus, App } from "@executor-js/sdk";
+import { Exit, type Cause } from "effect";
+import { useState, type ComponentType } from "react";
+import type { AccountSummary, FailureProps } from "../../contracts/dashboard.ts";
+import { appDisplayName } from "../../contracts/product-brand.ts";
+import { Button, buttonVariants } from "../components/button.tsx";
+import { LocalTime, shortMoment } from "../components/local-time.tsx";
+import { useProductBrand } from "../hooks/product-brand.ts";
+import { cn } from "../lib/utils.ts";
+import { describeAccountCheck } from "./account-health.tsx";
+import { useDashboard } from "./context.tsx";
+
+const severity: readonly AccountCheckStatus[] = [
+  "credentials_rejected",
+  "forbidden",
+  "upstream_unavailable",
+  "check_failed",
+  "healthy",
+];
+const dots = {
+  good: "bg-emerald-500",
+  bad: "bg-destructive",
+  warn: "bg-amber-500",
+  muted: "bg-muted-foreground/50",
+};
+const states = {
+  good: "",
+  bad: "text-destructive",
+  warn: "text-amber-700 dark:text-amber-400",
+  muted: "",
+};
+
+/**
+ * The latest check of each app, one line per result, worst first. Only a current rejection offers
+ * Reconnect, in the app that reported it; a failed or timed-out check makes no claim about the
+ * sign-in.
+ */
+export function AccountHealthLine<E>({
+  account,
+  apps,
+  check,
+  showStatus = true,
+  canReconnect,
+  Failure,
+}: {
+  readonly account: AccountSummary;
+  readonly apps: readonly App[];
+  readonly check: () => Promise<Exit.Exit<unknown, E>>;
+  readonly showStatus?: boolean;
+  readonly canReconnect?: (app: App) => boolean;
+  readonly Failure: ComponentType<FailureProps<NoInfer<E>>>;
+}) {
+  const brand = useProductBrand();
+  const { AppLink } = useDashboard();
+  const [pending, setPending] = useState(false);
+  const [error, setError] = useState<Cause.Cause<E>>();
+  const entries = (account.health?.apps ?? []).filter((entry) =>
+    apps.some((app) => app.id === entry.app),
+  );
+  const checkable = entries.some((entry) => entry.checkable);
+  const name = (id: string) => {
+    const app = apps.find((item) => item.id === id);
+    return app === undefined ? "an app" : appDisplayName(app, brand);
+  };
+  const groups = [true, false].flatMap((current) =>
+    severity.flatMap((status) => {
+      const matching = entries.flatMap((entry) =>
+        entry.check !== null && entry.check.current === current && entry.check.status === status
+          ? [{ app: entry.app, check: entry.check }]
+          : [],
+      );
+      const [first] = matching;
+      return first === undefined ? [] : [{ status, current, matching, first }];
+    }),
+  );
+  const run = async () => {
+    if (pending) return;
+    setPending(true);
+    setError(undefined);
+    const exit = await check();
+    setPending(false);
+    if (Exit.isFailure(exit)) setError(exit.cause);
+  };
+  const action = (
+    <Button
+      variant="outline"
+      size="xs"
+      className="ml-1"
+      loading={pending}
+      disabledReason={checkable ? undefined : "No app that uses this account defines a check."}
+      onClick={() => void run()}
+    >
+      Check now
+    </Button>
+  );
+  const rejected = groups.find((group) => group.current && group.status === "credentials_rejected");
+  const reconnect = rejected?.matching
+    .map((entry) => apps.find((app) => app.id === entry.app))
+    .find((app) => app !== undefined && canReconnect?.(app) === true);
+  if (!showStatus)
+    return (
+      <div data-account-health>
+        {action}
+        {error && <Failure cause={error} layout="compact" />}
+      </div>
+    );
+  return (
+    <div className="flex min-w-0 flex-col gap-0.75" data-account-health>
+      {groups.length === 0 && (
+        <div className="flex min-h-6 flex-wrap items-center gap-x-1.5 gap-y-0.5">
+          <span>{checkable ? "Not checked yet" : "No app checks this account"}</span>
+          {action}
+        </div>
+      )}
+      {groups.map((group, index) => {
+        const { label, tone } = describeAccountCheck(group.status);
+        const latest = group.matching
+          .map((entry) => entry.check.checkedAt)
+          .reduce((a, b) => (a > b ? a : b), group.first.check.checkedAt);
+        const message = group.matching
+          .map((entry) => entry.check.message)
+          .find((value) => value !== undefined);
+        return (
+          <div key={`${group.status}:${group.current}`} className="flex min-w-0 flex-col gap-0.75">
+            <div className="flex min-h-6 flex-wrap items-center gap-x-1.5 gap-y-0.5">
+              <span
+                aria-hidden
+                className={cn("size-1.5 rounded-full", group.current ? dots[tone] : dots.muted)}
+              />
+              <span
+                className={cn("font-medium text-foreground", group.current && states[tone])}
+                data-check-status={group.status}
+                data-check-current={group.current}
+              >
+                {group.current ? label : `${label} · outdated`}
+              </span>
+              <span>
+                in{" "}
+                {group.matching.length === 1
+                  ? name(group.first.app)
+                  : `${group.matching.length} apps`}
+              </span>
+              <span aria-hidden>·</span>
+              <span>
+                checked <LocalTime value={latest} options={shortMoment} />
+              </span>
+              {index === 0 && action}
+              {index === 0 && reconnect !== undefined && (
+                <AppLink
+                  app={reconnect.id}
+                  view="accounts"
+                  className={buttonVariants({ variant: "outline", size: "xs" })}
+                  aria-label={`Reconnect in ${name(reconnect.id)}`}
+                >
+                  Reconnect
+                </AppLink>
+              )}
+            </div>
+            {message !== undefined && (
+              <span className="wrap-anywhere text-foreground/80" data-check-message>
+                {message}
+              </span>
+            )}
+          </div>
+        );
+      })}
+      {error && <Failure cause={error} layout="compact" />}
+    </div>
+  );
+}
