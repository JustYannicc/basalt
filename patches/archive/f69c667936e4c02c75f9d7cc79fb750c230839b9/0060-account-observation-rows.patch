diff --git a/packages/ui/src/implementation/dashboard/account-observation-details.tsx b/packages/ui/src/implementation/dashboard/account-observation-details.tsx
new file mode 100644
index 000000000..e31097c36
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/account-observation-details.tsx
@@ -0,0 +1,211 @@
+import type { AccountObservationRecord, App } from "@executor-js/sdk";
+import type { ReactNode } from "react";
+import type { AccountSummary } from "../../contracts/dashboard.ts";
+import type { DisplayFormat } from "../../contracts/display.ts";
+import { appDisplayName } from "../../contracts/product-brand.ts";
+import { useProductBrand } from "../hooks/product-brand.ts";
+import { describeAccountCheck } from "./account-health.tsx";
+import {
+  age,
+  attemptReasons,
+  balanceView,
+  moment,
+  windowView,
+} from "./account-observation-format.ts";
+
+// Narrow screens read each row as label/value pairs instead of a squeezed table.
+const tableClass = "w-full border-collapse text-[11px]";
+const headClass =
+  "border-b border-border py-0.75 pr-3 text-left font-normal text-muted-foreground max-[740px]:hidden";
+const rowClass =
+  "max-[740px]:block max-[740px]:border-b max-[740px]:border-border/60 max-[740px]:py-1.5";
+const cellClass =
+  "border-b border-border/60 py-1.25 pr-3 align-top wrap-anywhere max-[740px]:flex max-[740px]:gap-2.5 max-[740px]:border-0 max-[740px]:py-px max-[740px]:pr-0 max-[740px]:before:min-w-24 max-[740px]:before:text-muted-foreground max-[740px]:before:content-[attr(data-label)]";
+
+function Table({
+  caption,
+  columns,
+  rows,
+}: {
+  readonly caption: string;
+  readonly columns: readonly string[];
+  readonly rows: readonly { readonly key: string; readonly cells: readonly ReactNode[] }[];
+}) {
+  return (
+    <table className={tableClass}>
+      <caption className="pb-1 text-left font-medium text-foreground">{caption}</caption>
+      <thead>
+        <tr>
+          {columns.map((column) => (
+            <th key={column} scope="col" className={headClass}>
+              {column}
+            </th>
+          ))}
+        </tr>
+      </thead>
+      <tbody>
+        {rows.map((row) => (
+          <tr key={row.key} className={rowClass}>
+            {row.cells.map((cell, index) => (
+              <td key={columns[index]} data-label={columns[index]} className={cellClass}>
+                {cell}
+              </td>
+            ))}
+          </tr>
+        ))}
+      </tbody>
+    </table>
+  );
+}
+
+const lastRefresh = (
+  attempt: NonNullable<AccountObservationRecord["lastAttempt"]>,
+  now: number,
+  format: DisplayFormat,
+) => {
+  const at = moment(attempt.attemptedAt, now, format);
+  return attempt.outcome === "success"
+    ? `succeeded ${at}.`
+    : `failed ${at}: ${attemptReasons[attempt.outcome]}.`;
+};
+
+const checkReasons = {
+  unauthorized: "The service rejected the sign-in.",
+  forbidden: "The sign-in is missing a permission the check needs.",
+  rate_limited: "The service is limiting requests.",
+  unavailable: "The service did not answer.",
+  rejected: "The service rejected the request.",
+} as const;
+
+/**
+ * Every reading with its own read time, where each report came from and how its last refresh
+ * went, and every app's latest check with its reason. Shown only on request.
+ */
+export function ObservationDetails({
+  id,
+  reports,
+  account,
+  apps,
+  now,
+  format,
+}: {
+  readonly id: string;
+  readonly reports: readonly AccountObservationRecord[];
+  readonly account: AccountSummary;
+  readonly apps?: readonly App[] | undefined;
+  readonly now: number;
+  readonly format: DisplayFormat;
+}) {
+  const brand = useProductBrand();
+  const read = (value: string, stale: boolean) => (
+    <>
+      <span className={stale ? "text-sign-in-warning" : undefined}>{age(value, now)}</span>{" "}
+      <time dateTime={value} className="text-muted-foreground">
+        {moment(value, now, format)}
+      </time>
+    </>
+  );
+  return (
+    <div
+      id={id}
+      data-observation-details
+      className="grid max-w-[900px] gap-3 border-t border-dashed border-border pt-2.5"
+    >
+      {reports.map((report) => {
+        const stale = report.freshness !== "fresh";
+        const observation = report.result?.observation;
+        const attempt = report.lastAttempt;
+        return (
+          <div key={report.source.id} className="grid gap-2">
+            {observation !== undefined && (
+              <Table
+                caption={reports.length > 1 ? `Readings from ${report.source.label}` : "Readings"}
+                columns={["Reading", "Amount", "Resets or expires", "Read"]}
+                rows={[
+                  ...(observation.plan === undefined
+                    ? []
+                    : [
+                        {
+                          key: "plan",
+                          cells: [
+                            "Plan",
+                            observation.plan.label,
+                            <span key="reset" className="text-muted-foreground">
+                              Not reported
+                            </span>,
+                            read(observation.plan.observedAt, stale),
+                          ],
+                        },
+                      ]),
+                  ...observation.windows.map((entry) => {
+                    const view = windowView(entry, now, format);
+                    return {
+                      key: `window:${entry.id}`,
+                      cells: [entry.label, view.detail, view.when, read(entry.observedAt, stale)],
+                    };
+                  }),
+                  ...observation.balances.map((entry) => {
+                    const view = balanceView(entry, now, format);
+                    return {
+                      key: `balance:${entry.id}`,
+                      cells: [entry.label, view.detail, view.when, read(entry.observedAt, stale)],
+                    };
+                  }),
+                ]}
+              />
+            )}
+            <p className="leading-[1.6] text-muted-foreground" data-observation-provenance>
+              <b className="font-medium text-foreground/80">Source:</b> the{" "}
+              {report.source.kind === "app" ? "app" : "driver"} {report.source.label}, version{" "}
+              {report.source.version}.{" "}
+              {report.freshness === "outdated" &&
+                "These readings came from an earlier version and stay until the next refresh. "}
+              {attempt !== null && (
+                <>
+                  <b className="font-medium text-foreground/80">Last refresh</b>{" "}
+                  {lastRefresh(attempt, now, format)}{" "}
+                  {attempt.outcome !== "success" &&
+                    report.result !== null &&
+                    "The amounts above are from the last successful read. "}
+                </>
+              )}
+              {report.result === null && "No reading has been saved yet. "}
+              {report.nextAllowedAt === null
+                ? "Next refresh allowed now."
+                : `Next refresh allowed at ${moment(report.nextAllowedAt, now, format)}.`}
+            </p>
+          </div>
+        );
+      })}
+      {apps !== undefined && apps.length > 0 && (
+        <Table
+          caption="Checks"
+          columns={["App", "Result", "Checked", "Reason"]}
+          rows={apps.map((app) => {
+            const entry = account.health?.apps.find((item) => item.app === app.id);
+            const check = entry?.check ?? null;
+            const result =
+              check === null ? (entry?.checkable === true ? "Not checked" : "No check") : undefined;
+            const { label } = check === null ? { label: "" } : describeAccountCheck(check.status);
+            return {
+              key: app.id,
+              cells: [
+                appDisplayName(app, brand),
+                result ?? (check?.current === false ? `${label} · outdated` : label),
+                check === null ? "—" : moment(check.checkedAt.toISOString(), now, format),
+                check?.message ??
+                  (check?.reason === undefined ? (
+                    <span key="reason" className="text-muted-foreground">
+                      None
+                    </span>
+                  ) : (
+                    checkReasons[check.reason]
+                  )),
+              ],
+            };
+          })}
+        />
+      )}
+    </div>
+  );
+}
diff --git a/packages/ui/src/implementation/dashboard/account-observation-format.ts b/packages/ui/src/implementation/dashboard/account-observation-format.ts
new file mode 100644
index 000000000..a0d65f64e
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/account-observation-format.ts
@@ -0,0 +1,267 @@
+/**
+ * What an account observation says, as text and drawn widths. Missing amounts stay unknown, a
+ * ratio stays a percentage, zero stays zero and an amount over its limit stays exact; only the
+ * drawn bar is clamped. Nothing here invents a capacity, a reset time or a refill.
+ */
+import type { AccountObservationRecord } from "@executor-js/sdk";
+import type { DisplayFormat } from "../../contracts/display.ts";
+import { formatMoment } from "../hooks/display-format.ts";
+
+type Result = NonNullable<AccountObservationRecord["result"]>;
+type Observation = Result["observation"];
+type Window = Observation["windows"][number];
+type Balance = Observation["balances"][number];
+export type ObservationMeterState = "good" | "warn" | "bad" | "exhausted" | "unknown" | "unlimited";
+
+const day = 86_400_000;
+
+/** Elapsed time in its two largest units, such as "2 h 14 min". */
+export const span = (milliseconds: number) => {
+  const minutes = Math.floor(Math.abs(milliseconds) / 60_000);
+  if (minutes < 1) return "less than a minute";
+  if (minutes < 60) return `${minutes} min`;
+  const hours = Math.floor(minutes / 60);
+  if (hours < 24) return minutes % 60 === 0 ? `${hours} h` : `${hours} h ${minutes % 60} min`;
+  const days = Math.floor(hours / 24);
+  return `${days} ${days === 1 ? "day" : "days"}`;
+};
+
+/** A source instant as age. Hosts accept a minute of clock skew; a later instant reads as now. */
+export const age = (value: string, now: number) => {
+  const elapsed = now - Date.parse(value);
+  return elapsed < 60_000 ? "just now" : `${span(elapsed)} ago`;
+};
+
+/** Today's moments show the time only; others name the day as well. */
+export const moment = (value: string, now: number, format: DisplayFormat) => {
+  const time = { hour: "numeric", minute: "2-digit" } as const;
+  const sameDay =
+    formatMoment(value, format, { dateStyle: "short" }) ===
+    formatMoment(now, format, { dateStyle: "short" });
+  return formatMoment(
+    value,
+    format,
+    sameDay ? time : { weekday: "short", day: "numeric", month: "short", ...time },
+  );
+};
+
+const currencies = new Set(Intl.supportedValuesOf("currency"));
+const isCurrency = (unit: string) => currencies.has(unit);
+const isPercent = (unit: string) => unit === "%" || unit.toLowerCase() === "percent";
+
+export const amount = (value: number, unit: string, format: DisplayFormat, withUnit = false) => {
+  if (isCurrency(unit))
+    return new Intl.NumberFormat(format.locale, { style: "currency", currency: unit }).format(
+      value,
+    );
+  const number = new Intl.NumberFormat(format.locale, { maximumFractionDigits: 2 }).format(value);
+  if (isPercent(unit)) return `${number}%`;
+  return withUnit ? `${number} ${unit}` : number;
+};
+
+const toneOf = (ratio: number): ObservationMeterState =>
+  ratio <= 0 ? "exhausted" : ratio >= 0.7 ? "good" : ratio >= 0.3 ? "warn" : "bad";
+
+const periodSpan = (period: NonNullable<Window["period"]>) => {
+  const seconds = period.seconds;
+  if (seconds === undefined)
+    return period.value !== undefined && period.unit !== undefined
+      ? `${period.value}-${period.unit}`
+      : undefined;
+  const [size, unit]: readonly [number, string] =
+    seconds % 86_400 === 0
+      ? [86_400, "day"]
+      : seconds % 3_600 === 0
+        ? [3_600, "hour"]
+        : seconds % 60 === 0
+          ? [60, "minute"]
+          : [1, "second"];
+  return `${seconds / size}-${unit}`;
+};
+
+/** One reported window: its amount, drawn width and reset, exactly as the source gave them. */
+export function windowView(entry: Window, now: number, format: DisplayFormat) {
+  const { unit, used, limit } = entry.measure;
+  const unlimited = entry.measure.unlimited === true;
+  const remaining =
+    entry.measure.remaining ??
+    (used !== undefined && limit !== undefined ? limit - used : undefined);
+  const ratio =
+    entry.measure.remainingRatio ??
+    (remaining !== undefined && limit !== undefined && limit > 0 ? remaining / limit : undefined);
+  const over = remaining !== undefined && remaining < 0;
+  const short = (value: number) => amount(value, unit, format);
+  const long = (value: number) => amount(value, unit, format, true);
+  const phrase = (last: (value: number) => string) =>
+    remaining !== undefined && limit !== undefined
+      ? over
+        ? `${short(limit - remaining)} of ${last(limit)} used`
+        : `${short(remaining)} of ${last(limit)} left`
+      : remaining !== undefined
+        ? `${last(remaining)} left`
+        : used !== undefined
+          ? `${last(used)} used`
+          : undefined;
+  const percent = ratio === undefined ? undefined : Math.round(ratio * 100);
+  const state: ObservationMeterState = unlimited
+    ? "unlimited"
+    : over || remaining === 0
+      ? "exhausted"
+      : ratio === undefined
+        ? "unknown"
+        : toneOf(ratio);
+  const absolute = phrase(long);
+  return {
+    state,
+    value: unlimited
+      ? "Unlimited"
+      : (phrase(long) ?? (percent === undefined ? "Usage unknown" : `${percent}% left`)),
+    flag: over
+      ? "Over limit"
+      : state === "exhausted"
+        ? "Exhausted"
+        : state === "warn" || state === "bad"
+          ? "Low"
+          : undefined,
+    detail: unlimited
+      ? "Unlimited"
+      : absolute !== undefined
+        ? `${absolute}${isCurrency(unit) ? ` (${unit})` : ""}`
+        : percent !== undefined
+          ? `${percent}% left (percent only)`
+          : limit !== undefined
+            ? `Unknown of ${long(limit)}`
+            : "Unknown",
+    // The bar draws the remaining share only; it never grows past full or below empty.
+    width: ratio === undefined || unlimited ? undefined : Math.min(100, Math.max(0, ratio * 100)),
+    aria:
+      remaining !== undefined && limit !== undefined
+        ? { now: Math.min(Math.max(0, remaining), limit), max: limit }
+        : percent !== undefined
+          ? { now: Math.min(100, Math.max(0, percent)), max: 100 }
+          : { now: undefined, max: limit ?? 100 },
+    note:
+      state === "unknown" && limit !== undefined && remaining === undefined
+        ? `Limit ${long(limit)}`
+        : used !== undefined && remaining !== undefined && limit !== undefined && !over
+          ? `${short(used)} ${isCurrency(unit) ? "spent" : "used"}`
+          : undefined,
+    ...windowTiming(entry, now, format),
+  };
+}
+
+/** A reset that already passed never refills the old reading; rolling windows have no reset. */
+function windowTiming(entry: Window, now: number, format: DisplayFormat) {
+  if (entry.resetsAt !== undefined) {
+    const at = Date.parse(entry.resetsAt);
+    const when = moment(entry.resetsAt, now, format);
+    if (at <= now)
+      return { timing: `Reset was due ${when}, not read since`, when: `Was due ${when}` };
+    return {
+      timing: at - now < day ? `Resets in ${span(at - now)}` : `Resets ${when}`,
+      when,
+    };
+  }
+  const length = entry.period === undefined ? undefined : periodSpan(entry.period);
+  if (entry.period?.mode === "rolling")
+    return {
+      timing: length === undefined ? "Rolling window" : `Rolling ${length} window`,
+      when: "Rolling, no single reset",
+    };
+  if (length !== undefined) return { timing: `${length} window`, when: "Reset not reported" };
+  return { timing: undefined, when: "Not reported" };
+}
+
+/** A reported balance, such as banked resets or credits. Expired balances are not minted again. */
+export function balanceView(balance: Balance, now: number, format: DisplayFormat) {
+  const expires = balance.expiresAt === undefined ? undefined : Date.parse(balance.expiresAt);
+  const when = balance.expiresAt === undefined ? undefined : moment(balance.expiresAt, now, format);
+  const units =
+    !isCurrency(balance.unit) && Number.isInteger(balance.available) && balance.available > 0
+      ? balance.available
+      : 0;
+  return {
+    value: `${amount(balance.available, balance.unit, format, true)} available`,
+    detail: amount(balance.available, balance.unit, format, true),
+    expired: expires !== undefined && expires <= now,
+    // One pip per whole unit up to eight; larger counts read better as the number alone.
+    pips: units <= 8 ? units : 0,
+    timing:
+      expires === undefined
+        ? undefined
+        : expires <= now
+          ? `Expired ${when}`
+          : `Expires ${when} · in ${span(expires - now)}`,
+    when:
+      expires === undefined
+        ? "Does not expire"
+        : `${expires <= now ? "Expired" : "Expires"} ${when}`,
+  };
+}
+
+const offerings = {
+  subscription: "Subscription",
+  metered_api: "Metered API",
+  prepaid: "Prepaid",
+  other: undefined,
+  unknown: undefined,
+} satisfies Record<Observation["offering"], string | undefined>;
+
+/** The plan a source reported, or the kind of offering when it named no plan. */
+export const planLabel = (observation: Observation) =>
+  observation.plan?.label ?? offerings[observation.offering];
+
+export const attemptReasons = {
+  unavailable: "the source did not return a reading",
+  rate_limited: "the source is limiting requests",
+  invalid: "the source returned a reading that could not be used",
+  timed_out: "the source took too long to answer",
+} as const;
+
+/**
+ * The last refresh, when it failed. A failure never clears the retained reading; it says so. Only
+ * the credential check can say the sign-in needs repair, so no failure here asks for it.
+ */
+export function attemptNote(record: AccountObservationRecord, now: number, format: DisplayFormat) {
+  const attempt = record.lastAttempt;
+  if (attempt === null || attempt.outcome === "success") return undefined;
+  const retry = record.nextAllowedAt ?? attempt.retryAt;
+  return [
+    `Refresh failed ${age(attempt.attemptedAt, now)}: ${attemptReasons[attempt.outcome]}.`,
+    record.result === null ? undefined : "Showing the last successful reading.",
+    retry === undefined || Date.parse(retry) <= now
+      ? undefined
+      : `Next refresh at ${moment(retry, now, format)}.`,
+  ]
+    .filter((part) => part !== undefined)
+    .join(" ");
+}
+
+/** Why Refresh is unavailable right now, if it is. */
+export function refreshBlocked(
+  view: { readonly canRefresh: boolean; readonly reports: readonly AccountObservationRecord[] },
+  now: number,
+  format: DisplayFormat,
+) {
+  if (!view.canRefresh)
+    return "You can see this usage but not refresh it. Ask an account manager if you need to.";
+  if (view.reports.some((report) => report.collecting)) return "Usage is being read now.";
+  const next = view.reports.map((report) =>
+    report.nextAllowedAt === null ? now : Date.parse(report.nextAllowedAt),
+  );
+  const earliest = Math.min(...next);
+  if (next.length === 0 || earliest <= now) return undefined;
+  const at = moment(new Date(earliest).toISOString(), now, format);
+  return `Next refresh allowed at ${at}.`;
+}
+
+/** Every timestamp a record's readings carry, newest first. */
+export const readingTimes = (result: Result) =>
+  [
+    result.observedAt,
+    result.observation.plan?.observedAt,
+    ...result.observation.windows.map((entry) => entry.observedAt),
+    ...result.observation.balances.map((balance) => balance.observedAt),
+  ]
+    .filter((value) => value !== undefined)
+    .sort((a, b) => Date.parse(b) - Date.parse(a));
