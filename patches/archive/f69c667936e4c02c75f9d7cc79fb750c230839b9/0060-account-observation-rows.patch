+++ b/apps/hosted/web/src/implementation/pages/account-observations.tsx
@@ -0,0 +1,52 @@
+import { lazy, Suspense } from "react";
+import { useHydrated } from "@executor-js/ui/hooks/hydrated";
+import type {
+  HostedAccountObservations as HostedAccountObservationsClient,
+  HostedAccountPlan as HostedAccountPlanClient,
+  AccountUsageSettings as AccountUsageSettingsClient,
+} from "./account-observations-client.tsx";
+
+// The SSR guard removes the renderer from the Worker; a server-side lazy chunk still uploads.
+const loadObservations = () =>
+  import.meta.env.SSR
+    ? Promise.reject(new Error("Account observations render only in a browser"))
+    : import("./account-observations-client.tsx");
+
+const ObservationsView = lazy(() =>
+  loadObservations().then((module) => ({ default: module.HostedAccountObservations })),
+);
+const PlanView = lazy(() =>
+  loadObservations().then((module) => ({ default: module.HostedAccountPlan })),
+);
+const UsageSettingsView = lazy(() =>
+  loadObservations().then((module) => ({ default: module.AccountUsageSettings })),
+);
+
+export function HostedAccountObservations(
+  props: Parameters<typeof HostedAccountObservationsClient>[0],
+) {
+  const hydrated = useHydrated();
+  return hydrated ? (
+    <Suspense fallback={null}>
+      <ObservationsView {...props} />
+    </Suspense>
+  ) : null;
+}
+
+export function HostedAccountPlan(props: Parameters<typeof HostedAccountPlanClient>[0]) {
+  const hydrated = useHydrated();
+  return hydrated ? (
+    <Suspense fallback={null}>
+      <PlanView {...props} />
+    </Suspense>
+  ) : null;
+}
+
+export function AccountUsageSettings(props: Parameters<typeof AccountUsageSettingsClient>[0]) {
+  const hydrated = useHydrated();
+  return hydrated ? (
+    <Suspense fallback={null}>
+      <UsageSettingsView {...props} />
+    </Suspense>
+  ) : null;
+}
