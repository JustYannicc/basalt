@@ -0,0 +1,267 @@
+/** Account rows show retained usage beside independent health, only to callers who may see it. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import type { Page } from "playwright";
+import { body } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Evidence } from "../support/evidence.ts";
+import { allowance, observationFixture } from "../support/account-observation-fixture.ts";
+import { linkAccount } from "../support/app-accounts.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Revision = Schema.Struct({ revision: Schema.String });
+const Detail = Schema.Struct({ account: Schema.Struct({ label: Schema.String }) });
+const Retained = Schema.Struct({
+  reports: Schema.Array(Schema.Struct({ result: Schema.Struct({ observedAt: Schema.String }) })),
+});
+
+layer(HostedLive, { excludeTestServices: true })("Account observation rows", (it) => {
+  it.effect(scenarios.accountObservationRows.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const browser = yield* Browser,
+          evidence = yield* Evidence;
+        const f = yield* observationFixture({ observe: true, health: true, shared: true });
+        const reported = allowance();
+        yield* f.backend.answer({
+          status: 200,
+          body: {
+            ...reported,
+            observation: {
+              ...reported.observation,
+              windows: reported.observation.windows.map((window) => ({
+                ...window,
+                measure: { ...window.measure, unit: "RPM" },
+              })),
+            },
+          },
+        });
+        const appAccess = yield* body(
+          Revision,
+          yield* f.api.request(f.actors.owner, "GET", `${f.appPath}/access`),
+        );
+        expect(
+          (yield* f.api.request(f.actors.owner, "PATCH", `${f.appPath}/access`, {
+            revision: appAccess.revision,
+            audience: { kind: "everyone" },
+          })).status,
+        ).toBe(200);
+        yield* linkAccount(f.actors.member, f.appPath, "service", f.account);
+        const label = (yield* body(Detail, yield* f.detail())).account.label || "Unnamed account";
+        const accounts = `/org/${f.actors.organization.slug}/accounts`;
+        const block = (page: Page) =>
+          page.getByRole("group", { name: `Usage and health of ${label}`, exact: true });
+        const refreshButton = (page: Page) =>
+          block(page).getByRole("button", { name: "Refresh", exact: true });
+        const reading = (page: Page) => block(page).locator('[data-reading="requests"]');
+        // The plan sits on the account's own metadata line, outside the usage block.
+        const inventoryRow =
+          "xpath=ancestor::div[contains(concat(' ', @class, ' '), ' inventory-row ')][1]";
+        const plan = (page: Page) =>
+          block(page).locator(inventoryRow).locator("[data-account-plan]");
+
+        yield* browser.login(f.actors.owner);
+        yield* browser.use("Open Accounts as the account manager", (page) =>
+          page.goto(accounts).then(() => block(page).getByText("No usage reported").waitFor()),
+        );
+        expect(yield* f.backend.calls, "showing retained usage collects nothing").toBe(0);
+
+        yield* browser.use("Refresh usage from the row", (page) =>
+          refreshButton(page)
+            .click()
+            .then(() => reading(page).getByText("88 of 100 RPM left").waitFor()),
+        );
+        expect(yield* f.backend.calls).toBe(1);
+        const fresh = yield* browser.use("Read the fresh row", (page) => {
+          const row = block(page);
+          const meter = row.getByRole("meter", { name: "Requests per minute", exact: true });
+          return Promise.all([
+            meter.getAttribute("aria-valuenow"),
+            meter.getAttribute("aria-valuemax"),
+            row.locator('[data-reading="credits"] [data-reading-value]').innerText(),
+            plan(page).allInnerTexts(),
+            refreshButton(page).getAttribute("aria-disabled"),
+            row.locator("[data-usage-source] time").getAttribute("datetime"),
+          ]);
+        });
+        expect(fresh.slice(0, 3)).toEqual(["88", "100", "$25.00 available"]);
+        const units = yield* browser.use("Keep RPM as a count while USD remains money", (page) =>
+          reading(page).innerText(),
+        );
+        expect(units).toContain("12 used");
+        expect(units).not.toContain("spent");
+        expect(units).not.toContain("88.00");
+        expect(fresh[3]).toContain("Developer");
+        expect(fresh[4], "the source's next allowed refresh holds Refresh").toBe("true");
+        const observedAt = (yield* body(Retained, yield* f.read())).reports[0]?.result.observedAt;
+        expect(fresh[5]).toBe(observedAt);
+        yield* evidence.attach(
+          "account-observation-row-fresh.png",
+          "image/png",
+          yield* browser.use("Capture the fresh row", (page) => block(page).screenshot()),
+        );
+
+        yield* browser.use("Check the credential inline", (page) =>
+          block(page)
+            .getByRole("button", { name: "Check now", exact: true })
+            .click()
+            .then(() =>
+              block(page).locator('[data-account-health] [data-check-status="healthy"]').waitFor(),
+            ),
+        );
+        expect(yield* f.backend.calls, "a credential check does not collect usage").toBe(1);
+
+        // A failed refresh keeps the reading, its original age and the healthy credential.
+        yield* f.backend.answer({ status: 503, body: {} });
+        yield* serverControl("stop");
+        yield* serverControl("clock/advance", 200, { milliseconds: 6 * 60_000 });
+        yield* serverControl("start");
+        yield* browser.use("Refresh after the source stops answering", (page) =>
+          page
+            .reload()
+            .then(() => refreshButton(page).click())
+            .then(() => block(page).locator("[data-attempt-note]").waitFor()),
+        );
+        expect(yield* f.backend.calls).toBe(2);
+        const failed = yield* browser.use("Read the retained row", (page) => {
+          const row = block(page);
+          return Promise.all([
+            row.locator("[data-attempt-note]").innerText(),
+            reading(page).locator("[data-reading-value]").innerText(),
+            reading(page).getAttribute("data-stale"),
+            row.locator("[data-usage-source] [data-freshness]").getAttribute("data-freshness"),
+            row.locator("[data-usage-source] time").getAttribute("datetime"),
+            row.getByRole("link", { name: /^Reconnect/ }).count(),
+            row.locator('[data-account-health] [data-check-status="healthy"]').count(),
+            refreshButton(page).getAttribute("aria-disabled"),
+          ]);
+        });
+        expect(failed[0]).toContain("Refresh failed");
+        expect(failed[0]).toContain("Showing the last successful reading.");
+        expect(failed[1]).toBe("88 of 100 RPM left");
+        expect(failed[2]).toBe("");
+        expect(failed[3]).toBe("stale");
+        expect(failed[4], "the retained reading keeps its source time").toBe(observedAt);
+        expect(failed[5], "a usage failure never asks to reconnect").toBe(0);
+        expect(failed[6]).toBe(1);
+        expect(failed[7]).toBe("true");
+        yield* evidence.attach(
+          "account-observation-row-failed.png",
+          "image/png",
+          yield* browser.use("Capture the retained row", (page) => block(page).screenshot()),
+        );
+
+        // Using a shared account shows its health, never its usage, until the policy allows it.
+        yield* browser.login(f.actors.member);
+        yield* browser.use("Open Accounts as a member who uses the account", (page) =>
+          page.goto(accounts).then(() => block(page).locator("[data-usage-restricted]").waitFor()),
+        );
+        const denied = yield* browser.use("Read the restricted row", (page) => {
+          const row = block(page);
+          return Promise.all([
+            row.locator("[data-reading]").count(),
+            row.getByText("88 of 100", { exact: false }).count(),
+            plan(page).count(),
+            row.getByRole("button", { name: "Refresh", exact: true }).count(),
+            row.locator("[data-usage-source]").count(),
+            row.locator("[data-account-health] [data-check-status]").count(),
+            row
+              .getByRole("button", { name: "Details", exact: true })
+              .click()
+              .then(() => row.locator("[data-observation-provenance]").count()),
+          ]);
+        });
+        expect(denied).toEqual([0, 0, 0, 0, 0, 1, 0]);
+        yield* evidence.attach(
+          "account-observation-row-restricted.png",
+          "image/png",
+          yield* browser.use("Capture the restricted row", (page) => block(page).screenshot()),
+        );
+
+        yield* browser.login(f.actors.owner);
+        yield* browser.use("Let members see usage from Manage access", (page) =>
+          page
+            .goto(accounts)
+            .then(() => page.getByRole("button", { name: `Manage ${label}`, exact: true }).click())
+            .then(() => page.getByRole("menuitem", { name: "Manage access", exact: true }).click())
+            .then(() => page.getByRole("combobox", { name: "Who can see usage?" }).click())
+            .then(() => page.getByRole("option", { name: "Everyone in the organization" }).click())
+            .then(() =>
+              page.getByRole("button", { name: "Save usage access", exact: true }).click(),
+            )
+            .then(() =>
+              page
+                .getByRole("region", { name: "Usage access" })
+                .getByRole("status")
+                .getByText("Saved")
+                .waitFor(),
+            ),
+        );
+        const policy = yield* f.api.request(
+          f.actors.owner,
+          "GET",
+          `${f.accountPath}/observations/access`,
+        );
+        expect(policy.body).toMatchObject({
+          read: { kind: "everyone" },
+          refresh: { kind: "owners" },
+        });
+
+        yield* browser.login(f.actors.member);
+        yield* browser.use("Open Accounts after the grant", (page) =>
+          page.goto(accounts).then(() => reading(page).getByText("88 of 100 RPM left").waitFor()),
+        );
+        expect(
+          yield* browser.use("Refresh stays with the account managers", (page) =>
+            refreshButton(page).getAttribute("aria-disabled"),
+          ),
+        ).toBe("true");
+        yield* browser.use("Open the app's accounts", (page) =>
+          page.goto(`/org/${f.actors.organization.slug}/apps/${f.app.id}?view=accounts`).then(() =>
+            page
+              .getByRole("region", { name: "Your accounts", exact: true })
+              .getByRole("group", { name: `Usage and health of ${label}`, exact: true })
+              .locator('[data-reading="requests"]')
+              .getByText("88 of 100 RPM left")
+              .waitFor(),
+          ),
+        );
+        const appLayout = yield* browser.use(
+          "Keep the app account details inside its card",
+          (page) =>
+            page
+              .getByRole("region", { name: "Your accounts", exact: true })
+              .getByRole("group", { name: `Usage and health of ${label}`, exact: true })
+              .evaluate((element) => ({
+                width: element.clientWidth,
+                scrollWidth: element.scrollWidth,
+              })),
+        );
+        expect(appLayout.scrollWidth, JSON.stringify(appLayout)).toBeLessThanOrEqual(
+          appLayout.width,
+        );
+        expect(yield* f.backend.calls, "showing usage to more people collects nothing").toBe(2);
+
+        const narrow = yield* browser.use("Check the row at phone width in dark mode", (page) =>
+          page
+            .setViewportSize({ width: 390, height: 900 })
+            .then(() => page.emulateMedia({ colorScheme: "dark" }))
+            .then(() => page.goto(accounts))
+            .then(() => reading(page).getByText("88 of 100 RPM left").waitFor())
+            .then(() =>
+              page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth),
+            ),
+        );
+        expect(narrow, "the row fits a phone without horizontal scrolling").toBe(true);
+        yield* evidence.attach(
+          "account-observation-row-phone-dark.png",
+          "image/png",
+          yield* browser.use("Capture the phone row", (page) => block(page).screenshot()),
+        );
+      }),
+    ),
+  );
+});
