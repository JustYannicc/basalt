diff --git a/apps/local/web/src/contracts/account-observations.ts b/apps/local/web/src/contracts/account-observations.ts
new file mode 100644
index 000000000..6cc811efd
--- /dev/null
+++ b/apps/local/web/src/contracts/account-observations.ts
@@ -0,0 +1,39 @@
+/** Account usage reads and refreshes. The local owner may see and refresh every saved account. */
+import type { AccountId, AccountObservationView } from "@executor-js/sdk";
+import { browserOnly } from "@executor-js/ui/contracts/http";
+import { acknowledge, acknowledgedQuery } from "@executor-js/ui/contracts/mutations";
+import type { AccountObservationsView } from "@executor-js/ui/dashboard/account-observations";
+import { Effect } from "effect";
+import { AsyncResult, Atom } from "effect/reactivity";
+import { DashboardClient } from "./api.ts";
+
+const owned = (view: AccountObservationView): AccountObservationsView => ({
+  ...view,
+  canInspect: true,
+  canRefresh: true,
+});
+
+/** Retained readings; reading never collects. Loaded in the browser, after the page renders. */
+export const accountObservationsAtom = Atom.family((account: AccountId) =>
+  acknowledgedQuery(
+    Atom.map(
+      browserOnly(
+        DashboardClient.query("dashboard", "accountObservations", { params: { account } }),
+      ),
+      AsyncResult.map(owned),
+    ),
+  ),
+);
+
+/** Collect usage again; the source's own limits still apply. */
+export const refreshAccountObservationsAtom = Atom.family((account: AccountId) =>
+  DashboardClient.runtime.fn((_: void, get) =>
+    Effect.flatMap(DashboardClient, (client) =>
+      client.dashboard.refreshAccountObservations({ params: { account } }),
+    ).pipe(
+      Effect.tap((view) =>
+        Effect.sync(() => acknowledge(get, accountObservationsAtom(account), () => owned(view))),
+      ),
+    ),
+  ),
+);
