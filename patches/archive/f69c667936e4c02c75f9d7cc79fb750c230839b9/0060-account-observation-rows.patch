diff --git a/apps/hosted/web/src/implementation/pages/account-observations-client.tsx b/apps/hosted/web/src/implementation/pages/account-observations-client.tsx
new file mode 100644
index 000000000..4ee1a6808
--- /dev/null
+++ b/apps/hosted/web/src/implementation/pages/account-observations-client.tsx
@@ -0,0 +1,215 @@
+/** Hosted account rows show usage under the policy the server enforces on every read. */
+import { useAtomSet } from "@effect/atom-react";
+import { Exit } from "effect";
+import { useState } from "react";
+import type { AccountId, App } from "@executor-js/sdk";
+import type { Group } from "@executor-js/hosted-server/groups";
+import type { AccountSummary } from "@executor-js/ui/contracts/dashboard";
+import { Button } from "@executor-js/ui/components/button";
+import {
+  AccountObservationPlan,
+  AccountObservations,
+} from "@executor-js/ui/dashboard/account-observations";
+import { QueryView } from "@executor-js/ui/dashboard/context";
+import { DetailSkeleton } from "@executor-js/ui/dashboard/loading";
+import {
+  accountObservationsAtom,
+  observationPolicyAtom,
+  refreshAccountObservationsAtom,
+  saveObservationPolicyAtom,
+  type ObservationAudience,
+  type ObservationPolicy,
+} from "../../contracts/account-observations.ts";
+import { checkAccountAtom, checkAppAccountAtom } from "../../contracts/accounts.ts";
+import { appError, type HostedError } from "../../contracts/errors.ts";
+import { groupsAtom } from "../../contracts/groups.ts";
+import { HostedFailure } from "../components/dashboard-bindings.tsx";
+import { useOrganizationRoute } from "../components/organization.tsx";
+import { AudienceInput, SharingFailure } from "../components/sharing.tsx";
+
+/**
+ * Usage under an account's row. With `apps`, the block also shows those apps' checks and an inline
+ * Check now, which runs the same checks as the Check health dialog.
+ */
+export function HostedAccountObservations({
+  account,
+  apps,
+  app,
+  canReconnect,
+  plan = false,
+}: {
+  readonly account: AccountSummary;
+  readonly apps?: readonly App[];
+  readonly app?: App;
+  readonly canReconnect?: (app: App) => boolean;
+  readonly plan?: boolean;
+}) {
+  const { organization } = useOrganizationRoute();
+  const key = { organization, account: account.id };
+  const refresh = useAtomSet(refreshAccountObservationsAtom(key), { mode: "promiseExit" });
+  const check = useAtomSet(
+    app === undefined ? checkAccountAtom(key) : checkAppAccountAtom({ ...key, app: app.id }),
+    { mode: "promiseExit" },
+  );
+  return (
+    <AccountObservations<HostedError>
+      account={account}
+      query={accountObservationsAtom(key)}
+      refresh={() => refresh()}
+      {...(app === undefined
+        ? apps === undefined
+          ? {}
+          : {
+              health: {
+                apps,
+                check: () => check(),
+                ...(canReconnect === undefined ? {} : { canReconnect }),
+              },
+            }
+        : { health: { apps: [app], check: () => check(), showStatus: false } })}
+      plan={plan}
+      Failure={HostedFailure}
+    />
+  );
+}
+
+/** The reported plan beside the account's other metadata, when the caller may see usage. */
+export function HostedAccountPlan({ account }: { readonly account: AccountSummary }) {
+  const { organization } = useOrganizationRoute();
+  return (
+    <AccountObservationPlan
+      query={accountObservationsAtom({ organization, account: account.id })}
+    />
+  );
+}
+
+/**
+ * Who besides the account's managers may see its plan, limits and balances, and who may refresh
+ * them. Using a shared account grants neither. Only managers can read or change this.
+ */
+export function AccountUsageSettings({ account }: { readonly account: AccountId }) {
+  const { organization } = useOrganizationRoute();
+  const save = useAtomSet(saveObservationPolicyAtom({ organization, account }), {
+    mode: "promiseExit",
+  });
+  return (
+    <section className="space-y-4 border-t pt-5" aria-label="Usage access">
+      <div className="space-y-1">
+        <h3 className="text-sm font-medium">Usage</h3>
+        <p className="text-xs text-muted-foreground">
+          Using this account doesn't show its plan, limits or balances. Account managers always see
+          them.
+        </p>
+      </div>
+      <QueryView
+        query={observationPolicyAtom({ organization, account })}
+        Failure={HostedFailure}
+        pending={<DetailSkeleton label="Loading usage access" />}
+      >
+        {(policy) => (
+          <QueryView
+            query={groupsAtom(organization)}
+            Failure={HostedFailure}
+            pending={<DetailSkeleton label="Loading groups" />}
+          >
+            {(data) => <UsagePolicyEditor policy={policy} groups={data.groups} save={save} />}
+          </QueryView>
+        )}
+      </QueryView>
+    </section>
+  );
+}
+
+const missingGroups = (audience: ObservationAudience) =>
+  audience.kind === "groups" && audience.groups.length === 0;
+
+/** The draft keeps the revision it was loaded with, so a concurrent change fails instead. */
+function UsagePolicyEditor({
+  policy,
+  groups,
+  save,
+}: {
+  readonly policy: ObservationPolicy;
+  readonly groups: readonly Group[];
+  readonly save: (policy: ObservationPolicy) => Promise<Exit.Exit<ObservationPolicy, HostedError>>;
+}) {
+  const [draft, setDraft] = useState(policy);
+  const [pending, setPending] = useState(false);
+  const [error, setError] = useState<string>();
+  const [saved, setSaved] = useState(false);
+  const [touched, setTouched] = useState(false);
+  const change = (part: "read" | "refresh") => (audience: ObservationAudience) => {
+    setDraft((current) => ({ ...current, [part]: audience }));
+    setSaved(false);
+  };
+  const invalid = missingGroups(draft.read) || missingGroups(draft.refresh);
+  return (
+    <form
+      noValidate
+      className="space-y-4"
+      onSubmit={async (event) => {
+        event.preventDefault();
+        setTouched(true);
+        if (invalid || pending) return;
+        setPending(true);
+        setError(undefined);
+        setSaved(false);
+        const exit = await save(draft);
+        setPending(false);
+        if (Exit.isFailure(exit)) return setError(appError(exit.cause));
+        setDraft(exit.value);
+        setSaved(true);
+      }}
+    >
+      <AudienceInput
+        mode="observation"
+        question="Who can see usage?"
+        value={draft.read}
+        groups={groups}
+        disabled={pending}
+        onBlur={() => setTouched(true)}
+        onChange={change("read")}
+        error={touched && missingGroups(draft.read) ? "Choose at least one group." : undefined}
+      />
+      <div className="space-y-1.5">
+        <AudienceInput
+          mode="observation"
+          question="Who can refresh usage?"
+          value={draft.refresh}
+          groups={groups}
+          disabled={pending}
+          onBlur={() => setTouched(true)}
+          onChange={change("refresh")}
+          error={touched && missingGroups(draft.refresh) ? "Choose at least one group." : undefined}
+        />
+        <p className="text-xs text-muted-foreground">
+          Refreshing also needs use of the account and permission to see its usage.
+        </p>
+      </div>
+      {error && <SharingFailure message={error} title="Could not save usage access" />}
+      <div className="flex flex-wrap items-center gap-3">
+        <Button type="submit" loading={pending}>
+          Save usage access
+        </Button>
+        <Button
+          type="button"
+          variant="outline"
+          disabled={pending}
+          onClick={() => {
+            setDraft(policy);
+            setError(undefined);
+            setSaved(false);
+            setTouched(false);
+          }}
+        >
+          Reset changes
+        </Button>
+        {saved && (
+          <span role="status" className="text-sm text-muted-foreground">
+            Saved
+          </span>
+        )}
+      </div>
+    </form>
+  );
+}
