+/** Local account rows show usage with the owner's own authority. */
+import { useAtomSet } from "@effect/atom-react";
+import type { App } from "@executor-js/sdk";
+import type { AccountSummary } from "@executor-js/ui/contracts/dashboard";
+import {
+  AccountObservationPlan,
+  AccountObservations,
+} from "@executor-js/ui/dashboard/account-observations";
+import {
+  accountObservationsAtom,
+  refreshAccountObservationsAtom,
+} from "../../contracts/account-observations.ts";
+import { checkAccountAtom } from "../../contracts/accounts.ts";
+import type { DashboardError } from "../../contracts/errors.ts";
+import { Failure } from "../components/common.tsx";
+
+/**
+ * Usage under an account's row. With `apps`, the block also shows those apps' checks and an inline
+ * Check now, which runs the same checks as the Check health dialog.
+ */
+export function LocalAccountObservations({
+  account,
+  apps,
+  app,
+  canReconnect,
+  plan = false,
+}: {
+  readonly account: AccountSummary;
+  readonly apps?: readonly App[];
+  readonly app?: App;
+  readonly canReconnect?: (app: App) => boolean;
+  readonly plan?: boolean;
+}) {
+  const refresh = useAtomSet(refreshAccountObservationsAtom(account.id), { mode: "promiseExit" });
+  const check = useAtomSet(checkAccountAtom(account.id), { mode: "promiseExit" });
+  return (
+    <AccountObservations<DashboardError>
+      account={account}
+      query={accountObservationsAtom(account.id)}
+      refresh={() => refresh()}
+      {...(app === undefined
+        ? apps === undefined
+          ? {}
+          : {
+              health: {
+                apps,
+                check: () => check(),
+                ...(canReconnect === undefined ? {} : { canReconnect }),
+              },
+            }
+        : { health: { apps: [app], check: () => check(), showStatus: false } })}
+      plan={plan}
+      Failure={Failure}
+    />
+  );
+}
+
+/** The reported plan beside the account's other metadata. */
+export function LocalAccountPlan({ account }: { readonly account: AccountSummary }) {
+  return <AccountObservationPlan query={accountObservationsAtom(account.id)} />;
+}
