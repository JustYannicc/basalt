+          server,
+          method.tokenEndpointAuthMethod,
+          options.clientMetadataUrl,
+        );
+        signals.push(
+          AuthorizationServerSignal.make({
+            issuer,
+            result: "found",
+            ...(document === undefined ? {} : { document }),
+            registration,
+          }),
+        );
