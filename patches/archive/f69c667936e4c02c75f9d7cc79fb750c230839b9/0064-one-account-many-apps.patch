diff --git a/apps/hosted/cloud/src/infrastructure/oauth-protocol.ts b/apps/hosted/cloud/src/infrastructure/oauth-protocol.ts
new file mode 100644
index 00000000..8bf289de
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/oauth-protocol.ts
@@ -0,0 +1,104 @@
+/** The cloud host replaces the SDK wire adapter; storage and policy still execute in their original transaction. */
+import { Effect, Option, Schema } from "effect";
+import { traceHeaders } from "@executor-js/telemetry";
+import { parseDestination } from "@executor-js/utils/url-policy";
+import { ResourceOAuth, type OAuthOptions } from "@executor-js/sdk/core";
+import { OAuthProtocolFailed, type OAuthProtocol } from "@executor-js/sdk/oauth-protocol-contracts";
+import {
+  OAuthWireHost,
+  OAuthWireFailure,
+  type OAuthWire,
+  type OAuthWireSettings,
+  type WireReply,
+} from "../contracts/oauth-wire.ts";
+import type { RpcCallError } from "alchemy/Rpc";
+
+const call = <A>(
+  run: (
+    wire: OAuthWire,
+    headers: Readonly<Record<string, string>>,
+  ) => Effect.Effect<WireReply<A>, RpcCallError>,
+) =>
+  Effect.gen(function* () {
+    const binding = yield* Effect.serviceOption(OAuthWireHost);
+    if (Option.isNone(binding)) return yield* new OAuthProtocolFailed({ reason: "request" });
+    const result = yield* run(
+      binding.value,
+      Object.fromEntries(Object.entries(yield* traceHeaders)),
+    ).pipe(Effect.mapError(() => new OAuthProtocolFailed({ reason: "request" })));
+    if (result.ok) return result.value;
+    const failure = yield* Schema.decodeUnknownEffect(OAuthWireFailure)(result.error).pipe(
+      Effect.mapError(() => new OAuthProtocolFailed({ reason: "invalid_response" })),
+    );
+    return yield* failure;
+  });
+
+export const makeOAuthProtocol = (options: OAuthOptions): OAuthProtocol => {
+  const settings: OAuthWireSettings = {
+    clientName: options.clientName,
+    ...(options.clientMetadataUrl === undefined
+      ? {}
+      : { clientMetadataUrl: options.clientMetadataUrl }),
+    ...(options.statePrefix === undefined ? {} : { statePrefix: options.statePrefix }),
+  };
+  // oauth4webapi brands validated parameters in a WeakSet. Retain the saved validation
+  // inputs so the remote exchange can validate and consume the same native object.
+  const callbacks = new WeakMap<
+    URLSearchParams,
+    {
+      readonly input: Parameters<OAuthProtocol["callback"]>[0];
+      readonly callback: string;
+    }
+  >();
+  return {
+    identify: (...args: Parameters<OAuthProtocol["identify"]>) =>
+      call((wire, headers) => wire.identify(settings, args, headers)),
+    discover: (...args: Parameters<OAuthProtocol["discover"]>) =>
+      call((wire, headers) => wire.discover(settings, args, headers)),
+    inspect: (...args: Parameters<OAuthProtocol["inspect"]>) =>
+      call((wire, headers) => wire.inspect(settings, [args[0].href, args[1]], headers)).pipe(
+        Effect.catch(() =>
+          Effect.succeed(
+            ResourceOAuth.cases.OAuthUnusable.make({ reason: "unavailable", signals: [] }),
+          ),
+        ),
+      ),
+    register: (...args: Parameters<OAuthProtocol["register"]>) =>
+      call((wire, headers) =>
+        wire.register(settings, [args[0], args[1].href, args[2], args[3]], headers),
+      ),
+    authorize: (...args: Parameters<OAuthProtocol["authorize"]>) =>
+      call((wire, headers) => wire.authorize(settings, args, headers)),
+    callback: (...args: Parameters<OAuthProtocol["callback"]>) =>
+      call((wire, headers) => wire.callback(settings, [args[0], args[1].href], headers)).pipe(
+        Effect.map((value) => {
+          const parameters = new URLSearchParams(value);
+          callbacks.set(parameters, { input: args[0], callback: args[1].href });
+          return parameters;
+        }),
+      ),
+    exchange: (...args: Parameters<OAuthProtocol["exchange"]>) =>
+      Effect.suspend(() => {
+        const validation = callbacks.get(args[1]);
+        return validation === undefined
+          ? Effect.fail(new OAuthProtocolFailed({ reason: "invalid_response" }))
+          : call((wire, headers) => wire.exchange(settings, [args[0], validation], headers));
+      }),
+    clientCredentials: (...args: Parameters<OAuthProtocol["clientCredentials"]>) =>
+      call((wire, headers) => wire.clientCredentials(settings, args, headers)),
+    refresh: (...args: Parameters<OAuthProtocol["refresh"]>) =>
+      call((wire, headers) => wire.refresh(settings, args, headers)),
+    revoke: (...args: Parameters<OAuthProtocol["revoke"]>) =>
+      call((wire, headers) => wire.revoke(settings, args, headers)),
+  };
+};
+export const discoverResourceOAuth = (
+  resource: string,
+  options: Pick<OAuthOptions, "httpClient" | "urlPolicy" | "clientMetadataUrl">,
+  observed: { readonly resourceMetadata?: string | undefined; readonly originFallback: boolean },
+) => {
+  const endpoint = parseDestination(resource, options.urlPolicy);
+  return endpoint === undefined
+    ? Effect.succeed(ResourceOAuth.cases.OAuthUnusable.make({ reason: "blocked", signals: [] }))
+    : makeOAuthProtocol({ ...options, clientName: "Executor" }).inspect(endpoint, observed);
+};
