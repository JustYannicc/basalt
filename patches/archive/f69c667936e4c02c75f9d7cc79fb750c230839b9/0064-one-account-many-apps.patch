+import { lazy, Suspense, useState } from "react";
+import { useHydrated } from "../hooks/hydrated.ts";
+import type { IdentityAppPicker as IdentityAppPickerClient } from "./identity-app-picker-client.tsx";
+
+// Server-side lazy chunks still upload and compile on every Worker cold start.
+const load = () =>
+  import.meta.env.SSR
+    ? Promise.reject(new Error("Account controls render only in a browser"))
+    : import("./identity-app-picker-client.tsx");
+
+export function IdentityAppPicker(props: Parameters<typeof IdentityAppPickerClient>[0]) {
+  const hydrated = useHydrated();
+  const [View] = useState(() =>
+    lazy(() => load().then((module) => ({ default: module.IdentityAppPicker }))),
+  );
+  return hydrated ? (
+    <Suspense fallback={null}>
+      <View {...props} />
+    </Suspense>
+  ) : null;
+}
