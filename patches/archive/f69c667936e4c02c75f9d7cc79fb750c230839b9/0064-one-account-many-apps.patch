index 00000000..00466dfb
--- /dev/null
+++ b/apps/hosted/cloud/src/contracts/oauth-wire.ts
@@ -0,0 +1,46 @@
+/** Only the private binding may send grant material; no storage handle or authority crosses it. */
+import type { RpcCallError } from "alchemy/Rpc";
+import { Context, Schema, type Effect } from "effect";
+import { OAuthProtocolFailed, type OAuthProtocol } from "@executor-js/sdk/oauth-protocol-contracts";
+import type { OAuthOptions } from "@executor-js/sdk/core";
+
+export const OAuthWireFailure = Schema.toCodecJson(OAuthProtocolFailed);
+export type OAuthWireSettings = Pick<
+  OAuthOptions,
+  "clientName" | "clientMetadataUrl" | "statePrefix"
+>;
+export type WireReply<A> =
+  | { readonly ok: true; readonly value: A }
+  | { readonly ok: false; readonly error: typeof OAuthWireFailure.Encoded };
+type Args<K extends keyof OAuthProtocol> = Parameters<OAuthProtocol[K]>;
+type WireArgs<K extends keyof OAuthProtocol> = K extends "inspect"
+  ? [endpoint: string, observed: Args<"inspect">[1]]
+  : K extends "register"
+    ? [
+        server: Args<"register">[0],
+        redirect: string,
+        scopes: Args<"register">[2],
+        configured?: Args<"register">[3],
+      ]
+    : K extends "callback"
+      ? [input: Args<"callback">[0], callback: string]
+      : K extends "exchange"
+        ? [
+            input: Args<"exchange">[0],
+            validation: { readonly input: Args<"callback">[0]; readonly callback: string },
+          ]
+        : Args<K>;
+type Value<K extends keyof OAuthProtocol> = K extends "callback"
+  ? string
+  : Effect.Success<ReturnType<OAuthProtocol[K]>>;
+export type OAuthWire = {
+  readonly [K in keyof OAuthProtocol]: (
+    settings: OAuthWireSettings,
+    args: WireArgs<K>,
+    headers: Readonly<Record<string, string>>,
+  ) => Effect.Effect<WireReply<Value<K>>, RpcCallError>;
+};
+/** Bound once by cloud composition and read in the caller's request context. */
+export class OAuthWireHost extends Context.Service<OAuthWireHost, OAuthWire>()(
+  "executor/cloud/OAuthWire",
+) {}
