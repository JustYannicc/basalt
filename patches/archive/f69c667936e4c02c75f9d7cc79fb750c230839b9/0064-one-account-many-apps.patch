+import { lazy, Suspense, useState } from "react";
+import { useHydrated } from "../hooks/hydrated.ts";
+import type { IdentityConsent as IdentityConsentClient } from "./identity-consent-client.tsx";
+import type { OAuthStartResult } from "@executor-js/sdk";
+
+// Server-side lazy chunks still upload and compile on every Worker cold start.
+const load = () =>
+  import.meta.env.SSR
+    ? Promise.reject(new Error("Account controls render only in a browser"))
+    : import("./identity-consent-client.tsx");
+
+export function IdentityConsent<E, S extends OAuthStartResult>(
+  props: Parameters<typeof IdentityConsentClient<E, S>>[0],
+) {
+  const hydrated = useHydrated();
+  const [View] = useState(() =>
+    lazy(() => load().then((module) => ({ default: module.IdentityConsent<E, S> }))),
+  );
+  return hydrated ? (
+    <Suspense fallback={null}>
+      <View {...props} />
+    </Suspense>
+  ) : null;
+}
