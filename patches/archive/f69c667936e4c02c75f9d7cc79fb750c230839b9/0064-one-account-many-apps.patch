new file mode 100644
index 00000000..2bbccd8b
--- /dev/null
+++ b/packages/sdk/src/implementation/oauth-grant-bindings.ts
@@ -0,0 +1,137 @@
+/** Shared grants keep their encryption identity and renewal lock after individual bindings disappear. */
+import { Clock, type Crypto, Effect, Redacted, Schema } from "effect";
+import type { Credentials, StoredAccount } from "../contracts/storage.ts";
+import { AccountId, JsonObject, StorageError, type ProviderId } from "../contracts/shared.ts";
+import type { AccountIdentity } from "../contracts/account-identity.ts";
+import type { ResourceLifecycle } from "../contracts/executor.ts";
+import type { OAuthGrant } from "../contracts/oauth.ts";
+import { accountGrantId, identityPlacement } from "./account-identities.ts";
+import { query, type Query } from "./database.ts";
+
+/** Promotion leaves the account ID free for a later independent reconnect. Call under the grant's row lock. */
+export const shareOAuthGrant = (
+  db: Query,
+  credentials: Credentials,
+  crypto: Crypto.Crypto,
+  source: StoredAccount,
+  record: { readonly status: string; readonly updatedAt: Date },
+  grant: OAuthGrant,
+) =>
+  Effect.gen(function* () {
+    if (source.oauthGrantId !== null) return source.oauthGrantId;
+    if (source.identityId === null) return yield* new StorageError();
+    const id = AccountId.make(
+      `acc_grant_${yield* crypto.randomUUIDv4.pipe(Effect.mapError(() => new StorageError()))}`,
+    );
+    const json = yield* Schema.decodeUnknownEffect(JsonObject)({
+      ...grant,
+      identityId: source.identityId,
+    }).pipe(Effect.mapError(() => new StorageError()));
+    const encrypted = yield* credentials.encrypt(id, Redacted.make(json));
+    yield* query(() =>
+      db.create("oauthGrants", {
+        id,
+        owner: source.owner,
+        encrypted,
+        status: record.status,
+        updatedAt: record.updatedAt,
+      }),
+    );
+    yield* query(() =>
+      db.updateMany("accounts", {
+        where: (b) => b("id", "=", source.id),
+        set: { oauthGrantId: id },
+      }),
+    );
+    yield* query(() => db.deleteMany("oauthGrants", { where: (b) => b("id", "=", source.id) }));
+    return id;
+  });
+
+/** A binding stores its own policy and no copied token. Hosts resolve its destination after insertion. */
+export const createSharedOAuthBinding = (
+  db: Query,
+  credentials: Credentials,
+  crypto: Crypto.Crypto,
+  lifecycle: ResourceLifecycle | undefined,
+  source: Pick<StoredAccount, "owner" | "identityId" | "site">,
+  identity: AccountIdentity,
+  placement: string,
+  input: {
+    readonly provider: ProviderId;
+    readonly method: string;
+    readonly label: string;
+    readonly grant: AccountId;
+  },
+) =>
+  Effect.gen(function* () {
+    if (source.identityId === null) return yield* new StorageError();
+    const id = AccountId.make(
+      `acc_${yield* crypto.randomUUIDv4.pipe(Effect.mapError(() => new StorageError()))}`,
+    );
+    const account = {
+      id,
+      owner: source.owner,
+      provider: input.provider,
+      method: input.method,
+      label: input.label,
+      description: null,
+      createdAt: new Date(yield* Clock.currentTimeMillis),
+      identity,
+      ...(source.site === null ? {} : { site: source.site }),
+    };
+    const encryptedCredentials = yield* credentials.encrypt(id, Redacted.make({}));
+    yield* query(() =>
+      db.create("accounts", {
+        ...account,
+        site: source.site,
+        encryptedCredentials,
+        identityId: source.identityId,
+        oauthGrantId: input.grant,
+      }),
+    );
+    if (lifecycle !== undefined) yield* lifecycle.accountCreated(account);
+    if ((yield* identityPlacement(account, lifecycle)) !== placement) return undefined;
+    return account;
+  });
+
+export const grantBindings = (db: Query, grant: AccountId) =>
+  query(() =>
+    db.findMany("accounts", {
+      where: (b) =>
+        b.or(
+          b("oauthGrantId", "=", grant),
+          b.and(b("id", "=", grant), b("oauthGrantId", "is", null)),
+        ),
+    }),
+  );
+
+/** Call after the binding was deleted or detached, inside the same transaction. */
+export const releaseAccountGrant = (
+  db: Query,
+  account: Pick<StoredAccount, "id" | "oauthGrantId" | "provider">,
+) =>
+  Effect.gen(function* () {
+    const id = accountGrantId(account);
+    // Serializing shared releases makes the last concurrent removal responsible for cleanup.
+    if (account.oauthGrantId !== null) {
+      const saved = yield* query(() =>
+        db.findFirst("oauthGrants", { where: (b) => b("id", "=", id) }),
+      );
+      if (saved === null) return undefined;
+      yield* query(() =>
+        db.updateMany("oauthGrants", {
+          where: (b) => b("id", "=", id),
+          set: { owner: saved.owner },
+        }),
+      );
+    }
+    const held = yield* grantBindings(db, id);
+    if (held.length !== 0) return undefined;
+    const grant = yield* query(() =>
+      db.findFirst("oauthGrants", { where: (b) => b("id", "=", id) }),
+    );
+    yield* query(() => db.deleteMany("oauthGrants", { where: (b) => b("id", "=", id) }));
+    return grant === null
+      ? undefined
+      : { account: id, provider: account.provider, encrypted: grant.encrypted };
+  });
diff --git a/packages/sdk/src/implementation/oauth-grant-reuse.ts b/packages/sdk/src/implementation/oauth-grant-reuse.ts
new file mode 100644
index 00000000..52e7d8f6
--- /dev/null
+++ b/packages/sdk/src/implementation/oauth-grant-reuse.ts
@@ -0,0 +1,165 @@
+import { accountMetadata } from "./accounts.ts";
+/** Reuse creates exact provider bindings only after one grant covers every saved target. */
+import { type Crypto, Effect } from "effect";
+import { Base64 } from "effect/encoding";
+import { StorageError } from "../contracts/shared.ts";
+import type { ResourceLifecycle } from "../contracts/executor.ts";
+import {
+  AccountConnectionRefused,
+  type ReuseConnectionOAuth,
+} from "../contracts/account-connection.ts";
+import type { OAuthOptions } from "../contracts/oauth.ts";
+import type { Credentials } from "../contracts/storage.ts";
+import { accountGrantId } from "./account-identities.ts";
+import { ownedAccount, defaultLabel } from "./accounts.ts";
+import {
+  lockConnection,
+  readConnection,
+  requireOpen,
+  finishConnection,
+} from "./connection-state.ts";
+import { requireTargetProvider } from "./connection-target.ts";
+import { query, transaction, type Query } from "./database.ts";
+import { inspectOAuthConnection } from "./oauth-connection-plan.ts";
+import { shareOAuthGrant, createSharedOAuthBinding } from "./oauth-grant-bindings.ts";
+
+export const makeOAuthGrantReuse =
+  (
+    db: Query,
+    credentials: Credentials,
+    crypto: Crypto.Crypto,
+    options: OAuthOptions | undefined,
+    lifecycle: ResourceLifecycle | undefined,
+  ) =>
+  (input: typeof ReuseConnectionOAuth.Type) =>
+    Effect.gen(function* () {
+      const request = yield* readConnection(db, input);
+      if (request.state.status === "completed")
+        return { status: "completed" as const, account: request.state.account };
+      const inspected = yield* inspectOAuthConnection(db, credentials, options, lifecycle, {
+        ...input,
+        sourceAccount: input.account,
+      });
+      const { plan, entries, source } = inspected;
+      const consent = (
+        reason: "identity" | "placement" | "client" | "resource" | "scopes" | "busy",
+      ) => ({ status: "consent-required" as const, reason });
+      if (plan.status !== "reuse" || source?.status !== "ready")
+        return consent("reason" in plan ? plan.reason : "scopes");
+      return yield* transaction(db, (tx) =>
+        Effect.gen(function* () {
+          // Every batch takes connection locks in the same order, including overlapping batches.
+          for (const entry of [...entries].sort((a, b) => a.row.id.localeCompare(b.row.id))) {
+            const locked = yield* lockConnection(
+              tx,
+              { connection: entry.row.id, owner: request.owner },
+              crypto,
+            );
+            if (entry.row.id === input.connection && locked.state.status === "completed")
+              return { status: "completed" as const, account: locked.state.account };
+            yield* requireOpen({ connection: entry.row.id }, locked);
+          }
+          const live = yield* ownedAccount(tx, {
+            account: source.account.id,
+            owner: request.owner,
+          });
+          yield* query(() =>
+            tx.updateMany("accounts", {
+              where: (b) => b.and(b("id", "=", live.id), b("owner", "=", request.owner)),
+              set: { owner: live.owner },
+            }),
+          );
+          const current = yield* ownedAccount(tx, { account: live.id, owner: request.owner });
+          if (
+            accountGrantId(current) !== source.grantId ||
+            current.credentialGeneration !== source.account.credentialGeneration ||
+            current.identityId !== source.account.identityId
+          )
+            return consent("busy");
+          if (
+            lifecycle !== undefined &&
+            !(yield* lifecycle.accountsResolving([accountMetadata(current)])).has(current.id)
+          )
+            return yield* new AccountConnectionRefused(request.target);
+          yield* query(() =>
+            tx.updateMany("oauthGrants", {
+              where: (b) =>
+                b.and(
+                  b("id", "=", source.grantId),
+                  b("status", "=", source.record.status),
+                  b("encrypted", "=", source.record.encrypted),
+                ),
+              set: { status: source.record.status },
+            }),
+          );
+          const locked = yield* query(() =>
+            tx.findFirst("oauthGrants", { where: (b) => b("id", "=", source.grantId) }),
+          );
+          if (
+            locked === null ||
+            locked.status !== source.record.status ||
+            Base64.encode(locked.encrypted) !== Base64.encode(source.record.encrypted)
+          )
+            return consent("busy");
+          const grant = yield* shareOAuthGrant(
+            tx,
+            credentials,
+            crypto,
+            current,
+            locked,
+            source.grant,
+          );
+          const accounts = [];
+          for (const entry of entries) {
+            const row = yield* requireOpen(
+              { connection: entry.row.id },
+              yield* readConnection(tx, { connection: entry.row.id, owner: request.owner }),
+            );
+            const target = yield* requireTargetProvider(tx, row);
+            if ((row.target.site ?? null) !== current.site)
+              return yield* new AccountConnectionRefused(row.target);
+            const method = target.definition.auth[entry.methodName];
+            if (
+              method?.type !== "oauth2" ||
+              method.grant === "client_credentials" ||
+              method.identity?.issuer !== entry.method.identity?.issuer
+            )
+              return yield* new AccountConnectionRefused(row.target);
+            const placement =
+              lifecycle === undefined
+                ? row.owner
+                : yield* lifecycle.connectionIdentityPlacement?.(row) ?? Effect.succeed(null);
+            if (placement !== source.proof.placement)
+              return yield* new AccountConnectionRefused(row.target);
+            const account = yield* createSharedOAuthBinding(
+              tx,
+              credentials,
+              crypto,
+              lifecycle,
+              current,
+              source.identity,
+              source.proof.placement,
+              {
+                provider: row.provider,
+                method: entry.methodName,
+                label: input.label ?? (yield* defaultLabel(tx, row.owner, row.provider)),
+                grant,
+              },
+            );
+            if (account === undefined) return yield* new AccountConnectionRefused(row.target);
+            if (lifecycle !== undefined)
+              yield* lifecycle.connectionCompleting({
+                id: row.id,
+                owner: row.owner,
+                reconnectAccount: row.reconnectAccount,
+                target: row.target,
+              });
+            yield* finishConnection(tx, row, account, lifecycle);
+            accounts.push(account);
+          }
+          const account = accounts[0];
+          if (account === undefined) return yield* new StorageError();
+          return { status: "completed" as const, account };
+        }),
+      );
+    }).pipe(Effect.withSpan("sdk.connections.reuseOAuth"));
diff --git a/packages/sdk/src/implementation/oauth-protocol-native.ts b/packages/sdk/src/implementation/oauth-protocol-native.ts
