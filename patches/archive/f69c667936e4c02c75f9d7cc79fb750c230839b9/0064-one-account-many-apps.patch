diff --git a/apps/hosted/cloud/src/oauth-wire.ts b/apps/hosted/cloud/src/oauth-wire.ts
new file mode 100644
index 00000000..4f1b5442
--- /dev/null
+++ b/apps/hosted/cloud/src/oauth-wire.ts
@@ -0,0 +1,78 @@
+/** OAuth networking and validation run here only on sign-in, discovery or token renewal. No account state lives here. */
+import { Effect, Result, Schema } from "effect";
+import { makeOAuthProtocol } from "@executor-js/sdk/oauth-protocol";
+import { OAuthProtocolFailed } from "@executor-js/sdk/oauth-protocol-contracts";
+import { withRemoteSpan } from "@executor-js/telemetry";
+import {
+  OAuthWireFailure,
+  type OAuthWireSettings,
+  type WireReply,
+} from "./contracts/oauth-wire.ts";
+import { OAuthWireWorker } from "./infrastructure/oauth-wire-worker.ts";
+import { cloudEgress } from "./infrastructure/egress.ts";
+import {
+  cloudObservability,
+  cloudTelemetry,
+  telemetryBindings,
+} from "./infrastructure/telemetry.ts";
+import { workerBuild } from "./infrastructure/worker-build.ts";
+
+const answer = <A>(
+  operation: Effect.Effect<A, OAuthProtocolFailed>,
+  headers: Readonly<Record<string, string>>,
+): Effect.Effect<WireReply<A>> =>
+  Effect.gen(function* () {
+    const result = yield* Effect.result(operation);
+    if (Result.isSuccess(result)) return { ok: true as const, value: result.success };
+    const error = yield* Schema.encodeEffect(OAuthWireFailure)(result.failure).pipe(Effect.orDie);
+    return { ok: false as const, error };
+  }).pipe(withRemoteSpan(new Request("https://oauth-wire.internal", { headers }), "oauth.wire"));
+
+export default OAuthWireWorker.make(
+  Effect.gen(function* () {
+    if (globalThis.__ALCHEMY_RUNTIME__) return { main: import.meta.url };
+    return {
+      main: import.meta.url,
+      ...(yield* cloudObservability),
+      workersDev: false,
+      build: workerBuild("oauth-wire"),
+      compatibility: { date: "2026-09-08", flags: ["nodejs_compat"] },
+      env: yield* telemetryBindings,
+    };
+  }),
+  Effect.gen(function* () {
+    const egress = yield* cloudEgress;
+    const protocol = (settings: OAuthWireSettings) =>
+      makeOAuthProtocol({ ...settings, httpClient: egress.client, urlPolicy: egress.policy });
+    return OAuthWireWorker.of({
+      identify: (settings, args, headers) => answer(protocol(settings).identify(...args), headers),
+      discover: (settings, args, headers) => answer(protocol(settings).discover(...args), headers),
+      inspect: (settings, args, headers) =>
+        answer(protocol(settings).inspect(new URL(args[0]), args[1]), headers),
+      register: (settings, args, headers) =>
+        answer(protocol(settings).register(args[0], new URL(args[1]), args[2], args[3]), headers),
+      authorize: (settings, args, headers) =>
+        answer(protocol(settings).authorize(...args), headers),
+      callback: (settings, args, headers) =>
+        answer(
+          protocol(settings)
+            .callback(args[0], new URL(args[1]))
+            .pipe(Effect.map((value) => value.toString())),
+          headers,
+        ),
+      exchange: (settings, args, headers) =>
+        answer(
+          Effect.gen(function* () {
+            const native = protocol(settings);
+            const parameters = yield* native.callback(args[1].input, new URL(args[1].callback));
+            return yield* native.exchange(args[0], parameters);
+          }),
+          headers,
+        ),
+      clientCredentials: (settings, args, headers) =>
+        answer(protocol(settings).clientCredentials(...args), headers),
+      refresh: (settings, args, headers) => answer(protocol(settings).refresh(...args), headers),
+      revoke: (settings, args, headers) => answer(protocol(settings).revoke(...args), headers),
+    });
+  }).pipe(Effect.provide(cloudTelemetry)),
+);
