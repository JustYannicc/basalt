+  placement: Schema.NonEmptyString,
+  issuer: HttpUrl,
+  subject: Schema.NonEmptyString,
+  verifiedAt: Schema.Date,
+  createdAt: Schema.Date,
+});
+export type StoredAccountIdentity = typeof StoredAccountIdentity.Type;
