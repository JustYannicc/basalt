@@ -0,0 +1,85 @@
+/** Hosted commands keep each request's product authorization and reviewed account destination. */
+import { Effect } from "effect";
+import type { AccountScope, AppId, OAuthClientSelection } from "@executor-js/sdk";
+import type { OrganizationReference } from "@executor-js/hosted-server/organization";
+import type { IdentityConsentSelection } from "@executor-js/ui/contracts/identity-consent";
+import { identityRequests } from "@executor-js/ui/contracts/identity-requests";
+import { HostedClient } from "./api.ts";
+import { refreshResourceDirectory } from "./resource-access.ts";
+import { refreshAppLinks } from "./app-accounts.ts";
+
+export const identityConsentAtoms = (key: {
+  readonly organization: OrganizationReference;
+  readonly app: AppId;
+  readonly scope: AccountScope;
+  readonly requirement: string;
+}) => {
+  const prepare = identityRequests(key, (target) =>
+    Effect.gen(function* () {
+      const client = yield* HostedClient;
+      const request = {
+        params: {
+          organization: key.organization,
+          app: target.app,
+          requirement: target.requirement,
+        },
+        payload: {},
+      };
+      return yield* target.scope === "app"
+        ? client.appAccounts.appConnect(request)
+        : client.appAccounts.userConnect(request);
+    }),
+  );
+  return {
+    plan: HostedClient.runtime.fn((input: IdentityConsentSelection & { readonly method: string }) =>
+      Effect.gen(function* () {
+        const { connection, ...selection } = yield* prepare(input);
+        return yield* (yield* HostedClient).accounts.planOAuth({
+          params: { organization: key.organization, connection },
+          payload: { ...selection, method: input.method },
+        });
+      }),
+    ),
+    reuse: HostedClient.runtime.fn(
+      (
+        input: IdentityConsentSelection & {
+          readonly method: string;
+          readonly sourceAccount: NonNullable<IdentityConsentSelection["sourceAccount"]>;
+        },
+        get,
+      ) =>
+        Effect.gen(function* () {
+          const { connection, additionalConnections } = yield* prepare(input);
+          const result = yield* (yield* HostedClient).accounts.reuseOAuth({
+            params: { organization: key.organization, connection },
+            payload: { additionalConnections, method: input.method, account: input.sourceAccount },
+          });
+          if (result.status === "completed") {
+            refreshResourceDirectory(get, key.organization);
+            refreshAppLinks(get, { organization: key.organization, app: key.app });
+          }
+          return result;
+        }),
+    ),
+    start: HostedClient.runtime.fn(
+      (
+        input: IdentityConsentSelection & {
+          readonly method: string;
+          readonly client?: OAuthClientSelection | undefined;
+        },
+      ) =>
+        Effect.gen(function* () {
+          const { connection, ...selection } = yield* prepare(input);
+          const signIn = yield* (yield* HostedClient).accounts.startOAuth({
+            params: { organization: key.organization, connection },
+            payload: {
+              ...selection,
+              method: input.method,
+              ...(input.client === undefined ? {} : { client: input.client }),
+            },
+          });
+          return { ...signIn, connection };
+        }),
+    ),
+  };
+};
diff --git a/apps/hosted/web/src/implementation/pages/accounts-client.tsx b/apps/hosted/web/src/implementation/pages/accounts-client.tsx
new file mode 100644
index 00000000..a4387f78
--- /dev/null
+++ b/apps/hosted/web/src/implementation/pages/accounts-client.tsx
@@ -0,0 +1,184 @@
+import { VerifyIdentities } from "@executor-js/ui/dashboard/verify-identities";
+import { useAtomSet } from "@effect/atom-react";
+import { identifyAccountsAtom } from "../../contracts/accounts.ts";
+import { IdentityAppPicker } from "@executor-js/ui/dashboard/identity-app-picker";
+import { AppConnectionDialogContent } from "./app-accounts.tsx";
+import { useState } from "react";
+import type { AccountId } from "@executor-js/sdk";
+import {
+  HostedAccountActions,
+  HostedAccountDialog,
+  type AccountDialogKind,
+} from "./account-actions.tsx";
+import { Option } from "effect";
+import { AccountsPage as SharedPage } from "@executor-js/ui/dashboard/accounts";
+import { EmptyState } from "@executor-js/ui/dashboard/empty-state";
+import { Button } from "@executor-js/ui/components/button";
+import { Link } from "@tanstack/react-router";
+import { useQuery } from "@executor-js/ui/dashboard/context";
+import { HostedFailure } from "../components/dashboard-bindings.tsx";
+import { useOrganizationDetails, useOrganizationRoute } from "../components/organization.tsx";
+import { OAuthClientsDialog } from "./oauth-clients.tsx";
+import { HostedAccountObservations, HostedAccountPlan } from "./account-observations.tsx";
+import { inventoryAtom } from "../../contracts/organization.ts";
+
+import { resourceDirectoryAtom, resourceInventoryAtom } from "../../contracts/resource-access.ts";
+
+/**
+ * Personal and shared credentials use one list. Administrators also manage the organization's
+ * OAuth clients from here, since those clients only exist to connect accounts.
+ */
+export function AccountsPage({
+  highlight,
+  oauthClients,
+}: {
+  readonly highlight?: AccountId | undefined;
+  readonly oauthClients: { readonly open: boolean; readonly onOpenChange: (open: boolean) => void };
+}) {
+  const { organization, slug: organizationSlug } = useOrganizationRoute();
+  const identify = useAtomSet(identifyAccountsAtom(organization), { mode: "promiseExit" });
+  const directory = useQuery(resourceDirectoryAtom(organization));
+  const inventory = useQuery(resourceInventoryAtom(organization));
+  const setup = useQuery(inventoryAtom(organization));
+
+  const [dialog, setDialog] = useState<{ account: AccountId; kind: AccountDialogKind }>();
+  const role = useOrganizationDetails()?.role;
+  const admin = role !== undefined && role !== "member";
+  const manageClients = admin && (
+    <Button variant="outline" onClick={() => oauthClients.onOpenChange(true)}>
+      OAuth clients
+    </Button>
+  );
+  return (
+    <>
+      <SharedPage
+        query={resourceInventoryAtom(organization)}
+        Failure={HostedFailure}
+        action={
+          <>
+            <VerifyIdentities
+              query={resourceInventoryAtom(organization)}
+              identify={identify}
+              Failure={HostedFailure}
+            />
+            {manageClients}
+          </>
+        }
+        empty={
+          <EmptyState
+            title="No accounts available"
+            action={
+              <div className="flex flex-wrap justify-center gap-2">
+                <Button asChild>
+                  <Link to="/org/$organizationSlug/apps" params={{ organizationSlug }}>
+                    Choose an app
+                  </Link>
+                </Button>
+                {manageClients}
+              </div>
+            }
+          >
+            Open an app to connect an account, or ask a teammate to share one.
+          </EmptyState>
+        }
+        highlight={highlight}
+        identityActions={(bindings, inventory) => {
+          const ready = Option.getOrUndefined(setup.data);
+          return (
+            ready !== undefined && (
+              <IdentityAppPicker bindings={bindings} inventory={inventory}>
+                {({ app, requirement, slot, method, account, onDone, onPendingChange }) => (
+                  <AppConnectionDialogContent
+                    key={`${app.id}:${slot}`}
+                    app={app}
+                    scope={requirement.scope}
+                    slot={slot}
+                    requirement={requirement}
+                    method={method}
+                    initialAccount={account}
+                    redirectUri={ready.accountSetup.redirectUri}
+                    onSaved={onDone}
+                    onPendingChange={onPendingChange}
+                  />
+                )}
+              </IdentityAppPicker>
+            )
+          );
+        }}
+        accountActions={(account) => {
+          const entry = Option.isSome(directory.data)
+            ? directory.data.value.accounts.find((item) => item.account.id === account.id)
+            : undefined;
+          return (
+            <HostedAccountActions
+              account={account}
+              access={entry?.access}
+              open={(kind) => setDialog({ account: account.id, kind })}
+            />
+          );
+        }}
+        accountMeta={(account) => {
+          const access = Option.isSome(directory.data)
+            ? directory.data.value.accounts.find((item) => item.account.id === account.id)?.access
+            : undefined;
+          return (
+            <>
+              {access && (
+                <span className="rounded border px-1.5 py-0.5 text-[10px]">
+                  {access.ownership.kind === "personal" ? "Personal" : "Shared"}
+                </span>
+              )}
+              <HostedAccountPlan account={account} />
+            </>
+          );
+        }}
+        accountDetails={(account, apps) => (
+          <HostedAccountObservations
+            account={account}
+            apps={apps}
+            canReconnect={(app) => {
+              if (
+                account.hostManaged === true ||
+                app.activeVersion === null ||
+                !Option.isSome(directory.data) ||
+                !Option.isSome(inventory.data)
+              )
+                return false;
+              const saved = inventory.data.value;
+              const listed = directory.data.value.apps.find((entry) => entry.app.id === app.id);
+              const usable = directory.data.value.accounts.some(
+                (entry) => entry.account.id === account.id && entry.access.canUse,
+              );
+              if (listed === undefined || !usable) return false;
+              return Object.values(app.requirements.accounts).some((requirement) => {
+                const method = requirement.definition.auth[account.method];
+                if (
+                  requirement.provider !== account.provider ||
+                  method === undefined ||
+                  method.type === "interactive" ||
+                  (method.type === "secrets" && method.provisioned === true)
+                )
+                  return false;
+                return requirement.scope === "user"
+                  ? listed.access.canUse && listed.linkedAccounts.includes(account.id)
+                  : listed.access.canManage &&
+                      (saved.appLinks ?? []).some(
+                        (link) => link.app === app.id && link.account === account.id,
+                      );
+              });
+            }}
+          />
+        )}
+      />
+      {dialog && (
+        <HostedAccountDialog
+          key={`${dialog.account}:${dialog.kind}`}
+          id={dialog.account}
+          dialog={dialog.kind}
+          onClose={() => setDialog(undefined)}
+        />
+      )}
+      {admin && <OAuthClientsDialog {...oauthClients} />}
+    </>
+  );
+}
