+                "entered",
+                method.tokenEndpointAuthMethod,
+              ),
+            }),
+        ...(resourceIndicator == null ? {} : { resource: resourceIndicator }),
+        resourceSource:
+          method.resource !== undefined
+            ? ("declared" as const)
+            : found?.resource === undefined
+              ? ("none" as const)
