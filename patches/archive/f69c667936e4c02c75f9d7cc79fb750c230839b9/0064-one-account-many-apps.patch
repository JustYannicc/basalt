+
+/** Saved account metadata is shared across app references, without exposing credential values. */
+export function AccountsPage<E>({
+  query,
+  Failure,
+  action,
+  ...props
+}: QueryProps<Inventory, E> & {
+  readonly filters?: ReactNode;
+  /** A page action beside the title, such as managing OAuth clients; hidden while there are none. */
+  readonly action?: ReactNode;
+  readonly empty?: ReactNode;
+  readonly accountActions?: (account: AccountSummary) => ReactNode;
+  readonly identityActions?: (
+    bindings: readonly AccountSummary[],
+    inventory: Inventory,
+  ) => ReactNode;
+  readonly accountMeta?: (account: AccountSummary) => ReactNode;
+  /** A full-width block under the row, such as the account's usage, given the apps using it. */
+  readonly accountDetails?: (account: AccountSummary, apps: readonly App[]) => ReactNode;
+  /** A linked account is scrolled into view and marked, since accounts have no page of their own. */
+  readonly highlight?: AccountId | undefined;
+}) {
+  const { result, data, refresh } = useQuery(query);
+  const [search, setSearch] = useState("");
+  return (
+    <PageFrame>
+      <PageHeader
+        title="Accounts"
+        description="Saved sign-ins, available to your apps."
+        {...(Option.isSome(data) ? { count: accountGroups(data.value.accounts).length } : {})}
+      >
+        {(!Option.isSome(data) || data.value.accounts.length > 0) && action}
+      </PageHeader>
+      <div className="list-toolbar mb-4 flex flex-wrap items-center gap-[10px_16px]">
+        {(!Option.isSome(data) || data.value.accounts.length > 0 || search.length > 0) && (
+          <SearchInput value={search} onChange={setSearch} placeholder="Search accounts…" />
+        )}
+        {props.filters}
+      </div>
+      <QueryResult
+        result={result}
+        Failure={Failure}
+        retry={refresh}
+        pending={<AccountRowsSkeleton />}
+      >
+        {(data) => (
+          <AccountsList
+            data={data}
+            search={search}
+            clearSearch={() => setSearch("")}
+            {...props}
+            empty={
+              props.empty ?? (
+                <Empty title="No accounts yet">Open an app to connect an account.</Empty>
+              )
+            }
+          />
+        )}
+      </QueryResult>
+    </PageFrame>
+  );
+}
+
+function AccountsList({
+  data,
+  search,
+  accountActions,
+  identityActions,
+  accountMeta,
+  accountDetails,
+  highlight,
+  empty,
+  clearSearch,
+}: {
+  readonly data: Inventory;
+  readonly search: string;
+  readonly empty: ReactNode;
+  readonly clearSearch: () => void;
+  readonly accountActions?: (account: AccountSummary) => ReactNode;
+  readonly identityActions?: (
+    bindings: readonly AccountSummary[],
+    inventory: Inventory,
+  ) => ReactNode;
+  readonly accountMeta?: (account: AccountSummary) => ReactNode;
+  readonly accountDetails?: (account: AccountSummary, apps: readonly App[]) => ReactNode;
+  readonly highlight?: AccountId | undefined;
