@@ -0,0 +1,31 @@
+import { createFileRoute } from "@tanstack/react-router";
+import { ErrorTrackingProvider } from "@executor-js/ui/dashboard/error-tracking";
+import { OrganizationBoundary, OrganizationContent } from "@executor-js/hosted-web/organization";
+import { AppSkeleton } from "@executor-js/hosted-web/pages/app-screen";
+import { AppWindowPage } from "@executor-js/hosted-web/pages/app-window";
+import { parseAppParams } from "@executor-js/hosted-web/route-params";
+
+/** An embedded app full-window, outside the dashboard shell, where "Open in new tab" goes. */
+export const Route = createFileRoute("/org/$organizationSlug_/apps/$appId/window")({
+  // No parent route carries the organization here, so its slug passes through with the app ID.
+  params: {
+    parse: ({ organizationSlug, appId }: { organizationSlug: string; appId: string }) => ({
+      organizationSlug,
+      ...parseAppParams({ appId }),
+    }),
+  },
+  component: AppWindow,
+});
+
+function AppWindow() {
+  const { organizationSlug, appId } = Route.useParams();
+  return (
+    <OrganizationBoundary slug={organizationSlug}>
+      <ErrorTrackingProvider>
+        <OrganizationContent pending={<AppSkeleton />}>
+          <AppWindowPage appId={appId} />
+        </OrganizationContent>
+      </ErrorTrackingProvider>
+    </OrganizationBoundary>
+  );
+}
