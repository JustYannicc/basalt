diff --git a/apps/hosted/web/src/implementation/pages/app-window.tsx b/apps/hosted/web/src/implementation/pages/app-window.tsx
new file mode 100644
index 0000000..06a5836
--- /dev/null
+++ b/apps/hosted/web/src/implementation/pages/app-window.tsx
@@ -0,0 +1,47 @@
+import type { AppId } from "@executor-js/sdk";
+import { Button } from "@executor-js/ui/components/button";
+import { appScreenTab } from "@executor-js/ui/dashboard/app-detail";
+import { useQuery } from "@executor-js/ui/dashboard/context";
+import { Link } from "@tanstack/react-router";
+import { Option } from "effect";
+import { AsyncResult } from "effect/reactivity";
+import { liveAppAtom } from "../../contracts/apps.ts";
+import { appAccessAtom } from "../../contracts/resource-access.ts";
+import { useOrganizationRoute } from "../components/organization.tsx";
+import { AppScreen, AppSkeleton } from "./app-screen.tsx";
+
+/**
+ * An embedded app alone in its own tab, on the dashboard's address. "Open in new tab" lands here,
+ * so a person never sees the app's opaque origin.
+ */
+export function AppWindowPage({ appId }: { readonly appId: AppId }) {
+  const { organization, slug } = useOrganizationRoute();
+  const query = useQuery(liveAppAtom({ organization, app: appId }));
+  const authority = useQuery(appAccessAtom({ organization, app: appId }));
+  const app = Option.getOrUndefined(query.data);
+  const screen = appScreenTab(app, Option.getOrUndefined(authority.data), {
+    app: AsyncResult.isFailure(query.result),
+    access: AsyncResult.isFailure(authority.result),
+  });
+  return (
+    <main className="flex h-dvh flex-col bg-background">
+      {screen === "present" && app !== undefined ? (
+        <AppScreen app={app} active />
+      ) : screen === "pending" ? (
+        <AppSkeleton />
+      ) : (
+        <div className="m-auto flex flex-col items-center gap-3 text-sm text-muted-foreground">
+          <p>This app has no screen you can open.</p>
+          <Button variant="outline" size="sm" asChild>
+            <Link
+              to="/org/$organizationSlug/apps/$appId"
+              params={{ organizationSlug: slug, appId }}
+            >
+              Go to the app
+            </Link>
+          </Button>
+        </div>
+      )}
+    </main>
+  );
+}
