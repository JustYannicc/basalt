+import { Context, Effect, Redacted, Schema } from "effect";
+import { AccountId, ProviderDefinition, type Credentials } from "@executor-js/sdk/core";
+import type { Json } from "../contracts.ts";
+import { RetainedIdentityRefused, readRetainedAccount } from "./retained-identity-records.ts";
+
+export class GoogleClientDiagnosticsRuntime extends Context.Service<
+  GoogleClientDiagnosticsRuntime,
+  {
+    readonly credentials: Pick<Credentials, "decrypt">;
+    readonly configuredClientId: string | undefined;
+  }
+>()("basalt/production-ops/GoogleClientDiagnosticsRuntime") {}
+
+const Request = Schema.Struct({
+  organization: Schema.NonEmptyString,
+  accounts: Schema.Array(Schema.NonEmptyString.check(Schema.isMaxLength(256))).check(
+    Schema.isMinLength(1),
+    Schema.isMaxLength(50),
+  ),
+});
+
+// Decode provenance only. Token contents, lifetime and refresh capability are irrelevant here.
+const SavedClient = Schema.Struct({
+  firstParty: Schema.optionalKey(Schema.NonEmptyString),
+  authorizationClient: Schema.optionalKey(Schema.NonEmptyString),
+});
+
+const Comparison = Schema.Struct({
+  savedClientPresent: Schema.Boolean,
+  firstPartyRegistrationMatches: Schema.Boolean,
+  clientIdMatches: Schema.Boolean,
+});
+
+/** The result reveals equality, never either side of a client comparison. */
+export const diagnoseGoogleClients = (request: Json) =>
+  Effect.gen(function* () {
+    const input = yield* Schema.decodeUnknownEffect(Request)(request);
+    const selected = [...new Set(input.accounts)].sort();
+    if (selected.length !== input.accounts.length)
+      return yield* new RetainedIdentityRefused({ reason: "duplicate-account-selection" });
+    const runtime = yield* GoogleClientDiagnosticsRuntime;
+    const accounts = new Map<string, typeof Comparison.Type>();
+    for (const account of selected) {
+      const row = yield* readRetainedAccount(account);
+      if (
+        row.organization !== input.organization ||
+        row.owner !== `organization:${input.organization}`
+      )
+        return yield* new RetainedIdentityRefused({ reason: "account-outside-organization" });
+      const definition = yield* Schema.decodeUnknownEffect(ProviderDefinition)(row.definition);
+      const method = definition.auth[row.method];
+      if (
+        method?.type !== "oauth2" ||
+        method.grant === "client_credentials" ||
+        (method.identity !== undefined &&
+          method.identity.issuer !== "https://accounts.google.com") ||
+        (method.discover === undefined
+          ? ![
+              "https://accounts.google.com/o/oauth2/v2/auth",
+              "https://accounts.google.com/o/oauth2/auth",
+            ].includes(method.authorizationUrl ?? "") ||
+            ![
+              "https://oauth2.googleapis.com/token",
+              "https://accounts.google.com/o/oauth2/token",
+            ].includes(method.tokenUrl ?? "")
+          : ![
+              "https://accounts.google.com",
+              "https://accounts.google.com/",
+              "https://accounts.google.com/.well-known/openid-configuration",
+            ].includes(method.discover))
+      )
+        return yield* new RetainedIdentityRefused({ reason: "provider-not-google" });
+      const fields = yield* runtime.credentials.decrypt(
+        AccountId.make(row.grant),
+        Redacted.make(row.encrypted),
+      );
+      const saved = yield* Schema.decodeUnknownEffect(SavedClient)(Redacted.value(fields));
+      accounts.set(account, {
+        savedClientPresent: saved.authorizationClient !== undefined,
+        firstPartyRegistrationMatches: saved.firstParty === "google",
+        clientIdMatches:
+          runtime.configuredClientId !== undefined &&
+          saved.authorizationClient === runtime.configuredClientId,
+      });
+    }
+    return {
+      configuredClientAvailable: runtime.configuredClientId !== undefined,
+      accounts: Object.fromEntries(accounts),
+    };
+  });
