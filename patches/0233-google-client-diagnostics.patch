diff --git a/e2e/tests/google-client-diagnostics.spec.ts b/e2e/tests/google-client-diagnostics.spec.ts
new file mode 100644
index 0000000..51aa7bf
--- /dev/null
+++ b/e2e/tests/google-client-diagnostics.spec.ts
@@ -0,0 +1,201 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { createCipheriv, randomBytes, randomUUID } from "node:crypto";
+import type { TestContext } from "vitest";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { cloudLocks } from "../support/cloud-locks.ts";
+import { Artifact, productionOpsClient } from "../support/production-ops-client.ts";
+import { scenarios } from "../test-plan.ts";
+
+const clientId = "synthetic-google-diagnostic-client";
+const privateValues = [
+  clientId,
+  "synthetic-google-diagnostic-secret",
+  "private-access-canary",
+  "private-refresh-canary",
+  "another-client-canary",
+];
+
+// Legacy grants may omit provenance that today's sign-in always records.
+const seal = (id: string, metadata: object) => {
+  const nonce = randomBytes(12);
+  const cipher = createCipheriv("aes-256-gcm", Buffer.from("cd".repeat(32), "hex"), nonce);
+  cipher.setAAD(Buffer.from(id));
+  const encrypted = Buffer.concat([
+    cipher.update(
+      JSON.stringify({
+        grant: "authorization_code",
+        generation: 3,
+        response: {},
+        fields: { access_token: privateValues[2] },
+        refreshToken: privateValues[3],
+        expiresAt: 0,
+        ...metadata,
+      }),
+    ),
+    cipher.final(),
+  ]);
+  return Buffer.concat([Buffer.from([1]), nonce, encrypted, cipher.getAuthTag()]).toString("hex");
+};
+
+layer(HostedLive, { excludeTestServices: true })("Google client diagnostics", (it) => {
+  const diagnose = (context: TestContext, configured: boolean) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const actors = yield* Actors,
+          api = yield* Api,
+          database = yield* cloudLocks;
+        const client = yield* productionOpsClient;
+        const organization = actors.organization.id,
+          owner = `organization:${organization}`;
+        const person = (yield* body(
+          Schema.Struct({ user: Schema.Struct({ id: Schema.String }) }),
+          yield* api.request(actors.owner, "GET", "/api/auth/get-session"),
+        )).user.id;
+        const provider = `prv_${randomUUID()}`,
+          otherProvider = `prv_${randomUUID()}`;
+        const variants = [
+          { firstParty: "google", authorizationClient: clientId },
+          { firstParty: "google", authorizationClient: privateValues[4] },
+          { firstParty: "google" },
+          { firstParty: "synthetic-cloud-mail", authorizationClient: clientId },
+          { authorizationClient: clientId },
+        ];
+        const selected = variants.map(() => `acc_${randomUUID()}`);
+        const unreadable = `acc_${randomUUID()}`,
+          foreign = `acc_${randomUUID()}`,
+          nonGoogle = `acc_${randomUUID()}`;
+        const ids = [...selected, unreadable, foreign, nonGoogle];
+        const rows = (sql: string, params: readonly (string | number | null)[] = []) =>
+          database.run({ sql, params });
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            for (const id of ids) {
+              yield* rows("delete from executor_accounts where id = $1", [id]);
+              yield* rows("delete from executor_oauth_grants where id = $1", [id]);
+            }
+            yield* rows("delete from executor_providers where id in ($1,$2)", [
+              provider,
+              otherProvider,
+            ]);
+          }).pipe(Effect.orDie),
+        );
+        for (const [id, google] of [
+          [provider, true],
+          [otherProvider, false],
+        ] as const) {
+          yield* rows("insert into executor_providers (id,definition) values ($1,$2::jsonb)", [
+            id,
+            JSON.stringify({
+              name: "Synthetic diagnostic provider",
+              auth: {
+                oauth: {
+                  type: "oauth2",
+                  authorizationUrl: google
+                    ? "https://accounts.google.com/o/oauth2/v2/auth"
+                    : "https://outside.example.test/authorize",
+                  tokenUrl: google
+                    ? "https://oauth2.googleapis.com/token"
+                    : "https://outside.example.test/token",
+                  scopes: ["openid", "email"],
+                  response: {
+                    type: "object",
+                    properties: { access_token: { type: "string" } },
+                    required: ["access_token"],
+                  },
+                },
+              },
+            }),
+          ]);
+        }
+        for (const [index, id] of ids.entries()) {
+          const accountOwner = id === foreign ? "organization:another-organization" : owner;
+          yield* rows(
+            `insert into executor_accounts (id,owner,provider,method,label,encrypted_credentials,created_at,credential_generation)
+          values ($1,$2,$3,'oauth','Retained account',decode('123456','hex'),now(),3)`,
+            [id, accountOwner, id === nonGoogle ? otherProvider : provider],
+          );
+          yield* rows(
+            `insert into executor_oauth_grants (id,encrypted,status,updated_at,owner)
+          values ($1,decode($2,'hex'),'ready_fixture',now(),$3)`,
+            [
+              id,
+              id === unreadable ? "abcdef" : seal(id, variants[index] ?? variants[0]!),
+              accountOwner,
+            ],
+          );
+          yield* rows(
+            `insert into hosted_account_access (account_id,organization_id,creator_id,kind,personal_user_id)
+          values ($1,$2,$3,'personal',$3)`,
+            [id, organization, person],
+          );
+        }
+        const snapshot = () =>
+          rows(
+            `select
+        (select jsonb_agg(to_jsonb(a) order by a.id) from executor_accounts a where a.id in (select jsonb_array_elements_text($1::jsonb))) as accounts,
+        (select jsonb_agg(to_jsonb(g) order by g.id) from executor_oauth_grants g where g.id in (select jsonb_array_elements_text($1::jsonb))) as grants,
+        (select jsonb_agg(to_jsonb(h) order by h.account_id) from hosted_account_access h where h.account_id in (select jsonb_array_elements_text($1::jsonb))) as access`,
+            [JSON.stringify(ids)],
+          );
+        const before = yield* snapshot();
+        const operation = (accounts: readonly string[]) => ({
+          action: "prepare",
+          selection: "google-client-diagnostics",
+          request: { organization, accounts },
+          recipient: client.recipient,
+        });
+        expect(
+          (yield* client.request(operation(selected), { secret: "00".repeat(32) })).status,
+        ).toBe(401);
+        const response = yield* client.request(operation(selected));
+        expect(response.status, JSON.stringify(response.body)).toBe(200);
+        const decoded = client.decrypt(
+          (yield* body(Schema.Struct({ artifact: Artifact }), response)).artifact,
+        );
+        const report = Schema.decodeUnknownSync(
+          Schema.Struct({ selection: Schema.String, result: Schema.Unknown }),
+        )(decoded);
+        expect(report.selection).toBe("google-client-diagnostics");
+        expect(report.result).toEqual({
+          configuredClientAvailable: configured,
+          accounts: Object.fromEntries(
+            selected.map((account, index) => [
+              account,
+              {
+                savedClientPresent: index !== 2,
+                firstPartyRegistrationMatches: index < 3,
+                clientIdMatches: configured && index !== 1 && index !== 2,
+              },
+            ]),
+          ),
+        });
+        for (const privateValue of privateValues) {
+          expect(JSON.stringify(response.body)).not.toContain(privateValue);
+          expect(JSON.stringify(decoded)).not.toContain(privateValue);
+        }
+        for (const selection of [
+          [],
+          [selected[0]!, selected[0]!],
+          Array.from({ length: 51 }, () => selected[0]!),
+          ["x".repeat(257)],
+          [unreadable],
+          [foreign],
+          [nonGoogle],
+          [`acc_${randomUUID()}`],
+        ]) {
+          const refused = yield* client.request(operation(selection));
+          expect(refused.status, JSON.stringify(refused.body)).toBe(409);
+          for (const privateValue of privateValues)
+            expect(JSON.stringify(refused.body)).not.toContain(privateValue);
+        }
+        expect(yield* snapshot()).toEqual(before);
+      }),
+    );
+
+  it.effect(scenarios.googleClientDiagnostics.title, (context) => diagnose(context, true));
+  it.effect(scenarios.googleClientUnavailable.title, (context) => diagnose(context, false));
+});
