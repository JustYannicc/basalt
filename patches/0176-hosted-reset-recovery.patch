@@ -0,0 +1,120 @@
+import { AccountId, AppId, StorageError } from "@executor-js/sdk/core";
+import { ApiError } from "@executor-js/utils/api-error";
+import { Context, Schema, type Redacted } from "effect";
+import { HttpApiEndpoint, HttpApiGroup } from "effect/http-api";
+import { BrowserSessionOnly, Forbidden } from "./auth.ts";
+import { requireAccount } from "./account-grants.ts";
+import {
+  OrganizationForbidden,
+  OrganizationReference,
+  RequireOrganization,
+} from "./organization.ts";
+
+export const ResetCredit = Schema.Struct({
+  id: Schema.NonEmptyString,
+  type: Schema.Literals(["codex_rate_limits", "cedar_ember"]),
+  remaining: Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)),
+  expiresAt: Schema.NullOr(Schema.NonEmptyString),
+  usableNow: Schema.NullOr(Schema.Boolean),
+  requiresLimit: Schema.Boolean,
+  clears: Schema.NullOr(
+    Schema.Array(Schema.Literals(["five_hour", "seven_day", "seven_day_overage_included"])),
+  ),
+});
+export type ResetCredit = typeof ResetCredit.Type;
+export const ResetCredits = Schema.Struct({
+  provider: Schema.Literals(["codex", "claude"]),
+  observedAt: Schema.NonEmptyString,
+  available: Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)),
+  credits: Schema.Array(ResetCredit),
+});
+export type ResetCredits = typeof ResetCredits.Type;
+export const ResetResult = Schema.Struct({
+  requestId: Schema.NonEmptyString,
+  outcome: Schema.Literals([
+    "reset",
+    "already_redeemed",
+    "already_used",
+    "nothing_to_reset",
+    "no_credit",
+    "not_limited",
+    "cooldown",
+    "ineligible",
+    "unavailable",
+    "rate_limited",
+    "auth_error",
+    "unknown",
+  ]),
+  cooldownCleared: Schema.Boolean,
+  usageRefreshQueued: Schema.Boolean,
+});
+export type ResetResult = typeof ResetResult.Type;
+export const ResetAttempt = Schema.Struct({
+  ...ResetResult.fields,
+  provider: Schema.Literals(["codex", "claude"]),
+  creditId: Schema.NonEmptyString,
+  startedAt: Schema.NonEmptyString,
+  retryUntil: Schema.NonEmptyString,
+  canRetryProvider: Schema.Boolean,
+});
+export type ResetAttempt = typeof ResetAttempt.Type;
+
+export const AccountResetUnavailable = ApiError.define({
+  tag: "AccountResetUnavailable",
+  status: 503,
+  message: "This account's banked resets could not be reached. Keep its request ID and retry.",
+});
+export const AccountResetRefused = ApiError.define({
+  tag: "AccountResetRefused",
+  status: 409,
+  fields: { reason: Schema.Literals(["invalid_query", "not_found", "unknown_provider", "busy"]) },
+  message:
+    "This reset cannot start. Read its retained attempt and current reset credits before trying again.",
+});
+
+export const AccountResetBackend = Context.Reference<
+  { readonly key: Redacted.Redacted<string>; readonly origin: string } | undefined
+>("hosted/AccountResetBackend", { defaultValue: () => undefined });
+
+const params = { organization: OrganizationReference, pool: AppId, account: AccountId };
+const prefix = "/api/organizations/:organization/pools/:pool/accounts/:account";
+const errors = [
+  OrganizationForbidden,
+  StorageError,
+  AccountResetUnavailable,
+  AccountResetRefused,
+] as const;
+/** Saved-account IDs cross this boundary; the host keeps the provider reference private. */
+export const HostedAccountResets = HttpApiGroup.make("accountResets")
+  .add(
+    HttpApiEndpoint.get("credits", `${prefix}/reset-credits`, {
+      params,
+      success: ResetCredits,
+      error: errors,
+    }).pipe(requireAccount.inspect),
+  )
+  .add(
+    HttpApiEndpoint.get("attempt", `${prefix}/reset-attempt`, {
+      params,
+      success: Schema.NullOr(ResetAttempt),
+      error: errors,
+    }).pipe(requireAccount.inspect),
+  )
+  .add(
+    HttpApiEndpoint.post("use", `${prefix}/reset`, {
+      params,
+      payload: Schema.Struct({
+        creditId: Schema.NonEmptyString.check(Schema.isMaxLength(256)),
+        requestId: Schema.String.check(
+          Schema.isPattern(
+            /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/u,
+          ),
+        ),
+      }),
+      success: ResetResult,
+      error: [...errors, Forbidden],
+    })
+      .pipe(requireAccount.use)
+      .annotate(BrowserSessionOnly, true),
+  )
+  .middleware(RequireOrganization);
