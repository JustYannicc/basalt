diff --git a/apps/hosted/server/src/implementation/account-resets.ts b/apps/hosted/server/src/implementation/account-resets.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/server/src/implementation/account-resets.ts
@@ -0,0 +1,174 @@
+import { AppId, StorageError } from "@executor-js/sdk/core";
+import { Config, Effect, Option, Redacted, Schema } from "effect";
+import {
+  FetchHttpClient,
+  HttpBody,
+  HttpClient,
+  HttpClientResponse,
+  HttpServerResponse,
+} from "effect/http";
+import { HttpApiBuilder } from "effect/http-api";
+import { HostedApi } from "../contracts/api.ts";
+import { HostedExecutor } from "../contracts/executor.ts";
+import {
+  AccountResetBackend,
+  AccountResetRefused,
+  AccountResetUnavailable,
+  ResetAttempt,
+  ResetCredits,
+  ResetResult,
+} from "../contracts/account-resets.ts";
+import { OrganizationForbidden } from "../contracts/organization.ts";
+import { AccountGrants } from "./proofs/account-access.ts";
+import { browserOnly } from "./access.ts";
+import {
+  currentResourceAuthority,
+  policyDatabase,
+  requireAppAccessAs,
+  usableAppLinks,
+} from "./resource-policy.ts";
+import { nativePoolMembership } from "./pool-membership.ts";
+import { signPoolToken } from "./pool-token.ts";
+import { SqlClient } from "effect/sql";
+
+/** Resolve a current saved-account link in this person's own pool. Never guess from a label. */
+const target = (pool: AppId, spend: boolean) =>
+  Effect.gen(function* () {
+    if (spend) yield* browserOnly;
+    const grant = yield* spend ? AccountGrants.use : AccountGrants.inspect;
+    const actor = yield* currentResourceAuthority;
+    yield* requireAppAccessAs(actor, pool, "use");
+    const sql = yield* policyDatabase;
+    const rows =
+      yield* sql`select coalesce(entry.value ->> 'owner', entry.key) as owner, entry.value ->> 'membership' as membership
+    from organization o
+    cross join lateral jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) entry
+    join executor_apps app on app.id = entry.value ->> 'app' and app.owner = 'organization:' || o.id
+    where o.id = ${actor.organization} and app.id = ${pool}`;
+    if (rows.length !== 1 || rows[0]?.owner !== actor.user)
+      return yield* new OrganizationForbidden();
+    const executor = yield* Effect.flatten(HostedExecutor);
+    let reference: string | undefined;
+    if (rows[0]?.membership === "executor-links-v1") {
+      const membership = yield* nativePoolMembership(actor.organization, pool, executor).pipe(
+        Effect.provideService(SqlClient.SqlClient, sql),
+      );
+      const refs = [
+        ...new Set(
+          membership.accounts.flatMap((row) =>
+            row.account === grant.account &&
+            (row.method === "codex" || row.method === "claude") &&
+            row.homeReference !== null
+              ? [row.homeReference]
+              : [],
+          ),
+        ),
+      ];
+      if (membership.native && refs.length === 1) reference = refs[0];
+    } else {
+      // Released app-acquired subscriptions keep their ref in managed credentials, not a native binding.
+      const links = yield* sql`select a.id from ${yield* usableAppLinks(sql, [pool])}
+      and a.id = ${grant.account} and l.requirement = 'subscriptions'
+      and contribution_deployment.requirements::jsonb -> 'accounts' -> l.requirement ->> 'scope' = 'app'
+      and contribution_deployment.requirements::jsonb -> 'accounts' -> l.requirement ->> 'provider' = a.provider`;
+      if (links.length === 1) {
+        const credentials = yield* executor.managedAccounts.readCredentials({
+          account: grant.account,
+          owner: grant.owner,
+        });
+        const fields = Redacted.value(credentials);
+        if (typeof fields.ref === "string") reference = fields.ref;
+      }
+    }
+    if (
+      reference === undefined ||
+      reference.length === 0 ||
+      reference.length > 256 ||
+      reference.startsWith("sbhrefs1:")
+    )
+      return yield* new AccountResetUnavailable();
+    return { pool, organization: actor.organization, owner: actor.user, reference };
+  }).pipe(
+    Effect.catchTags({
+      SqlError: () => new StorageError(),
+      AccountNotFound: () => new AccountResetUnavailable(),
+      CredentialsError: () => new AccountResetUnavailable(),
+    }),
+  );
+
+const send = <A>(
+  pool: AppId,
+  action: "resets" | "resets/attempt" | "resets/use",
+  schema: Schema.ConstraintDecoder<A, never>,
+  payload?: { readonly creditId: string; readonly requestId: string },
+) =>
+  Effect.gen(function* () {
+    const resolved = yield* target(pool, payload !== undefined);
+    const supplied = yield* AccountResetBackend;
+    const backend =
+      supplied ??
+      (yield* Effect.gen(function* () {
+        const key = yield* Config.Redacted("POOL_APP_SIGNING_KEY").pipe(Config.option);
+        const origin = yield* Config.String("BASALT_POOL_ORIGIN").pipe(Config.option);
+        return Option.isSome(key) && Option.isSome(origin)
+          ? { key: key.value, origin: origin.value }
+          : undefined;
+      }));
+    if (backend === undefined) return yield* new AccountResetUnavailable();
+    const token = yield* Effect.tryPromise(() =>
+      signPoolToken(Redacted.value(backend.key), resolved),
+    );
+    const client = yield* HttpClient.HttpClient;
+    const path = `/pool/v1/accounts/${encodeURIComponent(resolved.reference)}/${action}`;
+    const url = new URL(path, backend.origin).href;
+    const headers = { authorization: `Bearer ${token}`, "x-signalbox-caller": resolved.owner };
+    const response = yield* payload === undefined
+      ? client.get(url, { headers })
+      : client.post(url, { headers, body: HttpBody.jsonUnsafe(payload) });
+    if (response.status === 403) return yield* new OrganizationForbidden();
+    if (response.status !== 200) {
+      const value = yield* HttpClientResponse.schemaBodyJson(
+        Schema.Struct({ error: Schema.String }),
+      )(response);
+      if (
+        value.error === "invalid_query" ||
+        value.error === "not_found" ||
+        value.error === "unknown_provider" ||
+        value.error === "busy"
+      )
+        return yield* new AccountResetRefused({ reason: value.error });
+      return yield* new AccountResetUnavailable();
+    }
+    return yield* HttpClientResponse.schemaBodyJson(schema)(response);
+  }).pipe(
+    Effect.timeout("15 seconds"),
+    Effect.provide(FetchHttpClient.layer),
+    Effect.catchTags({
+      ConfigError: () => new AccountResetUnavailable(),
+      UnknownError: () => new AccountResetUnavailable(),
+      HttpClientError: () => new AccountResetUnavailable(),
+      SchemaError: () => new AccountResetUnavailable(),
+      TimeoutError: () => new AccountResetUnavailable(),
+    }),
+  );
+
+const fresh = <A, E, R>(work: Effect.Effect<A, E, R>) =>
+  work.pipe(
+    Effect.map((value) =>
+      HttpServerResponse.jsonUnsafe(value, { headers: { "cache-control": "no-store" } }),
+    ),
+  );
+
+export const hostedAccountResetHandlers = HttpApiBuilder.group(
+  HostedApi,
+  "accountResets",
+  (handlers) =>
+    handlers
+      .handle("credits", ({ params }) => fresh(send(params.pool, "resets", ResetCredits)))
+      .handle("attempt", ({ params }) =>
+        fresh(send(params.pool, "resets/attempt", Schema.NullOr(ResetAttempt))),
+      )
+      .handle("use", ({ params, payload }) =>
+        fresh(send(params.pool, "resets/use", ResetResult, payload)),
+      ),
+);
