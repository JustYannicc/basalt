diff --git a/apps/hosted/web/src/contracts/account-resets.ts b/apps/hosted/web/src/contracts/account-resets.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/web/src/contracts/account-resets.ts
@@ -0,0 +1,40 @@
+import type { AccountId, AppId } from "@executor-js/sdk";
+import type { OrganizationReference } from "@executor-js/hosted-server/organization";
+export type {
+  ResetCredit,
+  ResetAttempt,
+  ResetCredits,
+  ResetResult,
+} from "@executor-js/hosted-server/account-resets";
+import { Data, Effect } from "effect";
+import { Atom } from "effect/reactivity";
+import { HostedClient } from "./api.ts";
+
+class Target extends Data.Class<{
+  readonly organization: OrganizationReference;
+  readonly pool: AppId;
+  readonly account: AccountId;
+}> {}
+// These are explicit fresh reads, not observation caches. Opening a confirm never spends.
+const credits = Atom.family((params: Target) =>
+  HostedClient.runtime.fn(() =>
+    Effect.flatMap(HostedClient, (client) => client.accountResets.credits({ params })),
+  ),
+);
+const attempt = Atom.family((params: Target) =>
+  HostedClient.runtime.fn(() =>
+    Effect.flatMap(HostedClient, (client) => client.accountResets.attempt({ params })),
+  ),
+);
+const use = Atom.family((params: Target) =>
+  HostedClient.runtime.fn((payload: { readonly creditId: string; readonly requestId: string }) =>
+    Effect.flatMap(HostedClient, (client) => client.accountResets.use({ params, payload })),
+  ),
+);
+export const resetCreditsAtom = (target: ConstructorParameters<typeof Target>[0]) =>
+  credits(new Target(target));
+export const resetAttemptAtom = (target: ConstructorParameters<typeof Target>[0]) =>
+  attempt(new Target(target));
+/** The browser invokes this only after confirmation; the request ID belongs to one intended spend. */
+export const useResetAtom = (target: ConstructorParameters<typeof Target>[0]) =>
+  use(new Target(target));
