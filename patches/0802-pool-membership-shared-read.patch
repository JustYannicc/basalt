+
+/** The shared counterpart: writers wait for the operation, other shared holders do not. */
+export const withOrganizationReadLock = <A, E, R>(
+  organization: string,
+  operation: Effect.Effect<A, E, R>,
+) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    return yield* sql.withTransaction(
+      lockOrganizationReadAccess(organization).pipe(Effect.andThen(operation)),
+    );
+  });
