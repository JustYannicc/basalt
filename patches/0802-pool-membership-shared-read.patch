diff --git a/e2e/tests/pool-membership-shared-read.spec.ts b/e2e/tests/pool-membership-shared-read.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/pool-membership-shared-read.spec.ts
@@ -0,0 +1,222 @@
+import { expect, layer } from "@effect/vitest";
+import { Clock, Effect, Schema } from "effect";
+import { createHmac, randomUUID } from "node:crypto";
+import { Actors } from "../support/actors.ts";
+import { Api } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { cloudLocks } from "../support/cloud-locks.ts";
+import { poolFixtureSigningKey } from "../support/cloud-pool-gateway.ts";
+import { Evidence } from "../support/evidence.ts";
+import { legacyPoolHome } from "../support/legacy-pool-home.ts";
+import {
+  installLegacyPoolHandoffSetup,
+  legacyPoolHandoffFixture,
+} from "../support/legacy-pool-handoff-setup.ts";
+import { Target } from "../support/platform.ts";
+import { poolHistoryDatabase } from "../support/pool-history-database.ts";
+import { poolWorkerRuntime } from "../support/pool-worker-runtime.ts";
+import { openPrivateApp, waitForAppUrl } from "../support/app-pages.ts";
+import { sqlWireProof } from "../support/sql-wire-proof.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Registration = Schema.Array(Schema.Struct({ membership: Schema.NullOr(Schema.String) }));
+
+/**
+ * An exclusive or shared advisory lock on a text key. The wire log carries no parameters, so these
+ * also match other text-keyed locks (catalog, pool defaults, installs, default policies, the app
+ * registry); counted only on the membership read's own traces, they are its organization lock.
+ */
+const exclusiveLock = /^\s*select pg_advisory_xact_lock\(hashtextextended/i;
+const sharedLock = /^\s*select pg_advisory_xact_lock_shared\(hashtextextended/i;
+/** The membership read's first row lock: its presence proves the read itself ran. */
+const membershipRows = /from hosted_app_account_links l[\s\S]*for share of a/i;
+/** Below the pool's membership read timeout (10 s), which its read would otherwise wait out. */
+const readCap = 6_000;
+
+layer(HostedLive, { excludeTestServices: true })(
+  "Pool membership reads share the organization lock",
+  (it) => {
+    installLegacyPoolHandoffSetup({ nativeSources: true });
+    it.effect(scenarios.poolMembershipSharedRead.title, (context) =>
+      withHostedCase(
+        context,
+        Effect.gen(function* () {
+          const api = yield* Api,
+            actors = yield* Actors,
+            target = yield* Target,
+            browser = yield* Browser,
+            evidence = yield* Evidence;
+          const wire = yield* sqlWireProof;
+          const { pool, accounts } = legacyPoolHandoffFixture(context);
+          const home = yield* legacyPoolHome(
+            pool.id,
+            ["codex", "claude", "claude", "claude", "xai"].map((provider, index) => ({
+              id: `synthetic-cloud-native-reference-${index + 1}`,
+              provider,
+            })),
+          );
+          const history = yield* poolHistoryDatabase;
+          const worker = yield* poolWorkerRuntime(
+            target.metadata.origin,
+            home.origin,
+            history.connection,
+          );
+          const peer = (origin: string | null) =>
+            api.request(actors.owner, "POST", "/native-provider-fixture/product-peer", {
+              pool: pool.id,
+              origin,
+            });
+          expect((yield* peer(worker.origin)).status).toBe(200);
+          yield* Effect.addFinalizer(() => peer(null).pipe(Effect.asVoid, Effect.orDie));
+          expect((yield* worker.operations("/model-history/schema/catalog")).status).toBe(200);
+          yield* history.applySchema;
+
+          const organization = actors.organization.id;
+          const path = `/api/organizations/${organization}/apps/${pool.id}`;
+          expect(accounts.length).toBeGreaterThan(1);
+          yield* browser.login(actors.owner);
+          yield* browser.use("Keep reads explicit", (page) =>
+            page.route("**/*.js", (route) => route.abort()),
+          );
+          yield* openPrivateApp(yield* waitForAppUrl(actors.owner, `${path}/ui`));
+
+          // The overview's fresh pool view. With the membership gate's mapping it reads membership
+          // from the host only through the gate, so the lock is proven on the pool's own read below.
+          const view = () =>
+            browser.use("Pool view", (page) =>
+              page.evaluate(() => {
+                const context = JSON.parse(
+                  document.getElementById("executor-context")?.textContent ?? "{}",
+                );
+                return fetch("/_executor/api/query", {
+                  method: "POST",
+                  credentials: "same-origin",
+                  headers: { "content-type": "application/json" },
+                  body: JSON.stringify({
+                    name: "view",
+                    input: { fresh: true },
+                    version: context.version ?? context.deployment,
+                  }),
+                }).then((response) =>
+                  response.text().then((text) => ({ status: response.status, text })),
+                );
+              }),
+            );
+          // The signed request the pool makes for every membership read: its gate's refresh and its
+          // once-a-minute read. Back a second, so a server clock slightly behind still accepts it.
+          const membershipRead = (traceparent?: string) =>
+            Effect.gen(function* () {
+              const at = (yield* Clock.currentTimeMillis) - 1_000;
+              const payload = Buffer.from(
+                JSON.stringify({ pool: pool.id, organization, at, expiresAt: at + 30_000 }),
+              ).toString("base64url");
+              const signature = createHmac("sha256", Buffer.from(poolFixtureSigningKey, "hex"))
+                .update(`sbq1.${payload}`)
+                .digest("base64url");
+              const response = yield* api.request(
+                actors.owner,
+                "POST",
+                "/api/internal/pool-membership",
+                { envelope: `sbq1.${payload}.${signature}` },
+                traceparent === undefined ? {} : { traceparent },
+              );
+              return response.status;
+            });
+          // The read's own statements, by the trace its request carries: the pool's own reads and
+          // other requests that take the same lock in the same moments never count.
+          const counted = Effect.gen(function* () {
+            const trace = randomUUID().replaceAll("-", "");
+            yield* wire.begin(0);
+            const status = yield* membershipRead(`00-${trace}-${trace.slice(0, 16)}-01`);
+            yield* wire.end(trace);
+            const statements = wire.global().filter((item) => item.trace === trace);
+            const lock = statements.find((item) => sharedLock.test(item.query));
+            const rows = statements.find((item) => membershipRows.test(item.query));
+            return {
+              status,
+              exclusive: statements.filter((item) => exclusiveLock.test(item.query)).length,
+              shared: statements.filter((item) => sharedLock.test(item.query)).length,
+              membership: statements.filter((item) => membershipRows.test(item.query)).length,
+              // The read's row locks run in the shared lock's transaction: same session, after it.
+              lockedRead:
+                lock !== undefined &&
+                rows !== undefined &&
+                lock.connection === rows.connection &&
+                lock.start <= rows.start,
+            };
+          });
+          const locks = yield* cloudLocks;
+          const registration = locks
+            .run({
+              sql: `select entry.value ->> 'membership' as membership from organization o
+                cross join lateral jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) entry
+                where o.id = $1 and entry.value ->> 'app' = $2`,
+              params: [organization, pool.id],
+            })
+            .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Registration)));
+
+          // Each check is soft, so one failing run shows every check a broken read breaks.
+          // 1. A legacy registration is handed off under the exclusive lock, as before: that is a
+          //    write. A native registration's read takes no exclusive lock, only the shared one.
+          //    The only historical state: an existing registration predating the membership marker.
+          //    The pool's own once-a-minute read could hand it off first, between the update and
+          //    the test's read; and a native read that still has accounts to mirror takes the lock
+          //    exclusively for that write. Both are rare here and fail loudly.
+          yield* locks.run({
+            sql: `update organization set metadata=(select jsonb_set(metadata::jsonb, '{basaltPools}', jsonb_object_agg(entry.key, case when entry.value->>'app'=$2 then entry.value-'membership' else entry.value end))::text from jsonb_each(metadata::jsonb->'basaltPools') entry) where id=$1`,
+            params: [organization, pool.id],
+          });
+          const before = yield* registration;
+          expect(before).toEqual([{ membership: null }]);
+          const legacy = yield* counted;
+          const handedOff = yield* registration;
+          const native = yield* counted;
+          yield* evidence.json("membership-locks.json", { before, legacy, handedOff, native });
+          expect.soft(legacy.status, "the legacy read answers").toBe(200);
+          expect
+            .soft(legacy.exclusive, "the legacy handoff takes the lock exclusively")
+            .toBeGreaterThan(0);
+          expect
+            .soft(handedOff, "the legacy registration is handed off")
+            .toEqual([{ membership: "executor-links-v1" }]);
+          expect.soft(native.status, "the native read answers").toBe(200);
+          expect.soft(native.membership, "the native read ran").toBeGreaterThan(0);
+          expect.soft(native.exclusive, "the native read takes no exclusive lock").toBe(0);
+          expect.soft(native.shared, "the native read takes the lock shared").toBeGreaterThan(0);
+          expect
+            .soft(native.lockedRead, "the native read's rows are read under the shared lock")
+            .toBe(true);
+
+          // 2. A usage read in flight holds the shared lock through its pool's answer. A membership
+          //    read must not wait for it.
+          const reader = yield* cloudLocks;
+          yield* reader.hold({
+            sql: "select pg_backend_pid() as pid, pg_advisory_xact_lock_shared(hashtextextended($1, 0))",
+            params: [`executor-access:${organization}`],
+          });
+          const started = yield* Clock.currentTimeMillis;
+          const beside = yield* membershipRead().pipe(Effect.timeoutOption(readCap + 2_000));
+          const besideMs = (yield* Clock.currentTimeMillis) - started;
+          yield* reader.release;
+          yield* evidence.json("read-beside-a-reader.json", {
+            status: beside._tag === "Some" ? beside.value : "waiting",
+            ms: besideMs,
+          });
+          expect.soft(beside._tag === "Some" ? beside.value : "waiting").toBe(200);
+          expect.soft(besideMs, "the read does not wait for a shared holder").toBeLessThan(readCap);
+
+          // 3. The pool view still names each Home account's saved account from that membership.
+          const shown = yield* view();
+          yield* evidence.json("pool-view.json", {
+            status: shown.status,
+            annotated: (shown.text.match(/"nativeAccountId":"[^"]+"/g) ?? []).length,
+          });
+          expect
+            .soft(shown.text, "the pool view names a saved account")
+            .toMatch(/"nativeAccountId":"[^"]+"/);
+        }),
+      ),
+    );
+  },
+);
