+/**
+ * The signed read under the shared organization lock: a page's pool view and the pool's own
+ * membership refresh no longer wait for usage reads in flight or for each other, while writers
+ * (policy and role changes, handoffs) still wait for it. A legacy registration, whose handoff
+ * writes, refuses the shared read, and the read runs again under the exclusive lock.
+ */
+const sharedNativePoolMembership = (organization: string, pool: AppId, executor: Executor) =>
+  withOrganizationReadLock(
+    organization,
+    membershipRows(organization, pool, executor, readRegisteredNativePool(organization, pool)),
+  ).pipe(
+    // As in nativePoolMembership: the tracked transaction is the outer one; the SDK refuses one
+    // opened inside a raw SQL transaction.
+    executor[StorageHost].transaction,
+    // Outside the tracked transaction, so the shared one has ended before the exclusive read.
+    Effect.catch((error) =>
+      Schema.is(PoolMembershipReconcileRequired)(error)
+        ? nativePoolMembership(organization, pool, executor)
+        : Effect.fail(new StorageError()),
+    ),
+  );
