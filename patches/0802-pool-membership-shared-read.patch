diff --git a/e2e/tests/pool-membership-shared-read.spec.ts b/e2e/tests/pool-membership-shared-read.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/pool-membership-shared-read.spec.ts
@@ -0,0 +1,339 @@
+import { expect, layer } from "@effect/vitest";
+import { Clock, Effect, Fiber, Schedule, Schema } from "effect";
+import { createHmac, randomUUID } from "node:crypto";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { cloudLocks } from "../support/cloud-locks.ts";
+import { poolFixtureSigningKey } from "../support/cloud-pool-gateway.ts";
+import { Evidence } from "../support/evidence.ts";
+import { legacyPoolHome } from "../support/legacy-pool-home.ts";
+import {
+  installLegacyPoolHandoffSetup,
+  legacyPoolHandoffFixture,
+} from "../support/legacy-pool-handoff-setup.ts";
+import { Target } from "../support/platform.ts";
+import { poolHistoryDatabase } from "../support/pool-history-database.ts";
+import { poolWorkerRuntime } from "../support/pool-worker-runtime.ts";
+import { openPrivateApp, waitForAppUrl } from "../support/app-pages.ts";
+import { sqlWireProof } from "../support/sql-wire-proof.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Count = Schema.Array(Schema.Struct({ n: Schema.Number }));
+const Registration = Schema.Array(Schema.Struct({ membership: Schema.NullOr(Schema.String) }));
+const Members = Schema.Struct({
+  members: Schema.Array(Schema.Struct({ id: Schema.String, userId: Schema.String })),
+});
+const Viewer = Schema.Struct({ userId: Schema.String });
+class Waiting extends Schema.TaggedError<Waiting>()("Waiting", {}) {}
+
+/**
+ * An exclusive or shared advisory lock on a text key. The wire log carries no parameters, so these
+ * also match other text-keyed locks (catalog, pool defaults, installs, default policies, the app
+ * registry); counted only on the membership read's own traces, they are its organization lock.
+ */
+const exclusiveLock = /^\s*select pg_advisory_xact_lock\(hashtextextended/i;
+const sharedLock = /^\s*select pg_advisory_xact_lock_shared\(hashtextextended/i;
+/** The membership read's first row lock: its presence proves the read itself ran. */
+const membershipRows = /from hosted_app_account_links l[\s\S]*for share of a/i;
+/** The membership read's registration check, which the shared and the exclusive read both run. */
+const registrations = /select current_database\(\) as database,\s*current_schema\(\) as schema/i;
+/** Below the pool's membership read timeout (10 s), which a view would otherwise wait out. */
+const viewCap = 6_000;
+/** How long part 3 polls for each lock state: a held lock is visible in milliseconds. */
+const lockStateCap = 6_000;
+
+layer(HostedLive, { excludeTestServices: true })(
+  "Pool membership reads share the organization lock",
+  (it) => {
+    installLegacyPoolHandoffSetup({ nativeSources: true });
+    it.effect(scenarios.poolMembershipSharedRead.title, (context) =>
+      withHostedCase(
+        context,
+        Effect.gen(function* () {
+          const api = yield* Api,
+            actors = yield* Actors,
+            target = yield* Target,
+            browser = yield* Browser,
+            evidence = yield* Evidence;
+          const wire = yield* sqlWireProof;
+          const { pool, accounts } = legacyPoolHandoffFixture(context);
+          const home = yield* legacyPoolHome(
+            pool.id,
+            ["codex", "claude", "claude", "claude", "xai"].map((provider, index) => ({
+              id: `synthetic-cloud-native-reference-${index + 1}`,
+              provider,
+            })),
+          );
+          const history = yield* poolHistoryDatabase;
+          const worker = yield* poolWorkerRuntime(
+            target.metadata.origin,
+            home.origin,
+            history.connection,
+          );
+          const peer = (origin: string | null) =>
+            api.request(actors.owner, "POST", "/native-provider-fixture/product-peer", {
+              pool: pool.id,
+              origin,
+            });
+          expect((yield* peer(worker.origin)).status).toBe(200);
+          yield* Effect.addFinalizer(() => peer(null).pipe(Effect.asVoid, Effect.orDie));
+          expect((yield* worker.operations("/model-history/schema/catalog")).status).toBe(200);
+          yield* history.applySchema;
+
+          const organization = actors.organization.id;
+          const path = `/api/organizations/${organization}/apps/${pool.id}`;
+          expect(accounts.length).toBeGreaterThan(1);
+          yield* browser.login(actors.owner);
+          yield* browser.use("Keep reads explicit", (page) =>
+            page.route("**/*.js", (route) => route.abort()),
+          );
+          yield* openPrivateApp(yield* waitForAppUrl(actors.owner, `${path}/ui`));
+
+          // The overview's fresh pool view: the pool reads its membership from the host.
+          const view = (traceparent?: string) =>
+            browser.use("Pool view", (page) =>
+              page.evaluate(
+                ({ traceparent }) => {
+                  const context = JSON.parse(
+                    document.getElementById("executor-context")?.textContent ?? "{}",
+                  );
+                  return fetch("/_executor/api/query", {
+                    method: "POST",
+                    credentials: "same-origin",
+                    headers: {
+                      "content-type": "application/json",
+                      ...(traceparent === undefined ? {} : { traceparent }),
+                    },
+                    body: JSON.stringify({
+                      name: "view",
+                      input: { fresh: true },
+                      version: context.version ?? context.deployment,
+                    }),
+                  }).then((response) => response.text().then(() => response.status));
+                },
+                { traceparent },
+              ),
+            );
+          const counted = Effect.gen(function* () {
+            const trace = randomUUID().replaceAll("-", "");
+            yield* wire.begin(0);
+            const status = yield* view(`00-${trace}-${trace.slice(0, 16)}-01`);
+            yield* wire.end(trace);
+            // The pool reads membership in a request of its own, under a trace of its own: count
+            // the view's trace and every trace in its window that ran a membership read, so other
+            // sessions' locks in the same run never count.
+            const window = wire.global();
+            const traces = new Set<string>([trace]);
+            for (const item of window)
+              if (
+                item.trace !== undefined &&
+                (membershipRows.test(item.query) || registrations.test(item.query))
+              )
+                traces.add(item.trace);
+            const statements = window.filter(
+              (item) => item.trace !== undefined && traces.has(item.trace),
+            );
+            return {
+              status,
+              exclusive: statements.filter((item) => exclusiveLock.test(item.query)).length,
+              shared: statements.filter((item) => sharedLock.test(item.query)).length,
+              membership: statements.filter((item) => membershipRows.test(item.query)).length,
+            };
+          });
+          const locks = yield* cloudLocks;
+          const registration = locks
+            .run({
+              sql: `select entry.value ->> 'membership' as membership from organization o
+                cross join lateral jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) entry
+                where o.id = $1 and entry.value ->> 'app' = $2`,
+              params: [organization, pool.id],
+            })
+            .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Registration)));
+
+          // 1. A legacy registration is handed off under the exclusive lock, as before: that is a
+          //    write. A native registration's read takes no exclusive lock at all. The only
+          //    historical state: an existing registration predating the membership marker.
+          yield* locks.run({
+            sql: `update organization set metadata=(select jsonb_set(metadata::jsonb, '{basaltPools}', jsonb_object_agg(entry.key, case when entry.value->>'app'=$2 then entry.value-'membership' else entry.value end))::text from jsonb_each(metadata::jsonb->'basaltPools') entry) where id=$1`,
+            params: [organization, pool.id],
+          });
+          const before = yield* registration;
+          expect(before).toEqual([{ membership: null }]);
+          const first = yield* counted;
+          expect(first.status).toBe(200);
+          expect(first.exclusive, "a legacy registration's handoff").toBeGreaterThan(0);
+          expect(yield* registration).toEqual([{ membership: "executor-links-v1" }]);
+          const native = yield* counted;
+          yield* evidence.json("membership-locks.json", { before, first, native });
+          expect(native).toMatchObject({ status: 200, exclusive: 0 });
+          expect(native.shared).toBeGreaterThan(0);
+          expect(native.membership, "the membership read ran").toBeGreaterThan(0);
+
+          // 2. A usage read in flight holds the shared lock through its pool's answer. The pool view
+          //    must not wait for it.
+          const reader = yield* cloudLocks;
+          yield* reader.hold({
+            sql: "select pg_backend_pid() as pid, pg_advisory_xact_lock_shared(hashtextextended($1, 0))",
+            params: [`executor-access:${organization}`],
+          });
+          const started = yield* Clock.currentTimeMillis;
+          const beside = yield* view().pipe(Effect.timeoutOption(viewCap + 2_000));
+          const besideMs = (yield* Clock.currentTimeMillis) - started;
+          yield* reader.release;
+          yield* evidence.json("view-beside-a-reader.json", {
+            status: beside._tag === "Some" ? beside.value : "waiting",
+            ms: besideMs,
+          });
+          expect(beside._tag === "Some" ? beside.value : "waiting").toBe(200);
+          expect(besideMs).toBeLessThan(viewCap);
+
+          // 3. A role change, which takes the lock exclusively, still waits for a membership read
+          //    in flight. The test issues the pool's signed read itself, so the read starts when the
+          //    test says, and parks it at its first FOR SHARE row lock, after it took the shared
+          //    lock, by holding this pool's linked accounts FOR UPDATE: only this scenario's rows,
+          //    which the role change never touches.
+          const admin = yield* body(Viewer, yield* api.request(actors.admin, "GET", "/api/viewer"));
+          const directory = yield* body(
+            Members,
+            yield* api.request(
+              actors.owner,
+              "GET",
+              `/api/auth/organization/list-members?organizationId=${organization}`,
+            ),
+          );
+          const member = directory.members.find((entry) => entry.userId === admin.userId);
+          expect(member).toBeDefined();
+          const role = (next: "member" | "admin") =>
+            api.request(actors.owner, "POST", "/api/auth/organization/update-member-role", {
+              organizationId: organization,
+              memberId: member!.id,
+              role: next,
+            });
+          yield* Effect.addFinalizer(() => role("admin").pipe(Effect.asVoid, Effect.orDie));
+          // The request the pool makes for every view and every membership refresh.
+          const membershipRead = Effect.gen(function* () {
+            // A second back, so a server clock slightly behind the test's still accepts it.
+            const at = (yield* Clock.currentTimeMillis) - 1_000;
+            const payload = Buffer.from(
+              JSON.stringify({ pool: pool.id, organization, at, expiresAt: at + 30_000 }),
+            ).toString("base64url");
+            const signature = createHmac("sha256", Buffer.from(poolFixtureSigningKey, "hex"))
+              .update(`sbq1.${payload}`)
+              .digest("base64url");
+            const response = yield* api.request(
+              actors.owner,
+              "POST",
+              "/api/internal/pool-membership",
+              { envelope: `sbq1.${payload}.${signature}` },
+            );
+            return response.status;
+          });
+          const count = (rows: unknown) => Schema.decodeUnknownSync(Count)(rows)[0]!.n;
+          /** Polls until `ready`, for at most the lock-state cap; `false` when the cap ran out. */
+          const within = <A, E, R>(probe: Effect.Effect<A, E, R>, ready: (value: A) => boolean) =>
+            probe.pipe(
+              Effect.filterOrFail(ready, () => new Waiting()),
+              Effect.retry({ while: Schema.is(Waiting), schedule: Schedule.spaced("50 millis") }),
+              Effect.as(true),
+              Effect.timeoutOption(lockStateCap),
+              Effect.map((done) => done._tag === "Some"),
+            );
+          const organizationLock = `executor-access:${organization}`;
+          // Sessions waiting on a lock at the membership read's accounts row-lock statement, and
+          // those of them that hold this organization's lock shared.
+          const parked = (holdingShared: boolean) =>
+            locks.run({
+              sql: `select count(*)::int as n from pg_stat_activity a
+                where a.wait_event_type = 'Lock' and a.query ~* 'for share of a'
+                  and (not $2 or exists (select 1 from pg_locks l,
+                    (select hashtextextended($1, 0) as k) key
+                    where l.pid = a.pid and l.locktype = 'advisory' and l.granted
+                      and l.mode = 'ShareLock' and l.objsubid = 1
+                      and l.classid::bigint = (key.k >> 32) & 4294967295
+                      and l.objid::bigint = key.k & 4294967295))`,
+              params: [organizationLock, holdingShared],
+            });
+          // Sessions waiting for this organization's lock exclusively: the role change, once it asked.
+          const waitingForOrganization = locks.run({
+            sql: `select count(*)::int as n from pg_locks l,
+              (select hashtextextended($1, 0) as k) key
+              where l.locktype = 'advisory' and not l.granted and l.mode = 'ExclusiveLock'
+                and l.objsubid = 1
+                and l.classid::bigint = (key.k >> 32) & 4294967295
+                and l.objid::bigint = key.k & 4294967295`,
+            params: [organizationLock],
+          });
+          // What every waiting session waits on, so a red run names the statement.
+          const sessions = locks.run({
+            sql: `select a.pid, pg_blocking_pids(a.pid) as blockers, a.state, a.wait_event_type,
+                a.wait_event,
+                left(regexp_replace(a.query, '[[:space:]]+', ' ', 'g'), 300) as query
+              from pg_stat_activity a
+              where a.pid <> pg_backend_pid() and a.wait_event_type is not null
+                and a.state <> 'idle'`,
+          });
+          const finished = <A, E, R>(effect: Effect.Effect<A, E, R>) =>
+            Effect.zip(effect, Clock.currentTimeMillis);
+          const rows = yield* cloudLocks;
+          yield* rows.hold({
+            sql: `select a.id from hosted_app_account_links l
+              join executor_apps app on app.id = l.app
+              join executor_accounts a on a.id = l.account and a.owner = app.owner
+              where l.app = $1 and l.subject is null for update of a`,
+            params: [pool.id],
+          });
+          const inFlight = yield* Effect.forkChild(finished(membershipRead));
+          const readParked = yield* within(parked(false), (value) => count(value) > 0);
+          if (!readParked)
+            yield* evidence.json("waiting-sessions.json", {
+              step: "parked",
+              read: inFlight.pollUnsafe() ?? "in flight",
+              sessions: yield* sessions,
+            });
+          expect(readParked, "the membership read parks at its accounts row lock").toBe(true);
+          // A parked read holding the shared lock; it waits out the cap only when none does.
+          const holdsShared = yield* within(parked(true), (value) => count(value) > 0);
+          // Another request's exclusive wait on this organization must not pass for the role change's.
+          const waitingBefore = count(yield* waitingForOrganization);
+          const demotion = yield* Effect.forkChild(finished(role("member")));
+          // Either the role change asks for the organization lock and waits, or it finishes: with
+          // no lock held by the read it would pass straight through.
+          const waited = yield* within(
+            Effect.zip(
+              waitingForOrganization,
+              Effect.sync(() => demotion.pollUnsafe()),
+            ),
+            ([waiting, done]) => count(waiting) > waitingBefore || done !== undefined,
+          );
+          const demotionWaiting =
+            waited &&
+            demotion.pollUnsafe() === undefined &&
+            count(yield* waitingForOrganization) > waitingBefore;
+          const waitingOn = demotionWaiting ? [] : yield* sessions;
+          yield* rows.release;
+          const [answered, readAt] = yield* Fiber.join(inFlight);
+          const [demoted, demotedAt] = yield* Fiber.join(demotion);
+          // Evidence only: the read releases its lock before its answer travels back, so the two
+          // finish times are not strictly ordered.
+          yield* evidence.json("writer-waits-for-membership-read.json", {
+            holdsShared,
+            demotionWaiting,
+            waitingOn,
+            read: answered,
+            demotion: demoted.status,
+            readAt,
+            demotedAt,
+          });
+          expect(demotionWaiting, "the role change waits for the membership read in flight").toBe(
+            true,
+          );
+          expect(holdsShared, "the parked read holds the organization lock shared").toBe(true);
+          expect(answered).toBe(200);
+          expect(demoted.status).toBe(200);
+        }),
+      ),
+    );
+  },
+);
