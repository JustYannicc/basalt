diff --git a/e2e/support/released-retirement-proof.ts b/e2e/support/released-retirement-proof.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/released-retirement-proof.ts
@@ -0,0 +1,246 @@
+import { expect } from "@effect/vitest";
+import { Effect, Fiber, Schema } from "effect";
+import { body } from "./api.ts";
+import { providerAdoptionFixture } from "./provider-adoption-fixture.ts";
+import { productionOpsClient, Response } from "./production-ops-client.ts";
+import { Applied, DryRun } from "./production-ops-migration-proof.ts";
+
+const Row = Schema.Record(Schema.String, Schema.Json);
+const Snapshot = Schema.Array(
+  Schema.Struct({
+    accounts: Schema.Array(Row),
+    access: Schema.Array(Row),
+    sources: Schema.Array(Row),
+    links: Schema.Array(Row),
+    connections: Schema.Array(Row),
+    acquisitions: Schema.NullOr(Schema.Array(Row)),
+  }),
+);
+const Proof = Schema.Struct({
+  result: Schema.Struct({
+    code: Schema.Literal("released_retirement_verified"),
+    snapshotSha256: Schema.String,
+    homeReferenceSurvives: Schema.Literal(true),
+    credentialReferenceMatches: Schema.Literal(true),
+  }),
+});
+const Plan = Schema.Struct({
+  plan: Schema.Struct({
+    changes: Schema.Array(
+      Schema.Struct({
+        table: Schema.String,
+        key: Schema.Record(Schema.String, Schema.NullOr(Schema.String)),
+        action: Schema.String,
+      }),
+    ),
+  }),
+});
+
+const fixture = Effect.gen(function* () {
+  const p = yield* providerAdoptionFixture,
+    client = yield* productionOpsClient;
+  const account = p.request.accounts.find((item) => item.method === "codex")!;
+  const rows = yield* p.database
+    .run({
+      sql: `select id, state -> 'interactive' ->> 'version' as version,
+      encode(sha256(convert_to(state -> 'interactive' ->> 'ref', 'UTF8')), 'hex') as "referenceSha256"
+      from executor_account_connections where state -> 'account' ->> 'id' = $1`,
+      params: [account.account],
+    })
+    .pipe(
+      Effect.flatMap(
+        Schema.decodeUnknownEffect(
+          Schema.Array(
+            Schema.Struct({
+              id: Schema.String,
+              version: Schema.String,
+              referenceSha256: Schema.String,
+            }),
+          ),
+        ),
+      ),
+    );
+  expect(rows).toHaveLength(1);
+  const connection = rows[0]!;
+  const marker = (value: Schema.Json) =>
+    p.database.run({
+      sql: "update executor_account_connections set state = jsonb_set(state::jsonb, '{interactive,retirement}', $2::jsonb)::json where id = $1",
+      params: [connection.id, JSON.stringify(value)],
+    });
+  yield* marker({ removed: false });
+  const selection = {
+    organization: p.request.organization,
+    actor: p.request.actor,
+    account: account.account,
+    connection: connection.id,
+    provider: account.provider,
+    method: account.method,
+    generation: account.generation,
+    app: p.pool,
+    version: connection.version,
+    referenceSha256: connection.referenceSha256,
+  };
+  const prepared = yield* client.request({
+    action: "prepare",
+    selection: "released-interactive-retirement-proof-v1",
+    recipient: client.recipient,
+    request: selection,
+  });
+  expect(prepared.status, JSON.stringify(prepared.body)).toBe(200);
+  const encrypted = yield* body(Response, prepared);
+  const proof = yield* Schema.decodeUnknownEffect(Proof)(client.decrypt(encrypted.artifact));
+  const operation = {
+    action: "dry-run",
+    selection: "released-interactive-retirement-v1",
+    recipient: client.recipient,
+    request: { ...selection, snapshotSha256: proof.result.snapshotSha256 },
+  };
+  const snapshot = p.snapshot.pipe(
+    Effect.flatMap(Schema.decodeUnknownEffect(Snapshot)),
+    Effect.map((rows) => rows[0]!),
+  );
+  const dryRun = Effect.gen(function* () {
+    const response = yield* client.request(operation);
+    expect(response.status, JSON.stringify(response.body)).toBe(200);
+    return yield* body(DryRun, response);
+  });
+  const apply = (dry: typeof DryRun.Type) => ({
+    ...operation,
+    action: "apply",
+    artifact: dry.artifact,
+    planSha256: dry.artifact.sha256,
+    backupSha256: dry.backupSha256,
+    go: `GO ${dry.artifact.sha256}`,
+  });
+  const backend = (mode: string) =>
+    p.api.request(p.actors.owner, "POST", "/native-provider-fixture/retirement-reference", {
+      mode,
+    });
+  yield* Effect.addFinalizer(() => backend("present").pipe(Effect.asVoid, Effect.orDie));
+  return { ...p, client, selection, operation, snapshot, marker, dryRun, apply, backend };
+});
+
+export const releasedRetirementPreservationProof = Effect.gen(function* () {
+  const p = yield* fixture;
+  const before = yield* p.snapshot;
+  expect([401, 409]).toContain(
+    (yield* p.client.request(p.operation, { secret: "cd".repeat(32) })).status,
+  );
+  for (const changed of [
+    { account: "missing-account" },
+    { connection: "missing-connection" },
+    { actor: "missing-actor" },
+    { provider: "missing-provider" },
+    { app: p.second },
+    { version: "missing-version" },
+    { generation: p.selection.generation + 1 },
+    { referenceSha256: "0".repeat(64) },
+  ]) {
+    expect(
+      (yield* p.client.request({
+        ...p.operation,
+        request: { ...p.operation.request, ...changed },
+      })).status,
+    ).toBe(409);
+  }
+  for (const marker of [
+    { removed: true },
+    { removed: false, token: "synthetic-active-lease", expiresAt: Date.now() + 60_000 },
+    { removed: false, token: "synthetic-expired-lease", expiresAt: 1 },
+  ]) {
+    yield* p.marker(marker);
+    expect((yield* p.client.request(p.operation)).status).toBe(409);
+  }
+  yield* p.marker({ removed: false });
+  yield* p.database.run({
+    sql: "update executor_account_connections set state = (state::jsonb #- '{interactive,retirement}')::json where id = $1",
+    params: [p.selection.connection],
+  });
+  expect((yield* p.client.request(p.operation)).status).toBe(409);
+  yield* p.marker({ removed: false });
+  const duplicate = `${p.selection.connection}-ambiguous`;
+  yield* p.database.run({
+    sql: "insert into executor_account_connections select (jsonb_populate_record(null::executor_account_connections, to_jsonb(c) || jsonb_build_object('id', $2::text))).* from executor_account_connections c where id = $1",
+    params: [p.selection.connection, duplicate],
+  });
+  expect((yield* p.client.request(p.operation)).status).toBe(409);
+  yield* p.database.run({
+    sql: "delete from executor_account_connections where id = $1",
+    params: [duplicate],
+  });
+  for (const mode of ["missing", "mismatched"]) {
+    yield* p.backend(mode);
+    expect((yield* p.client.request(p.operation)).status).toBe(409);
+  }
+  yield* p.backend("present");
+  const dry = yield* p.dryRun;
+  const plan = yield* Schema.decodeUnknownEffect(Plan)(p.client.decrypt(dry.artifact));
+  expect(plan.plan.changes).toEqual([
+    {
+      table: "executor_account_connections",
+      key: { id: p.selection.connection },
+      action: "update",
+    },
+  ]);
+  expect(yield* p.snapshot).toEqual(before);
+  const apply = p.apply(dry);
+  expect((yield* p.client.request({ ...apply, go: "GO invalid" })).status).toBe(409);
+  yield* p.backend("missing");
+  expect((yield* p.client.request(apply)).status).toBe(409);
+  expect(yield* p.snapshot).toEqual(before);
+  yield* p.backend("present");
+  const applied = yield* p.client.request(apply);
+  expect(applied.status, JSON.stringify(applied.body)).toBe(200);
+  expect((yield* body(Applied, applied)).verification.ok).toBe(true);
+  const connections = before.connections.map((row) => {
+    if (row.id !== p.selection.connection) return row;
+    const state = Schema.decodeUnknownSync(Row)(row.state);
+    const interactive = Schema.decodeUnknownSync(Row)(state.interactive);
+    const { retirement: _retirement, ...retained } = interactive;
+    return { ...row, state: { ...state, interactive: retained } };
+  });
+  expect(yield* p.snapshot).toEqual({ ...before, connections });
+  // Receipt replay verifies committed state without requiring or repeating an external operation.
+  yield* p.backend("missing");
+  const replay = yield* p.client.request(apply);
+  expect(replay.status, JSON.stringify(replay.body)).toBe(200);
+  expect((yield* body(Applied, replay)).repeated).toBe(true);
+  expect(yield* p.snapshot).toEqual({ ...before, connections });
+});
+
+export const releasedRetirementRaceProof = Effect.gen(function* () {
+  const p = yield* fixture;
+  const before = yield* p.snapshot,
+    dry = yield* p.dryRun;
+  const account = before.accounts.find((row) => row.id === p.selection.account)!;
+  yield* p.backend("hold");
+  const apply = yield* p.client.request(p.apply(dry)).pipe(Effect.forkScoped);
+  const entered = yield* p.api.request(
+    p.actors.owner,
+    "GET",
+    "/native-provider-fixture/retirement-reference/wait",
+  );
+  expect(entered.status).toBe(200);
+  yield* p.database.run({
+    sql: "update executor_accounts set label = $2 where id = $1",
+    params: [p.selection.account, "Changed during Home read"],
+  });
+  yield* p.backend("release");
+  const refused = yield* Fiber.join(apply);
+  expect(refused.status).toBe(409);
+  expect((yield* p.snapshot).connections).toEqual(before.connections);
+  yield* p.database.run({
+    sql: "update executor_accounts set label = $2 where id = $1",
+    params: [p.selection.account, String(account.label)],
+  });
+  yield* p.backend("present");
+  yield* p.database.hold({
+    sql: "select id from executor_account_connections where id = $1 for update",
+    params: [p.selection.connection],
+  });
+  const busy = yield* p.client.request(p.apply(dry));
+  expect(busy.status).toBe(409);
+  expect(busy.body).toMatchObject({ error: "operation_busy", retryable: true });
+  yield* p.database.release;
+  expect(yield* p.snapshot).toEqual(before);
+});
