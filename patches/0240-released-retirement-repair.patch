@@ -0,0 +1,192 @@
+import { Effect, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import { ProductionOperationRefused } from "../contracts.ts";
+import { canonical, sha256 } from "../crypto.ts";
+import { record, type Row } from "./provider-apps-schema.ts";
+
+const Digest = Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/u));
+export const RetirementSelection = Schema.Struct({
+  organization: Schema.NonEmptyString,
+  actor: Schema.NonEmptyString,
+  account: Schema.NonEmptyString,
+  connection: Schema.NonEmptyString,
+  provider: Schema.NonEmptyString,
+  method: Schema.Literals(["codex", "claude"]),
+  generation: Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)),
+  app: Schema.NonEmptyString,
+  version: Schema.NonEmptyString,
+  referenceSha256: Digest,
+});
+export const RetirementRequest = Schema.Struct({
+  ...RetirementSelection.fields,
+  snapshotSha256: Digest,
+});
+export type RetirementSelection = typeof RetirementSelection.Type;
+
+export const retirementRefused = (code: string) =>
+  Effect.fail(new ProductionOperationRefused({ message: `Released retirement refused: ${code}` }));
+export const retirementHash = (value: unknown) => sha256(canonical(value));
+const Rows = Schema.Array(Schema.Struct({ row: Schema.Record(Schema.String, Schema.Json) }));
+const decode = <E, R>(effect: Effect.Effect<readonly unknown[], E, R>) =>
+  effect.pipe(
+    Effect.flatMap(Schema.decodeUnknownEffect(Rows)),
+    Effect.map((rows) => rows.map(({ row }) => row)),
+  );
+const exact = (rows: readonly Row[]) =>
+  rows.length === 1 && rows[0] !== undefined
+    ? Effect.succeed(rows[0])
+    : retirementRefused("missing_or_ambiguous_row");
+
+/** All fingerprints include complete private rows; only their hashes leave encrypted artifacts. */
+export const readReleasedRetirement = (input: RetirementSelection, repaired = false) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const owner = `organization:${input.organization}`;
+    const account = yield* exact(
+      yield* decode(
+        sql`select to_jsonb(a) as row from executor_accounts a where id = ${input.account}`,
+      ),
+    );
+    const member = yield* exact(
+      yield* decode(
+        sql`select to_jsonb(m) as row from member m where "organizationId" = ${input.organization} and "userId" = ${input.actor}`,
+      ),
+    );
+    const access = yield* exact(
+      yield* decode(
+        sql`select to_jsonb(p) as row from hosted_account_access p where account_id = ${input.account}`,
+      ),
+    );
+    const connections = yield* decode(
+      sql`select to_jsonb(c) as row from executor_account_connections c
+      where id = ${input.connection} or state -> 'account' ->> 'id' = ${input.account}
+        or reconnect_account = ${input.account} or source_account = ${input.account} order by id`,
+    );
+    const connection = yield* exact(connections);
+    const links = yield* decode(
+      sql`select to_jsonb(l) as row from hosted_app_account_links l where account = ${input.account}
+      order by app, requirement, subject nulls first`,
+    );
+    const acquisitions = yield* decode(
+      sql`select to_jsonb(r) as row from executor_account_acquisitions r where account = ${input.account}`,
+    );
+    const groups = yield* decode(
+      sql`select to_jsonb(g) as row from hosted_account_groups g where account_id = ${input.account} order by group_id`,
+    );
+    const app = yield* exact(
+      yield* decode(sql`select to_jsonb(a) as row from executor_apps a where id = ${input.app}`),
+    );
+    const deployment = yield* exact(
+      yield* decode(
+        sql`select to_jsonb(d) as row from executor_deployments d where id = ${input.version}`,
+      ),
+    );
+    const provider = yield* exact(
+      yield* decode(
+        sql`select to_jsonb(p) as row from executor_providers p where id = ${input.provider}`,
+      ),
+    );
+    if (
+      (member.role !== "owner" && member.role !== "admin") ||
+      account.owner !== owner ||
+      account.provider !== input.provider ||
+      account.method !== input.method ||
+      account.credential_generation !== input.generation ||
+      account.oauth_grant_id !== null ||
+      account.site !== null ||
+      account.identity_id !== null ||
+      access.organization_id !== input.organization ||
+      access.kind !== "personal" ||
+      access.personal_user_id !== input.actor ||
+      groups.length !== 0 ||
+      acquisitions.length !== 0
+    )
+      return yield* retirementRefused("account_binding_changed");
+    const state = record(connection.state),
+      binding = record(state?.interactive);
+    const saved = record(state?.account),
+      target = record(connection.target);
+    const requirement = record(record(record(deployment.requirements)?.accounts)?.subscriptions);
+    if (
+      connection.id !== input.connection ||
+      connection.owner !== owner ||
+      connection.provider !== input.provider ||
+      connection.oauth_attempt !== null ||
+      (connection.reconnect_account !== null && connection.reconnect_account !== input.account) ||
+      (connection.source_account !== null && connection.source_account !== input.account) ||
+      !Array.isArray(connection.additional_targets) ||
+      connection.additional_targets.length !== 0 ||
+      state?.status !== "completed" ||
+      state.providerAppAdoption !== undefined ||
+      saved?.id !== input.account ||
+      saved.owner !== owner ||
+      saved.provider !== input.provider ||
+      saved.method !== input.method ||
+      binding?.method !== input.method ||
+      binding.app !== input.app ||
+      binding.slot !== "subscriptions" ||
+      binding.version !== input.version ||
+      typeof binding.ref !== "string" ||
+      binding.ref.length === 0 ||
+      binding.ref.length > 256 ||
+      sha256(binding.ref) !== input.referenceSha256 ||
+      target?.app !== input.app ||
+      target.requirement !== "subscriptions" ||
+      app.owner !== owner ||
+      deployment.owner !== owner ||
+      requirement?.provider !== input.provider ||
+      record(record(record(requirement.definition)?.auth)?.[input.method])?.type !==
+        "interactive" ||
+      links.length !== 1 ||
+      links[0]?.app !== input.app ||
+      links[0]?.requirement !== "subscriptions" ||
+      links[0]?.subject !== null
+    )
+      return yield* retirementRefused("provenance_binding_changed");
+    if (
+      repaired
+        ? binding.retirement !== undefined
+        : canonical(binding.retirement) !== '{"removed":false}'
+    )
+      return yield* retirementRefused("retirement_marker_changed");
+    const rows = {
+      account,
+      connection,
+      links,
+      member,
+      access,
+      groups,
+      acquisitions,
+      app,
+      deployment,
+      provider,
+    };
+    return {
+      rows,
+      connection,
+      state,
+      binding,
+      reference: binding.ref,
+      snapshotSha256: retirementHash(rows),
+    };
+  });
+
+/** NOWAIT prevents lock-order cycles with account deletion and concurrent retirement claims. */
+export const lockReleasedRetirement = (input: RetirementSelection) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const owner = `organization:${input.organization}`;
+    yield* sql`select pg_advisory_xact_lock(hashtextextended(${`executor-access:${input.organization}`}, 0))`;
+    yield* sql`select id from organization where id = ${input.organization} for update nowait`;
+    yield* sql`select id from member where "organizationId" = ${input.organization} and "userId" = ${input.actor} for share nowait`;
+    yield* sql`select id from executor_apps where id = ${input.app} and owner = ${owner} for share nowait`;
+    yield* sql`select id from executor_deployments where id = ${input.version} and owner = ${owner} for share nowait`;
+    yield* sql`select id from executor_providers where id = ${input.provider} for share nowait`;
+    yield* sql`select id from executor_accounts where id = ${input.account} and owner = ${owner} for update nowait`;
+    yield* sql`select id from executor_account_connections where owner = ${owner}
+      and (id = ${input.connection} or state -> 'account' ->> 'id' = ${input.account}
+        or reconnect_account = ${input.account} or source_account = ${input.account}) order by id for update nowait`;
+    yield* sql`select account_id from hosted_account_access where account_id = ${input.account} for share nowait`;
+    yield* sql`select app, requirement, subject from hosted_app_account_links where account = ${input.account}
+      order by app, requirement, subject nulls first for share nowait`;
+  });
diff --git a/apps/hosted/cloud/src/infrastructure/production-ops/migrations/released-retirement-v1.ts b/apps/hosted/cloud/src/infrastructure/production-ops/migrations/released-retirement-v1.ts
