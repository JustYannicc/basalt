@@ -0,0 +1,89 @@
+import { Effect, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import type { Json, MigrationPlan, ProductionMigration } from "../contracts.ts";
+import { contention } from "../locking.ts";
+import { record } from "./provider-apps-schema.ts";
+import {
+  RetirementRequest,
+  lockReleasedRetirement,
+  readReleasedRetirement,
+  retirementHash,
+  retirementRefused,
+} from "./released-retirement-records.ts";
+
+const inspect = (request: Json) =>
+  Effect.gen(function* () {
+    const input = yield* Schema.decodeUnknownEffect(RetirementRequest)(request);
+    const before = yield* readReleasedRetirement(input);
+    if (before.snapshotSha256 !== input.snapshotSha256)
+      return yield* retirementRefused("snapshot_changed");
+    const { retirement: _retirement, ...interactive } = before.binding;
+    const connection = { ...before.connection, state: { ...before.state, interactive } };
+    return {
+      changes: [
+        {
+          table: "executor_account_connections",
+          key: { id: input.connection },
+          action: "update" as const,
+          beforeSha256: retirementHash(before.connection),
+          afterSha256: retirementHash(connection),
+        },
+      ],
+      data: {
+        code: "clear_released_retirement_marker",
+        homeReferenceSurvives: true,
+        beforeSnapshotSha256: before.snapshotSha256,
+        afterSnapshotSha256: retirementHash({ ...before.rows, connection }),
+      },
+    };
+  });
+
+const verify = (request: Json, plan: MigrationPlan) =>
+  Effect.gen(function* () {
+    const input = yield* Schema.decodeUnknownEffect(RetirementRequest)(request);
+    const after = yield* readReleasedRetirement(input, true);
+    const checks = {
+      markerAbsent: after.binding.retirement === undefined,
+      allOtherFieldsPreserved: after.snapshotSha256 === record(plan.data)?.afterSnapshotSha256,
+    };
+    return { ok: Object.values(checks).every(Boolean), checks };
+  });
+
+export const releasedRetirementV1: ProductionMigration = {
+  name: "released-interactive-retirement-v1",
+  revision: "1",
+  preflight: "released-interactive-retirement-preflight-v1",
+  tables: [
+    "executor_accounts",
+    "executor_account_connections",
+    "hosted_app_account_links",
+    "executor_account_acquisitions",
+    "hosted_account_access",
+    "hosted_account_groups",
+    "executor_apps",
+    "executor_deployments",
+    "executor_providers",
+    "member",
+  ],
+  inspect,
+  lockAuthority: (request) =>
+    Effect.gen(function* () {
+      const input = yield* Schema.decodeUnknownEffect(RetirementRequest)(request);
+      yield* lockReleasedRetirement(input);
+    }).pipe(Effect.mapError(contention)),
+  apply: (request, plan) =>
+    Effect.gen(function* () {
+      const input = yield* Schema.decodeUnknownEffect(RetirementRequest)(request);
+      const current = yield* inspect(request);
+      if (retirementHash(current) !== retirementHash(plan))
+        return yield* retirementRefused("reviewed_plan_changed");
+      const before = yield* readReleasedRetirement(input);
+      const sql = yield* SqlClient.SqlClient;
+      const updated = yield* sql`update executor_account_connections c
+      set state = (state::jsonb #- '{interactive,retirement}')::json
+      where id = ${input.connection} and to_jsonb(c) = ${JSON.stringify(before.connection)}::jsonb
+      returning id`;
+      if (updated.length !== 1) return yield* retirementRefused("compare_and_swap_failed");
+    }),
+  verify,
+};
