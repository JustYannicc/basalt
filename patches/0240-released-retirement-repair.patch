+import { AccountId, type Credentials } from "@executor-js/sdk/core";
+import { Effect, Redacted, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import type { Json } from "../contracts.ts";
+import {
+  RetirementRequest,
+  RetirementSelection,
+  readReleasedRetirement,
+  retirementRefused,
+} from "./released-retirement-records.ts";
+
+export const releasedRetirementProof = (
+  request: Json,
+  runtime: {
+    readonly credentials: Pick<Credentials, "decrypt">;
+    readonly verifyHome: (
+      reference: string,
+      method: "codex" | "claude",
+    ) => Effect.Effect<boolean, unknown>;
+  },
+  requireSnapshot: boolean,
+) =>
+  Effect.gen(function* () {
+    const input = yield* Schema.decodeUnknownEffect(RetirementSelection)(request);
+    const expected = requireSnapshot
+      ? (yield* Schema.decodeUnknownEffect(RetirementRequest)(request)).snapshotSha256
+      : undefined;
+    const before = yield* readReleasedRetirement(input);
+    if (expected !== undefined && expected !== before.snapshotSha256)
+      return yield* retirementRefused("snapshot_changed");
+    const sql = yield* SqlClient.SqlClient;
+    const encrypted =
+      yield* sql`select encrypted_credentials as credentials from executor_accounts where id = ${input.account}`;
+    const rows = yield* Schema.decodeUnknownEffect(
+      Schema.Array(Schema.Struct({ credentials: Schema.Uint8Array })),
+    )(encrypted);
+    if (rows.length !== 1 || rows[0] === undefined)
+      return yield* retirementRefused("credential_reference_changed");
+    const fields = yield* runtime.credentials.decrypt(
+      AccountId.make(input.account),
+      Redacted.make(rows[0].credentials),
+    );
+    const saved = yield* Schema.decodeUnknownEffect(Schema.Struct({ ref: Schema.NonEmptyString }))(
+      Redacted.value(fields),
+    );
+    if (saved.ref !== before.reference)
+      return yield* retirementRefused("credential_reference_changed");
+    if (!(yield* runtime.verifyHome(before.reference, input.method)))
+      return yield* retirementRefused("home_reference_unavailable");
+    const after = yield* readReleasedRetirement(input);
+    if (before.snapshotSha256 !== after.snapshotSha256)
+      return yield* retirementRefused("snapshot_changed");
+    return {
+      code: "released_retirement_verified",
+      snapshotSha256: before.snapshotSha256,
+      homeReferenceSurvives: true,
+      credentialReferenceMatches: true,
+    };
+  });
diff --git a/apps/hosted/cloud/src/infrastructure/production-ops/migrations/released-retirement-records.ts b/apps/hosted/cloud/src/infrastructure/production-ops/migrations/released-retirement-records.ts
