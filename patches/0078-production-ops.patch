@@ -0,0 +1,45 @@
+import * as Cloudflare from "alchemy/Cloudflare";
+import { Effect, Schema } from "effect";
+import { HttpServerRequest, HttpServerResponse } from "effect/http";
+import { McpServer } from "../mcp-server-worker.ts";
+import { requestBody } from "./body.ts";
+export { productionOpsPath } from "./contracts.ts";
+
+const Binding = Schema.declare(
+  (value): value is { readonly fetch: (request: Request) => Promise<Response> } =>
+    typeof value === "object" &&
+    value !== null &&
+    "fetch" in value &&
+    typeof value.fetch === "function",
+);
+
+/** Large operator modules stay in the private Worker already holding the SQL and OAuth services. */
+export const cloudProductionOpsForward = Effect.gen(function* () {
+  yield* Cloudflare.Workers.bindWorker(McpServer);
+  return Effect.gen(function* () {
+    const body = yield* requestBody.pipe(
+      Effect.flatMap(Schema.decodeUnknownEffect(Schema.Struct({ envelope: Schema.String }))),
+    );
+    const environment = yield* Cloudflare.WorkerEnvironment;
+    const worker = yield* Schema.decodeUnknownEffect(Binding)(environment[McpServer.LogicalId]);
+    const request = yield* HttpServerRequest.HttpServerRequest;
+    const response = yield* Effect.tryPromise(() =>
+      worker.fetch(
+        new Request(request.originalUrl, {
+          method: "POST",
+          headers: { "content-type": "application/json" },
+          body: JSON.stringify(body),
+        }),
+      ),
+    );
+    return HttpServerResponse.fromWeb(response);
+  }).pipe(
+    Effect.catchCause(() =>
+      HttpServerResponse.json(
+        { error: "operation_refused" },
+        { status: 409, headers: { "cache-control": "no-store" } },
+      ),
+    ),
+    Effect.withTracerEnabled(false),
+  );
+});
diff --git a/apps/hosted/cloud/src/infrastructure/production-ops/http.ts b/apps/hosted/cloud/src/infrastructure/production-ops/http.ts
new file mode 100644
index 0000000..ad32d87
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/production-ops/http.ts
@@ -0,0 +1,84 @@
+import { openEnvelope } from "@executor-js/hosted-server/pool-token";
+import { GroupDatabase } from "@executor-js/hosted-server/groups";
+import { Clock, Config, Effect, Option, Redacted, Schema } from "effect";
+import { HttpServerResponse } from "effect/http";
+import { SqlClient } from "effect/sql";
+import { cloudEncryptionKey } from "../secrets.ts";
+import { cloudDatabaseConnection, cloudDirectDatabaseConnection } from "../database.ts";
+import { cloudHosts } from "../stage.ts";
+import { productionOpsRelease } from "../../implementation/production-ops-release.ts";
+import { Operation, runProductionOperation } from "./runner.ts";
+import { cloudProductionPreparations } from "./preparations.ts";
+import { requestBody } from "./body.ts";
+import { canonical, sha256 } from "./crypto.ts";
+export { productionOpsPath } from "./contracts.ts";
+
+const SignedRequest = Schema.Struct({
+  version: Schema.Literal(1),
+  id: Schema.NonEmptyString,
+  target: Schema.NonEmptyString,
+  at: Schema.Number,
+  expiresAt: Schema.Number,
+  operation: Operation,
+});
+
+/** No browser session or user-controlled SQL participates in the operator's signed request. */
+export const cloudProductionOps = Effect.gen(function* () {
+  const key = yield* Config.Redacted("POOL_APP_SIGNING_KEY").pipe(Config.option);
+  const encryptionKey = yield* cloudEncryptionKey.pipe(Effect.orDie);
+  const hosts = yield* cloudHosts.pipe(Effect.orDie);
+  const preparations = yield* cloudProductionPreparations;
+  const runtimeConnection = yield* cloudDatabaseConnection;
+  const directConnection = yield* cloudDirectDatabaseConnection;
+  return Effect.gen(function* () {
+    if (Option.isNone(key)) return HttpServerResponse.empty({ status: 503 });
+    const body = yield* requestBody.pipe(
+      Effect.flatMap(Schema.decodeUnknownEffect(Schema.Struct({ envelope: Schema.String }))),
+    );
+    const raw = yield* Effect.tryPromise(() =>
+      openEnvelope(Redacted.value(key.value), "sbops1", body.envelope),
+    );
+    const signed = yield* Schema.decodeUnknownEffect(SignedRequest)(raw).pipe(Effect.option);
+    const now = yield* Clock.currentTimeMillis;
+    if (
+      Option.isNone(signed) ||
+      signed.value.target !== hosts.browser ||
+      signed.value.at > now + 5000 ||
+      signed.value.expiresAt <= now ||
+      signed.value.expiresAt > signed.value.at + 60_000 ||
+      signed.value.id.length > 128
+    )
+      return HttpServerResponse.empty({ status: 401 });
+    const sql = yield* Effect.flatten(GroupDatabase);
+    const secret = yield* encryptionKey;
+    // Include the direct origin because a Hyperdrive proxy address can survive an origin change.
+    // Credentials stay inside this digest; rotating either binding invalidates an old plan.
+    const databaseTargetSha256 = sha256(
+      canonical({
+        context: "basalt-production-database-v1",
+        runtime: Redacted.value(yield* runtimeConnection.connectionString),
+        direct: Redacted.value(yield* directConnection.connectionString),
+      }),
+    );
+    const result = yield* runProductionOperation(
+      {
+        target: hosts.browser,
+        release: productionOpsRelease,
+        databaseTargetSha256,
+        encryptionKey: Redacted.value(secret),
+        preparations,
+      },
+      signed.value.operation,
+    ).pipe(Effect.provideService(SqlClient.SqlClient, sql), Effect.timeout("25 seconds"));
+    return yield* HttpServerResponse.json(result, { headers: { "cache-control": "no-store" } });
+  }).pipe(
+    // SQL errors can quote credentials from a rejected row. Only a fixed refusal crosses HTTP or telemetry.
+    Effect.catchCause(() =>
+      HttpServerResponse.json(
+        { error: "operation_refused" },
+        { status: 409, headers: { "cache-control": "no-store" } },
+      ),
+    ),
+    Effect.withTracerEnabled(false),
+  );
+});
diff --git a/apps/hosted/cloud/src/infrastructure/production-ops/inventory.ts b/apps/hosted/cloud/src/infrastructure/production-ops/inventory.ts
new file mode 100644
index 0000000..2c95e7f
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/production-ops/inventory.ts
@@ -0,0 +1,70 @@
+import { Effect, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+
+/** These projections are the complete SQL interface; workflow inputs never supply SQL. */
+export const inventoryQueries = {
+  receipts: `select plan_sha256, migration, revision, release, backup_sha256,
+    verification, applied_at::text from private_production_ops_receipts
+    where organization_id = $1 order by applied_at desc, plan_sha256 limit 2001`,
+  organizations: `select o.id as organization, o.name as organization_name, m.id as member,
+    m."userId" as user_id, m.role, u.email,
+    coalesce((select jsonb_agg(distinct a."providerId") from account a where a."userId" = u.id), '[]'::jsonb) as linked_sign_in_methods,
+    coalesce(u."emailVerified", false) as email_verified
+    from organization o left join member m on m."organizationId" = o.id
+    left join "user" u on u.id = m."userId"
+    where o.id = $1 order by o.id, m.id limit 2001`,
+  accounts: `select a.id, a.owner, a.provider, a.method, a.label, a.credential_generation,
+    p.organization_id, p.creator_id, p.personal_user_id, p.kind, p.audience, p.revision
+    from executor_accounts a left join hosted_account_access p on p.account_id = a.id and p.organization_id = $1
+    where a.owner = 'organization:' || $1 order by a.id limit 2001`,
+  pools: `select o.id as organization, entry.key as owner, entry.value ->> 'app' as app,
+    entry.value ->> 'version' as version, entry.value ->> 'authorization' as authorization,
+    entry.value ->> 'membership' as membership
+    from organization o cross join lateral jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) entry
+    where o.id = $1 order by o.id, entry.key limit 2001`,
+  "app-links": `select l.app, l.requirement, l.subject, l.account, l.linked_by, l.created_at::text,
+    a.owner, a.active_deployment from hosted_app_account_links l join executor_apps a on a.id = l.app
+    join executor_accounts account on account.id = l.account
+    where a.owner = 'organization:' || $1 and account.owner = a.owner
+    order by l.app, l.requirement, l.account, l.subject nulls first limit 2001`,
+  "retired-tokens": `select a.id, a.owner, a.provider, a.method,
+    p.organization_id, p.creator_id, p.kind, p.revision
+    from executor_accounts a
+    join hosted_account_access p on p.account_id = a.id and p.organization_id = $1 and p.kind = 'personal'
+    join organization team on team.id = $1
+    join executor_apps app on app.owner = a.owner
+      and app.id = coalesce(team.metadata::jsonb -> 'basaltPools', '{}'::jsonb) -> p.personal_user_id ->> 'app'
+    where a.owner = 'organization:' || $1 and a.method = 'token'
+      and exists (select 1 from executor_deployments d where d.code = app.code
+        and d.requirements::jsonb -> 'accounts' -> 'pool' ->> 'provider' = a.provider)
+    order by a.id limit 2001`,
+  departures: `select id, organization_id, user_id, status, attempts,
+    available_at::text, updated_at::text from hosted_contributed_departure_jobs
+    where organization_id = $1 order by id limit 2001`,
+  workflows: `select id, app, owner, actor, name, status, "created_at"::text
+    from executor_workflow_runs entry where entry.owner = 'organization:' || $1
+    and exists (select 1 from executor_apps a where a.id = entry.app and a.owner = 'organization:' || $1)
+    order by id limit 2001`,
+  schedules: `select id, app, owner, actor, name, enabled, revision, next_at::text,
+    active_run from executor_schedules entry where entry.owner = 'organization:' || $1
+    and exists (select 1 from executor_apps a where a.id = entry.app and a.owner = 'organization:' || $1)
+    order by id limit 2001`,
+  reporters: `select id, account, owner, source, generation, checked_at::text,
+    next_allowed_at::text, lease_until::text from executor_account_observations entry
+    where entry.owner = 'organization:' || $1
+    and exists (select 1 from executor_accounts a where a.id = entry.account and a.owner = 'organization:' || $1)
+    order by id limit 2001`,
+} as const;
+
+export const inventory = (selection: string, organization: string) =>
+  Effect.gen(function* () {
+    if (!Object.hasOwn(inventoryQueries, selection))
+      return yield* Effect.fail(new Error("Unknown inventory"));
+    const sql = yield* SqlClient.SqlClient;
+    const query = inventoryQueries[selection as keyof typeof inventoryQueries];
+    const rows = yield* sql
+      .unsafe(query, [organization])
+      .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Schema.Array(Schema.Json))));
+    if (rows.length > 2000) return yield* Effect.fail(new Error("Inventory exceeds its bound"));
+    return { selection, organization, rows };
+  });
diff --git a/apps/hosted/cloud/src/infrastructure/production-ops/migrations.ts b/apps/hosted/cloud/src/infrastructure/production-ops/migrations.ts
