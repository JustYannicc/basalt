+import { expect } from "@effect/vitest";
+import { Effect } from "effect";
+import { Api, body, type Session } from "./api.ts";
+import { App, Resource } from "./contracts.ts";
+import { connectionsPath } from "./app-accounts.ts";
+import { appsManifest } from "./apps-release.ts";
+
+/** Create a real saved account and app link, without relying on asynchronous onboarding keys. */
+export const productionOpsAccount = (actor: Session, organization: string) =>
+  Effect.gen(function* () {
+    const api = yield* Api;
+    const prefix = `/api/organizations/${organization}`;
+    const deployed = yield* api.request(actor, "POST", `${prefix}/apps/deploy`, {
+      name: "Production operations account",
+      files: [
+        {
+          path: "index.ts",
+          content: `import { defineApp, defineProvider, oauth2, object, router, secrets, string } from "apps";
+const service = defineProvider({ name: "Operations fixture", auth: {
+  apiKey: secrets({ label: "API key", fields: object({ token: string() }) }),
+  token: secrets({ label: "Pool token", fields: object({ token: string() }) }),
+  oauth: oauth2({ authorizationUrl: "https://identity.example.test/authorize", tokenUrl: "https://identity.example.test/token", scopes: ["read"], tokenEndpointAuthMethod: "none" })
+} });
+export default defineApp({ user: { accounts: { service } } }, { tools: router({}) });`,
+        },
+        appsManifest,
+      ],
+    });
+    expect(deployed.status).toBe(200);
+    const app = yield* body(App, deployed);
+    const appPath = `${prefix}/apps/${app.id}`;
+    let account: string | undefined;
+    yield* Effect.addFinalizer(() =>
+      Effect.gen(function* () {
+        expect((yield* api.request(actor, "DELETE", appPath)).status).toBe(200);
+        if (account !== undefined)
+          expect(
+            (yield* api.request(actor, "DELETE", `${prefix}/accounts/${account}`)).status,
+          ).toBe(200);
+      }).pipe(Effect.orDie),
+    );
+    const connection = yield* api.request(
+      actor,
+      "POST",
+      connectionsPath(appPath, "user", "service"),
+      {},
+    );
+    expect(connection.status).toBe(200);
+    const pending = yield* body(Resource, connection);
+    const saved = yield* api.request(actor, "POST", `${prefix}/connections/${pending.id}/submit`, {
+      method: "apiKey",
+      fields: { token: "synthetic-production-ops-token" },
+    });
+    expect(saved.status).toBe(200);
+    account = (yield* body(Resource, saved)).id;
+    return { account, app: app.id };
+  });
