diff --git a/e2e/tests/production-ops-migrations.spec.ts b/e2e/tests/production-ops-migrations.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d9937f85b3c35931f6b770ba66320b13bb366ec9
--- /dev/null
+++ b/e2e/tests/production-ops-migrations.spec.ts
@@ -0,0 +1,217 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { randomUUID } from "node:crypto";
+import { body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Artifact, productionOpsClient } from "../support/production-ops-client.ts";
+import { productionOpsInventoryRows } from "../support/production-ops-inventory-rows.ts";
+import { scenarios } from "../test-plan.ts";
+
+const DryRun = Schema.Struct({
+  action: Schema.Literal("dry-run"),
+  artifact: Artifact,
+  backupSha256: Schema.String,
+});
+const Applied = Schema.Struct({
+  action: Schema.Literal("apply"),
+  repeated: Schema.Boolean,
+  verification: Schema.Struct({ ok: Schema.Boolean }),
+});
+
+const proof = Effect.gen(function* () {
+  const rows = yield* productionOpsInventoryRows;
+  const client = yield* productionOpsClient;
+  const operation = (
+    name: string,
+    foreign: string = rows.foreign.account,
+    account = rows.own.account,
+  ) => ({
+    action: "dry-run",
+    selection: "scope-proof",
+    recipient: client.recipient,
+    request: {
+      organization: rows.own.organization,
+      account,
+      app: rows.own.app,
+      connection: rows.own.connection,
+      job: rows.own.job,
+      workflow: rows.own.workflow,
+      schedule: rows.own.schedule,
+      subject: rows.own.user,
+      foreign,
+      operation: name,
+    },
+  });
+  const apply = (op: ReturnType<typeof operation>, dry: typeof DryRun.Type) => ({
+    ...op,
+    action: "apply",
+    artifact: dry.artifact,
+    planSha256: dry.artifact.sha256,
+    backupSha256: dry.backupSha256,
+    go: `GO ${dry.artifact.sha256}`,
+  });
+  const dryRun = (op: ReturnType<typeof operation>) =>
+    Effect.gen(function* () {
+      const response = yield* client.request(op);
+      expect(response.status).toBe(200);
+      return yield* body(DryRun, response);
+    });
+  return { ...rows, ...client, operation, apply, dryRun };
+});
+
+layer(HostedLive, { excludeTestServices: true })("Production migration scope", (it) => {
+  it.effect(scenarios.cloudProductionOpsStableKeys.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const p = yield* proof;
+        const valid = p.operation("increment");
+        const before = yield* p.account();
+        const dry = yield* p.dryRun(valid);
+        expect(yield* p.account()).toEqual(before);
+        const applied = yield* p.request(p.apply(valid, dry));
+        expect(applied.status).toBe(200);
+        expect((yield* body(Applied, applied)).repeated).toBe(false);
+        const after = yield* p.account();
+        expect(after).not.toEqual(before);
+        const replay = yield* p.request(p.apply(valid, dry));
+        expect(replay.status).toBe(200);
+        expect((yield* body(Applied, replay)).repeated).toBe(true);
+        expect(yield* p.account()).toEqual(after);
+        expect(
+          (yield* p.request({
+            ...p.apply(valid, dry),
+            request: { ...valid.request, organization: p.foreign.organization },
+          })).status,
+        ).toBe(409);
+        for (const [name, foreign, account] of [
+          ["mutable-delete", `organization:${p.foreign.organization}`, p.own.account],
+          ["collision", p.foreign.account, p.foreign.account],
+        ] as const) {
+          const operation = p.operation(name, foreign, account);
+          const before = yield* p.account(account);
+          const response = yield* p.request(operation);
+          if (response.status === 200) {
+            const prepared = yield* body(DryRun, response);
+            expect((yield* p.request(p.apply(operation, prepared))).status).toBe(409);
+          } else expect(response.status).toBe(409);
+          expect(yield* p.account(account)).toEqual(before);
+        }
+        const failing = p.operation("bad-verification");
+        const bad = yield* p.dryRun(failing);
+        const unchanged = yield* p.account();
+        expect((yield* p.request(p.apply(failing, bad))).status).toBe(409);
+        expect(yield* p.account()).toEqual(unchanged);
+        expect(
+          yield* p.database.run({
+            sql: "select plan_sha256 from private_production_ops_receipts where plan_sha256 = $1",
+            params: [bad.artifact.sha256],
+          }),
+        ).toEqual([]);
+        yield* p.database.run({
+          sql: "update hosted_app_account_links set subject = null where app = $1",
+          params: [p.own.app],
+        });
+        const nullable = p.operation("link-null", p.own.user);
+        nullable.request.subject = "null";
+        const nullablePlan = yield* p.dryRun(nullable);
+        expect((yield* p.request(p.apply(nullable, nullablePlan))).status).toBe(200);
+        // A committed receipt cannot authorize a foreign replacement at the same stable ID.
+        yield* p.database.run({
+          sql: "update executor_accounts set owner = $2 where id = $1",
+          params: [p.own.account, `organization:${p.foreign.organization}`],
+        });
+        expect((yield* p.request(p.apply(valid, dry))).status).toBe(409);
+        yield* p.database.run({
+          sql: "update executor_accounts set owner = $2 where id = $1",
+          params: [p.own.account, `organization:${p.own.organization}`],
+        });
+        const deletedId = randomUUID();
+        yield* Effect.addFinalizer(() =>
+          p.database
+            .run({ sql: "delete from executor_accounts where id = $1", params: [deletedId] })
+            .pipe(Effect.orDie),
+        );
+        yield* p.database.run({
+          sql: `insert into executor_accounts select (jsonb_populate_record(null::executor_accounts, to_jsonb(a) || jsonb_build_object('id', $2::text))).* from executor_accounts a where id = $1`,
+          params: [p.own.account, deletedId],
+        });
+        const deletion = p.operation("delete", p.foreign.account, deletedId);
+        const deletionPlan = yield* p.dryRun(deletion);
+        expect((yield* p.request(p.apply(deletion, deletionPlan))).status).toBe(200);
+        expect(yield* p.account(deletedId)).toEqual([]);
+        yield* p.database.run({
+          sql: `insert into executor_accounts select (jsonb_populate_record(null::executor_accounts, to_jsonb(a) || jsonb_build_object('id', $2::text))).* from executor_accounts a where id = $1`,
+          params: [p.foreign.account, deletedId],
+        });
+        expect((yield* p.request(p.apply(deletion, deletionPlan))).status).toBe(409);
+        expect(
+          (yield* p.request(p.operation("increment", p.own.account, p.foreign.account))).status,
+        ).toBe(409);
+      }),
+    ),
+  );
+
+  it.effect(scenarios.cloudProductionOpsReferences.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const p = yield* proof;
+        const grantlessId = randomUUID();
+        yield* Effect.addFinalizer(() =>
+          p.database
+            .run({
+              sql: "delete from executor_accounts where id = $1 or id = $2",
+              params: [p.foreign.grant, grantlessId],
+            })
+            .pipe(Effect.orDie),
+        );
+        expect(yield* p.account(p.foreign.grant)).toEqual([]);
+        const implicit = p.operation("implicit-grant", p.foreign.account, p.foreign.grant);
+        const implicitPlan = yield* p.dryRun(implicit);
+        expect(
+          (yield* p.request(p.apply(implicit, implicitPlan))).status,
+          "Null references must not borrow a foreign grant at the inserted account ID",
+        ).toBe(409);
+        expect(yield* p.account(p.foreign.grant)).toEqual([]);
+        expect(
+          yield* p.database.run({
+            sql: "select plan_sha256 from private_production_ops_receipts where plan_sha256 = $1",
+            params: [implicitPlan.artifact.sha256],
+          }),
+        ).toEqual([]);
+        const grantless = p.operation("grantless-insert", p.own.account, grantlessId);
+        const grantlessPlan = yield* p.dryRun(grantless);
+        expect((yield* p.request(p.apply(grantless, grantlessPlan))).status).toBe(200);
+        expect((yield* p.account(grantlessId)).length).toBe(1);
+        const grantlessReplay = yield* p.request(p.apply(grantless, grantlessPlan));
+        expect(grantlessReplay.status).toBe(200);
+        expect((yield* body(Applied, grantlessReplay)).repeated).toBe(true);
+        for (const [name, foreign] of [
+          ["account-grant", p.foreign.grant],
+          ["account-identity", p.foreign.identity],
+          ["app-deployment", p.foreign.deployment],
+          ["connection-source", p.foreign.account],
+          ["connection-reconnect", p.foreign.account],
+          ["link-subject", p.foreign.user],
+          ["departure-app", p.foreign.app],
+          ["departure-account", p.foreign.account],
+          ["workflow-deployment", p.foreign.deployment],
+          ["schedule-run", p.foreign.workflow],
+        ] as const) {
+          const operation = p.operation(name, foreign);
+          const unchanged = yield* p.snapshot;
+          const dry = yield* p.dryRun(operation);
+          expect((yield* p.request(p.apply(operation, dry))).status).toBe(409);
+          expect(yield* p.snapshot).toEqual(unchanged);
+          expect(
+            yield* p.database.run({
+              sql: "select plan_sha256 from private_production_ops_receipts where plan_sha256 = $1",
+              params: [dry.artifact.sha256],
+            }),
+          ).toEqual([]);
+        }
+      }),
+    ),
+  );
+});
diff --git a/e2e/tests/production-ops.spec.ts b/e2e/tests/production-ops.spec.ts
