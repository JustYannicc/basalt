--- /dev/null
+++ b/e2e/tests/production-ops.spec.ts
@@ -0,0 +1,200 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import {
+  constants,
+  createDecipheriv,
+  createHash,
+  createHmac,
+  generateKeyPairSync,
+  privateDecrypt,
+  randomUUID,
+} from "node:crypto";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Target } from "../support/platform.ts";
+import { targetHosts } from "../support/role-hosts.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Artifact = Schema.Struct({
+  version: Schema.Literal(1),
+  sha256: Schema.String,
+  sealed: Schema.Struct({
+    version: Schema.Literal(1),
+    iv: Schema.String,
+    ciphertext: Schema.String,
+  }),
+  recipient: Schema.Struct({
+    version: Schema.Literal(1),
+    recipient: Schema.String,
+    wrappedKey: Schema.String,
+    iv: Schema.String,
+    ciphertext: Schema.String,
+  }),
+});
+const Response = Schema.Struct({ action: Schema.String, artifact: Artifact });
+const Inventory = Schema.Struct({
+  format: Schema.Literal("basalt-production-inventory-v1"),
+  target: Schema.String,
+  release: Schema.String,
+  selection: Schema.String,
+  rows: Schema.Array(Schema.Json),
+});
+const Backup = Schema.Struct({
+  format: Schema.Literal("basalt-production-backup-v1"),
+  target: Schema.String,
+  release: Schema.String,
+  tables: Schema.Array(Schema.String),
+  rows: Schema.Record(Schema.String, Schema.Array(Schema.Json)),
+});
+
+layer(HostedLive, { excludeTestServices: true })("Production operations", (it) => {
+  it.effect(scenarios.cloudProductionOps.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          target = yield* Target;
+        const origin = targetHosts(target).browser;
+        const anonymous = yield* api.session();
+        const pair = generateKeyPairSync("rsa", { modulusLength: 3072 });
+        const recipient = pair.publicKey.export({ type: "spki", format: "der" }).toString("base64");
+        const request = (
+          operation: unknown,
+          overrides: { target?: string; expiresAt?: number; secret?: string } = {},
+        ) => {
+          const at = Date.now();
+          const payload = Buffer.from(
+            JSON.stringify({
+              version: 1,
+              id: randomUUID(),
+              target: overrides.target ?? origin,
+              at,
+              expiresAt: overrides.expiresAt ?? at + 60_000,
+              operation,
+            }),
+          ).toString("base64url");
+          const signature = createHmac(
+            "sha256",
+            Buffer.from(overrides.secret ?? "ab".repeat(32), "hex"),
+          )
+            .update(`sbops1.${payload}`)
+            .digest("base64url");
+          return api.request(anonymous, "POST", "/api/internal/production-ops", {
+            envelope: `sbops1.${payload}.${signature}`,
+          });
+        };
+        const read = (selection: string) => ({
+          action: "inventory",
+          selection,
+          request: {},
+          recipient,
+        });
+        const decrypt = (artifact: typeof Artifact.Type) => {
+          const copy = artifact.recipient;
+          const key = privateDecrypt(
+            { key: pair.privateKey, padding: constants.RSA_PKCS1_OAEP_PADDING, oaepHash: "sha256" },
+            Buffer.from(copy.wrappedKey, "base64"),
+          );
+          const encrypted = Buffer.from(copy.ciphertext, "base64");
+          const decipher = createDecipheriv("aes-256-gcm", key, Buffer.from(copy.iv, "base64"));
+          decipher.setAAD(Buffer.from(`basalt-production-ops-v1:${origin}`));
+          decipher.setAuthTag(encrypted.subarray(-16));
+          const plaintext = Buffer.concat([
+            decipher.update(encrypted.subarray(0, -16)),
+            decipher.final(),
+          ]);
+          expect(createHash("sha256").update(plaintext).digest("hex")).toBe(artifact.sha256);
+          return JSON.parse(plaintext.toString("utf8"));
+        };
+
+        expect(
+          (yield* api.request(actors.owner, "POST", "/api/internal/production-ops", {})).status,
+        ).toBe(409);
+        expect((yield* request(read("organizations"), { secret: "cd".repeat(32) })).status).toBe(
+          401,
+        );
+        expect(
+          (yield* request(read("organizations"), { target: "https://another.example.test" }))
+            .status,
+        ).toBe(401);
+        expect((yield* request(read("organizations"), { expiresAt: Date.now() - 1 })).status).toBe(
+          401,
+        );
+        expect((yield* request(read("select * from account"))).status).toBe(409);
+
+        for (const selection of [
+          "organizations",
+          "accounts",
+          "pools",
+          "app-links",
+          "retired-tokens",
+          "departures",
+          "workflows",
+          "schedules",
+          "reporters",
+          "receipts",
+        ]) {
+          const response = yield* request(read(selection));
+          expect(response.status).toBe(200);
+          const encrypted = yield* body(Response, response);
+          expect(JSON.stringify(response.body)).not.toContain("@example.test");
+          const inventory = yield* Schema.decodeUnknownEffect(Inventory)(
+            decrypt(encrypted.artifact),
+          );
+          expect(inventory.selection).toBe(selection);
+          expect(inventory.target).toBe(origin);
+          expect(inventory.release).toMatch(/^[a-f0-9]{40}$/);
+          if (selection === "organizations")
+            expect(
+              inventory.rows.some(
+                (row) =>
+                  typeof row === "object" &&
+                  row !== null &&
+                  !Array.isArray(row) &&
+                  "organization" in row &&
+                  row.organization === actors.organization.id,
+              ),
+            ).toBe(true);
+        }
+        const before = yield* body(Response, yield* request(read("accounts")));
+        const snapshotResponse = yield* request({
+          action: "backup",
+          selection: "accounts",
+          request: {},
+          recipient,
+        });
