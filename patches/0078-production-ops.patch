+import { SqlClient } from "effect/sql";
+
+/** An additive receipt makes an interrupted apply observable without replaying its writes. */
+export const migrateProductionOps = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  yield* sql`create table if not exists private_production_ops_receipts (
+    plan_sha256 text primary key,
+    organization_id text not null,
