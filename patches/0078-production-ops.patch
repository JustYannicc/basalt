diff --git a/apps/hosted/cloud/src/infrastructure/production-ops/runner.ts b/apps/hosted/cloud/src/infrastructure/production-ops/runner.ts
new file mode 100644
index 0000000..b518371
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/production-ops/runner.ts
@@ -0,0 +1,320 @@
+import { Clock, Effect, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import type {
+  Json,
+  MigrationPlan,
+  ProductionMigration,
+  ProductionPreparation,
+} from "./contracts.ts";
+import { canonical, openArtifact, protectArtifact, ProtectedArtifact, sha256 } from "./crypto.ts";
+import { backupSelections, backupTables, snapshotTables } from "./backup.ts";
+import { inventory } from "./inventory.ts";
+import { productionMigrations } from "./migrations.ts";
+import { checkPlanScope, OrganizationRequest, requireOrganization } from "./scope.ts";
+
+export const Operation = Schema.Struct({
+  action: Schema.Literals(["inventory", "backup", "prepare", "dry-run", "apply"]),
+  selection: Schema.NonEmptyString,
+  request: OrganizationRequest,
+  recipient: Schema.NonEmptyString,
+  artifact: Schema.optionalKey(ProtectedArtifact),
+  planSha256: Schema.optionalKey(Schema.String),
+  backupSha256: Schema.optionalKey(Schema.String),
+  go: Schema.optionalKey(Schema.String),
+});
+export type Operation = typeof Operation.Type;
+
+const Plan = Schema.Struct({
+  format: Schema.Literal("basalt-production-plan-v1"),
+  target: Schema.String,
+  database: Schema.Struct({ name: Schema.String, targetSha256: Schema.String }),
+  release: Schema.String,
+  migration: Schema.String,
+  revision: Schema.String,
+  preparedAt: Schema.Number,
+  request: OrganizationRequest,
+  plan: Schema.Struct({
+    changes: Schema.Array(
+      Schema.Struct({
+        table: Schema.String,
+        key: Schema.Record(Schema.String, Schema.NullOr(Schema.String)),
+        action: Schema.Literals(["insert", "update", "delete"]),
+        beforeSha256: Schema.NullOr(Schema.String),
+        afterSha256: Schema.NullOr(Schema.String),
+      }),
+    ),
+    data: Schema.Json,
+  }),
+  backupSha256: Schema.String,
+});
+
+export interface OpsSettings {
+  readonly target: string;
+  readonly release: string;
+  readonly databaseTargetSha256: string;
+  readonly encryptionKey: string;
+  readonly preparations: Readonly<Record<string, ProductionPreparation>>;
+}
+
+const fail = (reason: string) => Effect.fail(new Error(reason));
+const checksum = /^[a-f0-9]{64}$/;
+
+function validPlan(module: ProductionMigration, plan: MigrationPlan): boolean {
+  if (plan.changes.length > 2000 || !/^[a-z0-9][a-z0-9.-]{0,127}$/.test(module.revision))
+    return false;
+  const seen = new Set<string>();
+  return (
+    module.tables.length > 0 &&
+    module.tables.every((table) => backupTables.has(table)) &&
+    plan.changes.every((change) => {
+      const id = canonical([change.table, change.key]);
+      const unique = !seen.has(id);
+      seen.add(id);
+      const before = change.beforeSha256;
+      const after = change.afterSha256;
+      return (
+        unique &&
+        module.tables.includes(change.table) &&
+        Object.keys(change.key).length > 0 &&
+        Object.values(change.key).every(
+          (value) => value === null || (value.length > 0 && value.length <= 512),
+        ) &&
+        (change.action === "insert"
+          ? before === null && after !== null && checksum.test(after)
+          : change.action === "delete"
+            ? before !== null && checksum.test(before) && after === null
+            : before !== null && after !== null && checksum.test(before) && checksum.test(after))
+      );
+    })
+  );
+}
+
+const readOnly = <A, E>(work: Effect.Effect<A, E, SqlClient.SqlClient>) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    return yield* sql.withTransaction(
+      Effect.gen(function* () {
+        yield* sql`set transaction isolation level repeatable read read only`;
+        yield* sql`set local statement_timeout = '5s'`;
+        yield* sql`set local lock_timeout = '500ms'`;
+        yield* sql`set local idle_in_transaction_session_timeout = '10s'`;
+        return yield* work;
+      }),
+    );
+  });
+
+const databaseName = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  const rows = yield* sql`select current_database() as name`.pipe(
+    Effect.flatMap(
+      Schema.decodeUnknownEffect(Schema.Array(Schema.Struct({ name: Schema.String }))),
+    ),
+  );
+  return rows[0]?.name ?? (yield* fail("Database identity unavailable"));
+});
+
+const databaseIdentity = (targetSha256: string) =>
+  databaseName.pipe(Effect.map((name) => ({ name, targetSha256 })));
+
+const inspect = (module: ProductionMigration, request: Json) =>
+  module
+    .inspect(request)
+    .pipe(
+      Effect.flatMap((plan) =>
+        validPlan(module, plan) ? Effect.succeed(plan) : fail("Invalid migration plan"),
+      ),
+    );
+
+/** Only the registered modules can reach writes. Inventory, backup and plan inspection stay SQL read-only. */
+export const runProductionOperation = (settings: OpsSettings, operation: Operation) =>
+  Effect.gen(function* () {
+    const now = yield* Clock.currentTimeMillis;
+    const organization = operation.request.organization;
+    yield* requireOrganization(organization);
+    const protect = (value: unknown) =>
+      Effect.tryPromise(() =>
+        protectArtifact(value, settings.encryptionKey, operation.recipient, settings.target),
+      );
+    if (operation.action === "inventory") {
+      const result = yield* readOnly(
+        Effect.gen(function* () {
+          const database = yield* databaseIdentity(settings.databaseTargetSha256);
+          return { ...(yield* inventory(operation.selection, organization)), database };
+        }),
+      );
+      return {
+        action: "inventory",
+        rows: result.rows.length,
+        artifact: yield* protect({
+          format: "basalt-production-inventory-v1",
+          target: settings.target,
+          release: settings.release,
+          observedAt: now,
+          ...result,
+        }),
+      };
+    }
+    const module = Object.hasOwn(productionMigrations, operation.selection)
+      ? productionMigrations[operation.selection]
+      : undefined;
+    if (operation.action === "backup") {
+      const tables = module?.tables ?? backupSelections[operation.selection];
+      if (tables === undefined) return yield* fail("Unknown backup selection");
+      const snapshot = yield* readOnly(
+        Effect.gen(function* () {
+          const database = yield* databaseIdentity(settings.databaseTargetSha256);
+          return { ...(yield* snapshotTables(tables)), database };
+        }),
+      );
+      return {
+        action: "backup",
+        tables: snapshot.tables,
+        artifact: yield* protect({
+          format: "basalt-production-backup-v1",
+          target: settings.target,
+          release: settings.release,
+          observedAt: now,
+          organization,
+          ...snapshot,
+        }),
+      };
+    }
+    if (operation.action === "prepare") {
+      const preparation = Object.hasOwn(settings.preparations, operation.selection)
+        ? settings.preparations[operation.selection]
+        : undefined;
+      if (preparation === undefined || preparation.name !== operation.selection)
+        return yield* fail("Unknown preparation selection");
+      const result = yield* preparation.run(operation.request);
+      return {
+        action: "prepare",
+        artifact: yield* protect({
+          format: "basalt-production-preparation-v1",
+          target: settings.target,
+          release: settings.release,
+          observedAt: now,
+          selection: preparation.name,
+          request: operation.request,
+          result,
+        }),
+      };
+    }
+    if (module === undefined || module.name !== operation.selection)
+      return yield* fail("Unknown migration");
+    if (operation.action === "dry-run") {
+      const result = yield* readOnly(
+        Effect.gen(function* () {
+          const database = yield* databaseIdentity(settings.databaseTargetSha256);
+          const plan = yield* inspect(module, operation.request);
+          yield* checkPlanScope(plan, organization, "before");
+          const snapshot = yield* snapshotTables(module.tables);
+          return { database, plan, snapshot };
+        }),
+      );
+      const backup = yield* protect({
+        format: "basalt-production-backup-v1",
+        target: settings.target,
+        release: settings.release,
+        migration: module.name,
+        revision: module.revision,
+        observedAt: now,
+        ...result.snapshot,
+      });
+      const backupSha256 = sha256(`${canonical(backup)}\n`);
+      const plan = {
+        format: "basalt-production-plan-v1",
+        target: settings.target,
+        database: result.database,
+        release: settings.release,
+        migration: module.name,
+        revision: module.revision,
+        preparedAt: now,
+        request: operation.request,
+        plan: result.plan,
+        backupSha256,
+      };
+      return {
+        action: "dry-run",
+        changes: result.plan.changes.length,
+        backupSha256,
+        artifact: yield* protect(plan),
+        backup,
+      };
+    }
+    if (
+      operation.artifact === undefined ||
+      operation.planSha256 === undefined ||
+      operation.artifact.sha256 !== operation.planSha256 ||
+      operation.go !== `GO ${operation.planSha256}`
+    )
+      return yield* fail("Apply requires the reviewed plan hash and exact GO");
+    const raw = yield* Effect.tryPromise(() =>
+      openArtifact(operation.artifact!, settings.encryptionKey, settings.target),
+    );
+    const saved = yield* Schema.decodeUnknownEffect(Plan)(raw);
+    if (
+      saved.target !== settings.target ||
+      saved.release !== settings.release ||
+      saved.migration !== module.name ||
+      saved.revision !== module.revision ||
+      saved.backupSha256 !== operation.backupSha256 ||
+      canonical(saved.request) !== canonical(operation.request) ||
+      !validPlan(module, saved.plan) ||
+      now - saved.preparedAt > 3_600_000 ||
+      saved.preparedAt > now
+    )
+      return yield* fail("The reviewed plan no longer matches this operation");
+    const sql = yield* SqlClient.SqlClient;
+    const hash = operation.planSha256;
+    const receipt = yield* sql.withTransaction(
+      Effect.gen(function* () {
+        yield* sql`set transaction isolation level serializable`;
+        yield* sql`set local statement_timeout = '5s'`;
+        yield* sql`set local lock_timeout = '500ms'`;
+        yield* sql`set local idle_in_transaction_session_timeout = '10s'`;
+        if (
+          (yield* databaseName) !== saved.database.name ||
+          settings.databaseTargetSha256 !== saved.database.targetSha256
+        )
+          return yield* fail("Database identity changed");
+        const prior =
+          yield* sql`select organization_id, migration, revision, release, backup_sha256 from private_production_ops_receipts
+      where plan_sha256 = ${hash} for update`;
+        if (prior.length > 0) {
+          const row = prior[0];
+          if (
+            row?.organization_id !== organization ||
+            row?.migration !== saved.migration ||
+            row?.revision !== saved.revision ||
+            row?.release !== saved.release ||
+            row?.backup_sha256 !== saved.backupSha256
+          )
+            return yield* fail("Receipt identity differs");
+          return { repeated: true };
+        }
+        yield* checkPlanScope(saved.plan, organization, "before", true);
+        const current = yield* inspect(module, saved.request);
+        if (canonical(current) !== canonical(saved.plan))
+          return yield* fail("Migration inputs changed after review");
+        yield* sql`insert into private_production_ops_receipts
+      (plan_sha256, organization_id, migration, revision, release, backup_sha256, verification)
+      values (${hash}, ${organization}, ${module.name}, ${module.revision}, ${settings.release}, ${saved.backupSha256}, '{}'::jsonb)`;
+        yield* module.apply(saved.request, saved.plan);
+        yield* checkPlanScope(saved.plan, organization, "after");
+        const verification = yield* module.verify(saved.request, saved.plan);
+        if (!verification.ok || Object.values(verification.checks).some((value) => !value))
+          return yield* fail("Migration verification failed");
+        yield* sql`update private_production_ops_receipts set verification = ${JSON.stringify(verification)}::jsonb
+      where plan_sha256 = ${hash}`;
+        return { repeated: false };
+      }),
+    );
+    const verification = yield* readOnly(
+      checkPlanScope(saved.plan, organization, "after").pipe(
+        Effect.andThen(module.verify(saved.request, saved.plan)),
+      ),
+    );
+    if (!verification.ok || Object.values(verification.checks).some((value) => !value))
+      return yield* fail("Committed migration needs operator investigation");
+    return { action: "apply", planSha256: hash, ...receipt, verification };
+  });
