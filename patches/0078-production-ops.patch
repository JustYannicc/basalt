+++ b/apps/hosted/cloud/src/infrastructure/production-ops/backup.ts
@@ -0,0 +1,84 @@
+import { Effect, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import { canonical, sha256 } from "./crypto.ts";
+
+/** Full rows stay inside encrypted snapshots. This list is changed only by reviewed source. */
+export const backupTables = new Set([
+  "organization",
+  "member",
+  "user",
+  "account",
+  "executor_accounts",
+  "executor_account_identities",
+  "executor_providers",
+  "executor_oauth_grants",
+  "executor_account_acquisitions",
+  "executor_account_connections",
+  "hosted_account_access",
+  "hosted_account_groups",
+  "hosted_account_observation_access",
+  "hosted_app_account_links",
+  "hosted_app_access",
+  "hosted_app_groups",
+  "hosted_groups",
+  "hosted_group_members",
+  "executor_apps",
+  "executor_deployments",
+  "hosted_contributed_departure_jobs",
+  "hosted_contributed_departures",
+  "executor_account_observations",
+  "executor_schedules",
+  "executor_workflow_runs",
+]);
+
+export const snapshotTables = (tables: readonly string[]) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const unique = [...new Set(tables)].sort();
+    if (
+      unique.length === 0 ||
+      unique.length > 24 ||
+      unique.some((table) => !backupTables.has(table))
+    )
+      return yield* Effect.fail(new Error("Unknown backup table"));
+    const snapshot: Record<string, readonly Schema.Json[]> = {};
+    for (const table of unique) {
+      const rows = yield* sql
+        .unsafe(`select to_jsonb(entry) as row from "${table}" entry limit 10001`)
+        .pipe(
+          Effect.flatMap(
+            Schema.decodeUnknownEffect(Schema.Array(Schema.Struct({ row: Schema.Json }))),
+          ),
+        );
+      if (rows.length > 10000) return yield* Effect.fail(new Error("Backup exceeds its row bound"));
+      snapshot[table] = rows
+        .map(({ row }) => row)
+        .sort((left, right) => canonical(left).localeCompare(canonical(right), "en"));
+      if (Buffer.byteLength(canonical(snapshot)) > 8_000_000)
+        return yield* Effect.fail(new Error("Backup exceeds its byte bound"));
+    }
+    return { tables: unique, rows: snapshot, sha256: sha256(canonical(snapshot)) };
+  });
+
+export const backupSelections: Readonly<Record<string, readonly string[]>> = {
+  accounts: [
+    "executor_accounts",
+    "executor_account_identities",
+    "executor_providers",
+    "executor_oauth_grants",
+    "hosted_account_access",
+    "hosted_account_groups",
+    "hosted_app_account_links",
+  ],
+  pools: [
+    "organization",
+    "executor_apps",
+    "executor_deployments",
+    "hosted_app_access",
+    "hosted_app_groups",
+    "hosted_app_account_links",
+  ],
+  departures: ["hosted_contributed_departure_jobs", "hosted_contributed_departures"],
+  reporters: ["executor_account_observations", "hosted_account_observation_access"],
+  workflows: ["executor_schedules", "executor_workflow_runs"],
+};
diff --git a/apps/hosted/cloud/src/infrastructure/production-ops/body.ts b/apps/hosted/cloud/src/infrastructure/production-ops/body.ts
new file mode 100644
index 0000000..02905be
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/production-ops/body.ts
@@ -0,0 +1,22 @@
+import { Effect, Stream } from "effect";
+import { HttpServerRequest } from "effect/http";
+
+/** Read with a byte bound before parsing, including requests without Content-Length. */
+export const requestBody = Effect.gen(function* () {
+  const request = yield* HttpServerRequest.HttpServerRequest;
+  const chunks: Uint8Array[] = [];
+  let length = 0;
+  yield* request.stream.pipe(
+    Stream.runForEach((chunk) =>
+      Effect.gen(function* () {
+        length += chunk.byteLength;
+        if (length > 24_000_000)
+          return yield* Effect.fail(new Error("Ops request exceeds its bound"));
+        chunks.push(chunk);
+      }),
+    ),
+  );
+  return yield* Effect.try(() =>
+    JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(Buffer.concat(chunks))),
+  );
+});
