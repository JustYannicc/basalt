+++ b/apps/hosted/cloud/src/infrastructure/production-ops/inventory.ts
@@ -0,0 +1,53 @@
+import { Effect, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+
+/** These projections are the complete SQL interface; workflow inputs never supply SQL. */
+export const inventoryQueries = {
+  receipts: `select plan_sha256, migration, revision, release, backup_sha256,
+    verification, applied_at::text from private_production_ops_receipts
+    order by applied_at desc, plan_sha256 limit 2001`,
+  organizations: `select o.id as organization, o.name as organization_name, m.id as member,
+    m."userId" as user_id, m.role, u.email,
+    coalesce((select jsonb_agg(distinct a."providerId") from account a where a."userId" = u.id), '[]'::jsonb) as linked_sign_in_methods,
+    coalesce(u."emailVerified", false) as email_verified
+    from organization o left join member m on m."organizationId" = o.id
+    left join "user" u on u.id = m."userId"
+    order by o.id, m.id limit 2001`,
+  accounts: `select a.id, a.owner, a.provider, a.method, a.label, a.credential_generation,
+    p.organization_id, p.creator_id, p.personal_user_id, p.kind, p.audience, p.revision
+    from executor_accounts a left join hosted_account_access p on p.account_id = a.id
+    order by a.id limit 2001`,
+  pools: `select o.id as organization, entry.key as owner, entry.value ->> 'app' as app,
+    entry.value ->> 'version' as version, entry.value ->> 'authorization' as authorization,
+    entry.value ->> 'membership' as membership
+    from organization o cross join lateral jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) entry
+    order by o.id, entry.key limit 2001`,
+  "app-links": `select l.app, l.requirement, l.subject, l.account, l.linked_by, l.created_at::text,
+    a.owner, a.active_deployment from hosted_app_account_links l join executor_apps a on a.id = l.app
+    order by l.app, l.requirement, l.account, l.subject nulls first limit 2001`,
+  "retired-tokens": `select a.id, a.owner, a.provider, a.method,
+    p.organization_id, p.creator_id, p.kind, p.revision
+    from executor_accounts a join hosted_account_access p on p.account_id = a.id
+    where p.kind = 'provisioned' order by a.id limit 2001`,
+  departures: `select id, organization_id, user_id, status, attempts,
+    available_at::text, updated_at::text from hosted_contributed_departure_jobs order by id limit 2001`,
+  workflows: `select id, app, owner, actor, name, status, "created_at"::text
+    from executor_workflow_runs order by id limit 2001`,
+  schedules: `select id, app, owner, actor, name, enabled, revision, next_at::text,
+    active_run from executor_schedules order by id limit 2001`,
+  reporters: `select id, account, owner, source, generation, checked_at::text,
+    next_allowed_at::text, lease_until::text from executor_account_observations order by id limit 2001`,
+} as const;
+
+export const inventory = (selection: string) =>
+  Effect.gen(function* () {
+    if (!Object.hasOwn(inventoryQueries, selection))
+      return yield* Effect.fail(new Error("Unknown inventory"));
+    const sql = yield* SqlClient.SqlClient;
+    const query = inventoryQueries[selection as keyof typeof inventoryQueries];
+    const rows = yield* sql
+      .unsafe(query)
+      .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Schema.Array(Schema.Json))));
+    if (rows.length > 2000) return yield* Effect.fail(new Error("Inventory exceeds its bound"));
+    return { selection, rows };
+  });
