diff --git a/apps/hosted/cloud/src/mcp-server.ts b/apps/hosted/cloud/src/mcp-server.ts
index c2df1f7..033dee5 100644
--- a/apps/hosted/cloud/src/mcp-server.ts
+++ b/apps/hosted/cloud/src/mcp-server.ts
@@ -24,6 +24,8 @@ import {
 } from "./infrastructure/telemetry.ts";
 import { workerBuild } from "./infrastructure/worker-build.ts";
 import { cloudSite } from "./infrastructure/site.ts";
+import { HttpServerRequest, HttpServerResponse } from "effect/http";
+import { cloudProductionOps, productionOpsPath } from "./infrastructure/production-ops/http.ts";
