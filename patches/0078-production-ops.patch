+++ b/e2e/support/production-ops-client.ts
@@ -0,0 +1,112 @@
+import { expect } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import {
+  constants,
+  createDecipheriv,
+  createHash,
+  createHmac,
+  generateKeyPairSync,
+  privateDecrypt,
+  randomUUID,
+} from "node:crypto";
+import { Actors } from "./actors.ts";
+import { Api } from "./api.ts";
+import { Target } from "./platform.ts";
+import { targetHosts } from "./role-hosts.ts";
+
+export const Artifact = Schema.Struct({
+  version: Schema.Literal(1),
+  sha256: Schema.String,
+  sealed: Schema.Struct({
+    version: Schema.Literal(1),
+    iv: Schema.String,
+    ciphertext: Schema.String,
+  }),
+  recipient: Schema.Struct({
+    version: Schema.Literal(1),
+    recipient: Schema.String,
+    wrappedKey: Schema.String,
+    iv: Schema.String,
+    ciphertext: Schema.String,
+  }),
+});
+export const Response = Schema.Struct({ action: Schema.String, artifact: Artifact });
+export const Inventory = Schema.Struct({
+  format: Schema.Literal("basalt-production-inventory-v1"),
+  target: Schema.String,
+  release: Schema.String,
+  database: Schema.Struct({ name: Schema.String, targetSha256: Schema.String }),
+  selection: Schema.String,
+  organization: Schema.String,
+  rows: Schema.Array(Schema.Json),
+});
+export const Backup = Schema.Struct({
+  format: Schema.Literal("basalt-production-backup-v1"),
+  target: Schema.String,
+  release: Schema.String,
+  tables: Schema.Array(Schema.String),
+  rows: Schema.Record(Schema.String, Schema.Array(Schema.Json)),
+});
+
+/** Sign real operator HTTP requests and independently decrypt recipient artifacts. */
+export const productionOpsClient = Effect.gen(function* () {
+  const api = yield* Api,
+    actors = yield* Actors,
+    target = yield* Target;
+  const origin = targetHosts(target).browser;
+  const anonymous = yield* api.session();
+  const pair = generateKeyPairSync("rsa", { modulusLength: 3072 });
+  const recipient = pair.publicKey.export({ type: "spki", format: "der" }).toString("base64");
+  const request = (
+    operation: unknown,
+    overrides: {
+      target?: string;
+      expiresAt?: number;
+      secret?: string;
+      tamper?: { from: string; to: string };
+    } = {},
+  ) => {
+    const at = Date.now();
+    const payload = Buffer.from(
+      JSON.stringify({
+        version: 1,
+        id: randomUUID(),
+        target: overrides.target ?? origin,
+        at,
+        expiresAt: overrides.expiresAt ?? at + 60_000,
+        operation,
+      }),
+    ).toString("base64url");
+    const signature = createHmac("sha256", Buffer.from(overrides.secret ?? "ab".repeat(32), "hex"))
+      .update(`sbops1.${payload}`)
+      .digest("base64url");
+    return api.request(anonymous, "POST", "/api/internal/production-ops", {
+      envelope: `sbops1.${overrides.tamper === undefined ? payload : Buffer.from(Buffer.from(payload, "base64url").toString("utf8").replace(overrides.tamper.from, overrides.tamper.to)).toString("base64url")}.${signature}`,
+    });
+  };
+  const read = (selection: string, organization = actors.organization.id) => ({
+    action: "inventory",
+    selection,
+    request: { organization },
+    recipient,
+  });
+  const decrypt = (artifact: typeof Artifact.Type) => {
+    const copy = artifact.recipient;
+    const key = privateDecrypt(
+      { key: pair.privateKey, padding: constants.RSA_PKCS1_OAEP_PADDING, oaepHash: "sha256" },
+      Buffer.from(copy.wrappedKey, "base64"),
+    );
+    const encrypted = Buffer.from(copy.ciphertext, "base64");
+    const decipher = createDecipheriv("aes-256-gcm", key, Buffer.from(copy.iv, "base64"));
+    decipher.setAAD(Buffer.from(`basalt-production-ops-v1:${origin}`));
+    decipher.setAuthTag(encrypted.subarray(-16));
+    const plaintext = Buffer.concat([
+      decipher.update(encrypted.subarray(0, -16)),
+      decipher.final(),
+    ]);
+    expect(createHash("sha256").update(plaintext).digest("hex")).toBe(artifact.sha256);
+    const value: unknown = JSON.parse(plaintext.toString("utf8"));
+    return value;
+  };
+  return { origin, recipient, request, read, decrypt };
+});
