+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Target } from "../support/platform.ts";
+import { scenarios } from "../test-plan.ts";
+import { fixtureRequest } from "../sdk/fixtures.ts";
+import { productionOpsInventoryRows } from "../support/production-ops-inventory-rows.ts";
+import {
+  productionOpsClient,
+  Response,
+  Inventory,
+  Backup,
+} from "../support/production-ops-client.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Production operations", (it) => {
+  it.effect(scenarios.cloudProductionOps.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors;
+        const { origin, recipient, request, read, decrypt } = yield* productionOpsClient;
+
+        expect(
+          (yield* api.request(actors.owner, "POST", "/api/internal/production-ops", {})).status,
+        ).toBe(409);
+        expect((yield* request(read("organizations"), { secret: "cd".repeat(32) })).status).toBe(
+          401,
+        );
+        expect(
+          (yield* request(read("organizations"), { target: "https://another.example.test" }))
+            .status,
+        ).toBe(401);
+        expect((yield* request(read("organizations"), { expiresAt: Date.now() - 1 })).status).toBe(
+          401,
+        );
+        expect((yield* request(read("select * from account"))).status).toBe(409);
+
+        for (const selection of [
+          "organizations",
+          "accounts",
+          "pools",
+          "app-links",
+          "retired-tokens",
+          "departures",
+          "workflows",
+          "schedules",
+          "reporters",
+          "receipts",
+        ] as const) {
+          const response = yield* request(read(selection));
+          expect(response.status).toBe(200);
+          const encrypted = yield* body(Response, response);
+          expect(JSON.stringify(response.body)).not.toContain("@example.test");
+          const inventory = yield* Schema.decodeUnknownEffect(Inventory)(
+            decrypt(encrypted.artifact),
+          );
+          expect(inventory.selection).toBe(selection);
+          expect(inventory.organization).toBe(actors.organization.id);
+          expect(inventory.target).toBe(origin);
+          expect(inventory.release).toMatch(/^[a-f0-9]{40}$/);
+          if (selection === "organizations") {
+            expect(inventory.rows.length).toBeGreaterThan(0);
+            const rows = yield* Schema.decodeUnknownEffect(
+              Schema.Array(Schema.Struct({ organization: Schema.String })),
+            )(inventory.rows);
+            for (const row of rows) expect(row.organization).toBe(actors.organization.id);
+          }
+        }
+        expect((yield* request({ ...read("accounts"), request: {} })).status).toBe(401);
+        expect(
+          (yield* request({
+            ...read("accounts"),
+            request: { organization: "missing-organization" },
+          })).status,
+        ).toBe(409);
+        for (const organization of ["", 1, "x".repeat(257)]) {
+          expect((yield* request({ ...read("accounts"), request: { organization } })).status).toBe(
+            401,
+          );
+        }
+        expect(
+          (yield* request(read("accounts"), {
+            tamper: { from: actors.organization.id, to: "forged-organization" },
+          })).status,
+        ).toBe(401);
+        const before = yield* body(Response, yield* request(read("accounts")));
+        const snapshotResponse = yield* request({
+          action: "backup",
+          selection: "accounts",
+          request: { organization: actors.organization.id },
+          recipient,
+        });
+        expect(snapshotResponse.status).toBe(200);
+        const snapshot = yield* body(Response, snapshotResponse);
+        const backup = yield* Schema.decodeUnknownEffect(Backup)(decrypt(snapshot.artifact));
+        expect(backup.tables).toEqual([
+          "executor_account_identities",
+          "executor_accounts",
+          "executor_oauth_grants",
+          "executor_providers",
+          "hosted_account_access",
+          "hosted_account_groups",
+          "hosted_app_account_links",
+        ]);
+        expect(Object.keys(backup.rows).sort()).toEqual(backup.tables);
+        const after = yield* body(Response, yield* request(read("accounts")));
+        expect(
+          (yield* Schema.decodeUnknownEffect(Inventory)(decrypt(after.artifact))).rows,
+        ).toEqual((yield* Schema.decodeUnknownEffect(Inventory)(decrypt(before.artifact))).rows);
+        for (const action of ["backup", "prepare", "dry-run", "apply"])
+          expect(
+            (yield* request({
+              action,
+              selection: "unregistered",
+              request: { organization: actors.organization.id },
+              recipient,
+            })).status,
+          ).toBe(409);
+        expect(
+          (yield* request({
+            action: "backup",
+            selection: "account;drop-table",
+            request: { organization: actors.organization.id },
+            recipient,
+          })).status,
+        ).toBe(409);
+      }),
+    ),
+  );
+
+  it.effect(scenarios.cloudProductionOpsBinding.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const target = yield* Target;
+        const { request, read, decrypt } = yield* productionOpsClient;
+        if (target.fixtures === undefined) return yield* Effect.die("Cloud fixture required");
+        const fixtures = target.fixtures;
+        const originalResponse = yield* body(Response, yield* request(read("organizations")));
+        const original = yield* Schema.decodeUnknownEffect(Inventory)(
+          decrypt(originalResponse.artifact),
+        );
+        yield* fixtureRequest(
+          fixtures,
+          "/runtime/database-binding",
+          { binding: "alternate" },
+          "5 minutes",
+        );
+        const changed = yield* body(Response, yield* request(read("organizations")));
+        const changedInventory = yield* Schema.decodeUnknownEffect(Inventory)(
+          decrypt(changed.artifact),
+        );
+        expect(changedInventory.database.name).toBe(original.database.name);
+        expect(changedInventory.database.targetSha256).not.toBe(original.database.targetSha256);
+        expect(changedInventory.rows).toEqual(original.rows);
+      }),
+    ),
+  );
+
+  it.effect(scenarios.cloudProductionOpsScope.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const { request, read, decrypt, recipient } = yield* productionOpsClient;
+        const accounts = yield* productionOpsInventoryRows;
+        for (const [wanted, excluded] of [
+          [accounts.own, accounts.foreign],
+          [accounts.foreign, accounts.own],
+        ] as const) {
+          const expected = {
+            organizations: ["organization", wanted.organization],
+            accounts: ["id", wanted.account],
+            pools: ["app", wanted.app],
+            "app-links": ["app", wanted.app],
+            "retired-tokens": ["id", wanted.account],
+            departures: ["id", wanted.job],
+            workflows: ["id", wanted.workflow],
+            schedules: ["id", wanted.schedule],
+            reporters: ["id", wanted.reporter],
+            receipts: ["plan_sha256", wanted.receipt],
+          } as const;
+          for (const [selection, match] of Object.entries(expected)) {
+            const response = yield* request(read(selection, wanted.organization));
+            expect(response.status).toBe(200);
+            const encrypted = yield* body(Response, response);
+            const inventory = yield* Schema.decodeUnknownEffect(Inventory)(
+              decrypt(encrypted.artifact),
+            );
+            expect(inventory.organization).toBe(wanted.organization);
+            const rows = yield* Schema.decodeUnknownEffect(
+              Schema.Array(Schema.Record(Schema.String, Schema.Unknown)),
+            )(inventory.rows);
+            expect(
+              rows.some((row) => row[match[0]] === match[1]),
+              selection,
+            ).toBe(true);
+            for (const forbidden of [
+              excluded.organization,
+              excluded.account,
+              excluded.app,
+              excluded.job,
+              excluded.workflow,
+              excluded.schedule,
+              excluded.reporter,
+              excluded.receipt,
+            ])
+              expect(JSON.stringify(rows)).not.toContain(forbidden);
+            if (selection === "retired-tokens")
+              expect(rows.map((row) => row.id)).toEqual([wanted.account]);
+          }
+        }
+        const snapshot = yield* request({
+          action: "backup",
+          selection: "accounts",
+          request: { organization: accounts.own.organization },
+          recipient,
+        });
+        expect(snapshot.status).toBe(200);
+        const backup = yield* Schema.decodeUnknownEffect(Backup)(
+          decrypt((yield* body(Response, snapshot)).artifact),
+        );
+        const retained = yield* Schema.decodeUnknownEffect(
+          Schema.Array(Schema.Struct({ id: Schema.String })),
+        )(backup.rows.executor_accounts);
+        expect(retained.some((row) => row.id === accounts.own.account)).toBe(true);
+        expect(retained.some((row) => row.id === accounts.foreign.account)).toBe(true);
+      }),
+    ),
+  );
+});
