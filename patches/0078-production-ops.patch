+import { expect } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { randomUUID } from "node:crypto";
+import { Actors } from "./actors.ts";
+import { Target } from "./platform.ts";
+import { cloudLocks } from "./cloud-locks.ts";
+import { productionOpsAccount } from "./production-ops-account.ts";
+import { FixtureActors, fixtureRequest } from "../sdk/fixtures.ts";
+
+/** All direct rows are synthetic and confined to the managed Cloud's disposable database. */
+export const productionOpsRows = Effect.gen(function* () {
+  const actors = yield* Actors,
+    target = yield* Target,
+    database = yield* cloudLocks;
+  if (target.fixtures === undefined) return yield* Effect.die("Managed Cloud required");
+  const fixtures = target.fixtures;
+  const outsideId = randomUUID().replaceAll("-", "");
+  yield* Effect.addFinalizer(() =>
+    fixtureRequest(fixtures, "/remove", { id: outsideId }).pipe(Effect.orDie),
+  );
+  const outside = yield* fixtureRequest(fixtures, "/actors", {
+    id: outsideId,
+    label: "Operations foreign organization",
+  }).pipe(Effect.flatMap(Schema.decodeUnknownEffect(FixtureActors)));
+  const original = yield* productionOpsAccount(actors.owner, actors.organization.id);
+  const id = () => randomUUID();
+  const ownUsers = yield* database
+    .run({
+      sql: 'select "userId" as id from member where "organizationId" = $1 and role = $2',
+      params: [actors.organization.id, "owner"],
+    })
+    .pipe(
+      Effect.flatMap(
+        Schema.decodeUnknownEffect(Schema.Array(Schema.Struct({ id: Schema.String }))),
+      ),
+    );
+  const ownUser = ownUsers[0];
+  if (ownUser === undefined) return yield* Effect.die("Fixture owner missing");
+  const own = {
+    organization: actors.organization.id,
+    user: ownUser.id,
+    account: id(),
+    app: id(),
+    deployment: id(),
+    connection: id(),
+    grant: id(),
+    identity: id(),
+  };
+  const foreign = {
+    organization: outside.organization.id,
+    user: outside.actors.owner.userId,
+    account: id(),
+    app: id(),
+    deployment: id(),
+    connection: id(),
+    grant: id(),
+    identity: id(),
+  };
+  // Registered before writes so partial setup failures release every synthetic reference too.
+  yield* Effect.addFinalizer(() =>
+    Effect.gen(function* () {
+      for (const row of [own, foreign]) {
+        yield* database.run({
+          sql: "delete from hosted_app_account_links where app = $1",
+          params: [row.app],
+        });
+        yield* database.run({
+          sql: "delete from executor_account_connections where id = $1",
+          params: [row.connection],
+        });
+        yield* database.run({ sql: "delete from executor_apps where id = $1", params: [row.app] });
+        yield* database.run({
+          sql: "delete from executor_accounts where id = $1",
+          params: [row.account],
+        });
+        yield* database.run({
+          sql: "delete from executor_deployments where id = $1",
+          params: [row.deployment],
+        });
+        yield* database.run({
+          sql: "delete from executor_oauth_grants where id = $1",
+          params: [row.grant],
+        });
+        yield* database.run({
+          sql: "delete from executor_account_identities where id = $1",
+          params: [row.identity],
+        });
+        yield* database.run({
+          sql: "delete from private_production_ops_receipts where organization_id = $1 and migration = 'scope-proof'",
+          params: [row.organization],
+        });
+      }
+    }).pipe(Effect.orDie),
+  );
+  for (const row of [own, foreign]) {
+    const owner = `organization:${row.organization}`;
+    yield* database.run({
+      sql: `insert into executor_accounts select (jsonb_populate_record(null::executor_accounts, to_jsonb(a) || jsonb_build_object('id', $2::text, 'owner', $3::text, 'identity_id', null, 'oauth_grant_id', null))).* from executor_accounts a where a.id = $1`,
+      params: [original.account, row.account, owner],
+    });
+    yield* database.run({
+      sql: `insert into executor_deployments select (jsonb_populate_record(null::executor_deployments, to_jsonb(d) || jsonb_build_object('id', $2::text, 'owner', $3::text))).* from executor_apps a join executor_deployments d on d.id = a.active_deployment where a.id = $1`,
+      params: [original.app, row.deployment, owner],
+    });
+    yield* database.run({
+      sql: `insert into executor_apps select (jsonb_populate_record(null::executor_apps, to_jsonb(a) || jsonb_build_object('id', $2::text, 'owner', $3::text, 'active_deployment', $4::text, 'name', $2::text, 'slug', $2::text))).* from executor_apps a where a.id = $1`,
+      params: [original.app, row.app, owner, row.deployment],
+    });
+    yield* database.run({
+      sql: `insert into executor_account_connections (id, owner, provider, state, revision, created_at, expires_at, target) select $2, $3, provider, '{}'::jsonb, 'fixture', now(), now() + interval '1 hour', '{}'::jsonb from executor_accounts where id = $1`,
+      params: [original.account, row.connection, owner],
+    });
+    yield* database.run({
+      sql: `insert into executor_oauth_grants (id, owner, encrypted, status, updated_at) values ($1, $2, decode('00', 'hex'), 'active', now())`,
+      params: [row.grant, owner],
+    });
+    yield* database.run({
+      sql: `insert into executor_account_identities (id, owner, placement, issuer, subject, name, label, verified_at, created_at) values ($1, $2, 'personal', 'https://identity.example.test', $3, 'Synthetic identity', 'Synthetic identity', now(), now())`,
+      params: [row.identity, owner, row.user],
+    });
+    yield* database.run({
+      sql: `insert into hosted_app_account_links (app, requirement, account, subject, linked_by) values ($1, 'scope-proof', $2, $3, $3)`,
+      params: [row.app, row.account, row.user],
+    });
+  }
+  const account = (value = own.account) =>
+    database.run({
+      sql: "select to_jsonb(a) as row from executor_accounts a where id = $1",
+      params: [value],
+    });
+  const snapshot = database.run({
+    sql: `select
+      (select jsonb_agg(to_jsonb(a) order by id) from executor_accounts a where id = any($1::text[])) as accounts,
+      (select jsonb_agg(to_jsonb(a) order by id) from executor_apps a where id = any($2::text[])) as apps,
+      (select jsonb_agg(to_jsonb(a) order by id) from executor_account_connections a where id = any($3::text[])) as connections,
+      (select jsonb_agg(to_jsonb(a) order by app, subject) from hosted_app_account_links a where app = any($2::text[])) as links`,
+    params: [
+      `{${own.account},${foreign.account}}`,
+      `{${own.app},${foreign.app}}`,
+      `{${own.connection},${foreign.connection}}`,
+    ],
+  });
+  expect((yield* account()).length).toBe(1);
+  return { own, foreign, database, account, snapshot };
+});
