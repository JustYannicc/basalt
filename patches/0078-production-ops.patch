@@ -0,0 +1,4 @@
+import type { ProductionMigration } from "./contracts.ts";
+
+/** Migration modules land with their owning feature and remain inert until an exact-ID GO. */
+export const productionMigrations: Readonly<Record<string, ProductionMigration>> = {};
