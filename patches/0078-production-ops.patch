index 0000000..a47083f
--- /dev/null
+++ b/e2e/support/cloud-runtime-control.ts
@@ -0,0 +1,72 @@
+/** Runner-only control of the disposable Cloud process, never installed in a product Worker. */
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Effect, Layer, Redacted, Schema } from "effect";
+import {
+  HttpClient,
+  HttpClientRequest,
+  HttpRouter,
+  HttpServer,
+  HttpServerRequest,
+  HttpServerResponse,
+} from "effect/http";
+import { createServer } from "node:http";
+import type { FixtureControl } from "../sdk/contracts.ts";
+
+const Change = Schema.Struct({ binding: Schema.Literals(["original", "alternate"]) });
+
+/** Preserve the existing fixture capability while adding one fixed local runtime operation. */
+export const cloudRuntimeControl = <A, E>(
+  fixtures: typeof FixtureControl.Type,
+  change: (binding: "original" | "alternate") => Effect.Effect<A, E>,
+) =>
+  Effect.gen(function* () {
+    const http = yield* HttpClient.HttpClient;
+    let changing = false;
+    const handler = Effect.gen(function* () {
+      const request = yield* HttpServerRequest.HttpServerRequest;
+      if (request.headers.authorization !== `Bearer ${Redacted.value(fixtures.token)}`)
+        return HttpServerResponse.empty({ status: 401 });
+      if (request.url === "/runtime/database-binding" && request.method === "POST") {
+        const input = yield* request.json.pipe(Effect.flatMap(Schema.decodeUnknownEffect(Change)));
+        if (changing) return HttpServerResponse.empty({ status: 409 });
+        changing = true;
+        const result = yield* change(input.binding).pipe(
+          Effect.ensuring(
+            Effect.sync(() => {
+              changing = false;
+            }),
+          ),
+        );
+        return HttpServerResponse.jsonUnsafe(result);
+      }
+      let forward = HttpClientRequest.make(request.method)(`${fixtures.origin}${request.url}`).pipe(
+        HttpClientRequest.setHeaders(request.headers),
+      );
+      if (request.method !== "GET" && request.method !== "HEAD")
+        forward = HttpClientRequest.bodyText(
+          forward,
+          yield* request.text,
+          request.headers["content-type"],
+        );
+      const response = yield* http.execute(forward);
+      return HttpServerResponse.uint8Array(new Uint8Array(yield* response.arrayBuffer), {
+        status: response.status,
+        headers: response.headers,
+      });
+    }).pipe(
+      Effect.catchCause(() =>
+        HttpServerResponse.json({ error: "runtime_control_failed" }, { status: 503 }),
+      ),
+    );
+    const services = yield* Layer.build(
+      HttpRouter.serve(HttpRouter.add("*", "/*", handler), {
+        disableLogger: true,
+        disableListenLog: true,
+      }).pipe(
+        Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 })),
+      ),
+    );
+    const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+    if (!("port" in server.address)) return yield* Effect.die("Cloud runtime control requires TCP");
+    return { origin: `http://127.0.0.1:${server.address.port}`, token: fixtures.token };
+  });
