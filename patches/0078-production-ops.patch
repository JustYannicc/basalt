+});
diff --git a/apps/hosted/cloud/src/infrastructure/production-ops/scope.ts b/apps/hosted/cloud/src/infrastructure/production-ops/scope.ts
new file mode 100644
index 0000000000000000000000000000000000000000..488484426b7a0c8b21a6b1ac71576ee84a7edc92
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/production-ops/scope.ts
@@ -0,0 +1,162 @@
+import { Effect, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import type { Change, MigrationPlan } from "./contracts.ts";
+
+export const OrganizationRequest = Schema.StructWithRest(
+  Schema.Struct({ organization: Schema.NonEmptyString.check(Schema.isMaxLength(256)) }),
+  [Schema.Record(Schema.String, Schema.Json)],
+);
+
+const owner = "entry.owner = 'organization:' || $1";
+const organization = "entry.organization_id = $1";
+const owned = (table: string, key: string) =>
+  `exists (select 1 from ${table} related where related.id = entry.${key} and related.owner = 'organization:' || $1)`;
+const optional = (key: string, predicate: string) => `(entry.${key} is null or ${predicate})`;
+const account = (key: string) => owned("executor_accounts", key);
+const app = (key: string) => owned("executor_apps", key);
+const member = (key: string) =>
+  `exists (select 1 from member m where m."userId" = entry.${key} and m."organizationId" = $1)`;
+const grant = (id: string) => `exists (select 1 from executor_oauth_grants g where g.id = ${id}
+  and (g.owner = 'organization:' || $1 or (g.owner is null
+    and exists (select 1 from executor_accounts a where coalesce(a.oauth_grant_id, a.id) = g.id and a.owner = 'organization:' || $1)
+    and not exists (select 1 from executor_accounts a where coalesce(a.oauth_grant_id, a.id) = g.id and a.owner <> 'organization:' || $1))))`;
+// OAuth falls back to the account ID; other auth methods can have no grant at all.
+const accountGrant = `(${grant("coalesce(entry.oauth_grant_id, entry.id)")}
+  or (entry.oauth_grant_id is null and not exists
+    (select 1 from executor_oauth_grants g where g.id = entry.id)))`;
+
+interface RowScope {
+  readonly keys: readonly string[];
+  readonly predicate: string;
+}
+const id = (predicate: string): RowScope => ({ keys: ["id"], predicate });
+
+/** Identities come from the table schema, never from mutable ownership filters supplied by a module. */
+const scopes: Readonly<Record<string, RowScope>> = {
+  organization: id("entry.id = $1"),
+  member: id('entry."organizationId" = $1'),
+  executor_accounts: id(
+    `${owner} and ${optional("identity_id", owned("executor_account_identities", "identity_id"))} and ${accountGrant}`,
+  ),
+  executor_account_identities: id(owner),
+  executor_oauth_grants: id(grant("entry.id")),
+  executor_account_acquisitions: {
+    keys: ["account"],
+    predicate: `${owner} and ${account("account")}`,
+  },
+  executor_account_connections: id(
+    `${owner} and ${optional("source_account", account("source_account"))} and ${optional("reconnect_account", account("reconnect_account"))}`,
+  ),
+  hosted_account_access: {
+    keys: ["account_id"],
+    predicate: `${organization} and ${account("account_id")}`,
+  },
+  hosted_account_groups: {
+    keys: ["account_id", "group_id"],
+    predicate: `${organization} and ${account("account_id")}`,
+  },
+  hosted_account_observation_access: {
+    keys: ["account_id"],
+    predicate: `${organization} and ${account("account_id")}`,
+  },
+  hosted_app_account_links: {
+    keys: ["app", "requirement", "account", "subject"],
+    predicate: `${app("app")} and ${account("account")} and ${optional("subject", member("subject"))}`,
+  },
+  hosted_app_access: id(`${organization} and ${app("id")}`),
+  hosted_app_groups: {
+    keys: ["app_id", "group_id"],
+    predicate: `${organization} and ${app("app_id")}`,
+  },
+  hosted_groups: id(organization),
+  hosted_group_members: {
+    keys: ["group_id", "member_id"],
+    predicate: `exists (select 1 from hosted_groups g join member m on m.id = entry.member_id where g.id = entry.group_id and g.organization_id = $1 and m."organizationId" = $1)`,
+  },
+  executor_apps: id(
+    `${owner} and ${optional("active_deployment", owned("executor_deployments", "active_deployment"))}`,
+  ),
+  executor_deployments: id(owner),
+  hosted_contributed_departure_jobs: id(organization),
+  hosted_contributed_departures: {
+    keys: ["job", "app", "requirement", "account"],
+    predicate: `exists (select 1 from hosted_contributed_departure_jobs j where j.id = entry.job and j.organization_id = $1) and ${app("app")} and ${account("account")}`,
+  },
+  executor_account_observations: id(`${owner} and ${account("account")}`),
+  executor_schedules: id(
+    `${owner} and ${app("app")} and ${optional("active_run", owned("executor_workflow_runs", "active_run"))}`,
+  ),
+  executor_workflow_runs: id(
+    `${owner} and ${app("app")} and ${owned("executor_deployments", "deployment")}`,
+  ),
+};
+
+export const requireOrganization = (organization: string) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const rows = yield* sql`select id from organization where id = ${organization}`;
+    if (rows.length !== 1) return yield* Effect.fail(new Error("Organization unavailable"));
+  });
+
+/** Lock declared existing rows before apply; inspect the same stable identities after writes and on replay. */
+export const checkPlanScope = (
+  plan: MigrationPlan,
+  organization: string,
+  phase: "before" | "after",
+  lock = false,
+) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const tables = new Map<string, Change[]>();
+    for (const change of plan.changes) {
+      const scope = Object.hasOwn(scopes, change.table) ? scopes[change.table] : undefined;
+      if (scope === undefined)
+        return yield* Effect.fail(new Error("Migration table has no organization scope"));
+      if (
+        Object.keys(change.key).sort().join("\0") !== [...scope.keys].sort().join("\0") ||
+        scope.keys.some(
+          (key) =>
+            change.key[key] === null &&
+            !(change.table === "hosted_app_account_links" && key === "subject"),
+        )
+      )
+        return yield* Effect.fail(new Error("Invalid migration row identity"));
+      const group = tables.get(change.table) ?? [];
+      group.push(change);
+      tables.set(change.table, group);
+    }
+    for (const [table, changes] of tables) {
+      const scope = scopes[table]!;
+      const rows = yield* sql
+        .unsafe(
+          `select expected.value ->> 'index' as index, actual.scoped
+        from jsonb_array_elements($2::jsonb) expected
+        left join lateral (
+          select coalesce((${scope.predicate}), false) as scoped from "${table}" entry
+          where ${scope.keys.map((key) => `entry."${key}" is not distinct from (expected.value -> 'key' ->> '${key}')`).join(" and ")}
+          limit 2 ${lock ? "for update of entry" : ""}
+        ) actual on true`,
+          [
+            organization,
+            JSON.stringify(changes.map((change, index) => ({ index, key: change.key }))),
+          ],
+        )
+        .pipe(
+          Effect.flatMap(
+            Schema.decodeUnknownEffect(
+              Schema.Array(
+                Schema.Struct({ index: Schema.String, scoped: Schema.NullOr(Schema.Boolean) }),
+              ),
+            ),
+          ),
+        );
+      for (const [index, change] of changes.entries()) {
+        const matches = rows.filter((row) => row.index === String(index) && row.scoped !== null);
+        const absent = phase === "before" ? change.action === "insert" : change.action === "delete";
+        if (absent ? matches.length !== 0 : matches.length !== 1 || matches[0]?.scoped !== true)
+          return yield* Effect.fail(
+            new Error("Migration row is outside the selected organization"),
+          );
+      }
+    }
+  });
