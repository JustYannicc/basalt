+import { Effect } from "effect";
+import { randomUUID } from "node:crypto";
+import { productionOpsRows } from "./production-ops-rows.ts";
+
+/** Populate every named projection with owned and foreign retained rows. No extra app builds. */
+export const productionOpsInventoryRows = Effect.gen(function* () {
+  const fixture = yield* productionOpsRows;
+  const { database } = fixture;
+  const decorate = (row: typeof fixture.own) => ({
+    ...row,
+    personal: randomUUID(),
+    shared: randomUUID(),
+    job: randomUUID(),
+    workflow: randomUUID(),
+    schedule: randomUUID(),
+    reporter: randomUUID(),
+    receipt: randomUUID(),
+  });
+  const own = decorate(fixture.own),
+    foreign = decorate(fixture.foreign);
+  yield* Effect.addFinalizer(() =>
+    Effect.gen(function* () {
+      for (const row of [own, foreign]) {
+        yield* database.run({
+          sql: "delete from executor_schedules where id = $1",
+          params: [row.schedule],
+        });
+        yield* database.run({
+          sql: "delete from executor_workflow_runs where id = $1",
+          params: [row.workflow],
+        });
+        yield* database.run({
+          sql: "delete from executor_account_observations where id = $1",
+          params: [row.reporter],
+        });
+        yield* database.run({
+          sql: "delete from hosted_contributed_departure_jobs where id = $1",
+          params: [row.job],
+        });
+        yield* database.run({
+          sql: "delete from private_production_ops_receipts where plan_sha256 = $1",
+          params: [row.receipt],
+        });
+        yield* database.run({
+          sql: "delete from executor_accounts where id = $1 or id = $2",
+          params: [row.personal, row.shared],
+        });
+        yield* database.run({
+          sql: "delete from executor_providers where id = $1",
+          params: [row.personal],
+        });
+      }
+    }).pipe(Effect.orDie),
+  );
+  for (const row of [own, foreign]) {
+    const owner = `organization:${row.organization}`;
+    yield* database.run({
+      sql: "update executor_accounts set method = 'token', label = 'Pool access (retired)' where id = $1",
+      params: [row.account],
+    });
+    yield* database.run({
+      sql: `insert into hosted_account_access (account_id, organization_id, creator_id, kind, personal_user_id, audience) values ($1, $2, $3, 'personal', $3, null)`,
+      params: [row.account, row.organization, row.user],
+    });
+    yield* database.run({
+      sql: `insert into executor_providers (id, definition) select $2, definition from executor_providers where id = (select provider from executor_accounts where id = $1)`,
+      params: [row.account, row.personal],
+    });
+    // Same name is not evidence. The personal account has another provider; the shared token has the pool's exact provider.
+    yield* database.run({
+      sql: `insert into executor_accounts select (jsonb_populate_record(null::executor_accounts, to_jsonb(a) || jsonb_build_object('id', $2::text, 'provider', $2::text))).* from executor_accounts a where id = $1`,
+      params: [row.account, row.personal],
+    });
+    yield* database.run({
+      sql: `insert into executor_accounts select (jsonb_populate_record(null::executor_accounts, to_jsonb(a) || jsonb_build_object('id', $2::text))).* from executor_accounts a where id = $1`,
+      params: [row.account, row.shared],
+    });
+    yield* database.run({
+      sql: `insert into hosted_account_access (account_id, organization_id, creator_id, kind, personal_user_id, audience) values ($1, $3, $4, 'personal', $4, null), ($2, $3, $4, 'shared', null, 'everyone')`,
+      params: [row.personal, row.shared, row.organization, row.user],
+    });
+    yield* database.run({
+      sql: `update executor_deployments d set requirements = jsonb_set(d.requirements::jsonb, '{accounts,pool}', jsonb_build_object('provider', a.provider)) from executor_accounts a where d.id = $1 and a.id = $2`,
+      params: [row.deployment, row.account],
+    });
+    yield* database.run({
+      sql: `update organization set metadata = (coalesce(metadata::jsonb, '{}'::jsonb) || jsonb_build_object('basaltPools', jsonb_build_object($2::text, jsonb_build_object('app', $3::text))))::text where id = $1`,
+      params: [row.organization, row.user, row.app],
+    });
+    yield* database.run({
+      sql: `insert into hosted_contributed_departure_jobs (id, organization_id, user_id, status) values ($1, $2, $3, 'succeeded')`,
+      params: [row.job, row.organization, row.user],
+    });
+    yield* database.run({
+      sql: `insert into executor_workflow_runs (id, app, owner, start_key, deployment, name, accounts, status, encrypted, created_at) values ($1, $2, $3, $1, $4, 'scope-proof', '{}'::jsonb, 'succeeded', decode('00','hex'), now())`,
+      params: [row.workflow, row.app, owner, row.deployment],
+    });
+    yield* database.run({
+      sql: `insert into executor_schedules (id, app, owner, name, timing, enabled, approval_mode, revision) values ($1, $2, $3, 'scope-proof', '{}'::jsonb, false, 'manual', 'fixture')`,
+      params: [row.schedule, row.app, owner],
+    });
+    yield* database.run({
+      sql: `insert into executor_account_observations (id, account, owner, source, generation, next_allowed_at) select $1, id, owner, 'scope-proof', credential_generation, now() + interval '1 day' from executor_accounts where id = $2`,
+      params: [row.reporter, row.account],
+    });
+    yield* database.run({
+      sql: `insert into private_production_ops_receipts (plan_sha256, organization_id, migration, revision, release, backup_sha256, verification) values ($1, $2, 'inventory-proof', 'fixture', 'fixture', 'fixture', '{"ok":true}')`,
+      params: [row.receipt, row.organization],
+    });
+  }
+  const snapshot = Effect.all({
+    base: fixture.snapshot,
+    departures: database.run({
+      sql: "select to_jsonb(d) as row from hosted_contributed_departures d where job = $1 or job = $2 order by job, app, account",
+      params: [own.job, foreign.job],
+    }),
+    workflows: database.run({
+      sql: "select to_jsonb(w) as row from executor_workflow_runs w where id = $1 or id = $2 order by id",
+      params: [own.workflow, foreign.workflow],
+    }),
+    schedules: database.run({
+      sql: "select to_jsonb(s) as row from executor_schedules s where id = $1 or id = $2 order by id",
+      params: [own.schedule, foreign.schedule],
+    }),
+  });
+  return { ...fixture, own, foreign, database, snapshot };
+});
