@@ -0,0 +1,52 @@
+import type { Effect } from "effect";
+import type { SqlClient } from "effect/sql";
+
+export type Json =
+  | null
+  | boolean
+  | number
+  | string
+  | readonly Json[]
+  | { readonly [key: string]: Json };
+
+export interface Change {
+  readonly table: string;
+  readonly key: Readonly<Record<string, string>>;
+  readonly action: "insert" | "update" | "delete";
+  readonly beforeSha256: string | null;
+  readonly afterSha256: string | null;
+}
+
+export interface MigrationPlan {
+  readonly changes: readonly Change[];
+  readonly data: Json;
+}
+
+export interface Verification {
+  readonly ok: boolean;
+  readonly checks: Readonly<Record<string, boolean>>;
+}
+
+/** The runner owns transactions, backup binding, authorization and receipts. Modules perform SQL only. */
+export interface ProductionMigration {
+  readonly name: string;
+  readonly revision: string;
+  readonly tables: readonly string[];
+  readonly inspect: (request: Json) => Effect.Effect<MigrationPlan, unknown, SqlClient.SqlClient>;
+  readonly apply: (
+    request: Json,
+    plan: MigrationPlan,
+  ) => Effect.Effect<void, unknown, SqlClient.SqlClient>;
+  readonly verify: (
+    request: Json,
+    plan: MigrationPlan,
+  ) => Effect.Effect<Verification, unknown, SqlClient.SqlClient>;
+}
+
+/** Network proof collection has a separate, read-only operation before migration inspection. */
+export interface ProductionPreparation {
+  readonly name: string;
+  readonly run: (request: Json) => Effect.Effect<Json, unknown, SqlClient.SqlClient>;
+}
+
+export const productionOpsPath = "/api/internal/production-ops";
diff --git a/apps/hosted/cloud/src/infrastructure/production-ops/crypto.ts b/apps/hosted/cloud/src/infrastructure/production-ops/crypto.ts
new file mode 100644
index 0000000..3a9af56
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/production-ops/crypto.ts
@@ -0,0 +1,131 @@
+import { createHash } from "node:crypto";
+import { Schema } from "effect";
+import type { Json } from "./contracts.ts";
+
+const encoder = new TextEncoder();
+const context = "basalt-production-ops-v1";
+const Sealed = Schema.Struct({
+  version: Schema.Literal(1),
+  iv: Schema.String,
+  ciphertext: Schema.String,
+});
+const Recipient = Schema.Struct({
+  version: Schema.Literal(1),
+  recipient: Schema.String,
+  wrappedKey: Schema.String,
+  iv: Schema.String,
+  ciphertext: Schema.String,
+});
+export const ProtectedArtifact = Schema.Struct({
+  version: Schema.Literal(1),
+  sha256: Schema.String,
+  sealed: Sealed,
+  recipient: Recipient,
+});
+export type ProtectedArtifact = typeof ProtectedArtifact.Type;
+
+/** Sorted object keys make the reviewed file hash independent of transport serialization. */
+export function canonical(value: unknown): string {
+  return JSON.stringify(value, (_key, entry: unknown) => {
+    if (entry === null || typeof entry !== "object" || Array.isArray(entry)) return entry;
+    return Object.fromEntries(
+      Object.entries(entry).sort(([left], [right]) => left.localeCompare(right, "en")),
+    );
+  });
+}
+
+export const sha256 = (value: string) => createHash("sha256").update(value).digest("hex");
+const bytes = (value: string) => Uint8Array.from(Buffer.from(value, "base64"));
+const base64 = (value: ArrayBuffer | Uint8Array) =>
+  Buffer.from(value instanceof Uint8Array ? value : new Uint8Array(value)).toString("base64");
+
+async function encryptionKey(secret: string, usage: "encrypt" | "decrypt") {
+  if (!/^[a-f0-9]{64}$/i.test(secret)) throw new Error("Invalid ops encryption key");
+  const source = await crypto.subtle.importKey(
+    "raw",
+    Uint8Array.from(Buffer.from(secret, "hex")),
+    "HKDF",
+    false,
+    ["deriveKey"],
+  );
+  return crypto.subtle.deriveKey(
+    {
+      name: "HKDF",
+      hash: "SHA-256",
+      salt: encoder.encode(context),
+      info: encoder.encode("artifacts"),
+    },
+    source,
+    { name: "AES-GCM", length: 256 },
+    false,
+    [usage],
+  );
+}
+
+/** The runner copy supports later apply; the recipient copy keeps recovery independent of runtime secrets. */
+export async function protectArtifact(
+  value: unknown,
+  secret: string,
+  recipient: string,
+  target: string,
+): Promise<ProtectedArtifact> {
+  const plaintext = encoder.encode(`${canonical(value)}\n`);
+  if (plaintext.byteLength > 8_000_000) throw new Error("Ops artifact exceeds its bound");
+  const aad = encoder.encode(`${context}:${target}`);
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+  const ciphertext = await crypto.subtle.encrypt(
+    { name: "AES-GCM", iv, additionalData: aad },
+    await encryptionKey(secret, "encrypt"),
+    plaintext,
+  );
+  const publicBytes = bytes(recipient);
+  const publicKey = await crypto.subtle.importKey(
+    "spki",
+    publicBytes,
+    { name: "RSA-OAEP", hash: "SHA-256" },
+    false,
+    ["encrypt"],
+  );
+  if ((publicKey.algorithm as RsaHashedKeyAlgorithm).modulusLength < 3072)
+    throw new Error("Ops recipient requires RSA 3072 or stronger");
+  const rawKey = crypto.getRandomValues(new Uint8Array(32));
+  const copyKey = await crypto.subtle.importKey("raw", rawKey, "AES-GCM", false, ["encrypt"]);
+  const copyIv = crypto.getRandomValues(new Uint8Array(12));
+  const copy = await crypto.subtle.encrypt(
+    { name: "AES-GCM", iv: copyIv, additionalData: aad },
+    copyKey,
+    plaintext,
+  );
+  const wrappedKey = await crypto.subtle.encrypt({ name: "RSA-OAEP" }, publicKey, rawKey);
+  return {
+    version: 1,
+    sha256: sha256(new TextDecoder().decode(plaintext)),
+    sealed: { version: 1, iv: base64(iv), ciphertext: base64(ciphertext) },
+    recipient: {
+      version: 1,
+      recipient: sha256(base64(publicBytes)),
+      wrappedKey: base64(wrappedKey),
+      iv: base64(copyIv),
+      ciphertext: base64(copy),
+    },
+  };
+}
+
+export async function openArtifact(
+  artifact: ProtectedArtifact,
+  secret: string,
+  target: string,
+): Promise<Json> {
+  const plaintext = await crypto.subtle.decrypt(
+    {
+      name: "AES-GCM",
+      iv: bytes(artifact.sealed.iv),
+      additionalData: encoder.encode(`${context}:${target}`),
+    },
+    await encryptionKey(secret, "decrypt"),
+    bytes(artifact.sealed.ciphertext),
+  );
+  const text = new TextDecoder("utf-8", { fatal: true }).decode(plaintext);
+  if (sha256(text) !== artifact.sha256) throw new Error("Ops artifact hash mismatch");
+  return Schema.decodeUnknownSync(Schema.Json)(JSON.parse(text));
+}
