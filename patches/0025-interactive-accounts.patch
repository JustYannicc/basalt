new file mode 100644
index 0000000..302dbed
--- /dev/null
+++ b/packages/sdk/src/implementation/interactive-cleanup.ts
@@ -0,0 +1,61 @@
+/** Bulk cleanup is bounded and advisory; a provider never vetoes the local purge. */
+import { Clock, Effect } from "effect";
+import type { InteractiveHost } from "../contracts/interactive-accounts.ts";
+import type { AccountId, OwnerId } from "../contracts/shared.ts";
+import { interactiveStepMillis } from "./interactive-runner.ts";
+/** Self-host's HTTP idle limit is 30 seconds; leave 10 seconds for the local mutation. */
+export const interactiveCleanupMillis = 20_000;
+/** Capture resolved handler calls while the app, version and linked credentials still exist. */
+export const prepareInteractiveCleanup = <E, E2>(
+  prepare: (
+    input: Parameters<InteractiveHost["remove"]>[0],
+  ) => Effect.Effect<Effect.Effect<void, E>, E2>,
+  input: { readonly owner: OwnerId; readonly accounts: readonly AccountId[] },
+) =>
+  Effect.gen(function* () {
+    const deadline = (yield* Clock.currentTimeMillis) + interactiveCleanupMillis;
+    const prepared = new Map<AccountId, Effect.Effect<void, E>>();
+    const warning = (account: AccountId) =>
+      Effect.logWarning("Interactive account cleanup could not be prepared; continuing deletion", {
+        account,
+      });
+    yield* Effect.forEach(
+      input.accounts,
+      (account) =>
+        prepare({ owner: input.owner, account }).pipe(
+          Effect.timeout(interactiveStepMillis),
+          Effect.tap((call) => Effect.sync(() => prepared.set(account, call))),
+          Effect.catchCause(() => warning(account)),
+        ),
+      { concurrency: 4, discard: true },
+    ).pipe(
+      Effect.timeout(interactiveCleanupMillis),
+      Effect.catchCause(() =>
+        Effect.forEach(
+          input.accounts.filter((account) => !prepared.has(account)),
+          warning,
+          { discard: true },
+        ),
+      ),
+    );
+    return Effect.gen(function* () {
+      const remaining = deadline - (yield* Clock.currentTimeMillis);
+      const pending = new Set(prepared.keys());
+      const warn = (account: AccountId) =>
+        Effect.logWarning("Interactive account cleanup did not finish after deletion", { account });
+      if (remaining <= 0) return yield* Effect.forEach([...pending], warn, { discard: true });
+      yield* Effect.forEach(
+        [...prepared],
+        ([account, call]) =>
+          call.pipe(
+            Effect.timeout(interactiveStepMillis),
+            Effect.catchCause(() => warn(account)),
+            Effect.tap(() => Effect.sync(() => pending.delete(account))),
+          ),
+        { concurrency: 4, discard: true },
+      ).pipe(
+        Effect.timeout(remaining),
+        Effect.catchCause(() => Effect.forEach([...pending], warn, { discard: true })),
+      );
+    });
+  });
diff --git a/packages/sdk/src/implementation/interactive-retirement-claims.ts b/packages/sdk/src/implementation/interactive-retirement-claims.ts
new file mode 100644
index 0000000..bfed8bb
--- /dev/null
+++ b/packages/sdk/src/implementation/interactive-retirement-claims.ts
@@ -0,0 +1,168 @@
+/** Durable explicit-retirement leases. No transaction escapes these helpers. */
+import { Clock, type Crypto, Effect, Option, Schema } from "effect";
+import {
+  InteractiveRetirementBusy,
+  InteractiveRetirementFailed,
+} from "../contracts/interactive-errors.ts";
+import type { ResourceLifecycle } from "../contracts/executor.ts";
+import {
+  StorageError,
+  type AccountId,
+  type AccountConnectionId,
+  type OwnerId,
+} from "../contracts/shared.ts";
+import { lockConnection, StoredState } from "./connection-state.ts";
+import { ownedAccount, publicAccount } from "./accounts.ts";
+import { query, transaction, type Query } from "./database.ts";
+const decode = Schema.decodeUnknownOption(StoredState),
+  encode = Schema.encodeSync(StoredState);
+/** The complete remove step is limited to 15 seconds, leaving 5 seconds to settle its lease. */
+export const retirementLeaseMillis = 20_000;
+export interface RetirementClaim {
+  readonly connection: AccountConnectionId;
+  readonly account: AccountId;
+  readonly owner: OwnerId;
+  readonly token: string;
+  readonly removed: boolean;
+}
+export const retirementRecords = (db: Query, owner: OwnerId) =>
+  query(() =>
+    db.findMany("accountConnections", {
+      where: (b) => b("owner", "=", owner),
+      orderBy: ["createdAt", "desc"],
+    }),
+  );
+export const makeRetirementClaims = (
+  db: Query,
+  crypto: Crypto.Crypto,
+  lifecycle?: ResourceLifecycle,
+) => {
+  const check = (input: { owner: OwnerId; accounts: readonly AccountId[] }) =>
+    Effect.gen(function* () {
+      const now = yield* Clock.currentTimeMillis;
+      const wanted = new Set(input.accounts);
+      for (const row of yield* retirementRecords(db, input.owner)) {
+        const state = decode(row.state);
+        if (
+          Option.isSome(state) &&
+          state.value.status === "completed" &&
+          wanted.delete(state.value.account.id)
+        ) {
+          const lease = state.value.interactive?.retirement;
+          if (lease?.token !== undefined && (lease.expiresAt ?? 0) > now)
+            return yield* new InteractiveRetirementBusy({ account: state.value.account.id });
+        }
+      }
+    });
+  const begin = (input: { owner: OwnerId; accounts: readonly AccountId[] }) =>
+    transaction(db, (tx) =>
+      Effect.gen(function* () {
+        const now = yield* Clock.currentTimeMillis;
+        const token = yield* crypto.randomUUIDv4.pipe(Effect.mapError(() => new StorageError()));
+        const wanted = new Set(input.accounts),
+          claims: RetirementClaim[] = [];
+        for (const record of yield* retirementRecords(tx, input.owner)) {
+          const parsed = decode(record.state);
+          if (
+            Option.isNone(parsed) ||
+            parsed.value.status !== "completed" ||
+            parsed.value.interactive === undefined ||
+            !wanted.delete(parsed.value.account.id)
+          )
+            continue;
+          const row = yield* lockConnection(
+            tx,
+            { connection: record.id, owner: input.owner },
+            crypto,
+          ).pipe(Effect.mapError(() => new StorageError()));
+          if (row.storedState.status !== "completed" || row.storedState.interactive === undefined)
+            return yield* new StorageError();
+          const state = row.storedState,
+            binding = row.storedState.interactive,
+            account = state.account.id;
+          const lease = binding.retirement;
+          // A legacy claim without an expiry is reclaimable too; it cannot block an upgrade forever.
+          if (lease?.token !== undefined && (lease.expiresAt ?? 0) > now)
+            return yield* new InteractiveRetirementBusy({ account });
+          const saved = yield* ownedAccount(tx, { account, owner: input.owner }).pipe(
+            Effect.mapError(() => new StorageError()),
+          );
+          yield* (lifecycle?.accountRetiring?.(yield* publicAccount(saved)) ?? Effect.void).pipe(
+            Effect.mapError(
+              () => new InteractiveRetirementFailed({ account, reason: "authority" }),
+            ),
+          );
+          for (const table of ["webhookAccounts", "workflowAccounts"] as const)
+            if (
+              (yield* query(() =>
+                tx.findFirst(table, { where: (b) => b("account", "=", account) }),
+              )) !== null
+            )
+              return yield* new InteractiveRetirementFailed({ account, reason: "active" });
+          yield* query(() =>
+            tx.updateMany("accountConnections", {
+              where: (b) => b("id", "=", row.id),
+              set: {
+                state: encode({
+                  ...state,
+                  interactive: {
+                    ...binding,
+                    retirement: {
+                      token,
+                      expiresAt: now + retirementLeaseMillis,
+                      removed: lease?.removed ?? false,
+                    },
+                  },
+                }),
+              },
+            }),
+          );
+          claims.push({
+            owner: input.owner,
+            account,
+            connection: row.id,
+            token,
+            removed: lease?.removed ?? false,
+          });
+        }
+        return claims;
+      }),
+    );
+  const current = (claim: RetirementClaim) =>
+    lockConnection(db, claim, crypto).pipe(
+      Effect.catchTag("AccountConnectionNotFound", () => Effect.succeed(undefined)),
+      Effect.mapError(() => new StorageError()),
+    );
+  const ensure = (claim: RetirementClaim) =>
+    Effect.gen(function* () {
+      const row = yield* current(claim);
+      if (
+        row?.storedState.status !== "completed" ||
+        row.storedState.interactive?.retirement?.token !== claim.token
+      )
+        return yield* new InteractiveRetirementBusy({ account: claim.account });
+    });
+  const release = (claim: RetirementClaim, removed: boolean) =>
+    transaction(db, () =>
+      Effect.gen(function* () {
+        const row = yield* current(claim);
+        if (
+          row?.storedState.status !== "completed" ||
+          row.storedState.interactive?.retirement?.token !== claim.token
+        )
+          return;
+        const state = row.storedState,
+          binding = state.interactive;
+        if (binding === undefined) return;
+        yield* query(() =>
+          db.updateMany("accountConnections", {
+            where: (b) => b("id", "=", row.id),
+            set: {
+              state: encode({ ...state, interactive: { ...binding, retirement: { removed } } }),
+            },
+          }),
+        );
+      }),
+    );
+  return { check, begin, ensure, release };
+};
diff --git a/packages/sdk/src/implementation/interactive-retirement.ts b/packages/sdk/src/implementation/interactive-retirement.ts
new file mode 100644
index 0000000..70c8aeb
--- /dev/null
+++ b/packages/sdk/src/implementation/interactive-retirement.ts
@@ -0,0 +1,128 @@
+/** Explicit retirement validates, leases, invokes without SQL, then rechecks and commits. */
+import { type Crypto, Effect, Option, Schema } from "effect";
+import { InteractiveRemovalDone, type InteractiveHost } from "../contracts/interactive-accounts.ts";
+import { InteractiveRetirementFailed } from "../contracts/interactive-errors.ts";
+import { type AccountWebhooksActive, type AccountWorkflowsActive } from "../contracts/account.ts";
+import { StorageError, type AccountId, type OwnerId } from "../contracts/shared.ts";
+import type { ResourceLifecycle } from "../contracts/executor.ts";
+import { query, transaction, type Query } from "./database.ts";
+import { StoredState } from "./connection-state.ts";
+import { makeRetirementClaims, retirementRecords } from "./interactive-retirement-claims.ts";
+import { interactiveStepMillis } from "./interactive-runner.ts";
+import { validateRemovalChange } from "./removal-validation.ts";
+const decode = Schema.decodeUnknownOption(StoredState);
+export const makeInteractiveRetirement = (
+  db: Query,
+  crypto: Crypto.Crypto,
+  remove: InteractiveHost["remove"],
+  deleteAccount: (input: {
+    owner: OwnerId;
+    account: AccountId;
+  }) => Effect.Effect<unknown, StorageError | AccountWebhooksActive | AccountWorkflowsActive>,
+  lifecycle?: ResourceLifecycle,
+) => {
+  const leases = makeRetirementClaims(db, crypto, lifecycle);
+  const acquired: InteractiveHost["acquired"] = (input) =>
+    Effect.gen(function* () {
+      const present = new Set(
+        (yield* query(() =>
+          db.findMany("accounts", { select: ["id"], where: (b) => b("owner", "=", input.owner) }),
+        )).map((a) => a.id),
+      );
+      const ids = new Set<AccountId>();
+      for (const row of yield* retirementRecords(db, input.owner)) {
+        const parsed = decode(row.state);
+        if (
+          Option.isSome(parsed) &&
+          parsed.value.status === "completed" &&
+          parsed.value.interactive !== undefined &&
+          (input.app === undefined || parsed.value.interactive.app === input.app) &&
+          present.has(parsed.value.account.id)
+        )
+          ids.add(parsed.value.account.id);
+      }
+      return [...ids];
+    });
+  const retire: InteractiveHost["retire"] = (input, action) =>
+    Effect.gen(function* () {
+      const held = yield* InteractiveRemovalDone;
+      const accounts = input.accounts.filter((account) => !held.has(account));
+      const first = accounts[0];
+      if (first === undefined) return yield* action;
+      yield* leases.check({ ...input, accounts });
+      const change = Effect.gen(function* () {
+        const result = yield* action;
+        for (const account of accounts)
+          yield* deleteAccount({ owner: input.owner, account }).pipe(
+            Effect.mapError(() => new StorageError()),
+          );
+        return result;
+      }).pipe(Effect.provideService(InteractiveRemovalDone, new Set([...held, ...accounts])));
+      // Use the canonical mutation's complete checks, then roll back and release every SQL lock.
+      yield* validateRemovalChange(db, change);
+      const claims = yield* leases.begin({ ...input, accounts });
+      const removed = new Set(
+        claims.filter((claim) => claim.removed).map((claim) => claim.account),
+      );
+      return yield* Effect.gen(function* () {
+        yield* Effect.forEach(
+          claims,
+          (claim) =>
+            removed.has(claim.account)
+              ? Effect.void
+              : remove({ owner: input.owner, account: claim.account }).pipe(
+                  Effect.timeout(interactiveStepMillis),
+                  Effect.mapError(
+                    () =>
+                      new InteractiveRetirementFailed({ account: claim.account, reason: "remove" }),
+                  ),
+                  Effect.tap(() => Effect.sync(() => removed.add(claim.account))),
+                ),
+          { concurrency: 4, discard: true },
+        ).pipe(
+          Effect.timeout(interactiveStepMillis),
+          Effect.catchTag("TimeoutError", () =>
+            Effect.fail(new InteractiveRetirementFailed({ account: first, reason: "remove" })),
+          ),
+        );
+        return yield* transaction(db, () =>
+          Effect.gen(function* () {
+            for (const claim of claims) yield* leases.ensure(claim);
+            const result = yield* change;
+            for (const claim of claims) yield* leases.release(claim, removed.has(claim.account));
+            return result;
+          }),
+        );
+      }).pipe(
+        Effect.ensuring(
+          Effect.forEach(claims, (claim) => leases.release(claim, removed.has(claim.account)), {
+            discard: true,
+          }).pipe(
+            Effect.catch(() =>
+              Effect.logWarning(
+                "Interactive retirement claim could not be released; its lease will expire",
+              ),
+            ),
+          ),
+        ),
+      );
+    });
+  /** Bulk authority is the app/owner deletion. Its bound references cannot survive that app. */
+  const discard = (input: { owner: OwnerId; accounts: readonly AccountId[] }) =>
+    Effect.gen(function* () {
+      if (input.accounts.length === 0) return;
+      for (const table of ["webhookSources", "accountChecks"] as const)
+        yield* query(() =>
+          db.deleteMany(table, { where: (b) => b("account", "in", input.accounts) }),
+        );
+      yield* query(() =>
+        db.deleteMany("oauthGrants", { where: (b) => b("id", "in", input.accounts) }),
+      );
+      yield* query(() =>
+        db.deleteMany("accounts", {
+          where: (b) => b.and(b("owner", "=", input.owner), b("id", "in", input.accounts)),
+        }),
+      );
+    });
+  return { retire, acquired, discard };
+};
diff --git a/packages/sdk/src/implementation/interactive-runner.ts b/packages/sdk/src/implementation/interactive-runner.ts
new file mode 100644
index 0000000..085e742
--- /dev/null
+++ b/packages/sdk/src/implementation/interactive-runner.ts
@@ -0,0 +1,172 @@
+/** Run acquisition handlers through the ordinary app host, with current linked credentials. */
+import { Clock, type Crypto, Effect, Redacted, Schema } from "effect";
+import type { ConnectCommand, InteractiveStatus } from "apps/contracts";
+import { AccountId, StorageError, type OwnerId } from "../contracts/shared.ts";
+import {
+  InteractiveConnectionFailed,
+  type InteractiveBinding,
+} from "../contracts/interactive-accounts.ts";
+import type { AppAccounts } from "../contracts/apps.ts";
+import type { Credentials } from "../contracts/storage.ts";
+import type { Runtime } from "../contracts/runtime.ts";
+import type { ResourceLifecycle } from "../contracts/executor.ts";
+import type { makeOAuth } from "./oauth.ts";
+import { defaultLabel, ownedAccount, publicAccount } from "./accounts.ts";
+import { snapshot, resolve, resolveRemoval } from "./tools.ts";
+import { query, type Query } from "./database.ts";
+import type { ConnectionRow } from "./connection-state.ts";
+import { interactiveBinding } from "./interactive-state.ts";
+
+/** The limit includes credential resolution, app startup and the handler itself. */
+export const interactiveStepMillis = 15_000;
+
+/** Resolve the retained handler and credentials before a local mutation can remove their rows. */
+export const prepareInteractiveContext =
+  (db: Query, runtime: Runtime, resolveAccount: ReturnType<typeof makeOAuth>["resolveSelected"]) =>
+  (input: {
+    readonly owner: OwnerId;
+    readonly acquisition: Pick<InteractiveBinding, "app" | "slot" | "version">;
+    readonly accounts: AppAccounts;
+    readonly command: ConnectCommand;
+  }) =>
+    Effect.gen(function* () {
+      const state = yield* snapshot(db, {
+        app: input.acquisition.app,
+        version: input.acquisition.version,
+        accounts:
+          input.command.step !== "remove"
+            ? input.accounts
+            : {
+                app: Object.fromEntries(
+                  Object.entries(input.accounts.app).filter(
+                    ([slot]) => slot !== input.acquisition.slot,
+                  ),
+                ),
+                ...(input.accounts.user === undefined
+                  ? {}
+                  : {
+                      user: Object.fromEntries(
+                        Object.entries(input.accounts.user).filter(
+                          ([slot]) => slot !== input.acquisition.slot,
+                        ),
+                      ),
+                    }),
+              },
+        connecting: input.acquisition.slot,
+      });
+      if (state.app.owner !== input.owner) return yield* new StorageError();
+      const context = yield* input.command.step === "remove"
+        ? resolveRemoval(state, resolveAccount)
+        : resolve(state, resolveAccount);
+      return (command: ConnectCommand) =>
+        Effect.gen(function* () {
+          const bound = Redacted.value(context.accounts);
+          const omitSlot = <A>(slots: Readonly<Record<string, A>>) =>
+            Object.fromEntries(
+              Object.entries(slots).filter(([slot]) => slot !== input.acquisition.slot),
+            );
+          const accounts =
+            command.step === "remove"
+              ? Redacted.make({
+                  app: omitSlot(bound.app),
+                  ...(bound.user === undefined ? {} : { user: omitSlot(bound.user) }),
+                })
+              : context.accounts;
+          const deadline = (yield* Clock.currentTimeMillis) + interactiveStepMillis;
+          return yield* runtime.connect({
+            ...context,
+            accounts,
+            app: state.app.id,
+            build: state.version.build,
+            database: state.version.requirements.sql === true,
+            deadline,
+            command,
+          });
+        }).pipe(
+          Effect.timeout(interactiveStepMillis),
+          Effect.mapError(() => new InteractiveConnectionFailed({ reason: "step" })),
+        );
+    }).pipe(
+      Effect.timeout(interactiveStepMillis),
+      Effect.mapError((error) =>
+        Schema.is(StorageError)(error)
+          ? error
+          : new InteractiveConnectionFailed({ reason: "step" }),
+      ),
+      Effect.withSpan("sdk.connections.interactive.invoke"),
+    );
+
+/** A single command, or a retained context used to compensate an in-flight sign-in. */
+export const prepareInteractiveCall = (
+  ...services: Parameters<typeof prepareInteractiveContext>
+) => {
+  const prepare = prepareInteractiveContext(...services);
+  return (input: Parameters<typeof prepare>[0]) =>
+    prepare(input).pipe(Effect.map((invoke) => invoke(input.command)));
+};
+
+export const interactiveRunner = (...services: Parameters<typeof prepareInteractiveCall>) => {
+  const prepare = prepareInteractiveCall(...services);
+  return (input: Parameters<typeof prepare>[0]) =>
+    Effect.flatten(prepare(input)).pipe(Effect.timeout(interactiveStepMillis));
+};
+
+/** Save the opaque reference with the same name and product lifecycle used by other connects. */
+export const saveInteractiveAccount = (
+  db: Query,
+  credentials: Credentials,
+  crypto: Crypto.Crypto,
+  row: ConnectionRow,
+  binding: InteractiveBinding,
+  connected: Extract<InteractiveStatus, { readonly state: "connected" }>,
+  lifecycle: ResourceLifecycle | undefined,
+) =>
+  Effect.gen(function* () {
+    const existing =
+      row.reconnectAccount === null
+        ? undefined
+        : yield* ownedAccount(db, { account: row.reconnectAccount, owner: row.owner });
+    if (existing !== undefined) {
