+import { ApiError } from "@executor-js/utils/api-error";
+import { Schema } from "effect";
+
+const count = Schema.Int.check(Schema.isGreaterThanOrEqualTo(0));
+const hash = Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/u));
+const label = Schema.NonEmptyString.check(Schema.isMaxLength(256));
+export const PoolUsageImportInput = Schema.Struct({
+  source: Schema.String.check(Schema.isPattern(/^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/u)),
+  format: Schema.Literal("cpamp-v1-jsonl"),
+  data: Schema.String.check(Schema.isMaxLength(8 * 1024 * 1024)),
+  offset: Schema.optionalKey(count),
+  mode: Schema.Literals(["dry-run", "apply"]),
+  approval: Schema.optionalKey(Schema.String.check(Schema.isMaxLength(4096))),
+  accountMappings: Schema.optionalKey(
+    Schema.Array(
+      Schema.Struct({
+        sourceAccountRef: hash,
+        targetAccountId: label,
+        provider: label,
+      }),
+    ).check(Schema.isMaxLength(500)),
+  ),
+});
+export type PoolUsageImportInput = typeof PoolUsageImportInput.Type;
+
+export const PoolUsageImportResult = Schema.Struct({
+  mode: Schema.Literals(["dry-run", "apply"]),
+  format: Schema.Literal("cpamp-v1-jsonl"),
+  accountMappingDigest: Schema.optionalKey(hash),
+  totalDetails: count,
+  pageDetails: count,
+  aggregateOnlyNotImportable: Schema.String,
+  indistinguishableDetails: count,
+  unpriced: count,
+  missingProvider: count,
+  missingEndpoint: count,
+  missingLatency: count,
+  missingPriceSnapshot: count,
+  existing: count,
+  wouldInsert: count,
+  inserted: count,
+  ids: Schema.Array(hash).check(Schema.isMaxLength(200)),
+  next: Schema.NullOr(count),
+  approval: Schema.NullOr(Schema.String),
+});
+
+export const PoolUsageImportRejected = ApiError.define({
+  tag: "PoolUsageImportRejected",
+  status: 409,
+  message: "Usage import was refused. Check the source and mapping, then run a new dry run.",
+  fields: {
+    reason: Schema.Literals(["invalid_query", "identity_conflict", "unauthorized", "unavailable"]),
+  },
+});
