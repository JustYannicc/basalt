--- /dev/null
+++ b/e2e/support/pool-usage-import-backend.ts
@@ -0,0 +1,115 @@
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Clock, Effect, Layer, Ref, Schema } from "effect";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { createHash, createHmac, timingSafeEqual } from "node:crypto";
+import { createServer } from "node:http";
+
+const Input = Schema.Struct({
+  source: Schema.String,
+  format: Schema.Literal("cpamp-v1-jsonl"),
+  data: Schema.String,
+  mode: Schema.Literals(["dry-run", "apply"]),
+  approval: Schema.optionalKey(Schema.String),
+  accountMappings: Schema.Array(
+    Schema.Struct({
+      sourceAccountRef: Schema.String,
+      targetAccountId: Schema.String,
+      provider: Schema.String,
+    }),
+  ),
+});
+const Assertion = Schema.Struct({
+  action: Schema.Literal("importUsage"),
+  pool: Schema.String,
+  organization: Schema.String,
+  owner: Schema.String,
+  user: Schema.String,
+  expiresAt: Schema.Number,
+  input: Input,
+});
+const hash = (value: string) => createHash("sha256").update(value).digest("hex");
+
+/** The real hosted product talks to this loopback implementation of the pool boundary. */
+export const poolUsageImportBackend = (owner: string) =>
+  Effect.gen(function* () {
+    const calls = yield* Ref.make<readonly (typeof Assertion.Type)[]>([]);
+    const retained = yield* Ref.make<ReadonlySet<string>>(new Set());
+    const handler = Effect.gen(function* () {
+      const request = yield* HttpServerRequest.HttpServerRequest;
+      const body = yield* request.json.pipe(
+        Effect.flatMap(Schema.decodeUnknownEffect(Schema.Struct({ envelope: Schema.String }))),
+      );
+      const [prefix, encoded, signature, extra] = body.envelope.split(".");
+      if (prefix !== "sbs1" || !encoded || !signature || extra !== undefined)
+        return HttpServerResponse.empty({ status: 401 });
+      const actual = Buffer.from(signature, "base64url"),
+        expected = createHmac("sha256", Buffer.from("ab".repeat(32), "hex"))
+          .update(`${prefix}.${encoded}`)
+          .digest();
+      if (actual.length !== expected.length || !timingSafeEqual(actual, expected))
+        return HttpServerResponse.empty({ status: 401 });
+      const assertion = yield* Schema.decodeUnknownEffect(Schema.fromJsonString(Assertion))(
+        Buffer.from(encoded, "base64url").toString(),
+      );
+      const now = yield* Clock.currentTimeMillis;
+      if (
+        assertion.owner !== owner ||
+        assertion.user !== owner ||
+        assertion.expiresAt <= now ||
+        assertion.expiresAt > now + 30_000
+      )
+        return HttpServerResponse.empty({ status: 401 });
+      yield* Ref.update(calls, (calls) => [...calls, assertion]);
+      const input = assertion.input,
+        data = input.data.split("\n"),
+        ids = data.map((row) => hash(JSON.stringify([input.source, row])));
+      const approval = hash(
+        JSON.stringify({
+          source: input.source,
+          data: input.data,
+          accountMappings: input.accountMappings,
+        }),
+      );
+      if (input.mode === "apply" && input.approval !== approval)
+        return HttpServerResponse.jsonUnsafe({ error: "invalid_query" }, { status: 409 });
+      const before = yield* Ref.get(retained),
+        missing = ids.filter((id) => !before.has(id));
+      if (input.mode === "apply")
+        yield* Ref.update(retained, (saved) => new Set([...saved, ...ids]));
+      return HttpServerResponse.jsonUnsafe({
+        mode: input.mode,
+        format: input.format,
+        accountMappingDigest: hash(JSON.stringify(input.accountMappings)),
+        totalDetails: ids.length,
+        pageDetails: ids.length,
+        aggregateOnlyNotImportable: "0",
+        indistinguishableDetails: 0,
+        unpriced: ids.length,
+        missingProvider: 0,
+        missingEndpoint: 0,
+        missingLatency: 0,
+        missingPriceSnapshot: ids.length,
+        existing: ids.length - missing.length,
+        wouldInsert: missing.length,
+        inserted: input.mode === "apply" ? missing.length : 0,
+        ids,
+        next: null,
+        approval: input.mode === "dry-run" ? approval : null,
+      });
+    });
+    const services = yield* Layer.build(
+      HttpRouter.serve(HttpRouter.add("POST", "/pool/v1/usage/import/owner", handler), {
+        disableLogger: true,
+        disableListenLog: true,
+      }).pipe(
+        Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 })),
+      ),
+    );
+    const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+    if (!("port" in server.address)) return yield* Effect.die("Import fixture requires TCP");
+    return {
+      origin: `http://127.0.0.1:${server.address.port}`,
+      calls: Ref.get(calls),
+      retained: Ref.get(retained),
+    };
+  });
