@@ -0,0 +1,125 @@
+import { createHash } from "node:crypto";
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { App } from "../support/contracts.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { poolUsageImportBackend } from "../support/pool-usage-import-backend.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+const source = `import {defineApp,query,object,router} from "apps";
+export default defineApp({},{tools:router({identity:query({input:object({})},async()=>"allowed")})});`;
+const Result = Schema.Struct({
+  ids: Schema.Array(Schema.String),
+  inserted: Schema.Number,
+  wouldInsert: Schema.Number,
+  accountMappingDigest: Schema.String,
+  approval: Schema.NullOr(Schema.String),
+});
+
+layer(RuntimeLive, { excludeTestServices: true })("Pool owner import", (it) => {
+  it.effect(scenarios.poolOwnerImport.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors;
+        const viewer = yield* api
+          .request(actors.owner, "GET", "/api/viewer")
+          .pipe(
+            Effect.flatMap((response) => body(Schema.Struct({ userId: Schema.String }), response)),
+          );
+        const backend = yield* poolUsageImportBackend(viewer.userId),
+          prefix = `/api/organizations/${actors.organization.id}`;
+        const app = yield* api
+          .request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+            name: "Mapped history fixture",
+            files: [{ path: "index.ts", content: source }, appsManifest],
+          })
+          .pipe(Effect.flatMap((response) => body(App, response)));
+        yield* serverControl("stop");
+        yield* legacyStorage([
+          {
+            sql: `update organization set metadata=jsonb_set(coalesce(metadata::jsonb,'{}'::jsonb),'{basaltPools}',$1::jsonb)::text where id=$2`,
+            params: [
+              JSON.stringify({
+                [viewer.userId]: {
+                  app: app.id,
+                  version: "retained-version",
+                  authorization: "executor-app-v1",
+                  membership: "executor-links-v1",
+                },
+              }),
+              actors.organization.id,
+            ],
+          },
+        ]);
+        yield* serverControl("environment", 200, {
+          POOL_APP_SIGNING_KEY: "ab".repeat(32),
+          BASALT_POOL_ORIGIN: backend.origin,
+        });
+        yield* serverControl("start");
+        yield* Effect.addFinalizer(() => serverControl("start").pipe(Effect.orDie));
+        const path = `${prefix}/apps/${app.id}/pool-usage/import`;
+        const input = {
+          source: "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee",
+          format: "cpamp-v1-jsonl",
+          mode: "dry-run",
+          data: JSON.stringify({
+            event_hash: "b".repeat(64),
+            timestamp: "2026-05-05T11:32:18.619Z",
+            failed: false,
+          }),
+          accountMappings: [
+            {
+              sourceAccountRef: "a".repeat(64),
+              targetAccountId: "fixture-credential",
+              provider: "codex",
+            },
+          ],
+        };
+        expect((yield* api.request(actors.member, "POST", path, input)).status).toBe(403);
+        expect((yield* api.request(actors.admin, "POST", path, input)).status).toBe(403);
+        expect(
+          (yield* api.request(actors.owner, "POST", path, input, {
+            authorization: "Bearer refused-grant",
+          })).status,
+        ).toBe(401);
+        expect((yield* backend.calls).length).toBe(0);
+        const response = yield* api.request(actors.owner, "POST", path, input);
+        expect(response.status).toBe(200);
+        const dry = yield* body(Result, response);
+        expect(dry.wouldInsert).toBe(1);
+        expect((yield* backend.retained).size).toBe(0);
+        const calls = yield* backend.calls;
+        expect(calls[0]?.input).toEqual(input);
+        expect(calls[0]?.pool).toBe(app.id);
+        expect(calls[0]?.organization).toBe(actors.organization.id);
+        expect(calls[0]?.owner).toBe(viewer.userId);
+        expect(dry.accountMappingDigest).toBe(
+          createHash("sha256").update(JSON.stringify(input.accountMappings)).digest("hex"),
+        );
+        expect(
+          (yield* api.request(actors.owner, "POST", path, { ...input, mode: "apply" })).status,
+        ).toBe(409);
+        for (const expected of [1, 0]) {
+          const applied = yield* api.request(actors.owner, "POST", path, {
+            ...input,
+            mode: "apply",
+            approval: dry.approval,
+          });
+          expect(applied.status).toBe(200);
+          const result = yield* body(Result, applied);
+          expect(result.ids).toEqual(dry.ids);
+          expect(result.inserted).toBe(expected);
+        }
+        expect((yield* backend.retained).size).toBe(1);
+      }),
+    ),
+  );
+});
