@@ -0,0 +1,45 @@
+import type { AppId } from "@executor-js/sdk/core";
+import { StorageError } from "@executor-js/sdk/core";
+import { Effect, Schema } from "effect";
+import { OrganizationForbidden } from "../contracts/organization.ts";
+import {
+  PoolUsageImportRejected,
+  PoolUsageImportResult,
+  type PoolUsageImportInput,
+} from "../contracts/pool-usage-import.ts";
+import { PoolUsageUnavailable } from "../contracts/pool-usage.ts";
+import { sendPoolCommandResponse, withPool } from "./pool-backend.ts";
+
+const Refusal = Schema.Struct({
+  error: Schema.Literals(["invalid_query", "identity_conflict", "unauthorized"]),
+});
+
+/** App managers cannot import on behalf of a different recorded pool owner. */
+export const importPoolUsage = (app: AppId, input: PoolUsageImportInput) =>
+  withPool(app, (pool) =>
+    Effect.gen(function* () {
+      if (pool.user !== pool.owner) return yield* new OrganizationForbidden();
+      const response = yield* sendPoolCommandResponse("importUsage", {
+        pool: pool.pool,
+        organization: pool.organization,
+        owner: pool.owner,
+        user: pool.user,
+        input,
+      });
+      if (response.status !== 200) {
+        const refused = Schema.decodeUnknownOption(Refusal)(response.body);
+        return yield* new PoolUsageImportRejected({
+          reason: refused._tag === "Some" ? refused.value.error : "unavailable",
+        });
+      }
+      return yield* Schema.decodeUnknownEffect(PoolUsageImportResult)(response.body);
+    }),
+  ).pipe(
+    Effect.flatMap((result) =>
+      result === null ? Effect.fail(new OrganizationForbidden()) : Effect.succeed(result),
+    ),
+    Effect.catchTags({
+      SqlError: () => new StorageError(),
+      SchemaError: () => new PoolUsageUnavailable(),
+    }),
+  );
