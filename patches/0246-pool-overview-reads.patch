+            byte.toString(16).padStart(2, "0"),
+          ).join("");
+        }).pipe(Effect.mapError(() => new StorageError()));
+        const offerings = yield* poolPersonalOverviewOfferings({
+          pool: app,
+          organization: actor.organization,
+        });
