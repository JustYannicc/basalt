+import { Data, Effect } from "effect";
+import { HttpClient, HttpClientRequest } from "effect/http";
+import { Atom } from "effect/reactivity";
+import { browserOnly, dashboardHttpClient } from "@executor-js/ui/contracts/http";
+
+/** The Basalt Sync version this dashboard connects to; it names the plugin's release tag. */
+export const basaltSyncVersion = "0.1.0";
+export const basaltSyncTag = `basalt-sync-${basaltSyncVersion}`;
+/** Obsidian downloads exactly these files when it installs a plugin. */
+export const basaltSyncFiles = ["main.js", "manifest.json", "styles.css"] as const;
+/** BRAT is the community plugin that installs a plugin from a GitHub release. */
+export const bratStoreLink = "obsidian://show-plugin?id=obsidian42-brat";
+
+const githubRepository =
+  /^https:\/\/github\.com\/([A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+?)(?:\.git)?\/?$/u;
+
+/**
+ * Where Basalt Sync is published: the deployment's own public source repository, when that is
+ * on GitHub. Anything else has nowhere to install from.
+ */
+export const basaltSyncRepository = (source: string | undefined): string | null =>
+  source === undefined ? null : (githubRepository.exec(source)?.[1] ?? null);
+
+/** Opens BRAT's add dialog for this exact published version. */
+export const bratInstallLink = (repository: string) =>
+  `obsidian://brat?plugin=${repository}&version=${basaltSyncTag}`;
+
+export class BasaltSyncReleaseUnreachable extends Data.TaggedError("BasaltSyncReleaseUnreachable")<{
+  readonly status: number | null;
+}> {
+  readonly message = "Couldn't check whether Basalt Sync can be installed. Check again.";
+}
+
+/**
+ * Whether the release exists with every file Obsidian installs. A missing tag or file means
+ * there is nothing to install yet; only an answer GitHub couldn't give is a failure.
+ */
+export function basaltSyncReleaseStatus(
+  status: number,
+  body: unknown,
+): "available" | "unavailable" | BasaltSyncReleaseUnreachable {
+  if (status === 404) return "unavailable";
+  if (status !== 200) return new BasaltSyncReleaseUnreachable({ status });
+  const assets =
+    typeof body === "object" && body !== null && "assets" in body && Array.isArray(body.assets)
+      ? body.assets
+      : [];
+  const names = new Set(
+    assets.flatMap((asset: unknown) =>
+      typeof asset === "object" && asset !== null && "name" in asset ? [asset.name] : [],
+    ),
+  );
+  return basaltSyncFiles.every((file) => names.has(file)) ? "available" : "unavailable";
+}
+
+/**
+ * Read in the browser once per repository; the dialog refreshes it on "Check again". A
+ * deployment without a public GitHub source has nothing to install from.
+ */
+export const basaltSyncReleaseAtom = Atom.family((repository: string | null) =>
+  browserOnly(
+    Atom.make(
+      repository === null
+        ? Effect.succeed("unavailable" as const)
+        : Effect.gen(function* () {
+            const client = yield* HttpClient.HttpClient;
+            const response = yield* client
+              .execute(
+                HttpClientRequest.get(
+                  `https://api.github.com/repos/${repository}/releases/tags/${basaltSyncTag}`,
+                ).pipe(HttpClientRequest.acceptJson),
+              )
+              .pipe(Effect.mapError(() => new BasaltSyncReleaseUnreachable({ status: null })));
+            const body: unknown =
+              response.status === 200
+                ? yield* response.json.pipe(
+                    Effect.mapError(
+                      () => new BasaltSyncReleaseUnreachable({ status: response.status }),
+                    ),
+                  )
+                : null;
+            const status = basaltSyncReleaseStatus(response.status, body);
+            return typeof status === "string" ? status : yield* status;
+          }).pipe(Effect.provide(dashboardHttpClient)),
+    ),
+  ),
+);
