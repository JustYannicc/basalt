+
+/** Links BRAT only once the release exists with every file Obsidian installs. */
+function InstallBasaltSync({ repository }: { readonly repository: string }) {
+  const release = useAtomValue(basaltSyncReleaseAtom(repository));
+  const refresh = useAtomRefresh(basaltSyncReleaseAtom(repository));
+  if (AsyncResult.isFailure(release))
+    return (
+      <div className="flex flex-wrap items-center gap-2">
+        <p role="alert" className="text-destructive">
+          Couldn't check whether Basalt Sync can be installed.
+        </p>
+        <Button variant="outline" size="sm" onClick={refresh}>
+          Check again
+        </Button>
+      </div>
+    );
+  if (!AsyncResult.isSuccess(release))
+    return <p className="text-muted-foreground">Checking for Basalt Sync…</p>;
+  if (release.value === "unavailable")
+    return <p className="text-muted-foreground">Basalt Sync isn't available to install yet.</p>;
+  return (
+    <ol className="space-y-2">
+      <li className="flex items-center justify-between gap-3">
+        <span className="text-muted-foreground">
+          Get BRAT from Obsidian's community plugins. Choose Install, then Enable.
+        </span>
+        <Button variant="outline" size="sm" asChild>
+          <a href={bratStoreLink}>Get BRAT</a>
+        </Button>
+      </li>
+      <li className="flex items-center justify-between gap-3">
+        <span className="text-muted-foreground">
+          Add Basalt Sync. Confirm in BRAT, which installs and enables it.
+        </span>
+        <Button variant="outline" size="sm" asChild>
+          <a href={bratInstallLink(repository)}>Add Basalt Sync</a>
+        </Button>
+      </li>
+    </ol>
+  );
+}
