+/**
+ * Install first, then connect. BRAT is linked only once the release exists with every file
+ * Obsidian installs; Connect stays available for vaults that already have the plugin.
+ */
+function ConnectSteps({
+  repository,
+  step,
+  onConnect,
+}: {
+  readonly repository: string | null;
+  readonly step: Step;
+  readonly onConnect: () => void;
+}) {
+  const release = useAtomValue(basaltSyncReleaseAtom(repository));
+  const refresh = useAtomRefresh(basaltSyncReleaseAtom(repository));
+  const [added, setAdded] = useState(false);
+  const installable = AsyncResult.isSuccess(release) && release.value === "available";
+  // Before the install link is used, it is the primary action; afterwards Connect is.
+  const connectFirst = !installable || added || step.kind !== "idle";
+
+  return (
+    <ol className="space-y-4 rounded-md bg-muted/50 p-3 text-[13px] leading-5">
+      <li className="space-y-2">
+        <div>
+          <p className="font-medium text-foreground">1. Install Basalt Sync in Obsidian</p>
+          <p className="text-muted-foreground">Once in each vault, on each device.</p>
+        </div>
+        {AsyncResult.isFailure(release) ? (
+          <div className="flex flex-wrap items-center gap-2">
+            <p role="alert" className="text-destructive">
+              Couldn't check whether Basalt Sync can be installed.
+            </p>
+            <Button variant="outline" size="sm" onClick={refresh}>
+              Check again
+            </Button>
+          </div>
+        ) : !AsyncResult.isSuccess(release) ? (
+          <p className="text-muted-foreground">Checking for Basalt Sync…</p>
+        ) : !installable || repository === null ? (
+          <p className="text-muted-foreground">Basalt Sync isn't available to install yet.</p>
+        ) : (
+          <ol className="space-y-2">
+            <li className="flex items-center justify-between gap-3">
+              <span className="text-muted-foreground">
+                Get BRAT from Obsidian's community plugins. Turn them on if Obsidian asks, then
+                Install and Enable BRAT.
+              </span>
+              <Button variant="outline" size="sm" asChild>
+                <a href={bratStoreLink}>Get BRAT</a>
+              </Button>
+            </li>
+            <li className="flex items-center justify-between gap-3">
+              <span className="text-muted-foreground">
+                Add Basalt Sync. Confirm in BRAT, which installs and enables it.
+              </span>
+              <Button variant={added ? "outline" : "default"} size="sm" asChild>
+                <a href={bratInstallLink(repository)} onClick={() => setAdded(true)}>
+                  Add Basalt Sync
+                </a>
+              </Button>
+            </li>
+          </ol>
+        )}
+      </li>
+      <li className="space-y-2">
+        <p className="font-medium text-foreground">2. Connect your vault</p>
+        <div className="flex items-center justify-between gap-3">
+          <span className="text-muted-foreground">
+            Already installed? Connect. Obsidian shows this vault and server, then you approve in
+            the browser tab it opens.
+          </span>
+          <Button
+            variant={connectFirst ? "default" : "outline"}
+            size="sm"
+            loading={step.kind === "preparing"}
+            onClick={onConnect}
+          >
+            {step.kind === "idle"
+              ? "Connect"
+              : step.kind === "failed"
+                ? "Try again"
+                : "Connect again"}
+          </Button>
+        </div>
+        <div role="status" className="space-y-2">
+          {step.kind === "preparing" && (
+            <p className="text-muted-foreground">Preparing a connection for this device…</p>
+          )}
+          {step.kind === "opened" && (
+            <p className="text-muted-foreground">
+              Obsidian said "Unrecognized URI action"? Basalt Sync isn't installed or enabled in
+              that vault yet.{" "}
+              {installable
+                ? "Do step 1, then Connect again."
+                : "It can be connected once Basalt Sync is available to install."}{" "}
+              Obsidian didn't open?{" "}
+              <a
+                className="font-medium text-foreground underline underline-offset-2"
+                href={step.link}
+              >
+                Open Obsidian
+              </a>
+              .
+            </p>
+          )}
+          {step.kind === "failed" && (
+            <p role="alert" className="text-destructive">
+              {step.message}
+            </p>
+          )}
+        </div>
+      </li>
+    </ol>
+  );
+}
