diff --git a/e2e/support/runner-progress-evidence.ts b/e2e/support/runner-progress-evidence.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/runner-progress-evidence.ts
@@ -0,0 +1,79 @@
+/** Read immediate runner records after a public listing, independently of the trace collector. */
+import { Effect, FileSystem, Option, Schema } from "effect";
+import { HttpClient, HttpClientRequest } from "effect/http";
+import { FixtureFailed } from "../sdk/fixtures.ts";
+import { CloudLogRevision } from "./cloud-log-activity.ts";
+import { Target } from "./platform.ts";
+
+const Progress = Schema.Struct({
+  type: Schema.Literal("executor.runner.progress"),
+  inspection: Schema.Boolean,
+  traceId: Schema.NullOr(Schema.String),
+  attempt: Schema.String,
+  isolate: Schema.String,
+  app: Schema.String,
+  build: Schema.String,
+  sequence: Schema.Number,
+  phase: Schema.String,
+  status: Schema.Literals(["started", "completed", "failed", "interrupted"]),
+  elapsedMs: Schema.Number,
+  activeInvocations: Schema.Number,
+  truncated: Schema.Boolean,
+});
+
+export const runnerProgressEvidence = (app: string) =>
+  Effect.gen(function* () {
+    const target = yield* Target;
+    const fs = yield* FileSystem.FileSystem;
+    const http = yield* HttpClient.HttpClient;
+    const fixtures = target.fixtures;
+    if (fixtures === undefined) return yield* Effect.die("Managed Cloud log control required");
+    const revision = (after?: number) =>
+      Effect.scoped(
+        Effect.gen(function* () {
+          const request = yield* HttpClientRequest.post(
+            `${fixtures.origin}/runtime/cloud-log`,
+          ).pipe(
+            HttpClientRequest.bearerToken(fixtures.token),
+            HttpClientRequest.bodyJson(after === undefined ? {} : { after }),
+          );
+          const response = yield* http.execute(request);
+          if (response.status !== 200)
+            return yield* new FixtureFailed({
+              operation: "Runner progress log wait",
+              status: response.status,
+            });
+          return yield* response.json.pipe(
+            Effect.flatMap(Schema.decodeUnknownEffect(CloudLogRevision)),
+          );
+        }),
+      );
+    let current = yield* revision();
+    for (;;) {
+      const text = yield* fs.readFileString(`${target.directory}/cloud.log`);
+      const records = text.split("\n").flatMap((line) => {
+        const start = line.indexOf('{"type":"executor.runner.progress"');
+        if (start < 0) return [];
+        let value: unknown;
+        try {
+          value = JSON.parse(line.slice(start));
+        } catch {
+          return [];
+        }
+        const decoded = Schema.decodeUnknownOption(Progress)(value);
+        if (
+          Option.isNone(decoded) ||
+          decoded.value.app !== app ||
+          typeof value !== "object" ||
+          value === null
+        )
+          return [];
+        return [{ record: decoded.value, keys: Object.keys(value).sort() }];
+      });
+      if (
+        records.some(({ record }) => record.phase === "invocation" && record.status === "completed")
+      )
+        return records;
+      current = yield* revision(current.revision);
+    }
+  });
diff --git a/e2e/tests/import-runtime-evidence.spec.ts b/e2e/tests/import-runtime-evidence.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/import-runtime-evidence.spec.ts
@@ -0,0 +1,124 @@
+/** A public management listing leaves diagnostics even before a case can collect traces. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Exit, FileSystem, Layer, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { SessionClients } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { frameworkSession } from "../support/framework.ts";
+import { McpOAuth } from "../support/mcp-oauth.ts";
+import { McpClient } from "../support/mcp-client.ts";
+import { Target } from "../support/platform.ts";
+import { Evidence } from "../support/evidence.ts";
+import { managementApp, prepareManagementApp } from "../support/management-app.ts";
+import type { ManagementSetupRecord } from "../support/management-setup-diagnostics.ts";
+import { runnerProgressEvidence } from "../support/runner-progress-evidence.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Import runtime evidence", (it) => {
+  it.effect(scenarios.importRuntimeEvidence.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const actors = yield* Actors;
+        const { execute, queries } = yield* frameworkSession;
+        const searched = yield* execute(
+          'return await tools.search({ query: "importCustom", limit: 10 });',
+        ).pipe(
+          Effect.flatMap(
+            Schema.decodeUnknownEffect(
+              Schema.Struct({ items: Schema.Array(Schema.Struct({ path: Schema.String })) }),
+            ),
+          ),
+        );
+        expect(searched.items.some(({ path }) => path === `${queries}.apps.importCustom`)).toBe(
+          true,
+        );
+        const target = yield* Target;
+        expect(target.metadata.target).toBe("cloud");
+        {
+          const evidence = yield* Evidence;
+          const { app } = yield* managementApp(actors.owner);
+          const progress = yield* runnerProgressEvidence(app.id);
+          yield* evidence.json("runner-progress", progress);
+          expect(
+            progress.some(
+              ({ record }) => record.phase === "worker-start" && record.status === "completed",
+            ),
+          ).toBe(true);
+          expect(
+            progress.some(
+              ({ record }) => record.phase === "worker-result" && record.status === "completed",
+            ),
+          ).toBe(true);
+          for (const { keys } of progress)
+            expect(keys).toEqual([
+              "activeInvocations",
+              "app",
+              "attempt",
+              "build",
+              "elapsedMs",
+              "inspection",
+              "isolate",
+              "phase",
+              "sequence",
+              "status",
+              "traceId",
+              "truncated",
+              "type",
+            ]);
+          const fs = yield* FileSystem.FileSystem;
+          const native = yield* fs
+            .readFileString(`${target.directory}/report/native-processes-1.json`)
+            .pipe(
+              Effect.flatMap(
+                Schema.decodeUnknownEffect(
+                  Schema.fromJsonString(
+                    Schema.Struct({
+                      effectiveHeapLimitMiB: Schema.Null,
+                      residentDynamicWorkers: Schema.Null,
+                      samples: Schema.Array(
+                        Schema.Struct({
+                          available: Schema.Boolean,
+                          workers: Schema.Array(
+                            Schema.Struct({
+                              pid: Schema.Number,
+                              parent: Schema.Number,
+                              rssKiB: Schema.Number,
+                            }),
+                          ),
+                        }),
+                      ),
+                    }),
+                  ),
+                ),
+              ),
+            );
+          expect(
+            native.samples.some(
+              (sample) => sample.available && sample.workers.some((worker) => worker.rssKiB > 0),
+            ),
+          ).toBe(true);
+          yield* evidence.json("native-process-samples", native);
+
+          const clients = yield* SessionClients;
+          const anonymous = yield* clients.session();
+          const setup: ManagementSetupRecord[] = [];
+          const rejected = yield* prepareManagementApp(
+            anonymous,
+            actors.organization.id,
+            target,
+            (record) => setup.push(record),
+          ).pipe(Effect.exit);
+          expect(Exit.isFailure(rejected)).toBe(true);
+          expect(setup).toHaveLength(1);
+          expect(setup[0]!.step).toBe("prepare");
+          expect(setup[0]!.outcome).toBe("schema");
+          expect(setup[0]!.response?.status).toBe(401);
+          expect(setup[0]!.response?.statusField).toBe("missing");
+          expect(JSON.stringify(setup)).not.toContain(actors.organization.id);
+          yield* evidence.json("rejected-management-setup", setup);
+        }
+      }).pipe(Effect.provide(Layer.mergeAll(McpOAuth.layer, McpClient.layer))),
+    ),
+  );
+});
