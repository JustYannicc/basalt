diff --git a/packages/sdk/src/implementation/runner-progress.ts b/packages/sdk/src/implementation/runner-progress.ts
new file mode 100644
--- /dev/null
+++ b/packages/sdk/src/implementation/runner-progress.ts
@@ -0,0 +1,101 @@
+/** Runner records do not depend on an app returning or a collector accepting an export. */
+import { Cause, Context, Effect, Exit, Option, Ref } from "effect";
+
+type Phase =
+  | "invocation"
+  | "build-read"
+  | "protocol"
+  | "accounts"
+  | "worker-entry"
+  | "worker-code"
+  | "cache-open"
+  | "worker-start"
+  | "worker-result"
+  | "cache-command";
+type Status = "started" | "completed" | "failed" | "interrupted";
+type RecordProgress = (phase: Phase, status: Status) => void;
+
+const Progress = Context.Reference<RecordProgress | undefined>("sdk/RunnerProgress", {
+  defaultValue: () => undefined,
+});
+// Reference defaults are cached once in this SDK isolate and remain injectable by a host.
+const RunnerState = Context.Reference("sdk/RunnerObservationState", {
+  defaultValue: () => ({ isolate: crypto.randomUUID(), active: Ref.makeUnsafe(0) }),
+});
+
+/** Counts calls in this SDK isolate, not loaded or resident dynamic Workers. */
+export const observeRunner = <A, E, R>(
+  invocation: {
+    readonly app: string | null;
+    readonly build: string | null;
+    readonly command: { readonly operation: string };
+  },
+  work: Effect.Effect<A, E, R>,
+) =>
+  Effect.gen(function* () {
+    if ((yield* Progress) !== undefined) return yield* work;
+    const state = yield* RunnerState;
+    return yield* Effect.acquireUseRelease(
+      Ref.update(state.active, (active) => active + 1),
+      () =>
+        Effect.gen(function* () {
+          const inspection = invocation.command.operation === "inspect";
+          const span = yield* Effect.currentSpan.pipe(Effect.option);
+          const traceId = Option.isSome(span) ? span.value.traceId : null;
+          let attempt: string | undefined;
+          const started = performance.now();
+          let records = 0;
+          const progress: RecordProgress = (phase, status) => {
+            // A native OOM may originate in another call's cold load.
+            if (!inspection && phase !== "worker-code") return;
+            // Cache callbacks can repeat indefinitely. Keep a terminal slot after truncation.
+            if (records >= 48 && phase !== "invocation") return;
+            try {
+              attempt ??= crypto.randomUUID();
+              console.log(
+                JSON.stringify({
+                  type: "executor.runner.progress",
+                  inspection,
+                  traceId,
+                  attempt,
+                  isolate: state.isolate,
+                  app: invocation.app,
+                  build: invocation.build,
+                  sequence: ++records,
+                  phase,
+                  status,
+                  elapsedMs: Math.max(0, performance.now() - started),
+                  activeInvocations: Ref.getUnsafe(state.active),
+                  truncated: records > 48,
+                }),
+              );
+            } catch {}
+          };
+          return yield* runnerPhase("invocation", work).pipe(
+            Effect.provideService(Progress, progress),
+          );
+        }),
+      () => Ref.update(state.active, (active) => active - 1),
+    );
+  });
+
+export const runnerPhase = <A, E, R>(phase: Phase, work: Effect.Effect<A, E, R>) =>
+  Effect.gen(function* () {
+    const progress = yield* Progress;
+    if (progress === undefined) return yield* work;
+    progress(phase, "started");
+    return yield* work.pipe(
+      Effect.onExit((exit) =>
+        Effect.sync(() =>
+          progress(
+            phase,
+            Exit.isSuccess(exit)
+              ? "completed"
+              : Cause.hasInterrupts(exit.cause)
+                ? "interrupted"
+                : "failed",
+          ),
+        ),
+      ),
+    );
+  });
