--- /dev/null
+++ b/e2e/support/management-setup-diagnostics.ts
@@ -0,0 +1,107 @@
+/** Setup runs before case Evidence exists. These records contain no response values. */
+import { Cause, Effect, Exit, Schema } from "effect";
+import { RequestFailed } from "./api.ts";
+import type { Response } from "./platform.ts";
+
+type Step = "prepare" | "session" | "provisioning" | "inventory";
+export interface ManagementSetupRecord {
+  readonly step: Step;
+  readonly method: "GET" | "POST";
+  readonly route: string;
+  readonly startedAt: number;
+  finishedAt?: number;
+  outcome: "started" | "completed" | "schema" | "request" | "fixture" | "interrupted" | "other";
+  response?: {
+    readonly status: number;
+    readonly shape: "object" | "array" | "null" | "string" | "number" | "boolean" | "other";
+    readonly statusField: "ready" | "draft" | "invitation" | "v1" | "missing" | "other";
+    readonly errorTag: "OnboardingUnavailable" | "missing" | "other";
+  };
+}
+
+export const managementSetupDiagnostics = (
+  report: (record: ManagementSetupRecord) => void = () => {},
+) => {
+  const step = <A, E, R>(
+    name: Step,
+    work: (response: (response: Response) => void) => Effect.Effect<A, E, R>,
+  ) =>
+    Effect.suspend(() => {
+      const request = {
+        prepare: { method: "POST", route: "/api/onboarding/prepare" },
+        session: { method: "GET", route: "/api/auth/get-session" },
+        provisioning: { method: "POST", route: "/management-provisioned" },
+        inventory: { method: "GET", route: "/api/organizations/:organization/inventory" },
+      } as const;
+      const record: ManagementSetupRecord = {
+        step: name,
+        ...request[name],
+        startedAt: Date.now(),
+        outcome: "started",
+      };
+      // Recording is not part of provisioning's success contract.
+      try {
+        report(record);
+      } catch {}
+      return work((response) => {
+        const value = response.body;
+        const object =
+          typeof value === "object" && value !== null && !Array.isArray(value) ? value : undefined;
+        const status = object !== undefined && "status" in object ? object.status : undefined;
+        const error = object !== undefined && "_tag" in object ? object._tag : undefined;
+        record.response = {
+          status: response.status,
+          shape:
+            value === null
+              ? "null"
+              : Array.isArray(value)
+                ? "array"
+                : typeof value === "object"
+                  ? "object"
+                  : typeof value === "string"
+                    ? "string"
+                    : typeof value === "number"
+                      ? "number"
+                      : typeof value === "boolean"
+                        ? "boolean"
+                        : "other",
+          statusField:
+            status === "ready" || status === "draft" || status === "invitation" || status === "v1"
+              ? status
+              : object !== undefined && !("status" in object)
+                ? "missing"
+                : "other",
+          errorTag:
+            error === "OnboardingUnavailable"
+              ? error
+              : object !== undefined && !("_tag" in object)
+                ? "missing"
+                : "other",
+        };
+      }).pipe(
+        Effect.onExit((exit) =>
+          Effect.sync(() => {
+            record.finishedAt = Date.now();
+            if (Exit.isSuccess(exit)) {
+              record.outcome = "completed";
+              return;
+            }
+            const error = Cause.squash(exit.cause);
+            record.outcome = Cause.hasInterrupts(exit.cause)
+              ? "interrupted"
+              : Schema.isSchemaError(error)
+                ? "schema"
+                : Schema.is(RequestFailed)(error)
+                  ? "request"
+                  : typeof error === "object" &&
+                      error !== null &&
+                      "_tag" in error &&
+                      error._tag === "FixtureFailed"
+                    ? "fixture"
+                    : "other";
+          }),
+        ),
+      );
+    });
+  return { step };
+};
