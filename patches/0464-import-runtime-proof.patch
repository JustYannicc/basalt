diff --git a/e2e/support/native-process-diagnostics.ts b/e2e/support/native-process-diagnostics.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/native-process-diagnostics.ts
@@ -0,0 +1,222 @@
+/** Bounded native evidence belongs to the runner that launched these processes. */
+import { Effect, FileSystem, Option, Schedule, Schema, Semaphore } from "effect";
+import { ChildProcess, ChildProcessSpawner } from "effect/process";
+import { createHash } from "node:crypto";
+
+interface ProcessSample {
+  readonly at: number;
+  readonly available: boolean;
+  readonly truncated: boolean;
+  readonly workers: ReadonlyArray<{
+    readonly pid: number;
+    readonly parent: number;
+    readonly rssKiB: number;
+  }>;
+}
+interface NativeEvent {
+  readonly at: number;
+  readonly generation: number;
+  readonly event: "ready" | "started" | "heap-oom" | "abort" | "replacement" | "gc";
+  readonly pid?: number;
+  readonly isolate?: string;
+  readonly heapUsedMiB?: number;
+  readonly heapCapacityMiB?: number;
+}
+const Allocation = Schema.Struct({
+  type: Schema.Literal("executor.runner.progress"),
+  isolate: Schema.String,
+  app: Schema.NullOr(Schema.String),
+  build: Schema.NullOr(Schema.String),
+  attempt: Schema.String,
+  phase: Schema.Literal("worker-code"),
+  status: Schema.Literals(["started", "completed", "failed", "interrupted"]),
+});
+type AllocationRecord = typeof Allocation.Type & {
+  readonly at: number;
+  readonly generation: number;
+};
+interface Generation {
+  readonly id: number;
+  readonly pids: number[];
+}
+interface FailureSnapshot {
+  readonly at: number;
+  readonly trigger: NativeEvent["event"];
+  readonly samples: ReadonlyArray<ProcessSample>;
+  readonly events: ReadonlyArray<NativeEvent>;
+  readonly allocations: ReadonlyArray<AllocationRecord>;
+  readonly generations: ReadonlyArray<Generation>;
+}
+
+export const nativeProcessDiagnostics = (root: number, directory: string, launch: number) =>
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem;
+    const processes = yield* ChildProcessSpawner.ChildProcessSpawner;
+    const samples: ProcessSample[] = [];
+    const events: NativeEvent[] = [];
+    const allocations: AllocationRecord[] = [];
+    const generations: Generation[] = [{ id: 1, pids: [] }];
+    let generation = 1;
+    let failureSnapshot: FailureSnapshot | null = null;
+    yield* fs
+      .makeDirectory(`${directory}/report`, { recursive: true })
+      .pipe(Effect.catchCause(() => Effect.void));
+    const file = `${directory}/report/native-processes-${launch}.json`;
+    const writer = yield* Semaphore.make(1);
+    const persist = writer
+      .withPermits(1)(
+        Effect.suspend(() =>
+          fs
+            .writeFileString(
+              `${file}.pending`,
+              JSON.stringify({
+                // GC capacity and RSS do not establish the effective isolate heap limit.
+                version: 1,
+                root,
+                launch,
+                effectiveHeapLimitMiB: null,
+                residentDynamicWorkers: null,
+                samples,
+                events,
+                allocations,
+                generations,
+                failureSnapshot,
+              }),
+              { mode: 0o600 },
+            )
+            .pipe(Effect.andThen(fs.rename(`${file}.pending`, file))),
+        ),
+      )
+      .pipe(Effect.catchCause(() => Effect.void));
+    const sample = Effect.gen(function* () {
+      const text = yield* processes.string(
+        ChildProcess.make("ps", ["-axo", "pid=,ppid=,rss=,comm="]),
+      );
+      const rows = text.split("\n").flatMap((line) => {
+        const match = /^\s*(\d+)\s+(\d+)\s+(\d+)\s+(.+)$/u.exec(line);
+        return match === null
+          ? []
+          : [
+              {
+                pid: Number(match[1]),
+                parent: Number(match[2]),
+                rssKiB: Number(match[3]),
+                worker: /(?:^|\/)workerd(?:\.exe)?$/u.test(match[4]!),
+              },
+            ];
+      });
+      const descendants = new Set([root]);
+      for (let changed = true; changed;) {
+        changed = false;
+        for (const row of rows)
+          if (!descendants.has(row.pid) && descendants.has(row.parent)) {
+            descendants.add(row.pid);
+            changed = true;
+          }
+      }
+      const workers = rows
+        .filter((row) => row.worker && descendants.has(row.pid))
+        .map(({ pid, parent, rssKiB }) => ({ pid, parent, rssKiB }));
+      return {
+        at: Date.now(),
+        available: true,
+        truncated: workers.length > 128,
+        workers: workers.slice(0, 128),
+      };
+    }).pipe(
+      Effect.timeout("1 second"),
+      Effect.catchCause(() =>
+        Effect.succeed({ at: Date.now(), available: false, truncated: false, workers: [] }),
+      ),
+      Effect.tap((value) =>
+        Effect.sync(() => {
+          samples.push(value);
+          if (samples.length > 120) samples.shift();
+        }),
+      ),
+      Effect.andThen(persist),
+    );
+    yield* persist;
+    yield* Effect.addFinalizer(() => persist);
+    yield* sample.pipe(Effect.repeat(Schedule.spaced("5 seconds")), Effect.forkScoped);
+    return {
+      observe: (line: string) =>
+        Effect.sync(() => {
+          const appdata = line.includes("[AppData]");
+          const start =
+            appdata && line.length < 8192 ? line.indexOf('{"type":"executor.runner.progress"') : -1;
+          if (start >= 0) {
+            let value: unknown;
+            try {
+              value = JSON.parse(line.slice(start));
+            } catch {
+              value = undefined;
+            }
+            const parsed = Schema.decodeUnknownOption(Allocation)(value);
+            if (
+              Option.isSome(parsed) &&
+              Object.values(parsed.value).every((value) => value === null || value.length <= 256)
+            ) {
+              allocations.push({ ...parsed.value, at: Date.now(), generation });
+              if (allocations.length > 64) allocations.shift();
+            }
+          }
+          const gc = appdata
+            ? /\[(\d+):(0x[\da-f]+)\].*?->\s*([\d.]+)\s*\(([\d.]+)\) MB/u.exec(line)
+            : null;
+          const event: NativeEvent | undefined =
+            gc !== null
+              ? {
+                  at: Date.now(),
+                  generation,
+                  event: "gc",
+                  pid: Number(gc[1]),
+                  isolate: createHash("sha256").update(gc[2]!).digest("hex").slice(0, 16),
+                  heapUsedMiB: Number(gc[3]),
+                  heapCapacityMiB: Number(gc[4]),
+                }
+              : appdata && line.includes("JavaScript heap out of memory")
+                ? { at: Date.now(), generation, event: "heap-oom" }
+                : appdata && line.includes("Received signal #6")
+                  ? { at: Date.now(), generation, event: "abort" }
+                  : appdata && line.includes("ready at ")
+                    ? { at: Date.now(), generation, event: "ready" }
+                    : appdata && line.includes("Started in ")
+                      ? { at: Date.now(), generation, event: "started" }
+                      : /appdata[^\n]*exited unexpectedly[^\n]*starting a replacement/u.test(line)
+                        ? { at: Date.now(), generation, event: "replacement" }
+                        : undefined;
+          if (event === undefined) return false;
+          events.push(event);
+          if (events.length > 128) events.shift();
+          const current = generations.at(-1)!;
+          if (
+            event.pid !== undefined &&
+            !current.pids.includes(event.pid) &&
+            current.pids.length < 4
+          )
+            current.pids.push(event.pid);
+          // AppData stdout is drained before the runtime announces and starts its replacement.
+          // GC PIDs and SDK allocations therefore share this scoped native generation, not a time guess.
+          if (event.event === "replacement") {
+            generations.push({ id: ++generation, pids: [] });
+            if (generations.length > 16) generations.shift();
+          }
+          if (
+            failureSnapshot !== null ||
+            !["heap-oom", "abort", "replacement"].includes(event.event)
+          )
+            return false;
+          // Keep the first failure's pre-exit history even if the suite runs for another hour.
+          failureSnapshot = {
+            at: event.at,
+            trigger: event.event,
+            samples: [...samples],
+            events: [...events],
+            allocations: [...allocations],
+            generations: generations.map(({ id, pids }) => ({ id, pids: [...pids] })),
+          };
+          return true;
+        }).pipe(Effect.flatMap((captured) => (captured ? persist : Effect.void))),
+    };
+  });
