diff --git a/packages/mcp-auth/src/implementation/native-access-budget.ts b/packages/mcp-auth/src/implementation/native-access-budget.ts
new file mode 100644
--- /dev/null
+++ b/packages/mcp-auth/src/implementation/native-access-budget.ts
@@ -0,0 +1,75 @@
+import type { GenericEndpointContext } from "@better-auth/core";
+import { APIError } from "better-auth/api";
+import { authCall } from "./auth-call.ts";
+
+const windowMilliseconds = 60_000;
+const maximumChecks = 1200;
+const prefix = "native-access:";
+export const nativeAccessRateRule = {
+  pathMatcher: (path: string) => path === "/native/access",
+  window: windowMilliseconds / 1000,
+  max: maximumChecks,
+};
+
+/** Verified devices share a budget across token rotation, never across a proxy address. */
+export const nativeAccessBudget = (
+  ctx: GenericEndpointContext,
+  identity: { device?: string; userId: string },
+) =>
+  authCall(async () => {
+    const now = Date.now();
+    const window = Math.floor(now / windowMilliseconds);
+    if (!ctx.context.rateLimit.enabled) return;
+    const identityKey = identity.device
+      ? `device:${identity.device}`
+      : `account:${identity.userId}`;
+    const key = `${prefix}${identityKey}:${window}`;
+    const adapter = ctx.context.adapter;
+    const where = [{ field: "key", value: key }];
+    const consume = async (): Promise<void> => {
+      const updated = await adapter.incrementOne({
+        model: "rateLimit",
+        where: [...where, { field: "count", operator: "lt", value: maximumChecks }],
+        increment: { count: 1 },
+      });
+      if (updated) return;
+      const existing = await adapter.findOne<{ count: number }>({ model: "rateLimit", where });
+      if (existing) {
+        if (existing.count < maximumChecks) return consume();
+        const retryAfter = Math.max(
+          1,
+          Math.ceil(((window + 1) * windowMilliseconds - Date.now()) / 1000),
+        );
+        ctx.setHeader("Retry-After", String(retryAfter));
+        console.warn("NATIVE_ACCESS_RATE_LIMIT", {
+          scope: identity.device ? "device" : "account",
+          limit: maximumChecks,
+          windowSeconds: 60,
+          retryAfterSeconds: retryAfter,
+        });
+        throw new APIError("TOO_MANY_REQUESTS", {
+          message: "Native access checks are temporarily limited. Retry shortly.",
+        });
+      }
+      try {
+        await adapter.create({ model: "rateLimit", data: { key, count: 1, lastRequest: now } });
+      } catch (error) {
+        // A sibling may create this device's window between the guarded increment and insert.
+        if (!(await adapter.findOne({ model: "rateLimit", where }))) throw error;
+        return consume();
+      }
+      await ctx.context.runInBackgroundOrAwait(
+        adapter
+          .deleteMany({
+            model: "rateLimit",
+            where: [
+              { field: "key", operator: "starts_with", value: prefix },
+              { field: "lastRequest", operator: "lt", value: now - 2 * windowMilliseconds },
+            ],
+          })
+          .then(() => undefined)
+          .catch(() => console.warn("NATIVE_ACCESS_BUDGET_CLEANUP_FAILURE")),
+      );
+    };
+    await consume();
+  });
