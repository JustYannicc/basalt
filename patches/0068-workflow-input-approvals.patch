new file mode 100644
index 0000000..f43d464
--- /dev/null
+++ b/apps/hosted/server/src/implementation/workflow-input-displays.ts
@@ -0,0 +1,42 @@
+import { workflowDisplayResult } from "@executor-js/mcp";
+import { WorkflowInputDisplays } from "../contracts/workflow-display.ts";
+import { WorkflowFailure, type AppId, type WorkflowInputId } from "@executor-js/sdk/core";
+import { Effect } from "effect";
+import { McpAppSandbox } from "../contracts/mcp.ts";
+import { CurrentOrganization } from "../contracts/organization.ts";
+import { CurrentUserId, Forbidden } from "../contracts/auth.ts";
+import { HostedExecutor } from "../contracts/executor.ts";
+import { browserOnly, currentOwner } from "./access.ts";
+import { requireAppAccess } from "./resource-policy.ts";
+import { requireWorkflowAccess } from "./workflow-access.ts";
+
+export const hostedWorkflowInputDisplay = (
+  target: { readonly app: AppId; readonly id: WorkflowInputId },
+  closing = false,
+) =>
+  Effect.gen(function* () {
+    yield* browserOnly;
+    const owner = yield* currentOwner;
+    const user = yield* CurrentUserId;
+    if (user === undefined) return yield* new Forbidden();
+    const executor = yield* Effect.flatten(HostedExecutor);
+    yield* requireAppAccess(target.app, "use");
+    const question = yield* executor.workflowInputs.get({ ...target, owner });
+    yield* requireWorkflowAccess(executor, owner, target.app, question.run);
+    if (!closing && question.status !== "pending")
+      return yield* new WorkflowFailure({ reason: "unavailable", retryable: false });
+    const organization = yield* CurrentOrganization;
+    return yield* workflowDisplayResult(
+      (yield* WorkflowInputDisplays).create(
+        executor,
+        { ...target, owner },
+        {
+          product: `workflow-input:${organization.owner}:${target.id}`,
+          principal: user,
+          grant: "browser",
+        },
+        yield* McpAppSandbox,
+      ),
+    );
+  });
+export { workflowDisplayResult };
