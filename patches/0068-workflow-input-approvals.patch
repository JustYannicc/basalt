+  ...DisplayAuthority.fields,
+  name: Schema.NonEmptyString,
+  input: Json,
+});
+export const DisplayResume = Schema.Struct({
+  ...DisplayCall.fields,
+  pending: ToolPending,
+  response: ApprovalResponse,
+});
