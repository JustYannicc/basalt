+/** Browser authority crosses only the private binding; no public route accepts this record. */
+import type { makeWorkflowInputDisplay } from "@executor-js/mcp";
+import type { WorkflowInputDisplay } from "@executor-js/hosted-server/workflow-display";
+import type { OrganizationAccess } from "@executor-js/hosted-server/organization";
+import type { CurrentAuthorization } from "@executor-js/hosted-server/authorization";
+import type { CurrentUsage, ProductAnalytics } from "@executor-js/hosted-server";
+import type { Context, Effect } from "effect";
+import type { RpcCallError } from "alchemy/Rpc";
+export type DisplayEvent = Parameters<Context.Service.Shape<typeof ProductAnalytics>["capture"]>[0];
+export type DisplayReply<A> = (
+  | { readonly ok: true; readonly value: A }
+  | { readonly ok: false }
+) & { readonly events: ReadonlyArray<DisplayEvent> };
+export type DisplayBinding = {
+  readonly target: Parameters<typeof makeWorkflowInputDisplay>[1];
+  readonly context: Parameters<typeof makeWorkflowInputDisplay>[2];
+  readonly actor: string | undefined;
+  readonly organization: OrganizationAccess;
+  readonly policy: Context.Service.Shape<typeof CurrentAuthorization>;
+  readonly usage: Context.Service.Shape<typeof CurrentUsage>;
+  readonly analyticsEnabled: boolean;
+};
+type DisplayMethods = {
+  readonly open: () => WorkflowInputDisplay["open"];
+  readonly resource: WorkflowInputDisplay["resource"];
+  readonly call: (
+    ...input: [
+      id: Parameters<WorkflowInputDisplay["call"]>[0],
+      capability: string,
+      name: string,
+      input: Parameters<WorkflowInputDisplay["call"]>[3],
+    ]
+  ) => ReturnType<WorkflowInputDisplay["call"]>;
+  readonly resume: (
+    ...input: [
+      id: Parameters<WorkflowInputDisplay["resume"]>[0],
+      capability: string,
+      name: string,
+      input: Parameters<WorkflowInputDisplay["resume"]>[3],
+      pending: Parameters<WorkflowInputDisplay["resume"]>[4],
+      response: Parameters<WorkflowInputDisplay["resume"]>[5],
+    ]
+  ) => ReturnType<WorkflowInputDisplay["resume"]>;
+  readonly renew: WorkflowInputDisplay["renew"];
+  readonly close: WorkflowInputDisplay["close"];
+};
+export type WorkflowDisplayRpc = {
+  readonly [K in keyof DisplayMethods]: (
+    binding: DisplayBinding,
+    ...input: Parameters<DisplayMethods[K]>
+  ) => Effect.Effect<DisplayReply<Effect.Success<ReturnType<DisplayMethods[K]>>>, RpcCallError>;
+};
