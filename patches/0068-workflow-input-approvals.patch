+import { HostedClient } from "./api.ts";
+import { protectedQuery } from "./protected-query.ts";
+import { inventoryAtom } from "./organization.ts";
+import { pendingApprovalsAtom } from "./schedules.ts";
+
+export const questions = Atom.family((organization: OrganizationReference) =>
+  HostedClient.runtime
+    .atom(
+      Effect.flatMap(HostedClient, (client) =>
+        workflowInputPages((after) =>
+          client.workflowInputs.list({
+            params: { organization },
+            query: { pending: true, ...(after === undefined ? {} : { after }) },
+          }),
+        ),
+      ),
+    )
+    .pipe(revalidated, protectedQuery),
+);
+const pending = Atom.family((organization: OrganizationReference) =>
+  pollingQuery(questions(organization), steadyPolling),
+);
+export const approvalsAtom = Atom.family((organization: OrganizationReference) =>
+  HostedClient.runtime.atom((get) =>
+    Effect.gen(function* () {
+      const [scheduled, inputs, inventory] = yield* Effect.all(
+        [
+          get.result(pendingApprovalsAtom(organization)),
+          get.result(pending(organization)),
+          get.result(inventoryAtom(organization)),
+        ],
+        { concurrency: "unbounded" },
+      );
+      return approvalQueue(scheduled, inputs, inventory.apps);
+    }),
+  ),
+);
