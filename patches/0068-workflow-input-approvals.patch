+/** Products choose where display resources run; authorization stays with the current request. */
+import type { makeWorkflowInputDisplay } from "@executor-js/mcp";
+import type { HostedExecutor } from "./executor.ts";
+import type { CurrentOrganization } from "./organization.ts";
+import type { GroupDatabase } from "./groups.ts";
+import { Context, type Effect } from "effect";
+
+type LocalDisplay = Pick<
+  ReturnType<typeof makeWorkflowInputDisplay>,
+  "open" | "resource" | "call" | "resume" | "renew" | "close"
+>;
+/** Product adapters map display failures at their public boundary, including transport errors. */
+export type WorkflowInputDisplay = {
+  readonly [K in keyof LocalDisplay]: LocalDisplay[K] extends (
+    ...input: infer P
+  ) => Effect.Effect<infer A, unknown>
+    ? (...input: P) => Effect.Effect<A, Error>
+    : LocalDisplay[K] extends Effect.Effect<infer A, unknown>
+      ? Effect.Effect<A, Error>
+      : never;
+};
+type DisplayInput = Parameters<typeof makeWorkflowInputDisplay>;
+export class WorkflowInputDisplays extends Context.Service<
+  WorkflowInputDisplays,
+  {
+    readonly create: (
+      executor: DisplayInput[0],
+      target: DisplayInput[1],
+      context: DisplayInput[2],
+      address: DisplayInput[4],
+    ) => Effect.Effect<
+      WorkflowInputDisplay,
+      Error,
+      HostedExecutor | CurrentOrganization | GroupDatabase
+    >;
+  }
+>()("hosted/WorkflowInputDisplays") {}
