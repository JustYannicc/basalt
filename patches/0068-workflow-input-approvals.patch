index 0000000..7fdab4b
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/review-lazy.tsx
@@ -0,0 +1,58 @@
+import { Component, lazy, Suspense, useState, type ComponentType, type ReactNode } from "react";
+import { useHydrated } from "../hooks/hydrated.ts";
+import { Button } from "../components/button.tsx";
+import { Spinner } from "../components/spinner.tsx";
+import { ApprovalCard } from "./loading.tsx";
+
+/** Review code loads only when a browser opens the request. */
+export function LazyReview<P extends object>({
+  load,
+  props,
+}: {
+  readonly load: () => Promise<{ default: ComponentType<P> }>;
+  readonly props: P;
+}) {
+  const hydrated = useHydrated();
+  const [attempt, setAttempt] = useState(0);
+  const [Review, setReview] = useState(() => lazy(load));
+  const pending = (
+    <ApprovalCard>
+      <Spinner />
+    </ApprovalCard>
+  );
+  return !hydrated ? (
+    pending
+  ) : (
+    <ReviewBoundary
+      key={attempt}
+      retry={() => {
+        setReview(() => lazy(load));
+        setAttempt(attempt + 1);
+      }}
+    >
+      <Suspense fallback={pending}>
+        <Review {...props} />
+      </Suspense>
+    </ReviewBoundary>
+  );
+}
+class ReviewBoundary extends Component<
+  { readonly children: ReactNode; readonly retry: () => void },
+  { readonly failed: boolean }
+> {
+  override state = { failed: false };
+  static getDerivedStateFromError() {
+    return { failed: true };
+  }
+  override render() {
+    if (!this.state.failed) return this.props.children;
+    return (
+      <ApprovalCard>
+        <p>This page could not load. Try again to refresh its current state.</p>
+        <Button variant="outline" onClick={this.props.retry}>
+          Try again
+        </Button>
+      </ApprovalCard>
+    );
+  }
+}
diff --git a/packages/ui/src/implementation/dashboard/workflow-display-review.tsx b/packages/ui/src/implementation/dashboard/workflow-display-review.tsx
new file mode 100644
index 0000000..64379e3
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/workflow-display-review.tsx
@@ -0,0 +1,98 @@
+/** Custom displays present the SDK's real saved tool approval before its one-shot continuation. */
+import type { ToolPending, ToolResumeResult } from "@executor-js/sdk/core";
+import type { ElicitationResponse } from "apps/contracts";
+import { Effect } from "effect";
+import { AsyncResult, Atom } from "effect/reactivity";
+import { useCallback, useEffect, useRef, useState } from "react";
+import { BrowserApprovalFailed, type ReviewAtoms } from "../../contracts/browser-approval.ts";
+import { ApprovalForm } from "./browser-approval-client.tsx";
+
+type Pending = typeof ToolPending.Type;
+export const useDisplayApproval = () => {
+  const [review, setReview] = useState<{
+    readonly pending: Pending;
+    readonly atoms: ReviewAtoms;
+  }>();
+  const region = useRef<HTMLDivElement>(null);
+  const requestId = review?.pending.requestId;
+  useEffect(() => {
+    if (requestId === undefined) return;
+    region.current?.scrollIntoView({ block: "nearest" });
+    region.current?.focus({ preventScroll: true });
+  }, [requestId]);
+  const ask = useCallback(
+    (
+      pending: Pending,
+      invoke: (response: ElicitationResponse) => Promise<ToolResumeResult>,
+      signal: AbortSignal,
+    ) =>
+      new Promise<ToolResumeResult>((resolve, reject) => {
+        let consuming = false;
+        const done = () => {
+          signal.removeEventListener("abort", abort);
+          setReview((current) =>
+            current?.pending.requestId === pending.requestId ? undefined : current,
+          );
+        };
+        const abort = () => {
+          done();
+          // Cancellation only consumes an unanswered approval. Never race an answer already sent.
+          if (!consuming) {
+            consuming = true;
+            void invoke({ action: "cancel" }).catch(() => {});
+          }
+          reject(new Error("Display closed"));
+        };
+        const atoms: ReviewAtoms = {
+          view: Atom.make(AsyncResult.success({ status: "pending" as const, request: pending })),
+          answer: Atom.fn((response: ElicitationResponse) =>
+            Effect.tryPromise({
+              try: async () => {
+                if (consuming || signal.aborted) throw new Error("Approval already answered");
+                consuming = true;
+                try {
+                  const result = await invoke(response);
+                  done();
+                  resolve(result);
+                  return { status: "answered" as const };
+                } catch (error) {
+                  done();
+                  reject(error);
+                  throw error;
+                }
+              },
+              catch: () => new BrowserApprovalFailed({ reason: "reply-unreadable" }),
+            }),
+          ),
+        };
+        signal.addEventListener("abort", abort, { once: true });
+        if (signal.aborted) {
+          abort();
+          return;
+        }
+        setReview({ pending, atoms });
+      }),
+    [],
+  );
+  return {
+    ask,
+    review:
+      review === undefined ? null : (
+        <div
+          ref={region}
+          tabIndex={-1}
+          className="border-t pt-6"
+          role="region"
+          aria-label="Review display action"
+        >
+          <ApprovalForm
+            key={review.pending.requestId}
+            request={review.pending}
+            appName={undefined}
+            atoms={review.atoms}
+            completion="Your decision was saved."
+          />
+        </div>
+      ),
+  };
+};
diff --git a/packages/ui/src/implementation/dashboard/workflow-display.tsx b/packages/ui/src/implementation/dashboard/workflow-display.tsx
new file mode 100644
index 0000000..b6630c9
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/workflow-display.tsx
@@ -0,0 +1,247 @@
+import { useAtomSet } from "@effect/atom-react";
+import { mountAppFrame } from "@executor-js/mcp/app-frame";
+import { workflowInputAnswerTool, type AppBridgePayload } from "@executor-js/mcp/workflow-display";
+import { ElicitationResponse, McpToolResult as McpResult } from "apps/contracts";
+import type { McpToolResult } from "apps/contracts";
+import { Cause, Exit, Schema } from "effect";
+import { useEffect, useRef, useState } from "react";
+import type { WorkflowDisplayAtoms } from "../../contracts/workflow-inputs.ts";
+import type { WorkflowDisplayProps } from "./workflow-input.tsx";
+import { useDisplayApproval } from "./workflow-display-review.tsx";
+import { Button } from "../components/button.tsx";
+
+const result = async <A, E>(promise: Promise<Exit.Exit<A, E>>) => {
+  const exit = await promise;
+  if (Exit.isFailure(exit)) throw Cause.squash(exit.cause);
+  return exit.value;
+};
+const failedAction = (): McpToolResult => ({
+  isError: true,
+  content: [
+    {
+      type: "text",
+      text: "This action did not return a confirmed result. Check before trying it again.",
+    },
+  ],
+});
+
+export function WorkflowDisplay<E>({
+  question,
+  answer,
+  onReady,
+  atoms,
+}: WorkflowDisplayProps & { readonly atoms: WorkflowDisplayAtoms<E> }) {
+  const bound = question.display?.kind === "mcp-app" && question.display.tool !== undefined;
+  const [state, setState] = useState<"opening" | "ready" | "unavailable" | "closed">(
+    bound ? "opening" : "unavailable",
+  );
+  const [attempt, setAttempt] = useState(0);
+  const [actionError, setActionError] = useState(false);
+  const frame = useRef<HTMLIFrameElement>(null);
+  const closeView = useRef<() => void>(() => {});
+  const open = useAtomSet(atoms.open, { mode: "promiseExit" });
+  const resource = useAtomSet(atoms.resource, { mode: "promiseExit" });
+  const call = useAtomSet(atoms.call, { mode: "promiseExit" });
+  const resume = useAtomSet(atoms.resume, { mode: "promiseExit" });
+  const renew = useAtomSet(atoms.renew, { mode: "promiseExit" });
+  const close = useAtomSet(atoms.close, { mode: "promiseExit" });
+  const { ask, review } = useDisplayApproval();
+  useEffect(() => {
+    onReady(false);
+    if (!bound) return;
+    let stopped = false;
+    let payload: AppBridgePayload | undefined;
+    let unmount: (() => void) | undefined;
+    let capability = "";
+    let receivedAt = 0;
+    let renewal: Promise<void> | undefined;
+    let busy = false;
+    const stop = () => {
+      if (stopped) return;
+      stopped = true;
+      unmount?.();
+      if (payload !== undefined) void close(payload.view);
+    };
+    const fail = () => {
+      if (!stopped) {
+        setState("unavailable");
+        onReady(false);
+        stop();
+      }
+    };
+    closeView.current = () => {
+      stop();
+      setState("closed");
+      onReady(false);
+    };
+    const current = async (signal: AbortSignal) => {
+      signal.throwIfAborted();
+      if (payload === undefined || stopped) throw new Error("Display closed");
+      if (
+        Number(capability.split(".")[0]) - Date.now() <= 30000 ||
+        performance.now() - receivedAt >= 14.5 * 60000
+      ) {
+        renewal ??= result(renew({ view: payload.view, capability }))
+          .then((value) => {
+            if (stopped) throw new Error("Display closed");
+            capability = value.capability;
+            receivedAt = performance.now();
+          })
+          .catch((error) => {
+            fail();
+            throw error;
+          })
+          .finally(() => {
+            renewal = undefined;
+          });
+        await renewal;
+      }
+      signal.throwIfAborted();
+      return { view: payload.view, capability };
+    };
+    void result(open())
+      .then(async (value) => {
+        if (stopped) {
+          void close(value.view);
+          return;
+        }
+        payload = value;
+        capability = value.capability;
+        receivedAt = performance.now();
+        if (stopped) return;
+        if (frame.current === null) {
+          fail();
+          return;
+        }
+        unmount = mountAppFrame(frame.current, value, {
+          ready: () => {
+            if (!stopped) {
+              setState("ready");
+              onReady(true);
+            }
+          },
+          failed: fail,
+          resource: async (uri, signal) => {
+            try {
+              return await result(resource({ ...(await current(signal)), uri }));
+            } catch (error) {
+              fail();
+              throw error;
+            }
+          },
+          call: async (name, input, signal) => {
+            if (busy)
+              return {
+                isError: true,
+                content: [
+                  { type: "text", text: "Finish the current action before starting another." },
+                ],
+              };
+            busy = true;
+            setActionError(false);
+            try {
+              if (name === workflowInputAnswerTool) {
+                const response = Schema.decodeUnknownSync(ElicitationResponse)(input);
+                const saved = await answer(response);
+                return {
+                  isError: saved.status !== "answered",
+                  content: [
+                    {
+                      type: "text",
+                      text:
+                        saved.status === "answered"
+                          ? "Response saved."
+                          : "This question no longer accepts a response.",
+                    },
+                  ],
+                };
+              }
+              const authority = await current(signal);
+              const initial = await result(call({ ...authority, name, input }));
+              signal.throwIfAborted();
+              const outcome =
+                initial.status === "completed"
+                  ? initial
+                  : await ask(
+                      initial,
+                      (response) =>
+                        result(resume({ ...authority, name, input, pending: initial, response })),
+                      signal,
+                    );
+              if (outcome.status !== "completed")
+                return {
+                  isError: true,
+                  content: [
+                    {
+                      type: "text",
+                      text:
+                        outcome.status === "denied"
+                          ? "Action declined."
+                          : outcome.status === "cancelled"
+                            ? "Action cancelled."
+                            : "The action's result is unavailable. Check before trying it again.",
+                    },
+                  ],
+                };
+              return Schema.decodeUnknownSync(McpResult)(outcome.value);
+            } catch {
+              if (!stopped) setActionError(true);
+              return failedAction();
+            } finally {
+              busy = false;
+            }
+          },
+        });
+      })
+      .catch(fail);
+    return stop;
+  }, [bound, attempt, open, resource, call, resume, renew, close, ask, answer, onReady]);
+  return (
+    <div className="space-y-4">
+      <div className="flex flex-wrap items-center justify-between gap-2 text-sm">
+        <p role="status" className="text-muted-foreground">
+          {state === "opening"
+            ? "Opening custom display…"
+            : state === "ready"
+              ? "Custom display"
+              : state === "closed"
+                ? "Custom display closed"
+                : "The custom display is unavailable. Use the form below."}
+        </p>
+        {state === "ready" || state === "opening" ? (
+          <Button variant="ghost" size="sm" onClick={() => closeView.current()}>
+            Close display
+          </Button>
+        ) : (
+          bound && (
+            <Button
+              variant="outline"
+              size="sm"
+              onClick={() => {
+                setState("opening");
+                setActionError(false);
+                onReady(false);
+                setAttempt((value) => value + 1);
+              }}
+            >
+              {state === "closed" ? "Open display" : "Try display again"}
+            </Button>
+          )
+        )}
+      </div>
+      <iframe
+        ref={frame}
+        title="Custom workflow display"
+        hidden={state !== "ready"}
+        className="h-120 w-full border-0"
+      />
+      {review}
+      {actionError && (
+        <p role="alert" className="text-sm text-destructive">
+          The action's result could not be confirmed. Check before trying it again. You can still
+          answer with the form.
+        </p>
+      )}
+    </div>
+  );
+}
diff --git a/packages/ui/src/implementation/dashboard/workflow-input.tsx b/packages/ui/src/implementation/dashboard/workflow-input.tsx
new file mode 100644
index 0000000..bb71df7
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/workflow-input.tsx
@@ -0,0 +1,234 @@
+import { useAtomRefresh, useAtomSet, useAtomValue } from "@effect/atom-react";
+import type { WorkflowInput } from "@executor-js/sdk/core";
+import type { ElicitationResponse } from "apps/contracts";
+import { Cause, Exit } from "effect";
+import { useCallback, useEffect, useState, type ComponentType } from "react";
+import type { FailureProps } from "../../contracts/dashboard.ts";
+import type { WorkflowInputAtoms } from "../../contracts/workflow-inputs.ts";
+import { QueryView } from "./context.tsx";
+import { ApprovalCard } from "./loading.tsx";
+import {
+  ElicitationFields,
+  elicitationDefaults,
+  elicitationContent,
+} from "./elicitation-fields.tsx";
+import { Spinner } from "../components/spinner.tsx";
+import { Button } from "../components/button.tsx";
+import { LocalTime, timeOfDay } from "../components/local-time.tsx";
+
+export interface WorkflowDisplayProps {
+  readonly question: WorkflowInput;
+  readonly answer: (response: ElicitationResponse) => Promise<WorkflowInput>;
+  readonly onReady: (ready: boolean) => void;
+}
+/** Workflow input is a durable answer, separate from permission to run a tool. */
+export function WorkflowInputCard<E>({
+  atoms,
+  Failure,
+  Display,
+}: {
+  readonly atoms: WorkflowInputAtoms<E>;
+  readonly Failure: ComponentType<FailureProps<NoInfer<E>>>;
+  readonly Display?: ComponentType<WorkflowDisplayProps>;
+}) {
+  return (
+    <ApprovalCard>
+      <QueryView query={atoms.view} Failure={Failure} pending={<Spinner />}>
+        {(question) =>
+          question.status === "pending" ? (
+            <QuestionForm
+              key={question.id}
+              question={question}
+              atoms={atoms}
+              Failure={Failure}
+              Display={Display}
+            />
+          ) : (
+            <QuestionResult status={question.status} />
+          )
+        }
+      </QueryView>
+    </ApprovalCard>
+  );
+}
+function QuestionResult({ status }: { readonly status: WorkflowInput["status"] }) {
+  return (
+    <div role="status">
+      <h1 className="text-[22px] font-semibold tracking-[-0.035em] leading-[1.35]">
+        {status === "answered"
+          ? "Response saved"
+          : status === "expired"
+            ? "Question expired"
+            : "Question withdrawn"}
+      </h1>
+      <p className="mt-3 text-sm text-muted-foreground">
+        {status === "answered"
+          ? "Your response was saved. The workflow continues in the background."
+          : "This question no longer accepts a response."}
+      </p>
+    </div>
+  );
+}
+function QuestionForm<E>({
+  question,
+  atoms,
+  Failure,
+  Display,
+}: {
+  readonly question: WorkflowInput;
+  readonly atoms: WorkflowInputAtoms<E>;
+  readonly Failure: ComponentType<FailureProps<NoInfer<E>>>;
+  readonly Display: ComponentType<WorkflowDisplayProps> | undefined;
+}) {
+  const [customReady, setCustomReady] = useState(false);
+  const [standard, setStandard] = useState(false);
+  const [values, setValues] = useState(() => elicitationDefaults(question.form));
+  const [error, setError] = useState<Cause.Cause<E>>();
+  const [expired, setExpired] = useState(() => question.expiresAt <= Date.now());
+  const send = useAtomSet(atoms.answer, { mode: "promiseExit" });
+  const sending = useAtomValue(atoms.answer).waiting;
+  const refresh = useAtomRefresh(atoms.view);
+  useEffect(() => {
+    let timer: ReturnType<typeof setTimeout>;
+    const check = () => {
+      const remaining = question.expiresAt - Date.now();
+      if (remaining <= 0) {
+        setExpired(true);
+        refresh();
+      } else timer = setTimeout(check, Math.min(remaining, 2147483000));
+    };
+    check();
+    return () => clearTimeout(timer);
+  }, [question.expiresAt, refresh]);
+  const answer = useCallback(
+    async (response: ElicitationResponse) => {
+      setError(undefined);
+      const result = await send(response);
+      if (Exit.isFailure(result)) {
+        setError(result.cause);
+        refresh();
+        throw Cause.squash(result.cause);
+      }
+      return result.value;
+    },
+    [send, refresh],
+  );
+  const decide = (action: ElicitationResponse["action"]) => {
+    const response: ElicitationResponse =
+      action === "accept"
+        ? { action, content: elicitationContent(question.form, values) }
+        : { action };
+    void answer(response).catch(() => {});
+  };
+  const disabled = sending || expired;
+  const standardForm = (
+    <form
+      className="space-y-6 pt-4"
+      onSubmit={(event) => {
+        event.preventDefault();
+        decide("accept");
+      }}
+    >
+      <ElicitationFields
+        form={question.form}
+        values={values}
+        change={(next) => {
+          setValues(next);
+          setStandard(true);
+        }}
+        disabled={disabled}
+        multiline
+      />
+      {question.display?.kind === "reconnect-account" && (
+        <p className="text-sm text-muted-foreground">
+          After reconnecting, ask the workflow to verify the connection. Your response alone does
+          not confirm it is working.
+        </p>
+      )}
+      {error !== undefined && <Failure cause={error} layout="compact" />}
+      <div className="flex flex-wrap gap-2 border-t pt-5">
+        <Button type="submit" disabled={disabled} loading={sending}>
+          {question.display?.kind === "confirm"
+            ? "Confirm"
+            : question.display?.kind === "reconnect-account"
+              ? "Verify connection"
+              : "Submit"}
+        </Button>
+        <Button
+          type="button"
+          variant="outline"
+          disabled={disabled}
+          onClick={() => decide("decline")}
+        >
+          Decline
+        </Button>
+        <Button type="button" variant="ghost" disabled={disabled} onClick={() => decide("cancel")}>
+          Cancel request
+        </Button>
+      </div>
+      <p className="text-xs text-muted-foreground">
+        Expires at <LocalTime value={question.expiresAt} options={timeOfDay} />.
+      </p>
+    </form>
+  );
+  return (
+    <div className="space-y-6">
+      <header>
+        <p className="mb-2 text-sm text-muted-foreground">
+          {question.workflow} · {question.name}
+        </p>
+        <h1 className="whitespace-pre-wrap break-words text-[22px] font-semibold tracking-[-0.035em] leading-[1.35]">
+          {question.form.message}
+        </h1>
+      </header>
+      {question.evidence.length > 0 && (
+        <dl className="space-y-3 text-sm">
+          {question.evidence.map((item) => (
+            <div key={item.label}>
+              <dt className="text-xs text-muted-foreground">{item.label}</dt>
+              <dd className="mt-1 whitespace-pre-wrap break-words">{item.value}</dd>
+            </div>
+          ))}
+        </dl>
+      )}
+      {question.links.length > 0 && (
+        <div className="flex flex-wrap gap-2">
+          {question.links.map((link) => (
+            <Button key={link.href} variant="outline" asChild>
+              <a href={link.href} target="_blank" rel="noopener noreferrer">
+                {link.label}
+              </a>
+            </Button>
+          ))}
+        </div>
+      )}
+      {expired ? (
+        <p role="status" className="text-sm text-muted-foreground">
+          This question has expired.
+        </p>
+      ) : (
+        question.display?.kind === "mcp-app" &&
+        (Display === undefined ? (
+          <p role="status" className="text-sm text-muted-foreground">
+            The custom display is unavailable. Use the form below.
+          </p>
+        ) : (
+          <Display question={question} answer={answer} onReady={setCustomReady} />
+        ))
+      )}
+      {question.display?.kind === "mcp-app" ? (
+        <details
+          open={!customReady || standard}
+          onToggle={(event) => {
+            if (customReady) setStandard(event.currentTarget.open);
+          }}
+        >
+          <summary className="cursor-pointer text-sm font-medium">Use the standard form</summary>
+          {standardForm}
+        </details>
+      ) : (
+        standardForm
+      )}
+    </div>
+  );
+}
