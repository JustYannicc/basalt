+import {
+  appSandboxAddress,
+  makeWorkflowInputDisplay,
+  workflowDisplayResult,
+} from "@executor-js/mcp";
+import {
+  CurrentActor,
+  WorkflowFailure,
+  type Executor,
+  type AppId,
+  type WorkflowInputId,
+} from "@executor-js/sdk/core";
+import { Effect } from "effect";
+import type { ServerConfig } from "../contracts/config.ts";
+import type { LocalAuth } from "./auth.ts";
+import { browserOnly } from "./dashboard.ts";
+
+export const localWorkflowInputDisplay =
+  (executor: Executor, config: ServerConfig, auth: LocalAuth) =>
+  (target: { readonly app: AppId; readonly id: WorkflowInputId }, closing = false) =>
+    Effect.gen(function* () {
+      yield* browserOnly(config, auth);
+      const question = yield* executor.workflowInputs.get(target);
+      if (!closing && question.status !== "pending")
+        return yield* new WorkflowFailure({ reason: "unavailable", retryable: false });
+      return makeWorkflowInputDisplay(
+        executor,
+        target,
+        {
+          product: `workflow-input:local:${target.id}`,
+          principal: (yield* CurrentActor) ?? "local-dashboard",
+          grant: "dashboard",
+        },
+        {
+          authorizeElicitation: () => Effect.void,
+          callTool: (input, options) => executor.tools.call(input, options),
+          resumeInvocation: (pending, response, options) =>
+            executor.tools.resume({ requestId: pending.requestId, response }, options),
+        },
+        appSandboxAddress(`http://localhost:${config.port}`),
+      );
+    });
+export { workflowDisplayResult };
