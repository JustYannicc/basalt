+import type {
+  AppViewId,
+  DisplayAuthority,
+  DisplayCall,
+  DisplayResource,
+  DisplayResume,
+} from "@executor-js/mcp/workflow-display";
+import { hydrated } from "@executor-js/ui/contracts/http";
+import { revalidated } from "@executor-js/ui/contracts/refresh";
+import { acknowledge, acknowledgedQuery } from "@executor-js/ui/contracts/mutations";
+import { pollingQuery, whileLoaded } from "@executor-js/ui/contracts/polling";
+import { AppId, WorkflowInputId } from "@executor-js/sdk/core";
+import type { ElicitationResponse } from "apps/contracts";
+import { Data, Effect } from "effect";
+import { Atom } from "effect/reactivity";
+import { DashboardClient } from "./api.ts";
+
+import { questions } from "./workflow-inputs.ts";
+class InputKey extends Data.Class<{ readonly app: AppId; readonly id: WorkflowInputId }> {}
+const source = Atom.family((key: InputKey) =>
+  DashboardClient.query("workflowInputs", "get", hydrated({ params: key })).pipe(
+    revalidated,
+    acknowledgedQuery,
+  ),
+);
+const review = Atom.family((key: InputKey) => ({
+  view: pollingQuery(source(key), { active: whileLoaded((input) => input.status === "pending") }),
+  answer: DashboardClient.runtime.fn((response: ElicitationResponse, get) =>
+    Effect.flatMap(DashboardClient, (client) =>
+      client.workflowInputs.answer({ params: key, payload: { response } }),
+    ).pipe(
+      Effect.tap((saved) =>
+        Effect.sync(() => {
+          acknowledge(get, source(key), () => saved);
+          acknowledge(get, questions, (items) => items.filter((item) => item.id !== saved.id));
+        }),
+      ),
+    ),
+  ),
+}));
+export const workflowInputAtoms = (key: { readonly app: string; readonly id: string }) =>
+  review(new InputKey({ app: AppId.make(key.app), id: WorkflowInputId.make(key.id) }));
+
+const displays = Atom.family((key: InputKey) => ({
+  open: DashboardClient.runtime.fn(() =>
+    Effect.flatMap(DashboardClient, (client) => client.workflowInputs.openDisplay({ params: key })),
+  ),
+  resource: DashboardClient.runtime.fn(
+    ({ view, ...payload }: { readonly view: AppViewId } & typeof DisplayResource.Type) =>
+      Effect.flatMap(DashboardClient, (client) =>
+        client.workflowInputs.displayResource({ params: { ...key, view }, payload }),
+      ),
+  ),
+  call: DashboardClient.runtime.fn(
+    ({ view, ...payload }: { readonly view: AppViewId } & typeof DisplayCall.Type) =>
+      Effect.flatMap(DashboardClient, (client) =>
+        client.workflowInputs.displayCall({ params: { ...key, view }, payload }),
+      ),
+  ),
+  resume: DashboardClient.runtime.fn(
+    ({ view, ...payload }: { readonly view: AppViewId } & typeof DisplayResume.Type) =>
+      Effect.flatMap(DashboardClient, (client) =>
+        client.workflowInputs.displayResume({ params: { ...key, view }, payload }),
+      ),
+  ),
+  renew: DashboardClient.runtime.fn(
+    ({ view, ...payload }: { readonly view: AppViewId } & typeof DisplayAuthority.Type) =>
+      Effect.flatMap(DashboardClient, (client) =>
+        client.workflowInputs.displayRenew({ params: { ...key, view }, payload }),
+      ),
+  ),
+  close: DashboardClient.runtime.fn((view: AppViewId) =>
+    Effect.flatMap(DashboardClient, (client) =>
+      client.workflowInputs.closeDisplay({ params: { ...key, view } }),
+    ),
+  ),
+}));
+export const workflowDisplayAtoms = (key: { readonly app: string; readonly id: string }) =>
+  displays(new InputKey({ app: AppId.make(key.app), id: WorkflowInputId.make(key.id) }));
