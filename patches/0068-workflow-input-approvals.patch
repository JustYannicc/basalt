+export const workflowInputAnswerTool = "executor-workflow-input-answer";
+export const DisplayAuthority = Schema.Struct({
+  capability: Schema.String.check(Schema.isMaxLength(256)),
+});
+export const DisplayResource = Schema.Struct({
+  ...DisplayAuthority.fields,
+  uri: Schema.NonEmptyString,
+});
