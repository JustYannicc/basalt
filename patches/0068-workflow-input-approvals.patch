+/** Workflow questions keep their own identity and answer boundary beside ordinary tool approvals. */
+import type { ElicitationResponse } from "apps/contracts";
+import type { WorkflowInput, WorkflowInputId, WorkflowInputPage } from "@executor-js/sdk/core";
+import { Effect } from "effect";
+import type { Atom } from "effect/reactivity";
+import type { Query } from "./dashboard.ts";
+import type { ApprovalListItem } from "./schedules.ts";
+
+export type ApprovalQueueItem =
+  | ({ readonly kind: "scheduled" } & ApprovalListItem)
+  | {
+      readonly kind: "workflow";
+      readonly input: WorkflowInput;
+      readonly app: { readonly name: string };
+    };
+export interface WorkflowInputAtoms<E> {
+  readonly view: Query<WorkflowInput, E>;
+  readonly answer: Atom.AtomResultFn<ElicitationResponse, WorkflowInput, E>;
+}
+/** A permitted page may be empty with a cursor, so only the cursor ends the read. */
+export const workflowInputPages = <E, R>(
+  list: (after?: WorkflowInputId) => Effect.Effect<WorkflowInputPage, E, R>,
+) =>
+  Effect.gen(function* () {
+    const items: WorkflowInput[] = [];
+    let after: WorkflowInputId | undefined;
+    do {
+      const page = yield* list(after);
+      items.push(...page.items);
+      after = page.next;
+    } while (after !== undefined);
+    return items;
+  });
+export const approvalQueue = (
+  scheduled: readonly ApprovalListItem[],
+  questions: readonly WorkflowInput[],
+  apps: readonly { readonly id: string; readonly name: string }[],
+): readonly ApprovalQueueItem[] =>
+  [
+    ...scheduled.map((item): ApprovalQueueItem => ({ kind: "scheduled", ...item })),
+    ...questions.map((input): ApprovalQueueItem => ({
+      kind: "workflow",
+      input,
+      app: { name: apps.find((app) => app.id === input.app)?.name ?? "App unavailable" },
+    })),
+  ].sort(
+    (left, right) =>
+      (left.kind === "workflow"
+        ? left.input.expiresAt
+        : (left.run.expiresAt?.getTime() ?? Infinity)) -
+      (right.kind === "workflow"
+        ? right.input.expiresAt
+        : (right.run.expiresAt?.getTime() ?? Infinity)),
+  );
+
+export interface WorkflowDisplayAtoms<E> {
+  readonly open: Atom.AtomResultFn<void, AppBridgePayload, E>;
+  readonly resource: Atom.AtomResultFn<
+    { readonly view: AppViewId } & typeof DisplayResource.Type,
+    McpAppResources,
+    E
+  >;
+  readonly call: Atom.AtomResultFn<
+    { readonly view: AppViewId } & typeof DisplayCall.Type,
+    ToolCallResult,
+    E
+  >;
+  readonly resume: Atom.AtomResultFn<
+    { readonly view: AppViewId } & typeof DisplayResume.Type,
+    ToolResumeResult,
+    E
+  >;
+  readonly renew: Atom.AtomResultFn<
+    { readonly view: AppViewId } & typeof DisplayAuthority.Type,
+    typeof DisplayAuthority.Type,
+    E
+  >;
+  readonly close: Atom.AtomResultFn<AppViewId, void, E>;
+}
