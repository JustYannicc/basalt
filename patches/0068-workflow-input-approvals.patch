@@ -0,0 +1,94 @@
+/** Retained displays use the existing MCP Worker's normal invocation authorization. */
+import {
+  HostedExecutor,
+  CurrentUserId,
+  CurrentOrganization,
+  CurrentUsage,
+  ProductAnalytics,
+} from "@executor-js/hosted-server";
+import { GroupDatabase } from "@executor-js/hosted-server/groups";
+import { CurrentAuthorization } from "@executor-js/hosted-server/authorization";
+import { hostedMcpBackend } from "@executor-js/hosted-server";
+import { makeWorkflowInputDisplay, appSandboxAddress } from "@executor-js/mcp";
+import { CurrentActor } from "@executor-js/sdk/core";
+import { Effect, type Layer } from "effect";
+import type {
+  DisplayBinding,
+  DisplayEvent,
+  WorkflowDisplayRpc,
+} from "../contracts/workflow-display.ts";
+import { cloudAppUiBase } from "../contracts/app-ui.ts";
+export const makeWorkflowDisplayRpc = Effect.fn(function* (
+  services: Layer.Layer<HostedExecutor | GroupDatabase>,
+) {
+  const address = appSandboxAddress(yield* cloudAppUiBase.pipe(Effect.orDie));
+  const display = (binding: DisplayBinding) =>
+    Effect.gen(function* () {
+      return makeWorkflowInputDisplay(
+        yield* Effect.flatten(HostedExecutor),
+        binding.target,
+        binding.context,
+        yield* hostedMcpBackend,
+        address,
+      );
+    });
+  const bound = <A, E>(
+    binding: DisplayBinding,
+    work: Effect.Effect<A, E, HostedExecutor | GroupDatabase | CurrentOrganization>,
+  ) =>
+    Effect.gen(function* () {
+      const events: Array<DisplayEvent> = [];
+      const sink = yield* ProductAnalytics;
+      return yield* work.pipe(
+        Effect.provideService(CurrentActor, binding.actor),
+        Effect.provideService(CurrentUserId, binding.context.principal),
+        Effect.provideService(CurrentOrganization, binding.organization),
+        Effect.provideService(CurrentAuthorization, binding.policy),
+        Effect.provideService(CurrentUsage, binding.usage),
+        Effect.provideService(ProductAnalytics, {
+          ...sink,
+          enabled: binding.analyticsEnabled,
+          capture: (event) => {
+            events.push(event);
+          },
+        }),
+        Effect.provide(services),
+        Effect.match({
+          onFailure: () => ({ ok: false as const, events }),
+          onSuccess: (value) => ({ ok: true as const, value, events }),
+        }),
+      );
+    });
+  return {
+    open: (binding) =>
+      bound(
+        binding,
+        Effect.flatMap(display(binding), (view) => view.open),
+      ),
+    resource: (binding, ...input) =>
+      bound(
+        binding,
+        Effect.flatMap(display(binding), (view) => view.resource(...input)),
+      ),
+    call: (binding, ...input) =>
+      bound(
+        binding,
+        Effect.flatMap(display(binding), (view) => view.call(...input)),
+      ),
+    resume: (binding, ...input) =>
+      bound(
+        binding,
+        Effect.flatMap(display(binding), (view) => view.resume(...input)),
+      ),
+    renew: (binding, ...input) =>
+      bound(
+        binding,
+        Effect.flatMap(display(binding), (view) => view.renew(...input)),
+      ),
+    close: (binding, ...input) =>
+      bound(
+        binding,
+        Effect.flatMap(display(binding), (view) => view.close(...input)),
+      ),
+  } satisfies WorkflowDisplayRpc;
+});
