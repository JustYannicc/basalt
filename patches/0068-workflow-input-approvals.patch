--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/workflow-display.ts
@@ -0,0 +1,60 @@
+/** The API checks the browser and recipient, then lends authority to one private display call. */
+import * as Cloudflare from "alchemy/Cloudflare";
+import { WorkflowInputDisplays } from "@executor-js/hosted-server/workflow-display";
+import { CurrentOrganization, CurrentUsage, ProductAnalytics } from "@executor-js/hosted-server";
+import { CurrentAuthorization } from "@executor-js/hosted-server/authorization";
+import { CurrentActor, WorkflowFailure } from "@executor-js/sdk/core";
+import { Effect, Layer } from "effect";
+import { McpServer } from "./mcp-server-worker.ts";
+import type { DisplayReply } from "../contracts/workflow-display.ts";
+export const cloudWorkflowInputDisplays = Effect.gen(function* () {
+  const worker = yield* Cloudflare.Workers.bindWorker(McpServer);
+  return Layer.effect(
+    WorkflowInputDisplays,
+    Effect.gen(function* () {
+      const environment = yield* Cloudflare.WorkerEnvironment;
+      return WorkflowInputDisplays.of({
+        create: (_executor, target, context) =>
+          Effect.gen(function* () {
+            const sink = yield* ProductAnalytics;
+            const binding = {
+              target,
+              context,
+              organization: yield* CurrentOrganization,
+              policy: yield* CurrentAuthorization,
+              actor: yield* CurrentActor,
+              usage: yield* CurrentUsage,
+              analyticsEnabled: sink.enabled,
+            };
+            const result = <A>(answer: DisplayReply<A>) =>
+              Effect.sync(() => {
+                for (const event of answer.events) sink.capture(event);
+              }).pipe(
+                Effect.andThen(
+                  answer.ok
+                    ? Effect.succeed(answer.value)
+                    : Effect.fail(new WorkflowFailure({ reason: "unavailable", retryable: false })),
+                ),
+              );
+            const bound = <A, E>(
+              work: Effect.Effect<DisplayReply<A>, E, Cloudflare.WorkerEnvironment>,
+            ) =>
+              work.pipe(
+                Effect.provideService(Cloudflare.WorkerEnvironment, environment),
+                Effect.flatMap(result),
+              );
+            return {
+              open: bound(worker.open(binding)),
+              resource: (...input) => bound(worker.resource(binding, ...input)),
+              call: (id, capability, name, input) =>
+                bound(worker.call(binding, id, capability, name, input)),
+              resume: (id, capability, name, input, pending, response) =>
+                bound(worker.resume(binding, id, capability, name, input, pending, response)),
+              renew: (...input) => bound(worker.renew(binding, ...input)),
+              close: (...input) => bound(worker.close(binding, ...input)),
+            };
+          }),
+      });
+    }),
+  );
+});
