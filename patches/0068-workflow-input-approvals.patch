+/** People answer durable questions in the existing Approvals tab, with ordinary forms as fallback. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { body } from "../support/api.ts";
+import type { Page } from "playwright";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Browser } from "../support/browser.ts";
+import {
+  workflowInputFixture,
+  workflowInputFixtureFor,
+} from "../support/workflow-input-fixture.ts";
+import { workflowDisplayFiles } from "../support/workflow-display-app.ts";
+import { holdQuery, refreshVisiblePage } from "../support/query-transition.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Workflow questions in Approvals", (it) => {
+  it.effect(scenarios.workflowInputBrowser.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* workflowInputFixture;
+        const browser = yield* Browser;
+        const run = yield* f.start(86400000, "no", f.actors.owner, "defaults");
+        yield* browser.login(f.actors.owner);
+        const queue = `/org/${f.actors.organization.slug}/approvals`;
+        const messages = [
+          "Explain the exception in your own words",
+          "Choose a destination",
+          "Continue?",
+          "What amount?",
+          "Which date?",
+          "Reconnect, then ask to verify",
+          "Custom question with a form fallback",
+        ];
+        for (const [index, message] of messages.entries()) {
+          const question = yield* f.pending(run.id);
+          yield* browser.use("Open the existing Approvals queue", (page) => page.goto(queue));
+          yield* browser.use("Respond to the workflow question", (page) =>
+            page.getByRole("link", { name: "Respond", exact: true }).click(),
+          );
+          yield* browser.use("The question explains what it needs", (page) =>
+            page.getByRole("heading", { name: message, exact: true }).waitFor(),
+          );
+          if (index === 0) {
+            yield* browser.use("Enter a multiline free response", (page) =>
+              page
+                .getByRole("textbox", { name: "value" })
+                .fill("First line\nA freely written second line"),
+            );
+            yield* Effect.scoped(
+              Effect.gen(function* () {
+                const held = yield* holdQuery(
+                  [
+                    `${f.path}/workflow-inputs/${question.id}`,
+                    `/api/organizations/${f.actors.organization.slug}/apps/${question.app}/workflow-inputs/${question.id}`,
+                  ],
+                  "fail",
+                  { allRequests: true },
+                );
+                yield* refreshVisiblePage;
+                yield* held.requested;
+                expect(
+                  yield* browser.use("Read the draft during refresh", (page) =>
+                    page.getByRole("textbox", { name: "value" }).inputValue(),
+                  ),
+                ).toContain("second line");
+                yield* held.release;
+                yield* browser.use("The failed refresh keeps the draft", (page) =>
+                  page.getByRole("textbox", { name: "value" }).waitFor(),
+                );
+                expect(
+                  yield* browser.use("Read the draft after failed refresh", (page) =>
+                    page.getByRole("textbox", { name: "value" }).inputValue(),
+                  ),
+                ).toContain("second line");
+              }),
+            );
+            yield* browser.checkpoint("Free text retains the draft through a failed refresh");
+          } else if (index === 1)
+            yield* browser.use("Choose the ordinary select", (page) =>
+              page.getByRole("combobox", { name: "value", exact: true }).selectOption("two"),
+            );
+          else if (index === 3)
+            yield* browser.use("Enter a number", (page) =>
+              page.getByRole("spinbutton", { name: "value" }).fill("42.5"),
+            );
+          else if (index === 4)
+            yield* browser.use("Enter a calendar date", (page) =>
+              page.locator("input[type=date]").fill("2026-10-31"),
+            );
+          else if (index === 5) {
+            expect(
+              yield* browser.use("Reconnect asks for a fresh check", (page) =>
+                page
+                  .getByText("Your response alone does not confirm it is working.", {
+                    exact: false,
+                  })
+                  .isVisible(),
+              ),
+            ).toBe(true);
+          } else if (index === 6) {
+            yield* browser.use("Old custom descriptors keep the standard form", (page) =>
+              page
+                .getByText("The custom display is unavailable. Use the form below.", {
+                  exact: true,
+                })
+                .waitFor(),
+            );
+            yield* browser.use("Enter fallback text", (page) =>
+              page.getByRole("textbox", { name: "value" }).fill("Fallback response"),
+            );
+            yield* browser.use("Enter fallback count", (page) =>
+              page.getByRole("spinbutton", { name: "count" }).fill("2"),
+            );
+            yield* browser.use("Enter fallback amount", (page) =>
+              page.getByRole("spinbutton", { name: "amount" }).fill("5"),
+            );
+            yield* browser.use("Enter fallback boolean", (page) =>
+              page.getByRole("combobox", { name: "enabled", exact: true }).selectOption("true"),
+            );
+            yield* browser.use("Enter fallback choice", (page) =>
+              page
+                .getByRole("combobox", { name: "single", exact: true })
+                .selectOption({ label: "Second" }),
+            );
+            yield* browser.use("Enter fallback multiple choices", (page) =>
+              page
+                .getByRole("listbox", { name: "multi", exact: true })
+                .selectOption(["one", "two"]),
+            );
+            yield* browser.checkpoint(
+              "A legacy custom question remains answerable with the standard form",
+            );
+          }
+          yield* browser.use("Save the response", (page) =>
+            page
+              .getByRole("button", {
+                name: index === 2 ? "Decline" : index === 5 ? "Verify connection" : "Submit",
+                exact: true,
+              })
+              .click(),
+          );
+          yield* browser.use("Only the saved response is confirmed", (page) =>
+            page.getByRole("heading", { name: "Response saved", exact: true }).waitFor(),
+          );
+          if (index === 0)
+            expect(
+              (yield* f.api.request(
+                f.actors.owner,
+                "GET",
+                `${f.path}/workflow-inputs/${question.id}`,
+              )).body,
+            ).toMatchObject({
+              response: { content: { value: "First line\nA freely written second line" } },
+            });
+        }
+        expect(yield* f.wait(run.id)).toMatchObject({ status: "complete" });
+      }),
+    ),
+  );
+
+  it.effect(scenarios.workflowDisplayBrowser.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* workflowInputFixtureFor(workflowDisplayFiles);
+        const browser = yield* Browser;
+        const run = yield* f.start(86400000, "no", f.actors.owner, "custom");
+        const question = yield* f.pending(run.id);
+        yield* browser.login(f.actors.owner);
+        const guest = (page: Page) =>
+          page
+            .frameLocator('iframe[title="Custom workflow display"]')
+            .frameLocator('iframe[title="App content"]');
+        const url = `/org/${f.actors.organization.slug}/approvals/workflow/${question.app}/${question.id}`;
+        yield* browser.use("Open an authored custom question", (page) => page.goto(url));
+        yield* browser.use("The native app receives its own input", (page) =>
+          guest(page).getByText("Frame input", { exact: true }).waitFor(),
+        );
+        yield* browser.use("The app is ready", (page) =>
+          guest(page)
+            .getByRole("status")
+            .filter({ hasText: /^Ready$/ })
+            .waitFor(),
+        );
+        expect(
+          yield* browser.use("The custom view initially folds the fallback", (page) =>
+            page.locator("details").first().getAttribute("open"),
+          ),
+        ).toBe(null);
+        yield* browser.use("Read the original source's resource", (page) =>
+          guest(page).getByRole("button", { name: "Read note", exact: true }).click(),
+        );
+        yield* browser.use("The resource remains bound to Alpha", (page) =>
+          guest(page)
+            .getByRole("status")
+            .filter({ hasText: /^Alpha source note$/ })
+            .waitFor(),
+        );
+        yield* browser.use("A callback cannot jump to another source", (page) =>
+          guest(page).getByRole("button", { name: "Other source", exact: true }).click(),
+        );
+        yield* browser.use("The source mismatch is explained without replay", (page) =>
+          page.getByRole("alert").first().waitFor(),
+        );
+        expect((yield* f.rows()).body).toEqual([]);
+        yield* browser.use("Control the display's elapsed lifetime", (page) =>
