@@ -0,0 +1,139 @@
+import { guestCapabilities } from "./app-capabilities.ts";
+/** A dashboard uses the same MCP Apps bridge and isolated proxy as external MCP clients. */
+import { AppBridge, buildAllowAttribute } from "@modelcontextprotocol/ext-apps/app-bridge";
+import {
+  PostMessageTransport,
+  McpUiToolResultNotificationSchema,
+} from "@modelcontextprotocol/ext-apps";
+import { Schema } from "effect";
+import type { McpAppResources, McpToolResult } from "apps/contracts";
+import { Json } from "@executor-js/sdk/core";
+import type { AppBridgePayload } from "../contracts/app-bridge.ts";
+
+export const mountAppFrame = (
+  frame: HTMLIFrameElement,
+  payload: AppBridgePayload,
+  options: {
+    readonly call: (name: string, input: Json, signal: AbortSignal) => Promise<McpToolResult>;
+    readonly resource: (uri: string, signal: AbortSignal) => Promise<McpAppResources>;
+    readonly ready: () => void;
+    readonly failed: () => void;
+  },
+) => {
+  const lifetime = new AbortController();
+  const signal = lifetime.signal;
+  const context = () => ({
+    displayMode: "inline" as const,
+    theme: document.documentElement.classList.contains("dark")
+      ? ("dark" as const)
+      : ("light" as const),
+  });
+  const capabilities = guestCapabilities({ openLinks: {} }, payload.policy);
+  const bridge = new AppBridge(null, { name: "Executor", version: "1.0.0" }, capabilities, {
+    hostContext: context(),
+  });
+  const timeout = setTimeout(options.failed, 15000);
+  bridge.oncalltool = async ({ name, arguments: input }, extra) => {
+    const active = AbortSignal.any([signal, extra.signal]);
+    active.throwIfAborted();
+    const value = await options.call(name, Schema.decodeUnknownSync(Json)(input ?? {}), active);
+    active.throwIfAborted();
+    return McpUiToolResultNotificationSchema.shape.params.parse(value);
+  };
+  bridge.onreadresource = async ({ uri }, extra) => {
+    const active = AbortSignal.any([signal, extra.signal]);
+    active.throwIfAborted();
+    const resource = await options.resource(uri, active);
+    active.throwIfAborted();
+    return {
+      contents: resource.contents.map((item) => {
+        const common = {
+          uri: item.uri,
+          ...(item.mimeType === undefined ? {} : { mimeType: item.mimeType }),
+          ...(item._meta === undefined ? {} : { _meta: item._meta }),
+        };
+        if (item.text !== undefined) return { ...common, text: item.text };
+        if (item.blob !== undefined) return { ...common, blob: item.blob };
+        throw new Error("Resource has no content");
+      }),
+      ...(resource._meta === undefined ? {} : { _meta: resource._meta }),
+    };
+  };
+  bridge.onopenlink = async ({ url }) => {
+    const target = new URL(url, window.location.href);
+    if (target.protocol !== "https:" && target.origin !== window.location.origin)
+      return { isError: true };
+    window.open(target.href, "_blank", "noopener,noreferrer");
+    return {};
+  };
+  bridge.onsizechange = ({ height }) => {
+    if (height !== undefined && Number.isFinite(height))
+      frame.style.height = `${Math.max(100, Math.min(6000, height))}px`;
+  };
+  bridge.oninitialized = async () => {
+    try {
+      await bridge.sendToolInput({ arguments: payload.input });
+      await bridge.sendToolResult(
+        McpUiToolResultNotificationSchema.shape.params.parse(payload.result),
+      );
+      if (!signal.aborted) {
+        clearTimeout(timeout);
+        options.ready();
+      }
+    } catch {
+      if (!signal.aborted) options.failed();
+    }
+  };
+  const observer = new MutationObserver(() => bridge.setHostContext(context()));
+  observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
+  const target = new URL(payload.sandboxUrl);
+  const ready = new Promise<void>((resolve, reject) => {
+    const cleanup = () => {
+      window.removeEventListener("message", receive);
+      signal.removeEventListener("abort", abort);
+    };
+    const abort = () => {
+      cleanup();
+      reject(new Error("Display closed"));
+    };
+    const receive = (event: MessageEvent) => {
+      if (
+        event.source === frame.contentWindow &&
+        event.origin === target.origin &&
+        event.data?.method === "ui/notifications/sandbox-proxy-ready"
+      ) {
+        cleanup();
+        resolve();
+      }
+    };
+    window.addEventListener("message", receive);
+    signal.addEventListener("abort", abort, { once: true });
+  });
+  frame.sandbox.add("allow-scripts", "allow-same-origin", "allow-forms");
+  const allow = buildAllowAttribute(capabilities.sandbox.permissions);
+  if (allow) frame.setAttribute("allow", allow);
+  frame.src = target.href;
+  void ready
+    .then(async () => {
+      signal.throwIfAborted();
+      if (frame.contentWindow === null) throw new Error("Display closed");
+      await bridge.connect(new PostMessageTransport(frame.contentWindow, frame.contentWindow));
+      await bridge.sendSandboxResourceReady({
+        html: payload.html,
+        permissions: capabilities.sandbox.permissions,
+      });
+    })
+    .catch(() => {
+      if (!signal.aborted) options.failed();
+    });
+  return () => {
+    lifetime.abort();
+    observer.disconnect();
+    clearTimeout(timeout);
+    void bridge
+      .teardownResource({}, { timeout: 3000 })
+      .catch(() => {})
+      .finally(() => bridge.close());
+    frame.removeAttribute("src");
+  };
+};
