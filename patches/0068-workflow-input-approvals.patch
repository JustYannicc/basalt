+        ),
+      )
+      .handle("displayCall", ({ params, payload }) =>
+        Effect.flatMap(hostedWorkflowInputDisplay(params), (display) =>
+          workflowDisplayResult(
+            display.call(params.view, payload.capability, payload.name, payload.input),
+          ),
+        ),
+      )
+      .handle("displayResume", ({ params, payload }) =>
+        Effect.flatMap(hostedWorkflowInputDisplay(params), (display) =>
+          workflowDisplayResult(
+            display.resume(
+              params.view,
+              payload.capability,
+              payload.name,
+              payload.input,
+              payload.pending,
+              payload.response,
+            ),
+          ),
+        ),
+      )
+      .handle("displayRenew", ({ params, payload }) =>
+        Effect.flatMap(hostedWorkflowInputDisplay(params), (display) =>
+          workflowDisplayResult(
+            display
+              .renew(params.view, payload.capability)
+              .pipe(Effect.map((capability) => ({ capability }))),
+          ),
+        ),
+      )
+      .handle("closeDisplay", ({ params }) =>
+        Effect.flatMap(hostedWorkflowInputDisplay(params, true), (display) =>
+          workflowDisplayResult(display.close(params.view)),
+        ),
       ),
 );
