diff --git a/e2e/support/workflow-display-app.ts b/e2e/support/workflow-display-app.ts
new file mode 100644
index 0000000..5bb115f
--- /dev/null
+++ b/e2e/support/workflow-display-app.ts
@@ -0,0 +1,44 @@
+/** An authored custom question binds one router and leaves callbacks behind ordinary tool consent. */
+import { appsManifest } from "./apps-release.ts";
+const html = `<!doctype html><html><head><title>Custom question</title></head><body>
+<h1>Choose your response</h1><label>Draft<input value="Custom answer"></label>
+<button id="save">Save draft</button><button id="read">Read note</button><button id="wrong">Other source</button><button id="invalid">Invalid answer</button><button id="answer">Send response</button><p id="input"></p><p role="status">Starting</p>
+<script>
+let sequence=0;const pending=new Map();
+const call=(method,params)=>new Promise((resolve,reject)=>{const id=++sequence;pending.set(id,{resolve,reject});parent.postMessage({jsonrpc:"2.0",id,method,params},"*");});
+const status=document.querySelector("[role=status]");
+window.addEventListener("message",event=>{if(event.source!==parent)return;const m=event.data;
+if(m.method==="ui/resource-teardown"){parent.postMessage({jsonrpc:"2.0",id:m.id,result:{}},"*");return;}
+if(m.id!==undefined){const p=pending.get(m.id);if(!p)return;pending.delete(m.id);if(m.error)p.reject(new Error(m.error.message));else p.resolve(m.result);}
+else if(m.method==="ui/notifications/tool-input")document.querySelector("#input").textContent=m.params.arguments.text;
+else if(m.method==="ui/notifications/tool-result")status.textContent="Ready";});
+const tool=(name,args)=>call("tools/call",{name,arguments:args}).then(r=>{status.textContent=r.content?.[0]?.text??"Done";}).catch(()=>{status.textContent="Action failed";});
+document.querySelector("#save").onclick=()=>tool("edit",{text:document.querySelector("input").value});
+document.querySelector("#wrong").onclick=()=>tool("beta.edit",{text:"Wrong source"});
+document.querySelector("#read").onclick=()=>call("resources/read",{uri:"fixture://note"}).then(r=>{status.textContent=r.contents[0].text;}).catch(()=>{status.textContent="Read failed";});
+document.querySelector("#invalid").onclick=()=>tool("executor-workflow-input-answer",{action:"accept",content:{value:"x"}});
+document.querySelector("#answer").onclick=()=>tool("executor-workflow-input-answer",{action:"accept",content:{value:document.querySelector("input").value}});
+call("ui/initialize",{appInfo:{name:"Custom question",version:"1"},appCapabilities:{},protocolVersion:"2026-01-26"}).then(()=>parent.postMessage({jsonrpc:"2.0",method:"ui/notifications/initialized",params:{}},"*"));
+</script></body></html>`;
+export const workflowDisplayFiles = [
+  appsManifest,
+  {
+    path: "index.ts",
+    content: `import { defineApp, workflow, query, mutation, object, string, number, router } from "apps";
+import { always } from "apps/operations/approval";
+const result = text => ({ content: [{ type: "text", text }], structuredContent: { text } });
+const rows = query({input:object({})},async ctx=>ctx.sql.exec("SELECT answer FROM receipts").toArray());
+const source = name => router({
+ open: query({input:object({text:string()})},async()=>{throw new Error("The original tool must not execute to show a question");}),
+ edit: mutation({input:object({text:string()}),approval:always()},async(ctx,input)=>{ctx.sql.exec("INSERT INTO receipts(answer) VALUES (?)",input.text);return result(name+" saved "+input.text);}),
+},{mcpResources:async uri=>({contents:[{uri,mimeType:uri.startsWith("ui:")?"text/html;profile=mcp-app":"text/plain",text:uri.startsWith("ui:")?${JSON.stringify(html)}:name+" source note",_meta:{ui:{csp:{connectDomains:[],resourceDomains:[]}}}}]})});
+const custom=workflow({input:object({timeoutMs:number(),protected:string()})},async(ctx,input)=>{
+ const question=await ctx.step.requestInput("custom response",{timeoutMs:input.timeoutMs,
+ form:{mode:"form",message:"Custom question with a standard form",requestedSchema:{type:"object",properties:{value:{type:"string",minLength:2}},required:["value"]}},
