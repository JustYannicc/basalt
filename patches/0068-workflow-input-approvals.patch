diff --git a/packages/mcp/src/implementation/workflow-display.ts b/packages/mcp/src/implementation/workflow-display.ts
new file mode 100644
index 0000000..6e5271a
--- /dev/null
+++ b/packages/mcp/src/implementation/workflow-display.ts
@@ -0,0 +1,36 @@
+import {
+  AppViewsHost,
+  WorkflowHost,
+  WorkflowFailure,
+  type AppViewContext,
+  type Executor,
+} from "@executor-js/sdk/core";
+import { Effect } from "effect";
+import type { McpBackend } from "../contracts/backend.ts";
+import type { AppSandboxAddress } from "../contracts/app-sandbox.ts";
+import { makeMcpAppViews } from "./app-views-backend.ts";
+
+/** Products check the question's recipient and pending state before binding this request. */
+export const makeWorkflowInputDisplay = (
+  executor: Executor,
+  target: Parameters<Executor[typeof WorkflowHost]["inputView"]>[0],
+  context: AppViewContext,
+  backend: Pick<McpBackend<Error>, "authorizeElicitation" | "callTool" | "resumeInvocation">,
+  address: AppSandboxAddress | undefined,
+) => {
+  const views = makeMcpAppViews(executor, Effect.succeed(context), backend, address);
+  return {
+    ...views,
+    open: executor[WorkflowHost].inputView(target).pipe(
+      Effect.flatMap(views.retainObserved),
+      Effect.flatMap(({ id }) => views.show(id)),
+      Effect.map(({ payload }) => payload),
+    ),
+    close: (id: Parameters<typeof views.show>[0]) => executor[AppViewsHost].release(context, id),
+  };
+};
+/** A custom display failure leaves its ordinary form usable and exposes no adapter internals. */
+export const workflowDisplayResult = <A, R>(work: Effect.Effect<A, unknown, R>) =>
+  work.pipe(
+    Effect.mapError(() => new WorkflowFailure({ reason: "unavailable", retryable: false })),
+  );
