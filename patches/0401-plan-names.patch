diff --git a/e2e/tests/account-plan-names.spec.ts b/e2e/tests/account-plan-names.spec.ts
new file mode 100644
index 0000000..50c69c4
--- /dev/null
+++ b/e2e/tests/account-plan-names.spec.ts
@@ -0,0 +1,137 @@
+/** The same reported tier names an account everywhere it can be selected. */
+import { expect, layer } from "@effect/vitest";
+import { Effect } from "effect";
+import { body } from "../support/api.ts";
+import { linkAccount } from "../support/app-accounts.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import {
+  allowance,
+  observationFixture,
+  observationSource,
+} from "../support/account-observation-fixture.ts";
+import { anyRowMenuName } from "../support/account-choices.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { Evidence } from "../support/evidence.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Account plan names", (it) => {
+  it.effect(scenarios.accountPlanNames.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const browser = yield* Browser,
+          evidence = yield* Evidence;
+        const results: {
+          width: number;
+          surface: string;
+          raw: string;
+          expected: string;
+          label: string;
+          title: string | null;
+        }[] = [];
+        for (const [raw, expected] of [
+          ["pro", "Pro (More)"],
+          ["promax", "Pro (Max)"],
+          ["plus", "Plus"],
+        ] as const) {
+          const family = {
+            id: "openai",
+            name: "OpenAI",
+            methods: { key: { mechanism: "interactive", offering: "subscription" } },
+          };
+          const f = yield* observationFixture({
+            name: `ChatGPT ${raw}`,
+            providerName: "OpenAI",
+            family,
+            observe: true,
+            health: false,
+          });
+          const label = `ChatGPT ${raw} account`;
+          expect(
+            (yield* f.api.request(f.actors.owner, "PATCH", f.accountPath, { label })).status,
+          ).toBe(200);
+          const reading = allowance();
+          yield* f.backend.answer({
+            status: 200,
+            body: {
+              ...reading,
+              observation: {
+                ...reading.observation,
+                offering: "subscription",
+                plan: { label: raw, observedAt: reading.observedAt },
+              },
+            },
+          });
+          expect((yield* f.refresh()).status).toBe(200);
+          const deployed = yield* f.api.request(f.actors.owner, "POST", `${f.prefix}/apps/deploy`, {
+            name: `Plan pool ${raw}`,
+            files: [
+              appsManifest,
+              {
+                path: "index.ts",
+                content: observationSource(f.backend.origin, {
+                  family,
+                  providerName: "OpenAI",
+                  observe: true,
+                  health: false,
+                  pool: "models",
+                }),
+              },
+            ],
+          });
+          expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+          const pool = (yield* body(Resource, deployed)).id;
+          yield* Effect.addFinalizer(() =>
+            f.api.request(f.actors.owner, "DELETE", `${f.prefix}/apps/${pool}`).pipe(Effect.orDie),
+          );
+          yield* linkAccount(
+            f.actors.owner,
+            `${f.prefix}/apps/${pool}`,
+            "models",
+            f.account,
+            "app",
+          );
+          yield* browser.login(f.actors.owner);
+          const base = `/org/${f.actors.organization.slug}`;
+          for (const width of [1280, 390]) {
+            for (const [surface, path] of [
+              ["accounts", `${base}/accounts`],
+              ["app", `${base}/apps/${f.app.id}?view=accounts`],
+              ["pool", `${base}/apps/${pool}?view=accounts`],
+            ] as const) {
+              const result = yield* browser.use(`Read ${raw} on ${surface} at ${width}`, (page) => {
+                const plan = page
+                  .locator(surface === "accounts" ? ".inventory-row" : "li")
+                  .filter({ has: page.getByRole("button", { name: anyRowMenuName(label) }) })
+                  .first()
+                  .locator("[data-account-plan]")
+                  .first();
+                return page
+                  .setViewportSize({ width, height: 780 })
+                  .then(() => page.goto(path))
+                  .then(() => plan.waitFor())
+                  .then(() => Promise.all([plan.innerText(), plan.getAttribute("title")]))
+                  .then(([label, title]) => ({ label, title }));
+              });
+              yield* evidence.attach(
+                `${raw}-${surface}-${width}.png`,
+                "image/png",
+                yield* browser.use("Capture plan label", (page) => page.screenshot()),
+              );
+              results.push({ width, surface, raw, expected, ...result });
+            }
+          }
+        }
+        yield* evidence.json("plan-labels.json", results);
+        for (const result of results) {
+          expect(result.label, `${result.raw} on ${result.surface} at ${result.width}`).toBe(
+            result.expected,
+          );
+          expect(result.title).toBe(result.expected);
+        }
+      }),
+    ),
+  );
+});
