@@ -0,0 +1,60 @@
+import { AccountId, OwnerId } from "@executor-js/sdk/core";
+import { Clock, Config, Effect, Option, Redacted, Schema } from "effect";
+import { HttpServerRequest, HttpServerResponse } from "effect/http";
+import { HostedExecutor } from "../contracts/executor.ts";
+import { policyDatabase } from "./resource-policy.ts";
+import { accountAcquisitionPrefix } from "./pool-account-acquisition-contract.ts";
+import { openEnvelope } from "./pool-token.ts";
+
+export const observationPublishPath = "/api/internal/account-observations/refresh";
+const Request = Schema.Struct({
+  action: Schema.Literal("refresh-observations"),
+  at: Schema.Finite,
+  expiresAt: Schema.Finite,
+});
+const Account = Schema.Struct({ account: AccountId, owner: OwnerId });
+
+/**
+ * Refresh the retained usage report of every saved account with a current Home binding, including
+ * accounts no pool uses. Callable by anything that owns a schedule; the source keeps its own caps.
+ */
+export const refreshHomeBoundObservations = Effect.gen(function* () {
+  const sql = yield* policyDatabase;
+  const executor = yield* Effect.flatten(HostedExecutor);
+  // Only the model-provider driver owns usage. Connector accounts are never candidates.
+  const rows = yield* sql`select a.id as account, a.owner from executor_accounts a
+    join executor_account_acquisitions binding on binding.account = a.id
+    where binding.driver = 'basalt-home' and binding.removal is null
+      and binding.owner = a.owner and binding.provider = a.provider
+      and binding.method = a.method and binding.generation = a.credential_generation
+    order by a.id`;
+  const accounts = yield* Schema.decodeUnknownEffect(Schema.Array(Account))(rows);
+  yield* Effect.forEach(
+    accounts,
+    (account) =>
+      executor.accounts
+        .refreshObservations({ ...account, apps: [] })
+        .pipe(Effect.catch(() => Effect.logWarning("Native account observation refresh failed"))),
+    { concurrency: 4, discard: true },
+  );
+});
+
+/** The existing Home alarm's signed request; it only authenticates and runs the refresh. */
+export const publishAccountObservations = Effect.gen(function* () {
+  const key = yield* Config.Redacted("POOL_APP_SIGNING_KEY").pipe(Config.option);
+  if (Option.isNone(key)) return HttpServerResponse.empty({ status: 503 });
+  const body = yield* HttpServerRequest.schemaBodyJson(
+    Schema.Struct({ envelope: Schema.NonEmptyString }),
+  );
+  const raw = yield* Effect.tryPromise(() =>
+    openEnvelope(Redacted.value(key.value), accountAcquisitionPrefix, body.envelope),
+  );
+  const value = yield* Schema.decodeUnknownEffect(Request)(raw);
+  const now = yield* Clock.currentTimeMillis;
+  if (value.at > now || value.expiresAt <= now || value.expiresAt > value.at + 30_000)
+    return HttpServerResponse.empty({ status: 401 });
+  // Four accounts collect concurrently. Bound the whole scan inside the caller's 30 s timeout;
+  // accounts not reached in this pass remain due and completed reports retain their own cooldown.
+  yield* refreshHomeBoundObservations.pipe(Effect.timeout(25_000));
+  return HttpServerResponse.empty({ status: 204 });
+}).pipe(Effect.catch(() => Effect.succeed(HttpServerResponse.empty({ status: 503 }))));
