@@ -0,0 +1,57 @@
+/** A visible account row picks up a newly retained usage report without a manual refresh. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import type { Page } from "playwright";
+import { body } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { allowance, observationFixture } from "../support/account-observation-fixture.ts";
+import { advanceToReconciliation, installBrowserClock } from "../support/query-transition.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Detail = Schema.Struct({ account: Schema.Struct({ label: Schema.String }) });
+const Retained = Schema.Struct({
+  reports: Schema.Array(Schema.Struct({ result: Schema.Struct({ observedAt: Schema.String }) })),
+});
+
+layer(HostedLive, { excludeTestServices: true })("Account observation row polling", (it) => {
+  it.effect(scenarios.accountObservationRowPolling.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const browser = yield* Browser;
+        const f = yield* observationFixture({ observe: true, health: true, shared: true });
+        yield* f.backend.answer({ status: 200, body: allowance() });
+        const label = (yield* body(Detail, yield* f.detail())).account.label || "Unnamed account";
+        const block = (page: Page) =>
+          page.getByRole("group", { name: `Usage and health of ${label}`, exact: true });
+        const source = (page: Page) => block(page).locator("[data-usage-source] time");
+
+        yield* installBrowserClock;
+        yield* browser.login(f.actors.owner);
+        yield* browser.use("Open Accounts with nothing retained yet", (page) =>
+          page
+            .goto(`/org/${f.actors.organization.slug}/accounts`)
+            .then(() => block(page).getByText("No usage reported").waitFor()),
+        );
+
+        // Stands in for the server interval: a report is retained while the row stays open.
+        expect((yield* f.refresh()).status).toBe(200);
+        const observedAt = (yield* body(Retained, yield* f.read())).reports[0]?.result.observedAt;
+        expect(observedAt).toBeDefined();
