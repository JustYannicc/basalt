diff --git a/e2e/tests/account-observation-interval.spec.ts b/e2e/tests/account-observation-interval.spec.ts
new file mode 100644
index 0000000..c7d2530
--- /dev/null
+++ b/e2e/tests/account-observation-interval.spec.ts
@@ -0,0 +1,184 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { createHmac } from "node:crypto";
+import { Actors } from "../support/actors.ts";
+import { Browser } from "../support/browser.ts";
+import { Api, body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { ObservationView, allowance } from "../support/account-observation-fixture.ts";
+import { providerAccountProduct } from "../support/provider-account-product.ts";
+import { providerAppsCatalog } from "../support/provider-apps-catalog.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+// Covers the tools-service side of the pool alarm's signed request. The alarm sending it is proven
+// by the pool Worker's unit test only; a deployed alarm-to-tools delivery is not exercised here.
+// Also unproven by e2e, covered by unit tests only: the publish scan's 25 s limit (accounts not
+// reached keep their state and stay due) and a first collection that fails before any reading.
+layer(HostedLive, { excludeTestServices: true })("Automatic account readings", (it) => {
+  it.effect(scenarios.accountObservationInterval.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          home = yield* providerAppsCatalog;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const apps: string[] = [],
+          accounts: string[] = [];
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* serverControl("start");
+            for (const app of apps)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app}`);
+            for (const account of accounts)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`);
+          }).pipe(Effect.orDie),
+        );
+        yield* providerAccountProduct(home.origin, `${home.origin}/catalog/index.json`);
+        const installed = yield* api.request(actors.owner, "POST", `${prefix}/apps/install`, {
+          entry: "provider-openai",
+          name: "Usage interval fixture",
+        });
+        expect(installed.status, JSON.stringify(installed.body)).toBe(200);
+        const app = (yield* body(Resource, installed)).id;
+        apps.push(app);
+        const pending = yield* api.request(
+          actors.owner,
+          "POST",
+          `${prefix}/apps/${app}/accounts/app/openai/connections`,
+          {},
+        );
+        const connection = (yield* body(Resource, pending)).id;
+        const connect = `${prefix}/connections/${connection}/interactive`;
+        expect(
+          (yield* api.request(actors.owner, "POST", `${connect}/start`, { method: "codex" }))
+            .status,
+        ).toBe(200);
+        const connected = yield* api.request(actors.owner, "POST", `${connect}/submit`, {
+          value: "synthetic-callback",
+        });
+        const account = (yield* body(Schema.Struct({ account: Resource }), connected)).account.id;
+        accounts.push(account);
+        // Deleting the app leaves the native account saved with no membership or app reporter.
+        expect((yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app}`)).status).toBe(
+          200,
+        );
+        const read = () =>
+          api
+            .request(actors.owner, "GET", `${prefix}/accounts/${account}/observations`)
+            .pipe(Effect.flatMap((response) => body(ObservationView, response)));
+        expect((yield* read()).reports).toEqual([]);
+        let offset = 0;
+        const advance = (milliseconds: number) =>
+          Effect.gen(function* () {
+            yield* serverControl("stop");
+            yield* serverControl("clock/advance", 200, { milliseconds });
+            yield* home.advance(milliseconds);
+            offset += milliseconds;
+            yield* serverControl("start");
+          });
+        const publish = () =>
+          Effect.gen(function* () {
+            const at = Date.now() + offset;
+            const payload = Buffer.from(
+              JSON.stringify({ action: "refresh-observations", at, expiresAt: at + 30_000 }),
+            ).toString("base64url");
+            const signature = createHmac("sha256", Buffer.from("ab".repeat(32), "hex"))
+              .update(`sbaa1.${payload}`)
+              .digest("base64url");
+            return yield* api.request(
+              actors.owner,
+              "POST",
+              "/api/internal/account-observations/refresh",
+              { envelope: `sbaa1.${payload}.${signature}` },
+            );
+          });
+        // The Home collection is queued but has not produced its first reading.
+        expect((yield* publish()).status).toBe(204);
+        expect((yield* read()).reports[0]).toMatchObject({
+          result: null,
+          lastAttempt: null,
+          collecting: false,
+        });
+        const browser = yield* Browser;
+        yield* browser.login(actors.owner);
+        yield* browser.use("A queued first reading is neutral", (page) =>
+          page
+            .goto(`/org/${actors.organization.slug}/accounts`)
+            .then(() => page.getByText("Checking usage…", { exact: true }).waitFor())
+            .then(() =>
+              Promise.all([
+                page.locator("[data-account-observations]").getByText("Refresh failed").count(),
+                page.locator("[data-account-observations]").getByText("No usage reported").count(),
+              ]),
+            )
+            .then((counts) => expect(counts).toEqual([0, 0])),
+        );
+        yield* advance(61_000);
+        const initial = allowance(new Date(Date.now() + offset).toISOString());
+        const staleAt = new Date(
+          Date.parse(initial.observedAt) + 40 * 60_000 + 30_000,
+        ).toISOString();
+        const first = {
+          ...initial,
+          observation: {
+            ...initial.observation,
+            plan: { ...initial.observation.plan, staleAt },
+            windows: initial.observation.windows.map((window) => ({ ...window, staleAt })),
+            balances: initial.observation.balances.map((balance) => ({ ...balance, staleAt })),
+          },
+        };
+        yield* home.observation(first);
+        expect((yield* publish()).status).toBe(204);
+        expect((yield* read()).reports[0]).toMatchObject({
+          source: { kind: "driver", id: "basalt-home" },
+          result: { observedAt: first.observedAt },
+          freshness: "fresh",
+        });
+        yield* advance(6 * 60_000);
+        expect((yield* read()).reports[0]).toMatchObject({
+          result: { observedAt: first.observedAt },
+          freshness: "fresh",
+        });
+        // A bounded wait returning a retained snapshot has no failed source attempt.
+        yield* home.observation(first);
+        expect((yield* publish()).status).toBe(204);
+        expect((yield* read()).reports[0]).toMatchObject({
+          result: { observedAt: first.observedAt },
+          lastAttempt: { outcome: "success" },
+        });
+        yield* advance(35 * 60_000);
+        expect((yield* read()).reports[0]).toMatchObject({
+          result: { observedAt: first.observedAt },
+          freshness: "stale",
+        });
+        const second = allowance(new Date(Date.now() + offset).toISOString());
+        const retryAt = new Date(Date.now() + offset + 60 * 60_000).toISOString();
+        yield* home.observation({
+          ...second,
+          collection: { attemptedAt: second.observedAt, outcome: "rate_limited", retryAt },
+        });
+        expect((yield* publish()).status).toBe(204);
+        const refreshed = yield* read();
+        expect(refreshed.reports[0]).toMatchObject({
+          result: { observedAt: second.observedAt },
+          lastAttempt: { outcome: "rate_limited", retryAt },
+        });
+        expect(Date.parse(second.observedAt)).toBeGreaterThan(Date.parse(first.observedAt));
+        const count = (yield* home.calls).filter((call) => call.action === "observe").length;
+        expect(count).toBe(4);
+        yield* advance(31 * 60_000);
+        expect((yield* publish()).status).toBe(204);
+        expect((yield* home.calls).filter((call) => call.action === "observe")).toHaveLength(count);
+        expect((yield* read()).reports[0]).toEqual(refreshed.reports[0]);
+        expect(
+          (yield* api.request(actors.owner, "POST", "/api/internal/account-observations/refresh", {
+            envelope: "invalid",
+          })).status,
+        ).toBe(503);
+      }),
+    ),
+  );
+});
