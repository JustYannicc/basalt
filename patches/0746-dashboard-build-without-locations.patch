+/**
+ * Build options that keep the dashboard's output the same bytes from any dependency store.
+ *
+ * Rolldown marks each bundled module with a `//#region <path>` comment by default. The path runs
+ * through the dependency store, whose directory is new on every install, so the server build's
+ * chunks, their names and the Dashboard Worker that bundles them changed on every fresh install.
+ */
+export const reproducibleBuild = {
+  rolldownOptions: { experimental: { attachDebugInfo: "none" } },
+} as const;
