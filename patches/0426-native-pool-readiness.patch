@@ -0,0 +1,46 @@
+import {
+  AccountAcquisitionHost,
+  AccountId,
+  OwnerId,
+  StorageError,
+  type AppId,
+  type Executor,
+} from "@executor-js/sdk/core";
+import { Effect, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import { usableAppLinks } from "./app-link-policy.ts";
+
+const Candidate = Schema.Struct({ account: AccountId, owner: OwnerId, generation: Schema.Int });
+
+/** Retained selections need the same mirror as new selections, before the organization lock. */
+export const preparePoolMembershipMirrors = (
+  executor: Executor,
+  organization: string,
+  pool: AppId,
+) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const rows = yield* sql`select distinct a.id as account, a.owner,
+      a.credential_generation as generation from ${yield* usableAppLinks(sql, [pool])}
+      and exists (select 1 from organization o
+        cross join lateral jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) entry
+        where o.id = ${organization} and entry.value ->> 'app' = app.id
+          and app.owner = 'organization:' || o.id)
+      and exists (select 1 from executor_deployments d where d.id = app.active_deployment
+        and d.requirements::jsonb -> 'accounts' -> l.requirement ->> 'scope' = 'app'
+        and d.requirements::jsonb -> 'accounts' -> l.requirement ->> 'provider' = a.provider
+        and d.requirements::jsonb -> 'accounts' -> l.requirement -> 'definition' -> 'auth' -> a.method ->> 'type' = 'secrets'
+        and coalesce(d.requirements::jsonb -> 'accounts' -> l.requirement -> 'definition' -> 'auth' -> a.method ->> 'provisioned', 'false') <> 'true')
+      and not exists (select 1 from executor_account_acquisitions r where r.account = a.id
+        and (r.driver <> 'basalt-home' or r.owner <> a.owner or r.provider <> a.provider
+          or r.method <> a.method or r.generation <> a.credential_generation
+          or r.removal is not null or r.mirror_reference is null or r.mirror_ready))`;
+    const candidates = yield* Schema.decodeUnknownEffect(Schema.Array(Candidate))(rows);
+    for (const candidate of candidates)
+      yield* executor[AccountAcquisitionHost].ensureMirror({
+        account: candidate.account,
+        owner: candidate.owner,
+        expectedGeneration: candidate.generation,
+        operation: `native-pool-link:${pool}:${candidate.account}:${candidate.generation}`,
+      });
+  }).pipe(Effect.mapError(() => new StorageError()));
