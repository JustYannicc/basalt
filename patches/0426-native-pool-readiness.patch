new file mode 100644
index 0000000..e59dac3
--- /dev/null
+++ b/e2e/support/legacy-pool-key.ts
@@ -0,0 +1,99 @@
+import { Effect, FileSystem, Path, Schema } from "effect";
+import { Actors } from "./actors.ts";
+import { Api, body } from "./api.ts";
+import { productionOpsClient, Response, Inventory } from "./production-ops-client.ts";
+import { cloudLocks } from "./cloud-locks.ts";
+
+const Resource = Schema.Struct({ id: Schema.String });
+const Source = Schema.Struct({
+  files: Schema.Array(Schema.Struct({ path: Schema.String, content: Schema.String })),
+});
+
+/** A saved key selected before native pool links required a credential mirror. */
+export const legacyPoolKey = (pool: string) =>
+  Effect.gen(function* () {
+    const api = yield* Api,
+      actors = yield* Actors,
+      database = yield* cloudLocks,
+      fs = yield* FileSystem.FileSystem,
+      path = yield* Path.Path;
+    const prefix = `/api/organizations/${actors.organization.id}`;
+    const source = yield* fs
+      .readFileString(path.resolve("../src/catalog/provider-apps/jev.json"))
+      .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Schema.fromJsonString(Source))));
+    const provider = yield* body(
+      Resource,
+      yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+        name: "Retained Jev",
+        files: source.files,
+      }),
+    );
+    const connection = yield* body(
+      Resource,
+      yield* api.request(
+        actors.owner,
+        "POST",
+        `${prefix}/apps/${provider.id}/accounts/app/jev/connections`,
+        { destination: { kind: "personal" } },
+      ),
+    );
+    const saved = yield* api.request(
+      actors.owner,
+      "POST",
+      `${prefix}/connections/${connection.id}/submit`,
+      { method: "apiKey", fields: { token: "synthetic-retained-jev-token" } },
+    );
+    const account = yield* body(Resource, saved);
+    const selected = yield* database.run({
+      sql: `insert into hosted_app_account_links (app, requirement, subject, account, linked_by)
+        select app.id, 'jev', null, a.id, access.creator_id from executor_apps app
+        join hosted_app_access access on access.id=app.id
+        join executor_accounts a on a.id=$1 and a.owner=app.owner
+        where app.id=$2 and app.owner='organization:' || $3 returning account`,
+      params: [account.id, pool, actors.organization.id],
+    });
+    if (selected.length !== 1) return yield* Effect.die("Retained key link was not inserted");
+    const binding = () =>
+      database.run({
+        sql: `select a.id, a.credential_generation as generation, r.driver,
+          r.generation=a.credential_generation as generation_matches, r.removal is not null as removing,
+          r.mirror_ready, r.revision from executor_accounts a
+          left join executor_account_acquisitions r on r.account=a.id where a.id=$1`,
+        params: [account.id],
+      });
+    const selection = database.run({
+      sql: `select l.account, l.requirement, l.linked_by, p.kind,
+        p.personal_user_id = l.linked_by as owner_matches,
+        hosted_contribution_access(l.app, l.account, l.linked_by) as usable,
+        d.requirements::jsonb -> 'accounts' -> l.requirement as requirement_definition
+        from hosted_app_account_links l join executor_apps app on app.id=l.app
+        join executor_deployments d on d.id=app.active_deployment
+        join hosted_account_access p on p.account_id=l.account
+        where l.app=$1 and l.account=$2`,
+      params: [pool, account.id],
+    });
+    const operations = yield* productionOpsClient;
+    const inventory = () =>
+      operations.request(operations.read("pool-bindings")).pipe(
+        Effect.flatMap((response) => body(Response, response)),
+        Effect.flatMap((response) =>
+          Schema.decodeUnknownEffect(Inventory)(operations.decrypt(response.artifact)),
+        ),
+        Effect.flatMap((inventory) =>
+          Schema.decodeUnknownEffect(
+            Schema.Array(
+              Schema.Struct({
+                account: Schema.String,
+                driver: Schema.NullOr(Schema.String),
+                generation_matches: Schema.NullOr(Schema.Boolean),
+                identity_matches: Schema.NullOr(Schema.Boolean),
+                removing: Schema.Boolean,
+                mirror_ready: Schema.Boolean,
+                has_mirror_reference: Schema.Boolean,
+              }),
+            ),
+          )(inventory.rows),
+        ),
+      );
+    return { account: account.id, binding, selection, inventory, provider: provider.id };
+  });
