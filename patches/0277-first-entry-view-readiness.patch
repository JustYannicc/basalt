+        state.released = true;
+        Reflect.get(window, "__firstEntryObserver").disconnect();
+        return {
+          replacedWhileHeld: state.replacedWhileHeld,
+          pendingMountsWhileHeld: state.pendingMountsWhileHeld,
+          sawPending: state.first !== null,
+        };
+      }),
+    );
+    yield* held.release;
+    yield* browser.use(`${target.page}: content after release`, (page) =>
+      page.locator("main").getByText(target.marker).first().waitFor(),
+    );
+    return recorded;
+  }).pipe(Effect.scoped);
