+import { Effect, Fiber } from "effect";
+import { Browser } from "./browser.ts";
+import { holdQuery } from "./query-transition.ts";
+
+/**
+ * Pages whose first hydrated entry mounted a nested browser-only lazy view. `pending` is the
+ * router's pending markup for that path (PagePending), and `marker` is the existing content marker
+ * from the inventory navigation scenario.
+ */
+export const firstEntryPages = [
+  {
+    page: "Accounts",
+    path: (organization: string) => `${organization}/accounts`,
+    // Both the host layer and the shared layer are named accounts-client.
+    clientChunks: /\/assets\/accounts-client-[^/]+\.js$/,
+    routeChunk: /\/assets\/org\._organizationSlug\.accounts\.index-[^/]+\.js$/,
+    pending: '[role="status"][aria-label="Loading accounts"]',
+    marker: "No accounts available",
+  },
+  {
+    page: "Human in the loop",
+    path: (organization: string) => `${organization}/approvals`,
+    clientChunks: /\/assets\/approvals-list-client-[^/]+\.js$/,
+    routeChunk: /\/assets\/org\._organizationSlug\.approvals\.index-[^/]+\.js$/,
+    pending: '.loading-rows[role="status"]',
+    marker: "Nothing needs you right now",
+  },
+] as const;
+type FirstEntryPage = (typeof firstEntryPages)[number];
+
+interface Recorded {
+  /** The router's pending element left the document while the view's chunks were still held. */
+  readonly replacedWhileHeld: boolean;
+  /** Distinct pending-shaped elements mounted while held; a nested fallback mounts a second one. */
+  readonly pendingMountsWhileHeld: number;
+  readonly sawPending: boolean;
+}
+
+/**
+ * Holds the page's browser-only chunks, enters the page through the hydrated router, and records
+ * whether anything replaced the router's pending element before the hold was released.
+ *
+ * Why this is timing-free for the candidate: with the route loader awaiting the held chunks, the
+ * route cannot render at all until release, so the pending element stays however long we wait.
+ * The two frames after the route chunk only bound how long the baseline gets to show its nested
+ * fallback; too short can only produce a false pass, so a valid RED on the baseline is required.
+ */
+export const observeFirstEntry = (organization: string, target: FirstEntryPage) =>
+  Effect.gen(function* () {
+    const browser = yield* Browser;
+    const held = yield* holdQuery(target.clientChunks, "continue", { allRequests: true });
+    const routeChunk = yield* Effect.forkScoped(
+      browser.use(`${target.page}: route chunk arrives`, (page) =>
+        page
+          .waitForResponse((response) => target.routeChunk.test(new URL(response.url()).pathname))
+          .then((response) => response.finished()),
+      ),
+    );
+    yield* browser.use(`${target.page}: record pending element`, (page) =>
+      page.evaluate((pending) => {
+        const seen = new WeakSet<Element>();
+        const state = {
+          first: null as Element | null,
+          released: false,
+          replacedWhileHeld: false,
+          pendingMountsWhileHeld: 0,
+        };
+        const scan = () => {
+          for (const element of document.querySelectorAll(`main ${pending}`)) {
+            if (seen.has(element)) continue;
+            seen.add(element);
+            state.first ??= element;
+            if (!state.released) state.pendingMountsWhileHeld++;
+          }
+          if (state.first && !state.first.isConnected && !state.released)
