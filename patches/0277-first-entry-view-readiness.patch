@@ -0,0 +1,132 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Evidence } from "../support/evidence.ts";
+import { openInApp } from "../support/in-app-navigation.ts";
+import { holdQuery } from "../support/query-transition.ts";
+import { scenarios } from "../test-plan.ts";
+
+const pages = [
+  {
+    name: "Accounts",
+    path: "accounts",
+    marker: "No accounts available",
+    code: /\/assets\/accounts-client-[^/]+\.js$/,
+  },
+  {
+    name: "Human in the loop",
+    path: "approvals",
+    marker: "Nothing needs you right now",
+    code: /\/assets\/approvals-list-client-[^/]+\.js$/,
+  },
+];
+layer(HostedLive, { excludeTestServices: true })("First-entry behavior", (it) => {
+  for (const width of [1440, 390]) {
+    const scenario =
+      width === 1440 ? scenarios.firstEntryBehaviorDesktop : scenarios.firstEntryBehaviorPhone;
+    it.effect(scenario.title, (context) =>
+      withHostedCase(
+        context,
+        Effect.gen(function* () {
+          const actors = yield* Actors;
+          const browser = yield* Browser;
+          const evidence = yield* Evidence;
+          const organization = `/org/${actors.organization.slug}`;
+          const results = [];
+          yield* browser.login(actors.owner);
+          yield* browser.use("Set behavior viewport", (page) =>
+            page.setViewportSize({ width, height: 960 }),
+          );
+          for (const target of pages) {
+            yield* browser.use(`Load ${target.name} as a document`, (page) =>
+              page.goto(`${organization}/${target.path}`),
+            );
+            yield* browser.use(`${target.name} document renders content`, (page) =>
+              page.locator("main").getByText(target.marker, { exact: true }).waitFor(),
+            );
+            const horizontalOverflow = yield* browser.use("Check document width", (page) =>
+              page.evaluate(() => document.documentElement.scrollWidth > innerWidth),
+            );
+            expect(horizontalOverflow).toBe(false);
+            results.push({ width, page: target.name, documentContent: true, horizontalOverflow });
+            if (width === 1440) {
+              yield* browser.use("Start fresh before hover", (page) =>
+                page.goto(`${organization}/connect`),
+              );
+              yield* browser.use("Wait for sidebar", (page) =>
+                page.getByRole("link", { name: target.name, exact: true }).waitFor(),
+              );
+              yield* Effect.scoped(
+                Effect.gen(function* () {
+                  const held = yield* holdQuery(target.code, "continue", { allRequests: true });
+                  yield* browser.use(`Hover ${target.name}`, (page) =>
+                    page.getByRole("link", { name: target.name, exact: true }).hover(),
+                  );
+                  const requested = yield* held.requested;
+                  const pathBeforeClick = yield* browser.use("Hover keeps current route", (page) =>
+                    Promise.resolve(new URL(page.url()).pathname),
+                  );
+                  expect(pathBeforeClick).toBe(`${organization}/connect`);
+                  yield* held.release;
+                  yield* browser.use(`Open preloaded ${target.name}`, (page) =>
+                    page.getByRole("link", { name: target.name, exact: true }).click(),
+                  );
+                  yield* browser.use("Preloaded content renders", (page) =>
+                    page.locator("main").getByText(target.marker, { exact: true }).waitFor(),
+                  );
+                  results.push({ width, page: target.name, hoverStartsViewCode: true, requested });
+                }),
+              );
+            }
+          }
+          yield* browser.use("Start fresh for failed download", (page) =>
+            page.goto(`${organization}/connect`),
+          );
+          yield* browser.use("Wait for the neutral page", (page) =>
+            page.getByRole("heading", { name: "Connect your agent", exact: true }).waitFor(),
+          );
+          yield* Effect.scoped(
+            Effect.gen(function* () {
+              const held = yield* holdQuery(pages[1]!.code, "fail", { allRequests: true });
+              yield* openInApp("Open the queue with its code held", `${organization}/approvals`);
+              yield* held.requested;
+              yield* held.release;
+              yield* browser.use("A failed view offers its existing retry", (page) =>
+                page
+                  .getByText("This page could not load. Try again to refresh its current state.", {
+                    exact: true,
+                  })
+                  .waitFor(),
+              );
+              const retryVisible = yield* browser.use("Retry action remains available", (page) =>
+                page.getByRole("button", { name: "Try again", exact: true }).isEnabled(),
+              );
+              expect(retryVisible).toBe(true);
+              results.push({
+                width,
+                page: "Human in the loop",
+                failureSettles: true,
+                retryVisible,
+              });
+            }),
+          );
+          // A fresh document clears Chromium's failed module map, the existing recovery boundary.
+          yield* browser.use("Reload the failed queue after the network recovers", (page) =>
+            page.reload(),
+          );
+          yield* browser.use("A fresh document recovers the queue", (page) =>
+            page
+              .locator("main")
+              .getByText("Nothing needs you right now", { exact: true })
+              .waitFor(),
+          );
+          results.push({ width, page: "Human in the loop", documentReloadRecovers: true });
+          yield* evidence.json("first-entry-behavior.json", results);
+          yield* browser.checkpoint(`First-entry behavior at ${width}px`);
+        }),
+      ),
+    );
+  }
+});
