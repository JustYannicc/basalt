diff --git a/e2e/tests/first-entry-reveal.spec.ts b/e2e/tests/first-entry-reveal.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/first-entry-reveal.spec.ts
@@ -0,0 +1,76 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Evidence } from "../support/evidence.ts";
+import { openInApp, openThroughBrowser } from "../support/in-app-navigation.ts";
+import { firstEntryPages, observeFirstEntry } from "../support/first-entry-reveal-probe.ts";
+import { scenarios } from "../test-plan.ts";
+
+/**
+ * A first entry must go from the router's pending page straight to the page itself. A nested
+ * Suspense fallback in between is what React throttles, so its absence is the guarded property;
+ * no wall-clock budget is asserted.
+ */
+layer(HostedLive, { excludeTestServices: true })("First entry reveal", (it) => {
+  for (const width of [1440, 390]) {
+    const scenario = width === 1440 ? scenarios.firstEntryDesktop : scenarios.firstEntryPhone;
+    it.effect(scenario.title, (context) =>
+      withHostedCase(
+        context,
+        Effect.gen(function* () {
+          const actors = yield* Actors;
+          const browser = yield* Browser;
+          const evidence = yield* Evidence;
+          const organization = `/org/${actors.organization.slug}`;
+          yield* browser.login(actors.owner);
+          yield* browser.use("Set viewport", (page) =>
+            page.setViewportSize({ width, height: 960 }),
+          );
+          // A hydrated document whose route has never loaded either page's view.
+          yield* openThroughBrowser("Enter the apps list", `${organization}/apps`);
+          const results = [];
+          for (const target of firstEntryPages) {
+            const recorded = yield* observeFirstEntry(organization, target);
+            results.push({ width, page: target.page, recorded });
+            yield* evidence.json("first-entry-reveal.json", results);
+            // In-app only: a document load would discard the loaded views the revisits rely on.
+            yield* openInApp("Back to the apps list", `${organization}/apps`);
+          }
+          // Revisits keep their retained views: no chunk request, content without a fallback.
+          for (const target of firstEntryPages) {
+            const requested: string[] = [];
+            const watch = (request: import("playwright").Request) => {
+              const path = new URL(request.url()).pathname;
+              if (target.clientChunks.test(path)) requested.push(path);
+            };
+            yield* Effect.acquireRelease(
+              browser.use(`${target.page}: watch revisit requests`, (page) =>
+                Promise.resolve(void page.on("request", watch)),
+              ),
+              () =>
+                browser
+                  .use(`${target.page}: stop watching`, (page) =>
+                    Promise.resolve(void page.off("request", watch)),
+                  )
+                  .pipe(Effect.orDie),
+            );
+            yield* openInApp(`Revisit ${target.page}`, target.path(organization));
+            yield* browser.use(`${target.page}: revisit content`, (page) =>
+              page.locator("main").getByText(target.marker).first().waitFor(),
+            );
+            expect(requested, `${target.page} revisit loads no view code`).toEqual([]);
+            yield* openInApp("Back to the apps list", `${organization}/apps`);
+          }
+          for (const { page, recorded } of results) {
+            expect(recorded.sawPending, `${page} shows the router's pending page`).toBe(true);
+            expect(recorded.replacedWhileHeld, `${page} keeps one pending page`).toBe(false);
+            expect(recorded.pendingMountsWhileHeld, `${page} mounts no nested fallback`).toBe(1);
+          }
+          yield* browser.checkpoint(`First entry final viewport ${width}`);
+        }),
+      ),
+    );
+  }
+});
