@@ -0,0 +1,127 @@
+import { type App } from "@executor-js/sdk/core";
+import { UiForbidden, UiUnauthorized } from "apps/ui/contracts";
+import { Effect, Schema } from "effect";
+import { HttpServerResponse } from "effect/http";
+import { CurrentAuthorization } from "../contracts/authorization.ts";
+import { CurrentUserId } from "../contracts/auth.ts";
+import { GroupDatabase } from "../contracts/groups.ts";
+import {
+  CurrentOrganization,
+  OrganizationForbidden,
+  type OrganizationAccess,
+} from "../contracts/organization.ts";
+import { fullAuthority } from "@executor-js/authorization";
+import { makeChangeJournal } from "./change-revisions.ts";
+import { organizationChangeSources } from "./organization-changes.ts";
+import { sendPoolCommand } from "./pool-backend.ts";
+import {
+  ChangeSnapshot,
+  changeHeaders,
+  changeIdentity,
+  scopedChangeResponse,
+} from "./scoped-changes.ts";
+
+const path = "/_executor/api/changes";
+const denied = (error: unknown) =>
+  Schema.is(UiUnauthorized)(error) ||
+  Schema.is(UiForbidden)(error) ||
+  Schema.is(OrganizationForbidden)(error);
+const failed = (error: unknown) =>
+  HttpServerResponse.empty({
+    status: Schema.is(UiUnauthorized)(error) ? 401 : denied(error) ? 403 : 503,
+    headers: changeHeaders,
+  });
+
+/** The app origin, session and current native policy select every scope; query strings cannot. */
+export const makeAppChanges = <E, R>(
+  authorize: Effect.Effect<
+    {
+      readonly app: Pick<App, "id">;
+      readonly access: OrganizationAccess & { readonly userId: string };
+      readonly changeSession?: { readonly expiresAt?: Date; readonly sessionId?: string };
+    },
+    E,
+    R
+  >,
+) => {
+  const context = Effect.gen(function* () {
+    const identity = yield* authorize;
+    const { app, access } = identity;
+    const fingerprint = yield* changeIdentity([
+      access.organization,
+      access.userId,
+      identity.changeSession?.sessionId ?? "",
+      app.id,
+    ]);
+    const sql = yield* Effect.flatten(GroupDatabase);
+    const hosted = organizationChangeSources(access.organization, access.userId);
+    const sources = [
+      ...hosted,
+      {
+        scope: `pool:${app.id}`,
+        keys: ["pool-readings", "pool-usage", "pool-samples", "pool-prices"].map((topic) => ({
+          topic,
+          resource: app.id,
+        })),
+      },
+    ];
+    const current = Effect.gen(function* () {
+      const native = yield* sendPoolCommand(
+        "changeRevisions",
+        { pool: app.id },
+        ChangeSnapshot,
+      ).pipe(
+        Effect.provideService(CurrentOrganization, access),
+        Effect.provideService(CurrentUserId, access.userId),
+        Effect.provideService(CurrentAuthorization, fullAuthority),
+      );
+      const revisions = [
+        ...native.revisions,
+        ...(yield* Effect.forEach(hosted, (source) =>
+          makeChangeJournal(sql).current(source.scope, source.keys),
+        )).flat(),
+      ];
+      const latest = yield* authorize;
+      if (
+        latest.access.userId !== access.userId ||
+        latest.changeSession?.sessionId !== identity.changeSession?.sessionId
+      )
+        return yield* new UiUnauthorized();
+      const deadlines = [native.validUntil, latest.changeSession?.expiresAt?.getTime()].filter(
+        (at) => at !== undefined,
+      );
+      return {
+        revisions,
+        identity: fingerprint,
+        ...(deadlines.length ? { validUntil: Math.min(...deadlines) } : {}),
+      };
+    });
+    return {
+      sources,
+      current,
+      fingerprint,
+      validUntil: identity.changeSession?.expiresAt?.getTime(),
+    };
+  });
+  return {
+    path: path as typeof path,
+    current: context.pipe(
+      Effect.flatMap(({ current }) => current),
+      Effect.map((body) => HttpServerResponse.jsonUnsafe(body, { headers: changeHeaders })),
+      Effect.catch((error) => Effect.succeed(failed(error))),
+    ),
+    events: context.pipe(
+      Effect.flatMap(({ sources, current, validUntil, fingerprint }) =>
+        scopedChangeResponse({
+          sources,
+          current,
+          authorize,
+          validUntil,
+          identity: fingerprint,
+          denied,
+        }),
+      ),
+      Effect.catch((error) => Effect.succeed(failed(error))),
+    ),
+  };
+};
