diff --git a/apps/hosted/server/src/implementation/pool-change-publish.ts b/apps/hosted/server/src/implementation/pool-change-publish.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ad72a78b0671f533d4f28558d3d8bba13cf8c8ed
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-change-publish.ts
@@ -0,0 +1,63 @@
+import { Clock, Config, Effect, Option, Redacted, Schema } from "effect";
+import { HttpServerRequest, HttpServerResponse } from "effect/http";
+import { RevisionHint } from "apps/ui/contracts";
+import { GroupDatabase } from "../contracts/groups.ts";
+import { openEnvelope } from "./pool-token.ts";
+import { makeChangeJournal } from "./change-revisions.ts";
+import { ScopedChanges } from "./scoped-changes.ts";
+
+export const poolChangePath = "/api/internal/change-revisions";
+const Request = Schema.Struct({
+  action: Schema.Literal("publish-changes"),
+  at: Schema.Finite,
+  expiresAt: Schema.Finite,
+  changes: Schema.Array(Schema.Struct({ scope: Schema.NonEmptyString, hint: RevisionHint })).check(
+    Schema.isMaxLength(100),
+  ),
+});
+/** Receiving the producer's committed counter is idempotent; delivery still uses the SQL outbox. */
+export const publishCommittedChanges = Effect.gen(function* () {
+  const key = yield* Config.Redacted("POOL_APP_SIGNING_KEY").pipe(Config.option);
+  if (Option.isNone(key)) return HttpServerResponse.empty({ status: 503 });
+  const body = yield* HttpServerRequest.schemaBodyJson(
+    Schema.Struct({ envelope: Schema.NonEmptyString }),
+  );
+  const raw = yield* Effect.tryPromise(() =>
+    openEnvelope(Redacted.value(key.value), "sbcr1", body.envelope),
+  );
+  const value = yield* Schema.decodeUnknownEffect(Request)(raw);
+  const now = yield* Clock.currentTimeMillis;
+  if (value.at > now || value.expiresAt <= now || value.expiresAt > value.at + 30_000)
+    return HttpServerResponse.empty({ status: 401 });
+  if (
+    value.changes.some(
+      ({ scope, hint }) =>
+        !["pool-readings", "pool-usage", "pool-samples", "pool-prices"].includes(hint.topic) ||
+        scope !== `pool:${hint.resource}` ||
+        !hint.resource.startsWith("app_") ||
+        hint.revision === "0",
+    )
+  )
+    return HttpServerResponse.empty({ status: 400 });
+  const sql = yield* Effect.flatten(GroupDatabase);
+  yield* sql.withTransaction(
+    Effect.forEach(
+      value.changes,
+      ({ scope, hint }) =>
+        Effect.gen(function* () {
+          const changed = yield* sql`insert into hosted_change_heads (scope,topic,resource,revision)
+      values (${scope},${hint.topic},${hint.resource},${hint.revision}::bigint)
+      on conflict (scope,topic,resource) do update set revision = excluded.revision
+      where hosted_change_heads.revision < excluded.revision returning revision`;
+          if (changed.length)
+            yield* sql`insert into hosted_change_pending (scope,topic,resource,revision)
+        values (${scope},${hint.topic},${hint.resource},${hint.revision}::bigint)
+        on conflict (scope,topic,resource) do update set revision = greatest(hosted_change_pending.revision, excluded.revision), updated_at = now()`;
+        }),
+      { discard: true },
+    ),
+  );
+  const transport = yield* ScopedChanges;
+  yield* makeChangeJournal(sql).deliver(transport.publish);
+  return HttpServerResponse.empty({ status: 204 });
+}).pipe(Effect.catch(() => Effect.succeed(HttpServerResponse.empty({ status: 503 }))));
diff --git a/apps/hosted/server/src/implementation/scoped-changes.ts b/apps/hosted/server/src/implementation/scoped-changes.ts
new file mode 100644
index 0000000000000000000000000000000000000000..45868bb04fd0cda47c1cca77188828c452b641de
--- /dev/null
+++ b/apps/hosted/server/src/implementation/scoped-changes.ts
@@ -0,0 +1,143 @@
+import { Context, Effect, Schema, Stream } from "effect";
+import { HttpServerResponse } from "effect/http";
+import { RuntimeProtocolFailed } from "@executor-js/sdk/core";
+import { type ChangeKey, type RevisionEvent, RevisionHint } from "apps/ui/contracts";
+import { authorizedChangeEvents } from "./authorized-change-stream.ts";
+
+export class ScopedChanges extends Context.Service<
+  ScopedChanges,
+  {
+    readonly subscribe: (
+      scope: string,
+      keys: readonly ChangeKey[],
+    ) => Stream.Stream<RevisionEvent, RuntimeProtocolFailed>;
+    readonly publish: (
+      scope: string,
+      hint: RevisionHint,
+    ) => Effect.Effect<void, RuntimeProtocolFailed>;
+  }
+>()("hosted/ScopedChanges") {}
+
+export const ChangeSnapshot = Schema.Struct({
+  revisions: Schema.Array(RevisionHint),
+  validUntil: Schema.optionalKey(Schema.Finite),
+  identity: Schema.optionalKey(Schema.String),
+});
+export const changeHeaders = { "cache-control": "private, no-store", "x-accel-buffering": "no" };
+export interface ChangeSource {
+  scope: string;
+  keys: readonly ChangeKey[];
+}
+export const changeIdentity = (parts: readonly string[]) =>
+  Effect.promise(async () =>
+    Array.from(
+      new Uint8Array(
+        await crypto.subtle.digest("SHA-256", new TextEncoder().encode(JSON.stringify(parts))),
+      ),
+      (byte) => byte.toString(16).padStart(2, "0"),
+    ).join(""),
+  );
+
+/** Each owner acknowledges registration before any authoritative head is read. */
+const registeredEvents = (
+  transport: typeof ScopedChanges.Service,
+  sources: readonly ChangeSource[],
+) =>
+  Stream.unwrap(
+    Effect.sync(() => {
+      const registered = new Set<number>();
+      let ready = false;
+      return Stream.mergeAll(
+        sources.map((source, index) =>
+          transport
+            .subscribe(source.scope, source.keys)
+            .pipe(Stream.map((event) => ({ index, event }))),
+        ),
+        { concurrency: "unbounded" },
+      ).pipe(
+        Stream.map(({ index, event }): RevisionEvent | undefined => {
+          if (!ready) {
+            if (event.kind === "current") registered.add(index);
+            if (registered.size !== sources.length) return undefined;
+            ready = true;
+            return { kind: "current", revisions: [], snapshotRequired: true };
+          }
+          return event.kind === "changed" ? event : undefined;
+        }),
+        Stream.filter((event) => event !== undefined),
+      );
+    }),
+  );
+
+/** Heartbeats do no application reads. An absolute expiry closes even a completely idle stream. */
+export const scopedChangeResponse = <E, R, E2, R2>(input: {
+  readonly sources: readonly ChangeSource[];
+  readonly current: Effect.Effect<typeof ChangeSnapshot.Type, E, R>;
+  readonly authorize: Effect.Effect<unknown, E2, R2>;
+  readonly validUntil?: number | undefined;
+  readonly identity?: string | undefined;
+  readonly denied: (error: unknown) => boolean;
+}) =>
+  Effect.gen(function* () {
+    const transport = yield* ScopedChanges;
+    const events = authorizedChangeEvents({
+      keys: input.sources.flatMap((source) => source.keys),
+      events: registeredEvents(transport, input.sources),
+      current: input.current.pipe(Effect.map((snapshot) => snapshot.revisions)),
+      authorize: input.authorize.pipe(Effect.asVoid),
+    });
+    const services = yield* Effect.context<Stream.Services<typeof events>>();
+    const changes = events.pipe(
+      Stream.map(
+        (event) =>
+          `event: ${event.kind}\ndata: ${JSON.stringify(
+            event.kind === "current"
+              ? {
+                  ...event,
+                  ...(input.validUntil === undefined ? {} : { validUntil: input.validUntil }),
+                  ...(input.identity === undefined ? {} : { identity: input.identity }),
+                }
+              : event,
+          )}\n\n`,
+      ),
+      Stream.catch((error) =>
+        Stream.make(
+          input.denied(error) ? "event: revoked\ndata: {}\n\n" : "event: resync\ndata: {}\n\n",
+        ),
+      ),
+      Stream.provideContext(services),
+    );
+    const heartbeat = Stream.tick("15 seconds").pipe(
+      Stream.drop(1),
+      Stream.map(() => ": heartbeat\n\n"),
+    );
+    let stream = Stream.merge(changes, heartbeat, { haltStrategy: "left" });
+    if (input.validUntil !== undefined) {
+      const expiry = Stream.fromEffect(
+        Effect.sleep(Math.max(0, input.validUntil - Date.now())).pipe(
+          // Renewal can extend a session while this stream still holds its original deadline.
+          Effect.andThen(input.authorize),
+          Effect.as("event: resync\ndata: {}\n\n"),
+          Effect.catch((error) =>
+            Effect.succeed(
+              input.denied(error) ? "event: revoked\ndata: {}\n\n" : "event: resync\ndata: {}\n\n",
+            ),
+          ),
+        ),
+      ).pipe(Stream.concat(Stream.never), Stream.provideContext(services));
+      // Finish after the terminal frame is consumed; ending the expiry branch can cancel its frame.
+      stream = Stream.merge(stream, expiry, { haltStrategy: "left" }).pipe(
+        Stream.takeUntil(
+          (frame) =>
+            frame === "event: revoked\ndata: {}\n\n" || frame === "event: resync\ndata: {}\n\n",
+        ),
+      );
+    }
+    return HttpServerResponse.stream(
+      stream.pipe(Stream.provideContext(services), Stream.encodeText),
+      {
+        contentType: "text/event-stream",
+        headers: changeHeaders,
+      },
+    );
+  });
