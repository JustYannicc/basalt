diff --git a/apps/hosted/self-host/src/implementation/committed-change-delivery.ts b/apps/hosted/self-host/src/implementation/committed-change-delivery.ts
new file mode 100644
index 0000000..6323cb8
--- /dev/null
+++ b/apps/hosted/self-host/src/implementation/committed-change-delivery.ts
@@ -0,0 +1,31 @@
+/** Wake on committed journal changes; ordinary reads never probe an empty outbox. */
+import { PgliteClient } from "@effect/sql-pglite";
+import { Effect, Queue, Result } from "effect";
+import { makeChangeJournal } from "@executor-js/hosted-server";
+import type { RevisionHint } from "apps/ui/contracts";
+
+export const committedChangeDelivery = <E, R>(
+  send: (scope: string, hint: RevisionHint) => Effect.Effect<void, E, R>,
+) =>
+  Effect.gen(function* () {
+    const sql = yield* PgliteClient.PgliteClient;
+    // LISTEN precedes recovery so a commit during the first delivery cannot be missed.
+    const changes = yield* sql.listen("hosted_committed_changes");
+    const deliver = Effect.gen(function* () {
+      let failures = 0;
+      while (true) {
+        const result = yield* makeChangeJournal(sql).deliver(send).pipe(Effect.result);
+        if (Result.isSuccess(result)) return;
+        yield* Effect.logWarning("Committed change delivery failed; retrying retained changes");
+        yield* Effect.sleep(Math.min(30_000, 1_000 * 2 ** Math.min(failures++, 5)));
+      }
+    });
+    yield* Effect.gen(function* () {
+      // Recover retained rows once, then retry only a failed delivery or an actual commit.
+      yield* deliver;
+      while (true) {
+        yield* Queue.takeAll(changes);
+        yield* deliver;
+      }
+    }).pipe(Effect.forkScoped);
+  });
diff --git a/apps/hosted/web/src/contracts/accepted-read.ts b/apps/hosted/web/src/contracts/accepted-read.ts
new file mode 100644
index 0000000..6755620
--- /dev/null
+++ b/apps/hosted/web/src/contracts/accepted-read.ts
@@ -0,0 +1,38 @@
+/** The body and its authority travel together; an unfenced source is never dehydrated. */
+import { ChangeReceipt } from "@executor-js/ui/contracts/refresh";
+import { AsyncResult, Atom } from "effect/reactivity";
+import { Schema } from "effect";
+
+export interface AcceptedRead<A, E> {
+  readonly result: AsyncResult.AsyncResult<A, E>;
+  readonly receipt: ChangeReceipt;
+  readonly hydrated?: true;
+}
+
+const Snapshot = Schema.Struct({ body: Schema.Unknown, receipt: ChangeReceipt });
+const decodeSnapshot = Schema.decodeUnknownSync(Snapshot);
+
+export const acceptedRead = <A, E>(self: Atom.Atom<AsyncResult.AsyncResult<A, E>>) => {
+  const cache = Atom.make<AcceptedRead<A, E> | undefined>(undefined).pipe(
+    Atom.setIdleTTL("30 minutes"),
+  );
+  // Reuse the endpoint's codec, but give the body no independently hydratable atom.
+  const source = Atom.readable(self.read, self.refresh).pipe(Atom.setIdleTTL(0));
+  if (!Atom.isSerializable(self)) return { cache, source, document: false };
+  const codec = self[Atom.SerializableTypeId];
+  const retained = Object.assign(cache, {
+    [Atom.SerializableTypeId]: {
+      key: `hosted:accepted:${codec.key}`,
+      encode: (value: AcceptedRead<A, E> | undefined): unknown => {
+        if (value === undefined || value.receipt.identity === undefined)
+          throw new Error("No accepted document read");
+        return { body: codec.encode(value.result), receipt: value.receipt };
+      },
+      decode: (value: unknown): AcceptedRead<A, E> => {
+        const snapshot = decodeSnapshot(value);
+        return { result: codec.decode(snapshot.body), receipt: snapshot.receipt, hydrated: true };
+      },
+    },
+  });
+  return { cache: retained, source, document: true };
+};
