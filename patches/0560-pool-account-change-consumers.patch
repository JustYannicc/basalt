index 0000000..2dd7454
--- /dev/null
+++ b/apps/hosted/server/src/implementation/deferred-change-schema.ts
@@ -0,0 +1,74 @@
+import { Effect } from "effect";
+import { SqlClient } from "effect/sql";
+
+/** Domain writes take their locks first; one commit-time batch takes journal locks in key order. */
+export const migrateDeferredChanges = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  yield* sql`create table if not exists hosted_change_batches (transaction_id bigint primary key)`;
+  yield* sql`create table if not exists hosted_change_dirty (
+    transaction_id bigint not null, scope text not null, topic text not null, resource text not null,
+    revision bigint check (revision > 0), primary key (transaction_id, scope, topic, resource))`;
+  yield* sql`create or replace function hosted_queue_change(
+    target_scope text, target_topic text, target_resource text, target_revision bigint default null)
+    returns void language plpgsql as $$
+    declare own_transaction bigint := txid_current();
+    begin
+      insert into hosted_change_dirty (transaction_id,scope,topic,resource,revision)
+        values (own_transaction,target_scope,target_topic,target_resource,target_revision)
+        on conflict (transaction_id,scope,topic,resource) do update
+        set revision = case when hosted_change_dirty.revision is null or excluded.revision is null
+          then null else greatest(hosted_change_dirty.revision,excluded.revision) end;
+      insert into hosted_change_batches values (own_transaction) on conflict do nothing;
+    end $$`;
+  yield* sql`create or replace function hosted_flush_changes() returns trigger language plpgsql as $$
+    declare item record; accepted bigint; changed boolean := false;
+    begin
+      for item in select scope,topic,resource,revision from hosted_change_dirty
+        where transaction_id=NEW.transaction_id
+        order by scope collate "C",topic collate "C",resource collate "C" loop
+        if item.revision is null then
+          perform hosted_record_change(item.scope,item.topic,item.resource);
+          changed := true;
+        else
+          accepted := null;
+          insert into hosted_change_heads (scope,topic,resource,revision)
+            values (item.scope,item.topic,item.resource,item.revision)
+            on conflict (scope,topic,resource) do update set revision=excluded.revision
+            where hosted_change_heads.revision < excluded.revision returning revision into accepted;
+          if accepted is not null then
+            changed := true;
+            insert into hosted_change_pending (scope,topic,resource,revision)
+              values (item.scope,item.topic,item.resource,accepted)
+              on conflict (scope,topic,resource) do update
+              set revision=greatest(hosted_change_pending.revision,excluded.revision),updated_at=now();
+          end if;
+        end if;
+      end loop;
+      if changed then perform pg_notify('hosted_committed_changes', ''); end if;
+      delete from hosted_change_dirty where transaction_id=NEW.transaction_id;
+      delete from hosted_change_batches where transaction_id=NEW.transaction_id;
+      return null;
+    end $$`;
+  // One marker per transaction schedules one deferred event, regardless of dirty-key count.
+  yield* sql`drop trigger if exists hosted_flush_changes on hosted_change_batches`;
+  yield* sql`create constraint trigger hosted_flush_changes after insert on hosted_change_batches
+    deferrable initially deferred for each row execute function hosted_flush_changes()`;
+  yield* sql`create or replace function hosted_deployment_changed() returns trigger language plpgsql as $$
+    begin
+      if TG_OP = 'DELETE' then
+        perform hosted_queue_change(OLD.owner, 'deployment', OLD.id);
+        return OLD;
+      end if;
+      if TG_OP = 'INSERT' then
+        if NEW.active_deployment is not null then
+          perform hosted_queue_change(NEW.owner, 'deployment', NEW.id);
+        end if;
+      elsif NEW.active_deployment is distinct from OLD.active_deployment or NEW.owner is distinct from OLD.owner then
+        if NEW.owner is distinct from OLD.owner then
+          perform hosted_queue_change(OLD.owner, 'deployment', OLD.id);
+        end if;
+        perform hosted_queue_change(NEW.owner, 'deployment', NEW.id);
+      end if;
+      return NEW;
+    end $$`;
+});
