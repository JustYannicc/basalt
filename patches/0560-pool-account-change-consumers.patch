@@ -0,0 +1,26 @@
+/**
+ * A fresh report stops being fresh at its own deadline even when nothing is written, so it turns
+ * stale then, locally and without a read. Only currently fresh reports are considered; stale,
+ * outdated and unavailable ones are never promoted, and timestamps are left as they were. A
+ * deadline that is not a finite instant (an unreadable source timestamp) cannot vouch for
+ * freshness, so that report turns stale now and is never scheduled.
+ */
+export const expireReports = <
+  Result,
+  Report extends { readonly freshness: string; readonly result: Result | null },
+  View extends { readonly reports: readonly Report[] },
+>(
+  view: View,
+  now: number,
+  deadlineOf: (result: Result) => number,
+): { readonly view: View; readonly next: number | undefined } => {
+  let next: number | undefined;
+  const reports = view.reports.map((report) => {
+    if (report.freshness !== "fresh" || report.result === null) return report;
+    const deadline = deadlineOf(report.result);
+    if (!Number.isFinite(deadline) || now >= deadline) return { ...report, freshness: "stale" };
+    next = next === undefined ? deadline : Math.min(next, deadline);
+    return report;
+  });
+  return { view: { ...view, reports }, next };
+};
