diff --git a/apps/hosted/server/src/implementation/organization-changes.ts b/apps/hosted/server/src/implementation/organization-changes.ts
new file mode 100644
index 0000000..07218aa
--- /dev/null
+++ b/apps/hosted/server/src/implementation/organization-changes.ts
@@ -0,0 +1,130 @@
+import { Effect, Schema } from "effect";
+import { HttpRouter, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { Authentication, Unauthorized } from "../contracts/auth.ts";
+import { GroupDatabase } from "../contracts/groups.ts";
+import {
+  OrganizationForbidden,
+  OrganizationId,
+  OrganizationReference,
+  organizationOwner,
+} from "../contracts/organization.ts";
+import { OrganizationTombstones } from "../contracts/organization-removal.ts";
+import { makeChangeJournal } from "./change-revisions.ts";
+import {
+  changeHeaders,
+  changeIdentity,
+  scopedChangeResponse,
+  type ChangeSource,
+} from "./scoped-changes.ts";
+
+export const organizationChangesPath = "/api/organizations/:organization/changes";
+export const organizationChangesCurrentPath = `${organizationChangesPath}/current`;
+export const organizationChangeKeys = ["accounts", "observations", "apps", "membership"].map(
+  (topic) => ({
+    topic,
+    resource: "*",
+  }),
+);
+export const sessionChangeKeys = [{ topic: "session", resource: "*" }];
+const Params = Schema.Struct({ organization: OrganizationReference });
+const Expires = Schema.Array(Schema.Struct({ expiresAt: Schema.Date }));
+export const deniedChange = (error: unknown) =>
+  Schema.is(Unauthorized)(error) || Schema.is(OrganizationForbidden)(error);
+
+/** A browser feed uses the same live identity and membership as a fresh dashboard request. */
+export const organizationChangeAuthority = (headers: Headers, reference: OrganizationReference) =>
+  Effect.gen(function* () {
+    if (headers.has("authorization")) return yield* new Unauthorized();
+    const authentication = yield* Authentication;
+    const principal = yield* authentication.current(headers);
+    if (principal === null) return yield* new Unauthorized();
+    const organization = yield* authentication.organization(reference);
+    yield* authentication.membership(principal, organization);
+    if (yield* (yield* OrganizationTombstones)(organization))
+      return yield* new OrganizationForbidden();
+    const sql = yield* Effect.flatten(GroupDatabase);
+    const expires = yield* Schema.decodeUnknownEffect(Expires)(
+      yield* sql`select "expiresAt" from session where id = ${principal.sessionId}`,
+    );
+    if (!expires[0]) return yield* new Unauthorized();
+    return {
+      organization,
+      user: principal.userId,
+      session: principal.sessionId,
+      validUntil: expires[0].expiresAt.getTime(),
+    };
+  });
+
+export const organizationChangeSources = (
+  organization: OrganizationId,
+  user: string,
+): ChangeSource[] => [
+  { scope: organizationOwner(organization), keys: organizationChangeKeys },
+  { scope: `user:${user}`, keys: sessionChangeKeys },
+];
+
+const failed = (error: unknown) =>
+  HttpServerResponse.empty({
+    status: Schema.is(Unauthorized)(error)
+      ? 401
+      : Schema.is(OrganizationForbidden)(error)
+        ? 403
+        : 503,
+    headers: changeHeaders,
+  });
+
+export const makeOrganizationChanges = () => {
+  const context = Effect.gen(function* () {
+    const { organization } = yield* HttpRouter.schemaPathParams(Params);
+    const request = yield* HttpServerRequest.HttpServerRequest;
+    const headers = new Headers(request.headers);
+    const identity = yield* organizationChangeAuthority(headers, organization);
+    // Slugs can move; this stream keeps checking the canonical scope it subscribed to.
+    const authorize = organizationChangeAuthority(headers, identity.organization).pipe(
+      Effect.flatMap((latest) =>
+        latest.organization !== identity.organization ||
+        latest.user !== identity.user ||
+        latest.session !== identity.session
+          ? Effect.fail(new Unauthorized())
+          : Effect.succeed(latest),
+      ),
+    );
+    const fingerprint = yield* changeIdentity([
+      identity.organization,
+      identity.user,
+      identity.session,
+    ]);
+    const sql = yield* Effect.flatten(GroupDatabase);
+    const sources = organizationChangeSources(identity.organization, identity.user);
+    const current = Effect.gen(function* () {
+      const revisions = (yield* Effect.forEach(sources, (source) =>
+        makeChangeJournal(sql).current(source.scope, source.keys),
+      )).flat();
+      const latest = yield* authorize;
+      if (latest.user !== identity.user || latest.session !== identity.session)
+        return yield* new Unauthorized();
+      return { revisions, validUntil: latest.validUntil, identity: fingerprint };
+    });
+    return { identity, sources, current, authorize, fingerprint };
+  });
+  return {
+    current: context.pipe(
+      Effect.flatMap(({ current }) => current),
+      Effect.map((body) => HttpServerResponse.jsonUnsafe(body, { headers: changeHeaders })),
+      Effect.catch((error) => Effect.succeed(failed(error))),
+    ),
+    events: context.pipe(
+      Effect.flatMap(({ identity, sources, current, authorize, fingerprint }) =>
+        scopedChangeResponse({
+          sources,
+          current,
+          authorize,
+          validUntil: identity.validUntil,
+          identity: fingerprint,
+          denied: deniedChange,
+        }),
+      ),
+      Effect.catch((error) => Effect.succeed(failed(error))),
+    ),
+  };
+};
