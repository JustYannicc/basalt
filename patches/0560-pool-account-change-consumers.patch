index 0000000..6c69a77
--- /dev/null
+++ b/packages/apps/src/browser/change-feed.ts
@@ -0,0 +1,632 @@
+/**
+ * One committed-revision stream per page. A watch reads again only after a hint, a handshake or a
+ * server deadline shows its data is behind; nothing here reads on a timer. The stream and the
+ * current-heads route both derive scope and resources on the server.
+ */
+import { Option, Schema } from "effect";
+import { newerRevision, revisionKey, RevisionEvent, RevisionHint } from "@executor-js/app-data";
+import { makeRevisionFence } from "../implementation/revision-fence.ts";
+
+/** Whether the page is following committed changes or needs to reconnect or sign in again. */
+export type ChangeStatus = "connecting" | "live" | "paused" | "revoked";
+
+/** Whether someone can see the page. Hidden pages hold no stream and make no reads. */
+export interface ChangeActivity {
+  readonly isActive: () => boolean;
+  readonly onActiveChange: (listener: (active: boolean) => void) => () => void;
+}
+
+/** Select a view's topics and its refresh and access-ended callbacks. */
+export interface ChangeWatchOptions {
+  /** Topics this watch's data depends on; omitted means every topic the server sends. */
+  readonly topics?: readonly string[];
+  /** A server-fenced or previously accepted result, bound to this feed's authority. */
+  readonly accepted?: ChangeReceipt;
+  /** The retained receipt still covers this connection's authorized heads; no body read is owed. */
+  readonly confirmed?: () => void;
+  /** Read again through `read`. Called only while active, and never while this watch reads. */
+  readonly refresh: () => unknown;
+  /** Access ended. Drop protected data now; defaults to `refresh`, whose refusal clears it. */
+  readonly revoked?: () => void;
+}
+
+/** Fence reads for one mounted view and stop them when that view leaves. */
+export interface ChangeWatch {
+  /**
+   * Run `work` between two authoritative head reads and return its result only once it is
+   * accepted: both reads agree, cover every head this page knows (handshake, hints and
+   * acknowledged writes) and, with a stream, the fence accepts them. Otherwise `work` runs again,
+   * a bounded number of times, and then this throws `ChangeReadRetry`. An unaccepted result is
+   * never returned; callers keep their previous accepted data. An optional publisher runs only
+   * after acceptance, with an opaque version for matching independently read parts.
+   */
+  readonly read: <T>(
+    work: () => Promise<T>,
+    publish?: (value: T, version: string, receipt: ChangeReceipt) => void,
+  ) => Promise<T>;
+  /** Ask for a read through `refresh`, coalesced with any hint-driven one. */
+  readonly request: () => void;
+  readonly stop: () => void;
+}
+
+/**
+ * A read that could not be accepted. `moving`: heads kept changing, and their hints will read
+ * again. `unavailable`: the head route could not be read; the next hint, handshake or return
+ * to the page reads again. `hidden`: the page was hidden mid-read, so the read parked before
+ * any further data work; the foreground handshake reads again. Nothing retries on a timer.
+ */
+export class ChangeReadRetry extends Error {
+  readonly retryable = true;
+  readonly reason: "moving" | "unavailable" | "hidden";
+  constructor(reason: "moving" | "unavailable" | "hidden") {
+    super(`Change read not accepted: ${reason}`);
+    this.reason = reason;
+  }
+}
+
+/** Share one authorized revision stream among the page's mounted views. */
+export interface ChangeFeed {
+  readonly watch: (options: ChangeWatchOptions) => ChangeWatch;
+  readonly status: () => ChangeStatus;
+  readonly onStatus: (listener: () => void) => () => void;
+  /** Raise minimums with revisions a write actually returned. */
+  readonly acknowledge: (revisions: readonly RevisionHint[]) => void;
+  /** Reconnect now instead of waiting for the next retry. */
+  readonly reconnect: () => void;
+  readonly close: () => void;
+}
+
+/**
+ * `identity` is the server's opaque hash of organization, viewer and session (and app, for an
+ * app page). It is optional only so older fixtures decode; every current route sends it.
+ */
+export const ChangeReceipt = Schema.Struct({
+  revisions: Schema.Array(RevisionHint),
+  validUntil: Schema.optional(Schema.Number),
+  identity: Schema.optional(Schema.String),
+});
+export type ChangeReceipt = typeof ChangeReceipt.Type;
+type Current = ChangeReceipt;
+const decodeCurrent = Schema.decodeUnknownOption(ChangeReceipt);
+const decodeEvent = Schema.decodeUnknownOption(RevisionEvent);
+/** Handshake fields beyond `RevisionEvent`, decoded on their own so either contract version reads. */
+const Handshake = Schema.Struct({
+  identity: Schema.optional(Schema.String),
+  validUntil: Schema.optional(Schema.Number),
+});
+const decodeHandshake = Schema.decodeUnknownOption(Handshake);
+
+/** Reads whose heads keep moving stop here; the hints for those moves read again. */
+const attempts = 3;
+/** Only a disconnect lasting this long is shown; a quick reconnect stays silent. */
+const pausedAfter = 30_000;
+/** The server sends a heartbeat every 15 seconds; three missed ones mean the socket is gone. */
+const silentAfter = 45_000;
+/** The handshake is the server's first message; a stream that hasn't sent it is treated as lost. */
+const handshakeAfter = 10_000;
+/** Watches re-created by a render reuse the open stream. */
+const closeAfter = 1_000;
+const maximumDelay = 60_000;
+const maximumTimer = 2_147_483_647;
+
+class AccessEnded extends Error {}
+class Stopped extends Error {}
+
+const documentActivity: ChangeActivity = {
+  isActive: () => document.visibilityState === "visible",
+  onActiveChange: (listener) => {
+    const changed = () => listener(document.visibilityState === "visible");
+    document.addEventListener("visibilitychange", changed);
+    return () => document.removeEventListener("visibilitychange", changed);
+  },
+};
+
+/** Server-sent events over fetch, so access refusals are visible as status codes. */
+async function readEvents(
+  body: ReadableStream<Uint8Array>,
+  onBytes: () => void,
+  onEvent: (name: string, data: string) => void,
+) {
+  const reader = body.getReader();
+  const decoder = new TextDecoder();
+  let buffer = "";
+  for (;;) {
+    const { value, done } = await reader.read();
+    if (done) return;
+    onBytes();
+    buffer = (buffer + decoder.decode(value, { stream: true })).replaceAll("\r\n", "\n");
+    let end = buffer.indexOf("\n\n");
+    while (end >= 0) {
+      let name = "message";
+      const data: string[] = [];
+      for (const line of buffer.slice(0, end).split("\n")) {
+        if (line.startsWith("event:")) name = line.slice(6).trim();
+        else if (line.startsWith("data:")) data.push(line.slice(5).trimStart());
+      }
+      buffer = buffer.slice(end + 2);
+      if (data.length > 0) onEvent(name, data.join("\n"));
+      end = buffer.indexOf("\n\n");
+    }
+  }
+}
+
+interface WatchState {
+  readonly topics: ReadonlySet<string> | undefined;
+  readonly options: ChangeWatchOptions;
+  readonly abort: AbortController;
+  /** Heads of this watch's last accepted read. Empty until one is accepted. */
+  heads: Map<string, string>;
+  validUntil: number | undefined;
+  deadline: ReturnType<typeof setTimeout> | undefined;
+  dirty: boolean;
+  reading: boolean;
+  /** The last read through this watch was not accepted. */
+  failed: boolean;
+  /** `request()` asked for a read; consumed when one starts, so one asked mid-read survives. */
+  requested: boolean;
+}
+
+/** Follow committed revisions, reconcile reconnects and accept reads under one server identity. */
+export function makeChangeFeed(input: {
+  readonly stream: string;
+  readonly current: string;
+  readonly activity?: ChangeActivity;
+}): ChangeFeed {
+  const activity = input.activity ?? documentActivity;
+  const watches = new Set<WatchState>();
+  const statusListeners = new Set<() => void>();
+  let status: ChangeStatus = "connecting";
+  let fence: ReturnType<typeof makeRevisionFence> | undefined;
+  let fenceKeys = "";
+  /**
+   * The principal this feed serves: the first identity a handshake or head read reported. A
+   * different one ends access at once; a missing one after that is rejected. A feed never moves
+   * to another principal, so nothing it accepted can reach one.
+   */
+  let identity: string | undefined;
+  /** The current handshake's deadline; it bounds every read accepted on that connection too. */
+  let streamUntil: number | undefined;
+  let connection: ReturnType<ReturnType<typeof makeRevisionFence>["begin"]> | undefined;
+  /** Heads the stream has told this page, from the handshake and every later hint. */
+  const known = new Map<string, string>();
+  const topicOf = new Map<string, string>();
+  let stream: AbortController | undefined;
+  let failures = 0;
+  /** A stream that never handshook lets watches read once so the page is not left empty. */
+  let fallback = false;
+  let revoked = false;
+  let closed = false;
+  let retry: ReturnType<typeof setTimeout> | undefined;
+  let paused: ReturnType<typeof setTimeout> | undefined;
+  let silent: ReturnType<typeof setTimeout> | undefined;
+  let idle: ReturnType<typeof setTimeout> | undefined;
+
+  const setStatus = (next: ChangeStatus) => {
+    if (status === next) return;
+    status = next;
+    for (const listener of statusListeners) listener();
+  };
+  const interested = (watch: WatchState, key: string) => {
+    const topic = topicOf.get(key);
+    return watch.topics === undefined || (topic !== undefined && watch.topics.has(topic));
+  };
+  const behind = (watch: WatchState) => {
+    if (watch.heads.size === 0) return true;
+    if (watch.validUntil !== undefined && Date.now() >= watch.validUntil) return true;
+    for (const [key, revision] of known) {
+      if (!interested(watch, key)) continue;
+      const held = watch.heads.get(key);
+      if (held === undefined || newerRevision(revision, held)) return true;
+    }
+    return false;
+  };
+  const kick = (watch: WatchState) => {
+    if (closed || revoked || watch.abort.signal.aborted) return;
+    if (!watch.dirty || watch.reading || !activity.isActive()) return;
+    // The first read waits for the handshake unless the stream could not provide one.
+    if (connection === undefined && !fallback) return;
+    watch.dirty = false;
+    watch.requested = false;
+    watch.reading = true;
+    void Promise.resolve()
+      .then(() => watch.options.refresh())
+      .catch(() => undefined)
+      .finally(() => {
+        watch.reading = false;
+        // `dirty` here means a hint, request or deadline arrived during the read.
+        const arrived = watch.dirty;
+        if (watch.failed) {
+          // Stay behind until something new arrives; a failure alone never reads again.
+          watch.dirty = arrived || behind(watch);
+          if (arrived) kick(watch);
+          return;
+        }
+        // A hint the finished read already covered needs no second read; an explicit request does.
+        watch.dirty = watch.requested || (arrived && behind(watch));
+        kick(watch);
+      });
+  };
+  const mark = (watch: WatchState) => {
+    watch.dirty = true;
+    kick(watch);
+  };
+
+  const clearTimers = () => {
+    clearTimeout(retry);
+    clearTimeout(paused);
+    clearTimeout(silent);
+    retry = paused = silent = undefined;
+  };
+  const disconnect = () => {
+    stream?.abort();
+    stream = undefined;
+    clearTimeout(silent);
+    silent = undefined;
+    if (connection !== undefined) fence?.disconnect();
+    connection = undefined;
+  };
+  const endAccess = () => {
+    if (revoked) return;
+    revoked = true;
+    disconnect();
+    clearTimers();
+    setStatus("revoked");
+    for (const watch of watches) (watch.options.revoked ?? watch.options.refresh)();
+  };
+
+  /** False when `reported` cannot be this feed's principal; a different one also ends access. */
+  const bind = (reported: string | undefined) => {
+    if (identity === undefined) {
+      identity = reported;
+      return true;
+    }
+    if (reported === identity) return true;
+    if (reported !== undefined) endAccess();
+    return false;
+  };
+  /** Accepted data may not outlive the earliest deadline the server gave for it. */
+  const expireBy = (watch: WatchState, at: number) => {
+    if (watch.validUntil !== undefined && watch.validUntil <= at) return;
+    watch.validUntil = at;
+    clearTimeout(watch.deadline);
+    watch.deadline = setTimeout(
+      () => mark(watch),
+      Math.min(maximumTimer, Math.max(0, at - Date.now())),
+    );
+  };
+
+  const handshake = (revisions: readonly RevisionHint[], extras: typeof Handshake.Type) => {
+    if (!bind(extras.identity)) {
+      if (!revoked) resync();
+      return;
+    }
+    const keys = `${identity ?? ""}\n${revisions.map(revisionKey).sort().join("\n")}`;
+    if (fence === undefined || keys !== fenceKeys) {
+      // The fence scope binds the URL and the principal it serves.
+      fence = makeRevisionFence(`${input.stream}\n${identity ?? ""}`, revisions);
+      fenceKeys = keys;
+    }
+    const next = fence.begin();
+    if (!fence.handshake(next, revisions)) return resync();
+    connection = next;
+    if (stream !== undefined) watchdog(stream);
+    known.clear();
+    for (const hint of revisions) {
+      const key = revisionKey(hint);
+      known.set(key, hint.revision);
+      topicOf.set(key, hint.topic);
+    }
+    failures = 0;
+    fallback = false;
+    clearTimeout(paused);
+    paused = undefined;
+    streamUntil = extras.validUntil;
+    if (streamUntil !== undefined) for (const watch of watches) expireBy(watch, streamUntil);
+    setStatus("live");
+    for (const watch of watches) {
+      if (behind(watch)) mark(watch);
+      else watch.options.confirmed?.();
+    }
+  };
+  /** Stream hints and acknowledged writes both raise what an accepted read must cover. */
+  const changed = (hint: RevisionHint) => {
+    const key = revisionKey(hint);
+    fence?.observe(hint);
+    topicOf.set(key, hint.topic);
+    const held = known.get(key);
+    if (held === undefined || newerRevision(hint.revision, held)) known.set(key, hint.revision);
+    for (const watch of watches) {
+      if (!interested(watch, key)) continue;
+      const seen = watch.heads.get(key);
+      if (seen === undefined || newerRevision(hint.revision, seen)) mark(watch);
+    }
+  };
+
+  const wanted = () => !closed && !revoked && watches.size > 0 && activity.isActive();
+  const schedule = (delay: number) => {
+    clearTimeout(retry);
+    retry = wanted() ? setTimeout(connect, delay) : undefined;
+  };
+  const lost = () => {
+    disconnect();
+    if (!wanted()) return;
+    fallback = true;
+    for (const watch of watches) kick(watch);
