diff --git a/apps/hosted/server/src/implementation/account-change-schema.ts b/apps/hosted/server/src/implementation/account-change-schema.ts
new file mode 100644
index 0000000..c0566ea
--- /dev/null
+++ b/apps/hosted/server/src/implementation/account-change-schema.ts
@@ -0,0 +1,149 @@
+import { Effect } from "effect";
+import { SqlClient } from "effect/sql";
+import { migrateDeferredChanges } from "./deferred-change-schema.ts";
+
+/** Triggers cover SQL writers, including background work and writes from another isolate. */
+export const migrateAccountChanges = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  yield* migrateDeferredChanges;
+  yield* sql`create or replace function hosted_account_changed() returns trigger language plpgsql as $$
+    declare previous jsonb; following jsonb; item jsonb; target_scope text; topic text;
+      reference text; ignored text[]; identity jsonb; notified text[] := '{}'; candidate text;
+    begin
+      if TG_OP <> 'INSERT' then previous := to_jsonb(OLD); end if;
+      if TG_OP <> 'DELETE' then following := to_jsonb(NEW); end if;
+      ignored := string_to_array(TG_ARGV[3], ',');
+      if TG_TABLE_NAME = 'executor_account_observations' then
+        -- A claim can span transactions while support is discovered. Only settled reports publish.
+        if previous -> 'data' -> 'result' is not distinct from 'null'::jsonb
+          and previous -> 'data' -> 'lastAttempt' is not distinct from 'null'::jsonb then previous := null; end if;
+        if following -> 'data' -> 'result' is not distinct from 'null'::jsonb
+          and following -> 'data' -> 'lastAttempt' is not distinct from 'null'::jsonb then following := null; end if;
+        if previous is null and following is null then
+          if TG_OP = 'DELETE' then return OLD; end if;
+          return NEW;
+        end if;
+      end if;
+      if TG_OP = 'UPDATE' and previous - ignored = following - ignored then return NEW; end if;
+      for item in select distinct value from jsonb_array_elements(jsonb_build_array(previous, following))
+        where value <> 'null'::jsonb loop
+        target_scope := null;
+        reference := item ->> TG_ARGV[2];
+        case TG_ARGV[0]
+          when 'owner' then target_scope := reference;
+          when 'organization' then target_scope := 'organization:' || reference;
+          when 'app' then select owner into target_scope from executor_apps where id = reference;
+          when 'account' then select owner into target_scope from executor_accounts where id = reference;
+          when 'group' then select 'organization:' || organization_id into target_scope from hosted_groups where id = reference;
+          when 'user' then
+            target_scope := 'user:' || reference;
+            if TG_TABLE_NAME = 'user' then
+              for candidate in select distinct 'organization:' || "organizationId" from member where "userId" = reference loop
+                perform hosted_queue_change(candidate, 'membership', '*');
+              end loop;
+            end if;
+          when 'grant' then
+            for candidate in select distinct owner from executor_accounts where oauth_grant_id = reference loop
+              perform hosted_queue_change(candidate, 'accounts', '*');
+              perform hosted_queue_change(candidate, 'observations', '*');
+            end loop;
+          when 'provider' then
+            for candidate in select distinct owner from executor_accounts where provider = reference loop
+              perform hosted_queue_change(candidate, 'accounts', '*');
+              perform hosted_queue_change(candidate, 'observations', '*');
+            end loop;
+          when 'verification' then
+            if item ->> 'identifier' like 'executor-app-ui:v1:session:%' then
+              begin identity := (item ->> 'value')::jsonb; exception when others then identity := null; end;
+              if identity ->> 'kind' = 'session' then target_scope := 'user:' || (identity ->> 'user'); end if;
+            end if;
+        end case;
+        if target_scope is not null and not target_scope = any(notified) then
+          notified := array_append(notified, target_scope);
+          foreach topic in array string_to_array(TG_ARGV[1], ',') loop
+            if topic = 'observations' and TG_TABLE_NAME = 'executor_accounts' and TG_OP = 'INSERT' then continue; end if;
+            if topic = 'observations' and TG_TABLE_NAME = 'hosted_app_account_links'
+              and not exists (select 1 from executor_account_observations where account = item ->> 'account' and source = item ->> 'app') then continue; end if;
+            if topic = 'membership' and TG_TABLE_NAME = 'hosted_account_access' and TG_OP = 'INSERT'
+              and not exists (select 1 from executor_account_observations where account = item ->> 'account_id') then continue; end if;
+            -- Provisioning metadata does not change the organization's identity or anyone's access.
+            if topic = 'membership' and TG_TABLE_NAME = 'organization' and TG_OP = 'UPDATE'
+              and jsonb_build_array(previous -> 'id', previous -> 'slug') = jsonb_build_array(following -> 'id', following -> 'slug') then continue; end if;
+            if topic = 'observations' and TG_TABLE_NAME in ('executor_apps', 'hosted_app_access', 'hosted_app_groups') then
+              reference := case when TG_TABLE_NAME = 'hosted_app_groups' then item ->> 'app_id' else item ->> 'id' end;
+              -- Source edits and deployment bookkeeping do not change a retained reading.
+              if TG_TABLE_NAME = 'executor_apps' and TG_OP = 'UPDATE' and
+                jsonb_build_array(previous -> 'owner', previous -> 'name', previous -> 'active_deployment') =
+                jsonb_build_array(following -> 'owner', following -> 'name', following -> 'active_deployment') then continue; end if;
+              if not exists (select 1 from executor_account_observations where source = reference)
+                and not exists (select 1 from hosted_app_account_links where app = reference) then continue; end if;
+            end if;
+            perform hosted_queue_change(target_scope, topic, '*');
+          end loop;
+        end if;
+      end loop;
+      if TG_OP = 'DELETE' then return OLD; end if;
+      return NEW;
+    end $$`;
+  const triggers = [
+    ["executor_accounts", "owner", "accounts,observations", "owner", "encrypted_credentials"],
+    ["executor_account_checks", "account", "accounts", "account", ""],
+    ["executor_account_reports", "owner", "accounts", "owner", "lease,lease_until"],
+    ["executor_account_driver_checks", "owner", "accounts", "owner", ""],
+    ["executor_account_targets", "owner", "accounts", "owner", ""],
+    [
+      "executor_account_observations",
+      "owner",
+      "observations",
+      "owner",
+      "lease,lease_until,next_allowed_at",
+    ],
+    ["executor_account_acquisitions", "owner", "accounts,observations", "owner", ""],
+    ["executor_account_connections", "owner", "accounts", "owner", ""],
+    ["executor_app_connections", "owner", "accounts,apps", "owner", "updated_at"],
+    ["executor_account_identities", "owner", "accounts", "owner", ""],
+    ["executor_oauth_grants", "grant", "accounts", "id", "encrypted,updated_at"],
+    ["executor_apps", "owner", "apps,accounts,observations", "owner", "repository"],
+    ["executor_providers", "provider", "accounts", "id", ""],
+    ["hosted_app_account_links", "app", "accounts,observations", "app", ""],
+    ["hosted_app_access", "organization", "accounts,apps,observations", "organization_id", ""],
+    ["hosted_account_access", "organization", "accounts,membership", "organization_id", ""],
+    [
+      "hosted_account_observation_access",
+      "organization",
+      "observations,membership",
+      "organization_id",
+      "",
+    ],
+    [
+      "hosted_account_rechecks",
+      "organization",
+      "accounts",
+      "organization_id",
+      "lease,lease_until,provider_next_at,next_at",
+    ],
+    ["hosted_app_groups", "organization", "accounts,apps,observations", "organization_id", ""],
+    ["hosted_account_groups", "organization", "accounts,membership", "organization_id", ""],
+    ["hosted_model_bindings", "app", "accounts,apps,membership", "app_id", ""],
+    ["hosted_groups", "organization", "accounts,apps,membership", "organization_id", ""],
+    ["hosted_group_members", "group", "accounts,apps,membership", "group_id", ""],
+    ["member", "organization", "accounts,apps,membership", "organizationId", "createdAt"],
+    ["organization", "organization", "accounts,apps,membership", "id", "logo"],
+    [
+      "hosted_provisioning",
+      "organization",
+      "apps,accounts",
+      "organization_id",
+      "updated_at,attempts,available_at",
+    ],
+    ["hosted_organization_removal", "organization", "membership", "organization_id", ""],
+    ["session", "user", "session", "userId", "updatedAt,ipAddress,userAgent"],
+    ["user", "user", "session", "id", "updatedAt"],
+    ["verification", "verification", "session", "identifier", "updatedAt"],
+  ] as const;
+  for (const [table, mode, topics, field, ignored] of triggers)
+    yield* sql.unsafe(
+      `create or replace trigger hosted_committed_change after insert or update or delete on "${table}"
+        for each row execute function hosted_account_changed('${mode}', '${topics}', '${field}', '${ignored}')`,
+    );
+});
