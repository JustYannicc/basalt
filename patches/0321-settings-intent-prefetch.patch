diff --git a/e2e/support/settings-touch-intent.ts b/e2e/support/settings-touch-intent.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/settings-touch-intent.ts
@@ -0,0 +1,96 @@
+/** A real touch context proves intent before the link's click can navigate. */
+import { expect } from "@effect/vitest";
+import { Effect } from "effect";
+import { Browser } from "./browser.ts";
+import { Evidence } from "./evidence.ts";
+
+export const checkSettingsTouchIntent = (slug: string) =>
+  Effect.gen(function* () {
+    const browser = yield* Browser;
+    const evidence = yield* Evidence;
+    const touch = yield* Effect.acquireRelease(
+      browser.use("Open an authenticated touch context", (page) => {
+        const native = page.context().browser();
+        if (native === null) throw new Error("The scenario has no browser process");
+        return native
+          .newContext({
+            baseURL: new URL(page.url()).origin,
+            hasTouch: true,
+            viewport: { width: 390, height: 844 },
+            ignoreHTTPSErrors: true,
+          })
+          .then((context) =>
+            page
+              .context()
+              .cookies()
+              .then((cookies) => context.addCookies(cookies))
+              .then(() => context.newPage())
+              .then((opened) => ({ context, page: opened }))
+              .catch((error) =>
+                context.close().then(() => {
+                  throw error;
+                }),
+              ),
+          );
+      }),
+      ({ context }) =>
+        browser.use("Close the touch context", () => context.close()).pipe(Effect.orDie),
+    );
+    const endpoints: string[] = [];
+    touch.page.on("request", (request) => {
+      const path = new URL(request.url()).pathname;
+      if (request.method() === "GET" && path === "/api/auth/organization/list-members")
+        endpoints.push("members");
+      if (request.method() === "GET" && path === "/api/auth/organization/list-invitations")
+        endpoints.push("invitations");
+    });
+    const page = touch.page;
+    yield* browser.use("Open Apps in the touch context", () => page.goto(`/org/${slug}/apps`));
+    yield* browser.use("The touch document has hydrated", () =>
+      page.waitForFunction(
+        () => document.documentElement.hasAttribute("data-hydrated") && !("$_TSR" in window),
+      ),
+    );
+    yield* browser.use("Open the touch navigation", () =>
+      page.getByRole("button", { name: "Menu", exact: true }).click(),
+    );
+    const link = page
+      .getByRole("navigation", { name: "Main navigation" })
+      .getByRole("link", { name: "Settings", exact: true });
+    yield* browser.use("Observe a native touch without following its click", () =>
+      link.evaluate((element) => {
+        element.addEventListener("click", (event) => event.preventDefault(), {
+          once: true,
+          capture: true,
+        });
+        element.addEventListener(
+          "touchstart",
+          (event) => element.setAttribute("data-native-touch", String(event.isTrusted)),
+          { once: true },
+        );
+      }),
+    );
+    expect(endpoints, "The touch context reads no members before intent").toEqual([]);
+    yield* browser.use("Tap the real link", () =>
+      Promise.all([
+        page.waitForRequest(
+          (request) => new URL(request.url()).pathname === "/api/auth/organization/list-members",
+        ),
+        link.tap(),
+      ]),
+    );
+    const trusted = yield* browser.use("The touch event came from the browser", () =>
+      link.getAttribute("data-native-touch"),
+    );
+    expect(trusted).toBe("true");
+    expect(new URL(page.url()).pathname, "The click did not open members").toBe(
+      `/org/${slug}/apps`,
+    );
+    expect(endpoints, "A native touch starts members before navigation").toContain("members");
+    yield* evidence.json("settings-native-touch.json", {
+      hasTouch: true,
+      trusted: true,
+      beforeNavigation: true,
+      endpoints,
+    });
+  });
