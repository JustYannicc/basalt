diff --git a/e2e/tests/settings-intent-prefetch.spec.ts b/e2e/tests/settings-intent-prefetch.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/settings-intent-prefetch.spec.ts
@@ -0,0 +1,350 @@
+import { expect, layer } from "@effect/vitest";
+import { Deferred, Effect, Option } from "effect";
+import type { Locator, Page, Request } from "playwright";
+import { Actors } from "../support/actors.ts";
+import type { Session } from "../support/api.ts";
+import { checkSettingsTouchIntent } from "../support/settings-touch-intent.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Evidence } from "../support/evidence.ts";
+import { openThroughBrowser } from "../support/in-app-navigation.ts";
+import { observeNavigation } from "../support/instant-navigation.ts";
+import { holdQuery, refreshVisiblePage } from "../support/query-transition.ts";
+import { batchedReads, batchPath } from "../support/read-batches.ts";
+import { scenarios } from "../test-plan.ts";
+
+type SettingsRead = "members" | "invitations" | "billing";
+const membersPath = "/api/auth/organization/list-members";
+const invitationsPath = "/api/auth/organization/list-invitations";
+/** Cloud's settings page reads billing and removal after it renders; intent must not. */
+const pageOnlyGroups = new Set(["billing", "organizationRemoval"]);
+
+const settingsReads = (request: Request): readonly SettingsRead[] => {
+  const path = new URL(request.url()).pathname;
+  if (request.method() === "POST" && path === batchPath)
+    return batchedReads(request.postData()).flatMap((read): SettingsRead[] =>
+      pageOnlyGroups.has(read.group) ? ["billing"] : [],
+    );
+  if (request.method() !== "GET") return [];
+  if (path === membersPath) return ["members"];
+  if (path === invitationsPath) return ["invitations"];
+  return /\/billing(?:\/|$)/.test(path) ? ["billing"] : [];
+};
+/** The already verified boundary data must not be requested again merely for link intent. */
+const identityReads = (request: Request): readonly string[] => {
+  const path = new URL(request.url()).pathname;
+  if (request.method() === "POST" && path === batchPath)
+    return batchedReads(request.postData()).flatMap((read) =>
+      read.group === "organization" && read.endpoint === "access" ? ["access"] : [],
+    );
+  if (request.method() !== "GET") return [];
+  if (/^\/api\/organizations\/[^/]+\/access$/.test(path)) return ["access"];
+  if (path === "/api/auth/organization/list") return ["organizations"];
+  if (path === "/api/auth/get-session") return ["session"];
+  return [];
+};
+const count = (reads: readonly SettingsRead[], kind: SettingsRead) =>
+  reads.filter((read) => read === kind).length;
+
+/**
+ * Intent on the Settings link reads the organization's members, and its invitations for an owner
+ * or admin, before the click, and holds them only until they answer. The proof is the reads, the
+ * retained rows on the destination's first frame, and the absence of any later focus, visibility
+ * or timer read, and of any billing read, while the link was never followed.
+ */
+layer(HostedLive, { excludeTestServices: true })("Settings intent prefetch", (it) => {
+  const cases = [
+    { scenario: scenarios.settingsIntentPrefetchDesktop, width: 1280, actor: "owner" },
+    { scenario: scenarios.settingsIntentPrefetchPhone, width: 390, actor: "owner" },
+    { scenario: scenarios.settingsIntentPrefetchMember, width: 1280, actor: "member" },
+  ] as const;
+  for (const { scenario, width, actor } of cases) {
+    const phone = width === 390;
+    const administrator = actor === "owner";
+    it.effect(scenario.title, (context) =>
+      withHostedCase(
+        context,
+        Effect.gen(function* () {
+          const actors = yield* Actors;
+          const browser = yield* Browser;
+          const evidence = yield* Evidence;
+          const organization = `/org/${actors.organization.slug}`;
+          const session: Session = actors[actor];
+          const reads: SettingsRead[] = [];
+          const forbiddenRequests: string[] = [];
+          const identity: string[] = [];
+          let intentOnly = true;
+          const answered: SettingsRead[] = [];
+          let membersFailed = yield* Deferred.make<void>();
+          const record = (request: Request) => {
+            reads.push(...settingsReads(request));
+            identity.push(...identityReads(request));
+            if (!intentOnly) return;
+            const path = new URL(request.url()).pathname;
+            const telemetry =
+              /^\/api\/telemetry\/(traces|logs)$/.test(path) ||
+              [
+                "/api/fedcba9876543210/submit",
+                "/api/0123456789abcdef/push",
+                "/api/0123456789abcdef/flags/",
+              ].includes(path);
+            if (
+              /health/i.test(path) ||
+              (request.method() !== "GET" &&
+                !(request.method() === "POST" && (path === batchPath || telemetry)))
+            )
+              forbiddenRequests.push(`${request.method()} ${path}`);
+          };
+          const finished = (request: Request) => answered.push(...settingsReads(request));
+          const failed = (request: Request) => {
+            if (settingsReads(request).includes("members"))
+              Deferred.doneUnsafe(membersFailed, Effect.void);
+          };
+          yield* browser.login(session);
+          yield* Effect.acquireRelease(
+            browser.use("Observe settings reads with the browser clock", (page) =>
+              page.clock.install().then(() => {
+                page.on("request", record);
+                page.on("requestfinished", finished);
+                page.on("requestfailed", failed);
+                return page.setViewportSize({ width, height: 844 });
+              }),
+            ),
+            () =>
+              browser
+                .use("Stop observing settings reads", (page) => {
+                  page.off("request", record);
+                  page.off("requestfinished", finished);
+                  page.off("requestfailed", failed);
+                  return Promise.resolve();
+                })
+                .pipe(Effect.orDie),
+          );
+          const settle = (label: string) =>
+            browser.use(label, (page) =>
+              Promise.all([
+                page.evaluate(
+                  () =>
+                    new Promise<void>((resolve) =>
+                      requestAnimationFrame(() => requestAnimationFrame(() => resolve())),
+                    ),
+                ),
+                page.clock.runFor(100),
+              ]).then(() => undefined),
+            );
+          const link = (page: Page): Locator =>
+            page
+              .getByRole("navigation", { name: "Main navigation" })
+              .getByRole("link", { name: "Settings", exact: true });
+          const showLink = (label: string) =>
+            phone
+              ? browser.use(label, (page) =>
+                  page
+                    .getByRole("button", { name: "Menu", exact: true })
+                    .click()
+                    .then(() => link(page).waitFor()),
+                )
+              : browser.use(label, (page) => link(page).waitFor());
+          const showIntent = (page: Page) =>
+            phone ? link(page).dispatchEvent("touchstart") : link(page).hover();
+          const expected: SettingsRead[] = administrator ? ["invitations", "members"] : ["members"];
+          /** A fresh Apps document that has never read members, invitations or billing. */
+          const enterApps = (label: string) =>
+            Effect.gen(function* () {
+              intentOnly = true;
+              reads.length = 0;
+              answered.length = 0;
+              forbiddenRequests.length = 0;
+              yield* openThroughBrowser(label, `${organization}/apps`);
+              yield* browser.use(`${label}: Apps is shown`, (page) =>
+                page.getByRole("heading", { name: /^Apps/ }).first().waitFor(),
+              );
+              yield* settle(`${label}: entry settles`);
+              expect(
+                reads.filter((read) => read !== "billing"),
+                "Apps reads no members or invitations before any intent",
+              ).toEqual([]);
+            });
+          /** Billing the destination reads after its click must not start on intent. */
+          const withoutBilling = <A, E, R>(label: string, intent: Effect.Effect<A, E, R>) =>
+            Effect.gen(function* () {
+              const before = count(reads, "billing");
+              const result = yield* intent;
+              expect(count(reads, "billing"), `${label} reads no billing`).toBe(before);
+              return result;
+            });
+          const answers = (label: string) =>
+            browser.use(label, (page) =>
+              Promise.all(
+                expected.map((kind) =>
+                  answered.includes(kind)
+                    ? Promise.resolve()
+                    : page
+                        .waitForEvent("requestfinished", (request) =>
+                          settingsReads(request).includes(kind),
+                        )
+                        .then(() => undefined),
+                ),
+              ),
+            );
+          const stillOnApps = (label: string) =>
+            Effect.gen(function* () {
+              const path = yield* browser.use(label, (page) =>
+                Promise.resolve(new URL(page.url()).pathname),
+              );
+              expect(path, label).toBe(`${organization}/apps`);
+            });
+          /**
+           * Following the link renders retained rows on its first frame: no members skeleton and
+           * no page loading state. Cloud's SSO card owns its own loading state and is not counted.
+           */
+          const followed = (label: string, key: string) =>
+            Effect.gen(function* () {
+              intentOnly = false;
+              const observation = yield* observeNavigation(
+                label,
+                { kind: "sidebar", link: "Settings" },
+                { selector: 'table[aria-label="Members"]' },
+              );
+              yield* evidence.json(`settings-intent-${key}-${actor}-${width}.json`, {
+                label,
+                observation,
+                reads,
+              });
+              expect(observation.contentMs, `${label} shows the members`).not.toBeNull();
+              expect(observation.contentAtStart).toBe(false);
+              expect(
+                observation.loading.filter((entry) => !entry.label.startsWith("Loading SSO")),
+                `${label} commits no loading state`,
+              ).toEqual([]);
+            });
+          const rowsShown = (label: string) =>
+            browser.use(label, (page) =>
+              page
+                .getByRole("main")
+                .getByRole("table", { name: "Members", exact: true })
+                .locator("tbody tr")
+                .count(),
+            );
+
+          // In-flight intent: the first read is held, and repeated intent joins it.
+          yield* enterApps("Enter Apps for the primary intent");
+          yield* showLink("Show the Settings link");
+          const held = yield* holdQuery([membersPath], "continue");
+          const intentStart = count(reads, "billing");
+          const identityBeforeIntent = identity.length;
+          yield* browser.use(phone ? "Touch Settings" : "Hover Settings", (page) =>
+            showIntent(page).then(() => page.clock.runFor(100)),
+          );
+          const requested = yield* Effect.option(held.requested.pipe(Effect.timeout("5 seconds")));
+          expect(Option.isSome(requested), "Intent reads members before the click").toBe(true);
+          yield* browser.use("Repeat the intent while members are held", (page) =>
+            (phone ? showIntent(page) : page.mouse.move(0, 0).then(() => showIntent(page))).then(
+              () => page.clock.runFor(100),
+            ),
+          );
+          yield* settle("The repeated intent settles");
+          expect(count(reads, "members"), "Repeated intent joins the held read").toBe(1);
+          yield* held.release;
+          yield* answers("The intent's reads answer");
+          yield* settle("The answer settles");
+          yield* stillOnApps("Intent alone stays on Apps");
+          expect(
+            identity.slice(identityBeforeIntent),
+            "Intent reuses the verified access, organizations and session",
+          ).toEqual([]);
+          expect(count(reads, "billing"), "Intent reads no billing").toBe(intentStart);
+          expect(
+            reads.filter((read) => read !== "billing").sort(),
+            "Intent reads each settings endpoint once",
+          ).toEqual(expected);
+
+          // Unfollowed intent: nothing reads again on focus, visibility or timers.
+          if (!phone) yield* browser.use("Move the pointer away", (page) => page.mouse.move(0, 0));
+          const beforeIdle = reads.length;
+          yield* refreshVisiblePage;
+          yield* browser.use("Focus the window after intent", (page) =>
+            page.evaluate(() => {
+              window.dispatchEvent(new Event("focus"));
+            }),
+          );
+          // Past the reads' 30 second freshness, so following the link refreshes behind the rows.
+          yield* browser.use("Let the answer go stale", (page) => page.clock.runFor(31_000));
+          yield* settle("Flush fetch dispatch after the due timers");
+          // Apps' own reads may refresh here; only the settings reads belong to the intent.
+          const idleReads = reads.slice(beforeIdle).filter((read) => read !== "billing");
+          yield* evidence.json(`settings-intent-idle-${actor}-${width}.json`, { idleReads });
+          expect(idleReads, "An unfollowed intent keeps no settings read").toEqual([]);
+          expect(count(reads, "billing"), "Unfollowed intent reads no billing or removal").toBe(
+            intentStart,
+          );
+          expect(
+            forbiddenRequests,
+            "Intent and its idle window send no product mutation or health check",
+          ).toEqual([]);
+          yield* browser.checkpoint(`Settings intent settled without navigating at ${width}`);
+
+          // The stale answer is shown at once and read again behind it; a failed read keeps it.
+          membersFailed = yield* Deferred.make<void>();
+          const failing = yield* holdQuery([membersPath], "fail");
+          yield* followed("Follow the warmed Settings link", "intent");
+          yield* failing.requested;
+          yield* failing.release;
+          yield* Deferred.await(membersFailed);
+          yield* settle("The failed refresh settles");
+          expect(
+            yield* rowsShown("Members after the failed refresh"),
+            "A failed refresh keeps the shown members",
+          ).toBeGreaterThan(0);
+          yield* browser.checkpoint(`Settings members after a failed refresh at ${width}`);
+          if (!administrator)
+            expect(count(reads, "invitations"), "A member never reads invitations").toBe(0);
+
+          // Keyboard focus is intent too, and a fresh answer is shown without reading again.
+          yield* enterApps("Enter Apps for keyboard focus");
+          yield* showLink("Show the Settings link for keyboard focus");
+          const identityBeforeFocus = identity.length;
+          yield* withoutBilling(
+            "Keyboard focus",
+            Effect.gen(function* () {
+              yield* browser.use("Focus Settings", (page) =>
+                link(page)
+                  .focus()
+                  .then(() => page.clock.runFor(100)),
+              );
+              yield* answers("The focus reads answer");
+              yield* settle("The focus answer settles");
+            }),
+          );
+          yield* stillOnApps("Focus alone stays on Apps");
+          expect(
+            identity.slice(identityBeforeFocus),
+            "Focus reuses the verified access, organizations and session",
+          ).toEqual([]);
+          expect(
+            reads.filter((read) => read !== "billing").sort(),
+            "Focus reads each settings endpoint once",
+          ).toEqual(expected);
+          expect(
+            forbiddenRequests,
+            "Focus intent sends no product mutation or health check",
+          ).toEqual([]);
+          yield* followed("Follow the focused Settings link", "focus");
+          yield* settle("The focused destination settles");
+          expect(count(reads, "members"), "A fresh answer is not read again").toBe(1);
+          expect(yield* rowsShown("Members from the focus read")).toBeGreaterThan(0);
+          const membersImage = yield* browser.use("Capture the loaded member rows", (page) =>
+            page.locator(".organization-members").screenshot(),
+          );
+          yield* evidence.attach(
+            `settings-members-${actor}-${width}.png`,
