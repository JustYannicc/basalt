diff --git a/e2e/support/fixture-diagnostics.ts b/e2e/support/fixture-diagnostics.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/fixture-diagnostics.ts
@@ -0,0 +1,64 @@
+/** Private runner evidence survives generic fixture HTTP errors and subprocess cleanup. */
+import { Cause, Effect, FileSystem, Stream } from "effect";
+import { ChildProcess, ChildProcessSpawner } from "effect/process";
+import { randomUUID } from "node:crypto";
+
+const diagnosticFiles = (directory: string, name: string) =>
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem;
+    const output = `${directory}/report/diagnostics`;
+    yield* fs.makeDirectory(output, { recursive: true, mode: 0o700 }).pipe(Effect.ignore);
+    const prefix = `${output}/${name}-${randomUUID()}`;
+    return {
+      write: (suffix: string, text: string, append = false) =>
+        fs
+          .writeFileString(`${prefix}${suffix}`, text, {
+            flag: append ? "a" : "w",
+            mode: 0o600,
+          })
+          .pipe(Effect.ignore),
+    };
+  });
+
+/** Drain both pipes together so a noisy failure cannot block its own exit. */
+export const fixtureProcessOutput = (directory: string, command: ChildProcess.Command) =>
+  Effect.gen(function* () {
+    const evidence = yield* diagnosticFiles(directory, "physical-provisioning");
+    const processes = yield* ChildProcessSpawner.ChildProcessSpawner;
+    const child = yield* processes.spawn(command);
+    yield* evidence.write(".stdout.log", "");
+    yield* evidence.write(".stderr.log", "");
+    const [stdout, , exitCode] = yield* Effect.all(
+      [
+        child.stdout.pipe(
+          Stream.decodeText(),
+          Stream.tap((text) => evidence.write(".stdout.log", text, true)),
+          Stream.mkString,
+        ),
+        child.stderr.pipe(
+          Stream.decodeText(),
+          Stream.runForEach((text) =>
+            evidence.write(".stderr.log", text, true).pipe(
+              Effect.andThen(
+                Effect.sync(() => {
+                  process.stderr.write(text);
+                }),
+              ),
+            ),
+          ),
+        ),
+        child.exitCode.pipe(
+          Effect.tap((exitCode) => evidence.write(".json", `${JSON.stringify({ exitCode })}\n`)),
+        ),
+      ],
+      { concurrency: "unbounded" },
+    );
+    return { stdout, exitCode };
+  });
+
+/** The public control response stays generic; the runner keeps the complete nested cause. */
+export const retainFixtureCause = (directory: string, cause: Cause.Cause<unknown>) =>
+  Effect.gen(function* () {
+    const evidence = yield* diagnosticFiles(directory, "cloud-runtime-control");
+    yield* evidence.write(".json", `${JSON.stringify({ cause: Cause.pretty(cause) })}\n`);
+  });
