--- /dev/null
+++ b/apps/hosted/server/src/implementation/account-traffic-change-schema.ts
@@ -0,0 +1,26 @@
+import { Effect } from "effect";
+import { SqlClient } from "effect/sql";
+
+/** Counter writes publish only their account key; readers must authorize that key separately. */
+export const migrateAccountTrafficChanges = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  yield* sql`create or replace function hosted_account_traffic_changed() returns trigger language plpgsql as $$
+    declare previous text; following text; account_id text; target_scope text;
+    begin
+      if TG_OP <> 'INSERT' then previous := OLD.account; end if;
+      if TG_OP <> 'DELETE' then following := NEW.account; end if;
+      if TG_OP = 'UPDATE' and to_jsonb(OLD) = to_jsonb(NEW) then return NEW; end if;
+      for account_id in select distinct value from unnest(array[previous,following]) value
+        where value is not null loop
+        select owner into target_scope from executor_accounts where id=account_id;
+        if target_scope is not null then
+          perform hosted_queue_change(target_scope,'account-traffic',account_id);
+        end if;
+      end loop;
+      if TG_OP = 'DELETE' then return OLD; end if;
+      return NEW;
+    end $$`;
+  yield* sql`create or replace trigger hosted_account_traffic_changed
+    after insert or update or delete on executor_account_tool_calls
+    for each row execute function hosted_account_traffic_changed()`;
+});
