+++ b/packages/ui/src/implementation/dashboard/publish-app.tsx
@@ -285,3 +285,4 @@
+const publishingBox = "h-9 w-26 max-[740px]:h-11";
 const publishingPending = (
-  <Skeleton className="h-9 w-26 max-[740px]:h-11" aria-label="Loading publishing access" />
+  <Skeleton className={publishingBox} aria-label="Loading publishing access" />
 );
@@ -297,4 +298,9 @@
   const { result } = useQuery(atoms.publishing);
-  if (AsyncResult.isSuccess(result)) return result.value.publishing ? children : null;
-  return AsyncResult.isFailure(result) ? children : publishingPending;
+  // A placeholder shown while the host answered keeps its box when the answer is no: on a phone
+  // it is the actions row, and removing it would pull everything beneath it up.
+  const [heldPlace] = useState(() => AsyncResult.isInitial(result));
+  if (!AsyncResult.isSuccess(result))
+    return AsyncResult.isFailure(result) ? children : publishingPending;
+  if (result.value.publishing) return children;
+  return heldPlace ? <div aria-hidden className={cn("invisible", publishingBox)} /> : null;
 }
