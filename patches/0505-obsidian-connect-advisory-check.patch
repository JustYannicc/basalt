+/**
+ * A published release never changes, so finding it holds for the browser session. A missing one
+ * may still be published under this tag, so only "available" is remembered.
+ */
+const sessionKey = (repository: string) => `signalbox-sync-release:${repository}:${basaltSyncTag}`;
+const remembered = (repository: string): BasaltSyncRelease | null => {
+  try {
+    const value = globalThis.sessionStorage?.getItem(sessionKey(repository));
+    return value === "available" ? value : null;
+  } catch {
+    return null;
+  }
+};
+const remember = (repository: string, release: BasaltSyncRelease) => {
+  if (release !== "available") return;
+  try {
+    globalThis.sessionStorage?.setItem(sessionKey(repository), release);
+  } catch {
+    // Storage can be full or blocked; the check simply runs again next time.
+  }
+};
