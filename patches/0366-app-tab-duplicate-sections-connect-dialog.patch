diff --git a/e2e/tests/app-account-sections.spec.ts b/e2e/tests/app-account-sections.spec.ts
new file mode 100644
index 00000000..58644cc2
--- /dev/null
+++ b/e2e/tests/app-account-sections.spec.ts
@@ -0,0 +1,200 @@
+/**
+ * An app's Accounts tab gives each account requirement one section that reads as its own, and the
+ * Connect dialog closes cleanly after saving a key its check rejected.
+ */
+import { expect, layer } from "@effect/vitest";
+import { Effect } from "effect";
+import { randomUUID } from "node:crypto";
+import type { Page } from "playwright";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { App } from "../support/contracts.ts";
+import { accountNamePrompt, nameConnectedAccount } from "../support/name-account.ts";
+import { scenarios } from "../test-plan.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { anyRowMenuName } from "../support/account-choices.ts";
+import { dialogLeftovers, rejectingSource } from "../support/app-account-sections.ts";
+
+// One service declared twice, as a catalog app keeps API tokens and sign-ins apart: both
+// requirements carry the service's name and link many accounts for the caller.
+const twoRequirements = `
+import { defineApp, defineProvider, object, oauth2, router, secrets, string } from "apps";
+const tokens = defineProvider({ name: "Deploy fixture", auth: { apiKey: secrets({ label: "Access token", fields: object({ token: string() }) }) } });
+const signIn = defineProvider({ name: "Deploy fixture", auth: { oauth: oauth2({ authorizationUrl: "https://oauth.example.test/authorize", tokenUrl: "https://oauth.example.test/token", scopes: ["read"] }) } });
+export default defineApp({ user: { accounts: { tokens: tokens.many(), signIn: signIn.many() } } }, async () => ({ tools: router({}) }));
+`;
+
+/** Each requirement section in Your accounts: its accessible name and what its header reads. */
+const readSections = (page: Page) =>
+  page
+    .getByRole("region", { name: "Your accounts", exact: true })
+    .locator("section[aria-label]")
+    .evaluateAll((sections) =>
+      sections.map((section) => ({
+        name: section.getAttribute("aria-label"),
+        header: (section.firstElementChild as HTMLElement | null)?.innerText.trim() ?? "",
+        lists: Array.from(section.querySelectorAll("ul[aria-label]"), (list) =>
+          list.getAttribute("aria-label"),
+        ),
+      })),
+    );
+
+layer(HostedLive, { excludeTestServices: true })("App account sections", (it) => {
+  const deploy = (name: string, content: string) =>
+    Effect.gen(function* () {
+      const actors = yield* Actors;
+      const api = yield* Api;
+      const prefix = `/api/organizations/${actors.organization.id}`;
+      const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+        name: `${name} ${randomUUID().slice(0, 8)}`,
+        files: [{ path: "index.ts", content }, appsManifest],
+      });
+      expect(deployed.status).toBe(200);
+      const app = yield* body(App, deployed);
+      yield* Effect.addFinalizer(() =>
+        api.request(actors.owner, "DELETE", `${prefix}/apps/${app.id}`).pipe(
+          Effect.map((response) => expect(response.status).toBe(200)),
+          Effect.orDie,
+        ),
+      );
+      return app;
+    });
+
+  const distinctSections = (width: number) => (context: Parameters<typeof withHostedCase>[0]) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const actors = yield* Actors;
+        const browser = yield* Browser;
+        const app = yield* deploy("Sections", twoRequirements);
+        yield* browser.login(actors.owner);
+        yield* browser.use(`A ${width}px screen`, (page) =>
+          page.setViewportSize({ width, height: width < 600 ? 844 : 900 }),
+        );
+        yield* browser.use("Open the app's accounts", (page) =>
+          page
+            .goto(`/org/${actors.organization.slug}/apps/${app.id}?view=accounts`)
+            .then(() =>
+              page
+                .getByRole("region", { name: "Your accounts", exact: true })
+                .getByRole("button", { name: "Connect new account", exact: true })
+                .nth(1)
+                .waitFor({ state: "visible" }),
+            ),
+        );
+        const sections = yield* browser.use("Read the requirement sections", readSections);
+        yield* browser.checkpoint(`Requirement sections at ${width}px`);
+        expect(sections).toHaveLength(2);
+        // Each section names what it is for, so neither reads as a copy of the other.
+        expect(new Set(sections.map((section) => section.name)).size).toBe(2);
+        expect(new Set(sections.map((section) => section.header)).size).toBe(2);
+        expect(new Set(sections.flatMap((section) => section.lists)).size).toBe(
+          sections.flatMap((section) => section.lists).length,
+        );
+        expect(sections.map((section) => section.name).sort()).toEqual([
+          "Deploy fixture · Access token",
+          "Deploy fixture · Sign in",
+        ]);
+      }),
+    );
+
+  it.effect(scenarios.appAccountSectionsDistinctDesktop.title, distinctSections(1280));
+  it.effect(scenarios.appAccountSectionsDistinctPhone.title, distinctSections(390));
+
+  it.effect(scenarios.appAccountContinueAnywayCloses.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const actors = yield* Actors;
+        const browser = yield* Browser;
+        const app = yield* deploy("Rejecting", rejectingSource);
+        yield* browser.login(actors.owner);
+        yield* browser.use("A 1280px screen", (page) =>
+          page.setViewportSize({ width: 1280, height: 900 }),
+        );
+        yield* browser.use("Open the app's accounts", (page) =>
+          page.goto(`/org/${actors.organization.slug}/apps/${app.id}?view=accounts`),
+        );
+        yield* browser.use("Connect a new account", (page) =>
+          page.getByRole("button", { name: "Connect new account", exact: true }).click(),
+        );
+        const connect = yield* browser.use("The Connect dialog opens", (page) => {
+          const dialog = page.getByRole("dialog", {
+            name: "Connect Rejecting fixture",
+            exact: true,
+          });
+          return dialog.waitFor({ state: "visible" }).then(() => dialog);
+        });
+        yield* browser.use("Validate a key the check rejects", () =>
+          connect
+            .getByLabel("Token", { exact: true })
+            .fill("synthetic-rejected-token")
+            .then(() =>
+              connect.getByRole("button", { name: "Validate Access token", exact: true }).click(),
+            )
+            .then(() =>
+              connect
+                .locator('[data-credential-check="credentials_rejected"]')
+                .waitFor({ state: "visible" }),
+            ),
+        );
+        yield* browser.checkpoint("The check rejected the key");
+        yield* browser.use("Continue anyway", () =>
+          connect.getByRole("button", { name: "Continue anyway", exact: true }).click(),
+        );
+        // The prompt takes the Connect dialog's place, which unmounts rather than staying behind
+        // it, hidden, until the prompt closes.
+        const behindPrompt = yield* browser.use(
+          "The Connect dialog unmounts behind the prompt",
+          (page) =>
+            accountNamePrompt(page)
+              .then(() =>
+                page
+                  .waitForFunction(
+                    () => document.querySelectorAll('[data-slot="dialog-content"]').length === 1,
+                    undefined,
+                    { timeout: 3_000 },
+                  )
+                  .catch(() => undefined),
+              )
+              .then(() =>
+                page.evaluate(() =>
+                  Array.from(document.querySelectorAll('[data-slot="dialog-content"]'), (dialog) =>
+                    dialog.getAttribute("data-state"),
+                  ),
+                ),
+              ),
+        );
+        yield* browser.checkpoint("The name prompt replaces the Connect dialog");
+        expect(behindPrompt).toEqual(["open"]);
+        yield* browser.use("Name the saved account", (page) =>
+          nameConnectedAccount(page, "Rejected key"),
+        );
+        // The Connect dialog is gone with its overlay and focus scope, and focus is on the page.
+        const left = yield* browser.use("Nothing of the dialog is left", dialogLeftovers);
+        yield* browser.checkpoint("After Continue anyway");
+        expect(left).toEqual({
+          dialogs: 0,
+          overlays: 0,
+          focusGuards: 0,
+          bodyPointerEvents: "auto",
+          focusOnPage: true,
+        });
+        // The very next click opens the new row's menu without Escape first.
+        yield* browser.use("Open the new row's menu", (page) =>
+          page
+            .getByRole("button", { name: anyRowMenuName("Rejected key") })
+            .click({ timeout: 5_000 })
+            .then(() => page.getByRole("menu").waitFor({ state: "visible", timeout: 5_000 })),
+        );
+        yield* browser.checkpoint("The row menu opens");
+        yield* browser.use("A 390px screen", (page) =>
+          page.setViewportSize({ width: 390, height: 844 }),
+        );
+        yield* browser.checkpoint("The row menu on a phone");
+      }),
+    ),
+  );
+});
