new file mode 100644
index 00000000..7b7eb611
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/requirement-titles.ts
@@ -0,0 +1,52 @@
+/**
+ * The titles of one scope's account requirements on an app's Accounts tab, so no two sections read
+ * the same when an app declares one service more than once.
+ */
+import type { AccountRequirement } from "@executor-js/sdk";
+import { requirementMethods } from "../../contracts/app-accounts.ts";
+import { methodLabels, methodVariant } from "./method-labels.ts";
+
+type RequirementEntry = readonly [string, AccountRequirement];
+
+/** The requirement's sign-in methods as its connect form names them, without repeating the service. */
+const methodsFor = (requirement: AccountRequirement) => {
+  const signIn = `Sign in with ${requirement.definition.name}`;
+  return [...methodLabels(requirement.definition.name, requirementMethods(requirement)).values()]
+    .map((label) =>
+      label === signIn || label.startsWith(`${signIn} `)
+        ? `Sign in${label.slice(signIn.length)}`
+        : label,
+    )
+    .join(", ");
+};
+
+/**
+ * Each requirement's title by slot: its service's name, and where several requirements share that
+ * name, what each is for: its sign-in methods, else its slot in words, else its slot as declared.
+ * Every title in the scope is distinct. A requirement whose service has no name gets no title.
+ */
+export const requirementTitles = (
+  requirements: readonly RequirementEntry[],
+): ReadonlyMap<string, string> => {
+  const named = requirements.flatMap(([slot, requirement]) => {
+    const name = requirement.definition.name.trim();
+    return name === "" ? [] : [{ slot, name, methods: methodsFor(requirement) }];
+  });
+  const titled = named.map((entry) => {
+    const alike = named.filter((other) => other.name === entry.name);
+    if (alike.length === 1) return { slot: entry.slot, title: entry.name };
+    const qualifier =
+      entry.methods !== "" &&
+      alike.every((other) => other === entry || other.methods !== entry.methods)
+        ? entry.methods
+        : methodVariant(entry.slot);
+    return { slot: entry.slot, title: `${entry.name} · ${qualifier}` };
+  });
+  // Variants can still meet, such as `apiKey` and `api_key`; the declared slot settles them.
+  return new Map(
+    titled.map(({ slot, title }) => [
+      slot,
+      titled.filter((other) => other.title === title).length > 1 ? `${title} [${slot}]` : title,
+    ]),
+  );
+};
