diff --git a/packages/ui/src/implementation/components/dialog.tsx b/packages/ui/src/implementation/components/dialog.tsx
index 7519ddc9..a8ccdc57 100644
--- a/packages/ui/src/implementation/components/dialog.tsx
+++ b/packages/ui/src/implementation/components/dialog.tsx
@@ -61,10 +61,56 @@ const focusFirstField = (event: Event) => {
   field.focus();
 };
 
+const dialogContent = '[data-slot="dialog-content"]';
+
+/** Where each mounted dialog returns focus, nearest first. */
+const returnTargets = new WeakMap<Element, readonly Element[]>();
+
+/**
+ * Where a dialog opening now returns focus: the element that has focus, then, when it opens over
+ * or in place of another dialog, wherever that dialog returns focus. So a prompt that replaces the
+ * dialog it was opened from returns focus to what opened that dialog.
+ */
+const openerTargets = (): readonly Element[] => {
+  const active = document.activeElement;
+  const own = active !== null && active !== document.body ? [active] : [];
+  const dialogs = document.querySelectorAll(dialogContent);
+  const host = active?.closest(dialogContent) ?? dialogs[dialogs.length - 1];
+  return [...own, ...((host && returnTargets.get(host)) ?? [])];
+};
+
+/** Focus the first target still on the page outside a closing dialog; false when none takes it. */
+const returnFocus = (targets: readonly Element[]) =>
+  targets.some((target) => {
+    if (
+      !(target instanceof HTMLElement) ||
+      !target.isConnected ||
+      target.closest(`${dialogContent}[data-state="closed"]`) !== null
+    )
+      return false;
+    target.focus({ preventScroll: true });
+    return document.activeElement === target;
+  });
+
+/**
+ * Reads where focus returns as the content mounts, before any field inside it takes focus. A dialog
