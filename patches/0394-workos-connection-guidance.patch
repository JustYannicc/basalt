diff --git a/apps/local/web/src/implementation/pages/catalog-connection-guidance.ts b/apps/local/web/src/implementation/pages/catalog-connection-guidance.ts
new file mode 100644
index 0000000..249158e
--- /dev/null
+++ b/apps/local/web/src/implementation/pages/catalog-connection-guidance.ts
@@ -0,0 +1,16 @@
+import type { AppId } from "@executor-js/sdk";
+import { Option } from "effect";
+import { useQuery } from "@executor-js/ui/dashboard/context";
+import { overviewAtom } from "../../contracts/api.ts";
+import { catalogAtom } from "../../contracts/onboarding.ts";
+
+/** An app's copied package identifies its guidance; a provider's display name does not. */
+export function useCatalogConnectionGuidance(app: AppId, requirement: string) {
+  const overview = useQuery(overviewAtom);
+  const catalog = useQuery(catalogAtom);
+  const copiedFrom = Option.getOrUndefined(overview.data)?.apps.find((entry) => entry.id === app)
+    ?.copiedFrom?.name;
+  return Option.getOrUndefined(catalog.data)
+    ?.find((entry) => entry.package === copiedFrom)
+    ?.connectionGuidance?.filter((entry) => entry.requirement === requirement);
+}
