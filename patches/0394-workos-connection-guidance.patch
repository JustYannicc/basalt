@@ -0,0 +1,29 @@
+import type { AppId } from "@executor-js/sdk";
+import { Option } from "effect";
+import { AsyncResult } from "effect/reactivity";
+import { useQuery } from "@executor-js/ui/dashboard/context";
+import { overviewAtom } from "../../contracts/api.ts";
+import { catalogAtom } from "../../contracts/onboarding.ts";
+
+/** An app's copied package identifies its guidance; a provider's display name does not. */
+export function useCatalogConnectionMetadata(id: AppId) {
+  const overview = useQuery(overviewAtom);
+  const catalog = useQuery(catalogAtom);
+  const app = Option.getOrUndefined(overview.data)?.apps.find((entry) => entry.id === id);
+  const copiedFrom = app?.copiedFrom?.name;
+  const guidance = Option.getOrUndefined(catalog.data)?.find(
+    (entry) => entry.package === copiedFrom,
+  )?.connectionGuidance;
+  const waiting =
+    AsyncResult.isInitial(overview.result) ||
+    overview.result.waiting ||
+    AsyncResult.isInitial(catalog.result) ||
+    catalog.result.waiting;
+  return { app, guidance, waiting };
+}
+
+export function useCatalogConnectionGuidance(app: AppId, requirement: string) {
+  return useCatalogConnectionMetadata(app).guidance?.filter(
+    (entry) => entry.requirement === requirement,
+  );
+}
