@@ -0,0 +1,96 @@
+import { Link } from "@tanstack/react-router";
+import { Option } from "effect";
+import type { OAuthCompletionRecovery } from "@executor-js/sdk";
+import { Button } from "@executor-js/ui/components/button";
+import { CopyButton } from "@executor-js/ui/dashboard/code";
+import { useProductBrand } from "@executor-js/ui/hooks/product-brand";
+import type { PendingOAuth } from "../../contracts/apps.ts";
+
+/** Recovery links resume the original connection or return to the page that started it. */
+export function OAuthRecoveryActions({
+  pending,
+  recovery,
+  fixPrompt,
+  partial = false,
+  canRetry = true,
+}: {
+  readonly pending: Option.Option<typeof PendingOAuth.Type>;
+  readonly recovery: OAuthCompletionRecovery | "setup";
+  readonly fixPrompt?: string | undefined;
+  /** The service granted only part of the request; a retry asks for the same access again. */
+  readonly partial?: boolean | undefined;
+  readonly canRetry?: boolean | undefined;
+}) {
+  const brand = useProductBrand();
+  if (Option.isNone(pending))
+    return (
+      <Button asChild>
+        <Link to="/">Open {brand.name}</Link>
+      </Button>
+    );
+  const context = pending.value;
+  // Entered clients are saved only after a successful sign-in, so a retry reopens their fields.
+  const retry =
+    canRetry && (recovery === "restart" || recovery === "client")
+      ? {
+          label:
+            recovery === "client"
+              ? "Update client details"
+              : partial
+                ? "Grant access again"
+                : "Try again",
+          search:
+            recovery === "client" || context.manualClient === true
+              ? { client: "change" as const }
+              : {},
+        }
+      : undefined;
+  const primary = retry === undefined && fixPrompt === undefined;
+  return (
+    <>
+      {fixPrompt !== undefined && (
+        <CopyButton
+          code={fixPrompt}
+          label="Copy fix prompt"
+          text="Copy fix prompt"
+          variant="default"
+          size="default"
+          inline
+        />
+      )}
+      {retry !== undefined && (
+        <Button asChild>
+          <Link
+            to="/org/$organizationSlug/connections/$connectionId"
+            params={{
+              organizationSlug: context.organizationSlug,
+              connectionId: context.connection,
+            }}
+            search={retry.search}
+          >
+            {retry.label}
+          </Link>
+        </Button>
+      )}
+      <Button variant={primary ? "default" : "outline"} asChild>
+        {context.returnTo !== undefined ? (
+          <Link
+            to="/org/$organizationSlug/setup/accounts"
+            params={{ organizationSlug: context.organizationSlug }}
+            search={context.returnTo.handoff ?? {}}
+          >
+            Back to setup
+          </Link>
+        ) : (
+          <Link
+            to="/org/$organizationSlug/apps/$appId"
+            params={{ organizationSlug: context.organizationSlug, appId: context.app }}
+            search={{ view: "accounts" }}
+          >
+            Back to app
+          </Link>
+        )}
+      </Button>
+    </>
+  );
+}
