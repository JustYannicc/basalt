+      details: Schema.optionalKey(Schema.String),
+    }),
+  ),
+  credentials: Schema.optionalKey(CredentialGuidance),
+  oauthClient: Schema.optionalKey(CredentialGuidance),
+});
+export type CatalogConnectionGuidance = typeof CatalogConnectionGuidance.Type;
