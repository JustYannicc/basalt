+import { useAtomSet, useAtomValue } from "@effect/atom-react";
+import { guidedOAuthFailureAtom } from "../../contracts/apps.ts";
+import { useOrganizationRoute } from "../components/organization.tsx";
+import { AccountConnectionDialog } from "./connection-dialog.tsx";
+
+/** Onboarding returns to its existing, server-resolved connection rather than a client editor. */
+export function SetupConnectionRecovery() {
+  const failure = useAtomValue(guidedOAuthFailureAtom);
+  const clear = useAtomSet(guidedOAuthFailureAtom);
+  const { slug } = useOrganizationRoute();
+  return failure?.context.returnTo?.page === "setup" &&
+    failure.context.organizationSlug === slug ? (
+    <AccountConnectionDialog
+      connectionId={failure.context.connection}
+      onClose={() => clear(undefined)}
+    />
+  ) : null;
+}
