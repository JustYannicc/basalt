diff --git a/packages/ui/src/contracts/guided-oauth-failure.ts b/packages/ui/src/contracts/guided-oauth-failure.ts
new file mode 100644
index 0000000..0b66d47
--- /dev/null
+++ b/packages/ui/src/contracts/guided-oauth-failure.ts
@@ -0,0 +1,21 @@
+import { OAuthCompletionFailed, oauthCompletionRecovery } from "@executor-js/sdk";
+import { Cause, Option, Schema } from "effect";
+
+/** A guided service refusal is not evidence that the user's OAuth client is misconfigured. */
+export function guidedOAuthFailure(cause: Cause.Cause<unknown>) {
+  const failure = Option.getOrUndefined(
+    Option.filter(Cause.findErrorOption(cause), Schema.is(OAuthCompletionFailed)),
+  );
+  if (
+    failure === undefined ||
+    !(
+      ["cancelled", "client", "restart"].includes(oauthCompletionRecovery[failure.reason]) ||
+      failure.reason === "authorization_rejected"
+    )
+  )
+    return undefined;
+  const response = failure.serviceError;
+  return response !== undefined && "description" in response && response.description
+    ? response.description
+    : "Sign-in did not finish. No account was connected. Try again, or use another connection method.";
+}
