diff --git a/packages/ui/src/implementation/dashboard/connection-method-choices.tsx b/packages/ui/src/implementation/dashboard/connection-method-choices.tsx
new file mode 100644
index 0000000..b513a1d
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/connection-method-choices.tsx
@@ -0,0 +1,86 @@
+import { useState, type ReactNode } from "react";
+import type { App, AccountScope } from "@executor-js/sdk";
+import type { CatalogConnectionGuidance } from "@executor-js/catalog/contracts";
+import { Button } from "../components/button.tsx";
+/** Alternatives can only target this app's declared, currently connectable requirements. */
+export function ConnectionMethodChoices({
+  app,
+  scope,
+  slot,
+  method,
+  guidance,
+  fixed,
+  onChange,
+  canConnect,
+  unavailable: unavailableFor,
+  onPendingChange,
+  children,
+}: {
+  readonly app: App;
+  readonly scope: AccountScope;
+  readonly slot: string;
+  readonly method: string;
+  readonly guidance?: readonly CatalogConnectionGuidance[] | undefined;
+  readonly fixed: boolean;
+  readonly onChange?: (() => void) | undefined;
+  readonly canConnect: (requirement: string) => boolean;
+  readonly unavailable: (requirement: string, method: string) => string | undefined;
+  readonly onPendingChange: (pending: boolean) => void;
+  readonly children: (choice: {
+    readonly slot: string;
+    readonly method: string;
+    readonly actions: ReactNode;
+    readonly unavailable: (method: string) => string | undefined;
+    readonly onPendingChange: (pending: boolean) => void;
+  }) => ReactNode;
+}) {
+  const [selected, setSelected] = useState({ slot, method });
+  const [pending, setPending] = useState(false);
+  const unavailable = unavailableFor;
+  const currentGuide = guidance?.find(
+    (entry) => entry.requirement === selected.slot && entry.method === selected.method,
+  );
+  const alternatives =
+    fixed || currentGuide === undefined
+      ? []
+      : (guidance ?? []).filter((entry) => {
+          const requirement = app.requirements.accounts[entry.requirement];
+          const auth = requirement?.definition.auth[entry.method];
+          return (
+            entry.alternativeLabel !== undefined &&
+            !(entry.requirement === selected.slot && entry.method === selected.method) &&
+            requirement?.scope === scope &&
+            auth !== undefined &&
+            !(auth.type === "secrets" && auth.provisioned === true) &&
+            canConnect(entry.requirement) &&
+            unavailable(entry.requirement, entry.method) === undefined
+          );
+        });
+  return children({
+    ...selected,
+    unavailable: (method) => unavailable(selected.slot, method),
+    onPendingChange: (value) => {
+      setPending(value);
+      onPendingChange(value);
+    },
+    actions: alternatives.length > 0 && (
+      <div className="border-t border-border pt-3">
+        {alternatives.map((entry) => (
+          <Button
+            key={`${entry.requirement}:${entry.method}`}
+            type="button"
+            variant="ghost"
+            className="w-full text-muted-foreground"
+            disabled={pending}
+            onClick={() => {
+              onChange?.();
+              setSelected({ slot: entry.requirement, method: entry.method });
+            }}
+          >
+            {entry.alternativeLabel}
+          </Button>
+        ))}
+      </div>
+    ),
+  });
+}
diff --git a/packages/ui/src/implementation/dashboard/credential-guidance.tsx b/packages/ui/src/implementation/dashboard/credential-guidance.tsx
new file mode 100644
