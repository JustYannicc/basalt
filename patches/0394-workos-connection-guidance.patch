diff --git a/apps/hosted/web/src/implementation/pages/connection-method-choices.tsx b/apps/hosted/web/src/implementation/pages/connection-method-choices.tsx
new file mode 100644
index 0000000..4dcba73
--- /dev/null
+++ b/apps/hosted/web/src/implementation/pages/connection-method-choices.tsx
@@ -0,0 +1,29 @@
+import { Option } from "effect";
+import { ConnectionMethodChoices as SharedChoices } from "@executor-js/ui/dashboard/connection-method-choices";
+import { useQuery } from "@executor-js/ui/dashboard/context";
+import { appMethodsAtom } from "../../contracts/app-accounts.ts";
+import { useOrganizationRoute } from "../components/organization.tsx";
+
+/** Hosted alternatives follow the destination organization's current connection policy. */
+export function ConnectionMethodChoices(
+  props: Omit<Parameters<typeof SharedChoices>[0], "canConnect" | "unavailable">,
+) {
+  const { organization } = useOrganizationRoute();
+  const policy = useQuery(appMethodsAtom({ organization, app: props.app.id }));
+  const current = Option.getOrUndefined(policy.data);
+  return (
+    <SharedChoices
+      {...props}
+      canConnect={(requirement) =>
+        current?.connections.find((entry) => entry.requirement === requirement)?.canConnect === true
+      }
+      unavailable={(requirement, method) =>
+        current === undefined
+          ? "Sign-in methods are unavailable. Retry loading them."
+          : current.unavailable.find(
+              (entry) => entry.requirement === requirement && entry.method === method,
+            )?.reason
+      }
+    />
+  );
+}
diff --git a/apps/hosted/web/src/implementation/pages/guided-connection-recovery.tsx b/apps/hosted/web/src/implementation/pages/guided-connection-recovery.tsx
new file mode 100644
index 0000000..8b882e8
--- /dev/null
+++ b/apps/hosted/web/src/implementation/pages/guided-connection-recovery.tsx
@@ -0,0 +1,114 @@
+import { useEffect } from "react";
+import { useAtomSet, useAtomValue } from "@effect/atom-react";
+import { useNavigate } from "@tanstack/react-router";
+import type { App } from "@executor-js/sdk";
+import type { HostedAccountConnection } from "@executor-js/hosted-server";
+import type { CatalogEntry } from "@executor-js/catalog/contracts";
+import { guidedOAuthFailureAtom } from "../../contracts/apps.ts";
+import { useOrganizationRoute } from "../components/organization.tsx";
+import { AppConnectionDialogContent } from "./app-accounts.tsx";
+
+/** Only the callback tab's exact, still-declared guided target may reopen with alternatives. */
+export function useGuidedConnectionRecovery({
+  app,
+  connection,
+  guidance,
+  onPendingChange,
+}: {
+  readonly app?: App | undefined;
+  readonly connection: HostedAccountConnection;
+  readonly guidance?: CatalogEntry | undefined;
+  readonly onPendingChange: (pending: boolean) => void;
+}) {
+  const failure = useAtomValue(guidedOAuthFailureAtom);
+  const guided = failure?.context.guided;
+  const requirement = app?.requirements.accounts[connection.target.requirement];
+  if (
+    app !== undefined &&
+    requirement !== undefined &&
+    failure !== undefined &&
+    guided !== undefined &&
+    failure.context.connection === connection.id &&
+    failure.context.app === app.id &&
+    guided.requirement === connection.target.requirement &&
+    connection.reconnectAccount === null &&
+    requirement.provider === connection.provider.id &&
+    requirement.definition.auth[guided.method]?.type === "oauth2" &&
+    guidance?.connectionGuidance?.some(
+      (entry) =>
+        entry.requirement === guided.requirement &&
+        entry.method === guided.method &&
+        entry.signIn !== undefined,
+    )
+  )
+    return (
+      <GuidedConnectionRecovery
+        app={app}
+        connection={connection}
+        failure={failure}
+        guidance={guidance}
+        onPendingChange={onPendingChange}
+      />
+    );
+
+  return undefined;
+}
+
+/** A refused dashboard attempt returns to normal, permission-checked connection choices. */
+function GuidedConnectionRecovery({
+  app,
+  connection,
+  failure,
+  guidance,
+  onPendingChange,
+}: {
+  readonly app: App;
+  readonly connection: HostedAccountConnection;
+  readonly failure: NonNullable<
+    import("effect/reactivity").Atom.Type<typeof guidedOAuthFailureAtom>
+  >;
+  readonly guidance: CatalogEntry;
+  readonly onPendingChange: (pending: boolean) => void;
+}) {
+  const clear = useAtomSet(guidedOAuthFailureAtom);
+  const navigate = useNavigate();
+  const { slug: organizationSlug } = useOrganizationRoute();
+  useEffect(
+    () => () =>
+      clear((current) => (current?.context.connection === connection.id ? undefined : current)),
+    [clear, connection.id],
+  );
+  const guided = failure.context.guided!;
+  const requirement = app.requirements.accounts[guided.requirement]!;
+  return (
+    <AppConnectionDialogContent
+      app={app}
+      scope={requirement.scope}
+      slot={guided.requirement}
+      requirement={requirement}
+      method={guided.method}
+      redirectUri={failure.context.redirectUri}
+      notice={failure.message}
+      connectionGuidance={guidance.connectionGuidance}
+      connectionNotices={guidance.connectionNotices}
+      oauthDeferrals={guidance.oauthDeferrals}
+      onPendingChange={onPendingChange}
+      onSaved={() => {
+        clear(undefined);
+        void (failure.context.returnTo !== undefined
+          ? navigate({
+              to: "/org/$organizationSlug/setup/accounts",
+              params: { organizationSlug },
+              search: failure.context.returnTo.handoff ?? {},
+              replace: true,
+            })
+          : navigate({
+              to: "/org/$organizationSlug/apps/$appId",
+              params: { organizationSlug, appId: app.id },
+              search: { view: "accounts" },
+              replace: true,
+            }));
+      }}
+    />
