@@ -0,0 +1,86 @@
+import { Empty, Failure } from "../components/common.tsx";
+import { useState } from "react";
+import { useNavigate } from "@tanstack/react-router";
+import { Cause } from "effect";
+import { guidedOAuthFailure } from "@executor-js/ui/contracts/guided-oauth-failure";
+import {
+  Dialog,
+  DialogContent,
+  DialogTitle,
+  DialogDescription,
+} from "@executor-js/ui/components/dialog";
+import type { OAuthReturn } from "../../contracts/oauth.ts";
+import { useCatalogConnectionMetadata } from "./catalog-connection-guidance.ts";
+import { AppAccountForm } from "./account-form.tsx";
+import type { DashboardError } from "../../contracts/errors.ts";
+
+/** Stored navigation hints may select only a still-declared guided target; normal submission validates it. */
+export function GuidedOAuthRecovery({
+  saved,
+  cause,
+}: {
+  readonly saved: typeof OAuthReturn.Type;
+  readonly cause: Cause.Cause<DashboardError>;
+}) {
+  const { app, guidance, waiting } = useCatalogConnectionMetadata(saved.app);
+  const navigate = useNavigate();
+  const [pending, setPending] = useState(false);
+  const target = saved.guided;
+  const requirement =
+    target === undefined ? undefined : app?.requirements.accounts[target.requirement];
+  const message = guidedOAuthFailure(cause);
+  if (message !== undefined && waiting)
+    return <Empty title="Connecting your account">Loading connection options…</Empty>;
+  if (
+    saved.reconnect ||
+    target === undefined ||
+    app === undefined ||
+    requirement === undefined ||
+    requirement.provider !== target.provider ||
+    requirement.scope !== target.scope ||
+    requirement.definition.auth[target.method]?.type !== "oauth2" ||
+    message === undefined ||
+    !guidance?.some(
+      (entry) =>
+        entry.requirement === target.requirement &&
+        entry.method === target.method &&
+        entry.signIn !== undefined,
+    )
+  )
+    return <Failure cause={cause} />;
+  const close = () => {
+    sessionStorage.removeItem("executor.oauth.return");
+    void navigate({ to: "/apps/$appId", params: { appId: app.id }, search: { view: "accounts" } });
+  };
+  return (
+    <Dialog
+      open
+      onOpenChange={(open) => {
+        if (!open && !pending) close();
+      }}
+    >
+      <DialogContent className="max-h-[85dvh] overflow-y-auto sm:max-w-[560px]">
+        <DialogTitle>Connect {requirement.definition.name}</DialogTitle>
+        <DialogDescription className="sr-only">
+          Retry sign-in or choose another connection method for {app.name}.
+        </DialogDescription>
+        {!pending && (
+          <p role="status" className="text-sm text-muted-foreground">
+            {message}
+          </p>
+        )}
+        <AppAccountForm
+          app={app.id}
+          version={app.activeVersion}
+          scope={target.scope}
+          requirement={target.requirement}
+          initialMethod={target.method}
+          provider={{ id: requirement.provider, definition: requirement.definition }}
+          checkWith={requirement.health === true}
+          onPendingChange={setPending}
+          onSaved={close}
+        />
+      </DialogContent>
+    </Dialog>
+  );
+}
