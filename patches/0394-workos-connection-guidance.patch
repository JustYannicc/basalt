+++ b/packages/ui/src/implementation/dashboard/credential-guidance.tsx
@@ -0,0 +1,42 @@
+import type { CredentialGuidance as Guidance } from "@executor-js/catalog/contracts";
+
+/** External setup stays beside the empty credential fields that need it. */
+export function CredentialGuidance({
+  guidance,
+  site,
+}: {
+  readonly guidance: Guidance;
+  readonly site?: string | undefined;
+}) {
+  const base = site === undefined ? null : URL.parse(site);
+  const relative =
+    guidance.link.url.startsWith("/") &&
+    !guidance.link.url.startsWith("//") &&
+    !guidance.link.url.includes("\\");
+  const url = relative
+    ? base?.protocol === "https:" && !base.username && !base.password
+      ? URL.parse(guidance.link.url, base.origin)
+      : null
+    : URL.parse(guidance.link.url);
+  return (
+    <div className="grid min-w-0 gap-3 text-[13px] leading-5 text-muted-foreground">
+      {url?.protocol === "https:" && !url.username && !url.password && (
+        <a
+          href={url.href}
+          target="_blank"
+          rel="noopener noreferrer"
+          className="w-fit rounded-sm font-medium text-foreground underline underline-offset-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring max-[740px]:inline-flex max-[740px]:min-h-11 max-[740px]:items-center"
+        >
+          {guidance.link.label}
+        </a>
+      )}
+      <ol className="list-decimal space-y-1.5 pl-5">
+        {guidance.steps.map((step, index) => (
+          <li key={index}>{step}</li>
+        ))}
+      </ol>
+      {guidance.expectedFormat && <p>{guidance.expectedFormat}</p>}
+      {guidance.note && <p>{guidance.note}</p>}
+    </div>
+  );
+}
