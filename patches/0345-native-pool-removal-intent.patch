diff --git a/apps/hosted/server/src/implementation/pool-removal-intent.ts b/apps/hosted/server/src/implementation/pool-removal-intent.ts
new file mode 100644
index 0000000..2e911b9
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-removal-intent.ts
@@ -0,0 +1,100 @@
+import { AppId, AccountAcquisitionHost, type AccountId, StorageError } from "@executor-js/sdk/core";
+import { Clock, Config, Context, Effect, Option, Redacted, Schema } from "effect";
+import { FetchHttpClient, HttpBody, HttpClient } from "effect/http";
+import { HostedExecutor } from "../contracts/executor.ts";
+import { CurrentUserId } from "../contracts/auth.ts";
+import { CurrentOrganization } from "../contracts/organization.ts";
+import { policyDatabase } from "./resource-policy.ts";
+import { nativePoolMembership } from "./pool-membership.ts";
+import { signEnvelope } from "./pool-token.ts";
+import { SqlClient } from "effect/sql";
+
+export const PoolRemovalBackend = Context.Reference<
+  { readonly key: Redacted.Redacted<string>; readonly origin: string } | undefined
+>("hosted/PoolRemovalBackend", { defaultValue: () => undefined });
+const Pools = Schema.Array(Schema.Struct({ pool: AppId }));
+
+/** Capture privately before unlink; invoke only after its authorized transaction commits. */
+export const preparePoolUnlinkIntent = (input: {
+  readonly app: AppId;
+  readonly account: AccountId;
+}) =>
+  Effect.gen(function* () {
+    const actor = yield* CurrentUserId;
+    if (actor === undefined) return Effect.void;
+    const { organization } = yield* CurrentOrganization;
+    const sql = yield* policyDatabase;
+    const person =
+      yield* sql`select id from member where "organizationId" = ${organization} and "userId" = ${actor}`;
+    if (person.length !== 1) return Effect.void;
+    const pools = yield* Schema.decodeUnknownEffect(Pools)(
+      yield* sql`
+      select app.id as pool from organization o
+      cross join lateral jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) entry
+      join executor_apps app on app.id = entry.value ->> 'app' and app.owner = 'organization:' || o.id
+      join hosted_app_account_links l on l.app = app.id and l.subject is null and l.account = ${input.account}
+      where o.id = ${organization} and app.id = ${input.app}
+        and entry.value ->> 'membership' = 'executor-links-v1'`,
+    );
+    if (!pools.length) return Effect.void;
+    const executor = yield* Effect.flatten(HostedExecutor);
+    const source = yield* executor[AccountAcquisitionHost].source({ account: input.account });
+    if (
+      source === undefined ||
+      source.hostReference === undefined ||
+      source.source.id !== "basalt-home"
+    )
+      return Effect.void;
+    const reference = Redacted.value(source.hostReference);
+    const matching: AppId[] = [];
+    for (const { pool } of pools) {
+      const membership = yield* nativePoolMembership(organization, pool, executor).pipe(
+        Effect.provideService(SqlClient.SqlClient, sql),
+      );
+      if (
+        membership.accounts.some(
+          (account) => account.account === input.account && account.homeReference === reference,
+        )
+      )
+        matching.push(pool);
+    }
+    if (!matching.length) return Effect.void;
+    const revision = source.binding.revision;
+    return Effect.gen(function* () {
+      const current = yield* source.current;
+      if (current === undefined || current.revision !== revision || current.removal !== null)
+        return;
+      const supplied = yield* PoolRemovalBackend;
+      const key =
+        supplied?.key ??
+        Option.getOrUndefined(yield* Config.Redacted("POOL_APP_SIGNING_KEY").pipe(Config.option));
+      const origin =
+        supplied?.origin ??
+        Option.getOrUndefined(yield* Config.String("BASALT_POOL_ORIGIN").pipe(Config.option));
+      if (key === undefined || origin === undefined) return yield* new StorageError();
+      const client = yield* HttpClient.HttpClient;
+      for (const pool of matching) {
+        const at = yield* Clock.currentTimeMillis;
+        const envelope = yield* Effect.tryPromise(() =>
+          signEnvelope(Redacted.value(key), "sbrm1", {
+            audience: "/pool/v1/account-removal-intents",
+            pool,
+            reference,
+            actor,
+            operation: crypto.randomUUID(),
+            at,
+            expiresAt: at + 30_000,
+          }),
+        );
+        const response = yield* client.post(
+          new URL("/pool/v1/account-removal-intents", origin).href,
+          { body: HttpBody.jsonUnsafe({ envelope }) },
+        );
+        if (response.status !== 204) return yield* new StorageError();
+      }
+    }).pipe(
+      Effect.timeout("10 seconds"),
+      Effect.provide(FetchHttpClient.layer),
+      Effect.catch(() => new StorageError()),
+    );
+  }).pipe(Effect.catch(() => new StorageError()));
