@@ -0,0 +1,31 @@
+import { Effect } from "effect";
+import { SqlClient } from "effect/sql";
+
+/** Additive leases survive Worker replacement without changing saved credentials or checks. */
+export const migrateAccountRechecks = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  yield* sql`create table if not exists hosted_account_rechecks (
+    account_id text primary key references executor_accounts(id) on delete cascade,
+    organization_id text not null references organization(id) on delete cascade,
+    provider_key text not null,
+    next_at timestamptz not null,
+    provider_next_at timestamptz not null,
+    lease text,
+    lease_until timestamptz,
+    run_id text not null,
+    started_at timestamptz not null,
+    finished_at timestamptz,
+    outcome text not null check (outcome in ('running', 'healthy', 'failed', 'skipped'))
+  )`;
+  // No account or organization foreign key: deleting either cannot reset a provider's rate limit.
+  yield* sql`create table if not exists hosted_account_recheck_families (
+    provider_key text primary key,
+    next_at timestamptz not null,
+    account_id text not null,
+    lease text not null
+  )`;
+  yield* sql`create index if not exists hosted_account_rechecks_provider
+    on hosted_account_rechecks(provider_key, started_at)`;
+  yield* sql`create index if not exists hosted_account_rechecks_organization
+    on hosted_account_rechecks(organization_id, started_at)`;
+});
diff --git a/apps/hosted/server/src/implementation/account-recheck-queue.ts b/apps/hosted/server/src/implementation/account-recheck-queue.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/server/src/implementation/account-recheck-queue.ts
@@ -0,0 +1,149 @@
+import { AccountId, AppId, OwnerId, StorageError } from "@executor-js/sdk/core";
+import { Effect, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import { OrganizationId } from "../contracts/organization.ts";
+
+export const recheckBatchSize = 4;
+const Candidate = Schema.Struct({
+  account: AccountId,
+  owner: OwnerId,
+  organization: OrganizationId,
+  provider: Schema.String,
+  app: Schema.NullOr(AppId),
+});
+export type RecheckCandidate = typeof Candidate.Type;
+
+/** A minute tick observes new deployments; unchanged successful or failed checks wait six hours. */
+export const makeAccountRecheckQueue = (sql: SqlClient.SqlClient) => {
+  const candidates = Effect.gen(function* () {
+    const rows = yield* sql`
+      with targets as (
+        select distinct a.id as account, a.owner, p.organization_id as organization,
+          coalesce(provider.definition::jsonb -> 'family' ->> 'id', a.provider) as provider,
+          app.id as app, c.checked_at
+        from executor_accounts a
+        join hosted_account_access p on p.account_id = a.id
+          and a.owner = 'organization:' || p.organization_id
+        join executor_providers provider on provider.id = a.provider
+        join hosted_app_account_links l on l.account = a.id
+        join executor_apps app on app.id = l.app and app.owner = a.owner
+        join executor_deployments d on d.id = app.active_deployment
+        left join executor_account_checks c on c.account = a.id and c.app = app.id
+        where not exists (select 1 from hosted_organization_removal removed
+            where removed.organization_id = p.organization_id)
+          and (p.kind <> 'personal' or exists (select 1 from member m
+            where m."organizationId" = p.organization_id and m."userId" = p.personal_user_id))
+          and (l.subject is null or exists (select 1 from member m
+            where m."organizationId" = p.organization_id and m."userId" = l.subject))
+          and d.requirements::jsonb -> 'accounts' -> l.requirement ->> 'provider' = a.provider
+          and (d.requirements::jsonb -> 'accounts' -> l.requirement ->> 'health' = 'true'
+            or d.requirements::jsonb -> 'accounts' -> l.requirement ->> 'interactiveHealth' = 'true')
+          and (c.account is null or c.deployment <> app.active_deployment
+            or c.credential_generation <> a.credential_generation
+            or c.checked_at <= now() - interval '6 hours')
+        union all
+        select a.id, a.owner, p.organization_id,
+          coalesce(provider.definition::jsonb -> 'family' ->> 'id', a.provider),
+          null::text, c.checked_at
+        from executor_accounts a
+        join hosted_account_access p on p.account_id = a.id
+          and a.owner = 'organization:' || p.organization_id
+        join executor_providers provider on provider.id = a.provider
+        join executor_account_acquisitions b on b.account = a.id and b.owner = a.owner
+          and b.provider = a.provider and b.method = a.method
+          and b.generation = a.credential_generation and b.removal is null
+        left join executor_account_driver_checks c on c.account = a.id
+        where (c.account is null or c.checkable or c.driver_revision <> b.driver_revision
+            or c.binding_revision <> b.revision)
+          and not exists (select 1 from hosted_organization_removal removed
+            where removed.organization_id = p.organization_id)
+          and (p.kind <> 'personal' or exists (select 1 from member m
+            where m."organizationId" = p.organization_id and m."userId" = p.personal_user_id))
+          and (c.account is null or c.driver_revision <> b.driver_revision
+            or c.binding_revision <> b.revision or c.generation <> a.credential_generation
+            or c.checked_at <= now() - interval '6 hours')
+      ), due as (
+        select distinct on (t.account) t.* from targets t
+        left join hosted_account_rechecks q on q.account_id = t.account
+        where (q.next_at is null or q.next_at <= now())
+          and (q.lease_until is null or q.lease_until <= now())
+          and not exists (select 1 from hosted_account_recheck_families family
+            where family.provider_key = t.provider and family.next_at > now())
+          and not exists (select 1 from hosted_account_rechecks recent
+            where recent.provider_key = t.provider
+              and (recent.provider_next_at > now() or recent.lease_until > now()))
+        order by t.account, t.checked_at nulls first, t.app nulls first limit 128
+      ), spaced as (
+        select due.*, row_number() over (partition by provider order by checked_at nulls first, account) as position
+        from due
+      ) select account, owner, organization, provider, app from spaced
+        where position = 1 order by checked_at nulls first, account limit ${recheckBatchSize}`;
+    return yield* Schema.decodeUnknownEffect(Schema.Array(Candidate))(rows);
+  });
+  // A transaction-scoped lock covers discovery and reservation, never a provider request.
+  const claim = (run: string) =>
+    sql
+      .withTransaction(
+        Effect.gen(function* () {
+          const [lock] =
+            yield* sql`select pg_try_advisory_xact_lock(hashtext('basalt:account-rechecks')) as acquired`;
+          if (lock?.acquired !== true) return [];
+          const due = yield* candidates;
+          for (const entry of due)
+            yield* sql`insert into hosted_account_rechecks
+      (account_id, organization_id, provider_key, next_at, provider_next_at, lease, lease_until, run_id, started_at, finished_at, outcome)
+      values (${entry.account}, ${entry.organization}, ${entry.provider}, now() + interval '5 minutes', now() + interval '1 minute',
+        ${run}, now() + interval '5 minutes', ${run}, now(), null, 'running')
+      on conflict (account_id) do update set organization_id = excluded.organization_id, provider_key = excluded.provider_key,
+        next_at = excluded.next_at, provider_next_at = excluded.provider_next_at, lease = excluded.lease, lease_until = excluded.lease_until,
+        run_id = excluded.run_id, started_at = excluded.started_at, finished_at = null, outcome = 'running'`;
+          return due;
+        }),
+      )
+      .pipe(Effect.mapError(() => new StorageError()));
+  // The 55-second attempt ceiling plus 15 minutes remains reserved if completion is lost.
+  const start = (target: RecheckCandidate, lease: string) =>
+    sql
+      .withTransaction(
+        Effect.gen(function* () {
+          const held = yield* sql`select account_id from hosted_account_rechecks
+        where account_id = ${target.account} and lease = ${lease} and lease_until > now() for update`;
+          if (held.length !== 1) return false;
+          const reserved =
+            yield* sql`insert into hosted_account_recheck_families (provider_key, next_at, account_id, lease)
+        values (${target.provider}, now() + interval '16 minutes', ${target.account}, ${lease})
+        on conflict (provider_key) do update set next_at = excluded.next_at,
+          account_id = excluded.account_id, lease = excluded.lease
+        where hosted_account_recheck_families.next_at <= now()
+        returning provider_key`;
+          return reserved.length === 1;
+        }),
+      )
+      .pipe(Effect.mapError(() => new StorageError()));
+  const finish = (
+    account: AccountId,
+    lease: string,
+    outcome: "healthy" | "failed" | "skipped",
+    retry: boolean,
+    cooldown = false,
+  ) =>
+    sql
+      .withTransaction(
+        Effect.gen(function* () {
+          const completed =
+            yield* sql`update hosted_account_rechecks set lease = null, lease_until = null, finished_at = now(),
+        next_at = now() + ${retry ? 15 * 60 : 60} * interval '1 second',
+        provider_next_at = now() + ${cooldown ? 15 * 60 : 60} * interval '1 second', outcome = ${outcome}
+        where account_id = ${account} and lease = ${lease} returning provider_key`;
+          for (const row of completed)
+            yield* sql`insert into hosted_account_recheck_families (provider_key, next_at, account_id, lease)
+          values (${row.provider_key}, now() + ${cooldown ? 15 * 60 : 60} * interval '1 second', ${account}, ${lease})
+          on conflict (provider_key) do update set next_at = excluded.next_at,
+            account_id = excluded.account_id, lease = excluded.lease
+          where hosted_account_recheck_families.next_at <= now()
+            or (hosted_account_recheck_families.account_id = ${account} and hosted_account_recheck_families.lease = ${lease})`;
+        }),
+      )
+      .pipe(Effect.mapError(() => new StorageError()));
+  return { claim, start, finish };
+};
diff --git a/apps/hosted/server/src/implementation/account-rechecks.ts b/apps/hosted/server/src/implementation/account-rechecks.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/server/src/implementation/account-rechecks.ts
@@ -0,0 +1,159 @@
+import { AutomaticAccountCheck, automaticCheckAccounts } from "./account-recheck-authority.ts";
+import { CurrentUserId } from "../contracts/auth.ts";
+import { StorageError, type Executor } from "@executor-js/sdk/core";
+import { Clock, Crypto, Effect, Result, Schema } from "effect";
+import type { SqlClient } from "effect/sql";
+import { HostedExecutor } from "../contracts/executor.ts";
+import { GroupDatabase } from "../contracts/groups.ts";
+import { OrganizationForbidden } from "../contracts/organization.ts";
+import { currentResourceAuthority, policyDatabase } from "./resource-policy.ts";
+import { appLinkedAccounts, linkedAccounts } from "./app-accounts.ts";
+import { makeAccountRecheckQueue, type RecheckCandidate } from "./account-recheck-queue.ts";
+import { AccountRecheckRun } from "../contracts/account-rechecks.ts";
+
+const Subject = Schema.Struct({ subject: Schema.NullOr(Schema.String) });
+
+/** Re-read links after claiming: a removed link never becomes background account use. */
+const stillLinked = (sql: SqlClient.SqlClient, target: RecheckCandidate) =>
+  Effect.gen(function* () {
+    if (target.app === null) return null;
+    const app = target.app;
+    if ((yield* appLinkedAccounts(sql, [app])).some((link) => link.id === target.account))
+      return null;
+    const rows = yield* sql`select distinct l.subject from hosted_app_account_links l
+      join member m on m."userId" = l.subject and m."organizationId" = ${target.organization}
+      join hosted_app_access p on p.id = l.app and p.organization_id = m."organizationId"
+      where l.app = ${app} and l.account = ${target.account} and
+        (p.audience = 'everyone' or (p.audience = 'private' and p.creator_id = l.subject)
+          or (p.audience = 'groups' and exists (
+            select 1 from hosted_app_groups g join hosted_group_members gm on gm.group_id = g.group_id
+            where g.app_id = p.id and gm.member_id = m.id)))
+      order by l.subject limit 16`;
+    const subjects = yield* Schema.decodeUnknownEffect(Schema.Array(Subject))(rows);
+    for (const { subject } of subjects) {
+      if (
+        subject !== null &&
+        (yield* linkedAccounts(sql, { subject, apps: [app] })).some(
+          (link) => link.id === target.account,
+        )
+      )
+        return subject;
+    }
+    return undefined;
+  });
+
+type RecheckExecutor = { readonly accounts: Pick<Executor["accounts"], "health" | "check"> };
+
+const runOne = (
+  sql: SqlClient.SqlClient,
+  executor: RecheckExecutor,
+  target: RecheckCandidate,
+  lease: string,
+) =>
+  Effect.gen(function* () {
+    const subject = yield* stillLinked(sql, target);
+    if (subject === undefined) return { outcome: "skipped" as const, retry: true, cooldown: false };
+    return yield* Effect.gen(function* () {
+      const apps = target.app === null ? [] : [target.app];
+      const before = yield* executor.accounts.health({
+        owner: target.owner,
+        account: target.account,
+        apps,
+      });
+      const check = target.app === null ? before.driver?.check : before.apps[0]?.check;
+      const now = yield* Clock.currentTimeMillis;
+      if (check?.current === true && check.checkedAt.getTime() > now - 6 * 60 * 60_000)
+        return { outcome: "skipped" as const, retry: false, cooldown: false };
+      if (target.app === null && before.driver?.checkable !== true)
+        return { outcome: "skipped" as const, retry: true, cooldown: false };
+      const authorized = yield* automaticCheckAccounts(sql, [
+        { id: target.account, owner: target.owner },
+      ]);
+      if (
+        !authorized.has(target.account) ||
+        !(yield* makeAccountRecheckQueue(sql).start(target, lease))
+      )
+        return { outcome: "skipped" as const, retry: true, cooldown: false };
+      // The explicit SDK path owns diagnostics and persistence, including phase/tag/vendor reason.
+      const health = yield* executor.accounts.check({
+        owner: target.owner,
+        account: target.account,
+        apps,
+      });
+      const after = target.app === null ? health.driver?.check : health.apps[0]?.check;
+      const rateLimited = [health.driver?.check, ...health.apps.map((app) => app.check)].some(
+        (result) => result?.reason === "rate_limited",
+      );
+      return {
+        outcome:
+          after?.status === "healthy" && !rateLimited ? ("healthy" as const) : ("failed" as const),
+        retry: after === null || after === undefined || !after.current || rateLimited,
+        cooldown: rateLimited,
+      };
+    }).pipe(Effect.provideService(CurrentUserId, subject ?? undefined));
+  });
+
+/** Claims at most four accounts, one per provider family. Each attempt has a 55-second ceiling. */
+export const makeAccountRechecks =
+  (sql: SqlClient.SqlClient, executor: RecheckExecutor) => (run: string) =>
+    Effect.gen(function* () {
+      const queue = makeAccountRecheckQueue(sql);
+      const targets = yield* queue.claim(run);
+      yield* Effect.forEach(
+        targets,
+        (target) =>
+          Effect.gen(function* () {
+            const result = yield* runOne(sql, executor, target, run).pipe(
+              Effect.provideService(AutomaticAccountCheck, { ...target, lease: run }),
+              Effect.timeout(55_000),
+              Effect.result,
+            );
+            const outcome = Result.isSuccess(result)
+              ? result.success
+              : { outcome: "failed" as const, retry: true, cooldown: true };
+            yield* queue.finish(
+              target.account,
+              run,
+              outcome.outcome,
+              outcome.retry,
+              outcome.cooldown,
+            );
+            yield* Effect.logInfo("Automatic account health recheck finished", {
+              outcome: outcome.outcome,
+            });
+          }),
+        { concurrency: 2, discard: true },
+      );
+    }).pipe(Effect.mapError(() => new StorageError()));
+
+export const runAccountRechecks = Effect.gen(function* () {
+  const sql = yield* Effect.flatten(GroupDatabase);
+  const executor = yield* Effect.flatten(HostedExecutor);
+  const crypto = yield* Crypto.Crypto;
+  const run = yield* crypto.randomUUIDv4.pipe(Effect.mapError(() => new StorageError()));
+  yield* makeAccountRechecks(sql, executor)(run);
