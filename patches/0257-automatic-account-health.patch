@@ -0,0 +1,60 @@
+import { Context, Effect } from "effect";
+import type { Account } from "@executor-js/sdk/core";
+import type { SqlClient } from "effect/sql";
+import type { RecheckCandidate } from "./account-recheck-queue.ts";
+import { CurrentUserId } from "../contracts/auth.ts";
+import { linkedAccounts } from "./app-accounts.ts";
+import { usableAppLinks } from "./app-link-policy.ts";
+
+/** Only the claimed check receives this capability; normal requests still require their actor. */
+export const AutomaticAccountCheck = Context.Reference<
+  (RecheckCandidate & { readonly lease: string }) | undefined
+>("hosted/AutomaticAccountCheck", { defaultValue: () => undefined });
+
+export const automaticCheckAccounts = (
+  sql: SqlClient.SqlClient,
+  accounts: readonly Pick<Account, "id" | "owner">[],
+) =>
+  Effect.gen(function* () {
+    const target = yield* AutomaticAccountCheck;
+    if (
+      target === undefined ||
+      accounts.length !== 1 ||
+      accounts[0]?.id !== target.account ||
+      accounts[0]?.owner !== target.owner
+    )
+      return new Set<Account["id"]>();
+    const held = yield* sql`select q.account_id from hosted_account_rechecks q
+      join hosted_account_access p on p.account_id = q.account_id and p.organization_id = q.organization_id
+      join executor_accounts a on a.id = q.account_id and a.owner = ${target.owner}
+      where q.account_id = ${target.account} and q.lease = ${target.lease} and q.lease_until > now()
+        and q.organization_id = ${target.organization}
+        and not exists (select 1 from hosted_organization_removal removed where removed.organization_id = q.organization_id)
+        and (p.kind <> 'personal' or exists (select 1 from member m
+          where m."organizationId" = p.organization_id and m."userId" = p.personal_user_id))`;
+    if (held.length !== 1) return new Set<Account["id"]>();
+    if (target.app !== null) {
+      const subject = yield* CurrentUserId;
+      if (subject === undefined) {
+        const linked = yield* sql`select a.id from ${yield* usableAppLinks(sql, [target.app])}
+          and a.id = ${target.account} limit 1`;
+        if (linked.length !== 1) return new Set<Account["id"]>();
+      } else {
+        const permitted = yield* sql`select p.id from hosted_app_access p
+          join member m on m."organizationId" = p.organization_id and m."userId" = ${subject}
+          where p.id = ${target.app} and p.organization_id = ${target.organization}
+            and (p.audience = 'everyone' or (p.audience = 'private' and p.creator_id = ${subject})
+              or (p.audience = 'groups' and exists (
+                select 1 from hosted_app_groups g join hosted_group_members gm on gm.group_id = g.group_id
+                where g.app_id = p.id and gm.member_id = m.id)))`;
+        if (
+          permitted.length !== 1 ||
+          !(yield* linkedAccounts(sql, { subject, apps: [target.app] })).some(
+            (link) => link.id === target.account,
+          )
+        )
+          return new Set<Account["id"]>();
+      }
+    }
+    return new Set([target.account]);
+  });
