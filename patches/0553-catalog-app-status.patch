diff --git a/apps/hosted/web/src/implementation/pages/catalog-app-status.tsx b/apps/hosted/web/src/implementation/pages/catalog-app-status.tsx
new file mode 100644
--- /dev/null
+++ b/apps/hosted/web/src/implementation/pages/catalog-app-status.tsx
@@ -0,0 +1,66 @@
+import { useAtomValue } from "@effect/atom-react";
+import { Link } from "@tanstack/react-router";
+import { AsyncResult } from "effect/reactivity";
+import type { App } from "@executor-js/sdk";
+import { LocalTime, shortMoment } from "@executor-js/ui/components/local-time";
+import { Skeleton } from "@executor-js/ui/components/skeleton";
+import { independentCopyNote } from "@executor-js/ui/dashboard/app-settings";
+import { catalogStatusAtom } from "../../contracts/apps.ts";
+import { useOrganizationRoute } from "../components/organization.tsx";
+
+/**
+ * How a copy relates to its original in Settings. Catalog installs follow the catalog by
+ * themselves until someone changes them, so they say where they stand instead.
+ */
+export function CatalogAppNote({ app }: { readonly app: App }) {
+  const { organization, slug } = useOrganizationRoute();
+  const status = useAtomValue(catalogStatusAtom({ organization, app: app.id }));
+  if (AsyncResult.isInitial(status))
+    return (
+      <div role="status" aria-label="Loading update status" className="py-1">
+        <Skeleton className="h-3 w-72 max-w-full" />
+      </div>
+    );
+  // A copy of anything else, or a status that failed to load, makes no claim about updates.
+  if (!AsyncResult.isSuccess(status) || status.value === null) return independentCopyNote;
+  const { state, nextCheckAt, checking } = status.value;
+  const versions = (
+    <Link
+      to="/org/$organizationSlug/apps/$appId"
+      params={{ organizationSlug: slug, appId: app.id }}
+      search={{ view: "versions" }}
+      className="font-medium text-foreground underline-offset-4 hover:underline"
+    >
+      Versions
+    </Link>
+  );
+  const due = nextCheckAt === null ? null : <LocalTime value={nextCheckAt} options={shortMoment} />;
+  if (state === "current")
+    return (
+      <p>
+        {checking ? (
+          "Checking the catalog for an update now. An update found applies by itself."
+        ) : due === null ? (
+          "On the catalog’s current version. Catalog updates apply by themselves while nobody changes this app."
+        ) : (
+          <>Catalog update check due {due}. An update found then applies by itself.</>
+        )}
+      </p>
+    );
+  return (
+    <p>
+      {state === "offered" ? (
+        <>
+          A catalog update is waiting for review in {versions}. It didn’t apply by itself because it
+          changes this app’s accounts or replaces changes made here.
+        </>
+      ) : (
+        <>
+          This app was changed after it came from the catalog, so catalog updates wait for review in{" "}
+          {versions} instead of applying by themselves.
+        </>
+      )}
+      {checking ? " Checking the catalog now." : due !== null && <> Next catalog check {due}.</>}
+    </p>
+  );
+}
