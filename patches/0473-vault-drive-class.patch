--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/vault-drive.ts
@@ -0,0 +1,14 @@
+/** Bind a vault's drive object without importing its implementation. */
+import * as Cloudflare from "alchemy/Cloudflare";
+
+/** Calls the vault backend makes on one vault's object. None exist until that backend ships. */
+export interface VaultDriveApi {}
+
+/**
+ * One SQLite object per vault serializes its writes and holds its receipts and caches. Its text
+ * and history live in the vault's Artifacts repository. The class ships first, with no methods
+ * or bindings, so its storage exists before any feature code depends on it.
+ */
+export class VaultDrive extends Cloudflare.DurableObject<VaultDrive, VaultDriveApi>()(
+  "VaultDrive",
+) {}
