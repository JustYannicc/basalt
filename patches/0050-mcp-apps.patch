+/** Native MCP registrations preserve host-only metadata outside model-visible structured content. */
+import {
+  AppViewUnavailable,
+  AppViewId,
+  Json,
+  ElicitationFailed,
+  type ToolInvocationOptions,
+} from "@executor-js/sdk/core";
+import { Clock, Context, Effect, Layer, Option, Schema } from "effect";
+import { McpSchema, McpServer } from "effect/ai";
+import type { McpBackend } from "../contracts/backend.ts";
+import type { McpAppViewsBackend } from "../contracts/app-views.ts";
+import { appBridgeResource, decodeAppResource } from "../contracts/app-bridge.ts";
+import { appBridgeHtml } from "./app-sandbox.ts";
+import { diagnosticSummary } from "./diagnostics.ts";
+import { currentMcpAppProfile } from "./app-capability.ts";
+const viewError = (error: unknown, action = false) => {
+  const reason = Schema.is(AppViewUnavailable)(error)
+    ? error.reason
+    : error instanceof ElicitationFailed && error.reason === "forbidden"
+      ? "denied"
+      : action
+        ? "action-failed"
+        : "unavailable";
+  const text =
+    action && error instanceof Error && reason === "action-failed"
+      ? diagnosticSummary(error)
+      : reason === "expired"
+        ? "This app view has expired. The original text result remains available."
+        : reason === "denied"
+          ? "Access to this app view was removed. The original text result remains available."
+          : "This app view is unavailable. The original text result remains available.";
+  return new McpSchema.CallToolResult({
+    isError: true,
+    content: [{ type: "text", text }],
+    _meta: { "executor/app-state": reason },
+  });
+};
+
+const View = Schema.Struct({ view: AppViewId });
+const Authority = { ...View.fields, capability: Schema.String.check(Schema.isMaxLength(256)) };
+const Callback = Schema.Struct({ ...Authority, name: Schema.String, input: Json });
+const Resource = Schema.Struct({ ...Authority, uri: Schema.String });
+const mcpError = () =>
+  new McpSchema.InternalError({
+    message:
+      "This app view is unavailable. It may have expired or access may have changed. The original text result remains available.",
+  });
+const parse = <S extends Schema.Top>(schema: S, value: unknown) =>
+  Schema.decodeUnknownEffect(schema)(value).pipe(Effect.mapError(mcpError));
+
+const callback = (backend: McpAppViewsBackend<Error>, input: typeof Callback.Type) =>
+  Effect.gen(function* () {
+    const client = yield* Effect.serviceOption(McpSchema.McpServerClient);
+    const { clientCapabilities } = yield* McpSchema.McpRequestContext;
+    const capability = clientCapabilities.elicitation;
+    const native =
+      Option.isSome(client) &&
+      capability !== undefined &&
+      (capability.form !== undefined || capability.url === undefined)
+        ? yield* client.value.getClient
+        : undefined;
+    const options: ToolInvocationOptions = {
+      elicitation: (prompt, signal) =>
+        Effect.gen(function* () {
+          if (native === undefined || signal.aborted)
+            return yield* new ElicitationFailed({ reason: "unavailable" });
+          const decoded = yield* Schema.decodeUnknownEffect(McpSchema.ElicitRequestFormParams)(
+            prompt,
+          ).pipe(Effect.mapError(() => new ElicitationFailed({ reason: "invalid-request" })));
+          return yield* native.elicit(decoded).pipe(
+            Effect.mapError(() => new ElicitationFailed({ reason: "transport" })),
+            Effect.timeoutOrElse({
+              duration: "15 minutes",
+              orElse: () => Effect.fail(new ElicitationFailed({ reason: "expired" })),
+            }),
+            Effect.raceFirst(
+              Effect.callback<never>((resume) => {
+                const abort = () => resume(Effect.interrupt);
+                signal.addEventListener("abort", abort, { once: true });
+                if (signal.aborted) abort();
+                return Effect.sync(() => signal.removeEventListener("abort", abort));
+              }),
+            ),
+          );
+        }),
+    };
+    const result = yield* backend.call(
+      input.view,
+      input.capability,
+      input.name,
+      input.input,
+      options,
+    );
+    if (result.status === "completed") return yield* parse(McpSchema.CallToolResult, result.value);
+    // Keep the continuation private and cancel it if no native prompt can complete this request.
+    let consumed = false;
+    return yield* Effect.gen(function* () {
+      if (native === undefined) return yield* mcpError();
+      const remaining = result.expiresAt - (yield* Clock.currentTimeMillis);
+      if (remaining <= 0) return yield* mcpError();
+      const prompt = yield* parse(McpSchema.ElicitRequestFormParams, result.elicitation);
+      const response = yield* native
+        .elicit(prompt)
+        .pipe(Effect.timeoutOrElse({ duration: remaining, orElse: () => Effect.fail(mcpError()) }));
+      const resumed = yield* backend.resume(
+        input.view,
+        input.capability,
+        input.name,
+        input.input,
+        result,
+        response,
+        options,
+      );
+      consumed = true;
+      if (resumed.status !== "completed") return yield* mcpError();
+      return yield* parse(McpSchema.CallToolResult, resumed.value);
+    }).pipe(
+      Effect.ensuring(
+        Effect.suspend(() =>
+          consumed
+            ? Effect.void
+            : backend
+                .resume(
+                  input.view,
+                  input.capability,
+                  input.name,
+                  input.input,
+                  result,
+                  { action: "cancel" },
+                  options,
+                )
+                .pipe(Effect.ignore),
+        ),
+      ),
+    );
+  });
+
