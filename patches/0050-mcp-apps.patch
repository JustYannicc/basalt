+import { McpAppUiProfile } from "apps/contracts";
+import { Effect, Option, Schema } from "effect";
+import { McpSchema } from "effect/ai";
+
+/** Capability comes from the current MCP revision's request context, including restored sessions. */
+export const currentMcpAppProfile = Effect.gen(function* () {
+  const request = yield* Effect.serviceOption(McpSchema.McpRequestContext);
+  if (Option.isNone(request)) return false;
+  const capability = request.value.clientCapabilities.extensions?.["io.modelcontextprotocol/ui"];
+  return (
+    Schema.is(Schema.Struct({ mimeTypes: Schema.Array(Schema.String) }))(capability) &&
+    capability.mimeTypes.includes("text/html;profile=mcp-app")
+  );
+});
+
+export const availableMcpAppProfile = (
+  backend: Pick<import("../contracts/backend.ts").McpBackend<Error>, "appViews">,
+) =>
+  currentMcpAppProfile.pipe(
+    Effect.flatMap((supported) =>
+      !supported || backend.appViews === undefined
+        ? Effect.succeed(false)
+        : backend.appViews.rendererPolicy.pipe(
+            Effect.map((policy) => policy.frameDomains.length > 0),
+            Effect.catch(() => Effect.succeed(false)),
+          ),
+    ),
+  );
+
+export const withMcpAppProfile =
+  (backend: Pick<import("../contracts/backend.ts").McpBackend<Error>, "appViews">) =>
+  <A, E, R>(work: Effect.Effect<A, E, R>) =>
+    work.pipe(Effect.provideServiceEffect(McpAppUiProfile, availableMcpAppProfile(backend)));
