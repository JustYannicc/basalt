+/** Views are separate from program values, and only the host metadata carries callback authority. */
+import {
+  AppViewReference,
+  type AppViewId,
+  type ObservedAppView,
+  type ToolCallResult,
+  type ToolPending,
+  type ToolResumeResult,
+  type ToolInvocationOptions,
+  type Json,
+} from "@executor-js/sdk/core";
+import type { McpAppResources } from "apps/contracts";
+import { Schema, type Effect } from "effect";
+
+export const McpAppViewReference = Schema.Struct({
+  ...AppViewReference.fields,
+  callIndex: Schema.Int,
+  path: Schema.String,
+});
+export type McpAppViewReference = typeof McpAppViewReference.Type;
+export const McpAppViewFailure = Schema.Struct({
+  callIndex: Schema.Int,
+  path: Schema.String,
+  reason: Schema.String,
+});
+export type McpAppViewFailure = typeof McpAppViewFailure.Type;
+
+export interface McpAppViewsBackend<E extends Error> {
+  readonly rendererPolicy: Effect.Effect<{ readonly frameDomains: readonly string[] }, E | Error>;
+  readonly retainObserved: (
+    observed: ObservedAppView,
+  ) => Effect.Effect<typeof AppViewReference.Type, E | Error>;
+  readonly show: (id: AppViewId) => Effect.Effect<
+    {
+      readonly observed: ObservedAppView;
+      readonly capability: string;
+      readonly resource: McpAppResources;
+      readonly payload: import("./app-bridge.ts").AppBridgePayload;
+    },
+    E | Error
+  >;
+  readonly resource: (
+    id: AppViewId,
+    capability: string,
+    uri: string,
+  ) => Effect.Effect<McpAppResources, E | Error>;
+  readonly call: (
+    id: AppViewId,
+    capability: string,
+    name: string,
+    input: Json,
+    options?: ToolInvocationOptions,
+  ) => Effect.Effect<ToolCallResult, E | Error>;
+  readonly resume: (
+    id: AppViewId,
+    capability: string,
+    name: string,
+    input: Json,
+    pending: typeof ToolPending.Type,
+    response: { readonly action: "accept" | "decline" | "cancel" },
+    options?: ToolInvocationOptions,
+  ) => Effect.Effect<ToolResumeResult, E | Error>;
+}
