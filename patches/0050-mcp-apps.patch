+/** The source binding survives remote MCP adaptation, aliases and account composition. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { randomUUID } from "node:crypto";
+import { scenarios } from "../test-plan.ts";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { App, Resource } from "../support/contracts.ts";
+import { McpClient } from "../support/mcp-client.ts";
+import { connectionsPath, unlinkAccount } from "../support/app-accounts.ts";
+import { mcpAppUpstream, remoteMcpAppFiles } from "../support/mcp-app-upstream.ts";
+
+const Captured = Schema.Struct({
+  views: Schema.Array(Schema.Struct({ id: Schema.String, callIndex: Schema.Number })),
+});
+const Payload = Schema.Struct({
+  "executor/app-view": Schema.Struct({
+    view: Schema.String,
+    capability: Schema.String,
+    resourceBase: Schema.String,
+    html: Schema.String,
+    input: Schema.Struct({ text: Schema.String }),
+    policy: Schema.Struct({ csp: Schema.Struct({ resourceDomains: Schema.Array(Schema.String) }) }),
+  }),
+});
+layer(HostedLive, { excludeTestServices: true })("Remote MCP Apps sources", (it) => {
+  it.effect(scenarios.mcpAppsSource.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          mcp = yield* McpClient;
+        const upstream = yield* mcpAppUpstream;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const key = yield* body(
+          Schema.Struct({ id: Schema.String, key: Schema.RedactedFromValue(Schema.String) }),
+          yield* api.request(actors.owner, "POST", "/api/auth/api-key/create", {
+            name: "MCP Apps sources",
+          }),
+        );
+        yield* Effect.addFinalizer(() =>
+          api
+            .request(actors.owner, "POST", "/api/auth/api-key/delete", { keyId: key.id })
+            .pipe(Effect.orDie),
+        );
+        const response = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: `App source ${randomUUID().slice(0, 8)}`,
+          files: remoteMcpAppFiles(upstream.url),
+        });
+        expect(response.status, JSON.stringify(response.body)).toBe(200);
+        const app = yield* body(App, response),
+          path = `${prefix}/apps/${app.id}`;
+        yield* Effect.addFinalizer(() =>
+          api.request(actors.owner, "DELETE", path).pipe(Effect.orDie),
+        );
+        const connect = (variant: string) =>
+          Effect.gen(function* () {
+            const connection = yield* body(
+              Resource,
+              yield* api.request(
+                actors.owner,
+                "POST",
+                connectionsPath(path, "user", "service"),
+                {},
+              ),
+            );
+            const account = yield* body(
+              Resource,
+              yield* api.request(
+                actors.owner,
+                "POST",
+                `${prefix}/connections/${connection.id}/submit`,
+                {
+                  method: "key",
+                  label: variant,
+                  fields: { variant, endpoint: upstream.url, token: randomUUID() },
+                },
+              ),
+            );
+            yield* Effect.addFinalizer(() =>
+              api
+                .request(actors.owner, "DELETE", `${prefix}/accounts/${account.id}`)
+                .pipe(Effect.orDie),
+            );
+            return account.id;
+          });
+        const alpha = yield* connect("Alpha"),
+          beta = yield* connect("Beta");
+        const client = yield* mcp.connect(key.key, "source-bound", {
+          organization: actors.organization.id,
+          ui: true,
+        });
+        const call = (name: string, input: Record<string, unknown>) =>
+          client.use(name, (client, signal) =>
+            client.callTool({ name, arguments: input }, undefined, { signal }),
+          );
+        const tool = `tools[${JSON.stringify(app.slug)}].remote.open`;
+        const called = yield* call("call", {
