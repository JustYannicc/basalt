+++ b/e2e/support/mcp-app-fixture.ts
@@ -0,0 +1,47 @@
+import { appsManifest } from "./apps-release.ts";
+
+/** Two sources deliberately reuse the URI and callback name. Their markup and native results differ. */
+export const mcpAppFiles = [
+  {
+    path: "index.ts",
+    content: `
+import { defineApp, router, query, mutation, object, string } from "apps";
+import { always } from "apps/operations/approval";
+const ui = { ui: { resourceUri: "ui://fixture/view.html" } };
+const appOnly = { ui: { visibility: ["app"] } };
+const result = (source, text) => ({ content: [{ type: "text", text }], structuredContent: { source, text }, _meta: { original: source } });
+const source = (name) => router({
+  open: query({ input: object({ text: string() }), _meta: ui }, async (_ctx, { text }) => result(name, text)),
+  approved: mutation({ input: object({ text: string() }), _meta: ui, approval: always() }, async (_ctx, { text }) => result(name, text)),
+  edit: mutation({ input: object({ text: string() }), _meta: appOnly, approval: always() }, async (_ctx, { text }) => result(name, text)),
+  large: query({ input: object({}), _meta: ui }, async () => result(name, "x".repeat(1024 * 1024))),
+  question: query({ input: object({}), _meta: appOnly }, async (ctx) => { const response = await ctx.elicit({ mode: "form", message: "Keep this app binding?", requestedSchema: { type: "object", properties: {} } }); return result(name, response.action); }),
+  reject: query({ input: object({}), _meta: appOnly }, async () => ({ content: [{ type: "text", text: "Native app error" }], isError: true })),
+  modelOnly: query({ input: object({}), _meta: { ui: { visibility: ["model"] } } }, async () => result(name, "model only")),
+}, { mcpResources: async (uri) => {
+  if (uri !== "ui://fixture/view.html" && uri !== "fixture://note") throw new Error("Unknown resource");
+  return { contents: [{ uri, mimeType: uri.startsWith("ui:") ? "text/html;profile=mcp-app" : "text/plain",
+    text: uri.startsWith("ui:") ? "<!doctype html><html><head><title>" + name + " native view</title></head><body><p>" + name + " native view</p></body></html>" : name + " source note",
+    _meta: { ui: { csp: { connectDomains: [], resourceDomains: [] } } },
+  }] };
+} });
+export default defineApp({}, { tools: router({
+  alpha: source("Alpha"), beta: source("Beta"),
+  fake: query({ input: object({}) }, async () => ({ content: [{ type: "text", text: "fake" }], _meta: ui })),
+}) });`,
+  },
+  appsManifest,
+];
+
+export const mcpAppUiFiles = (html: string) =>
+  mcpAppFiles.map((file) =>
+    file.path !== "index.ts"
+      ? file
+      : {
+          ...file,
+          content: file.content.replace(
+            '"<!doctype html><html><head><title>" + name + " native view</title></head><body><p>" + name + " native view</p></body></html>"',
+            JSON.stringify(html),
+          ),
+        },
+  );
diff --git a/e2e/support/mcp-app-host.ts b/e2e/support/mcp-app-host.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/mcp-app-host.ts
@@ -0,0 +1,99 @@
+/** A protocol peer loads the product's packaged renderer and forwards its native tool requests. */
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Effect, Layer, Schema } from "effect";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { createServer } from "node:http";
+
+const Request = Schema.Struct({
+  name: Schema.String,
+  arguments: Schema.Record(Schema.String, Schema.Unknown),
+});
+export const mcpAppHost = <E>(
+  html: string,
+  view: string,
+  result: unknown,
+  call: (name: string, input: Record<string, unknown>) => Effect.Effect<unknown, E>,
+  read: (uri: string) => Effect.Effect<unknown, E>,
+) =>
+  Effect.gen(function* () {
+    const data = JSON.stringify({ view, result }).replaceAll("<", "\\u003c");
+    const host = `<!doctype html><html><head><title>MCP Apps protocol peer</title></head><body><iframe title="Executor view" src="/renderer" style="width:100%;height:800px;border:0"></iframe><script>
+const data = ${data};
+const frame = document.querySelector("iframe");
+const send = (message) => frame.contentWindow.postMessage({ jsonrpc: "2.0", ...message }, location.origin);
+window.addEventListener("message", async (event) => {
+ if (event.source !== frame.contentWindow || event.origin !== location.origin) return;
+ const request = event.data;
+ if (request.method === "ui/initialize") send({ id: request.id, result: {
+  protocolVersion: "2026-01-26", hostInfo: { name: "E2E protocol peer", version: "1" },
+  hostCapabilities: { serverTools: {}, serverResources: {}, openLinks: {}, updateModelContext: { text: {} } },
+  hostContext: { theme: "light", displayMode: "inline", availableDisplayModes: ["inline", "fullscreen"], platform: "web", containerDimensions: { maxHeight: 6000 } },
+ } });
+ else if (request.method === "ui/notifications/initialized") {
+  send({ method: "ui/notifications/tool-input", params: { arguments: { view: data.view } } });
+  send({ method: "ui/notifications/tool-result", params: data.result });
+ } else if (request.method === "tools/call") {
+  const response = await fetch("/call", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(request.params) });
+  send({ id: request.id, result: await response.json() });
+ } else if (request.method === "resources/read") {
+  const response = await fetch("/resource", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(request.params) });
+  send({ id: request.id, result: await response.json() });
+ } else if (request.method === "ui/request-display-mode") send({ id: request.id, result: { mode: request.params.mode } });
+ else if (request.id !== undefined) send({ id: request.id, result: {} });
+});
+</script></body></html>`;
+    const routes = Layer.mergeAll(
+      HttpRouter.add("GET", "/", HttpServerResponse.html(host)),
+      HttpRouter.add("GET", "/renderer", HttpServerResponse.html(html)),
+      HttpRouter.add(
+        "POST",
+        "/resource",
+        Effect.gen(function* () {
+          const request = yield* HttpServerRequest.HttpServerRequest;
+          const input = yield* Schema.decodeUnknownEffect(Schema.Struct({ uri: Schema.String }))(
+            yield* request.json,
+          );
+          return HttpServerResponse.jsonUnsafe(yield* read(input.uri));
+        }),
+      ),
+      HttpRouter.add(
+        "POST",
+        "/call",
+        Effect.gen(function* () {
+          const request = yield* HttpServerRequest.HttpServerRequest;
+          const input = yield* Schema.decodeUnknownEffect(Request)(yield* request.json);
+          return HttpServerResponse.jsonUnsafe(yield* call(input.name, input.arguments));
+        }),
+      ),
+    );
+    const services = yield* Layer.build(
+      HttpRouter.serve(routes, { disableLogger: true, disableListenLog: true }).pipe(
+        Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 })),
+      ),
+    );
+    const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+    if (!("port" in server.address)) return yield* Effect.die("Expected a TCP peer");
+    return `http://127.0.0.1:${server.address.port}`;
+  });
+
+/** A small authored MCP App speaks the published frame protocol and keeps a visible local draft. */
+export const interactiveMcpApp = `<!doctype html><html><head><title>Original app</title></head><body>
+<h1>Original app</h1><label>Draft<input value="Unsaved draft"></label><button id="edit">Save</button><button id="note">Read note</button><button id="reject">Fail action</button><p id="input"></p><p id="result"></p><p role="status">Starting</p>
+<script>
+let sequence = 0; const pending = new Map();
+const call = (method, params) => new Promise((resolve, reject) => { const id = ++sequence; pending.set(id, { resolve, reject }); parent.postMessage({ jsonrpc: "2.0", id, method, params }, "*"); });
+const status = document.querySelector("[role=status]");
+window.addEventListener("message", (event) => {
+ if (event.source !== parent) return;
+ const message = event.data;
+ if (message.id !== undefined) {
+  const request = pending.get(message.id); if (!request) return; pending.delete(message.id);
+  if (message.error) request.reject(new Error(message.error.message)); else request.resolve(message.result);
+ } else if (message.method === "ui/notifications/tool-input") document.querySelector("#input").textContent = message.params.arguments.text;
+ else if (message.method === "ui/notifications/tool-result") { document.querySelector("#result").textContent = message.params.structuredContent.text; status.textContent = "Ready"; }
+});
+document.querySelector("#edit").onclick = () => call("tools/call", { name: "edit", arguments: { text: document.querySelector("input").value } }).then((result) => { status.textContent = result.isError ? "Save failed" : result.structuredContent.text; }).catch(() => { status.textContent = "Save failed"; });
+document.querySelector("#note").onclick = () => call("resources/read", { uri: "fixture://note" }).then((result) => { status.textContent = result.contents[0].text; }).catch(() => { status.textContent = "Read failed"; });
+document.querySelector("#reject").onclick = () => call("tools/call", { name: "reject", arguments: {} }).then((result) => { status.textContent = result.content[0].text; }).catch(() => { status.textContent = "Action failed"; });
+call("ui/initialize", { appInfo: { name: "Original app", version: "1" }, appCapabilities: {}, protocolVersion: "2026-01-26" }).then(() => parent.postMessage({ jsonrpc: "2.0", method: "ui/notifications/initialized", params: {} }, "*"));
+</script></body></html>`;
diff --git a/e2e/support/mcp-app-upstream.ts b/e2e/support/mcp-app-upstream.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/mcp-app-upstream.ts
@@ -0,0 +1,157 @@
+/** An external MCP peer varies identical tool/resource names by the selected account. */
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Effect, Layer, Schema } from "effect";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { createServer } from "node:http";
+import { randomUUID } from "node:crypto";
+import { mcpSdkVersion, withApps } from "./apps-release.ts";
+
+const Rpc = Schema.Struct({
+  id: Schema.optionalKey(Schema.Union([Schema.String, Schema.Number])),
+  method: Schema.String,
+  params: Schema.optionalKey(Schema.Record(Schema.String, Schema.Unknown)),
+});
+const Arguments = Schema.Struct({
+  name: Schema.String,
+  arguments: Schema.Record(Schema.String, Schema.Unknown),
+});
+export const mcpAppUpstream = Effect.gen(function* () {
+  const sessions = new Map<string, boolean>();
+  const seen: Array<{
+    readonly method: string;
+    readonly account: string;
+    readonly name?: string;
+    readonly ui?: boolean;
+  }> = [];
+  const handler = Effect.gen(function* () {
+    const request = yield* HttpServerRequest.HttpServerRequest;
+    if (request.method === "GET") return HttpServerResponse.empty({ status: 405 });
+    if (request.method === "DELETE") return HttpServerResponse.empty({ status: 200 });
+    const message = yield* Schema.decodeUnknownEffect(Schema.fromJsonString(Rpc))(
+      yield* request.text,
+    );
+    if (message.id === undefined) return HttpServerResponse.empty({ status: 202 });
+    const account = request.headers["x-fixture-account"] ?? "none";
+    seen.push({ method: message.method, account });
+    const answer = (result: unknown, headers?: Record<string, string>) =>
+      HttpServerResponse.jsonUnsafe(
+        { jsonrpc: "2.0", id: message.id, result },
+        headers === undefined ? {} : { headers },
+      );
+    if (message.method === "initialize") {
+      const session = randomUUID();
+      const capabilities = yield* Schema.decodeUnknownEffect(
+        Schema.Struct({
+          extensions: Schema.optionalKey(Schema.Record(Schema.String, Schema.Unknown)),
+        }),
+      )(message.params?.capabilities ?? {});
+      sessions.set(session, capabilities.extensions?.["io.modelcontextprotocol/ui"] !== undefined);
+      return answer(
+        {
+          protocolVersion: message.params?.protocolVersion,
+          capabilities: { tools: {}, resources: {} },
+          serverInfo: { name: "MCP Apps upstream", version: "1" },
+        },
+        { "mcp-session-id": session },
+      );
+    }
+    const ui = sessions.get(request.headers["mcp-session-id"] ?? "") === true;
+    if (message.method === "tools/list")
+      return answer({
+        tools: [
+          {
+            name: "open_native",
+            inputSchema: {
+              type: "object",
+              properties: { text: { type: "string" } },
+              required: ["text"],
+            },
+            annotations: { readOnlyHint: true },
+            ...(ui ? { _meta: { ui: { resourceUri: "ui://remote/view.html" } } } : {}),
+          },
+          {
+            name: ui ? "visual_profile" : "plain_profile",
+            inputSchema: { type: "object" },
+            annotations: { readOnlyHint: true },
+          },
+          {
+            name: "edit_native",
+            inputSchema: {
+              type: "object",
+              properties: { text: { type: "string" } },
+              required: ["text"],
+            },
+            annotations: { readOnlyHint: true },
+            _meta: { ui: { visibility: ["app"] } },
+          },
+        ],
+      });
+    if (message.method === "tools/call") {
+      const tool = yield* Schema.decodeUnknownEffect(Arguments)(message.params);
+      seen.push({ method: "call", account, name: tool.name, ui });
+      return answer({
+        content: [{ type: "text", text: `${account}:${String(tool.arguments.text)}` }],
+        structuredContent: { account, text: tool.arguments.text },
+        _meta: { native: account },
+      });
+    }
+    if (message.method === "resources/list")
+      return answer({
+        resources: [
+          {
+            uri: "ui://remote/view.html",
+            name: "Remote view",
+            mimeType: "text/html;profile=mcp-app",
+            _meta: {
+              ui: {
+                csp: { resourceDomains: ["https://esm.sh"], connectDomains: ["https://esm.sh"] },
+              },
+            },
+          },
+        ],
+      });
+    if (message.method === "resources/read") {
+      const uri = message.params?.uri;
+      return answer({
+        contents: [
+          {
+            uri,
+            mimeType: "text/html;profile=mcp-app",
+            blob: Buffer.from(`<html><body>${account} remote view</body></html>`).toString(
+              "base64",
+            ),
+          },
+        ],
+      });
+    }
+    return answer({});
+  });
+  const services = yield* Layer.build(
+    HttpRouter.serve(HttpRouter.add("*", "/mcp", handler), {
+      disableLogger: true,
+      disableListenLog: true,
+    }).pipe(Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 }))),
+  );
+  const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+  if (!("port" in server.address)) return yield* Effect.die("Expected a TCP upstream");
+  return { url: `http://127.0.0.1:${server.address.port}/mcp`, seen };
+});
+
+export const remoteMcpAppFiles = (url: string) => [
+  {
+    path: "package.json",
+    content: JSON.stringify({
+      dependencies: withApps({ "@modelcontextprotocol/sdk": mcpSdkVersion }),
+    }),
+  },
+  {
