+            label: "Alpha",
+            fields: {
+              variant: "Alpha",
+              endpoint: upstream.url + "?revision=2",
+              token: randomUUID(),
+            },
+          }),
+        );
+        expect(changedEndpoint.id).toBe(alpha);
+        expect(
+          (yield* call("show-app", { view: first.id })).isError,
+          "A saved view cannot move to a replacement endpoint",
+        ).toBe(true);
+        yield* unlinkAccount(actors.owner, path, "service", alpha);
+        expect(
+          (yield* call("app-callback", {
+            view: first.id,
+            capability: payload.capability,
+            name: "edit_native",
+            input: { text: "No longer linked" },
+          })).isError,
+        ).toBe(true);
+      }).pipe(Effect.provide(McpClient.layer)),
+    ),
+  );
+});
diff --git a/e2e/tests/mcp-apps-ui.spec.ts b/e2e/tests/mcp-apps-ui.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/mcp-apps-ui.spec.ts
@@ -0,0 +1,104 @@
+/** The packaged renderer runs inside a real protocol peer, including its separately served sandbox. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { randomUUID } from "node:crypto";
+import { scenarios } from "../test-plan.ts";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { App } from "../support/contracts.ts";
+import { McpClient } from "../support/mcp-client.ts";
+import { Browser } from "../support/browser.ts";
+import { mcpAppUiFiles } from "../support/mcp-app-fixture.ts";
+import { interactiveMcpApp, mcpAppHost } from "../support/mcp-app-host.ts";
+import {
+  renderMcpApp,
+  exerciseMcpApp,
+  reopenMcpApp,
+  rejectForgedMcpPolicy,
+} from "../support/mcp-app-browser.ts";
+
+const Captured = Schema.Struct({ views: Schema.Array(Schema.Struct({ id: Schema.String })) });
+const Resource = Schema.Struct({ contents: Schema.Array(Schema.Struct({ text: Schema.String })) });
+const Payload = Schema.Struct({
+  "executor/app-view": Schema.Struct({ sandboxUrl: Schema.String, capability: Schema.String }),
+});
+
+layer(HostedLive, { excludeTestServices: true })("MCP Apps renderer", (it) => {
+  it.effect(scenarios.mcpAppsUi.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          mcp = yield* McpClient,
+          browser = yield* Browser;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const key = yield* body(
+          Schema.Struct({ id: Schema.String, key: Schema.RedactedFromValue(Schema.String) }),
+          yield* api.request(actors.owner, "POST", "/api/auth/api-key/create", {
+            name: "App renderer",
+          }),
+        );
+        yield* Effect.addFinalizer(() =>
+          api
+            .request(actors.owner, "POST", "/api/auth/api-key/delete", { keyId: key.id })
+            .pipe(Effect.orDie),
+        );
+        const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: `App renderer ${randomUUID().slice(0, 8)}`,
+          files: mcpAppUiFiles(interactiveMcpApp),
+        });
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const app = yield* body(App, deployed);
+        yield* Effect.addFinalizer(() =>
+          api.request(actors.owner, "DELETE", `${prefix}/apps/${app.id}`).pipe(Effect.orDie),
+        );
+        const client = yield* mcp.connect(key.key, "renderer", {
+          organization: actors.organization.id,
+          mode: "native",
+          ui: true,
+        });
+        const call = (name: string, input: Record<string, unknown>) =>
+          client.use(`App peer ${name}`, (client, signal) =>
+            client.callTool({ name, arguments: input }, undefined, { signal }),
+          );
+        const captured = yield* Schema.decodeUnknownEffect(Captured)(
+          (yield* call("execute", {
+            code: `await tools[${JSON.stringify(app.slug)}].alpha.open({ text: "Original native input" }); return "only transformed text";`,
+          })).structuredContent,
+        );
+        const view = captured.views[0]?.id;
+        if (view === undefined) return yield* Effect.die("No view captured");
+        const shown = yield* call("show-app", { view });
+        expect(shown.isError, JSON.stringify(shown.content)).not.toBe(true);
+        const payload = (yield* Schema.decodeUnknownEffect(Payload)(shown._meta))[
+          "executor/app-view"
+        ];
+        const resource = yield* client
+          .use("Load packaged UI", (client) =>
+            client.readResource({ uri: "ui://executor/app-bridge.html" }),
+          )
+          .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Resource)));
+        const html = resource.contents[0]?.text;
+        if (html === undefined) return yield* Effect.die("No packaged renderer");
+        const peer = yield* mcpAppHost(html, view, shown, call, (uri) =>
+          client.use("Read a bound resource", (client, signal) =>
+            client.readResource({ uri }, { signal }),
+          ),
+        );
+        const headers = yield* renderMcpApp(browser, peer);
+        expect(headers["content-security-policy"]).toContain("connect-src 'none'");
+        expect(headers["content-security-policy"]).toContain("frame-src 'self'");
+        expect(headers["cache-control"]).toBe("no-store");
+        yield* browser.checkpoint("Original app rendered through the packaged bridge");
+        yield* exerciseMcpApp(browser, payload.capability);
+        expect(yield* client.elicitationCount).toBe(1);
+        yield* browser.checkpoint("App callback and resource read preserve native UI state");
+        yield* reopenMcpApp(browser);
+        // A policy cannot be loosened by a child or reused under a second sandbox origin.
+        yield* rejectForgedMcpPolicy(browser, payload.sandboxUrl);
+      }).pipe(Effect.provide(McpClient.layer)),
+    ),
+  );
+});
diff --git a/e2e/tests/mcp-apps.spec.ts b/e2e/tests/mcp-apps.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/mcp-apps.spec.ts
@@ -0,0 +1,283 @@
+/** App views cross the real product's HTTP/MCP boundary, including approval and source rechecks. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { randomUUID } from "node:crypto";
+import { scenarios } from "../test-plan.ts";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { App } from "../support/contracts.ts";
+import { McpClient } from "../support/mcp-client.ts";
+import { mcpAppFiles } from "../support/mcp-app-fixture.ts";
+
+const Key = Schema.Struct({ id: Schema.String, key: Schema.RedactedFromValue(Schema.String) });
+const View = Schema.Struct({
+  id: Schema.String,
+  app: Schema.String,
+  callIndex: Schema.Number,
+  path: Schema.String,
+  expiresAt: Schema.Number,
+});
+const Completed = Schema.Struct({
+  status: Schema.Literal("completed"),
+  execution: Schema.Struct({ ok: Schema.Boolean, value: Schema.Unknown }),
+  views: Schema.optionalKey(Schema.Array(View)),
+});
+const Shown = Schema.Struct({
+  "executor/app-view": Schema.Struct({
+    view: Schema.String,
+    capability: Schema.String,
+    app: Schema.String,
+    html: Schema.String,
+    sandboxUrl: Schema.String,
+    input: Schema.Struct({ text: Schema.String }),
+    result: Schema.Struct({
+      structuredContent: Schema.Struct({ source: Schema.String, text: Schema.String }),
+      _meta: Schema.Struct({ original: Schema.String }),
+    }),
+  }),
+});
+
+layer(HostedLive, { excludeTestServices: true })("MCP Apps bridge", (it) => {
+  it.effect(scenarios.mcpApps.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          mcp = yield* McpClient;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const createKey = (name: string) =>
+          api.request(actors.owner, "POST", "/api/auth/api-key/create", { name }).pipe(
+            Effect.flatMap((response) => body(Key, response)),
+            Effect.tap((key) =>
+              Effect.addFinalizer(() =>
+                api
+                  .request(actors.owner, "POST", "/api/auth/api-key/delete", { keyId: key.id })
+                  .pipe(Effect.orDie),
+              ),
+            ),
+          );
+        const key = yield* createKey("MCP Apps owner");
+        const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: `MCP Apps ${randomUUID().slice(0, 8)}`,
+          files: mcpAppFiles,
+        });
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const app = yield* body(App, deployed);
+        yield* Effect.addFinalizer(() =>
+          api.request(actors.owner, "DELETE", `${prefix}/apps/${app.id}`).pipe(Effect.orDie),
+        );
+        const client = yield* mcp.connect(key.key, "app-owner", {
+          organization: actors.organization.id,
+          mode: "native",
+          ui: true,
+        });
+        const call = (name: string, args: Record<string, unknown>) =>
+          client.use(name, (client, signal) =>
+            client.callTool({ name, arguments: args }, undefined, { signal }),
+          );
+        const path = (source: string, name: string) =>
+          `tools[${JSON.stringify(app.slug)}].${source}.${name}`;
+        const listed = yield* client.use("Read native app declarations", (client) =>
+          client.listTools(),
+        );
+        expect(listed.tools.find((tool) => tool.name === "show-app")?._meta).toMatchObject({
+          ui: { resourceUri: "ui://executor/app-bridge.html" },
+        });
+        expect(listed.tools.find((tool) => tool.name === "app-callback")?._meta).toMatchObject({
+          ui: { visibility: ["app"] },
+        });
+        const bridge = yield* client.use("Read the packaged renderer", (client) =>
+          client.readResource({ uri: "ui://executor/app-bridge.html" }),
+        );
+        expect(JSON.stringify(bridge)).toContain("text/html;profile=mcp-app");
+        expect(JSON.stringify(bridge)).toContain("frameDomains");
+
+        // The program discards both raw native values, but its view references retain their exact inputs.
+        const execution = yield* call("execute", {
+          code: `await tools[${JSON.stringify(app.slug)}].alpha.open({ text: "First input" }); await tools[${JSON.stringify(app.slug)}].beta.open({ text: "Second input" }); return "transformed";`,
+        });
+        const result = yield* Schema.decodeUnknownEffect(Completed)(execution.structuredContent);
+        expect(result.execution).toMatchObject({ ok: true, value: "transformed" });
+        expect(
+          result.views?.map((view) => ({ callIndex: view.callIndex, path: view.path })),
+        ).toEqual([
+          { callIndex: 0, path: path("alpha", "open") },
+          { callIndex: 1, path: path("beta", "open") },
+        ]);
+        expect(JSON.stringify(execution.structuredContent)).not.toContain("capability");
+        const first = result.views?.[0],
+          second = result.views?.[1];
+        expect(first).toBeDefined();
+        expect(second).toBeDefined();
+        if (!first || !second) return yield* Effect.die("Missing captured views");
+        const shown = yield* call("show-app", { view: first.id });
+        expect(shown.isError, JSON.stringify(shown.content)).not.toBe(true);
+        const payload = (yield* Schema.decodeUnknownEffect(Shown)(shown._meta))[
+          "executor/app-view"
+        ];
+        expect(payload.input).toEqual({ text: "First input" });
+        expect(payload.result).toMatchObject({
+          structuredContent: { source: "Alpha", text: "First input" },
+          _meta: { original: "Alpha" },
+        });
+        expect(payload.html).toContain("Alpha native view");
+        expect(JSON.stringify(shown.content)).not.toContain(payload.capability);
+        const again = (yield* Schema.decodeUnknownEffect(Shown)(
+          (yield* call("show-app", { view: first.id }))._meta,
+        ))["executor/app-view"];
+        expect(again.result).toEqual(payload.result);
+        expect(new URL(again.sandboxUrl).origin).not.toBe(new URL(payload.sandboxUrl).origin);
+        const beta = (yield* Schema.decodeUnknownEffect(Shown)(
+          (yield* call("show-app", { view: second.id }))._meta,
+        ))["executor/app-view"];
+        expect(beta.html).toContain("Beta native view");
+
+        const before = yield* client.elicitationCount;
+        const callback = yield* call("app-callback", {
+          view: first.id,
+          capability: payload.capability,
+          name: "edit",
+          input: { text: "Edited" },
+        });
+        expect(callback.isError, JSON.stringify(callback.content)).not.toBe(true);
+        expect(callback.structuredContent).toEqual({ source: "Alpha", text: "Edited" });
+        expect(yield* client.elicitationCount).toBe(before + 1);
+        const resource = yield* call("app-resource", {
+          view: first.id,
+          capability: payload.capability,
+          uri: "fixture://note",
+        });
+        expect(JSON.stringify(resource._meta)).toContain("Alpha source note");
+        const rejected = yield* call("app-callback", {
+          view: first.id,
+          capability: payload.capability,
+          name: "reject",
+          input: {},
+        });
+        expect(rejected).toMatchObject({
+          isError: true,
+          content: [{ type: "text", text: "Native app error" }],
+        });
+        for (const name of ["beta.edit", "modelOnly"])
+          expect(
+            (yield* call("app-callback", {
+              view: first.id,
+              capability: payload.capability,
+              name,
+              input: {},
+            })).isError,
+          ).toBe(true);
+        expect(
+          (yield* call("app-callback", {
+            view: first.id,
+            capability: "forged",
+            name: "edit",
+            input: { text: "No" },
+          })).isError,
+        ).toBe(true);
+
+        const fake = yield* Schema.decodeUnknownEffect(Completed)(
+          (yield* call("call", {
+            calls: { path: `tools[${JSON.stringify(app.slug)}].fake`, input: {} },
+          })).structuredContent,
+        );
+        expect(fake.views ?? []).toHaveLength(0);
+        const hidden = yield* Schema.decodeUnknownEffect(Completed)(
+          (yield* call("call", {
+            calls: { path: path("alpha", "edit"), input: { text: "Model bypass" } },
+          })).structuredContent,
+        );
+        expect(JSON.stringify(hidden.execution.value)).toContain('"ok":false');
+        const searched = yield* call("search", { namespace: app.slug, query: "edit" });
+        expect(JSON.stringify(searched.structuredContent)).not.toContain(path("alpha", "edit"));
+
+        const foreignKey = yield* createKey("MCP Apps separate grant");
+        const foreign = yield* mcp.connect(foreignKey.key, "foreign-app-grant", {
+          organization: actors.organization.id,
+          ui: true,
+        });
+        const denied = yield* foreign.use("Refuse another grant's view", (client) =>
+          client.callTool({ name: "show-app", arguments: { view: first.id } }),
+        );
+        expect(denied.isError).toBe(true);
+        const plain = yield* mcp.connect(key.key, "non-apps-client", {
+          organization: actors.organization.id,
+        });
+        const unsupported = yield* plain.use("Explain unsupported clients", (client) =>
+          client.callTool({ name: "show-app", arguments: { view: first.id } }),
+        );
+        expect(unsupported.isError).toBe(true);
+        expect(JSON.stringify(unsupported.content)).toContain("does not support MCP Apps");
+
+        for (const answer of ["decline", "cancel"] as const) {
+          const refusing = yield* mcp.connect(key.key, `callback-${answer}`, {
+            organization: actors.organization.id,
+            mode: "native",
+            ui: true,
+            answer,
+          });
+          const refused = yield* refusing.use(`A callback respects ${answer}`, (client, signal) =>
+            client.callTool(
+              {
+                name: "app-callback",
+                arguments: {
+                  view: first.id,
+                  capability: payload.capability,
+                  name: "edit",
+                  input: { text: "Must not run" },
+                },
+              },
+              undefined,
+              { signal },
+            ),
+          );
+          expect(refused.isError, JSON.stringify(refused)).toBe(true);
+          expect(yield* refusing.elicitationCount).toBe(1);
+        }
+        const replacing = yield* mcp.connect(key.key, "version-changes-during-input", {
+          organization: actors.organization.id,
+          mode: "native",
+          ui: true,
+          whileApproving: api
+            .request(actors.owner, "POST", `${prefix}/apps/${app.id}/deploy`, {
+              files: mcpAppFiles,
+            })
+            .pipe(
+              Effect.tap((response) =>
+                Effect.sync(() => expect(response.status, JSON.stringify(response.body)).toBe(200)),
+              ),
+              Effect.asVoid,
+            ),
+        });
+        const interrupted = yield* replacing.use(
+          "A version change cannot release an old live prompt",
+          (client, signal) =>
+            client.callTool(
+              {
+                name: "app-callback",
+                arguments: {
+                  view: first.id,
+                  capability: payload.capability,
+                  name: "question",
+                  input: {},
+                },
+              },
+              undefined,
+              { signal },
+            ),
+        );
+        expect(interrupted.isError, JSON.stringify(interrupted)).toBe(true);
+        expect(yield* replacing.elicitationCount).toBe(1);
+        expect(
+          (yield* call("app-resource", {
+            view: first.id,
+            capability: payload.capability,
+            uri: "fixture://note",
+          })).isError,
+        ).toBe(true);
+      }).pipe(Effect.provide(McpClient.layer)),
+    ),
+  );
+});
