--- /dev/null
+++ b/packages/apps/src/implementation/mcp-app-selection.ts
@@ -0,0 +1,52 @@
+/** Reopening a source compares its effective headers without retaining expiring credential handles. */
+import { cacheKey } from "@executor-js/app-cache";
+import { Effect, Redacted } from "effect";
+import { McpAppSourceAccounts, scopedSlots } from "../contracts/host.ts";
+import type { JsonValue } from "../contracts/schema.ts";
+import { McpError } from "../contracts/mcp.ts";
+
+export const mcpAppHeaderSelection = (
+  headers: Readonly<Record<string, string>> | undefined,
+  accountId: string | undefined,
+) =>
+  Effect.gen(function* () {
+    const supplied = yield* McpAppSourceAccounts;
+    const accounts =
+      supplied === undefined
+        ? []
+        : scopedSlots(Redacted.value(supplied)).flatMap(([, selected]) =>
+            Array.isArray(selected) ? selected : [selected],
+          );
+    const selected = accounts.find((account) => account.id === accountId);
+    if (accountId !== undefined && selected === undefined)
+      return yield* new McpError({ phase: "connect", reason: "invalid_input" });
+    const handles = new Map<string, string>();
+    for (const account of accounts) {
+      const collect = (value: JsonValue, path: readonly string[]) => {
+        if (typeof value === "string" && /^exsec2?_[a-f0-9]+_$/u.test(value))
+          handles.set(
+            value,
+            JSON.stringify([account.id, account.method, account.generation ?? null, path]),
+          );
+        else if (Array.isArray(value))
+          value.forEach((item, index) => collect(item, [...path, String(index)]));
+        else if (value !== null && typeof value === "object")
+          for (const [key, item] of Object.entries(value)) collect(item, [...path, key]);
+      };
+      collect(account.fields, []);
+    }
+    const normalized = Object.fromEntries(
+      Object.entries(headers ?? {}).map(([name, value]) => [
+        name,
+        [...handles].reduce(
+          (value, [handle, identity]) => value.replaceAll(handle, `\0credential:${identity}\0`),
+          value,
+        ),
+      ]),
+    );
+    return yield* cacheKey({
+      headers: normalized,
+      account:
+        selected === undefined ? null : [selected.id, selected.method, selected.generation ?? null],
+    });
+  });
