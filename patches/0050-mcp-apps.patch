diff --git a/e2e/tests/local-mcp-apps.spec.ts b/e2e/tests/local-mcp-apps.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/local-mcp-apps.spec.ts
@@ -0,0 +1,133 @@
+/** Local views survive the product process and stay separate from management routes. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Redacted, Schema } from "effect";
+import { HttpClient, HttpClientRequest } from "effect/http";
+import { randomUUID } from "node:crypto";
+import { scenarios } from "../test-plan.ts";
+import { Api, body } from "../support/api.ts";
+import { TestLive, withCase } from "../support/case.ts";
+import { App } from "../support/contracts.ts";
+import { Target } from "../support/platform.ts";
+import { McpClient } from "../support/mcp-client.ts";
+import { mcpAppFiles } from "../support/mcp-app-fixture.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { serverControl } from "../support/server-control.ts";
+
+const Captured = Schema.Struct({ views: Schema.Array(Schema.Struct({ id: Schema.String })) });
+const Shown = Schema.Struct({
+  "executor/app-view": Schema.Struct({
+    sandboxUrl: Schema.String,
+    input: Schema.Struct({ text: Schema.String }),
+    capability: Schema.String,
+  }),
+});
+layer(TestLive, { excludeTestServices: true })("Local MCP Apps", (it) => {
+  it.effect(scenarios.localMcpApps.title, (context) =>
+    withCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          target = yield* Target,
+          mcp = yield* McpClient,
+          http = yield* HttpClient.HttpClient;
+        const session = yield* api.session();
+        const headers = { authorization: `Bearer ${Redacted.value(target.apiKey)}` };
+        const deployed = yield* session.send(
+          "POST",
+          "/v1/apps/deploy",
+          { owner: "local", name: `Local view ${randomUUID().slice(0, 8)}`, files: mcpAppFiles },
+          headers,
+        );
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const { app } = yield* body(Schema.Struct({ app: App }), deployed);
+        yield* Effect.addFinalizer(() =>
+          session.send("DELETE", `/v1/apps/${app.id}`, undefined, headers).pipe(Effect.orDie),
+        );
+        const client = yield* mcp.connect(target.apiKey, "local-apps", {
+          mode: "native",
+          ui: true,
+        });
+        const call = (name: string, input: Record<string, unknown>) =>
+          client.use(name, (client, signal) =>
+            client.callTool({ name, arguments: input }, undefined, { signal }),
+          );
+        const capture = yield* call("execute", {
+          code: `return await tools[${JSON.stringify(app.slug)}].alpha.open({ text: "Retained local input" });`,
+        });
+        const views = yield* Schema.decodeUnknownEffect(Captured)(capture.structuredContent);
+        const view = views.views[0]?.id;
+        if (view === undefined) return yield* Effect.die("Local view missing");
+        const first = yield* call("show-app", { view });
+        expect(first.isError, JSON.stringify(first.content)).not.toBe(true);
+        const shown = (yield* Schema.decodeUnknownEffect(Shown)(first._meta))["executor/app-view"];
+        expect(shown.input.text).toBe("Retained local input");
+        const proxy = yield* http.get(shown.sandboxUrl);
+        expect(proxy.status).toBe(200);
+        expect(proxy.headers["content-security-policy"]).toContain("connect-src 'none'");
+        const proxyBody = yield* proxy.text;
+        expect(proxyBody).not.toContain(shown.capability);
+        const management = new URL("/v1/apps", shown.sandboxUrl).href;
+        const refused = yield* http.execute(
+          HttpClientRequest.get(management).pipe(HttpClientRequest.setHeaders(headers)),
+        );
+        expect(refused.status).toBe(404);
+        yield* refused.text;
+        const oversized = yield* call("execute", {
+          code: `await tools[${JSON.stringify(app.slug)}].alpha.large({}); return "Original operation completed";`,
+        });
+        expect(oversized.structuredContent).toMatchObject({
+          execution: { ok: true, value: "Original operation completed" },
+          viewErrors: [{ callIndex: 0 }],
+        });
+        const concurrent = yield* Effect.all(
+          [0, 1].map(() =>
+            call("execute", {
+              code: `const results = await Promise.all(Array.from({ length: 70 }, () => tools[${JSON.stringify(app.slug)}].alpha.open({ text: "Concurrent native input" }))); return results.length;`,
+            }),
+          ),
+          { concurrency: 2 },
+        );
+        const Admission = Schema.Struct({
+          execution: Schema.Struct({ ok: Schema.Literal(true), value: Schema.Literal(70) }),
+          views: Schema.optionalKey(Schema.Array(Schema.Unknown)),
+          viewErrors: Schema.optionalKey(Schema.Array(Schema.Unknown)),
+        });
+        const admissions = yield* Effect.forEach(concurrent, (item) =>
+          Schema.decodeUnknownEffect(Admission)(item.structuredContent),
+        );
+        expect(admissions.reduce((total, item) => total + (item.views?.length ?? 0), 0)).toBe(127);
+        expect(admissions.reduce((total, item) => total + (item.viewErrors?.length ?? 0), 0)).toBe(
+          13,
+        );
+        const [sealed, retained] = yield* legacyStorage([
+          {
+            sql: "select get_byte(encrypted, 0) as version, octet_length(encrypted) as bytes, position(convert_to($1, 'UTF8') in encrypted) as plaintext from executor_app_views where id = $2",
+            params: ["Retained local input", view],
+          },
+          { sql: "select count(*)::int as count from executor_app_views" },
+        ]);
+        expect(sealed).toMatchObject([{ version: 1, plaintext: 0 }]);
+        expect(sealed?.[0]?.bytes).toBeGreaterThan(13);
+        expect(retained).toEqual([{ count: 128 }]);
+        yield* serverControl("start");
+
+        const restored = yield* mcp.connect(target.apiKey, "restored-apps", {
+          mode: "native",
+          ui: true,
+        });
+        const reopened = yield* restored.use("Reopen persisted view", (client) =>
+          client.callTool({ name: "show-app", arguments: { view } }),
+        );
+        expect(reopened.isError, JSON.stringify(reopened.content)).not.toBe(true);
+        expect(
+          (yield* Schema.decodeUnknownEffect(Shown)(reopened._meta))["executor/app-view"].input,
+        ).toEqual(shown.input);
+        yield* serverControl("clock/advance", 200, { milliseconds: 24 * 60 * 60 * 1000 + 1 });
+        const expired = yield* restored.use("Expired views cannot reopen", (client) =>
+          client.callTool({ name: "show-app", arguments: { view } }),
+        );
+        expect(expired.isError).toBe(true);
+      }).pipe(Effect.provide(McpClient.layer)),
+    ),
+  );
+});
