@@ -0,0 +1,192 @@
+/** Products bind the principal and grant, then reuse their ordinary invocation authorization. */
+import {
+  ElicitationFailed,
+  AppViewsHost,
+  AppSourceHost,
+  AppViewUnavailable,
+  ToolApprovalIssuer,
+  invocationAccounts,
+  Json,
+  ToolName,
+  ToolInvocationFields,
+  type Executor,
+  type AppViewContext,
+  type AppViewId,
+  type ObservedAppView,
+  type ToolInvocationOptions,
+} from "@executor-js/sdk/core";
+import { McpAppUiProfile, McpAppResources } from "apps/contracts";
+import { Effect, Schema } from "effect";
+import type { McpBackend } from "../contracts/backend.ts";
+import type { McpAppViewsBackend } from "../contracts/app-views.ts";
+import { appViewResourceBase } from "../contracts/app-bridge.ts";
+import { AppSandboxPolicy, type AppSandboxAddress } from "../contracts/app-sandbox.ts";
+
+export const makeMcpAppViews = <E extends Error>(
+  executor: Executor,
+  context: Effect.Effect<AppViewContext, E>,
+  backend: Pick<McpBackend<E>, "authorizeElicitation" | "callTool" | "resumeInvocation">,
+  address: AppSandboxAddress | undefined,
+): McpAppViewsBackend<E> => {
+  const store = executor[AppViewsHost];
+  const source = executor[AppSourceHost];
+  const authorize = (observed: ObservedAppView) =>
+    backend.authorizeElicitation({
+      app: observed.invocation.app,
+      tool: observed.invocation.tool,
+      accounts: invocationAccounts(observed.invocation),
+    });
+  const read = (id: AppViewId, capability?: string) =>
+    Effect.gen(function* () {
+      const binding = yield* context;
+      if (capability !== undefined) yield* store.verify(binding, id, capability);
+      const retained = yield* store.readAuthorized(binding, id);
+      yield* authorize(retained.observed);
+      return { ...retained, binding };
+    });
+  const resource = (observed: ObservedAppView, uri: string) =>
+    source
+      .dispatch(observed, { operation: "app-resource", uri })
+      .pipe(Effect.flatMap(Schema.decodeUnknownEffect(McpAppResources)));
+  const mapped = (observed: ObservedAppView, name: string, input: Json) =>
+    source
+      .dispatch(observed, {
+        operation: "app-callback",
+        name,
+        arguments: input,
+      })
+      .pipe(
+        Effect.flatMap(Schema.decodeUnknownEffect(Schema.Struct({ name: ToolName, input: Json }))),
+      );
+  const issuer = (id: AppViewId, capability: string) =>
+    ToolApprovalIssuer.make(`mcp-app:${id}:${capability}`);
+  const delivery = (
+    id: AppViewId,
+    capability: string,
+    name: string,
+    input: Json,
+    options: ToolInvocationOptions | undefined,
+  ): ToolInvocationOptions => {
+    const handler = options?.elicitation;
+    const validate = read(id, capability).pipe(
+      Effect.flatMap(({ observed }) => mapped(observed, name, input)),
+      Effect.mapError(() => new ElicitationFailed({ reason: "forbidden" })),
+    );
+    return handler === undefined
+      ? { ...options }
+      : {
+          ...options,
+          elicitation: (request, signal) =>
+            validate.pipe(
+              Effect.andThen(handler(request, signal)),
+              Effect.tap(() => validate),
+            ),
+        };
+  };
+  return {
+    rendererPolicy: Effect.succeed({
+      frameDomains: address === undefined ? [] : [address.frameDomain],
+    }),
+    retainObserved: (observed) =>
+      Effect.gen(function* () {
+        const binding = yield* context;
+        yield* authorize(observed);
+        return yield* store.putObserved(binding, observed);
+      }),
+    show: (id) =>
+      Effect.gen(function* () {
+        const { observed, binding } = yield* read(id);
+        const content = yield* resource(observed, observed.view.resourceUri);
+        if (address === undefined) return yield* new AppViewUnavailable({ reason: "unavailable" });
+        const item = content.contents.find((item) => item.uri === observed.view.resourceUri);
+        if (item === undefined || item.mimeType !== "text/html;profile=mcp-app")
+          return yield* new AppViewUnavailable({ reason: "unavailable" });
+        const html = yield* Effect.try({
+          try: () =>
+            item.text ??
+            (item.blob === undefined
+              ? undefined
+              : new TextDecoder("utf-8", { fatal: true }).decode(
+                  Uint8Array.from(atob(item.blob), (character) => character.charCodeAt(0)),
+                )),
+          catch: () => new AppViewUnavailable({ reason: "unavailable" }),
+        });
+        if (html === undefined || new TextEncoder().encode(html).byteLength > 2 * 1024 * 1024)
+          return yield* new AppViewUnavailable({ reason: "too-large" });
+        const policy = yield* Schema.decodeUnknownEffect(AppSandboxPolicy)(
+          item._meta?.ui ?? {},
+        ).pipe(Effect.mapError(() => new AppViewUnavailable({ reason: "unavailable" })));
+        const signed = yield* store.sandboxPolicy(JSON.stringify(policy));
+        const sandboxUrl = new URL("/_executor/mcp-sandbox", address.origin(signed.label));
+        sandboxUrl.searchParams.set("policy", signed.token);
+        const capability = yield* store.capability(binding, id);
+        return {
+          observed,
+          capability,
+          resource: content,
+          payload: {
+            view: id,
+            app: observed.appName,
+            capability,
+            sandboxUrl: sandboxUrl.href,
+            resourceBase: appViewResourceBase(id, capability),
+            html,
+            input: observed.view.input,
+            result: observed.result,
+            policy,
+          },
+        };
+      }),
+    resource: (id, capability, uri) =>
+      read(id, capability).pipe(Effect.flatMap(({ observed }) => resource(observed, uri))),
+    call: (id, capability, name, input, options) =>
+      Effect.gen(function* () {
+        const { observed } = yield* read(id, capability);
+        const tool = yield* mapped(observed, name, input);
+        return yield* backend
+          .callTool(
+            {
+              app: observed.invocation.app,
+              version: observed.invocation.version,
+              accounts: invocationAccounts(observed.invocation),
+              tool: tool.name,
+              input: tool.input,
+            },
+            {
+              ...delivery(id, capability, name, input, options),
+              audience: "app",
+              uiProfile: true,
+              appViewBinding: observed.invocation,
+              issuer: issuer(id, capability),
+            },
+          )
+          .pipe(Effect.provideService(McpAppUiProfile, true));
+      }),
+    resume: (id, capability, name, input, pending, response, options) =>
+      Effect.gen(function* () {
+        const { observed } = yield* read(id, capability);
+        const tool = yield* mapped(observed, name, input);
+        const saved = pending.invocation;
+        if (
+          saved.app !== observed.invocation.app ||
+          saved.version !== observed.invocation.version ||
+          saved.tool !== tool.name ||
+          saved.audience !== "app" ||
+          !Schema.toEquivalence(ToolInvocationFields.fields.accounts)(
+            saved.accounts,
+            observed.invocation.accounts,
+          )
+        )
+          return yield* new AppViewUnavailable({ reason: "denied" });
+        return yield* backend
+          .resumeInvocation(pending, response, {
+            ...delivery(id, capability, name, input, options),
+            audience: "app",
+            uiProfile: true,
+            appViewBinding: observed.invocation,
+            issuer: issuer(id, capability),
+          })
+          .pipe(Effect.provideService(McpAppUiProfile, true));
+      }),
+  };
+};
