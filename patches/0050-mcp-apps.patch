+import { Effect } from "effect";
+import type { McpAppViewsBackend } from "../contracts/app-views.ts";
+
+/** Cached MCP servers resolve the authenticated request backend anew for every operation. */
+export const deferredMcpAppViews = <E extends Error>(
+  current: Effect.Effect<McpAppViewsBackend<E>, E>,
+): McpAppViewsBackend<E> => ({
+  rendererPolicy: current.pipe(Effect.flatMap((backend) => backend.rendererPolicy)),
+  retainObserved: (view) => current.pipe(Effect.flatMap((backend) => backend.retainObserved(view))),
+  show: (id) => current.pipe(Effect.flatMap((backend) => backend.show(id))),
+  resource: (id, capability, uri) =>
+    current.pipe(Effect.flatMap((backend) => backend.resource(id, capability, uri))),
+  call: (id, capability, name, input, options) =>
+    current.pipe(Effect.flatMap((backend) => backend.call(id, capability, name, input, options))),
+  resume: (id, capability, name, input, pending, response, options) =>
+    current.pipe(
+      Effect.flatMap((backend) =>
+        backend.resume(id, capability, name, input, pending, response, options),
+      ),
+    ),
+});
