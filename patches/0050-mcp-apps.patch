@@ -0,0 +1,168 @@
+/** Private payloads use the host credential key; references contain no callback authority. */
+import { Clock, type Crypto, Effect, Redacted, Schema } from "effect";
+import {
+  AppViewId,
+  AppViewUnavailable,
+  ObservedAppView,
+  appViewLimits,
+  type AppViewsHost,
+  type AppViewContext,
+} from "../contracts/app-views.ts";
+import { JsonObject, StorageError } from "../contracts/shared.ts";
+import type { Credentials } from "../contracts/storage.ts";
+import type { ExecutorDatabase } from "./storage.ts";
+
+export const makeAppViews = (
+  storage: ExecutorDatabase["appViews"],
+  credentials: Credentials,
+  crypto: Crypto.Crypto,
+): AppViewsHost => {
+  const nonceId = crypto.randomUUIDv4.pipe(Effect.mapError(() => new StorageError()));
+  const scope = (context: AppViewContext) =>
+    credentials.fingerprint(
+      "mcp-app-view-scope",
+      Redacted.make(JSON.stringify([context.product, context.principal, context.grant])),
+    );
+  const readAuthorized: AppViewsHost["readAuthorized"] = (context, id) =>
+    Effect.gen(function* () {
+      const key = yield* scope(context);
+      const row = yield* storage.read(key, id);
+      if (row === undefined) return yield* new AppViewUnavailable({ reason: "unavailable" });
+      const now = yield* Clock.currentTimeMillis;
+      if (row.expiresAt <= now) return yield* new AppViewUnavailable({ reason: "expired" });
+      const payload = yield* credentials.decrypt(id, Redacted.make(row.encrypted));
+      const observed = yield* Schema.decodeUnknownEffect(ObservedAppView)(
+        Redacted.value(payload),
+      ).pipe(Effect.mapError(() => new StorageError()));
+      return { observed, expiresAt: row.expiresAt };
+    });
+  const signature = (key: string, id: AppViewId, expiresAt: string, nonce: string) =>
+    credentials.fingerprint(
+      "mcp-app-view-capability",
+      Redacted.make(JSON.stringify([key, id, expiresAt, nonce])),
+    );
+  const policySignature = (label: string, expiry: string, payload: string) =>
+    credentials.fingerprint(
+      "mcp-app-sandbox-policy",
+      Redacted.make(JSON.stringify([label, expiry, payload])),
+    );
+  const sameMac = (expected: string, actual: string) => {
+    if (!/^[a-f0-9]{64}$/.test(actual)) return false;
+    let difference = 0;
+    for (let index = 0; index < expected.length; index++)
+      difference |= expected.charCodeAt(index) ^ actual.charCodeAt(index);
+    return difference === 0;
+  };
+  return {
+    readAuthorized,
+    sandboxPolicy: (policy) =>
+      Effect.gen(function* () {
+        const bytes = new TextEncoder().encode(policy);
+        if (bytes.length > 8192) return yield* new AppViewUnavailable({ reason: "too-large" });
+        const label = `mcp-${yield* nonceId}`;
+        const expiry = String((yield* Clock.currentTimeMillis) + appViewLimits.capabilityTtlMs);
+        const payload = btoa(Array.from(bytes, (byte) => String.fromCharCode(byte)).join(""))
+          .replaceAll("+", "-")
+          .replaceAll("/", "_")
+          .replace(/=+$/, "");
+        const mac = yield* policySignature(label, expiry, payload);
+        return { label, token: `${expiry}.${payload}.${mac}` };
+      }),
+    verifySandboxPolicy: (label, token) =>
+      Effect.gen(function* () {
+        if (!/^mcp-[a-f0-9-]{36}$/.test(label) || token.length > 12000)
+          return yield* new AppViewUnavailable({ reason: "denied" });
+        const parts = token.split(".");
+        const expiry = parts[0],
+          payload = parts[1],
+          mac = parts[2];
+        const now = yield* Clock.currentTimeMillis;
+        if (
+          parts.length !== 3 ||
+          expiry === undefined ||
+          payload === undefined ||
+          mac === undefined ||
+          !/^[0-9]{1,16}$/.test(expiry) ||
+          !/^[A-Za-z0-9_-]*$/.test(payload) ||
+          Number(expiry) <= now ||
+          Number(expiry) > now + appViewLimits.capabilityTtlMs
+        )
+          return yield* new AppViewUnavailable({ reason: "denied" });
+        const expected = yield* policySignature(label, expiry, payload);
+        if (!sameMac(expected, mac)) return yield* new AppViewUnavailable({ reason: "denied" });
+        return yield* Effect.try({
+          try: () =>
+            new TextDecoder("utf-8", { fatal: true }).decode(
+              Uint8Array.from(
+                atob(payload.replaceAll("-", "+").replaceAll("_", "/")),
+                (character) => character.charCodeAt(0),
+              ),
+            ),
+          catch: () => new AppViewUnavailable({ reason: "denied" }),
+        });
+      }),
+    putObserved: (context, observed) =>
+      Effect.gen(function* () {
+        const value = yield* Schema.encodeEffect(ObservedAppView)(observed).pipe(
+          Effect.flatMap(Schema.decodeUnknownEffect(JsonObject)),
+          Effect.mapError(() => new StorageError()),
+        );
+        const bytes = new TextEncoder().encode(JSON.stringify(value)).byteLength;
+        if (bytes > appViewLimits.maxViewBytes)
+          return yield* new AppViewUnavailable({ reason: "too-large" });
+        const now = yield* Clock.currentTimeMillis;
+        const expiresAt = now + appViewLimits.ttlMs;
+        const id = AppViewId.make(
+          `app-view:${yield* crypto.randomUUIDv4.pipe(Effect.mapError(() => new StorageError()))}`,
+        );
+        const key = yield* scope(context);
+        const encrypted = yield* credentials.encrypt(id, Redacted.make(value));
+        yield* storage.cleanup(now);
+        const admitted = yield* storage.put({ id, scope: key, bytes, encrypted, now, expiresAt });
+        if (!admitted) return yield* new AppViewUnavailable({ reason: "capacity" });
+        return { id, app: observed.appName, expiresAt };
+      }),
+    release: (context, id) =>
+      scope(context).pipe(Effect.flatMap((key) => storage.release(key, id))),
+    cleanup: Clock.currentTimeMillis.pipe(Effect.flatMap(storage.cleanup)),
+    capability: (context, id) =>
+      Effect.gen(function* () {
+        const { expiresAt: viewExpiry } = yield* readAuthorized(context, id);
+        const key = yield* scope(context);
+        const expiresAt = String(
+          Math.min(viewExpiry, (yield* Clock.currentTimeMillis) + appViewLimits.capabilityTtlMs),
+        );
+        const nonce = `${yield* nonceId}${yield* nonceId}`;
+        const mac = yield* signature(key, id, expiresAt, nonce);
+        return `${expiresAt}.${nonce}.${mac}`;
+      }),
+    verify: (context, id, capability) =>
+      Effect.gen(function* () {
+        if (capability.length > 256) return yield* new AppViewUnavailable({ reason: "denied" });
+        const parts = capability.split(".");
+        const expiresAt = parts[0],
+          nonce = parts[1],
+          mac = parts[2];
+        const now = yield* Clock.currentTimeMillis;
+        if (
+          parts.length !== 3 ||
+          expiresAt === undefined ||
+          nonce === undefined ||
+          mac === undefined ||
+          !/^[0-9]{1,16}$/.test(expiresAt) ||
+          !/^[a-f0-9-]{72}$/.test(nonce) ||
+          !/^[a-f0-9]{64}$/.test(mac) ||
+          Number(expiresAt) <= now ||
+          Number(expiresAt) > now + appViewLimits.capabilityTtlMs
+        )
+          return yield* new AppViewUnavailable({ reason: "denied" });
+        const key = yield* scope(context);
+        const expected = yield* signature(key, id, expiresAt, nonce);
+        let difference = 0;
+        for (let index = 0; index < expected.length; index++)
+          difference |= expected.charCodeAt(index) ^ mac.charCodeAt(index);
+        if (difference !== 0) return yield* new AppViewUnavailable({ reason: "denied" });
+        yield* readAuthorized(context, id);
+      }),
+  };
+};
