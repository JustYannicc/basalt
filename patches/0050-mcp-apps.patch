+import {
+  applyDocumentTheme,
+  applyHostStyleVariables,
+  McpUiToolResultNotificationSchema,
+  App,
+  PostMessageTransport,
+} from "@modelcontextprotocol/ext-apps";
+import { AppBridge, buildAllowAttribute } from "@modelcontextprotocol/ext-apps/app-bridge";
+import { Schema } from "effect";
+import { AppBridgePayload, encodeAppResource } from "../contracts/app-bridge.ts";
+import { McpAppResources } from "apps/contracts";
+
+const mount = () => {
+  const app = new App({ name: "Executor app bridge", version: "1.0.0" }, {});
+  const status = document.createElement("div");
+  status.setAttribute("role", "status");
+  status.textContent = "Loading app…";
+  const label = document.createElement("span");
+  const controls = document.createElement("div");
+  const retry = document.createElement("button");
+  retry.textContent = "Try again";
+  retry.hidden = true;
+  const copy = document.createElement("button");
+  copy.textContent = "Copy text";
+  const close = document.createElement("button");
+  close.textContent = "Close";
+  const frame = document.createElement("iframe");
+  frame.title = "App";
+  frame.style.cssText = "display:none;width:100%;height:480px;border:0";
+  frame.sandbox.add("allow-scripts", "allow-same-origin", "allow-forms");
+  controls.append(label, copy, retry, close);
+  document.body.append(controls, status, frame);
+  let current: AppBridgePayload | undefined;
+  let bridge: AppBridge | undefined;
+  let generation = 0;
+  let viewId: string | undefined;
+  let loadTimeout: number | undefined;
+  let loading: AbortController | undefined;
+  const terminal = (state: unknown) => state === "expired" || state === "denied";
+  const checkAuthority = (result: { readonly _meta?: Record<string, unknown> | undefined }) => {
+    const state = result._meta?.["executor/app-state"];
+    if (terminal(state)) fail(state);
+  };
+  const fail = (state?: unknown) => {
+    generation++;
+    loading?.abort();
+    if (loadTimeout !== undefined) clearTimeout(loadTimeout);
+    void bridge?.close();
+    frame.removeAttribute("src");
+    frame.style.display = "none";
+    status.hidden = false;
+    retry.hidden = terminal(state);
+    retry.textContent = "Try again";
+    status.textContent =
+      state === "expired"
+        ? "This view has expired. The text result is still in the conversation."
+        : state === "denied"
+          ? "Access to this app was removed. The text result is still in the conversation."
+          : "This view could not load. You can try again without running the original tool. The text result is still in the conversation.";
+  };
+  const load = async (payload: AppBridgePayload) => {
+    loading?.abort();
+    const controller = new AbortController();
+    loading = controller;
+    const run = ++generation;
+    await bridge?.close();
+    if (controller.signal.aborted || run !== generation) return;
+    current = payload;
+    viewId = payload.view;
+    retry.hidden = true;
+    retry.textContent = "Try again";
+    if (loadTimeout !== undefined) clearTimeout(loadTimeout);
+    loadTimeout = window.setTimeout(() => {
+      if (run === generation) fail();
+    }, 15000);
+    label.textContent = payload.app;
+    frame.title = payload.app;
+    status.textContent = "Loading app…";
+    status.hidden = false;
+    frame.style.display = "none";
+    const allow = buildAllowAttribute(payload.policy.permissions);
+    if (allow) frame.setAttribute("allow", allow);
+    else frame.removeAttribute("allow");
+    updateContext();
+    const capabilities = app.getHostCapabilities();
+    const next = new AppBridge(
+      null,
+      { name: "Executor", version: "1.0.0" },
+      {
+        serverTools: {},
+        serverResources: {},
+        ...(capabilities?.openLinks === undefined ? {} : { openLinks: {} }),
+        ...(capabilities?.downloadFile === undefined ? {} : { downloadFile: {} }),
+        ...(capabilities?.updateModelContext === undefined
+          ? {}
+          : { updateModelContext: capabilities.updateModelContext }),
+      },
+      { hostContext: app.getHostContext() ?? { displayMode: "inline" } },
+    );
+    bridge = next;
+    next.oncalltool = async ({ name, arguments: input }, extra) => {
+      const result = await app.callServerTool(
+        {
+          name: "app-callback",
+          arguments: {
+            view: payload.view,
+            capability: payload.capability,
+            name,
+            input: input ?? {},
+          },
+        },
+        { signal: extra.signal },
+      );
+      checkAuthority(result);
+      return result;
+    };
+    next.onreadresource = async ({ uri }, extra) => {
+      if (capabilities?.serverResources !== undefined) {
+        try {
+          return await app.readServerResource(
+            { uri: payload.resourceBase + encodeAppResource(uri) },
+            { signal: extra.signal },
+          );
+        } catch (error) {
+          const denied = Schema.Struct({
+            data: Schema.Struct({ "executor/app-state": Schema.String }),
+          });
+          if (Schema.is(denied)(error)) checkAuthority({ _meta: error.data });
+          throw new Error("The app resource could not be read.");
+        }
+      }
+      const response = await app.callServerTool(
+        {
+          name: "app-resource",
+          arguments: {
+            view: payload.view,
+            capability: payload.capability,
+            uri,
+          },
+        },
+        { signal: extra.signal },
+      );
+      checkAuthority(response);
+      if (response.isError) throw new Error("The app resource could not be read.");
