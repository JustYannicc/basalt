diff --git a/e2e/support/mcp-app-browser.ts b/e2e/support/mcp-app-browser.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/mcp-app-browser.ts
@@ -0,0 +1,132 @@
+/** Effect owns each browser transition; the driver returns only observed values. */
+import { expect } from "@effect/vitest";
+import { Effect } from "effect";
+import type { Page } from "playwright";
+import { randomUUID } from "node:crypto";
+import type { Browser } from "./browser.ts";
+
+const renderer = (page: Page) => page.frameLocator('iframe[title="Executor view"]');
+const guest = (page: Page) =>
+  renderer(page).frameLocator("iframe").frameLocator('iframe[title="App content"]');
+const ready = (page: Page, text: RegExp) =>
+  guest(page).getByRole("status").filter({ hasText: text }).waitFor();
+
+export const renderMcpApp = (browser: Browser["Service"], peer: string) =>
+  Effect.gen(function* () {
+    const [headers] = yield* Effect.all(
+      [
+        browser.use("Read sandbox headers", (page) =>
+          page
+            .waitForResponse((response) =>
+              response.url().includes("/_executor/mcp-sandbox?policy="),
+            )
+            .then((response) => response.headers()),
+        ),
+        browser.use("Open the MCP Apps peer", (page) => page.goto(peer)),
+      ],
+      { concurrency: 2 },
+    );
+    yield* browser.use("Wait for the original app", (page) => ready(page, /^Ready$/));
+    expect(
+      yield* browser.use("Read original tool input", (page) =>
+        guest(page).locator("#input").textContent(),
+      ),
+    ).toBe("Original native input");
+    expect(
+      yield* browser.use("Read original native result", (page) =>
+        guest(page).locator("#result").textContent(),
+      ),
+    ).toBe("Original native input");
+    return headers;
+  });
+
+export const exerciseMcpApp = (browser: Browser["Service"], capability: string) =>
+  Effect.gen(function* () {
+    yield* browser.use("Write a local app draft", (page) =>
+      guest(page).getByRole("textbox", { name: "Draft" }).fill("Kept local draft"),
+    );
+    yield* browser.use("Trigger a native app error", (page) =>
+      guest(page).getByRole("button", { name: "Fail action" }).click(),
+    );
+    yield* browser.use("Read native app error", (page) => ready(page, /^Native app error$/));
+    expect(
+      yield* browser.use("Read the preserved draft", (page) =>
+        guest(page).getByRole("textbox", { name: "Draft" }).inputValue(),
+      ),
+    ).toBe("Kept local draft");
+    yield* browser.use("Read a source-bound resource", (page) =>
+      guest(page).getByRole("button", { name: "Read note" }).click(),
+    );
+    yield* browser.use("Receive the source note", (page) => ready(page, /^Alpha source note$/));
+    yield* browser.use("Save through native approval", (page) =>
+      guest(page).getByRole("button", { name: "Save", exact: true }).click(),
+    );
+    yield* browser.use("Receive the approved callback", (page) =>
+      ready(page, /^Kept local draft$/),
+    );
+    expect(
+      yield* browser.use("Read the saved draft", (page) =>
+        guest(page).getByRole("textbox", { name: "Draft" }).inputValue(),
+      ),
+    ).toBe("Kept local draft");
+    const isolated = yield* browser.use("Try reading the outer renderer", (page) =>
+      guest(page)
+        .locator("body")
+        .evaluate(() => {
+          try {
+            return window.parent.parent.document.body.textContent;
+          } catch {
+            return "blocked";
+          }
+        }),
+    );
+    expect(isolated).toBe("blocked");
+    expect(
+      yield* browser.use("Read guest content", (page) => guest(page).locator("body").textContent()),
+    ).not.toContain(capability);
+  });
+
+export const reopenMcpApp = (browser: Browser["Service"]) =>
+  Effect.gen(function* () {
+    yield* browser.use("Close the app", (page) =>
+      renderer(page).getByRole("button", { name: "Close", exact: true }).click(),
+    );
+    yield* browser.use("Read the closed view", (page) =>
+      renderer(page)
+        .getByRole("status")
+        .filter({ hasText: /View closed/ })
+        .waitFor(),
+    );
+    expect(
+      yield* browser.use("Check the sandbox was removed", (page) =>
+        renderer(page).locator("iframe").getAttribute("src"),
+      ),
+    ).toBeNull();
+    yield* browser.use("Reopen the retained view", (page) =>
+      renderer(page).getByRole("button", { name: "Open again", exact: true }).click(),
+    );
+    yield* browser.use("Wait for the reopened original app", (page) => ready(page, /^Ready$/));
+    expect(
+      yield* browser.use("Read reopened native input", (page) =>
+        guest(page).locator("#input").textContent(),
+      ),
+    ).toBe("Original native input");
+  });
+
+export const rejectForgedMcpPolicy = (browser: Browser["Service"], sandboxUrl: string) =>
+  Effect.gen(function* () {
+    const forged = new URL(sandboxUrl);
+    forged.searchParams.set("policy", `${forged.searchParams.get("policy")}x`);
+    expect(
+      yield* browser.use("Reject a forged sandbox policy", (page) =>
+        page.goto(forged.href).then((response) => response?.status()),
+      ),
+    ).toBe(403);
+    forged.href = sandboxUrl;
+    forged.hostname = `mcp-${randomUUID()}.${forged.hostname.split(".").slice(1).join(".")}`;
+    expect(
+      yield* browser.use("Reject a policy under another origin", (page) =>
+        page.goto(forged.href).then((response) => response?.status()),
+      ),
+    ).toBe(403);
+  });
diff --git a/e2e/support/mcp-app-fixture.ts b/e2e/support/mcp-app-fixture.ts
new file mode 100644
