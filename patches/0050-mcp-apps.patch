+      .then((result) => {
+        if (before !== generation) return;
+        if (result.isError) {
+          fail(result._meta?.["executor/app-state"]);
+          return;
+        }
+        return load(
+          Schema.decodeUnknownSync(AppBridgePayload)(result._meta?.["executor/app-view"]),
+        );
+      })
+      .catch(() => {
+        if (before === generation) fail();
+      })
+      .finally(() => {
+        retry.disabled = false;
+      });
+  };
