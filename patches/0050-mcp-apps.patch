+import { AppViewsHost, type Executor } from "@executor-js/sdk/core";
+import { Effect, Schema } from "effect";
+import { HttpServerRequest, HttpServerResponse } from "effect/http";
+import {
+  AppSandboxPolicy,
+  sandboxHeaders,
+  type AppSandboxAddress,
+} from "../contracts/app-sandbox.ts";
+import { appAssets } from "./app-assets.ts";
+
+export const appSandboxAddress = (base: string | undefined): AppSandboxAddress | undefined => {
+  if (base === undefined) return undefined;
+  const url = new URL(base);
+  return {
+    origin: (label) => `${url.protocol}//${label}.${url.host}`,
+    frameDomain: `${url.protocol}//*.${url.host}`,
+  };
+};
+export const appSandboxLabel = (
+  host: string | undefined,
+  address: AppSandboxAddress | undefined,
+) => {
+  if (host === undefined || address === undefined) return undefined;
+  const label = host.split(".")[0];
+  if (label === undefined || !/^mcp-[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/.test(label))
+    return undefined;
+  return new URL(address.origin(label)).host === host ? label : undefined;
+};
+
+/** This endpoint serves public static proxy bytes and an authenticated policy, never retained data. */
+export const appSandboxResponse = <E, R>(
+  executor: Effect.Effect<Executor, E, R>,
+  address: AppSandboxAddress | undefined,
+) =>
+  Effect.gen(function* () {
+    const request = yield* HttpServerRequest.HttpServerRequest;
+    const label = appSandboxLabel(request.headers.host, address);
+    const url = new URL(request.url, "http://sandbox.invalid");
+    const token = url.searchParams.get("policy");
+    if (
+      request.method !== "GET" ||
+      url.pathname !== "/_executor/mcp-sandbox" ||
+      label === undefined ||
+      token === null
+    )
+      return HttpServerResponse.empty({ status: 404, headers: { "cache-control": "no-store" } });
+    const store = (yield* executor)[AppViewsHost];
+    const signed = yield* store.verifySandboxPolicy(label, token);
+    const policy = yield* Schema.decodeUnknownEffect(AppSandboxPolicy)(JSON.parse(signed));
+    return HttpServerResponse.text(
+      `<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><style>html,body{margin:0;width:100%;height:100%;overflow:hidden}</style></head><body><script type="module">${appAssets.sandbox.replaceAll("</script", "<\\/script")}</script></body></html>`,
+      {
+        contentType: "text/html",
+        headers: sandboxHeaders(policy),
+      },
+    );
+  }).pipe(
+    Effect.catchCause(() =>
+      Effect.succeed(
+        HttpServerResponse.empty({ status: 403, headers: { "cache-control": "no-store" } }),
+      ),
+    ),
+  );
+
+export const appBridgeHtml = `<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><style>
+:root{color-scheme:light dark;font-family:var(--font-sans,system-ui,sans-serif);font-size:14px;color:light-dark(#171717,#ededed);background:light-dark(#fff,#101010)}*{box-sizing:border-box}body{margin:0}body>div:first-of-type{display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding:12px;border-bottom:1px solid light-dark(#e6e6e6,#303030)}body>div:first-of-type>span{flex:1;min-width:80px;overflow-wrap:anywhere}button{font:inherit;color:inherit;background:light-dark(#fff,#101010);border:1px solid light-dark(#e6e6e6,#303030);border-radius:7px;padding:7px 12px;min-height:36px;touch-action:manipulation}button:focus-visible{outline:2px solid currentColor;outline-offset:3px}[role=status]{padding:36px 22px;min-height:200px;max-width:500px;line-height:1.5}iframe{display:block}[hidden]{display:none!important}
+</style></head><body><script type="module">${appAssets.renderer.replaceAll("</script", "<\\/script")}</script></body></html>`;
