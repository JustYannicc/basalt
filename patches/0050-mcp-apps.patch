+/** Resolve resource and callback ownership from the original tool, never from a requested URI. */
+import { Effect } from "effect";
+import type { AppRouter, DynamicRouter } from "../contracts/router.ts";
+import { HostToolNotFound } from "../contracts/host.ts";
+import type { JsonValue } from "../contracts/schema.ts";
+import { joinPath, locate } from "./router.ts";
+
+const sourceName = (path: string, tool: string) =>
+  path === "" ? tool : tool.slice(path.length + 1);
+
+export const bindMcpAppSource = (
+  root: AppRouter | DynamicRouter | undefined,
+  tool: string,
+  input: JsonValue,
+) =>
+  Effect.gen(function* () {
+    const location = locate(root, tool);
+    if (location === undefined) return yield* new HostToolNotFound();
+    let node = root;
+    let rest = tool;
+    let path = "";
+    let owner: { readonly node: AppRouter | DynamicRouter; readonly path: string } | undefined;
+    while (node !== undefined) {
+      if (node.mcpApps !== undefined) owner = { node, path };
+      if (node.kind === "dynamic") break;
+      const dot = rest.indexOf(".");
+      if (dot < 0) break;
+      const key = rest.slice(0, dot);
+      const child = Object.hasOwn(node.children, key) ? node.children[key] : undefined;
+      if (child === undefined || (child.kind !== "router" && child.kind !== "dynamic")) break;
+      node = child;
+      path = joinPath(path, key);
+      rest = rest.slice(dot + 1);
+    }
+    if (owner?.node.mcpApps === undefined) return yield* new HostToolNotFound();
+    const bound = yield* owner.node.mcpApps.bind(input, sourceName(owner.path, tool));
+    const source = owner.path;
+    return {
+      source,
+      selection: bound.selection,
+      input: bound.input,
+      ...(bound.meta === undefined ? {} : { meta: bound.meta }),
+      read: bound.read,
+      callback: (name: string, input: JsonValue) => {
+        return bound.callback(name, input).pipe(
+          Effect.map((mapped) => ({
+            name: joinPath(source, mapped.name),
+            input: mapped.input,
+          })),
+        );
+      },
+    };
+  });
