+++ b/packages/apps/src/contracts/mcp-apps.ts
@@ -0,0 +1,77 @@
+/** MCP Apps resource bytes and the source that owns their tool namespace. */
+import { Context, Schema, type Effect } from "effect";
+import { JsonObject, JsonValue } from "./schema.ts";
+
+export const McpAppUiProfile = Context.Reference<boolean>("apps/McpAppUiProfile", {
+  defaultValue: () => false,
+});
+
+export const mcpAppResourceLimit = 2 * 1024 * 1024;
+
+export const McpAppResource = Schema.Struct({
+  uri: Schema.NonEmptyString,
+  mimeType: Schema.optionalKey(Schema.String),
+  text: Schema.optionalKey(Schema.String),
+  blob: Schema.optionalKey(Schema.String),
+  _meta: Schema.optionalKey(JsonObject),
+});
+export type McpAppResource = typeof McpAppResource.Type;
+
+export const McpAppResources = Schema.Struct({
+  contents: Schema.Array(McpAppResource),
+  _meta: Schema.optionalKey(JsonObject),
+});
+export type McpAppResources = typeof McpAppResources.Type;
+
+/** A bound source maps plain callback names back through the ordinary authorized tool path. */
+export interface BoundMcpAppSource {
+  readonly selection: JsonValue;
+  readonly meta?: JsonObject;
+  readonly input: JsonValue;
+  readonly read: (uri: string) => Effect.Effect<McpAppResources, unknown>;
+  readonly callback: (
+    name: string,
+    input: JsonValue,
+  ) => Effect.Effect<{ readonly name: string; readonly input: JsonValue }, unknown>;
+}
+
+/** Account composition binds this capability using the original, validated tool input. */
+export interface McpAppSource {
+  readonly bind: (input: JsonValue, tool: string) => Effect.Effect<BoundMcpAppSource, unknown>;
+}
+
+export const McpAppViewObservation = Schema.Struct({
+  source: Schema.String,
+  selection: JsonValue,
+  input: JsonObject,
+  resourceUri: Schema.NonEmptyString,
+});
+export type McpAppViewObservation = typeof McpAppViewObservation.Type;
+
+export const McpAppUi = Schema.Struct({
+  resourceUri: Schema.optionalKey(Schema.String),
+  visibility: Schema.Array(Schema.Literals(["model", "app"])),
+});
+export type McpAppUi = typeof McpAppUi.Type;
+
+/** Visibility defaults to both audiences; app-only tools never enter model discovery. */
+export const mcpAppToolUi = (meta: JsonObject | undefined) => {
+  const ui = meta?.ui;
+  if (!Schema.is(JsonObject)(ui)) return undefined;
+  const resourceUri =
+    typeof ui.resourceUri === "string" && ui.resourceUri.startsWith("ui://")
+      ? ui.resourceUri
+      : undefined;
+  const visibility = Array.isArray(ui.visibility)
+    ? ui.visibility.filter((audience) => audience === "model" || audience === "app")
+    : ["model", "app"];
+  return Schema.decodeUnknownSync(McpAppUi)({
+    ...(resourceUri === undefined ? {} : { resourceUri }),
+    visibility,
+  });
+};
+
+export const mcpAppUiFields = (meta: JsonObject | undefined) => {
+  const ui = mcpAppToolUi(meta);
+  return ui === undefined ? {} : { ui };
+};
