--- /dev/null
+++ b/packages/sdk/src/implementation/app-view-storage.ts
@@ -0,0 +1,70 @@
+/** Admission is serialized per principal and grant across all server processes. */
+import { Effect, Schema } from "effect";
+import type { SqlClient } from "effect/sql";
+import { StorageError } from "../contracts/shared.ts";
+import { appViewLimits } from "../contracts/app-views.ts";
+
+const Stored = Schema.Struct({
+  id: Schema.String,
+  encrypted: Schema.Uint8Array,
+  expiresAt: Schema.Number,
+});
+const Usage = Schema.Struct({ count: Schema.Number, bytes: Schema.Number });
+
+export const makeAppViewStorage = (sql: SqlClient.SqlClient) => {
+  const safe = <A, E, R>(effect: Effect.Effect<A, E, R>) =>
+    effect.pipe(Effect.mapError(() => new StorageError()));
+  const cleanup = (now: number) =>
+    sql`delete from executor_app_views where id in (
+    select id from executor_app_views where expires_at <= ${new Date(now)}
+    order by expires_at, id limit ${appViewLimits.cleanupBatch}
+  )`.pipe(Effect.asVoid, safe);
+  return {
+    cleanup,
+    put: (input: {
+      readonly id: string;
+      readonly scope: string;
+      readonly bytes: number;
+      readonly encrypted: Uint8Array;
+      readonly expiresAt: number;
+      readonly now: number;
+    }) =>
+      Effect.gen(function* () {
+        // The same advisory lock is available in Postgres and the local PGlite adapter.
+        yield* sql`select pg_advisory_xact_lock(hashtext('executor-app-view'), hashtext(${input.scope}::text))`;
+        yield* sql`delete from executor_app_views where scope = ${input.scope} and expires_at <= ${new Date(input.now)}`;
+        const rows =
+          yield* sql`select count(*)::float8 as count, coalesce(sum(bytes), 0)::float8 as bytes
+          from executor_app_views where scope = ${input.scope} and expires_at > ${new Date(input.now)}`.pipe(
+            Effect.flatMap(Schema.decodeUnknownEffect(Schema.Array(Usage))),
+          );
+        const used = rows[0];
+        if (used === undefined) return yield* new StorageError();
+        if (
+          used.count >= appViewLimits.maxViews ||
+          used.bytes + input.bytes > appViewLimits.maxBytes
+        )
+          return false;
+        yield* sql`insert into executor_app_views ${sql.insert({
+          id: input.id,
+          scope: input.scope,
+          bytes: input.bytes,
+          encrypted: input.encrypted,
+          expires_at: new Date(input.expiresAt),
+        })}`;
+        return true;
+      }).pipe(sql.withTransaction, safe),
+    read: (scope: string, id: string) =>
+      sql`select id, encrypted, extract(epoch from expires_at)::float8 * 1000 as "expiresAt"
+      from executor_app_views where id = ${id} and scope = ${scope}`.pipe(
+        Effect.flatMap(Schema.decodeUnknownEffect(Schema.Array(Stored))),
+        Effect.map((rows) => rows[0]),
+        safe,
+      ),
+    release: (scope: string, id: string) =>
+      sql`delete from executor_app_views where id = ${id} and scope = ${scope}`.pipe(
+        Effect.asVoid,
+        safe,
+      ),
+  };
+};
