+      html: payload.html,
+      ...(payload.policy.permissions === undefined
+        ? {}
+        : { permissions: payload.policy.permissions }),
+    });
+  };
+  app.ontoolinput = ({ arguments: input }) => {
+    if (typeof input?.view === "string") viewId = input.view;
+  };
+  app.ontoolresult = (result) => {
+    if (result.isError) {
+      fail(result._meta?.["executor/app-state"]);
+      return;
+    }
+    try {
+      void load(
+        Schema.decodeUnknownSync(AppBridgePayload)(result._meta?.["executor/app-view"]),
+      ).catch(fail);
+    } catch {
+      fail();
+    }
+  };
+  const updateContext = () => {
+    const context = app.getHostContext();
+    if (context?.theme !== undefined) applyDocumentTheme(context.theme);
+    if (context?.styles?.variables !== undefined) applyHostStyleVariables(context.styles.variables);
+    bridge?.setHostContext(context ?? {});
+  };
+  app.onhostcontextchanged = updateContext;
+  const teardown = async () => {
+    generation++;
+    loading?.abort();
+    if (loadTimeout !== undefined) clearTimeout(loadTimeout);
+    await bridge?.teardownResource({}, { timeout: 3000 }).catch(() => {});
+    await bridge?.close();
+    bridge = undefined;
+    frame.removeAttribute("src");
+    frame.style.display = "none";
+  };
