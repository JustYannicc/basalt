+    const text = current?.result.content
+      .flatMap((item) => (item.type === "text" ? [item.text] : []))
+      .join("\n");
+    if (text !== undefined)
+      void navigator.clipboard.writeText(text).catch(() => {
+        status.hidden = false;
+        status.textContent = "Could not copy. The text is in the conversation.";
+      });
+  };
+  close.onclick = () => {
+    status.hidden = false;
+    status.textContent = "Closing app…";
+    void teardown().then(() => {
+      status.textContent = "View closed. The text result is still in the conversation.";
+      retry.textContent = "Open again";
+      retry.hidden = false;
+    });
+  };
+  void app.connect().catch(fail);
+};
+mount();
