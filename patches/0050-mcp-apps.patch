+import { Schema } from "effect";
+import { AppSandboxPolicy } from "../contracts/app-sandbox.ts";
+import { buildAllowAttribute } from "@modelcontextprotocol/ext-apps/app-bridge";
+
+const mount = () => {
+  if (window.parent === window) throw new Error("The app sandbox requires a parent.");
+  const inner = document.createElement("iframe");
+  inner.title = "App content";
+  inner.style.cssText = "display:block;width:100%;height:100%;border:0";
+  inner.sandbox.add("allow-scripts", "allow-same-origin", "allow-forms");
+  document.body.append(inner);
+  let parentOrigin: string | undefined;
+  let loaded = false;
+  window.addEventListener("message", (event: MessageEvent<unknown>) => {
+    if (event.source === window.parent) {
+      if (parentOrigin !== undefined && event.origin !== parentOrigin) return;
+      if (typeof event.data !== "object" || event.data === null) return;
+      if (!("jsonrpc" in event.data) || event.data.jsonrpc !== "2.0") return;
+      if (parentOrigin === undefined) {
+        if (
+          !("method" in event.data) ||
+          event.data.method !== "ui/notifications/sandbox-resource-ready"
+        )
+          return;
+        parentOrigin = event.origin;
+      }
+      if (
+        "method" in event.data &&
+        event.data.method === "ui/notifications/sandbox-resource-ready"
+      ) {
+        if (
+          loaded ||
+          !("params" in event.data) ||
+          typeof event.data.params !== "object" ||
+          event.data.params === null ||
+          !("html" in event.data.params) ||
+          typeof event.data.params.html !== "string"
+        )
+          return;
+        loaded = true;
+        if ("permissions" in event.data.params) {
+          const policy = Schema.decodeUnknownSync(AppSandboxPolicy)(event.data.params);
+          const allow = buildAllowAttribute(policy.permissions);
+          if (allow) inner.setAttribute("allow", allow);
+        }
+        const doc = inner.contentDocument;
+        if (doc) {
+          doc.open();
+          doc.write(event.data.params.html);
+          doc.close();
+        }
+      } else inner.contentWindow?.postMessage(event.data, location.origin);
+    } else if (
+      event.source === inner.contentWindow &&
+      event.origin === location.origin &&
+      parentOrigin !== undefined
+    ) {
+      window.parent.postMessage(event.data, parentOrigin);
+    }
+  });
+  window.parent.postMessage(
+    { jsonrpc: "2.0", method: "ui/notifications/sandbox-proxy-ready", params: {} },
+    "*",
+  );
+};
+mount();
