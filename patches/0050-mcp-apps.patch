+        response._meta?.["executor/app-resource"],
+      );
+      return {
+        contents: resource.contents.map((item) => {
+          const common = {
+            uri: item.uri,
+            ...(item.mimeType === undefined ? {} : { mimeType: item.mimeType }),
+            ...(item._meta === undefined ? {} : { _meta: item._meta }),
+          };
+          if (item.text !== undefined) return { ...common, text: item.text };
+          if (item.blob !== undefined) return { ...common, blob: item.blob };
+          throw new Error("Resource has no content");
+        }),
+        ...(resource._meta === undefined ? {} : { _meta: resource._meta }),
+      };
+    };
+    next.onopenlink = async (params, extra) => {
+      const result = await app.openLink(params, { signal: extra.signal });
+      return result.isError === undefined ? {} : { isError: result.isError };
+    };
+    next.onmessage = async (params, extra) => {
+      const result = await app.sendMessage(params, { signal: extra.signal });
+      return result.isError === undefined ? {} : { isError: result.isError };
+    };
+    next.onupdatemodelcontext = (params, extra) =>
+      app.updateModelContext(params, { signal: extra.signal });
+    next.onrequestdisplaymode = (params, extra) =>
+      app.requestDisplayMode(params, { signal: extra.signal });
+    next.ondownloadfile = async (params, extra) => {
+      const result = await app.downloadFile(params, { signal: extra.signal });
+      return result.isError === undefined ? {} : { isError: result.isError };
+    };
+    next.onrequestteardown = () => {
+      void app.requestTeardown();
+    };
+    next.onsizechange = ({ height }) => {
+      if (height !== undefined && Number.isFinite(height))
+        frame.style.height = `${Math.max(100, Math.min(6000, height))}px`;
+    };
+    next.oninitialized = async () => {
+      if (run !== generation) return;
+      await next.sendToolInput({ arguments: payload.input });
+      await next.sendToolResult(
+        McpUiToolResultNotificationSchema.shape.params.parse(payload.result),
+      );
+      if (loadTimeout !== undefined) clearTimeout(loadTimeout);
+      status.hidden = true;
+      frame.style.display = "block";
+    };
+    const target = new URL(payload.sandboxUrl);
+    const ready = new Promise<void>((resolve, reject) => {
+      const cleanup = () => {
+        clearTimeout(timeout);
+        window.removeEventListener("message", receive);
+        controller.signal.removeEventListener("abort", abort);
+      };
+      const abort = () => {
+        cleanup();
+        resolve();
+      };
+      const timeout = window.setTimeout(() => {
+        cleanup();
+        reject(new Error("App sandbox timed out"));
+      }, 15000);
+      function receive(event: MessageEvent) {
+        if (
+          event.source === frame.contentWindow &&
+          event.origin === target.origin &&
+          event.data?.method === "ui/notifications/sandbox-proxy-ready"
+        ) {
+          cleanup();
+          resolve();
+        }
+      }
+      window.addEventListener("message", receive);
+      controller.signal.addEventListener("abort", abort, { once: true });
+    });
