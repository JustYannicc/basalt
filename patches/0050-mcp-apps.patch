+  btoa(Array.from(new TextEncoder().encode(uri), (byte) => String.fromCharCode(byte)).join(""))
+    .replaceAll("+", "-")
+    .replaceAll("/", "_")
+    .replace(/=+$/, "");
+export const decodeAppResource = (encoded: string) => {
+  if (encoded.length > 16384 || !/^[A-Za-z0-9_-]+$/.test(encoded))
+    throw new Error("Invalid app resource");
+  return new TextDecoder("utf-8", { fatal: true }).decode(
+    Uint8Array.from(atob(encoded.replaceAll("-", "+").replaceAll("_", "/")), (character) =>
+      character.charCodeAt(0),
+    ),
+  );
+};
diff --git a/packages/mcp/src/contracts/app-sandbox.ts b/packages/mcp/src/contracts/app-sandbox.ts
new file mode 100644
--- /dev/null
+++ b/packages/mcp/src/contracts/app-sandbox.ts
@@ -0,0 +1,49 @@
+import { Schema } from "effect";
+
+const Domain = Schema.String.check(
+  Schema.isPattern(/^(https?|wss?):\/\/(?:\*\.)?[a-zA-Z0-9.-]+(?::[0-9]+)?$/u),
+);
+const Domains = Schema.Array(Domain).check(Schema.isMaxLength(64));
+export const AppSandboxPolicy = Schema.Struct({
+  csp: Schema.optionalKey(
+    Schema.Struct({
+      connectDomains: Schema.optionalKey(Domains),
+      resourceDomains: Schema.optionalKey(Domains),
+      frameDomains: Schema.optionalKey(Domains),
+      baseUriDomains: Schema.optionalKey(Domains),
+    }),
+  ),
+  permissions: Schema.optionalKey(
+    Schema.Struct({
+      camera: Schema.optionalKey(Schema.Struct({})),
+      microphone: Schema.optionalKey(Schema.Struct({})),
+      geolocation: Schema.optionalKey(Schema.Struct({})),
+      clipboardWrite: Schema.optionalKey(Schema.Struct({})),
+    }),
+  ),
+});
+export type AppSandboxPolicy = typeof AppSandboxPolicy.Type;
+export interface AppSandboxAddress {
+  readonly origin: (label: string) => string;
+  readonly frameDomain: string;
+}
+
+export const sandboxHeaders = (policy: AppSandboxPolicy) => {
+  const resources = policy.csp?.resourceDomains?.join(" ") ?? "";
+  const connect = policy.csp?.connectDomains?.join(" ") || "'none'";
+  const frames = policy.csp?.frameDomains?.join(" ") ?? "";
+  const base = policy.csp?.baseUriDomains?.join(" ") || "'self'";
+  const permissions = policy.permissions;
+  return {
+    "content-security-policy": `default-src 'none'; script-src 'unsafe-inline' ${resources}; style-src 'unsafe-inline' ${resources}; img-src data: blob: ${resources}; font-src data: ${resources}; media-src data: blob: ${resources}; connect-src ${connect}; frame-src 'self' ${frames}; base-uri ${base}; object-src 'none'; form-action 'none'; worker-src 'none'`,
+    "permissions-policy": [
+      `camera=${permissions?.camera === undefined ? "()" : "(self)"}`,
+      `microphone=${permissions?.microphone === undefined ? "()" : "(self)"}`,
+      `geolocation=${permissions?.geolocation === undefined ? "()" : "(self)"}`,
+      `clipboard-write=${permissions?.clipboardWrite === undefined ? "()" : "(self)"}`,
+    ].join(", "),
+    "cache-control": "no-store",
+    "referrer-policy": "no-referrer",
+    "x-content-type-options": "nosniff",
+  };
+};
