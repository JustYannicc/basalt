diff --git a/scripts/build-mcp-apps.ts b/scripts/build-mcp-apps.ts
new file mode 100644
--- /dev/null
+++ b/scripts/build-mcp-apps.ts
@@ -0,0 +1,21 @@
+/** Embed the renderer so Workers and binaries serve the same bytes without runtime file reads. */
+if (process.versions.bun !== "1.4.2") throw new Error("Build MCP Apps assets with Bun 1.4.2.");
+const entries = ["renderer", "sandbox"] as const;
+const assets: Record<string, string> = {};
+for (const entry of entries) {
+  const result = await Bun.build({
+    entrypoints: [`packages/mcp/src/ui/${entry}.ts`],
+    target: "browser",
+    minify: true,
+  });
+  if (!result.success) throw new Error(result.logs.map(String).join("\n"));
+  const output = result.outputs[0];
+  if (!output) throw new Error("Missing MCP Apps bundle");
+  assets[entry] = await output.text();
+}
+const path = "packages/mcp/src/implementation/app-assets.ts";
+const generated = `// Generated by scripts/build-mcp-apps.ts.\nexport const appAssets = {\n${entries.map((entry) => `  ${entry}: ${JSON.stringify(assets[entry])},`).join("\n")}\n};\n`;
+if (process.argv.includes("--check")) {
+  if ((await Bun.file(path).text()) !== generated)
+    throw new Error("MCP Apps assets are stale. Run bun run mcp:apps.");
+} else await Bun.write(path, generated);
