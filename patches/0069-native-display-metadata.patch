@@ -0,0 +1,47 @@
+import type { GenericEndpointContext } from "@better-auth/core";
+import {
+  authCall,
+  type NativeGrantAccess,
+  type NativeGrantDisplay,
+  type NativePoolMetadata,
+} from "@executor-js/mcp-auth/oauth";
+import { APIError } from "better-auth/api";
+import { Effect, Schema } from "effect";
+
+const Account = Schema.Struct({
+  id: Schema.NonEmptyString,
+  name: Schema.optionalKey(Schema.NullOr(Schema.String)),
+  email: Schema.NonEmptyString,
+  emailVerified: Schema.Boolean,
+});
+
+/** Identity comes from the authenticated grant, never display input or a browser session. */
+export const nativeGrantDisplay = (
+  ctx: GenericEndpointContext,
+  access: NativeGrantAccess,
+  metadata: NativePoolMetadata | undefined,
+): Effect.Effect<NativeGrantDisplay | undefined, APIError> =>
+  Effect.gen(function* () {
+    // Retained pool Workers can authorize the grant before their display projection is deployed.
+    if (metadata === undefined) return undefined;
+    const row = yield* authCall(() =>
+      ctx.context.adapter.findOne({
+        model: "user",
+        where: [{ field: "id", value: access.userId }],
+      }),
+    );
+    const account = yield* Schema.decodeUnknownEffect(Account)(row).pipe(
+      Effect.mapError(() => new APIError("SERVICE_UNAVAILABLE")),
+    );
+    if (account.id !== access.userId || metadata.pool.id !== access.policy.pool)
+      return yield* Effect.fail(new APIError("UNAUTHORIZED"));
+    return {
+      account: {
+        name: account.name?.trim() || account.email,
+        email: account.email,
+        emailVerified: account.emailVerified,
+      },
+      pool: metadata.pool,
+      pools: access.policy.models ? metadata.pools : [],
+    };
+  });
