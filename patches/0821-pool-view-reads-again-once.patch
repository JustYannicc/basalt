--- /dev/null
+++ b/e2e/support/query-read-rounds.ts
@@ -0,0 +1,37 @@
+import { Effect, Schema } from "effect";
+
+/** The query read more than once under each of two requests in a row. */
+export class QueryReadAgain extends Schema.TaggedError<QueryReadAgain>()("QueryReadAgain", {
+  message: Schema.String,
+}) {}
+
+/**
+ * A pool view query reads with its accounts' shared facts and, by design, drops that answer and
+ * reads once more when the organization's change head moved during the read; the pool view
+ * cache reads once more again when the head it guards moved. Each read is one `sdk.data.query`
+ * directly under the request's server span.
+ */
+export const readRounds = (
+  spans: ReadonlyArray<{ readonly parentSpanId: string | null; readonly operationName: string }>,
+  server: string,
+) =>
+  spans.filter((span) => span.parentSpanId === server && span.operationName === "sdk.data.query")
+    .length;
+
+/**
+ * Asks a query again on a new request when its first request read more than once, since
+ * something outside the test can move the head mid-read. One such request is tolerated; the
+ * next must read once, so a product that always reads again is still caught.
+ */
+export const askWithOneReadAgain = <A, E, R>(
+  ask: (attempt: number) => Effect.Effect<{ readonly rounds: number; readonly answer: A }, E, R>,
+) =>
+  Effect.gen(function* () {
+    const first = yield* ask(0);
+    if (first.rounds === 1) return first.answer;
+    const second = yield* ask(1);
+    if (second.rounds === 1) return second.answer;
+    return yield* new QueryReadAgain({
+      message: `The query read again after its account head moved on two requests in a row (${first.rounds} and ${second.rounds} reads); one is tolerated`,
+    });
+  });
