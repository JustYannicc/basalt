diff --git a/apps/hosted/server/src/implementation/resource-directory.ts b/apps/hosted/server/src/implementation/resource-directory.ts
new file mode 100644
index 0000000..f623650
--- /dev/null
+++ b/apps/hosted/server/src/implementation/resource-directory.ts
@@ -0,0 +1,260 @@
+import {
+  AccountReadHost,
+  type AccountId,
+  type AppId,
+  type Provider,
+  type ProviderId,
+} from "@executor-js/sdk/core";
+import { permittedAppIds } from "@executor-js/authorization";
+import { Effect } from "effect";
+import { SqlClient } from "effect/sql";
+import { CurrentAuthorization } from "../contracts/authorization.ts";
+import { HostedExecutor } from "../contracts/executor.ts";
+import { CurrentOrganization } from "../contracts/organization.ts";
+import type { ResourceDirectory } from "../contracts/resource-access.ts";
+import { AccountListReads } from "./account-list-reads.ts";
+import { readAccountListLinks } from "./account-list-links.ts";
+import { accountListPhase } from "./account-list-timing.ts";
+import { readIdentityMetadata, visibleAccountStatuses } from "./account-identity.ts";
+import {
+  readObservationInspections,
+  visibleObservationHealth,
+} from "./account-observation-policy.ts";
+import { appLinkedAccounts, callerLinkedAccounts } from "./app-accounts.ts";
+import { appUiIndicators } from "./app-ui.ts";
+import { hostManagedAccounts } from "./host-managed-accounts.ts";
+import { linkedAccountSignIn } from "./account-sign-in.ts";
+import { recordedPools, projectSavedAccounts } from "./account-projection.ts";
+import { teamAppPending } from "./provisioning.ts";
+import {
+  policyDatabase,
+  currentResourceAuthority,
+  applicationAccesses,
+  accountAccesses,
+} from "./resource-policy.ts";
+
+/** Shared resource listing for the normal app/account lists and an explicit management view. */
+const projectResourceDirectory = <A, E, R>(
+  view: "available" | "managed" | "readable",
+  project: (directory: typeof ResourceDirectory.Type) => Effect.Effect<A, E, R>,
+  batch: boolean,
+) =>
+  Effect.gen(function* () {
+    const actor = yield* currentResourceAuthority;
+    const executor = yield* Effect.flatten(HostedExecutor);
+    const { owner } = yield* CurrentOrganization;
+    const policy = yield* CurrentAuthorization;
+    const apps = yield* executor.apps.list({ owner, ids: permittedAppIds(policy) });
+    const appPolicies = new Map(
+      (yield* applicationAccesses(
+        apps.map((app) => app.id),
+        actor,
+      )).map((access) => [access.app, access]),
+    );
+    const visibleApps = apps.flatMap((app) => {
+      const access = appPolicies.get(app.id);
+      return access !== undefined &&
+        (view === "readable"
+          ? access.canUse || access.canManage
+          : view === "managed"
+            ? access.canManage
+            : access.canUse)
+        ? [{ app, access }]
+        : [];
+    });
+    const indicated = new Map(
+      (yield* appUiIndicators(visibleApps.map(({ app }) => app))).map((app) => [app.id, app]),
+    );
+    const listedApps = visibleApps.map(({ app, access }) => {
+      return { app: indicated.get(app.id) ?? app, access };
+    });
+    const usableApps = listedApps.filter(({ access }) => access.canUse).map(({ app }) => app.id);
+    const links = yield* callerLinkedAccounts(usableApps);
+    const appLinked = yield* appLinkedAccounts(
+      yield* policyDatabase,
+      listedApps.map(({ app }) => app.id),
+    );
+    const appAccounts = new Map<AppId, Set<AccountId>>();
+    for (const link of appLinked) {
+      const accounts = appAccounts.get(link.app) ?? new Set<AccountId>();
+      accounts.add(link.id);
+      appAccounts.set(link.app, accounts);
+    }
+    const linked = new Set(links.map((link) => link.id));
+    const records = batch
+      ? yield* accountListPhase("links", readAccountListLinks(listedApps.map(({ app }) => app.id)))
+      : [];
+    const snapshot = batch
+      ? yield* accountListPhase(
+          "snapshot",
+          executor[AccountReadHost].read({
+            owner,
+            links: [
+              ...[...links, ...appLinked].map((link) => ({ account: link.id, app: link.app })),
+              ...records.map((record) => ({ account: record.account, app: record.app })),
+            ],
+          }),
+        )
+      : undefined;
+    const all = snapshot?.accounts ?? (yield* executor.accounts.list({ owner }));
+    const managed = yield* hostManagedAccounts(
+      executor,
+      yield* policyDatabase,
+      actor.organization,
+      all,
+    );
+    const accounts = all.filter(
+      (account) =>
+        !managed.has(account.id) && (policy.tools.kind === "all" || linked.has(account.id)),
+    );
+    const providers = new Map<ProviderId, Provider>();
+    // App-scoped links check the same saved accounts without a caller-specific link.
+    const directoryLinks = new Set(
+      [...links, ...appLinked].map((link) => `${link.id}\u0000${link.app}`),
+    );
+    const health = new Map(
+      (accounts.length === 0
+        ? []
+        : (snapshot?.health.map((entry) => ({
+            ...entry,
+            apps: entry.apps.filter((app) =>
+              directoryLinks.has(`${entry.account}\u0000${app.app}`),
+            ),
+          })) ??
+          (yield* executor.accounts.listHealth({
+            owner,
+            links: [...links, ...appLinked].map((link) => ({ account: link.id, app: link.app })),
+          })))
+      ).map((entry) => [entry.account, entry]),
+    );
+    const accountPolicies = new Map(
+      (yield* accountAccesses(
+        (snapshot === undefined ? accounts : all).map((account) => account.id),
+        actor,
+      )).map((access) => [access.account, access]),
+    );
+    const finish = Effect.gen(function* () {
+      const accountEntries = yield* Effect.forEach(accounts, (account) =>
+        Effect.gen(function* () {
+          const access = accountPolicies.get(account.id);
+          if (
+            access === undefined ||
+            !(view === "readable"
+              ? access.canUse || access.canManage
+              : view === "managed"
+                ? access.canManage
+                : access.canUse)
+          )
+            return [];
+          let provider = providers.get(account.provider);
+          if (provider === undefined) {
+            provider =
+              snapshot?.providers.get(account.provider) ??
+              (yield* executor.accounts.provider({ owner, account: account.id }));
+            providers.set(account.provider, provider);
+          }
+          const checks = health.get(account.id);
+          return [
+            checks === undefined
+              ? { account, access, provider }
+              : { account, access, provider, health: yield* visibleObservationHealth(checks) },
+          ];
+        }),
+      );
+      const listedAccounts = accountEntries.flat();
+      const listed = new Set(listedAccounts.map(({ account }) => account.id));
+      const providerOf = new Map(all.map((account) => [account.id, account.provider]));
+      const managedSignIns = new Map(
+        yield* Effect.forEach(
+          all.filter((account) => managed.has(account.id) && linked.has(account.id)),
+          (account) =>
+            linkedAccountSignIn(executor, owner, account.id).pipe(
+              Effect.map((state) => [account.id, state] as const),
+              Effect.catchTag("AccountNotFound", () =>
+                Effect.succeed([account.id, { state: "unavailable" as const }] as const),
+              ),
+            ),
+          { concurrency: 8 },
+        ),
+      );
+      const appEntries = listedApps.map(({ app, access }) => {
+        const shared = [...(appAccounts.get(app.id) ?? [])].filter((id) => !managed.has(id));
+        const own = [
+          ...new Set(links.filter((link) => link.app === app.id).map((link) => link.id)),
+        ];
+        // Host credentials satisfy the caller's requirements without being listed as theirs.
+        const hostManagedLinks = own.flatMap((account) => {
+          const provider = providerOf.get(account);
+          const state = managedSignIns.get(account);
+          return managed.has(account) && provider !== undefined
+            ? [
+                {
+                  account,
+                  provider,
+                  ...(state === undefined || state.state === "saved"
+                    ? {}
+                    : { problem: state.state }),
+                },
+              ]
+            : [];
+        });
+        return {
+          app,
+          access,
+          appAccountCount: shared.length,
+          appLinkedAccounts: shared.filter((id) => listed.has(id)),
+          linkedAccounts: own.filter((id) => !managed.has(id)),
+          ...(hostManagedLinks.length === 0 ? {} : { hostManagedLinks }),
+        };
+      });
+      const pendingApp =
+        policy.tools.kind === "all" && (view === "available" || actor.role !== "member")
+          ? yield* teamAppPending(
+              actor.organization,
+              (yield* executor.apps.list({ owner, name: "Executor" })).length > 0,
+            ).pipe(Effect.provideService(SqlClient.SqlClient, yield* policyDatabase))
+          : false;
+      return yield* project({
+        apps: appEntries,
+        accounts: yield* visibleAccountStatuses(listedAccounts),
+        pendingApp,
+      });
+    });
+    if (snapshot === undefined) return yield* finish;
+    const ids = all.map((account) => account.id);
+    const identity = yield* accountListPhase("identity", readIdentityMetadata(ids));
+    const pools = yield* recordedPools;
+    const observations = yield* accountListPhase(
+      "observations",
+      readObservationInspections(snapshot.health, actor, accountPolicies),
+    );
+    return yield* finish.pipe(
+      Effect.provideService(AccountListReads, {
+        owner,
+        actor,
+        snapshot,
+        apps: new Map(apps.map((app) => [app.id, app])),
+        appAccesses: appPolicies,
+        accountAccesses: accountPolicies,
+        userLinks: links,
+        records,
+        managed,
+        pools,
+        identity,
+        observations,
+      }),
+    );
+  });
+
+export const resourceDirectory = (view: "available" | "managed" | "readable" = "available") =>
+  projectResourceDirectory(view, (directory) => Effect.succeed(directory), false);
+
+export const savedAccountDirectory = (pool?: AppId) =>
+  accountListPhase(
+    "request",
+    projectResourceDirectory(
+      "readable",
+      (directory) => accountListPhase("projection", projectSavedAccounts(directory, pool)),
+      true,
+    ),
+  );
