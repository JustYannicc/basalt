+++ b/apps/hosted/server/src/implementation/account-list-timing.ts
@@ -0,0 +1,35 @@
+import { Clock, Effect, Option } from "effect";
+
+type AccountListPhase =
+  | "request"
+  | "snapshot"
+  | "links"
+  | "identity"
+  | "observations"
+  | "projection";
+
+/** Native Worker logs retain phase timing even when child spans export directly to the collector. */
+export const accountListPhase = <A, E, R>(phase: AccountListPhase, work: Effect.Effect<A, E, R>) =>
+  Effect.gen(function* () {
+    const start = yield* Clock.currentTimeNanos;
+    const span = yield* Effect.currentSpan.pipe(Effect.option);
+    return yield* work.pipe(
+      Effect.onExit(() =>
+        Effect.gen(function* () {
+          const durationMs = Math.max(
+            0,
+            Number((yield* Clock.currentTimeNanos) - start) / 1_000_000,
+          );
+          yield* Effect.logInfo("accounts.list.phase").pipe(
+            Effect.annotateLogs({
+              phase,
+              duration_ms: durationMs,
+              ...(Option.isSome(span)
+                ? { "executor.trace_id": span.value.traceId, "executor.span_id": span.value.spanId }
+                : {}),
+            }),
+          );
+        }),
+      ),
+    );
+  }).pipe(Effect.withSpan(`hosted.accounts.${phase}`));
