+import { Effect, Schema } from "effect";
+import type { AccountListSignIn, AccountReadHost } from "../contracts/account-read.ts";
+import { AccountTargetBinding, type MachineAccounts } from "../contracts/account-target.ts";
+import type { Executor } from "../contracts/executor.ts";
+import { Provider } from "../contracts/provider.ts";
+import { StorageError, type AccountId, type ProviderId } from "../contracts/shared.ts";
+import { StoredAccount, type Credentials } from "../contracts/storage.ts";
+import { accountGrantId } from "./account-identities.ts";
+import { accountSignInState } from "./account-sign-in.ts";
+import { query, type Query } from "./database.ts";
+import { interactiveBindings } from "./interactive-state.ts";
+
+/** Collection reads stay on the existing Query and retain no state beyond this request. */
+export const makeAccountRead = (
+  db: Query,
+  credentials: Credentials,
+  accounts: Pick<Executor["accounts"], "list" | "listHealth">,
+  machines: MachineAccounts | undefined,
+): AccountReadHost => ({
+  read: (input) =>
+    Effect.gen(function* () {
+      const listed = yield* accounts.list({ owner: input.owner });
+      if (listed.length === 0)
+        return {
+          accounts: [],
+          providers: new Map<ProviderId, Provider>(),
+          signIns: new Map<AccountId, AccountListSignIn>(),
+          acquired: new Set<AccountId>(),
+          health: [],
+        };
+      const ids = listed.map((account) => account.id);
+      const stored = yield* query(() =>
+        db.findMany("accounts", {
+          where: (b) => b.and(b("owner", "=", input.owner), b("id", "in", ids)),
+          orderBy: ["id", "asc"],
+        }),
+      ).pipe(
+        Effect.flatMap(Schema.decodeUnknownEffect(Schema.Array(StoredAccount))),
+        Effect.mapError(() => new StorageError()),
+      );
+      const present = new Set(stored.map((account) => account.id));
