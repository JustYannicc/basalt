@@ -0,0 +1,44 @@
+import { Clock, Effect, Redacted, Schema } from "effect";
+import type { AccountListSignIn } from "../contracts/account-read.ts";
+import { OAuthGrant } from "../contracts/oauth.ts";
+import type { Provider } from "../contracts/provider.ts";
+import type { Credentials, StoredAccount } from "../contracts/storage.ts";
+import { accountGrantId } from "./account-identities.ts";
+
+export interface SignInGrant {
+  readonly encrypted: Uint8Array;
+  readonly status: string;
+}
+
+/** Interpret retained sign-in state without renewing a grant or checking saved fields. */
+export const accountSignInState = (
+  account: Pick<StoredAccount, "id" | "oauthGrantId" | "method">,
+  provider: Provider | undefined,
+  grant: SignInGrant | undefined,
+  credentials: Credentials,
+): Effect.Effect<AccountListSignIn> =>
+  Effect.gen(function* () {
+    const method = provider?.definition.auth[account.method];
+    if (method === undefined) return { state: "unavailable" } as const;
+    if (method.type === "secrets" || method.type === "interactive")
+      return { state: "saved", reconnectAt: null } as const;
+    if (grant === undefined || grant.status === "reconnect") return { state: "reconnect" } as const;
+    const decoded = yield* credentials
+      .decrypt(accountGrantId(account), Redacted.make(grant.encrypted))
+      .pipe(
+        Effect.flatMap((value) => Schema.decodeUnknownEffect(OAuthGrant)(Redacted.value(value))),
+        Effect.option,
+      );
+    if (decoded._tag === "None") return { state: "unavailable" } as const;
+    const saved = decoded.value;
+    const reconnectAt =
+      saved.grant !== "client_credentials" &&
+      saved.refreshToken === undefined &&
+      saved.expiresAt !== undefined
+        ? new Date(saved.expiresAt)
+        : null;
+    const now = yield* Clock.currentTimeMillis;
+    return reconnectAt !== null && reconnectAt.getTime() <= now
+      ? ({ state: "reconnect" } as const)
+      : ({ state: "saved", reconnectAt } as const);
+  });
