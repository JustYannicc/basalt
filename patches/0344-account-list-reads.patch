diff --git a/e2e/tests/account-list-total-budget.spec.ts b/e2e/tests/account-list-total-budget.spec.ts
new file mode 100644
index 0000000..1d1718f
--- /dev/null
+++ b/e2e/tests/account-list-total-budget.spec.ts
@@ -0,0 +1,231 @@
+import { expect, layer } from "@effect/vitest";
+import { Clock, Effect, Layer, Schedule, Schema } from "effect";
+import { randomUUID } from "node:crypto";
+import { Api, SessionClients, body } from "../support/api.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { TestLive, withCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { Evidence, Telemetry } from "../support/evidence.ts";
+import { startControlledDevelopmentServer } from "../support/managed-server.ts";
+import { Target } from "../support/platform.ts";
+import { scenarios } from "../test-plan.ts";
+
+const source = `import { defineApp, defineProvider, secrets, object, string, router } from "apps";
+const service = defineProvider({ name: "Account list budget", auth: {
+  key: secrets({ label: "API key", fields: object({ token: string() }) })
+} });
+export default defineApp({ app: { accounts: { shared: service.many() } },
+  user: { accounts: { own: service.many() } } }, async () => ({ tools: router({}) }));`;
+
+const Rows = Schema.Array(
+  Schema.Struct({
+    id: Schema.String,
+    label: Schema.String,
+    bindings: Schema.Array(
+      Schema.Struct({ app: Schema.String, scope: Schema.String, requirement: Schema.String }),
+    ),
+  }),
+);
+const Counts = Schema.Struct({
+  operations: Schema.Array(Schema.Struct({ name: Schema.String, statements: Schema.Number })),
+});
+
+layer(TestLive, { excludeTestServices: true })("Accounts total query budget", (it) => {
+  it.effect(scenarios.accountListTotalBudget.title, (context) =>
+    withCase(
+      context,
+      Effect.gen(function* () {
+        const target = yield* Target;
+        const development = yield* startControlledDevelopmentServer(target);
+        const origin = development.metadata.origin;
+        const raw = yield* Api.pipe(
+          Effect.provide(Layer.fresh(Api.layer)),
+          Effect.provide(Layer.fresh(SessionClients.layer)),
+          Effect.provideService(Target, development),
+        );
+        const api = {
+          ...raw,
+          request: (...args: Parameters<typeof raw.request>) =>
+            raw.request(args[0], args[1], `${origin}${args[2]}`, args[3], {
+              origin,
+              ...args[4],
+            }),
+        };
+        const owner = yield* api.session();
+        expect((yield* api.request(owner, "POST", "/api/devtools/operator", {})).status).toBe(200);
+        const users = yield* body(
+          Schema.Struct({
+            users: Schema.Array(Schema.Struct({ id: Schema.String, email: Schema.String })),
+          }),
+          yield* api.request(owner, "GET", "/api/auth/admin/list-users"),
+        );
+        const developer = users.users.find((user) => user.email === "agent-agent@example.test");
+        if (developer === undefined) return yield* Effect.die("Development owner is missing");
+        expect(
+          (yield* api.request(owner, "POST", "/api/auth/admin/impersonate-user", {
+            userId: developer.id,
+          })).status,
+        ).toBe(200);
+        const organization = (yield* body(
+          Schema.Array(Schema.Struct({ id: Schema.String })),
+          yield* api.request(owner, "GET", "/api/auth/organization/list"),
+        ))[0];
+        if (organization === undefined)
+          return yield* Effect.die("Development organization is missing");
+        const prefix = `/api/organizations/${organization.id}`;
+        const apps: string[] = [];
+        const accounts: { id: string; label: string; app: string; scope: string }[] = [];
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* api.request(owner, "POST", "/api/devtools/statement-count", { within: [] });
+            for (const app of apps) yield* api.request(owner, "DELETE", `${prefix}/apps/${app}`);
+            for (const account of accounts)
+              yield* api.request(owner, "DELETE", `${prefix}/accounts/${account.id}`);
+          }).pipe(Effect.orDie),
+        );
+        for (let index = 0; index < 7; index++) {
+          const response = yield* api.request(owner, "POST", `${prefix}/apps/deploy`, {
+            name: `Budget app ${index}`,
+            files: [{ path: "index.ts", content: source }, appsManifest],
+          });
+          expect(response.status).toBe(200);
+          apps.push((yield* body(Resource, response)).id);
+        }
+        const create = (index: number) =>
+          Effect.gen(function* () {
+            const app = apps[index % apps.length]!;
+            const scope = index % 2 === 0 ? "user" : "app";
+            const requirement = scope === "user" ? "own" : "shared";
+            const started = yield* api.request(
+              owner,
+              "POST",
+              `${prefix}/apps/${app}/accounts/${scope}/${requirement}/connections`,
+              scope === "app"
+                ? { destination: { kind: "shared", audience: { kind: "everyone" } } }
+                : {},
+            );
+            expect(started.status, JSON.stringify(started.body)).toBe(200);
+            const connection = yield* body(Resource, started);
+            const label = `Synthetic account ${index}`;
+            const saved = yield* api.request(
+              owner,
+              "POST",
+              `${prefix}/connections/${connection.id}/submit`,
+              {
+                method: "key",
+                label,
+                fields: { token: `synthetic-${index}` },
+              },
+            );
+            expect(saved.status, JSON.stringify(saved.body)).toBe(200);
+            accounts.push({ id: (yield* body(Resource, saved)).id, label, app, scope });
+          });
+        const measure = Effect.gen(function* () {
+          expect(
+            (yield* api.request(owner, "POST", "/api/devtools/statement-count", {
+              within: ["http.server GET"],
+            })).status,
+          ).toBe(200);
+          const traceId = randomUUID().replaceAll("-", "");
+          const started = yield* Clock.currentTimeNanos;
+          const response = yield* api.request(
+            owner,
+            "GET",
+            `${prefix}/resources/accounts`,
+            undefined,
+            {
+              traceparent: `00-${traceId}-1234567890abcdef-01`,
+            },
+          );
+          const durationMs = Number((yield* Clock.currentTimeNanos) - started) / 1_000_000;
+          expect(response.status).toBe(200);
+          const rows = yield* body(Rows, response);
+          for (const account of accounts) {
+            const row = rows.find((row) => row.id === account.id);
+            expect(row?.label).toBe(account.label);
+            expect(row?.bindings).toEqual(
+              expect.arrayContaining([
+                expect.objectContaining({ app: account.app, scope: account.scope }),
+              ]),
+            );
+          }
+          const counts = yield* body(
+            Counts,
+            yield* api.request(owner, "GET", "/api/devtools/statement-count"),
+          );
+          return {
+            durationMs,
+            statements: counts.operations.reduce((sum, row) => sum + row.statements, 0),
+            operations: counts.operations,
+            accountCount: accounts.length,
+            traceId,
+          };
+        });
+        yield* create(0);
+        const small = yield* Effect.forEach([0, 1, 2], () => measure);
+        for (let index = 1; index < 35; index++) yield* create(index);
+        expect(accounts).toHaveLength(35);
+        const large = yield* Effect.forEach([0, 1, 2], () => measure);
+        const evidence = yield* Evidence;
+        yield* evidence.json("account-list-total-budget.json", { small, large });
+        const first = accounts[0]!;
+        const renamed = "Renamed after the list was read";
+        expect(
+          (yield* api.request(owner, "PATCH", `${prefix}/accounts/${first.id}`, {
+            label: renamed,
+            description: null,
+          })).status,
+        ).toBe(200);
+        const requirement = first.scope === "user" ? "own" : "shared";
+        expect(
+          (yield* api.request(
+            owner,
+            "DELETE",
+            `${prefix}/apps/${first.app}/accounts/${first.scope}/${requirement}/${first.id}`,
+          )).status,
+        ).toBe(200);
+        const after = yield* body(
+          Rows,
+          yield* api.request(owner, "GET", `${prefix}/resources/accounts`),
+        );
+        const changed = after.find((row) => row.id === first.id);
+        expect(changed?.label).toBe(renamed);
+        expect(changed?.bindings.some((binding) => binding.app === first.app)).toBe(false);
+        for (const sample of [...small, ...large]) expect(sample.statements).toBeGreaterThan(0);
+        expect(
+          Math.max(...large.map((sample) => sample.statements)),
+          "the complete 35-account GET stays within its query budget",
+        ).toBeLessThanOrEqual(100);
+        expect(
+          Math.max(...large.map((sample) => sample.statements)),
+          "account growth does not repeat reads for each row or app scope",
+        ).toBeLessThanOrEqual(Math.max(...small.map((sample) => sample.statements)) + 10);
+        const phases = ["request", "snapshot", "links", "identity", "observations", "projection"];
+        const telemetry = yield* Telemetry.pipe(
+          Effect.provide(Layer.fresh(Telemetry.layer)),
+          Effect.provideService(Target, development),
+        );
+        const trace = yield* telemetry.query(large[2]!.traceId).pipe(
+          Effect.flatMap((trace) =>
+            phases.every((phase) =>
+              trace.data.some(({ span }) => span.operationName === `hosted.accounts.${phase}`),
+            )
+              ? Effect.succeed(trace)
+              : Effect.fail(new Error("Accounts phase spans have not arrived")),
+          ),
+          Effect.retry({ schedule: Schedule.spaced("100 millis"), times: 100 }),
+        );
+        yield* evidence.json(
+          "account-list-phases.json",
+          trace.data
+            .filter(({ span }) => span.operationName.startsWith("hosted.accounts."))
+            .map(({ span }) => ({
+              name: span.operationName,
+              durationMs: span.durationMs,
+              status: span.status,
+            })),
+        );
+      }),
+    ),
+  );
+});
