+import type { Effect } from "effect";
+import type { Account, AccountHealth } from "./account.ts";
+import type { Provider } from "./provider.ts";
+import type { AccountId, AppId, OwnerId, ProviderId, StorageError } from "./shared.ts";
+
+export type AccountListSignIn =
+  | { readonly state: "saved"; readonly reconnectAt: Date | null }
+  | { readonly state: "reconnect" | "unavailable" };
+
+/** Request-owned account metadata. Products authorize and redact every outward view. */
+export interface AccountReadSnapshot {
+  readonly accounts: readonly Account[];
+  readonly providers: ReadonlyMap<ProviderId, Provider>;
+  readonly signIns: ReadonlyMap<AccountId, AccountListSignIn>;
+  readonly acquired: ReadonlySet<AccountId>;
+  readonly health: readonly AccountHealth[];
+}
+
+export const AccountReadHost = Symbol("executor.AccountReadHost");
+
+/** Host-only collection reads; no credentials or acquisition references leave the SDK. */
+export interface AccountReadHost {
+  readonly read: (input: {
+    readonly owner: OwnerId;
+    readonly links: readonly { readonly account: AccountId; readonly app: AppId }[];
+  }) => Effect.Effect<AccountReadSnapshot, StorageError>;
+}
