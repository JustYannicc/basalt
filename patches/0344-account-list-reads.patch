@@ -0,0 +1,40 @@
+import { AccountId, AppId, StorageError } from "@executor-js/sdk/core";
+import { Effect, Schema } from "effect";
+import { CurrentUserId } from "../contracts/auth.ts";
+import { policyDatabase } from "./resource-policy.ts";
+
+export const AccountLinkRecord = Schema.Struct({
+  requirement: Schema.NonEmptyString,
+  account: AccountId,
+  createdAt: Schema.Date,
+  contributed: Schema.Boolean,
+  linkedBy: Schema.String,
+  linkedByName: Schema.NullOr(Schema.String),
+});
+
+const ListLink = Schema.Struct({
+  ...AccountLinkRecord.fields,
+  app: AppId,
+  subject: Schema.NullOr(Schema.String),
+});
+export type AccountListLink = typeof ListLink.Type;
+
+/** Preserve each scope's native record order while loading visible apps together. */
+export const readAccountListLinks = (apps: readonly AppId[]) =>
+  Effect.gen(function* () {
+    if (apps.length === 0) return [];
+    const sql = yield* policyDatabase;
+    const user = yield* CurrentUserId;
+    return yield* sql`select l.app, l.subject, l.requirement, l.account, l.created_at as "createdAt",
+      l.linked_by as "linkedBy", u.name as "linkedByName",
+      coalesce(d.requirements::jsonb -> 'accounts' -> l.requirement ->> 'scope' = 'app'
+        and d.requirements::jsonb -> 'accounts' -> l.requirement ->> 'contributed' = 'true', false) as contributed
+      from hosted_app_account_links l left join "user" u on u.id = l.linked_by
+      join executor_apps a on a.id = l.app
+      left join executor_deployments d on d.id = a.active_deployment
+      where ${sql.in("l.app", apps)} and (l.subject is null or l.subject = ${user ?? ""})
+      order by l.app, l.requirement, l.created_at, l.account`.pipe(
+      Effect.flatMap(Schema.decodeUnknownEffect(Schema.Array(ListLink))),
+      Effect.mapError(() => new StorageError()),
+    );
+  });
