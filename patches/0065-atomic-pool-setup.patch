diff --git a/e2e/tests/pool-setup-atomic.spec.ts b/e2e/tests/pool-setup-atomic.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/pool-setup-atomic.spec.ts
@@ -0,0 +1,151 @@
+/** Hold the real setup transaction at metadata publication, then inspect public visibility. */
+import { expect, layer } from "@effect/vitest";
+import { Clock, Effect, Schema } from "effect";
+import { randomUUID } from "node:crypto";
+import { Api, body } from "../support/api.ts";
+import { Actors } from "../support/actors.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { cloudLocks } from "../support/cloud-locks.ts";
+import { Evidence } from "../support/evidence.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Pool setup publication", (it) => {
+  it.effect(scenarios.cloudPoolSetupAtomic.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          database = yield* cloudLocks,
+          evidence = yield* Evidence;
+        const suffix = randomUUID().replaceAll("-", "");
+        const slug = `atomic-pool-${suffix}`;
+        const fn = `pool_setup_${suffix}`;
+        const key = `pool-setup:${suffix}`;
+        const rows = (sql: string, params: readonly (string | number)[] = []) =>
+          database.run({ sql, params });
+        const deferJobs = (organization: string) =>
+          rows(
+            "update hosted_provisioning set available_at = now() + interval '1 day' where organization_id = $1 and status = 'queued'",
+            [organization],
+          );
+        // Any product request dispatches queued jobs. Keep this unrelated team's setup from
+        // racing cleanup, which cannot defer jobs that have already started.
+        yield* deferJobs(actors.organization.id);
+        // Only this team's pool metadata write waits. All calls still use the ordinary product.
+        yield* rows(`create function ${fn}() returns trigger language plpgsql as $$ begin
+      if new.slug = '${slug}' and coalesce(new.metadata::jsonb -> 'basaltPools', '{}'::jsonb) <> '{}'::jsonb then
+        perform pg_advisory_xact_lock(hashtextextended('${key}', 0));
+      end if; return new; end $$`);
+        yield* rows(
+          `create trigger ${fn} before update of metadata on organization for each row execute function ${fn}()`,
+        );
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* database.release;
+            yield* rows(`drop trigger if exists ${fn} on organization`);
+            yield* rows(`drop function if exists ${fn}()`);
+          }).pipe(Effect.orDie),
+        );
+        const held = yield* database.hold({
+          sql: "select pg_backend_pid() as pid, pg_advisory_xact_lock(hashtextextended($1, 0))",
+          params: [key],
+        });
+        const pid = held[0]?.pid;
+        expect(typeof pid).toBe("number");
+        const team = yield* body(
+          Schema.Struct({ id: Schema.String }),
+          yield* api.request(actors.owner, "POST", "/api/auth/organization/create", {
+            name: "Atomic pool evidence",
+            slug,
+            keepCurrentActiveOrganization: true,
+          }),
+        );
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* database.release;
+            // The managed lab has no deployed pool receiver for organization-removal notifications.
+            for (const organization of [team.id, actors.organization.id]) {
+              yield* deferJobs(organization);
+              yield* rows(
+                "update organization set metadata = (coalesce(metadata::jsonb, '{}'::jsonb) - 'basaltPools')::text where id = $1",
+                [organization],
+              );
+            }
+          }).pipe(Effect.orDie),
+        );
+        const prefix = `/api/organizations/${team.id}`;
+        const deadline = (yield* Clock.currentTimeMillis) + 60000;
+        while (true) {
+          const blocked = yield* rows(
+            "select pid from pg_stat_activity where $1::integer = any(pg_blocking_pids(pid))",
+            [Number(pid)],
+          );
+          if (blocked.length > 0) break;
+          expect(yield* Clock.currentTimeMillis).toBeLessThan(deadline);
+          yield* Effect.sleep("50 millis");
+        }
+        const Apps = Schema.Array(
+          Schema.Struct({
+            id: Schema.String,
+            copiedFrom: Schema.NullOr(Schema.Struct({ reference: Schema.String })),
+          }),
+        );
+        const list = () =>
+          api
+            .request(actors.owner, "GET", `${prefix}/apps`)
+            .pipe(Effect.flatMap((response) => body(Apps, response)));
+        const pool = (apps: typeof Apps.Type) =>
+          apps.find(
+            (app) =>
+              app.copiedFrom?.reference ===
+              "https://github.com/JustYannicc/basalt/tree/main/apps/pool",
+          );
+        const before = yield* list();
+        yield* evidence.json("blocked-pool-publication.json", {
+          apps: before,
+          blockedByOwnedTransaction: true,
+        });
+        expect(
+          pool(before),
+          "Pool must stay unpublished until its native link and metadata commit",
+        ).toBeUndefined();
+        yield* database.release;
+        let app = pool(yield* list());
+        while (app === undefined) {
+          expect(yield* Clock.currentTimeMillis).toBeLessThan(deadline);
+          yield* Effect.sleep("50 millis");
+          app = pool(yield* list());
+        }
+        const linked = yield* api.request(
+          actors.owner,
+          "GET",
+          `${prefix}/apps/${app.id}/accounts/app`,
+        );
+        expect(linked.status).toBe(200);
+        expect(linked.body).toEqual(
+          expect.arrayContaining([
+            expect.objectContaining({ requirement: "pool", hostManaged: true }),
+          ]),
+        );
+        const metadata = yield* rows(
+          "select metadata::jsonb -> 'basaltPools' as pools from organization where id = $1",
+          [team.id],
+        );
+        expect(Object.values(metadata[0]?.pools ?? {})).toEqual(
+          expect.arrayContaining([expect.objectContaining({ app: app.id })]),
+        );
+        yield* evidence.json("committed-pool-publication.json", {
+          app: app.id,
+          links: linked.body,
+          metadata,
+        });
+        // The member's separate session still cannot use this owner's private pool.
+        expect(
+          (yield* api.request(actors.member, "GET", `${prefix}/apps/${app.id}/accounts/app`))
+            .status,
+        ).toBe(403);
+      }),
+    ),
+  );
+});
