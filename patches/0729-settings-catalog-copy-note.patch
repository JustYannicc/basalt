--- /dev/null
+++ b/apps/hosted/web/src/implementation/pages/copied-from-note.tsx
@@ -0,0 +1,16 @@
+import { useAtomValue } from "@effect/atom-react";
+import type { App } from "@executor-js/sdk";
+import { AsyncResult } from "effect/reactivity";
+import { catalogUpdateAtom } from "../../contracts/apps.ts";
+import { copiedFromNote } from "../../contracts/catalog-copy.ts";
+import { useOrganizationRoute } from "../components/organization.tsx";
+
+/**
+ * How an installed copy changes, once the server says whether releases update it from the catalog.
+ * Until then it says nothing, rather than calling a catalog copy independent.
+ */
+export function CopiedFromNote({ app }: { readonly app: App }) {
+  const { organization } = useOrganizationRoute();
+  const status = useAtomValue(catalogUpdateAtom({ organization, app: app.id }));
+  return AsyncResult.isSuccess(status) ? copiedFromNote(status.value) : null;
+}
