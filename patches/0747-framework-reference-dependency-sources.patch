+/**
+ * A declaration's file, from the workspace's parent. A dependency is named from its last
+ * `node_modules`, so the reference and its digest do not depend on where the package store sits:
+ * that directory is new on every install.
+ */
+const referenceSource = (root, fileName) => {
+  const path = fileName.split("\\").join("/");
+  const dependency = path.lastIndexOf("/node_modules/");
+  return dependency === -1
+    ? relative(resolve(root, ".."), fileName).split("\\").join("/")
+    : path.slice(dependency + 1);
+};
