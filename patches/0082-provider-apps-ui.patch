+import { expect } from "@effect/vitest";
+import { Effect } from "effect";
+import { Actors } from "./actors.ts";
+import { Browser } from "./browser.ts";
+import { openInApp, openThroughBrowser } from "./in-app-navigation.ts";
+import { holdQuery } from "./query-transition.ts";
+
+/** Hold the real capability read before its first response, then fail and retry it. */
+export const providerMethodsUi = (app: string) =>
+  Effect.gen(function* () {
+    const actors = yield* Actors;
+    const browser = yield* Browser;
+    yield* browser.login(actors.owner);
+    const paths = [actors.organization.slug, actors.organization.id].map(
+      (organization) => `/api/organizations/${organization}/apps/${app}/accounts/methods`,
+    );
+    const first = yield* holdQuery(paths, "undeclared");
+    yield* openThroughBrowser(
+      "Open OpenAI while method availability is loading",
+      `/org/${actors.organization.slug}/apps/${app}?view=accounts`,
+    );
+    yield* first.requested;
+    yield* browser.use("The capability read visibly waits", (page) =>
+      page.getByText("Loading sign-in methods…", { exact: true }).waitFor({ state: "visible" }),
+    );
+    expect(
+      yield* browser.use("The capability read blocks connection", (page) =>
+        page.getByRole("button", { name: "Connect new account", exact: true }).isEnabled(),
+      ),
+    ).toBe(false);
+    yield* browser.checkpoint("OpenAI waits for host sign-in methods");
+    yield* first.release;
+    yield* browser.use("A failed capability read offers retry", (page) =>
+      page.getByRole("button", { name: "Retry", exact: true }).waitFor({ state: "visible" }),
+    );
+    expect(
+      yield* browser.use("The failed read keeps connection blocked", (page) =>
+        page.getByRole("button", { name: "Connect new account", exact: true }).isEnabled(),
+      ),
+    ).toBe(false);
+    yield* browser.checkpoint("OpenAI method failure stays actionable");
+    const retry = yield* holdQuery(paths, "continue");
+    yield* browser.use("Retry host sign-in methods", (page) =>
+      page.getByRole("button", { name: "Retry", exact: true }).click(),
+    );
+    yield* retry.requested;
+    expect(
+      yield* browser.use("Retry still blocks new connections", (page) =>
+        page.getByRole("button", { name: "Connect new account", exact: true }).isEnabled(),
+      ),
+    ).toBe(false);
+    yield* retry.release;
+    yield* browser.use("Only the successful host response enables connection", (page) =>
+      page
+        .getByRole("button", { name: "Connect new account", exact: true })
+        .and(page.locator(":enabled"))
+        .waitFor({ state: "visible" }),
+    );
+    yield* browser.checkpoint("OpenAI methods recover without a page reload");
+    const lightInk = yield* browser.use("Read the provider accent in light mode", (page) =>
+      page
+        .locator('.provider-icon[data-provider="openai"]')
+        .first()
+        .evaluate((element) => getComputedStyle(element).color),
+    );
+    yield* browser.use("Follow the system dark appearance", (page) =>
+      page.emulateMedia({ colorScheme: "dark" }),
+    );
+    const darkInk = yield* browser.use("Read the provider accent in dark mode", (page) =>
+      page
+        .locator('.provider-icon[data-provider="openai"]')
+        .first()
+        .evaluate((element) => getComputedStyle(element).color),
+    );
+    expect(darkInk).not.toBe(lightInk);
+    yield* browser.checkpoint("Provider identity follows dark appearance");
+    yield* browser.use("Restore light appearance", (page) =>
+      page.emulateMedia({ colorScheme: "light" }),
+    );
+    yield* openInApp(
+      "Leave the app before exercising its independent account lifecycle",
+      `/org/${actors.organization.slug}/connect`,
+    );
+  });
