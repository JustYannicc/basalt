+              content: `import { defineApp } from "apps";
+import { providers } from "./providers.ts";
+export default defineApp({ app: { accounts: { openai: providers.openai.many(), anthropic: providers.anthropic.many() } } }, {});`,
+            },
+          ],
+        });
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const pool = (yield* body(Resource, deployed)).id;
+        apps.push(pool);
+        for (const [lab, method] of [
+          ["openai", "codex"],
+          ["anthropic", "claude"],
