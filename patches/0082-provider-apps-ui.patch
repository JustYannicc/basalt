+
+/**
+ * What the host says about an app's requirement methods. Only the host knows whether it can
+ * connect or route a method now, so a dashboard never guesses: a method without a reason is
+ * available, as every method is for apps the host says nothing about.
+ */
+export interface RequirementMethods {
+  /** Why the host cannot connect or route this requirement's method now, in the user's words. */
+  readonly unavailable: (requirement: string, method: string) => string | undefined;
+  /** The name of the native, non-chat API a requirement's accounts serve, such as System One. */
+  readonly native: (requirement: string) => string | undefined;
+}
+
+/** A requirement's methods people can pick, OAuth first, without the host's own credentials. */
+export const requirementMethods = (requirement: AccountRequirement) =>
+  Object.entries(requirement.definition.auth)
+    .filter(([, method]) => method.type !== "secrets" || method.provisioned !== true)
