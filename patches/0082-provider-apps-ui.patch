+              creation: crypto.randomUUID(),
+              method: "apiKey",
+              fields: { token: "synthetic-tool-key" },
+            },
+          );
+          expect(toolKey.status, JSON.stringify(toolKey.body)).toBe(200);
+          const toolAccount = (yield* body(Resource, toolKey)).id;
+          accounts.push(toolAccount);
+          expect(
+            (yield* api.request(
