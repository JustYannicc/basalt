@@ -0,0 +1,124 @@
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Clock, Effect, FileSystem, Layer, Path, Ref, Schema } from "effect";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { createHmac, timingSafeEqual } from "node:crypto";
+import { createServer } from "node:http";
+
+const Source = Schema.Struct({
+  package: Schema.String,
+  files: Schema.Array(Schema.Struct({ path: Schema.String, content: Schema.String })),
+});
+const Acquisition = Schema.Struct({
+  action: Schema.String,
+  provider: Schema.String,
+  owner: Schema.String,
+  at: Schema.Number,
+  expiresAt: Schema.Number,
+});
+
+/** Provider packages stay unchanged; the extra consumer detects restrictions leaking to ordinary apps. */
+export const providerAppsCatalog = Effect.gen(function* () {
+  const fs = yield* FileSystem.FileSystem,
+    path = yield* Path.Path;
+  const sources = new Map<string, typeof Source.Type>();
+  for (const lab of ["openai", "anthropic"]) {
+    const content = yield* fs.readFileString(
+      path.resolve("..", "src/catalog/provider-apps", `${lab}.json`),
+    );
+    sources.set(lab, yield* Schema.decodeUnknownEffect(Schema.fromJsonString(Source))(content));
+  }
+  const openai = sources.get("openai")!;
+  const manifest = yield* Schema.decodeUnknownEffect(
+    Schema.fromJsonString(Schema.Record(Schema.String, Schema.Json)),
+  )(openai.files.find((file) => file.path === "package.json")!.content);
+  sources.set("openai-tools", {
+    package: "provider-openai-tools",
+    files: openai.files.map((file) =>
+      file.path === "package.json"
+        ? { ...file, content: JSON.stringify({ ...manifest, name: "provider-openai-tools" }) }
+        : file,
+    ),
+  });
+  const calls = yield* Ref.make<readonly (typeof Acquisition.Type)[]>([]);
+  const routes = Layer.mergeAll(
+    HttpRouter.add(
+      "GET",
+      "/catalog/index.json",
+      Effect.succeed(
+        HttpServerResponse.jsonUnsafe({
+          version: 1,
+          apps: [...sources].map(([lab, source]) => ({
+            id: `provider-${lab}`,
+            package: source.package,
+            name:
+              lab === "openai-tools"
+                ? "Ordinary OpenAI consumer"
+                : lab === "openai"
+                  ? "OpenAI"
+                  : "Anthropic",
+            description: "Reusable model provider accounts for pools.",
+            auth: [{ method: lab.startsWith("openai") ? "codex" : "claude", kind: "interactive" }],
+            icons: [],
+            source: `apps/provider-${lab}.json`,
+          })),
+        }),
+      ),
+    ),
+    ...[...sources].map(([lab, source]) =>
+      HttpRouter.add(
+        "GET",
+        `/catalog/apps/provider-${lab}.json`,
+        Effect.succeed(HttpServerResponse.jsonUnsafe(source)),
+      ),
+    ),
+    HttpRouter.add(
+      "POST",
+      "/pool/v1/account-acquisitions",
+      Effect.gen(function* () {
+        const { envelope } = yield* HttpServerRequest.schemaBodyJson(
+          Schema.Struct({ envelope: Schema.String }),
+        );
+        const [prefix, payload, signature, extra] = envelope.split(".");
+        if (
+          prefix !== "sbaa1" ||
+          payload === undefined ||
+          signature === undefined ||
+          extra !== undefined
+        )
+          return HttpServerResponse.empty({ status: 401 });
+        const expected = createHmac("sha256", Buffer.from("ab".repeat(32), "hex"))
+          .update(`${prefix}.${payload}`)
+          .digest();
+        const actual = Buffer.from(signature, "base64url");
+        if (actual.byteLength !== expected.byteLength || !timingSafeEqual(actual, expected))
+          return HttpServerResponse.empty({ status: 401 });
+        const input = yield* Schema.decodeUnknownEffect(Schema.fromJsonString(Acquisition))(
+          Buffer.from(payload, "base64url").toString(),
+        );
+        const now = yield* Clock.currentTimeMillis;
+        if (input.at > now || input.expiresAt <= now || input.expiresAt > input.at + 30_000)
+          return HttpServerResponse.empty({ status: 401 });
+        yield* Ref.update(calls, (items) => [...items, input]);
+        if (input.action === "start")
+          return HttpServerResponse.jsonUnsafe({
+            session: `synthetic-session-${input.provider}`,
+            paste: { label: "Callback URL" },
+          });
+        if (input.action === "status" || input.action === "submit")
+          return HttpServerResponse.jsonUnsafe({
+            state: "connected",
+            ref: `synthetic-private-${input.provider}`,
+          });
+        return HttpServerResponse.jsonUnsafe(null);
+      }),
+    ),
+  );
+  const context = yield* Layer.build(
+    HttpRouter.serve(routes, { disableLogger: true, disableListenLog: true }).pipe(
+      Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 })),
+    ),
+  );
+  const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(context));
+  if (!("port" in server.address)) return yield* Effect.die("Expected a loopback catalog");
+  return { origin: `http://127.0.0.1:${server.address.port}`, sources, calls: Ref.get(calls) };
+});
