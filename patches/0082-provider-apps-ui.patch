+              }),
+            ]),
+          );
+          expect(
+            (yield* api.request(actors.owner, "DELETE", `${poolPath}/${account}`)).status,
+          ).toBe(200);
+          expect(
+            (yield* api.request(actors.owner, "GET", `${prefix}/accounts/${account}`)).status,
