+        const api = yield* Api,
+          actors = yield* Actors,
+          catalog = yield* providerAppsCatalog;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const apps: string[] = [],
+          accounts: string[] = [];
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* serverControl("start");
+            for (const app of apps)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app}`);
+            for (const account of accounts)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`);
+          }).pipe(Effect.orDie),
+        );
+        yield* providerAccountProduct(catalog.origin, `${catalog.origin}/catalog/index.json`);
+        const entries = yield* body(
+          Catalog,
+          yield* api.request(actors.owner, "GET", "/api/catalog"),
+        );
+        expect(entries).toEqual(
+          expect.arrayContaining([
+            { id: "provider-openai", name: "OpenAI" },
+            { id: "provider-anthropic", name: "Anthropic" },
+          ]),
+        );
+        const canonical = catalog.sources
+          .get("openai")!
+          .files.find((file) => file.path === "providers.ts")!;
+        const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: "Pool with native provider requirements",
+          files: [
