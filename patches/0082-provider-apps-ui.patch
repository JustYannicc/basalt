+
+const Catalog = Schema.Array(Schema.Struct({ id: Schema.String, name: Schema.String }));
+const Methods = Schema.Struct({
+  unavailable: Schema.Array(
+    Schema.Struct({ requirement: Schema.String, method: Schema.String, reason: Schema.String }),
+  ),
+  native: Schema.Array(Schema.Struct({ requirement: Schema.String, name: Schema.String })),
