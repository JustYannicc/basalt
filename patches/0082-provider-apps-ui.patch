diff --git a/packages/ui/src/implementation/lib/provider-brand.ts b/packages/ui/src/implementation/lib/provider-brand.ts
new file mode 100644
index 00000000..ce7b13ad
--- /dev/null
+++ b/packages/ui/src/implementation/lib/provider-brand.ts
@@ -0,0 +1,55 @@
+/**
+ * Model providers' brand identity for their icon tiles. A brand only tints the tile behind the
+ * provider's own logo and gives a monogram when no logo loads; it never says anything about an
+ * account's health, which keeps its own status colours. The name always shows beside the tile.
+ */
+export interface ProviderBrand {
+  /** The `data-provider` value whose ink `dashboard.css` defines for light and dark. */
+  readonly key: string;
+  /** Shown when the provider's logo is missing or fails to load. */
+  readonly monogram: string;
+}
+
+const brand = (key: string, monogram: string): ProviderBrand => ({ key, monogram });
+const openai = brand("openai", "OA");
+const anthropic = brand("anthropic", "A");
+const gemini = brand("gemini", "G");
+const vertex = brand("vertex", "V");
+const antigravity = brand("antigravity", "AG");
+const kimi = brand("kimi", "K");
+const xai = brand("xai", "x");
+const devin = brand("devin", "D");
+const meta = brand("meta", "M");
+const jev = brand("jev", "J");
+const cloudflare = brand("cloudflare", "CF");
+
+/** Provider and product names as provider definitions and apps spell them, lowercased. */
+const brands: ReadonlyMap<string, ProviderBrand> = new Map([
+  ["openai", openai],
+  ["chatgpt", openai],
+  ["codex", openai],
+  ["anthropic", anthropic],
+  ["claude", anthropic],
+  ["gemini", gemini],
+  ["google gemini", gemini],
+  ["gemini cli", gemini],
+  ["google vertex ai", vertex],
+  ["vertex ai", vertex],
+  ["antigravity", antigravity],
+  ["kimi", kimi],
+  ["moonshot ai", kimi],
+  ["xai", xai],
+  ["grok", xai],
+  ["devin", devin],
+  ["cognition", devin],
+  ["meta", meta],
+  ["meta ai", meta],
+  ["jev", jev],
+  ["typesafe", jev],
+  ["cloudflare", cloudflare],
+  ["workers ai", cloudflare],
+]);
+
+/** The brand of a provider or app by its display name, or undefined for every other name. */
+export const providerBrand = (name: string): ProviderBrand | undefined =>
+  brands.get(name.toLowerCase().trim());
