+        expect(ordinary.status, JSON.stringify(ordinary.body)).toBe(200);
+        const ordinaryApp = (yield* body(Resource, ordinary)).id;
+        apps.push(ordinaryApp);
+        const ordinaryPath = `${prefix}/apps/${ordinaryApp}`;
+        const ordinaryMethods = yield* body(
+          Methods,
+          yield* api.request(actors.owner, "GET", `${ordinaryPath}/accounts/methods`),
+        );
+        expect(ordinaryMethods).toEqual({ unavailable: [], native: [] });
+        const key = yield* api.request(
+          actors.owner,
+          "POST",
+          `${ordinaryPath}/accounts/app/openai`,
+          {
+            creation: crypto.randomUUID(),
+            method: "apiKey",
+            fields: { token: "synthetic-ordinary-openai-key" },
+          },
+        );
+        expect(key.status, JSON.stringify(key.body)).toBe(200);
+        const keyAccount = (yield* body(Resource, key)).id;
+        accounts.push(keyAccount);
+        expect(
+          (yield* api.request(
+            actors.owner,
+            "PUT",
+            `${ordinaryPath}/accounts/app/openai/${keyAccount}`,
+          )).status,
+        ).toBe(200);
+      }),
+    ),
