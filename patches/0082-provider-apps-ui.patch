diff --git a/apps/hosted/server/src/implementation/provider-account-methods.ts b/apps/hosted/server/src/implementation/provider-account-methods.ts
new file mode 100644
index 00000000..f311100e
--- /dev/null
+++ b/apps/hosted/server/src/implementation/provider-account-methods.ts
@@ -0,0 +1,73 @@
+import {
+  AccountAcquisitionConfiguration,
+  AuthMethodInvalid,
+  identifyProvider,
+  StorageError,
+  type App,
+} from "@executor-js/sdk/core";
+import { providerDeclaration } from "apps/host";
+import { Crypto, Effect } from "effect";
+import type { AppAccountMethods } from "../contracts/app-accounts.ts";
+import { providers } from "./pool-provider-definitions.ts";
+import { providerCapabilities } from "./pool-provider-capabilities.ts";
+
+/** These restrictions describe model routing, not ordinary tool apps that use the same provider. */
+export const providerAccountMethods = (app: App) =>
+  Effect.gen(function* () {
+    const unavailable: Array<(typeof AppAccountMethods.Type)["unavailable"][number]> = [];
+    const native: Array<(typeof AppAccountMethods.Type)["native"][number]> = [];
+    const result = { unavailable, native };
+    if (
+      !Object.keys(providers).some((lab) => app.copiedFrom?.name === `provider-${lab}`) &&
+      app.copiedFrom?.reference !== "https://github.com/JustYannicc/basalt/tree/main/apps/pool"
+    )
+      return result;
+    const crypto = yield* Crypto.Crypto;
+    const { registrations } = yield* AccountAcquisitionConfiguration;
+    for (const [lab, provider] of Object.entries(providers)) {
+      const identified = yield* identifyProvider(yield* providerDeclaration(provider), crypto);
+      const capabilities = providerCapabilities.filter((capability) => capability.lab === lab);
+      for (const [requirement, slot] of Object.entries(app.requirements.accounts)) {
+        if (slot.provider !== identified.identity && slot.provider !== identified.legacy) continue;
+        for (const method of Object.keys(slot.definition.auth)) {
+          const capability = capabilities.find((candidate) => candidate.method === method);
+          const registered = registrations.filter(
+            (entry) => entry.current && entry.provider === slot.provider && entry.method === method,
+          );
+          const hostReady =
+            registered.length === 1 &&
+            registered[0]?.driver.id === "basalt-home" &&
+            registered[0].exposeHostReference === true;
+          if (capability?.connection === "unavailable" || capability === undefined || !hostReady) {
+            unavailable.push({
+              requirement,
+              method,
+              reason:
+                capability !== undefined && capability.connection !== "unavailable" && !hostReady
+                  ? "This host cannot connect this sign-in method right now."
+                  : lab === "cloudflare" && method === "oauth"
+                    ? "Cloudflare MCP sign-in connects tools. Model requests need Workers AI credentials."
+                    : "This connection method is not available for pools yet.",
+            });
+          }
+        }
+        if (capabilities.some((capability) => capability.protocol === "typesafe-systemone"))
+          native.push({ requirement, name: "System One" });
+      }
+    }
+    return result;
+  }).pipe(Effect.mapError(() => new StorageError()));
+
+export const requireProviderAccountMethod = (app: App, requirement: string, method: string) =>
+  Effect.gen(function* () {
+    const status = yield* providerAccountMethods(app);
+    if (
+      status.unavailable.some(
+        (entry) => entry.requirement === requirement && entry.method === method,
+      )
+    ) {
+      const slot = app.requirements.accounts[requirement];
+      if (slot !== undefined)
+        return yield* new AuthMethodInvalid({ provider: slot.provider, method });
+    }
+  });
