diff --git a/apps/hosted/cloud/src/infrastructure/site-release.ts b/apps/hosted/cloud/src/infrastructure/site-release.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/site-release.ts
@@ -0,0 +1,16 @@
+/** A new shell cannot name browser assets from a release whose migration failed. */
+import * as Output from "alchemy/Output";
+import { AlchemyContext } from "alchemy/AlchemyContext";
+import { Effect } from "effect";
+import { cloudSite } from "./site.ts";
+import { databaseInfrastructure } from "./database.ts";
+
+export const cloudSiteAfterMigrations = Effect.gen(function* () {
+  const site = yield* cloudSite;
+  const hash = (yield* AlchemyContext).dev
+    ? site.hash.output
+    : Output.all(site.hash.output, (yield* databaseInfrastructure).url).pipe(
+        Output.map(([build]) => build),
+      );
+  return { outdir: site.outdir, hash };
+});
