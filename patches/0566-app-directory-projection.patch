+++ b/packages/sdk/src/contracts/app-read.ts
@@ -0,0 +1,18 @@
+import type { Effect } from "effect";
+import type { App } from "./apps.ts";
+import type { AppId, OwnerId, StorageError } from "./shared.ts";
+
+/** Current configured-app fields, without the active version's immutable declarations. */
+export type AppMetadata = Omit<App, "requirements">;
+
+export const AppReadHost = Symbol("executor.AppReadHost");
+
+/** Products authorize metadata before hydrating the declarations their view displays. */
+export interface AppReadHost {
+  readonly list: (input: {
+    readonly owner: OwnerId;
+    readonly ids?: readonly AppId[] | undefined;
+    readonly name?: string | undefined;
+  }) => Effect.Effect<readonly AppMetadata[], StorageError>;
+  readonly hydrate: (apps: readonly AppMetadata[]) => Effect.Effect<readonly App[], StorageError>;
+}
