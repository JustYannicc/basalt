diff --git a/packages/sdk/src/implementation/app-read.ts b/packages/sdk/src/implementation/app-read.ts
new file mode 100644
index 0000000..8a5a303
--- /dev/null
+++ b/packages/sdk/src/implementation/app-read.ts
@@ -0,0 +1,112 @@
+import { Effect, Schema, Struct } from "effect";
+import type { AppReadHost, AppMetadata } from "../contracts/app-read.ts";
+import { AppRequirements } from "../contracts/apps.ts";
+import { AppCodeId, StorageError, VersionId } from "../contracts/shared.ts";
+import { StoredApp } from "../contracts/storage.ts";
+import { query, type Query } from "./database.ts";
+
+const maxEntries = 128;
+const maxBytes = 8 * 1024 * 1024;
+const maxEntryBytes = 512 * 1024;
+type Entry = { readonly requirements: AppRequirements; readonly bytes: number };
+// oxlint-disable-next-line executor/no-module-level-mutable-state -- completed credential-free declarations are immutable by scoped version identity; no request-owned I/O or authority is retained
+const completed = new Map<string, Entry>();
+
+const remember = (key: string, requirements: AppRequirements) => {
+  const bytes = new TextEncoder().encode(JSON.stringify(requirements)).byteLength;
+  if (bytes > maxEntryBytes) return;
+  completed.delete(key);
+  completed.set(key, { requirements, bytes });
+  let total = [...completed.values()].reduce((sum, entry) => sum + entry.bytes, 0);
+  while (completed.size > maxEntries || total > maxBytes) {
+    const oldest = completed.entries().next();
+    if (oldest.done) break;
+    total -= oldest.value[1].bytes;
+    completed.delete(oldest.value[0]);
+  }
+};
+
+const MetadataRow = Schema.Struct({
+  app: StoredApp,
+  deployment: Schema.NullOr(Schema.Struct({ id: VersionId })),
+});
+const RequirementsRow = Schema.Struct({
+  id: VersionId,
+  code: AppCodeId,
+  requirements: AppRequirements,
+});
+
+/** A metadata list always reads current owner, filters and active-version existence. */
+export const makeAppRead = (db: Query, origin: string | undefined): AppReadHost => {
+  const readState = (app: AppMetadata) => {
+    const key =
+      origin === undefined || app.activeVersion === null
+        ? undefined
+        : JSON.stringify([origin, app.owner, app.code, app.activeVersion]);
+    return { app, key, cached: key === undefined ? undefined : completed.get(key) };
+  };
+  return {
+    list: (input) =>
+      query(() =>
+        db.findMany("apps", {
+          join: (b) => b.deployment({ select: ["id"] }),
+          where: (b) =>
+            b.and(
+              b("owner", "=", input.owner),
+              input.ids === undefined ? true : b("id", "in", input.ids),
+              input.name === undefined ? true : b("name", "=", input.name),
+            ),
+          orderBy: ["id", "asc"],
+        }),
+      ).pipe(
+        Effect.flatMap((rows) =>
+          Schema.decodeUnknownEffect(Schema.Array(MetadataRow))(
+            rows.map(({ deployment, ...app }) => ({ app, deployment })),
+          ),
+        ),
+        Effect.mapError(() => new StorageError()),
+        Effect.flatMap((rows) =>
+          Effect.forEach(rows, (row) => {
+            if (row.app.activeVersion !== null && row.deployment?.id !== row.app.activeVersion)
+              return Effect.fail(new StorageError());
+            return Effect.succeed(Struct.omit(row.app, ["deploySequence", "activatedSequence"]));
+          }),
+        ),
+        Effect.withSpan("sdk.apps.listMetadata"),
+      ),
+    hydrate: (apps) =>
+      Effect.gen(function* () {
+        const states = apps.map(readState);
+        const missing = [
+          ...new Set(
+            states.flatMap(({ app, cached }) =>
+              app.activeVersion !== null && cached === undefined ? [app.activeVersion] : [],
+            ),
+          ),
+        ];
+        const rows =
+          missing.length === 0
+            ? []
+            : yield* query(() =>
+                db.findMany("deployments", {
+                  select: ["id", "code", "requirements"],
+                  where: (b) => b("id", "in", missing),
+                }),
+              ).pipe(
+                Effect.flatMap(Schema.decodeUnknownEffect(Schema.Array(RequirementsRow))),
+                Effect.mapError(() => new StorageError()),
+              );
+        const versions = new Map(rows.map((row) => [row.id, row]));
+        return yield* Effect.forEach(states, ({ app, key, cached }) => {
+          if (app.activeVersion === null)
+            return Effect.succeed({ ...app, requirements: { accounts: {} } });
+          if (cached !== undefined)
+            return Effect.succeed({ ...app, requirements: cached.requirements });
+          const row = versions.get(app.activeVersion);
+          if (row === undefined || row.code !== app.code) return Effect.fail(new StorageError());
+          if (key !== undefined) remember(key, row.requirements);
+          return Effect.succeed({ ...app, requirements: row.requirements });
+        });
+      }).pipe(Effect.withSpan("sdk.apps.hydrateDisplay")),
+  };
+};
