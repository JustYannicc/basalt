diff --git a/packages/sdk/src/implementation/oauth-consent-targets.ts b/packages/sdk/src/implementation/oauth-consent-targets.ts
new file mode 100644
--- /dev/null
+++ b/packages/sdk/src/implementation/oauth-consent-targets.ts
@@ -0,0 +1,58 @@
+import { Effect } from "effect";
+import { AccountConnectionTargetChanged } from "../contracts/account-connection.ts";
+import { OAuthCompletionFailed, type OAuthAttemptRecord } from "../contracts/oauth.ts";
+import { lockApp } from "./apps.ts";
+import { readConnection } from "./connection-state.ts";
+import { requireTargetProvider } from "./connection-target.ts";
+import type { Query } from "./database.ts";
+
+export const oauthConsentScopesGrew = (approved: readonly string[], current: readonly string[]) =>
+  current.some((scope) => !approved.includes(scope));
+
+/** Provider continuity does not carry a target's consent forward to newly requested access. */
+export const requireOAuthConsentTargets = (db: Query, attempt: typeof OAuthAttemptRecord.Type) =>
+  Effect.gen(function* () {
+    if (attempt.consentSource === undefined && (attempt.additionalConnections?.length ?? 0) === 0)
+      return;
+    const changed = () => new OAuthCompletionFailed({ reason: "grant_changed" });
+    const selections = [
+      { connection: attempt.connection, method: attempt.method },
+      ...(attempt.additionalConnections ?? []),
+    ];
+    const approved = attempt.consentTargets;
+    // A pre-upgrade pending batch has no per-target authorization proof; it needs fresh consent.
+    if (approved === undefined || approved.length !== selections.length) return yield* changed();
+    const rows = yield* Effect.forEach(selections, (selection) =>
+      readConnection(db, { connection: selection.connection, owner: attempt.owner }),
+    );
+    const targets = [...new Map(rows.map((row) => [row.target.app, row.target])).values()].sort(
+      (first, second) => first.app.localeCompare(second.app),
+    );
+    // Keep deployments behind these locks until the entire grant and every binding commit.
+    for (const target of targets)
+      yield* lockApp(db, { app: target.app, owner: target.owner }).pipe(
+        Effect.catchTag("AppNotFound", () =>
+          Effect.fail(
+            new AccountConnectionTargetChanged({
+              app: target.app,
+              requirement: target.requirement,
+            }),
+          ),
+        ),
+      );
+    for (let index = 0; index < selections.length; index++) {
+      const selection = selections[index]!;
+      const snapshot = approved.find(
+        (entry) => entry.connection === selection.connection && entry.method === selection.method,
+      );
+      const target = yield* requireTargetProvider(db, rows[index]!);
+      const method = target.definition.auth[selection.method];
+      if (
+        snapshot === undefined ||
+        method?.type !== "oauth2" ||
+        method.grant === "client_credentials" ||
+        oauthConsentScopesGrew(snapshot.scopes, method.scopes ?? [])
+      )
+        return yield* changed();
+    }
+  });
