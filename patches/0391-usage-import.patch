diff --git a/packages/sdk/src/implementation/worker-browser-exports.ts b/packages/sdk/src/implementation/worker-browser-exports.ts
new file mode 100644
--- /dev/null
+++ b/packages/sdk/src/implementation/worker-browser-exports.ts
@@ -0,0 +1,51 @@
+import type { InMemoryFileSystem } from "@cloudflare/worker-bundler";
+
+const object = (value: unknown): value is Record<string, unknown> =>
+  value !== null && typeof value === "object" && !Array.isArray(value);
+
+function target(value: unknown): string | null | undefined {
+  if (value === null) return null;
+  if (typeof value === "string") return value;
+  if (Array.isArray(value)) {
+    for (const entry of value) {
+      const found = target(entry);
+      if (found !== undefined) return found;
+    }
+  } else if (object(value)) {
+    for (const [condition, entry] of Object.entries(value)) {
+      if (!["browser", "import", "default"].includes(condition)) continue;
+      const found = target(entry);
+      if (found !== undefined) return found;
+    }
+  }
+}
+
+/** The pinned bundler also enables node; honor an explicit browser export without that condition. */
+export function browserExport(files: InMemoryFileSystem, specifier: string) {
+  const parts = specifier.split("/");
+  const count = specifier.startsWith("@") ? 2 : 1;
+  const name = parts.slice(0, count).join("/");
+  const root = `node_modules/${name}/`;
+  const manifest = files.read(`${root}package.json`);
+  if (manifest === null) return undefined;
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(manifest);
+  } catch {
+    return undefined;
+  }
+  if (!object(parsed) || !object(parsed.exports)) return undefined;
+  const subpath = parts.length === count ? "." : `./${parts.slice(count).join("/")}`;
+  const entry = parsed.exports[subpath] ?? (subpath === "." ? parsed.exports : undefined);
+  if (!object(entry) || !Object.hasOwn(entry, "browser")) return undefined;
+  const selected = target(entry);
+  if (
+    selected === undefined ||
+    selected === null ||
+    !selected.startsWith("./") ||
+    selected.split("/").includes("..") ||
+    files.read(`${root}${selected.slice(2)}`) === null
+  )
+    return { errors: [{ text: `The browser export for "${specifier}" is unavailable.` }] };
+  return { path: `${root}${selected.slice(2)}`, namespace: "virtual" };
+}
