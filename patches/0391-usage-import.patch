diff --git a/packages/sdk/src/implementation/worker-binary-files.ts b/packages/sdk/src/implementation/worker-binary-files.ts
new file mode 100644
--- /dev/null
+++ b/packages/sdk/src/implementation/worker-binary-files.ts
@@ -0,0 +1,14 @@
+import type { FileSystem, InMemoryFileSystem } from "@cloudflare/worker-bundler";
+
+/**
+ * worker-bundler probes package-export existence through its text-only read method.
+ * Binary files need an existence marker there; the WASM and browser asset loaders
+ * read their bytes from the original filesystem, never from this resolver view.
+ */
+export const binaryFilePaths = (filesystem: InMemoryFileSystem): FileSystem => ({
+  read: (path) => filesystem.read(path) ?? (filesystem.readBinary(path) === null ? null : ""),
+  write: (path, content) => filesystem.write(path, content),
+  delete: (path) => filesystem.delete(path),
+  list: (prefix) => filesystem.list(prefix),
+  flush: () => filesystem.flush(),
+});
