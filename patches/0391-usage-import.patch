--- /dev/null
+++ b/apps/hosted/web/src/implementation/pages/pool-import-usage.tsx
@@ -0,0 +1,49 @@
+import type { App, AppId } from "@executor-js/sdk";
+import { Button } from "@executor-js/ui/components/button";
+import { useQuery } from "@executor-js/ui/dashboard/context";
+import { Option } from "effect";
+import { AsyncResult } from "effect/reactivity";
+import { liveAppAtom } from "../../contracts/apps.ts";
+import { appUiError } from "../../contracts/app-ui.ts";
+import { useOrganizationRoute } from "../components/organization.tsx";
+import { useAppUiLocation } from "./app-screen.tsx";
+
+/** Settings and the pool screen open the same authenticated import flow. */
+export function PoolImportUsage({
+  app,
+  canUse,
+}: {
+  readonly app: AppId;
+  readonly canUse: boolean;
+}) {
+  const { organization } = useOrganizationRoute();
+  const query = useQuery(liveAppAtom({ organization, app }));
+  const current = Option.getOrUndefined(query.data);
+  if (!canUse || current === undefined || current.activeVersion === null) return null;
+  return <ImportLink app={current} />;
+}
+
+function ImportLink({ app }: { readonly app: App }) {
+  const { result, refresh } = useAppUiLocation(app);
+  if (AsyncResult.isFailure(result))
+    return (
+      <div className="flex flex-wrap items-center gap-2">
+        <span role="status" className="text-sm text-muted-foreground">
+          {appUiError(result.cause)}
+        </span>
+        <Button variant="outline" size="sm" onClick={refresh}>
+          Check import link
+        </Button>
+      </div>
+    );
+  if (!AsyncResult.isSuccess(result) || result.value.status !== "ready") return null;
+  const href = new URL(result.value.url);
+  href.hash = "usage-import";
+  return (
+    <Button variant="outline" size="sm" asChild>
+      <a href={href.href} target="_blank" rel="noopener noreferrer">
+        Import usage
+      </a>
+    </Button>
+  );
+}
