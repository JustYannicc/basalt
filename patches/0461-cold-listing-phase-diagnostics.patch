diff --git a/packages/sdk/src/implementation/app-telemetry.ts b/packages/sdk/src/implementation/app-telemetry.ts
new file mode 100644
index 0000000..8eb6a43
--- /dev/null
+++ b/packages/sdk/src/implementation/app-telemetry.ts
@@ -0,0 +1,69 @@
+import { Cause, Effect, Exit, Option, Schema, Scope } from "effect";
+import {
+  CurrentTelemetryConfig,
+  makeTelemetryForwarder,
+  TelemetryBatch,
+} from "@executor-js/telemetry";
+
+/** The runner can record cancellation even when the isolate cannot send its final batch. */
+export const invocationStatus = <A, E, R>(work: Effect.Effect<A, E, R>) =>
+  work.pipe(
+    Effect.onExit((exit) =>
+      Effect.annotateCurrentSpan(
+        "listing.phase.status",
+        Exit.isSuccess(exit)
+          ? "completed"
+          : Cause.hasInterrupts(exit.cause)
+            ? "interrupted"
+            : "failed",
+      ),
+    ),
+  );
+
+/** A listing may never return. Its partial records use the existing filtered return channel. */
+export const invocationTelemetry = (
+  source: { readonly app: string; readonly build: string },
+  waitUntil: (task: Promise<unknown>) => void,
+) =>
+  Effect.gen(function* () {
+    // Remote runners without exporter configuration keep the final-envelope return path.
+    if ((yield* CurrentTelemetryConfig)?.traces === undefined) return null;
+    const parent = yield* Effect.currentSpan.pipe(Effect.option);
+    if (Option.isNone(parent)) return null;
+    const services = yield* Effect.context<never>();
+    let closed = false;
+    const [, forward] = yield* Effect.acquireRelease(
+      Effect.gen(function* () {
+        const scope = yield* Scope.make();
+        return [scope, yield* makeTelemetryForwarder.pipe(Scope.provide(scope))] as const;
+      }),
+      ([scope], exit) =>
+        Effect.sync(() => {
+          closed = true;
+          // Collector shutdown must not hold a completed listing past discovery's cutoff.
+          waitUntil(Effect.runPromiseWith(services)(Scope.close(scope, exit)));
+        }),
+    );
+    const encoder = new TextEncoder();
+    let batches = 0;
+    let bytes = 0;
+    return (input: unknown) =>
+      Effect.runPromiseWith(services)(
+        Effect.suspend(() =>
+          closed || batches++ >= 64
+            ? Effect.void
+            : Schema.decodeUnknownEffect(TelemetryBatch)(input).pipe(
+                Effect.flatMap((batch) => {
+                  bytes += [...batch.traces, ...batch.logs].reduce(
+                    (total, body) => total + encoder.encode(body).byteLength,
+                    0,
+                  );
+                  return bytes > 2 * 1_048_576
+                    ? Effect.void
+                    : forward(batch, parent.value.traceId, source);
+                }),
+                Effect.catchCause(() => Effect.void),
+              ),
+        ),
+      );
+  });
