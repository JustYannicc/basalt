@@ -0,0 +1,127 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schedule, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { App } from "../support/contracts.ts";
+import { Evidence, Telemetry } from "../support/evidence.ts";
+import { McpClient } from "../support/mcp-client.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Completed = Schema.Struct({
+  status: Schema.Literal("completed"),
+  execution: Schema.Struct({ ok: Schema.Literal(true), value: Schema.Unknown }),
+  unavailableApps: Schema.Array(Schema.Struct({ app: Schema.String, reason: Schema.String })),
+});
+
+layer(HostedLive, { excludeTestServices: true })("Cold listing telemetry", (it) => {
+  it.effect(scenarios.coldListingTelemetry.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          evidence = yield* Evidence,
+          telemetry = yield* Telemetry;
+        const prefix = `/api/organizations/${actors.organization.id}/apps`;
+        const privateValue = "PRIVATE_COLD_LISTING_VALUE";
+        const deployed = yield* api.request(actors.owner, "POST", `${prefix}/deploy`, {
+          name: "Cold listing telemetry",
+          files: [
+            {
+              path: "index.ts",
+              content: `import { defineApp, string } from "apps";
+export default defineApp({}, async (ctx) => {
+  await ctx.cache.get({ key: "${privateValue}", schema: string(), freshFor: "1 minute", load: async () => {
+    await new Promise(resolve => setTimeout(resolve, 120000));
+    return "${privateValue}";
+  }});
+  return {};
+});`,
+            },
+            appsManifest,
+          ],
+        });
+        expect(deployed.status).toBe(200);
+        const app = yield* body(App, deployed);
+        yield* Effect.addFinalizer(() =>
+          api.request(actors.owner, "DELETE", `${prefix}/${app.id}`).pipe(Effect.orDie),
+        );
+        const key = yield* body(
+          Schema.Struct({ id: Schema.String, key: Schema.RedactedFromValue(Schema.String) }),
+          yield* api.request(actors.owner, "POST", "/api/auth/api-key/create", {
+            name: "Cold listing telemetry",
+          }),
+        );
+        yield* Effect.addFinalizer(() =>
+          api
+            .request(actors.owner, "POST", "/api/auth/api-key/delete", { keyId: key.id })
+            .pipe(Effect.orDie),
+        );
+        const client = yield* (yield* McpClient).connect(key.key, "cold-listing-telemetry", {
+          organization: actors.organization.id,
+        });
+        const searched = yield* client.use(
+          "Search while a cache loader is stuck",
+          (client, signal) =>
+            client.callTool(
+              {
+                name: "execute",
+                arguments: { code: 'return await tools.search({ query: "cold listing" });' },
+              },
+              undefined,
+              { signal },
+            ),
+        );
+        const completed = yield* Schema.decodeUnknownEffect(Completed)(searched.structuredContent);
+        expect(
+          completed.unavailableApps.some(
+            (entry) => entry.app === app.id && entry.reason.includes("AppDiscoveryTimedOut"),
+          ),
+        ).toBe(true);
+        const trace = (yield* evidence.requests).at(-1)?.traceId;
+        if (trace === undefined) return yield* Effect.die("Missing cold listing trace");
+        const partial = yield* telemetry.query(trace).pipe(
+          Effect.flatMap((result) =>
+            result.data.some(
+              ({ span }) =>
+                span.operationName === "app.listing.phase" &&
+                span.tags["executor.app.id"] === app.id &&
+                span.tags["listing.phase"] === "author-cache" &&
+                span.tags["listing.phase.status"] === "started",
+            )
+              ? Effect.succeed(result.data)
+              : Effect.fail(new Error("Missing active cold listing phase")),
+          ),
+          Effect.retry({ schedule: Schedule.spaced("500 millis"), times: 4 }),
+        );
+        expect(
+          partial.some(
+            ({ span }) =>
+              span.operationName === "mcp.discovery.cutoff" &&
+              span.tags["listing.phase.status"] === "timeout",
+          ),
+        ).toBe(true);
+        expect(
+          partial.some(
+            ({ span }) =>
+              span.operationName === "app.listing.phase" &&
+              span.tags["executor.app.id"] === app.id &&
+              span.tags["listing.phase"] === "evaluation" &&
+              span.tags["listing.phase.status"] === "completed",
+          ),
+        ).toBe(false);
+        expect(
+          partial.some(
+            ({ span }) =>
+              span.operationName === "app.cache.lease.state" &&
+              span.tags["cache.lease.state"] === "acquired",
+          ),
+        ).toBe(true);
+        expect(JSON.stringify(partial)).not.toContain(privateValue);
+        yield* evidence.json("cold-listing-partial-telemetry.json", partial);
+      }).pipe(Effect.provide(McpClient.layer)),
+    ),
+  );
+});
