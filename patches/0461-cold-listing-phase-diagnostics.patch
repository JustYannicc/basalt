new file mode 100644
index 0000000..de6316f
--- /dev/null
+++ b/packages/telemetry/src/listing-phase.ts
@@ -0,0 +1,48 @@
+import { Cause, Clock, Context, Effect, Exit } from "effect";
+
+export const ListingDiagnostics = Context.Reference<boolean>("telemetry/ListingDiagnostics", {
+  defaultValue: () => false,
+});
+
+type Phase =
+  | "evaluation"
+  | "cache-session"
+  | "author-cache"
+  | "invocation-fetch"
+  | "response-body"
+  | "response-release"
+  | "parse"
+  | "revision"
+  | "compile"
+  | "serialize"
+  | "cache-write";
+
+/** An ended start marker survives even when the work never returns its final span. */
+export const listingPhase = <A, E, R>(phase: Phase, work: Effect.Effect<A, E, R>) =>
+  Effect.gen(function* () {
+    if (!(yield* ListingDiagnostics)) return yield* work;
+    yield* Effect.void.pipe(
+      Effect.withSpan("app.listing.phase", {
+        attributes: { "listing.phase": phase, "listing.phase.status": "started" },
+      }),
+    );
+    const start = yield* Clock.currentTimeNanos;
+    return yield* work.pipe(
+      Effect.onExit((exit) =>
+        Effect.gen(function* () {
+          yield* Effect.annotateCurrentSpan({
+            "listing.phase.status": Exit.isSuccess(exit)
+              ? "completed"
+              : Cause.hasInterrupts(exit.cause)
+                ? "interrupted"
+                : "failed",
+            "listing.phase.duration_ms": Math.min(
+              60_000,
+              Math.max(0, Number((yield* Clock.currentTimeNanos) - start) / 1_000_000),
+            ),
+          });
+        }),
+      ),
+      Effect.withSpan("app.listing.phase", { attributes: { "listing.phase": phase } }),
+    );
+  });
