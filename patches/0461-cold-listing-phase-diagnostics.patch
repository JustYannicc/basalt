         const outcome = yield* execute(`try {
           await ${tool.path}(${JSON.stringify({ path: { organization: actors.organization.id }, body: { source: { kind: "mcp", name: "MCP import diagnostics", url } } })});
           return { unexpectedSuccess: true };
