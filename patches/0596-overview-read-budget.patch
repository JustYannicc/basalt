+++ b/apps/hosted/server/src/implementation/pool-usage-summary.ts
@@ -0,0 +1,45 @@
+import { StorageError, StorageHost, type AppId } from "@executor-js/sdk/core";
+import { Effect, Schema } from "effect";
+import { PoolUsageUnavailable } from "../contracts/pool-usage.ts";
+import type { PoolUsageOverviewReadInput } from "../contracts/pool-usage-summary.ts";
+import { readPool, sendPoolCommand } from "./pool-backend.ts";
+import { usageSeriesAccounts } from "./pool-usage-series-accounts.ts";
+import { appUiPhase } from "./app-ui-phase-timing.ts";
+import { HostedExecutor } from "../contracts/executor.ts";
+
+const trackedRead = <A, E, R>(read: Effect.Effect<A, E, R>) =>
+  Effect.gen(function* () {
+    const executor = yield* Effect.flatten(HostedExecutor);
+    return yield* executor[StorageHost].transaction(read);
+  });
+
+/** The manager lock and per-account inspection stay authoritative through the signed read. */
+export const poolUsageOverviewRead = (app: AppId, input: PoolUsageOverviewReadInput) =>
+  readPool(app, (pool) =>
+    Effect.gen(function* () {
+      const accounts = yield* usageSeriesAccounts(pool, undefined);
+      return yield* appUiPhase(
+        "overview-backend",
+        sendPoolCommand(
+          "poolUsageSummary",
+          {
+            pool: pool.pool,
+            organization: pool.organization,
+            user: pool.user,
+            input: {
+              ...input,
+              pool: pool.pool,
+              authority: { canManage: true, accounts, mappingProven: true },
+            },
+          },
+          Schema.Unknown,
+        ),
+      );
+    }),
+  ).pipe(
+    trackedRead,
+    Effect.catchTags({
+      SqlError: () => new StorageError(),
+      SchemaError: () => new PoolUsageUnavailable(),
+    }),
+  );
diff --git a/apps/hosted/server/src/implementation/pool-summary-app-ui.ts b/apps/hosted/server/src/implementation/pool-summary-app-ui.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-summary-app-ui.ts
@@ -0,0 +1,62 @@
+import { VersionId, type App } from "@executor-js/sdk/core";
+import { fullAuthority } from "@executor-js/authorization";
+import { appPrivateHeaders } from "apps/ui/auth";
+import { UiForbidden, UiUnauthorized } from "apps/ui/contracts";
+import { Effect, Schema } from "effect";
+import { HttpServerRequest, HttpServerResponse } from "effect/http";
+import { CurrentAuthorization } from "../contracts/authorization.ts";
+import { CurrentUserId } from "../contracts/auth.ts";
+import {
+  CurrentOrganization,
+  OrganizationForbidden,
+  type OrganizationAccess,
+} from "../contracts/organization.ts";
+import { PoolUsageOverviewReadInput } from "../contracts/pool-usage-summary.ts";
+import { poolUsageOverviewRead } from "./pool-usage-summary.ts";
+import { appUiPhase } from "./app-ui-phase-timing.ts";
+
+export const poolAppUsageSummaryPath = "/_executor/api/pool-usage/summary";
+const Request = Schema.Struct({ version: VersionId, input: PoolUsageOverviewReadInput });
+const json = (body: unknown, status = 200) =>
+  HttpServerResponse.jsonUnsafe(body, { status, headers: appPrivateHeaders });
+
+/** The app origin supplies the pool and current viewer; submitted authority is discarded. */
+export const poolAppUsageSummary = <E, R>(
+  authorize: Effect.Effect<
+    {
+      readonly app: Pick<App, "id" | "activeVersion">;
+      readonly access: OrganizationAccess & { readonly userId: string };
+    },
+    E,
+    R
+  >,
+) =>
+  Effect.gen(function* () {
+    const current = yield* appUiPhase("overview-authorize", authorize);
+    if (typeof current.access.userId !== "string" || !current.access.userId)
+      return json({ _tag: "UiUnauthorized" }, 401);
+    const payload = yield* HttpServerRequest.schemaBodyJson(Request).pipe(
+      Effect.catch(() => Effect.succeed(undefined)),
+    );
+    if (payload === undefined)
+      return json(
+        { error: "invalid_query", message: "Provide usage bounds and this page's version." },
+        400,
+      );
+    if (payload.version !== current.app.activeVersion)
+      return json({ _tag: "UiDeploymentChanged" }, 409);
+    const result = yield* poolUsageOverviewRead(current.app.id, payload.input).pipe(
+      Effect.provideService(CurrentOrganization, current.access),
+      Effect.provideService(CurrentUserId, current.access.userId),
+      Effect.provideService(CurrentAuthorization, fullAuthority),
+    );
+    return json(result);
+  }).pipe(
+    Effect.catch((error) => {
+      if (Schema.is(UiUnauthorized)(error))
+        return Effect.succeed(json({ _tag: "UiUnauthorized" }, 401));
+      if (Schema.is(UiForbidden)(error) || Schema.is(OrganizationForbidden)(error))
+        return Effect.succeed(json({ _tag: "UiForbidden" }, 403));
+      return Effect.succeed(json({ _tag: "UiFailed", reason: "unavailable" }, 503));
+    }),
+  );
