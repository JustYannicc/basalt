+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { randomBytes } from "node:crypto";
+import { Api, body } from "../support/api.ts";
+import { Actors } from "../support/actors.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { Evidence } from "../support/evidence.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { workflowStatusLogEvidence } from "../support/workflow-status-log-evidence.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Id = Schema.Struct({ id: Schema.String });
+const ActiveRun = Schema.Struct({
+  id: Schema.String,
+  status: Schema.Literals(["queued", "running", "waiting", "paused", "waitingForPause"]),
+});
+const source = `import {defineApp,workflow,object} from "apps";
+export default defineApp({}, {workflows:{park:workflow({input:object({})},async ctx=>{
+  await ctx.step.sleep("park","1 day");return {value:"synthetic-private-status-payload"};
+})}});`;
+const trace = () => randomBytes(16).toString("hex");
+const headers = (id: string) => ({ traceparent: `00-${id}-0123456789abcdef-01` });
+
+layer(RuntimeLive, { excludeTestServices: true })("Workflow status diagnostics", (it) => {
+  for (const [phase, scenario] of [
+    ["native_status", scenarios.workflowStatusNativeFailure],
+    ["decode_status", scenarios.workflowStatusDecodeFailure],
+    ["response_mapping", scenarios.workflowStatusResponseFailure],
+  ] as const) {
+    it.effect(scenario.title, (context) =>
+      withHostedHttpCase(
+        context,
+        Effect.gen(function* () {
+          const api = yield* Api,
+            actors = yield* Actors,
+            evidence = yield* Evidence;
+          const prefix = `/api/organizations/${actors.organization.id}`;
+          const created = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+            name: `Status ${phase}`,
+            files: [{ path: "index.ts", content: source }, appsManifest],
+          });
+          expect(created.status, JSON.stringify(created.body)).toBe(200);
+          const app = yield* body(Id, created);
+          const path = `${prefix}/apps/${app.id}`;
+          yield* Effect.addFinalizer(() =>
+            api.request(actors.owner, "DELETE", path).pipe(
+              Effect.tap((response) => Effect.sync(() => expect(response.status).toBe(200))),
+              Effect.orDie,
+            ),
+          );
+          const started = yield* api.request(actors.owner, "POST", `${path}/workflow-runs`, {
+            workflow: "park",
+            input: {},
+          });
+          expect(started.status, JSON.stringify(started.body)).toBe(200);
+          const run = yield* body(Id, started),
+            url = `${path}/workflow-runs/${run.id}`;
+          yield* Effect.addFinalizer(() =>
+            Effect.gen(function* () {
+              expect((yield* api.request(actors.owner, "POST", `${url}/terminate`)).status).toBe(
+                200,
+              );
+            }).pipe(Effect.orDie),
+          );
+          expect((yield* api.request(actors.owner, "GET", url)).status).toBe(200);
+          const directTrace = trace(),
+            batchTrace = trace(),
+            deniedTrace = trace(),
+            healthyTrace = trace(),
+            barrier = trace(),
+            invalidTrace = trace(),
+            invalidBatchTrace = trace();
+          const fault = { "x-executor-test-workflow-status-phase": phase };
+          const direct = yield* api.request(actors.owner, "GET", url, undefined, {
+            ...headers(directTrace),
+            ...fault,
+          });
+          const batch = yield* api.request(
+            actors.owner,
+            "POST",
+            "/api/dashboard/batch",
+            {
+              reads: [
+                {
+                  id: 1,
+                  group: "workflows",
+                  endpoint: "get",
+                  params: { organization: actors.organization.id, app: app.id, run: run.id },
+                  query: {},
+                  traceparent: headers(batchTrace).traceparent,
+                },
+              ],
+            },
+            fault,
+          );
+          expect(batch.status, JSON.stringify(batch.body)).toBe(200);
+          const denied = yield* api.request(actors.member, "GET", url, undefined, {
+            ...headers(deniedTrace),
+            ...fault,
+          });
+          expect(denied.status).toBe(403);
+          const invalid = yield* api.request(
+            actors.owner,
+            "GET",
+            `${prefix}/apps/invalid/workflow-runs/${run.id}`,
+            undefined,
+            headers(invalidTrace),
+          );
+          expect(invalid.status).toBe(400);
+          const invalidBatch = yield* api.request(actors.owner, "POST", "/api/dashboard/batch", {
+            reads: [
+              {
+                id: 2,
+                group: "workflows",
+                endpoint: "get",
+                params: { organization: actors.organization.id, app: "invalid", run: run.id },
+                query: {},
+                traceparent: headers(invalidBatchTrace).traceparent,
+              },
+            ],
+          });
+          expect(invalidBatch.status).toBe(200);
+          expect(
+            Schema.decodeUnknownSync(Schema.Struct({ status: Schema.Number }))(invalidBatch.body)
+              .status,
+          ).toBe(400);
+          const healthy = yield* api.request(
+            actors.owner,
+            "GET",
+            url,
+            undefined,
+            headers(healthyTrace),
+          );
+          expect(healthy.status, JSON.stringify(healthy.body)).toBe(200);
+          expect((yield* body(ActiveRun, healthy)).id).toBe(run.id);
