+import { ApiError } from "@executor-js/utils/api-error";
+import { HttpApiMiddleware } from "effect/http-api";
+/** A request's status phases never carry its workflow payload into diagnostics. */
+import { Context, type Cause, Effect, Schema } from "effect";
+
+export const WorkflowStatusPhase = Schema.Literals([
+  "native_status",
+  "decode_status",
+  "response_mapping",
+]);
+export type WorkflowStatusPhase = typeof WorkflowStatusPhase.Type;
+export const WorkflowStatusFault = Context.Reference<
+  (phase: WorkflowStatusPhase) => Effect.Effect<void>
+>("hosted/WorkflowStatusFault", { defaultValue: () => () => Effect.void });
+export const WorkflowStatusDiagnostic = Context.Reference<
+  (phase: WorkflowStatusPhase, cause: Cause.Cause<unknown>) => void
+>("hosted/WorkflowStatusDiagnostic", { defaultValue: () => () => {} });
+
+export const WorkflowStatusUnavailable = ApiError.define({
+  tag: "WorkflowStatusUnavailable",
+  status: 503,
+  message:
+    "This run's status could not be read. Try reading it again; the run has not been restarted.",
+});
+export type WorkflowStatusUnavailable = typeof WorkflowStatusUnavailable.Type;
+export class ObserveWorkflowStatus extends HttpApiMiddleware.Service<ObserveWorkflowStatus>()(
+  "hosted/ObserveWorkflowStatus",
+  { error: WorkflowStatusUnavailable },
+) {}
