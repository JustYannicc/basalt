index 0000000..be9bc4e
--- /dev/null
+++ b/e2e/support/workflow-status-log-evidence.ts
@@ -0,0 +1,57 @@
+/** Wait for a later request's native log as an append barrier, then inspect the earlier record. */
+import { Effect, FileSystem, Option, Schema } from "effect";
+import { HttpClient, HttpClientRequest } from "effect/http";
+import { CloudLogRevision } from "./cloud-log-activity.ts";
+import { Target } from "./platform.ts";
+
+const Record = Schema.Struct({
+  message: Schema.String,
+  annotations: Schema.Record(Schema.String, Schema.Unknown),
+});
+export const workflowStatusLogEvidence = (barrier: string) =>
+  Effect.gen(function* () {
+    const target = yield* Target,
+      fs = yield* FileSystem.FileSystem,
+      http = yield* HttpClient.HttpClient;
+    const fixtures = target.fixtures;
+    if (fixtures === undefined) return yield* Effect.die("Managed Cloud logs required");
+    const revision = (after?: number) =>
+      Effect.scoped(
+        Effect.gen(function* () {
+          const request = yield* HttpClientRequest.post(
+            `${fixtures.origin}/runtime/cloud-log`,
+          ).pipe(
+            HttpClientRequest.bearerToken(fixtures.token),
+            HttpClientRequest.bodyJson(after === undefined ? {} : { after }),
+          );
+          const response = yield* http.execute(request);
+          return (yield* response.json.pipe(
+            Effect.flatMap(Schema.decodeUnknownEffect(CloudLogRevision)),
+          )).revision;
+        }),
+      );
+    let after = yield* revision();
+    for (;;) {
+      const text = yield* fs.readFileString(`${target.directory}/cloud.log`);
+      const records = text.split("\n").flatMap((line) => {
+        const start = line.indexOf('{"message":');
+        if (start < 0) return [];
+        try {
+          const value: unknown = JSON.parse(line.slice(start));
+          const parsed = Schema.decodeUnknownOption(Record)(value);
+          return Option.isSome(parsed) ? [parsed.value] : [];
+        } catch {
+          return [];
+        }
+      });
+      if (
+        records.some(
+          (record) =>
+            record.message === "executor.request.context" &&
+            record.annotations["executor.trace_id"] === barrier,
+        )
+      )
+        return records;
+      after = yield* revision(after);
+    }
+  }).pipe(Effect.timeout("10 seconds"));
