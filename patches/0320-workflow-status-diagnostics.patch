new file mode 100644
index 0000000..389573a
--- /dev/null
+++ b/apps/hosted/server/src/implementation/workflow-status.ts
@@ -0,0 +1,74 @@
+import { isRequestRejection } from "@executor-js/telemetry/http";
+import { Cause, Console, Effect, Layer, Option, Schema, SchemaAST } from "effect";
+import {
+  ObserveWorkflowStatus,
+  WorkflowStatusDiagnostic,
+  WorkflowStatusUnavailable,
+  type WorkflowStatusPhase,
+} from "../contracts/workflow-status.ts";
+
+const KnownFailure = Schema.Struct({
+  _tag: Schema.Literals([
+    "SchemaError",
+    "WorkflowFailure",
+    "StorageError",
+    "SqlError",
+    "TimeoutError",
+    "HttpApiSchemaError",
+    "DecryptError",
+    "CryptoError",
+  ]),
+});
+
+const exceptionClass = (error: unknown) => {
+  if (Schema.is(KnownFailure)(error)) return error._tag;
+  if (error instanceof TypeError) return "TypeError";
+  if (error instanceof SyntaxError) return "SyntaxError";
+  if (error instanceof RangeError) return "RangeError";
+  if (error instanceof Error) return "Error";
+  return "UnrecognizedFailure";
+};
+
+const clientRejection = (error: unknown) => {
+  if (isRequestRejection(error)) return true;
+  if (!(error instanceof Error) || !Schema.isSchema(error.constructor)) return false;
+  const status = SchemaAST.resolveAt<unknown>("httpApiStatus")(error.constructor.ast);
+  return typeof status === "number" && status >= 400 && status < 500;
+};
+
+/** Endpoint middleware also surrounds dashboard-batch calls and response encoding. */
+export const observeWorkflowStatusLive = Layer.succeed(ObserveWorkflowStatus, (response) =>
+  Effect.gen(function* () {
+    const span = yield* Effect.currentSpan.pipe(Effect.option);
+    let diagnostic: { readonly phase: WorkflowStatusPhase; readonly exception: string } | undefined;
+    return yield* response.pipe(
+      Effect.provideService(WorkflowStatusDiagnostic, (phase, cause) => {
+        diagnostic = { phase, exception: exceptionClass(Cause.squash(cause)) };
+      }),
+      Effect.catchCause((cause) =>
+        Effect.gen(function* () {
+          if (Cause.hasInterrupts(cause) || clientRejection(Cause.squash(cause)))
+            return yield* Effect.failCause(cause);
+          const record = diagnostic ?? {
+            phase: "response_mapping" as const,
+            exception: exceptionClass(Cause.squash(cause)),
+          };
+          const trace =
+            Option.isSome(span) && /^[0-9a-f]{32}$/.test(span.value.traceId)
+              ? { trace_id: span.value.traceId }
+              : {};
+          // Request middleware may replace the logger; native diagnostics keep one safe JSON shape.
+          yield* Console.error(
+            JSON.stringify({
+              message: "workflow.status.failed",
+              level: "ERROR",
+              annotations: { ...record, ...trace },
+            }),
+          );
+          if (record.phase === "decode_status") return yield* new WorkflowStatusUnavailable();
+          return yield* Effect.failCause(cause);
+        }),
+      ),
+    );
+  }),
+);
