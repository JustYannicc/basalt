+import { AlchemyContext } from "alchemy/AlchemyContext";
+import * as Cloudflare from "alchemy/Cloudflare";
+import {
+  WorkflowStatusFault,
+  type WorkflowStatusPhase,
+} from "@executor-js/hosted-server/workflow-status";
+import { Effect } from "effect";
+import { HttpRouter, HttpServerRequest } from "effect/http";
+
+export const workflowStatusFaultBindings = Effect.gen(function* () {
+  return { WORKFLOW_STATUS_FAULTS: (yield* AlchemyContext).dev };
+});
+
+/** Only local Cloud installs request-scoped fault controls; deployments ignore this header. */
+export const localWorkflowStatusFaults = HttpRouter.middleware(
+  Effect.gen(function* () {
+    const environment = yield* Cloudflare.WorkerEnvironment;
+    return (response) =>
+      Effect.gen(function* () {
+        if (environment.WORKFLOW_STATUS_FAULTS !== true) return yield* response;
+        const request = yield* HttpServerRequest.HttpServerRequest;
+        const requested = request.headers["x-executor-test-workflow-status-phase"];
+        return yield* response.pipe(
+          Effect.provideService(WorkflowStatusFault, (phase: WorkflowStatusPhase) =>
+            requested === phase
+              ? Effect.die(new TypeError("synthetic-private-status-payload"))
+              : Effect.void,
+          ),
+        );
+      });
+  }),
+);
