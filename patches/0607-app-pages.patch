@@ -0,0 +1,62 @@
+/**
+ * Pages an app declares on `defineApp`: each is a host tab that opens one path of the app's own
+ * UI. Hosts read them from the version's recorded requirements, without evaluating the app.
+ */
+import { Schema } from "effect";
+
+/** Lowercase words joined by hyphens. Pages have their own URL namespace apart from host tabs. */
+export const AppPageKey = Schema.String.check(
+  Schema.isPattern(/^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$/u),
+  Schema.isMaxLength(32),
+);
+export type AppPageKey = typeof AppPageKey.Type;
+
+/** Paths under `/_executor/` belong to the host. */
+const hostPath = /^\/_executor(?:\/|$)/i;
+
+/**
+ * Why a page path is not a path of the app's own UI, or undefined for one that is: an absolute
+ * path on the app's origin with an optional query and fragment, never another origin, a host path
+ * or a `.` or `..` segment.
+ */
+export const appPagePathProblem = (path: string): string | undefined => {
+  if (!path.startsWith("/") || path.startsWith("//"))
+    return "must start with a single /, on the app's own origin";
+  if ([...path].some((char) => char === "\\" || char.charCodeAt(0) < 0x20 || char === "\u007f"))
+    return "must not contain backslashes or control characters";
+  const pathname = path.split(/[?#]/, 1)[0] ?? "";
+  if (pathname.split("/").some((segment) => segment === "." || segment === ".."))
+    return "must not contain . or .. segments";
+  if (hostPath.test(pathname)) return "must not be a host path under /_executor/";
+  try {
+    const url = new URL(path, "https://app.invalid");
+    if (url.origin !== "https://app.invalid") return "must stay on the app's own origin";
+    // Browsers normalize encoded dots and similar spellings; a path must already be in that form.
+    if (url.pathname !== pathname)
+      return "must be a normalized path, with special characters encoded";
+    if (hostPath.test(decodeURIComponent(pathname)))
+      return "must not be a host path under /_executor/";
+  } catch {
+    return "must be a valid URL path";
+  }
+  return undefined;
+};
+
+/** A path of the app's own UI, such as `/history` or `/history?range=7d`. */
+export const AppPagePath = Schema.String.check(
+  Schema.isMaxLength(512),
+  Schema.makeFilter((path) => appPagePathProblem(path) ?? true),
+);
+
+export const DeclaredPage = Schema.Struct({
+  /** The tab's name, as the host shows it. */
+  label: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(40)),
+  path: AppPagePath,
+});
+export type DeclaredPage = typeof DeclaredPage.Type;
+
+/** Up to eight pages, as tabs in declaration order after the app's screen. */
+export const DeclaredPages = Schema.Record(AppPageKey, DeclaredPage).check(
+  Schema.makeFilter((pages) => Object.keys(pages).length <= 8 || "declare at most 8 pages"),
+);
+export type DeclaredPages = typeof DeclaredPages.Type;
