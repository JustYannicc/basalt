+/** App pages declared on `defineApp` are host tabs, read from the app's active retained build. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import type { Frame, Page } from "playwright";
+import { randomUUID } from "node:crypto";
+import { scenarios } from "../test-plan.ts";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { App } from "../support/contracts.ts";
+import type { Response } from "../support/platform.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { waitForAppUrl } from "../support/app-pages.ts";
+import { openThroughBrowser } from "../support/in-app-navigation.ts";
+import { kept, request, selected } from "../support/app-host-navigation.ts";
+
+const historyPath = "/history?range=7d";
+const declared = (pages: string) => `import { defineApp, query, object, router } from "apps";
+export const ping = query({ input: object({}) }, async () => "pong");
+export default defineApp({ pages: ${pages} }, { tools: router({ ping }) });`;
+
+/** One document per path: the app's screen at "/", its History page at its own path. */
+const screen = `import { createAppClient } from "apps/client";
+const client = createAppClient();
+const context = JSON.parse(document.getElementById("executor-context")?.textContent ?? "{}");
+const history = location.pathname === "/history";
+document.querySelector("h1").textContent = history ? "History page " + location.search : "Pages fixture";
+document.body.dataset.load = String(Math.random());
+const output = document.querySelector("output");
+const go = (destination) =>
+  client.navigate(destination).then((accepted) => (output.textContent = accepted ? "accepted" : "refused"));
+document.getElementById("history").addEventListener("click", () => go({ page: "history" }));
+document.getElementById("unknown").addEventListener("click", () => go({ page: "billing" }));
+window.version = context.version;
+window.sendRaw = (message) => {
+  message = { reference: context.navigation, expiresAt: Date.now() + 3000, ...message };
+  return new Promise((resolve) => {
+    const timer = setTimeout(() => resolve("unanswered"), 4000);
+    const answer = (event) => {
+      if (event.source !== parent || event.data?.type !== "executor:navigate-result" || event.data.id !== message.id) return;
+      clearTimeout(timer);
+      removeEventListener("message", answer);
+      resolve(event.data.accepted ? "accepted" : "refused");
+    };
+    addEventListener("message", answer);
+    parent.postMessage(message, "*");
+  });
+};`;
+
+const files = (pages: string) => [
+  { path: "index.ts", content: declared(pages) },
+  {
+    path: "ui/index.html",
+    content: `<!doctype html><html><head><title>Pages fixture</title></head><body><main><h1>Pages fixture</h1><label>Draft <input name="draft"></label><button id="history">Open history</button><button id="unknown">Open unknown page</button><output></output></main><script type="module" src="./main.ts"></script></body></html>`,
+  },
+  { path: "ui/main.ts", content: screen },
+  appsManifest,
+];
+const historyPages = `{ history: { label: "History", path: ${JSON.stringify(historyPath)} } }`;
+
+const navigation = (page: Page) => page.getByRole("navigation", { name: "App navigation" });
+const tabs = (page: Page) =>
+  navigation(page)
+    .locator("a, button, [role=status]")
+    .allTextContents()
+    .then((names) => names.map((name) => name.trim()));
+/** The app's screen and its History page are separate documents of one origin. */
+const screenFrame = '[data-app-frames] iframe:not([src*="/history"])';
+const historyFrame = '[data-app-frames] iframe[src*="/history"]';
+const frameAt = (page: Page, origin: string, history: boolean): Frame => {
+  const frame = page
+    .frames()
+    .find(
+      (candidate) =>
+        candidate.url().startsWith(origin) &&
+        (new URL(candidate.url()).pathname === "/history") === history,
+    );
+  if (frame === undefined)
+    throw new Error(`The ${history ? "History" : "screen"} frame is missing`);
+  return frame;
+};
+
+layer(HostedLive, { excludeTestServices: true })("App pages", (it) => {
+  it.effect(scenarios.appPages.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          browser = yield* Browser;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const deploy = (name: string, pages: string) =>
+          api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+            name: `${name} ${randomUUID().slice(0, 8)}`,
+            files: files(pages),
+          });
+        const keep = (response: Response, label: string) =>
+          Effect.gen(function* () {
+            expect(response.status, label).toBe(200);
+            const app = yield* body(
+              Schema.Struct({ ...App.fields, activeVersion: Schema.String }),
+              response,
+            );
+            yield* Effect.addFinalizer(() =>
+              api.request(actors.owner, "DELETE", `${prefix}/apps/${app.id}`).pipe(Effect.orDie),
+            );
+            return app;
+          });
+
+        const legacy = yield* keep(yield* deploy("Legacy screen", "undefined"), "legacy deploy");
+        const app = yield* keep(yield* deploy("Pages", historyPages), "pages deploy");
+        const url = yield* waitForAppUrl(actors.owner, `${prefix}/apps/${app.id}/ui`);
+        const origin = new URL(url).origin;
+        const detail = `/org/${actors.organization.slug}/apps/${app.id}`;
+        yield* waitForAppUrl(actors.owner, `${prefix}/apps/${legacy.id}/ui`);
+
+        yield* browser.login(actors.owner);
+        yield* browser.use("Use a desktop viewport in light mode", (page) =>
+          page
+            .setViewportSize({ width: 1280, height: 900 })
+            .then(() => page.emulateMedia({ colorScheme: "light" })),
+        );
+
+        // An app without pages keeps exactly its tabs.
+        yield* openThroughBrowser(
+          "Open the app without pages",
+          `/org/${actors.organization.slug}/apps/${legacy.id}`,
+        );
+        yield* browser.use("The legacy app opens on its screen", (page) =>
+          page.frameLocator(screenFrame).getByRole("heading", { name: "Pages fixture" }).waitFor(),
+        );
+        expect(yield* browser.use("Read the legacy app's tabs", tabs)).toEqual([
+          "App",
+          "Overview",
+          "Accounts",
+          "Tools",
+          "Skills",
+          "Workflows",
+          "Schedules",
+          "Webhooks",
+          "Source",
+          "Versions",
+          "Settings",
+        ]);
+
+        yield* openThroughBrowser("Open the app with a History page", detail);
+        yield* browser.use("The app opens on its screen", (page) =>
+          page.frameLocator(screenFrame).getByRole("heading", { name: "Pages fixture" }).waitFor(),
+        );
+        expect(yield* browser.use("History is a tab after App", tabs)).toEqual([
+          "App",
+          "History",
+          "Overview",
+          "Accounts",
+          "Tools",
+          "Skills",
+          "Workflows",
+          "Schedules",
+          "Webhooks",
+          "Source",
+          "Versions",
+          "Settings",
+        ]);
+        expect(yield* browser.use("App is selected", selected)).toEqual(["App"]);
+        yield* browser.use("Type a draft on the screen", (page) =>
+          page.frameLocator(screenFrame).getByLabel("Draft").fill("screen draft"),
+        );
+        yield* browser.checkpoint("app with a declared History tab");
+
+        // Selecting the tab opens the page's own document at its declared path and query.
+        yield* browser.use("Select the History tab", (page) =>
+          navigation(page)
+            .getByRole("link", { name: "History", exact: true })
+            .click()
+            .then(() =>
+              page.waitForURL((current) => current.searchParams.get("page") === "history"),
+            )
+            .then(() =>
+              page
+                .frameLocator(historyFrame)
+                .getByRole("heading", { name: "History page ?range=7d" })
+                .waitFor(),
+            ),
+        );
+        expect(yield* browser.use("History is selected", selected)).toEqual(["History"]);
+        expect(
+          new URL(
+            yield* browser.use("Read the History tab's address", (page) =>
+              Promise.resolve(page.url()),
+            ),
+          ).pathname,
+        ).toBe(detail);
+        yield* browser.checkpoint("History page as a host tab");
+
+        // A direct link survives reload.
+        yield* browser.use("Reload the History tab", (page) =>
+          page
+            .reload()
+            .then(() =>
+              page
+                .frameLocator(historyFrame)
+                .getByRole("heading", { name: "History page ?range=7d" })
+                .waitFor(),
+            ),
+        );
+        expect(yield* browser.use("History stays selected after reload", selected)).toEqual([
+          "History",
+        ]);
+        yield* browser.use("Type on the History page", (page) =>
+          page.frameLocator(historyFrame).getByLabel("Draft").fill("history draft"),
+        );
+        const historyFirst = yield* browser.use("Read the History document", (page) =>
+          kept(frameAt(page, origin, true)),
+        );
+
+        // Back and Forward move between the tabs; each keeps its running document.
+        yield* browser.use("Open the screen tab", (page) =>
+          navigation(page)
+            .getByRole("link", { name: "App", exact: true })
+            .click()
+            .then(() => page.waitForURL((current) => !current.searchParams.has("page")))
+            .then(() =>
+              page
+                .frameLocator(screenFrame)
+                .getByRole("heading", { name: "Pages fixture" })
+                .waitFor(),
+            ),
+        );
+        yield* browser.use("Type a draft after reload", (page) =>
+          page.frameLocator(screenFrame).getByLabel("Draft").fill("screen draft"),
+        );
+        const screenAfterReload = yield* browser.use("Read the screen after reload", (page) =>
+          kept(frameAt(page, origin, false)),
+        );
+        yield* browser.use("Back returns to History", (page) =>
+          page
+            .goBack()
+            .then(() =>
+              page.waitForURL((current) => current.searchParams.get("page") === "history"),
+            ),
+        );
+        expect(yield* browser.use("History is selected again", selected)).toEqual(["History"]);
+        expect(
+          yield* browser.use("The History document kept its draft", (page) =>
+            kept(frameAt(page, origin, true)),
+          ),
+        ).toEqual(historyFirst);
+        yield* browser.use("Forward returns to the screen", (page) =>
+          page
+            .goForward()
+            .then(() => page.waitForURL((current) => !current.searchParams.has("page"))),
+        );
+        expect(
+          yield* browser.use("The screen document kept its draft", (page) =>
+            kept(frameAt(page, origin, false)),
+          ),
+        ).toEqual(screenAfterReload);
+
+        // The app opens its own declared page through the host.
+        yield* browser.use("The screen opens its History page", (page) =>
+          page
+            .frameLocator(screenFrame)
+            .getByRole("button", { name: "Open history" })
+            .click()
+            .then(() =>
+              page.waitForURL((current) => current.searchParams.get("page") === "history"),
+            ),
+        );
+        expect(yield* browser.use("The app's request selected History", selected)).toEqual([
+          "History",
+        ]);
+        yield* browser.use("Back returns to the screen once more", (page) =>
+          page.goBack().then(() => page.waitForURL((current) => !current.searchParams.has("page"))),
+        );
+        expect(
+          yield* browser.use("The screen kept its document through its own navigation", (page) =>
+            kept(frameAt(page, origin, false)),
+          ),
+        ).toEqual({ ...screenAfterReload, answer: "accepted" });
+
+        // Undeclared pages and other versions are refused; the screen stays put.
+        yield* browser.use("The screen asks for a page it never declared", (page) =>
+          page
+            .frameLocator(screenFrame)
+            .getByRole("button", { name: "Open unknown page" })
+            .click()
+            .then(() =>
+              page.frameLocator(screenFrame).locator("output", { hasText: "refused" }).waitFor(),
+            ),
+        );
+        const version = yield* browser.use("Read the screen's version", (page) =>
+          frameAt(page, origin, false).evaluate(
+            () => (window as unknown as { version: string }).version,
+          ),
+        );
+        expect(version).toBe(app.activeVersion);
+        const raw = (label: string, message: unknown) =>
+          browser.use(label, (page) =>
+            frameAt(page, origin, false).evaluate(
+              (value) =>
+                (window as unknown as { sendRaw: (message: unknown) => Promise<string> }).sendRaw(
+                  value,
+                ),
+              message,
+            ),
+          );
+        expect(
+          yield* raw(
+            "Another version's page request is refused",
+            request("ver_stale", { page: "history" }),
+          ),
+        ).toBe("refused");
+        expect(
+          yield* raw("A page key with a path is refused", request(version, { page: "../history" })),
+        ).toBe("refused");
+        expect(
+          yield* browser.use("The host stayed on the screen", (page) =>
+            Promise.all([new URL(page.url()).searchParams.get("page"), selected(page)]),
+          ),
+        ).toEqual([null, ["App"]]);
+
+        // A direct link to an undeclared page opens the screen, never another address.
+        yield* browser.use("Open an undeclared page by URL", (page) =>
+          page
+            .goto(`${detail}?page=billing`)
+            .then(() =>
+              page
+                .frameLocator(screenFrame)
+                .getByRole("heading", { name: "Pages fixture" })
+                .waitFor(),
+            ),
+        );
+        expect(yield* browser.use("An undeclared page selects App", selected)).toEqual(["App"]);
+        expect(
+          yield* browser.use("No document opened for it", (page) =>
+            page.locator(`[data-app-frames] iframe[src*="billing"]`).count(),
+          ),
+        ).toBe(0);
+
+        yield* browser.use("Use a phone viewport in dark mode", (page) =>
+          page
+            .setViewportSize({ width: 390, height: 844 })
+            .then(() => page.emulateMedia({ colorScheme: "dark" }))
+            .then(() => page.goto(`${detail}?page=history`))
+            .then(() =>
+              page
+                .frameLocator(historyFrame)
+                .getByRole("heading", { name: "History page ?range=7d" })
+                .waitFor(),
+            ),
+        );
+        expect(yield* browser.use("History is selected on a phone", selected)).toEqual(["History"]);
+        yield* browser.checkpoint("History tab on a phone in dark mode");
+
+        // Declarations are checked when the app's module loads: an unsafe page never deploys.
+        for (const [label, pages] of [
+          [
+            "An external page address",
+            `{ history: { label: "History", path: "https://example.com/" } }`,
+          ],
+          ["A path that leaves the app", `{ history: { label: "History", path: "/../history" } }`],
+          ["A host path", `{ history: { label: "History", path: "/_executor/version" } }`],
+          [
+            "A key outside the page namespace",
+            `{ "History Tab": { label: "History", path: "/history" } }`,
+          ],
+        ] as const) {
+          const refused = yield* deploy("Unsafe pages", pages);
+          if (refused.status === 200) yield* keep(refused, label);
+          expect(refused.status, label).toBe(422);
+        }
+      }),
+    ),
+  );
+});
