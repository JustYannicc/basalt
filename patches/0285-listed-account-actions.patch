+/** Listed values never authorize writes or outlive a denied account read. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import type { Page } from "playwright";
+import { appLinksFixture, keyProvider } from "../support/app-links.ts";
+import { body } from "../support/api.ts";
+import { linkAccount } from "../support/app-accounts.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { holdQuery } from "../support/query-transition.ts";
+import { scenarios } from "../test-plan.ts";
+
+const source = `import {defineApp,defineProvider,secrets,query,object,string,router} from "apps";
+const service=${keyProvider("Listed authority fixture")};
+export default defineApp({user:{accounts:{service:service.many()}}},{tools:router({hello:query({input:object({})},async()=>"Hello")})});`;
+const Access = Schema.Struct({ revision: Schema.String });
+const Members = Schema.Struct({
+  members: Schema.Array(Schema.Struct({ id: Schema.String, userId: Schema.String })),
+});
+const editor = (page: Page) => page.getByRole("dialog", { name: "Edit account", exact: true });
+const field = (page: Page) =>
+  editor(page).getByRole("textbox", { name: "Account name", exact: true });
+const action = (page: Page, label: string, name: string) =>
+  page
+    .getByRole("button", { name: `Manage ${label}`, exact: true })
+    .click()
+    .then(() => page.getByRole("menuitem", { name, exact: true }).click());
+const protectedState = (page: Page) =>
+  Promise.all([
+    field(page).inputValue(),
+    field(page).isDisabled(),
+    editor(page).getByRole("button", { name: "Save", exact: true }).isDisabled(),
+  ]);
+const settledReadonly = (page: Page) =>
+  page.waitForFunction(() => {
+    const field = document.querySelector('[role="dialog"] input');
+    return field instanceof HTMLInputElement && field.disabled;
+  });
+const fixture = Effect.gen(function* () {
+  const f = yield* appLinksFixture([{ path: "index.ts", content: source }]);
+  const label = `Shared ${f.app.id.slice(-8)}`;
+  const id = yield* f.connect(f.actors.owner, "user", "service", label, {
+    kind: "shared",
+    audience: { kind: "everyone" },
+  });
+  yield* linkAccount(f.actors.admin, f.path, "service", id);
+  yield* linkAccount(f.actors.member, f.path, "service", id);
+  const paths = [f.actors.organization.id, f.actors.organization.slug].map(
+    (org) => `/api/organizations/${org}/accounts/${id}`,
+  );
+  return { ...f, id, label, paths, accountPath: `${f.prefix}/accounts/${id}` };
+});
+
+layer(HostedLive, { excludeTestServices: true })("Listed account authority", (it) => {
+  for (const [scenario, width] of [
+    [scenarios.listedAccountDemotion, 1440],
+    [scenarios.listedAccountDemotionMobile, 390],
+  ] as const)
+    it.effect(scenario.title, (context) =>
+      withHostedCase(
+        context,
+        Effect.gen(function* () {
+          const f = yield* fixture,
+            browser = yield* Browser;
+          const directory = yield* body(
+            Members,
+            yield* f.api.request(
+              f.actors.owner,
+              "GET",
+              `/api/auth/organization/list-members?organizationId=${f.actors.organization.id}`,
+            ),
+          );
+          const member = directory.members.find((member) => member.userId === f.ids.admin);
+          if (member === undefined) throw new Error("Synthetic administrator missing");
+          const role = (role: "member" | "admin") =>
+            f.api.request(f.actors.owner, "POST", "/api/auth/organization/update-member-role", {
+              organizationId: f.actors.organization.id,
+              memberId: member.id,
+              role,
+            });
+          yield* Effect.addFinalizer(() => role("admin").pipe(Effect.orDie));
+          yield* browser.login(f.actors.admin);
+          yield* browser.use("Open app Accounts", (page) =>
+            page
+              .setViewportSize({ width, height: 900 })
+              .then(() =>
+                page.goto(`/org/${f.actors.organization.slug}/apps/${f.app.id}?view=accounts`),
+              ),
+          );
+          yield* browser.use("The shared account is listed", (page) =>
+            page.getByRole("button", { name: `Manage ${f.label}`, exact: true }).waitFor(),
+          );
+          const typed = `${f.label} draft`;
+          yield* Effect.scoped(
+            Effect.gen(function* () {
+              const held = yield* holdQuery(f.paths, "continue");
+              yield* browser.use("Open Edit details from app Accounts", (page) =>
+                action(page, f.label, "Edit details").then(() => editor(page).waitFor()),
+              );
+              expect(f.paths).toContain(yield* held.requested);
+              yield* browser.use("Type before authority arrives", (page) =>
+                field(page).fill(typed),
+              );
+              expect(
+                yield* browser.use("Save is blocked before the read", (page) =>
+                  editor(page).getByRole("button", { name: "Save", exact: true }).isDisabled(),
+                ),
+              ).toBe(true);
+              expect((yield* role("member")).status).toBe(200);
+              yield* held.release;
+              yield* browser.use("The read applies the current member role", settledReadonly);
+              expect(
+                yield* browser.use(
+                  "The draft remains visible without write permission",
+                  protectedState,
+                ),
+              ).toEqual([typed, true, true]);
+              yield* browser.checkpoint(`${width} typed draft after demotion`);
+            }),
+          );
+          expect(
+            (yield* f.api.request(f.actors.admin, "PATCH", f.accountPath, { label: typed })).status,
+          ).toBe(403);
+          expect((yield* f.api.request(f.actors.admin, "DELETE", f.accountPath)).status).toBe(403);
+          expect((yield* f.api.request(f.actors.owner, "GET", f.accountPath)).status).toBe(200);
+        }),
+      ),
+    );
+
+  for (const [scenario, width] of [
+    [scenarios.listedAccountReadonly, 1440],
+    [scenarios.listedAccountReadonlyMobile, 390],
+  ] as const)
+    it.effect(scenario.title, (context) =>
+      withHostedCase(
+        context,
+        Effect.gen(function* () {
+          const f = yield* fixture,
+            browser = yield* Browser;
+          yield* browser.login(f.actors.member);
+          const openList = () =>
+            browser.use("Open a fresh Accounts document", (page) =>
+              page
+                .setViewportSize({ width, height: 900 })
+                .then(() => page.goto(`/org/${f.actors.organization.slug}/accounts`))
+                .then(() =>
+                  page.getByRole("button", { name: `Manage ${f.label}`, exact: true }).waitFor(),
+                ),
+            );
+          yield* openList();
+          yield* Effect.scoped(
+            Effect.gen(function* () {
+              const held = yield* holdQuery(f.paths, "continue");
+              yield* browser.use("Open the read-only editor", (page) =>
+                action(page, f.label, "Edit details").then(() => editor(page).waitFor()),
+              );
+              expect(f.paths).toContain(yield* held.requested);
+              expect(yield* browser.use("The row keeps a read-only form", protectedState)).toEqual([
+                f.label,
+                true,
+                true,
+              ]);
+              expect(
+                yield* browser.use(
+                  "Close receives focus without opening a disabled-control tooltip",
+                  (page) =>
+                    Promise.all([
+                      editor(page)
+                        .getByRole("button", { name: "Close", exact: true })
+                        .evaluate((button) => button === document.activeElement),
+                      page.getByRole("tooltip").count(),
+                    ]),
+                ),
+              ).toEqual([true, 0]);
+              yield* browser.use("Close works by pointer while the read is held", (page) =>
+                editor(page)
+                  .getByRole("button", { name: "Close", exact: true })
+                  .click()
+                  .then(() => editor(page).waitFor({ state: "hidden" })),
+              );
+              yield* held.release;
+            }),
+          );
+          yield* openList();
+          yield* Effect.scoped(
+            Effect.gen(function* () {
+              const held = yield* holdQuery(f.paths, "continue");
+              yield* browser.use("Open deletion as a member", (page) =>
+                action(page, f.label, "Delete account").then(() =>
+                  page.getByRole("dialog", { name: "Delete account?", exact: true }).waitFor(),
+                ),
+              );
+              expect(f.paths).toContain(yield* held.requested);
+              expect(
+                yield* browser.use("Deletion is blocked while the read is held", (page) =>
+                  page
+                    .getByRole("dialog")
+                    .getByRole("button", { name: "Delete account", exact: true })
+                    .isDisabled(),
+                ),
+              ).toBe(true);
+              yield* held.release;
+              yield* browser.use("The account read completes", (page) =>
+                page
+                  .getByRole("dialog")
+                  .getByText(/^This deletes the saved credentials from /)
+                  .waitFor(),
+              );
+              expect(
+                yield* browser.use("Deletion remains blocked after the read", (page) =>
+                  page
+                    .getByRole("dialog")
+                    .getByRole("button", { name: "Delete account", exact: true })
+                    .isDisabled(),
+                ),
+              ).toBe(true);
+              yield* browser.use("Close deletion", (page) =>
+                page
+                  .getByRole("dialog")
+                  .getByRole("button", { name: "Close", exact: true })
+                  .click()
+                  .then(() => page.getByRole("dialog").waitFor({ state: "hidden" })),
+              );
+            }),
+          );
+          yield* browser.use("Open a fresh app Accounts document", (page) =>
+            page
+              .goto(`/org/${f.actors.organization.slug}/apps/${f.app.id}?view=accounts`)
+              .then(() =>
+                page.getByRole("button", { name: `Manage ${f.label}`, exact: true }).waitFor(),
+              ),
+          );
+          yield* Effect.scoped(
+            Effect.gen(function* () {
+              const held = yield* holdQuery(f.paths, "continue");
+              yield* browser.use("Open a row before it loses access", (page) =>
+                action(page, f.label, "Edit details").then(() => editor(page).waitFor()),
+              );
+              expect(f.paths).toContain(yield* held.requested);
+              const access = yield* body(
+                Access,
+                yield* f.api.request(f.actors.owner, "GET", `${f.accountPath}/access`),
+              );
+              expect(
+                (yield* f.api.request(f.actors.owner, "PATCH", `${f.accountPath}/access`, {
+                  revision: access.revision,
+                  audience: { kind: "groups", groups: [] },
+                })).status,
+              ).toBe(200);
+              yield* held.release;
+              yield* browser.use("A denied read removes the seeded protected form", (page) =>
+                field(page).waitFor({ state: "hidden" }),
+              );
+              expect(
+                yield* browser.use("No Save survives the denial", (page) =>
+                  editor(page).getByRole("button", { name: "Save", exact: true }).count(),
+                ),
+              ).toBe(0);
+            }),
+          );
+          expect((yield* f.api.request(f.actors.member, "GET", f.accountPath)).status).toBe(403);
+          expect(
+            (yield* f.api.request(f.actors.member, "PATCH", f.accountPath, { label: "Forbidden" }))
+              .status,
+          ).toBe(403);
+          expect((yield* f.api.request(f.actors.member, "DELETE", f.accountPath)).status).toBe(403);
+        }),
+      ),
+    );
+});
diff --git a/e2e/tests/listed-account-setup.spec.ts b/e2e/tests/listed-account-setup.spec.ts
