diff --git a/e2e/tests/listed-account-actions.spec.ts b/e2e/tests/listed-account-actions.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/listed-account-actions.spec.ts
@@ -0,0 +1,358 @@
+/** Edit details and Delete account open on their row while the account itself is read. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { randomUUID } from "node:crypto";
+import type { Locator, Page } from "playwright";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { connectionsPath } from "../support/app-accounts.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { accountRow, openRowDetails } from "../support/account-rows.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { App, Resource } from "../support/contracts.ts";
+import { holdQuery } from "../support/query-transition.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Account = Schema.Struct({
+  id: Schema.String,
+  label: Schema.String,
+  description: Schema.NullOr(Schema.String),
+});
+const Detail = Schema.Struct({ account: Account });
+const provider = "Listed actions fixture";
+const source = `import { defineApp, defineProvider, secrets, query, object, string, router } from "apps";
+const service = defineProvider({name:"${provider}",auth:{key:secrets({label:"Key",fields:object({token:string()})})}});
+export default defineApp({user: { accounts:{service:service.many()} }},{tools: router({ hello:query({input:object({})},async()=>"Hello") })});`;
+
+/** The owner's app and personal account named `label`, removed when the case ends. */
+const ownedAccount = (label: string, description: string) =>
+  Effect.gen(function* () {
+    const api = yield* Api,
+      actors = yield* Actors;
+    const prefix = `/api/organizations/${actors.organization.id}`;
+    const app = yield* body(
+      App,
+      yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+        name: `App for ${label}`,
+        files: [{ path: "index.ts", content: source }, appsManifest],
+      }),
+    );
+    const accounts: string[] = [];
+    yield* Effect.addFinalizer(() =>
+      Effect.gen(function* () {
+        expect(
+          (yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app.id}`)).status,
+        ).toBe(200);
+        for (const id of accounts)
+          expect(
+            (yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${id}`)).status,
+          ).toBe(200);
+      }).pipe(Effect.orDie),
+    );
+    const connection = yield* body(
+      Resource,
+      yield* api.request(
+        actors.owner,
+        "POST",
+        connectionsPath(`${prefix}/apps/${app.id}`, "user", "service"),
+        { destination: { kind: "personal" } },
+      ),
+    );
+    const account = yield* body(
+      Resource,
+      yield* api.request(actors.owner, "POST", `${prefix}/connections/${connection.id}/submit`, {
+        method: "key",
+        label,
+        fields: { token: "synthetic" },
+      }),
+    );
+    accounts.push(account.id);
+    expect(
+      (yield* api.request(actors.owner, "PATCH", `${prefix}/accounts/${account.id}`, {
+        description,
+      })).status,
+    ).toBe(200);
+    return {
+      id: account.id,
+      app: app.id,
+      path: `${prefix}/accounts/${account.id}`,
+      // The browser may name the organization by ID or slug; batches are split by the hold.
+      detailPaths: [actors.organization.id, actors.organization.slug].map(
+        (organization) => `/api/organizations/${organization}/accounts/${account.id}`,
+      ),
+      deleted: () => accounts.splice(accounts.indexOf(account.id), 1),
+    };
+  });
+
+/** Open a fresh Accounts document at `width` and wait for the row's menu button. */
+const openAccounts = (label: string, width: number, app?: string) =>
+  Effect.gen(function* () {
+    const actors = yield* Actors,
+      browser = yield* Browser;
+    yield* browser.login(actors.owner);
+    yield* browser.use("Use the scenario width", (page) =>
+      page.setViewportSize({ width, height: 900 }),
+    );
+    yield* browser.use("Open Accounts in a new document", (page) =>
+      page.goto(
+        app === undefined
+          ? `/org/${actors.organization.slug}/accounts`
+          : `/org/${actors.organization.slug}/apps/${app}?view=accounts`,
+      ),
+    );
+    yield* browser.use("The account row is listed", (page) =>
+      page.getByRole("button", { name: `Manage ${label}`, exact: true }).waitFor(),
+    );
+  });
+
+const openRowAction = (page: Page, label: string, item: string, dialog: Locator) =>
+  page
+    .getByRole("button", { name: `Manage ${label}`, exact: true })
+    .click()
+    .then(() => page.getByRole("menuitem", { name: item, exact: true }).click())
+    .then(() => dialog.waitFor({ state: "visible" }));
+
+const editDialog = (page: Page) => page.getByRole("dialog", { name: "Edit account", exact: true });
+const nameField = (dialog: Locator) =>
+  dialog.getByRole("textbox", { name: "Account name", exact: true });
+
+/** The edit form as it stands, without waiting for controls that are not there. */
+const editState = (dialog: Locator) => {
+  const name = nameField(dialog);
+  const save = dialog.getByRole("button", { name: "Save", exact: true });
+  return Promise.all([name.count(), save.count()]).then(([names, saves]) =>
+    Promise.all([
+      names === 1 ? name.isVisible() : false,
+      names === 1 ? name.inputValue() : undefined,
+      names === 1 ? name.isEditable() : false,
+      saves === 1 ? save.isDisabled() : undefined,
+    ]).then(([visible, value, editable, saveDisabled]) => ({
+      visible,
+      value,
+      editable,
+      saveDisabled,
+    })),
+  );
+};
+
+/** Wait for the account read to permit saving; the hold has been released by then. */
+const saveEnabled = (page: Page) =>
+  page.waitForFunction(() => {
+    const dialog = document.querySelector('[role="dialog"]');
+    const save = Array.from(dialog?.querySelectorAll("button") ?? []).find(
+      (button) => button.textContent?.trim() === "Save",
+    );
+    return save !== undefined && !save.disabled;
+  });
+
+const deleteDialog = (page: Page) =>
+  page.getByRole("dialog", { name: "Delete account?", exact: true });
+const impactText = /^This deletes the saved credentials from /;
+
+/** The delete dialog as it stands, without waiting for controls that are not there. */
+const deleteState = (dialog: Locator, label: string) => {
+  const button = dialog.getByRole("button", { name: "Delete account", exact: true });
+  return Promise.all([
+    dialog.getByText(label, { exact: true }).count(),
+    dialog.getByText(impactText).count(),
+    button.count(),
+  ]).then(([named, impact, buttons]) =>
+    Promise.resolve(buttons === 1 ? button.isDisabled() : undefined).then((disabled) => ({
+      named,
+      impact,
+      disabled,
+    })),
+  );
+};
+
+layer(HostedLive, { excludeTestServices: true })("Listed account actions", (it) => {
+  for (const [scenario, width, entry] of [
+    [scenarios.listedAccountEdit, 1440, "list"],
+    [scenarios.listedAccountEditMobile, 390, "list"],
+    [scenarios.listedAppAccountEdit, 1440, "app"],
+    [scenarios.listedAppAccountEditMobile, 390, "app"],
+  ] as const)
+    it.effect(scenario.title, (context) =>
+      withHostedCase(
+        context,
+        Effect.gen(function* () {
+          const api = yield* Api,
+            actors = yield* Actors,
+            browser = yield* Browser;
+          const label = `Listed edit ${randomUUID().slice(0, 8)}`;
+          const typed = `${label} renamed`;
+          const listedDescription = "Row description, read with the list.";
+          const savedDescription = "Saved description, read with the account.";
+          const fixture = yield* ownedAccount(label, listedDescription);
+          yield* openAccounts(label, width, entry === "app" ? fixture.app : undefined);
+          if (entry === "list")
+            yield* browser.use("The row shows its description in Details", (page) =>
+              openRowDetails(page, accountRow(page, label), label).then(() =>
+                page.getByText(listedDescription, { exact: true }).waitFor(),
+              ),
+            );
+          // Keep the list's older snapshot stable while the independent detail returns new metadata.
+          yield* holdQuery(
+            [actors.organization.id, actors.organization.slug].flatMap((organization) => [
+              `/api/organizations/${organization}/resources`,
+              `/api/organizations/${organization}/resources/accounts`,
+              `/api/organizations/${organization}/inventory`,
+              `/api/organizations/${organization}/apps/${fixture.app}/accounts/app`,
+              `/api/organizations/${organization}/apps/${fixture.app}/accounts/user`,
+            ]),
+            "continue",
+            { allRequests: true },
+          );
+          // The row now lags the saved account, as any listed value can.
+          expect(
+            (yield* api.request(actors.owner, "PATCH", fixture.path, {
+              description: savedDescription,
+            })).status,
+          ).toBe(200);
+
+          yield* Effect.scoped(
+            Effect.gen(function* () {
+              // The first account read fails, so the draft also has to survive its retry.
+              const held = yield* holdQuery(fixture.detailPaths, "fail");
+              yield* browser.use("Open Edit details from the row", (page) =>
+                openRowAction(page, label, "Edit details", editDialog(page)),
+              );
+              expect(fixture.detailPaths).toContain(yield* held.requested);
+              expect(
+                yield* browser.use("Read the form while the account read is held", (page) =>
+                  editState(editDialog(page)),
+                ),
+                "Edit details shows the row's name, typeable, with Save waiting, while the account read is held",
+              ).toEqual({ visible: true, value: label, editable: true, saveDisabled: true });
+              expect(
+                yield* browser.use("The held editor has the list's older description", (page) =>
+                  editDialog(page)
+                    .getByRole("textbox", { name: "Description for agents", exact: true })
+                    .inputValue(),
+                ),
+              ).toBe(listedDescription);
+              yield* browser.use("Type a new name before the account arrives", (page) =>
+                nameField(editDialog(page)).fill(typed),
+              );
+              yield* browser.checkpoint(`${width} edit details while the account is read`);
+              yield* held.release;
+              yield* browser.use("The failed account read offers a retry", (page) =>
+                editDialog(page).getByRole("button", { name: "Try again", exact: true }).waitFor(),
+              );
+              expect(
+                yield* browser.use("Read the form after the failed read", (page) =>
+                  editState(editDialog(page)),
+                ),
+                "A failed account read keeps the typed name and keeps Save waiting",
+              ).toEqual({ visible: true, value: typed, editable: true, saveDisabled: true });
+              yield* browser.use("Retry the account read", (page) =>
+                editDialog(page).getByRole("button", { name: "Try again", exact: true }).click(),
+              );
+            }),
+          );
+
+          yield* browser.use("The account read permits saving", saveEnabled);
+          expect(
+            yield* browser.use("Read the form after the account arrives", (page) =>
+              Promise.all([
+                editState(editDialog(page)),
+                editDialog(page)
+                  .getByRole("textbox", { name: "Description for agents", exact: true })
+                  .inputValue(),
+              ]),
+            ),
+            "The typed name stays and the untouched description follows the saved account",
+          ).toEqual([
+            { visible: true, value: typed, editable: true, saveDisabled: false },
+            savedDescription,
+          ]);
+          yield* browser.checkpoint(`${width} edit details after the account arrives`);
+          yield* browser.use("Save the account details", (page) =>
+            editDialog(page)
+              .getByRole("button", { name: "Save", exact: true })
+              .click()
+              .then(() => editDialog(page).waitFor({ state: "hidden" })),
+          );
+          const saved = yield* api
+            .request(actors.owner, "GET", fixture.path)
+            .pipe(Effect.flatMap((response) => body(Detail, response)));
+          expect(saved.account, "Saving changes only the typed name").toEqual({
+            id: fixture.id,
+            label: typed,
+            description: savedDescription,
+          });
+        }),
+      ),
+    );
+
+  for (const [scenario, width] of [
+    [scenarios.listedAccountDelete, 1440],
+    [scenarios.listedAccountDeleteMobile, 390],
+  ] as const)
+    it.effect(scenario.title, (context) =>
+      withHostedCase(
+        context,
+        Effect.gen(function* () {
+          const api = yield* Api,
+            actors = yield* Actors,
+            browser = yield* Browser;
+          const label = `Listed delete ${randomUUID().slice(0, 8)}`;
+          const fixture = yield* ownedAccount(label, "Delete fixture description.");
+          yield* openAccounts(label, width);
+
+          yield* Effect.scoped(
+            Effect.gen(function* () {
+              const held = yield* holdQuery(fixture.detailPaths, "continue");
+              yield* browser.use("Open Delete account from the row", (page) =>
+                openRowAction(page, label, "Delete account", deleteDialog(page)),
+              );
+              expect(fixture.detailPaths).toContain(yield* held.requested);
+              expect(
+                yield* browser.use("Read the dialog while the account read is held", (page) =>
+                  deleteState(deleteDialog(page), label),
+                ),
+                "Delete account? names the row's account and holds its button while the account read is held",
+              ).toEqual({ named: 1, impact: 0, disabled: true });
+              yield* browser.checkpoint(`${width} delete account while the account is read`);
+              yield* held.release;
+            }),
+          );
+
+          yield* browser.use("What deleting does arrives with the account", (page) =>
+            deleteDialog(page).getByText(impactText).waitFor(),
+          );
+          expect(
+            yield* browser.use("Read the dialog after the account arrives", (page) =>
+              Promise.all([
+                deleteState(deleteDialog(page), label),
+                deleteDialog(page).getByText(`${provider} · key`, { exact: true }).count(),
+              ]),
+            ),
+            "The account read adds the provider's method and what deleting does, then allows it",
+          ).toEqual([{ named: 1, impact: 1, disabled: false }, 1]);
+          yield* browser.checkpoint(`${width} delete account after the account arrives`);
+          const deleted = yield* browser.use("Delete the account", (page) =>
+            Promise.all([
+              page.waitForResponse(
+                (response) =>
+                  response.request().method() === "DELETE" &&
+                  fixture.detailPaths.includes(new URL(response.url()).pathname),
+              ),
+              deleteDialog(page)
+                .getByRole("button", { name: "Delete account", exact: true })
+                .click(),
+            ]).then(([response]) => response.status()),
+          );
+          expect(deleted).toBe(200);
+          yield* browser.use("Deleting closes the dialog", (page) =>
+            deleteDialog(page).waitFor({ state: "hidden" }),
+          );
+          fixture.deleted();
+          expect([403, 404]).toContain(
+            (yield* api.request(actors.owner, "GET", fixture.path)).status,
+          );
+        }),
+      ),
+    );
+});
diff --git a/e2e/tests/listed-account-bindings.spec.ts b/e2e/tests/listed-account-bindings.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/listed-account-bindings.spec.ts
@@ -0,0 +1,235 @@
+/** Removing one verified sign-in opens on that binding and preserves its sibling. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { FetchHttpClient, HttpClient } from "effect/http";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { accountIdentityIssuer } from "../support/account-identity-issuer.ts";
+import { IdentityAccount } from "../support/account-identity-product.ts";
+import { connectionsPath } from "../support/app-accounts.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { holdQuery } from "../support/query-transition.ts";
+import { scenarios } from "../test-plan.ts";
+
+const verifiedBindings = Effect.gen(function* () {
+  const api = yield* Api;
+  const actors = yield* Actors;
+  const issuer = yield* accountIdentityIssuer;
+  const http = yield* HttpClient.HttpClient;
+  const prefix = `/api/organizations/${actors.organization.id}`;
+  const apps: string[] = [];
+  const accounts = new Set<string>();
+  yield* Effect.addFinalizer(() =>
+    Effect.gen(function* () {
+      for (const app of apps)
+        expect((yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app}`)).status).toBe(
+          200,
+        );
+      for (const account of accounts)
+        expect(
+          (yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`)).status,
+        ).toBe(200);
+    }).pipe(Effect.orDie),
+  );
+  const bindings = [];
+  for (const label of ["First saved sign-in", "Other saved sign-in"]) {
+    const config = {
+      authorizationUrl: issuer.origin + "/authorize",
+      tokenUrl: issuer.origin + "/token",
+      scopes: ["read"],
+      tokenEndpointAuthMethod: "none",
+      identity: { issuer: issuer.origin, name: "Fixture identity" },
+    };
+    const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+      name: `App for ${label}`,
+      files: [
+        appsManifest,
+        {
+          path: "index.ts",
+          content: `import {defineApp,defineProvider,oauth2,router} from "apps";
+const service=defineProvider({name:${JSON.stringify(`Provider for ${label}`)},auth:{oauth:oauth2(${JSON.stringify(config)})}});
+export default defineApp({user:{accounts:{service}}},{tools:router({})});`,
+        },
+      ],
+    });
+    expect(deployed.status).toBe(200);
+    const app = (yield* body(Resource, deployed)).id;
+    apps.push(app);
+    const connection = yield* body(
+      Resource,
+      yield* api.request(
+        actors.owner,
+        "POST",
+        connectionsPath(`${prefix}/apps/${app}`, "user", "service"),
+        {},
+      ),
+    );
+    const started = yield* api.request(
+      actors.owner,
+      "POST",
+      `${prefix}/connections/${connection.id}/oauth/start`,
+      { method: "oauth", client: { clientId: "listed-bindings-client" } },
+    );
+    expect(started.status).toBe(200);
+    const authorization = yield* body(Schema.Struct({ authorizationUrl: Schema.String }), started);
+    const callbackUrl = yield* Effect.scoped(
+      Effect.gen(function* () {
+        const response = yield* HttpClient.withScope(http).get(authorization.authorizationUrl);
+        const location = response.headers.location;
+        if (location === undefined) return yield* Effect.die("Fixture issuer omitted callback");
+        return location;
+      }),
+    ).pipe(Effect.provideService(FetchHttpClient.RequestInit, { redirect: "manual" }));
+    const completed = yield* api.request(
+      actors.owner,
+      "POST",
+      `${prefix}/connections/${connection.id}/oauth/complete`,
+      { callbackUrl },
+    );
+    expect(completed.status).toBe(200);
+    const account = yield* body(IdentityAccount, completed);
+    expect(account.identity).toBeDefined();
+    accounts.add(account.id);
+    expect(
+      (yield* api.request(actors.owner, "PATCH", `${prefix}/accounts/${account.id}`, { label }))
+        .status,
+    ).toBe(200);
+    bindings.push({ ...account, label });
+  }
+  const [first, other] = bindings;
+  if (first === undefined || other === undefined)
+    return yield* Effect.die("Fixture did not create both bindings");
+  expect(first.id).not.toBe(other.id);
+  expect(first.identity?.id).toBe(other.identity?.id);
+  return { first, other, prefix, removed: (account: string) => accounts.delete(account) };
+});
+
+layer(HostedLive, { excludeTestServices: true })("Listed account bindings", (it) => {
+  for (const [scenario, width] of [
+    [scenarios.listedBindingRemove, 1440],
+    [scenarios.listedBindingRemoveMobile, 390],
+  ] as const)
+    it.effect(scenario.title, (context) =>
+      withHostedCase(
+        context,
+        Effect.gen(function* () {
+          const api = yield* Api;
+          const actors = yield* Actors;
+          const browser = yield* Browser;
+          const fixture = yield* verifiedBindings;
+          const paths = [actors.organization.id, actors.organization.slug].map(
+            (organization) => `/api/organizations/${organization}/accounts/${fixture.first.id}`,
+          );
+          yield* browser.login(actors.owner);
+          yield* browser.use("Open the grouped sign-ins", (page) =>
+            page
+              .setViewportSize({ width, height: 900 })
+              .then(() => page.goto(`/org/${actors.organization.slug}/accounts`))
+              .then(() => page.getByRole("button", { name: "Manage apps", exact: true }).waitFor()),
+          );
+          yield* Effect.scoped(
+            Effect.gen(function* () {
+              const held = yield* holdQuery(paths, "continue");
+              yield* browser.use("Remove the first saved sign-in", (page) =>
+                page
+                  .getByRole("button", { name: "Manage apps", exact: true })
+                  .click()
+                  .then(() =>
+                    page
+                      .getByRole("button", { name: `Manage ${fixture.first.label}`, exact: true })
+                      .click(),
+                  )
+                  .then(() =>
+                    page
+                      .getByRole("menuitem", { name: "Remove saved sign-in", exact: true })
+                      .click(),
+                  )
+                  .then(() =>
+                    page
+                      .getByRole("dialog", { name: "Remove saved sign-in?", exact: true })
+                      .waitFor(),
+                  ),
+              );
+              expect(paths).toContain(yield* held.requested);
+              expect(
+                yield* browser.use(
+                  "Read the binding confirmation while its account is held",
+                  (page) => {
+                    const dialog = page.getByRole("dialog", {
+                      name: "Remove saved sign-in?",
+                      exact: true,
+                    });
+                    const button = dialog.getByRole("button", {
+                      name: "Remove saved sign-in",
+                      exact: true,
+                    });
+                    return Promise.all([
+                      dialog.getByText(fixture.first.label, { exact: true }).count(),
+                      dialog.getByText(/^This deletes the saved credentials from /).count(),
+                      button.count(),
+                    ]).then(([named, impact, buttons]) =>
+                      Promise.resolve(buttons === 1 ? button.isDisabled() : undefined).then(
+                        (disabled) => ({ named, impact, disabled }),
+                      ),
+                    );
+                  },
+                ),
+                "Remove saved sign-in names the selected row and waits for its authoritative account read",
+              ).toEqual({ named: 1, impact: 0, disabled: true });
+              yield* browser.checkpoint(`${width} remove saved sign-in before detail`);
+              yield* held.release;
+            }),
+          );
+          yield* browser.use("The binding's removal impact arrives", (page) =>
+            page
+              .getByRole("dialog", { name: "Remove saved sign-in?", exact: true })
+              .getByText(/^This deletes the saved credentials from /)
+              .waitFor(),
+          );
+          const deleted = yield* browser.use("Confirm removal of only this saved sign-in", (page) =>
+            Promise.all([
+              page.waitForResponse(
+                (response) =>
+                  response.request().method() === "DELETE" &&
+                  paths.includes(new URL(response.url()).pathname),
+              ),
+              page
+                .getByRole("dialog", { name: "Remove saved sign-in?", exact: true })
+                .getByRole("button", { name: "Remove saved sign-in", exact: true })
+                .click(),
+            ]).then(([response]) => response.status()),
+          );
+          expect(deleted).toBe(200);
+          fixture.removed(fixture.first.id);
+          yield* browser.use("The sign-in dialog closes", (page) =>
+            page
+              .getByRole("dialog", { name: "Remove saved sign-in?", exact: true })
+              .waitFor({ state: "hidden" }),
+          );
+          expect([403, 404]).toContain(
+            (yield* api.request(
+              actors.owner,
+              "GET",
