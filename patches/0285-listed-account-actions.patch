@@ -0,0 +1,221 @@
+/** Setup uses the same row-seeded account actions as Accounts and app Accounts. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { connectionsPath } from "../support/app-accounts.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { officialApps } from "../support/public-catalogs.ts";
+import { holdQuery } from "../support/query-transition.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Detail = Schema.Struct({ account: Schema.Struct({ label: Schema.String }) });
+layer(HostedLive, { excludeTestServices: true })("Listed setup account actions", (it) => {
+  for (const [scenario, width] of [
+    [scenarios.listedSetupAccount, 1440],
+    [scenarios.listedSetupAccountMobile, 390],
+  ] as const)
+    it.effect(scenario.title, (context) =>
+      withHostedCase(
+        context,
+        Effect.gen(function* () {
+          const api = yield* Api,
+            actors = yield* Actors,
+            browser = yield* Browser;
+          const prefix = `/api/organizations/${actors.organization.id}`;
+          const install = yield* api.request(actors.owner, "POST", `${prefix}/apps/install`, {
+            entry: officialApps.mail.id,
+            name: officialApps.mail.name,
+          });
+          expect(install.status, JSON.stringify(install.body)).toBe(200);
+          const installed = yield* body(Resource, install);
+          const ids: string[] = [];
+          yield* Effect.addFinalizer(() =>
+            Effect.gen(function* () {
+              expect(
+                (yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${installed.id}`))
+                  .status,
+              ).toBe(200);
+              for (const id of ids)
+                expect(
+                  (yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${id}`)).status,
+                ).toBe(200);
+            }).pipe(Effect.orDie),
+          );
+          const labels = ["Setup work mail", "Setup personal mail"];
+          for (const label of labels) {
+            const started = yield* body(
+              Resource,
+              yield* api.request(
+                actors.owner,
+                "POST",
+                connectionsPath(`${prefix}/apps/${installed.id}`, "user", "mail"),
+                { destination: { kind: "personal" } },
+              ),
+            );
+            const account = yield* body(
+              Resource,
+              yield* api.request(
+                actors.owner,
+                "POST",
+                `${prefix}/connections/${started.id}/submit`,
+                { method: "apiKey", label, fields: { token: "synthetic" } },
+              ),
+            );
+            ids.push(account.id);
+          }
+          const id = ids[0];
+          if (id === undefined) throw new Error("Setup account missing");
+          const paths = [actors.organization.id, actors.organization.slug].map(
+            (org) => `/api/organizations/${org}/accounts/${id}`,
+          );
+          yield* browser.login(actors.owner);
+          yield* browser.use("Open the setup account step", (page) =>
+            page
+              .setViewportSize({ width, height: 900 })
+              .then(() => page.goto(`/org/${actors.organization.slug}/setup/accounts`)),
+          );
+          const openAccounts = () =>
+            browser.use("Open every saved mail account", (page) =>
+              page
+                .getByRole("button", {
+                  name: `Show all 2 ${officialApps.mail.name} accounts`,
+                  exact: true,
+                })
+                .click(),
+            );
+          const openAction = (name: string) =>
+            browser.use("Choose the setup account action", (page) =>
+              page
+                .getByRole("button", { name: `Manage ${labels[0]}`, exact: true })
+                .click()
+                .then(() => page.getByRole("menuitem", { name, exact: true }).click())
+                .then(() => page.getByRole("dialog").waitFor()),
+            );
+          yield* openAccounts();
+          yield* Effect.scoped(
+            Effect.gen(function* () {
+              const held = yield* holdQuery(paths, "continue");
+              yield* openAction("Edit details");
+              expect(paths).toContain(yield* held.requested);
+              expect(
+                yield* browser.use("Setup has an editable name while the detail is held", (page) =>
+                  Promise.all([
+                    page
+                      .getByRole("dialog")
+                      .getByRole("textbox", { name: "Account name", exact: true })
+                      .inputValue(),
+                    page
+                      .getByRole("dialog")
+                      .getByRole("textbox", { name: "Account name", exact: true })
+                      .isEditable(),
+                    page
+                      .getByRole("dialog")
+                      .getByRole("button", { name: "Save", exact: true })
+                      .isDisabled(),
+                  ]),
+                ),
+              ).toEqual([labels[0], true, true]);
+              yield* browser.use("Type a setup draft", (page) =>
+                page
+                  .getByRole("dialog")
+                  .getByRole("textbox", { name: "Account name", exact: true })
+                  .fill("Typed setup mail"),
+              );
+              yield* held.release;
+              yield* browser.use("Fresh detail enables Save", (page) =>
+                page.waitForFunction(() =>
+                  Array.from(
+                    document.querySelectorAll<HTMLButtonElement>('[role="dialog"] button'),
+                  ).some((button) => button.textContent?.trim() === "Save" && !button.disabled),
+                ),
+              );
+              expect(
+                yield* browser.use("The setup draft survives", (page) =>
+                  page
+                    .getByRole("dialog")
+                    .getByRole("textbox", { name: "Account name", exact: true })
+                    .inputValue(),
+                ),
+              ).toBe("Typed setup mail");
+              yield* browser.use("Save from setup", (page) =>
+                page
+                  .getByRole("dialog")
+                  .getByRole("button", { name: "Save", exact: true })
+                  .click()
+                  .then(() => page.getByRole("dialog").waitFor({ state: "hidden" })),
+              );
+            }),
+          );
+          expect(
+            (yield* body(
+              Detail,
+              yield* api.request(actors.owner, "GET", `${prefix}/accounts/${id}`),
+            )).account.label,
+          ).toBe("Typed setup mail");
+          yield* browser.use("Reopen setup in a fresh document", (page) =>
+            page.goto(`/org/${actors.organization.slug}/setup/accounts`),
+          );
+          yield* openAccounts();
+          yield* Effect.scoped(
+            Effect.gen(function* () {
+              const held = yield* holdQuery(paths, "continue");
+              yield* browser.use("Choose Delete account from setup", (page) =>
+                page
+                  .getByRole("button", { name: "Manage Typed setup mail", exact: true })
+                  .click()
+                  .then(() =>
+                    page.getByRole("menuitem", { name: "Delete account", exact: true }).click(),
+                  )
+                  .then(() => page.getByRole("dialog").waitFor()),
+              );
+              expect(paths).toContain(yield* held.requested);
+              expect(
+                yield* browser.use(
+                  "Setup deletion names the account and waits for its read",
+                  (page) =>
+                    Promise.all([
+                      page
+                        .getByRole("dialog")
+                        .getByText("Typed setup mail", { exact: true })
+                        .count(),
+                      page
+                        .getByRole("dialog")
+                        .getByRole("button", { name: "Delete account", exact: true })
+                        .isDisabled(),
+                    ]),
+                ),
+              ).toEqual([1, true]);
+              yield* held.release;
+              yield* browser.use("The saved account supplies deletion's impact", (page) =>
+                page
+                  .getByRole("dialog")
+                  .getByText(/^This deletes the saved credentials from /)
+                  .waitFor(),
+              );
+              expect(
+                yield* browser.use("The owner can delete after the read", (page) =>
+                  page
+                    .getByRole("dialog")
+                    .getByRole("button", { name: "Delete account", exact: true })
+                    .isDisabled(),
+                ),
+              ).toBe(false);
+              yield* browser.use("Cancel setup deletion", (page) =>
+                page
+                  .getByRole("dialog")
+                  .getByRole("button", { name: "Cancel", exact: true })
+                  .click()
+                  .then(() => page.getByRole("dialog").waitFor({ state: "hidden" })),
+              );
+            }),
+          );
+          expect((yield* api.request(actors.owner, "GET", `${prefix}/accounts/${id}`)).status).toBe(
+            200,
+          );
+        }),
+      ),
+    );
+});
