+  const { result, data, refresh } = useQuery(accountAtom({ organization, account: id }));
+  const detail = Option.getOrUndefined(data);
+  const failure = AsyncResult.isFailure(result) ? result : undefined;
+  const content =
+    detail !== undefined
+      ? children(detail)
+      : listed === undefined
+        ? failure === undefined && <DetailSkeleton label="Loading account" />
+        : (failure === undefined || retainProtectedFailure(failure.cause)) && children(undefined);
+  // The failure and the form keep separate positions, so a failure never remounts the draft.
+  return (
+    <>
+      {failure && (
+        <HostedFailure cause={failure.cause} retry={refresh} retrying={failure.waiting} />
+      )}
+      {content}
+    </>
+  );
+}
