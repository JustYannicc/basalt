+import { Effect } from "effect";
+import { authCall } from "./auth-call.ts";
+
+/**
+ * Every model request checks its device's bearer. An allowed answer and the database facts read
+ * for it are reused until this long after those rows were read, in one isolate, so a revocation
+ * made anywhere reaches every check within it. The pool's device check and the device budget
+ * still run every time.
+ */
+const memoryMs = 3_000;
+const capacity = 1_000;
+
+/** Whether an answer whose rows were read at `readAt` may still be served at `now`. */
+export const servable = (now: number, deadline: number, readAt: number) =>
+  now < Math.min(deadline, readAt + memoryMs);
+
+/** Allowed answers by bearer digest. An entry never outlives its own deadline. */
+export const recentAnswers = <V>() => {
+  const entries = new Map<string, { readonly value: V; readonly until: number }>();
+  return {
+    get: (key: string) => {
+      const entry = entries.get(key);
+      if (entry === undefined) return undefined;
+      if (Date.now() < entry.until) return entry.value;
+      entries.delete(key);
+      return undefined;
+    },
+    /** `readAt` is when the answer's rows were read, before any slow step that followed. */
+    set: (key: string, value: V, deadline: number, readAt: number) => {
+      entries.delete(key);
+      if (!servable(Date.now(), deadline, readAt)) return;
+      entries.set(key, { value, until: Math.min(deadline, readAt + memoryMs) });
+      for (const oldest of entries.keys()) {
+        if (entries.size <= capacity) break;
+        entries.delete(oldest);
+      }
+    },
+    delete: (key: string) => {
+      entries.delete(key);
+    },
+  };
+};
+
+/** The memory is keyed by a digest, so a bearer is never kept in clear. */
+export const bearerDigest = (token: string) =>
+  authCall(() => crypto.subtle.digest("SHA-256", new TextEncoder().encode(token))).pipe(
+    Effect.map((digest) =>
+      Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, "0")).join(""),
+    ),
+  );
