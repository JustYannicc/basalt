+import { expect } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Api, body } from "./api.ts";
+import { Actors } from "./actors.ts";
+import { appsManifest } from "./apps-release.ts";
+import { App } from "./contracts.ts";
+import { type McpConnection, mcpTool } from "./tool-availability-fixture.ts";
+
+const Page = Schema.Struct({
+  items: Schema.Array(Schema.Struct({ name: Schema.String })),
+  next: Schema.optionalKey(Schema.String),
+});
+const Search = Schema.Struct({
+  items: Schema.Array(Schema.Struct({ path: Schema.String })),
+  remaining: Schema.Number,
+});
+
+export const verifyAvailabilityPages = (client: McpConnection) =>
+  Effect.gen(function* () {
+    const api = yield* Api,
+      actors = yield* Actors;
+    const prefix = `/api/organizations/${actors.organization.id}/apps`;
+    const deployed = yield* api.request(actors.owner, "POST", `${prefix}/deploy`, {
+      name: "Availability pages",
+      files: [
+        appsManifest,
+        {
+          path: "index.ts",
+          content: `import { defineApp, query, object, router } from "apps";
+const tools = Object.fromEntries(Array.from({length: 2001}, (_, i) => ["tool" + String(i).padStart(4, "0"), query({input: object({})}, async () => ({}))]));
+export default defineApp({}, {tools: router({bulk: router(tools), visible: query({input: object({})}, async () => ({}))})});`,
+        },
+      ],
+    });
+    expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+    const app = yield* body(App, deployed),
+      path = `${prefix}/${app.id}`;
+    yield* Effect.addFinalizer(() => api.request(actors.owner, "DELETE", path).pipe(Effect.orDie));
+    const page = () =>
+      api
+        .request(actors.owner, "GET", `${path}/tools`)
+        .pipe(Effect.flatMap((response) => body(Page, response)));
+    const search = () =>
+      mcpTool(client, "Count enabled tools across pages", "search", {
+        namespace: app.slug,
+        limit: 1,
+      }).pipe(Effect.flatMap(Schema.decodeUnknownEffect(Search)));
+    const before = yield* page();
+    expect(before.next).toBeDefined();
+    expect(before.items.length).toBeLessThan(2002);
+    const beforeSearch = yield* search();
+    expect(beforeSearch.items.length + beforeSearch.remaining).toBe(2002);
+    const hidden = yield* api.request(actors.owner, "PATCH", `${path}/tool-availability`, {
+      revision: 0,
+      changes: [{ kind: "group", path: "bulk", enabled: false }],
+    });
+    expect(hidden.status).toBe(200);
+    const after = yield* page();
+    expect(after.items.map((tool) => tool.name)).toEqual(["visible"]);
+    expect(after.next).toBeUndefined();
+    const afterSearch = yield* search();
+    expect(afterSearch.items.map((tool) => tool.path)).toEqual([
+      `tools[${JSON.stringify(app.slug)}].visible`,
+    ]);
+    expect(afterSearch.remaining).toBe(0);
+  });
