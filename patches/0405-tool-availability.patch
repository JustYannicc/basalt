+import { Resource } from "./contracts.ts";
+
+const Run = Schema.Struct({ status: Schema.String, output: Schema.optionalKey(Schema.Json) });
+
+/** A real published protocol-12 framework has workflows but no native tool-policy callback. */
+const retainedApp = Effect.gen(function* () {
+  const api = yield* Api,
+    actors = yield* Actors;
+  const archive = yield* publishedRelease("0.0.1-beta.84");
+  const prefix = `/api/organizations/${actors.organization.id}`;
+  const response = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+    name: "Retained availability workflow",
+    files: [
+      { path: "package.json", content: JSON.stringify({ dependencies: { apps: archive.url } }) },
+      {
+        path: "index.ts",
+        content: `import { defineApp, query, workflow, object, router } from "apps";
+const guarded = query({ input: object({}) }, async () => ({ executed: true }));
+const probe = workflow({ input: object({}) }, async context => {
+  try { return await context.step.runQuery("guarded", guarded, {}, { retries: { limit: 0, delay: 0 } }); }
+  catch { return { blocked: true }; }
+});
+export default defineApp({ accounts: {} }, { tools: router({ guarded }), workflows: { probe } });`,
+      },
+    ],
+  });
+  expect(response.status, JSON.stringify(response.body)).toBe(200);
+  const app = yield* body(Resource, response);
+  const path = `${prefix}/apps/${app.id}`;
+  yield* Effect.addFinalizer(() => api.request(actors.owner, "DELETE", path).pipe(Effect.orDie));
+  return { api, actors, archive, path };
+});
+
+export const verifyRetainedToolAvailability = Effect.gen(function* () {
+  const { api, actors, path } = yield* retainedApp;
+  const run = () =>
+    Effect.gen(function* () {
+      const started = yield* api.request(actors.owner, "POST", `${path}/workflow-runs`, {
+        workflow: "probe",
+        input: {},
+      });
+      expect(started.status, JSON.stringify(started.body)).toBe(200);
+      const run = yield* body(Resource, started);
+      const finished = yield* api
+        .request(actors.owner, "GET", `${path}/workflow-runs/${run.id}`)
+        .pipe(
+          Effect.flatMap((response) => body(Run, response)),
+          Effect.repeat({
+            while: (run) => run.status === "queued" || run.status === "running",
+            schedule: Schedule.spaced("100 millis"),
+          }),
+          Effect.timeout("30 seconds"),
+        );
+      expect(finished.status, JSON.stringify(finished)).toBe("complete");
+      return finished.output;
+    });
+  expect(yield* run()).toEqual({ executed: true });
+  const hide = yield* api.request(actors.owner, "PATCH", `${path}/tool-availability`, {
+    revision: 0,
+    changes: [{ kind: "tool", tool: "guarded", enabled: false }],
