@@ -0,0 +1,52 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Api, body } from "../support/api.ts";
+import { Actors } from "../support/actors.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { availabilityFixture } from "../support/tool-availability-fixture.ts";
+import { verifyAvailabilitySaveRecovery } from "../support/tool-availability-recovery.ts";
+import {
+  openAvailabilityTools,
+  hideAvailabilityTool,
+  restoreAvailabilityTool,
+  hideAvailabilityToolOnPhone,
+  verifyAvailabilityBulkControls,
+} from "../support/tool-availability-ui.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Tool availability UI", (it) => {
+  it.effect(scenarios.toolAvailabilityUi.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          browser = yield* Browser;
+        const { app, path } = yield* availabilityFixture;
+        yield* browser.login(actors.owner);
+        yield* openAvailabilityTools(actors.organization.slug, app.id);
+        yield* browser.checkpoint("tools-1280-before-change");
+        yield* hideAvailabilityTool;
+        const listed = yield* body(
+          Schema.Struct({ items: Schema.Array(Schema.Struct({ name: Schema.String })) }),
+          yield* api.request(actors.owner, "GET", `${path}/tools/index`),
+        );
+        expect(listed.items.map((tool) => tool.name)).not.toContain("records.write");
+        yield* restoreAvailabilityTool;
+        const restored = yield* body(
+          Schema.Struct({ items: Schema.Array(Schema.Struct({ name: Schema.String })) }),
+          yield* api.request(actors.owner, "GET", `${path}/tools/index`),
+        );
+        expect(restored.items.map((tool) => tool.name)).toContain("records.write");
+        yield* verifyAvailabilitySaveRecovery(path);
+        yield* verifyAvailabilityBulkControls;
+        yield* browser.checkpoint("tools-1280-restored");
+        yield* hideAvailabilityToolOnPhone;
+        yield* browser.checkpoint("tools-390-hidden");
+        yield* restoreAvailabilityTool;
+        yield* browser.checkpoint("tools-390-restored");
+      }),
+    ),
+  );
+});
diff --git a/e2e/tests/tool-availability.spec.ts b/e2e/tests/tool-availability.spec.ts
new file mode 100644
index 0000000..01f8d63
--- /dev/null
+++ b/e2e/tests/tool-availability.spec.ts
@@ -0,0 +1,282 @@
+import {
+  verifyAvailabilityUpgrade,
+  verifyRetainedToolAvailability,
+} from "../support/tool-availability-retained.ts";
+import { verifyAvailabilityPages } from "../support/tool-availability-pages.ts";
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Api, body } from "../support/api.ts";
+import { Actors } from "../support/actors.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { McpClient } from "../support/mcp-client.ts";
+import { managementApp } from "../support/management-app.ts";
+import {
+  Availability,
+  AvailabilityCatalog,
+  Pending,
+  availabilityFixture,
+  completed,
+  mcpTool,
+  outcome,
+} from "../support/tool-availability-fixture.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Search = Schema.Struct({
+  items: Schema.Array(Schema.Struct({ path: Schema.String })),
+  remaining: Schema.Number,
+});
+const Describe = Schema.Struct({
+  items: Schema.Array(Schema.Struct({ path: Schema.String })),
+  missing: Schema.Array(
+    Schema.Struct({ path: Schema.String, matches: Schema.Array(Schema.String) }),
+  ),
+});
+
+layer(HostedLive, { excludeTestServices: true })("App tool availability", (it) => {
+  it.effect(scenarios.toolAvailabilityUpgrade.title, (context) =>
+    withHostedCase(context, verifyAvailabilityUpgrade),
+  );
+  it.effect(scenarios.toolAvailabilityAgent.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          mcp = yield* McpClient;
+        const { app, other, path, key } = yield* availabilityFixture;
+        const management = yield* managementApp(actors.owner);
+        const client = yield* mcp.connect(key.key, "availability-agent", {
+          organization: actors.organization.id,
+        });
+        const target = `tools[${JSON.stringify(app.slug)}]`;
+        const manager = `tools[${JSON.stringify(management.app.slug)}].toolAvailability`;
+        const write = `${target}.records.write`,
+          review = `${target}.records.review`;
+        const call = (label: string, name: string, input: Record<string, unknown>) =>
+          mcpTool(client, label, name, input);
+        const inventory = () =>
+          call("Read availability through the management app", "call", {
+            calls: { path: `${manager}.list`, input: { path: { app: app.id } } },
+          }).pipe(
+            Effect.flatMap(Schema.decodeUnknownEffect(outcome(AvailabilityCatalog))),
+            Effect.map((r) => r.execution.value.value),
+          );
+        const change = (revision: number, changes: readonly unknown[]) =>
+          call("Ask to change tool availability", "call", {
+            calls: {
+              path: `${manager}.update`,
+              input: { path: { app: app.id }, body: { revision, changes } },
+            },
+          });
+        const accept = (requestId: string) =>
+          call("Approve availability change", "resume", {
+            requestId,
+            response: { action: "accept" },
+          }).pipe(
+            Effect.flatMap(Schema.decodeUnknownEffect(outcome(Availability))),
+            Effect.map((r) => r.execution.value.value),
+          );
+        const search = () =>
+          call("Search the app's current tools", "search", {
+            namespace: app.slug,
+            limit: 100,
+          }).pipe(Effect.flatMap(Schema.decodeUnknownEffect(Search)));
+        const listNames = (suffix = "") =>
+          api.request(actors.owner, "GET", `${path}/tools${suffix}`).pipe(
+            Effect.flatMap((r) =>
+              body(
+                Schema.Struct({ items: Schema.Array(Schema.Struct({ name: Schema.String })) }),
+                r,
+              ),
+            ),
+            Effect.map((r) => r.items.map((t) => t.name)),
+          );
+        const count = () =>
+          api
+            .request(actors.owner, "POST", `${path}/tools/call`, {
+              tool: "counter.count",
+              input: {},
+            })
+            .pipe(
+              Effect.flatMap((r) => body(Schema.Struct({ total: Schema.Number }), r)),
+              Effect.map((r) => r.total),
+            );
+
+        const initial = yield* inventory();
+        expect(initial.revision).toBe(0);
+        expect(initial.enabledTools).toContain("records.write");
+        expect(initial.groups.find((g) => g.path === "records")?.tools).toContain("records.write");
+        expect((yield* search()).items.map((t) => t.path)).toContain(write);
+        expect(yield* listNames()).toContain("records.write");
+        const describedBefore = yield* Schema.decodeUnknownEffect(Describe)(
+          yield* call("Describe enabled write", "describe", { paths: [write] }),
+        );
+        expect(describedBefore.items.map((t) => t.path)).toEqual([write]);
+        yield* Schema.decodeUnknownEffect(outcome(Schema.Struct({ wrote: Schema.Literal(true) })))(
+          yield* call("Run enabled write", "call", { calls: { path: write, input: {} } }),
+        );
+        expect(yield* count()).toBe(1);
+        const pendingCall = yield* Schema.decodeUnknownEffect(Pending)(
+          yield* call("Park a write approval", "call", { calls: { path: review, input: {} } }),
+        );
+
+        const pending = yield* Schema.decodeUnknownEffect(Pending)(
+          yield* change(initial.revision, [{ kind: "group", path: "records", enabled: false }]),
+        );
+        expect((yield* inventory()).enabledTools).toContain("records.write");
+        yield* call("Decline availability change", "resume", {
+          requestId: pending.requestId,
+          response: { action: "decline" },
+        });
+        expect((yield* inventory()).revision).toBe(0);
+        const approved = yield* Schema.decodeUnknownEffect(Pending)(
+          yield* change(initial.revision, [{ kind: "group", path: "records", enabled: false }]),
+        );
+        const hidden = yield* accept(approved.requestId);
+        expect(hidden.revision).toBe(1);
+
+        expect(yield* listNames()).not.toContain("records.write");
+        expect(yield* listNames("/index")).not.toContain("records.write");
+        const hiddenSearch = yield* search();
+        expect(hiddenSearch.items.map((t) => t.path)).not.toContain(write);
+        expect(hiddenSearch.items.map((t) => t.path)).not.toContain(review);
+        const describedHidden = yield* Schema.decodeUnknownEffect(Describe)(
+          yield* call("Describe hidden write", "describe", { paths: [write] }),
+        );
+        expect(describedHidden.items).toEqual([]);
+        expect(describedHidden.missing.flatMap((t) => t.matches)).not.toContain(write);
+        const rawMcp = yield* client.use("List MCP wrappers after hiding", (client) =>
+          client.listTools(),
+        );
+        expect(rawMcp.tools.map((t) => t.name)).not.toContain("records.write");
+        expect(rawMcp.tools.map((t) => t.name)).toContain("search");
+        const direct = yield* api.request(actors.owner, "POST", `${path}/tools/call`, {
+          tool: "records.write",
+          input: {},
+        });
+        expect(direct.status).toBe(403);
+        expect(JSON.stringify(direct.body)).toContain("switched off");
+        expect(
+          (yield* api.request(actors.owner, "GET", `${path}/tools/records.write`)).status,
+        ).toBe(404);
+        const refused = yield* call("Refuse a known hidden MCP path", "call", {
+          calls: { path: write, input: {} },
+        });
+        expect(JSON.stringify(refused)).toContain("switched off");
+        const decodedRefusal = yield* Schema.decodeUnknownEffect(
+          completed(Schema.Struct({ ok: Schema.Literal(false) })),
+        )(refused);
+        expect(decodedRefusal.execution.value.ok).toBe(false);
+        const program = yield* call("Refuse hidden write in a program", "execute", {
+          code: `return await ${write}({});`,
+        });
+        expect(JSON.stringify(program)).toContain('"ok":false');
+        expect(JSON.stringify(program)).toContain("switched off");
+        const keys = yield* Schema.decodeUnknownEffect(completed(Schema.Array(Schema.String)))(
+          yield* call("List the executable namespace", "execute", {
+            code: `return Object.keys(${target});`,
+          }),
+        );
+        expect(keys.execution.value).not.toContain("records.write");
+        yield* call("Recheck earlier approval after disable", "resume", {
+          requestId: pendingCall.requestId,
+          response: { action: "accept" },
+        });
+        expect(yield* count()).toBe(1);
+        expect(
+          (yield* api.request(
+            actors.owner,
+            "POST",
+            `${path.replace(app.id, other.id)}/tools/call`,
+            { tool: "records.write", input: {} },
+          )).status,
+        ).toBe(200);
+        expect((yield* api.request(actors.member, "GET", `${path}/tool-availability`)).status).toBe(
+          403,
+        );
+        expect(
+          (yield* api.request(actors.member, "PATCH", `${path}/tool-availability`, {
+            revision: hidden.revision,
+            changes: [{ kind: "tool", tool: "records.write", enabled: true }],
+          })).status,
+        ).toBe(403);
+
+        const restore = yield* Schema.decodeUnknownEffect(Pending)(
+          yield* change(hidden.revision, [{ kind: "group", path: "records", enabled: true }]),
+        );
+        yield* accept(restore.requestId);
+        expect((yield* search()).items.map((t) => t.path)).toContain(write);
+        expect(yield* listNames()).toContain("records.write");
+        const describedAfter = yield* Schema.decodeUnknownEffect(Describe)(
+          yield* call("Describe restored write", "describe", { paths: [write] }),
+        );
+        expect(describedAfter.items.map((t) => t.path)).toEqual([write]);
+        yield* Schema.decodeUnknownEffect(outcome(Schema.Struct({ wrote: Schema.Literal(true) })))(
+          yield* call("Run restored write", "call", { calls: { path: write, input: {} } }),
+        );
+        expect(yield* count()).toBe(2);
+
+        const readState = () =>
+          api
+            .request(actors.owner, "GET", `${path}/tool-availability`)
+            .pipe(Effect.flatMap((r) => body(AvailabilityCatalog, r)));
