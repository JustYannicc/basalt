+import { AppId, ToolName, ToolIndex, Tool, ToolNotFound } from "@executor-js/sdk/core";
+import { ApiError } from "@executor-js/utils/api-error";
+import { Schema } from "effect";
+import { HttpApiEndpoint, HttpApiGroup } from "effect/http-api";
+import { RequiredAction } from "./authorization.ts";
+import { OrganizationReference, RequireOrganization } from "./organization.ts";
+import { discoveryErrors } from "./tools.ts";
+
+export const ToolAvailability = Schema.Struct({
+  revision: Schema.Int,
+  defaultMode: Schema.Literals(["all", "read-only"]),
+  overrides: Schema.Array(Schema.Struct({ tool: ToolName, enabled: Schema.Boolean })),
+});
+export type ToolAvailability = typeof ToolAvailability.Type;
+export const ToolAvailabilityChange = Schema.Union([
+  Schema.Struct({ kind: Schema.Literal("tool"), tool: ToolName, enabled: Schema.Boolean }),
+  Schema.Struct({
+    kind: Schema.Literal("group"),
+    path: Schema.NonEmptyString,
+    enabled: Schema.Boolean,
+  }),
+  Schema.Struct({ kind: Schema.Literal("writes"), enabled: Schema.Boolean }),
+  Schema.Struct({
+    kind: Schema.Literal("default"),
+    defaultMode: ToolAvailability.fields.defaultMode,
+  }),
+]);
+export type ToolAvailabilityChange = typeof ToolAvailabilityChange.Type;
+export class ToolAvailabilityConflict extends ApiError.define({
+  tag: "ToolAvailabilityConflict",
+  status: 409,
+  message: "These tool settings changed. Reload them before saving again.",
+}) {}
+export class ToolAvailabilityInvalid extends ApiError.define({
+  tag: "ToolAvailabilityInvalid",
+  status: 422,
+  message: "A tool or group is no longer in this app. Reload the tool list.",
+}) {}
+const params = { organization: OrganizationReference, app: AppId };
+const prefix = "/api/organizations/:organization/apps/:app/tool-availability";
+const errors = [...discoveryErrors, ToolAvailabilityConflict, ToolAvailabilityInvalid];
+export const HostedToolAvailability = HttpApiGroup.make("toolAvailability")
+  .add(
+    HttpApiEndpoint.get("list", prefix, {
+      params,
+      success: Schema.Struct({
+        ...ToolAvailability.fields,
+        catalog: ToolIndex,
+        enabledTools: Schema.Array(ToolName),
+        groups: Schema.Array(Schema.Struct({ path: Schema.String, tools: Schema.Array(ToolName) })),
+      }),
+      error: discoveryErrors,
+    }).annotate(RequiredAction, "manage"),
+  )
+  .add(
+    HttpApiEndpoint.get("get", `${prefix}/tools/:tool`, {
+      params: { ...params, tool: ToolName },
+      success: Tool,
+      error: [...discoveryErrors, ToolNotFound],
+    }).annotate(RequiredAction, "manage"),
+  )
+  .add(
+    HttpApiEndpoint.patch("update", prefix, {
+      params,
+      payload: Schema.Struct({
+        revision: Schema.Int,
+        changes: Schema.Array(ToolAvailabilityChange),
+      }),
+      success: ToolAvailability,
+      error: errors,
+    }).annotate(RequiredAction, "manage"),
+  )
+  .middleware(RequireOrganization);
