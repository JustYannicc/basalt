+        expect(enabled.defaultMode).toBe("all");
+        expect((yield* readState()).enabledTools).toContain("records.review");
+        yield* verifyRetainedToolAvailability;
+        yield* verifyAvailabilityPages(client);
+      }).pipe(Effect.provide(McpClient.layer)),
+    ),
+  );
+});
