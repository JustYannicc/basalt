+"use client";
+
+import type * as React from "react";
+import { Switch as SwitchPrimitive } from "radix-ui";
+import { cn } from "../lib/utils.ts";
+
+/**
+ * On/off switch for a setting that applies as soon as it changes. The visible track stays compact;
+ * on touch layouts the control itself grows to a 44px target around it, so dense rows stay dense.
+ */
+function Switch({ className, ...props }: React.ComponentProps<typeof SwitchPrimitive.Root>) {
+  return (
+    <SwitchPrimitive.Root
+      data-slot="switch"
+      className={cn(
+        "group/switch inline-flex h-6 shrink-0 cursor-pointer items-center justify-center rounded-full outline-none disabled:cursor-not-allowed disabled:opacity-50 max-[740px]:h-11 max-[740px]:min-w-11",
+        className,
+      )}
+      {...props}
+    >
+      <span
+        aria-hidden
+        className="flex h-4.5 w-8 items-center rounded-full border border-transparent bg-input p-px transition-colors group-focus-visible/switch:ring-[3px] group-focus-visible/switch:ring-ring/50 group-data-[state=checked]/switch:bg-primary dark:bg-input/80"
+      >
+        <SwitchPrimitive.Thumb
+          data-slot="switch-thumb"
+          className="block size-3.5 rounded-full bg-background shadow-xs transition-transform duration-150 ease-out data-[state=checked]:translate-x-3.5 dark:data-[state=unchecked]:bg-foreground/80 dark:data-[state=checked]:bg-primary-foreground"
+        />
+      </span>
+    </SwitchPrimitive.Root>
+  );
+}
+
+export { Switch };
