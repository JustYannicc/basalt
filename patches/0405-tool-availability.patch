@@ -0,0 +1,84 @@
+/**
+ * Which of an app instance's tools agents can find and use. Hosts own storage, authority and the
+ * revision check; this is the display shape and the rules a view needs to show a confirmed save.
+ */
+import type { ToolSummary } from "@executor-js/sdk";
+import type { Cause } from "effect";
+import type { Atom } from "effect/reactivity";
+import type { ComponentType } from "react";
+import type { FailureProps, Query } from "./dashboard.ts";
+
+/** `read-only` keeps every tool not positively marked read-only off unless switched on by name. */
+export type ToolDefaultMode = "all" | "read-only";
+
+export interface ToolAvailabilityOverride {
+  readonly tool: string;
+  readonly enabled: boolean;
+}
+
+/** One saved setting and the catalog it was evaluated against. */
+export interface ToolAvailability {
+  readonly revision: number;
+  readonly defaultMode: ToolDefaultMode;
+  readonly overrides: readonly ToolAvailabilityOverride[];
+  readonly enabledTools: readonly string[];
+  /** The host's tool groups with their current exact members. */
+  readonly groups: readonly { readonly path: string; readonly tools: readonly string[] }[];
+}
+
+/** One atomic batch applies every change or none of them. */
+export type ToolAvailabilityChange =
+  | { readonly kind: "tool"; readonly tool: string; readonly enabled: boolean }
+  | { readonly kind: "group"; readonly path: string; readonly enabled: boolean }
+  | { readonly kind: "writes"; readonly enabled: boolean }
+  | { readonly kind: "default"; readonly defaultMode: ToolDefaultMode };
+
+export interface ToolAvailabilityUpdate {
+  /** The revision the change was made against; a newer saved revision refuses it. */
+  readonly revision: number;
+  readonly changes: readonly ToolAvailabilityChange[];
+}
+
+/** A manager's view of the setting. Hosts pass it only to people who can change the app. */
+export interface ToolAvailabilityBinding<E> {
+  readonly query: Query<ToolAvailability, E>;
+  /** Answers with the saved revision, which a change queued behind this one is made against. */
+  readonly update: Atom.AtomResultFn<ToolAvailabilityUpdate, { readonly revision: number }, E>;
+  /** Renders a failed save's message; the view adds Retry or Reload itself. */
+  readonly Failure: ComponentType<FailureProps<NoInfer<E>>>;
+  /** The change can't apply to the current setting, such as when someone else saved first. The view offers Reload instead of resending it. */
+  readonly conflict: (cause: Cause.Cause<E>) => boolean;
+}
+
+/** Unknown metadata counts as a write, so a missing hint can never widen a read-only setting. */
+export const isWrite = (tool: Pick<ToolSummary, "readOnly">) => tool.readOnly !== true;
+
+/** Exact overrides win; otherwise the default decides, as the host evaluates it. */
+export const enabledToolNames = (
+  tools: readonly Pick<ToolSummary, "name" | "readOnly">[],
+  defaultMode: ToolDefaultMode,
+  overrides: readonly ToolAvailabilityOverride[],
+): readonly string[] => {
+  const exact = new Map(overrides.map((entry) => [entry.tool, entry.enabled]));
+  return tools
+    .filter((tool) => exact.get(tool.name) ?? (defaultMode === "all" || !isWrite(tool)))
+    .map((tool) => tool.name);
+};
+
+/**
+ * Switch a tree group's tools. A host group with exactly these members is named, so the host
+ * resolves its current members; otherwise the exact tools are listed in the same batch.
+ */
+export const groupChanges = (
+  groups: ToolAvailability["groups"],
+  members: readonly string[],
+  enabled: boolean,
+): readonly ToolAvailabilityChange[] => {
+  const wanted = new Set(members);
+  const group = groups.find(
+    (entry) => entry.tools.length === wanted.size && entry.tools.every((tool) => wanted.has(tool)),
+  );
+  return group !== undefined
+    ? [{ kind: "group", path: group.path, enabled }]
+    : members.map((tool) => ({ kind: "tool", tool, enabled }));
+};
