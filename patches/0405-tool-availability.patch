--- /dev/null
+++ b/apps/hosted/server/src/implementation/tool-availability-store.ts
@@ -0,0 +1,137 @@
+import { AppId, StorageError, type ToolName } from "@executor-js/sdk/core";
+import { Effect, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import { ToolAvailability } from "../contracts/tool-availability.ts";
+import type { OrganizationId } from "../contracts/organization.ts";
+import { policyDatabase } from "./resource-policy.ts";
+import { CurrentOrganization } from "../contracts/organization.ts";
+import { ToolAvailabilityReadAhead } from "./tool-availability-read.ts";
+
+export const migrateToolAvailability = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  yield* sql`create table if not exists hosted_tool_availability (
+    organization_id text not null,
+    app_id text not null,
+    definition jsonb not null,
+    primary key (organization_id, app_id),
+    foreign key (organization_id, app_id) references hosted_app_access (organization_id, id) on delete cascade
+  )`;
+});
+export const defaultAvailability: ToolAvailability = {
+  revision: 0,
+  defaultMode: "all",
+  overrides: [],
+};
+const snapshotAvailability = (
+  read: NonNullable<Effect.Success<typeof ToolAvailabilityReadAhead>>,
+) =>
+  read.definition === null
+    ? Effect.succeed(defaultAvailability)
+    : Schema.decodeUnknownEffect(Schema.fromJsonString(ToolAvailability))(read.definition).pipe(
+        Effect.mapError(() => new StorageError()),
+      );
+
+// A nested or later runtime invocation must read again, even if it inherited the call's context.
+const consumedAvailability = new WeakSet<object>();
+
+export const availabilityFilter = (state: ToolAvailability) => {
+  const overrides = new Map<string, boolean>(
+    state.overrides.map((item) => [item.tool, item.enabled]),
+  );
+  return (tool: { readonly name: string; readonly readOnly?: boolean | undefined }) =>
+    overrides.get(tool.name) ?? (state.defaultMode === "all" || tool.readOnly === true);
+};
+export const toolEnabled = (
+  state: ToolAvailability,
+  tool: { readonly name: string; readonly readOnly?: boolean | undefined },
+) =>
+  state.overrides.find((item) => item.tool === tool.name)?.enabled ??
+  (state.defaultMode === "all" || tool.readOnly === true);
+export const availabilityNeedsMetadata = (state: ToolAvailability, name: string) =>
+  state.defaultMode === "read-only" && !state.overrides.some((item) => item.tool === name);
+export const availabilityScope = (state: ToolAvailability) => ({
+  all: state.defaultMode === "all",
+  readOnly: state.defaultMode === "read-only",
+  names: state.overrides.filter((item) => item.enabled).map((item) => item.tool),
+  excludedNames: state.overrides.filter((item) => !item.enabled).map((item) => item.tool),
+});
+export const readAvailability = (
+  sql: SqlClient.SqlClient,
+  organization: OrganizationId,
+  apps: readonly AppId[],
+) =>
+  Effect.gen(function* () {
+    if (apps.length === 0) return new Map<AppId, ToolAvailability>();
+    const ahead = yield* ToolAvailabilityReadAhead;
+    if (
+      ahead !== undefined &&
+      ahead.organization === organization &&
+      apps.length === 1 &&
+      apps[0] === ahead.app
+    )
+      return new Map([[ahead.app, yield* snapshotAvailability(ahead)]]);
+    const rows = yield* sql`select app_id as app, definition from hosted_tool_availability
+      where organization_id = ${organization} and ${sql.in("app_id", apps)}`;
+    const decoded = yield* Schema.decodeUnknownEffect(
+      Schema.Array(Schema.Struct({ app: AppId, definition: ToolAvailability })),
+    )(rows);
+    return new Map(decoded.map((row) => [row.app, row.definition]));
+  }).pipe(Effect.mapError(() => new StorageError()));
+export const currentAvailabilities = (apps: readonly AppId[]) =>
+  Effect.gen(function* () {
+    const sql = yield* policyDatabase;
+    const { organization } = yield* CurrentOrganization;
+    return yield* readAvailability(sql, organization, apps);
+  });
+export const currentAvailability = (app: AppId) =>
+  currentAvailabilities([app]).pipe(Effect.map((states) => states.get(app) ?? defaultAvailability));
+/** Group names follow dotted routers, or the first underscore prefix for flat APIs. */
+export const toolGroups = (tools: readonly { readonly name: ToolName }[]) => {
+  const groups = new Map<string, ToolName[]>();
+  for (const tool of tools) {
+    const parts = tool.name.split(".");
+    const paths =
+      parts.length > 1
+        ? parts.slice(0, -1).map((_, index) => parts.slice(0, index + 1).join("."))
+        : tool.name.includes("_")
+          ? [tool.name.slice(0, tool.name.indexOf("_"))]
+          : [];
+    for (const path of paths) {
+      const names = groups.get(path) ?? [];
+      names.push(tool.name);
+      groups.set(path, names);
+    }
+  }
+  return [...groups].map(([path, tools]) => ({ path, tools }));
+};
