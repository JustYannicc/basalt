+      content: `import { defineApp, query, mutation, object, router } from "apps";
+const guarded = query({ input: object({}) }, async () => ({ executed: true }));
+const added = mutation({ input: object({}) }, async () => ({ wrote: true }));
+export default defineApp({ accounts: {} }, { tools: router({ guarded, added }) });`,
+    },
+  ];
