@@ -0,0 +1,147 @@
+/**
+ * An app instance's tool availability, read and changed by its managers. The list includes
+ * switched-off tools, which only this manager read reveals; agents' discovery stays filtered.
+ */
+import { hydrated } from "@executor-js/ui/contracts/http";
+import { revalidated } from "@executor-js/ui/contracts/refresh";
+import { acknowledge, invalidate } from "@executor-js/ui/contracts/mutations";
+import type { Query, ToolCatalog } from "@executor-js/ui/contracts/dashboard";
+import {
+  enabledToolNames,
+  type ToolAvailability,
+  type ToolAvailabilityUpdate,
+} from "@executor-js/ui/contracts/tool-availability";
+import { ToolName, type AppId, type VersionId } from "@executor-js/sdk";
+import type { OrganizationReference } from "@executor-js/hosted-server/organization";
+import { AsyncResult, Atom } from "effect/reactivity";
+import { Cause, Data, Effect, Option } from "effect";
+import { HostedClient } from "./api.ts";
+import { protectedQuery } from "./protected-query.ts";
+import { toolsAtom } from "./apps.ts";
+import type { HostedError } from "./errors.ts";
+
+/** The version names the catalog the setting is shown against, so an upgrade reads it again. */
+class AvailabilityKey extends Data.Class<{
+  readonly organization: OrganizationReference;
+  readonly app: AppId;
+  readonly version?: VersionId | undefined;
+}> {}
+
+const lists = Atom.family((key: AvailabilityKey) =>
+  HostedClient.query(
+    "toolAvailability",
+    "list",
+    hydrated({ params: { organization: key.organization, app: key.app } }),
+  ).pipe(revalidated, protectedQuery),
+);
+
+const catalogs = Atom.family((key: AvailabilityKey) =>
+  Atom.map(
+    lists(key),
+    AsyncResult.map((list): ToolCatalog => ({
+      tools: list.catalog.items,
+      routers: list.catalog.routers,
+    })),
+  ),
+);
+/** Account changes invalidate the manager's catalog as well as ordinary discovery. */
+export const refreshToolAvailabilityDiscovery = (
+  get: Atom.FnContext,
+  key: ConstructorParameters<typeof AvailabilityKey>[0],
+) => invalidate(get, lists(new AvailabilityKey(key)));
+
+/** Every tool of the app, switched off or not, for a manager's browser. */
+export const toolAvailabilityCatalogAtom = (
+  key: ConstructorParameters<typeof AvailabilityKey>[0],
+) => catalogs(new AvailabilityKey(key));
+
+const settings = Atom.family((key: AvailabilityKey) =>
+  Atom.map(
+    lists(key),
+    AsyncResult.map((list): ToolAvailability => ({
+      revision: list.revision,
+      defaultMode: list.defaultMode,
+      overrides: list.overrides,
+      enabledTools: list.enabledTools,
+      groups: list.groups,
+    })),
+  ),
+);
+/** Typed with the whole hosted error union so the setting and its save share one failure view. */
+export const toolAvailabilityAtom = (
+  key: ConstructorParameters<typeof AvailabilityKey>[0],
+): Query<ToolAvailability, HostedError> => settings(new AvailabilityKey(key));
+
+class DetailKey extends Data.Class<
+  ConstructorParameters<typeof AvailabilityKey>[0] & { readonly tool: ToolName }
+> {}
+const detailQueries = Atom.family((key: DetailKey) =>
+  HostedClient.query(
+    "toolAvailability",
+    "get",
+    hydrated({ params: { organization: key.organization, app: key.app, tool: key.tool } }),
+  ).pipe(revalidated),
+);
+const details = Atom.family((key: DetailKey) =>
+  HostedClient.runtime.atom((get) =>
+    get
+      .result(detailQueries(key))
+      // A tool that left the catalog since the list was read is not a failure.
+      .pipe(Effect.catchTag("ToolNotFound", () => Effect.succeed(undefined))),
+  ),
+);
+/** One tool's schemas, including a switched-off tool's, for its manager. */
+export const toolAvailabilityDetailAtom = (key: ConstructorParameters<typeof DetailKey>[0]) =>
+  details(new DetailKey(key));
+
+const updates = Atom.family((key: AvailabilityKey) =>
+  HostedClient.runtime.fn((input: ToolAvailabilityUpdate, get) =>
+    Effect.flatMap(HostedClient, (client) =>
+      client.toolAvailability.update({
+        params: { organization: key.organization, app: key.app },
+        payload: {
+          ...input,
+          changes: input.changes.map((change) =>
+            change.kind === "tool" ? { ...change, tool: ToolName.make(change.tool) } : change,
+          ),
+        },
+      }),
+    ).pipe(
+      Effect.tap((saved) =>
+        Effect.sync(() => {
+          // Show the confirmed save at once; the read that follows replaces it with the host's.
+          acknowledge(get, lists(key), (current) => ({
+            ...current,
+            revision: saved.revision,
+            defaultMode: saved.defaultMode,
+            overrides: saved.overrides,
+            enabledTools: enabledToolNames(
+              current.catalog.items,
+              saved.defaultMode,
+              saved.overrides,
+            ).map((name) => ToolName.make(name)),
+          }));
+          // Ordinary discovery, on this page and in connection pickers, lists only enabled tools.
+          get.refresh(toolsAtom(key));
+          get.refresh(toolsAtom({ organization: key.organization, app: key.app }));
+        }),
+      ),
+    ),
+  ),
+);
+/** Each app owns its save, so a change in one app never cancels another's. */
+export const updateToolAvailabilityAtom = (
+  key: ConstructorParameters<typeof AvailabilityKey>[0],
+): Atom.AtomResultFn<ToolAvailabilityUpdate, { readonly revision: number }, HostedError> =>
+  updates(new AvailabilityKey(key));
+
+/**
+ * Another manager saved first, or the catalog lost a tool or group the change named. Resending
+ * the same change cannot succeed, so the view reloads the current setting instead.
+ */
+export const toolAvailabilityConflict = (cause: Cause.Cause<HostedError>) =>
+  Option.exists(
+    Cause.findErrorOption(cause),
+    (error) =>
+      error._tag === "ToolAvailabilityConflict" || error._tag === "ToolAvailabilityInvalid",
+  );
