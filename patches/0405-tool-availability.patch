+/** Trusted runtime dispatch supplies app identity, without depending on a bundle callback. */
+export const hostedToolAccess =
+  (sql: SqlClient.SqlClient) =>
+  (input: {
+    readonly app: AppId;
+    readonly tool: string;
+    readonly kind?: "query" | "mutation" | undefined;
+  }) =>
+    Effect.gen(function* () {
+      const ahead = yield* ToolAvailabilityReadAhead;
+      if (
+        ahead !== undefined &&
+        ahead.app === input.app &&
+        ahead.tool === input.tool &&
+        !consumedAvailability.has(ahead)
+      ) {
+        consumedAvailability.add(ahead);
+        return toolEnabled(yield* snapshotAvailability(ahead), {
+          name: input.tool,
+          readOnly: input.kind === "query",
+        });
+      }
+      const rows =
+        yield* sql`select definition from hosted_tool_availability where app_id = ${input.app}`;
+      const decoded = yield* Schema.decodeUnknownEffect(
+        Schema.Array(Schema.Struct({ definition: ToolAvailability })),
+      )(rows);
+      const state = decoded[0]?.definition ?? defaultAvailability;
+      return toolEnabled(state, { name: input.tool, readOnly: input.kind === "query" });
+    }).pipe(Effect.mapError(() => new StorageError()));
