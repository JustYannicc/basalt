+import type { AppId } from "@executor-js/sdk/core";
+import { Context } from "effect";
+import type { OrganizationId } from "../contracts/organization.ts";
+
+/** One MCP call's availability from its access snapshot, never retained in the session cache. */
+export const ToolAvailabilityReadAhead = Context.Reference<
+  | {
+      readonly organization: OrganizationId;
+      readonly app: AppId;
+      readonly tool: string;
+      readonly definition: string | null;
+    }
