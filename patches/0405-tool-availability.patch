@@ -0,0 +1,303 @@
+/**
+ * A manager's controls for which tools agents can find and use. Every change saves at once as one
+ * atomic batch against the revision on screen; controls show the confirmed answer, never a guess.
+ */
+import type { ToolSummary } from "@executor-js/sdk";
+import { useAtomSet } from "@effect/atom-react";
+import { HugeiconsIcon } from "@hugeicons/react";
+import { ArrowDown01Icon } from "@hugeicons/core-free-icons";
+import { Exit, Option, type Cause } from "effect";
+import { useId, useRef, useState, type ComponentType } from "react";
+import type { FailureProps } from "../../contracts/dashboard.ts";
+import {
+  isWrite,
+  type ToolAvailability,
+  type ToolAvailabilityBinding,
+  type ToolAvailabilityChange,
+} from "../../contracts/tool-availability.ts";
+import { Button } from "../components/button.tsx";
+import { Checkbox } from "../components/checkbox.tsx";
+import {
+  DropdownMenu,
+  DropdownMenuCheckboxItem,
+  DropdownMenuContent,
+  DropdownMenuItem,
+  DropdownMenuLabel,
+  DropdownMenuSeparator,
+  DropdownMenuTrigger,
+} from "../components/dropdown-menu.tsx";
+import { Switch } from "../components/switch.tsx";
+import { cn } from "../lib/utils.ts";
+import { useQuery } from "./context.tsx";
+
+interface Batch {
+  readonly changes: readonly ToolAvailabilityChange[];
+  /** Tools whose controls wait for this batch's answer. */
+  readonly affected: readonly string[];
+}
+
+/** A later switch of the same tool replaces an earlier one still waiting in the queue. */
+const merge = (first: Batch, second: Batch): Batch => ({
+  changes: [
+    ...first.changes.filter(
+      (change) =>
+        change.kind !== "tool" ||
+        !second.changes.some((next) => next.kind === "tool" && next.tool === change.tool),
+    ),
+    ...second.changes,
+  ],
+  affected: [...first.affected, ...second.affected],
+});
+
+/** The saved setting and the actions a view needs; undefined state until the first read lands. */
+export interface AvailabilityController<E> {
+  readonly state: ToolAvailability | undefined;
+  readonly enabled: ReadonlySet<string>;
+  readonly busy: ReadonlySet<string>;
+  readonly apply: (changes: readonly ToolAvailabilityChange[], affected: readonly string[]) => void;
+  readonly failure:
+    | {
+        readonly cause: Cause.Cause<E>;
+        readonly conflict: boolean;
+        readonly retry: () => void;
+        readonly reload: () => void;
+      }
+    | undefined;
+  readonly Failure: ComponentType<FailureProps<NoInfer<E>>>;
+}
+
+/**
+ * Hosts render this only for people who can change the app. A change made while another saves
+ * waits and is sent against the revision that save returned, so no click is dropped and none is
+ * sent against a revision it never saw.
+ */
+export function useToolAvailability<E>(
+  binding: ToolAvailabilityBinding<E>,
+): AvailabilityController<E> {
+  const { data, refresh } = useQuery(binding.query);
+  const run = useAtomSet(binding.update, { mode: "promiseExit" });
+  const [busy, setBusy] = useState<ReadonlySet<string>>(() => new Set());
+  const [failed, setFailed] = useState<{ cause: Cause.Cause<E>; batch: Batch }>();
+  const inFlight = useRef(false);
+  const queued = useRef<Batch | undefined>(undefined);
+  const state = Option.getOrUndefined(data);
+
+  const send = async (batch: Batch, revision: number): Promise<void> => {
+    inFlight.current = true;
+    const exit = await run({ revision, changes: batch.changes });
+    const next = queued.current;
+    queued.current = undefined;
+    if (Exit.isSuccess(exit) && next !== undefined) return send(next, exit.value.revision);
+    inFlight.current = false;
+    setBusy(new Set());
+    if (Exit.isFailure(exit))
+      setFailed({ cause: exit.cause, batch: next === undefined ? batch : merge(batch, next) });
+  };
+  const apply = (changes: readonly ToolAvailabilityChange[], affected: readonly string[]) => {
+    if (state === undefined || changes.length === 0) return;
+    const batch = { changes, affected };
+    setFailed(undefined);
+    setBusy((previous) => new Set([...previous, ...affected]));
+    if (inFlight.current) {
+      queued.current = queued.current === undefined ? batch : merge(queued.current, batch);
+      return;
+    }
+    void send(batch, state.revision);
+  };
+
+  return {
+    state,
+    enabled: new Set(state?.enabledTools ?? []),
+    busy,
+    apply,
+    failure:
+      failed === undefined
+        ? undefined
+        : {
+            cause: failed.cause,
+            conflict: binding.conflict(failed.cause),
+            retry: () => apply(failed.batch.changes, failed.batch.affected),
+            reload: () => {
+              setFailed(undefined);
+              refresh();
+            },
+          },
+    Failure: binding.Failure,
+  };
+}
+
+/** A failed save keeps the previous saved state on screen and says how to recover. */
+export function AvailabilityNotice<E>({
+  controller,
+  className,
+}: {
+  readonly controller: AvailabilityController<E>;
+  readonly className?: string;
+}) {
+  const { failure, Failure } = controller;
+  if (failure === undefined) return null;
+  return (
+    <div
+      role="alert"
+      className={cn("flex items-start gap-2 text-[12.5px] leading-snug", className)}
+    >
+      <div className="min-w-0 flex-1 pt-0.5">
+        <Failure cause={failure.cause} layout="compact" />
+      </div>
+      <Button
+        variant="outline"
+        size="xs"
+        className="shrink-0 max-[740px]:h-11"
+        onClick={failure.conflict ? failure.reload : failure.retry}
+      >
+        {failure.conflict ? "Reload" : "Retry"}
+      </Button>
+    </div>
+  );
+}
+
+/** The list's second row: reveal hidden tools, and the switch for every write at once. */
+export function AvailabilityToolbar<E>({
+  controller,
+  tools,
+  showHidden,
+  onShowHidden,
+}: {
+  readonly controller: AvailabilityController<E>;
+  readonly tools: readonly ToolSummary[];
+  readonly showHidden: boolean;
+  readonly onShowHidden: (show: boolean) => void;
+}) {
+  const id = useId();
+  const hidden = tools.filter((tool) => !controller.enabled.has(tool.name)).length;
+  return (
+    <>
+      <div className="flex min-h-10 shrink-0 items-center gap-1 border-b pr-1.5 pl-3 max-[740px]:min-h-12">
+        <Checkbox
+          id={id}
+          variant="strong"
+          checked={showHidden}
+          onCheckedChange={(checked) => onShowHidden(checked === true)}
+        />
+        <label
+          htmlFor={id}
+          className="flex min-h-8 min-w-0 flex-1 cursor-pointer items-center gap-1.5 pl-2 text-[12.5px] text-muted-foreground select-none max-[740px]:min-h-11"
+        >
+          <span className="truncate">Show hidden tools</span>
+          {hidden > 0 && <span className="tabular-nums">{hidden}</span>}
+        </label>
+        <WritesMenu controller={controller} tools={tools} />
+      </div>
+      <AvailabilityNotice controller={controller} className="border-b bg-destructive/5 px-3 py-2" />
+    </>
+  );
+}
+
+/**
+ * Writes are every tool not positively marked read-only. Turning them off also keeps write tools
+ * that later versions add off; that default is its own reversible choice.
+ */
+function WritesMenu<E>({
+  controller,
+  tools,
+}: {
+  readonly controller: AvailabilityController<E>;
+  readonly tools: readonly ToolSummary[];
+}) {
+  const writes = tools.filter(isWrite).map((tool) => tool.name);
+  const on = writes.filter((tool) => controller.enabled.has(tool)).length;
+  const readOnlyDefault = controller.state?.defaultMode === "read-only";
+  const allOff = readOnlyDefault && on === 0;
+  const allOn = !readOnlyDefault && on === writes.length;
+  const summary = allOff ? "Writes off" : allOn ? "Writes on" : "Some writes";
+  const busy = writes.some((tool) => controller.busy.has(tool));
+  return (
+    <DropdownMenu>
+      <DropdownMenuTrigger asChild>
+        <Button
+          variant="ghost"
+          size="xs"
+          loading={busy}
+          disabled={controller.state === undefined}
+          className="shrink-0 gap-1 text-muted-foreground max-[740px]:h-11"
+        >
+          {summary}
+          <HugeiconsIcon icon={ArrowDown01Icon} size={13} aria-hidden />
+        </Button>
+      </DropdownMenuTrigger>
+      <DropdownMenuContent align="end" className="w-64">
+        <DropdownMenuItem
+          disabled={allOff}
+          onSelect={() => controller.apply([{ kind: "writes", enabled: false }], writes)}
+        >
+          Turn off all writes
+        </DropdownMenuItem>
+        <DropdownMenuItem
+          disabled={allOn}
+          onSelect={() => controller.apply([{ kind: "writes", enabled: true }], writes)}
+        >
+          Turn on all writes
+        </DropdownMenuItem>
+        <DropdownMenuSeparator />
+        <DropdownMenuCheckboxItem
+          checked={readOnlyDefault}
+          onCheckedChange={(checked) =>
+            controller.apply(
+              [{ kind: "default", defaultMode: checked ? "read-only" : "all" }],
+              writes,
+            )
+          }
+        >
+          Keep new write tools off
+        </DropdownMenuCheckboxItem>
+        <DropdownMenuLabel className="text-xs font-normal leading-snug text-muted-foreground">
+          {writes.length === 0
+            ? "This version has no write tools."
+            : `${on} of ${writes.length} write tools on.`}{" "}
+          Applies to everyone using this app. Approval rules still apply.
+        </DropdownMenuLabel>
+      </DropdownMenuContent>
+    </DropdownMenu>
+  );
+}
+
+/** The selected tool's own switch, reachable even after the list stops showing it. */
+export function AvailabilityRow<E>({
+  controller,
+  tool,
+  onChange,
+}: {
+  readonly controller: AvailabilityController<E>;
+  readonly tool: ToolSummary;
+  readonly onChange: (enabled: boolean) => void;
+}) {
+  const id = useId();
+  const on = controller.enabled.has(tool.name);
+  const busy = controller.busy.has(tool.name);
+  return (
+    <div className="mt-6 border-y py-3">
+      <div className="flex items-center gap-4">
+        <div className="min-w-0 flex-1">
+          <div id={`${id}-label`} className="text-sm font-medium">
+            {on ? "On for agents" : "Hidden from agents"}
+          </div>
+          <p id={`${id}-description`} className="text-xs leading-normal text-muted-foreground">
+            {on
+              ? "Agents can find and use this tool. Applies to everyone using this app."
+              : "Agents can't find or call this tool. Turn it on to run it here."}
+          </p>
+        </div>
+        <Switch
+          checked={on}
+          disabled={busy || controller.state === undefined}
+          aria-busy={busy || undefined}
+          aria-label="Available to agents"
+          aria-describedby={`${id}-description`}
+          onCheckedChange={onChange}
+        />
+      </div>
+      {/* The list's notice sits behind the open inspector on phones. */}
+      <AvailabilityNotice controller={controller} className="mt-3 hidden max-[740px]:flex" />
+    </div>
+  );
+}
