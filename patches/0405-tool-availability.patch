+import { expect } from "@effect/vitest";
+import { Effect } from "effect";
+import { Api, body } from "./api.ts";
+import { Actors } from "./actors.ts";
+import { Browser } from "./browser.ts";
+import { holdQuery } from "./query-transition.ts";
+import { AvailabilityCatalog } from "./tool-availability-fixture.ts";
+import { restoreAvailabilityTool } from "./tool-availability-ui.ts";
+
+export const verifyAvailabilitySaveRecovery = (path: string) =>
+  Effect.gen(function* () {
+    const browser = yield* Browser,
+      api = yield* Api,
+      actors = yield* Actors;
+    const current = () =>
+      api
+        .request(actors.owner, "GET", `${path}/tool-availability`)
+        .pipe(Effect.flatMap((response) => body(AvailabilityCatalog, response)));
+    const saved = yield* current();
+    const hold = yield* holdQuery(/\/tool-availability$/, "undeclared", { method: "PATCH" });
+    yield* browser.use("Attempt a save while the server is unavailable", (page) =>
+      page.getByRole("switch", { name: "Enable records.write", exact: true }).first().click(),
+    );
+    yield* hold.requested;
+    yield* hold.release;
+    yield* browser.use("Wait for the save retry", (page) =>
+      page.getByRole("button", { name: "Retry", exact: true }).waitFor(),
+    );
+    expect((yield* current()).revision).toBe(saved.revision);
+    const stillEnabled = yield* browser.use("Keep the confirmed switch after failure", (page) =>
+      page
+        .getByRole("switch", { name: "Enable records.write", exact: true })
+        .first()
+        .getAttribute("aria-checked"),
+    );
+    expect(stillEnabled).toBe("true");
+    yield* browser.use("Retry the failed save", (page) =>
+      page.getByRole("button", { name: "Retry", exact: true }).click(),
+    );
+    yield* browser.use("Wait for the retried tool to hide", (page) =>
+      page.getByRole("button", { name: "records.write", exact: true }).waitFor({ state: "hidden" }),
+    );
+    yield* restoreAvailabilityTool;
+    const beforeConflict = yield* current();
+    const changed = yield* api.request(actors.owner, "PATCH", `${path}/tool-availability`, {
+      revision: beforeConflict.revision,
+      changes: [{ kind: "tool", tool: "records.review", enabled: false }],
+    });
+    expect(changed.status).toBe(200);
+    yield* browser.use("Save against the screen's older revision", (page) =>
+      page.getByRole("switch", { name: "Enable records.write", exact: true }).first().click(),
+    );
+    yield* browser.use("Wait for conflict recovery", (page) =>
+      page.getByRole("button", { name: "Reload", exact: true }).waitFor(),
+    );
+    const conflictState = yield* current();
+    expect(conflictState.revision).toBe(beforeConflict.revision + 1);
+    expect(conflictState.enabledTools).toContain("records.write");
+    expect(conflictState.enabledTools).not.toContain("records.review");
+    yield* browser.use("Reload the teammate's saved state", (page) =>
+      page.getByRole("button", { name: "Reload", exact: true }).click(),
+    );
+    yield* browser.use("Observe the teammate's hidden tool", (page) =>
+      page
+        .getByRole("button", { name: "records.review", exact: true })
+        .waitFor({ state: "hidden" }),
+    );
+    yield* browser.use("Reveal the teammate's hidden tool", (page) =>
+      page.getByRole("checkbox", { name: /Show hidden tools/ }).check(),
+    );
+    yield* browser.use("Restore the hidden tool after reloading", (page) =>
+      page.getByRole("switch", { name: "Enable records.review", exact: true }).first().click(),
+    );
+    yield* browser.use("Wait for the saved restoration", (page) =>
+      page
+        .getByRole("switch", { name: "Enable records.review", exact: true })
+        .first()
+        .and(page.locator('[aria-checked="true"]'))
+        .waitFor(),
+    );
+    yield* browser.use("Return to enabled rows", (page) =>
+      page.getByRole("checkbox", { name: /Show hidden tools/ }).uncheck(),
+    );
+  });
