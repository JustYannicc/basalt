+
+export const openAvailabilityTools = (organization: string, app: string) =>
+  Effect.gen(function* () {
+    const browser = yield* Browser;
+    yield* browser.use("Use desktop viewport", (page) =>
+      page.setViewportSize({ width: 1280, height: 900 }),
+    );
+    yield* browser.use("Open the current Tools tab", (page) =>
+      page.goto(`/org/${organization}/apps/${app}?view=tools`),
+    );
+    yield* browser.use("Wait for the tool catalog", (page) =>
+      page.getByRole("button", { name: "records.write", exact: true }).waitFor(),
+    );
+  });
+
+export const hideAvailabilityTool = Effect.gen(function* () {
+  const browser = yield* Browser;
+  const count = yield* browser.use("Find the tool switch", (page) =>
+    page.getByRole("switch", { name: "Enable records.write", exact: true }).first().count(),
+  );
+  expect(count).toBe(1);
+  yield* browser.use("Hide a tool with its switch", (page) =>
+    page.getByRole("switch", { name: "Enable records.write", exact: true }).first().click(),
+  );
+  yield* browser.use("Wait for the hidden row to leave", (page) =>
+    page.getByRole("button", { name: "records.write", exact: true }).waitFor({ state: "hidden" }),
+  );
+});
+
+export const restoreAvailabilityTool = Effect.gen(function* () {
+  const browser = yield* Browser;
+  yield* browser.use("Show hidden tools", (page) =>
+    page.getByRole("checkbox", { name: /Show hidden tools/ }).check(),
+  );
+  yield* browser.use("Find the hidden row", (page) =>
+    page.getByRole("button", { name: "records.write", exact: true }).waitFor(),
+  );
+  const enabled = yield* browser.use("Read the saved hidden state", (page) =>
+    page
+      .getByRole("switch", { name: "Enable records.write", exact: true })
+      .first()
+      .getAttribute("aria-checked"),
+  );
+  expect(enabled).toBe("false");
+  yield* browser.use("Enable the hidden tool", (page) =>
+    page.getByRole("switch", { name: "Enable records.write", exact: true }).first().click(),
+  );
+  yield* browser.use("Wait for the confirmed enabled switch", (page) =>
+    page
+      .getByRole("switch", { name: "Enable records.write", exact: true })
+      .first()
+      .and(page.locator('[aria-checked="true"]:not(:disabled)'))
+      .waitFor(),
+  );
+  yield* browser.use("Wait for the restored switch to finish moving", (page) =>
+    page
+      .getByRole("switch", { name: "Enable records.write", exact: true })
+      .first()
+      .evaluate((element) =>
+        Promise.allSettled(
+          element.getAnimations({ subtree: true }).map((animation) => animation.finished),
+        ),
+      ),
+  );
+  yield* browser.use("Return to enabled tools", (page) =>
+    page.getByRole("checkbox", { name: /Show hidden tools/ }).uncheck(),
+  );
+  yield* browser.use("Wait for the restored tool", (page) =>
+    page.getByRole("button", { name: "records.write", exact: true }).waitFor(),
+  );
+});
+
+export const hideAvailabilityToolOnPhone = Effect.gen(function* () {
+  const browser = yield* Browser;
+  yield* browser.use("Use phone viewport", (page) =>
+    page.setViewportSize({ width: 390, height: 844 }),
+  );
+  const closed = yield* browser.use("Find phone tools opener", (page) =>
+    page.getByRole("button", { name: /Show all .* tools/ }).isVisible(),
+  );
+  if (closed)
+    yield* browser.use("Open phone tools list", (page) =>
+      page.getByRole("button", { name: /Show all .* tools/ }).click(),
+    );
+  yield* browser.use("Wait for the phone switch", (page) =>
+    page.getByRole("switch", { name: "Enable records.write", exact: true }).first().waitFor(),
+  );
+  yield* browser.use("Wait for the phone list to finish opening", (page) =>
+    page.waitForFunction(() => {
+      const panel = document.getElementById("tools-list-panel");
+      return panel !== null && getComputedStyle(panel).opacity === "1";
+    }),
+  );
+  const box = yield* browser.use("Measure phone switch hit target", (page) =>
+    page.getByRole("switch", { name: "Enable records.write", exact: true }).first().boundingBox(),
+  );
+  expect(box?.height).toBeGreaterThanOrEqual(44);
+  const fits = yield* browser.use("Check phone document width", (page) =>
+    page.evaluate(() => document.documentElement.scrollWidth <= innerWidth),
+  );
+  expect(fits).toBe(true);
+  yield* hideAvailabilityTool;
+  yield* browser.use("Show hidden tools on phone", (page) =>
+    page.getByRole("checkbox", { name: /Show hidden tools/ }).check(),
+  );
+  yield* browser.use("Wait for hidden tool on phone", (page) =>
+    page.getByRole("button", { name: "records.write", exact: true }).waitFor(),
+  );
+});
+
+export const verifyAvailabilityBulkControls = Effect.gen(function* () {
+  const browser = yield* Browser;
+  yield* browser.use("Select a tool before hiding it", (page) =>
+    page.getByRole("button", { name: "records.write", exact: true }).click(),
+  );
+  yield* browser.use("Hide the selected tool in its inspector", (page) =>
+    page.getByRole("switch", { name: "Available to agents", exact: true }).click(),
+  );
+  yield* browser.use("Keep the hidden tool in its inspector", (page) =>
+    page.getByText("Hidden from agents", { exact: true }).waitFor(),
+  );
+  const runs = yield* browser.use("No run action for the hidden tool", (page) =>
+    page.getByRole("button", { name: "Run tool", exact: true }).count(),
+  );
+  expect(runs).toBe(0);
+  yield* browser.use("Restore the selected tool in its inspector", (page) =>
+    page.getByRole("switch", { name: "Available to agents", exact: true }).click(),
+  );
+  yield* browser.use("Wait for restored inspector", (page) =>
+    page.getByText("On for agents", { exact: true }).waitFor(),
+  );
+  yield* browser.use("Turn off a whole group", (page) =>
+    page.getByRole("checkbox", { name: "Enable all tools in Records", exact: true }).click(),
+  );
+  yield* browser.use("Wait for the group's hidden rows", (page) =>
+    page.getByRole("button", { name: "records.review", exact: true }).waitFor({ state: "hidden" }),
+  );
+  yield* browser.use("Reveal the disabled group", (page) =>
+    page.getByRole("checkbox", { name: /Show hidden tools/ }).check(),
+  );
+  yield* browser.use("Restore the whole group", (page) =>
+    page.getByRole("checkbox", { name: "Enable all tools in Records", exact: true }).click(),
+  );
+  yield* browser.use("Wait for group restore", (page) =>
+    page
+      .getByRole("switch", { name: "Enable records.review", exact: true })
+      .and(page.locator('[aria-checked="true"]'))
+      .waitFor(),
+  );
+  yield* browser.use("Hide disabled rows again", (page) =>
+    page.getByRole("checkbox", { name: /Show hidden tools/ }).uncheck(),
+  );
+  yield* browser.use("Open the write controls", (page) =>
+    page.getByRole("button", { name: "Writes on", exact: true }).click(),
+  );
+  yield* browser.use("Disable every write", (page) =>
+    page.getByRole("menuitem", { name: "Turn off all writes", exact: true }).click(),
+  );
+  yield* browser.use("Wait for the read-only default", (page) =>
+    page.getByRole("button", { name: "Writes off", exact: true }).waitFor(),
+  );
+  const read = yield* browser.use("Read tool stays visible", (page) =>
+    page.getByRole("button", { name: "counter.count", exact: true }).count(),
+  );
+  expect(read).toBe(1);
+  yield* browser.use("Turn off the last visible group", (page) =>
+    page.getByRole("checkbox", { name: "Enable all tools in Counter", exact: true }).click(),
+  );
+  yield* browser.use("Show the all-hidden recovery", (page) =>
+    page.getByText("Every tool is hidden", { exact: true }).waitFor(),
+  );
+  yield* browser.use("Reveal all hidden tools with recovery action", (page) =>
+    page.getByRole("button", { name: "Show hidden tools", exact: true }).click(),
+  );
+  yield* browser.use("Restore read tools", (page) =>
+    page.getByRole("checkbox", { name: "Enable all tools in Counter", exact: true }).click(),
+  );
+  yield* browser.use("Open disabled writes menu", (page) =>
+    page.getByRole("button", { name: "Writes off", exact: true }).click(),
+  );
+  yield* browser.use("Restore every write", (page) =>
+    page.getByRole("menuitem", { name: "Turn on all writes", exact: true }).click(),
+  );
+  yield* browser.use("Wait for all write tools restored", (page) =>
+    page.getByRole("button", { name: "Writes on", exact: true }).waitFor(),
+  );
+  yield* browser.use("Return to enabled tools after bulk recovery", (page) =>
+    page.getByRole("checkbox", { name: /Show hidden tools/ }).uncheck(),
+  );
+});
