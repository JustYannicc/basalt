+import { StorageError, type AppId, type ToolName } from "@executor-js/sdk/core";
+import { discoversTool, permitsRouter } from "@executor-js/authorization";
+import { Effect } from "effect";
+import { HostedExecutor } from "../contracts/executor.ts";
+import { OrganizationForbidden } from "../contracts/organization.ts";
+import {
+  ToolAvailabilityConflict,
+  ToolAvailabilityInvalid,
+  type ToolAvailability,
+  type ToolAvailabilityChange,
+} from "../contracts/tool-availability.ts";
+import { authorizeApp } from "./authorization.ts";
+import { currentOwner, selectedActiveVersion } from "./access.ts";
+import {
+  applicationAccess,
+  currentResourceAuthority,
+  lockCurrentActor,
+  policyDatabase,
+} from "./resource-policy.ts";
+import {
+  defaultAvailability,
+  currentAvailability,
+  readAvailability,
+  availabilityFilter,
+  toolGroups,
+} from "./tool-availability-store.ts";
+
+const managerCatalog = (app: AppId) =>
+  Effect.gen(function* () {
+    const actor = yield* currentResourceAuthority;
+    if (!(yield* applicationAccess(app, actor)).canManage)
+      return yield* new OrganizationForbidden();
+    const policy = yield* authorizeApp(app);
+    const executor = yield* Effect.flatten(HostedExecutor);
+    const selected = yield* selectedActiveVersion(executor, yield* currentOwner, { app });
+    const catalog = yield* executor.tools.index({ app, ...selected });
+    const items = catalog.items.filter((tool) => discoversTool(policy, { app, tool }));
+    return {
+      catalog: {
+        ...catalog,
+        items,
+        routers: catalog.routers.filter((router) =>
+          permitsRouter(policy, { app, path: router.path }, items),
+        ),
+      },
+      executor,
+      selected,
+      policy,
+    };
+  });
+export const listToolAvailability = (app: AppId) =>
+  Effect.gen(function* () {
+    const { catalog } = yield* managerCatalog(app);
+    const state = yield* currentAvailability(app);
+    return {
+      ...state,
+      catalog,
+      enabledTools: catalog.items.filter(availabilityFilter(state)).map((tool) => tool.name),
+      groups: toolGroups(catalog.items),
+    };
+  });
+export const getAvailabilityTool = (app: AppId, tool: ToolName) =>
+  Effect.gen(function* () {
+    const { executor, selected, policy } = yield* managerCatalog(app);
+    const described = yield* executor.tools.get({ app, tool, ...selected });
+    if (!discoversTool(policy, { app, tool: described })) return yield* new OrganizationForbidden();
+    return described;
+  });
+export const updateToolAvailability = (
+  app: AppId,
+  input: { readonly revision: number; readonly changes: readonly ToolAvailabilityChange[] },
+) =>
+  Effect.gen(function* () {
+    const { catalog } = yield* managerCatalog(app);
+    const sql = yield* policyDatabase;
+    return yield* sql.withTransaction(
+      Effect.gen(function* () {
+        const actor = yield* lockCurrentActor;
+        // The app row serializes first writes too, when the availability row does not exist yet.
+        yield* sql`select id from hosted_app_access where organization_id = ${actor.organization} and id = ${app} for update`;
+        if (!(yield* applicationAccess(app, actor)).canManage)
+          return yield* new OrganizationForbidden();
+        const state =
+          (yield* readAvailability(sql, actor.organization, [app])).get(app) ?? defaultAvailability;
+        if (state.revision !== input.revision) return yield* new ToolAvailabilityConflict();
+        let defaultMode = state.defaultMode;
+        const overrides = new Map(state.overrides.map((item) => [item.tool, item.enabled]));
+        const names = new Set(catalog.items.map((tool) => tool.name));
+        const groups = toolGroups(catalog.items);
+        for (const change of input.changes) {
+          if (change.kind === "default") defaultMode = change.defaultMode;
+          else if (change.kind === "tool") {
+            if (!names.has(change.tool)) return yield* new ToolAvailabilityInvalid();
+            overrides.set(change.tool, change.enabled);
+          } else if (change.kind === "group") {
+            const group = groups.find((group) => group.path === change.path);
+            if (group === undefined) return yield* new ToolAvailabilityInvalid();
+            for (const name of group.tools) overrides.set(name, change.enabled);
+          } else {
+            defaultMode = change.enabled ? "all" : "read-only";
+            for (const tool of catalog.items)
+              if (tool.readOnly !== true) overrides.set(tool.name, change.enabled);
+          }
+        }
+        const saved: ToolAvailability = {
+          revision: state.revision + 1,
+          defaultMode,
+          overrides: [...overrides]
+            .sort(([a], [b]) => a.localeCompare(b))
+            .map(([tool, enabled]) => ({ tool, enabled })),
+        };
+        yield* sql`insert into hosted_tool_availability (organization_id, app_id, definition)
+      values (${actor.organization}, ${app}, ${JSON.stringify(saved)}::jsonb)
+      on conflict (organization_id, app_id) do update set definition = excluded.definition`;
+        return saved;
+      }),
+    );
+  }).pipe(Effect.catchTag("SqlError", () => new StorageError()));
