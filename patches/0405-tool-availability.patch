+import { expect } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Api, body } from "./api.ts";
+import { Actors } from "./actors.ts";
+import { App } from "./contracts.ts";
+import { appsManifest } from "./apps-release.ts";
+import { McpClient } from "./mcp-client.ts";
+
+export const Availability = Schema.Struct({
+  revision: Schema.Int,
+  defaultMode: Schema.Literals(["all", "read-only"]),
+  overrides: Schema.Array(Schema.Struct({ tool: Schema.String, enabled: Schema.Boolean })),
+});
+export const AvailabilityCatalog = Schema.Struct({
+  ...Availability.fields,
+  enabledTools: Schema.Array(Schema.String),
+  catalog: Schema.Struct({ items: Schema.Array(Schema.Struct({ name: Schema.String })) }),
+  groups: Schema.Array(Schema.Struct({ path: Schema.String, tools: Schema.Array(Schema.String) })),
+});
+export const Pending = Schema.Struct({
+  status: Schema.Literal("approval-required"),
+  requestId: Schema.String,
+});
+export const completed = <S extends Schema.Top>(value: S) =>
+  Schema.Struct({
+    status: Schema.Literal("completed"),
+    execution: Schema.Struct({ ok: Schema.Literal(true), value }),
+  });
+export const outcome = <S extends Schema.Top>(value: S) =>
+  completed(Schema.Struct({ ok: Schema.Literal(true), value }));
+export type McpConnection = Effect.Success<ReturnType<Effect.Success<typeof McpClient>["connect"]>>;
+
+export const mcpTool = (
+  client: McpConnection,
+  label: string,
+  name: string,
+  input: Record<string, unknown>,
+) =>
+  client
+    .use(label, (client, signal) =>
+      client.callTool({ name, arguments: input }, undefined, { signal }),
+    )
+    .pipe(Effect.map((result) => result.structuredContent));
+
+export const availabilityFixture = Effect.gen(function* () {
+  const api = yield* Api,
+    actors = yield* Actors;
+  const prefix = `/api/organizations/${actors.organization.id}`;
+  const key = yield* body(
+    Schema.Struct({ id: Schema.String, key: Schema.RedactedFromValue(Schema.String) }),
+    yield* api.request(actors.owner, "POST", "/api/auth/api-key/create", {
+      name: "Tool availability",
+    }),
+  );
+  yield* Effect.addFinalizer(() =>
+    api
+      .request(actors.owner, "POST", "/api/auth/api-key/delete", { keyId: key.id })
+      .pipe(Effect.orDie),
+  );
+  const source = `import { defineApp, mutation, query, object, router } from "apps";
+import { always } from "apps/operations/approval";
+const write = mutation({ input: object({}) }, async ctx => {
+  ctx.sql.exec("INSERT INTO calls (value) VALUES (1)");
+  return { wrote: true };
+});
+const review = mutation({ input: object({}), approval: always() }, async ctx => {
+  ctx.sql.exec("INSERT INTO calls (value) VALUES (1)");
+  return { wrote: true };
+});
+const count = query({ input: object({}) }, async ctx => ctx.sql.exec("SELECT count(*) AS total FROM calls").one());
+export default defineApp({}, { tools: router({ records: router({ write, review }), counter: router({ count }) }) });`;
+  const apps = [];
+  for (const name of ["Availability target", "Availability independent"]) {
+    const response = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+      name,
+      files: [
+        { path: "index.ts", content: source },
+        appsManifest,
+        {
+          path: "migrations/0001_calls.sql",
+          content: "CREATE TABLE calls (value INTEGER NOT NULL);",
+        },
+      ],
+    });
+    expect(response.status, JSON.stringify(response.body)).toBe(200);
+    const app = yield* body(App, response);
+    apps.push(app);
+    yield* Effect.addFinalizer(() =>
+      api.request(actors.owner, "DELETE", `${prefix}/apps/${app.id}`).pipe(Effect.orDie),
+    );
+  }
+  const app = apps[0]!,
+    other = apps[1]!;
+  const path = `${prefix}/apps/${app.id}`;
+  const access = yield* body(
+    Schema.Struct({ revision: Schema.String }),
+    yield* api.request(actors.owner, "GET", `${path}/access`),
+  );
+  expect(
+    (yield* api.request(actors.owner, "PATCH", `${path}/access`, {
+      revision: access.revision,
+      audience: { kind: "everyone" },
+    })).status,
+  ).toBe(200);
+  return { app, other, path, prefix, key };
+});
