+++ b/packages/ui/src/implementation/dashboard/tool-tree.tsx
@@ -0,0 +1,394 @@
+import type { ToolRouter, ToolSummary } from "@executor-js/sdk";
+import { HugeiconsIcon } from "@hugeicons/react";
+import {
+  ArrowRight01Icon,
+  Delete02Icon,
+  PencilEdit01Icon,
+  SourceCodeIcon,
+  ViewIcon,
+} from "@hugeicons/core-free-icons";
+import { Checkbox } from "../components/checkbox.tsx";
+import { Switch } from "../components/switch.tsx";
+import { cn } from "../lib/utils.ts";
+import { humanize } from "./tool-schema.tsx";
+
+export type ToolNode =
+  | {
+      readonly kind: "group";
+      readonly key: string;
+      readonly label: string;
+      readonly description: string | undefined;
+      readonly children: readonly ToolNode[];
+      readonly size: number;
+    }
+  | { readonly kind: "tool"; readonly tool: ToolSummary; readonly label: string };
+
+interface Entry {
+  readonly tool: ToolSummary;
+  readonly segments: readonly string[];
+}
+
+/** Routers by path, which is the dotted prefix their tools' names share. */
+type Routers = ReadonlyMap<string, ToolRouter>;
+
+/**
+ * Group tools by the dotted parts of their names, keeping catalog order. Within a level, a
+ * `prefix_` shared by several tools becomes a group too, e.g. `accounts_connect` and
+ * `accounts_rename` under Accounts. A tool that repeats its group's name as a prefix, like
+ * MCP servers that namespace every tool (`planetscale.planetscale_list_databases`), drops the
+ * repeat instead of nesting a second group with the same name. A dotted group is a router and
+ * takes its metadata.
+ */
+export function buildTree(tools: readonly ToolSummary[], routers: Routers): readonly ToolNode[] {
+  return nest(
+    tools.map((tool) => ({ tool, segments: tool.name.split(".") })),
+    "",
+    "",
+    "",
+    routers,
+  );
+}
+
+/**
+ * The tools that pass `keep`, in the whole catalog's groups. Built from the whole catalog, a
+ * search or a hidden tool never moves the others into a different group.
+ */
+export function pruneTree(
+  nodes: readonly ToolNode[],
+  keep: (tool: ToolSummary) => boolean,
+): readonly ToolNode[] {
+  return nodes.flatMap((node): readonly ToolNode[] => {
+    if (node.kind === "tool") return keep(node.tool) ? [node] : [];
+    const children = pruneTree(node.children, keep);
+    return children.length === 0 ? [] : [{ ...node, children, size: leafCount(children) }];
+  });
+}
+
+const leafCount = (nodes: readonly ToolNode[]): number =>
+  nodes.reduce((total, node) => total + (node.kind === "tool" ? 1 : leafCount(node.children)), 0);
+
+const underscorePrefix = (segment: string) => {
+  const at = segment.indexOf("_");
+  return at > 0 && at < segment.length - 1 ? segment.slice(0, at) : undefined;
+};
+
+/** Removes a leading `name_` that only repeats the enclosing group's name. */
+const withoutGroupPrefix = (entry: Entry, group: string): Entry => {
+  const [only, ...rest] = entry.segments;
+  if (only === undefined || rest.length > 0) return entry;
+  const prefix = underscorePrefix(only);
+  return prefix !== undefined && prefix.toLowerCase() === group.toLowerCase()
+    ? { tool: entry.tool, segments: [only.slice(prefix.length + 1)] }
+    : entry;
+};
+
+/** `path` is the enclosing router's path, or undefined inside a `prefix_` group. */
+function nest(
+  nested: readonly Entry[],
+  parent: string,
+  parentGroup: string,
+  path: string | undefined,
+  routers: Routers,
+): readonly ToolNode[] {
+  const entries =
+    parentGroup === "" ? nested : nested.map((e) => withoutGroupPrefix(e, parentGroup));
+  const shared = new Map<string, number>();
+  for (const entry of entries) {
+    const prefix = entry.segments.length === 1 ? underscorePrefix(entry.segments[0]!) : undefined;
+    if (prefix !== undefined) shared.set(prefix, (shared.get(prefix) ?? 0) + 1);
+  }
+  const order: Array<
+    { readonly group: string; readonly router: boolean } | { readonly entry: Entry }
+  > = [];
+  const groups = new Map<string, Entry[]>();
+  for (const entry of entries) {
+    const [head = "", ...rest] = entry.segments;
+    const prefix = rest.length === 0 ? underscorePrefix(head) : undefined;
+    const split =
+      rest.length > 0
+        ? { group: head, segments: rest, router: true }
+        : prefix !== undefined && (shared.get(prefix) ?? 0) > 1
+          ? { group: prefix, segments: [head.slice(prefix.length + 1)], router: false }
+          : undefined;
+    if (split === undefined) {
+      order.push({ entry });
+      continue;
+    }
+    const members = groups.get(split.group);
+    if (members === undefined) {
+      groups.set(split.group, [{ tool: entry.tool, segments: split.segments }]);
+      order.push({ group: split.group, router: split.router });
+    } else members.push({ tool: entry.tool, segments: split.segments });
+  }
+  return order.map((item): ToolNode => {
+    if ("entry" in item)
+      return { kind: "tool", tool: item.entry.tool, label: humanize(item.entry.segments[0]!) };
+    const members = groups.get(item.group) ?? [];
+    const key = parent === "" ? item.group : `${parent}/${item.group}`;
+    const routerPath =
+      item.router && path !== undefined
+        ? path === ""
+          ? item.group
+          : `${path}.${item.group}`
+        : undefined;
+    const router = routerPath === undefined ? undefined : routers.get(routerPath);
+    return {
+      kind: "group",
+      key,
+      label: router?.title ?? humanize(item.group),
+      description: router?.description,
+      children: nest(members, key, item.group, routerPath, routers),
+      size: members.length,
+    };
+  });
+}
+
+export function groupKeys(nodes: readonly ToolNode[]): readonly string[] {
+  return nodes.flatMap((node) =>
+    node.kind === "group" ? [node.key, ...groupKeys(node.children)] : [],
+  );
+}
+
+/** Each tool's short label, and every group's tools at any depth. */
+export function treeIndex(nodes: readonly ToolNode[]) {
+  const leafLabels = new Map<string, string>();
+  const members = new Map<string, readonly string[]>();
+  const walk = (level: readonly ToolNode[]): readonly string[] =>
+    level.flatMap((node) => {
+      if (node.kind === "tool") {
+        leafLabels.set(node.tool.name, node.label);
+        return [node.tool.name];
+      }
+      const names = walk(node.children);
+      members.set(node.key, names);
+      return names;
+    });
+  walk(nodes);
+  return { leafLabels, members };
+}
+
+/** A manager's switches in the tree. Rows without it are the ordinary browser. */
+export interface TreeAvailability {
+  readonly enabled: ReadonlySet<string>;
+  /** Every tool of each group in the whole catalog, so a group switch covers the hidden ones too. */
+  readonly members: ReadonlyMap<string, readonly string[]>;
+  /** Tools whose change is saving; their controls wait for the confirmed answer. */
+  readonly busy: ReadonlySet<string>;
+  readonly onTool: (tool: string, enabled: boolean) => void;
+  readonly onGroup: (members: readonly string[], enabled: boolean) => void;
+}
+
+export function ToolTree({
+  nodes,
+  depth,
+  current,
+  collapsed,
+  onToggle,
+  onSelect,
+  availability,
+}: {
+  readonly nodes: readonly ToolNode[];
+  readonly depth: number;
+  readonly current: string | undefined;
+  readonly collapsed: ReadonlySet<string>;
+  readonly onToggle: (key: string) => void;
+  readonly onSelect: (tool: string) => void;
+  readonly availability?: TreeAvailability | undefined;
+}) {
+  return (
+    <ul className={cn("space-y-px", depth > 0 && "ml-[15px] border-l pl-1.5")}>
+      {nodes.map((node) =>
+        node.kind === "group" ? (
+          <li key={`group:${node.key}`}>
+            <div className="flex items-center rounded-md transition-colors hover:bg-muted">
+              <button
+                type="button"
+                aria-expanded={!collapsed.has(node.key)}
+                onClick={() => onToggle(node.key)}
+                className="flex min-h-7.5 min-w-0 flex-1 items-center gap-1.5 rounded-md px-2 text-left text-[13px] font-medium text-foreground focus-visible:outline-ring max-[740px]:min-h-11"
+              >
+                <HugeiconsIcon
+                  icon={ArrowRight01Icon}
+                  size={14}
+                  className={cn(
+                    "shrink-0 text-muted-foreground transition-transform",
+                    !collapsed.has(node.key) && "rotate-90",
+                  )}
+                  aria-hidden
+                />
+                <span className="min-w-0 flex-1 truncate">{node.label}</span>
+                <GroupCount node={node} availability={availability} />
+              </button>
+              {availability !== undefined && (
+                <GroupSwitch node={node} availability={availability} />
+              )}
+            </div>
+            {node.description !== undefined && !collapsed.has(node.key) && (
+              <p
+                title={node.description}
+                className="mb-1 ml-[22px] line-clamp-2 pr-2 text-xs leading-normal text-muted-foreground"
+              >
+                {node.description}
+              </p>
+            )}
+            {!collapsed.has(node.key) && (
+              <ToolTree
+                nodes={node.children}
+                depth={depth + 1}
+                current={current}
+                collapsed={collapsed}
+                onToggle={onToggle}
+                onSelect={onSelect}
+                availability={availability}
+              />
+            )}
+          </li>
+        ) : (
+          <li key={`tool:${node.tool.name}`}>
+            <ToolRow
+              node={node}
+              current={current === node.tool.name}
+              onSelect={onSelect}
+              availability={availability}
+            />
+          </li>
+        ),
+      )}
+    </ul>
+  );
+}
+
+function GroupCount({
+  node,
+  availability,
+}: {
+  readonly node: Extract<ToolNode, { kind: "group" }>;
+  readonly availability: TreeAvailability | undefined;
+}) {
+  const members = availability?.members.get(node.key);
+  if (availability === undefined || members === undefined)
+    return (
+      <span className="text-[11px] font-normal tabular-nums text-muted-foreground">
+        {node.size}
+      </span>
+    );
+  const on = members.filter((tool) => availability.enabled.has(tool)).length;
+  return (
+    <span className="text-[11px] font-normal tabular-nums text-muted-foreground">
+      {on}/{members.length}
+      <span className="sr-only"> on</span>
+    </span>
+  );
+}
+
+/** Separate from the collapse button: switching a group never opens or closes it. */
+function GroupSwitch({
+  node,
+  availability,
+}: {
+  readonly node: Extract<ToolNode, { kind: "group" }>;
+  readonly availability: TreeAvailability;
+}) {
+  const members = availability.members.get(node.key) ?? [];
+  const on = members.filter((tool) => availability.enabled.has(tool)).length;
+  const checked = on === members.length ? true : on === 0 ? false : "indeterminate";
+  const busy = members.some((tool) => availability.busy.has(tool));
+  return (
+    <span className="flex w-9 shrink-0 justify-center max-[740px]:w-11">
+      <Checkbox
+        variant="strong"
+        checked={checked}
+        aria-label={`Enable all tools in ${node.label}`}
+        aria-busy={busy || undefined}
+        disabled={busy}
+        // A mixed or empty group turns every tool on; a full one turns them all off.
+        onCheckedChange={() => availability.onGroup(members, checked !== true)}
+        className="relative after:absolute after:-inset-2 after:content-[''] max-[740px]:after:-inset-3.5"
+      />
+    </span>
+  );
+}
+
+function ToolRow({
+  node,
+  current,
+  onSelect,
+  availability,
+}: {
+  readonly node: Extract<ToolNode, { kind: "tool" }>;
+  readonly current: boolean;
+  readonly onSelect: (tool: string) => void;
+  readonly availability: TreeAvailability | undefined;
+}) {
+  const name = node.tool.name;
+  const on = availability === undefined || availability.enabled.has(name);
+  return (
+    <div
+      className={cn(
+        "flex items-center rounded-md transition-colors hover:bg-muted",
+        current && "bg-muted",
+      )}
+    >
+      <button
+        type="button"
+        title={name}
+        aria-label={name}
+        aria-pressed={current}
+        onClick={() => onSelect(name)}
+        className={cn(
+          "flex min-h-7.5 min-w-0 flex-1 items-center gap-2 rounded-md px-2 text-left text-[13px] text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-ring max-[740px]:min-h-11",
+          current && "font-medium text-foreground",
+          !on && "text-muted-foreground/70",
+        )}
+      >
+        <HugeiconsIcon
+          icon={effectIcon(toolEffect(node.tool))}
+          size={14}
+          strokeWidth={1.7}
+          className={cn("shrink-0 opacity-70", !on && "opacity-40")}
+          aria-hidden
+        />
+        <span className="min-w-0 truncate">{node.label}</span>
+        {!on && (
+          <span className="ml-auto shrink-0 text-[11px] font-normal text-muted-foreground">
+            Hidden
+          </span>
+        )}
+      </button>
+      {availability !== undefined && (
+        <Switch
+          checked={on}
+          aria-label={`Enable ${name}`}
+          aria-busy={availability.busy.has(name) || undefined}
+          disabled={availability.busy.has(name)}
+          onCheckedChange={(enabled) => availability.onTool(name, enabled)}
+          className="w-9 max-[740px]:w-11"
+        />
+      )}
+    </div>
+  );
+}
+
+type Effect = "read" | "change" | "delete" | "unknown";
+
+/** What running the tool does, from its own read-only and destructive hints. */
+export function toolEffect(tool: ToolSummary): Effect {
+  const readOnly = tool.readOnly ?? tool.annotations?.readOnlyHint;
+  if (readOnly === true) return "read";
+  if (tool.annotations?.destructiveHint === true) return "delete";
+  return readOnly === false ? "change" : "unknown";
+}
+
+/** Read at render: a module-level table can capture icons before their chunk initializes on the server. */
+export const effectIcon = (effect: Effect) => {
+  switch (effect) {
+    case "read":
+      return ViewIcon;
+    case "change":
+      return PencilEdit01Icon;
+    case "delete":
+      return Delete02Icon;
+    case "unknown":
+      return SourceCodeIcon;
+  }
+};
