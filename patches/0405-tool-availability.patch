+        );
+        expect(exceptions.defaultMode).toBe("read-only");
+        expect((yield* search()).items.map((t) => t.path)).toContain(write);
+        expect((yield* search()).items.map((t) => t.path)).not.toContain(review);
+        // Concurrent saves of one revision cannot overwrite each other.
+        const concurrent = yield* Effect.all(
+          [
+            save(exceptions.revision, [{ kind: "tool", tool: "records.write", enabled: false }]),
+            save(exceptions.revision, [{ kind: "tool", tool: "records.review", enabled: true }]),
+          ],
+          { concurrency: "unbounded" },
+        );
+        expect(concurrent.map((result) => result.status).sort()).toEqual([200, 409]);
+        const current = yield* readState();
