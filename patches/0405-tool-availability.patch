+  const restore = yield* api.request(actors.owner, "PATCH", `${path}/tool-availability`, {
+    revision: 1,
+    changes: [{ kind: "tool", tool: "guarded", enabled: true }],
+  });
+  expect(restore.status, JSON.stringify(restore.body)).toBe(200);
+  expect(yield* run()).toEqual({ executed: true });
+});
+
+export const verifyAvailabilityUpgrade = Effect.gen(function* () {
+  const { api, actors, archive, path } = yield* retainedApp;
+  const writesOff = yield* api.request(actors.owner, "PATCH", `${path}/tool-availability`, {
