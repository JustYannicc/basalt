diff --git a/apps/hosted/server/src/implementation/zoho-people-oauth.ts b/apps/hosted/server/src/implementation/zoho-people-oauth.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/server/src/implementation/zoho-people-oauth.ts
@@ -0,0 +1,45 @@
+import type { FirstPartyOAuthClientDefinition } from "./first-party-oauth.ts";
+
+const scopes = [
+  "ZOHOPEOPLE.attendance.ALL",
+  "ZOHOPEOPLE.employee.ALL",
+  "ZOHOPEOPLE.forms.CREATE",
+  "ZOHOPEOPLE.forms.READ",
+  "ZOHOPEOPLE.forms.UPDATE",
+  "ZOHOPEOPLE.leave.ALL",
+  "ZOHOPEOPLE.payroll.ALL",
+  "ZOHOPEOPLE.timetracker.CREATE",
+  "ZOHOPEOPLE.timetracker.DELETE",
+  "ZOHOPEOPLE.timetracker.READ",
+  "ZOHOPEOPLE.timetracker.UPDATE",
+] as const;
+
+const regions = [
+  { id: "eu", accounts: "accounts.zoho.eu" },
+  { id: "us", accounts: "accounts.zoho.com" },
+  { id: "in", accounts: "accounts.zoho.in" },
+] as const;
+
+// Zoho's token api_domain selects only these People product hosts, never CRM's API hosts.
+const hosts = ["people.zoho.eu", "people.zoho.com", "people.zoho.in"];
+
+export const zohoPeopleOAuthClients: readonly FirstPartyOAuthClientDefinition[] = regions.map(
+  (region) => ({
+    id: `zoho-people-${region.id}`,
+    label: `Executor for Zoho People (${region.id.toUpperCase()})`,
+    server: {
+      authorizationUrl: `https://${region.accounts}/oauth/v2/auth`,
+      tokenUrl: `https://${region.accounts}/oauth/v2/token`,
+      revocationUrl: `https://${region.accounts}/oauth/v2/token/revoke`,
+      scopeSeparator: ",",
+      grantedScopeSeparator: ",",
+      authorizationParams: { access_type: "offline", prompt: "consent" },
+    },
+    tokenEndpointAuthMethod: "client_secret_post",
+    defaultScopes: scopes,
+    placement: { hosts, scheme: "Zoho-oauthtoken" },
+  }),
+);
+
+export const isZohoPeopleOAuthClient = (id: string) =>
+  regions.some((region) => id === `zoho-people-${region.id}`);
