-                values (${organization}, ${instance})
-                on conflict (organization_id) do nothing`,
+          Effect.flatMap((sql) =>
+            sql.withTransaction(
+              Effect.gen(function* () {
+                // Drain app persistence before the tombstone becomes visible to late builds.
+                yield* sql`select id from organization where id = ${organization} for update`;
+                yield* sql`insert into hosted_organization_removal (organization_id, instance_id)
+                  values (${organization}, ${instance})
+                  on conflict (organization_id) do nothing`;
+              }),
+            ),
           ),
           Effect.mapError(unavailable),
           Effect.andThen(read(organization)),
