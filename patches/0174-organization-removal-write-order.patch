+import { Effect } from "effect";
+import type { SqlClient } from "effect/sql";
+import { StorageError } from "@executor-js/sdk/core";
+import type { OrganizationId } from "../contracts/organization.ts";
+
+/** Caller keeps the parent lock through the app's persistence transaction. */
+export const requireOrganizationAppWrite = (
+  sql: SqlClient.SqlClient,
+  organization: OrganizationId,
+) =>
+  Effect.gen(function* () {
+    const parent = yield* sql`select id from organization where id = ${organization} for key share`;
+    if (parent.length !== 1) return yield* new StorageError();
+    // Read after taking the lock: removal may have committed its tombstone while we waited.
+    const removed = yield* sql`select organization_id from hosted_organization_removal
+      where organization_id = ${organization}`;
+    if (removed.length > 0) return yield* new StorageError();
+  }).pipe(Effect.catchTag("SqlError", () => new StorageError()));
