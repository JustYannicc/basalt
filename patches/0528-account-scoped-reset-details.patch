             ),
           ).toContain(label === "Credits only" ? "Credits" : "Unlimited");
         }
+
+        // A model's own weekly limit and scoped resets: the count stays on the account's Weekly,
+        // the model window sits right after it, and Details say what each kind gives back.
+        const scopedReset = (
+          id: string,
+          label: string,
+          available: number,
+          expiresAt: number,
+          extra: object = {},
+        ) => ({
+          id,
+          label,
+          unit: "resets",
+          available,
+          observedAt: iso(now),
+          expiresAt: iso(expiresAt),
+          ...extra,
+        });
+        const modelFixture = yield* observationFixture({
+          name: "Model limits",
+          observe: true,
+          health: true,
+        });
+        yield* modelFixture.backend.answer({
+          status: 200,
+          body: subscription(
+            now,
+            [
+              percentWindow("claude-five-hour", "5-hour", 70, 5 * hour, 3 * hour, now),
+              {
+                ...percentWindow(
+                  "claude-seven-day-fable",
+                  "Fable weekly",
+                  40,
+                  7 * day,
+                  5 * day,
+                  now,
+                ),
+                scope: { kind: "model", id: "fable" },
+              },
+              percentWindow("claude-seven-day", "Weekly", 80, 7 * day, 5 * day, now),
+            ],
+            [
+              scopedReset("weekly", "Weekly resets", 1, now + 28 * day, {
+                scope: { kind: "account" },
+                reset: { kind: "weekly", clears: ["claude-seven-day"] },
+              }),
+              scopedReset("fable", "Fable resets", 3, now + 117 * day, {
+                scope: { kind: "model", id: "fable" },
+                reset: {
+                  kind: "model",
+                  clears: ["claude-five-hour", "claude-seven-day-fable"],
+                  givesBackWeekly: true,
+                },
+              }),
+              scopedReset("expired", "Weekly resets", 2, now - day, {
+                scope: { kind: "account" },
+                reset: { kind: "weekly" },
+              }),
+              scopedReset("unknown", "Resets with unknown scope", 1, now + 10 * day),
+            ],
+          ),
+        });
+        expect(
+          (yield* modelFixture.api.request(
+            modelFixture.actors.owner,
+            "PATCH",
+            modelFixture.accountPath,
+            { label: "Model limits" },
+          )).status,
+        ).toBe(200);
+        expect((yield* modelFixture.refresh()).status).toBe(200);
+        for (const width of [1280, 390]) {
+          yield* browser.use(`Open Model limits Details at ${width}px`, (page) =>
+            page
+              .setViewportSize({ width, height: 900 })
+              .then(() => page.emulateMedia({ colorScheme: "light" }))
+              .then(() => page.goto(accounts))
+              .then(() => cell(page, "Model limits", "claude-seven-day").waitFor())
+              .then(() => openRowDetails(page, accountRow(page, "Model limits"), "Model limits"))
+              .then(() =>
+                block(page, "Model limits").locator("[data-observation-details]").waitFor(),
+              ),
+          );
+          const shown = yield* browser.use(`Read Model limits at ${width}px`, (page) => {
+            const group = block(page, "Model limits");
+            return Promise.all([
+              group
+                .locator("[data-reading]")
+                .evaluateAll((cells) => cells.map((cell) => cell.getAttribute("data-reading"))),
+              cell(page, "Model limits", "claude-seven-day")
+                .locator("[data-reset-count]")
+                .evaluateAll((items) =>
+                  items.map((item) => [
+                    item.getAttribute("data-reset-count"),
+                    item.getAttribute("title"),
+                  ]),
+                ),
+              cell(page, "Model limits", "claude-seven-day-fable")
+                .locator("[data-reset-count]")
+                .count(),
+              group
+                .locator("[data-observation-details] tbody tr")
+                .evaluateAll((rows) => rows.map((row) => (row as HTMLElement).innerText)),
+              page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth),
+            ]);
+          });
+          const [order, resetCount, modelReset, rows, fits] = shown;
+          expect(order, "the model window follows the account window it counts toward").toEqual([
+            "claude-five-hour",
+            "claude-seven-day",
+            "claude-seven-day-fable",
+          ]);
+          // Expired grants are not counted; kinds stay apart instead of one whole-week total.
+          expect(resetCount).toHaveLength(1);
+          expect(resetCount[0]?.[0]).toBe("5");
+          expect(resetCount[0]?.[1]).toBe(
+            "1 weekly reset · 3 Fable resets · 1 reset with unknown scope",
+          );
+          expect(modelReset, "a model window never carries the account's reset count").toBe(0);
+          // A row's first cell is its name; notes and values follow on later lines or cells.
+          const name = (text: string) => text.split(/[\t\n]/u)[0]?.trim();
+          const row = (label: string) => rows.find((text) => name(text) === label) ?? "";
+          expect(row("Fable weekly")).toContain(
+            "This model's own limit. Its use also counts toward the weekly limit.",
+          );
+          expect(rows.indexOf(row("Fable weekly"))).toBe(rows.indexOf(row("Weekly")) + 1);
+          const fable = rows.filter((text) => name(text) === "Fable resets");
+          expect(fable).toHaveLength(1);
+          expect(fable[0]).toContain("3 resets");
+          expect(fable[0]).toContain(
+            "Refills the Fable weekly limit and gives back only the weekly use spent on Fable, not the whole week. Also refills the 5-hour limit.",
+          );
+          expect(fable[0]).toMatch(/Expires .*\d{4}/);
+          const weekly = rows.filter((text) => name(text) === "Weekly resets");
+          expect(weekly).toHaveLength(2);
+          expect(weekly.find((text) => text.includes("Expires"))).toContain(
+            "Refills the account's whole weekly limit.",
+          );
+          // The expired grant stays visible in Details as expired, never as available.
+          expect(weekly.find((text) => text.includes("2 resets"))).toContain("Expired");
+          expect(row("Resets with unknown scope")).toContain(
+            "The source didn't say which limit this refills.",
+          );
+          expect(fits, `Model limits Details fit at ${width}px`).toBe(true);
+          yield* evidence.attach(
+            `after-model-limits-details-${width}.png`,
+            "image/png",
+            yield* browser.use(`Capture Model limits Details at ${width}px`, (page) =>
+              block(page, "Model limits")
+                .locator("[data-observation-details]")
+                .scrollIntoViewIfNeeded()
+                .then(() => page.screenshot({ fullPage: true })),
+            ),
+          );
+        }
+
+        // A long report under the host's 16 KiB report guard: 12 windows and 52 compact balances,
+        // 64 Details rows. The pool's own test covers 64 windows plus 64 groups.
+        const longWindows = Array.from({ length: 12 }, (_, index) =>
+          index === 0
+            ? percentWindow("claude-seven-day", "Weekly", 80, 7 * day, 5 * day, now)
+            : {
+                ...percentWindow(
+                  `claude-seven-day-model-${index}`,
+                  `Model ${index} weekly`,
+                  50,
+                  7 * day,
+                  5 * day,
+                  now,
+                ),
+                scope: { kind: "model", id: `model-${index}` },
+              },
+        );
+        const longBalances = Array.from({ length: 52 }, (_, index) => ({
+          id: `g${index}`,
+          label: "Weekly resets",
+          unit: "resets",
+          available: 1,
+          observedAt: iso(now),
+          expiresAt: iso(now + (index + 2) * day),
+        }));
+        const longBody = subscription(now, longWindows, longBalances);
+        expect(
+          new TextEncoder().encode(JSON.stringify(longBody)).length,
+          "the long fixture stays under the report guard",
+        ).toBeLessThan(16 * 1024);
+        const longFixture = yield* observationFixture({
+          name: "Long limits",
+          observe: true,
+          health: true,
+        });
+        yield* longFixture.backend.answer({
+          status: 200,
+          body: longBody,
+        });
+        expect(
+          (yield* longFixture.api.request(
+            longFixture.actors.owner,
+            "PATCH",
+            longFixture.accountPath,
+            { label: "Long limits" },
+          )).status,
+        ).toBe(200);
+        expect((yield* longFixture.refresh()).status).toBe(200);
+        for (const width of [1280, 390]) {
+          const long = yield* browser.use(`Read the longest Details at ${width}px`, (page) =>
+            page
+              .setViewportSize({ width, height: 900 })
+              .then(() => page.goto(accounts))
+              .then(() => cell(page, "Long limits", "claude-seven-day").waitFor())
+              .then(() => openRowDetails(page, accountRow(page, "Long limits"), "Long limits"))
+              .then(() => {
+                const rows = block(page, "Long limits").locator(
+                  "[data-observation-details] tbody tr",
+                );
+                const last = rows.last();
+                return last.scrollIntoViewIfNeeded().then(() =>
+                  Promise.all([
+                    rows.count(),
+                    last.innerText(),
+                    last.evaluate((element) => {
+                      const box = element.getBoundingClientRect();
+                      return box.top >= 0 && box.bottom <= window.innerHeight;
+                    }),
+                    page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth),
+                  ]),
+                );
+              }),
+          );
+          const [count, lastText, reachable, fits] = long;
+          expect(count, "every window and balance has its row").toBe(64);
+          expect(lastText).toContain("Weekly resets");
+          expect(reachable, `the last row scrolls into view at ${width}px`).toBe(true);
+          expect(fits, `the longest Details fit at ${width}px`).toBe(true);
+          yield* evidence.attach(
+            `after-long-details-${width}.png`,
+            "image/png",
+            yield* browser.use(`Capture the longest Details end at ${width}px`, (page) =>
+              page.screenshot(),
+            ),
+          );
+        }
       }),
     ),
   );
