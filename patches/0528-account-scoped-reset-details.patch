+/**
+ * An observation's readings as one Details table: plan, every window with a model's own limit
+ * right after the account limit it counts toward, and every balance with what a reset gives back
+ * and when it expires. Pure: React and `account-observation-text.ts` only, so the pool app
+ * packages this file and renders the same rows the host does.
+ */
+import type { ReactNode } from "react";
+import {
+  age,
+  balanceView,
+  modelWindowNote,
+  moment,
+  orderedWindows,
+  planLabel,
+  resetEffect,
+  windowView,
+  type DisplayFormat,
+  type ReadingObservation,
+} from "./account-observation-text.ts";
+
+// Narrow screens read each row as label/value pairs instead of a squeezed table.
+const tableClass = "w-full border-collapse text-[11px]";
+const headClass =
+  "border-b border-border py-0.75 pr-3 text-left font-normal text-muted-foreground max-[740px]:hidden";
+const rowClass =
+  "max-[740px]:block max-[740px]:border-b max-[740px]:border-border/60 max-[740px]:py-1.5";
+const cellClass =
+  "border-b border-border/60 py-1.25 pr-3 align-top wrap-anywhere max-[740px]:flex max-[740px]:gap-2.5 max-[740px]:border-0 max-[740px]:py-px max-[740px]:pr-0 max-[740px]:before:min-w-24 max-[740px]:before:text-muted-foreground max-[740px]:before:content-[attr(data-label)]";
+
+export function Table({
+  caption,
+  columns,
+  rows,
+}: {
+  readonly caption: string;
+  readonly columns: readonly string[];
+  readonly rows: readonly { readonly key: string; readonly cells: readonly ReactNode[] }[];
+}) {
+  return (
+    <table className={tableClass}>
+      <caption className="pb-1 text-left font-medium text-foreground">{caption}</caption>
+      <thead>
+        <tr>
+          {columns.map((column) => (
+            <th key={column} scope="col" className={headClass}>
+              {column}
+            </th>
+          ))}
+        </tr>
+      </thead>
+      <tbody>
+        {rows.map((row) => (
+          <tr key={row.key} className={rowClass}>
+            {row.cells.map((cell, index) => (
+              <td key={columns[index]} data-label={columns[index]} className={cellClass}>
+                {cell}
+              </td>
+            ))}
+          </tr>
+        ))}
+      </tbody>
+    </table>
+  );
+}
+
+/** A row's name with the note that keeps it from reading as something it is not. */
+const named = (label: string, note: string | undefined) =>
+  note === undefined ? (
+    label
+  ) : (
+    <span className="grid gap-0.5">
+      {label}
+      <span className="text-muted-foreground" data-observation-note>
+        {note}
+      </span>
+    </span>
+  );
+
+/**
+ * `stale` marks every read time: a reading that is no longer current stays last known. Expired
+ * balances read "Expired", never as available.
+ */
+export function ObservationReadingsTable({
+  observation,
+  caption = "Readings",
+  providerFamilyId,
+  stale,
+  now,
+  format,
+}: {
+  readonly observation: ReadingObservation;
+  readonly caption?: string;
+  readonly providerFamilyId?: string | undefined;
+  readonly stale: boolean;
+  readonly now: number;
+  readonly format: DisplayFormat;
+}) {
+  const read = (value: string) => (
+    <>
+      <span className={stale ? "text-sign-in-warning" : undefined}>{age(value, now)}</span>{" "}
+      <time dateTime={value} className="text-muted-foreground">
+        {moment(value, now, format)}
+      </time>
+    </>
+  );
+  return (
+    <Table
+      caption={caption}
+      columns={["Reading", "Amount", "Resets or expires", "Read"]}
+      rows={[
+        ...(observation.plan === undefined
+          ? []
+          : [
+              {
+                key: "plan",
+                cells: [
+                  "Plan",
+                  planLabel(observation, providerFamilyId),
+                  <span key="reset" className="text-muted-foreground">
+                    Not reported
+                  </span>,
+                  read(observation.plan.observedAt),
+                ],
+              },
+            ]),
+        ...orderedWindows(observation.windows).map(({ entry, within }) => {
+          const view = windowView(entry, now, format);
+          return {
+            key: `window:${entry.id}`,
+            cells: [
+              named(
+                entry.label,
+                entry.scope?.kind === "model" ? modelWindowNote(within) : undefined,
+              ),
+              view.detail,
+              view.when,
+              read(entry.observedAt),
+            ],
+          };
+        }),
+        ...observation.balances.map((entry) => {
+          const view = balanceView(entry, now, format);
+          return {
+            key: `balance:${entry.id}`,
+            cells: [
+              named(entry.label, resetEffect(entry, observation.windows)),
+              view.detail,
+              view.when,
+              read(entry.observedAt),
+            ],
+          };
+        }),
+      ]}
+    />
+  );
+}
