@@ -0,0 +1,475 @@
+/**
+ * What an account observation's readings say, as text and drawn widths. Missing amounts stay
+ * unknown, a ratio stays a percentage, zero stays zero and an amount over its limit stays exact;
+ * only the drawn bar is clamped. Nothing here invents a capacity, a reset time or a refill.
+ *
+ * Pure: no Effect, SDK or host imports, so the pool app packages this file with
+ * `account-observation-readings-view.tsx` and both render one Details table. Types are the
+ * structural subset of the native report that the pool's projection also carries.
+ */
+import { accountPlanName, type AccountOffering } from "apps";
+
+/** Locale and time zone; structurally the host's `DisplayFormat`. */
+export interface DisplayFormat {
+  readonly locale: string;
+  readonly timeZone: string;
+}
+
+export interface ReadingWindow {
+  readonly id: string;
+  readonly label: string;
+  readonly observedAt: string;
+  readonly scope?: { readonly kind: string; readonly id?: string };
+  readonly measure: {
+    readonly unit: string;
+    readonly used?: number;
+    readonly remaining?: number;
+    readonly limit?: number;
+    readonly remainingRatio?: number;
+    readonly unlimited?: boolean;
+  };
+  readonly period?: {
+    readonly mode?: "fixed" | "rolling";
+    readonly seconds?: number;
+    readonly unit?: string;
+    readonly value?: number;
+  };
+  readonly resetsAt?: string;
+}
+
+export interface ReadingBalance {
+  readonly id: string;
+  readonly label: string;
+  readonly unit: string;
+  readonly available: number;
+  readonly observedAt: string;
+  readonly expiresAt?: string;
+  readonly scope?: { readonly kind: "account" | "model" | "unknown"; readonly id?: string };
+  readonly reset?: {
+    readonly kind: "session" | "weekly" | "full" | "model" | "unknown";
+    readonly clears?: readonly string[];
+    readonly givesBackWeekly?: boolean;
+  };
+}
+
+export interface ReadingObservation {
+  readonly offering: AccountOffering;
+  readonly plan?: { readonly label: string; readonly observedAt: string };
+  readonly windows: readonly ReadingWindow[];
+  readonly balances: readonly ReadingBalance[];
+}
+
+type Observation = ReadingObservation;
+type Window = ReadingWindow;
+type Balance = ReadingBalance;
+export type ObservationMeterState = "good" | "warn" | "bad" | "exhausted" | "unknown" | "unlimited";
+
+/** The host's `formatMoment`, kept here so this file has no host imports. */
+const formatMoment = (
+  value: Date | number | string,
+  format: DisplayFormat,
+  options?: Intl.DateTimeFormatOptions,
+) => new Date(value).toLocaleString(format.locale, { timeZone: format.timeZone, ...options });
+
+/** Elapsed time in its two largest units, such as "2 h 14 min". */
+export const span = (milliseconds: number) => {
+  const minutes = Math.floor(Math.abs(milliseconds) / 60_000);
+  if (minutes < 1) return "less than a minute";
+  if (minutes < 60) return `${minutes} min`;
+  const hours = Math.floor(minutes / 60);
+  if (hours < 24) return minutes % 60 === 0 ? `${hours} h` : `${hours} h ${minutes % 60} min`;
+  const days = Math.floor(hours / 24);
+  return `${days} ${days === 1 ? "day" : "days"}`;
+};
+
+/** A source instant as age. Hosts accept a minute of clock skew; a later instant reads as now. */
+export const age = (value: string, now: number) => {
+  const elapsed = now - Date.parse(value);
+  return elapsed < 60_000 ? "just now" : `${span(elapsed)} ago`;
+};
+
+/**
+ * Today's moments show the time only; others name the day as well, and the year when it is not
+ * this one, since a banked reset can expire months ahead.
+ */
+export const moment = (value: string, now: number, format: DisplayFormat) => {
+  const time = { hour: "numeric", minute: "2-digit" } as const;
+  const sameDay =
+    formatMoment(value, format, { dateStyle: "short" }) ===
+    formatMoment(now, format, { dateStyle: "short" });
+  const sameYear =
+    formatMoment(value, format, { year: "numeric" }) ===
+    formatMoment(now, format, { year: "numeric" });
+  return formatMoment(
+    value,
+    format,
+    sameDay
+      ? time
+      : {
+          weekday: "short",
+          day: "numeric",
+          month: "short",
+          ...(sameYear ? {} : { year: "numeric" }),
+          ...time,
+        },
+  );
+};
+
+const currencies = new Set(Intl.supportedValuesOf("currency"));
+const isCurrency = (unit: string) => currencies.has(unit);
+const isPercent = (unit: string) => unit === "%" || unit.toLowerCase() === "percent";
+/** Reported plural units and how one of each reads; any other unit keeps its spelling. */
+const singulars: Readonly<Record<string, string>> = {
+  resets: "reset",
+  credits: "credit",
+  requests: "request",
+  tokens: "token",
+};
+
+/** The nouns are English, so English decides "one", at the displayed precision, in every locale. */
+const english = new Intl.PluralRules("en", { maximumFractionDigits: 2 });
+
+/** How `unit` reads after `value`: "1 request", "2 requests"; any other unit keeps its spelling. */
+export const countedUnit = (value: number, unit: string) =>
+  singulars[unit] !== undefined && english.select(value) === "one" ? singulars[unit] : unit;
+
+export const amount = (value: number, unit: string, format: DisplayFormat, withUnit = false) => {
+  if (isCurrency(unit))
+    return new Intl.NumberFormat(format.locale, { style: "currency", currency: unit }).format(
+      value,
+    );
+  const number = new Intl.NumberFormat(format.locale, { maximumFractionDigits: 2 }).format(value);
+  if (isPercent(unit)) return `${number}%`;
+  if (!withUnit) return number;
+  return `${number} ${countedUnit(value, unit)}`;
+};
+
+const toneOf = (ratio: number): ObservationMeterState =>
+  ratio <= 0 ? "exhausted" : ratio >= 0.7 ? "good" : ratio >= 0.3 ? "warn" : "bad";
+
+const periodSpan = (period: NonNullable<Window["period"]>) => {
+  const seconds = period.seconds;
+  if (seconds === undefined)
+    return period.value !== undefined && period.unit !== undefined
+      ? `${period.value}-${period.unit}`
+      : undefined;
+  const [size, unit]: readonly [number, string] =
+    seconds % 86_400 === 0
+      ? [86_400, "day"]
+      : seconds % 3_600 === 0
+        ? [3_600, "hour"]
+        : seconds % 60 === 0
+          ? [60, "minute"]
+          : [1, "second"];
+  return `${seconds / size}-${unit}`;
+};
+
+const cadences: Readonly<Record<number, string>> = {
+  3_600: "hourly",
+  86_400: "daily",
+  604_800: "weekly",
+  2_592_000: "monthly",
+};
+
+/**
+ * A window the source named but did not measure reads as a missing reading of its period, such
+ * as "No weekly reading" or "No 5-hour reading", never as a zero, a full bar or an outage.
+ */
+const missingReading = (period: Window["period"]) => {
+  const length =
+    cadences[periodSeconds(period)] ?? (period === undefined ? undefined : periodSpan(period));
+  return length === undefined ? "No reading" : `No ${length} reading`;
+};
+
+/**
+ * One reported window as a usage cell: the remaining share in its header, the drawn width and the
+ * reset. Where no share is known the header names the remaining or used amount instead.
+ */
+export function windowView(entry: Window, now: number, format: DisplayFormat) {
+  const { unit, used, limit } = entry.measure;
+  const unlimited = entry.measure.unlimited === true;
+  const remaining =
+    entry.measure.remaining ??
+    (used !== undefined && limit !== undefined ? limit - used : undefined);
+  const ratio =
+    entry.measure.remainingRatio ??
+    (remaining !== undefined && limit !== undefined && limit > 0 ? remaining / limit : undefined);
+  const over = remaining !== undefined && remaining < 0;
+  const short = (value: number) => amount(value, unit, format);
+  const long = (value: number) => amount(value, unit, format, true);
+  const percent = ratio === undefined ? undefined : Math.round(ratio * 100);
+  const measured =
+    unlimited || [ratio, remaining, used, limit].some((value) => value !== undefined);
+  const missing = measured ? undefined : missingReading(entry.period);
+  const state: ObservationMeterState = unlimited
+    ? "unlimited"
+    : over || remaining === 0
+      ? "exhausted"
+      : ratio === undefined
+        ? "unknown"
+        : toneOf(ratio);
+  const absolute =
+    remaining !== undefined && limit !== undefined
+      ? over
+        ? `${short(limit - remaining)} / ${long(limit)} used, over the limit`
+        : `${short(remaining)} / ${long(limit)} remaining`
+      : remaining !== undefined
+        ? `${long(remaining)} remaining`
+        : used !== undefined
+          ? `${long(used)} used`
+          : undefined;
+  return {
+    state,
+    // The header reads "Rem 89%": a quiet lead and the figure that carries the tone.
+    ...(unlimited
+      ? { lead: undefined, figure: "Unlimited" }
+      : over
+        ? { lead: undefined, figure: "Over limit" }
+        : percent !== undefined
+          ? // A sliver that rounds to zero still reads as some left, not as exhausted.
+            { lead: "Rem", figure: percent === 0 && state !== "exhausted" ? "<1%" : `${percent}%` }
+          : remaining !== undefined
+            ? { lead: "Rem", figure: long(remaining) }
+            : used !== undefined
+              ? { lead: "Used", figure: long(used) }
+              : { lead: undefined, figure: missing ?? "Unknown" }),
+    flag: over
+      ? undefined
+      : state === "exhausted"
+        ? "Exhausted"
+        : state === "bad"
+          ? "Low"
+          : undefined,
+    detail: unlimited
+      ? "Unlimited"
+      : absolute !== undefined
+        ? `${absolute}${isCurrency(unit) ? ` (${unit})` : ""}`
+        : percent !== undefined
+          ? `${percent}% remaining`
+          : limit !== undefined
+            ? `Limit ${long(limit)}, amount unknown`
+            : (missing ?? "Unknown"),
+    // The bar draws the remaining share only; it never grows past full or below empty.
+    width: ratio === undefined || unlimited ? undefined : Math.min(100, Math.max(0, ratio * 100)),
+    aria:
+      remaining !== undefined && limit !== undefined
+        ? { now: Math.min(Math.max(0, remaining), limit), max: limit }
+        : percent !== undefined
+          ? { now: Math.min(100, Math.max(0, percent)), max: 100 }
+          : { now: undefined, max: limit ?? 100 },
+    ...windowTiming(entry, now, format),
+  };
+}
+
+/** A reset that already passed never refills the old reading; rolling windows have no reset. */
+function windowTiming(entry: Window, now: number, format: DisplayFormat) {
+  if (entry.resetsAt !== undefined) {
+    const at = Date.parse(entry.resetsAt);
+    const when = moment(entry.resetsAt, now, format);
+    if (at <= now)
+      return {
+        reset: { text: `was due ${when}`, at: entry.resetsAt, due: true },
+        when: `Was due ${when}`,
+      };
+    return {
+      reset: {
+        text: `in ${span(at - now)}`,
+        at: entry.resetsAt,
+        title: `Resets ${when}`,
+        due: false,
+      },
+      when,
+    };
+  }
+  const length = entry.period === undefined ? undefined : periodSpan(entry.period);
+  if (entry.period?.mode === "rolling")
+    return {
+      reset: { text: length === undefined ? "rolling" : `rolling ${length}`, due: false },
+      when: "Rolling, no single reset",
+    };
+  return { reset: undefined, when: length === undefined ? "Not reported" : "Reset not reported" };
+}
+
+/** A reported balance, such as banked resets or credits. Expired balances are not minted again. */
+export function balanceView(balance: Balance, now: number, format: DisplayFormat) {
+  const expires = balance.expiresAt === undefined ? undefined : Date.parse(balance.expiresAt);
+  const when = balance.expiresAt === undefined ? undefined : moment(balance.expiresAt, now, format);
+  return {
+    detail: amount(balance.available, balance.unit, format, true),
+    when:
+      expires === undefined
+        ? "Does not expire"
+        : `${expires <= now ? "Expired" : "Expires"} ${when}`,
+  };
+}
+
+/** "1 weekly reset", "3 Fable resets": a model's name keeps its capital. */
+export const resetCountText = (balance: Pick<Balance, "label" | "scope">, count: number) => {
+  const text = count === 1 ? balance.label.replace(/\b([Rr])esets\b/u, "$1eset") : balance.label;
+  return `${count} ${balance.scope?.kind === "model" ? text : text.charAt(0).toLowerCase() + text.slice(1)}`;
+};
+
+/**
+ * Unexpired balances counted in resets, which refill a window early. They sit on the account's
+ * longest window. The title keeps each kind apart, so one weekly reset and three model resets
+ * never read as four whole-week resets; each credit's expiry lives in Details, where touch
+ * screens can reach it too.
+ */
+export function bankedResets(observation: Observation, now: number) {
+  const live = observation.balances.filter(
+    (balance) =>
+      balance.unit === "resets" &&
+      balance.available > 0 &&
+      (balance.expiresAt === undefined || Date.parse(balance.expiresAt) > now),
+  );
+  const count = live.reduce((total, balance) => total + balance.available, 0);
+  if (count === 0) return undefined;
+  if (live.every((balance) => balance.reset === undefined && balance.scope === undefined))
+    return { count, title: `${count} banked ${count === 1 ? "reset" : "resets"}` };
+  const kinds = new Map<string, { balance: Balance; count: number }>();
+  for (const balance of live) {
+    const key = JSON.stringify([balance.scope?.kind, balance.scope?.id, balance.reset?.kind]);
+    const kind = kinds.get(key);
+    kinds.set(key, {
+      balance: kind?.balance ?? balance,
+      count: (kind?.count ?? 0) + balance.available,
+    });
+  }
+  const rank = (balance: Balance) =>
+    balance.scope?.kind === "account" ? 0 : balance.scope?.kind === "model" ? 1 : 2;
+  const title = [...kinds.values()]
+    .sort(
+      (a, b) => rank(a.balance) - rank(b.balance) || a.balance.label.localeCompare(b.balance.label),
+    )
+    .map((kind) => resetCountText(kind.balance, kind.count))
+    .join(" · ");
+  return { count, title };
+}
+
+const isModelWindow = (entry: Window) => entry.scope?.kind === "model";
+
+/**
+ * Account windows in source order, each model's own window right after the account window of the
+ * same period, which its use also counts toward. `within` names that window.
+ */
+export function orderedWindows<W extends Window>(windows: readonly W[]) {
+  const own = windows.filter((entry) => !isModelWindow(entry));
+  const models = windows.filter(isModelWindow);
+  const placed = new Set<W>();
+  const rows: { entry: W; within?: W }[] = [];
+  for (const entry of own) {
+    rows.push({ entry });
+    const seconds = periodSeconds(entry.period);
+    for (const model of models)
+      if (!placed.has(model) && seconds > 0 && periodSeconds(model.period) === seconds) {
+        placed.add(model);
+        rows.push({ entry: model, within: entry });
+      }
+  }
+  for (const model of models) if (!placed.has(model)) rows.push({ entry: model });
+  return rows;
+}
+
+/** Why a model's own window is not extra capacity. */
+export const modelWindowNote = (within: Window | undefined) =>
+  `This model's own limit. Its use also counts toward ${within === undefined ? "the account's limits" : `the ${within.label.toLowerCase()} limit`}.`;
+
+/** "5-hour limit", "weekly limit": a window by its length, else its own label. */
+const limitName = (entry: Window) =>
+  `${cadences[periodSeconds(entry.period)] ?? (entry.period === undefined ? undefined : periodSpan(entry.period)) ?? entry.label.toLowerCase()} limit`;
+
+const listed = (names: readonly string[]) =>
+  names.length <= 1 ? names.join("") : `${names.slice(0, -1).join(", ")} and ${names.at(-1)}`;
+
+/**
+ * What a reset balance gives back, from the source's kind, scope and listed windows only. Whole-
+ * week and model resets never share wording; a reset claims a window only when the source names
+ * it or its kind is that window, and an unclassified reset is never described as a whole week.
+ */
+export function resetEffect(balance: Balance, windows: readonly Window[]) {
+  if (balance.unit !== "resets") return undefined;
+  const { reset, scope } = balance;
+  const own = windows.filter((entry) => !isModelWindow(entry));
+  const cleared = [
+    ...new Set(
+      (reset?.clears ?? []).flatMap((id) => own.filter((entry) => entry.id === id)).map(limitName),
+    ),
+  ];
+  const also = (skip: string) => {
+    const extra = cleared.filter((name) => name !== skip);
+    return extra.length === 0 ? "" : ` Also refills the ${listed(extra)}.`;
+  };
+  const unlisted = "The source didn't list which limits it refills.";
+  if (scope?.kind === "model" || reset?.kind === "model") {
+    const name = balance.label.replace(/\s*\bresets?\b\s*/iu, " ").trim() || "this model";
+    // A model window is named by its own label; its period is never the account's week.
+    const models = windows.filter(isModelWindow);
+    const refilled = [
+      ...new Set(
+        (reset?.clears ?? [])
+          .flatMap((id) => models.filter((entry) => entry.id === id))
+          .map((entry) => `${entry.label} limit`),
+      ),
+    ];
+    // A model reset never claims the account's weekly limit, even when the source lists it.
+    const ancillary = cleared.filter((limit) => limit !== "weekly limit");
+    const tail = ancillary.length === 0 ? "" : ` Also refills the ${listed(ancillary)}.`;
+    // Giving back weekly use is the source saying the model's allowance refills, listed or not.
+    if (reset?.givesBackWeekly === true)
+      return `Refills the ${refilled.length === 0 ? `${name} allowance` : listed(refilled)} and gives back only the weekly use spent on ${name}, not the whole week.${tail}`;
+    if (refilled.length > 0) return `Refills the ${listed(refilled)}.${tail}`;
+    return ancillary.length === 0
+      ? `Applies to ${name} only. ${unlisted}`
+      : `Applies to ${name} only and refills the ${listed(ancillary)}.`;
+  }
+  if (scope?.kind !== "account") return "The source didn't say which limit this refills.";
+  if (reset?.kind === "weekly")
+    return `Refills the account's whole weekly limit.${also("weekly limit")}`;
+  if (cleared.length > 0) return `Refills the account's ${listed(cleared)}.`;
+  if (reset?.kind === "session") return "Refills the account's session limit.";
+  if (reset?.kind === "full") return `A full reset. ${unlisted}`;
+  return "The source didn't say which limit this refills.";
+}
+
+const unitSeconds: Readonly<Record<string, number>> = {
+  second: 1,
+  minute: 60,
+  hour: 3_600,
+  day: 86_400,
+  week: 604_800,
+  month: 2_592_000,
+};
+/** A period's length in seconds, from `seconds` or a value and unit such as 1 week. */
+const periodSeconds = (period: Window["period"]) =>
+  period?.seconds ??
+  (period?.value ?? 0) * (unitSeconds[period?.unit?.toLowerCase().replace(/s$/u, "") ?? ""] ?? 0);
+
+/**
+ * The limited window a banked reset sits on: the account's longest period, else the last
+ * reported. A model's own window of the same length never takes it.
+ */
+export const resetWindow = (windows: readonly Window[]) =>
+  (windows.some((entry) => !isModelWindow(entry))
+    ? windows.filter((entry) => !isModelWindow(entry))
+    : windows
+  ).reduce<Window | undefined>(
+    (best, entry) =>
+      best === undefined || periodSeconds(entry.period) >= periodSeconds(best.period)
+        ? entry
+        : best,
+    undefined,
+  )?.id;
+
+const offerings = {
+  subscription: "Subscription",
+  metered_api: "Metered API",
+  prepaid: "Prepaid",
+  other: undefined,
+  unknown: undefined,
+} satisfies Record<Observation["offering"], string | undefined>;
+
+/** The plan a source reported, or the kind of offering when it named no plan. */
+export const planLabel = (observation: Observation, providerFamilyId?: string) =>
+  observation.plan === undefined
+    ? offerings[observation.offering]
+    : accountPlanName(observation.plan.label, providerFamilyId);
