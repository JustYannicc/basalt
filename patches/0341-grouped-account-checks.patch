index 0000000..849956d
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/account-sign-in-checks.tsx
@@ -0,0 +1,208 @@
+/**
+ * Checks of every sign-in in a grouped identity row, run together by one host action. The host
+ * checks each sign-in with the caller's own authority. A sign-in it refuses is only counted, never
+ * named, and keeps what the row already showed.
+ */
+import type { AccountGroupCheckResult, App } from "@executor-js/sdk";
+import { useAtomSet } from "@effect/atom-react";
+import { Cause, Exit } from "effect";
+import type { Atom } from "effect/reactivity";
+import { useEffect, useRef, useState, type ComponentType, type ReactNode } from "react";
+import type { AccountSummary, FailureProps } from "../../contracts/dashboard.ts";
+import { Button } from "../components/button.tsx";
+import { AccountHealthLine } from "./account-health-line.tsx";
+import { driverCanCheck } from "./account-health.tsx";
+import { useAccountRow } from "./account-row.tsx";
+
+/** One saved sign-in of a grouped row, with the apps it serves. */
+export interface AccountSignIn {
+  readonly account: AccountSummary;
+  /** What the sign-in's own menu announces, such as its given name. */
+  readonly name: string;
+  readonly apps: readonly App[];
+  readonly canReconnect?: ((app: App) => boolean) | undefined;
+}
+
+/** Why the host could not check one sign-in of the group. */
+export type AccountGroupCheckFailure = Extract<
+  AccountGroupCheckResult,
+  { status: "failed" }
+>["error"];
+
+/** A grouped row's one check of every sign-in, through the host's own group action. */
+export interface AccountGroupCheck<E> {
+  readonly signIns: readonly AccountSignIn[];
+  readonly check: () => Promise<Exit.Exit<readonly AccountGroupCheckResult[], E>>;
+  /** The host's own failure for a sign-in it could not check, shown with its other failures. */
+  readonly failure: (error: AccountGroupCheckFailure) => E;
+}
+
+/**
+ * Mounts the host's group check for a grouped row's sign-ins and hands it to `children`; only
+ * grouped rows render it, so other rows never mount a group check.
+ */
+export function AccountGroupCheckScope<E>({
+  signIns,
+  check,
+  failure,
+  children,
+}: Omit<AccountGroupCheck<E>, "check"> & {
+  /** The host's group check of exactly these sign-ins. */
+  readonly check: Atom.AtomResultFn<void, readonly AccountGroupCheckResult[], E>;
+  readonly children: (group: AccountGroupCheck<E>) => ReactNode;
+}) {
+  const run = useAtomSet(check, { mode: "promiseExit" });
+  return children({ signIns, check: () => run(), failure });
+}
+
+const noCheck = "No app that uses these sign-ins defines a check.";
+
+const checkable = ({ account, apps }: AccountSignIn) =>
+  (account.health?.apps.some(
+    (entry) => entry.checkable && apps.some((app) => app.id === entry.app),
+  ) ??
+    false) ||
+  driverCanCheck(account.health?.driver);
+
+/** A grouped row's shared check: one pending run and the last outcome. */
+export interface SignInChecksState<E> {
+  readonly signIns: readonly AccountSignIn[];
+  readonly pending: boolean;
+  readonly error: Cause.Cause<E> | undefined;
+  readonly outcome: readonly AccountGroupCheckResult[] | undefined;
+  /** The first sign-in the last check could not check, as the host's failure. */
+  readonly failure: Cause.Cause<E> | undefined;
+  readonly disabledReason: string | undefined;
+  readonly run: () => Promise<void>;
+}
+
+const count = (n: number) => `${n} ${n === 1 ? "sign-in" : "sign-ins"}`;
+
+/** Sentences that never open on a numeral and hold for refused, gone and failed sign-ins alike. */
+const outcomeText = (checked: number, unchecked: number) =>
+  unchecked === 0
+    ? checked === 1
+      ? "Checked the sign-in."
+      : `Checked all ${count(checked)}.`
+    : checked === 0
+      ? unchecked === 1
+        ? "The sign-in couldn't be checked."
+        : `None of the ${count(unchecked)} could be checked.`
+      : `Checked ${checked} of ${count(checked + unchecked)}. ${
+          unchecked === 1 ? "The other one" : `The other ${unchecked}`
+        } couldn't be checked.`;
+
+/**
+ * The group check's state. Inside a row with a menu it also offers Check now from that menu, so
+ * the menu item and Details share one pending check and one outcome.
+ */
+export function useSignInChecks<E>(
+  group: AccountGroupCheck<E> | undefined,
+): SignInChecksState<E> | undefined {
+  const [pending, setPending] = useState(false);
+  const [error, setError] = useState<Cause.Cause<E>>();
+  const [outcome, setOutcome] = useState<readonly AccountGroupCheckResult[]>();
+  const [failure, setFailure] = useState<Cause.Cause<E>>();
+  const run = async () => {
+    if (pending || group === undefined) return;
+    setPending(true);
+    setError(undefined);
+    setOutcome(undefined);
+    setFailure(undefined);
+    const exit = await group.check();
+    setPending(false);
+    if (Exit.isFailure(exit)) return setError(exit.cause);
+    setOutcome(exit.value);
+    const failed = exit.value.find((result) => result.status === "failed");
+    if (failed !== undefined) setFailure(Cause.fail(group.failure(failed.error)));
+  };
+  // The row menu keeps one stable callback that always runs the latest check.
+  const latest = useRef(run);
+  useEffect(() => {
+    latest.current = run;
+  });
+  const grouped = group !== undefined;
+  const disabledReason = group?.signIns.some(checkable) === true ? undefined : noCheck;
+  const setCheck = useAccountRow()?.setCheck;
+  useEffect(() => {
+    if (setCheck === undefined) return;
+    setCheck(grouped ? { run: () => void latest.current(), pending, disabledReason } : undefined);
+  }, [setCheck, grouped, pending, disabledReason]);
+  useEffect(() => (setCheck === undefined ? undefined : () => setCheck(undefined)), [setCheck]);
+  return group === undefined
+    ? undefined
+    : { signIns: group.signIns, pending, error, outcome, failure, disabledReason, run };
+}
+
+/** Whether the last check left a sign-in unchecked, which the collapsed row also says. */
+export const partialOutcome = <E,>(state: SignInChecksState<E> | undefined) =>
+  state?.outcome?.some((result) => result.status !== "checked") === true;
+
+/**
+ * What the last group check did: how many sign-ins it checked and the first failure. A sign-in the
+ * host refused, because the caller may not use it or it is gone, only counts as unchecked. `quiet`
+ * leaves a fully checked group to the updated checks.
+ */
+export function SignInCheckOutcome<E>({
+  state,
+  quiet = false,
+  Failure,
+}: {
+  readonly state: SignInChecksState<E>;
+  readonly quiet?: boolean;
+  readonly Failure: ComponentType<FailureProps<NoInfer<E>>>;
+}) {
+  const { outcome, failure, error } = state;
+  const checked = outcome?.filter((result) => result.status === "checked").length ?? 0;
+  const unchecked = (outcome?.length ?? 0) - checked;
+  return (
+    <>
+      {outcome !== undefined && (unchecked > 0 || !quiet) && (
+        <div role="status" className="grid min-w-0 gap-0.75" data-sign-in-check-outcome>
+          <p className="text-muted-foreground">{outcomeText(checked, unchecked)}</p>
+          {failure && <Failure cause={failure} layout="compact" />}
+        </div>
+      )}
+      {error && <Failure cause={error} layout="compact" />}
+    </>
+  );
+}
+
+/** Each sign-in's latest checks under its name, with one Check now for the whole group. */
+export function SignInChecks<E>({
+  state,
+  Failure,
+}: {
+  readonly state: SignInChecksState<E>;
+  readonly Failure: ComponentType<FailureProps<NoInfer<E>>>;
+}) {
+  return (
+    <div className="flex min-w-0 flex-col gap-1.5" data-sign-in-checks>
+      <div className="flex min-h-6 flex-wrap items-center gap-x-1.5 gap-y-0.5">
+        <span>Checks for each sign-in</span>
+        <Button
+          variant="outline"
+          size="xs"
+          className="ml-1"
+          loading={state.pending}
+          disabledReason={state.disabledReason}
+          onClick={() => void state.run()}
+        >
+          Check now
+        </Button>
+      </div>
+      <SignInCheckOutcome state={state} Failure={Failure} />
+      {state.signIns.map((signIn) => (
+        <div key={signIn.account.id} className="grid min-w-0 gap-0.5" data-sign-in>
+          <span className="font-medium text-foreground wrap-anywhere">{signIn.name}</span>
+          <AccountHealthLine<E>
+            account={signIn.account}
+            apps={signIn.apps}
+            canReconnect={signIn.canReconnect}
+            Failure={Failure}
+          />
+        </div>
+      ))}
+    </div>
+  );
+}
