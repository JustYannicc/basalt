+import { Effect } from "effect";
+import type { AccountGroupCheckResult } from "../contracts/account-group-check.ts";
+import type { AccountHealth, AccountNotFound } from "../contracts/account.ts";
+import type { AccountAcquisitionUnavailable } from "../contracts/account-acquisition-driver.ts";
+import type { AccountId, StorageError } from "../contracts/shared.ts";
+
+/** The product callback keeps its single-account authority; each distinct ID gets one answer. */
+export const checkEach = <R>(
+  accounts: readonly AccountId[],
+  check: (
+    account: AccountId,
+  ) => Effect.Effect<
+    AccountHealth,
+    AccountNotFound | StorageError | AccountAcquisitionUnavailable,
+    R
+  >,
+) =>
+  Effect.forEach(
+    [...new Set(accounts)],
+    (account) =>
+      check(account).pipe(
+        Effect.match({
+          onSuccess: (health): AccountGroupCheckResult => ({ account, status: "checked", health }),
+          onFailure: (error): AccountGroupCheckResult =>
+            error._tag === "AccountNotFound"
+              ? { account, status: "refused" }
+              : { account, status: "failed", error },
+        }),
+      ),
+    { concurrency: 2 },
+  );
