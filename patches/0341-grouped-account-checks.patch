@@ -0,0 +1,51 @@
+import { expect } from "@effect/vitest";
+import { Effect, Redacted } from "effect";
+import { Actors } from "./actors.ts";
+import { Api } from "./api.ts";
+import { Browser } from "./browser.ts";
+import { McpOAuth } from "./mcp-oauth.ts";
+
+/** Check with real delegated API authority, narrower than the owner's account access. */
+export const checkAppLimitedGroup = (input: {
+  readonly path: string;
+  readonly app: string;
+  readonly allowed: string;
+  readonly outside: string;
+  readonly missing: string;
+}) =>
+  Effect.gen(function* () {
+    const api = yield* Api;
+    const actors = yield* Actors;
+    const browser = yield* Browser;
+    const oauth = yield* McpOAuth;
+    yield* browser.login(actors.owner);
+    const grant = yield* oauth.authorizeApi;
+    yield* Effect.addFinalizer(() => oauth.revoke(grant).pipe(Effect.orDie));
+    expect(
+      (yield* api.request(actors.owner, "POST", "/api/auth/mcp/grants/narrow", {
+        id: grant.grantId,
+        policy: {
+          kind: "tools",
+          apps: [{ app: input.app, tools: { kind: "all" } }],
+          approval: "client",
+        },
+      })).status,
+    ).toBe(200);
+    const refreshed = yield* oauth.refresh(grant);
+    const anonymous = yield* api.session();
+    const response = yield* api.request(
+      anonymous,
+      "POST",
+      input.path,
+      {
+        accounts: [input.allowed, input.outside, input.missing],
+      },
+      { authorization: `Bearer ${Redacted.value(refreshed.tokens).access_token}` },
+    );
+    expect(response.status, "app-limited token may run the group action").toBe(200);
+    expect(response.body).toEqual([
+      expect.objectContaining({ account: input.allowed, status: "checked" }),
+      { account: input.outside, status: "refused" },
+      { account: input.missing, status: "refused" },
+    ]);
+  });
