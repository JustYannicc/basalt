@@ -0,0 +1,305 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { randomUUID } from "node:crypto";
+import { body } from "../support/api.ts";
+import { HostedLive, TestLive, withHostedCase, withCase } from "../support/case.ts";
+import {
+  observationBackend,
+  observationFixture,
+  observationSource,
+  observationToken,
+} from "../support/account-observation-fixture.ts";
+import { connectLocalAccount, linkAccount } from "../support/app-accounts.ts";
+import { localAgent } from "../support/local-links.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { scenarios } from "../test-plan.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { serverControl } from "../support/server-control.ts";
+
+const Resource = Schema.Struct({ id: Schema.String });
+const Revision = Schema.Struct({ revision: Schema.String });
+const Health = Schema.Struct({
+  account: Schema.String,
+  apps: Schema.Array(
+    Schema.Struct({
+      app: Schema.String,
+      check: Schema.NullOr(Schema.Struct({ status: Schema.String, checkedAt: Schema.String })),
+    }),
+  ),
+});
+const Results = Schema.Array(
+  Schema.Union([
+    Schema.Struct({ account: Schema.String, status: Schema.Literal("checked"), health: Health }),
+    Schema.Struct({ account: Schema.String, status: Schema.Literal("refused") }),
+    Schema.Struct({
+      account: Schema.String,
+      status: Schema.Literal("failed"),
+      error: Schema.Struct({ _tag: Schema.String }),
+    }),
+  ]),
+);
+
+layer(HostedLive, { excludeTestServices: true })("Group account check policy", (it) => {
+  it.effect(scenarios.groupAccountCheckPolicy.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const shared = yield* observationFixture({
+          health: true,
+          shared: true,
+          name: "Shared check",
+        });
+        const personal = yield* observationFixture({ health: true, name: "Private check" });
+        const { api, actors, prefix } = shared;
+        const revision = yield* body(
+          Revision,
+          yield* api.request(actors.owner, "GET", `${shared.appPath}/access`),
+        );
+        expect(
+          (yield* api.request(actors.owner, "PATCH", `${shared.appPath}/access`, {
+            revision: revision.revision,
+            audience: { kind: "everyone" },
+          })).status,
+        ).toBe(200);
+        yield* linkAccount(actors.member, shared.appPath, "service", shared.account);
+        const path = `${prefix}/accounts/health`;
+        const missing = `acc_${randomUUID()}`;
+        const accounts = [shared.account, personal.account, missing, shared.account];
+        const sharedBefore = yield* shared.backend.healthCalls;
+        const personalBefore = yield* personal.backend.healthCalls;
+        // The member may use the shared account only. Private and absent IDs have identical answers.
+        const member = yield* api.request(actors.member, "POST", path, { accounts });
+        expect(member.status, "group check route accepts the account list").toBe(200);
+        const checked = yield* body(Results, member);
+        expect(checked.map(({ account, status }) => ({ account, status }))).toEqual([
+          { account: shared.account, status: "checked" },
+          { account: personal.account, status: "refused" },
+          { account: missing, status: "refused" },
+        ]);
+        expect(member.body).toEqual([
+          expect.objectContaining({
+            account: shared.account,
+            status: "checked",
+            health: expect.objectContaining({
+              account: shared.account,
+              apps: [
+                expect.objectContaining({
+                  app: shared.app.id,
+                  check: expect.objectContaining({ status: "healthy" }),
+                }),
+              ],
+            }),
+          }),
+          { account: personal.account, status: "refused" },
+          { account: missing, status: "refused" },
