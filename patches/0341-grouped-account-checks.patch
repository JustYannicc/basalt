@@ -0,0 +1,41 @@
+import { type AccountId, type Executor } from "@executor-js/sdk/core";
+import { Effect } from "effect";
+import type { SqlClient } from "effect/sql";
+import type { AccountGroupCheckResult } from "../contracts/dashboard.ts";
+import { accountLinks } from "./app-accounts.ts";
+
+/** Local's authenticated dashboard uses its existing executor and links for every sign-in. */
+export const localAccountChecks = (executor: Executor, sql: SqlClient.SqlClient) => {
+  const linkedApps = (account: AccountId) =>
+    Effect.gen(function* () {
+      const found = yield* executor.accounts.get({ account });
+      const linked = new Set(
+        (yield* accountLinks(sql, executor, found.id)).map((link) => link.app),
+      );
+      return (yield* executor.apps.list()).filter((app) => linked.has(app.id));
+    });
+  const check = (account: AccountId) =>
+    linkedApps(account).pipe(
+      Effect.flatMap((apps) =>
+        executor.accounts.check({ account, apps: apps.map((app) => app.id) }),
+      ),
+    );
+  const checkGroup = (accounts: readonly AccountId[]) =>
+    Effect.forEach(
+      [...new Set(accounts)],
+      (account) =>
+        check(account).pipe(
+          Effect.map((health): AccountGroupCheckResult => ({ account, status: "checked", health })),
+          Effect.catchTags({
+            AccountNotFound: () =>
+              Effect.succeed<AccountGroupCheckResult>({ account, status: "refused" }),
+            StorageError: (error) =>
+              Effect.succeed<AccountGroupCheckResult>({ account, status: "failed", error }),
+            AccountAcquisitionUnavailable: (error) =>
+              Effect.succeed<AccountGroupCheckResult>({ account, status: "failed", error }),
+          }),
+        ),
+      { concurrency: 2 },
+    );
+  return { linkedApps, check, checkGroup };
+};
