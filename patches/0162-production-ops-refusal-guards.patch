 class DiagnosticFailure extends Error {
   readonly receipt: FailureReceipt;
-  constructor(receipt: FailureReceipt) {
+  readonly guard: { readonly guard: string; readonly reasonCode: string };
+  constructor(receipt: FailureReceipt, guard: DiagnosticFailure["guard"]) {
     super("Production operation refused");
     this.receipt = receipt;
+    this.guard = guard;
   }
 }
 
@@ -144,9 +147,29 @@
   };
 }
 
+/** Preserve only allowlisted guard codes before phase wrappers discard the underlying error. */
+export function refusalDiagnostic(cause: Cause.Cause<unknown>, phase: Phase) {
+  for (const reason of cause.reasons) {
+    const error = Cause.isFailReason(reason)
+      ? reason.error
+      : Cause.isDieReason(reason)
+        ? reason.defect
+        : undefined;
+    if (error instanceof DiagnosticFailure) return error.guard;
+    const guard = knownRefusalGuard(error instanceof Error ? error.message : undefined);
+    if (guard !== undefined) return guard;
+  }
+  const receipt = diagnostic(cause, phase);
+  return { guard: `phase_${receipt.phase}`, reasonCode: receipt.category };
+}
+
 export const atPhase =
   (phase: Phase) =>
   <A, E, R>(work: Effect.Effect<A, E, R>) =>
     work.pipe(
-      Effect.catchCause((cause) => Effect.fail(new DiagnosticFailure(diagnostic(cause, phase)))),
+      Effect.catchCause((cause) =>
+        Effect.fail(
+          new DiagnosticFailure(diagnostic(cause, phase), refusalDiagnostic(cause, phase)),
+        ),
+      ),
     );
