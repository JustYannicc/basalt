+const invoke=query({input:object({account:string()})},async(ctx,input)=>ctx.apps.call({connection:"nested",target:${JSON.stringify(callerApp.id)},tool:"invoke",kind:"query",input:{account:input.account,target:${JSON.stringify(f.app.id)}}}));
