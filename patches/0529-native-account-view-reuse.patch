diff --git a/apps/hosted/server/src/implementation/account-source-authority.ts b/apps/hosted/server/src/implementation/account-source-authority.ts
new file mode 100644
index 0000000..25ef26f
--- /dev/null
+++ b/apps/hosted/server/src/implementation/account-source-authority.ts
@@ -0,0 +1,135 @@
+import {
+  AccountId,
+  StorageError,
+  type AccountScope,
+  type AppAccounts,
+  type AppId,
+  type ResourceLifecycle,
+} from "@executor-js/sdk/core";
+import { Context, Effect, Schema } from "effect";
+import { HostedExecutor } from "../contracts/executor.ts";
+import { accountSourceOptions } from "./account-source-options.ts";
+import { policyDatabase, requireAppAccess } from "./resource-policy.ts";
+import { registeredPool } from "./provider-account-policy.ts";
+
+const dependency = "accountView";
+type BindingChange = {
+  readonly app: AppId;
+  readonly target: AppId;
+  readonly scope: AccountScope;
+  readonly removing?: true;
+};
+export const BindingChange = Context.Reference<BindingChange | undefined>(
+  "hosted/AccountSourceBindingChange",
+  { defaultValue: () => undefined },
+);
+const accountIds = (accounts: AppAccounts) => [
+  ...new Set(
+    Object.values(accounts.app)
+      .flat()
+      .concat(Object.values(accounts.user ?? {}).flat()),
+  ),
+];
+/** Only a checked native selection transaction installs this narrowly scoped authority. */
+export const accountSourceBindingChange = (input: {
+  readonly app: AppId;
+  readonly target?: AppId;
+  readonly scope: AccountScope;
+  readonly dependency: string;
+}) =>
+  Effect.map(BindingChange, (change) =>
+    change !== undefined &&
+    input.app === change.app &&
+    input.scope === change.scope &&
+    input.dependency === dependency &&
+    (input.target === undefined || input.target === change.target)
+      ? change
+      : undefined,
+  );
+
+export const selectedSourceAccount = (input: {
+  readonly app: AppId;
+  readonly requirement: string;
+  readonly account: AccountId;
+  readonly scope: AccountScope;
+  readonly subject: string | undefined;
+}) =>
+  Effect.gen(function* () {
+    const sql = yield* policyDatabase;
+    const rows = yield* sql`select account from hosted_app_account_links
+      where app = ${input.app} and account = ${input.account} and requirement = ${input.requirement}
+        and ${input.scope === "app" ? sql`subject is null` : sql`subject = ${input.subject ?? ""}`}`;
+    return rows.length !== 0;
+  }).pipe(Effect.mapError(() => new StorageError()));
+
+/** An app-scoped account-view connection grants no other operation or account. */
+export const authorizeAccountSourceCall = (
+  input: Parameters<NonNullable<ResourceLifecycle["appCallAs"]>>[0],
+) =>
+  Effect.gen(function* () {
+    const call = input.call;
+    if (
+      call?.selections === undefined ||
+      call.dependency !== dependency ||
+      !(yield* registeredPool(input.app))
+    )
+      return false;
+    if (call.tool !== dependency || call.kind !== "query") return yield* new StorageError();
+    const requested = yield* Schema.decodeUnknownEffect(Schema.Struct({ account: AccountId }))(
+      call.input,
+      { onExcessProperty: "error" },
+    );
+    const ids = accountIds(call.accounts);
+    if (!ids.includes(requested.account)) return yield* new StorageError();
+    const executor = yield* Effect.flatten(HostedExecutor);
+    const app = yield* executor.apps.get({ app: input.app, owner: input.owner });
+    for (const id of ids) {
+      let permitted = false;
+      for (const selection of call.selections) {
+        if (
+          selection.revoked === true ||
+          selection.account !== id ||
+          selection.scope !== input.scope ||
+          selection.source.app !== input.target ||
+          !(call.accounts[selection.source.scope]?.[selection.source.requirement] ?? []).includes(
+            id,
+          )
+        )
+          continue;
+        const slot = app.requirements.accounts[selection.requirement];
+        if (slot?.scope !== input.scope || (input.scope === "app" && slot.contributed !== true))
+          continue;
+        if (
+          !(yield* selectedSourceAccount({
+            app: app.id,
+            requirement: selection.requirement,
+            account: id,
+            scope: input.scope,
+            subject: input.authorizer,
+          }))
+        )
+          continue;
+        const options = yield* accountSourceOptions({
+          executor,
+          owner: input.owner,
+          app,
+          requirement: selection.requirement,
+          accounts: [id],
+          subject: input.authorizer,
+        });
+        if (
+          (options.get(id) ?? []).some(
+            ({ source }) =>
+              source.app === input.target &&
+              source.scope === selection.source.scope &&
+              source.requirement === selection.source.requirement,
+          )
+        )
+          permitted = true;
+      }
+      if (!permitted) return yield* new StorageError();
+    }
+    yield* requireAppAccess(input.app, "use");
+    yield* requireAppAccess(input.target, "use");
+    return true;
+  }).pipe(Effect.mapError(() => new StorageError()));
diff --git a/apps/hosted/server/src/implementation/account-source-connections.ts b/apps/hosted/server/src/implementation/account-source-connections.ts
new file mode 100644
index 0000000..cb1cc54
--- /dev/null
+++ b/apps/hosted/server/src/implementation/account-source-connections.ts
@@ -0,0 +1,347 @@
+import { BindingChange, selectedSourceAccount as selected } from "./account-source-authority.ts";
+import {
+  AppCallsHost,
+  AccountId,
+  AccountConnectionTargetChanged,
+  StorageError,
+  StorageHost,
+  type AccountScope,
+  type AppConnection,
+  type AppConnectionSelection,
+  type AppAccountSource,
+  type AppId,
+  type AppAccounts,
+  type Executor,
+  type OwnerId,
+} from "@executor-js/sdk/core";
+import { Effect, Schema } from "effect";
+import { accountSourceOptions } from "./account-source-options.ts";
+import { policyDatabase, requireAppAccess } from "./resource-policy.ts";
+import { registeredPool } from "./provider-account-policy.ts";
+
+const dependency = "accountView";
+const accountsOf = (selections: readonly AppConnectionSelection[]): AppAccounts => {
+  const accounts: { app: Record<string, AccountId[]>; user: Record<string, AccountId[]> } = {
+    app: {},
+    user: {},
+  };
+  for (const selection of selections) {
+    if (selection.revoked === true) continue;
+    const scoped = accounts[selection.source.scope];
+    const ids = scoped[selection.source.requirement] ?? [];
+    if (!ids.includes(selection.account)) ids.push(selection.account);
+    scoped[selection.source.requirement] = ids;
+  }
+  return accounts;
+};
+
+type SelectedSourceInput = {
+  readonly executor: Executor;
+  readonly owner: OwnerId;
+  readonly app: AppId;
+  readonly requirement: string;
+  readonly account: AccountId;
+  readonly subject: string | undefined;
+  readonly scope: AccountScope;
+};
+const sameSelection = (selection: AppConnectionSelection, input: SelectedSourceInput) =>
+  selection.scope === input.scope &&
+  selection.requirement === input.requirement &&
+  selection.account === input.account;
+
+/** Read setup provenance after the native reader checked the original viewer and selected row. */
+export const selectedAccountSource = (input: SelectedSourceInput) =>
+  Effect.gen(function* () {
+    if (!(yield* registeredPool(input.app)) || !(yield* selected(input))) return undefined;
+    const app = yield* input.executor.apps.get({ app: input.app, owner: input.owner });
+    const bindings = yield* input.executor[AppCallsHost].bindings.list({
+      app: input.app,
+      owner: input.owner,
+    });
+    const found = [];
+    for (const binding of bindings) {
+      if (
+        !binding.connection.enabled ||
+        binding.connection.dependency !== dependency ||
+        binding.connection.scope !== input.scope
+      )
+        continue;
+      const selection = binding.selections?.find(
+        (entry) => entry.revoked !== true && sameSelection(entry, input),
+      );
+      if (
+        selection === undefined ||
+        selection.source.app !== binding.connection.target ||
+        !(binding.accounts[selection.source.scope]?.[selection.source.requirement] ?? []).includes(
+          input.account,
+        )
+      )
+        continue;
+      const options = yield* accountSourceOptions({
+        ...input,
+        app,
+        accounts: [input.account],
+        subject: binding.authorizer,
+      });
+      if (
+        (options.get(input.account) ?? []).some(
+          ({ source }) =>
+            source.app === selection.source.app &&
+            source.scope === selection.source.scope &&
+            source.requirement === selection.source.requirement,
+        )
+      )
+        found.push(binding);
+    }
+    if (found.length !== 1) return undefined;
+    return {
+      connection: dependency as "accountView",
+      target: found[0]!.connection.target,
+      account: input.account,
+    };
+  }).pipe(Effect.mapError(() => new StorageError()));
+
+/** Called under the native link lock; account membership has already been saved in this transaction. */
+export const bindAccountSource = (
+  input: SelectedSourceInput & { readonly source?: AppAccountSource | undefined },
+) =>
+  Effect.gen(function* () {
+    const mismatch = () =>
+      new AccountConnectionTargetChanged({
+        app: input.app,
+        requirement: input.requirement,
+      });
+    if (!(yield* registeredPool(input.app))) {
+      if (input.source !== undefined) return yield* mismatch();
+      return;
+    }
+    const app = yield* input.executor.apps.get({ app: input.app, owner: input.owner });
+    if (app.requirements.dependencies?.[dependency]?.cardinality !== "many") {
+      if (input.source !== undefined) return yield* mismatch();
+      return;
+    }
+    if (!(yield* selected(input))) return yield* new StorageError();
+    const bindings = yield* input.executor[AppCallsHost].bindings.list({
+      app: input.app,
+      owner: input.owner,
+    });
+    if (
+      input.source === undefined &&
+      bindings.some(
+        (binding) =>
+          binding.connection.dependency === dependency &&
+          binding.selections?.some((entry) => sameSelection(entry, input)),
+      )
+    )
+      return;
+    const options =
+      (yield* accountSourceOptions({ ...input, app, accounts: [input.account] })).get(
+        input.account,
+      ) ?? [];
+    const all =
+      input.source === undefined
+        ? ((yield* accountSourceOptions({
+            ...input,
+            app,
+            accounts: [input.account],
+            includeInvisible: true,
+          })).get(input.account) ?? [])
+        : [];
+    const source =
+      input.source === undefined
+        ? new Set(all.map(({ source }) => source.app)).size === 1 && options.length === 1
+          ? options[0]?.source
+          : undefined
+        : options.find(
+            ({ source }) =>
+              source.app === input.source!.app &&
+              source.version === input.source!.version &&
+              source.scope === input.source!.scope &&
+              source.requirement === input.source!.requirement,
+          )?.source;
+    if (source === undefined) {
+      if (input.source !== undefined)
+        return yield* new AccountConnectionTargetChanged({
+          app: input.app,
+          requirement: input.requirement,
+        });
+      return;
+    }
+    const old = bindings.find(
+      ({ connection }) =>
+        connection.dependency === dependency &&
+        connection.scope === input.scope &&
+        connection.target === source.app,
+    );
+    const selections = [
+      ...(old?.selections ?? [])
+        .filter((entry) => !sameSelection(entry, input))
+        .map((entry) =>
+          old?.connection.enabled === false ? { ...entry, revoked: true as const } : entry,
+        ),
+      { scope: input.scope, requirement: input.requirement, account: input.account, source },
+    ];
+    yield* input.executor[AppCallsHost].bindings
+      .save({
+        app: input.app,
+        owner: input.owner,
+        dependency,
+        scope: input.scope,
+        target: source.app,
+        revision: old?.connection.revision ?? 0,
+        accounts: accountsOf(selections),
+        selections,
+      })
+      .pipe(
+        Effect.provideService(BindingChange, {
+          app: input.app,
+          target: source.app,
+          scope: input.scope,
+        }),
+      );
+    for (const binding of bindings) {
+      if (
+        binding.connection.dependency !== dependency ||
+        binding.connection.scope !== input.scope ||
+        binding.connection.target === source.app ||
+        binding.selections === undefined ||
+        !binding.selections.some((entry) => sameSelection(entry, input))
+      )
+        continue;
+      yield* writeRemaining(
+        input,
+        binding.connection,
+        binding.selections.filter((entry) => !sameSelection(entry, input)),
+      );
+    }
+  }).pipe(
+    Effect.mapError((error) =>
+      Schema.is(AccountConnectionTargetChanged)(error) ? error : new StorageError(),
+    ),
+  );
+
+const writeRemaining = (
+  input: SelectedSourceInput,
+  connection: AppConnection,
+  selections: readonly AppConnectionSelection[],
+) =>
+  (selections.length === 0
+    ? input.executor.appConnections
+        .remove({
+          app: input.app,
+          owner: input.owner,
+          dependency,
+          scope: input.scope,
+          target: connection.target,
+          revision: connection.revision,
+        })
+        .pipe(Effect.asVoid)
+    : input.executor[AppCallsHost].bindings
+        .rewrite({
+          app: input.app,
+          owner: input.owner,
+          dependency,
+          scope: input.scope,
+          target: connection.target,
+          revision: connection.revision,
+          accounts: accountsOf(selections),
+          selections,
+          enabled: connection.enabled && selections.some((entry) => entry.revoked !== true),
+        })
+        .pipe(Effect.asVoid)
+  ).pipe(
+    Effect.provideService(BindingChange, {
+      app: input.app,
+      target: connection.target,
+      scope: input.scope,
+      removing: true,
+    }),
+  );
+
+/** Unlink prunes only its own provenance; other native memberships and revocations stay intact. */
+export const unlinkAccountSource = (input: SelectedSourceInput) =>
+  Effect.gen(function* () {
+    if (!(yield* registeredPool(input.app))) return;
+    const bindings = yield* input.executor[AppCallsHost].bindings.list({
+      app: input.app,
+      owner: input.owner,
+    });
+    for (const binding of bindings) {
+      if (
+        binding.connection.dependency !== dependency ||
+        binding.connection.scope !== input.scope ||
+        binding.selections === undefined ||
+        !binding.selections.some((entry) => sameSelection(entry, input))
+      )
+        continue;
+      yield* writeRemaining(
+        input,
+        binding.connection,
+        binding.selections.filter((entry) => !sameSelection(entry, input)),
+      );
+    }
+  }).pipe(Effect.mapError(() => new StorageError()));
+
+/** Removing a managed source retains its revocation until a new explicit native selection. */
+export const revokeManagedAccountSource = (input: {
+  readonly executor: Executor;
+  readonly owner: OwnerId;
+  readonly app: AppId;
+  readonly dependency: string;
+  readonly scope: AccountScope;
+  readonly target?: AppId | undefined;
+  readonly revision: number;
+}) =>
+  Effect.gen(function* () {
+    if (input.dependency !== dependency || !(yield* registeredPool(input.app))) return false;
+    return yield* input.executor[StorageHost].transaction(
+      Effect.gen(function* () {
+        const sql = yield* policyDatabase;
+        yield* sql`select id from executor_apps where id = ${input.app} for no key update`;
+        const bindings = yield* input.executor[AppCallsHost].bindings.list({
+          app: input.app,
+          owner: input.owner,
+        });
+        const binding = bindings.find(
+          ({ connection }) =>
+            connection.dependency === dependency &&
+            connection.scope === input.scope &&
+            connection.target === input.target &&
+            connection.revision === input.revision,
+        );
+        if (
+          binding?.selections === undefined ||
+          binding.selections.length === 0 ||
+          binding.selections.some(
+            (entry) =>
+              entry.source.app !== binding.connection.target ||
+              (entry.revoked !== true &&
+                !(binding.accounts[entry.source.scope]?.[entry.source.requirement] ?? []).includes(
+                  entry.account,
+                )),
+          )
+        )
+          return false;
+        yield* requireAppAccess(input.app, "manage");
+        yield* input.executor.appConnections
+          .update({
+            app: input.app,
+            owner: input.owner,
+            dependency,
+            scope: input.scope,
+            target: binding.connection.target,
+            revision: input.revision,
+            enabled: false,
+          })
+          .pipe(
+            Effect.provideService(BindingChange, {
+              app: input.app,
+              target: binding.connection.target,
+              scope: input.scope,
+              removing: true,
+            }),
+          );
+        return true;
+      }),
+    );
+  }).pipe(Effect.mapError(() => new StorageError()));
diff --git a/apps/hosted/server/src/implementation/account-source-options.ts b/apps/hosted/server/src/implementation/account-source-options.ts
