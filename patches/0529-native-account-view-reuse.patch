+import { Schema } from "effect";
+import {
+  AccountObservationResult,
+  AccountObservationAttempt as AppObservationAttempt,
+  AccountObservationInstant,
+} from "./account-observation.ts";
+import { AccountCheckFailure } from "./account-check-failure.ts";
+import { AccountId } from "./schema.ts";
+
+export const AccountObservationCheckAttempt = Schema.Struct({
+  ...AppObservationAttempt.fields,
+  failure: Schema.optionalKey(AccountCheckFailure),
+});
+
+const Source = /* @__PURE__ */ (() =>
+  Schema.Struct({
+    kind: Schema.Literals(["app", "driver"]),
+    id: Schema.NonEmptyString,
+    label: Schema.String,
+    version: Schema.String,
+  }))();
+
+/** Host-attributed readings and refresh attempts. No provider credential or backend reference. */
+export const AccountObservationRecord = /* @__PURE__ */ (() =>
+  Schema.Struct({
+    source: Source,
