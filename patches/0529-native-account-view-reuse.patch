+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors;
+        const prefix = `/api/organizations/${actors.organization.id}/apps`;
+        const apps: string[] = [];
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* serverControl("start");
+            for (const app of apps) yield* api.request(actors.owner, "DELETE", `${prefix}/${app}`);
+          }).pipe(Effect.orDie),
+        );
+        const deploy = (name: string, content: string) =>
+          Effect.gen(function* () {
+            const response = yield* api.request(actors.owner, "POST", `${prefix}/deploy`, {
+              name,
+              files: [appsManifest, { path: "index.ts", content }],
+            });
+            expect(response.status, JSON.stringify(response.body)).toBe(200);
+            const app = (yield* body(Resource, response)).id;
+            apps.push(app);
+            return app;
+          });
+        const target = yield* deploy(
+          "Retained connection target",
+          'import {defineApp,query,object,router} from "apps"; export default defineApp({}, {tools:router({ping:query({input:object({})},async()=>({target:"first"}))})});',
+        );
+        const other = yield* deploy(
+          "Another exact target",
+          'import {defineApp,query,object,router} from "apps"; export default defineApp({}, {tools:router({ping:query({input:object({})},async()=>({target:"second"}))})});',
+        );
+        const callerSource = (
+          many: boolean,
+        ) => `import {defineApp,query,object,string,router} from "apps";
+const invoke=query({input:object({target:string()})},async(ctx,input)=>ctx.apps.call({connection:"remote",target:input.target,tool:"ping",kind:"query",input:{}}));
+export default defineApp({dependencies:{remote:{scope:"user",${many ? 'cardinality:"many",' : ""}tools:{ping:{kind:"query"}}}}},{tools:router({invoke})});`;
+        const caller = yield* deploy("Retained calling app", callerSource(false));
+        const path = `${prefix}/${caller}/connections/remote`;
+        const saved = yield* body(
+          Connection,
+          yield* api.request(actors.owner, "PUT", path, { scope: "user", target, revision: 0 }),
+        );
+        const call = (app: string, target: string) =>
+          api.request(actors.owner, "POST", `${prefix}/${app}/tools/call`, {
+            tool: "invoke",
+            kind: "query",
+            input: { target },
+          });
+        expect((yield* call(caller, target)).body).toEqual({ target: "first" });
+
+        // Reconstruct precisely the released 4.0.29 connection constraint with its real saved row.
+        const before = yield* legacyStorage([
+          oldColumns(saved.id),
+          {
+            sql: "alter table executor_app_connections drop constraint executor_app_connections_target_binding",
+          },
+          {
+            sql: "alter table executor_app_connections add constraint executor_app_connections_binding unique (app, dependency, subject)",
+          },
+          { sql: "update private_executor_settings set value = '4.0.29' where key = 'version'" },
+          // A failed migration must not leave the old server with a half-changed constraint.
+          { sql: "create index executor_app_connections_target_binding on executor_apps (id)" },
+        ]);
+        yield* serverControl("start", 500);
+        const rolledBack = yield* legacyStorage([
+          oldColumns(saved.id),
+          currentVersion,
+          oldConstraint,
+          { sql: "drop index executor_app_connections_target_binding" },
+        ]);
+        expect(rolledBack[0]).toEqual(before[0]);
+        expect(rolledBack[1]).toEqual([{ value: "4.0.29" }]);
+        expect(rolledBack[2]).toEqual([{ conname: "executor_app_connections_binding" }]);
+        yield* serverControl("start");
+        const upgraded = yield* legacyStorage([
+          oldColumns(saved.id),
+          currentVersion,
+          oldConstraint,
+        ]);
+        expect(upgraded[0]).toEqual(before[0]);
+        expect(upgraded[1]).toEqual([{ value: "4.0.30" }]);
+        expect(upgraded[2]).toEqual([]);
+        yield* serverControl("start");
+        expect((yield* call(caller, target)).body).toEqual({ target: "first" });
+        expect(
+          yield* body(
+            Connections,
+            yield* api.request(actors.owner, "GET", `${prefix}/${caller}/connections`),
+          ),
+        ).toEqual({ connections: [saved] });
+        yield* serverControl("restart");
+        expect((yield* call(caller, target)).body).toEqual({ target: "first" });
+        const repeated = yield* legacyStorage([oldColumns(saved.id), currentVersion]);
+        expect(repeated[0]).toEqual(before[0]);
+        expect(repeated[1]).toEqual([{ value: "4.0.30" }]);
+        yield* serverControl("start");
+
+        // The old request shape still replaces one target and preserves its stable row identity.
+        const replaced = yield* body(
+          Connection,
+          yield* api.request(actors.owner, "PUT", path, {
+            scope: "user",
+            target: other,
+            revision: saved.revision,
+          }),
+        );
+        expect(replaced).toMatchObject({ id: saved.id, target: other, revision: 2 });
+        expect((yield* call(caller, other)).body).toEqual({ target: "second" });
+        expect((yield* call(caller, target)).status).not.toBe(200);
+        const collection = yield* deploy("Many exact targets", callerSource(true));
+        const collectionPath = `${prefix}/${collection}/connections/remote`;
+        for (const exact of [target, other])
+          expect(
+            (yield* api.request(actors.owner, "PUT", collectionPath, {
+              scope: "user",
+              target: exact,
+              revision: 0,
+            })).status,
+          ).toBe(200);
+        expect((yield* call(collection, target)).body).toEqual({ target: "first" });
+        expect((yield* call(collection, other)).body).toEqual({ target: "second" });
+        const listed = yield* body(
+          Connections,
+          yield* api.request(actors.owner, "GET", `${prefix}/${collection}/connections`),
+        );
+        expect(listed.connections.map((connection) => connection.id)).toHaveLength(2);
+        const removed = listed.connections.find((connection) => connection.target === target)!;
+        expect(
+          (yield* api.request(
+            actors.owner,
+            "DELETE",
+            `${collectionPath}?scope=user&target=${encodeURIComponent(target)}&revision=${removed.revision}`,
+          )).status,
+        ).toBe(200);
+        expect((yield* call(collection, target)).status).not.toBe(200);
+        expect((yield* call(collection, other)).body).toEqual({ target: "second" });
+        expect(
+          (yield* body(
+            Connections,
+            yield* api.request(actors.owner, "GET", `${prefix}/${collection}/connections`),
+          )).connections,
+        ).toHaveLength(1);
+      }),
+    ),
+  );
+});
