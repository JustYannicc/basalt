+    ),
+    health: Schema.toEncoded(AccountHealthJson),
+    canInspect: Schema.Boolean,
+    observations: Schema.NullOr(AccountObservationView),
+  }),
+]);
+export type SelectedAccountView = typeof SelectedAccountView.Type;
+
+/** A selected-account read refused stale authority or could not complete without collecting data. */
+export class SelectedAccountReadFailed extends Schema.TaggedError<SelectedAccountReadFailed>()(
+  "SelectedAccountReadFailed",
+  {
+    reason: Schema.Literals(["unavailable", "stale", "invalid_input", "failed"]),
+    retryable: Schema.Literal(false),
+  },
+) {}
+
+export const SelectedAccountReadCommand = Schema.Struct({
+  operation: Schema.Literal("selected-account-read"),
+  scope: Schema.Literals(["app", "user"]),
+  requirement: Schema.NonEmptyString,
+  account: AccountId,
+});
+export const SelectedAccountReadReply = Schema.Union([
+  Schema.Struct({ ok: Schema.Literal(true), value: SelectedAccountView }),
+  Schema.Struct({ ok: Schema.Literal(false), error: SelectedAccountReadFailed }),
+]);
+export type SelectedAccountReadHost = (
+  command: typeof SelectedAccountReadCommand.Type,
+) => Effect.Effect<SelectedAccountView, SelectedAccountReadFailed>;
