+import { Schema, type Effect } from "effect";
+import { AccountId } from "./schema.ts";
+import { AppIcons } from "./icons.ts";
+import { AccountHealthJson } from "./account-health.ts";
+import { AccountObservationView } from "./account-observation-view.ts";
+
+/** Native metadata and retained readings visible to this invocation's original viewer and grant. */
+export const SelectedAccountView = Schema.Union([
+  Schema.Struct({ state: Schema.Literal("denied"), account: Schema.Struct({ id: AccountId }) }),
+  Schema.Struct({
+    state: Schema.Literal("available"),
+    account: Schema.Struct({
+      id: AccountId,
+      label: Schema.String,
+      method: Schema.String,
+      site: Schema.optionalKey(Schema.String),
+    }),
+    sourceApp: Schema.Struct({
+      id: Schema.String,
+      version: Schema.String,
+      name: Schema.String,
+      icons: Schema.optionalKey(AppIcons),
+    }),
+    sourceConnection: Schema.optionalKey(
+      Schema.Struct({
+        connection: Schema.Literal("accountView"),
+        target: Schema.String,
+        account: AccountId,
+      }),
+    ),
+    health: Schema.toEncoded(AccountHealthJson),
+    canInspect: Schema.Boolean,
+    observations: Schema.NullOr(AccountObservationView),
+  }),
+]);
+export type SelectedAccountView = typeof SelectedAccountView.Type;
+
+/** A selected-account read refused stale authority or could not complete without collecting data. */
+export class SelectedAccountReadFailed extends Schema.TaggedError<SelectedAccountReadFailed>()(
+  "SelectedAccountReadFailed",
+  {
+    reason: Schema.Literals(["unavailable", "stale", "invalid_input", "failed"]),
+    retryable: Schema.Literal(false),
+  },
+) {}
+
+export const SelectedAccountReadCommand = Schema.Struct({
+  operation: Schema.Literal("selected-account-read"),
+  scope: Schema.Literals(["app", "user"]),
+  requirement: Schema.NonEmptyString,
+  account: AccountId,
+});
+export const SelectedAccountReadReply = Schema.Union([
+  Schema.Struct({ ok: Schema.Literal(true), value: SelectedAccountView }),
+  Schema.Struct({ ok: Schema.Literal(false), error: SelectedAccountReadFailed }),
+]);
+export type SelectedAccountReadHost = (
+  command: typeof SelectedAccountReadCommand.Type,
+) => Effect.Effect<SelectedAccountView, SelectedAccountReadFailed>;
+
+/** Validate an app query's JSON reply against the same native account-view contract. */
+export const decodeSelectedAccountView = Schema.decodeUnknownSync(SelectedAccountView);
