+/** Native metadata and retained readings visible to this invocation's original viewer and grant. */
+export const SelectedAccountView = Schema.Union([
+  Schema.Struct({ state: Schema.Literal("denied"), account: Schema.Struct({ id: AccountId }) }),
+  Schema.Struct({
+    state: Schema.Literal("available"),
+    account: Schema.Struct({
+      id: AccountId,
+      label: Schema.String,
+      method: Schema.String,
+      site: Schema.optionalKey(Schema.String),
