index 0000000..5fa092c
--- /dev/null
+++ b/packages/sdk/src/implementation/selected-account-read.ts
@@ -0,0 +1,122 @@
+import { Context, Effect, Schema } from "effect";
+import {
+  SelectedAccountReadFailed,
+  SelectedAccountReadCommand,
+  type SelectedAccountReadHost,
+} from "apps/contracts";
+import { SelectedAccountInspection } from "../contracts/selected-account-read.ts";
+import type { ResourceLifecycle } from "../contracts/executor.ts";
+import { CurrentActor } from "../contracts/executor.ts";
+import type { Query } from "./database.ts";
+import type { InvocationSnapshot } from "./tools.ts";
+import { snapshot } from "./tools.ts";
+import { accountAuthority } from "./selection.ts";
+import { AppCallProtection } from "./app-call-context.ts";
+import { recheckAppCallAuthority, sameAppCallAuthority } from "./app-call-protection.ts";
+import type { makeAppConnections } from "./app-connections.ts";
+
+export const SelectedAccountReadParents = Context.Reference<
+  readonly Omit<
+    import("../contracts/app-calls.ts").AppProtectedDispatch,
+    "decodedInput" | "appPolicy"
+  >[]
+>("executor/SelectedAccountReadParents", { defaultValue: () => [] });
+
+/** Bind reads to the selection already given to this invocation, without resolving credentials. */
+export const selectedAccountRead =
+  (
+    db: Query,
+    state: InvocationSnapshot,
+    connections: ReturnType<typeof makeAppConnections>,
+    lifecycle?: ResourceLifecycle,
+  ): SelectedAccountReadHost =>
+  (input) =>
+    Effect.gen(function* () {
+      const command = yield* Schema.decodeUnknownEffect(SelectedAccountReadCommand)(input, {
+        onExcessProperty: "error",
+      }).pipe(
+        Effect.mapError(
+          () => new SelectedAccountReadFailed({ reason: "invalid_input", retryable: false }),
+        ),
+      );
+      const selection = state.selections.find(
+        (entry) => entry.slot === command.requirement && entry.required.scope === command.scope,
+      );
+      const selected = selection?.accounts.find((account) => account.id === command.account);
+      if (selected === undefined)
+        return yield* new SelectedAccountReadFailed({ reason: "invalid_input", retryable: false });
+      const protectedCall = yield* AppCallProtection;
+      const parents = yield* SelectedAccountReadParents;
+      const check = Effect.gen(function* () {
+        const current = yield* snapshot(db, {
+          app: state.app.id,
+          captured: { accounts: state.accounts, scope: state.scope },
+        });
+        if (
+          current.app.owner !== state.app.owner ||
+          current.version.id !== state.version.id ||
+          current.version.build !== state.version.build ||
+          !sameAppCallAuthority(current.accounts, state.accounts)
+        )
+          return yield* new SelectedAccountReadFailed({ reason: "stale", retryable: false });
+        const row = current.selections
+          .find(
+            (entry) => entry.slot === command.requirement && entry.required.scope === command.scope,
+          )
+          ?.accounts.find((account) => account.id === selected.id);
+        if (
+          row === undefined ||
+          row.owner !== selected.owner ||
+          row.provider !== selected.provider ||
+          row.method !== selected.method ||
+          row.credentialGeneration !== selected.credentialGeneration
+        )
+          return yield* new SelectedAccountReadFailed({ reason: "stale", retryable: false });
+        if (lifecycle !== undefined) {
+          const links =
+            command.scope === "app"
+              ? yield* lifecycle.appLinks({ app: state.app.id })
+              : state.actor === undefined
+                ? []
+                : yield* lifecycle.userLinks({ app: state.app.id, subject: state.actor });
+          if (
+            !links.some(
+              (link) => link.requirement === command.requirement && link.account === selected.id,
+            )
+          )
+            return yield* new SelectedAccountReadFailed({ reason: "stale", retryable: false });
+          const authority = accountAuthority(current.selections);
+          const allowed = yield* lifecycle.appResolving(
+            { id: current.app.id, owner: current.app.owner },
+            authority.user,
+            authority.app,
+          );
+          if (!allowed.has(selected.id))
+            return yield* new SelectedAccountReadFailed({ reason: "stale", retryable: false });
+        }
+        for (const call of [...parents, ...(protectedCall === undefined ? [] : [protectedCall])])
+          yield* recheckAppCallAuthority({ db, connections }, call);
+      }).pipe(
+        Effect.provideService(CurrentActor, state.actor),
+        Effect.mapError(() => new SelectedAccountReadFailed({ reason: "stale", retryable: false })),
+      );
+      yield* check;
+      const inspect = yield* SelectedAccountInspection;
+      if (inspect === undefined) return { state: "denied" as const, account: { id: selected.id } };
+      const value = yield* inspect({
+        account: selected.id,
+        owner: selected.owner,
+        scope: command.scope,
+        requirement: command.requirement,
+        sourceApp: {
+          id: state.app.id,
+          version: state.version.id,
+          name: state.app.name,
+          ...(state.version.requirements.icons === undefined
+            ? {}
+            : { icons: state.version.requirements.icons }),
+        },
+      });
+      yield* check;
