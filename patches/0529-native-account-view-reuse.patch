diff --git a/packages/ui/src/implementation/dashboard/account-source-choice.tsx b/packages/ui/src/implementation/dashboard/account-source-choice.tsx
new file mode 100644
index 0000000..446f2e2
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/account-source-choice.tsx
@@ -0,0 +1,112 @@
+import type { AppAccountSource } from "@executor-js/sdk";
+import { RegistryContext } from "@effect/atom-react";
+import { Effect, Exit, type Cause } from "effect";
+import { AtomRegistry, type Atom } from "effect/reactivity";
+import { HugeiconsIcon } from "@hugeicons/react";
+import { ArrowDown01Icon } from "@hugeicons/core-free-icons";
+import { useContext } from "react";
+import { Button } from "../components/button.tsx";
+import {
+  DropdownMenu,
+  DropdownMenuContent,
+  DropdownMenuLabel,
+  DropdownMenuRadioGroup,
+  DropdownMenuRadioItem,
+  DropdownMenuTrigger,
+} from "../components/dropdown-menu.tsx";
+
+type SourceOption = { readonly source: AppAccountSource; readonly name: string };
+interface Props<E> {
+  readonly sources: readonly SourceOption[];
+  readonly current: AppAccountSource | undefined;
+  readonly accountName: string;
+  readonly disabled: boolean;
+  readonly link: (source: AppAccountSource) => Atom.AtomResultFn<void, unknown, E>;
+  readonly onPending: (pending: boolean) => void;
+  readonly onError: (error: Cause.Cause<E> | undefined) => void;
+}
+
+// The host matches the current source by app, scope and requirement; a newer version of the same
+// app is still the same choice.
+const keyOf = (source: AppAccountSource) => `${source.app}:${source.scope}:${source.requirement}`;
+
+// App names are unique in an organization, but one app can hold the account in two places.
+const labels = (sources: readonly SourceOption[]) =>
+  new Map(
+    sources.map((option) => {
+      const shared = sources.filter((other) => other.name === option.name).length > 1;
+      const where = option.source.scope === "user" ? "yours" : option.source.requirement;
+      return [keyOf(option.source), shared ? `${option.name} · ${where}` : option.name];
+    }),
+  );
+
+/**
+ * Picks which provider app supplies a linked account's details when more than one holds it, or
+ * when the host could not prove the only one. Choosing changes only where the details come from;
+ * the account's membership and routing stay as they are.
+ */
+export function AccountSourceChoice<E>(props: Props<E>) {
+  const registry = useContext(RegistryContext);
+  const named = labels(props.sources);
+  const current = props.sources.find(
+    (option) => props.current !== undefined && keyOf(option.source) === keyOf(props.current),
+  );
+  const currentName = current === undefined ? undefined : named.get(keyOf(current.source));
+  // Menu items unmount when the menu closes, so the change runs here, mounted until it settles.
+  const choose = async (option: SourceOption) => {
+    if (props.disabled || option === current) return;
+    const command = props.link(option.source);
+    const release = registry.mount(command);
+    props.onError(undefined);
+    props.onPending(true);
+    try {
+      registry.set(command, undefined);
+      const exit = await Effect.runPromiseExit(
+        AtomRegistry.getResult(registry, command, { suspendOnWaiting: true }),
+      );
+      if (Exit.isFailure(exit)) props.onError(exit.cause);
+    } finally {
+      props.onPending(false);
+      release();
+    }
+  };
+  return (
+    <DropdownMenu>
+      <DropdownMenuTrigger asChild>
+        <Button
+          variant="ghost"
+          size="xs"
+          className="max-w-full min-w-0"
+          disabled={props.disabled}
+          aria-label={
+            currentName === undefined
+              ? `Choose provider app for ${props.accountName}`
+              : `Details from ${currentName}. Choose provider app for ${props.accountName}`
+          }
+          data-account-source={current === undefined ? "unset" : "set"}
+        >
+          <span className="min-w-0 truncate">
+            {currentName === undefined ? "Choose provider app" : `Details from ${currentName}`}
+          </span>
+          <HugeiconsIcon icon={ArrowDown01Icon} size={12} strokeWidth={2} aria-hidden />
+        </Button>
+      </DropdownMenuTrigger>
+      <DropdownMenuContent align="start" collisionPadding={16} className="min-w-44 max-w-72">
+        <DropdownMenuLabel className="text-xs font-normal text-muted-foreground">
+          Account details from
+        </DropdownMenuLabel>
+        <DropdownMenuRadioGroup value={current === undefined ? "" : keyOf(current.source)}>
+          {props.sources.map((option) => (
+            <DropdownMenuRadioItem
+              key={keyOf(option.source)}
+              value={keyOf(option.source)}
+              onSelect={() => void choose(option)}
+            >
+              <span className="min-w-0 break-words">{named.get(keyOf(option.source))}</span>
+            </DropdownMenuRadioItem>
+          ))}
+        </DropdownMenuRadioGroup>
+      </DropdownMenuContent>
+    </DropdownMenu>
+  );
+}
