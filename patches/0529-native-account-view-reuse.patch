+import { selectedAccountSource } from "./account-source-connections.ts";
+import { GroupDatabase } from "../contracts/groups.ts";
+import { AccountHealthJson } from "apps/contracts";
+import { Effect, Option, Schema } from "effect";
+import { permitsApp } from "@executor-js/authorization";
+import {
+  AppId,
+  SelectedAccountInspection,
+  SelectedAccountReadFailed,
+  type SelectedAccountInspectionInput,
+  type SelectedAccountView,
+} from "@executor-js/sdk/core";
+import { CurrentAuthorization } from "../contracts/authorization.ts";
+import { CurrentUserId } from "../contracts/auth.ts";
+import { CurrentOrganization } from "../contracts/organization.ts";
+import { HostedExecutor } from "../contracts/executor.ts";
+import { inspectableAccounts } from "./proofs/account-access.ts";
+import { linkedApps } from "./accounts.ts";
+import { visibleApps } from "./resource-policy.ts";
+import { observationAccess, visibleObservationHealth } from "./account-observation-policy.ts";
+import { visibleAccountStatuses } from "./account-identity.ts";
+
+/** Install only after verifying the request's viewer and grant. Dependency execution keeps it. */
+export const withSelectedAccountInspection = <A, E, R>(work: Effect.Effect<A, E, R>) =>
+  Effect.gen(function* () {
+    const context = yield* Effect.context<R | CurrentOrganization>();
+    const hosted = yield* Effect.serviceOption(HostedExecutor);
+    const groups = yield* Effect.serviceOption(GroupDatabase);
+    const reader = (input: SelectedAccountInspectionInput) => {
+      if (Option.isNone(hosted) || Option.isNone(groups))
+        return Effect.fail(
+          new SelectedAccountReadFailed({ reason: "unavailable", retryable: false }),
+        );
+      return Effect.gen(function* () {
+        const denied: SelectedAccountView = { state: "denied", account: { id: input.account } };
+        const { owner } = yield* CurrentOrganization;
+        if (owner !== input.owner) return denied;
+        const executor = yield* Effect.flatten(HostedExecutor);
+        const source = AppId.make(input.sourceApp.id);
+        const policy = yield* CurrentAuthorization;
+        const access = Effect.gen(function* () {
+          if (!permitsApp(policy, source)) return false;
+          if (!(yield* inspectableAccounts([input.account])).includes(input.account)) return false;
+          const app = yield* executor.apps.get({ owner, app: source });
+          return (yield* visibleApps([app])).some((entry) => entry.id === source);
+        });
+        if (!(yield* access)) return denied;
+        const apps = yield* linkedApps(owner, input.account);
+        const ids = apps.map((app) => app.id);
+        const canInspect = (yield* observationAccess(input.account)).canInspect;
+        const account = yield* executor.accounts.get({ owner, account: input.account });
+        const health = yield* executor.accounts.health({
+          owner,
+          account: input.account,
+          apps: ids,
+        });
+        const observations = canInspect
+          ? yield* executor.accounts.observations({ owner, account: input.account, apps: ids })
+          : null;
+        const [visible] = yield* visibleAccountStatuses([
+          {
+            account,
+            health: { ...health, apps: health.apps.filter((app) => ids.includes(app.app)) },
+          },
+        ]);
+        const sourceConnection = yield* selectedAccountSource({
+          executor,
+          owner,
+          app: source,
+          requirement: input.requirement,
+          account: input.account,
+          subject: yield* CurrentUserId,
+          scope: input.scope,
+        });
+        if (!(yield* access)) return denied;
+        const currentApps = yield* linkedApps(owner, input.account);
+        if (currentApps.length !== ids.length || currentApps.some((app) => !ids.includes(app.id)))
+          return yield* new SelectedAccountReadFailed({ reason: "stale", retryable: false });
+        const currentInspection = (yield* observationAccess(input.account)).canInspect;
+        const canShowObservations = canInspect && currentInspection;
+        const safeHealth = yield* visibleObservationHealth(visible!.health!, canShowObservations);
+        return {
+          state: "available" as const,
+          account: {
+            id: account.id,
+            label: visible!.account.label,
+            method: account.method,
+            ...(account.site === undefined ? {} : { site: account.site }),
+          },
+          sourceApp: input.sourceApp,
+          ...(sourceConnection === undefined ? {} : { sourceConnection }),
+          health: yield* Schema.encodeUnknownEffect(AccountHealthJson)(safeHealth),
+          canInspect: canShowObservations,
+          observations: canShowObservations ? observations : null,
+        };
+      }).pipe(
+        Effect.catchTag("OrganizationForbidden", () =>
+          Effect.succeed<SelectedAccountView>({ state: "denied", account: { id: input.account } }),
+        ),
+        Effect.mapError((error) =>
+          error instanceof SelectedAccountReadFailed
+            ? error
+            : new SelectedAccountReadFailed({ reason: "failed", retryable: false }),
+        ),
+        Effect.provideService(HostedExecutor, hosted.value),
+        Effect.provideService(GroupDatabase, groups.value),
+        Effect.provideContext(context),
+      );
+    };
+    return yield* work.pipe(Effect.provideService(SelectedAccountInspection, reader));
+  });
