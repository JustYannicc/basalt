index 0000000..39e5e80
--- /dev/null
+++ b/apps/hosted/server/src/implementation/account-source-options.ts
@@ -0,0 +1,119 @@
+import {
+  AppId,
+  AccountId,
+  VersionId,
+  type App,
+  type AppAccountSource,
+  type Executor,
+  type OwnerId,
+  StorageError,
+} from "@executor-js/sdk/core";
+import { Effect, Option, Schema } from "effect";
+import { HostedCatalog } from "../contracts/catalog.ts";
+import { policyDatabase, requireAppAccess } from "./resource-policy.ts";
+import { registeredPool } from "./provider-account-policy.ts";
+import { recordedServiceInstalls } from "./service-install-records.ts";
+
+export interface AccountSourceOption {
+  readonly source: AppAccountSource;
+  readonly name: string;
+}
+const Held = Schema.Struct({
+  app: AppId,
+  requirement: Schema.String,
+  account: AccountId,
+  subject: Schema.NullOr(Schema.String),
+});
+
+/** Candidates are actual account holders with trusted provider installation identity. */
+export const accountSourceOptions = (input: {
+  readonly executor: Executor;
+  readonly owner: OwnerId;
+  readonly app: App;
+  readonly requirement: string;
+  readonly accounts: readonly AccountId[];
+  readonly subject: string | undefined;
+  readonly includeInvisible?: boolean;
+}) =>
+  Effect.gen(function* () {
+    const result = new Map<AccountId, AccountSourceOption[]>();
+    const required = input.app.requirements.accounts[input.requirement];
+    if (
+      required === undefined ||
+      input.accounts.length === 0 ||
+      input.app.requirements.dependencies?.accountView?.cardinality !== "many" ||
+      !(yield* registeredPool(input.app.id))
+    )
+      return result;
+    const catalog = yield* Effect.serviceOption(HostedCatalog);
+    if (Option.isNone(catalog)) return result;
+    const entries = yield* catalog.value.list.pipe(Effect.catch(() => Effect.succeed([])));
+    const sql = yield* policyDatabase;
+    const held = yield* Schema.decodeUnknownEffect(Schema.Array(Held))(
+      yield* sql`select app, requirement, account, subject
+    from hosted_app_account_links where ${sql.in("account", input.accounts)}
+      and app <> ${input.app.id} and ${input.includeInvisible === true ? sql`true` : sql`(subject is null or subject = ${input.subject ?? ""})`}
+    order by app, requirement, account`,
+    );
+    const apps = yield* Effect.forEach([...new Set(held.map((row) => row.app))], (app) =>
+      input.executor.apps.get({ app, owner: input.owner }).pipe(
+        Effect.map((app) => [app]),
+        Effect.catchTag("AppNotFound", () => Effect.succeed([])),
+      ),
+    );
+    const candidates = new Map(apps.flat().map((app) => [app.id, app]));
