index 0000000..ac5ed8b
--- /dev/null
+++ b/e2e/tests/pool-account-source-choice-ui.spec.ts
@@ -0,0 +1,242 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import type { Page } from "playwright";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { Browser } from "../support/browser.ts";
+import { choiceName } from "../support/account-choices.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { openThroughBrowser } from "../support/in-app-navigation.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { providerAccountProduct } from "../support/provider-account-product.ts";
+import { providerAppsCatalog } from "../support/provider-apps-catalog.ts";
+import { holdQuery } from "../support/query-transition.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+const poolName = "Pool shows provider details";
+const firstApp = "First provider app";
+// Long names must truncate inside the row instead of widening it.
+const secondApp = "Second provider app with a deliberately long name that must stay inside the row";
+const lone = "Lone account";
+const shared = "Shared account for the research team's long-running evaluation workloads";
+const poolSource = `import { defineApp } from "apps";
+import { providers } from "./providers.ts";
+export default defineApp({app:{accounts:{openai:providers.openai.many().requiring("model-inference").contributed()}},dependencies:{accountView:{scope:"app",cardinality:"many",tools:{accountView:{kind:"query"}}}}},{});`;
+
+const chooser = (page: Page, account: string) =>
+  page.getByRole("button", { name: `Choose provider app for ${account}` });
+const row = (page: Page, account: string) =>
+  page
+    .getByRole("listitem")
+    .filter({ has: page.getByRole("checkbox", { name: choiceName(account), exact: true }) });
+
+layer(HostedLive, { excludeTestServices: true })("Pool account source choice", (it) => {
+  it.effect(scenarios.poolAccountSourceChoiceUi.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          browser = yield* Browser,
+          catalog = yield* providerAppsCatalog;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const apps: string[] = [],
+          accounts: string[] = [];
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* serverControl("start");
+            for (const app of apps)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app}`);
+            for (const account of accounts)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`);
+          }).pipe(Effect.orDie),
+        );
+        yield* providerAccountProduct(catalog.origin, `${catalog.origin}/catalog/index.json`);
+        const canonical = catalog.sources
+          .get("openai")!
+          .files.find((file) => file.path === "providers.ts")!;
+        const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: poolName,
+          files: [appsManifest, canonical, { path: "index.ts", content: poolSource }],
+        });
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const pool = (yield* body(Resource, deployed)).id;
+        apps.push(pool);
+        const poolPath = `${prefix}/apps/${pool}`;
+        const sources: string[] = [];
+        for (const name of [firstApp, secondApp]) {
+          const installed = yield* api.request(actors.owner, "POST", `${prefix}/apps/install`, {
+            entry: "provider-openai",
+            name,
+            newInstance: true,
+          });
+          expect(installed.status, JSON.stringify(installed.body)).toBe(200);
+          const app = (yield* body(Resource, installed)).id;
+          sources.push(app);
+          apps.push(app);
+        }
+        const [first, second] = [sources[0]!, sources[1]!];
+        const providerPath = (app: string) => `${prefix}/apps/${app}/accounts/app/openai`;
+        // The lone account has one holder; the shared one is held by both provider apps.
+        for (const [label, holders] of [
+          [lone, [first]],
+          [shared, [first, second]],
+        ] as const) {
+          const created = yield* api.request(actors.owner, "POST", providerPath(holders[0]), {
+            creation: crypto.randomUUID(),
+            method: "apiKey",
+            label,
+            fields: { token: `synthetic-source-choice-${accounts.length}` },
+          });
+          expect(created.status, JSON.stringify(created.body)).toBe(200);
+          const account = (yield* body(Resource, created)).id;
+          accounts.push(account);
+          for (const holder of holders)
+            expect(
+              (yield* api.request(actors.owner, "PUT", `${providerPath(holder)}/${account}`))
+                .status,
+            ).toBe(200);
+        }
+        const sharedAccount = accounts[1]!;
+        yield* serverControl("stop");
+        yield* legacyStorage([
+          {
+            sql: `update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb), '{basaltPools}', coalesce(metadata::jsonb -> 'basaltPools', '{}'::jsonb) || $1::jsonb)::text where id = $2`,
+            params: [
+              JSON.stringify({
+                [pool]: {
+                  app: pool,
+                  membership: "executor-links-v1",
+                  authorization: "executor-app-v1",
+                },
+              }),
+              actors.organization.id,
+            ],
+          },
+        ]);
+        yield* serverControl("start");
+        for (const account of accounts)
+          expect(
+            (yield* api.request(actors.owner, "PUT", `${poolPath}/accounts/app/openai/${account}`))
+              .status,
+          ).toBe(200);
+        const membership = () =>
+          api.request(actors.owner, "GET", `${poolPath}/accounts/app`).pipe(
+            Effect.flatMap((response) =>
+              body(Schema.Array(Schema.Struct({ account: Resource })), response),
+            ),
+            Effect.map((rows) => rows.map((entry) => entry.account.id).sort()),
+          );
+        const before = yield* membership();
+        expect(before).toEqual([...accounts].sort());
+
+        yield* browser.login(actors.owner);
+        yield* openThroughBrowser(
+          "Open the pool's accounts",
+          `/org/${actors.organization.slug}/apps/${pool}?view=accounts`,
+        );
+        yield* browser.use("The shared account asks which provider app", (page) =>
+          chooser(page, shared).waitFor(),
+        );
+        expect(
+          yield* browser.use("The proven lone holder needs no choice", (page) =>
+            Promise.all([
+              chooser(page, lone).count(),
+              row(page, lone)
+                .getByText(/^Details from/)
+                .count(),
+            ]),
+          ),
+        ).toEqual([0, 0]);
+        yield* browser.checkpoint("Only the ambiguous account offers a provider app choice");
+
+        // A refused pick says so and claims nothing; the row is busy only while it runs.
+        const sourcePaths = [actors.organization.slug, actors.organization.id].map(
+          (organization) =>
+            `/api/organizations/${organization}/apps/${pool}/accounts/app/openai/${sharedAccount}/source`,
+        );
+        const refused = yield* holdQuery(sourcePaths, "fail", { method: "PUT" });
+        const pick = (page: Page, name: string) =>
+          chooser(page, shared)
+            .focus()
+            .then(() => page.keyboard.press("Enter"))
+            .then(() => page.getByRole("menuitemradio", { name, exact: true }).waitFor())
+            .then(() => page.getByRole("menuitemradio", { name, exact: true }).focus())
+            .then(() => page.keyboard.press("Enter"));
+        yield* browser.use("Pick the long-named app with the keyboard", (page) =>
+          pick(page, secondApp),
+        );
+        yield* refused.requested;
+        expect(
+          yield* browser.use("The row is busy and the choice waits", (page) =>
+            Promise.all([
+              row(page, shared).getAttribute("aria-busy"),
+              chooser(page, shared).isDisabled(),
+            ]),
+          ),
+        ).toEqual(["true", true]);
+        yield* refused.release;
+        yield* browser.use("The refused pick leaves the choice open", (page) =>
+          row(page, shared).and(page.locator('[aria-busy="false"]')).waitFor(),
+        );
+        expect(
+          yield* browser.use("Nothing claims the refused app", (page) =>
+            Promise.all([
+              chooser(page, shared).isEnabled(),
+              row(page, shared).getByText(`Details from ${secondApp}`).count(),
+            ]),
+          ),
+        ).toEqual([true, 0]);
+        yield* browser.checkpoint("A refused provider app pick is reported, not shown as chosen");
+
+        yield* browser.use("Pick the long-named app again", (page) => pick(page, secondApp));
+        yield* browser.use("The row names the chosen app", (page) =>
+          page
+            .getByRole("button", {
+              name: `Details from ${secondApp}. Choose provider app for ${shared}`,
+              exact: true,
+            })
+            .waitFor(),
+        );
+        expect(yield* membership(), "choosing a source never changes membership").toEqual(before);
+        yield* browser.checkpoint("The chosen provider app is named on the row");
+
+        const narrow = yield* browser.use("Check the chosen row at phone width", (page) =>
+          page
+            .setViewportSize({ width: 390, height: 900 })
+            .then(() => page.reload())
+            .then(() =>
+              page
+                .getByRole("button", {
+                  name: `Details from ${secondApp}. Choose provider app for ${shared}`,
+                })
+                .waitFor(),
+            )
+            .then(() =>
+              page.evaluate(() => ({
+                page: document.documentElement.scrollWidth <= window.innerWidth,
+                trigger: [...document.querySelectorAll<HTMLElement>("[data-account-source]")].every(
+                  (trigger) => trigger.getBoundingClientRect().right <= window.innerWidth,
+                ),
+                target: [...document.querySelectorAll<HTMLElement>("[data-account-source]")].every(
+                  (trigger) => trigger.getBoundingClientRect().height >= 44,
+                ),
+              })),
+            ),
+        );
+        expect(narrow, "the chooser fits a phone and keeps a touch-sized target").toEqual({
+          page: true,
+          trigger: true,
+          target: true,
+        });
+        yield* browser.checkpoint("The provider app choice fits a phone");
+        yield* browser.use("Restore the desktop width", (page) =>
+          page.setViewportSize({ width: 1280, height: 900 }),
+        );
+      }),
+    ),
+  );
+});
diff --git a/e2e/tests/pool-provider-native-presentation.spec.ts b/e2e/tests/pool-provider-native-presentation.spec.ts
new file mode 100644
index 0000000..c5e908c
--- /dev/null
+++ b/e2e/tests/pool-provider-native-presentation.spec.ts
@@ -0,0 +1,402 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, FileSystem, Path, Schema } from "effect";
+import { randomUUID } from "node:crypto";
+import { Actors } from "../support/actors.ts";
+import { Api, body, type Session } from "../support/api.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { PoolSeedApp, PoolSeedFiles } from "../support/pool-seed.ts";
+import { providerAccountProduct } from "../support/provider-account-product.ts";
+import { providerAppsCatalog } from "../support/provider-apps-catalog.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Native = Schema.Struct({
+  state: Schema.String,
+  account: Resource,
+  sourceApp: Schema.optionalKey(
+    Schema.Struct({
+      id: Schema.String,
+      version: Schema.String,
+      icons: Schema.optionalKey(Schema.Array(Schema.Json)),
+    }),
+  ),
+  canInspect: Schema.optionalKey(Schema.Boolean),
+  observations: Schema.optionalKey(
+    Schema.NullOr(Schema.Struct({ account: Schema.String, reports: Schema.Array(Schema.Json) })),
+  ),
+});
+const PoolReply = Schema.Struct({
+  ok: Schema.Literal(true),
+  value: Schema.Struct({
+    providers: Schema.Array(
+      Schema.Struct({ id: Schema.String, icons: Schema.optionalKey(Schema.Array(Schema.Json)) }),
+    ),
+    accounts: Schema.Array(
+      Schema.Struct({
+        id: Schema.String,
+        nativeAccountId: Schema.optionalKey(Schema.NullOr(Schema.String)),
+        nativeView: Schema.optionalKey(Native),
+        plan: Schema.NullOr(Schema.String),
+        windows: Schema.Array(Schema.Json),
+        bankedResets: Schema.NullOr(Schema.Json),
+        observedAt: Schema.NullOr(Schema.String),
+        usageCredits: Schema.optionalKey(Schema.Json),
+        collection: Schema.optionalKey(Schema.Json),
+      }),
+    ),
+  }),
+});
+const Revision = Schema.Struct({ revision: Schema.String });
+
+layer(RuntimeLive, { excludeTestServices: true })("Packaged pool native presentation", (it) => {
+  it.effect(scenarios.poolProviderNativePresentation.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          home = yield* providerAppsCatalog;
+        const fs = yield* FileSystem.FileSystem,
+          path = yield* Path.Path;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const apps: string[] = [],
+          accounts: string[] = [];
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* serverControl("start");
+            for (const app of apps)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app}`);
+            for (const account of accounts)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`);
+          }).pipe(Effect.orDie),
+        );
+        yield* providerAccountProduct(home.origin, `${home.origin}/catalog/index.json`);
+        const directory = path.resolve("apps/hosted/cloud/.generated/pool-app");
+        const bundles = (yield* fs.readDirectory(directory)).filter((name) =>
+          /^pool-app-[a-f0-9]+\.json$/.test(name),
+        );
+        expect(bundles).toHaveLength(1);
+        const packaged = yield* fs
+          .readFileString(path.join(directory, bundles[0]!))
+          .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Schema.fromJsonString(PoolSeedFiles))));
+        expect(packaged.some((file) => file.path === "provider-account-view.ts")).toBe(true);
+        // Only the external backend address changes. The shipped pool query and its reuse adapter execute unchanged.
+        const poolFiles = packaged.map((file) =>
+          file.path === "deployment.ts"
+            ? {
+                ...file,
+                content: file.content.replace(
+                  /export const poolOrigin = [^;]+;/,
+                  `export const poolOrigin = ${JSON.stringify(home.origin)};`,
+                ),
+              }
+            : file,
+        );
+        expect(
+          poolFiles
+            .filter((file, index) => file.content !== packaged[index]!.content)
+            .map((file) => file.path),
+        ).toEqual(["deployment.ts"]);
+        const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: "Packaged presentation pool",
+          files: poolFiles,
+        });
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const pool = yield* body(PoolSeedApp, deployed);
+        apps.push(pool.id);
+        const poolPath = `${prefix}/apps/${pool.id}`;
+        const installed = yield* api.request(actors.owner, "POST", `${prefix}/apps/install`, {
+          entry: "provider-openai",
+          name: "Native presentation source",
+        });
+        expect(installed.status, JSON.stringify(installed.body)).toBe(200);
+        const provider = (yield* body(Resource, installed)).id;
+        apps.push(provider);
+        const providerPath = `${prefix}/apps/${provider}`;
+        const share = (appPath: string) =>
+          Effect.gen(function* () {
+            const access = yield* body(
+              Revision,
+              yield* api.request(actors.owner, "GET", `${appPath}/access`),
+            );
+            expect(
+              (yield* api.request(actors.owner, "PATCH", `${appPath}/access`, {
+                revision: access.revision,
+                audience: { kind: "everyone" },
+              })).status,
+            ).toBe(200);
+          });
+        yield* share(poolPath);
+        yield* share(providerPath);
+        const pending = yield* body(
+          Resource,
+          yield* api.request(
+            actors.owner,
+            "POST",
+            `${providerPath}/accounts/app/openai/connections`,
+            { destination: { kind: "shared", audience: { kind: "everyone" } } },
+          ),
+        );
+        const connection = `${prefix}/connections/${pending.id}/interactive`;
+        expect(
+          (yield* api.request(actors.owner, "POST", `${connection}/start`, { method: "codex" }))
+            .status,
+        ).toBe(200);
+        const connected = yield* api.request(actors.owner, "POST", `${connection}/submit`, {
+          value: "synthetic-callback",
+        });
+        expect(connected.status, JSON.stringify(connected.body)).toBe(200);
+        const account = (yield* body(Schema.Struct({ account: Resource }), connected)).account.id;
+        accounts.push(account);
+        const accountPath = `${prefix}/accounts/${account}`;
+        const owner = (yield* body(
+          Schema.Struct({ userId: Schema.String }),
+          yield* api.request(actors.owner, "GET", "/api/viewer"),
+        )).userId;
+        const token = "synthetic-public-pool-control";
+        const control = `acc_${randomUUID()}`;
+        accounts.push(control);
+        // This is the released seed's supported provisioned-control fixture, not a replacement query or service.
+        yield* legacyStorage([
+          {
+            sql: "insert into executor_accounts (id,owner,provider,method,label,encrypted_credentials,credential_generation,created_at) select $1,owner,$2,'token','Synthetic pool control',$3,1,now() from executor_apps where id = $4",
+            params: [
+              control,
+              pool.requirements.accounts.pool!.provider,
+              { sealed: { id: control, value: { token } } },
+              pool.id,
+            ],
+          },
+          {
+            sql: "insert into hosted_account_access (account_id,organization_id,creator_id,kind,personal_user_id) values ($1,$2,$3,'personal',$3)",
+            params: [control, actors.organization.id, owner],
+          },
+          {
+            sql: "insert into hosted_app_account_links (app,requirement,subject,account,linked_by) values ($1,'pool',null,$2,$3)",
+            params: [pool.id, control, owner],
+          },
+          {
+            sql: "update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb), '{basaltPools}', coalesce(metadata::jsonb -> 'basaltPools', '{}'::jsonb) || $1::jsonb)::text where id = $2",
+            params: [
+              JSON.stringify({
+                [pool.id]: {
+                  app: pool.id,
+                  version: pool.activeVersion,
+                  owner,
+                  membership: "executor-links-v1",
+                  authorization: "executor-app-v1",
+                },
+              }),
+              actors.organization.id,
+            ],
+          },
+        ]);
+        yield* serverControl("start");
+        expect(
+          (yield* api.request(actors.owner, "PUT", `${poolPath}/accounts/app/openai/${account}`))
+            .status,
+        ).toBe(200);
+        const poolBefore = (yield* api.request(actors.owner, "GET", `${poolPath}/source`)).body;
+        const at = new Date().toISOString(),
+          resetAt = new Date(Date.parse(at) + 86_400_000).toISOString();
+        const reading = (label: string, ratio: number, resets: number, observedAt: string) => ({
+          observedAt,
+          observation: {
+            offering: "subscription",
+            plan: { label, observedAt },
+            windows: [
+              {
+                id: "model-week",
+                label: "Model weekly limit",
+                scope: { kind: "model", id: "fixture-model" },
+                observedAt,
+                measure: { unit: "requests", remainingRatio: ratio },
+                period: { mode: "rolling", seconds: 604800 },
+                resetsAt: resetAt,
+              },
+            ],
+            balances: [
+              {
+                id: "banked-resets",
+                label: "Banked resets",
+                unit: "resets",
+                available: resets,
+                observedAt,
+                expiresAt: resetAt,
+              },
+            ],
+          },
+        });
+        const backendRow = {
+          id: "backend-subscription",
+          nativeAccountId: account,
+          provider: "codex",
+          label: "Copied backend label",
+          plan: "COPIED_PRIVATE_PLAN",
+          state: "active",
+          message: null,
+          windows: [
+            {
+              id: "copied-private-window",
+              label: "COPIED_PRIVATE_WINDOW",
+              remainingRatio: 0.123,
+              resetAt,
+              windowSeconds: 18000,
+              observedAt: at,
+            },
+          ],
+          observedAt: at,
+          freshness: "fresh",
+          staleAt: resetAt,
+          readingFailed: false,
+          nextReadAt: resetAt,
+          earliestResetAt: resetAt,
+          bankedResets: { available: 99, nextExpiresAt: resetAt },
+          usageCredits: { privateSentinel: "COPIED_PRIVATE_CREDITS" },
+          collection: { status: "COPIED_PRIVATE_COLLECTION", errorCode: null, lastAttemptAt: at },
+        };
+        yield* home.poolView(token, {
+          isOwner: true,
+          providers: [{ id: "codex", name: "Old backend brand" }],
+          accounts: [backendRow],
+          subscriptionAccountIds: [backendRow.id],
+        });
+        const refresh = () =>
+          api.request(actors.owner, "POST", `${accountPath}/observations/refresh`);
+        const native = () =>
+          api
+            .request(actors.owner, "GET", `${accountPath}/observations`)
+            .pipe(
+              Effect.flatMap((response) =>
+                body(Schema.Struct({ reports: Schema.Array(Schema.Json) }), response),
+              ),
+            );
+        const direct = (actor: Session = actors.owner) =>
+          api
+            .request(actor, "POST", `${providerPath}/tools/call`, {
+              tool: "accountView",
+              kind: "query",
+              input: { account },
+            })
+            .pipe(Effect.flatMap((response) => body(Native, response)));
+        const view = (actor: Session = actors.owner) =>
+          Effect.gen(function* () {
+            const response = yield* api.request(actor, "POST", `${poolPath}/tools/call`, {
+              tool: "view",
+              kind: "query",
+              input: {},
+            });
+            const parsed = yield* body(PoolReply, response);
+            return { ...parsed, raw: response.body };
+          });
+        const firstReading = reading("Native first plan", 0.8, 2, at);
+        yield* home.observation(firstReading);
+        expect((yield* refresh()).status).toBe(200);
+        const firstNative = yield* native(),
+          firstDirect = yield* direct(),
+          firstPool = yield* view();
+        expect(firstNative.reports).not.toEqual([]);
+        expect(firstDirect.observations?.reports).toEqual(firstNative.reports);
+        expect(firstPool.value.accounts[0]?.nativeView?.observations?.reports).toEqual(
+          firstNative.reports,
+        );
+        expect(firstPool.value.providers[0]?.icons).toEqual(firstDirect.sourceApp?.icons);
+        expect(firstDirect.sourceApp?.icons?.length).toBeGreaterThan(0);
+        expect(firstPool.value.accounts[0]?.nativeView?.observations?.reports).toEqual(
+          expect.arrayContaining([expect.objectContaining({ result: firstReading })]),
+        );
+
+        yield* serverControl("stop");
+        yield* serverControl("clock/advance", 200, { milliseconds: 6 * 60_000 });
+        yield* home.advance(6 * 60_000);
+        yield* serverControl("start");
+        const secondReading = reading(
+          "Native changed plan",
+          0.35,
+          1,
+          new Date(Date.parse(at) + 6 * 60_000).toISOString(),
+        );
+        yield* home.observation(secondReading);
+        expect((yield* refresh()).status).toBe(200);
+        const changedIcons = [
+          {
+            src: "https://icons.example.test/native-presentation-v2.svg",
+            mimeType: "image/svg+xml",
+            theme: "light",
+          },
+        ];
+        const providerFiles = home.sources
+          .get("openai")!
+          .files.map((file) =>
+            file.path === "index.ts"
+              ? {
+                  ...file,
+                  content: file.content.replace(
