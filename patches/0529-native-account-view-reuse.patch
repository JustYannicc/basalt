+++ b/packages/apps/src/contracts/selected-account-health.ts
@@ -0,0 +1,48 @@
+import { Schema } from "effect";
+import type { AccountHealth } from "./account-health.ts";
+import type { AccountObservationView } from "./account-observation-view.ts";
+import { AccountObservationView as RetainedObservationView } from "./protocols/account-observation-view-41.ts";
+import type { AccountCheckFailure } from "./account-check-failure.ts";
+import { AccountHealthJson } from "./protocols/account-health-41.ts";
+
+const selectedFailure = (failure: AccountCheckFailure) => {
+  const { tag, ...detail } = failure;
+  return {
+    ...detail,
+    tag: tag === "FrameworkProvenanceRefused" ? "RuntimeBuildUnavailable" : tag,
+  };
+};
+const selectedCheck = <A extends { readonly failure?: AccountCheckFailure }>(check: A) => ({
+  ...check,
+  ...(check.failure === undefined ? {} : { failure: selectedFailure(check.failure) }),
+});
+
+/** Native diagnostics stay exact; retained selected-account readers keep their accepted tags. */
+export const encodeSelectedAccountHealth = (health: AccountHealth) =>
+  Schema.encodeUnknownEffect(AccountHealthJson)({
+    ...health,
+    apps: health.apps.map((app) => ({
+      ...app,
+      check: app.check === null ? null : selectedCheck(app.check),
+    })),
+    ...(health.driver === undefined
+      ? {}
+      : {
+          driver: {
+            ...health.driver,
+            check: health.driver.check === null ? null : selectedCheck(health.driver.check),
+          },
+        }),
+  });
+
+/** The same retained diagnostic vocabulary applies to failed observation attempts. */
+export const selectedAccountObservations = (view: AccountObservationView | null) =>
+  view === null
+    ? null
+    : Schema.decodeUnknownSync(RetainedObservationView)({
+        ...view,
+        reports: view.reports.map((report) => ({
+          ...report,
+          lastAttempt: report.lastAttempt === null ? null : selectedCheck(report.lastAttempt),
+        })),
+      });
