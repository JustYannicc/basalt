diff --git a/e2e/tests/pool-account-source-bindings.spec.ts b/e2e/tests/pool-account-source-bindings.spec.ts
new file mode 100644
index 0000000..8f565ab
--- /dev/null
+++ b/e2e/tests/pool-account-source-bindings.spec.ts
@@ -0,0 +1,368 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body, type Session } from "../support/api.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { providerAccountProduct } from "../support/provider-account-product.ts";
+import { providerAppsCatalog } from "../support/provider-apps-catalog.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Connection = Schema.Struct({
+  id: Schema.String,
+  target: Schema.String,
+  dependency: Schema.String,
+  scope: Schema.String,
+  revision: Schema.Int,
+  enabled: Schema.Boolean,
+});
+const Connections = Schema.Struct({ connections: Schema.Array(Connection) });
+const Source = Schema.Struct({
+  app: Schema.String,
+  version: Schema.String,
+  scope: Schema.Literal("app"),
+  requirement: Schema.String,
+});
+const Native = Schema.Struct({
+  state: Schema.Literal("available"),
+  account: Schema.Struct({ id: Schema.String, label: Schema.String }),
+  sourceConnection: Schema.optionalKey(
+    Schema.Struct({ connection: Schema.String, target: Schema.String, account: Schema.String }),
+  ),
+});
+const View = Schema.Struct({
+  selected: Schema.Array(Schema.String),
+  native: Native,
+  reused: Schema.NullOr(
+    Schema.Struct({
+      account: Resource,
+      sourceApp: Schema.Struct({ id: Schema.String, version: Schema.String }),
+    }),
+  ),
+});
+
+const poolSource = (
+  connected: boolean,
+) => `import { defineApp, query, object, string, json, router } from "apps";
+import {providers} from "./providers.ts";
+const view = query({input:object({account:string()})}, async(ctx,input) => {
+  const selected=ctx.app.accounts.openai;
+  const account=selected.find(account=>account.id===input.account);
+  if(!account) throw new Error("Account is not selected");
+  const native=await account.read();
+  let reused=null;
+  if(native.state==="available" && native.sourceConnection) {
+    const source=native.sourceConnection;
+    reused=await ctx.apps.call({connection:source.connection,target:source.target,tool:"accountView",kind:"query",input:{account:source.account}});
+  }
+  return {selected:selected.map(account=>account.id),native,reused};
+});
+const forward=query({input:object({target:string(),tool:string(),payload:json()})},async(ctx,input)=>ctx.apps.call({connection:"accountView",target:input.target,tool:input.tool,kind:"query",input:input.payload}));
+export default defineApp({app:{accounts:{openai:providers.openai.many().requiring("model-inference").contributed()}},${connected ? 'dependencies:{accountView:{scope:"app",cardinality:"many",tools:{accountView:{kind:"query"}}}},' : ""}},{tools:router({view,forward})});`;
+
+layer(RuntimeLive, { excludeTestServices: true })("Pool account sources", (it) => {
+  it.effect(scenarios.poolAccountSourceBindings.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          catalog = yield* providerAppsCatalog;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const apps: string[] = [],
+          accounts: string[] = [];
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* serverControl("start");
+            for (const app of apps)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app}`);
+            for (const account of accounts)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`);
+          }).pipe(Effect.orDie),
+        );
+        yield* providerAccountProduct(catalog.origin, `${catalog.origin}/catalog/index.json`);
+        const canonical = catalog.sources
+          .get("openai")!
+          .files.find((file) => file.path === "providers.ts")!;
+        const files = (connected: boolean) => [
+          appsManifest,
+          canonical,
+          { path: "index.ts", content: poolSource(connected) },
+        ];
+        const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: "Source binding pool",
+          files: files(false),
+        });
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const pool = (yield* body(Resource, deployed)).id;
+        apps.push(pool);
+        const poolPath = `${prefix}/apps/${pool}`;
+        const share = (app: string, actor: Session = actors.owner) =>
+          Effect.gen(function* () {
+            const access = yield* body(
+              Schema.Struct({ revision: Schema.String }),
+              yield* api.request(actor, "GET", `${prefix}/apps/${app}/access`),
+            );
+            expect(
+              (yield* api.request(actor, "PATCH", `${prefix}/apps/${app}/access`, {
+                revision: access.revision,
+                audience: { kind: "everyone" },
+              })).status,
+            ).toBe(200);
+          });
+        yield* share(pool);
+        const sourceApps: string[] = [];
+        for (const name of ["First exact provider", "Second exact provider"]) {
+          const installed = yield* api.request(actors.member, "POST", `${prefix}/apps/install`, {
+            entry: "provider-openai",
+            name,
+            newInstance: true,
+          });
+          expect(installed.status, JSON.stringify(installed.body)).toBe(200);
+          const source = (yield* body(Resource, installed)).id;
+          sourceApps.push(source);
+          apps.push(source);
+          yield* share(source, actors.member);
+        }
+        const first = sourceApps[0]!,
+          second = sourceApps[1]!;
+        const providerPath = (app: string) => `${prefix}/apps/${app}/accounts/app/openai`;
+        for (const [index, label] of [
+          "First account",
+          "Second account",
+          "Ambiguous account",
+        ].entries()) {
+          const provider = index === 1 ? second : first;
+          const created = yield* api.request(actors.member, "POST", providerPath(provider), {
+            creation: crypto.randomUUID(),
+            method: "apiKey",
+            label,
+            fields: { token: `synthetic-source-${index}` },
+          });
+          expect(created.status, JSON.stringify(created.body)).toBe(200);
+          const account = (yield* body(Resource, created)).id;
+          accounts.push(account);
+          expect(
+            (yield* api.request(actors.member, "PUT", `${providerPath(provider)}/${account}`))
+              .status,
+          ).toBe(200);
+        }
+        const a = accounts[0]!,
+          b = accounts[1]!,
+          ambiguous = accounts[2]!;
+        expect(
+          (yield* api.request(actors.member, "PUT", `${providerPath(second)}/${ambiguous}`)).status,
+        ).toBe(200);
+        yield* serverControl("stop");
+        yield* legacyStorage([
+          {
+            sql: `update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb), '{basaltPools}', coalesce(metadata::jsonb -> 'basaltPools', '{}'::jsonb) || $1::jsonb)::text where id = $2`,
+            params: [
+              JSON.stringify({
+                [pool]: {
+                  app: pool,
+                  membership: "executor-links-v1",
+                  authorization: "executor-app-v1",
+                },
+              }),
+              actors.organization.id,
+            ],
+          },
+        ]);
+        yield* serverControl("start");
+        for (const account of accounts)
+          expect(
+            (yield* api.request(actors.member, "PUT", `${poolPath}/accounts/app/openai/${account}`))
+              .status,
+          ).toBe(200);
+        const nativeIds = () =>
+          api.request(actors.member, "GET", `${poolPath}/accounts/app`).pipe(
+            Effect.flatMap((response) =>
+              body(Schema.Array(Schema.Struct({ account: Resource })), response),
+            ),
+            Effect.map((rows) => rows.map((row) => row.account.id).sort()),
+          );
+        const membership = yield* nativeIds();
+        expect(membership).toEqual([...accounts].sort());
+        const mirrors = yield* catalog.mirrors;
+        const upgraded = yield* api.request(actors.owner, "POST", `${poolPath}/deploy`, {
+          files: files(true),
+        });
+        expect(upgraded.status, JSON.stringify(upgraded.body)).toBe(200);
+        const view = (account: string) =>
+          api
+            .request(actors.member, "POST", `${poolPath}/tools/call`, {
+              tool: "view",
+              kind: "query",
+              input: { account },
+            })
+            .pipe(Effect.flatMap((response) => body(View, response)));
+        const connections = () =>
+          api.request(actors.member, "GET", `${poolPath}/connections`).pipe(
+            Effect.flatMap((response) => body(Connections, response)),
+            Effect.map((response) => response.connections),
+          );
+        const source = (app: string) =>
+          api.request(actors.member, "GET", `${prefix}/apps/${app}`).pipe(
+            Effect.flatMap((response) =>
+              body(Schema.Struct({ activeVersion: Schema.String }), response),
+            ),
+            Effect.map((appVersion) =>
+              Source.make({
+                app,
+                version: appVersion.activeVersion,
+                scope: "app",
+                requirement: "openai",
+              }),
+            ),
+          );
+        const choose = (account: string, selected: typeof Source.Type) =>
+          api.request(
+            actors.member,
+            "PUT",
+            `${poolPath}/accounts/app/openai/${account}/source`,
+            selected,
+          );
+
+        // Direct first query prepares old selections, while two holding instances stay ambiguous.
+        const firstView = yield* view(a),
+          secondView = yield* view(b),
+          fallback = yield* view(ambiguous);
+        expect(firstView.reused?.sourceApp.id).toBe(first);
+        expect(secondView.reused?.sourceApp.id).toBe(second);
+        expect(fallback.native.account).toMatchObject({
+          id: ambiguous,
+          label: "Ambiguous account",
+        });
+        expect(fallback.native.sourceConnection).toBeUndefined();
+        expect(fallback.reused).toBeNull();
+        expect((yield* connections()).map((connection) => connection.target).sort()).toEqual(
+          [first, second].sort(),
+        );
+        expect(yield* nativeIds()).toEqual(membership);
+        expect(yield* catalog.mirrors).toEqual(mirrors);
+        expect(
+          (yield* api.request(actors.member, "PUT", `${poolPath}/connections/accountView`, {
+            scope: "app",
+            target: first,
+            revision: 0,
+          })).status,
+        ).toBe(403);
+        for (const [tool, payload] of [
+          ["otherTool", { account: a }],
+          ["accountView", { account: ambiguous }],
+          ["accountView", { account: a, extra: true }],
+        ] as const) {
+          const refused = yield* api.request(actors.member, "POST", `${poolPath}/tools/call`, {
+            tool: "forward",
+            kind: "query",
+            input: { target: first, tool, payload },
+          });
+          expect(refused.status).not.toBe(200);
+        }
+        const beforeRevocation = (yield* connections()).find(
+          (connection) => connection.target === first,
+        )!;
+        expect(
+          (yield* api.request(
+            actors.owner,
+            "DELETE",
+            `${poolPath}/connections/accountView?scope=app&target=${encodeURIComponent(first)}&revision=${beforeRevocation.revision}`,
+          )).status,
+        ).toBe(200);
+        expect(
+          (yield* api.request(actors.member, "GET", `${poolPath}/accounts/app/openai`)).status,
+        ).toBe(200);
+        expect((yield* view(a)).native.sourceConnection).toBeUndefined();
+        expect(
+          (yield* connections()).find((connection) => connection.target === first),
+        ).toMatchObject({ id: beforeRevocation.id, enabled: false });
+        expect(yield* nativeIds()).toEqual(membership);
+        expect(yield* catalog.mirrors).toEqual(mirrors);
+
+        // Explicitly choosing another account cannot restore authority for the revoked account.
+        expect((yield* choose(ambiguous, yield* source(first))).status).toBe(200);
+        expect((yield* view(ambiguous)).reused?.sourceApp.id).toBe(first);
+        expect((yield* view(a)).native.sourceConnection).toBeUndefined();
+        expect((yield* view(b)).reused?.sourceApp.id).toBe(second);
+        expect(
+          (yield* api.request(actors.member, "DELETE", `${poolPath}/accounts/app/openai/${a}`))
+            .status,
+        ).toBe(200);
+        expect((yield* choose(a, yield* source(first))).status).toBe(200);
+        expect((yield* view(a)).reused?.sourceApp.id).toBe(first);
+        expect(yield* nativeIds()).toEqual(membership);
+
+        const oldSource = yield* source(first);
+        const providerFiles = catalog.sources.get("openai")!.files;
+        const changed = yield* api.request(
+          actors.member,
+          "POST",
+          `${prefix}/apps/${first}/deploy`,
+          {
+            files: providerFiles.map((file) =>
+              file.path === "index.ts"
+                ? { ...file, content: `${file.content}\n// Exact source version fixture\n` }
+                : file,
+            ),
+          },
+        );
+        expect(changed.status, JSON.stringify(changed.body)).toBe(200);
+        const newSource = yield* source(first);
+        expect(newSource.version).not.toBe(oldSource.version);
+        expect((yield* choose(a, oldSource)).status).toBe(409);
+        expect((yield* view(a)).reused?.sourceApp).toMatchObject({
+          id: first,
+          version: newSource.version,
+        });
+        const currentBinding = (yield* connections()).find(
+          (connection) => connection.target === first,
+        )!;
+        const stale = yield* api.request(
+          actors.owner,
+          "PATCH",
+          `${poolPath}/connections/accountView`,
+          { scope: "app", target: first, revision: beforeRevocation.revision, enabled: false },
+        );
+        expect(stale.status).toBe(409);
+        expect((yield* connections()).find((connection) => connection.target === first)).toEqual(
+          currentBinding,
+        );
+        expect(yield* nativeIds()).toEqual(membership);
+        expect(yield* catalog.mirrors).toEqual(mirrors);
+
+        expect(
+          (yield* api.request(actors.member, "DELETE", `${providerPath(first)}/${a}`)).status,
+        ).toBe(200);
+        expect((yield* view(a)).native.sourceConnection).toBeUndefined();
+        expect(yield* nativeIds()).toEqual(membership);
+        expect(yield* catalog.mirrors).toEqual(mirrors);
+
+        // Removing an unavailable source still records revocation, without choosing another holder.
+        const unavailableBinding = (yield* connections()).find(
+          (connection) => connection.target === first,
+        )!;
+        expect((yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${first}`)).status).toBe(
+          200,
+        );
+        expect(
+          (yield* api.request(
+            actors.owner,
+            "DELETE",
+            `${poolPath}/connections/accountView?scope=app&target=${encodeURIComponent(first)}&revision=${unavailableBinding.revision}`,
+          )).status,
+        ).toBe(200);
+        expect((yield* view(ambiguous)).native.sourceConnection).toBeUndefined();
+        expect(
+          (yield* connections()).find((connection) => connection.target === first)?.enabled,
+        ).toBe(false);
+        expect(yield* nativeIds()).toEqual(membership);
+        expect(yield* catalog.mirrors).toEqual(mirrors);
+      }),
+    ),
+  );
+});
