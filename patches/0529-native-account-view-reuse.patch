+import type { AppIcons } from "../contracts/icons.ts";
+
+/** The authored image to render in each color scheme, after applying the declared fallbacks. */
+export interface AppIconSources {
+  readonly light: string;
+  readonly dark: string;
+}
+
+/** The declared variant for each scheme, then an unthemed icon, then the first. */
+export const themedAppIconSources = (
+  icons: readonly { readonly src: string; readonly theme?: "light" | "dark" }[],
+): AppIconSources | null => {
+  const pick = (theme: "light" | "dark") =>
+    (
+      icons.find((icon) => icon.theme === theme) ??
+      icons.find((icon) => icon.theme === undefined) ??
+      icons[0]
+    )?.src;
+  const light = pick("light"),
+    dark = pick("dark");
+  return light === undefined || dark === undefined ? null : { light, dark };
+};
+
+/** Load authored images through an image element; only image data and HTTPS are accepted. */
+export const appIconSources = (icons: AppIcons | undefined): AppIconSources | null =>
+  themedAppIconSources(
+    (icons ?? []).filter(
+      ({ src }) =>
+        /^data:image\/(?:svg\+xml|png|webp|jpeg)[;,]/u.test(src) ||
+        (URL.canParse(src) && new URL(src).protocol === "https:"),
+    ),
+  );
