+import type { AccountObservation } from "../contracts/account-observation.ts";
+
+/** Reported reset balances that have not expired, retaining every source field. */
+export const availableResetBalances = (
+  observation: Pick<AccountObservation, "balances">,
+  now: number,
+) =>
+  observation.balances.filter(
+    (balance) =>
