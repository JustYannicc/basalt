+              kind: "tools",
+              approval: "client",
+              apps: [
+                {
+                  app: callerApp.id,
+                  tools: { kind: "selected", names: ["invoke"] },
+                  targets: [{ kind: "app" }],
+                },
+              ],
+            },
+          })).status,
+        ).toBe(200);
+        const limitedRead = yield* executeRead(
+          ownerMcp,
+          "The same bearer cannot inspect an app omitted by its narrowed grant",
+        );
+        expect(limitedRead).toEqual({ state: "denied", account: { id: f.account } });
+        expect(yield* f.backend.calls).toBe(2);
+
+        const accountAccess = yield* body(
+          Revision,
+          yield* api.request(f.actors.owner, "GET", `${f.accountPath}/access`),
+        );
+        const privateAccount = yield* api.request(
+          f.actors.owner,
+          "PATCH",
+          `${f.accountPath}/access`,
+          { revision: accountAccess.revision, audience: { kind: "groups", groups: [] } },
+        );
+        expect(privateAccount.status, JSON.stringify(privateAccount.body)).toBe(200);
+        const metadataDenied = yield* api.request(
+          f.actors.member,
+          "POST",
+          `${callerPath}/tools/call`,
+          { tool: "invoke", kind: "query", input: { account: f.account, target: f.app.id } },
+        );
+        // Revoking account use refuses target admission before its selected-account read runs.
+        expect(metadataDenied.status, JSON.stringify(metadataDenied.body)).toBe(502);
+        expect(metadataDenied.body).toMatchObject({
+          _tag: "ToolCallFailed",
+          failure: { errorName: "AppCallFailed", code: "denied" },
+        });
+        expect(JSON.stringify(metadataDenied.body)).not.toContain("Private identity");
+        expect(JSON.stringify(metadataDenied.body)).not.toContain("Private allowance");
+        expect(yield* f.backend.calls).toBe(2);
+        const restoredAccess = yield* body(Revision, privateAccount);
+        expect(
+          (yield* api.request(f.actors.owner, "PATCH", `${f.accountPath}/access`, {
+            revision: restoredAccess.revision,
+            audience: { kind: "everyone" },
+          })).status,
+        ).toBe(200);
+
+        const access = yield* body(
+          Revision,
+          yield* api.request(f.actors.owner, "GET", `${f.accountPath}/observations/access`),
+        );
+        expect(
+          (yield* api.request(f.actors.owner, "PUT", `${f.accountPath}/observations/access`, {
+            revision: access.revision,
+            read: { kind: "everyone" },
+            refresh: { kind: "owners" },
+          })).status,
+        ).toBe(200);
+        const visible = yield* body(Selected, yield* call(f.actors.member));
+        expect(visible.canInspect).toBe(true);
+        expect(visible.observations?.reports).toEqual(native.reports);
+
+        const launched = yield* api.request(f.actors.owner, "POST", `${f.appPath}/tools/call`, {
+          tool: "launch",
+          kind: "mutation",
+          input: {},
+        });
+        expect(launched.status, JSON.stringify(launched.body)).toBe(200);
+        const background = yield* body(
+          Schema.Struct({ interactive: Selected, run: Schema.String }),
+          launched,
+        );
+        expect(background.interactive).toMatchObject({ state: "available", canInspect: true });
+        expect(background.interactive.observations?.reports).toEqual(native.reports);
+        yield* Effect.addFinalizer(() =>
+          api
+            .request(
+              f.actors.owner,
+              "POST",
+              `${f.appPath}/workflow-runs/${background.run}/terminate`,
+            )
+            .pipe(Effect.orDie),
+        );
+        const completed = yield* api
+          .request(f.actors.owner, "GET", `${f.appPath}/workflow-runs/${background.run}`)
+          .pipe(
+            Effect.flatMap((response) => {
+              expect(response.status, JSON.stringify(response.body)).toBe(200);
+              return body(WorkflowRun, response);
+            }),
+            Effect.repeat({
+              while: (run) => run.status === "queued" || run.status === "running",
+              schedule: Schedule.spaced("100 millis"),
+            }),
+            Effect.timeout("20 seconds"),
+          );
+        expect(completed.status, JSON.stringify(completed)).toBe("complete");
+        expect(completed.output).toEqual({ state: "denied", account: { id: f.account } });
+        expect(yield* f.backend.calls).toBe(2);
+
+        const held = yield* f.backend.hold;
+        const pending = yield* call(f.actors.owner, "hold").pipe(Effect.forkChild);
+        yield* held.entered;
+        yield* unlinkAccount(f.actors.owner, f.appPath, "service", f.account);
+        yield* held.release;
+        const stale = yield* Fiber.join(pending);
+        expect(stale.status, JSON.stringify(stale.body)).not.toBe(200);
+        expect(JSON.stringify(stale.body)).not.toContain("Developer");
+      }).pipe(Effect.provide(McpClient.layer)),
+    ),
+  );
+});
