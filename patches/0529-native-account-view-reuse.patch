+        expect(deniedDirect).toMatchObject({
+          state: "available",
+          canInspect: false,
+          observations: null,
+        });
+        expect(deniedPool.value.accounts[0]?.nativeView).toMatchObject({
+          state: "available",
+          canInspect: false,
+          observations: null,
+        });
+        expect(deniedPool.value.accounts[0]).toMatchObject({
