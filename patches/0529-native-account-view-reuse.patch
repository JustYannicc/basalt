+++ b/packages/apps/src/contracts/account-check-failure.ts
@@ -0,0 +1,83 @@
+import { Schema } from "effect";
+import { AccountObservationInstant } from "./account-observation.ts";
+import {
+  OAuthFailureCause,
+  OAuthProviderErrorCode,
+  OAuthResponseField,
+  OAuthRenewalReason,
+} from "./oauth-failure-evidence.ts";
+
+export const OAuthCheckEvidence = /* @__PURE__ */ (() =>
+  Schema.Struct({
+    reason: Schema.optionalKey(OAuthRenewalReason),
+    cause: Schema.optionalKey(
+      Schema.Struct({
+        stage: OAuthFailureCause.fields.stage,
+        status: Schema.optionalKey(Schema.Int),
+        providerError: Schema.optionalKey(OAuthProviderErrorCode),
+        field: Schema.optionalKey(OAuthResponseField),
+      }),
+    ),
+  }))();
+
+const detailReason = Schema.Literals([
+  "unauthorized",
+  "forbidden",
+  "rate_limited",
+  "unavailable",
+  "rejected",
+  "invalid_response",
+  "timed_out",
+]);
+export const AccountFailureDetail = Schema.Struct({
+  source: Schema.Literals(["provider", "home", "transport"]),
+  reason: detailReason,
+  status: Schema.optionalKey(Schema.Int.check(Schema.isBetween({ minimum: 100, maximum: 599 }))),
+  parserStage: Schema.optionalKey(
+    Schema.Literals([
+      "monthly_decode",
+      "weekly_decode",
+      "missing_amount",
+      "profile_entitlement",
+      "unknown",
+    ]),
+  ),
+  occurredAt: AccountObservationInstant,
+}).check(
+  Schema.makeFilter((detail) => detail.source === "provider" || detail.status === undefined),
+  Schema.makeFilter(
+    (detail) =>
+      detail.parserStage === undefined ||
+      (detail.source === "provider" && detail.reason === "invalid_response"),
+  ),
+);
+export type AccountFailureDetail = typeof AccountFailureDetail.Type;
+
+/** Closed host diagnostics; app text and vendor responses never enter this record. */
+export const AccountCheckFailure = /* @__PURE__ */ (() =>
+  Schema.Struct({
+    detail: Schema.optionalKey(AccountFailureDetail),
+    oauthRenewal: Schema.optionalKey(OAuthCheckEvidence),
+    phase: Schema.Literals(["invoke", "app-threw", "timeout", "decode", "vendor"]),
+    tag: Schema.Literals([
+      "RuntimeBuildUnavailable",
+      "RuntimeProtocolFailed",
+      "RuntimeProtocolUnsupported",
+      "HostRequestInvalid",
+      "HostDeclarationInvalid",
+      "HostAccountsInvalid",
+      "HostOperationNotFound",
+      "HostOperationFailed",
+      "HostOutputInvalid",
+      "WorkflowFailure",
+      "ProviderError",
+      "AccountSourceFailure",
+      "OAuthReconnectRequired",
+      "OAuthRenewalFailed",
+      "AccountAcquisitionUnavailable",
+      "TimeoutError",
+      "SchemaError",
+      "Unknown",
+    ]),
+  }))();
+export type AccountCheckFailure = typeof AccountCheckFailure.Type;
diff --git a/packages/apps/src/contracts/account-health.ts b/packages/apps/src/contracts/account-health.ts
new file mode 100644
index 0000000..b737069
--- /dev/null
+++ b/packages/apps/src/contracts/account-health.ts
@@ -0,0 +1,111 @@
+import { Schema } from "effect";
+import { AccountCheckFailure } from "./account-check-failure.ts";
+import { AccountId, AppId } from "./schema.ts";
+import { AccountStatus } from "./account-status.ts";
+import { AccountInfo } from "./provider.ts";
+import { ProviderError } from "./provider-error.ts";
+
+/**
+ * The outcome of one app's check of an account. Only `credentials_rejected` means the saved
+ * credentials were refused; `check_failed` means the check could not verify the account, such as a
+ * timeout or a failure in the app's check. `tools_unavailable` means the credentials passed but the
+ * app's tools did not load for this account, at the check or at agents' last tool discovery.
+ */
+export const AccountCheckStatus = /* @__PURE__ */ (() =>
+  Schema.Literals([
+    "healthy",
+    "credentials_rejected",
+    "forbidden",
+    "upstream_unavailable",
+    "check_failed",
+    "tools_unavailable",
+  ]))();
+export type AccountCheckStatus = typeof AccountCheckStatus.Type;
+
+/** One app that uses the account, and its latest check. */
+const AccountAppCheck = Schema.Struct({
+  status: AccountCheckStatus,
+  reason: Schema.optionalKey(ProviderError.fields.reason),
+  failure: Schema.optionalKey(AccountCheckFailure),
+  checkedAt: Schema.Date,
+  /** Public display data from this check only; outdated results remain marked outdated. */
+  displayStatus: Schema.optionalKey(AccountStatus),
+  current: Schema.Boolean,
+  /** Why the check failed, as the app or host explained it. Absent when it gave no reason. */
+  message: Schema.optionalKey(Schema.String),
+});
+
+export const AccountAppHealth = /* @__PURE__ */ (() =>
+  Schema.Struct({
+    app: AppId,
+    /** The app's active version defines a check for this account's provider. */
+    checkable: Schema.Boolean,
+    /**
+     * The app's latest check. It is not `current` once the account's credentials or the app's
+     * active version changed after it ran; recheck before relying on it.
+     */
+    check: Schema.NullOr(AccountAppCheck),
+  }))();
+export type AccountAppHealth = typeof AccountAppHealth.Type;
+
+/**
+ * Checks of an account by the apps that use it, as the product names them. An account no app uses
+ * has no app checks; a bound acquisition driver can report its own check.
+ * `info` is the upstream identity from the most recent passing check that reported one; it is
+ * kept when later checks fail. It never replaces the account's own label.
+ */
+const AccountDriverCheck = Schema.Struct({
+  status: AccountCheckStatus,
+  reason: Schema.optionalKey(ProviderError.fields.reason),
+  failure: Schema.optionalKey(AccountCheckFailure),
+  checkedAt: Schema.Date,
+  current: Schema.Boolean,
+  message: Schema.optionalKey(Schema.String.check(Schema.isMaxLength(500))),
+});
+
+export const AccountDriverHealth = /* @__PURE__ */ (() =>
+  Schema.Struct({
+    source: Schema.Struct({
+      kind: Schema.Literal("driver"),
+      id: Schema.NonEmptyString,
+      version: Schema.NonEmptyString,
+    }),
+    /** The retained driver for this binding currently implements a credential check. */
+    checkable: Schema.Boolean,
+    check: Schema.NullOr(AccountDriverCheck),
+  }))();
+export type AccountDriverHealth = typeof AccountDriverHealth.Type;
+
+export const AccountHealth = /* @__PURE__ */ (() =>
+  Schema.Struct({
+    account: AccountId,
+    info: Schema.NullOr(AccountInfo),
+    infoCheckedAt: Schema.NullOr(Schema.Date),
+    /** A host removed this account's credentials after its service reported the account closed. */
+    personalDataStatus: Schema.optionalKey(Schema.Literal("account_closed")),
+    apps: Schema.Array(AccountAppHealth),
+    driver: Schema.optionalKey(AccountDriverHealth),
+  }))();
+export type AccountHealth = typeof AccountHealth.Type;
+
+/** Same native health fields with ISO timestamps for app JSON output. */
+export const AccountHealthJson = Schema.Struct({
+  ...AccountHealth.fields,
+  infoCheckedAt: Schema.NullOr(Schema.DateFromString),
+  apps: Schema.Array(
+    Schema.Struct({
+      ...AccountAppHealth.fields,
+      check: Schema.NullOr(
+        Schema.Struct({ ...AccountAppCheck.fields, checkedAt: Schema.DateFromString }),
+      ),
+    }),
+  ),
+  driver: Schema.optionalKey(
+    Schema.Struct({
+      ...AccountDriverHealth.fields,
+      check: Schema.NullOr(
+        Schema.Struct({ ...AccountDriverCheck.fields, checkedAt: Schema.DateFromString }),
+      ),
+    }),
+  ),
+});
