+import { Deferred, Effect, FileSystem, Queue, Schema, Stream } from "effect";
+import type { ChildProcessSpawner } from "effect/process";
+import { isAlchemyDevFailure, outputLines } from "./alchemy-dev-output.ts";
+
+export class CloudStartFailed extends Schema.TaggedError<CloudStartFailed>()("CloudStartFailed", {
+  operation: Schema.String,
+}) {
+  get message() {
+    return `Cloud test environment failed: ${this.operation}`;
+  }
+}
+
+export const cloudStartupSecrets = (
+  env: Readonly<Record<string, string | undefined>>,
+  services: Readonly<
+    Record<string, { readonly clientSecret: string } | { readonly token: string }>
+  >,
+) => [
+  ...Object.entries(env)
+    .filter(([name]) => /SECRET|TOKEN|PASSWORD|KEY/u.test(name))
+    .flatMap(([, value]) => (value === undefined ? [] : [value])),
+  ...Object.values(services).map((service) =>
+    "clientSecret" in service ? service.clientSecret : service.token,
+  ),
+];
+
+/** One reader owns both pipes, the saved log, and the failure text readiness reports. */
+export const captureCloudStartup = (
+  child: ChildProcessSpawner.ChildProcessHandle,
+  file: string,
+  secrets: ReadonlyArray<string>,
+  onLine: (line: string) => Effect.Effect<void> = () => Effect.void,
+) =>
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem;
+    const failed = yield* Deferred.make<void>();
+    const ended = yield* Deferred.make<void>();
+    const activity = yield* Queue.sliding<void>(1);
+    let diagnostic: string | undefined;
+    const redact = (line: string) => {
+      let safe = line.replace(/#pair=[a-f0-9]{64}/gu, "#pair=<redacted>");
+      for (const secret of secrets) {
+        if (secret) safe = safe.replaceAll(secret, "<redacted>");
+      }
+      return safe;
+    };
+    const activityReceived = Queue.offer(activity, undefined).pipe(Effect.asVoid);
+    yield* outputLines(child, activityReceived).pipe(
+      Stream.runForEach((raw) =>
+        Effect.gen(function* () {
+          const line = redact(raw);
+          yield* fs.writeFileString(file, `${line}\n`, { flag: "a", mode: 0o600 });
+          if (diagnostic !== undefined) diagnostic += `\n${line}`;
+          else if (isAlchemyDevFailure(line)) diagnostic = line;
+          if (diagnostic !== undefined) {
+            yield* Queue.offer(activity, undefined);
+            yield* Deferred.succeed(failed, undefined);
+          }
+          yield* onLine(line);
+        }),
+      ),
+      Effect.ensuring(Deferred.succeed(ended, undefined)),
+      Effect.forkScoped,
+    );
+    const failure = Effect.gen(function* () {
+      yield* Deferred.await(failed);
+      // Failed dev processes keep watching, so their pipes may never end. Debounce output
+      // events only after failure; a quiet 250 ms bounds that fallback without delaying readiness.
+      yield* Effect.raceFirst(
+        Deferred.await(ended),
+        Stream.fromQueue(activity).pipe(Stream.debounce("250 millis"), Stream.runHead),
+      );
+      return yield* new CloudStartFailed({
+        operation: `Alchemy could not start every Cloud resource; see cloud.log\n${diagnostic}`,
+      });
+    });
+    return {
+      failure,
+      check: Effect.suspend(() => (diagnostic === undefined ? Effect.void : failure)),
+      stopped: child.exitCode.pipe(
+        Effect.andThen(Deferred.await(ended)),
+        Effect.andThen(
+          Effect.suspend(() =>
+            diagnostic === undefined
+              ? new CloudStartFailed({ operation: "Cloud stopped before readiness; see cloud.log" })
+              : failure,
+          ),
+        ),
+      ),
+    };
+  });
