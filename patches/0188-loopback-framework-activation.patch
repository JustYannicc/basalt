+     * it for a tool its catalog does not list, and then opens storage for writing.
+     */
+    kind: Schema.optionalKey(ToolKind),
+    input: JsonValue,
+    audience: Schema.optionalKey(Schema.Literal("app")),
+    uiProfile: Schema.optionalKey(Schema.Literal(true)),
