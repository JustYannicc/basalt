+export type HostRequest = typeof HostRequest.Type;
+
+/** The dispatch request did not match the protocol. */
+export class HostRequestInvalid extends Schema.TaggedError<HostRequestInvalid>()(
+  "HostRequestInvalid",
+  {},
+) {}
