diff --git a/apps/hosted/cloud/src/infrastructure/auth-rate-limit.ts b/apps/hosted/cloud/src/infrastructure/auth-rate-limit.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/auth-rate-limit.ts
@@ -0,0 +1,58 @@
+import { RecordedMessage } from "@executor-js/utils/recorded-message";
+import { ErrorReporter, Schema } from "effect";
+import {
+  ColumnNode,
+  InsertQueryNode,
+  OnConflictNode,
+  type KyselyPlugin,
+  type QueryId,
+} from "kysely";
+
+/**
+ * Better Auth's database rate limiter inserts an address's row on its first request to a path.
+ * A skipped conflicting insert must reject so Better Auth reads the winner's row and counts
+ * this request through its native atomic increment. Returning no row would admit it uncounted.
+ */
+export class AuthRateLimitRaced extends Schema.TaggedError<AuthRateLimitRaced>()(
+  "AuthRateLimitRaced",
+  {},
+) {
+  override get message() {
+    return "Another request inserted this address's rate-limit row first; Better Auth counts against that row";
+  }
+  get [RecordedMessage]() {
+    return this.message;
+  }
+  get [ErrorReporter.ignore]() {
+    return true;
+  }
+}
+
+/** Keep normal first-request contention out of PostgreSQL's error log. */
+export const authRateLimitConflicts = (): KyselyPlugin => {
+  const inserts = new WeakSet<QueryId>();
+  return {
+    transformQuery: ({ node, queryId }) => {
+      if (
+        !InsertQueryNode.is(node) ||
+        node.into?.table.identifier.name !== "rateLimit" ||
+        node.returning === undefined ||
+        node.onConflict !== undefined ||
+        !node.columns?.some((column) => column.column.name === "key")
+      )
+        return node;
+      inserts.add(queryId);
+      return InsertQueryNode.cloneWith(node, {
+        onConflict: OnConflictNode.cloneWith(OnConflictNode.create(), {
+          columns: [ColumnNode.create("key")],
+          doNothing: true,
+        }),
+      });
+    },
+    transformResult: async ({ result, queryId }) => {
+      if (inserts.delete(queryId) && result.rows.length === 0 && result.numAffectedRows === 0n)
+        throw new AuthRateLimitRaced();
+      return result;
+    },
+  };
+};
