diff --git a/apps/hosted/web/src/contracts/obsidian-vault-name.ts b/apps/hosted/web/src/contracts/obsidian-vault-name.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/web/src/contracts/obsidian-vault-name.ts
@@ -0,0 +1,42 @@
+import { Effect, Option } from "effect";
+import type { ConnectionId } from "@executor-js/mcp-auth/connections";
+import type { OrganizationId } from "@executor-js/hosted-server/organization";
+import { HostedClient } from "./api.ts";
+import { vaultApp, vaultRename } from "./obsidian-vault-rename.ts";
+
+/**
+ * One Obsidian app is one vault, named after it. When a device connects a vault app that still
+ * has the catalog's name, name the app after the vault the device reports, exactly as the Rename
+ * button would: its slug follows the name. This happens at the vault's first connection, before
+ * much can depend on the catalog's slug. The server renames only while the app still has the
+ * catalog's name, so a name someone chose is never replaced, and it checks the approving person
+ * may manage the app. The vault name is the device's claim and
+ * decides nothing else; any failure leaves the app as it was.
+ */
+export const nameVaultAfterDeviceAtom = HostedClient.runtime.fn(
+  (input: {
+    readonly connection: ConnectionId;
+    readonly vault: string;
+    readonly organizations: readonly OrganizationId[];
+  }) =>
+    Effect.gen(function* () {
+      const client = yield* HostedClient;
+      for (const organization of input.organizations) {
+        // A person may belong to several organizations; one that can't be read is skipped.
+        const listed = yield* Effect.option(
+          client.mcpConnections.list({ params: { organization } }),
+        );
+        if (Option.isNone(listed)) continue;
+        const connections = listed.value;
+        const connection = connections.find((item) => item.id === input.connection);
+        if (connection === undefined) continue;
+        const app = vaultApp(connection);
+        if (app === undefined) return;
+        const current = yield* client.apps.get({ params: { organization, app } });
+        const payload = vaultRename(current, input.vault);
+        if (payload !== undefined)
+          yield* client.apps.rename({ params: { organization, app }, payload });
+        return;
+      }
+    }).pipe(Effect.catchCause(() => Effect.void)),
+);
diff --git a/apps/hosted/web/src/contracts/obsidian-vault-rename.ts b/apps/hosted/web/src/contracts/obsidian-vault-rename.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/web/src/contracts/obsidian-vault-rename.ts
@@ -0,0 +1,20 @@
+import type { Connection } from "@executor-js/mcp-auth/connections";
+import { isVaultConnection } from "./obsidian-devices.ts";
+
+/** The catalog entry's name for a new Obsidian app, before it is named after its vault. */
+export const obsidianDefaultName = "Obsidian";
+
+/** The vault app a device's connection was made for; nothing for any other connection. */
+export const vaultApp = (connection: Connection) => {
+  const app = connection.policy.apps[0]?.app;
+  return app !== undefined && isVaultConnection(app, connection) ? app : undefined;
+};
+
+/**
+ * How to name a vault app after the vault a device reports: only an app still named after the
+ * catalog, renamed as the Rename button does. Nothing to do for any other app.
+ */
+export const vaultRename = (app: { readonly name: string }, vault: string) =>
+  app.name === obsidianDefaultName && vault.trim().length > 0
+    ? { name: vault.trim(), expectedName: obsidianDefaultName }
+    : undefined;
