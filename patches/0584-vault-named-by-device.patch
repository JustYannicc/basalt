+/**
+ * One device-reported label as it is kept: control and formatting characters removed, spacing
+ * collapsed, at most `deviceReportLimit` characters. Nothing when nothing printable is left.
+ */
+export const deviceReportLabel = (value: string | undefined) => {
+  if (value === undefined) return undefined;
+  const label = Array.from(
+    value
