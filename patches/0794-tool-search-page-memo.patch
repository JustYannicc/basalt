new file mode 100644
index 000000000..7f40bac92
--- /dev/null
+++ b/packages/sdk/src/implementation/tool-search-memo.ts
@@ -0,0 +1,82 @@
+/**
+ * Ranked search pages one MCP session keeps, so a repeated search does not rank the same rows
+ * again. A page is a function of its ranking input and of the rows of the listings it reads. A
+ * listing's rows are rewritten only by a write that also gives it a newer evaluation time, so an
+ * entry is keyed by the complete input and each target's listing version (digest and time), which
+ * every search reads again, and a page is kept only under the versions its own statement read.
+ * The input carries the request's own authorization outcome: its targets passed this request's
+ * checks and its scopes come from this request's policy, grant and tool availability. A changed
+ * permission is a different key; the memo decides no access.
+ */
+import { Context } from "effect";
+import type { RankedPage } from "./tool-search-store.ts";
+
+export interface ToolSearchPageMemo {
+  readonly get: (key: string, now: number) => RankedPage | undefined;
+  readonly set: (key: string, page: RankedPage, bytes: number, now: number) => void;
+}
+
+/** The session's memo; unset outside an MCP session, where every search ranks its rows. */
+export const ToolSearchPageCache = Context.Reference<ToolSearchPageMemo | undefined>(
+  "executor/ToolSearchPageCache",
+  { defaultValue: () => undefined },
+);
+
+/**
+ * Bounds of one session's memo. Sizes are the page's JSON in UTF-16 bytes; a page larger than
+ * `entryBytes` is not kept. Expired entries are dropped whenever the memo is read or written.
+ */
+export interface ToolSearchMemoLimits {
+  readonly entries: number;
+  readonly entryBytes: number;
+  readonly totalBytes: number;
+  readonly ttlMillis: number;
+}
+
+export const toolSearchMemoLimits: ToolSearchMemoLimits = {
+  entries: 16,
+  entryBytes: 128 * 1024,
+  totalBytes: 512 * 1024,
+  ttlMillis: 5 * 60_000,
+};
+
+/** Least recently used entries go first once a bound is passed. */
+export const makeToolSearchPageMemo = (
+  limits: ToolSearchMemoLimits = toolSearchMemoLimits,
+): ToolSearchPageMemo => {
+  const entries = new Map<
+    string,
+    { readonly page: RankedPage; readonly bytes: number; readonly at: number }
+  >();
+  let total = 0;
+  const drop = (key: string) => {
+    const entry = entries.get(key);
+    if (entry === undefined) return;
+    total -= entry.bytes;
+    entries.delete(key);
+  };
+  const expire = (now: number) => {
+    for (const [key, entry] of entries) if (now - entry.at >= limits.ttlMillis) drop(key);
+  };
+  return {
+    get: (key, now) => {
+      expire(now);
+      const entry = entries.get(key);
+      if (entry === undefined) return undefined;
+      entries.delete(key);
+      entries.set(key, entry);
+      return structuredClone(entry.page);
+    },
+    set: (key, page, bytes, now) => {
+      expire(now);
+      drop(key);
+      if (bytes > limits.entryBytes) return;
+      entries.set(key, { page: structuredClone(page), bytes, at: now });
+      total += bytes;
+      for (const oldest of entries.keys()) {
+        if (entries.size <= limits.entries && total <= limits.totalBytes) break;
+        drop(oldest);
+      }
+    },
+  };
+};
