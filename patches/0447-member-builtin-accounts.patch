+import { StorageError } from "@executor-js/sdk/core";
+import { Effect, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import { OrganizationDefaults } from "../contracts/organization-defaults.ts";
+import { policyDatabase, type ResourceAuthority } from "./resource-policy.ts";
+
+/** Repair members skipped by earlier setup without replacing recorded accounts or choices. */
+export const ensureMemberDefaults = (actor: ResourceAuthority) =>
+  Effect.gen(function* () {
+    const sql = yield* policyDatabase;
+    const members = yield* sql`select "user".id as "userId", "user".name
+      from organization team join member on member."organizationId" = team.id
+      join "user" on "user".id = member."userId"
+      where team.id = ${actor.organization} and member."userId" = ${actor.user}
+        and coalesce((team.metadata::jsonb -> 'executorDefaults' ->> 'installed')::boolean, false)
+        and not (coalesce(team.metadata::jsonb -> 'executorKeyAccounts', '{}'::jsonb) ? member."userId")`.pipe(
+      Effect.flatMap(
+        Schema.decodeUnknownEffect(
+          Schema.Array(Schema.Struct({ userId: Schema.String, name: Schema.String })),
+        ),
+      ),
+    );
+    const member = members[0];
+    if (member === undefined) return;
+    const initialize = yield* OrganizationDefaults;
+    yield* initialize(actor.organization, member).pipe(
+      Effect.provideService(SqlClient.SqlClient, sql),
+    );
+  }).pipe(Effect.mapError(() => new StorageError()));
