+/** The Accounts tab's browser-only client, held at the public asset boundary. */
+const accountsClient = /\/assets\/app-accounts-client-[^/]+\.js$/;
+/** A link in the app's tab bar. */
+const appTab = (page: Page, name: string) =>
+  page
+    .getByRole("navigation", { name: "App navigation", exact: true })
+    .getByRole("link", { name, exact: true });
+/** What each committed state after the click showed in the app's tab content. */
+interface AccountsTabRecord {
+  /** Whether the pointerdown that opened the tab came from real input. */
+  readonly trusted: boolean | null;
+  /** The Accounts tab's loading state. */
+  readonly loading: boolean;
+  /** The previous tab, still selected, with its own content. */
+  readonly previous: boolean;
+  /** Accounts styled as the selected tab over content that is neither its loading state nor it. */
+  readonly mislabeled: boolean;
+  /** The App accounts section itself. */
+  readonly content: boolean;
+  /** Nothing at all: no text and no loading status, as a nested null fallback leaves it. */
+  readonly blank: boolean;
+  /** The app's heading left the page, so the whole page gave way to a placeholder. */
+  readonly headingLost: boolean;
+}
+
+/**
+ * Classifies every DOM commit from a MutationObserver installed before the click, so a state
+ * React commits and replaces before the next frame is still seen. Nothing here waits on time.
+ * The selected tab is not read: the tab bar's links mark the new location current before its
+ * content commits, so only the content says what the person sees.
+ */
+const recordAccountsTab = (label: string) =>
+  Effect.flatMap(Browser, (browser) =>
+    browser.use(label, (page) =>
+      page.evaluate(() => {
+        const state = {
+          trusted: null as boolean | null,
+          loading: false,
+          previous: false,
+          mislabeled: false,
+          content: false,
+          blank: false,
+          headingLost: false,
+        };
+        const scan = () => {
+          // The tab content follows the header row that holds the tab bar.
+          const nav = document.querySelector('nav[aria-label="App navigation"]');
+          const tab = nav?.parentElement?.nextElementSibling;
+          // The selected tab's look follows the content the page rendered, not the location.
+          const selected = [...(nav?.children ?? [])]
+            .find((item) => item.classList.contains("font-medium"))
+            ?.textContent?.trim();
+          if (tab?.querySelector('section[aria-label="App accounts"]')) state.content = true;
+          else if (!tab?.textContent?.trim() && !tab?.querySelector('[role="status"]'))
+            state.blank = true;
+          else if (tab?.querySelector('[role="status"][aria-label="Loading accounts"]'))
+            state.loading = true;
+          else if (selected === "Accounts") state.mislabeled = true;
+          else state.previous = true;
+          if (!document.querySelector('h1 a[aria-label$=" overview"]')) state.headingLost = true;
+        };
+        document.addEventListener(
+          "pointerdown",
+          (event) => {
+            state.trusted = event.isTrusted;
+          },
+          { once: true, capture: true },
+        );
+        const observer = new MutationObserver(scan);
+        observer.observe(document.documentElement, {
+          subtree: true,
+          childList: true,
+          attributes: true,
+          characterData: true,
+        });
+        Object.assign(window, { __accountsTab: state, __accountsTabObserver: observer });
+      }),
+    ),
+  );
+/** A copy of the record so far; `stop` ends the recording. */
+const readAccountsTab = (label: string, stop: boolean) =>
+  Effect.flatMap(Browser, (browser) =>
+    browser.use(label, (page) =>
+      page.evaluate((stop): AccountsTabRecord => {
+        if (stop) Reflect.get(window, "__accountsTabObserver").disconnect();
+        return { ...Reflect.get(window, "__accountsTab") };
+      }, stop),
+    ),
+  );
