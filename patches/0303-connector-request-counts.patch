@@ -0,0 +1,50 @@
+import { AccountTrafficHost, type AccountId } from "@executor-js/sdk/core";
+import { Clock, Effect } from "effect";
+import { HttpApiBuilder } from "effect/http-api";
+import { trafficTickHours, type AccountTraffic } from "../contracts/account-traffic.ts";
+import { HostedApi } from "../contracts/api.ts";
+import { HostedExecutor } from "../contracts/executor.ts";
+import { inspectableAccounts } from "./proofs/account-access.ts";
+
+const hour = 3_600_000;
+const week = 7 * 24 * hour;
+
+/**
+ * The tool calls each named account served in the last 7 days, for those the caller may inspect.
+ * Each account is judged on its own, so one the caller may not see never hides the others.
+ */
+export const readAccountTraffic = (accounts: readonly AccountId[]) =>
+  Effect.gen(function* () {
+    const visible = yield* inspectableAccounts([...new Set(accounts)]);
+    const executor = yield* Effect.flatten(HostedExecutor);
+    const now = yield* Clock.currentTimeMillis;
+    const current = Math.floor(now / hour) * hour;
+    const recentFrom = current - (trafficTickHours - 1) * hour;
+    const records = yield* executor[AccountTrafficHost].read({
+      accounts: visible,
+      from: now - week,
+    });
+    return {
+      readAt: new Date(now).toISOString(),
+      accounts: records.map((record): AccountTraffic => ({
+        account: record.account,
+        requests: record.hours.reduce((sum, entry) => sum + entry.requests, 0),
+        failed: record.hours.reduce((sum, entry) => sum + entry.failed, 0),
+        recent: record.hours
+          .filter((entry) => entry.at >= recentFrom)
+          .map((entry) => ({
+            at: new Date(entry.at).toISOString(),
+            requests: entry.requests,
+            failed: entry.failed,
+          })),
+        lastSuccessAt:
+          record.lastSuccessAt === null ? null : new Date(record.lastSuccessAt).toISOString(),
+      })),
+    };
+  });
+
+export const hostedAccountTrafficHandlers = HttpApiBuilder.group(
+  HostedApi,
+  "accountTraffic",
+  (handlers) => handlers.handle("read", ({ payload }) => readAccountTraffic(payload.accounts)),
+);
