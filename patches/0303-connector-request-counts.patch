+++ b/e2e/tests/account-tool-calls.spec.ts
@@ -0,0 +1,179 @@
+/** Tool calls count toward the account they used, on the Accounts list and its app's tab. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { randomUUID } from "node:crypto";
+import { scenarios } from "../test-plan.ts";
+import { Api, body } from "../support/api.ts";
+import { Actors } from "../support/actors.ts";
+import { Browser } from "../support/browser.ts";
+import { Evidence } from "../support/evidence.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { App, Resource } from "../support/contracts.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { connectionsPath } from "../support/app-accounts.ts";
+import { accountRow } from "../support/account-rows.ts";
+
+const files = [
+  {
+    path: "index.ts",
+    content: `import { defineApp, defineProvider, secrets, object, string, router, query } from "apps";
+const service = defineProvider({ name: "Tool call service", auth: {
+  key: secrets({ label: "API key", fields: object({ token: string() }) }),
+} });
+export default defineApp({ user: { accounts: { service } } }, { tools: router({
+  ping: query({ input: object({}) }, async () => true),
+  fail: query({ input: object({}) }, async () => { throw new Error("Synthetic tool failure"); }),
+}) });`,
+  },
+  appsManifest,
+];
+
+const Count = Schema.Struct({ at: Schema.String, requests: Schema.Number, failed: Schema.Number });
+const Traffic = Schema.Struct({
+  readAt: Schema.String,
+  accounts: Schema.Array(
+    Schema.Struct({
+      account: Schema.String,
+      requests: Schema.Number,
+      failed: Schema.Number,
+      recent: Schema.Array(Count),
+      lastSuccessAt: Schema.NullOr(Schema.String),
+    }),
+  ),
+});
+
+layer(HostedLive, { excludeTestServices: true })("Account tool calls", (it) => {
+  it.effect(scenarios.accountToolCalls.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api;
+        const actors = yield* Actors;
+        const browser = yield* Browser;
+        const evidence = yield* Evidence;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const suffix = randomUUID().slice(0, 8);
+        const label = `Counted key ${suffix}`;
+        const created: { app?: string; account?: string } = {};
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            if (created.app)
+              expect(
+                (yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${created.app}`))
+                  .status,
+              ).toBe(200);
+            if (created.account)
+              expect(
+                (yield* api.request(
+                  actors.owner,
+                  "DELETE",
+                  `${prefix}/accounts/${created.account}`,
+                )).status,
+              ).toBe(200);
+          }).pipe(Effect.orDie),
+        );
+        const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: `Tool calls ${suffix}`,
+          files,
+        });
+        expect(deployed.status).toBe(200);
+        const app = (yield* body(App, deployed)).id;
+        created.app = app;
+        // Connecting from the app links the account to it, so calls need no choice. Personal, so
+        // only the owner may inspect it.
+        const connection = yield* api.request(
+          actors.owner,
+          "POST",
+          connectionsPath(`${prefix}/apps/${app}`, "user", "service"),
+          {},
+        );
+        expect(connection.status).toBe(200);
+        const saved = yield* api.request(
+          actors.owner,
+          "POST",
+          `${prefix}/connections/${(yield* body(Resource, connection)).id}/submit`,
+          { method: "key", label, fields: { token: "synthetic-tool-call-token" } },
+        );
+        expect(saved.status).toBe(200);
+        const account = (yield* body(Resource, saved)).id;
+        created.account = account;
+
+        // Two calls succeed and one throws in the app's code: three requests, one failed.
+        const call = (tool: "ping" | "fail" | "missing") =>
+          api.request(actors.owner, "POST", `${prefix}/apps/${app}/tools/call`, {
+            tool,
+            kind: "query",
+            input: {},
+          });
+        expect((yield* call("ping")).status).toBe(200);
+        expect((yield* call("fail")).status).toBeGreaterThanOrEqual(400);
+        expect((yield* call("ping")).status).toBe(200);
+        // A refusal of the caller's own request is not the account's failure and counts nothing.
+        expect((yield* call("missing")).status).toBeGreaterThanOrEqual(400);
+
+        const read = (actor: typeof actors.owner) =>
+          api.request(actor, "POST", `${prefix}/account-traffic`, { accounts: [account] });
+        const owned = yield* read(actors.owner);
+        expect(owned.status).toBe(200);
+        const counted = (yield* body(Traffic, owned)).accounts;
+        expect(
+          counted.map(({ account, requests, failed }) => ({ account, requests, failed })),
+        ).toEqual([{ account, requests: 3, failed: 1 }]);
+        expect(counted[0]?.recent.reduce((sum, hour) => sum + hour.requests, 0)).toBe(3);
+        expect(counted[0]?.lastSuccessAt).not.toBeNull();
+        // A member who may not inspect the owner's personal account reads no counts for it, the
+        // same answer as an account no call used.
+        const other = yield* read(actors.member);
+        expect(other.status).toBe(200);
+        expect((yield* body(Traffic, other)).accounts).toEqual([]);
+
+        yield* browser.login(actors.owner);
+        const accounts = `/org/${actors.organization.slug}/accounts`;
+        const appTab = `/org/${actors.organization.slug}/apps/${app}?view=accounts`;
+        for (const width of [1280, 390]) {
+          const listed = yield* browser.use(`Read the counted row at ${width}px`, (page) => {
+            const cell = accountRow(page, label).locator("[data-account-requests]");
+            return page
+              .setViewportSize({ width, height: 900 })
+              .then(() => page.goto(accounts))
+              .then(() => cell.waitFor())
+              .then(() =>
+                Promise.all([
+                  cell.getAttribute("data-account-requests"),
+                  cell.getAttribute("title"),
+                ]),
+              );
+          });
+          expect(listed[0]).toBe("3");
+          expect(listed[1]).toContain("tool calls");
+          yield* evidence.attach(
+            `tool-calls-accounts-${width}.png`,
+            "image/png",
+            yield* browser.use("Capture the Accounts list", (page) =>
+              page.screenshot({ fullPage: true }),
+            ),
+          );
+          const tabbed = yield* browser.use(`Read the app tab row at ${width}px`, (page) => {
+            const cell = page
+              .getByRole("region", { name: "Your accounts", exact: true })
+              .locator("li")
+              .filter({ has: page.getByRole("button", { name: `Manage ${label}`, exact: true }) })
