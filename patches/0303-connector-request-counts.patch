diff --git a/packages/sdk/src/implementation/account-traffic-store.ts b/packages/sdk/src/implementation/account-traffic-store.ts
new file mode 100644
index 0000000..24ab26d
--- /dev/null
+++ b/packages/sdk/src/implementation/account-traffic-store.ts
@@ -0,0 +1,129 @@
+/**
+ * Per-account, per-UTC-hour counts of the tool calls each account served, so account lists can
+ * show requests, failures and the latest success. Derived data no reactive reader watches: the
+ * table creates itself the first time a write finds it missing instead of taking a schema version,
+ * and every write is best-effort for its caller.
+ */
+import { Clock, Effect, Schema } from "effect";
+import type { SqlClient } from "effect/sql";
+import type { AccountTrafficRecord } from "../contracts/account-traffic.ts";
+import { AccountId, StorageError } from "../contracts/shared.ts";
+
+const hour = 3_600_000;
+/** Hours older than this are dropped and never read. */
+export const accountTrafficRetention = 31 * 24 * hour;
+
+const Hour = Schema.Struct({
+  account: AccountId,
+  at: Schema.Number,
+  requests: Schema.Number,
+  failed: Schema.Number,
+});
+const Last = Schema.Struct({ account: AccountId, at: Schema.NullOr(Schema.Number) });
+const Opened = Schema.Struct({ opened: Schema.Boolean });
+
+/** Postgres and PGlite report an undefined table as SQLSTATE 42P01, wrapped by the SQL client. */
+const missingTable = (error: unknown) => {
+  let at: unknown = error;
+  for (let depth = 0; depth < 5 && typeof at === "object" && at !== null; depth += 1) {
+    if ("code" in at && at.code === "42P01") return true;
+    at = "cause" in at ? at.cause : undefined;
+  }
+  return false;
+};
+
+export const makeAccountTrafficStore = (sql: SqlClient.SqlClient) => {
+  const safe = <A, E, R>(effect: Effect.Effect<A, E, R>) =>
+    effect.pipe(Effect.mapError(() => new StorageError()));
+  // Only after a write found the table missing, serialized so concurrent first writes cannot race
+  // on the catalog. Postgres and PGlite alike.
+  const create = Effect.gen(function* () {
+    yield* sql`select pg_advisory_xact_lock(hashtext('executor-account-tool-calls'))`;
+    yield* sql`create table if not exists executor_account_tool_calls (
+      account text not null,
+      hour timestamptz not null,
+      requests integer not null default 0,
+      failed integer not null default 0,
+      last_success timestamptz,
+      primary key (account, hour)
+    )`;
+  }).pipe(sql.withTransaction);
+  const upsert = (account: AccountId, start: Date, failed: number, success: Date | null) => {
+    const statement = sql`insert into executor_account_tool_calls ${sql.insert({
+      account,
+      hour: start,
+      requests: 1,
+      failed,
+      last_success: success,
+    })}
+    on conflict (account, hour) do update set
+      requests = executor_account_tool_calls.requests + 1,
+      failed = executor_account_tool_calls.failed + excluded.failed,
+      last_success = greatest(executor_account_tool_calls.last_success, excluded.last_success)
+    returning (xmax = 0) as opened`;
+    return statement.pipe(
+      Effect.catchIf(missingTable, () => create.pipe(Effect.andThen(statement))),
+      Effect.flatMap(Schema.decodeUnknownEffect(Schema.Array(Opened))),
+      Effect.map((rows) => rows[0]?.opened === true),
+    );
+  };
+  return {
+    /** One call's outcome for each distinct account it used. */
+    record: (input: {
+      readonly accounts: readonly AccountId[];
+      readonly at: number;
+      readonly ok: boolean;
+    }) =>
+      input.accounts.length === 0
+        ? Effect.void
+        : Effect.gen(function* () {
+            const accounts = [...new Set(input.accounts)];
+            const start = new Date(Math.floor(input.at / hour) * hour);
+            const opened = yield* Effect.forEach(accounts, (account) =>
+              upsert(account, start, input.ok ? 0 : 1, input.ok ? new Date(input.at) : null),
+            );
+            // Old hours go when an account opens a new one, so a busy hour pays nothing extra.
+            const fresh = accounts.filter((_, index) => opened[index] === true);
+            if (fresh.length > 0)
+              yield* sql`delete from executor_account_tool_calls
+                where ${sql.in("account", fresh)}
+                and hour < ${new Date(input.at - accountTrafficRetention)}`;
+          }).pipe(safe),
+    read: (input: { readonly accounts: readonly AccountId[]; readonly from: number }) =>
+      input.accounts.length === 0
+        ? Effect.succeed<readonly AccountTrafficRecord[]>([])
+        : Effect.gen(function* () {
+            const accounts = [...new Set(input.accounts)];
+            // An idle account keeps its old hours until it opens a new one; they are never read.
+            const kept = new Date((yield* Clock.currentTimeMillis) - accountTrafficRetention);
+            const from = new Date(Math.max(Math.floor(input.from / hour) * hour, kept.getTime()));
+            const hours = yield* sql`select account,
+                extract(epoch from hour)::float8 * 1000 as at,
+                requests::float8 as requests, failed::float8 as failed
+              from executor_account_tool_calls
+              where ${sql.in("account", accounts)} and hour >= ${from}
+              order by account, hour`.pipe(
+              Effect.flatMap(Schema.decodeUnknownEffect(Schema.Array(Hour))),
+            );
+            const last = yield* sql`select account,
+                extract(epoch from max(last_success))::float8 * 1000 as at
+              from executor_account_tool_calls
+              where ${sql.in("account", accounts)} and hour >= ${kept}
+              group by account`.pipe(
+              Effect.flatMap(Schema.decodeUnknownEffect(Schema.Array(Last))),
+            );
+            // Only accounts with a counted call are listed: no row means nothing was counted.
+            return last.map((entry): AccountTrafficRecord => ({
+              account: entry.account,
+              hours: hours
+                .filter((row) => row.account === entry.account)
+                .map(({ at, requests, failed }) => ({ at, requests, failed })),
+              lastSuccessAt: entry.at,
+            }));
+          }).pipe(
+            // Nothing has been counted before the first write creates the table.
+            Effect.catchIf(missingTable, () => Effect.succeed<readonly AccountTrafficRecord[]>([])),
+            safe,
+          ),
+  };
+};
