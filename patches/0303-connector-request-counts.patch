+/**
+ * The accounts among `accounts` the caller may inspect, by the same rule as `AccountGrants.inspect`
+ * but read together: one policy query, and the token's app scope worked out once. It grants
+ * nothing and mints no proof; a read that only filters what it shows uses it.
+ */
+export const inspectableAccounts = (accounts: readonly AccountId[]) =>
+  Effect.gen(function* () {
+    if (accounts.length === 0) return [];
+    const actor = yield* currentResourceAuthority;
+    const readable = (yield* accountAccesses(accounts, actor))
+      .filter((access) => access.canUse || access.canManage)
