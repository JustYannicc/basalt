+import { AccountId, StorageError } from "@executor-js/sdk/core";
+import { Schema } from "effect";
+import { HttpApiEndpoint, HttpApiGroup } from "effect/http-api";
+import { RequiredAction } from "./authorization.ts";
+import {
+  OrganizationForbidden,
+  OrganizationReference,
+  RequireOrganization,
+} from "./organization.ts";
+
+/** The most accounts one read names; an Accounts list asks for its visible rows at once. */
+export const maxTrafficAccounts = 200;
+/** The recent hours an account row shows as ticks, the current partial hour last. */
+export const trafficTickHours = 8;
+
+const Count = Schema.Finite.check(Schema.isGreaterThanOrEqualTo(0));
+
+export const AccountTrafficInput = Schema.Struct({
+  accounts: Schema.Array(AccountId).check(Schema.isMaxLength(maxTrafficAccounts)),
+});
+
+/** The tool calls one account served: 7 days of totals, recent hours and its latest success. */
+export const AccountTraffic = Schema.Struct({
+  account: AccountId,
+  requests: Count,
+  failed: Count,
+  /** Hours with calls among the last `trafficTickHours`, oldest first; ISO hour starts. */
+  recent: Schema.Array(Schema.Struct({ at: Schema.String, requests: Count, failed: Count })),
+  lastSuccessAt: Schema.NullOr(Schema.String),
+});
+export type AccountTraffic = typeof AccountTraffic.Type;
+
+/**
+ * Lists only accounts the caller may inspect that served a counted call; an account it may not
+ * inspect is left out exactly as one nothing called, so the answer never shows which is which.
+ */
+export const AccountTrafficPage = Schema.Struct({
+  readAt: Schema.String,
+  accounts: Schema.Array(AccountTraffic),
+});
+
+export const HostedAccountTraffic = HttpApiGroup.make("accountTraffic")
+  .add(
+    HttpApiEndpoint.post("read", "/api/organizations/:organization/account-traffic", {
+      params: { organization: OrganizationReference },
+      payload: AccountTrafficInput,
+      success: AccountTrafficPage,
+      error: [OrganizationForbidden, StorageError],
+    }).annotate(RequiredAction, "read"),
+  )
+  .middleware(RequireOrganization);
