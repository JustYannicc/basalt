--- /dev/null
+++ b/apps/hosted/web/src/contracts/connector-traffic.ts
@@ -0,0 +1,82 @@
+/**
+ * The tool calls each visible account served, read in one polled request per page. The host
+ * leaves out accounts the caller may not inspect and accounts no call used, so either gets no
+ * numbers, never 0. A failed read gives nothing at all.
+ */
+import { browserOnly } from "@executor-js/ui/contracts/http";
+import { pollingQuery } from "@executor-js/ui/contracts/polling";
+import type { TrafficTick } from "@executor-js/ui/dashboard/account-traffic";
+import { Effect } from "effect";
+import { Atom } from "effect/reactivity";
+import type { AccountId } from "@executor-js/sdk";
+import type { OrganizationReference } from "@executor-js/hosted-server/organization";
+import { maxTrafficAccounts, trafficTickHours } from "@executor-js/hosted-server/account-traffic";
+import { HostedClient } from "./api.ts";
+
+const hour = 3_600_000;
+
+/** One account's counted tool calls, before the page names who counted them. */
+export interface ToolCallTraffic {
+  readonly requests: number;
+  readonly failed: number;
+  readonly ticks: readonly TrafficTick[];
+  readonly lastSuccessAt: string | null;
+}
+
+interface Key {
+  readonly organization: OrganizationReference;
+  readonly accounts: readonly AccountId[];
+}
+
+const read = ({ organization, accounts }: Key) =>
+  Effect.gen(function* () {
+    const client = yield* HostedClient;
+    const pages = yield* Effect.forEach(
+      Array.from({ length: Math.ceil(accounts.length / maxTrafficAccounts) }, (_, index) =>
+        accounts.slice(index * maxTrafficAccounts, (index + 1) * maxTrafficAccounts),
+      ),
+      (batch) =>
+        client.accountTraffic.read({ params: { organization }, payload: { accounts: batch } }),
+      { concurrency: 2 },
+    );
+    return new Map(
+      pages.flatMap((page) => {
+        // The server's hours, so a skewed browser clock never shifts the ticks.
+        const current = Math.floor(Date.parse(page.readAt) / hour) * hour;
+        return page.accounts.map((entry) => {
+          const traffic: ToolCallTraffic = {
+            requests: entry.requests,
+            failed: entry.failed,
+            ticks: Array.from({ length: trafficTickHours }, (_, index): TrafficTick => {
+              const start = current - (trafficTickHours - 1 - index) * hour;
+              const bucket = entry.recent.find((recent) => Date.parse(recent.at) === start);
+              return bucket === undefined || bucket.requests === 0
+                ? "none"
+                : bucket.failed > 0
+                  ? "bad"
+                  : "good";
+            }),
+            lastSuccessAt: entry.lastSuccessAt,
+          };
+          return [entry.account, traffic] as const;
+        });
+      }),
+    );
+  });
+
+// String keys: the family reuses the atom, and its polling, while the visible accounts stay put.
+const traffic = Atom.family((key: string) => {
+  const parsed = JSON.parse(key) as Key;
+  return pollingQuery(
+    browserOnly(
+      HostedClient.runtime.atom(
+        parsed.accounts.length === 0
+          ? Effect.succeed(undefined)
+          : read(parsed).pipe(Effect.catch(() => Effect.succeed(undefined))),
+      ),
+    ),
+  );
+});
+
+/** Each visible account's counted tool calls; undefined while unread or when the read failed. */
+export const toolCallTrafficAtom = (key: Key) => traffic(JSON.stringify(key));
