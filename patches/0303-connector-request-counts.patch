+    const scope = yield* CurrentAuthorization;
+    if (scope.tools.kind === "all") return readable;
+    const executor = yield* Effect.flatten(HostedExecutor);
+    const apps = yield* executor.apps.list({
+      owner: organizationOwner(actor.organization),
+      ids: permittedAppIds(scope),
+    });
+    const reachable = yield* visibleAppsAs(actor, apps);
+    const linked = new Set(
+      (yield* callerLinkedAccounts(reachable.map((app) => app.id))).map((entry) => entry.id),
+    );
+    return readable.filter((account) => linked.has(account));
+  });
