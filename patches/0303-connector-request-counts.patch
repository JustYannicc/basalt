diff --git a/packages/sdk/src/contracts/account-traffic.ts b/packages/sdk/src/contracts/account-traffic.ts
new file mode 100644
index 0000000..69c6666
--- /dev/null
+++ b/packages/sdk/src/contracts/account-traffic.ts
@@ -0,0 +1,32 @@
+import type { Effect } from "effect";
+import type { AccountId, StorageError } from "./shared.ts";
+
+/** Host-only reads of the tool calls each account served, for account lists. */
+export const AccountTrafficHost = Symbol("executor.AccountTrafficHost");
+
+/** One UTC hour's tool calls for an account. `at` is the hour's start in epoch milliseconds. */
+export interface AccountTrafficHour {
+  readonly at: number;
+  readonly requests: number;
+  readonly failed: number;
+}
+
+/** An account's counted tool calls since `from`, and its latest success in the kept history. */
+export interface AccountTrafficRecord {
+  readonly account: AccountId;
+  readonly hours: readonly AccountTrafficHour[];
+  /** Epoch milliseconds; null when no call it served succeeded in the kept history. */
+  readonly lastSuccessAt: number | null;
+}
+
+/**
+ * Counts are best-effort and carry no inputs, outputs or identities. The host checks that its
+ * caller may inspect every account it asks about; this read checks nothing.
+ */
+export interface AccountTrafficHost {
+  readonly read: (input: {
+    readonly accounts: readonly AccountId[];
+    /** Epoch milliseconds; earlier hours are left out. */
+    readonly from: number;
+  }) => Effect.Effect<readonly AccountTrafficRecord[], StorageError>;
+}
