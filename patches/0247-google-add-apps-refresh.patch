diff --git a/packages/ui/src/implementation/dashboard/identity-consent-complete.tsx b/packages/ui/src/implementation/dashboard/identity-consent-complete.tsx
new file mode 100644
index 0000000..ad2598c
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/identity-consent-complete.tsx
@@ -0,0 +1,56 @@
+import { useState } from "react";
+import { Exit } from "effect";
+import type { Account } from "@executor-js/sdk";
+import { Button } from "../components/button.tsx";
+
+/** Retrying account reads must never repeat the already committed connection. */
+export function IdentityConsentComplete<E>(props: {
+  readonly account: Account;
+  readonly apps: readonly string[];
+  readonly family: string;
+  readonly warning: boolean;
+  readonly retry: () => Promise<Exit.Exit<void, E>>;
+  readonly onPendingChange: (pending: boolean) => void;
+  readonly onDone: () => void;
+}) {
+  const [warning, setWarning] = useState(props.warning);
+  const [pending, setPending] = useState(false);
+  return (
+    <div className="min-w-0 space-y-4 wrap-anywhere">
+      <div role="status" className="space-y-2">
+        <p className="font-medium">Apps connected</p>
+        <p className="text-sm text-muted-foreground">
+          {props.apps.join(", ")} can now use {props.account.identity?.label ?? props.family}.
+        </p>
+      </div>
+      {warning && (
+        <div className="space-y-2">
+          <p role="alert" className="text-sm text-muted-foreground">
+            Your apps are connected, but the account list could not refresh.
+          </p>
+          <Button
+            variant="outline"
+            loading={pending}
+            disabled={pending}
+            onClick={async () => {
+              if (pending) return;
+              setPending(true);
+              props.onPendingChange(true);
+              try {
+                setWarning(Exit.isFailure(await props.retry()));
+              } finally {
+                setPending(false);
+                props.onPendingChange(false);
+              }
+            }}
+          >
+            Retry
+          </Button>
+        </div>
+      )}
+      <Button disabled={pending} onClick={props.onDone}>
+        Done
+      </Button>
+    </div>
+  );
+}
