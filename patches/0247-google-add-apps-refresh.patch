diff --git a/e2e/tests/account-identity-reconciliation.spec.ts b/e2e/tests/account-identity-reconciliation.spec.ts
new file mode 100644
index 0000000..50a85e1
--- /dev/null
+++ b/e2e/tests/account-identity-reconciliation.spec.ts
@@ -0,0 +1,216 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { FetchHttpClient, HttpClient } from "effect/http";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { accountIdentityIssuer } from "../support/account-identity-issuer.ts";
+import { IdentityAccount } from "../support/account-identity-product.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { connectionsPath } from "../support/app-accounts.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Links = Schema.Array(Schema.Struct({ account: Resource }));
+
+layer(HostedLive, { excludeTestServices: true })("Account reconciliation", (it) => {
+  it.effect(scenarios.accountIdentityReconciliation.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          browser = yield* Browser,
+          http = yield* HttpClient.HttpClient,
+          issuer = yield* accountIdentityIssuer;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const accounts = new Set<string>(),
+          apps: string[] = [];
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            for (const app of apps) {
+              const links = yield* api.request(
+                actors.owner,
+                "GET",
+                `${prefix}/apps/${app}/accounts/user`,
+              );
+              if (links.status === 200)
+                for (const link of yield* body(Links, links)) accounts.add(link.account.id);
+              yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app}`);
+            }
+            for (const account of accounts)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`);
+          }).pipe(Effect.orDie),
+        );
+        const deploy = (name: string) =>
+          Effect.gen(function* () {
+            const response = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+              name,
+              files: [
+                appsManifest,
+                {
+                  path: "index.ts",
+                  content: `import { defineApp, defineProvider, oauth2, router } from "apps";
+const service=defineProvider({name:${JSON.stringify(name)},auth:{oauth:oauth2(${JSON.stringify({ authorizationUrl: issuer.origin + "/authorize", tokenUrl: issuer.origin + "/token", scopes: ["read"], tokenEndpointAuthMethod: "none", identity: { issuer: issuer.origin, name: "Reconciliation identity" } })})}});
+export default defineApp({user:{accounts:{service}}},async()=>({tools:router({})}));`,
+                },
+              ],
+            });
+            expect(response.status, JSON.stringify(response.body)).toBe(200);
+            const app = (yield* body(Resource, response)).id;
+            apps.push(app);
+            return app;
+          });
+        const first = yield* deploy("Reconciliation source");
+        const created = yield* api.request(
+          actors.owner,
+          "POST",
+          connectionsPath(`${prefix}/apps/${first}`, "user", "service"),
+          {},
+        );
+        expect(created.status).toBe(200);
+        const connection = (yield* body(Resource, created)).id;
+        const started = yield* api.request(
+          actors.owner,
+          "POST",
+          `${prefix}/connections/${connection}/oauth/start`,
+          { method: "oauth", client: { clientId: "reconciliation-client" } },
+        );
+        expect(started.status).toBe(200);
+        const authorization = yield* body(
+          Schema.Struct({ authorizationUrl: Schema.String }),
+          started,
+        );
+        const callbackUrl = yield* Effect.scoped(
+          Effect.gen(function* () {
+            const response = yield* HttpClient.withScope(http).get(authorization.authorizationUrl);
+            expect(response.status).toBe(302);
+            if (response.headers.location === undefined)
+              return yield* Effect.die("Issuer omitted callback");
+            return response.headers.location;
+          }),
+        ).pipe(Effect.provideService(FetchHttpClient.RequestInit, { redirect: "manual" }));
+        const completed = yield* api.request(
+          actors.owner,
+          "POST",
+          `${prefix}/connections/${connection}/oauth/complete`,
+          { callbackUrl },
+        );
+        expect(completed.status).toBe(200);
+        const source = yield* body(IdentityAccount, completed);
+        accounts.add(source.id);
+        expect(source.identity).toBeDefined();
+        const target = yield* deploy("Reconciliation target");
+        yield* browser.login(actors.owner);
+        let committed = false,
+          blocked = true,
+          saves = 0,
+          projectionReads = 0,
+          failedReads = 0;
+        yield* browser.use(
+          "Keep the real save and fail only its following account projection",
+          (page) =>
+            page
+              .route(/\/connections\/[^/]+\/oauth\/reuse$/, (route) => {
+                saves++;
+                return route.fetch().then((response) => {
+                  committed = response.ok();
+                  return route.fulfill({ response });
+                });
+              })
+              .then(() =>
+                page.route(/\/resources\/accounts(?:\?.*)?$/, (route) => {
+                  projectionReads++;
+                  if (committed && blocked) {
+                    failedReads++;
+                    return route.abort("failed");
+                  }
+                  return route.continue();
+                }),
+              ),
+        );
+        yield* browser.use("Open the initial saved account", (page) =>
+          page.goto(`/org/${actors.organization.slug}/accounts`),
+        );
+        yield* browser.use("Add the second app from its saved identity", (page) =>
+          page
+            .getByRole("button", { name: "Add Reconciliation identity app", exact: true })
+            .click(),
+        );
+        yield* browser.use("Choose the target app", (page) =>
+          page
+            .getByRole("combobox", { name: "App", exact: true })
+            .click()
+            .then(() =>
+              page.getByRole("option", { name: "Reconciliation target", exact: true }).click(),
+            ),
+        );
+        yield* browser.use("Save once using the covering grant", (page) =>
+          page.getByRole("button", { name: "Add app", exact: true }).click(),
+        );
+        yield* browser.use("Keep save success visible", (page) =>
+          page.getByRole("status").filter({ hasText: "Apps connected" }).waitFor(),
+        );
+        yield* browser.use("Expose the failed account read", (page) =>
+          page
+            .getByRole("alert")
+            .filter({ hasText: "the account list could not refresh" })
+            .waitFor(),
+        );
+        expect(committed).toBe(true);
+        expect(saves).toBe(1);
+        expect(failedReads).toBeGreaterThan(0);
+        const linked = yield* body(
+          Links,
+          yield* api.request(actors.owner, "GET", `${prefix}/apps/${target}/accounts/user`),
+        );
+        expect(linked).toHaveLength(1);
+        accounts.add(linked[0]!.account.id);
+        yield* browser.checkpoint("Connection committed while only the account projection failed");
+        const beforeFailedRetry = failedReads;
+        yield* browser.use("A failed read-only retry keeps the warning", (page) =>
+          page.getByRole("button", { name: "Retry", exact: true }).click(),
+        );
+        yield* browser.use("The failed retry is available again", (page) =>
+          page.getByRole("button", { name: "Retry", exact: true, disabled: false }).waitFor(),
+        );
+        expect(failedReads).toBeGreaterThan(beforeFailedRetry);
+        expect(saves).toBe(1);
+        yield* browser.use("Save success survives the failed retry", (page) =>
+          page.getByRole("status").filter({ hasText: "Apps connected" }).waitFor(),
+        );
+        const beforeRetry = projectionReads,
+          failedBeforeRetry = failedReads;
+        blocked = false;
+        yield* browser.use("Retry only the account reads", (page) =>
+          page.getByRole("button", { name: "Retry", exact: true }).click(),
+        );
+        yield* browser.use("The warning clears after fresh reads", (page) =>
+          page
+            .getByRole("alert")
+            .filter({ hasText: "the account list could not refresh" })
+            .waitFor({ state: "detached" }),
+        );
+        expect(projectionReads).toBeGreaterThan(beforeRetry);
+        expect(failedReads).toBe(failedBeforeRetry);
+        expect(saves).toBe(1);
+        expect((yield* issuer.metrics).authorizations).toBe(1);
+        yield* browser.use("Both apps remain on the verified row", (page) =>
+          page
+            .locator(".inventory-row")
+            .filter({ hasText: "same@example.test" })
+            .getByRole("link", { name: "Reconciliation target", exact: true })
+            .waitFor(),
+        );
+        yield* browser.use("Dismiss confirmed completion", (page) =>
+          page
+            .getByRole("button", { name: "Done", exact: true })
+            .click()
+            .then(() => page.getByRole("dialog").waitFor({ state: "hidden" })),
+        );
+        yield* browser.checkpoint("Read-only retry refreshed the account without another reuse");
+      }),
+    ),
+  );
+});
