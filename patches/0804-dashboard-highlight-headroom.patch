diff --git a/packages/ui/src/implementation/server-highlight-engine.ts b/packages/ui/src/implementation/server-highlight-engine.ts
new file mode 100644
index 000000000..2fed6e850
--- /dev/null
+++ b/packages/ui/src/implementation/server-highlight-engine.ts
@@ -0,0 +1,27 @@
+import { HighlightUnavailable } from "../contracts/highlight.ts";
+import { Effect } from "effect";
+import { createHighlighterCore } from "shiki/core";
+import { createJavaScriptRegexEngine } from "shiki/engine/javascript";
+import typescript from "shiki/langs/typescript.mjs";
+import json from "shiki/langs/json.mjs";
+import shellscript from "shiki/langs/shellscript.mjs";
+import light from "shiki/themes/github-light.mjs";
+import dark from "shiki/themes/github-dark.mjs";
+
+/**
+ * The engine for a server render that has to fit a Worker's upload: only the grammars of the code
+ * a page load most often shows (schemas, install snippets and TypeScript source). Other languages
+ * render plain there and take their colors when the browser's full engine loads.
+ */
+export const highlighter = Effect.acquireRelease(
+  Effect.tryPromise({
+    try: () =>
+      createHighlighterCore({
+        themes: [light, dark],
+        langs: [typescript, json, shellscript],
+        engine: createJavaScriptRegexEngine(),
+      }),
+    catch: () => new HighlightUnavailable({}),
+  }),
+  (value) => Effect.sync(() => value.dispose()),
+);
