+import { fileURLToPath } from "node:url";
+import type { Plugin } from "vite-plus";
+
+const engine = "/packages/ui/src/implementation/highlight-engine.ts";
+const serverEngine = fileURLToPath(
+  new URL("../../../../packages/ui/src/implementation/server-highlight-engine.ts", import.meta.url),
+);
+
+/**
+ * Give the server build an engine with only three grammars (TypeScript, JSON and shell) instead
+ * of all seven, which the dashboard Worker would otherwise upload and compile on every cold start.
+ * Code in those languages is colored in the server's HTML, and hydration keeps those colors
+ * because each line holds the same text. Other languages render plain on a page load and take
+ * their colors once the browser's full engine loads. Only built Workers swap; a dev server
+ * renders with the full engine. The build fails if the engine is no longer swapped, so a moved
+ * import cannot quietly bring every grammar back.
+ */
+export const serverHighlight = (): Plugin => {
+  let swapped = false;
+  return {
+    name: "executor-cloud-server-highlight",
+    apply: "build",
+    enforce: "pre",
+    async resolveId(source, importer, options) {
+      if (this.environment.config.consumer !== "server" || !source.endsWith("highlight-engine.ts"))
+        return null;
+      const resolved = await this.resolve(source, importer, { ...options, skipSelf: true });
+      if (!resolved?.id.endsWith(engine)) return null;
+      swapped = true;
+      return serverEngine;
+    },
+    buildEnd(error) {
+      if (this.environment.config.consumer === "server" && error === undefined && !swapped)
+        this.error(`The server build no longer imports ${engine}; update the highlight swap`);
+    },
+  };
+};
