diff --git a/apps/hosted/cloud/web/server-highlight.ts b/apps/hosted/cloud/web/server-highlight.ts
new file mode 100644
index 000000000..c0ce24672
--- /dev/null
+++ b/apps/hosted/cloud/web/server-highlight.ts
@@ -0,0 +1,32 @@
+import { fileURLToPath } from "node:url";
+import type { Plugin } from "vite-plus";
+
+const engine = "/packages/ui/src/implementation/highlight-engine.ts";
+const stub = fileURLToPath(new URL("./server-highlight-engine.ts", import.meta.url));
+
+/**
+ * Keep Shiki out of the server build, which the dashboard Worker uploads and compiles on every
+ * cold start although no server render can use it: `highlighterAtom` loads the engine with a
+ * dynamic import that cannot settle before the render, so the server always sends plain code and
+ * the browser highlights after hydration. The client build keeps the real engine. The build fails
+ * if the engine is no longer swapped, so a moved import cannot quietly bring Shiki back.
+ */
+export const serverHighlight = (): Plugin => {
+  let swapped = false;
+  return {
+    name: "executor-cloud-server-highlight",
+    apply: "build",
+    enforce: "pre",
+    async resolveId(source, importer, options) {
+      if (this.environment.name !== "ssr" || !source.endsWith("highlight-engine.ts")) return null;
+      const resolved = await this.resolve(source, importer, { ...options, skipSelf: true });
+      if (!resolved?.id.endsWith(engine)) return null;
+      swapped = true;
+      return stub;
+    },
+    buildEnd(error) {
+      if (this.environment.name === "ssr" && error === undefined && !swapped)
+        this.error(`The server build no longer imports ${engine}; update the highlight swap`);
+    },
+  };
+};
