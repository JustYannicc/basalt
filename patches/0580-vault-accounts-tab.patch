+/**
+ * A device idle this long needs a look, even one that last synced the vault's newest change: it
+ * may be switched off, signed out or stuck, and won't see the next change.
+ */
+export const staleAfter = 2 * 24 * 60 * 60 * 1000;
+
+export const isStale = (activity: DeviceActivity | null, now: number) =>
+  activity !== null && now - Date.parse(activity.at) > staleAfter;
