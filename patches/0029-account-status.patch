+/** Refuse a connection's plain-slot replacement under the same lock used by link mutations. */
+import { AccountProvisioned, StorageError, type ResourceLifecycle } from "@executor-js/sdk/core";
+import { Effect } from "effect";
+import type { SqlClient } from "effect/sql";
+import { lockAppLinks } from "./app-accounts.ts";
+
+export const protectProvisionedConnection = (
+  sql: SqlClient.SqlClient,
+  input: Parameters<ResourceLifecycle["appAccountConnected"]>[0],
+  subject: string | null,
+) =>
+  Effect.gen(function* () {
+    yield* lockAppLinks(sql, input.app);
+    const links = yield* sql`select l.account from hosted_app_account_links l
+    join executor_apps app on app.id = l.app
+    join executor_deployments d on d.id = app.active_deployment
+    join executor_accounts a on a.id = l.account
+    where l.app = ${input.app} and l.requirement = ${input.requirement}
+      and ${subject === null ? sql`l.subject is null` : sql`l.subject = ${subject}`}
+      and l.account <> ${input.account.id}
+      and coalesce(d.requirements::jsonb -> 'accounts' -> ${input.requirement} ->> 'cardinality', 'one') <> 'many'
+      and d.requirements::jsonb -> 'accounts' -> ${input.requirement} -> 'definition' -> 'auth' -> a.method ->> 'provisioned' = 'true'`;
+    if (links.length > 0)
+      return yield* new AccountProvisioned({ provider: input.account.provider });
+  }).pipe(Effect.catchTag("SqlError", () => new StorageError()));
