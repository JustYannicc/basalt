+/** Validate display data against raw credentials before the SDK persists or returns it. */
+import { Effect, Schema } from "effect";
+import { AccountCheckResult, HostOutputInvalid } from "apps/contracts";
+import { accountFieldSecrets } from "@executor-js/utils/account-secrets";
+
+export const privateAccountCheck = (value: AccountCheckResult, accounts: unknown, ref?: string) =>
+  Effect.gen(function* () {
+    if (value.status !== undefined) {
+      const secrets = accountFieldSecrets(accounts, 1);
+      if (ref !== undefined && ref !== "") secrets.push(ref);
+      const strings = [
+        ...value.status.badges.flatMap((badge) => [badge.label, badge.tone]),
+        ...value.status.meters.flatMap((meter) => [
+          meter.label,
+          meter.detail ?? "",
+          meter.resetsAt ?? "",
+        ]),
+        ...value.status.stats.flatMap((stat) => [stat.label, stat.value]),
+      ];
+      if (strings.some((text) => secrets.some((secret) => text.includes(secret))))
+        return yield* new HostOutputInvalid();
+    }
+    return yield* Schema.decodeUnknownEffect(AccountCheckResult)(value).pipe(
+      Effect.mapError(() => new HostOutputInvalid()),
+    );
+  });
