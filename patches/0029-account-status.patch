@@ -0,0 +1,30 @@
+/** Refuse credential-bearing display data before it leaves a provider or app-owned check. */
+import { Effect, Redacted, Schema } from "effect";
+import { AccountCheckResult } from "../contracts/provider.ts";
+import { HostOutputInvalid, type HostContext } from "../contracts/host.ts";
+import { accountFieldSecrets } from "@executor-js/utils/account-secrets";
+
+export const accountCheckOutput = (value: unknown, context: HostContext, ref?: string) =>
+  Effect.gen(function* () {
+    const result = yield* Schema.decodeUnknownEffect(AccountCheckResult)(value).pipe(
+      Effect.mapError(() => new HostOutputInvalid()),
+    );
+    if (result.status !== undefined) {
+      const secrets = accountFieldSecrets(Redacted.value(context.accounts), 1);
+      if (ref !== undefined && ref !== "") secrets.push(ref);
+      const strings = [
+        ...result.status.badges.flatMap((badge) => [badge.label, badge.tone]),
+        ...result.status.meters.flatMap((meter) => [
+          meter.label,
+          meter.detail ?? "",
+          meter.resetsAt ?? "",
+        ]),
+        ...result.status.stats.flatMap((stat) => [stat.label, stat.value]),
+      ];
+      if (strings.some((text) => secrets.some((secret) => text.includes(secret))))
+        return yield* new HostOutputInvalid();
+    }
+    return yield* Schema.encodeEffect(AccountCheckResult)(result).pipe(
+      Effect.mapError(() => new HostOutputInvalid()),
+    );
+  });
