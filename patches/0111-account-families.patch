@@ -0,0 +1,71 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect } from "effect";
+import { TestLive, withCase } from "../support/case.ts";
+import { accountIdentityIssuer } from "../support/account-identity-issuer.ts";
+import { accountIdentityProduct } from "../support/account-identity-product.ts";
+import { credentialUpstream } from "../support/credential-upstream.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(TestLive, { excludeTestServices: true })("Account family credential hosts", (it) => {
+  it.effect(scenarios.accountFamilyHosts.title, (context) =>
+    withCase(
+      context,
+      Effect.gen(function* () {
+        const issuer = yield* accountIdentityIssuer;
+        const product = yield* accountIdentityProduct;
+        const first = yield* credentialUpstream;
+        const second = yield* credentialUpstream;
+        const provider = { name: "Same credential provider" };
+        const app = yield* product.deploy(
+          issuer.origin,
+          "First host consumer",
+          ["read"],
+          {},
+          undefined,
+          { ...provider, hosts: [new URL(first.origin).host] },
+          [],
+          first.origin,
+        );
+        const source = yield* product.connect(app);
+        expect((yield* product.read(app)).status).toBe(200);
+        const other = yield* product.deploy(
+          issuer.origin,
+          "Second host consumer",
+          ["read"],
+          {},
+          undefined,
+          { ...provider, hosts: [new URL(second.origin).host] },
+          [],
+          second.origin,
+        );
+        const connection = yield* product.connection(other);
+        expect((yield* product.reuseConnection(connection, source.id)).status).toBe("completed");
+        expect((yield* product.connectionAccount(connection)).id).toBe(source.id);
+        expect((yield* product.read(app)).status).toBe(200);
+        expect((yield* product.read(other)).status).toBe(200);
+        for (const [consumer, forbidden] of [
+          [app, second.origin],
+          [other, first.origin],
+        ] as const) {
+          const refused = yield* product.request("POST", "/v1/tools/call", {
+            app: consumer,
+            tool: "read",
+            input: { url: forbidden + "/resource" },
+          });
+          expect(refused.status).toBe(502);
+          expect(refused.body).toMatchObject({
+            _tag: "ToolCallFailed",
+            failure: { code: "credential_host" },
+          });
+        }
+        const originalRequests = yield* first.received;
+        const addedRequests = yield* second.received;
+        expect(originalRequests).toHaveLength(2);
+        expect(addedRequests).toHaveLength(1);
+        for (const request of [...originalRequests, ...addedRequests])
+          expect(request.authorization).toMatch(/^Bearer synthetic-access-/);
+        expect((yield* issuer.metrics).authorizations).toBe(1);
+      }),
+    ),
+  );
+});
diff --git a/e2e/tests/account-family-pools.spec.ts b/e2e/tests/account-family-pools.spec.ts
