+++ b/e2e/tests/account-family-pools.spec.ts
@@ -0,0 +1,205 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, FileSystem, Path, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { accountFamilyProviderBackend } from "../support/account-family-provider-backend.ts";
+import { providerAccountProduct } from "../support/provider-account-product.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Files = Schema.Array(Schema.Struct({ path: Schema.String, content: Schema.String }));
+const Deployed = Schema.Struct({
+  id: Schema.String,
+  requirements: Schema.Struct({
+    accounts: Schema.Record(Schema.String, Schema.Struct({ provider: Schema.String })),
+  }),
+});
+const Revision = Schema.Struct({ revision: Schema.String });
+
+layer(RuntimeLive, { excludeTestServices: true })("Account families across pools", (it) => {
+  it.effect(scenarios.accountFamilyPools.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          fs = yield* FileSystem.FileSystem,
+          path = yield* Path.Path;
+        const backend = yield* accountFamilyProviderBackend;
+        const directory = path.resolve("apps/hosted/cloud/.generated/pool-app");
+        const bundle = (yield* fs.readDirectory(directory)).filter((name) =>
+          /^pool-app-[a-f0-9]{64}\.json$/.test(name),
+        );
+        expect(bundle).toHaveLength(1);
+        const files = yield* Schema.decodeUnknownEffect(Schema.fromJsonString(Files))(
+          yield* fs.readFileString(path.join(directory, bundle[0]!)),
+        );
+        const managerSource = yield* Schema.decodeUnknownEffect(
+          Schema.fromJsonString(
+            Schema.Struct({ package: Schema.Literal("provider-openai"), files: Files }),
+          ),
+        )(yield* fs.readFileString(path.resolve("../src/catalog/provider-apps/openai.json")));
+        const definitions = files.find((file) => file.path === "provider-definitions.ts");
+        if (definitions === undefined)
+          return yield* Effect.die("Pool bundle has no canonical providers");
+        const capabilityConsumerFiles = (capability: string) => [
+          {
+            path: "index.ts",
+            content: `import { defineApp } from "apps";
+import { providers } from "./providers.ts";
+export default defineApp({ app: { accounts: { openai: providers.openai.many().requiring(${JSON.stringify(capability)}).contributed() } } }, {});`,
+          },
+          { path: "providers.ts", content: definitions.content },
+          appsManifest,
+        ];
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const apps: string[] = [],
+          accounts: string[] = [];
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* serverControl("start");
+            for (const app of apps)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app}`);
+            for (const account of accounts)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`);
+          }).pipe(Effect.orDie),
+        );
+        yield* providerAccountProduct(backend.origin);
+        const deploy = (name: string, source: typeof Files.Type) =>
+          Effect.gen(function* () {
+            const response = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+              name,
+              files: source,
+            });
+            expect(response.status, JSON.stringify(response.body)).toBe(200);
+            const app = yield* body(Deployed, response);
+            apps.push(app.id);
+            const appPath = `${prefix}/apps/${app.id}`;
+            const access = yield* body(
+              Revision,
+              yield* api.request(actors.owner, "GET", `${appPath}/access`),
+            );
+            expect(
+              (yield* api.request(actors.owner, "PATCH", `${appPath}/access`, {
+                revision: access.revision,
+                audience: { kind: "everyone" },
+              })).status,
+            ).toBe(200);
+            return { ...app, path: appPath };
+          });
+        const manager = yield* deploy("OpenAI account manager", managerSource.files);
+        const first = yield* deploy("First family pool", files);
+        const second = yield* deploy("Second family pool", files);
+        expect(first.requirements.accounts.openai?.provider).toBe(
+          manager.requirements.accounts.openai?.provider,
+        );
+        expect(second.requirements.accounts.openai?.provider).toBe(
+          manager.requirements.accounts.openai?.provider,
+        );
+        const Methods = Schema.Struct({
+          unavailable: Schema.Array(
+            Schema.Struct({ requirement: Schema.String, method: Schema.String }),
+          ),
+        });
+        const methods = (app: typeof manager) =>
+          Effect.gen(function* () {
+            const response = yield* api.request(
+              actors.owner,
+              "GET",
+              `${app.path}/accounts/methods`,
+            );
+            expect(response.status, JSON.stringify(response.body)).toBe(200);
+            return yield* body(Methods, response);
+          });
+        expect((yield* methods(manager)).unavailable).toEqual([
+          { requirement: "openai", method: "apiKey" },
+        ]);
+        for (const pool of [first, second]) {
+          const unavailable = (yield* methods(pool)).unavailable;
+          expect(unavailable).toContainEqual({ requirement: "openai", method: "apiKey" });
+          expect(unavailable).not.toContainEqual({ requirement: "openai", method: "codex" });
+        }
+        // Activation remains operator-owned; only this scenario's two actual pool apps are opted in.
+        yield* legacyStorage([
+          {
+            sql: "update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb), '{basaltPools}', $1::jsonb)::text where id = $2",
+            params: [
+              JSON.stringify({
+                first: { app: first.id, membership: "executor-links-v1" },
+                second: { app: second.id, membership: "executor-links-v1" },
+              }),
+              actors.organization.id,
+            ],
+          },
+        ]);
+        yield* serverControl("start");
+        const pending = yield* api.request(
+          actors.owner,
+          "POST",
+          `${manager.path}/accounts/app/openai/connections`,
+          {},
+        );
+        expect(pending.status, JSON.stringify(pending.body)).toBe(200);
+        const connection = (yield* body(Resource, pending)).id;
+        const connectPath = `${prefix}/connections/${connection}/interactive`;
+        expect(
+          (yield* api.request(actors.owner, "POST", `${connectPath}/start`, { method: "codex" }))
+            .status,
+        ).toBe(200);
+        const connected = yield* api.request(actors.owner, "POST", `${connectPath}/submit`, {
+          value: "http://localhost/done?code=synthetic",
+        });
+        expect(connected.status, JSON.stringify(connected.body)).toBe(200);
+        const saved = yield* body(Schema.Struct({ account: Resource }), connected);
+        const account = saved.account.id;
+        accounts.push(account);
+        const link = (app: typeof manager) =>
+          api.request(actors.owner, "PUT", `${app.path}/accounts/app/openai/${account}`);
+        for (const app of [first, second]) expect((yield* link(app)).status).toBe(200);
+        const linked = (app: typeof manager) =>
+          api.request(actors.owner, "GET", `${app.path}/accounts/app`);
+        for (const app of [manager, first, second]) {
+          const response = yield* linked(app);
+          expect(response.status).toBe(200);
+          expect(response.body).toMatchObject([
+            { requirement: "openai", account: { id: account } },
+          ]);
+        }
+        expect((yield* backend.calls).filter((call) => call.action === "start")).toHaveLength(1);
+        const unsupported = yield* deploy(
+          "Unavailable family capability",
+          capabilityConsumerFiles("unregistered-capability"),
+        );
+        const refused = yield* link(unsupported);
+        expect(refused.status, JSON.stringify(refused.body)).toBe(422);
+        expect(refused.body).toMatchObject({ _tag: "AuthMethodInvalid" });
+        expect((yield* linked(unsupported)).body).toEqual([]);
+        expect(
+          (yield* api.request(
+            actors.owner,
+            "DELETE",
+            `${first.path}/accounts/app/openai/${account}`,
+          )).status,
+        ).toBe(200);
+        expect((yield* linked(first)).body).toEqual([]);
+        expect((yield* linked(second)).body).toMatchObject([
+          {
+            requirement: "openai",
+            account: { id: account },
+          },
+        ]);
+        expect((yield* linked(manager)).body).toMatchObject([{ account: { id: account } }]);
+        const retained = yield* api.request(actors.owner, "GET", `${prefix}/accounts/${account}`);
+        expect(retained.status).toBe(200);
+        expect(retained.body).toMatchObject({ account: { id: account, method: "codex" } });
+        expect((yield* backend.calls).filter((call) => call.action === "start")).toHaveLength(1);
+        expect((yield* backend.calls).filter((call) => call.action === "remove")).toHaveLength(0);
+      }),
+    ),
+  );
+});
