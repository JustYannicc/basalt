@@ -0,0 +1,241 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { createHash } from "node:crypto";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { serverControl } from "../support/server-control.ts";
+import { TestLive, withCase } from "../support/case.ts";
+import { accountIdentityIssuer } from "../support/account-identity-issuer.ts";
+import { accountIdentityProduct } from "../support/account-identity-product.ts";
+import { accountFamilyProduct } from "../support/account-family-product.ts";
+import { body } from "../support/api.ts";
+import { scenarios } from "../test-plan.ts";
+
+// Earlier provider IDs hashed the declaration as canonical JSON, including authored identity.
+const legacyContent = (value: typeof Schema.Json.Type): string =>
+  Array.isArray(value)
+    ? `[${value.map(legacyContent).join(",")}]`
+    : value !== null && typeof value === "object"
+      ? `{${Object.entries(value)
+          .sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0))
+          .map(([key, item]) => `${JSON.stringify(key)}:${legacyContent(item)}`)
+          .join(",")}}`
+      : JSON.stringify(value);
+
+layer(TestLive, { excludeTestServices: true })("Account families", (it) => {
+  it.effect(scenarios.accountFamilyProfile.title, (context) =>
+    withCase(
+      context,
+      Effect.gen(function* () {
+        const issuer = yield* accountIdentityIssuer;
+        yield* issuer.configure({ discoveryFails: true });
+        yield* accountFamilyProduct(issuer.origin);
+        const product = yield* accountIdentityProduct;
+        const family = {
+          id: "fixture-family",
+          name: "Shared service",
+          methods: { oauth: { mechanism: "oauth" } },
+        };
+        const app = yield* product.deploy(issuer.origin, "Family reader", ["read"]);
+        const source = yield* product.connect(app);
+        expect(source.identity).toBeDefined();
+        expect(source.label).toBe("same@example.test");
+        yield* product.deploy(issuer.origin, "Family reader", ["read"], {}, app, {
+          family: { ...family, name: "Renamed service" },
+        });
+        expect((yield* product.read(app)).status).toBe(200);
+        const retained = yield* body(
+          Schema.Struct({ id: Schema.String, provider: Schema.String }),
+          yield* product.request("GET", `/v1/accounts/${source.id}`),
+        );
+        expect(retained).toEqual({ id: source.id, provider: source.provider });
+        const current = yield* body(
+          Schema.Struct({ provider: Schema.Struct({ id: Schema.String }) }),
+          yield* product.request(
+            "GET",
+            `/v1/account-connections/${yield* product.connection(app)}`,
+          ),
+        );
+        expect(current.provider.id).toBe(source.provider);
+        const second = yield* product.deploy(
+          issuer.origin,
+          "Family second app",
+          ["read"],
+          {},
+          undefined,
+          { family },
+        );
+        const pending = yield* product.connection(second);
+        const plan = yield* body(
+          Schema.Struct({ status: Schema.String }),
+          yield* product.request("POST", "/v1/account-connections/oauth/plan", {
+            connection: pending,
+            method: "oauth",
+            sourceAccount: source.id,
+          }),
+        );
+        expect(plan.status).toBe("reuse");
+        const reused = yield* product.reuseConnection(pending, source.id);
+        expect(reused.status).toBe("completed");
+        expect((yield* product.connectionAccount(pending)).identity?.id).toBe(source.identity?.id);
+        expect((yield* product.read(second)).status).toBe(200);
+        expect((yield* issuer.metrics).authorizations).toBe(1);
+        const savedBefore = (yield* product.request("GET", "/v1/accounts")).body;
+        const exact = yield* product.deploy(
+          issuer.origin,
+          "Exact provider consumer",
+          ["read"],
+          {},
+          undefined,
+          { family, name: "Family reader" },
+        );
+        const exactConnection = yield* product.connection(exact);
+        const exactProvider = yield* body(
+          Schema.Struct({ provider: Schema.Struct({ id: Schema.String }) }),
+          yield* product.request("GET", `/v1/account-connections/${exactConnection}`),
+        );
+        expect(exactProvider.provider.id).toBe(source.provider);
+        const exactReuse = yield* product.reuseConnection(exactConnection, source.id);
+        expect(exactReuse.status).toBe("completed");
