+        const pending = yield* product.connection(consumer);
+        const unavailable = yield* product.request("POST", "/v1/account-connections/oauth/plan", {
+          connection: pending,
+          method: "oauth",
+          sourceAccount: source.id,
+        });
+        expect(unavailable.status).toBe(422);
+        expect(unavailable.body).toMatchObject({ _tag: "AuthMethodInvalid" });
+        const blockedStart = yield* product.request("POST", "/v1/account-connections/oauth/start", {
