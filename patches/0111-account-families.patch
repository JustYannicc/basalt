+import { Effect } from "effect";
+import { AccountAcquisitionConfiguration } from "../contracts/account-acquisition-driver.ts";
+import { planAccountConsumerMethod } from "../contracts/account-consumers.ts";
+import { AuthMethodInvalid } from "../contracts/provider.ts";
+import { AccountConnectionTargetChanged } from "../contracts/account-connection.ts";
+import type { StoredConnectionTarget } from "../contracts/storage.ts";
+import type { ProviderId } from "../contracts/shared.ts";
+import { storedApp, storedVersion } from "./apps.ts";
+import type { Query } from "./database.ts";
+
+/** Read the consumer's current requirements before contacting an authorization or acquisition service. */
+export const requireAccountConsumerMethod = (
+  db: Query,
+  target: StoredConnectionTarget,
+  provider: ProviderId,
+  method: string,
+) =>
+  Effect.gen(function* () {
+    const app = yield* storedApp(db, { app: target.app, owner: target.owner });
+    const version = yield* storedVersion(db, app);
+    const required = Object.hasOwn(version.requirements.accounts, target.requirement)
+      ? version.requirements.accounts[target.requirement]
+      : undefined;
+    if (required === undefined || required.provider !== provider || required.scope !== target.scope)
+      return yield* new AccountConnectionTargetChanged({
+        app: target.app,
+        requirement: target.requirement,
+      });
+    const { registrations } = yield* AccountAcquisitionConfiguration;
+    const plan = planAccountConsumerMethod(required, method, registrations);
+    if (plan.status === "unavailable") return yield* new AuthMethodInvalid({ provider, method });
+    return plan;
+  }).pipe(
+    Effect.catchTags({
+      AppNotFound: () =>
+        new AccountConnectionTargetChanged({ app: target.app, requirement: target.requirement }),
+      AppNotDeployed: () =>
+        new AccountConnectionTargetChanged({ app: target.app, requirement: target.requirement }),
+      VersionNotFound: () =>
+        new AccountConnectionTargetChanged({ app: target.app, requirement: target.requirement }),
+    }),
+  );
