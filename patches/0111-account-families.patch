+/** Reviewed authorization metadata. Families never establish identity without authenticated proof. */
+export interface OAuthAccountFamilyRecipe {
+  readonly id: string;
+  readonly name: string;
+  readonly issuer: string;
+  /** Keep identity defaults only where earlier hosts already inserted them. */
+  readonly legacyIdentity?: true;
+  readonly authorizationUrls: readonly string[];
+  readonly tokenUrls: readonly string[];
+  readonly discoveryUrls?: readonly string[];
+  readonly consent?: {
+    /** Shared authorization endpoints can serve APIs with different identity scopes. */
+    readonly audience?: string;
+    readonly scopes: readonly string[];
+    readonly authorizationParams?: Readonly<Record<string, string>>;
+  };
+  readonly scopeAliases?: Readonly<Record<string, string>>;
+  /** Reviewed permission names that may appear in saved failures and native logs. */
+  readonly diagnosticScopes?: readonly string[];
+  readonly profile?: {
+    readonly url: string;
+    readonly subjectField: string;
+    readonly labelFields: readonly string[];
+  };
+}
+
+export const defaultAccountFamilies: readonly OAuthAccountFamilyRecipe[] = [
+  {
