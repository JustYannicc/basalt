@@ -0,0 +1,55 @@
+import { Schema } from "effect";
+import { AccountCredentialMechanism } from "apps/contracts";
+import type { AccountRequirement } from "./apps.ts";
+import type { AccountAcquisitionRegistration } from "./account-acquisition-driver.ts";
+
+/** Method availability precedes account selection. It is not proof of grant coverage or health. */
+export const AccountConsumerMethodPlan = Schema.Struct({
+  method: Schema.NonEmptyString,
+  mechanism: AccountCredentialMechanism,
+  status: Schema.Literals(["available", "unavailable"]),
+  capabilities: Schema.Array(Schema.NonEmptyString),
+  missingCapabilities: Schema.Array(Schema.NonEmptyString),
+  reason: Schema.optionalKey(Schema.NonEmptyString),
+});
+export type AccountConsumerMethodPlan = typeof AccountConsumerMethodPlan.Type;
+
+/** The same planner runs for management apps, ordinary tools and capability-requiring consumers. */
+export const planAccountConsumerMethod = (
+  requirement: AccountRequirement,
+  method: string,
+  registrations: readonly AccountAcquisitionRegistration[],
+): AccountConsumerMethodPlan => {
+  const auth = Object.hasOwn(requirement.definition.auth, method)
+    ? requirement.definition.auth[method]
+    : undefined;
+  const capabilities = [...new Set(requirement.capabilities ?? [])].sort();
+  const candidates = registrations.filter(
+    (entry) => entry.current && entry.provider === requirement.provider && entry.method === method,
+  );
+  const registration = candidates.length === 1 ? candidates[0] : undefined;
+  const missingCapabilities = capabilities.filter(
+    (capability) => !registration?.capabilities?.includes(capability),
+  );
+  const mechanism =
+    requirement.definition.family?.methods?.[method]?.mechanism ??
+    (auth?.type === "oauth2" ? "oauth" : auth?.type === "interactive" ? "interactive" : "other");
+  const reason =
+    auth === undefined
+      ? "This app no longer declares this connection method."
+      : auth.type === "secrets" && auth.provisioned === true
+        ? "The host provisions this account."
+        : requirement.hostAcquisition?.includes(method) === true && registration === undefined
+          ? "This host cannot acquire this sign-in method right now."
+          : missingCapabilities.length > 0
+            ? "This connection method does not support this app's required capabilities."
+            : undefined;
+  return {
+    method,
+    mechanism,
+    capabilities,
+    missingCapabilities,
+    status: reason === undefined ? "available" : "unavailable",
+    ...(reason === undefined ? {} : { reason }),
+  };
+};
