diff --git a/packages/sdk/src/implementation/oauth-scope-evidence.ts b/packages/sdk/src/implementation/oauth-scope-evidence.ts
new file mode 100644
index 00000000..ba983ea3
--- /dev/null
+++ b/packages/sdk/src/implementation/oauth-scope-evidence.ts
@@ -0,0 +1,31 @@
+import type { OAuthAccountFamilyRecipe } from "../contracts/account-family-recipes.ts";
+
+/** Provider-authored strings never enter recorded failures or logs without host review. */
+export const oauthScopeEvidence = (
+  issuer: string | undefined,
+  requested: readonly string[],
+  granted: readonly string[] | undefined,
+  missing: readonly string[],
+  scopeNames: readonly string[],
+  recipes: readonly OAuthAccountFamilyRecipe[],
+) => {
+  const recipe = recipes.find((entry) => entry.issuer === issuer);
+  const allowed = new Set([
+    ...scopeNames,
+    ...(recipe?.diagnosticScopes ?? []),
+    ...Object.keys(recipe?.scopeAliases ?? {}),
+    ...Object.values(recipe?.scopeAliases ?? {}),
+  ]);
+  const names = (scopes: readonly string[]) => [
+    ...new Set(scopes.filter((scope) => allowed.has(scope))),
+  ];
+  return {
+    requestedScopes: names(requested),
+    ...(granted === undefined ? {} : { grantedScopes: names(granted) }),
+    missingScopes: names(missing),
+    grantedScopesKnown: granted !== undefined,
+    scopeNamesOmitted: [...requested, ...(granted ?? []), ...missing].some(
+      (scope) => !allowed.has(scope),
+    ),
+  };
+};
