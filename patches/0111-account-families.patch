diff --git a/packages/apps/src/contracts/account-family.ts b/packages/apps/src/contracts/account-family.ts
new file mode 100644
index 00000000..d9a6655a
--- /dev/null
+++ b/packages/apps/src/contracts/account-family.ts
@@ -0,0 +1,27 @@
+import { Schema } from "effect";
+
+/** How credentials are acquired, independently of subscription, plan or usage entitlement. */
+export const AccountCredentialMechanism = Schema.Literals([
+  "api-key",
+  "oauth",
+  "interactive",
+  "other",
+]);
+/** A credential mechanism never establishes a consumer's readiness or granted permissions. */
+export type AccountCredentialMechanism = typeof AccountCredentialMechanism.Type;
+
+/** Groups compatible sign-ins for discovery. It does not grant access or identify a person. */
+export const AccountFamily = Schema.Struct({
+  id: Schema.NonEmptyString,
+  name: Schema.NonEmptyString,
+  methods: Schema.optionalKey(
+    Schema.Record(
+      Schema.NonEmptyString,
+      Schema.Struct({
+        mechanism: AccountCredentialMechanism,
+      }),
+    ),
+  ),
+});
+/** Display and discovery metadata for several consumers of compatible saved accounts. */
+export type AccountFamily = typeof AccountFamily.Type;
