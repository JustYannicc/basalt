new file mode 100644
index 0000000..98dfbf4
--- /dev/null
+++ b/packages/sdk/src/contracts/account-family-recipes.ts
@@ -0,0 +1,75 @@
+import { Context } from "effect";
+
+/** Reviewed authorization metadata. Families never establish identity without authenticated proof. */
+export interface OAuthAccountFamilyRecipe {
+  readonly id: string;
+  readonly name: string;
+  readonly issuer: string;
+  /** Keep identity defaults only where earlier hosts already inserted them. */
+  readonly legacyIdentity?: true;
+  readonly authorizationUrls: readonly string[];
+  readonly tokenUrls: readonly string[];
+  readonly discoveryUrls?: readonly string[];
+  readonly consent?: {
+    /** Shared authorization endpoints can serve APIs with different identity scopes. */
+    readonly audience?: string;
+    readonly scopes: readonly string[];
+    readonly authorizationParams?: Readonly<Record<string, string>>;
+  };
+  readonly scopeAliases?: Readonly<Record<string, string>>;
+  readonly profile?: {
+    readonly url: string;
+    readonly subjectField: string;
+    readonly labelFields: readonly string[];
+  };
+}
+
+export const defaultAccountFamilies: readonly OAuthAccountFamilyRecipe[] = [
+  {
+    id: "google",
+    name: "Google",
+    issuer: "https://accounts.google.com",
+    legacyIdentity: true,
+    discoveryUrls: [
+      "https://accounts.google.com",
+      "https://accounts.google.com/",
+      "https://accounts.google.com/.well-known/openid-configuration",
+    ],
+    authorizationUrls: [
+      "https://accounts.google.com/o/oauth2/v2/auth",
+      "https://accounts.google.com/o/oauth2/auth",
+    ],
+    tokenUrls: [
+      "https://oauth2.googleapis.com/token",
+      "https://accounts.google.com/o/oauth2/token",
+    ],
+    consent: {
+      scopes: ["openid", "email"],
+      authorizationParams: { include_granted_scopes: "true" },
+    },
+    scopeAliases: {
+      email: "https://www.googleapis.com/auth/userinfo.email",
+      profile: "https://www.googleapis.com/auth/userinfo.profile",
+    },
+  },
+  {
+    id: "atlassian",
+    name: "Atlassian",
+    issuer: "https://auth.atlassian.com",
+    authorizationUrls: ["https://auth.atlassian.com/authorize"],
+    tokenUrls: ["https://auth.atlassian.com/oauth/token"],
+    consent: { audience: "api.atlassian.com", scopes: ["read:me"] },
+    profile: {
+      url: "https://api.atlassian.com/me",
+      subjectField: "account_id",
+      labelFields: ["email", "name"],
+    },
+  },
+];
+
+/** Host composition supplies reviewed recipes; apps may select a family but cannot register one. */
+export const AccountFamilyConfiguration = Context.Reference<{
+  readonly recipes: readonly OAuthAccountFamilyRecipe[];
+}>("executor/AccountFamilyConfiguration", {
+  defaultValue: () => ({ recipes: defaultAccountFamilies }),
+});
