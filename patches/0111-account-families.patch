diff --git a/e2e/tests/hosted-scope-refusal.spec.ts b/e2e/tests/hosted-scope-refusal.spec.ts
new file mode 100644
index 00000000..2ca4ea29
--- /dev/null
+++ b/e2e/tests/hosted-scope-refusal.spec.ts
@@ -0,0 +1,294 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { FetchHttpClient, HttpClient } from "effect/http";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { accountIdentityIssuer } from "../support/account-identity-issuer.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { connectionsPath } from "../support/app-accounts.ts";
+import { googleOAuthProduct } from "../support/google-oauth-product.ts";
+import { Evidence } from "../support/evidence.ts";
+import { scenarios } from "../test-plan.ts";
+
+const docs = "https://www.googleapis.com/auth/documents";
+const drive = "https://www.googleapis.com/auth/drive";
+const requested = ["email", docs, drive, "openid"].sort();
+const partialGrant = ["openid", "email", docs];
+const Failure = Schema.Struct({
+  requestedScopes: Schema.Array(Schema.String),
+  grantedScopes: Schema.optionalKey(Schema.Array(Schema.String)),
+  missingScopes: Schema.Array(Schema.String),
+  grantedScopesKnown: Schema.Boolean,
+  scopeNamesOmitted: Schema.Boolean,
+});
+const Connection = Schema.Struct({
+  state: Schema.Struct({
+    status: Schema.String,
+    failure: Schema.Struct({ error: Failure }),
+  }),
+});
+
+layer(HostedLive, { excludeTestServices: true })("Hosted scope refusal", (it) => {
+  it.effect(scenarios.hostedScopeRefusal.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          browser = yield* Browser,
+          issuer = yield* accountIdentityIssuer,
+          http = yield* HttpClient.HttpClient,
+          evidence = yield* Evidence;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const google = yield* googleOAuthProduct(issuer.origin);
+        const deploy = (name: string, scope: string) =>
+          Effect.gen(function* () {
+            const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+              name,
+              files: [
+                appsManifest,
+                {
+                  path: "index.ts",
+                  content: `import { defineApp, defineProvider, oauth2, router } from "apps";
+const service = defineProvider({ name: ${JSON.stringify(name)}, auth: { oauth: oauth2({
+  authorizationUrl: "https://accounts.google.com/o/oauth2/v2/auth",
+  tokenUrl: "https://oauth2.googleapis.com/token",
+  identity: { issuer: "https://accounts.google.com", name: "Google" },
+  scopes: [${JSON.stringify(scope)}], tokenEndpointAuthMethod: "client_secret_post"
+}) } });
+export default defineApp({ user: { accounts: { service } } }, { tools: router({}) });`,
+                },
+              ],
+            });
+            expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+            const app = yield* body(Resource, deployed);
+            yield* Effect.addFinalizer(() =>
+              api.request(actors.owner, "DELETE", `${prefix}/apps/${app.id}`).pipe(Effect.orDie),
+            );
+            return yield* body(
+              Resource,
+              yield* api.request(
+                actors.owner,
+                "POST",
+                connectionsPath(`${prefix}/apps/${app.id}`, "user", "service"),
+                {},
+              ),
+            );
+          });
+        const primary = yield* deploy("Fixture Docs", docs);
+        const additional = yield* deploy("Fixture Drive", drive);
+        const start = (
+          secondary = additional.id,
+          client?: { readonly clientId: string; readonly clientSecret: string },
+        ) =>
+          Effect.gen(function* () {
+            const response = yield* api.request(
+              actors.owner,
+              "POST",
+              `${prefix}/connections/${primary.id}/oauth/start`,
+              {
+                method: "oauth",
+                additionalConnections: [{ connection: secondary, method: "oauth" }],
+                ...(client === undefined ? {} : { client }),
+              },
+            );
+            expect(response.status, JSON.stringify(response.body)).toBe(200);
+            const authorization = yield* body(
+              Schema.Struct({ authorizationUrl: Schema.String }),
+              response,
+            );
+            const url = new URL(authorization.authorizationUrl);
+            expect(url.origin + url.pathname).toBe("https://accounts.google.com/o/oauth2/v2/auth");
+            expect(url.searchParams.get("include_granted_scopes")).toBe("true");
+            // Only Google's HTTP side is simulated; client selection, recipe and callbacks are real.
+            const consent = new URL("/authorize", issuer.origin);
+            consent.search = url.search;
+            const callback = yield* Effect.scoped(
+              Effect.gen(function* () {
+                const answer = yield* HttpClient.withScope(http).get(consent.href);
+                expect(answer.status).toBe(302);
+                const location = answer.headers.location;
+                if (location === undefined) return yield* Effect.die("Issuer omitted its callback");
+                return new URL(location);
+              }),
+            ).pipe(Effect.provideService(FetchHttpClient.RequestInit, { redirect: "manual" }));
+            return { ...authorization, callbackPath: `/oauth/callback${callback.search}` };
+          });
+        yield* browser.omitNetworkTrace;
+        yield* browser.login(actors.owner);
+        yield* issuer.configure({ scopes: partialGrant });
+        const partial = yield* start();
+        expect(new URL(partial.authorizationUrl).searchParams.get("client_id")).toBe(
+          "scope-fixture-client.apps.googleusercontent.com",
+        );
+        yield* browser.use("Complete a partial operator-client grant", (page) =>
+          page
+            .goto(partial.callbackPath)
+            .then(() => page.getByText("Not granted", { exact: true }).waitFor()),
+        );
+        yield* browser.use("Open exact requested and granted access", (page) =>
+          page.getByText("Access details", { exact: true }).click(),
+        );
+        for (const [label, expected] of [
+          ["Requested", requested],
+          ["Granted", partialGrant],
+        ] as const) {
+          const values = yield* browser.use("Read the exact scope comparison", (page) => {
+            const detail = page
+              .locator("details")
+              .filter({ has: page.getByText("Access details", { exact: true }) });
+            return detail
+              .locator("dl > div")
+              .filter({ has: page.getByText(label, { exact: true }) })
+              .locator("dd li > span:last-child")
+              .allTextContents();
+          });
+          expect(values.sort()).toEqual([...expected].sort());
+        }
+        expect(
+          yield* browser.use("A known partial grant offers consent recovery", (page) =>
+            page.getByRole("link", { name: "Grant access again", exact: true }).isVisible(),
+          ),
+        ).toBe(true);
+        yield* browser.use("Explain permission selection before retrying", (page) =>
+          page
+            .getByText("On the consent screen, select every permission listed above.", {
+              exact: false,
+            })
+            .waitFor(),
+        );
+        const failed = yield* body(
+          Connection,
+          yield* api.request(actors.owner, "GET", `${prefix}/connections/${primary.id}`),
+        );
+        expect(failed.state).toMatchObject({
+          status: "pending",
+          failure: {
+            error: {
+              requestedScopes: requested,
+              grantedScopes: partialGrant,
+              missingScopes: [drive],
+              grantedScopesKnown: true,
+              scopeNamesOmitted: false,
+            },
+          },
+        });
+        yield* browser.checkpoint("Hosted operator-client refusal names exact missing access");
+        yield* issuer.configure({ omitScopes: true });
+        const unknown = yield* start();
+        yield* browser.use("An unreported grant needs diagnosis before retry", (page) =>
+          page
+            .goto(unknown.callbackPath)
+            .then(() =>
+              page
+                .getByText("The service did not report its granted permissions.", { exact: false })
+                .waitFor(),
+            ),
+        );
+        expect(
+          yield* browser.use("The hosted page withholds a blind retry", (page) =>
+            page.getByRole("link", { name: "Grant access again", exact: true }).count(),
+          ),
+        ).toBe(0);
+        expect(
+          yield* browser.use("Unknown access never claims permissions were denied", (page) =>
+            page.getByText("Not granted", { exact: true }).count(),
+          ),
+        ).toBe(0);
+        yield* browser.use("Explain recovery when grants are unreported", (page) =>
+          page
+            .getByText(
+              "Ask the app owner to check the service's token response before trying again.",
+              {
+                exact: false,
+              },
+            )
+            .waitFor(),
+        );
+        const unreported = yield* body(
+          Connection,
+          yield* api.request(actors.owner, "GET", `${prefix}/connections/${primary.id}`),
+        );
+        expect(unreported.state.failure.error).toEqual({
+          requestedScopes: requested,
+          missingScopes: requested,
+          grantedScopesKnown: false,
+          scopeNamesOmitted: false,
+        });
+        yield* browser.checkpoint("Hosted unreported scopes stop blind retries");
+
+        const withheldScope = "unreviewed-sensitive-scope";
+        const withheld = yield* deploy("Unreviewed service", withheldScope);
+        yield* issuer.configure({ omitScopes: false, scopes: ["openid", "email", docs] });
+        const incomplete = yield* start(withheld.id, {
+          clientId: "entered-google-client.apps.googleusercontent.com",
+          clientSecret: "entered-google-secret",
+        });
+        yield* browser.use("Hidden permission names require app-owner diagnosis", (page) =>
+          page.goto(incomplete.callbackPath).then(() =>
+            page
+              .getByText("Some permission names are not recognised by this host and are hidden.", {
+                exact: false,
+              })
+              .waitFor(),
+          ),
+        );
+        expect(
+          yield* browser.use("The hosted page withholds retry for incomplete names", (page) =>
+            page.getByRole("link", { name: "Grant access again", exact: true }).count(),
+          ),
+        ).toBe(0);
+        yield* browser.use("Open the incomplete evidence", (page) =>
+          page.getByText("Access details", { exact: true }).click(),
+        );
+        expect(
+          yield* browser.use("Unreviewed permission names stay hidden", (page) =>
+            page.locator("body").textContent(),
+          ),
+        ).not.toContain(withheldScope);
+        yield* browser.use("State the app-owner recovery step", (page) =>
+          page
+            .getByText(
+              "Ask the app owner to review its permission configuration before trying again.",
+              {
+                exact: false,
+              },
+            )
+            .waitFor(),
+        );
+        const incompleteFailure = yield* body(
+          Connection,
+          yield* api.request(actors.owner, "GET", `${prefix}/connections/${primary.id}`),
+        );
+        expect(incompleteFailure.state.failure.error).toEqual({
+          requestedScopes: ["email", docs, "openid"].sort(),
+          grantedScopes: ["openid", "email", docs],
+          missingScopes: [],
+          grantedScopesKnown: true,
+          scopeNamesOmitted: true,
+        });
+        yield* browser.checkpoint("Hosted withheld scope names stop blind retries");
+        const requests = yield* google.requests;
+        expect(
+          requests.filter(
+            ({ host, path }) => host === "oauth2.googleapis.com" && path === "/token",
+          ),
+        ).toHaveLength(3);
+        expect(requests).toContainEqual({
+          method: "GET",
+          host: "accounts.google.com",
+          path: "/.well-known/openid-configuration",
+        });
+        expect(requests).toContainEqual({
+          method: "GET",
+          host: "openidconnect.googleapis.com",
+          path: "/v1/userinfo",
+        });
+        yield* evidence.json("google-oauth-transport.json", requests);
+      }),
+    ),
+  );
+});
