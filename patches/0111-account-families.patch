+++ b/e2e/support/account-family-product.ts
@@ -0,0 +1,56 @@
+import { Effect, FileSystem, Path } from "effect";
+import { ChildProcess, ChildProcessSpawner } from "effect/process";
+import { Target } from "./platform.ts";
+import { serverControl } from "./server-control.ts";
+
+/** Register a reviewed recipe through the public host capability on the complete local product. */
+export const accountFamilyProduct = (origin: string) =>
+  Effect.gen(function* () {
+    const target = yield* Target,
+      fs = yield* FileSystem.FileSystem,
+      path = yield* Path.Path;
+    const entry = path.join(target.directory, "account-family-product.ts");
+    yield* fs.writeFileString(
+      entry,
+      `
+import * as Runtime from "@effect/platform-node/NodeRuntime";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { launch } from "@executor-js/local-server";
+import { AccountFamilyConfiguration, defaultAccountFamilies } from "@executor-js/sdk/core";
+import { Effect } from "effect";
+Runtime.runMain(Effect.scoped(launch("headless", process.platform)).pipe(Effect.provide(NodeServices.layer),
+  Effect.provideService(AccountFamilyConfiguration, { recipes: [...defaultAccountFamilies, {
+    id: "fixture-family", name: "Fixture family", issuer: ${JSON.stringify(origin)},
+    authorizationUrls: [${JSON.stringify(origin + "/authorize")}], tokenUrls: [${JSON.stringify(origin + "/token")}],
+    diagnosticScopes: ["read", "write", "organize"],
+    profile: { url: ${JSON.stringify(origin + "/profile")}, subjectField: "account_id", labelFields: ["email"] },
+  }] })));
+`,
+    );
+    const links = path.join(target.directory, "node_modules", "@executor-js");
+    yield* fs.makeDirectory(links, { recursive: true });
+    const product = path.join(links, "local-server");
+    if (!(yield* fs.exists(product))) yield* fs.symlink(path.resolve("apps/local/server"), product);
+    const config = path.join(target.directory, "account-family-product.json");
+    yield* fs.writeFileString(
+      config,
+      JSON.stringify({
+        extends: path.resolve("tsconfig.json"),
+        compilerOptions: { typeRoots: [path.resolve("node_modules/@types")] },
+        files: [entry],
+        include: [],
+        exclude: [],
+      }),
+    );
+    const processes = yield* ChildProcessSpawner.ChildProcessSpawner;
+    const checked = yield* processes.exitCode(
+      ChildProcess.make(path.resolve("node_modules/.bin/tsc-rs"), ["--noEmit", "-p", config], {
+        stdout: "inherit",
+        stderr: "inherit",
+      }),
+    );
+    if (checked !== 0) return yield* Effect.die("Family product failed its public API typecheck");
+    yield* serverControl("stop");
+    yield* serverControl("environment", 200, { EXECUTOR_E2E_PRODUCT_ENTRY: entry });
+    yield* serverControl("start");
+  });
diff --git a/e2e/support/account-family-provider-backend.ts b/e2e/support/account-family-provider-backend.ts
new file mode 100644
index 00000000..6ac20386
--- /dev/null
+++ b/e2e/support/account-family-provider-backend.ts
@@ -0,0 +1,71 @@
+/** A signed external acquisition service, used by the production provider registration. */
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Clock, Effect, Layer, Ref, Schema } from "effect";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { createHmac, timingSafeEqual } from "node:crypto";
+import { createServer } from "node:http";
+
+const Command = Schema.Struct({
+  action: Schema.String,
+  provider: Schema.String,
+  owner: Schema.String,
+  at: Schema.Number,
+  expiresAt: Schema.Number,
+});
+
+export const accountFamilyProviderBackend = Effect.gen(function* () {
+  const calls = yield* Ref.make<readonly (typeof Command.Type)[]>([]);
+  const routes = Layer.mergeAll(
+    HttpRouter.add(
+      "POST",
+      "/pool/v1/account-acquisitions",
+      Effect.gen(function* () {
+        const { envelope } = yield* HttpServerRequest.schemaBodyJson(
+          Schema.Struct({ envelope: Schema.String }),
+        );
+        const [prefix, payload, signature, extra] = envelope.split(".");
+        if (
+          prefix !== "sbaa1" ||
+          payload === undefined ||
+          signature === undefined ||
+          extra !== undefined
+        )
+          return HttpServerResponse.empty({ status: 401 });
+        const expected = createHmac("sha256", Buffer.from("ab".repeat(32), "hex"))
+          .update(`${prefix}.${payload}`)
+          .digest();
+        const actual = Buffer.from(signature, "base64url");
+        if (actual.length !== expected.length || !timingSafeEqual(actual, expected))
+          return HttpServerResponse.empty({ status: 401 });
+        const command = yield* Schema.decodeUnknownEffect(Schema.fromJsonString(Command))(
+          Buffer.from(payload, "base64url").toString(),
+        );
+        const now = yield* Clock.currentTimeMillis;
+        if (command.at > now || command.expiresAt <= now || command.expiresAt > command.at + 30_000)
+          return HttpServerResponse.empty({ status: 401 });
+        yield* Ref.update(calls, (items) => [...items, command]);
+        if (command.action === "start")
+          return HttpServerResponse.jsonUnsafe({
+            session: "private-family-session",
+            paste: { label: "Callback URL" },
+          });
+        if (command.action === "submit" || command.action === "status")
+          return HttpServerResponse.jsonUnsafe({
+            state: "connected",
+            ref: "private-family-reference",
+          });
+        return HttpServerResponse.jsonUnsafe(null);
+      }),
+    ),
+    HttpRouter.add("POST", "/pool/v1/membership", Effect.succeed(HttpServerResponse.empty())),
+    HttpRouter.add("POST", "/pool/v1/access", Effect.succeed(HttpServerResponse.empty())),
+  );
+  const context = yield* Layer.build(
+    HttpRouter.serve(routes, { disableLogger: true, disableListenLog: true }).pipe(
+      Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 })),
+    ),
+  );
+  const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(context));
+  if (!("port" in server.address)) return yield* Effect.die("Expected a TCP acquisition fixture");
+  return { origin: `http://127.0.0.1:${server.address.port}`, calls: Ref.get(calls) };
+});
