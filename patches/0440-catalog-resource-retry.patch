diff --git a/apps/hosted/server/src/implementation/catalog-build-failure.ts b/apps/hosted/server/src/implementation/catalog-build-failure.ts
new file mode 100644
index 0000000..8980a6c
--- /dev/null
+++ b/apps/hosted/server/src/implementation/catalog-build-failure.ts
@@ -0,0 +1,53 @@
+/** Resource failures leave catalog source undecided and use the provisioning job's retry. */
+import {
+  BuildBusy,
+  BuildMemoryExceeded,
+  BuildUnanswered,
+  VersionBuildFailed,
+  type AppId,
+} from "@executor-js/sdk/core";
+import { Cause, Effect, ErrorReporter, Option, Schema } from "effect";
+import type { OrganizationId } from "../contracts/organization.ts";
+
+/** Background compiler exhaustion is an operational incident, not a deployer's 4xx rejection. */
+class CatalogBuildResourceFailed extends Schema.TaggedError<CatalogBuildResourceFailed>()(
+  "CatalogBuildResourceFailed",
+  {},
+) {}
+
+export const reportCatalogResourceFailure = (
+  error: unknown,
+  input: {
+    readonly organization: OrganizationId;
+    readonly app: AppId;
+    readonly entry: string;
+    readonly phase: "requirements" | "deployment";
+  },
+) =>
+  Effect.gen(function* () {
+    const cause = Schema.is(BuildMemoryExceeded)(error)
+      ? "memory"
+      : Schema.is(BuildBusy)(error)
+        ? "capacity"
+        : Schema.is(BuildUnanswered)(error) ||
+            (Schema.is(VersionBuildFailed)(error) && error.unanswered === true)
+          ? "unanswered"
+          : undefined;
+    if (cause === undefined) return;
+    const span = yield* Effect.currentSpan.pipe(Effect.option);
+    // The log exporter also carries the provisioning job and attempt annotations. The trace
+    // joins immediate compiler phase/isolate records even when memory exhaustion ends its span.
+    yield* Effect.logWarning("Catalog app update resource failure").pipe(
+      Effect.annotateLogs({
+        ...input,
+        cause,
+        trace: Option.isSome(span) ? span.value.traceId : null,
+      }),
+    );
+    yield* Effect.annotateCurrentSpan({
+      "executor.catalog.resource_failure": cause,
+      "executor.app.id": input.app,
+      "executor.catalog.phase": input.phase,
+    });
+    yield* ErrorReporter.report(Cause.fail(new CatalogBuildResourceFailed()));
+  });
