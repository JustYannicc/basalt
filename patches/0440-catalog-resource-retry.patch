diff --git a/packages/sdk/src/implementation/version-build-failure.ts b/packages/sdk/src/implementation/version-build-failure.ts
new file mode 100644
index 0000000..535584c
--- /dev/null
+++ b/packages/sdk/src/implementation/version-build-failure.ts
@@ -0,0 +1,30 @@
+import type { OwnerId } from "../contracts/shared.ts";
+import type { RuntimeBuildFailed } from "../contracts/runtime.ts";
+import { VersionBuildFailed } from "../contracts/version.ts";
+
+/** Carry the runtime's stage, location and underlying failure to the deployer. */
+export const versionBuildFailed = (owner: OwnerId, name: string, error: RuntimeBuildFailed) => {
+  const { stage, dependency, location } = error;
+  const hint =
+    dependency === undefined ? undefined : `Add ${dependency} to package.json dependencies.`;
+  const detail =
+    error.declaration !== undefined
+      ? error.declaration.message
+      : error.message.length > 0
+        ? error.message
+        : hint;
+  // Compiler messages already begin with their location.
+  const where =
+    location === undefined || detail?.includes(location.file) === true
+      ? ""
+      : ` in ${location.file}${location.line === undefined ? "" : `:${location.line}${location.column === undefined ? "" : `:${location.column}`}`}`;
+  return new VersionBuildFailed({
+    owner,
+    name,
+    reason: hint ?? error.declaration?.message ?? "App build failed",
+    stage,
+    ...(error.unanswered === true ? { unanswered: true } : {}),
+    ...(location === undefined ? {} : { location }),
+    message: `App build failed at the ${stage} stage${where}${detail === undefined ? "." : `: ${detail}`}`,
+  });
+};
