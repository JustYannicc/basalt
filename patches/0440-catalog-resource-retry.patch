new file mode 100644
index 0000000..3686bfc
--- /dev/null
+++ b/apps/hosted/cloud/src/implementation/catalog-build-incident.ts
@@ -0,0 +1,26 @@
+/** Only closed catalog resource diagnostics pass the direct error sink's privacy boundary. */
+import type { ErrorEvent } from "@sentry/core";
+
+export const catalogBuildIncident = (event: ErrorEvent) => {
+  if (!event.exception?.values?.some((value) => value.type === "CatalogBuildResourceFailed"))
+    return undefined;
+  const app = event.tags?.["executor.app.id"];
+  const cause = event.tags?.["executor.catalog.resource_failure"];
+  const phase = event.tags?.["executor.catalog.phase"];
+  const attempt = event.tags?.["executor.provisioning.attempt"];
+  if (
+    typeof app !== "string" ||
+    !/^app_[0-9a-f-]{36}$/i.test(app) ||
+    (cause !== "memory" && cause !== "capacity" && cause !== "unanswered") ||
+    (phase !== "requirements" && phase !== "deployment") ||
+    typeof attempt !== "string" ||
+    !/^[1-9][0-9]{0,2}$/.test(attempt)
+  )
+    return undefined;
+  return {
+    "executor.app.id": app,
+    "executor.catalog.resource_failure": cause,
+    "executor.catalog.phase": phase,
+    "executor.provisioning.attempt": attempt,
+  };
+};
diff --git a/apps/hosted/cloud/src/implementation/compiler-resource-retry.ts b/apps/hosted/cloud/src/implementation/compiler-resource-retry.ts
new file mode 100644
index 0000000..e525ee5
--- /dev/null
+++ b/apps/hosted/cloud/src/implementation/compiler-resource-retry.ts
@@ -0,0 +1,27 @@
+/** Normalize compiler transport failures and retry one confirmed memory failure. */
+import { BuildMemoryExceeded, RuntimeBuildFailed, describeBuildCause } from "@executor-js/sdk/core";
+import type { RpcCallError } from "alchemy/Rpc";
+import { Effect, Schema } from "effect";
+import { requestCompile } from "./compiler-request.ts";
+
+export const retryCompilerRequest = <A, R>(request: Effect.Effect<A, RpcCallError, R>) =>
+  requestCompile(request).pipe(
+    Effect.catchTag("RpcCallError", (error) => {
+      const cause = error.cause;
+      return Effect.fail(
+        cause instanceof Error && /^Worker exceeded memory limit\.?$/.test(cause.message)
+          ? new BuildMemoryExceeded()
+          : new RuntimeBuildFailed({
+              stage: "compile",
+              message: describeBuildCause(cause instanceof Error ? cause : error),
+            }),
+      );
+    }),
+    // Service binding acquisition promises neither a fresh nor an exclusive isolate.
+    Effect.tapError((error) =>
+      Schema.is(BuildMemoryExceeded)(error)
+        ? Effect.annotateCurrentSpan("build.memory_retry", true)
+        : Effect.void,
+    ),
+    Effect.retry({ times: 1, while: Schema.is(BuildMemoryExceeded) }),
+  );
