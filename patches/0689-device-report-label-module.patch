--- /dev/null
+++ b/packages/mcp-auth/src/contracts/device-label.ts
@@ -0,0 +1,23 @@
+// No imports: clients that bundle this rule, such as the Obsidian plugin, compare their own
+// labels with the stored ones without shipping Effect.
+
+/** The longest device-reported label kept, in characters. */
+export const deviceReportLimit = 80;
+
+/**
+ * One device-reported label as it is kept: control and formatting characters removed, spacing
+ * collapsed, at most `deviceReportLimit` characters. Nothing when nothing printable is left.
+ */
+export const deviceReportLabel = (value: string | undefined) => {
+  if (value === undefined) return undefined;
+  const label = Array.from(
+    value
+      .replace(/[\p{Cc}\p{Cf}\p{Zl}\p{Zp}]/gu, " ")
+      .replace(/\s+/gu, " ")
+      .trim(),
+  )
+    .slice(0, deviceReportLimit)
+    .join("")
+    .trim();
+  return label.length === 0 ? undefined : label;
+};
