+import { Effect, Schema } from "effect";
+import { randomUUID } from "node:crypto";
+import { productionMigrationProof } from "./production-ops-migration-proof.ts";
+
+/**
+ * Connections in both proof organizations, each with its sign-in attempt and access row. Hours are
+ * since expiry; only the own organization's abandoned ones are older than the reviewed cutoff.
+ */
+export const productionOpsConnectionRows = Effect.gen(function* () {
+  const p = yield* productionMigrationProof;
+  const id = {
+    pending: randomUUID(),
+    cancelled: randomUUID(),
+    completed: randomUUID(),
+    fresh: randomUUID(),
+    foreign: randomUUID(),
+  };
+  const rows = [
+    { id: id.pending, side: p.own, status: "pending", hours: 72 },
+    { id: id.cancelled, side: p.own, status: "cancelled", hours: 48 },
+    { id: id.completed, side: p.own, status: "completed", hours: 72 },
+    { id: id.fresh, side: p.own, status: "pending", hours: 2 },
+    { id: id.foreign, side: p.foreign, status: "pending", hours: 72 },
+  ];
+  const ids = rows.map((row) => row.id),
+    attempts = ids.map((id) => `attempt-${id}`);
+  yield* Effect.addFinalizer(() =>
+    Effect.gen(function* () {
+      yield* p.database.run({
+        sql: "delete from executor_oauth_attempts where id in (select jsonb_array_elements_text($1::jsonb))",
+        params: [JSON.stringify(attempts)],
+      });
+      yield* p.database.run({
+        sql: "delete from executor_account_connections where id in (select jsonb_array_elements_text($1::jsonb))",
+        params: [JSON.stringify(ids)],
+      });
+    }).pipe(Effect.orDie),
+  );
+  for (const row of rows) {
+    const owner = `organization:${row.side.organization}`;
+    yield* p.database.run({
+      sql: `insert into executor_oauth_attempts (id, encrypted, expires_at, status)
+        values ($1, decode('00','hex'), now() - make_interval(hours => $2::int), 'pending')`,
+      params: [`attempt-${row.id}`, row.hours],
+    });
+    yield* p.database.run({
+      sql: `insert into executor_account_connections (id, owner, provider, reconnect_account, state, revision, oauth_attempt, created_at, expires_at, target)
+        select $1, $2::text, provider, null, $3::jsonb, 'fixture', $4, now() - make_interval(hours => $5::int) - interval '30 minutes',
+        now() - make_interval(hours => $5::int), jsonb_build_object('app', $6::text, 'requirement', 'service', 'name', 'Retention proof', 'owner', $2::text, 'scope', 'user')
+        from executor_accounts where id = $7`,
+      params: [
+        row.id,
+        owner,
+        JSON.stringify(
+          row.status === "completed"
+            ? { status: "completed", account: { id: row.side.account } }
+            : { status: row.status },
+        ),
+        `attempt-${row.id}`,
+        row.hours,
+        row.side.app,
+        row.side.account,
+      ],
+    });
+    yield* p.database.run({
+      sql: `insert into hosted_connection_access (connection_id, organization_id, creator_id, destination, target)
+        select id, $2, $3, '{}'::jsonb, target from executor_account_connections where id = $1`,
+      params: [row.id, row.side.organization, row.side.user],
+    });
+  }
+  const present = (table: string, column: string) =>
+    p.database
+      .run({
+        sql: `select ${column} as id from ${table} where ${column} in (select jsonb_array_elements_text($1::jsonb)) order by 1`,
+        params: [JSON.stringify(table === "executor_oauth_attempts" ? attempts : ids)],
+      })
+      .pipe(
+        Effect.flatMap(
+          Schema.decodeUnknownEffect(Schema.Array(Schema.Struct({ id: Schema.String }))),
+        ),
+        Effect.map((found) => found.map((row) => row.id)),
+      );
+  return {
+    p,
+    id,
+    connections: present("executor_account_connections", "id"),
+    attempts: present("executor_oauth_attempts", "id"),
+    access: present("hosted_connection_access", "connection_id"),
+  };
+});
