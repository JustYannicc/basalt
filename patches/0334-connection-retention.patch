diff --git a/apps/hosted/server/src/implementation/connection-retention.ts b/apps/hosted/server/src/implementation/connection-retention.ts
new file mode 100644
index 0000000..ca81a72
--- /dev/null
+++ b/apps/hosted/server/src/implementation/connection-retention.ts
@@ -0,0 +1,65 @@
+/**
+ * Abandoned account connections: a sign-in that never produced an account and expired more than a
+ * day ago. A pending connection expires after 30 minutes but nothing deletes it, so they pile up.
+ * The reviewed `account-connection-retention-v1` operation and the daily rule share this predicate.
+ */
+import { Config, Effect, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+
+/**
+ * SQL over `executor_account_connections` aliased `alias`. "Produced an account" is any completed
+ * sign-in, exactly as the production `connections` inventory reports `produced_account`.
+ */
+export const abandonedConnection = (alias: string) =>
+  `coalesce(${alias}.state ->> 'status' = 'completed', false) = false
+    and ${alias}.expires_at < now() - interval '24 hours'`;
+
+/**
+ * Off unless a host sets it. No deployment binds it: turning the daily rule on is a reviewed change
+ * that follows the reviewed removal of the existing backlog.
+ */
+export const connectionRetentionEnabled = Config.Boolean(
+  "EXECUTOR_ACCOUNT_CONNECTION_RETENTION",
+).pipe(Config.withDefault(false));
+
+/** One run's bound; a larger backlog drains over later runs, oldest first. */
+export const connectionRetentionBatch = 500;
+
+const Candidates = Schema.Array(
+  Schema.Struct({ id: Schema.String, oauth_attempt: Schema.NullOr(Schema.String) }),
+);
+
+/**
+ * Delete up to one batch of abandoned connections, each sign-in attempt before its connection, as
+ * owner removal does. Access rows cascade with their connection; accounts are never touched.
+ * Returns the number of connections removed; `enabled: false` removes nothing.
+ */
+export const retainConnections = (enabled: boolean) =>
+  Effect.gen(function* () {
+    if (!enabled) return 0;
+    const sql = yield* SqlClient.SqlClient;
+    return yield* sql.withTransaction(
+      Effect.gen(function* () {
+        // Locked rows are a connection another writer holds; a later run takes them.
+        const rows = yield* sql
+          .unsafe(
+            `select c.id, c.oauth_attempt from executor_account_connections c
+            where ${abandonedConnection("c")} order by c.expires_at, c.id
+            limit ${connectionRetentionBatch} for update skip locked`,
+          )
+          .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Candidates)));
+        if (rows.length === 0) return 0;
+        const ids = rows.map((row) => row.id);
+        const attempts = rows.flatMap((row) =>
+          row.oauth_attempt === null ? [] : [row.oauth_attempt],
+        );
+        // An attempt another connection still names stays with that connection.
+        if (attempts.length > 0)
+          yield* sql`delete from executor_oauth_attempts a where ${sql.in("a.id", attempts)}
+            and not exists (select 1 from executor_account_connections other
+              where other.oauth_attempt = a.id and not ${sql.in("other.id", ids)})`;
+        yield* sql`delete from executor_account_connections where ${sql.in("id", ids)}`;
+        return ids.length;
+      }),
+    );
+  });
diff --git a/e2e/support/production-ops-connection-rows.ts b/e2e/support/production-ops-connection-rows.ts
new file mode 100644
index 0000000..a642463
--- /dev/null
+++ b/e2e/support/production-ops-connection-rows.ts
@@ -0,0 +1,84 @@
+import { Effect, Schema } from "effect";
+import { randomUUID } from "node:crypto";
+import { productionMigrationProof } from "./production-ops-migration-proof.ts";
+
+/**
+ * Connections in both proof organizations, each with its sign-in attempt and access row. Hours are
+ * since expiry; only the own organization's abandoned ones are older than the reviewed cutoff.
+ */
+export const productionOpsConnectionRows = Effect.gen(function* () {
+  const p = yield* productionMigrationProof;
+  const rows = [
+    { key: "pending", side: p.own, status: "pending", hours: 72 },
+    { key: "cancelled", side: p.own, status: "cancelled", hours: 48 },
+    { key: "completed", side: p.own, status: "completed", hours: 72 },
+    { key: "fresh", side: p.own, status: "pending", hours: 2 },
+    { key: "foreign", side: p.foreign, status: "pending", hours: 72 },
+  ].map((row) => ({ ...row, id: randomUUID() }));
+  const ids = rows.map((row) => row.id),
+    attempts = ids.map((id) => `attempt-${id}`);
+  yield* Effect.addFinalizer(() =>
+    Effect.gen(function* () {
+      yield* p.database.run({
+        sql: "delete from executor_oauth_attempts where id in (select jsonb_array_elements_text($1::jsonb))",
+        params: [JSON.stringify(attempts)],
+      });
+      yield* p.database.run({
+        sql: "delete from executor_account_connections where id in (select jsonb_array_elements_text($1::jsonb))",
+        params: [JSON.stringify(ids)],
+      });
+    }).pipe(Effect.orDie),
+  );
+  for (const row of rows) {
+    const owner = `organization:${row.side.organization}`;
+    yield* p.database.run({
+      sql: `insert into executor_oauth_attempts (id, encrypted, expires_at, status)
+        values ($1, decode('00','hex'), now() - make_interval(hours => $2::int), 'pending')`,
+      params: [`attempt-${row.id}`, row.hours],
+    });
+    yield* p.database.run({
+      sql: `insert into executor_account_connections (id, owner, provider, reconnect_account, state, revision, oauth_attempt, created_at, expires_at, target)
+        select $1, $2::text, provider, null, $3::jsonb, 'fixture', $4, now() - make_interval(hours => $5::int) - interval '30 minutes',
+        now() - make_interval(hours => $5::int), jsonb_build_object('app', $6::text, 'requirement', 'service', 'name', 'Retention proof', 'owner', $2::text, 'scope', 'user')
+        from executor_accounts where id = $7`,
+      params: [
+        row.id,
+        owner,
+        JSON.stringify(
+          row.status === "completed"
+            ? { status: "completed", account: { id: row.side.account } }
+            : { status: row.status },
+        ),
+        `attempt-${row.id}`,
+        row.hours,
+        row.side.app,
+        row.side.account,
+      ],
+    });
+    yield* p.database.run({
+      sql: `insert into hosted_connection_access (connection_id, organization_id, creator_id, destination, target)
+        select id, $2, $3, '{}'::jsonb, target from executor_account_connections where id = $1`,
+      params: [row.id, row.side.organization, row.side.user],
+    });
+  }
+  const id = Object.fromEntries(rows.map((row) => [row.key, row.id]));
+  const present = (table: string, column: string) =>
+    p.database
+      .run({
+        sql: `select ${column} as id from ${table} where ${column} in (select jsonb_array_elements_text($1::jsonb)) order by 1`,
+        params: [JSON.stringify(table === "executor_oauth_attempts" ? attempts : ids)],
+      })
+      .pipe(
+        Effect.flatMap(
+          Schema.decodeUnknownEffect(Schema.Array(Schema.Struct({ id: Schema.String }))),
+        ),
+        Effect.map((found) => found.map((row) => row.id)),
+      );
+  return {
+    p,
+    id,
+    connections: present("executor_account_connections", "id"),
+    attempts: present("executor_oauth_attempts", "id"),
+    access: present("hosted_connection_access", "connection_id"),
+  };
+});
