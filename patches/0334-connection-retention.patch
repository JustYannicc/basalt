+/**
+ * Abandoned account connections: a sign-in that never produced an account and expired more than a
+ * day ago. The reviewed `account-connection-retention-v1` operation and the daily rule remove them
+ * with the same predicate; the production `connections` inventory reports the same definition.
+ */
+import { Config, Effect, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+
+/** SQL over `executor_account_connections` aliased `alias`: any completed sign-in, new, reconnected or reused. */
+export const producedAccount = (alias: string) =>
+  `coalesce(${alias}.state ->> 'status' = 'completed', false)`;
+
+/** SQL over `executor_account_connections` aliased `alias`. */
+export const abandonedConnection = (alias: string) =>
+  `${producedAccount(alias)} = false and ${alias}.expires_at < now() - interval '24 hours'`;
+
+/** Turns the daily rule on when `true`; unset or `false` leaves it off. */
+export const connectionRetentionEnabled = Config.Boolean(
+  "EXECUTOR_ACCOUNT_CONNECTION_RETENTION",
+).pipe(Config.withDefault(false));
+
+/** Run `work` only when the switch is on; off, nothing connects, schedules or deletes. */
+export const whenConnectionRetentionEnabled = <A, E, R>(work: Effect.Effect<A, E, R>) =>
+  Effect.gen(function* () {
+    if (!(yield* connectionRetentionEnabled)) return false;
+    yield* work;
+    return true;
+  });
+
+/** One run's bound; a larger backlog drains over later runs, oldest first. */
+export const connectionRetentionBatch = 500;
+
+const Candidates = Schema.Array(
+  Schema.Struct({ id: Schema.String, oauth_attempt: Schema.NullOr(Schema.String) }),
+);
+
+/**
+ * Delete up to one batch of abandoned connections, each sign-in attempt before its connection, as
+ * owner removal does. An attempt another connection still names stays with it. Access rows
+ * cascade with their connection; accounts are never touched. Returns the connections removed.
+ */
+export const retainConnections = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  return yield* sql.withTransaction(
+    Effect.gen(function* () {
+      // Locked rows are a connection another writer holds; a later run takes them.
+      const rows = yield* sql
+        .unsafe(
+          `select c.id, c.oauth_attempt from executor_account_connections c
+          where ${abandonedConnection("c")} order by c.expires_at, c.id
+          limit ${connectionRetentionBatch} for update skip locked`,
+        )
+        .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Candidates)));
+      if (rows.length === 0) return 0;
+      const ids = rows.map((row) => row.id);
+      const attempts = rows.flatMap((row) =>
+        row.oauth_attempt === null ? [] : [row.oauth_attempt],
+      );
+      if (attempts.length > 0)
+        yield* sql`delete from executor_oauth_attempts a where ${sql.in("a.id", attempts)}
+          and not exists (select 1 from executor_account_connections other
+            where other.oauth_attempt = a.id and not ${sql.in("other.id", ids)})`;
+      yield* sql`delete from executor_account_connections where ${sql.in("id", ids)}`;
+      return ids.length;
+    }),
+  );
+});
