+/** At most 16 query parameters, with bounded keys, values and total text. */
+// Check keys after decoding: constrained record keys would silently discard invalid entries.
+export const AppPageSearch = Schema.Record(
+  Schema.String,
+  Schema.String.check(Schema.isMaxLength(1024)),
+).check(
+  Schema.makeFilter((search) => {
+    const entries = Object.entries(search);
+    return (
+      (entries.length <= 16 &&
+        entries.every(([key]) => key.length >= 1 && key.length <= 64) &&
+        entries.reduce((size, [key, value]) => size + key.length + value.length, 0) <= 4096) ||
+      "page search allows at most 16 parameters and 4096 characters"
+    );
+  }),
+);
+export type AppPageSearch = typeof AppPageSearch.Type;
