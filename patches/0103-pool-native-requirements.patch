diff --git a/e2e/tests/pool-seed-native-upgrade.spec.ts b/e2e/tests/pool-seed-native-upgrade.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ff23f26445809ed23d3932ff30ce5436fe2dfa0b
--- /dev/null
+++ b/e2e/tests/pool-seed-native-upgrade.spec.ts
@@ -0,0 +1,168 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, FileSystem, Path, Schema } from "effect";
+import { randomUUID } from "node:crypto";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+import {
+  PoolSeedFiles as Files,
+  PoolSeedApp as App,
+  legacyPoolRequirements as legacyRequirements,
+} from "../support/pool-seed.ts";
+
+layer(RuntimeLive, { excludeTestServices: true })("Pool seed upgrade", (it) => {
+  it.effect(scenarios.poolSeedNativeUpgrade.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          fs = yield* FileSystem.FileSystem,
+          path = yield* Path.Path;
+        const directory = path.resolve("apps/hosted/cloud/.generated/pool-app");
+        const bundles = (yield* fs.readDirectory(directory)).filter((name) =>
+          /^pool-app-[a-f0-9]+\.json$/.test(name),
+        );
+        expect(bundles).toHaveLength(1);
+        const files = yield* fs
+          .readFileString(path.join(directory, bundles[0]!))
+          .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Schema.fromJsonString(Files))));
+        const previous = files.map((file) =>
+          file.path === "requirements.ts" ? { ...file, content: legacyRequirements } : file,
+        );
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const apps: string[] = [],
+          accounts: string[] = [];
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* serverControl("start");
+            for (const app of apps) {
+              const removed = yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app}`);
+              expect(removed.status, JSON.stringify(removed.body)).toBe(200);
+            }
+            for (const account of accounts) {
+              const removed = yield* api.request(
+                actors.owner,
+                "DELETE",
+                `${prefix}/accounts/${account}`,
+              );
+              expect(removed.status, JSON.stringify(removed.body)).toBe(200);
+            }
+          }).pipe(Effect.orDie),
+        );
+        const deploy = (name: string, source: typeof Files.Type) =>
+          Effect.gen(function* () {
+            const response = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+              name,
+              files: source,
+            });
+            expect(response.status, JSON.stringify(response.body)).toBe(200);
+            const app = yield* body(App, response);
+            apps.push(app.id);
+            return app;
+          });
+        const old = yield* deploy("Retained pool seed", previous),
+          appPath = `${prefix}/apps/${old.id}`;
+        expect(Object.keys(old.requirements.accounts).sort()).toEqual(["pool", "subscriptions"]);
+        const viewer = yield* body(
+          Schema.Struct({ userId: Schema.String }),
+          yield* api.request(actors.owner, "GET", "/api/viewer"),
+        );
+        const rows = [
+          { slot: "pool", method: "token", fields: { token: "synthetic-retained-pool-token" } },
+          {
+            slot: "subscriptions",
+            method: "codex",
+            fields: { ref: "synthetic-retained-subscription" },
+          },
+        ];
+        for (const row of rows) {
+          const id = `acc_${randomUUID()}`;
+          accounts.push(id);
+          yield* legacyStorage([
+            {
+              sql: `insert into executor_accounts (id,owner,provider,method,label,encrypted_credentials,credential_generation,created_at)
+            select $1,owner,$2,$3,$4,$5,7,now() from executor_apps where id = $6`,
+              params: [
+                id,
+                old.requirements.accounts[row.slot]!.provider,
+                row.method,
+                row.slot,
+                { sealed: { id, value: row.fields } },
+                old.id,
+              ],
+            },
+            {
+              sql: `insert into hosted_account_access (account_id,organization_id,creator_id,kind,personal_user_id) values ($1,$2,$3,'personal',$3)`,
+              params: [id, actors.organization.id, viewer.userId],
+            },
+            {
+              sql: `insert into hosted_app_account_links (app,requirement,subject,account,linked_by) values ($1,$2,null,$3,$4)`,
+              params: [old.id, row.slot, id, viewer.userId],
+            },
+          ]);
+        }
+        yield* serverControl("start");
+        const links = () => api.request(actors.owner, "GET", `${appPath}/accounts/app`);
+        const before = yield* links();
+        expect(before.status).toBe(200);
+        for (const account of accounts) expect(JSON.stringify(before.body)).toContain(account);
+        const upgraded = yield* api.request(actors.owner, "POST", `${appPath}/deploy`, { files });
+        expect(upgraded.status, JSON.stringify(upgraded.body)).toBe(200);
+        const current = (yield* body(Schema.Struct({ app: App }), upgraded)).app;
+        expect(Object.keys(current.requirements.accounts).sort()).toEqual([
+          "anthropic",
+          "openai",
+          "pool",
+          "subscriptions",
+        ]);
+        expect(current.activeVersion).not.toBe(old.activeVersion);
+        for (const slot of ["pool", "subscriptions"])
+          expect(current.requirements.accounts[slot]).toEqual(old.requirements.accounts[slot]);
+        for (const lab of ["openai", "anthropic"]) {
+          const source = yield* fs
+            .readFileString(path.resolve(`../src/catalog/provider-apps/${lab}.json`))
+            .pipe(
+              Effect.flatMap(
+                Schema.decodeUnknownEffect(Schema.fromJsonString(Schema.Struct({ files: Files }))),
+              ),
+            );
+          const providerApp = yield* deploy(`Canonical ${lab}`, source.files);
+          expect(current.requirements.accounts[lab]).toMatchObject({
+            provider: providerApp.requirements.accounts[lab]!.provider,
+            cardinality: "many",
+            contributed: true,
+          });
+        }
+        const after = yield* links();
+        expect(after.status).toBe(200);
+        expect(after.body).toEqual(before.body);
+        for (let index = 0; index < rows.length; index++) {
+          const choices = yield* api.request(
+            actors.owner,
+            "GET",
+            `${appPath}/accounts/app/${rows[index]!.slot}`,
+          );
+          expect(choices.status, JSON.stringify(choices.body)).toBe(200);
+          expect(choices.body).toMatchObject({
+            accounts: expect.arrayContaining([
+              expect.objectContaining({
+                account: expect.objectContaining({ id: accounts[index] }),
+                linked: true,
+              }),
+            ]),
+          });
+          expect(
+            (yield* api.request(actors.owner, "GET", `${prefix}/accounts/${accounts[index]}`))
+              .status,
+          ).toBe(200);
+        }
+      }),
+    ),
+  );
+});
