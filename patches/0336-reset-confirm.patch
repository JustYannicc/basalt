@@ -0,0 +1,117 @@
+/**
+ * The signed reset routes of a pool that offers banked resets for one account. Only the pool
+ * boundary is synthetic; the product owns every access decision and the browser the confirm step.
+ * The pool app itself is `trafficPool` with a `subscriptions` requirement and `resetReference`.
+ */
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Effect, Layer, Ref, Schema } from "effect";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { createHmac, timingSafeEqual } from "node:crypto";
+import { createServer } from "node:http";
+import { poolFixtureSigningKey } from "./cloud-pool-gateway.ts";
+
+/** The pool's private reference for the account, kept in the account's credentials. */
+export const resetReference = "synthetic-reset-reference";
+const Claims = Schema.Struct({
+  pool: Schema.NonEmptyString,
+  owner: Schema.NonEmptyString,
+  organization: Schema.NonEmptyString,
+});
+const Spend = Schema.Struct({ creditId: Schema.NonEmptyString, requestId: Schema.NonEmptyString });
+type Use = typeof Spend.Type & { readonly startedAt: string };
+type Call = { readonly action: "resets" | "attempt" | "use"; readonly pool: string };
+
+/**
+ * The pool's reset routes. Two credits, soonest expiry first; each use spends the first left and
+ * becomes the retained attempt. `reset` returns the pool to two unspent credits and no calls.
+ */
+export const resetPoolBackend = Effect.gen(function* () {
+  const calls = yield* Ref.make<readonly Call[]>([]);
+  const uses = yield* Ref.make<readonly Use[]>([]);
+  const expiries = [27, 28].map((days) => new Date(Date.now() + days * 86_400_000).toISOString());
+  const credits = (spent: number) =>
+    expiries.slice(spent).map((expiresAt, index) => ({
+      id: `credit-${index + spent}`,
+      type: "codex_rate_limits",
+      remaining: 1,
+      expiresAt,
+      usableNow: true,
+      requiresLimit: false,
+      clears: null,
+    }));
+  const result = (spend: Use) => ({
+    requestId: spend.requestId,
+    outcome: "reset",
+    cooldownCleared: false,
+    usageRefreshQueued: true,
+  });
+  const route = (action: Call["action"]) =>
+    Effect.gen(function* () {
+      const request = yield* HttpServerRequest.HttpServerRequest;
+      const [prefix, encoded, signature, extra] = (request.headers.authorization ?? "")
+        .replace(/^Bearer /u, "")
+        .split(".");
+      if (prefix !== "sbp1" || encoded === undefined || signature === undefined || extra)
+        return HttpServerResponse.empty({ status: 401 });
+      const actual = Buffer.from(signature, "base64url");
+      const expected = createHmac("sha256", Buffer.from(poolFixtureSigningKey, "hex"))
+        .update(`${prefix}.${encoded}`)
+        .digest();
+      if (actual.length !== expected.length || !timingSafeEqual(actual, expected))
+        return HttpServerResponse.empty({ status: 401 });
+      const claims = yield* Schema.decodeUnknownEffect(Schema.fromJsonString(Claims))(
+        Buffer.from(encoded, "base64url").toString(),
+      );
+      if (request.headers["x-signalbox-caller"] !== claims.owner)
+        return HttpServerResponse.empty({ status: 403 });
+      yield* Ref.update(calls, (items) => [...items, { action, pool: claims.pool }]);
+      const spent = yield* Ref.get(uses);
+      if (action === "resets")
+        return HttpServerResponse.jsonUnsafe({
+          provider: "codex",
+          observedAt: new Date().toISOString(),
+          available: expiries.length - spent.length,
+          credits: credits(spent.length),
+        });
+      if (action === "attempt") {
+        const last = spent.at(-1);
+        return HttpServerResponse.jsonUnsafe(
+          last === undefined
+            ? null
+            : {
+                ...result(last),
+                provider: "codex",
+                creditId: last.creditId,
+                startedAt: last.startedAt,
+                retryUntil: new Date(Date.now() + 600_000).toISOString(),
+                canRetryProvider: false,
+              },
+        );
+      }
+      const spend = {
+        ...(yield* request.json.pipe(Effect.flatMap(Schema.decodeUnknownEffect(Spend)))),
+        startedAt: new Date().toISOString(),
+      };
+      yield* Ref.update(uses, (items) => [...items, spend]);
+      return HttpServerResponse.jsonUnsafe(result(spend));
+    });
+  const base = `/pool/v1/accounts/${resetReference}`;
+  const services = yield* Layer.build(
+    HttpRouter.serve(
+      Layer.mergeAll(
+        HttpRouter.add("GET", `${base}/resets`, route("resets")),
+        HttpRouter.add("GET", `${base}/resets/attempt`, route("attempt")),
+        HttpRouter.add("POST", `${base}/resets/use`, route("use")),
+      ),
+      { disableLogger: true, disableListenLog: true },
+    ).pipe(Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 }))),
+  );
+  const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+  if (!("port" in server.address)) return yield* Effect.die("Reset pool fixture requires TCP");
+  return {
+    origin: `http://127.0.0.1:${server.address.port}`,
+    calls: Ref.get(calls),
+    uses: Ref.get(uses),
+    reset: Effect.andThen(Ref.set(calls, []), Ref.set(uses, [])),
+  };
+});
