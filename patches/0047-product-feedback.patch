diff --git a/packages/ui/src/implementation/components/toast.tsx b/packages/ui/src/implementation/components/toast.tsx
new file mode 100644
index 0000000..b6b8649
--- /dev/null
+++ b/packages/ui/src/implementation/components/toast.tsx
@@ -0,0 +1,74 @@
+"use client";
+
+import { useEffect } from "react";
+import { useAtomSet, useAtomValue } from "@effect/atom-react";
+import { HugeiconsIcon } from "@hugeicons/react";
+import { CheckmarkCircle02Icon } from "@hugeicons/core-free-icons";
+import { Atom } from "effect/reactivity";
+
+interface Toast {
+  readonly id: string;
+  readonly title: string;
+  readonly description?: string;
+}
+
+const visibleMs = 4000;
+const toastsAtom = Atom.make<ReadonlyArray<Toast>>([]).pipe(Atom.keepAlive);
+
+/** Shows a toast that confirms something that already happened, then leaves on its own. */
+// A counter, not crypto.randomUUID: that exists only in secure contexts, and a self-host can be
+// served over plain HTTP. Toasts are only raised in the browser.
+const ids = { next: 0 };
+
+export function useToast() {
+  const set = useAtomSet(toastsAtom);
+  return (message: Omit<Toast, "id">) =>
+    set((toasts) => [...toasts, { id: String((ids.next += 1)), ...message }]);
+}
+
+function ToastItem({ toast }: { readonly toast: Toast }) {
+  const set = useAtomSet(toastsAtom);
+  useEffect(() => {
+    const timer = setTimeout(
+      () => set((toasts) => toasts.filter((item) => item.id !== toast.id)),
+      visibleMs,
+    );
+    return () => clearTimeout(timer);
+  }, [set, toast.id]);
+  return (
+    <div className="pointer-events-auto flex items-start gap-2.5 rounded-lg border bg-popover p-3 text-sm text-popover-foreground shadow-md animate-in fade-in-0 slide-in-from-bottom-2 duration-200 motion-reduce:animate-none">
+      <HugeiconsIcon
+        icon={CheckmarkCircle02Icon}
+        strokeWidth={2}
+        aria-hidden
+        className="mt-px size-4 shrink-0"
+      />
+      <div className="grid gap-0.5">
+        <p className="font-medium">{toast.title}</p>
+        {toast.description !== undefined && (
+          <p className="text-muted-foreground">{toast.description}</p>
+        )}
+      </div>
+    </div>
+  );
+}
+
+/**
+ * Where toasts appear: bottom-right on wide screens, and above the Menu pill on phones. The region
+ * stays mounted, so screen readers announce each toast as it arrives.
+ */
+export function Toaster() {
+  const toasts = useAtomValue(toastsAtom);
+  return (
+    <div
+      data-slot="toaster"
+      role="status"
+      aria-live="polite"
+      className="pointer-events-none fixed z-[60] right-4 bottom-4 flex w-80 flex-col gap-2 max-[740px]:left-4 max-[740px]:w-auto max-[740px]:bottom-[calc(max(16px,_env(safe-area-inset-bottom))_+_56px)]"
+    >
+      {toasts.map((toast) => (
+        <ToastItem key={toast.id} toast={toast} />
+      ))}
+    </div>
+  );
+}
diff --git a/packages/ui/src/implementation/dashboard/product-feedback.tsx b/packages/ui/src/implementation/dashboard/product-feedback.tsx
new file mode 100644
index 0000000..2e961f0
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/product-feedback.tsx
@@ -0,0 +1,253 @@
+import { useId, useRef, useState, type KeyboardEvent, type ReactNode } from "react";
+import { HugeiconsIcon } from "@hugeicons/react";
+import { ImageNotFound01Icon, Message01Icon } from "@hugeicons/core-free-icons";
+import { Button } from "../components/button.tsx";
+import { Checkbox } from "../components/checkbox.tsx";
+import { Dialog, DialogContent, DialogTitle, DialogTrigger } from "../components/dialog.tsx";
+import { Popover, PopoverContent, PopoverTrigger } from "../components/popover.tsx";
+import { Spinner } from "../components/spinner.tsx";
+import { Textarea } from "../components/textarea.tsx";
+import { useToast } from "../components/toast.tsx";
+import { useFeedbackScreenshot, type FeedbackScreenshot } from "../hooks/feedback-screenshot.ts";
+import { useProductBrand } from "../hooks/product-brand.ts";
+import { installFeedbackLog, readFeedbackLog } from "../lib/feedback-log.ts";
+import {
+  feedbackFailure,
+  feedbackMessageMax,
+  sendFeedback,
+  toBase64,
+} from "../lib/feedback-submit.ts";
+import { useKeyboardInset } from "../hooks/keyboard-inset.ts";
+
+function Thumbnail({ enabled, screenshot }: { enabled: boolean; screenshot: FeedbackScreenshot }) {
+  let content: ReactNode;
+  if (enabled && screenshot.status === "ready")
+    content = (
+      <img
+        src={screenshot.url}
+        alt="Screenshot that will be attached"
+        className="size-full object-cover object-left-top"
+      />
+    );
+  else if (enabled && screenshot.status !== "failed") content = <Spinner className="size-3.5" />;
+  else
+    content = (
+      <HugeiconsIcon
+        icon={ImageNotFound01Icon}
+        strokeWidth={2}
+        size={16}
+        aria-label={enabled ? "Screenshot unavailable" : "No screenshot"}
+      />
+    );
+  return (
+    <div className="flex h-10 w-16 shrink-0 items-center justify-center overflow-hidden rounded-md border bg-muted text-muted-foreground">
+      {content}
+    </div>
+  );
+}
+
+function Option(props: {
+  checked: boolean;
+  disabled: boolean;
+  onCheckedChange: (checked: boolean) => void;
+  children: ReactNode;
+}) {
+  return (
+    <label className="flex cursor-pointer items-center gap-2 text-sm max-[740px]:min-h-11">
+      <Checkbox
+        checked={props.checked}
+        disabled={props.disabled}
+        onCheckedChange={(checked) => props.onCheckedChange(checked === true)}
+      />
+      {props.children}
+    </label>
+  );
+}
+
+/**
+ * The sidebar's Feedback entry for a deployment with its own feedback endpoint. On wide screens it
+ * opens a popover above the entry; in the phone menu (`sheet`) it opens its own bottom sheet, where
+ * Enter adds a line. A screenshot of the page and recent logs attach unless unticked. What was
+ * typed stays when a send fails, and `onSent` runs after a send succeeds.
+ */
+export function ProductFeedback({
+  endpoint,
+  sheet = false,
+  onSent,
+}: {
+  readonly endpoint: string;
+  readonly sheet?: boolean;
+  readonly onSent?: (() => void) | undefined;
+}) {
+  // The sidebar renders with the dashboard, so logs are kept from page load onward.
+  installFeedbackLog();
+  const { name } = useProductBrand();
+  const [open, setOpen] = useState(false);
+  const [draft, setDraft] = useState("");
+  const [attachScreenshot, setAttachScreenshot] = useState(true);
+  const [attachLogs, setAttachLogs] = useState(true);
+  const [sending, setSending] = useState(false);
+  const [error, setError] = useState<string>();
+  const { screenshot, start, clear, resolve } = useFeedbackScreenshot();
+  const toast = useToast();
+  const field = useRef<HTMLTextAreaElement>(null);
+  const keyboardInset = useKeyboardInset(sheet && open);
+  const id = useId();
+
+  // Each open captures what is on screen right then; closing drops it.
+  const changeOpen = (next: boolean) => {
+    if (sending) return;
+    setOpen(next);
+    setError(undefined);
+    if (next && attachScreenshot) start();
+    else if (!next) clear();
+  };
+  const changeAttachScreenshot = (checked: boolean) => {
+    setAttachScreenshot(checked);
+    if (checked && open) start();
+    else if (!checked) clear();
+  };
+
+  const submit = async () => {
+    const message = draft.trim();
+    if (message.length === 0 || sending) return;
+    setSending(true);
+    setError(undefined);
+    const image = attachScreenshot ? await resolve() : null;
+    const status = await sendFeedback(endpoint, {
+      message,
+      page: location.pathname,
+      ...(image === null
+        ? {}
+        : {
+            screenshot: { name: "screenshot.jpg", type: image.type, data: await toBase64(image) },
+          }),
+      ...(attachLogs ? { logs: readFeedbackLog() } : {}),
+    });
+    setSending(false);
+    if (status >= 200 && status < 300) {
+      setDraft("");
+      setOpen(false);
+      clear();
+      toast({ title: "Feedback sent", description: "Thanks." });
+      onSent?.();
+      return;
+    }
+    setError(feedbackFailure(status, image !== null));
+    field.current?.focus();
+  };
+
+  const onKeyDown = (event: KeyboardEvent<HTMLTextAreaElement>) => {
+    // Safari ends composition before the Enter that confirms it, which then reads as key 229.
+    const composing = event.nativeEvent.isComposing || event.keyCode === 229;
+    if (sheet || event.key !== "Enter" || event.shiftKey || composing) return;
+    event.preventDefault();
+    void submit();
+  };
+
+  const form = (
+    <form
+      className="grid gap-3"
+      aria-busy={sending}
+      onSubmit={(event) => {
+        event.preventDefault();
+        void submit();
+      }}
+    >
+      <label htmlFor={`${id}-message`} id={`${id}-label`} className="text-sm font-medium">
+        Feedback about {name}
+      </label>
+      <Textarea
+        ref={field}
+        id={`${id}-message`}
+        value={draft}
+        readOnly={sending}
+        maxLength={feedbackMessageMax}
+        rows={4}
+        placeholder="Bug, idea, annoyance…"
+        aria-invalid={error !== undefined}
+        aria-describedby={
+          [sheet ? undefined : `${id}-hint`, error === undefined ? undefined : `${id}-error`]
+            .filter((part) => part !== undefined)
+            .join(" ") || undefined
+        }
+        className="resize-none"
+        onChange={(event) => {
+          setDraft(event.currentTarget.value);
+          setError(undefined);
+        }}
+        onKeyDown={onKeyDown}
+      />
+      <div className="flex items-center gap-3">
+        <Thumbnail enabled={attachScreenshot} screenshot={screenshot} />
+        <div className="grid gap-2">
+          <Option
+            checked={attachScreenshot}
+            disabled={sending}
+            onCheckedChange={changeAttachScreenshot}
+          >
+            Attach screenshot
+          </Option>
+          <Option checked={attachLogs} disabled={sending} onCheckedChange={setAttachLogs}>
+            Attach logs
+          </Option>
+        </div>
+      </div>
+      {error !== undefined && (
+        <p id={`${id}-error`} role="alert" className="text-sm text-destructive">
+          {error}
+        </p>
+      )}
+      <div className="flex items-center justify-between gap-2">
+        {!sheet && (
+          <p id={`${id}-hint`} className="text-xs text-muted-foreground">
+            Shift+Enter for a new line
+          </p>
+        )}
+        <Button
+          type="submit"
+          size="sm"
+          className="ml-auto"
+          loading={sending}
+          disabled={draft.trim().length === 0}
+        >
+          Send
+        </Button>
+      </div>
+    </form>
+  );
+
+  const trigger = (
+    <button type="button" title="Feedback" className="cursor-pointer hover:text-foreground">
+      <HugeiconsIcon icon={Message01Icon} strokeWidth={2} size={13} aria-hidden />
+      <span>Feedback</span>
+    </button>
+  );
+
+  if (sheet)
+    return (
+      <Dialog open={open} onOpenChange={changeOpen}>
+        <DialogTrigger asChild>{trigger}</DialogTrigger>
+        <DialogContent
+          showCloseButton={false}
+          aria-describedby={undefined}
+          overlayClassName="bg-black/20"
+          style={{ bottom: keyboardInset }}
+          className="top-auto bottom-0 left-0 translate-x-0 translate-y-0 w-full max-w-none sm:max-w-none gap-0 rounded-b-none rounded-t-[14px] border-b-0 p-[8px_16px_max(16px,_env(safe-area-inset-bottom))] max-h-[85dvh] overflow-y-auto data-[state=open]:slide-in-from-bottom-4 data-[state=closed]:slide-out-to-bottom-4 data-[state=open]:zoom-in-100 data-[state=closed]:zoom-out-100"
+        >
+          <DialogTitle className="sr-only">Send feedback</DialogTitle>
+          <div className="mx-auto mb-3 h-1 w-9 rounded-full bg-border" aria-hidden />
+          {form}
+        </DialogContent>
+      </Dialog>
+    );
+
+  return (
+    <Popover open={open} onOpenChange={changeOpen}>
+      <PopoverTrigger asChild>{trigger}</PopoverTrigger>
+      <PopoverContent side="top" align="start" className="w-80" aria-labelledby={`${id}-label`}>
+        {form}
+      </PopoverContent>
+    </Popover>
+  );
+}
