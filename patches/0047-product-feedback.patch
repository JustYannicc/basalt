diff --git a/packages/ui/src/implementation/hooks/feedback-screenshot.ts b/packages/ui/src/implementation/hooks/feedback-screenshot.ts
new file mode 100644
index 0000000..211a244
--- /dev/null
+++ b/packages/ui/src/implementation/hooks/feedback-screenshot.ts
@@ -0,0 +1,109 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import { untrackedFetch, withoutFeedbackLog } from "../lib/feedback-log.ts";
+
+/** Popovers, dialogs and toasts are left out, so the feedback form never shows in its own image. */
+const overlays = new Set(["popover-content", "dialog-content", "dialog-overlay", "toaster"]);
+const keep = (node: Node) =>
+  !(node instanceof HTMLElement && overlays.has(node.dataset.slot ?? ""));
+
+/** A blank pixel stands in for an image or font the capture can't load. */
+const blank = "data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==";
+
+/** Images the capture inlines; it reports them as blank rather than failing. */
+const fetchResource = (url: string) =>
+  untrackedFetch(url, { cache: "force-cache" })
+    .then((response) => (response.ok ? response.blob() : Promise.reject(new Error())))
+    .then(
+      (blob) =>
+        new Promise<string>((resolve, reject) => {
+          const reader = new FileReader();
+          reader.onload = () => resolve(String(reader.result));
+          reader.onerror = reject;
+          reader.readAsDataURL(blob);
+        }),
+    )
+    .catch(() => blank);
+
+/** Encoded bytes of an attached screenshot; a sharper capture over it retries at 1x. */
+export const feedbackScreenshotBytesMax = 1_500_000;
+
+/**
+ * Draws the visible page to a JPEG. `modern-screenshot` loads on first use, so pages that never
+ * open the form don't download it. Frames from other origins draw blank.
+ */
+async function capturePage(): Promise<Blob> {
+  const { domToBlob } = await import("modern-screenshot");
+  const capture = (scale: number) =>
+    domToBlob(document.body, {
+      type: "image/jpeg",
+      quality: 0.85,
+      width: window.innerWidth,
+      height: window.innerHeight,
+      scale,
+      backgroundColor: getComputedStyle(document.body).backgroundColor,
+      filter: keep,
+      fetchFn: fetchResource,
+      timeout: 10_000,
+    });
+  // Fonts and stylesheets load through the page's own fetch, so the request log pauses meanwhile
+  // and the capture stays out of the logs it may be sent with.
+  return withoutFeedbackLog(async () => {
+    const sharp = await capture(Math.min(window.devicePixelRatio || 1, 2));
+    if (sharp.size <= feedbackScreenshotBytesMax) return sharp;
+    const plain = await capture(1);
+    if (plain.size <= feedbackScreenshotBytesMax) return plain;
+    throw new Error("Screenshot too large");
+  });
+}
+
+export type FeedbackScreenshot =
+  | { readonly status: "idle" | "capturing" | "failed" }
+  | { readonly status: "ready"; readonly url: string };
+
+/**
+ * One page capture at a time. `start` captures what is on screen now, `clear` drops it, and
+ * `resolve` waits for a capture in flight so a quick send still carries it. A capture that
+ * finishes after `clear` or a newer `start` is discarded.
+ */
+export function useFeedbackScreenshot() {
+  const [screenshot, setScreenshot] = useState<FeedbackScreenshot>({ status: "idle" });
+  const session = useRef(0);
+  const pending = useRef<Promise<Blob | null> | null>(null);
+  const url = useRef<string | null>(null);
+
+  const release = useCallback(() => {
+    if (url.current !== null) URL.revokeObjectURL(url.current);
+    url.current = null;
+  }, []);
+
+  const clear = useCallback(() => {
+    session.current += 1;
+    pending.current = null;
+    release();
+    setScreenshot({ status: "idle" });
+  }, [release]);
+
+  const start = useCallback(() => {
+    const current = ++session.current;
+    release();
+    setScreenshot({ status: "capturing" });
+    pending.current = capturePage().then(
+      (blob) => {
+        if (current !== session.current) return null;
+        url.current = URL.createObjectURL(blob);
+        setScreenshot({ status: "ready", url: url.current });
+        return blob;
+      },
+      () => {
+        if (current === session.current) setScreenshot({ status: "failed" });
+        return null;
+      },
+    );
+  }, [release]);
+
+  const resolve = useCallback(() => pending.current ?? Promise.resolve(null), []);
+
+  useEffect(() => release, [release]);
+
+  return { screenshot, start, clear, resolve };
+}
diff --git a/packages/ui/src/implementation/hooks/keyboard-inset.ts b/packages/ui/src/implementation/hooks/keyboard-inset.ts
new file mode 100644
index 0000000..2037da3
--- /dev/null
+++ b/packages/ui/src/implementation/hooks/keyboard-inset.ts
@@ -0,0 +1,20 @@
+import { useEffect, useState } from "react";
+
+/** How far the on-screen keyboard covers the bottom of the page while `active`, so a sheet can sit above it. */
+export function useKeyboardInset(active: boolean) {
+  const [inset, setInset] = useState(0);
+  useEffect(() => {
+    const viewport = window.visualViewport;
+    if (!active || !viewport) return;
+    const update = () =>
+      setInset(Math.max(0, window.innerHeight - viewport.height - viewport.offsetTop));
+    update();
+    viewport.addEventListener("resize", update);
+    viewport.addEventListener("scroll", update);
+    return () => {
+      viewport.removeEventListener("resize", update);
+      viewport.removeEventListener("scroll", update);
+    };
+  }, [active]);
+  return inset;
+}
diff --git a/packages/ui/src/implementation/lib/feedback-log.ts b/packages/ui/src/implementation/lib/feedback-log.ts
new file mode 100644
index 0000000..a674dee
--- /dev/null
+++ b/packages/ui/src/implementation/lib/feedback-log.ts
@@ -0,0 +1,196 @@
+/**
+ * Recent page errors and failed requests, kept in memory for the feedback form's "Attach logs".
+ * Entries are redacted as they are recorded, so no raw token, address or query string is held, and
+ * nothing leaves the page unless a person sends feedback with logs attached.
+ */
+
+/** One console error or one failed request. A request that never got a response has status 0. */
+export type FeedbackLogEntry =
+  | { readonly kind: "error"; readonly at: string; readonly message: string }
+  | {
+      readonly kind: "request";
+      readonly at: string;
+      readonly method: string;
+      readonly path: string;
+      /** Set when the request went to another origin, whose host is left out. */
+      readonly crossOrigin?: true;
+      readonly status: number;
+      readonly durationMs: number;
+    };
+
+const capacity = 50;
+const messageMax = 1000;
+const pathMax = 512;
+/** UTF-8 bytes of the entries a submission carries; the oldest beyond it are left out. */
+export const feedbackLogBytesMax = 16_384;
+
+/** Credentials, keys and addresses that can appear in error text, each replaced by its kind. */
+const secrets: ReadonlyArray<readonly [RegExp, (match: string, name?: string) => string]> = [
+  [
+    // An optional quote covers headers logged as JSON, such as {"cookie":"..."}.
+    /\b(authorization|proxy-authorization|cookie|set-cookie|x-api-key)\b["']?\s*[:=]\s*[^\n]*/gi,
+    (_, name) => `${name}: [redacted]`,
+  ],
+  [
+    /\b(password|passwd|secret|client[_-]?secret|api[_-]?key|access[_-]?token|refresh[_-]?token|token)\b["']?\s*[:=]\s*["']?[^\s"'&,;}]+/gi,
+    (_, name) => `${name}=[redacted]`,
+  ],
+  [/\b(bearer|basic)\s+[\w.~+/=-]{8,}/gi, (_, name) => `${name} [redacted]`],
+  [/\beyJ[\w-]*\.[\w-]*\.[\w-]*/g, () => "[jwt]"],
+  [
+    /\b(?:sk|pk|rk|sb|ghp|gho|ghu|ghs|ghr|glpat|github_pat|xox[abprs])[-_][\w-]{8,}/gi,
+    () => "[key]",
+  ],
+  [/[^\s@<>()[\]"'`,;:]+@[^\s@<>()[\]"'`,;:]+\.[a-z]{2,}/gi, () => "[email]"],
+  [/[\w.+-]+%40[\w.-]+\.[a-z]{2,}/gi, () => "[email]"],
+  [/\b[0-9a-f]{32,}\b/gi, () => "[hex]"],
+  // Long base64 runs that mix letters and digits; long words, slugs and paths stay readable.
+  [/[\w+-]{32,}={0,2}/g, (match) => (/\d/.test(match) && /[a-z]/i.test(match) ? "[token]" : match)],
+  [
+    /[A-Za-z\d+/]{40,}={0,2}/g,
+    (match) => (/\d/.test(match) && /[a-z]/.test(match) && /[A-Z]/.test(match) ? "[token]" : match),
+  ],
+];
+/** A URL or path keeps everything before its query string or fragment. */
+const queries = /((?:[a-z][a-z\d+.-]*:)?\/\/[^\s?#"'<>]+|\/[^\s?#"'<>]*)[?#][^\s"'<>]*/gi;
+
+/** Removes query strings, fragments, credentials, keys, emails and long tokens from `text`. */
+export const redactFeedbackText = (text: string) =>
+  secrets.reduce(
+    (result, [pattern, replace]) => result.replace(pattern, replace),
+    text.replace(queries, "$1"),
+  );
+
+const clip = (text: string, max: number) => (text.length > max ? `${text.slice(0, max)}…` : text);
+
+/**
+ * Text and errors are kept; any other value is named by its type only, so logged objects, such as
+ * a response a decoder rejected, never carry their contents. Clipping first bounds the redaction.
+ */
+const describe = (value: unknown): string => {
+  if (typeof value === "string") return clip(value, messageMax);
+  if (value instanceof Error) {
+    const frames = (value.stack ?? "")
+      .split("\n")
+      .filter((line) => /^\s*at |@/.test(line))
+      .slice(0, 5);
+    return clip([`${value.name}: ${value.message}`, ...frames].join("\n"), messageMax);
+  }
+  return `[${value === null ? "null" : typeof value}]`;
+};
+
+const entries: FeedbackLogEntry[] = [];
+const push = (entry: FeedbackLogEntry) => {
+  entries.push(entry);
+  if (entries.length > capacity) entries.shift();
+};
+
+const recordError = (values: ReadonlyArray<unknown>) => {
+  try {
+    const message = redactFeedbackText(values.map(describe).join(" "));
+    push({ kind: "error", at: new Date().toISOString(), message: clip(message, messageMax) });
+  } catch {
+    // Recording must never throw into the page.
+  }
+};
+
+/**
+ * The page's own fetch from before recording wrapped it, set once recording starts, and how many
+ * callers have paused recording, such as a screenshot loading its fonts. Only a browser page
+ * records, so this is never shared between requests.
+ */
+const recording: { native?: typeof fetch; paused: number } = { paused: 0 };
+
+/** Fetches without recording, for the feedback form's own requests. */
+export const untrackedFetch: typeof fetch = (input, init) =>
+  (recording.native ?? fetch)(input, init);
+
+/** Runs `work` without recording the requests made meanwhile, such as a screenshot's fonts. */
+export async function withoutFeedbackLog<A>(work: () => Promise<A>): Promise<A> {
+  recording.paused += 1;
+  try {
+    return await work();
+  } finally {
+    recording.paused -= 1;
+  }
+}
+
+/**
+ * Starts recording console errors, uncaught errors, unhandled rejections, scripts and stylesheets
+ * that fail to load, and fetches that fail or answer 4xx/5xx. Idempotent.
+ */
+export function installFeedbackLog() {
+  if (typeof window === "undefined" || recording.native !== undefined) return;
+  const consoleError = console.error;
+  console.error = (...values: unknown[]) => {
+    recordError(values);
+    consoleError.apply(console, values);
+  };
+  window.addEventListener(
+    "error",
+    (event) => {
+      const target = event.target;
+      if (!(target instanceof Element))
+        return recordError(["Uncaught", event.error ?? event.message]);
+      // Images fail routinely, such as avatars; a missing script or stylesheet breaks the page.
+      if (target instanceof HTMLScriptElement || target instanceof HTMLLinkElement)
+        recordError([
+          `Failed to load ${target.localName}`,
+          target.getAttribute("src") ?? target.getAttribute("href"),
+        ]);
+    },
+    true,
+  );
+  window.addEventListener("unhandledrejection", (event) =>
+    recordError(["Unhandled rejection", event.reason]),
+  );
+  const native = window.fetch.bind(window);
+  recording.native = native;
+  window.fetch = (input: RequestInfo | URL, init?: RequestInit) => {
+    const response = native(input, init);
+    if (recording.paused > 0) return response;
+    const url = URL.parse(input instanceof Request ? input.url : String(input), location.href);
+    // Only web requests are named; blob: and data: URLs carry no path worth reporting.
+    if (url === null || (url.protocol !== "https:" && url.protocol !== "http:")) return response;
+    const method = (
+      init?.method ?? (input instanceof Request ? input.method : "GET")
+    ).toUpperCase();
+    if (!/^[A-Z]{1,10}$/.test(method)) return response;
+    const crossOrigin = url.origin !== location.origin;
+    const at = new Date().toISOString();
+    const started = performance.now();
+    const failed = (status: number) =>
+      push({
+        kind: "request",
+        at,
+        method,
+        path: clip(redactFeedbackText(url.pathname), pathMax),
+        ...(crossOrigin ? { crossOrigin: true as const } : {}),
+        status,
+        durationMs: Math.round(performance.now() - started),
+      });
+    response.then(
+      (result) => {
+        if (result.status >= 400) failed(result.status);
+      },
+      (error: unknown) => {
+        // Navigation cancels in-flight queries; that is not a failure.
+        if (!(error instanceof DOMException && error.name === "AbortError")) failed(0);
+      },
+    );
+    return response;
+  };
+}
+
+/** The newest entries, oldest first, within `feedbackLogBytesMax`. */
+export function readFeedbackLog(): FeedbackLogEntry[] {
+  const encoder = new TextEncoder();
+  const kept: FeedbackLogEntry[] = [];
+  let bytes = 2;
+  for (const entry of [...entries].reverse()) {
+    bytes += encoder.encode(JSON.stringify(entry)).byteLength + 1;
+    if (bytes > feedbackLogBytesMax) break;
+    kept.unshift(entry);
+  }
+  return kept;
+}
diff --git a/packages/ui/src/implementation/lib/feedback-submit.ts b/packages/ui/src/implementation/lib/feedback-submit.ts
new file mode 100644
index 0000000..e1fc687
--- /dev/null
+++ b/packages/ui/src/implementation/lib/feedback-submit.ts
@@ -0,0 +1,52 @@
+/** The feedback form's request to a deployment's own feedback endpoint. */
+import { untrackedFetch, type FeedbackLogEntry } from "./feedback-log.ts";
+
+/** The longest message the form accepts. */
+export const feedbackMessageMax = 4000;
+
+/**
+ * What the form posts to the deployment's feedback endpoint, as JSON with the session cookie.
+ * `page` is the path without its query string; `screenshot.data` is base64.
+ */
+export interface FeedbackSubmission {
+  readonly message: string;
+  readonly page: string;
+  readonly screenshot?: { readonly name: string; readonly type: string; readonly data: string };
+  readonly logs?: ReadonlyArray<FeedbackLogEntry>;
+}
+
+/** The bytes of `blob` as base64. */
+export const toBase64 = async (blob: Blob) => {
+  const bytes = new Uint8Array(await blob.arrayBuffer());
+  let text = "";
+  for (let index = 0; index < bytes.length; index += 0x8000)
+    text += String.fromCharCode(...bytes.subarray(index, index + 0x8000));
+  return btoa(text);
+};
+
+/** Posts `submission`; the response status, or 0 when the request never got one. */
+export async function sendFeedback(endpoint: string, submission: FeedbackSubmission) {
+  try {
+    const response = await untrackedFetch(endpoint, {
+      method: "POST",
+      credentials: "same-origin",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify(submission),
+      signal: AbortSignal.timeout(30_000),
+    });
+    return response.status;
+  } catch {
+    return 0;
+  }
+}
+
+/** The one line the form shows for a failed send; `screenshot` says whether one was attached. */
+export const feedbackFailure = (status: number, screenshot: boolean) => {
+  if (status === 401 || status === 403) return "You're signed out. Sign in, then send again.";
+  if (status === 413)
+    return screenshot
+      ? "Screenshot too large. Untick it and send."
+      : "Logs too large. Untick them and send.";
+  if (status === 429) return "Too many in a row. Try again in a minute.";
+  return "Couldn't send. Try again.";
+};
