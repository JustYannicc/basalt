@@ -0,0 +1,287 @@
+import { expect, layer } from "@effect/vitest";
+import { Deferred, Effect } from "effect";
+import type { Locator, Page, Request } from "playwright";
+import { Actors } from "../support/actors.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Evidence } from "../support/evidence.ts";
+import { openThroughBrowser } from "../support/in-app-navigation.ts";
+import { observeNavigation } from "../support/instant-navigation.ts";
+import { holdQuery, refreshVisiblePage } from "../support/query-transition.ts";
+import { batchedReads, batchPath } from "../support/read-batches.ts";
+import { scenarios } from "../test-plan.ts";
+
+type QueueRead = "workflowInputs.list" | "schedules.runs";
+const queueEndpoint = /^\/api\/organizations\/[^/]+\/(?:workflow-inputs|scheduled-runs)$/;
+const viewCode = /\/assets\/approvals-list-client-[^/]+\.js$/;
+/** The queue also names apps from the organization's inventory; its answer completes the queue. */
+const inventoryEndpoint = /^\/api\/organizations\/[^/]+\/inventory$/;
+const readsInventory = (request: Request) =>
+  request.method() === "GET" && inventoryEndpoint.test(new URL(request.url()).pathname);
+
+/** The queue's two reads, whether the dashboard batched them or sent them on their own. */
+const queueReads = (request: Request): readonly QueueRead[] => {
+  const path = new URL(request.url()).pathname;
+  if (request.method() === "POST" && path === batchPath)
+    return batchedReads(request.postData()).flatMap((read): QueueRead[] =>
+      read.group === "workflowInputs" && read.endpoint === "list"
+        ? ["workflowInputs.list"]
+        : read.group === "schedules" && read.endpoint === "runs"
+          ? ["schedules.runs"]
+          : [],
+    );
+  if (request.method() !== "GET" || !queueEndpoint.test(path)) return [];
+  return [path.endsWith("/workflow-inputs") ? "workflowInputs.list" : "schedules.runs"];
+};
+
+/**
+ * Intent on the Human in the loop link reads the queue before the click and holds it only until it
+ * answers. The proof is the read itself, its retained answer on the destination's first frame, and
+ * the absence of any later poll or focus read while the link was never followed.
+ */
+layer(HostedLive, { excludeTestServices: true })("Human in the loop intent prefetch", (it) => {
+  for (const width of [1280, 390]) {
+    const phone = width === 390;
+    const scenario = phone
+      ? scenarios.hitlIntentPrefetchPhone
+      : scenarios.hitlIntentPrefetchDesktop;
+    it.effect(scenario.title, (context) =>
+      withHostedCase(
+        context,
+        Effect.gen(function* () {
+          const actors = yield* Actors;
+          const browser = yield* Browser;
+          const evidence = yield* Evidence;
+          const organization = `/org/${actors.organization.slug}`;
+          const reads: QueueRead[] = [];
+          const answered: QueueRead[] = [];
+          let viewLoaded = yield* Deferred.make<void>();
+          let inventoryInFlight = 0;
+          const record = (request: Request) => {
+            reads.push(...queueReads(request));
+            if (readsInventory(request)) inventoryInFlight += 1;
+          };
+          const finished = (request: Request) => {
+            answered.push(...queueReads(request));
+            if (readsInventory(request)) inventoryInFlight -= 1;
+            if (viewCode.test(new URL(request.url()).pathname))
+              Deferred.doneUnsafe(viewLoaded, Effect.void);
+          };
+          const queueFailed = yield* Deferred.make<void>();
+          const failed = (request: Request) => {
+            if (readsInventory(request)) inventoryInFlight -= 1;
+            if (queueReads(request).length > 0) Deferred.doneUnsafe(queueFailed, Effect.void);
+          };
+          yield* browser.login(actors.owner);
+          yield* Effect.acquireRelease(
+            browser.use("Observe queue reads with the browser clock", (page) =>
+              page.clock
+                .install()
+                .then(() =>
+                  // An active route sends a matching batched read as its own request.
+                  page.route(
+                    (url) =>
+                      queueEndpoint.test(url.pathname) || inventoryEndpoint.test(url.pathname),
+                    (route) => route.fallback(),
+                  ),
+                )
+                .then(() => {
+                  page.on("request", record);
+                  page.on("requestfinished", finished);
+                  page.on("requestfailed", failed);
+                  return page.setViewportSize({ width, height: 844 });
+                }),
+            ),
+            () =>
+              browser
+                .use("Stop observing queue reads", (page) => {
+                  page.off("request", record);
+                  page.off("requestfinished", finished);
+                  page.off("requestfailed", failed);
+                  return Promise.resolve();
+                })
+                .pipe(Effect.orDie),
+          );
+          const settle = (label: string) =>
+            browser.use(label, (page) =>
+              Promise.all([
+                page.evaluate(
+                  () =>
+                    new Promise<void>((resolve) =>
+                      requestAnimationFrame(() => requestAnimationFrame(() => resolve())),
+                    ),
+                ),
+                page.clock.runFor(100),
+              ]).then(() => undefined),
+            );
+          // Roles skip the hidden copy: the sidebar at desktop width, the Menu sheet on a phone.
+          const link = (page: Page): Locator =>
+            page
+              .getByRole("navigation", { name: "Main navigation" })
+              .getByRole("link", { name: "Human in the loop", exact: true });
+          const showLink = (label: string) =>
+            phone
+              ? browser.use(label, (page) =>
+                  page
+                    .getByRole("button", { name: "Menu", exact: true })
+                    .click()
+                    .then(() => link(page).waitFor()),
+                )
+              : browser.use(label, (page) => link(page).waitFor());
+          /** A fresh document on Apps that has never read the queue or loaded its view. */
+          const enterApps = (label: string) =>
+            Effect.gen(function* () {
+              viewLoaded = yield* Deferred.make<void>();
+              reads.length = 0;
+              answered.length = 0;
+              yield* openThroughBrowser(label, `${organization}/apps`);
+              yield* browser.use(`${label}: Apps is shown`, (page) =>
+                // The heading also names the app count.
+                page.getByRole("heading", { name: /^Apps/ }).first().waitFor(),
+              );
+              yield* settle(`${label}: entry settles`);
+              expect(reads, "Apps reads no queue before any intent").toEqual([]);
+            });
+          /**
+           * The queue read the intent started. A missing read is reported as an assertion; the
+           * bounded wait only stops a run that would otherwise wait for a read never sent.
+           */
+          const warmed = (label: string, intent: (page: Page) => Promise<void>) =>
+            Effect.gen(function* () {
+              const read = yield* browser.use(label, (page) =>
+                Promise.all([
+                  page
+                    .waitForRequest((request) => queueReads(request).length > 0, {
+                      timeout: 5_000,
+                    })
+                    .catch(() => null),
+                  intent(page).then(() => page.clock.runFor(100)),
+                ]).then(([request]) => request),
+              );
+              expect(read, `${label} reads the queue before the click`).not.toBeNull();
+              yield* browser.use(`${label}: the queue answers`, (page) =>
+                Promise.all(
+                  (["workflowInputs.list", "schedules.runs"] as const).map((endpoint) =>
+                    answered.includes(endpoint)
+                      ? Promise.resolve()
+                      : page
+                          .waitForEvent("requestfinished", (request) =>
+                            queueReads(request).includes(endpoint),
+                          )
+                          .then(() => undefined),
+                  ),
+                ),
+              );
+              // The queue's hold ends once the inventory it joins has answered too.
+              yield* browser.use(`${label}: the inventory answers`, (page) => {
+                const drained = (): Promise<void> =>
+                  inventoryInFlight === 0
+                    ? Promise.resolve()
+                    : page.waitForEvent("requestfinished", readsInventory).then(drained);
+                return drained();
+              });
+              yield* Deferred.await(viewLoaded);
+              yield* settle(`${label}: the answer settles`);
+              expect(
+                yield* browser.use(`${label}: still on Apps`, (page) =>
+                  Promise.resolve(new URL(page.url()).pathname),
+                ),
+              ).toBe(`${organization}/apps`);
+              expect([...reads].sort(), `${label} reads each queue endpoint once`).toEqual([
+                "schedules.runs",
+                "workflowInputs.list",
+              ]);
+            });
+          /**
+           * Following the link renders the retained queue on its first frame: no loading state. A
+           * stale answer is read again behind it; when that read fails the queue stays shown.
+           */
+          const followed = (label: string, key: string, refresh: "fresh" | "stale-fails") =>
+            Effect.gen(function* () {
+              const failing =
+                refresh === "stale-fails" ? yield* holdQuery(queueEndpoint, "fail") : undefined;
+              const observation = yield* observeNavigation(
+                label,
+                { kind: "sidebar", link: "Human in the loop" },
+                { text: "Nothing needs you right now" },
+              );
+              yield* evidence.json(`hitl-intent-${key}-${width}.json`, {
+                label,
+                observation,
+                reads,
+              });
+              expect(observation.contentMs, `${label} shows the queue`).not.toBeNull();
+              expect(observation.contentAtStart).toBe(false);
+              expect(observation.loading, `${label} commits no loading state`).toEqual([]);
+              yield* browser.use(`${label}: the heading is shown`, (page) =>
+                page
+                  .getByRole("main")
+                  .getByRole("heading", { name: "Human in the loop", exact: true })
+                  .waitFor(),
+              );
+              if (failing === undefined) return;
+              yield* failing.requested;
+              yield* failing.release;
+              yield* Deferred.await(queueFailed);
+              yield* settle(`${label}: the failed refresh settles`);
+              const kept = yield* browser.use(
+                `${label}: the queue after its failed refresh`,
+                (page) =>
+                  page
+                    .getByRole("main")
+                    .getByText("Nothing needs you right now", { exact: true })
+                    .isVisible(),
+              );
+              yield* browser.checkpoint(`${label} after a failed refresh at ${width}`);
+              expect(kept, `${label}: a failed refresh keeps the cached queue`).toBe(true);
+            });
+
+          // Pointer hover on desktop, touch on the phone's navigation sheet.
+          yield* enterApps("Enter Apps for the primary intent");
+          yield* showLink("Show the Human in the loop link");
+          const primary = phone
+            ? "Touch the Human in the loop link"
+            : "Hover the Human in the loop link";
+          yield* warmed(primary, (page) =>
+            phone ? link(page).dispatchEvent("touchstart") : link(page).hover(),
+          );
+          // Repeated intent while the answer is fresh starts nothing new.
+          yield* browser.use("Repeat the intent", (page) =>
+            (phone
+              ? link(page).dispatchEvent("touchstart")
+              : page.mouse.move(0, 0).then(() => link(page).hover())
+            ).then(() => page.clock.runFor(100)),
+          );
+          yield* settle("The repeated intent settles");
+          expect(reads.length, "Repeated intent is deduplicated").toBe(2);
+          // A link that was only shown intent must leave no poll or focus refresh behind.
+          if (!phone) yield* browser.use("Move the pointer away", (page) => page.mouse.move(0, 0));
+          const beforeIdle = reads.length;
+          yield* refreshVisiblePage;
+          yield* browser.use("Focus the window after intent", (page) =>
+            page.evaluate(() => {
+              window.dispatchEvent(new Event("focus"));
+            }),
+          );
+          yield* browser.use("Deliver six queue poll intervals", (page) =>
+            page.clock.runFor(31_000),
+          );
+          yield* settle("Flush fetch dispatch after the due timers");
+          const idleReads = reads.slice(beforeIdle);
+          yield* evidence.json(`hitl-intent-idle-${width}.json`, { idleReads });
+          expect(idleReads, "An unfollowed intent keeps no poll or focus read").toEqual([]);
+          yield* browser.checkpoint(`Intent settled without navigating at ${width}`);
+          yield* followed("Follow the warmed link", "intent", "stale-fails");
+          yield* browser.checkpoint(`Queue from the intent's read at ${width}`);
+
+          // Keyboard focus is intent too.
+          yield* enterApps("Enter Apps for keyboard focus");
+          yield* showLink("Show the link for keyboard focus");
+          yield* warmed("Focus the Human in the loop link", (page) => link(page).focus());
+          yield* followed("Follow the focused link", "focus", "fresh");
+          yield* browser.checkpoint(`Queue from the focus read at ${width}`);
+        }),
+      ),
+    );
+  }
+});
