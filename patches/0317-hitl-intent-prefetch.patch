+          const browser = yield* Browser;
+          const evidence = yield* Evidence;
+          const a = actors.organization;
+          const target = yield* Target;
+
+          // One owner-private question in A.
+          yield* f.share("private");
+          const run = yield* f.start();
+          yield* f.pending(run.id);
+
+          // Self-host has exactly one organization. Cloud exercises the real switcher below.
+          const b =
+            target.metadata.target === "cloud"
+              ? yield* Effect.gen(function* () {
