+                      requestAnimationFrame(() => requestAnimationFrame(() => resolve())),
+                    ),
+                ),
+                page.clock.runFor(ms),
+              ]).then(() => undefined),
+            );
+          const link = (page: Page): Locator =>
+            page
+              .getByRole("navigation", { name: "Main navigation" })
+              .getByRole("link", { name: "Human in the loop", exact: true });
+          const showLink = (label: string) =>
+            phone
+              ? browser.use(label, (page) =>
+                  link(page)
+                    .isVisible()
+                    .then((visible) =>
+                      visible
+                        ? undefined
+                        : page.getByRole("button", { name: "Menu", exact: true }).click(),
+                    )
+                    .then(() => link(page).waitFor()),
+                )
+              : browser.use(label, (page) => link(page).waitFor());
+          // Hover on desktop. The phone context has no touch support (shared Browser), so keyboard
+          // focus is its intent here; touch stays the existing spec's synthetic touchstart.
+          const intent = (page: Page) => (phone ? link(page).focus() : link(page).hover());
+          const away = (page: Page) =>
+            phone
+              ? link(page).evaluate((element) => (element as HTMLElement).blur())
+              : page.mouse.move(0, 0);
+          const reset = (newDocument = true) =>
+            Effect.gen(function* () {
+              if (newDocument) viewLoaded = yield* Deferred.make<void>();
+              reads.length = 0;
+              answered.length = 0;
+              blocked.length = 0;
+            });
+          const enterApps = (label: string, slug: string) =>
+            Effect.gen(function* () {
+              yield* reset();
+              yield* openThroughBrowser(label, `/org/${slug}/apps`);
+              yield* browser.use(`${label}: Apps is shown`, (page) =>
+                page.getByRole("heading", { name: /^Apps/ }).first().waitFor(),
+              );
+              yield* settle(`${label}: entry settles`);
+              expect(reads, `${label}: Apps reads no queue before any intent`).toEqual([]);
+            });
+          /** The intent's reads, their answers and the queue view, for both endpoints. */
+          const warm = (label: string) =>
+            Effect.gen(function* () {
