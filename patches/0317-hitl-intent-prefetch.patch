+import { workflowInputFixture } from "../support/workflow-input-fixture.ts";
+import { scenarios } from "../test-plan.ts";
+
+type QueueRead = {
+  readonly endpoint: "workflowInputs.list" | "schedules.runs";
+  readonly organization: string;
+};
+const queueEndpoint = /^\/api\/organizations\/([^/]+)\/(?:workflow-inputs|scheduled-runs)$/;
+const inputsEndpoint = /^\/api\/organizations\/[^/]+\/workflow-inputs$/;
+const viewCode = /\/assets\/approvals-list-client-[^/]+\.js$/;
+const inventoryEndpoint = /^\/api\/organizations\/[^/]+\/inventory$/;
+const readsInventory = (request: Request) =>
+  request.method() === "GET" && inventoryEndpoint.test(new URL(request.url()).pathname);
+const question = "Choose a synthetic action";
+const empty = "Nothing needs you right now";
+const Created = Schema.Struct({ id: Schema.String, slug: Schema.String, name: Schema.String });
+
+/** The queue's two reads and the organization each names, batched or on their own. */
+const queueReads = (request: Request): readonly QueueRead[] => {
+  const path = new URL(request.url()).pathname;
+  if (request.method() === "POST" && path === batchPath)
+    return batchedReads(request.postData()).flatMap((read): QueueRead[] =>
+      (read.group === "workflowInputs" && read.endpoint === "list") ||
+      (read.group === "schedules" && read.endpoint === "runs")
+        ? [
+            {
+              endpoint: read.group === "workflowInputs" ? "workflowInputs.list" : "schedules.runs",
+              organization: read.params.organization ?? "",
+            },
+          ]
+        : [],
+    );
+  const match = request.method() === "GET" ? queueEndpoint.exec(path) : null;
+  if (match === null) return [];
+  return [
+    {
+      endpoint: path.endsWith("/workflow-inputs") ? "workflowInputs.list" : "schedules.runs",
+      organization: match[1] ?? "",
+    },
+  ];
+};
+/** Intent and an unfollowed link may only read: no write and no health check. */
+const forbidden = (request: Request): string | null => {
+  const path = new URL(request.url()).pathname;
+  // Browser telemetry records the read itself; these two sinks do not mutate product data.
+  if (request.method() === "POST" && /^\/api\/telemetry\/(traces|logs)$/.test(path)) return null;
+  // The managed Cloud fixture routes analytics and error reports through fixed test channels.
+  if (
+    request.method() === "POST" &&
+    [
+      "/api/fedcba9876543210/submit",
+      "/api/0123456789abcdef/push",
+      "/api/0123456789abcdef/flags/",
+    ].includes(path)
+  )
+    return null;
+  if (/health/i.test(path)) return `${request.method()} ${path}`;
+  if (request.method() === "GET" || (request.method() === "POST" && path === batchPath))
+    return null;
+  return `${request.method()} ${path}`;
+};
+
+/**
+ * Who and where the intent read is for. A warmed queue is shown with its question on the first
+ * frame; switching organization in the same document, or signing in as another person in a new
+ * document, reads that destination's own queue and never paints the first one's question. A read
+ * held past the 10 second intent bound leaves no poll or focus read behind.
+ */
+layer(HostedLive, { excludeTestServices: true })("Human in the loop intent scope", (it) => {
