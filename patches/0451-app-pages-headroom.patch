index 0000000000000000000000000000000000000000..d07d039a41a6c300e9aa966bdf7796078204ec94
--- /dev/null
+++ b/packages/apps/src/implementation/ui-document-native.ts
@@ -0,0 +1,45 @@
+/** Cloud uses workerd's HTML parser instead of uploading another HTML engine. */
+import type {
+  HTMLRewriter as NativeHTMLRewriter,
+  Response as NativeResponse,
+} from "@cloudflare/workers-types";
+import { decodeHTMLAttribute } from "./ui-document-decode.ts";
+import { documentResources } from "./ui-document-resources.ts";
+
+declare const HTMLRewriter: typeof NativeHTMLRewriter;
+declare const Response: typeof NativeResponse;
+
+export const versionDocument = async (html: string, version: string) => {
+  const rewrite = documentResources(version);
+  let css = "";
+  return new HTMLRewriter()
+    .on("*", {
+      element(element) {
+        const seen = new Set<string>();
+        const attributes = Array.from(element.attributes)
+          .filter(([name]) => {
+            const key = name.toLowerCase();
+            if (seen.has(key)) return false;
+            seen.add(key);
+            return true;
+          })
+          .map(([name, value]) => ({ name, value: decodeHTMLAttribute(value) }));
+        for (const [index, attribute] of rewrite
+          .attributes(element.tagName === "feimage" ? "feImage" : element.tagName, attributes)
+          .entries())
+          if (attribute.value !== attributes[index]!.value)
+            element.setAttribute(attribute.name, attribute.value.replaceAll("&", "&amp;"));
+      },
+    })
+    .on("style", {
+      text(text) {
+        css += text.text;
+        if (text.lastInTextNode) {
+          text.replace(rewrite.css(css), { html: true });
+          css = "";
+        } else text.remove();
+      },
+    })
+    .transform(new Response(html, { headers: { "content-type": "text/html; charset=utf-8" } }))
+    .text();
+};
