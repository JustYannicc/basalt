--- /dev/null
+++ b/packages/apps/src/implementation/ui-document-decode.ts
@@ -0,0 +1,10 @@
+/** Portable attribute decoding; Cloud binds the same parser dependency's decoder directly. */
+import { parseFragment } from "parse5";
+
+export const decodeHTMLAttribute = (value: string) => {
+  const document = parseFragment(`<x value="${value.replaceAll('"', "&quot;")}"></x>`);
+  const element = document.childNodes[0];
+  return element !== undefined && "attrs" in element
+    ? (element.attrs.find((attribute) => attribute.name === "value")?.value ?? "")
+    : "";
+};
diff --git a/packages/apps/src/implementation/ui-document-native.ts b/packages/apps/src/implementation/ui-document-native.ts
