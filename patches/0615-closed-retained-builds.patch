--- /dev/null
+++ b/packages/sdk/src/contracts/unverified-retained-build.ts
@@ -0,0 +1,28 @@
+import { Schema } from "effect";
+
+export const RetainedFrameworkTuple = Schema.Struct({
+  version: Schema.NonEmptyString,
+  protocol: Schema.Int.check(Schema.isGreaterThanOrEqualTo(1)),
+  sha256: Schema.String.check(Schema.isPattern(/^[0-9a-f]{64}$/u)),
+});
+export type RetainedFrameworkTuple = typeof RetainedFrameworkTuple.Type;
+
+export const unverifiedRetainedBuildReason = "active at sync, provenance unproven";
+
+/** Permission for one existing build to serve; this asserts no framework source provenance. */
+export const UnverifiedRetainedBuild = Schema.Struct({
+  _tag: Schema.Literal("UnverifiedRetainedBuild"),
+  app: Schema.NonEmptyString,
+  build: Schema.NonEmptyString,
+  reason: Schema.Literal(unverifiedRetainedBuildReason),
+  tuple: RetainedFrameworkTuple,
+});
+export type UnverifiedRetainedBuild = typeof UnverifiedRetainedBuild.Type;
+
+/** Supplied only by the host's atomic pin transaction, never by a loaded build or transport. */
+export const CommittedRetainedBuildPin = Schema.Struct({
+  app: Schema.NonEmptyString,
+  build: Schema.NonEmptyString,
+  tuple: RetainedFrameworkTuple,
+});
+export type CommittedRetainedBuildPin = typeof CommittedRetainedBuildPin.Type;
