diff --git a/apps/hosted/cloud/src/implementation/unverified-retained-build-pins.ts b/apps/hosted/cloud/src/implementation/unverified-retained-build-pins.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/cloud/src/implementation/unverified-retained-build-pins.ts
@@ -0,0 +1,118 @@
+import type { DurableObjectStorage } from "@cloudflare/workers-types";
+import { Effect, Schema } from "effect";
+import { FrameworkProvenanceRefused } from "@executor-js/sdk/core";
+import {
+  CommittedRetainedBuildPin,
+  RetainedFrameworkTuple,
+  findUnverifiedRetainedBuild,
+} from "@executor-js/sdk/workerd";
+
+const PinReply = Schema.Union([
+  Schema.Struct({ ok: Schema.Literal(true), pin: CommittedRetainedBuildPin }),
+  Schema.Struct({ ok: Schema.Literal(false), error: FrameworkProvenanceRefused }),
+]);
+export type PinReply = typeof PinReply.Encoded;
+
+const sameTuple = (left: RetainedFrameworkTuple, right: RetainedFrameworkTuple) =>
+  left.version === right.version &&
+  left.protocol === right.protocol &&
+  left.sha256 === right.sha256;
+
+const tupleLabel = ({ version, protocol, sha256 }: RetainedFrameworkTuple) => {
+  const safeVersion = Array.from(version, (char) => {
+    const code = char.charCodeAt(0);
+    return code < 32 || code === 127 ? "?" : char;
+  }).join("");
+  const boundedVersion = safeVersion.length > 96 ? `${safeVersion.slice(0, 96)}…` : safeVersion;
+  return `${boundedVersion}/${protocol}/${sha256.slice(0, 12)}`;
+};
+
+const refused = (build: string | undefined, comparison: string) =>
+  new FrameworkProvenanceRefused({
+    reason: "conflicting-lineage",
+    ...(build === undefined ? {} : { build }),
+    comparison,
+  });
+
+/** A per-app first-observation pin. The object identity and one transaction own the decision. */
+export const makeUnverifiedRetainedBuildPin =
+  (storage: DurableObjectStorage, serves: (app: string) => boolean) =>
+  (input: unknown): Effect.Effect<CommittedRetainedBuildPin, FrameworkProvenanceRefused> =>
+    Effect.gen(function* () {
+      if (!Schema.is(CommittedRetainedBuildPin)(input))
+        return yield* Effect.fail(refused(undefined, "Malformed retained-build pin request."));
+
+      const { app, build, tuple } = input;
+      const entry = findUnverifiedRetainedBuild(build);
+      if (entry === undefined || entry.policy !== "pin-first-observation" || entry.app !== app)
+        return yield* Effect.fail(
+          refused(build, "The app and build are not the closed pin-first retained-build entry."),
+        );
+      if (!Schema.is(RetainedFrameworkTuple)(tuple))
+        return yield* Effect.fail(refused(build, "Malformed observed framework tuple."));
+      if (!serves(app))
+        return yield* Effect.fail(
+          refused(build, "This Durable Object is not the configured supervisor for the app."),
+        );
+
+      const key = `executor:unverified-retained-build:${app}:${build}`;
+      const candidate = Object.freeze({
+        app,
+        build,
+        tuple: Object.freeze({ ...tuple }),
+      });
+      const saved = yield* Effect.tryPromise({
+        try: () =>
+          storage.transaction(async (transaction) => {
+            const current = await transaction.get<unknown>(key);
+            if (current !== undefined) return current;
+            await transaction.put(key, candidate);
+            return candidate;
+          }),
+        catch: () =>
+          refused(
+            build,
+            "The supervisor could not atomically read or commit the retained-build pin.",
+          ),
+      });
+
+      if (!Schema.is(CommittedRetainedBuildPin)(saved))
+        return yield* Effect.fail(refused(build, "The committed retained-build pin is malformed."));
+      if (saved.app !== app || saved.build !== build)
+        return yield* Effect.fail(
+          refused(build, "The committed retained-build pin belongs to another app or build."),
+        );
+      if (!sameTuple(saved.tuple, tuple))
+        return yield* Effect.fail(
+          refused(
+            build,
+            `Committed tuple ${tupleLabel(saved.tuple)} differs from observed tuple ${tupleLabel(tuple)}.`,
+          ),
+        );
+      return saved;
+    });
+
+/** RPC errors cross as plain schema data; callers reconstruct the tagged error locally. */
+export const encodePinReply = (
+  effect: Effect.Effect<CommittedRetainedBuildPin, FrameworkProvenanceRefused>,
+) =>
+  effect.pipe(
+    Effect.match({
+      onSuccess: (pin) => ({ ok: true as const, pin }),
+      onFailure: (error) => ({
+        ok: false as const,
+        error: Schema.encodeUnknownSync(FrameworkProvenanceRefused)(error),
+      }),
+    }),
+  );
+
+export const decodePinReply = (
+  reply: unknown,
+  build?: string,
+): Effect.Effect<CommittedRetainedBuildPin, FrameworkProvenanceRefused> =>
+  Schema.decodeUnknownEffect(PinReply)(reply).pipe(
+    Effect.mapError(() => refused(build, "The app-data supervisor returned an invalid pin reply.")),
+    Effect.flatMap((result) =>
+      result.ok ? Effect.succeed(result.pin) : Effect.fail(result.error),
+    ),
+  );
