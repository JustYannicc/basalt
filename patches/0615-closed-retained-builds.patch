diff --git a/packages/sdk/src/implementation/unverified-retained-build.ts b/packages/sdk/src/implementation/unverified-retained-build.ts
new file mode 100644
--- /dev/null
+++ b/packages/sdk/src/implementation/unverified-retained-build.ts
@@ -0,0 +1,147 @@
+import { Effect, Schema } from "effect";
+import { FrameworkProvenanceRefused } from "../contracts/runtime.ts";
+import {
+  CommittedRetainedBuildPin,
+  RetainedFrameworkTuple,
+  UnverifiedRetainedBuild,
+} from "../contracts/unverified-retained-build.ts";
+import type { LoadedWorkerBuild } from "../contracts/worker-build.ts";
+import { appProtocol } from "./app-protocols.ts";
+import { frameworkIdentity } from "./framework-identity.ts";
+import { inlinedFramework, selectFrameworkProtocol } from "./framework-provenance.ts";
+import { closedRetainedBuilds, type ClosedRetainedBuild } from "./closed-retained-builds.ts";
+
+/** Storage has only the build ID. Invocation validation must also check the app ID. */
+export const findUnverifiedRetainedBuild = (build: string) =>
+  closedRetainedBuilds.find((entry) => entry.build === build);
+
+const sameTuple = (left: RetainedFrameworkTuple, right: RetainedFrameworkTuple) =>
+  left.version === right.version &&
+  left.protocol === right.protocol &&
+  left.sha256 === right.sha256;
+
+const describe = (tuple: RetainedFrameworkTuple) =>
+  `${tuple.version}/${tuple.protocol}/${tuple.sha256}`;
+
+const refused = (build: string, comparison: string) =>
+  new FrameworkProvenanceRefused({ build, reason: "conflicting-lineage", comparison });
+
+const entryFor = (build: string) => {
+  const entry = findUnverifiedRetainedBuild(build);
+  return entry === undefined
+    ? Effect.fail(refused(build, `Build ${build} is absent from the closed retained-build list.`))
+    : Effect.succeed(entry);
+};
+
+const verifyTuple = (
+  build: string,
+  expected: RetainedFrameworkTuple,
+  observed: RetainedFrameworkTuple,
+) =>
+  Schema.is(RetainedFrameworkTuple)(observed) && sameTuple(expected, observed)
+    ? Effect.void
+    : Effect.fail(
+        refused(
+          build,
+          `Expected retained tuple ${describe(expected)}; observed ${describe(observed)}.`,
+        ),
+      );
+
+const marker = (
+  entry: ClosedRetainedBuild,
+  tuple: RetainedFrameworkTuple,
+): UnverifiedRetainedBuild =>
+  Object.freeze({
+    _tag: "UnverifiedRetainedBuild",
+    app: entry.app,
+    build: entry.build,
+    reason: entry.reason,
+    tuple: Object.freeze({ ...tuple }),
+  });
+
+/** The caller recomputes the framework hash from loaded bytes before calling. */
+export const verifyFixedRetainedBuild = (build: string, observed: RetainedFrameworkTuple) =>
+  Effect.gen(function* () {
+    const entry = yield* entryFor(build);
+    if (entry.policy !== "fixed-tuple")
+      return yield* refused(build, `Build ${build} requires an atomic durable tuple pin.`);
+    yield* verifyTuple(build, entry.tuple, observed);
+    return marker(entry, entry.tuple);
+  });
+
+/** The receipt must come from a committed app+build pin, including on later loads. */
+export const verifyPinnedRetainedBuild = (
+  build: string,
+  observed: RetainedFrameworkTuple,
+  pin: CommittedRetainedBuildPin,
+) =>
+  Effect.gen(function* () {
+    const entry = yield* entryFor(build);
+    if (entry.policy !== "pin-first-observation")
+      return yield* refused(
+        build,
+        `Build ${build} has a fixed tuple; a durable pin cannot replace it.`,
+      );
+    if (!Schema.is(CommittedRetainedBuildPin)(pin))
+      return yield* refused(build, `Build ${build} has no valid committed durable tuple pin.`);
+    if (pin.app !== entry.app || pin.build !== entry.build)
+      return yield* refused(
+        build,
+        `Expected pin for ${entry.app}/${entry.build}; observed ${pin.app}/${pin.build}.`,
+      );
+    yield* verifyTuple(build, pin.tuple, observed);
+    return marker(entry, observed);
+  });
+
+/** The host obtains a receipt from its own atomic app storage, never the build transport. */
+export type RetainedBuildPin = (
+  tuple: RetainedFrameworkTuple,
+) => Effect.Effect<CommittedRetainedBuildPin, FrameworkProvenanceRefused>;
+
+export const retainedBuildMarker = (
+  build: string,
+  observed: RetainedFrameworkTuple,
+  pin?: RetainedBuildPin,
+) =>
+  Effect.gen(function* () {
+    const entry = yield* entryFor(build);
+    if (entry.policy === "fixed-tuple") return yield* verifyFixedRetainedBuild(build, observed);
+    if (pin === undefined)
+      return yield* refused(build, `Build ${build} requires its host's durable tuple pin.`);
+    return yield* verifyPinnedRetainedBuild(build, observed, yield* pin(observed));
+  });
+
+/** Existing app calls have an exact app and build; compilation and public declaration do not. */
+export const selectInvocationFrameworkProtocol = (
+  loaded: LoadedWorkerBuild,
+  invocation: { readonly app: string; readonly build: string },
+  pin?: RetainedBuildPin,
+) =>
+  Effect.gen(function* () {
+    const entry = findUnverifiedRetainedBuild(invocation.build);
+    if (entry === undefined)
+      return yield* selectFrameworkProtocol(loaded, { build: invocation.build });
+    if (!Schema.is(UnverifiedRetainedBuild)(loaded.unverified))
+      return yield* refused(
+        invocation.build,
+        `Build ${invocation.build} has no retained-build marker.`,
+      );
+    if (
+      entry.app !== invocation.app ||
+      loaded.unverified.app !== invocation.app ||
+      loaded.unverified.build !== invocation.build
+    )
+      return yield* refused(
+        invocation.build,
+        `Retained app ${entry.app} and marker ${loaded.unverified.app}/${loaded.unverified.build} differ from invocation ${invocation.app}/${invocation.build}.`,
+      );
+    const framework = yield* inlinedFramework(
+      loaded,
+      loaded.unverified.tuple.version,
+      invocation.build,
+    );
+    const observed = { ...(yield* frameworkIdentity(framework)), protocol: loaded.protocol };
+    yield* verifyTuple(invocation.build, loaded.unverified.tuple, observed);
+    const verified = yield* retainedBuildMarker(invocation.build, observed, pin);
+    return yield* appProtocol(verified.tuple.protocol);
+  });
