diff --git a/apps/hosted/cloud/src/implementation/compiler-phases.ts b/apps/hosted/cloud/src/implementation/compiler-phases.ts
new file mode 100644
index 00000000..cccf09b0
--- /dev/null
+++ b/apps/hosted/cloud/src/implementation/compiler-phases.ts
@@ -0,0 +1,75 @@
+/** Immediate records retain the last reached phase even when a compiler span never ends. */
+import type { CodeFiles } from "@executor-js/sdk/core";
+import { Effect, Option } from "effect";
+
+type Phase = "received" | "admitted" | "dependencies" | "bundle" | "replied" | "released" | "error";
+
+export const compilerPhases = (
+  files: CodeFiles,
+  publicPaths: ReadonlyArray<string>,
+  isolate: string,
+) =>
+  Effect.gen(function* () {
+    const span = yield* Effect.currentSpan.pipe(Effect.option);
+    const traceId = Option.isSome(span) ? span.value.traceId : null;
+    const attempt = crypto.randomUUID();
+    const started = performance.now();
+    let sourceDigest: string | null = null;
+    let previous: Phase | undefined;
+    let transitions = 0;
+    let truncated = false;
+    const terminals = new Set<Phase>();
+    const emit = (phase: Phase | "truncated") => {
+      // Diagnostic transport must never change a build's outcome.
+      try {
+        console.log(
+          JSON.stringify({
+            type: "executor.compiler.phase",
+            traceId,
+            attempt,
+            isolate,
+            sourceDigest,
+            phase,
+            elapsedMs: Math.max(0, performance.now() - started),
+          }),
+        );
+      } catch {}
+    };
+    const phase = (phase: Phase) => {
+      if (phase === "replied" || phase === "released" || phase === "error") {
+        if (terminals.has(phase)) return;
+        terminals.add(phase);
+        emit(phase);
+        return;
+      }
+      if (phase === previous) return;
+      previous = phase;
+      // At most 16 records: 12 transitions, one truncation marker and three terminal slots.
+      if (transitions === 12) {
+        if (!truncated) emit("truncated");
+        truncated = true;
+        return;
+      }
+      transitions++;
+      emit(phase);
+    };
+    phase("received");
+    // The caller runs this only after admission. Early records correlate by attempt ID.
+    const fingerprint = Effect.promise(async () => {
+      const canonical = JSON.stringify([
+        files
+          .map(({ path, content }) => ({ path, content }))
+          .sort((a, b) => a.path.localeCompare(b.path)),
+        [...publicPaths].sort(),
+      ]);
+      const bytes = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(canonical));
+      sourceDigest = Array.from(new Uint8Array(bytes), (byte) =>
+        byte.toString(16).padStart(2, "0"),
+      ).join("");
+    }).pipe(Effect.catchCause(() => Effect.void));
+    return { phase, fingerprint };
+  }).pipe(
+    Effect.catchCause(() =>
+      Effect.succeed({ phase: (_phase: Phase) => {}, fingerprint: Effect.void }),
+    ),
+  );
diff --git a/e2e/support/compiler-phase-evidence.ts b/e2e/support/compiler-phase-evidence.ts
new file mode 100644
index 00000000..76859ef4
--- /dev/null
+++ b/e2e/support/compiler-phase-evidence.ts
@@ -0,0 +1,68 @@
+/** Read the runner's retained log independently of completed compiler spans. */
+import { Effect, FileSystem, Option, Schema } from "effect";
+import { Target } from "./platform.ts";
+import { createHash } from "node:crypto";
+
+const Phase = Schema.Struct({
+  type: Schema.Literal("executor.compiler.phase"),
+  traceId: Schema.NullOr(Schema.String),
+  attempt: Schema.String,
+  isolate: Schema.String,
+  sourceDigest: Schema.NullOr(Schema.String),
+  phase: Schema.Literals([
+    "received",
+    "admitted",
+    "dependencies",
+    "bundle",
+    "replied",
+    "released",
+    "error",
+    "truncated",
+  ]),
+  elapsedMs: Schema.Number,
+});
+
+export const compilerPhaseEvidence = (
+  traceId: string,
+  files: ReadonlyArray<{ readonly path: string; readonly content: string }>,
+) =>
+  Effect.gen(function* () {
+    const sourceDigest = createHash("sha256")
+      .update(
+        JSON.stringify([
+          files
+            .map(({ path, content }) => ({ path, content }))
+            .sort((a, b) => a.path.localeCompare(b.path)),
+          [],
+        ]),
+      )
+      .digest("hex");
+    const target = yield* Target;
+    const fs = yield* FileSystem.FileSystem;
+    const text = yield* fs.readFileString(`${target.directory}/cloud.log`);
+    const records = text.split("\n").flatMap((line) => {
+      const start = line.indexOf('{"type":"executor.compiler.phase"');
+      if (start < 0) return [];
+      let value: unknown;
+      try {
+        value = JSON.parse(line.slice(start));
+      } catch {
+        return [];
+      }
+      const parsed = Schema.decodeUnknownOption(Phase)(value);
+      if (
+        Option.isNone(parsed) ||
+        parsed.value.traceId !== traceId ||
+        value === null ||
+        typeof value !== "object"
+      )
+        return [];
+      return [{ record: parsed.value, keys: Object.keys(value).sort() }];
+    });
+    const attempts = new Set(
+      records
+        .filter(({ record }) => record.sourceDigest === sourceDigest)
+        .map(({ record }) => record.attempt),
+    );
+    return records.filter(({ record }) => attempts.has(record.attempt));
+  });
