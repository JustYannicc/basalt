diff --git a/apps/hosted/server/src/implementation/catalog-app-defaults.ts b/apps/hosted/server/src/implementation/catalog-app-defaults.ts
new file mode 100644
index 000000000..c624d181c
--- /dev/null
+++ b/apps/hosted/server/src/implementation/catalog-app-defaults.ts
@@ -0,0 +1,251 @@
+/**
+ * Installed catalog apps roll forward to the feed's current source once per Basalt release. The
+ * catalog source is built first, without saving anything. Only an untouched copy whose linked
+ * accounts all keep working is deployed; anything else becomes an offer a manager applies.
+ * Results live in organization metadata.
+ */
+import { createCatalog } from "@executor-js/catalog";
+import {
+  StorageError,
+  sourceFilesEqual,
+  type App,
+  type Executor,
+  type OwnerId,
+  type SourceFiles,
+} from "@executor-js/sdk/core";
+import type { HostEgress } from "@executor-js/utils/url-policy";
+import { Effect, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import { CatalogAppSweep } from "../contracts/catalog-app-updates.ts";
+import { type OrganizationId, organizationOwner } from "../contracts/organization.ts";
+import type { OrganizationDefaults } from "../contracts/organization-defaults.ts";
+import { ScheduleWakeup } from "../contracts/schedules.ts";
+import {
+  breakingChanges,
+  catalogEntryId,
+  decideCatalogOffer,
+  decideCatalogUpdate,
+} from "./catalog-app-updates.ts";
+import { healCatalogWorkspace } from "./catalog-app-heal.ts";
+import { pinnedOnly } from "@executor-js/app-management/data-steps";
+import {
+  activeSource,
+  catalogDecision,
+  deployCatalogSource,
+  recordOf,
+  reportCatalogApp,
+  saveCatalogRecord,
+  savedRecords,
+  sourceDigest,
+  stillCurrent,
+  type CatalogOutcome,
+  type Saved,
+} from "./catalog-app-records.ts";
+
+const Links = Schema.Array(
+  Schema.Struct({
+    requirement: Schema.String,
+    scope: Schema.String,
+    subject: Schema.NullOr(Schema.String),
+    account: Schema.String,
+    provider: Schema.String,
+  }),
+);
+type Links = typeof Links.Type;
+
+/** The feed installs read, through the same egress. */
+export interface CatalogAppFeed {
+  readonly egress: HostEgress;
+  readonly url: string;
+}
+
+/**
+ * Decide one catalog copy against the catalog's `files`. Returns what to record, or undefined to
+ * keep the earlier record. Only an untouched copy no linked account breaks on is deployed, and
+ * only a deploy that became active over the version it was decided against is recorded as the
+ * catalog's own.
+ */
+export const updateCatalogApp = (
+  executor: { readonly apps: Executor["apps"] },
+  input: {
+    readonly organization: OrganizationId;
+    readonly owner: OwnerId;
+    readonly app: App;
+    readonly files: SourceFiles;
+    readonly recorded: Saved | undefined;
+    readonly links: Effect.Effect<Links, StorageError>;
+  },
+) =>
+  Effect.gen(function* () {
+    const { owner, app, files, recorded } = input;
+    const read = yield* activeSource(executor, owner, app, recorded);
+    if (read === undefined) return undefined;
+    const current = yield* healCatalogWorkspace(
+      executor,
+      input.organization,
+      owner,
+      app.id,
+      read,
+      recorded,
+    );
+    if (current === undefined) return undefined;
+    const { active, commit, clean } = current;
+    const digest = yield* sourceDigest(files);
+    // The digest recorded at apply stands in for the files, which retain binary ones by
+    // reference; without one, comparing files can only miss, costing one redeploy.
+    const unchanged =
+      (recorded?.applied === digest && recorded.version === active) ||
+      sourceFilesEqual(current.files, files);
+    const step = decideCatalogUpdate({ unchanged, clean });
+    if (step === "skip") return undefined;
+    // After a person's direct deploy, the commit read holds the source it replaced, so it is
+    // clean only when it holds the active source; the job's own versions keep their commit.
+    const ours = recorded?.version === active;
+    if (step === "record")
+      return {
+        record: {
+          version: active,
+          applied: digest,
+          ...((clean && ours) || pinnedOnly(current.workspace, current.files)
+            ? { workspace: commit }
+            : !ours || recorded?.workspace === undefined
+              ? {}
+              : { workspace: recorded.workspace }),
+        },
+        active,
+        deployed: false,
+      } satisfies CatalogOutcome;
+    // Compile without saving: requirements decide before anything, migrations included, runs.
+    const built = yield* executor.apps.build({ owner, name: app.name, files });
+    const breaks = breakingChanges(
+      yield* input.links,
+      app.requirements.accounts,
+      built.requirements.accounts,
+    );
+    const versions = (yield* executor.apps.versions({ owner, app: app.id, versionOwner: owner }))
+      .length;
+    const { untouched, decision } = decideCatalogOffer({
+      versions,
+      active,
+      recorded,
+      breaking: breaks.reconnect > 0 || breaks.reasons.length > 0,
+    });
+    if (decision === "apply") {
+      // The build took a while; a person's deploy, activation or edit since then wins.
+      const fresh = yield* stillCurrent(executor, owner, app.id, active, recorded);
+      if (fresh === undefined) return undefined;
+      return yield* deployCatalogSource(executor, owner, app.id, fresh, files, digest);
+    }
+    return {
+      record: {
+        ...(recorded?.version === undefined ? {} : { version: recorded.version }),
+        ...(recorded?.applied === undefined ? {} : { applied: recorded.applied }),
+        workspace: commit,
+        offer: { ...breaks, source: digest, active, touched: !untouched },
+      },
+      active,
+      deployed: false,
+    } satisfies CatalogOutcome;
+  });
+
+/** A build failure is the feed source's own; it stays until a later release. */
+const unbuildable = (entry: string) =>
+  Effect.logWarning("Catalog app update does not build", { entry }).pipe(Effect.as(undefined));
+
+/**
+ * Sweep one organization's copies of `feed`'s apps. Failures that a retry can fix fail the job
+ * after every app was tried; a delisted entry or a build the feed's source fails is left as is.
+ */
+export const catalogAppDefaults = (
+  executor: Executor,
+  feed: CatalogAppFeed,
+  organization: OrganizationId,
+) =>
+  Effect.suspend(() => {
+    let intent = false;
+    return Effect.gen(function* () {
+      const sql = yield* SqlClient.SqlClient;
+      const owner = organizationOwner(organization);
+      const saved = yield* savedRecords(organization);
+      if (saved === undefined) return;
+      const catalog = createCatalog({ egress: feed.egress, feedUrl: feed.url });
+      let failed = false;
+      for (const app of yield* executor.apps.list({ owner })) {
+        const entry = catalogEntryId(app.copiedFrom?.reference, feed.url);
+        if (entry === undefined) continue;
+        const recorded = recordOf(saved, app.id);
+        yield* Effect.gen(function* () {
+          if (app.activeVersion === null) return undefined;
+          const prepared = yield* catalog.prepare({ entry });
+          if (prepared.origin?.reference !== app.copiedFrom?.reference) return undefined;
+          const outcome = yield* updateCatalogApp(executor, {
+            organization,
+            owner,
+            app,
+            files: prepared.files,
+            recorded,
+            links: sql`select l.requirement, l.subject, l.account, a.provider,
+                case when l.subject is null then 'app' else 'user' end as scope
+              from hosted_app_account_links l join executor_accounts a on a.id = l.account
+              where l.app = ${app.id}`.pipe(
+              Effect.flatMap(Schema.decodeUnknownEffect(Links)),
+              Effect.mapError(() => new StorageError()),
+            ),
+          });
+          if (outcome === undefined) return undefined;
+          // A deploy leaves the app's webhook sources pending.
+          if (outcome.deployed) intent = true;
+          // An unchanged record needs no locked write.
+          if (catalogDecision(recorded, outcome) === "unchanged") return outcome;
+          const wrote = yield* saveCatalogRecord(executor, organization, app.id, recorded, outcome);
+          // A refused write keeps the earlier record; a deploy it refused still runs.
+          return wrote || outcome.deployed ? outcome : undefined;
+        }).pipe(
+          Effect.catchTags({
+            CatalogImportFailed: () => Effect.succeed(undefined),
+            AppNotFound: () => Effect.succeed(undefined),
+            VersionBuildFailed: () => unbuildable(entry),
+            BuildMemoryExceeded: () => unbuildable(entry),
+          }),
+          Effect.flatMap((outcome: CatalogOutcome | undefined) =>
+            reportCatalogApp(
+              organization,
+              app.id,
+              catalogDecision(recorded, outcome),
+              outcome?.active ?? app.activeVersion,
+              outcome?.record.offer,
+            ),
+          ),
+          Effect.catch(() =>
+            Effect.logWarning("Catalog app update failed; the job will retry", { entry }).pipe(
+              Effect.andThen(Effect.sync(() => (failed = true))),
+            ),
+          ),
+        );
+      }
+      if (failed) return yield* new StorageError();
+    }).pipe(
+      Effect.mapError(() => new StorageError()),
+      Effect.ensuring(
+        Effect.suspend(() => (intent ? Effect.flatten(ScheduleWakeup) : Effect.void)),
+      ),
+    );
+  });
+
+/** Release jobs only sweep catalog apps; every other member job runs ordinary setup. */
+export const withCatalogAppDefaults = (
+  executor: Executor,
+  feed: CatalogAppFeed | undefined,
+  initialize: Parameters<typeof OrganizationDefaults.of>[0],
+) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    return (organization: OrganizationId, user?: Parameters<typeof initialize>[1]) =>
+      Effect.gen(function* () {
+        if (!(yield* CatalogAppSweep)) return yield* initialize(organization, user);
+        if (user !== undefined && feed !== undefined)
+          yield* catalogAppDefaults(executor, feed, organization).pipe(
+            Effect.provideService(SqlClient.SqlClient, sql),
+          );
+      });
+  });
diff --git a/apps/hosted/server/src/implementation/catalog-app-heal.ts b/apps/hosted/server/src/implementation/catalog-app-heal.ts
new file mode 100644
index 000000000..8cd797f8b
--- /dev/null
+++ b/apps/hosted/server/src/implementation/catalog-app-heal.ts
@@ -0,0 +1,67 @@
+/**
+ * The first catalog sweeps deployed catalog source without committing it, so a workspace they
+ * recorded clean can still hold the source that deploy replaced, and "Deploy latest" would bring
+ * it back. The sweep commits the active source over such a workspace once, before it decides.
+ */
+import { pinnedOnly } from "@executor-js/app-management/data-steps";
+import type { AppId, Executor, OwnerId } from "@executor-js/sdk/core";
+import { Effect } from "effect";
+import type { OrganizationId } from "../contracts/organization.ts";
+import {
+  commitSource,
+  reportCatalogApp,
+  type ActiveSource,
+  type Saved,
+} from "./catalog-app-records.ts";
+
+/**
+ * Whether the app runs the version the sweep recorded while its workspace still holds the commit
+ * the sweep recorded clean, with other source. A person's deploy or activation, or any commit
+ * since, is theirs and never healed.
+ */
+export const drifted = (current: ActiveSource, recorded: Saved | undefined) =>
+  recorded?.version === current.active &&
+  // No commit since the recorded one, so the workspace holds no one's edits.
+  recorded.workspace === current.commit &&
+  !pinnedOnly(current.workspace, current.files);
+
+/**
+ * The source to decide from: `current`, or after a heal, the workspace holding the active
+ * source. Undefined when the heal failed; the app is then left alone until the next sweep.
+ */
+export const healCatalogWorkspace = (
+  executor: { readonly apps: Executor["apps"] },
+  organization: OrganizationId,
+  owner: OwnerId,
+  app: AppId,
+  current: ActiveSource,
+  recorded: Saved | undefined,
+) =>
+  Effect.gen(function* () {
+    if (!drifted(current, recorded)) return current;
+    // A framework pin committed on the replaced source carries over, as on any catalog commit.
+    const replaced = yield* Effect.gen(function* () {
+      for (const version of yield* executor.apps.versions({ owner, app, versionOwner: owner })) {
+        if (version.id === current.active) continue;
+        const source = yield* executor.apps.source({ owner, app, version: version.id });
+        if (pinnedOnly(current.workspace, source.files)) return source.files;
+      }
+      return current.files;
+    }).pipe(Effect.catch(() => Effect.succeed(current.files)));
+    const committed = yield* commitSource(executor, {
+      owner,
+      app,
+      current,
+      running: replaced,
+      files: current.files,
+      message: "Commit the catalog source this app runs",
+    });
+    if (committed === undefined) return undefined;
+    yield* reportCatalogApp(organization, app, "healed", current.active);
+    return {
+      ...current,
+      workspace: committed.files,
+      commit: committed.commit,
+      clean: true,
+    } satisfies ActiveSource;
+  });
diff --git a/apps/hosted/server/src/implementation/catalog-app-offers.ts b/apps/hosted/server/src/implementation/catalog-app-offers.ts
new file mode 100644
index 000000000..3c21e237c
--- /dev/null
+++ b/apps/hosted/server/src/implementation/catalog-app-offers.ts
@@ -0,0 +1,105 @@
+/** A catalog update held back for a manager, read for the Versions tab and applied on request. */
+import type { Catalog } from "@executor-js/catalog/contracts";
+import {
+  StorageError,
+  type App,
+  type AppId,
+  type Executor,
+  type OwnerId,
+  type SourceFiles,
+} from "@executor-js/sdk/core";
+import { Effect } from "effect";
+import { CatalogUpdateUnavailable } from "../contracts/apps.ts";
+import { type OrganizationId, organizationOwner } from "../contracts/organization.ts";
+import {
+  activeSource,
+  deployCatalogSource,
+  recordOf,
+  reportCatalogApp,
+  saveCatalogRecord,
+  savedRecords,
+  sourceDigest,
+  type Saved,
+} from "./catalog-app-records.ts";
+
+/**
+ * Deploy an offered catalog source at a manager's request, under the same workspace guard and
+ * over only the active version the offer was made for.
+ */
+export const applyCatalogUpdate = (
+  executor: { readonly apps: Executor["apps"] },
+  input: {
+    readonly owner: OwnerId;
+    readonly app: App;
+    readonly files: SourceFiles;
+    readonly recorded: Saved | undefined;
+  },
+) =>
+  Effect.gen(function* () {
+    const { owner, app, files, recorded } = input;
+    if (recorded?.offer === undefined)
+      return yield* new CatalogUpdateUnavailable({ reason: "none" });
+    const current = yield* activeSource(executor, owner, app, recorded);
+    if (current === undefined || current.active !== recorded.offer.active)
+      return yield* new CatalogUpdateUnavailable({ reason: "changed" });
+    if (!current.clean) return yield* new CatalogUpdateUnavailable({ reason: "edited" });
+    // Apply only the source the offer was evaluated against; a newer one waits for the sweep.
+    const digest = yield* sourceDigest(files);
+    if (digest !== recorded.offer.source)
+      return yield* new CatalogUpdateUnavailable({ reason: "changed" });
+    // The deploy's expected version and the commit's expected revision cover what moves next.
+    const outcome = yield* deployCatalogSource(executor, owner, app.id, current, files, digest);
+    if (outcome === undefined) return yield* new CatalogUpdateUnavailable({ reason: "changed" });
+    return outcome;
+  });
+
+/** The catalog update held back for this app, unless its active version changed since. */
+export const catalogAppOffer = (organization: OrganizationId, app: App) =>
+  Effect.gen(function* () {
+    const offer = recordOf(yield* savedRecords(organization), app.id)?.offer;
+    if (offer === undefined || offer.active !== app.activeVersion) return null;
+    return { reconnect: offer.reconnect, reasons: offer.reasons, touched: offer.touched };
+  }).pipe(Effect.mapError(() => new StorageError()));
+
+/** Apply the held-back update: read the catalog's current source, deploy it and record it. */
+export const applyCatalogAppOffer = (
+  executor: Executor,
+  catalog: Catalog,
+  organization: OrganizationId,
+  id: AppId,
+) =>
+  Effect.gen(function* () {
+    const owner = organizationOwner(organization);
+    const app = yield* executor.apps.get({ owner, app: id });
+    const recorded = recordOf(yield* savedRecords(organization), app.id);
+    yield* Effect.gen(function* () {
+      const reference = app.copiedFrom?.reference;
+      const encoded = reference?.match(/\/apps\/([^/]+)\.json$/)?.[1];
+      if (recorded?.offer === undefined || encoded === undefined)
+        return yield* new CatalogUpdateUnavailable({ reason: "none" });
+      const entry = yield* Effect.try({
+        try: () => decodeURIComponent(encoded),
+        catch: () => new CatalogUpdateUnavailable({ reason: "none" }),
+      });
+      const prepared = yield* catalog.prepare({ entry });
+      if (prepared.origin?.reference !== reference)
+        return yield* new CatalogUpdateUnavailable({ reason: "none" });
+      const outcome = yield* applyCatalogUpdate(executor, {
+        owner,
+        app,
+        files: prepared.files,
+        recorded,
+      });
+      yield* saveCatalogRecord(executor, organization, app.id, recorded, outcome);
+      yield* reportCatalogApp(organization, app.id, "upgraded", outcome.active);
+    }).pipe(
+      Effect.tapError((error) =>
+        error._tag === "CatalogUpdateUnavailable"
+          ? reportCatalogApp(organization, app.id, "skipped", app.activeVersion)
+          : Effect.void,
+      ),
+    );
+    return yield* executor.apps.get({ owner, app: app.id });
+  }).pipe(
+    Effect.catchTags({ SqlError: () => new StorageError(), SchemaError: () => new StorageError() }),
+  );
diff --git a/apps/hosted/server/src/implementation/catalog-app-records.ts b/apps/hosted/server/src/implementation/catalog-app-records.ts
new file mode 100644
index 000000000..6848384c2
--- /dev/null
+++ b/apps/hosted/server/src/implementation/catalog-app-records.ts
@@ -0,0 +1,259 @@
+/** The sweep's per-app records in organization metadata, and the guarded write of one. */
+import { pinnedOnly, withFrameworkPin } from "@executor-js/app-management/data-steps";
+import {
+  StorageError,
+  StorageHost,
+  VersionId,
+  sourceFilesEqual,
+  type App,
+  type AppId,
+  type Executor,
+  type OwnerId,
+  type SourceFiles,
+} from "@executor-js/sdk/core";
+import { Effect, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import { CatalogAppUpdate } from "../contracts/apps.ts";
+import { type OrganizationId, organizationOwner } from "../contracts/organization.ts";
+
+const basaltCatalogApps = "basaltCatalogApps";
+export const Saved = Schema.Struct({
+  version: Schema.optionalKey(VersionId),
+  workspace: Schema.optionalKey(Schema.String),
+  /** SHA-256 of the catalog source `version` holds, as the feed serves it. */
+  applied: Schema.optionalKey(Schema.String),
+  offer: Schema.optionalKey(
+    Schema.Struct({ ...CatalogAppUpdate.fields, source: Schema.String, active: VersionId }),
+  ),
+});
+export type Saved = typeof Saved.Type;
+const Records = Schema.Struct({ apps: Schema.Record(Schema.String, Saved) });
+/** What one app's sweep or update writes, and the active version it was decided against. */
+export interface CatalogOutcome {
+  readonly record: Saved;
+  readonly active: VersionId;
+  readonly deployed: boolean;
+}
+
+const sameRecord = Schema.toEquivalence(Saved);
+/** What happened to one catalog copy, as its one log line says. */
+export type CatalogDecision =
+  | "upgraded"
+  | "offered"
+  | "unchanged"
+  | "recorded"
+  | "healed"
+  | "skipped";
+/**
+ * The decision an outcome stands for: deployed, held back, or the active version already holding
+ * the catalog's source, `recorded` when that changed the record. Undefined means skipped.
+ */
+export const catalogDecision = (
+  recorded: Saved | undefined,
+  outcome: CatalogOutcome | undefined,
+): CatalogDecision => {
+  if (outcome === undefined) return "skipped";
+  if (outcome.deployed) return "upgraded";
+  if (outcome.record.offer !== undefined) return "offered";
+  return recorded !== undefined && sameRecord(recorded, outcome.record) ? "unchanged" : "recorded";
+};
+/** One line per catalog copy and outcome, with IDs only: never source, files, names or accounts. */
+export const reportCatalogApp = (
+  organization: OrganizationId,
+  app: AppId,
+  decision: CatalogDecision,
+  version: VersionId | null,
+  offer?: Pick<typeof CatalogAppUpdate.Type, "reasons" | "reconnect">,
+) =>
+  Effect.logInfo("Catalog app update", {
+    app,
+    organization,
+    decision,
+    version,
+    ...(offer === undefined ? {} : { reasons: offer.reasons, reconnect: offer.reconnect }),
+  });
+
+/** The sweep's records for every app of the organization, or undefined for a missing one. */
+export const savedRecords = (organization: OrganizationId) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const rows =
+      yield* sql`select coalesce(metadata::jsonb -> ${basaltCatalogApps}, '{}'::jsonb) as apps
+      from organization where id = ${organization}`;
+    if (rows.length !== 1) return undefined;
+    return (yield* Schema.decodeUnknownEffect(Records)(rows[0])).apps;
+  });
+export const recordOf = (records: Readonly<Record<string, Saved>> | undefined, app: AppId) =>
+  records !== undefined && Object.hasOwn(records, app) ? records[app] : undefined;
+
+/**
+ * SHA-256 of catalog source as the feed serves it. Retained versions store binary public files
+ * by reference, so comparing files alone would never match a catalog source that has any.
+ */
+export const sourceDigest = (files: SourceFiles) =>
+  Effect.tryPromise({
+    try: async () =>
+      Array.from(
+        new Uint8Array(
+          await crypto.subtle.digest("SHA-256", new TextEncoder().encode(JSON.stringify(files))),
+        ),
+        (byte) => byte.toString(16).padStart(2, "0"),
+      ).join(""),
+    catch: () => new StorageError(),
+  });
+
+/** The active source and whether the workspace holds unsaved edits; undefined while it moves. */
+export const activeSource = (
+  executor: { readonly apps: Executor["apps"] },
+  owner: OwnerId,
+  app: App,
+  recorded: Saved | undefined,
+) =>
+  Effect.gen(function* () {
+    const source = yield* executor.apps.source({ owner, app: app.id });
+    if (app.activeVersion === null || source.id !== app.activeVersion) return undefined;
+    const workspace = yield* executor.apps.workspace({ owner, app: app.id });
+    const commit = workspace.revision.commit;
+    // The recorded commit holds the source the catalog deployed, committed after its deploy.
+    const clean = pinnedOnly(workspace.files, source.files) || commit === recorded?.workspace;
+    return {
+      active: app.activeVersion,
+      files: source.files,
+      workspace: workspace.files,
+      commit,
+      clean,
+    };
+  });
+export type ActiveSource = NonNullable<Effect.Success<ReturnType<typeof activeSource>>>;
+
+/**
+ * Read the app again right before a deploy: a workspace edit since the decision must stop it, and
+ * the deploy and the commit after it start from this read. Undefined when anything moved.
+ */
+export const stillCurrent = (
+  executor: { readonly apps: Executor["apps"] },
+  owner: OwnerId,
+  app: AppId,
+  active: VersionId,
+  recorded: Saved | undefined,
+) =>
+  Effect.gen(function* () {
+    const fresh = yield* executor.apps.get({ owner, app });
+    if (fresh.activeVersion !== active) return undefined;
+    const current = yield* activeSource(executor, owner, fresh, recorded);
+    return current?.active === active && current.clean ? current : undefined;
+  });
+
+/**
+ * Commit `files` to the workspace's main on the revision `current` read, keeping the framework
+ * pin of a workspace that is `running` plus only that pin. Returns the commit that holds them, or
+ * undefined when the workspace moved or the commit failed: the commit read then holds other
+ * source, so it is never recorded clean.
+ */
+export const commitSource = (
+  executor: { readonly apps: Executor["apps"] },
+  input: {
+    readonly owner: OwnerId;
+    readonly app: AppId;
+    readonly current: ActiveSource;
+    readonly running: SourceFiles;
+    readonly files: SourceFiles;
+    readonly message: string;
+  },
+) => {
+  const { owner, app, current } = input;
+  return withFrameworkPin(current.workspace, input.running, input.files).pipe(
+    Effect.flatMap((files) =>
+      sourceFilesEqual(current.workspace, files)
+        ? Effect.succeed({ commit: current.commit, files })
+        : executor.apps
+            .commit({ owner, app, expected: current.commit, files, message: input.message })
+            .pipe(Effect.map((committed) => ({ commit: committed.revision.commit, files }))),
+    ),
+    Effect.map((committed): { commit: string; files: SourceFiles } | undefined => committed),
+    Effect.catch((error) =>
+      error._tag === "SourceError" && error.reason === "conflict"
+        ? Effect.logInfo("Catalog app workspace changed meanwhile", { app }).pipe(
+            Effect.as(undefined),
+          )
+        : Effect.logWarning("Catalog app could not commit its source", {
+            app,
+            failure: error._tag,
+          }).pipe(Effect.as(undefined)),
+    ),
+  );
+};
+
+/**
+ * Deploy catalog `files` over the active version `current` read, then commit them to the
+ * workspace's main on the revision read, as upstream's built-in app upgrade does, so a manager's
+ * "Deploy latest" does not bring the replaced source back. Undefined when a person's deploy or
+ * activation landed first. A workspace that moved keeps its commit and is left out of the
+ * record, so the next sweep counts the app as touched.
+ */
+export const deployCatalogSource = (
+  executor: { readonly apps: Executor["apps"] },
+  owner: OwnerId,
+  app: AppId,
+  current: ActiveSource,
+  files: SourceFiles,
+  digest: string,
+) =>
+  Effect.gen(function* () {
+    const deployed = yield* executor.apps
+      .deploy({ owner, app, files, expectedVersion: current.active })
+      .pipe(Effect.catchTag("AppVersionChanged", () => Effect.succeed(undefined)));
+    // A person's newer deploy or activation keeps the app; it now counts as touched.
+    if (deployed === undefined || deployed.app.activeVersion !== deployed.version.id)
+      return undefined;
+    // Main gets what now runs, on the revision read.
+    const committed = yield* commitSource(executor, {
+      owner,
+      app,
+      current,
+      running: current.files,
+      files,
+      message: "Update to the catalog's current source",
+    });
+    const workspace = committed?.commit;
+    return {
+      record: {
+        version: deployed.version.id,
+        applied: digest,
+        ...(workspace === undefined ? {} : { workspace }),
+      },
+      active: deployed.version.id,
+      deployed: true,
+    } satisfies CatalogOutcome;
+  });
+
+/**
+ * Write an outcome under the app's lock, only while its record is still the one it was decided
+ * from and the app's active version is the one it expects. Overlapping sweeps, retries and
+ * manager updates cannot record a stale read. Returns whether it wrote.
+ */
+export const saveCatalogRecord = (
+  executor: Executor,
+  organization: OrganizationId,
+  app: AppId,
+  read: Saved | undefined,
+  outcome: CatalogOutcome,
+) =>
+  executor[StorageHost].transaction(
+    Effect.gen(function* () {
+      const sql = yield* SqlClient.SqlClient;
+      yield* sql`select pg_advisory_xact_lock(hashtextextended(${`basalt-catalog-app:${app}`}, 0))`;
+      const [row] = yield* sql<{ same: boolean }>`select
+        (metadata::jsonb -> ${basaltCatalogApps} -> ${app}) is not distinct from
+          ${read === undefined ? null : JSON.stringify(read)}::jsonb as same
+        from organization where id = ${organization} for no key update`;
+      if (row?.same !== true) return false;
+      const locked = yield* executor.apps.get({ owner: organizationOwner(organization), app });
+      if (locked.activeVersion !== outcome.active) return false;
+      yield* sql`update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb),
+        array[${basaltCatalogApps}], coalesce(metadata::jsonb -> ${basaltCatalogApps}, '{}'::jsonb)
+          || jsonb_build_object(${app}::text, ${JSON.stringify(outcome.record)}::jsonb))::text
+        where id = ${organization}`;
+      return true;
+    }),
+  );
diff --git a/apps/hosted/server/src/implementation/catalog-app-updates.ts b/apps/hosted/server/src/implementation/catalog-app-updates.ts
new file mode 100644
index 000000000..2858520c4
--- /dev/null
+++ b/apps/hosted/server/src/implementation/catalog-app-updates.ts
@@ -0,0 +1,132 @@
+/** Whether an installed catalog app rolls forward to the feed's current source. No I/O. */
+
+/** Why the catalog's current source would leave a linked account or slot unusable. */
+export type CatalogBreak = "removed" | "provider" | "scope" | "added" | "cardinality";
+
+/** A catalog source the sweep held back, for a manager to apply from the app's Versions tab. */
+export interface CatalogOffer {
+  /** SHA-256 of the offered catalog files. */
+  readonly source: string;
+  /** The active version the offer was evaluated against; another one makes it stale. */
+  readonly active: string;
+  readonly reconnect: number;
+  readonly reasons: ReadonlyArray<CatalogBreak>;
+  /** Someone changed the app, so applying the offer replaces their version. */
+  readonly touched: boolean;
+}
+
+/** What the sweep last recorded for one app in organization metadata. */
+export interface CatalogAppRecord {
+  /** The catalog's own version: the original copy, or one the sweep or a manager deployed. */
+  readonly version?: string;
+  /** A workspace commit seen without unsaved edits; catalog deploys never change Git. */
+  readonly workspace?: string;
+  readonly offer?: CatalogOffer;
+}
+
+/** One account requirement, as a version declares it. */
+export interface CatalogSlot {
+  readonly provider: string;
+  readonly scope: string;
+  readonly cardinality: string;
+}
+
+/** One link to the app; `subject` is the linking member for a user requirement, else null. */
+export interface CatalogLink {
+  readonly requirement: string;
+  readonly scope: string;
+  readonly subject: string | null;
+  readonly account: string;
+  readonly provider: string;
+}
+
+/** The feed entry an app was copied from, or undefined when its origin is anything else. */
+export const catalogEntryId = (reference: string | undefined, feedUrl: string) => {
+  const apps = new URL("apps/", feedUrl).href;
+  if (reference === undefined || !reference.startsWith(apps) || !reference.endsWith(".json"))
+    return undefined;
+  const encoded = reference.slice(apps.length, -".json".length);
+  if (encoded.length === 0 || encoded.includes("/")) return undefined;
+  // The reference format is the catalog source's own: `apps/<encoded id>.json` beside the index.
+  try {
+    const id = decodeURIComponent(encoded);
+    return new URL(`apps/${encodeURIComponent(id)}.json`, feedUrl).href === reference
+      ? id
+      : undefined;
+  } catch {
+    return undefined;
+  }
+};
+
+/**
+ * Before building: `record` when the active source already is the catalog's, `skip` for unsaved
+ * workspace edits, otherwise `evaluate` the catalog source's requirements.
+ */
+export const decideCatalogUpdate = (input: {
+  readonly unchanged: boolean;
+  readonly clean: boolean;
+}) => (input.unchanged ? "record" : input.clean ? "evaluate" : "skip");
+
+/**
+ * After building: deploy only an untouched copy no linked account breaks on; anything else is an
+ * offer, and nothing is deployed, so no catalog migration runs on it.
+ */
+export const decideCatalogOffer = (input: {
+  /** How many versions the app has. */
+  readonly versions: number;
+  readonly active: string;
+  readonly recorded: CatalogAppRecord | undefined;
+  readonly breaking: boolean;
+}) => {
+  const untouched = input.versions === 1 || input.active === input.recorded?.version;
+  return { untouched, decision: untouched && !input.breaking ? "apply" : "offer" } as const;
+};
+
+const slotOf = (slots: Readonly<Record<string, CatalogSlot>>, name: string) =>
+  Object.hasOwn(slots, name) ? slots[name] : undefined;
+
+/**
+ * Linked accounts the catalog source can no longer use, and why. A slot that is gone, needs
+ * another provider or links in the other scope breaks its accounts. A new slot nobody linked
+ * breaks the app until someone does. A slot that becomes single keeps one account per linker.
+ */
+export const breakingChanges = (
+  links: ReadonlyArray<CatalogLink>,
+  before: Readonly<Record<string, CatalogSlot>>,
+  after: Readonly<Record<string, CatalogSlot>>,
+) => {
+  const reasons = new Set<CatalogBreak>();
+  const broken = new Set<string>();
+  const kept: CatalogLink[] = [];
+  for (const link of links) {
+    const slot = slotOf(after, link.requirement);
+    const reason =
+      slot === undefined
+        ? "removed"
+        : slot.provider !== link.provider
+          ? "provider"
+          : slot.scope !== link.scope
+            ? "scope"
+            : undefined;
+    if (reason === undefined) kept.push(link);
+    else {
+      reasons.add(reason);
+      broken.add(link.account);
+    }
+  }
+  let extra = 0;
+  for (const [name, slot] of Object.entries(after)) {
+    if (slotOf(before, name) === undefined && !links.some((link) => link.requirement === name))
