diff --git a/apps/hosted/server/src/implementation/catalog-app-defaults.ts b/apps/hosted/server/src/implementation/catalog-app-defaults.ts
new file mode 100644
index 000000000..5c1e93099
--- /dev/null
+++ b/apps/hosted/server/src/implementation/catalog-app-defaults.ts
@@ -0,0 +1,281 @@
+/**
+ * Installed catalog apps roll forward to the feed's current source once per Basalt release. An
+ * untouched copy is redeployed; a touched one, or one whose linked accounts would break, keeps its
+ * active version and gets the newer one waiting in Versions. Results live in organization metadata.
+ */
+import { pinnedOnly } from "@executor-js/app-management/data-steps";
+import { createCatalog } from "@executor-js/catalog";
+import {
+  StorageError,
+  VersionId,
+  sourceFilesEqual,
+  type App,
+  type Executor,
+  type OwnerId,
+  type SourceFiles,
+} from "@executor-js/sdk/core";
+import type { HostEgress } from "@executor-js/utils/url-policy";
+import { Effect, Schedule, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import { CatalogAppSweep, catalogAppJobPrefix } from "../contracts/catalog-app-updates.ts";
+import { type OrganizationId, organizationOwner } from "../contracts/organization.ts";
+import type { OrganizationDefaults } from "../contracts/organization-defaults.ts";
+import { ScheduleWakeup } from "../contracts/schedules.ts";
+import { catalogAppRelease } from "./catalog-app-release.ts";
+import { catalogEntryId, decideCatalogUpdate, reconnectCount } from "./catalog-app-updates.ts";
+
+const basaltCatalogApps = "basaltCatalogApps";
+const Saved = Schema.Struct({
+  version: Schema.optionalKey(VersionId),
+  workspace: Schema.optionalKey(Schema.String),
+  update: Schema.optionalKey(VersionId),
+  reconnect: Schema.optionalKey(Schema.Number),
+});
+const Records = Schema.Struct({ apps: Schema.Record(Schema.String, Saved) });
+const Links = Schema.Array(
+  Schema.Struct({
+    requirement: Schema.String,
+    scope: Schema.String,
+    account: Schema.String,
+    provider: Schema.String,
+  }),
+);
+type Links = typeof Links.Type;
+
+/** The sweep's records for every app of the organization, or undefined for a missing one. */
+const savedRecords = (organization: OrganizationId) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const rows =
+      yield* sql`select coalesce(metadata::jsonb -> ${basaltCatalogApps}, '{}'::jsonb) as apps
+      from organization where id = ${organization}`;
+    if (rows.length !== 1) return undefined;
+    return (yield* Schema.decodeUnknownEffect(Records)(rows[0])).apps;
+  });
+
+/** The feed installs read, through the same egress. */
+export interface CatalogAppFeed {
+  readonly egress: HostEgress;
+  readonly url: string;
+}
+
+/**
+ * Bring one catalog copy forward to `files`. Returns what to record, or undefined to keep the
+ * earlier record. Deploys never edit the workspace, so the recorded commit still marks it clean.
+ */
+export const updateCatalogApp = (
+  executor: { readonly apps: Executor["apps"] },
+  input: {
+    readonly owner: OwnerId;
+    readonly app: App;
+    readonly files: SourceFiles;
+    readonly recorded: typeof Saved.Type | undefined;
+    readonly links: Effect.Effect<Links, StorageError>;
+  },
+) =>
+  Effect.gen(function* () {
+    const { owner, app, files, recorded } = input;
+    const previous = app.activeVersion;
+    if (previous === null) return undefined;
+    const source = yield* executor.apps.source({ owner, app: app.id });
+    if (source.id !== previous) return undefined;
+    const workspace = yield* executor.apps.workspace({ owner, app: app.id });
+    const commit = workspace.revision.commit;
+    const clean = pinnedOnly(workspace.files, source.files) || commit === recorded?.workspace;
+    const unchanged = sourceFilesEqual(source.files, files);
+    const offered =
+      !unchanged && recorded?.update !== undefined && recorded.update !== previous
+        ? yield* executor.apps.source({ owner, app: app.id, version: recorded.update }).pipe(
+            Effect.map((waiting) => sourceFilesEqual(waiting.files, files)),
+            Effect.catchTags({
+              VersionNotFound: () => Effect.succeed(false),
+              AppNotDeployed: () => Effect.succeed(false),
+            }),
+          )
+        : false;
+    const versions = unchanged
+      ? 1
+      : (yield* executor.apps.versions({ owner, app: app.id, versionOwner: owner })).length;
+    const decision = decideCatalogUpdate({
+      versions,
+      active: previous,
+      recorded,
+      unchanged,
+      clean,
+      offered,
+    });
+    if (decision === "skip") return undefined;
+    if (decision === "record")
+      return clean
+        ? { version: previous, workspace: commit }
+        : {
+            version: previous,
+            ...(recorded?.workspace === undefined ? {} : { workspace: recorded.workspace }),
+          };
+    // Read everything that can fail first: after the deploy, only reactivation may.
+    const links = yield* input.links;
+    const deployed = yield* executor.apps.deploy({ owner, app: app.id, files });
+    const next = deployed.app.activeVersion;
+    const reconnect = reconnectCount(links, deployed.app.requirements.accounts);
+    if (decision === "apply" && reconnect === 0) return { version: next, workspace: commit };
+    // Only an unchanged previous version is restored; a concurrent choice is someone else's.
+    yield* executor.apps
+      .activate({ owner, app: app.id, version: previous, expectedVersion: next })
+      .pipe(
+        Effect.retry({
+          while: (error) => error._tag !== "AppVersionChanged",
+          schedule: Schedule.exponential("200 millis"),
+          times: 3,
+        }),
+      );
+    const version = decision === "apply" ? previous : recorded?.version;
+    return {
+      ...(version === undefined ? {} : { version }),
+      workspace: commit,
+      update: next,
+      reconnect,
+    };
+  });
+
+/** A build failure is the feed source's own; it stays until a later release. */
+const unbuildable = (entry: string) =>
+  Effect.logWarning("Catalog app update does not build", { entry }).pipe(Effect.as(undefined));
+
+/**
+ * Sweep one organization's copies of `feed`'s apps. Failures that a retry can fix fail the job
+ * after every app was tried; a delisted entry or a build the feed's source fails is left as is.
+ */
+export const catalogAppDefaults = (
+  executor: Executor,
+  feed: CatalogAppFeed,
+  organization: OrganizationId,
+) =>
+  Effect.suspend(() => {
+    let intent = false;
+    return Effect.gen(function* () {
+      const sql = yield* SqlClient.SqlClient;
+      const owner = organizationOwner(organization);
+      const saved = yield* savedRecords(organization);
+      if (saved === undefined) return;
+      const catalog = createCatalog({ egress: feed.egress, feedUrl: feed.url });
+      let failed = false;
+      for (const app of yield* executor.apps.list({ owner })) {
+        const entry = catalogEntryId(app.copiedFrom?.reference, feed.url);
+        if (entry === undefined || app.activeVersion === null) continue;
+        const result = yield* Effect.gen(function* () {
+          const prepared = yield* catalog.prepare({ entry });
+          if (prepared.origin?.reference !== app.copiedFrom?.reference) return undefined;
+          return yield* updateCatalogApp(executor, {
+            owner,
+            app,
+            files: prepared.files,
+            recorded: Object.hasOwn(saved, app.id) ? saved[app.id] : undefined,
+            links: sql`select l.requirement, l.account, a.provider,
+              case when l.subject is null then 'app' else 'user' end as scope
+            from hosted_app_account_links l join executor_accounts a on a.id = l.account
+            where l.app = ${app.id}`.pipe(
+              Effect.flatMap(Schema.decodeUnknownEffect(Links)),
+              Effect.mapError(() => new StorageError()),
+            ),
+          });
+        }).pipe(
+          Effect.catchTags({
+            CatalogImportFailed: () => Effect.succeed(undefined),
+            AppNotFound: () => Effect.succeed(undefined),
+            AppVersionChanged: () => Effect.succeed(undefined),
+            VersionBuildFailed: () => unbuildable(entry),
+            BuildMemoryExceeded: () => unbuildable(entry),
+          }),
+          Effect.catch(() =>
+            Effect.logWarning("Catalog app update failed; the job will retry", { entry }).pipe(
+              Effect.andThen(Effect.sync(() => (failed = true))),
+              Effect.as(undefined),
+            ),
+          ),
+        );
+        if (result === undefined) continue;
+        // Deploys and activations leave the app's webhook sources pending.
+        if (result.version !== app.activeVersion || "update" in result) intent = true;
+        yield* sql`update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb),
+        array[${basaltCatalogApps}], coalesce(metadata::jsonb -> ${basaltCatalogApps}, '{}'::jsonb)
+          || jsonb_build_object(${app.id}::text, ${JSON.stringify(result)}::jsonb))::text
+        where id = ${organization}`;
+      }
+      if (failed) return yield* new StorageError();
+    }).pipe(
+      Effect.mapError(() => new StorageError()),
+      Effect.ensuring(
+        Effect.suspend(() => (intent ? Effect.flatten(ScheduleWakeup) : Effect.void)),
+      ),
+    );
+  });
+
+/** Release jobs only sweep catalog apps; every other member job runs ordinary setup. */
+export const withCatalogAppDefaults = (
+  executor: Executor,
+  feed: CatalogAppFeed | undefined,
+  initialize: Parameters<typeof OrganizationDefaults.of>[0],
+) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    return (organization: OrganizationId, user?: Parameters<typeof initialize>[1]) =>
+      Effect.gen(function* () {
+        if (!(yield* CatalogAppSweep)) return yield* initialize(organization, user);
+        if (user !== undefined && feed !== undefined)
+          yield* catalogAppDefaults(executor, feed, organization).pipe(
+            Effect.provideService(SqlClient.SqlClient, sql),
+          );
+      });
+  });
+
+/** The newer catalog version waiting for this app, unless it is already active. */
+export const catalogAppUpdate = (organization: OrganizationId, app: App) =>
+  Effect.gen(function* () {
+    const apps = yield* savedRecords(organization);
+    const saved = apps !== undefined && Object.hasOwn(apps, app.id) ? apps[app.id] : undefined;
+    if (saved?.update === undefined || saved.update === app.activeVersion) return null;
+    return { version: saved.update, reconnect: saved.reconnect ?? 0 };
+  }).pipe(Effect.mapError(() => new StorageError()));
+
+/**
+ * Once per Basalt release, queue one sweep per organization that holds a copy of the feed's apps,
+ * run as a member who can manage apps. Jobs wait for the replacement server, as pool upgrades do.
+ */
+export const queueCatalogAppUpdates = (feedUrl: string, release = catalogAppRelease) => {
+  let completed = false;
+  const name = `${catalogAppJobPrefix}${release}`;
+  const apps = new URL("apps/", feedUrl).href;
+  return Effect.gen(function* () {
+    if (completed) return;
+    const sql = yield* SqlClient.SqlClient;
+    const done = yield* sql`select 1 from private_hosted_data_steps
+      where name = ${name} and run = 'apply' and completed_at is not null`;
+    if (done.length === 0)
+      yield* sql.withTransaction(
+        Effect.gen(function* () {
+          // Jobs and completion commit together; concurrent isolates serialize on the marker.
+          yield* sql`insert into private_hosted_data_steps (name, run, mode)
+            values (${name}, 'apply', 'apply') on conflict do nothing`;
+          const [locked] = yield* sql<{ completed: boolean }>`select
+            completed_at is not null as completed from private_hosted_data_steps
+            where name = ${name} and run = 'apply' for update`;
+          if (locked?.completed) return;
+          yield* sql`insert into hosted_provisioning (id, kind, organization_id, user_id, available_at)
+            select distinct on (organization.id)
+              ${catalogAppJobPrefix} || ${release} || ':' || gen_random_uuid()::text, 'member',
+              organization.id, member."userId", now() + interval '15 minutes'
+            from organization
+            join member on member."organizationId" = organization.id and member.role in ('owner', 'admin')
+            join "user" on "user".id = member."userId" and "user"."emailVerified" = true
+            where exists (select 1 from executor_apps app
+              where app.owner = 'organization:' || organization.id
+                and left(app.copied_from::jsonb ->> 'reference', length(${apps})) = ${apps})
+            order by organization.id, member.role = 'owner' desc, member."createdAt"`;
+          yield* sql`update private_hosted_data_steps set completed_at = now()
+            where name = ${name} and run = 'apply'`;
+        }),
+      );
+    // No invocation-owned I/O is retained; failures leave the next tick eligible.
+    completed = true;
+  });
+};
