new file mode 100644
index 000000000..f692db3f0
--- /dev/null
+++ b/apps/hosted/server/src/implementation/catalog-app-updates.ts
@@ -0,0 +1,85 @@
+/** Whether an installed catalog app rolls forward to the feed's current source. No I/O. */
+
+/** What the sweep last recorded for one app in organization metadata. */
+export interface CatalogAppRecord {
+  /** The catalog's own version: the original copy, or one the sweep deployed and kept. */
+  readonly version?: string;
+  /** A workspace commit the sweep saw without unsaved edits; its own deploys never change Git. */
+  readonly workspace?: string;
+  /** A newer catalog version that waits in Versions, and the linked accounts it would break. */
+  readonly update?: string;
+  readonly reconnect?: number;
+}
+
+/**
+ * - `record`: the active source is the catalog's current source; record it.
+ * - `skip`: unsaved workspace edits, or the newer version already waits; record nothing.
+ * - `apply`: untouched; deploy and keep it active unless linked accounts would break.
+ * - `offer`: touched; deploy, then re-activate the previous version at once.
+ */
+export type CatalogUpdate = "record" | "skip" | "apply" | "offer";
+
+/** The feed entry an app was copied from, or undefined when its origin is anything else. */
+export const catalogEntryId = (reference: string | undefined, feedUrl: string) => {
+  const apps = new URL("apps/", feedUrl).href;
+  if (reference === undefined || !reference.startsWith(apps) || !reference.endsWith(".json"))
+    return undefined;
+  const encoded = reference.slice(apps.length, -".json".length);
+  if (encoded.length === 0 || encoded.includes("/")) return undefined;
+  // The reference format is the catalog source's own: `apps/<encoded id>.json` beside the index.
+  try {
+    const id = decodeURIComponent(encoded);
+    // Installs record exactly this reference, so anything else came from another source.
+    return new URL(`apps/${encodeURIComponent(id)}.json`, feedUrl).href === reference
+      ? id
+      : undefined;
+  } catch {
+    return undefined;
+  }
+};
+
+export const decideCatalogUpdate = (input: {
+  /** How many versions the app has. */
+  readonly versions: number;
+  readonly active: string;
+  readonly recorded: CatalogAppRecord | undefined;
+  /** The catalog's current files equal the active source. */
+  readonly unchanged: boolean;
+  /** The workspace holds no unsaved edits. */
+  readonly clean: boolean;
+  /** The recorded update already holds the catalog's current files. */
+  readonly offered: boolean;
+}): CatalogUpdate => {
+  if (input.unchanged) return "record";
+  if (!input.clean || input.offered) return "skip";
+  // Activating a waiting update is accepting it, so that version stays the catalog's own.
+  const untouched =
+    input.versions === 1 ||
+    input.active === input.recorded?.version ||
