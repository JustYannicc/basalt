--- /dev/null
+++ b/apps/hosted/cloud/src/contracts/workflow-instance-id.ts
@@ -0,0 +1,47 @@
+/** Cloudflare accepts at most 100 letters, digits, hyphens and underscores, with no leading hyphen. */
+const instanceIdPattern = /^[a-zA-Z0-9_][a-zA-Z0-9_-]{0,99}$/;
+const digestIdPattern = /^job_[a-f0-9]{64}$/;
+
+export const isWorkflowInstanceId = (id: string) =>
+  instanceIdPattern.test(id) && !/[\r\n]/.test(id);
+
+/**
+ * Keep existing valid IDs stable, reserving the digest namespace so a literal job ID cannot
+ * alias another job's digest. Rows and workflow params always retain the original job ID.
+ */
+export const workflowInstanceId = async (job: string) => {
+  if (isWorkflowInstanceId(job) && !digestIdPattern.test(job)) return job;
+  const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(job));
+  return `job_${Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, "0")).join("")}`;
+};
+
+const errorNames = new Set([
+  "Error",
+  "TypeError",
+  "RangeError",
+  "AbortError",
+  "TimeoutError",
+  "NetworkError",
+]);
+const safeMessages = new Set([
+  "Provisioning instance unavailable",
+  "Network connection lost.",
+  "The operation was aborted.",
+  "The operation timed out.",
+  "Too many API requests by single worker invocation.",
+  "Internal error",
+]);
+
+/** Only closed platform diagnostics may reach logs. Unknown errors can contain credentials or SQL. */
+export const dispatchFailureReason = (cause: unknown) => {
+  if (typeof cause === "object" && cause !== null && "_tag" in cause && cause._tag === "SqlError")
+    return { name: "SqlError", message: "Database operation failed" };
+  if (!(cause instanceof Error)) return { name: "UnknownError", message: "Dispatch failed" };
+  const name = errorNames.has(cause.name) ? cause.name : "Error";
+  const message = safeMessages.has(cause.message)
+    ? cause.message
+    : /invalid.*instance.*id|instance.*id.*invalid|instance.*id.*[Cc]haracter/i.test(cause.message)
+      ? "Invalid Workflow instance ID"
+      : "Unrecognized dispatch error (redacted)";
+  return { name, message };
+};
