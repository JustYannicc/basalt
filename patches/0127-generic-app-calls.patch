+import { AppAccounts, type AppNotFound } from "./apps.ts";
+import { Effect, Schema } from "effect";
+import { AppDependency, AppDependencyName, type AppCallFailed } from "apps/contracts";
+import {
+  JsonObject,
+  type Json,
+  AppId,
+  VersionId,
+  BuildId,
+  OwnerId,
+  StorageError,
+} from "./shared.ts";
+import { ApiError } from "@executor-js/utils/api-error";
+export class AppConnectionConflict extends ApiError.define({
+  tag: "AppConnectionConflict",
+  status: 409,
+  message: "The saved app connection changed. Read it again before updating it.",
+}) {}
+export class AppConnectionRefused extends ApiError.define({
+  tag: "AppConnectionRefused",
+  status: 403,
+  message: "This app connection is unavailable or you may not change it.",
+}) {}
+export const AppConnectionId = Schema.String.pipe(Schema.brand("AppConnectionId"));
+export type AppConnectionId = typeof AppConnectionId.Type;
+export const AppCallReceiptId = Schema.String.pipe(Schema.brand("AppCallReceiptId"));
+export type AppCallReceiptId = typeof AppCallReceiptId.Type;
+export const AppConnectionScope = Schema.Literals(["app", "user"]);
+export const AppConnection = Schema.Struct({
+  id: AppConnectionId,
+  dependency: AppDependencyName,
+  target: AppId,
+  scope: AppConnectionScope,
+  revision: Schema.Int,
+  enabled: Schema.Boolean,
+});
+export type AppConnection = typeof AppConnection.Type;
+/** Encrypted host confirmation, bound to the exact accepted declaration and both versions. */
+export const AppCallConfirmation = Schema.Struct({
+  sourceVersion: VersionId,
+  targetVersion: VersionId,
+  connectionRevision: Schema.Int,
+  configurationRevision: Schema.NonEmptyString,
+  approvedBy: Schema.NonEmptyString,
+  accounts: AppAccounts,
+  declaration: AppDependency,
+  value: JsonObject,
+});
+export type AppCallConfirmation = typeof AppCallConfirmation.Type;
+export const AppConnectionPayload = Schema.Struct({
+  declaration: AppDependency,
+  accounts: AppAccounts,
+  confirmation: Schema.optionalKey(AppCallConfirmation),
+});
+export type AppConnectionIdentity = {
+  readonly app: AppId;
+  readonly owner: OwnerId;
+  readonly dependency: string;
+  readonly scope: "app" | "user";
+};
+export interface AppConnections {
+  readonly list: (input: {
+    readonly app: AppId;
+    readonly owner: OwnerId;
+  }) => Effect.Effect<
+    { connections: readonly AppConnection[] },
+    StorageError | AppConnectionRefused
+  >;
+  readonly save: (
+    input: AppConnectionIdentity & {
+      readonly target: AppId;
+      readonly revision: number;
+      readonly accounts?: typeof AppAccounts.Type;
+    },
+  ) => Effect.Effect<AppConnection, StorageError | AppConnectionRefused | AppConnectionConflict>;
+  readonly update: (
+    input: AppConnectionIdentity & { readonly revision: number; readonly enabled: boolean },
+  ) => Effect.Effect<AppConnection, StorageError | AppConnectionRefused | AppConnectionConflict>;
+  readonly remove: (
+    input: AppConnectionIdentity & { readonly revision: number },
+  ) => Effect.Effect<
+    { success: true },
+    StorageError | AppConnectionRefused | AppConnectionConflict
+  >;
+}
+
+const identity = {
+  app: AppId,
+  owner: OwnerId,
+  dependency: AppDependencyName,
+  scope: AppConnectionScope,
+};
+const revision = Schema.Int.check(Schema.isGreaterThanOrEqualTo(0));
+export const AppConnectionInputs = {
+  list: Schema.Struct({ app: AppId, owner: OwnerId }),
+  save: Schema.Struct({
+    ...identity,
+    target: AppId,
+    revision,
+    accounts: Schema.optionalKey(AppAccounts),
+  }),
+  update: Schema.Struct({ ...identity, revision, enabled: Schema.Boolean }),
+  remove: Schema.Struct({ ...identity, revision }),
+};
+
+/** Host adapters share one durable fence; app code and public JSON never receive it. */
+export const AppCallsHost = Symbol("executor.AppCallsHost");
+export interface AppCallsHost {
+  readonly receipts: {
+    readonly reserve: (input: {
+      readonly id: AppCallReceiptId;
+      readonly app: AppId;
+      readonly owner: OwnerId;
+      readonly connection: string;
+      readonly fingerprint: string;
+      readonly deadline: number;
+    }) => Effect.Effect<
+      | { readonly status: "reserved"; readonly dispatch: string }
+      | { readonly status: "completed"; readonly value: Json }
+      | { readonly status: "in_progress" | "outcome_unknown" },
+      StorageError | AppNotFound | AppCallFailed
+    >;
+    readonly finish: (input: {
+      readonly id: AppCallReceiptId;
+      readonly app: AppId;
+      readonly owner: OwnerId;
+      readonly dispatch: string;
+      readonly result?: Json;
+    }) => Effect.Effect<
+      { readonly status: "completed" | "outcome_unknown" },
+      StorageError | AppNotFound | AppCallFailed
+    >;
+  };
+}
+
+/** Issued only after a successful consumed SDK approval, never an ordinary tools.call. */
+export interface AppApprovedConfiguration {
+  readonly app: AppId;
+  readonly owner: OwnerId;
+  readonly version: VersionId;
+  readonly tool: string;
+  readonly requestId: string;
+  readonly actor: string;
+  readonly input: Json;
+  readonly output: Json;
+  readonly connections: ReadonlyArray<AppConnection & { readonly declaration: AppDependency }>;
+}
+/** Only the host policy supplies these values after checking the actual owner's identity. */
+export interface AppConfigurationAttachment {
+  readonly connection: AppConnectionId;
+  readonly revision: number;
+  readonly configurationRevision: string;
+  readonly value: JsonObject | null;
+}
+/** Captured by the SDK around the ordinary native tool call; no app-authored authority fields. */
+export interface AppProtectedDispatch {
+  readonly source: {
+    readonly app: AppId;
+    readonly version: VersionId;
+    readonly build: BuildId;
+    readonly caller?: string;
+  };
+  readonly connection: AppConnection;
+  readonly declaration: AppDependency;
+  readonly confirmation?: AppCallConfirmation;
+  readonly target: {
+    readonly app: AppId;
+    readonly version: VersionId;
+    readonly build: BuildId;
+    readonly tool: string;
+    readonly kind: "query" | "mutation";
+    readonly accounts: typeof AppAccounts.Type;
+  };
+  readonly decodedInput: Json;
+  readonly appPolicy: "user-approval";
+}
+/** Trusted host registration; it cannot be supplied through public JSON or an app declaration. */
+export interface AppCallHooks {
+  readonly configurationApproved?: (
+    event: AppApprovedConfiguration,
+  ) => Effect.Effect<
+    { readonly approvedBy: string; readonly attachments: readonly AppConfigurationAttachment[] },
+    StorageError | AppCallFailed
+  >;
+  readonly protectedDispatch?: (
+    event: AppProtectedDispatch,
+  ) => Effect.Effect<"approved" | "user-approval", StorageError | AppCallFailed>;
+}
