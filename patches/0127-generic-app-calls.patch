+/** App dependencies carry no credentials or caller-supplied authority. */
+import { Effect, Schema } from "effect";
+import { JsonObject, JsonValue } from "./schema.ts";
+export const AppDependencyName = Schema.String.check(
+  Schema.isPattern(/^[A-Za-z][A-Za-z0-9_-]{0,47}$/u),
+);
+export const AppCallKind = Schema.Literals(["query", "mutation"]);
+export const AppDependency = Schema.Struct({
+  scope: Schema.Literals(["app", "user"]),
+  configuration: Schema.optionalKey(
+    Schema.Struct({
+      tool: Schema.NonEmptyString,
+      policy: JsonObject,
+    }),
+  ),
+  tools: Schema.Record(
+    Schema.NonEmptyString,
+    Schema.Struct({
+      kind: AppCallKind,
+      inputSchema: Schema.optionalKey(JsonObject),
+      outputSchema: Schema.optionalKey(JsonObject),
+    }),
+  ),
+});
+/** A named personal or shared app dependency with its permitted operations. */
+export type AppDependency = typeof AppDependency.Type;
+export const DeclaredAppDependencies = Schema.Record(AppDependencyName, AppDependency);
+export type DeclaredAppDependencies = typeof DeclaredAppDependencies.Type;
+export const AppCallCommand = Schema.Struct({
+  operation: Schema.Literal("app-call"),
+  connection: AppDependencyName,
+  target: Schema.NonEmptyString,
+  tool: Schema.NonEmptyString,
+  kind: AppCallKind,
+  input: JsonValue,
+});
+/** One call to the exact app instance approved for a saved dependency. */
+export type AppCallCommand = typeof AppCallCommand.Type;
+/** A safe app-call refusal or terminal unknown outcome. Automatic retries are forbidden. */
+export class AppCallFailed extends Schema.TaggedError<AppCallFailed>()("AppCallFailed", {
+  reason: Schema.Literals([
+    "connection_missing",
+    "denied",
+    "stale",
+    "invalid_input",
+    "invalid_output",
+    "in_progress",
+    "identity_conflict",
+    "outcome_unknown",
+    "depth_exceeded",
+    "effects_unavailable",
+    "device_offline",
+  ]),
+  retryable: Schema.Literal(false).pipe(
+    Schema.withDecodingDefaultKey(Effect.succeed(false as const)),
+  ),
+}) {
+  override get message() {
+    return `App call refused: ${this.reason}. It will not be resent automatically.`;
+  }
+}
+export const AppCallReply = Schema.Union([
+  Schema.Struct({ ok: Schema.Literal(true), value: JsonValue }),
+  Schema.Struct({ ok: Schema.Literal(false), error: AppCallFailed }),
+]);
+export type AppCallHost = (
+  command: AppCallCommand,
+) => Effect.Effect<typeof JsonValue.Type, AppCallFailed>;
+
+/** Call a declared dependency through its saved host-authorized connection. */
+export interface AppCalls {
+  readonly call: (input: Omit<AppCallCommand, "operation">) => Promise<typeof JsonValue.Type>;
+}
+
+/** Private native-host policy callback. Identity is bound by the SDK, never by these fields. */
+export const AppToolPolicyCommand = Schema.Struct({
+  operation: Schema.Literal("app-tool-policy"),
+  tool: Schema.NonEmptyString,
+  kind: AppCallKind,
+  input: JsonValue,
+  decision: Schema.Literals(["approved", "denied", "user-approval", "failed"]),
+});
+export const AppToolPolicyReply = Schema.Struct({
+  decision: Schema.Literals(["approved", "denied", "user-approval", "failed"]),
+});
+export type AppToolPolicyHost = (
+  command: typeof AppToolPolicyCommand.Type,
+) => Effect.Effect<typeof AppToolPolicyReply.Type, AppCallFailed>;
