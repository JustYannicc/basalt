new file mode 100644
--- /dev/null
+++ b/e2e/support/app-call-sdk.ts
@@ -0,0 +1,87 @@
+import { Effect, Exit, FileSystem, Option, Path, Schema, Scope, Stream } from "effect";
+import { ChildProcess, ChildProcessSpawner } from "effect/process";
+import { HttpClient, HttpClientRequest } from "effect/http";
+import { appCallSdkSource } from "./app-call-sdk-source.ts";
+import { appsManifest } from "./apps-release.ts";
+import { lockedNpmRegistry } from "./npm-registry.ts";
+import { Target } from "./platform.ts";
+const Ready = Schema.Struct({ port: Schema.Number });
+export const appCallSdk = Effect.gen(function* () {
+  const target = yield* Target;
+  const fs = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const processes = yield* ChildProcessSpawner.ChildProcessSpawner;
+  const client = yield* HttpClient.HttpClient;
+  const registry = yield* lockedNpmRegistry;
+  const entry = path.join(target.directory, "app-call-sdk.ts");
+  const directory = path.join(target.directory, "app-call-sdk");
+  yield* fs.makeDirectory(directory, { recursive: true });
+  yield* fs.writeFileString(
+    entry,
+    appCallSdkSource.replace(
+      "INPUT",
+      JSON.stringify({
+        directory,
+        npmRegistry: registry.url,
+        files: [
+          {
+            path: "index.ts",
+            content: 'import {defineApp} from "apps"; export default defineApp({},{});',
+          },
+          appsManifest,
+        ],
+      }) + " as const",
+    ),
+  );
+  const config = path.join(target.directory, "app-call-sdk-tsconfig.json");
+  yield* fs.writeFileString(
+    config,
+    JSON.stringify({
+      extends: path.resolve("tsconfig.json"),
+      compilerOptions: { typeRoots: [path.resolve("node_modules/@types")] },
+      files: [entry],
+      include: [],
+      exclude: [],
+    }),
+  );
+  const checked = yield* processes.exitCode(
+    ChildProcess.make(path.resolve("node_modules/.bin/tsc-rs"), ["--noEmit", "-p", config], {
+      stdout: "inherit",
+      stderr: "inherit",
+    }),
+  );
+  if (checked !== 0) return yield* Effect.die("Public app-call SDK host failed its typecheck");
+  let childScope = yield* Scope.make();
+  let origin = "";
+  yield* Effect.addFinalizer(() => Scope.close(childScope, Exit.void));
+  const start = Effect.gen(function* () {
+    const child = yield* processes
+      .spawn(ChildProcess.make("node", [entry], { stdout: "pipe", stderr: "inherit" }))
+      .pipe(Scope.provide(childScope));
+    const line = yield* child.stdout.pipe(
+      Stream.decodeText(),
+      Stream.splitLines,
+      Stream.filter((line) => line.startsWith('{"port":')),
+      Stream.runHead,
+    );
+    if (Option.isNone(line)) return yield* Effect.die("SDK host exited before listening");
+    const ready = yield* Schema.decodeUnknownEffect(Schema.fromJsonString(Ready))(line.value);
+    origin = `http://127.0.0.1:${ready.port}`;
+  });
+  yield* start;
+  return {
+    restart: Effect.gen(function* () {
+      yield* Scope.close(childScope, Exit.void);
+      childScope = yield* Scope.make();
+      yield* start;
+    }),
+    request: (route: string, data: unknown) =>
+      Effect.gen(function* () {
+        const request = yield* HttpClientRequest.bodyJson(data)(
+          HttpClientRequest.post(origin + "/_fixture/" + route),
+        );
+        const response = yield* client.execute(request);
+        return { status: response.status, body: yield* response.json };
+      }),
+  };
+});
