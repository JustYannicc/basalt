+++ b/e2e/tests/app-call-receipts.spec.ts
@@ -0,0 +1,166 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { appCallSdk } from "../support/app-call-sdk.ts";
+import { TestLive, withCase } from "../support/case.ts";
+import { scenarios } from "../test-plan.ts";
+const Reserved = Schema.Struct({ status: Schema.Literal("reserved"), dispatch: Schema.String });
+layer(TestLive, { excludeTestServices: true })("App-call receipts", (it) => {
+  it.effect(scenarios.appCallConfiguration.title, (context) =>
+    withCase(
+      context,
+      Effect.gen(function* () {
+        const sdk = yield* appCallSdk;
+        const setup = yield* sdk.request("configuration/setup", null);
+        expect(setup.status, JSON.stringify(setup.body)).toBe(200);
+        const ids = yield* Schema.decodeUnknownEffect(
+          Schema.Struct({
+            source: Schema.String,
+            target: Schema.String,
+            connection: Schema.String,
+          }),
+        )(setup.body);
+        const counts = () => sdk.request("configuration/counts", null);
+        const call = () =>
+          sdk.request("configuration/call", { app: ids.source, target: ids.target });
+        expect((yield* call()).status).not.toBe(200);
+        expect((yield* counts()).body).toMatchObject({
+          approvedConfigurations: 0,
+          confirmedChecks: 0,
+        });
+        const ordinary = yield* sdk.request("configuration/configure", {
+          app: ids.source,
+          tool: "ordinary",
+          revision: "unapproved",
+        });
+        expect(ordinary.status).toBe(200);
+        expect((yield* counts()).body).toMatchObject({
+          approvedConfigurations: 0,
+          confirmedChecks: 0,
+        });
+        const pending = yield* sdk.request("configuration/configure", {
+          app: ids.source,
+          tool: "configure",
+          revision: "owner-r1",
+        });
+        expect(pending.status, JSON.stringify(pending.body)).toBe(200);
+        const request = yield* Schema.decodeUnknownEffect(
+          Schema.Struct({ status: Schema.Literal("approval-required"), requestId: Schema.String }),
+        )(pending.body);
+        expect((yield* counts()).body).toMatchObject({ approvedConfigurations: 0 });
+        const completed = yield* sdk.request("configuration/resume", {
+          requestId: request.requestId,
+          response: { action: "accept" },
+        });
+        expect(completed.status, JSON.stringify(completed.body)).toBe(200);
+        expect((yield* counts()).body).toMatchObject({ approvedConfigurations: 1 });
+        expect((yield* call()).body).toMatchObject({
+          status: "completed",
+          value: { message: "decoded" },
+        });
+        expect((yield* counts()).body).toMatchObject({ confirmedChecks: 1 });
+        yield* sdk.request("configuration/resume", {
+          requestId: request.requestId,
+          response: { action: "accept" },
+        });
