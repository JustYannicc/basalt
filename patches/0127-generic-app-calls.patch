new file mode 100644
--- /dev/null
+++ b/packages/sdk/src/implementation/app-call-receipts.ts
@@ -0,0 +1,132 @@
+/** Host-only effect fence. Expiry closes a reservation; it never transfers dispatch authority. */
+import { Clock, type Crypto, Effect, Redacted, Schema } from "effect";
+import { AppCallFailed } from "apps/contracts";
+import { AppCallReceiptId } from "../contracts/app-calls.ts";
+import { Json, JsonObject, StorageError, type AppId, type OwnerId } from "../contracts/shared.ts";
+import type { Credentials } from "../contracts/storage.ts";
+import { lockApp } from "./apps.ts";
+import { query, transaction, type Query } from "./database.ts";
+const Payload = Schema.Struct({
+  fingerprint: Schema.String,
+  dispatch: Schema.String,
+  result: Schema.optionalKey(Json),
+});
+export const makeAppCallReceipts = (db: Query, credentials: Credentials, crypto: Crypto.Crypto) => {
+  const find = (id: AppCallReceiptId) =>
+    query(() => db.findFirst("appCallReceipts", { where: (b) => b("id", "=", id) }));
+  type Row = NonNullable<Effect.Success<ReturnType<typeof find>>>;
+  const read = (row: Row) =>
+    credentials.decrypt(AppCallReceiptId.make(row.id), Redacted.make(row.encrypted)).pipe(
+      Effect.flatMap((value) => Schema.decodeUnknownEffect(Payload)(Redacted.value(value))),
+      Effect.mapError(() => new StorageError()),
+    );
+  const seal = (id: AppCallReceiptId, value: typeof Payload.Type) =>
+    Schema.encodeEffect(Schema.toCodecJson(Payload))(value).pipe(
+      Effect.flatMap(Schema.decodeUnknownEffect(JsonObject)),
+      Effect.flatMap((value) => credentials.encrypt(id, Redacted.make(value))),
+      Effect.mapError(() => new StorageError()),
+    );
+  const unknown = (row: Row, now: Date) =>
+    query(() =>
+      db.updateMany("appCallReceipts", {
+        where: (b) => b.and(b("id", "=", row.id), b("state", "=", "reserved")),
+        set: { state: "outcome_unknown", updatedAt: now },
+      }),
+    );
+  const reserve = (input: {
+    readonly id: AppCallReceiptId;
+    readonly app: AppId;
+    readonly owner: OwnerId;
+    readonly connection: string;
+    readonly fingerprint: string;
+    readonly deadline: number;
+  }) =>
+    transaction(db, () =>
+      Effect.gen(function* () {
+        yield* lockApp(db, input);
+        const now = new Date(yield* Clock.currentTimeMillis);
+        const row = yield* find(input.id);
+        if (row !== null) {
+          if (
+            row.app !== input.app ||
+            row.owner !== input.owner ||
+            row.connection !== input.connection
+          )
+            return yield* new AppCallFailed({ retryable: false, reason: "identity_conflict" });
+          const payload = yield* read(row);
+          if (payload.fingerprint !== input.fingerprint)
+            return yield* new AppCallFailed({ retryable: false, reason: "identity_conflict" });
+          if (row.state === "reserved" && now >= row.deadline) {
+            yield* unknown(row, now);
+            return { status: "outcome_unknown" as const };
+          }
+          if (row.state === "completed" && payload.result !== undefined)
+            return { status: "completed" as const, value: payload.result };
+          return {
+            status:
+              row.state === "reserved" ? ("in_progress" as const) : ("outcome_unknown" as const),
+          };
+        }
+        const expired = input.deadline <= now.getTime();
+        const dispatch = yield* crypto.randomUUIDv4.pipe(Effect.mapError(() => new StorageError()));
+        const encrypted = yield* seal(input.id, { fingerprint: input.fingerprint, dispatch });
+        yield* query(() =>
+          db.create("appCallReceipts", {
+            id: input.id,
+            app: input.app,
+            owner: input.owner,
+            connection: input.connection,
+            state: expired ? "outcome_unknown" : "reserved",
+            deadline: new Date(input.deadline),
+            encrypted,
+            createdAt: now,
+            updatedAt: now,
+          }),
+        );
+        return expired
+          ? { status: "outcome_unknown" as const }
+          : { status: "reserved" as const, dispatch };
+      }),
+    );
+  const finish = (input: {
+    readonly id: AppCallReceiptId;
+    readonly app: AppId;
+    readonly owner: OwnerId;
+    readonly dispatch: string;
+    readonly result?: Json;
+  }) =>
+    transaction(db, () =>
+      Effect.gen(function* () {
+        yield* lockApp(db, input);
+        const row = yield* find(input.id);
+        if (row === null || row.app !== input.app || row.owner !== input.owner)
+          return yield* new AppCallFailed({ retryable: false, reason: "identity_conflict" });
+        const payload = yield* read(row);
+        if (payload.dispatch !== input.dispatch)
+          return yield* new AppCallFailed({ retryable: false, reason: "identity_conflict" });
+        if (row.state !== "reserved")
+          return {
+            status:
+              row.state === "completed" ? ("completed" as const) : ("outcome_unknown" as const),
+          };
+        const now = new Date(yield* Clock.currentTimeMillis);
+        if (
+          input.result === undefined ||
+          now >= row.deadline ||
+          new TextEncoder().encode(JSON.stringify(input.result)).byteLength > 1_048_576
+        ) {
+          yield* unknown(row, now);
+          return { status: "outcome_unknown" as const };
+        }
+        const encrypted = yield* seal(input.id, { ...payload, result: input.result });
+        yield* query(() =>
+          db.updateMany("appCallReceipts", {
+            where: (b) => b.and(b("id", "=", input.id), b("state", "=", "reserved")),
+            set: { state: "completed", encrypted, updatedAt: now },
+          }),
+        );
+        return { status: "completed" as const };
+      }),
+    );
+  return { reserve, finish };
+};
