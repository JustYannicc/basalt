@@ -0,0 +1,139 @@
+import { Effect, Schema } from "effect";
+import { AppCallFailed, AppDependency } from "apps/contracts";
+import { CurrentActor } from "../contracts/executor.ts";
+import {
+  type AppApprovedConfiguration,
+  type AppCallHooks,
+  AppConnectionId,
+} from "../contracts/app-calls.ts";
+import { StorageError } from "../contracts/shared.ts";
+import { storedApp, storedVersion, lockApp } from "./apps.ts";
+import { query, transaction, type Query } from "./database.ts";
+import type { makeAppConnections } from "./app-connections.ts";
+
+/** Only tools.resume supplies a consumed, successful approval event. There is no public writer. */
+export const makeAppConfirmations =
+  (
+    db: Query,
+    connections: ReturnType<typeof makeAppConnections>,
+    hooks: AppCallHooks | undefined,
+  ) =>
+  (event: Omit<AppApprovedConfiguration, "actor" | "connections">) =>
+    Effect.gen(function* () {
+      if (hooks?.configurationApproved === undefined) return;
+      const actor = yield* CurrentActor;
+      if (actor === undefined) return;
+      const source = yield* storedApp(db, { app: event.app, owner: event.owner });
+      const version = yield* storedVersion(db, source);
+      if (version.id !== event.version)
+        return yield* new AppCallFailed({ reason: "stale", retryable: false });
+      const rows = yield* query(() =>
+        db.findMany("appConnections", {
+          where: (b) =>
+            b.and(
+              b("app", "=", event.app),
+              b("owner", "=", event.owner),
+              b.or(b("subject", "=", ""), b("subject", "=", actor)),
+            ),
+        }),
+      );
+      const candidates: Array<AppApprovedConfiguration["connections"][number]> = [];
+      for (const row of rows) {
+        const payload = yield* connections.payload(row);
+        const declaration = version.requirements.dependencies?.[row.dependency];
+        if (
+          declaration?.configuration?.tool !== event.tool ||
+          !Schema.toEquivalence(AppDependency)(declaration, payload.declaration)
+        )
+          continue;
+        yield* connections.authorize(
+          {
+            app: event.app,
+            owner: event.owner,
+            dependency: row.dependency,
+            scope: row.subject === "" ? "app" : "user",
+            target: row.target,
+          },
+          true,
+        );
+        candidates.push({ ...connections.view(row), declaration });
+      }
+      if (candidates.length === 0) return;
+      const decision = yield* hooks.configurationApproved({
+        ...event,
+        actor,
+        connections: candidates,
+      });
+      if (decision.approvedBy !== actor)
+        return yield* new AppCallFailed({ reason: "denied", retryable: false });
+      const ids = new Set<string>();
+      yield* transaction(db, () =>
+        Effect.gen(function* () {
+          const source = yield* lockApp(db, { app: event.app, owner: event.owner });
+          if (source.activeVersion !== event.version)
+            return yield* new AppCallFailed({ reason: "stale", retryable: false });
+          for (const attachment of decision.attachments) {
+            const candidate = candidates.find((c) => c.id === attachment.connection);
+            if (
+              candidate === undefined ||
+              ids.has(attachment.connection) ||
+              candidate.revision !== attachment.revision ||
+              attachment.configurationRevision.length === 0
+            )
+              return yield* new AppCallFailed({ reason: "stale", retryable: false });
+            ids.add(attachment.connection);
+            const row = yield* connections.find(
+              event.app,
+              candidate.dependency,
+              candidate.scope === "app" ? "" : actor,
+            );
+            if (
+              row === null ||
+              row.id !== attachment.connection ||
+              row.revision !== attachment.revision ||
+              !row.enabled
+            )
+              return yield* new AppCallFailed({ reason: "stale", retryable: false });
+            yield* connections.authorize(
+              {
+                app: event.app,
+                owner: event.owner,
+                dependency: row.dependency,
+                scope: candidate.scope,
+                target: row.target,
+              },
+              true,
+            );
+            const current = yield* connections.payload(row);
+            if (!Schema.toEquivalence(AppDependency)(current.declaration, candidate.declaration))
+              return yield* new AppCallFailed({ reason: "stale", retryable: false });
+            const target = yield* storedApp(db, { app: row.target, owner: event.owner });
+            const targetVersion = yield* storedVersion(db, target);
+            const encrypted = yield* connections.seal(AppConnectionId.make(row.id), {
+              declaration: current.declaration,
+              accounts: current.accounts,
+              ...(attachment.value === null
+                ? {}
+                : {
+                    confirmation: {
+                      sourceVersion: event.version,
+                      targetVersion: targetVersion.id,
+                      connectionRevision: row.revision,
+                      configurationRevision: attachment.configurationRevision,
+                      approvedBy: actor,
+                      accounts: current.accounts,
+                      declaration: current.declaration,
+                      value: attachment.value,
+                    },
+                  }),
+            });
+            yield* query(() =>
+              db.updateMany("appConnections", {
+                where: (b) => b("id", "=", row.id),
+                set: { encrypted },
+              }),
+            );
+          }
+        }),
+      );
+    }).pipe(Effect.mapError(() => new StorageError()));
