+import {
+  AppAccounts,
+  AppConnection,
+  AppConnectionConflict,
+  AppConnectionRefused,
+  AppConnectionScope,
+  AppId,
+  StorageError,
+} from "@executor-js/sdk/core";
+import { Schema } from "effect";
+import { HttpApiEndpoint, HttpApiGroup } from "effect/http-api";
+import { RequiredAction } from "./authorization.ts";
+import {
+  OrganizationForbidden,
+  OrganizationReference,
+  RequireOrganization,
+} from "./organization.ts";
+const params = { organization: OrganizationReference, app: AppId };
+const path = "/api/organizations/:organization/apps/:app/connections";
+const error = [OrganizationForbidden, StorageError, AppConnectionConflict, AppConnectionRefused];
+const revision = Schema.Int.check(Schema.isGreaterThanOrEqualTo(0));
+export const HostedAppConnections = HttpApiGroup.make("appConnections")
+  .add(
+    HttpApiEndpoint.get("list", path, {
+      params,
+      success: Schema.Struct({ connections: Schema.Array(AppConnection) }),
+      error,
+    }).annotate(RequiredAction, "read"),
+  )
+  .add(
+    HttpApiEndpoint.put("save", `${path}/:dependency`, {
+      params: { ...params, dependency: Schema.NonEmptyString },
+      payload: Schema.Struct({
+        scope: AppConnectionScope,
+        target: AppId,
+        revision,
+        accounts: Schema.optionalKey(AppAccounts),
+      }),
+      success: AppConnection,
+      error,
+    }).annotate(RequiredAction, "manage"),
+  )
+  .add(
+    HttpApiEndpoint.patch("update", `${path}/:dependency`, {
+      params: { ...params, dependency: Schema.NonEmptyString },
+      payload: Schema.Struct({ scope: AppConnectionScope, enabled: Schema.Boolean, revision }),
+      success: AppConnection,
+      error,
+    }).annotate(RequiredAction, "manage"),
+  )
+  .add(
+    HttpApiEndpoint.delete("remove", `${path}/:dependency`, {
+      params: { ...params, dependency: Schema.NonEmptyString },
+      query: { scope: AppConnectionScope, revision },
+      success: Schema.Struct({ success: Schema.Literal(true) }),
+      error,
+    }).annotate(RequiredAction, "manage"),
+  )
+  .middleware(RequireOrganization);
