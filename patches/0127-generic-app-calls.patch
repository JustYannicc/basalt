+import { Effect } from "effect";
+import { HttpApiBuilder } from "effect/http-api";
+import { CurrentActor } from "@executor-js/sdk/core";
+import { HostedApi } from "../contracts/api.ts";
+import { HostedExecutor } from "../contracts/executor.ts";
+import { currentOwner } from "./access.ts";
+import { CurrentUserId } from "../contracts/auth.ts";
+const operation = <A, E, R>(
+  run: (
+    executor: import("@executor-js/sdk/core").Executor,
+    owner: import("@executor-js/sdk/core").OwnerId,
+  ) => Effect.Effect<A, E, R>,
+) =>
+  Effect.gen(function* () {
+    const executor = yield* Effect.flatten(HostedExecutor);
+    const owner = yield* currentOwner;
+    return yield* run(executor, owner).pipe(
+      Effect.provideService(CurrentActor, yield* CurrentUserId),
+    );
+  });
+export const hostedAppConnectionHandlers = HttpApiBuilder.group(
+  HostedApi,
+  "appConnections",
+  (handlers) =>
+    handlers
+      .handle("list", ({ params }) =>
+        operation((executor, owner) => executor.appConnections.list({ app: params.app, owner })),
+      )
+      .handle("save", ({ params, payload }) =>
+        operation((executor, owner) =>
+          executor.appConnections.save({ ...params, ...payload, owner }),
+        ),
+      )
+      .handle("update", ({ params, payload }) =>
+        operation((executor, owner) =>
+          executor.appConnections.update({ ...params, ...payload, owner }),
+        ),
+      )
+      .handle("remove", ({ params, query }) =>
+        operation((executor, owner) =>
+          executor.appConnections.remove({ ...params, ...query, owner }),
+        ),
+      ),
+);
