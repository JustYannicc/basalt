+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { App } from "../support/contracts.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { poolRoutingBackend } from "../support/pool-routing-backend.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(RuntimeLive, { excludeTestServices: true })("Pool routing trace", (it) => {
+  it.effect(scenarios.poolRoutingTrace.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const viewer = yield* body(
+          Schema.Struct({ userId: Schema.String }),
+          yield* api.request(actors.owner, "GET", "/api/viewer"),
+        );
+        const backend = yield* poolRoutingBackend(viewer.userId);
+        const app = yield* body(
+          App,
+          yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+            name: "Routing trace fixture",
+            files: [
+              appsManifest,
+              {
+                path: "index.ts",
+                content: `import {defineApp} from "apps"; export default defineApp({},{});`,
+              },
+            ],
+          }),
+        );
+        const saved = (value: object) => ({
+          sql: `update organization set metadata=jsonb_set(coalesce(metadata::jsonb,'{}'::jsonb),'{basaltPools}',$1::jsonb)::text where id=$2`,
+          params: [JSON.stringify(value), actors.organization.id],
+        });
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* serverControl("stop");
+            yield* legacyStorage([saved({})]);
+            yield* serverControl("start");
+            yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app.id}`);
+          }).pipe(Effect.orDie),
+        );
+        yield* serverControl("stop");
+        yield* legacyStorage([
+          saved({
+            [viewer.userId]: {
+              app: app.id,
+              version: "retained-version",
+              authorization: "executor-app-v1",
+              membership: "executor-links-v1",
+            },
+          }),
+        ]);
+        yield* serverControl("environment", 200, {
+          POOL_APP_SIGNING_KEY: "ab".repeat(32),
+          BASALT_POOL_ORIGIN: backend.origin,
+        });
+        yield* serverControl("start");
+        const path = `${prefix}/apps/${app.id}/pool-routing-decisions`;
+        for (const actor of [actors.member, actors.admin]) {
+          expect((yield* api.request(actor, "GET", path)).status).toBe(403);
+        }
+        expect(yield* backend.calls).toHaveLength(0);
+        const response = yield* api.request(actors.owner, "GET", path);
+        expect(response.status, JSON.stringify(response.body)).toBe(200);
+        expect(response.body).toMatchObject({
+          current: [
+            {
+              scope: "account-windows",
+              mode: "balanced-fallback",
+              candidates: [{ account: null, display: "withheld" }],
+            },
+          ],
+          decisions: [],
+          capacity: [],
+        });
+        expect(JSON.stringify(response.body)).not.toContain("must-be-dropped");
+        expect(yield* backend.calls).toHaveLength(1);
+      }),
+    ),
+  );
+});
diff --git a/e2e/support/pool-routing-backend.ts b/e2e/support/pool-routing-backend.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/pool-routing-backend.ts
@@ -0,0 +1,101 @@
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Clock, Effect, Layer, Ref, Schema } from "effect";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { createHmac, timingSafeEqual } from "node:crypto";
+import { createServer } from "node:http";
+
+const Assertion = Schema.Struct({
+  action: Schema.Literal("routingDecisions"),
+  pool: Schema.String,
+  organization: Schema.String,
+  owner: Schema.String,
+  user: Schema.String,
+  expiresAt: Schema.Number,
+  canEdit: Schema.Boolean,
+  accounts: Schema.Array(
+    Schema.Struct({ account: Schema.String, home: Schema.Array(Schema.String) }),
+  ),
+});
+
+/** Only the external pool is synthetic. Hosted authorization and schema decoding remain real. */
+export const poolRoutingBackend = (owner: string) =>
+  Effect.gen(function* () {
+    const calls = yield* Ref.make<readonly (typeof Assertion.Type)[]>([]);
+    const handler = Effect.gen(function* () {
+      const request = yield* HttpServerRequest.HttpServerRequest;
+      const body = yield* request.json.pipe(
+        Effect.flatMap(Schema.decodeUnknownEffect(Schema.Struct({ envelope: Schema.String }))),
+      );
+      const [prefix, encoded, signature, extra] = body.envelope.split(".");
+      if (prefix !== "sbs1" || !encoded || !signature || extra !== undefined)
+        return HttpServerResponse.empty({ status: 401 });
+      const actual = Buffer.from(signature, "base64url"),
+        expected = createHmac("sha256", Buffer.from("ab".repeat(32), "hex"))
+          .update(`${prefix}.${encoded}`)
+          .digest();
+      if (actual.length !== expected.length || !timingSafeEqual(actual, expected))
+        return HttpServerResponse.empty({ status: 401 });
+      const assertion = yield* Schema.decodeUnknownEffect(Schema.fromJsonString(Assertion))(
+        Buffer.from(encoded, "base64url").toString(),
+      );
+      const now = yield* Clock.currentTimeMillis;
+      if (
+        assertion.owner !== owner ||
+        assertion.user !== owner ||
+        !assertion.canEdit ||
+        assertion.expiresAt <= now ||
+        assertion.expiresAt > now + 30_000
+      )
+        return HttpServerResponse.empty({ status: 401 });
+      yield* Ref.update(calls, (items) => [...items, assertion]);
+      const at = new Date(now).toISOString();
+      return HttpServerResponse.jsonUnsafe({
+        settings: {
+          strategy: "quota-deadline",
+          revision: "fixture",
+          changedAt: at,
+          canChange: true,
+          choices: [
+            {
+              strategy: "quota-deadline",
+              label: "Use quota before it resets",
+              description: "Pace quota toward resets.",
+            },
+          ],
+        },
+        decisions: [],
+        current: [
+          {
+            provider: "claude",
+            modelFamily: null,
+            scope: "account-windows",
+            computedAt: at,
+            validUntil: new Date(now + 60_000).toISOString(),
+            status: "available",
+            configuredStrategy: "quota-deadline",
+            effectiveStrategy: "round-robin",
+            mode: "balanced-fallback",
+            reason: "unknown-rank",
+            forecast: null,
+            targetThrough: null,
+            candidates: [{ account: null, display: "withheld" }],
+          },
+        ],
+        capacity: [],
+        next: null,
+        retention: { from: at, through: at, persistence: "runtime", truncated: false },
+        privateExtension: "must-be-dropped",
+      });
+    });
+    const services = yield* Layer.build(
+      HttpRouter.serve(HttpRouter.add("POST", "/pool/v1/routingDecisions", handler), {
+        disableLogger: true,
+        disableListenLog: true,
+      }).pipe(
+        Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 })),
+      ),
+    );
+    const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+    if (!("port" in server.address)) return yield* Effect.die("Routing fixture requires TCP");
+    return { origin: `http://127.0.0.1:${server.address.port}`, calls: Ref.get(calls) };
+  });
