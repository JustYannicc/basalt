+import { Schema } from "effect";
+import { AccountId } from "@executor-js/sdk/core";
+
+const text = Schema.NonEmptyString.check(Schema.isMaxLength(256));
+const at = Schema.String.check(Schema.isMaxLength(35));
+const amount = Schema.Finite.check(Schema.isGreaterThanOrEqualTo(0));
+const ratio = Schema.Finite.check(Schema.isBetween({ minimum: 0, maximum: 1 }));
+const maybeAt = Schema.NullOr(at);
+const strategies = Schema.Literals([
+  "quota-deadline",
+  "round-robin",
+  "fill-first",
+  "weighted-round-robin",
+]);
+const reasons = Schema.Array(
+  Schema.Literals([
+    "quota-calibration-missing",
+    "plan-weight-unknown",
+    "quota-reading-stale",
+    "reset-unknown",
+    "rolling-window-history-missing",
+    "history-gap",
+    "demand-censored",
+    "sticky-demand-uncertain",
+    "forecast-expired",
+  ]),
+);
+const evidence = Schema.Struct({
+  source: Schema.Literals(["history-forecast", "observed-quota-burn", "none"]),
+  revision: Schema.NullOr(text),
+  status: Schema.Literals([
+    "calibrated",
+    "observed",
+    "uncalibrated",
+    "stale",
+    "insufficient-history",
+  ]),
+  confidence: Schema.NullOr(Schema.Literals(["low", "medium", "high"])),
+  calculatedAt: at,
+  validUntil: maybeAt,
+  historyFrom: maybeAt,
+  historyThrough: maybeAt,
+  coverageRatio: Schema.NullOr(ratio),
+  heldOutPeriods: amount,
+  backtestRelativeError: Schema.NullOr(amount),
+  unit: Schema.NullOr(Schema.Struct({ id: text, label: text, calibrationRevision: text })),
+  reasons,
+});
+const candidate = Schema.Union([
+  Schema.Struct({ account: Schema.Null, display: Schema.Literal("withheld") }),
+  Schema.Struct({
+    account: AccountId,
+    display: Schema.Literal("inspectable"),
+    eligible: Schema.Boolean,
+    funding: Schema.Literals(["plan", "credits", "unknown", "blocked"]),
+    reason: Schema.Literals([
+      "target-share",
+      "balanced-fallback",
+      "affinity",
+      "parent-affinity",
+      "pinned",
+      "credits-last-resort",
+      "quota-exhausted",
+      "cooldown",
+      "concurrency-full",
+      "model-incompatible",
+      "disabled",
