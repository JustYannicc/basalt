+      "pinned-account",
+    ]),
+    quota: Schema.NullOr(
+      Schema.Struct({
+        remainingRatio: ratio,
+        window: Schema.Literals(["weekly", "five-hour"]),
+        resetAt: at,
+        observedAt: at,
+        staleAt: at,
+      }),
+    ),
+    fiveHour: Schema.NullOr(
+      Schema.Struct({
+        remainingRatio: ratio,
+        resetAt: maybeAt,
+        mode: Schema.Literals(["fixed", "rolling", "unknown"]),
+      }),
+    ),
+    targetBurnRate: Schema.NullOr(amount),
+    weight: Schema.NullOr(ratio),
+    projectedEmptyAt: maybeAt,
+    emptyProjection: Schema.Literals(["estimated", "not-before-reset", "unavailable"]),
+  }),
+]);
+const decision = Schema.Struct({
+  id: text,
+  at,
+  model: text,
+  configuredStrategy: strategies,
+  effectiveStrategy: strategies,
+  mode: Schema.Literals([
+    "forecast-paced",
+    "observed-paced",
+    "deadline-rate",
+    "balanced-fallback",
+    "configured-strategy",
+    "affinity",
+    "pinned",
+    "refused",
+  ]),
+  reason: Schema.Literals([
+    "deadline-budget",
+    "observed-burn-target",
+    "uncalibrated-demand",
+    "forecast-expired",
+    "unknown-rank",
+    "invalid-rank",
+    "expired-rank",
+    "credits-only",
+    "existing-affinity",
+    "parent-affinity",
+    "pinned-account",
+    "configured-strategy",
+    "no-eligible-account",
+    "mixed-provider-cohort",
+  ]),
+  forecast: Schema.NullOr(evidence),
+  targetThrough: maybeAt,
+  candidates: Schema.Array(candidate).check(Schema.isMaxLength(500)),
+  chosenAccount: Schema.NullOr(AccountId),
+  outcome: Schema.Literals(["admitted", "refused"]),
+  attempts: Schema.Array(
+    Schema.Struct({
+      account: Schema.NullOr(AccountId),
+      outcome: Schema.Literals(["admitted", "concurrency-full", "unavailable"]),
+    }),
+  ).check(Schema.isMaxLength(500)),
+  usageRecord: Schema.NullOr(text),
+});
+const attention = Schema.Struct({
+  evaluatedAt: at,
+  notice: Schema.Literals(["none", "needs-more-accounts", "routing-waste"]),
+  inboxNudge: Schema.Literals(["none", "eligible"]),
+  episode: Schema.NullOr(text),
+  firstShortfallAt: maybeAt,
+  reason: Schema.Literals([
+    "no-median-shortfall",
+    "outside-horizon",
+    "low-confidence",
+    "stale-evidence",
+    "incomplete-evidence",
+    "awaiting-confirmation",
+    "notice-only",
+    "within-three-days",
+  ]),
+  policy: Schema.Struct({
+    minimumConfidence: Schema.Literal("medium"),
+    minimumCoverageRatio: Schema.Literal(0.9),
+    minimumHeldOutPeriods: Schema.Literal(2),
+    noticeHorizonDays: Schema.Literal(7),
+    inboxHorizonDays: Schema.Literal(3),
+    confirmationMinutes: Schema.Literal(5),
+  }),
+});
+const capacity = Schema.Struct({
+  provider: text,
+  modelFamily: Schema.NullOr(text),
+  from: at,
+  through: at,
+  status: Schema.Literals(["enough", "routing-waste", "needs-more-accounts", "uncertain"]),
+  evidence,
+  attention,
+  scenarios: Schema.Array(
+    Schema.Struct({
+      demand: Schema.Literals(["median", "upper-80"]),
+      configuredUnserved: amount,
+      feasibleUnserved: amount,
+      expiringUnused: amount,
+      firstShortfallAt: maybeAt,
+      bottleneck: Schema.Literals(["weekly", "five-hour", "concurrency", "sticky", "none"]),
+    }),
+  ),
+  recommendation: Schema.NullOr(
+    Schema.Struct({
+      plan: text,
+      additionalAccounts: Schema.Struct({ median: amount, upper80: amount }),
+      basis: Schema.Literal("simulated-refill-schedule"),
+      assumedNewAccountStart: at,
+      constraints: Schema.Array(text),
+    }),
+  ),
+});
+
+const current = Schema.Struct({
+  provider: text,
+  modelFamily: Schema.NullOr(text),
+  scope: Schema.Literals(["account-windows", "model"]),
+  computedAt: at,
+  validUntil: at,
+  status: Schema.Literals(["available", "unavailable"]),
+  configuredStrategy: strategies,
+  effectiveStrategy: strategies,
+  mode: decision.fields.mode,
+  reason: decision.fields.reason,
+  forecast: Schema.NullOr(evidence),
+  targetThrough: maybeAt,
+  candidates: Schema.Array(candidate).check(Schema.isMaxLength(500)),
+});
+
+export const PoolRoutingDecisions = Schema.Struct({
+  settings: Schema.Struct({
+    strategy: strategies,
+    revision: Schema.String.check(Schema.isMaxLength(512)),
+    changedAt: at,
+    canChange: Schema.Boolean,
+    choices: Schema.Array(Schema.Struct({ strategy: strategies, label: text, description: text })),
+  }),
+  current: Schema.Array(current).check(Schema.isMaxLength(12)),
+  decisions: Schema.Array(decision).check(Schema.isMaxLength(20)),
+  next: Schema.NullOr(text),
+  retention: Schema.Struct({
+    from: at,
+    through: at,
+    truncated: Schema.Boolean,
+    persistence: Schema.Literal("runtime"),
+  }),
+  capacity: Schema.Array(capacity),
+});
+export type PoolRoutingDecisions = typeof PoolRoutingDecisions.Type;
