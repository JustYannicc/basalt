+/**
+ * Reading an embedded page's navigation request, for hosts that embed app screens. The page sends
+ * `apps/client`'s `navigate`; the host decides whether to follow it and answers either way.
+ */
+import { HostNavigationRequest, HostNavigationResult } from "apps/ui/contracts";
+import { Option, Schema } from "effect";
+
+const decode = Schema.decodeUnknownOption(HostNavigationRequest);
+
+export type HostNavigation = typeof HostNavigationRequest.Type;
+
+/**
+ * A navigation message, by its ID: `request` is none when the message names a destination or
+ * shape this host does not know, which the host refuses. Any other message is undefined.
+ */
+export const readHostNavigation = (
+  data: unknown,
+): { readonly id: string; readonly request: Option.Option<HostNavigation> } | undefined =>
+  typeof data === "object" &&
+  data !== null &&
+  "type" in data &&
+  data.type === "executor:navigate" &&
+  "id" in data &&
+  typeof data.id === "string" &&
+  data.id !== ""
+    ? { id: data.id, request: decode(data) }
+    : undefined;
+
+/** The answer a host posts back to the page that asked. */
+export const hostNavigationResult = (
+  id: string,
+  accepted: boolean,
+): typeof HostNavigationResult.Type => ({ type: "executor:navigate-result", id, accepted });
diff --git a/e2e/tests/app-host-navigation.spec.ts b/e2e/tests/app-host-navigation.spec.ts
