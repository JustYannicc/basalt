+++ b/e2e/support/app-host-navigation.ts
@@ -0,0 +1,82 @@
+/** Synthetic author app and browser reads for the host-navigation journey. */
+import type { Frame, Page } from "playwright";
+import { appsManifest } from "./apps-release.ts";
+
+const source = `import { defineApp, defineProvider, secrets, query, object, string, router } from "apps";
+const service = defineProvider({ name: "Navigation fixture", auth: { key: secrets({ label: "Key", fields: object({ token: string() }) }) } });
+export const ping = query({ input: object({}) }, async () => "pong");
+export default defineApp({ user: { accounts: { service: service.many() } } }, { tools: router({ ping }) });`;
+
+/**
+ * Buttons ask the host through the public client. `sendRaw` posts a hand-written request, as a page
+ * from another version or with an unknown destination would, and reports the host's answer.
+ */
+export const files = [
+  { path: "index.ts", content: source },
+  {
+    path: "ui/index.html",
+    content: `<!doctype html><html><head><title>Navigation fixture</title></head><body><main><h1>Navigation fixture</h1><label>Draft <input name="draft"></label><button id="settings">Open settings</button><button id="account">Show account</button><output></output></main><script type="module" src="./main.ts"></script></body></html>`,
+  },
+  {
+    path: "ui/main.ts",
+    content: `import { createAppClient } from "apps/client";
+const client = createAppClient();
+const context = JSON.parse(document.getElementById("executor-context")?.textContent ?? "{}");
+document.body.dataset.load = String(Math.random());
+const output = document.querySelector("output");
+const go = (destination) =>
+  client.navigate(destination).then((accepted) => (output.textContent = accepted ? "accepted" : "refused"));
+document.getElementById("settings").addEventListener("click", () => go({ tab: "settings" }));
+document.getElementById("account").addEventListener("click", () => go({ account: context.accounts?.service?.[0] }));
+window.version = context.version;
+window.sendRaw = (message) =>
+  new Promise((resolve) => {
+    const timer = setTimeout(() => resolve("unanswered"), 2000);
+    const answer = (event) => {
+      if (event.source !== parent || event.data?.type !== "executor:navigate-result" || event.data.id !== message.id) return;
+      clearTimeout(timer);
+      removeEventListener("message", answer);
+      resolve(event.data.accepted ? "accepted" : "refused");
+    };
+    addEventListener("message", answer);
+    parent.postMessage(message, "*");
+  });
+window.disposeNavigation = async () => {
+  const disposable = createAppClient();
+  await disposable.navigate({ tab: "app" });
+  const answer = disposable.navigate({ tab: "settings" });
+  await disposable.dispose();
+  return answer;
+};`,
+  },
+  appsManifest,
+];
+
+const navigation = (page: Page) => page.getByRole("navigation", { name: "App navigation" });
+export const selected = (page: Page) =>
+  navigation(page)
+    .locator('[aria-current="page"]')
+    .allTextContents()
+    .then((names) => names.map((name) => name.trim()));
+
+/** The app's document among the page's frames, by its origin. */
+export const appFrame = (page: Page, origin: string): Frame => {
+  const frame = page.frames().find((candidate) => candidate.url().startsWith(origin));
+  if (frame === undefined) throw new Error("The app's frame is missing");
+  return frame;
+};
+
+/** What the page keeps while hidden: its load marker, its draft and its last answer. */
+export const kept = (frame: Frame) =>
+  frame.evaluate(() => ({
+    load: document.body.dataset.load,
+    draft: document.querySelector("input")?.value,
+    answer: document.querySelector("output")?.textContent,
+  }));
+
+export const request = (version: string, destination: unknown) => ({
+  type: "executor:navigate",
+  id: `raw-${Math.random()}`,
+  version,
+  destination,
+});
