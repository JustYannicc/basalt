+const service = defineProvider({ name: "Navigation fixture", auth: { key: secrets({ label: "Key", fields: object({ token: string() }) }) } });
+export const ping = query({ input: object({}) }, async () => "pong");
+export default defineApp({ user: { accounts: { service: service.many() } } }, { tools: router({ ping }) });`;
