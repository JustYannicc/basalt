+            ),
+        );
+        const navigationPath = `${prefix}/apps/${app.id}/ui/navigation`;
+        const binding = { reference, origin, version };
+        const bound = yield* api.request(signedIn, "POST", navigationPath, binding);
+        expect([bound.status, bound.body]).toEqual([200, true]);
+        expect((yield* api.request(actors.owner, "POST", navigationPath, binding)).status).toBe(
+          401,
+        );
+        expect((yield* api.request(actors.member, "POST", navigationPath, binding)).status).toBe(
+          403,
+        );
+        const otherOrigin = yield* api.request(signedIn, "POST", navigationPath, {
+          ...binding,
+          origin: "https://example.com",
+        });
+        expect([otherOrigin.status, otherOrigin.body]).toEqual([200, false]);
+        expect(
+          (yield* api.request(signedIn, "POST", navigationPath, {
+            ...binding,
+            reference: "0".repeat(64),
+          })).status,
+        ).toBe(401);
+        const raw = (label: string, message: unknown) =>
+          browser.use(label, (page) =>
+            appFrame(page, origin).evaluate(
+              (value) =>
+                (window as unknown as { sendRaw: (message: unknown) => Promise<string> }).sendRaw(
+                  value,
+                ),
+              message,
+            ),
