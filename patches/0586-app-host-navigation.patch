@@ -0,0 +1,166 @@
+/** Public browser probes for independent navigation requests and posted-request disposal. */
+import { Effect, Fiber } from "effect";
+import { Browser } from "./browser.ts";
+import { holdQuery } from "./query-transition.ts";
+import { appFrame } from "./app-host-navigation.ts";
+
+/** Each client gets its own reply; disposing a posted request cancels the host's pending work. */
+export const navigationLifecycleProbe = (origin: string) =>
+  Effect.scoped(
+    Effect.gen(function* () {
+      const browser = yield* Browser;
+      const clearAnswers = () =>
+        browser.use("Clear previous navigation replies", (page) =>
+          appFrame(page, origin).evaluate(() => {
+            (window as unknown as { navigationAnswers: unknown[] }).navigationAnswers = [];
+          }),
+        );
+      const hostAnswers = (count: number) =>
+        browser.use("Observe the host's completed replies", (page) => {
+          const frame = appFrame(page, origin);
+          return frame
+            .waitForFunction(
+              (needed) =>
+                (window as unknown as { navigationAnswers: unknown[] }).navigationAnswers.length >=
+                needed,
+              count,
+            )
+            .then(() =>
+              frame.evaluate(() =>
+                (
+                  window as unknown as { navigationAnswers: { accepted: boolean }[] }
+                ).navigationAnswers.map((answer) => answer.accepted),
+              ),
+            );
+        });
+      const parallel = yield* Effect.scoped(
+        Effect.gen(function* () {
+          const hold = yield* holdQuery(/\/ui\/navigation$/, "continue", {
+            method: "POST",
+            allRequests: true,
+          });
+          yield* clearAnswers();
+          yield* browser.use("Start one client's request", (page) =>
+            appFrame(page, origin).evaluate(() => {
+              (
+                window as unknown as { startIndependentNavigation: (name: string) => void }
+              ).startIndependentNavigation("first");
+            }),
+          );
+          yield* hold.requested;
+          yield* browser.use(
+            "Another client starts a request before the first completes",
+            (page) => {
+              const requested = page.waitForRequest(
+                (request) =>
+                  request.method() === "POST" &&
+                  new URL(request.url()).pathname.endsWith("/ui/navigation"),
+              );
+              return appFrame(page, origin)
+                .evaluate(() => {
+                  (
+                    window as unknown as { startIndependentNavigation: (name: string) => void }
+                  ).startIndependentNavigation("second");
+                })
+                .then(() => requested)
+                .then(() => undefined);
+            },
+          );
+          yield* hold.release;
+          const answers = yield* browser.use("Read each client's own answer", (page) =>
+            appFrame(page, origin).evaluate(() =>
+              (
+                window as unknown as { independentNavigationAnswers: () => Promise<boolean[]> }
+              ).independentNavigationAnswers(),
+            ),
+          );
+          yield* hostAnswers(2);
+          return answers;
+        }),
+      );
+      const hold = yield* holdQuery(/\/ui\/navigation$/, "continue", { method: "POST" });
+      yield* clearAnswers();
+      const answer = yield* Effect.forkChild(
+        browser.use("Post a request from a disposable client", (page) =>
+          appFrame(page, origin).evaluate(() =>
+            (
+              window as unknown as { startPostedNavigation: () => Promise<boolean> }
+            ).startPostedNavigation(),
+          ),
+        ),
+      );
+      yield* hold.requested;
+      yield* browser.use("Dispose after the host has started authorization", (page) =>
+        appFrame(page, origin).evaluate(() =>
+          (
+            window as unknown as { disposePostedNavigation: () => Promise<void> }
+          ).disposePostedNavigation(),
+        ),
+      );
+      const disposed = yield* Fiber.join(answer);
+      yield* hold.release;
+      const replies = yield* hostAnswers(1);
+      const search = yield* browser.use("Read the route after the released response", (page) =>
+        Promise.resolve(new URL(page.url()).search),
+      );
+      return { parallel, disposed, host: replies.at(-1), search };
+    }),
+  );
+
+/** A refused record cannot borrow the result of a valid request sharing the parent channel. */
+export const navigationAuthorityIsolationProbe = (origin: string) =>
+  Effect.scoped(
+    Effect.gen(function* () {
+      const browser = yield* Browser;
+      const hold = yield* holdQuery(/\/ui\/navigation$/, "continue", { method: "POST" });
+      yield* browser.use("Post a valid request whose read stays pending", (page) =>
+        appFrame(page, origin).evaluate(() => {
+          (
+            window as unknown as { startIndependentNavigation: (name: string) => void }
+          ).startIndependentNavigation("overlapping-valid");
+        }),
+      );
+      yield* hold.requested;
+      yield* browser.use("The other request's own session check is refused", (page) => {
+        const refused = page.waitForResponse(
+          (response) =>
+            new URL(response.url()).pathname.endsWith("/ui/navigation") &&
+            response.status() === 401,
+        );
+        return appFrame(page, origin)
+          .evaluate(() => {
+            const fixture = window as unknown as {
+              version: string;
+              mixedAnswer: Promise<string>;
+              sendRaw: (request: unknown) => Promise<string>;
+            };
+            fixture.mixedAnswer = fixture.sendRaw({
+              type: "executor:navigate",
+              id: `invalid-${Math.random()}`,
+              version: fixture.version,
+              reference: "0".repeat(64),
+              expiresAt: Date.now() + 3000,
+              destination: { tab: "settings" },
+            });
+          })
+          .then(() => refused)
+          .then(() => undefined);
+      });
+      yield* hold.release;
+      const answers = yield* browser.use("Read the separately correlated answers", (page) =>
+        appFrame(page, origin).evaluate(() => {
+          const fixture = window as unknown as {
+            mixedAnswer: Promise<string>;
+            independentNavigationAnswers: () => Promise<boolean[]>;
+          };
+          return Promise.all([fixture.mixedAnswer, fixture.independentNavigationAnswers()]).then(
+            ([invalid, valid]) => ({ invalid, valid: valid[0] }),
+          );
+        }),
+      );
+      const search = yield* browser.use("An invalid record opens no host tab", (page) =>
+        Promise.resolve(new URL(page.url()).search),
+      );
+      return { ...answers, search };
+    }),
+  );
