--- /dev/null
+++ b/e2e/tests/app-host-navigation.spec.ts
@@ -0,0 +1,405 @@
+/** An embedded app page opens its host's tabs and accounts through `apps/client`, in one window. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Redacted, Schema } from "effect";
+import { randomUUID } from "node:crypto";
+import { scenarios } from "../test-plan.ts";
+import { Actors, password } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { App, Resource } from "../support/contracts.ts";
+import { waitForAppUrl } from "../support/app-pages.ts";
+import { connectionsPath } from "../support/app-accounts.ts";
+import { openThroughBrowser } from "../support/in-app-navigation.ts";
+import { appFrame, files, kept, request, selected } from "../support/app-host-navigation.ts";
+
+layer(HostedLive, { excludeTestServices: true })("App host navigation", (it) => {
+  it.effect(scenarios.appHostNavigation.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          browser = yield* Browser;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const name = `Navigation ${randomUUID().slice(0, 8)}`;
+        const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name,
+          files,
+        });
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const app = yield* body(
+          Schema.Struct({ ...App.fields, activeVersion: Schema.String }),
+          deployed,
+        );
+        const accounts: string[] = [];
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            expect(
+              (yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app.id}`)).status,
+            ).toBe(200);
+            for (const id of accounts)
+              expect(
+                (yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${id}`)).status,
+              ).toBe(200);
+          }).pipe(Effect.orDie),
+        );
+        const connection = yield* body(
+          Resource,
+          yield* api.request(
+            actors.owner,
+            "POST",
+            connectionsPath(`${prefix}/apps/${app.id}`, "user", "service"),
+            { destination: { kind: "shared", audience: { kind: "everyone" } } },
+          ),
+        );
+        const account = yield* body(
+          Resource,
+          yield* api.request(
+            actors.owner,
+            "POST",
+            `${prefix}/connections/${connection.id}/submit`,
+            {
+              method: "key",
+              label: "Navigation key",
+              fields: { token: "synthetic" },
+            },
+          ),
+        );
+        accounts.push(account.id);
+        const url = yield* waitForAppUrl(actors.owner, `${prefix}/apps/${app.id}/ui`);
+        const origin = new URL(url).origin;
+        const detail = `/org/${actors.organization.slug}/apps/${app.id}`;
+
+        // The browser signs in on its own, so revoking its login later leaves the fixture's intact.
+        const signedIn = yield* api.session();
+        expect(
+          (yield* api.request(signedIn, "POST", "/api/auth/sign-in/email", {
+            email: "owner@example.test",
+            password,
+          })).status,
+        ).toBe(200);
+        yield* browser.login(signedIn);
+        yield* openThroughBrowser("Open the app's screen", detail);
+        yield* browser.use("The app's page runs in its App tab", (page) =>
+          page
+            .frameLocator("iframe")
+            .getByRole("heading", { name: "Navigation fixture" })
+            .waitFor(),
+        );
+        yield* browser.use("Type a draft the page must keep", (page) =>
+          page.frameLocator("iframe").getByLabel("Draft").fill("kept draft"),
+        );
+        const first = yield* browser.use("Read the running page", (page) =>
+          kept(appFrame(page, origin)),
+        );
+        yield* browser.checkpoint("app page before host navigation");
+
+        // A tab of its own app, as a new history entry.
+        yield* browser.use("The page opens its Settings tab", (page) =>
+          page
+            .frameLocator("iframe")
+            .getByRole("button", { name: "Open settings" })
+            .click()
+            .then(() => page.waitForURL((current) => current.search === "?view=settings")),
+        );
+        expect(yield* browser.use("Settings is the selected tab", selected)).toEqual(["Settings"]);
+        expect(
+          new URL(yield* browser.use("Read the URL", (page) => Promise.resolve(page.url())))
+            .pathname,
+        ).toBe(detail);
+        yield* browser.checkpoint("host settings tab opened by the app");
+        yield* browser.use("Back returns to the app", (page) =>
+          page.goBack().then(() => page.waitForURL((current) => current.search === "")),
+        );
+        expect(yield* browser.use("App is the selected tab", selected)).toEqual(["App"]);
+        expect(
+          yield* browser.use("The same document kept its draft", (page) =>
+            kept(appFrame(page, origin)),
+          ),
+        ).toEqual({ ...first, answer: "accepted" });
+
+        // An account, highlighted on the Accounts page.
+        yield* browser.use("The page opens its account in Accounts", (page) =>
+          page
+            .frameLocator("iframe")
+            .getByRole("button", { name: "Show account" })
+            .click()
+            .then(() =>
+              page.waitForURL(
+                (current) =>
+                  current.pathname === `/org/${actors.organization.slug}/accounts` &&
+                  current.searchParams.get("account") === account.id,
+              ),
+            ),
+        );
+        expect(
+          yield* browser.use("Accounts highlights the account", (page) =>
+            page
+              .locator('[data-highlighted][aria-current="true"]')
+              .first()
+              .waitFor()
+              .then(() =>
+                page.locator('[data-highlighted][aria-current="true"]').allTextContents(),
+              ),
+          ),
+        ).toEqual([expect.stringContaining("Navigation key")]);
+        yield* browser.checkpoint("accounts highlight opened by the app");
+        yield* browser.use("Back returns to the app again", (page) =>
+          page.goBack().then(() => page.waitForURL((current) => current.pathname === detail)),
+        );
+        expect(
+          yield* browser.use("The document is still the same one", (page) =>
+            kept(appFrame(page, origin)),
+          ),
+        ).toEqual({ ...first, answer: "accepted" });
+
+        // Requests the host refuses, answered from the app's own document.
+        const version = yield* browser.use("Read the page's version", (page) =>
+          appFrame(page, origin).evaluate(() => (window as unknown as { version: string }).version),
+        );
+        expect(version).toBe(app.activeVersion);
+        const raw = (label: string, message: unknown) =>
+          browser.use(label, (page) =>
+            appFrame(page, origin).evaluate(
+              (value) =>
+                (window as unknown as { sendRaw: (message: unknown) => Promise<string> }).sendRaw(
+                  value,
+                ),
+              message,
+            ),
+          );
+        expect(
+          yield* raw(
+            "A request from another version is refused",
+            request("ver_stale", { tab: "settings" }),
+          ),
+        ).toBe("refused");
+        expect(yield* raw("An unknown tab is refused", request(version, { tab: "billing" }))).toBe(
+          "refused",
+        );
+        expect(
+          yield* raw(
+            "An address is not a destination",
+            request(version, { url: "https://example.com/" }),
+          ),
+        ).toBe("refused");
+        expect(
+          yield* raw("A malformed account is refused", request(version, { account: "someone" })),
+        ).toBe("refused");
+
+        // Windows other than the app's own document get no answer and move nothing.
+        yield* browser.use("The host's own window asks", (page) =>
+          page.evaluate(
+            (message) => window.postMessage(message, "*"),
+            request(version, { tab: "settings" }),
+          ),
+        );
+        yield* browser.use("A frame the app's page opens asks", (page) =>
+          appFrame(page, origin)
+            .evaluate(() => {
+              const child = document.createElement("iframe");
+              child.name = "nested";
+              document.body.append(child);
+            })
+            .then(() => {
+              const nested = page.frames().find((frame) => frame.name() === "nested");
+              if (nested === undefined) throw new Error("The nested frame is missing");
+              return nested.evaluate(
+                (message) => window.parent.parent.postMessage(message, "*"),
+                request(version, { tab: "settings" }),
+              );
+            }),
+        );
+        // The host handles messages in order: once this refusal arrives, both have been read.
+        expect(
+          yield* raw("A later refused request is answered", request("ver_stale", { tab: "tools" })),
+        ).toBe("refused");
+        expect(
+          yield* browser.use("The host stayed on the App tab", (page) =>
+            Promise.all([new URL(page.url()).search, selected(page)]),
+          ),
+        ).toEqual(["", ["App"]]);
+        expect(
+          yield* browser.use("The page kept its draft through refusals", (page) =>
+            kept(appFrame(page, origin)),
+          ),
+        ).toEqual({ ...first, answer: "accepted" });
+
+        expect(
+          yield* browser.use("Disposal cancels a queued navigation", (page) =>
+            appFrame(page, origin).evaluate(() =>
+              (
+                window as unknown as { disposeNavigation: () => Promise<boolean> }
+              ).disposeNavigation(),
+            ),
+          ),
+        ).toBe(false);
+        expect(
+          yield* browser.use("Disposed navigation stayed on App", (page) =>
+            Promise.resolve(new URL(page.url()).search),
+          ),
+        ).toBe("");
+
+        const windowPath = `${detail}/window`;
+        yield* openThroughBrowser("Open the app in its own host window", windowPath);
+        yield* browser.use("The own-window app is ready", (page) =>
+          page
+            .frameLocator("iframe")
+            .getByRole("heading", { name: "Navigation fixture" })
+            .waitFor(),
+        );
+        yield* browser.use("Type an own-window draft", (page) =>
+          page.frameLocator("iframe").getByLabel("Draft").fill("window draft"),
+        );
+        const windowFirst = yield* browser.use("Read the own-window document", (page) =>
+          kept(appFrame(page, origin)),
+        );
+        yield* browser.use("The own window opens Settings", (page) =>
+          page
+            .frameLocator("iframe")
+            .getByRole("button", { name: "Open settings" })
+            .click()
+            .then(() =>
+              page.waitForURL(
+                (current) => current.pathname === detail && current.search === "?view=settings",
+              ),
+            ),
+        );
+        yield* browser.use("Back returns to the own window", (page) =>
+          page
+            .goBack()
+            .then(() => page.waitForURL((current) => current.pathname === windowPath))
+            .then(() =>
+              page
+                .frameLocator("iframe")
+                .getByRole("heading", { name: "Navigation fixture" })
+                .waitFor(),
+            ),
+        );
+        expect(
+          yield* browser.use("Own-window navigation preserves its document and draft", (page) =>
+            kept(appFrame(page, origin)),
+          ),
+        ).toEqual({ ...windowFirst, answer: "accepted" });
+
+        // An account from the own window, and Back to the same document again.
+        yield* browser.use("The own window opens its account in Accounts", (page) =>
+          page
+            .frameLocator("iframe")
+            .getByRole("button", { name: "Show account" })
+            .click()
+            .then(() =>
+              page.waitForURL(
+                (current) =>
+                  current.pathname === `/org/${actors.organization.slug}/accounts` &&
+                  current.searchParams.get("account") === account.id,
+              ),
+            )
+            .then(() => page.locator('[data-highlighted][aria-current="true"]').first().waitFor()),
+        );
+        yield* browser.checkpoint("accounts highlight opened from the app's own window");
+        yield* browser.use("Back returns to the own window again", (page) =>
+          page
+            .goBack()
+            .then(() => page.waitForURL((current) => current.pathname === windowPath))
+            .then(() =>
+              page
+                .frameLocator("iframe")
+                .getByRole("heading", { name: "Navigation fixture" })
+                .waitFor(),
+            ),
+        );
+        expect(
+          yield* browser.use("The own window still runs the same document", (page) =>
+            kept(appFrame(page, origin)),
+          ),
+        ).toEqual({ ...windowFirst, answer: "accepted" });
+        yield* browser.checkpoint("own window after Back");
+
+        // Session binding. The page's version watch reloads it at its next heartbeat once its
+        // session ends; holding the next watch keeps the document mounted between heartbeats.
+        yield* browser.use("Hold the next version watch of the app", (page) => {
+          let watching = true;
+          return page.route(
+            (current) => current.origin === origin && current.pathname === "/_executor/version",
+            (route) => {
+              if (watching) {
+                watching = false;
+                return;
+              }
+              return route.continue();
+            },
+          );
+        });
+        yield* browser.use("Load a fresh document under the held watch", (page) => {
+          const frame = appFrame(page, origin);
+          return frame
+            .goto(frame.url())
+            .then(() =>
+              page
+                .frameLocator("iframe")
+                .getByRole("heading", { name: "Navigation fixture" })
+                .waitFor(),
+            )
+            .then(() => page.frameLocator("iframe").getByLabel("Draft").fill("session draft"));
+        });
+        const sessionFirst = yield* browser.use("Read the fresh document", (page) =>
+          kept(appFrame(page, origin)),
+        );
+        const refusedHere = (label: string) =>
+          browser.use(label, (page) =>
+            appFrame(page, origin)
+              .evaluate(() => {
+                const output = document.querySelector("output");
+                if (output !== null) output.textContent = "";
+              })
+              .then(() =>
+                page.frameLocator("iframe").getByRole("button", { name: "Open settings" }).click(),
+              )
+              .then(() =>
+                page.frameLocator("iframe").locator("output", { hasText: "refused" }).waitFor(),
+              )
+              .then(() => new URL(page.url()).pathname),
+          );
+
+        // The page's own scoped session ends while its document stays mounted.
+        const appCookies = yield* browser.use("Read the app's session", (page) =>
+          page.context().cookies(origin),
+        );
+        expect(appCookies.length).toBeGreaterThan(0);
+        yield* browser.use("The app's session ends", (page) =>
+          page.context().clearCookies({ domain: new URL(origin).hostname }),
+        );
+        expect(yield* refusedHere("A page whose session ended navigates nowhere")).toBe(windowPath);
+        yield* browser.use("The app's session is restored", (page) =>
+          page.context().addCookies(appCookies),
+        );
+
+        // The parent login is revoked elsewhere: the browser still holds its cookie.
+        const login = yield* browser.use("Read the dashboard login", (page) =>
+          page.context().cookies(new URL(page.url()).origin),
+        );
+        const elsewhere = yield* api.session(Redacted.make(login));
+        expect((yield* api.request(elsewhere, "POST", "/api/auth/sign-out", {})).status).toBe(200);
+        expect(yield* refusedHere("After revocation the page asks nothing")).toBe(windowPath);
+        expect(
+          yield* raw(
+            "The host refuses a current-version request after revocation",
+            request(version, { tab: "settings" }),
+          ),
+        ).toBe("refused");
+        expect(
+          yield* browser.use("Revocation navigated to no destination", (page) =>
+            Promise.resolve(new URL(page.url()).search),
+          ),
+        ).not.toBe("?view=settings");
+        expect(
+          yield* browser.use("The document outlived both refusals", (page) =>
+            kept(appFrame(page, origin)),
+          ),
+        ).toEqual({ ...sessionFirst, answer: "refused" });
+      }),
+    ),
+  );
+});
