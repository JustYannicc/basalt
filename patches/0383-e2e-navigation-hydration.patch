@@ -0,0 +1,64 @@
+import type { Page } from "playwright";
+
+const documentIsInteractive = () => {
+  const root = document.documentElement;
+  if (!root.hasAttribute("data-dashboard")) return true;
+  if (!root.hasAttribute("data-hydrated") || "$_TSR" in window) return false;
+  // Streamed regions respond only after React reveals them and attaches their fibers.
+  // Walking comment nodes avoids traversing every element in large account tables.
+  const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_COMMENT);
+  for (let node = walker.nextNode(); node !== null; node = walker.nextNode()) {
+    if (!(node instanceof Comment)) continue;
+    if (node.data === "$?" || node.data === "$~") return false;
+    if (node.data !== "$") continue;
+    let first = node.nextSibling;
+    while (
+      first !== null &&
+      !(first instanceof Element) &&
+      !(first instanceof Comment && first.data === "/$")
+    )
+      first = first.nextSibling;
+    if (
+      first instanceof Element &&
+      !Object.keys(first).some((key) => key.startsWith("__reactFiber$"))
+    )
+      return false;
+  }
+  return true;
+};
+
+/** Gate navigation promises so a chained action cannot reach inert server-rendered controls. */
+export const guardNavigation = (page: Page) => {
+  let responsive = false;
+  page.on("framenavigated", (frame) => {
+    if (frame === page.mainFrame()) responsive = false;
+  });
+  const interactive = async () => {
+    if (responsive) return;
+    const ready = await page.waitForFunction(documentIsInteractive, undefined, {
+      timeout: 10000,
+      polling: 50,
+    });
+    await ready.dispose();
+    responsive = true;
+  };
+  const completed = async <A>(navigation: Promise<A>, waitUntil: string | undefined) => {
+    const result = await navigation;
+    // Explicit commit navigation is the existing escape hatch for first-paint and early-input proofs.
+    if (waitUntil !== "commit") await interactive();
+    return result;
+  };
+  const goto = page.goto.bind(page);
+  const reload = page.reload.bind(page);
+  const back = page.goBack.bind(page);
+  const forward = page.goForward.bind(page);
+  page.goto = (url, options) => completed(goto(url, options), options?.waitUntil);
+  page.reload = (options) => completed(reload(options), options?.waitUntil);
+  page.goBack = (options) => completed(back(options), options?.waitUntil);
+  page.goForward = (options) => completed(forward(options), options?.waitUntil);
+  return () =>
+    interactive().catch(() => {
+      // Deliberately blocked documents retain the driver's existing best-effort end-of-step wait.
+      responsive = true;
+    });
+};
