+/**
+ * Every usage cell in `scope`, measured: how many, the narrowest, and any whose label, header or
+ * body spills or truncates, or that reaches past its account's usage band. A run that measures
+ * nothing proves nothing, so callers check `measured`.
+ */
+const measureCells = (scope: Locator) =>
+  scope.locator("[data-reading]").evaluateAll((cells) => ({
+    measured: cells.length,
+    narrowest: Math.min(...cells.map((cell) => cell.getBoundingClientRect().width)),
+    clipped: cells.flatMap((cell) => {
+      const header = cell.firstElementChild;
+      const label = cell.querySelector("span[title]");
+      const band = cell.closest("[data-account-observations]")?.getBoundingClientRect();
+      const outside =
+        band !== undefined && cell.getBoundingClientRect().right > band.right + 1
+          ? [`${cell.getAttribute("data-reading")}: past the band`]
+          : [];
+      return [
+        ...outside,
+        ...(
+          [
+            ["cell", cell],
+            ["header", header],
+            ["label", label],
+          ] as const
+        )
+          .filter(([, part]) => part !== null && part.scrollWidth > part.clientWidth + 1)
+          .map(([name]) => `${cell.getAttribute("data-reading")}: ${name}`),
+      ];
+    }),
+  }));
+
+/** How far the page scrolls sideways; zero or less means it fits the viewport. */
+const sideways = (page: Page) =>
+  page.evaluate(() => document.documentElement.scrollWidth - window.innerWidth);
