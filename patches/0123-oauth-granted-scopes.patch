new file mode 100644
index 00000000..16ed9573
--- /dev/null
+++ b/packages/sdk/src/contracts/oauth-scopes.ts
@@ -0,0 +1,31 @@
+/** Token responses use the server's declared format, independently of request formatting. */
+export const normalizeOAuthScopes = (value: string | undefined, separator?: string) =>
+  value === undefined
+    ? undefined
+    : [
+        ...new Set(
+          value
+            .split(/\s+/u)
+            .flatMap((part) => (separator === undefined ? [part] : part.split(separator)))
+            .filter(Boolean),
+        ),
+      ];
+
+/** Reviewed aliases and directed implications describe access already included in a scope. */
+export const oauthScopeClosure = (
+  scopes: readonly string[],
+  implications: Readonly<Record<string, readonly string[]>> = {},
+  aliases: Readonly<Record<string, string>> = {},
+) => {
+  const key = (scope: string) => (Object.hasOwn(aliases, scope) ? aliases[scope]! : scope);
+  const edges = new Map<string, string[]>();
+  for (const [scope, implied] of Object.entries(implications)) {
+    const name = key(scope);
+    edges.set(name, [...(edges.get(name) ?? []), ...implied.map(key)]);
+  }
+  const covered = new Set(scopes.map(key));
+  for (const scope of covered) {
+    for (const implied of edges.get(scope) ?? []) covered.add(implied);
+  }
+  return [...covered];
+};
