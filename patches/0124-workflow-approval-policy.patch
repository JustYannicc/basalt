diff --git a/apps/hosted/server/src/implementation/workflow-app-approvals.ts b/apps/hosted/server/src/implementation/workflow-app-approvals.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/server/src/implementation/workflow-app-approvals.ts
@@ -0,0 +1,81 @@
+import { Effect, Schema } from "effect";
+import type { SqlClient } from "effect/sql";
+import {
+  AppId,
+  StorageError,
+  ToolName,
+  workflowApprovalHooks,
+  type Executor,
+} from "@executor-js/sdk/core";
+
+// Full inspected structured Gmail compose source. Changes require a new envelope review.
+const structuredGmailSource = "895ce27492bff5270ea3a1101c585fe5e5849e07fe78821c2eb1a4ea1338878e";
+const Identity = Schema.Struct({ owner: Schema.NonEmptyString, recipient: Schema.NonEmptyString });
+const Settings = Schema.Struct({
+  revision: Schema.NonEmptyString,
+  deliveryEnabled: Schema.Boolean,
+  current: Schema.Boolean,
+});
+
+/** Hosted identity and source checks are shared by self-host and Cloud. Local has no registered
+ * identity resolver, so it retains ordinary target approval behavior.
+ */
+export const hostedWorkflowApprovals = (
+  executor: Effect.Effect<Executor, StorageError>,
+  sql: SqlClient.SqlClient,
+) =>
+  workflowApprovalHooks({
+    configuration: (event) =>
+      Effect.gen(function* () {
+        const sdk = yield* executor;
+        const source = "source" in event ? event.source : event;
+        const result = yield* sdk.tools.call({
+          app: source.app,
+          version: source.version,
+          tool: ToolName.make("settings"),
+          kind: "query",
+          input: {},
+        });
+        if (
+          result.status !== "completed" ||
+          result.toolError === true ||
+          !Schema.is(Settings)(result.value) ||
+          !result.value.current
+        )
+          return undefined;
+        return { revision: result.value.revision, enabled: result.value.deliveryEnabled };
+      }).pipe(Effect.mapError(() => new StorageError())),
+    personalEmailAccount: (input) =>
+      Effect.gen(function* () {
+        const rows = yield* sql`select a.personal_user_id as owner, u.email as recipient
+        from hosted_account_access a
+        join "user" u on u.id = a.personal_user_id and u."emailVerified" = true
+        join member m on m."userId" = u.id and m."organizationId" = a.organization_id
+        join hosted_app_access s on s.id = ${input.source} and s.organization_id = a.organization_id
+        join hosted_app_access t on t.id = ${input.target} and t.organization_id = a.organization_id
+        where a.account_id = ${input.account} and a.kind = 'personal'`;
+        if (rows.length !== 1) return undefined;
+        const identity = yield* Schema.decodeUnknownEffect(Identity)(rows[0]);
+        const sdk = yield* executor;
+        const source = yield* sdk.apps.source({ app: AppId.make(input.target) });
+        const files: Array<[string, string]> = [];
+        for (const file of source.files) {
+          if (!("content" in file) || "encoding" in file) return undefined;
+          files.push([file.path, file.content]);
+        }
+        files.sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0));
+        const digest = yield* Effect.tryPromise({
+          try: () =>
+            crypto.subtle.digest("SHA-256", new TextEncoder().encode(JSON.stringify(files))),
+          catch: () => new StorageError(),
+        });
+        const hash = Array.from(new Uint8Array(digest), (byte) =>
+          byte.toString(16).padStart(2, "0"),
+        ).join("");
+        return {
+          ...identity,
+          targetVersion: source.id,
+          inspectedCompose: hash === structuredGmailSource,
+        };
+      }).pipe(Effect.mapError(() => new StorageError())),
+  });
