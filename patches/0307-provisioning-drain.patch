+                  return "running" as const;
+                } catch (created) {
+                  // An existing instance explains a failed create; anything else reports the create.
+                  const existing = await binding
+                    .get(instance)
+                    .then((found) => found.status())
+                    .catch(() => {
+                      throw created;
+                    });
+                  if (existing.status === "unknown") throw created;
+                  return existing.status;
+                }
+              },
+              catch: (cause) => cause,
+            });
+            const persisted =
