+            if (job.kind === "team" && persisted === "running") yield* installTeam(job.id);
+          }).pipe(
+            Effect.catch((cause) =>
+              Effect.logWarning("Provisioning dispatch failed", {
+                kind: job.kind,
+                reason: dispatchFailureReason(cause),
+              }),
+            ),
