diff --git a/e2e/tests/hidden-section-reads.spec.ts b/e2e/tests/hidden-section-reads.spec.ts
new file mode 100644
index 0000000..6da608e
--- /dev/null
+++ b/e2e/tests/hidden-section-reads.spec.ts
@@ -0,0 +1,166 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Fiber } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Browser } from "../support/browser.ts";
+import { Evidence } from "../support/evidence.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { openInApp, openThroughBrowser } from "../support/in-app-navigation.ts";
+import { holdQuery, refreshVisiblePage } from "../support/query-transition.ts";
+import { scenarios } from "../test-plan.ts";
+import { batchedReads, batchPath } from "../support/read-batches.ts";
+import type { Request } from "playwright";
+
+layer(HostedLive, { excludeTestServices: true })("Hidden section reads", (it) => {
+  for (const width of [1280, 390]) {
+    const scenario = width === 1280 ? scenarios.hiddenSectionDesktop : scenarios.hiddenSectionPhone;
+    it.effect(scenario.title, (context) =>
+      withHostedCase(
+        context,
+        Effect.gen(function* () {
+          const actors = yield* Actors;
+          const browser = yield* Browser;
+          const evidence = yield* Evidence;
+          const reads: string[] = [];
+          const queueRead = (path: string) =>
+            /^\/api\/organizations\/[^/]+\/(?:workflow-inputs|scheduled-runs)$/.test(path);
+          const workflowRead = (operation: string) => operation === "workflowInputs.list";
+          const queueReads = (request: Request): readonly string[] => {
+            const path = new URL(request.url()).pathname;
+            if (request.method() === "POST" && path === batchPath)
+              return batchedReads(request.postData())
+                .filter(
+                  (read) =>
+                    (read.group === "workflowInputs" && read.endpoint === "list") ||
+                    (read.group === "schedules" && read.endpoint === "runs"),
+                )
+                .map((read) => `${read.group}.${read.endpoint}`);
+            if (request.method() !== "GET" || !queueRead(path)) return [];
+            return [path.endsWith("/workflow-inputs") ? "workflowInputs.list" : "schedules.runs"];
+          };
+          yield* browser.login(actors.owner);
+          yield* browser.use("Observe real queue reads with the browser clock", (page) =>
+            page.clock
+              .install()
+              .then(() =>
+                page.route(
+                  (url) => queueRead(url.pathname),
+                  (route) => route.fallback(),
+                ),
+              )
+              .then(() => {
+                page.on("request", (request) => {
+                  reads.push(...queueReads(request));
+                });
+                return page.setViewportSize({ width, height: 844 });
+              }),
+          );
+          const prefix = `/org/${actors.organization.slug}`;
+          const loadedQueue = (label: string) =>
+            browser.use(label, (page) =>
+              page.getByText("Nothing needs you right now", { exact: true }).waitFor(),
+            );
+          const pollVisibleQueue = (label: string) =>
+            browser.use(label, (page) =>
+              Promise.all([
+                page.waitForRequest((request) => queueReads(request).some(workflowRead)),
+                page.clock.runFor(6_000),
+              ])
+                .then(([request]) => request.response())
+                .then((response) => {
+                  if (response === null) throw new Error("The queue poll received no response");
+                  return response.finished();
+                }),
+            );
+          const settle = (label: string) =>
+            browser.use(label, (page) =>
+              Promise.all([
+                page.evaluate(
+                  () =>
+                    new Promise<void>((resolve) =>
+                      requestAnimationFrame(() => requestAnimationFrame(() => resolve())),
+                    ),
+                ),
+                page.clock.runFor(50),
+              ]).then(() => undefined),
+            );
+
+          yield* openThroughBrowser("Open the queue in a fresh document", `${prefix}/approvals`);
+          yield* loadedQueue("The queue is loaded before testing its poll");
+          const beforeVisiblePoll = reads.length;
+          yield* pollVisibleQueue("A visible queue polls its real workflow endpoint");
+          const visiblePollReads = reads.slice(beforeVisiblePoll);
+          expect(visiblePollReads.some(workflowRead)).toBe(true);
+
+          yield* settle("The visible poll has reached the queue before leaving");
+          // A poll due during the registry's short cache window must also stay quiet after unmount.
+          yield* browser.use("Leave shortly before the next queue poll", (page) =>
+            page
+              .evaluate(() => Date.now() + 100)
+              .then((time) => page.clock.pauseAt(time))
+              .then(() => page.clock.runFor(4_500)),
+          );
+
+          const chunk = yield* holdQuery(/\/assets\/accounts-client-[^/]+\.js$/, "continue", {
+            allRequests: true,
+          });
+          yield* openInApp("Leave the queue for Accounts", `${prefix}/accounts`);
+          yield* browser.use("Commit the destination while the clock is controlled", (page) =>
+            page.clock.runFor(64),
+          );
+          expect(yield* chunk.requested).toMatch(/\/assets\/accounts-client-[^/]+\.js$/);
+          yield* browser.use("The destination loading page has committed", (page) =>
+            page.getByRole("status", { name: "Loading accounts", exact: true }).waitFor(),
+          );
+          yield* settle("Finish the loading commit before checking hidden reads");
+          const beforeHiddenPoll = reads.length;
+          yield* browser.use("Deliver six queue polls while Accounts code stays held", (page) =>
+            page.clock.runFor(31_000),
+          );
+          yield* settle("Flush fetch dispatch after the due poll timers");
+          const hiddenPollReads = reads.slice(beforeHiddenPoll);
+          const beforeHiddenFocus = reads.length;
+          yield* refreshVisiblePage;
+          yield* browser.use("Focus the destination without reviving the departed queue", (page) =>
+            page.evaluate(() => {
+              window.dispatchEvent(new Event("focus"));
+            }),
+          );
+          yield* settle("Flush fetch dispatch after visibility returns");
+          const hiddenFocusReads = reads.slice(beforeHiddenFocus);
+          yield* evidence.json("hidden-queue-reads.json", {
+            width,
+            visiblePollReads,
+            hiddenPollReads,
+            hiddenFocusReads,
+          });
+          yield* browser.checkpoint(`Queue left for held Accounts at ${width}`);
+          expect(hiddenPollReads, "The hidden queue does no periodic reads").toEqual([]);
+          expect(hiddenFocusReads, "The hidden queue does no focus reads").toEqual([]);
+
+          yield* browser.use("Resume real-time frames", (page) => page.clock.resume());
+          yield* chunk.release;
+          yield* browser.use("Accounts finishes loading", (page) =>
+            page
+              .getByRole("status", { name: "Loading accounts", exact: true })
+              .waitFor({ state: "hidden" }),
+          );
+          const returnRead = yield* Effect.forkScoped(
+            browser.use("The visible queue catches up after its hidden focus", (page) =>
+              page
+                .waitForResponse((response) => queueReads(response.request()).some(workflowRead))
+                .then((response) => response.finished()),
+            ),
+          );
+          yield* openInApp("Return to the queue", `${prefix}/approvals`);
+          yield* loadedQueue("The retained queue is usable on return");
+          yield* Fiber.join(returnRead);
+          yield* settle("The return refresh settles before measuring the next poll");
+          const beforeReturnPoll = reads.length;
+          yield* pollVisibleQueue("Polling resumes on the visible queue");
+          expect(reads.slice(beforeReturnPoll).some(workflowRead)).toBe(true);
+          yield* browser.checkpoint(`Queue polling resumed at ${width}`);
+        }),
+      ),
+    );
+  }
+});
