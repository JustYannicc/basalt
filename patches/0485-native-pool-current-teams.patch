+const teamLimit = 200;
+// The pool Worker refuses control bodies over 64k characters; the base64 envelope must fit with room.
+const teamBytes = 24_000;
+const Members = Schema.Array(Schema.Struct({ organizationId: Schema.NonEmptyString }));
+const Teams = Schema.Array(Schema.Struct({ id: Schema.NonEmptyString, name: Schema.String }));
+/**
+ * The person's current teams, so the pool Worker can drop pools from teams they left or deleted.
+ * Undefined when they can't be read in full or won't fit the check: the Worker then filters
+ * nothing, which is safe because it still authorizes every pool.
+ */
+const currentTeams = (ctx: GenericEndpointContext, userId: string) =>
+  Effect.gen(function* () {
+    const members = yield* authCall(() =>
+      ctx.context.adapter.findMany({
+        model: "member",
+        where: [{ field: "userId", value: userId }],
+        select: ["organizationId"],
+        limit: teamLimit,
+      }),
+    ).pipe(Effect.flatMap(Schema.decodeUnknownEffect(Members)));
+    if (members.length >= teamLimit) return undefined;
+    if (members.length === 0) return [];
+    const rows = yield* authCall(() =>
+      ctx.context.adapter.findMany({
+        model: "organization",
+        where: [{ field: "id", operator: "in", value: members.map((row) => row.organizationId) }],
+        select: ["id", "name"],
+        limit: teamLimit,
+      }),
+    );
+    const teams = (yield* Schema.decodeUnknownEffect(Teams)(rows)).map(({ id, name }) => ({
+      id,
+      name: name.slice(0, 200),
+    }));
+    return JSON.stringify(teams).length > teamBytes ? undefined : teams;
+  }).pipe(Effect.catch(() => Effect.succeed(undefined)));
