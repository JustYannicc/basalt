diff --git a/apps/hosted/server/src/contracts/pool-usage-forecast.ts b/apps/hosted/server/src/contracts/pool-usage-forecast.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/server/src/contracts/pool-usage-forecast.ts
@@ -0,0 +1,62 @@
+import { Schema } from "effect";
+
+const number = Schema.Finite.check(Schema.isGreaterThanOrEqualTo(0));
+const amount = Schema.NullOr(number);
+const count = Schema.Int.check(Schema.isGreaterThanOrEqualTo(0));
+const projection = Schema.Struct({
+  from: Schema.String,
+  through: Schema.String,
+  actual: amount,
+  median: amount,
+  low: amount,
+  high: amount,
+});
+const forecast = Schema.Union([
+  Schema.Struct({
+    status: Schema.Literal("unavailable"),
+    reason: Schema.Literals(["invalid-input", "insufficient-history", "insufficient-use"]),
+    comparableWeeks: count,
+    calculatedAt: Schema.String,
+  }),
+  Schema.Struct({
+    status: Schema.Literal("available"),
+    calculatedAt: Schema.String,
+    timezone: Schema.Literal("Europe/Zurich"),
+    method: Schema.Literal("Median of the last 4 full weeks, shaped by day of week"),
+    confidence: Schema.Literals(["Low", "Medium", "High"]),
+    interval: Schema.Literal(0.8),
+    comparableWeeks: count,
+    trainingWeeks: Schema.Array(Schema.String).check(Schema.isMaxLength(4)),
+    misses: Schema.Array(
+      Schema.Struct({
+        week: Schema.String,
+        predicted: number,
+        actual: number,
+        error: Schema.Finite,
+        share: amount,
+      }),
+    ).check(Schema.isMaxLength(8)),
+    thisWeek: projection,
+    nextWeek: projection,
+    month: projection,
+    daily: Schema.Array(
+      Schema.Struct({ day: Schema.String, median: number, low: amount, high: amount }),
+    ).check(Schema.isMaxLength(45)),
+  }),
+]);
+
+export const PoolUsageForecasts = Schema.Struct({
+  calculatedAt: Schema.String,
+  timezone: Schema.Literal("Europe/Zurich"),
+  basis: Schema.Literal("recorded-usage"),
+  warnings: Schema.Array(Schema.String),
+  series: Schema.Array(
+    Schema.Struct({
+      provider: Schema.NullOr(Schema.String),
+      requests: forecast,
+      tokens: forecast,
+      apiEstimate: forecast,
+      excluded: Schema.Struct({ tokens: count, apiEstimate: count }),
+    }),
+  ),
+});
