+import { Duration, Effect, Schedule } from "effect";
+
+export interface ProvisioningDiagnostic {
+  readonly category?: string | undefined;
+  readonly status?: number | undefined;
+  readonly retryAfterMs?: number | undefined;
+}
+
+/** Only repeatable provisioning and cleanup may opt in. Scenario requests must see outages. */
+export const provisioningRequest = <A, E extends ProvisioningDiagnostic, R>(
+  attempt: (attempts: number) => Effect.Effect<A, E, R>,
+  timedOut: (attempts: number, last: E | undefined) => E,
+) =>
+  Effect.suspend(() => {
+    let attempts = 0;
+    let last: E | undefined;
+    const schedule = Schedule.exponential("250 millis").pipe(
+      Schedule.jittered,
+      Schedule.modifyDelay(({ duration }) =>
+        Effect.succeed(Math.max(Duration.toMillis(duration), last?.retryAfterMs ?? 0)),
+      ),
+    );
+    return Effect.suspend(() => attempt(++attempts)).pipe(
+      Effect.tapError((error) =>
+        Effect.sync(() => {
+          last = error;
+        }),
+      ),
+      Effect.retry({
+        times: 3,
+        schedule,
+        while: (error) =>
+          error.category === "transport" ||
+          (error.category === "http" && [500, 502, 503, 504].includes(error.status ?? 0)),
+      }),
+      // One deadline covers requests, body reads and every backoff, not one per attempt.
+      Effect.timeoutOrElse({
+        duration: "30 seconds",
+        orElse: () => Effect.fail(timedOut(attempts, last)),
+      }),
+    );
+  });
+
+/** Accept delta-seconds or an HTTP date, capped at five seconds within the operation budget. */
+export const provisioningRetryAfter = (value: string | undefined, now: number) => {
+  if (value === undefined) return undefined;
+  const delay = /^\d+(?:\.\d+)?$/u.test(value)
+    ? Number(value) * 1000
+    : /^(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun), /u.test(value)
+      ? Date.parse(value) - now
+      : NaN;
+  return Number.isFinite(delay) ? Math.min(5000, Math.max(0, delay)) : undefined;
+};
