index 0000000..74da701
--- /dev/null
+++ b/e2e/tests/emulator-provisioning.spec.ts
@@ -0,0 +1,262 @@
+import { expect, layer } from "@effect/vitest";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { Cause, Clock, Deferred, Effect, Fiber, Schema, Tracer, Exit } from "effect";
+import { FetchHttpClient, HttpClient } from "effect/http";
+import { TestClock } from "effect/testing";
+import { createServer } from "node:http";
+import type { AddressInfo } from "node:net";
+import { emulatorRequest, provisionEmulatorRequest } from "../support/emulators.ts";
+
+const secret = "SYNTHETIC_PRIVATE_TOKEN";
+const ray = "0123456789abcdef-AAA";
+const reply = Schema.Struct({ ready: Schema.Boolean });
+
+const server = (
+  answer: (attempt: number) => number | "disconnect" | "invalid" | "schema",
+  retryAfter?: string,
+) =>
+  Effect.acquireRelease(
+    Effect.callback<{ origin: string; calls: () => number; bodies: string[]; close: () => void }>(
+      (resume) => {
+        let calls = 0;
+        const bodies: string[] = [];
+        const http = createServer((request, response) => {
+          const result = answer(++calls);
+          let body = "";
+          request.on("data", (chunk) => {
+            body += String(chunk);
+          });
+          request.on("end", () => {
+            bodies.push(body);
+            if (result === "disconnect") {
+              request.socket.destroy();
+              return;
+            }
+            response
+              .writeHead(typeof result === "number" ? result : 200, {
+                "content-type": "application/json",
+                "cf-ray": ray,
+                ...(retryAfter === undefined ? {} : { "retry-after": retryAfter }),
+              })
+              .end(
+                result === "invalid"
+                  ? secret
+                  : result === "schema"
+                    ? JSON.stringify({ secret })
+                    : JSON.stringify({ ready: true, secret }),
+              );
+          });
+        });
+        http.listen(0, () => {
+          const { port } = http.address() as AddressInfo;
+          resume(
+            Effect.succeed({
+              origin: `http://127.0.0.1:${port}`,
+              calls: () => calls,
+              bodies,
+              close: () => {
+                http.closeAllConnections();
+                http.close();
+              },
+            }),
+          );
+        });
+        return Effect.sync(() => {
+          http.closeAllConnections();
+          http.close();
+        });
+      },
+    ),
+    ({ close }) => Effect.sync(close),
+  );
+
+layer(NodeServices.layer, { excludeTestServices: true })("Emulator provisioning", (it) => {
+  it.effect("transient setup HTTP errors recover within the operation budget", () =>
+    Effect.gen(function* () {
+      for (const status of [500, 502, 503, 504]) {
+        const stub = yield* server((attempt) => (attempt === 1 ? status : 200));
+        const started = yield* Clock.currentTimeMillis;
+        const result = yield* provisionEmulatorRequest(
+          stub.origin,
+          "/_emulate/instances",
+          { instance: "synthetic" },
+          reply,
