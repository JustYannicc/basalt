diff --git a/e2e/tests/emulator-fixture-provisioning.spec.ts b/e2e/tests/emulator-fixture-provisioning.spec.ts
new file mode 100644
index 0000000..48fdf3e
--- /dev/null
+++ b/e2e/tests/emulator-fixture-provisioning.spec.ts
@@ -0,0 +1,116 @@
+import { expect, layer } from "@effect/vitest";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { Effect, Redacted, Schema } from "effect";
+import { FetchHttpClient, HttpClient, HttpClientRequest } from "effect/http";
+import { createServer } from "node:http";
+import type { AddressInfo } from "node:net";
+import { createEmulatorFixture } from "../support/emulators.ts";
+
+/** The real fixture client talks HTTP to this control-plane stand-in instead of the hosted service. */
+const controlPlane = (failOauth: boolean) =>
+  Effect.acquireRelease(
+    Effect.callback<{
+      origin: string;
+      workosTokens: unknown[];
+      counts: Map<string, number>;
+      close: () => void;
+    }>((resume) => {
+      const workosTokens: unknown[] = [];
+      const counts = new Map<string, number>();
+      const server = createServer((request, response) => {
+        const original = String(request.headers["x-fixture-origin"]);
+        const service = new URL(original).hostname.split(".")[0];
+        const key = `${service} ${request.url}`;
+        const count = (counts.get(key) ?? 0) + 1;
+        counts.set(key, count);
+        let text = "";
+        request.on("data", (chunk) => {
+          text += String(chunk);
+        });
+        request.on("end", () => {
+          const body = Schema.decodeUnknownSync(
+            Schema.fromJsonString(
+              Schema.Struct({
+                type: Schema.optional(Schema.String),
+                token: Schema.optional(Schema.String),
+              }),
+            ),
+          )(text || "{}");
+          const send = (status: number, body: unknown) =>
+            response
+              .writeHead(status, { "content-type": "application/json" })
+              .end(JSON.stringify(body));
+          if (request.url === "/_emulate/instances") {
+            send(service === "github" && count === 1 ? 500 : 200, { providerBaseUrl: original });
+          } else if (request.url === "/.well-known/openid-configuration") {
+            send(200, {
+              issuer: original,
+              authorization_endpoint: `${original}/authorize`,
+              token_endpoint: `${original}/token`,
+              userinfo_endpoint: `${original}/userinfo`,
+              jwks_uri: `${original}/keys`,
+              id_token_signing_alg_values_supported: ["RS256"],
+            });
+          } else if (body.type === "oauth-authorization-code") {
+            send(failOauth ? 503 : 200, {
+              credential: { client_id: "synthetic-client", client_secret: "synthetic-secret" },
+            });
+          } else {
+            if (service === "workos") workosTokens.push(body.token);
+            send(service === "workos" && count === 1 ? 503 : 200, {
+              credential: { token: body.token },
+            });
+          }
+        });
+      });
+      const close = () => {
+        server.closeAllConnections();
+        server.close();
+      };
+      server.listen(0, () => {
+        const { port } = server.address() as AddressInfo;
+        resume(Effect.succeed({ origin: `http://127.0.0.1:${port}`, workosTokens, counts, close }));
+      });
+      return Effect.sync(close);
+    }),
+    ({ close }) => Effect.sync(close),
+  );
+
+const routed = (http: HttpClient.HttpClient, origin: string) =>
+  HttpClient.mapRequest(http, (request) => {
+    const url = new URL(request.url);
+    return request.pipe(
+      HttpClientRequest.setUrl(`${origin}${url.pathname}`),
+      HttpClientRequest.setHeader("x-fixture-origin", url.origin),
+    );
+  });
+
+layer(NodeServices.layer, { excludeTestServices: true })("Emulator fixture provisioning", (it) => {
+  it.effect("fixture setup recovers instances and reuses its generated WorkOS credential", () =>
+    Effect.gen(function* () {
+      const stub = yield* controlPlane(false);
+      const http = yield* HttpClient.HttpClient;
+      const fixture = yield* createEmulatorFixture(stub.origin).pipe(
+        Effect.provideService(HttpClient.HttpClient, routed(http, stub.origin)),
+      );
+      const workos = Redacted.value(fixture).services.workos;
+      expect(stub.counts.get("github /_emulate/instances")).toBe(2);
+      expect(stub.counts.get("github /_emulate/credentials")).toBe(1);
+      expect(stub.workosTokens).toEqual([workos.token, workos.token]);
+      expect(workos.token.length).toBeGreaterThan(0);
+    }).pipe(Effect.provide(FetchHttpClient.layer)),
+  );
+
+  it.effect("OAuth client creation remains outside setup retries", () =>
+    Effect.gen(function* () {
+      const stub = yield* controlPlane(true);
+      const http = yield* HttpClient.HttpClient;
+      const error = yield* createEmulatorFixture(stub.origin).pipe(
+        Effect.provideService(HttpClient.HttpClient, routed(http, stub.origin)),
+        Effect.flip,
+      );
+      expect(error.status).toBe(503);
+      expect(stub.counts.get("google /_emulate/credentials")).toBe(1);
+    }).pipe(Effect.provide(FetchHttpClient.layer)),
+  );
+});
