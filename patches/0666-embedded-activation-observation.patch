new file mode 100644
--- /dev/null
+++ b/e2e/support/app-activation-observer.ts
@@ -0,0 +1,72 @@
+import { errors, type Page, type Response, type Route } from "playwright";
+import { Option, Schema } from "effect";
+
+const AppVersion = Schema.Struct({
+  activeVersion: Schema.NullOr(Schema.String),
+});
+
+/** Split this app's read from streamed siblings so its exact version has a finite body. */
+export const observeAppActivation = (page: Page, appRead: (url: URL) => boolean) => {
+  const versions = new Set<string>();
+  let expected: string | undefined;
+  let confirm: (() => void) | undefined;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  let disposed = false;
+  const check = () => {
+    if (expected !== undefined && versions.has(expected)) confirm?.();
+  };
+  const body = (response: Response) => {
+    if (
+      !appRead(new URL(response.url())) ||
+      !response.ok() ||
+      response.request().method() !== "GET"
+    )
+      return;
+    void response.json().then(
+      (value: unknown) => {
+        if (disposed) return;
+        const decoded = Schema.decodeUnknownOption(AppVersion)(value);
+        if (Option.isSome(decoded) && decoded.value.activeVersion !== null)
+          versions.add(decoded.value.activeVersion);
+        check();
+      },
+      () => {},
+    );
+  };
+  const direct = (route: Route) => route.continue();
+  const dispose = () => {
+    if (disposed) return Promise.resolve();
+    disposed = true;
+    clearTimeout(timer);
+    page.off("response", body);
+    versions.clear();
+    return page.unroute(appRead, direct);
+  };
+  // splitRoutedReads sends this operation through its own URL without holding its siblings.
+  return page.route(appRead, direct).then(() => {
+    page.on("response", body);
+    return {
+      dispose,
+      waitForVersion: (version: string) => {
+        expected = version;
+        const ready = new Promise<void>((resolve, reject) => {
+          confirm = resolve;
+          // Match Browser's existing operation deadline.
+          timer = setTimeout(
+            () => reject(new errors.TimeoutError("Dashboard activation was not observed")),
+            15_000,
+          );
+          check();
+        });
+        return Promise.all([
+          ready,
+          page.evaluate(() =>
+            document.dispatchEvent(new Event("visibilitychange", { bubbles: true })),
+          ),
+        ])
+          .then(() => undefined)
+          .finally(dispose);
+      },
+    };
+  });
+};
