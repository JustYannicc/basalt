+/** How far the pointer must travel from the press that opened a menu before a release counts. */
+const releaseTravel = 10;
+
+/**
+ * Radix chooses an item that a pointer is released over without having pressed it, so pressing the
+ * button, dragging and releasing works. While the menu opens, though, its first item can slide
+ * under a pointer that has not moved, and the same press would choose it: through Radix on release,
+ * or through the click a touch sends to what lies under it. So a pointer's release or click chooses
+ * an item only if the item itself was pressed or the pointer left the opening press, as Radix's
+ * Select does. Keyboard clicks carry no click count, and a menu no pointer opened records no press.
+ */
+function useReleaseAfterTravel<E extends Element>({
+  onPointerDown,
+  onPointerUp,
+  onClickCapture,
+}: Pick<React.DOMAttributes<E>, "onPointerDown" | "onPointerUp" | "onClickCapture">) {
+  const opening = React.useContext(OpeningPress);
+  const pressedHere = React.useRef(false);
+  const atOpeningPress = (event: React.MouseEvent<E>) => {
+    const start = opening?.at();
+    return (
+      !pressedHere.current &&
+      start != null &&
+      Math.hypot(event.clientX - start.x, event.clientY - start.y) <= releaseTravel
+    );
+  };
+  return {
+    onPointerDown: (event: React.PointerEvent<E>) => {
+      pressedHere.current = true;
+      onPointerDown?.(event);
+    },
+    onPointerUp: (event: React.PointerEvent<E>) => {
+      onPointerUp?.(event);
+      if (atOpeningPress(event)) event.preventDefault();
+    },
+    // Captured, so an item rendered as a link sees the refusal before its own click handler.
+    onClickCapture: (event: React.MouseEvent<E>) => {
+      onClickCapture?.(event);
+      if (event.detail !== 0 && atOpeningPress(event)) event.preventDefault();
+    },
+  };
+}
