diff --git a/e2e/support/tool-sections-catalog.ts b/e2e/support/tool-sections-catalog.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/tool-sections-catalog.ts
@@ -0,0 +1,110 @@
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Effect, Layer } from "effect";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { createServer } from "node:http";
+import { appsVersion, mcpSdkVersion } from "./apps-release.ts";
+
+/** An ordinary catalog app whose two tool sections need different account methods. */
+export const toolSectionsCatalog = (issuer: string) =>
+  Effect.gen(function* () {
+    const entry = {
+      id: "tool-sections",
+      package: "@executor.sh/tool-sections",
+      name: "Sections fixture",
+      description: "Two tool sections with one reusable provider.",
+      auth: [
+        { method: "oauth", kind: "oauth2" },
+        { method: "token", kind: "secrets", label: "Personal token" },
+      ],
+      icons: [],
+      source: "apps/tool-sections.json",
+      toolSections: [
+        {
+          path: "api",
+          title: "Service API",
+          requirement: "service",
+          method: "token",
+          description:
+            "Your sign-in provides MCP tools. Add a personal token to use the REST API too.",
+          actionLabel: "Add token",
+        },
+        {
+          path: "missing",
+          title: "Stale section",
+          requirement: "removed",
+          method: "token",
+          description: "This requirement is not in the installed app.",
+          actionLabel: "Connect removed requirement",
+        },
+      ],
+    };
+    const source = (failedUrl?: string) => ({
+      package: entry.package,
+      files: [
+        {
+          path: "index.ts",
+          content: `import { defineApp, defineProvider, oauth2, object, query, router, secrets, string } from "apps";
+import { mcpRouter } from "apps/mcp";
+const service = defineProvider({ name: "Sections fixture", auth: {
+  oauth: oauth2({ authorizationUrl: ${JSON.stringify(issuer + "/authorize")}, tokenUrl: ${JSON.stringify(issuer + "/token")}, scopes: ["read"] }),
+  token: secrets({ label: "Personal token", fields: object({ token: string({ minLength: 1 }) }) })
+} });
+export default defineApp({ user: { accounts: { service: service.many() } } }, async ({ user, cache, signal }) => {
+  const accounts = user?.accounts.service ?? [];
+  const token = accounts.some(account => account.method === "token");
+  return { tools: router({
+    mcp: router(accounts.length ? { read: query({ input: object({}), description: "Read through MCP" }, async () => "MCP read") } : {}, { title: "Service MCP" }),
+    api: router(${
+      failedUrl === undefined
+        ? 'token ? { read: query({ input: object({}), description: "Read through REST" }, async () => "REST read") } : {}'
+        : `{ v1: await mcpRouter({ url: ${JSON.stringify(failedUrl)}, cache, signal }) }`
+    }, { title: "Service API" })
+  }) };
+});`,
+        },
+        {
+          path: "package.json",
+          content: JSON.stringify({
+            name: entry.package,
+            private: true,
+            type: "module",
+            dependencies: { apps: appsVersion, "@modelcontextprotocol/sdk": mcpSdkVersion },
+          }),
+        },
+      ],
+    });
+    const listener = createServer();
+    const services = yield* Layer.build(
+      HttpRouter.serve(
+        Layer.mergeAll(
+          HttpRouter.add("*", "/outage", HttpServerResponse.empty({ status: 503 })),
+          HttpRouter.add(
+            "GET",
+            "/*",
+            Effect.gen(function* () {
+              const request = yield* HttpServerRequest.HttpServerRequest;
+              const path = new URL(request.url, "http://catalog").pathname;
+              if (path === "/index.json")
+                return HttpServerResponse.jsonUnsafe({ version: 1, apps: [entry] });
+              if (path === "/apps/tool-sections.json")
+                return HttpServerResponse.jsonUnsafe(source());
+              return HttpServerResponse.empty({ status: 404 });
+            }),
+          ),
+        ),
+        { disableLogger: true, disableListenLog: true },
+      ).pipe(
+        Layer.provideMerge(NodeHttpServer.layer(() => listener, { host: "127.0.0.1", port: 0 })),
+      ),
+    );
+    yield* Effect.addFinalizer(() => Effect.sync(() => listener.closeAllConnections()));
+    const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+    if (!("port" in server.address)) return yield* Effect.die("Catalog needs a TCP listener");
+    const origin = `http://127.0.0.1:${server.address.port}`;
+    return {
+      url: `${origin}/index.json`,
+      entry,
+      files: source().files,
+      failedDescendantFiles: source(`${origin}/outage`).files,
+    };
+  });
