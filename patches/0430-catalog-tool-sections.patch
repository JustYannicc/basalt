@@ -0,0 +1,123 @@
+import { useRef, useState } from "react";
+import { AsyncResult } from "effect/reactivity";
+import { Option } from "effect";
+import type { App } from "@executor-js/sdk";
+import type { CatalogEntry, CatalogToolSection } from "@executor-js/catalog/contracts";
+import type { RequirementAccounts } from "@executor-js/ui/contracts/app-accounts";
+import type { AccountSummary } from "@executor-js/ui/contracts/dashboard";
+import { missingToolSections } from "@executor-js/ui/contracts/tool-sections";
+import { MissingToolSections } from "@executor-js/ui/dashboard/missing-tool-sections";
+import { useQuery } from "@executor-js/ui/dashboard/context";
+import { Button } from "@executor-js/ui/components/button";
+import { catalogAtom } from "../../contracts/api.ts";
+import { appMethodsAtom } from "../../contracts/app-accounts.ts";
+import { toolCatalogAtom } from "../../contracts/apps.ts";
+import { useOrganizationRoute } from "../components/organization.tsx";
+import { AppConnectionDialogContent } from "./app-accounts.tsx";
+import { ConnectionModal } from "./connection-dialog.tsx";
+
+type Props = {
+  readonly app: App;
+  readonly requirements: readonly RequirementAccounts<AccountSummary>[];
+  readonly redirectUri: string;
+};
+
+/** Catalog hints bind to the installed package; the live declaration and host policy authorize the action. */
+export function AppToolSections(props: Props) {
+  const catalog = useQuery(catalogAtom);
+  const entry = Option.getOrUndefined(catalog.data)?.find(
+    (entry) => entry.package === props.app.copiedFrom?.name,
+  );
+  return entry?.toolSections?.length ? <Sections {...props} entry={entry} /> : null;
+}
+
+function Sections({
+  app,
+  requirements,
+  redirectUri,
+  entry,
+}: Props & { readonly entry: CatalogEntry }) {
+  const { organization } = useOrganizationRoute();
+  const methods = useQuery(appMethodsAtom({ organization, app: app.id }));
+  const tools = useQuery(
+    toolCatalogAtom({ organization, app: app.id, version: app.activeVersion ?? undefined }),
+  );
+  const [connection, setConnection] = useState<CatalogToolSection>();
+  const [busy, setBusy] = useState(false);
+  const trigger = useRef<HTMLButtonElement | null>(null);
+  const missing = Option.isSome(tools.data)
+    ? missingToolSections(entry.toolSections ?? [], requirements, tools.data.value)
+    : [];
+  const selectedRequirement =
+    connection === undefined
+      ? undefined
+      : requirements.find(
+          ({ slot, requirement }) =>
+            slot === connection.requirement &&
+            Object.hasOwn(requirement.definition.auth, connection.method),
+        )?.requirement;
+  const selected =
+    connection !== undefined && selectedRequirement !== undefined
+      ? { section: connection, requirement: selectedRequirement }
+      : undefined;
+  const policy =
+    AsyncResult.isSuccess(methods.result) && !methods.result.waiting
+      ? methods.result.value
+      : undefined;
+  const unavailable = (section: CatalogToolSection) => {
+    if (policy === undefined) return "Checking available connection methods.";
+    const connection = policy.connections.find(
+      (entry) => entry.requirement === section.requirement,
+    );
+    if (connection?.canConnect !== true) return "This account must be connected from Accounts.";
+    return policy.unavailable.find(
+      (entry) => entry.requirement === section.requirement && entry.method === section.method,
+    )?.reason;
+  };
+  return (
+    <>
+      <MissingToolSections
+        sections={missing.map(({ section }) => section)}
+        renderAction={(section) => (
+          <Button
+            type="button"
+            disabled={busy || unavailable(section) !== undefined}
+            title={unavailable(section)}
+            onClick={(event) => {
+              trigger.current = event.currentTarget;
+              setConnection(section);
+            }}
+          >
+            {section.actionLabel}
+          </Button>
+        )}
+      />
+      <ConnectionModal
+        open={selected !== undefined}
+        busy={busy}
+        onClose={() => setConnection(undefined)}
+        onCloseAutoFocus={(event) => {
+          event.preventDefault();
+          trigger.current?.focus();
+        }}
+      >
+        {selected && (
+          <AppConnectionDialogContent
+            key={`${selected.section.requirement}:${selected.section.method}`}
+            app={app}
+            scope={selected.requirement.scope}
+            slot={selected.section.requirement}
+            requirement={selected.requirement}
+            method={selected.section.method}
+            redirectUri={redirectUri}
+            oauthDeferrals={entry.oauthDeferrals}
+            connectionGuidance={entry.connectionGuidance}
+            unavailable={(method) => unavailable({ ...selected.section, method })}
+            onPendingChange={setBusy}
+            onSaved={() => setConnection(undefined)}
+          />
+        )}
+      </ConnectionModal>
+    </>
+  );
+}
