+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { FetchHttpClient, HttpClient } from "effect/http";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { connectionsPath } from "../support/app-accounts.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { nameConnectedAccount } from "../support/name-account.ts";
+import { oauthSetupIssuer } from "../support/oauth-setup-issuer.ts";
+import { serverControl } from "../support/server-control.ts";
+import { toolSectionsCatalog } from "../support/tool-sections-catalog.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Redirect = Schema.Struct({ authorizationUrl: Schema.String, redirectUri: Schema.String });
+const Tools = Schema.Struct({
+  items: Schema.Array(Schema.Struct({ name: Schema.String })),
+  routers: Schema.Array(
+    Schema.Struct({
+      path: Schema.String,
+      error: Schema.optional(
+        Schema.Struct({ _tag: Schema.String, status: Schema.optional(Schema.Number) }),
+      ),
+    }),
+  ),
+});
+
+layer(HostedLive, { excludeTestServices: true })("Missing tool sections", (it) => {
+  for (const [scenario, width] of [
+    [scenarios.catalogToolSectionsDesktop, 1280],
+    [scenarios.catalogToolSectionsPhone, 390],
+  ] as const)
+    it.effect(scenario.title, (context) =>
+      withHostedCase(
+        context,
+        Effect.gen(function* () {
+          const api = yield* Api,
+            actors = yield* Actors,
+            browser = yield* Browser,
+            http = yield* HttpClient.HttpClient,
+            issuer = yield* oauthSetupIssuer;
+          const catalog = yield* toolSectionsCatalog(issuer.origin);
+          yield* serverControl("stop");
+          yield* serverControl("environment", 200, { EXECUTOR_CATALOG_URL: catalog.url });
+          yield* serverControl("start");
+          const prefix = `/api/organizations/${actors.organization.id}`;
+          const installed = yield* api.request(actors.owner, "POST", `${prefix}/apps/install`, {
+            entry: catalog.entry.id,
+            name: `Sections ${width}`,
+          });
+          expect(installed.status, JSON.stringify(installed.body)).toBe(200);
+          const app = yield* body(Resource, installed),
+            path = `${prefix}/apps/${app.id}`;
+          const accounts: string[] = [];
+          yield* Effect.addFinalizer(() =>
+            Effect.gen(function* () {
+              expect((yield* api.request(actors.owner, "DELETE", path)).status).toBe(200);
+              for (const account of accounts)
+                expect(
+                  (yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`))
+                    .status,
+                ).toBe(200);
+            }).pipe(Effect.orDie),
+          );
+          const connection = yield* body(
+            Resource,
+            yield* api.request(actors.owner, "POST", connectionsPath(path, "user", "service"), {}),
+          );
+          const client = { clientId: "sections-client", clientSecret: "sections-secret" };
+          const started = yield* api.request(
+            actors.owner,
+            "POST",
+            `${prefix}/connections/${connection.id}/oauth/start`,
+            { method: "oauth", client },
+          );
+          expect(started.status, JSON.stringify(started.body)).toBe(200);
+          const redirect = yield* body(Redirect, started);
+          yield* issuer.allowClient({ ...client, redirect: redirect.redirectUri });
+          const callbackUrl = yield* Effect.scoped(
+            Effect.gen(function* () {
+              const consent = yield* HttpClient.withScope(http).get(redirect.authorizationUrl);
+              expect(consent.status).toBe(302);
+              if (consent.headers.location === undefined)
+                return yield* Effect.die("Missing callback");
+              return consent.headers.location;
+            }),
+          ).pipe(Effect.provideService(FetchHttpClient.RequestInit, { redirect: "manual" }));
+          const completed = yield* api.request(
+            actors.owner,
+            "POST",
+            `${prefix}/connections/${connection.id}/oauth/complete`,
+            { callbackUrl },
+          );
+          expect(completed.status, JSON.stringify(completed.body)).toBe(200);
+          accounts.push((yield* body(Resource, completed)).id);
+          const before = yield* body(
+            Tools,
+            yield* api.request(actors.owner, "GET", `${path}/tools/index`),
+          );
+          expect(before.items.map((tool) => tool.name)).toEqual(["mcp.read"]);
+          yield* browser.login(actors.owner);
+          yield* browser.use("Open OAuth-only tools", (page) =>
+            page
+              .setViewportSize({ width, height: 900 })
+              .then(() => page.goto(`/org/${actors.organization.slug}/apps/${app.id}?view=tools`))
+              .then(() => page.getByRole("heading", { name: "Read", exact: true }).waitFor()),
+          );
+          yield* browser.use("Wait for the missing-section action to be ready", (page) =>
+            page.getByRole("button", { name: "Add token", exact: true }).click({ trial: true }),
+          );
+          yield* browser.checkpoint(`OAuth-only tool sections ${width}`);
+          expect(
+            yield* browser.use("Missing API section remains visible", (page) =>
+              page.getByRole("region", { name: "Service API", exact: true }).count(),
+            ),
