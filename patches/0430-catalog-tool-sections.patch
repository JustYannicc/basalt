@@ -0,0 +1,32 @@
+import type { ReactNode } from "react";
+import type { CatalogToolSection } from "@executor-js/catalog/contracts";
+
+/** Keep missing capabilities visible above the tool list, including when a phone hides the list. */
+export function MissingToolSections({
+  sections,
+  renderAction,
+}: {
+  readonly sections: readonly CatalogToolSection[];
+  readonly renderAction: (section: CatalogToolSection) => ReactNode;
+}) {
+  if (sections.length === 0) return null;
+  return (
+    <div className="grid shrink-0 gap-3 border-b p-5 max-[740px]:p-4">
+      {sections.map((section) => (
+        <section
+          key={section.path}
+          aria-label={section.title}
+          className="flex items-center gap-5 rounded-lg border px-5 py-4 max-[740px]:flex-col max-[740px]:items-stretch max-[740px]:gap-3 max-[740px]:px-4"
+        >
+          <div className="min-w-0 flex-1">
+            <h3 className="text-sm font-medium">{section.title}</h3>
+            <p className="mt-1 max-w-prose text-sm leading-relaxed text-muted-foreground">
+              {section.description}
+            </p>
+          </div>
+          {renderAction(section)}
+        </section>
+      ))}
+    </div>
+  );
+}
