@@ -0,0 +1,38 @@
+import type { CatalogToolSection } from "@executor-js/catalog/contracts";
+import type { RequirementAccounts } from "./app-accounts.ts";
+import type { AccountSummary, ToolCatalog } from "./dashboard.ts";
+
+/** Only a known missing method explains an empty section; search results and failures do not. */
+export const missingToolSections = (
+  sections: readonly CatalogToolSection[],
+  requirements: readonly RequirementAccounts<AccountSummary>[],
+  catalog: ToolCatalog,
+) => {
+  const seen = new Set<string>();
+  return sections.flatMap((section) => {
+    if (seen.has(section.path)) return [];
+    seen.add(section.path);
+    const entry = requirements.find((entry) => entry.slot === section.requirement);
+    if (entry === undefined || !entry.known) return [];
+    const method = entry.requirement.definition.auth[section.method];
+    if (
+      method === undefined ||
+      (method.type === "secrets" && method.provisioned === true) ||
+      entry.using.some((account) => account.method === section.method)
+    )
+      return [];
+    const router = catalog.routers.find((router) => router.path === section.path);
+    const prefix = `${section.path}.`;
+    if (
+      router === undefined ||
+      catalog.routers.some(
+        (router) =>
+          router.error !== undefined &&
+          (router.path === section.path || router.path.startsWith(prefix)),
+      ) ||
+      catalog.tools.some((tool) => tool.name.startsWith(prefix))
+    )
+      return [];
+    return [{ section, requirement: entry.requirement }];
+  });
+};
