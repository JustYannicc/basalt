diff --git a/apps/hosted/server/src/implementation/pool-membership-rows.ts b/apps/hosted/server/src/implementation/pool-membership-rows.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-membership-rows.ts
@@ -0,0 +1,53 @@
+import type { AppId } from "@executor-js/sdk/core";
+import { Effect } from "effect";
+import type { SqlClient } from "effect/sql";
+import { usableProjectedAppLinks } from "./app-link-policy.ts";
+
+/** Called after account and binding locks, so declaration and policy changes share a fresh snapshot. */
+export const readNativePoolAccountRows = (
+  sql: SqlClient.SqlClient,
+  organization: string,
+  pool: AppId,
+) =>
+  Effect.gen(function* () {
+    const usable = yield* usableProjectedAppLinks(sql, [pool]);
+    return yield* sql`with active_declarations as materialized (
+      select app.id as app,d.requirements::jsonb -> 'accounts' as accounts
+      from executor_apps app left join executor_deployments d on d.id=app.active_deployment
+      where app.id=${pool} and app.owner=${`organization:${organization}`}
+    ), requirement_keys as materialized (
+      select distinct l.app,l.requirement,a.method from hosted_app_account_links l
+      join executor_apps app on app.id=l.app
+      join executor_accounts a on a.id=l.account and a.owner=app.owner
+      where l.app=${pool} and l.subject is null and app.owner=${`organization:${organization}`}
+    ), hosted_app_requirement_declarations as materialized (
+      select k.app,k.requirement,k.method,
+        slot.value ->> 'scope' as scope,slot.value ->> 'provider' as provider,
+        slot.value ->> 'contributed' as contributed,
+        coalesce(auth.value @> '{"type":"secrets","provisioned":true}'::jsonb,false) as provisioned,
+        auth.value ->> 'type' as auth_type,
+        coalesce(auth.value ->> 'provisioned','false') <> 'true' as unprovisioned
+      from requirement_keys k left join active_declarations d on d.app=k.app
+      cross join lateral (select d.accounts -> k.requirement as value) slot
+      cross join lateral (select slot.value -> 'definition' -> 'auth' -> k.method as value) auth
+    ), linked as (
+      select a.*,l.requirement as linked_requirement,l.created_at as link_order,
+        declaration.scope as requirement_scope,declaration.provider as requirement_provider,
+        declaration.provisioned as requirement_provisioned,
+        declaration.auth_type as requirement_auth_type,
+        declaration.unprovisioned as requirement_unprovisioned from ${usable}
+    ) select a.id as account,a.owner,a.linked_requirement as requirement,a.provider,a.method,
+      a.credential_generation as generation,
+      r.driver,r.driver_revision as "driverRevision",r.revision as "bindingRevision",
+      a.requirement_scope as "requirementScope",a.requirement_provider as "requirementProvider",
+      coalesce(a.requirement_provisioned,false) as "requirementProvisioned",
+      coalesce(r.mirror_ready,false) as "mirrorReady",
+      encode(sha256(coalesce(r.mirror_reference,a.encrypted_credentials)),'hex') as "referenceDigest",
+      coalesce(a.requirement_scope = 'app' and a.requirement_provider = a.provider
+        and a.requirement_auth_type = 'secrets' and coalesce(a.requirement_unprovisioned,true)
+        and (r.account is null or r.driver='basalt-home' and r.mirror_reference is not null and not r.mirror_ready),false) as "mirrorNeeded"
+      from linked a left join executor_account_acquisitions r on r.account=a.id
+      where r.removal is null and (r.account is null or r.owner=a.owner and r.provider=a.provider
+        and r.method=a.method and r.generation=a.credential_generation)
+      order by a.linked_requirement,a.link_order,a.id`;
+  });
