diff --git a/e2e/tests/account-directory-health.spec.ts b/e2e/tests/account-directory-health.spec.ts
new file mode 100644
index 00000000..8f37220d
--- /dev/null
+++ b/e2e/tests/account-directory-health.spec.ts
@@ -0,0 +1,168 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { Evidence } from "../support/evidence.ts";
+import { scenarios } from "../test-plan.ts";
+
+const source = (
+  health: string,
+) => `import { defineApp, defineProvider, object, secrets, string } from "apps";
+const service = defineProvider({name: "Directory health fixture", auth: {
+  key: secrets({label: "Key", fields: object({token: string()})})
+}, ${health}});
+export default defineApp({app: {accounts: {service}}}, {});`;
+const Health = Schema.Struct({
+  apps: Schema.Array(
+    Schema.Struct({
+      app: Schema.String,
+      checkable: Schema.Boolean,
+      check: Schema.NullOr(
+        Schema.Struct({
+          status: Schema.String,
+          current: Schema.Boolean,
+          message: Schema.optionalKey(Schema.String),
+        }),
+      ),
+    }),
+  ),
+});
+const Directory = Schema.Struct({
+  accounts: Schema.Array(
+    Schema.Struct({
+      account: Resource,
+      health: Schema.optionalKey(Health),
+    }),
+  ),
+});
+
+layer(HostedLive, { excludeTestServices: true })("Account directory health", (it) => {
+  it.effect(scenarios.accountDirectoryHealth.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          browser = yield* Browser,
+          evidence = yield* Evidence;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const files = (health: string) => [
+          { path: "index.ts", content: source(health) },
+          appsManifest,
+        ];
+        const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: "App-owned check",
+          files: files("async health() { return {}; }"),
+        });
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const app = yield* body(Resource, deployed);
+        let account: string | undefined;
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app.id}`);
+            if (account !== undefined)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`);
+          }).pipe(Effect.orDie),
+        );
+        const connection = yield* body(
+          Resource,
+          yield* api.request(
+            actors.owner,
+            "POST",
+            `${prefix}/apps/${app.id}/accounts/app/service/connections`,
+            {},
+          ),
+        );
+        const saved = yield* api.request(
+          actors.owner,
+          "POST",
+          `${prefix}/connections/${connection.id}/submit`,
+          {
+            method: "key",
+            label: "App-scoped account",
+            fields: { token: "synthetic-directory-token" },
+          },
+        );
+        expect(saved.status, JSON.stringify(saved.body)).toBe(200);
+        account = (yield* body(Resource, saved)).id;
+        const accountPath = `${prefix}/accounts/${account}`;
+        const check = () => api.request(actors.owner, "POST", `${accountPath}/health`);
+        const result = yield* check();
+        expect(result.status, JSON.stringify(result.body)).toBe(200);
+        expect(result.body).toMatchObject({
+          apps: [{ app: app.id, checkable: true, check: { status: "healthy", current: true } }],
+        });
+        yield* browser.login(actors.owner);
+        yield* browser.use("Open the app-scoped account in Accounts", (page) =>
+          page
+            .goto(`/org/${actors.organization.slug}/accounts`)
+            .then(() =>
+              page
+                .getByRole("group", { name: "Usage and health of App-scoped account", exact: true })
+                .waitFor(),
+            ),
+        );
+        for (const scheme of ["light", "dark"] as const) {
+          const image = yield* browser.use(`Capture app-scoped health in ${scheme}`, (page) =>
+            page.emulateMedia({ colorScheme: scheme }).then(() =>
+              page
+                .getByRole("group", {
+                  name: "Usage and health of App-scoped account",
+                  exact: true,
+                })
+                .locator(
+                  "xpath=ancestor::div[contains(concat(' ', @class, ' '), ' inventory-row ')][1]",
+                )
+                .screenshot({ animations: "disabled" }),
+            ),
+          );
+          yield* evidence.attach(`app-scoped-account-health-${scheme}.png`, "image/png", image);
+        }
+        const directory = yield* body(
+          Directory,
+          yield* api.request(actors.owner, "GET", `${prefix}/resources`),
+        );
+        expect(
+          directory.accounts.find((entry) => entry.account.id === account)?.health?.apps,
+        ).toMatchObject([
+          { app: app.id, checkable: true, check: { status: "healthy", current: true } },
+        ]);
+        expect(
+          yield* browser.use("The Accounts row retains the app's health", (page) =>
+            page
+              .getByRole("group", { name: "Usage and health of App-scoped account", exact: true })
+              .locator("[data-account-health]")
+              .innerText(),
+          ),
+        ).toContain("Healthy");
+        const changed = yield* api.request(
+          actors.owner,
+          "POST",
+          `${prefix}/apps/${app.id}/deploy`,
+          {
+            files: files(
+              'async health() { return JSON.parse(\'{"accountInfo":{"displayName":[]}}\'); }',
+            ),
+          },
+        );
+        expect(changed.status, JSON.stringify(changed.body)).toBe(200);
+        const failed = yield* body(Health, yield* check());
+        expect(failed.apps[0]?.check).toMatchObject({
+          status: "check_failed",
+          current: true,
+          message: "The check could not verify this account. Try checking again.",
+        });
+        expect(JSON.stringify(failed)).not.toContain("synthetic-directory-token");
+        const retained = yield* body(
+          Schema.Struct({ health: Health }),
+          yield* api.request(actors.owner, "GET", accountPath),
+        );
+        expect(retained.health.apps[0]?.check?.message).toBe(failed.apps[0]?.check?.message);
+      }),
+    ),
+  );
+});
diff --git a/e2e/tests/native-subscription-health.spec.ts b/e2e/tests/native-subscription-health.spec.ts
new file mode 100644
index 00000000..82c8632f
--- /dev/null
+++ b/e2e/tests/native-subscription-health.spec.ts
@@ -0,0 +1,242 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import type { Page } from "playwright";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { Evidence } from "../support/evidence.ts";
+import { ObservationView } from "../support/account-observation-fixture.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { providerAccountProduct } from "../support/provider-account-product.ts";
+import { serverControl } from "../support/server-control.ts";
+import { subscriptionHealthBackend } from "../support/subscription-health-backend.ts";
+import { scenarios } from "../test-plan.ts";
+
+const source = `import { defineApp, defineProvider, interactive, object, secrets, string } from "apps";
+const openai = defineProvider({ name: "OpenAI", hosts: ["api.openai.com", "chatgpt.com"], auth: {
+  codex: interactive({ label: "ChatGPT subscription", acquisition: "host" }),
+  apiKey: secrets({ label: "OpenAI API key", fields: object({ token: string({ minLength: 1 }) }) }),
+} });
+export default defineApp({ user: { accounts: { openai: openai.many() } } }, {});`;
+
+const Detail = Schema.Struct({ account: Schema.Struct({ label: Schema.String }) });
+const DriverMessage = Schema.Struct({
+  driver: Schema.Struct({
+    check: Schema.Struct({ message: Schema.optionalKey(Schema.String) }),
+  }),
+});
+// The row's own container, so captures show the account, its apps and the health line together.
+const inventoryRow =
+  "xpath=ancestor::div[contains(concat(' ', @class, ' '), ' inventory-row ')][1]";
+
+layer(HostedLive, { excludeTestServices: true })("Native subscription health", (it) => {
+  it.effect(scenarios.nativeSubscriptionHealth.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          browser = yield* Browser,
+          evidence = yield* Evidence,
+          backend = yield* subscriptionHealthBackend;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        let account: string | undefined;
+        const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: "Subscription health fixture",
+          files: [{ path: "index.ts", content: source }, appsManifest],
+        });
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const app = yield* body(Resource, deployed);
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* serverControl("start");
+            yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app.id}`);
+            if (account !== undefined)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`);
+          }).pipe(Effect.orDie),
+        );
+        yield* providerAccountProduct(backend.origin);
+        const pending = yield* api.request(
+          actors.owner,
+          "POST",
+          `${prefix}/apps/${app.id}/accounts/user/openai/connections`,
+          {},
+        );
+        expect(pending.status, JSON.stringify(pending.body)).toBe(200);
+        const connection = yield* body(Resource, pending);
+        const path = `${prefix}/connections/${connection.id}/interactive`;
+        expect(
+          (yield* api.request(actors.owner, "POST", `${path}/start`, { method: "codex" })).status,
+        ).toBe(200);
+        const saved = yield* api.request(actors.owner, "GET", `${path}/status`);
+        expect(saved.status, JSON.stringify(saved.body)).toBe(200);
+        account = (yield* body(Schema.Struct({ account: Resource }), saved)).account.id;
+        const accountPath = `${prefix}/accounts/${account}`;
+        const check = () => api.request(actors.owner, "POST", `${accountPath}/health`);
+        const healthy = yield* check();
+        expect(healthy.status, JSON.stringify(healthy.body)).toBe(200);
+        expect(healthy.body).toMatchObject({
+          driver: { checkable: true, check: { status: "healthy", current: true } },
+          info: { displayName: "Synthetic subscriber" },
+        });
+
+        // The Accounts row shows the driver's own result; the fixture app defines no check.
+        const label =
+          (yield* body(Detail, yield* api.request(actors.owner, "GET", accountPath))).account
+            .label || "Unnamed account";
+        const line = (page: Page) =>
+          page
+            .getByRole("group", { name: `Usage and health of ${label}`, exact: true })
+            .locator("[data-account-health]");
+        const driverStatus = (page: Page) =>
+          line(page).locator('[data-check-source="driver"] [data-check-status]');
+        const checkNow = (page: Page) =>
+          line(page).getByRole("button", { name: "Check now", exact: true });
+        const capture = (stage: string) =>
+          Effect.forEach(["light", "dark"] as const, (scheme) =>
+            Effect.gen(function* () {
+              const image = yield* browser.use(
+                `Capture the ${stage} row in ${scheme} mode`,
+                (page) =>
+                  page
+                    .emulateMedia({ colorScheme: scheme })
+                    .then(() =>
+                      line(page).locator(inventoryRow).screenshot({ animations: "disabled" }),
+                    ),
+              );
+              yield* evidence.attach(
+                `native-subscription-row-${stage}-${scheme}.png`,
+                "image/png",
+                image,
+              );
+            }),
+          );
+        const readRow = (step: string) =>
+          browser.use(step, (page) =>
+            Promise.all([
+              line(page).innerText(),
+              driverStatus(page).evaluateAll(
+                (nodes) => nodes[0]?.getAttribute("data-check-status") ?? null,
+              ),
+              driverStatus(page).evaluateAll(
+                (nodes) => nodes[0]?.getAttribute("data-check-current") ?? null,
+              ),
+              checkNow(page).isEnabled(),
+              line(page)
+                .locator('[data-check-source="driver"] [data-check-message]')
+                .allInnerTexts(),
+              line(page)
+                .getByRole("link", { name: /^Reconnect/ })
+                .count(),
+            ]),
+          );
+        const accounts = `/org/${actors.organization.slug}/accounts`;
+        yield* browser.login(actors.owner);
+        yield* browser.use("Open Accounts as the subscriber", (page) =>
+          page.goto(accounts).then(() => line(page).waitFor()),
+        );
+        // Captured before asserting, so a run without the fix still records its row.
+        yield* capture("healthy");
+        const shown = yield* readRow("Read the healthy subscription row");
+        expect(shown[0]).not.toContain("No app checks this account");
+        expect(shown[0]).toContain("sign-in checked");
+        expect(shown[0], "the driver's result is never attributed to an app").not.toContain(
+          "Subscription health fixture",
+        );
+        expect(shown.slice(1, 4)).toEqual(["healthy", "true", true]);
+        expect(shown[4]).toEqual([]);
+        expect(shown[5]).toBe(0);
+
+        let failed = healthy;
+        for (const [reason, status] of [
+          ["unauthorized", "credentials_rejected"],
+          ["rate_limited", "upstream_unavailable"],
+          ["unavailable", "upstream_unavailable"],
+        ] as const) {
+          yield* backend.answer({ failure: reason });
+          const result = yield* check();
+          expect(result.status, JSON.stringify(result.body)).toBe(200);
+          expect(result.body).toMatchObject({ driver: { check: { status, current: true } } });
+          expect(JSON.stringify(result.body)).not.toContain("opaque-subscription-reference");
+          failed = result;
+        }
+
+        // A current failure keeps the line compact and shows the reason the driver gave.
+        const reported = (yield* body(DriverMessage, failed)).driver.check.message;
+        yield* browser.use("Reload Accounts after the service stops answering", (page) =>
+          page.reload().then(() => driverStatus(page).waitFor()),
+        );
+        yield* capture("unavailable");
+        const unavailable = yield* readRow("Read the unavailable subscription row");
+        expect(unavailable.slice(1, 4)).toEqual(["upstream_unavailable", "true", true]);
+        expect(unavailable[4]).toEqual(reported === undefined ? [] : [reported]);
+        expect(unavailable[5], "an unavailable service never asks to reconnect").toBe(0);
+        const calls = (yield* backend.calls).length;
+        expect((yield* api.request(actors.member, "POST", `${accountPath}/health`)).status).toBe(
+          403,
+        );
+        expect((yield* backend.calls).length).toBe(calls);
+        yield* backend.answer({ result: {} });
+        yield* browser.use("Check the subscription from its row", (page) =>
+          checkNow(page)
