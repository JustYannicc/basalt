diff --git a/e2e/support/subscription-health-backend.ts b/e2e/support/subscription-health-backend.ts
new file mode 100644
index 00000000..bf428b5d
--- /dev/null
+++ b/e2e/support/subscription-health-backend.ts
@@ -0,0 +1,83 @@
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Effect, Layer, Ref, Schema } from "effect";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { createHmac, timingSafeEqual } from "node:crypto";
+import { createServer } from "node:http";
+
+/** A signed external credential custodian for the production subscription registration. */
+export const subscriptionHealthBackend = Effect.gen(function* () {
+  const calls = yield* Ref.make<readonly string[]>([]);
+  const answer = yield* Ref.make<Schema.Json>({
+    result: { accountInfo: { displayName: "Synthetic subscriber" } },
+  });
+  const route = HttpRouter.add(
+    "POST",
+    "/pool/v1/account-acquisitions",
+    Effect.gen(function* () {
+      const { envelope } = yield* HttpServerRequest.schemaBodyJson(
+        Schema.Struct({ envelope: Schema.String }),
+      );
+      const [prefix, payload, signature, extra] = envelope.split(".");
+      if (
+        prefix !== "sbaa1" ||
+        payload === undefined ||
+        signature === undefined ||
+        extra !== undefined
+      )
+        return HttpServerResponse.empty({ status: 401 });
+      const expected = createHmac("sha256", Buffer.from("ab".repeat(32), "hex"))
+        .update(`${prefix}.${payload}`)
+        .digest();
+      const actual = Buffer.from(signature, "base64url");
+      if (actual.length !== expected.length || !timingSafeEqual(actual, expected))
+        return HttpServerResponse.empty({ status: 401 });
+      const input = yield* Schema.decodeUnknownEffect(
+        Schema.Struct({
+          action: Schema.String,
+          provider: Schema.String,
+          owner: Schema.String,
+          operation: Schema.String,
+          at: Schema.Number,
+          expiresAt: Schema.Number,
+          reference: Schema.optionalKey(Schema.String),
+        }),
+      )(JSON.parse(Buffer.from(payload, "base64url").toString())).pipe(Effect.orDie);
+      if (
+        input.provider !== "codex" ||
+        input.at > Date.now() ||
+        input.expiresAt <= Date.now() ||
+        input.expiresAt > input.at + 30_000
+      )
+        return HttpServerResponse.empty({ status: 401 });
+      if (input.action === "start")
+        return HttpServerResponse.jsonUnsafe({
+          session: "synthetic-subscription-session",
+          url: "https://provider.example.test/device",
+          expiresAt: Date.now() + 60_000,
+        });
+      if (input.action === "status")
+        return HttpServerResponse.jsonUnsafe({
+          state: "connected",
+          ref: "opaque-subscription-reference",
+        });
+      if (input.action === "remove" || input.action === "cancel")
+        return HttpServerResponse.jsonUnsafe(null);
+      if (input.action !== "check" || input.reference !== "opaque-subscription-reference")
+        return HttpServerResponse.empty({ status: 400 });
+      yield* Ref.update(calls, (values) => [...values, input.owner]);
+      return HttpServerResponse.jsonUnsafe(yield* Ref.get(answer));
+    }),
+  );
+  const context = yield* Layer.build(
+    HttpRouter.serve(route, { disableLogger: true, disableListenLog: true }).pipe(
+      Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 })),
+    ),
+  );
+  const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(context));
+  if (!("port" in server.address)) return yield* Effect.die("Expected subscription fixture port");
+  return {
+    origin: `http://127.0.0.1:${server.address.port}`,
+    calls: Ref.get(calls),
+    answer: (value: Schema.Json) => Ref.set(answer, value),
+  };
+});
