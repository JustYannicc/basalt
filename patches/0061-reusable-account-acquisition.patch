+import { Schema } from "effect";
+import { column, idColumn, table } from "fumadb-effect/schema";
+import { AccountCheckStatus } from "../contracts/account.ts";
+import { AccountId, OwnerId } from "../contracts/shared.ts";
+import { ProviderError } from "apps/contracts";
+
+/** One bound driver per saved account. App checks keep their existing independent rows. */
+export const accountDriverChecks = table("executor_account_driver_checks", {
+  account: idColumn("account", AccountId, { type: "varchar(255)" }),
+  owner: column("owner", OwnerId, { type: "varchar(255)" }),
+  driver: column("driver", Schema.String, { type: "varchar(255)" }),
+  driverRevision: column("driver_revision", Schema.String, { type: "varchar(255)" }),
+  bindingRevision: column("binding_revision", Schema.String, { type: "varchar(255)" }),
+  generation: column("generation", Schema.Int),
+  checkable: column("checkable", Schema.Boolean),
+  status: column("status", Schema.NullOr(AccountCheckStatus)),
+  reason: column("reason", Schema.NullOr(ProviderError.fields.reason), { type: "varchar(255)" }),
+  checkedAt: column("checked_at", Schema.Date),
+  info: column("info", Schema.NullOr(Schema.Json)).default(null),
+  infoCheckedAt: column("info_checked_at", Schema.NullOr(Schema.Date)).default(null),
+  message: column("message", Schema.NullOr(Schema.String)).default(null),
+});
diff --git a/packages/sdk/src/implementation/account-driver-health.ts b/packages/sdk/src/implementation/account-driver-health.ts
new file mode 100644
index 0000000..531a265
--- /dev/null
+++ b/packages/sdk/src/implementation/account-driver-health.ts
@@ -0,0 +1,213 @@
+import { Clock, Effect, Option, Result, Schema } from "effect";
+import { AccountInfo, AccountCheckResult, HostOutputInvalid, ProviderError } from "apps/contracts";
+import { AccountAcquisitionUnavailable } from "../contracts/account-acquisition-driver.ts";
+import type {
+  AccountDriverHealth,
+  AccountHealth,
+  AccountCheckStatus,
+} from "../contracts/account.ts";
+import type { StoredAccount } from "../contracts/storage.ts";
+import { StorageError } from "../contracts/shared.ts";
+import { query, transaction, type Query } from "./database.ts";
+import { accountCheckRecord } from "./account-check-record.ts";
+import {
+  driverSourceCurrent,
+  retainedDriverBinding,
+  type AccountDriverResolver,
+  type DriverAccount,
+} from "./account-driver-source.ts";
+
+export const makeDriverAccountHealth = (
+  db: Query,
+  acquisition: AccountDriverResolver | undefined,
+  failure: {
+    readonly status: (error: unknown) => AccountCheckStatus;
+    readonly message: (error: unknown, late: boolean) => string | undefined;
+  },
+  recordObservation?: ReturnType<
+    typeof import("./account-observations.ts").makeAccountObservations
+  >["fromHealth"],
+) => {
+  const rows = (accounts: readonly DriverAccount[]) =>
+    query(() =>
+      db.findMany("accountDriverChecks", {
+        where: (b) =>
+          b(
+            "account",
+            "in",
+            accounts.map((account) => account.id),
+          ),
+      }),
+    );
+  type Row = Effect.Success<ReturnType<typeof rows>>[number];
+  const project = (account: DriverAccount, row: Row | undefined) =>
+    Effect.gen(function* () {
+      const binding = yield* retainedDriverBinding(acquisition, account);
+      if (binding === undefined) return undefined;
+      const saved =
+        row !== undefined && row.driver === binding.driver && row.owner === account.owner
+          ? row
+          : undefined;
+      const current =
+        binding.removal === null &&
+        saved !== undefined &&
+        saved.generation === account.credentialGeneration &&
+        saved.driverRevision === binding.driverRevision &&
+        saved.bindingRevision === binding.revision;
+      const info =
+        saved === undefined ? Option.none() : Schema.decodeUnknownOption(AccountInfo)(saved.info);
+      return {
+        driver: {
+          source: {
+            kind: "driver",
+            id: binding.driver,
+            version: saved?.driverRevision ?? binding.driverRevision,
+          },
+          checkable: current && saved?.checkable === true,
+          check:
+            saved?.status == null
+              ? null
+              : {
+                  status: saved.status,
+                  checkedAt: saved.checkedAt,
+                  current,
+                  ...(saved.reason === null ? {} : { reason: saved.reason }),
+                  ...(saved.message === null ? {} : { message: saved.message }),
+                },
+        } satisfies AccountDriverHealth,
+        info: Option.getOrNull(info),
+        infoCheckedAt: saved?.infoCheckedAt ?? null,
+      };
+    });
+
+  const report = (account: DriverAccount) =>
+    Effect.gen(function* () {
+      if (acquisition === undefined) return undefined;
+      return yield* project(account, (yield* rows([account]))[0]);
+    });
+  const list = (accounts: readonly DriverAccount[]) =>
+    Effect.gen(function* () {
+      if (acquisition === undefined || accounts.length === 0)
+        return new Map<DriverAccount["id"], Effect.Success<ReturnType<typeof project>>>();
+      const recorded = yield* rows(accounts);
+      const values = yield* Effect.forEach(
+        accounts,
+        (account) =>
+          Effect.gen(function* () {
+            const result = yield* project(
+              account,
+              recorded.find((row) => row.account === account.id),
+            );
+            return [account.id, result] as const;
+          }),
+        { concurrency: 4 },
+      );
+      return new Map(values);
+    });
+
+  const check = (account: StoredAccount) =>
+    Effect.gen(function* () {
+      if (acquisition === undefined) return;
+      const source = yield* acquisition.source({ account: account.id, owner: account.owner });
+      if (source === undefined) return;
+      const hook = source.check;
+      const startedAt = yield* Clock.currentTimeMillis;
+      // Missing capability is not a successful credential check.
+      if (hook === undefined) {
+        yield* transaction(db, () =>
+          Effect.gen(function* () {
+            if (!(yield* driverSourceCurrent(source, account))) return;
+            yield* query(() =>
+              db.updateMany("accountDriverChecks", {
+                where: (b) =>
+                  b.and(b("account", "=", account.id), b("driver", "=", source.binding.driver)),
+                set: { checkable: false },
+              }),
+            );
+          }),
+        );
+        return;
+      }
+      const outcome = yield* hook().pipe(
+        Effect.flatMap((value) =>
+          Schema.decodeUnknownEffect(AccountCheckResult)(value === undefined ? {} : value).pipe(
+            Effect.mapError(() => new HostOutputInvalid()),
+          ),
+        ),
+        Effect.timeout(15_000),
+        Effect.result,
+      );
+      if (Result.isFailure(outcome) && Schema.is(StorageError)(outcome.failure))
+        return yield* outcome.failure;
+      if (Result.isFailure(outcome) && Schema.is(AccountAcquisitionUnavailable)(outcome.failure))
+        return yield* outcome.failure;
+      const late = (yield* Clock.currentTimeMillis) >= startedAt + 14_000;
+      yield* transaction(db, () =>
+        Effect.gen(function* () {
+          if (!(yield* driverSourceCurrent(source, account))) return;
+          const existing = yield* query(() =>
+            db.findFirst("accountDriverChecks", {
+              where: (b) => b("account", "=", account.id),
+            }),
+          );
+          if (existing !== null && existing.checkedAt.getTime() > startedAt) return;
+          const success = Result.isSuccess(outcome) ? outcome.success : undefined;
+          const checkedAt = new Date(startedAt);
+          const identity = yield* accountCheckRecord(
+            existing,
+            success?.accountInfo,
+            undefined,
+            checkedAt,
+          );
+          const state = {
+            owner: account.owner,
+            driver: source.binding.driver,
+            driverRevision: source.binding.driverRevision,
+            bindingRevision: source.binding.revision,
+            generation: account.credentialGeneration,
+            checkable: true,
+            status: Result.isSuccess(outcome)
+              ? ("healthy" as const)
+              : failure.status(outcome.failure),
+            reason:
+              Result.isFailure(outcome) && Schema.is(ProviderError)(outcome.failure)
+                ? outcome.failure.reason
+                : null,
+            checkedAt,
+            ...identity,
+            message: Result.isSuccess(outcome)
+              ? null
+              : (failure.message(outcome.failure, late)?.slice(0, 500) ?? null),
+          };
+          // No status meters or optional allowance enter the credential-health row.
+          yield* query(() =>
+            db.upsert("accountDriverChecks", {
+              where: (b) => b("account", "=", account.id),
+              create: { account: account.id, ...state },
+              update: state,
+            }),
+          );
+          if (success !== undefined && recordObservation !== undefined)
+            yield* recordObservation({ account, source, result: success, startedAt });
+        }),
+      );
+    });
+  return { report, list, check };
+};
+
+export const withDriverHealth = (
+  health: AccountHealth,
+  saved: Effect.Success<ReturnType<ReturnType<typeof makeDriverAccountHealth>["report"]>>,
+): AccountHealth => {
+  if (saved === undefined) return health;
+  const useIdentity =
+    saved.info !== null &&
+    saved.infoCheckedAt !== null &&
+    (health.infoCheckedAt === null ||
+      saved.infoCheckedAt.getTime() > health.infoCheckedAt.getTime());
+  return {
+    ...health,
+    driver: saved.driver,
+    ...(useIdentity ? { info: saved.info, infoCheckedAt: saved.infoCheckedAt } : {}),
+  };
+};
diff --git a/packages/sdk/src/implementation/account-driver-observation-store.ts b/packages/sdk/src/implementation/account-driver-observation-store.ts
new file mode 100644
index 0000000..d2698a8
--- /dev/null
+++ b/packages/sdk/src/implementation/account-driver-observation-store.ts
@@ -0,0 +1,228 @@
+import { Clock, Effect, Option, Schema, type Crypto } from "effect";
+import { Hex } from "effect/encoding";
+import type { AccountObservationResult } from "apps/contracts";
+import {
+  StoredDriverObservationData,
+  type AccountObservationRecord,
+} from "../contracts/account-observation.ts";
+import type {
+  AccountAcquisitionBinding,
+  AccountAcquisitionSource,
+} from "../contracts/account-acquisition-driver.ts";
+import { StorageError } from "../contracts/shared.ts";
+import type { StoredAccount } from "../contracts/storage.ts";
+import { query, transaction, type Query } from "./database.ts";
+import { driverBindingMatches, driverSourceCurrent } from "./account-driver-source.ts";
+import {
+  freshObservation,
+  nextObservationState,
+  observationLeaseMillis,
+} from "./account-observation-state.ts";
+
+const decode = Schema.decodeUnknownOption(StoredDriverObservationData);
+const encode = Schema.encodeSync(StoredDriverObservationData);
+
+export const makeDriverObservationStore = (db: Query, crypto: Crypto.Crypto) => {
+  const key = (account: StoredAccount, driver: string) =>
+    crypto.digest("SHA-256", new TextEncoder().encode(driver)).pipe(
+      Effect.map((digest) => {
+        const source = `driver:${Hex.encode(digest)}`;
+        return { source, id: `${account.id}:${account.credentialGeneration}:${source}` };
+      }),
+      Effect.mapError(() => new StorageError()),
+    );
+
+  const reportDriver = (account: StoredAccount, binding: AccountAcquisitionBinding | undefined) =>
+    Effect.gen(function* () {
+      if (binding === undefined || !driverBindingMatches(binding, account)) return undefined;
+      const source = yield* key(account, binding.driver);
+      const row = yield* query(() =>
+        db.findFirst("accountObservations", {
+          where: (b) => b("id", "=", source.id),
+        }),
+      );
+      if (
+        row === null ||
+        row.owner !== account.owner ||
+        row.source !== source.source ||
+        row.account !== account.id ||
+        row.generation !== account.credentialGeneration
+      )
+        return undefined;
+      const data = decode(row.data);
+      if (Option.isNone(data) || data.value.id !== binding.driver) return undefined;
+      const value = data.value;
+      const now = yield* Clock.currentTimeMillis;
+      const outdated =
+        binding.removal !== null ||
+        value.version !== binding.driverRevision ||
+        value.bindingRevision !== binding.revision;
+      const failed = value.lastAttempt !== null && value.lastAttempt.outcome !== "success";
+      return {
+        source: { kind: "driver", id: value.id, label: value.id, version: value.version },
+        credentialGeneration: row.generation,
+        result: value.result,
+        checkedAt: row.checkedAt?.toISOString() ?? null,
+        lastAttempt: value.lastAttempt,
+        freshness:
+          value.result === null
+            ? "unavailable"
+            : outdated
+              ? "outdated"
+              : failed || !freshObservation(value.result, now)
+                ? "stale"
+                : "fresh",
+        collecting: row.lease !== null && (row.leaseUntil?.getTime() ?? 0) > now,
+        nextAllowedAt: row.nextAllowedAt.getTime() > now ? row.nextAllowedAt.toISOString() : null,
+      } satisfies AccountObservationRecord;
+    });
+
+  const beginDriver = (account: StoredAccount, source: AccountAcquisitionSource) =>
+    transaction(db, () =>
+      Effect.gen(function* () {
+        if (!(yield* driverSourceCurrent(source, account))) return undefined;
+        const indexed = yield* key(account, source.binding.driver);
+        const now = yield* Clock.currentTimeMillis;
+        const token = yield* crypto.randomUUIDv4.pipe(Effect.mapError(() => new StorageError()));
+        const provenance = {
+          version: source.binding.driverRevision,
+          bindingRevision: source.binding.revision,
+        };
+        yield* query(() =>
+          db.upsert("accountObservations", {
+            where: (b) => b("id", "=", indexed.id),
+            create: {
+              ...indexed,
+              account: account.id,
+              owner: account.owner,
+              generation: account.credentialGeneration,
+              data: encode({
+                kind: "driver",
+                id: source.binding.driver,
+                ...provenance,
+                result: null,
+                lastAttempt: null,
+                attemptSource: provenance,
+              }),
+              checkedAt: null,
+              nextAllowedAt: new Date(0),
+              lease: null,
+              leaseUntil: null,
+            },
+            update: { source: indexed.source },
+          }),
+        );
+        yield* query(() =>
+          db.updateMany("accountObservations", {
+            where: (b) =>
+              b.and(
+                b("id", "=", indexed.id),
+                b("nextAllowedAt", "<=", new Date(now)),
+                b.or(b("lease", "is", null), b("leaseUntil", "<", new Date(now))),
+              ),
+            set: {
+              lease: token,
+              leaseUntil: new Date(now + observationLeaseMillis),
+              nextAllowedAt: new Date(now + 60_000),
+            },
+          }),
+        );
+        const row = yield* query(() =>
+          db.findFirst("accountObservations", { where: (b) => b("id", "=", indexed.id) }),
+        );
+        return row?.lease === token ? { ...indexed, token, startedAt: now } : undefined;
+      }),
+    );
+
+  type Claim = NonNullable<Effect.Success<ReturnType<typeof beginDriver>>>;
+  const saveDriver = (input: {
+    readonly account: StoredAccount;
+    readonly source: AccountAcquisitionSource;
+    readonly claim?: Claim;
+    readonly startedAt: number;
+    readonly result?: AccountObservationResult;
+    readonly outcome: "success" | "unavailable" | "rate_limited" | "invalid" | "timed_out";
+  }) =>
+    transaction(db, () =>
+      Effect.gen(function* () {
+        if (!(yield* driverSourceCurrent(input.source, input.account))) return;
+        const indexed = yield* key(input.account, input.source.binding.driver);
+        yield* db.lockAccountObservation(indexed.id);
+        const now = yield* Clock.currentTimeMillis;
+        const row = yield* query(() =>
+          db.findFirst("accountObservations", { where: (b) => b("id", "=", indexed.id) }),
+        );
+        if (
+          row !== null &&
+          (row.source !== indexed.source ||
+            row.generation !== input.account.credentialGeneration ||
+            row.owner !== input.account.owner ||
+            (row.checkedAt !== null && row.checkedAt.getTime() > input.startedAt))
+        )
+          return;
+        if (
+          input.claim !== undefined &&
+          (input.claim.id !== indexed.id ||
+            input.claim.source !== indexed.source ||
+            row?.lease !== input.claim.token)
+        )
+          return;
+        if (
+          input.claim === undefined &&
+          row?.lease != null &&
+          (row.leaseUntil?.getTime() ?? 0) > now
+        )
+          return;
+        const decoded = decode(row?.data);
+        if (
+          row !== null &&
+          (Option.isNone(decoded) || decoded.value.id !== input.source.binding.driver)
+        )
+          return;
+        const old = Option.isSome(decoded) ? decoded.value : undefined;
+        const next = nextObservationState({
+          ...(old === undefined ? {} : { previous: old }),
+          ...(input.result === undefined ? {} : { result: input.result }),
+          outcome: input.outcome,
+          startedAt: input.startedAt,
+          now,
+        });
+        const provenance = {
+          version: input.source.binding.driverRevision,
+          bindingRevision: input.source.binding.revision,
+        };
+        const reading =
+          next.replacesReading || old?.result == null
+            ? provenance
+            : { version: old.version, bindingRevision: old.bindingRevision };
+        const state = {
+          data: encode({
+            kind: "driver",
+            id: input.source.binding.driver,
+            ...reading,
+            result: next.result,
+            lastAttempt: next.lastAttempt,
+            attemptSource: provenance,
+          }),
+          checkedAt: next.checkedAt,
+          nextAllowedAt: next.nextAllowedAt,
+          lease: null,
+          leaseUntil: null,
+        };
+        yield* query(() =>
+          db.upsert("accountObservations", {
+            where: (b) => b("id", "=", indexed.id),
+            create: {
+              ...indexed,
+              account: input.account.id,
+              owner: input.account.owner,
+              generation: input.account.credentialGeneration,
+              ...state,
+            },
+            update: state,
+          }),
+        );
+      }),
+    );
+  return { reportDriver, beginDriver, saveDriver };
+};
