+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { body } from "../support/api.ts";
+import { TestLive, withCase } from "../support/case.ts";
+import {
+  observationBackend,
+  observationSource,
+  observationToken,
+  allowance,
+} from "../support/account-observation-fixture.ts";
+import { connectLocalAccount } from "../support/app-accounts.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { localAgent } from "../support/local-links.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+const App = Schema.Struct({
+  app: Schema.Struct({ id: Schema.String, activeVersion: Schema.String }),
+});
+const View = Schema.Struct({ reports: Schema.Array(Schema.Json) });
+layer(TestLive, { excludeTestServices: true })("Observation source discriminator", (it) => {
+  it.effect(scenarios.accountObservationDiscriminator.title, (context) =>
+    withCase(
+      context,
+      Effect.gen(function* () {
+        const { agent } = yield* localAgent;
+        const backend = yield* observationBackend;
+        const deployed = yield* agent.send("POST", "/v1/apps/deploy", {
+          owner: "local",
+          name: "Observation source guards",
+          files: [
+            {
+              path: "index.ts",
+              content: observationSource(backend.origin, { observe: true, health: true }),
+            },
+            appsManifest,
+          ],
+        });
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const { app } = yield* body(App, deployed);
+        const account = yield* connectLocalAccount(agent, {
+          app: app.id,
+          requirement: "service",
+          method: "key",
+          fields: { token: observationToken },
+        });
+        const path = `/v1/accounts/${account.id}`;
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* serverControl("start");
+            yield* agent.send("DELETE", `/v1/apps/${app.id}`);
+            yield* agent.send("DELETE", path);
+          }).pipe(Effect.orDie),
+        );
+        expect(
+          (yield* agent.send("POST", `${path}/observations/refresh`, { apps: [app.id] })).status,
+        ).toBe(200);
+        const rowSql =
+          "SELECT id, account, owner, source, generation, data, checked_at, next_allowed_at, lease, lease_until FROM executor_account_observations WHERE account = $1 AND source = $2";
+        const snapshot = () => legacyStorage([{ sql: rowSql, params: [account.id, app.id] }]);
+        const before = yield* snapshot();
+        expect(before[0]).toHaveLength(1);
+        const row = yield* Schema.decodeUnknownEffect(Schema.Struct({ id: Schema.String }))(
+          before[0]![0],
+        );
+        const raw = {
+          kind: "driver",
+          id: "synthetic-driver-at-app-key",
+          version: app.activeVersion,
+          bindingRevision: "synthetic-binding-revision",
+          result: allowance(),
+          lastAttempt: null,
+          attemptSource: {
+            version: app.activeVersion,
+            bindingRevision: "synthetic-binding-revision",
+          },
+        };
+        const health = {
+          accountInfo: { displayName: "Still a healthy account" },
+          observation: allowance(),
+        };
+        yield* backend.health({ status: 200, body: health });
+        yield* legacyStorage([
+          {
+            sql: "UPDATE executor_account_observations SET data = $3::jsonb, next_allowed_at = '1970-01-01', lease = NULL, lease_until = NULL WHERE account = $1 AND source = $2",
+            params: [account.id, app.id, JSON.stringify(raw)],
+          },
+        ]);
+        const tagged = yield* snapshot();
+        yield* serverControl("start");
+        const read = yield* agent.send(
+          "GET",
+          `${path}/observations?apps=${encodeURIComponent(JSON.stringify([app.id]))}`,
+        );
+        expect(read.status, JSON.stringify(read.body)).toBe(200);
+        expect((yield* body(View, read)).reports).toEqual([]);
+        const calls = yield* backend.calls;
+        const refresh = yield* agent.send("POST", `${path}/observations/refresh`, {
+          apps: [app.id],
+        });
+        expect(refresh.status, JSON.stringify(refresh.body)).toBe(200);
+        expect((yield* body(View, refresh)).reports).toEqual([]);
+        expect(yield* backend.calls).toBe(calls);
+        expect((yield* agent.send("POST", `${path}/health`, { apps: [app.id] })).status).toBe(200);
+        expect(yield* snapshot()).toEqual(tagged);
+        yield* serverControl("start");
+        const noHook = yield* agent.send("POST", "/v1/apps/deploy", {
+          owner: "local",
+          app: app.id,
+          expectedVersion: app.activeVersion,
+          files: [
+            { path: "index.ts", content: observationSource(backend.origin, { health: true }) },
+            appsManifest,
+          ],
+        });
+        expect(noHook.status, JSON.stringify(noHook.body)).toBe(200);
+        expect(
+          (yield* agent.send("POST", `${path}/observations/refresh`, { apps: [app.id] })).status,
