+import { Effect, Result, Schema } from "effect";
+import { AccountObservationResult, HostOutputInvalid, ProviderError } from "apps/contracts";
+import {
+  AccountAcquisitionUnavailable,
+  type AccountAcquisitionSource,
+} from "../contracts/account-acquisition-driver.ts";
+import type { StoredAccount } from "../contracts/storage.ts";
+import { StorageError } from "../contracts/shared.ts";
+import type { makeObservationStore } from "./account-observation-store.ts";
+
+/** Source callbacks already sanitize against the hidden reference; validate the persisted shape too. */
+export const refreshDriverObservation = (
+  store: ReturnType<typeof makeObservationStore>,
+  account: StoredAccount,
+  source: AccountAcquisitionSource | undefined,
+) =>
+  Effect.gen(function* () {
+    if (source?.observeAccount === undefined) return;
+    const observe = source.observeAccount;
+    const claim = yield* store.beginDriver(account, source);
+    if (claim === undefined) return;
+    yield* Effect.gen(function* () {
+      const result = yield* observe().pipe(
+        Effect.flatMap((value) =>
+          value === undefined
+            ? Effect.succeed(undefined)
+            : Schema.decodeUnknownEffect(AccountObservationResult)(value).pipe(
+                Effect.mapError(() => new HostOutputInvalid()),
+              ),
+        ),
+        Effect.timeout(15_000),
+        Effect.result,
+      );
+      if (Result.isFailure(result) && Schema.is(StorageError)(result.failure))
+        return yield* result.failure;
+      if (Result.isFailure(result) && Schema.is(AccountAcquisitionUnavailable)(result.failure))
+        return yield* result.failure;
+      const value = Result.isSuccess(result) ? result.success : undefined;
+      const error = Result.isFailure(result) ? result.failure : undefined;
+      const outcome =
+        value !== undefined
+          ? "success"
+          : Schema.is(HostOutputInvalid)(error)
+            ? "invalid"
+            : Schema.is(ProviderError)(error) && error.reason === "rate_limited"
+              ? "rate_limited"
+              : typeof error === "object" &&
+                  error !== null &&
+                  "_tag" in error &&
+                  error._tag === "TimeoutError"
+                ? "timed_out"
+                : "unavailable";
+      yield* store.saveDriver({
+        account,
+        source,
+        claim,
+        startedAt: claim.startedAt,
+        outcome,
+        ...(value === undefined ? {} : { result: value }),
+      });
+    }).pipe(
+      Effect.ensuring(
+        store
+          .release(claim)
+          .pipe(
+            Effect.catchTag("StorageError", () =>
+              Effect.logWarning("Account observation lease release failed; it will expire"),
+            ),
+          ),
+      ),
+    );
+  });
