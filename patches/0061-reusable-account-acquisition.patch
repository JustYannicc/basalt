+++ b/e2e/tests/account-acquisition-observations.spec.ts
@@ -0,0 +1,163 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Fiber, Schema } from "effect";
+import { body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { acquisitionFixture } from "../support/account-acquisition-fixture.ts";
+import { allowance, ObservationView } from "../support/account-observation-fixture.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Driver account readings", (it) => {
+  it.effect(scenarios.accountAcquisitionObservations.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* acquisitionFixture();
+        const { account } = yield* f.create(f.actors.owner, {
+          kind: "shared",
+          audience: { kind: "everyone" },
+        });
+        const path = `${f.prefix}/accounts/${account}`;
+        const read = () =>
+          f.api
+            .request(f.actors.owner, "GET", `${path}/observations`)
+            .pipe(Effect.flatMap((response) => body(ObservationView, response)));
+        const refresh = () => f.api.request(f.actors.owner, "POST", `${path}/observations/refresh`);
+        const check = () => f.api.request(f.actors.owner, "POST", `${path}/health`);
+        const advance = (minutes: number) =>
+          serverControl("stop").pipe(
+            Effect.andThen(serverControl("clock/advance", 200, { milliseconds: minutes * 60_000 })),
+            Effect.andThen(serverControl("start")),
+          );
+        const checked = yield* check();
+        expect(checked.status, JSON.stringify(checked.body)).toBe(200);
+        expect(checked.body).toMatchObject({
+          driver: { checkable: true, check: { status: "healthy", current: true } },
+        });
+        const health = () =>
+          f.api.request(f.actors.owner, "GET", path).pipe(
+            Effect.flatMap((response) => body(Schema.Struct({ health: Schema.Json }), response)),
+            Effect.map((detail) => detail.health),
+          );
+        const before = yield* health();
+        const gate = yield* f.backend.holdObservation;
+        const pending = yield* Effect.all([refresh(), refresh(), refresh(), refresh()], {
+          concurrency: 4,
+        }).pipe(Effect.forkChild);
+        yield* gate.started;
+        expect((yield* read()).reports[0]?.collecting).toBe(true);
+        yield* gate.release;
+        expect((yield* Fiber.join(pending)).every((response) => response.status === 200)).toBe(
+          true,
+        );
+        const first = yield* read();
+        expect(first.reports).toHaveLength(1);
+        expect(first.reports[0]).toMatchObject({
+          source: { kind: "driver", id: "synthetic-account-driver" },
+          lastAttempt: { outcome: "success" },
+          freshness: "fresh",
+        });
+        expect((yield* f.backend.calls).filter((call) => call.step === "observe")).toHaveLength(1);
+        expect(yield* health()).toEqual(before);
+        const hidden = yield* f.api.request(f.actors.member, "GET", `${path}/observations`);
+        expect(hidden.status).toBe(200);
+        expect(hidden.body).toMatchObject({ canInspect: false, canRefresh: false, reports: [] });
+        expect(
+          (yield* f.api.request(f.actors.member, "POST", `${path}/observations/refresh`)).status,
+        ).toBe(403);
+        expect((yield* f.backend.calls).filter((call) => call.step === "observe")).toHaveLength(1);
+
+        const encoded = Buffer.from("opaque-1").toString("base64");
+        for (const secret of ["opaque-1", encoded]) {
+          yield* f.backend.driverHealth({
+            accountInfo: { displayName: secret },
+            status: { badges: [{ label: secret, tone: "neutral" }], meters: [], stats: [] },
+          });
+          const privateHealth = yield* check();
+          expect(privateHealth.body).toMatchObject({
+            driver: { check: { status: "check_failed" } },
+          });
+          expect(JSON.stringify(privateHealth.body)).not.toContain(secret);
+          expect(JSON.stringify(yield* health())).not.toContain(secret);
+          yield* advance(secret === "opaque-1" ? 6 : 2);
+          const reading = allowance();
+          yield* f.backend.driverObservation({
+            ...reading,
+            observation: {
+              ...reading.observation,
+              plan: { label: secret, observedAt: reading.observedAt },
+            },
+          });
+          const invalid = yield* body(ObservationView, yield* refresh());
+          expect(invalid.reports[0]).toMatchObject({
+            lastAttempt: { outcome: "invalid" },
+            result: first.reports[0]?.result,
+          });
+          expect(JSON.stringify(invalid)).not.toContain(secret);
+        }
+        yield* advance(2);
+        yield* f.backend.driverObservation({}, 503);
+        const failed = yield* body(ObservationView, yield* refresh());
+        expect(failed.reports[0]).toMatchObject({
+          source: first.reports[0]?.source,
+          result: first.reports[0]?.result,
+          lastAttempt: { outcome: "unavailable" },
+        });
+        const count = (yield* f.backend.calls).filter((call) => call.step === "observe").length;
+        expect((yield* refresh()).status).toBe(200);
+        expect((yield* f.backend.calls).filter((call) => call.step === "observe")).toHaveLength(
+          count,
+        );
+        yield* f.configure({ revision: "dpl_missing_previous_registration" });
+        expect(yield* read()).toEqual(failed);
+        const unavailable = yield* refresh();
+        expect(unavailable.status).toBe(503);
+        expect(unavailable.body).toMatchObject({
+          _tag: "AccountAcquisitionUnavailable",
+          reason: "registration",
+        });
+        expect((yield* f.backend.calls).filter((call) => call.step === "observe")).toHaveLength(
+          count,
+        );
+        yield* f.configure();
+        yield* advance(2);
+        yield* f.backend.driverObservation(allowance());
+        expect(
+          (yield* body(ObservationView, yield* refresh())).reports[0]?.lastAttempt?.outcome,
+        ).toBe("success");
+      }),
+    ),
+  );
+  it.effect(scenarios.accountAcquisitionOptional.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* acquisitionFixture({ check: false, observe: false });
+        const { account } = yield* f.create(f.actors.owner);
+        const path = `${f.prefix}/accounts/${account}`;
+        const check = () => f.api.request(f.actors.owner, "POST", `${path}/health`);
+        const refresh = () => f.api.request(f.actors.owner, "POST", `${path}/observations/refresh`);
+        expect((yield* check()).body).toMatchObject({ driver: { checkable: false, check: null } });
+        expect((yield* refresh()).body).toMatchObject({ reports: [] });
+        expect(
+          (yield* f.backend.calls).filter((call) => ["check", "observe"].includes(call.step)),
+        ).toEqual([]);
+        yield* f.configure({ check: "void", observe: false });
+        expect((yield* check()).body).toMatchObject({
+          driver: { checkable: true, check: { status: "healthy" } },
+        });
+        expect((yield* refresh()).body).toMatchObject({ reports: [] });
+        expect(
+          (yield* f.backend.calls).filter((call) => ["check", "observe"].includes(call.step)),
+        ).toEqual([]);
+        yield* f.configure({});
+        yield* f.backend.driverHealth(false);
+        expect((yield* check()).body).toMatchObject({
+          driver: { check: { status: "check_failed" } },
+        });
+        yield* f.backend.driverHealth({});
+        expect((yield* check()).body).toMatchObject({ driver: { check: { status: "healthy" } } });
+      }),
+    ),
+  );
+});
