diff --git a/packages/sdk/src/implementation/account-acquisition-adapter.ts b/packages/sdk/src/implementation/account-acquisition-adapter.ts
new file mode 100644
index 0000000..ef13666
--- /dev/null
+++ b/packages/sdk/src/implementation/account-acquisition-adapter.ts
@@ -0,0 +1,67 @@
+import { Effect } from "effect";
+import type {
+  AccountCheckResult,
+  AccountObservationResult,
+  InteractiveStart,
+  InteractiveStatus,
+} from "apps/contracts";
+import type {
+  AccountAcquisitionAccountContext,
+  AccountAcquisitionContext,
+  AccountAcquisitionDriver,
+} from "../contracts/account-acquisition-driver.ts";
+
+/** Promise callbacks for hosts whose credential backend is authored outside Effect. */
+export interface PromiseAccountAcquisitionDriver<
+  Context extends AccountAcquisitionAccountContext = AccountAcquisitionAccountContext,
+> {
+  readonly id: string;
+  readonly revision: string;
+  readonly start: (
+    context: AccountAcquisitionContext,
+    reconnect?: Context,
+  ) => Promise<InteractiveStart>;
+  readonly status: (
+    context: AccountAcquisitionContext,
+    input: { readonly session: string },
+  ) => Promise<InteractiveStatus>;
+  readonly submit?: (
+    context: AccountAcquisitionContext,
+    input: { readonly session: string; readonly value: string },
+  ) => Promise<InteractiveStatus>;
+  readonly cancel: (
+    context: AccountAcquisitionContext,
+    input: { readonly session: string },
+  ) => Promise<void>;
+  readonly remove: (context: Context) => Promise<void>;
+  readonly check?: (context: Context) => Promise<AccountCheckResult | void>;
+  readonly observeAccount?: (context: Context) => Promise<AccountObservationResult | void>;
+}
+
+const callback = <A>(run: () => Promise<A>) =>
+  Effect.tryPromise({ try: run, catch: (error) => error });
+
+/** The host owns callback lifetime and aborts the supplied context signal when it ends. */
+export const accountAcquisitionDriver = <Context extends AccountAcquisitionAccountContext>(
+  driver: PromiseAccountAcquisitionDriver<Context>,
+): AccountAcquisitionDriver<Context> => {
+  const { submit, check, observeAccount } = driver;
+  return {
+    id: driver.id,
+    revision: driver.revision,
+    start: (context, reconnect) => callback(() => driver.start(context, reconnect)),
+    status: (context, input) => callback(() => driver.status(context, input)),
+    cancel: (context, input) => callback(() => driver.cancel(context, input)),
+    remove: (context) => callback(() => driver.remove(context)),
+    ...(submit === undefined
+      ? {}
+      : {
+          submit: (context: AccountAcquisitionContext, input: Parameters<typeof submit>[1]) =>
+            callback(() => submit(context, input)),
+        }),
+    ...(check === undefined ? {} : { check: (context: Context) => callback(() => check(context)) }),
+    ...(observeAccount === undefined
+      ? {}
+      : { observeAccount: (context: Context) => callback(() => observeAccount(context)) }),
+  };
+};
diff --git a/packages/sdk/src/implementation/account-acquisition-bindings.ts b/packages/sdk/src/implementation/account-acquisition-bindings.ts
new file mode 100644
index 0000000..74bc6a1
--- /dev/null
+++ b/packages/sdk/src/implementation/account-acquisition-bindings.ts
@@ -0,0 +1,100 @@
+import { Effect, Redacted, Schema } from "effect";
+import {
+  AccountAcquisitionBinding,
+  AccountAcquisitionUnavailable,
+} from "../contracts/account-acquisition-driver.ts";
+import type { Credentials, StoredAccount } from "../contracts/storage.ts";
+import { StorageError, type AccountId, type OwnerId } from "../contracts/shared.ts";
+import { storedAccount } from "./accounts.ts";
+import { query, type Query } from "./database.ts";
+
+export const acquisitionBinding = (
+  db: Query,
+  input: { readonly account: AccountId; readonly owner?: OwnerId },
+) =>
+  Effect.gen(function* () {
+    const row = yield* query(() =>
+      db.findFirst("accountAcquisitions", {
+        where: (b) =>
+          b.and(
+            b("account", "=", input.account),
+            input.owner === undefined ? true : b("owner", "=", input.owner),
+          ),
+      }),
+    );
+    return row === null
+      ? undefined
+      : yield* Schema.decodeUnknownEffect(AccountAcquisitionBinding)(row).pipe(
+          Effect.mapError(() => new StorageError()),
+        );
+  });
+
+export const bindingMatchesAccount = (
+  binding: AccountAcquisitionBinding,
+  account: StoredAccount,
+  allowRemoval = false,
+) =>
+  binding.account === account.id &&
+  binding.owner === account.owner &&
+  binding.provider === account.provider &&
+  binding.method === account.method &&
+  binding.generation === account.credentialGeneration &&
+  (allowRemoval || binding.removal === null);
+
+/** This read does not create or adopt a binding. Missing and stale bindings stay distinguishable. */
+export const resolveAcquisitionBinding =
+  (db: Query, credentials: Credentials, allowRemoval = false) =>
+  (input: { readonly account: AccountId; readonly owner?: OwnerId }) =>
+    Effect.gen(function* () {
+      const account = yield* storedAccount(db, input.account, input.owner);
+      const binding = yield* acquisitionBinding(db, { account: account.id, owner: account.owner });
+      if (binding === undefined) return undefined;
+      if (!bindingMatchesAccount(binding, account, allowRemoval))
+        return yield* new AccountAcquisitionUnavailable({ reason: "changed" });
+      const fields = yield* credentials
+        .decrypt(account.id, account.encryptedCredentials)
+        .pipe(Effect.mapError(() => new StorageError()));
+      const value = yield* Schema.decodeUnknownEffect(
+        Schema.Struct({ ref: Schema.NonEmptyString }),
+      )(Redacted.value(fields)).pipe(Effect.mapError(() => new StorageError()));
+      return { account, binding, reference: Redacted.make(value.ref) };
+    });
+
+/** Recheck inside the transaction that saves a hook result or credential replacement. */
+export const requireAcquisitionBinding = (
+  db: Query,
+  expected: AccountAcquisitionBinding,
+  allowRemoval = false,
+) =>
+  Effect.gen(function* () {
+    yield* query(() =>
+      db.updateMany("accounts", {
+        where: (b) =>
+          b.and(
+            b("id", "=", expected.account),
+            b("owner", "=", expected.owner),
+            b("credentialGeneration", "=", expected.generation),
+          ),
+        set: { owner: expected.owner },
+      }),
+    );
+    yield* query(() =>
+      db.updateMany("accountAcquisitions", {
+        where: (b) =>
+          b.and(b("account", "=", expected.account), b("revision", "=", expected.revision)),
+        set: { revision: expected.revision },
+      }),
+    );
+    const account = yield* storedAccount(db, expected.account, expected.owner);
+    const current = yield* acquisitionBinding(db, expected);
+    if (
+      current === undefined ||
+      current.revision !== expected.revision ||
+      current.driver !== expected.driver ||
+      current.driverRevision !== expected.driverRevision ||
+      current.generation !== expected.generation ||
+      !bindingMatchesAccount(current, account, allowRemoval)
+    )
+      return yield* new AccountAcquisitionUnavailable({ reason: "changed" });
+    return current;
+  });
diff --git a/packages/sdk/src/implementation/account-acquisition-connect.ts b/packages/sdk/src/implementation/account-acquisition-connect.ts
new file mode 100644
index 0000000..658cf35
--- /dev/null
+++ b/packages/sdk/src/implementation/account-acquisition-connect.ts
@@ -0,0 +1,130 @@
+import { Clock, Effect, Redacted } from "effect";
+import type { ConnectCommand } from "apps/contracts";
+import { AccountAcquisitionUnavailable } from "../contracts/account-acquisition-driver.ts";
+import type { InteractiveSession } from "../contracts/interactive-accounts.ts";
+import type { Credentials } from "../contracts/storage.ts";
+import type { Query } from "./database.ts";
+import type { ConnectionRow } from "./connection-state.ts";
+import type { AcquisitionRegistry } from "./account-acquisition-registry.ts";
+import { resolveAcquisitionBinding } from "./account-acquisition-bindings.ts";
+import { invokeAcquisitionDriver } from "./account-acquisition-runtime.ts";
+import { acquisitionStatusOutput } from "./account-acquisition-output.ts";
+import { storedApp, storedVersion } from "./apps.ts";
+
+/** App intent selects a provider/method; only the host registry selects its implementation. */
+export const makeAcquisitionConnect = (
+  db: Query,
+  credentials: Credentials,
+  registry: AcquisitionRegistry,
+) => {
+  const resolve = resolveAcquisitionBinding(db, credentials);
+  const select = (row: ConnectionRow, method: string) =>
+    Effect.gen(function* () {
+      if (row.reconnectAccount !== null) {
+        const saved = yield* resolve({ account: row.reconnectAccount, owner: row.owner });
+        if (saved !== undefined) {
+          const registration = yield* registry.retained(saved.binding);
+          if (saved.binding.provider !== row.provider || saved.binding.method !== method)
+            return yield* new AccountAcquisitionUnavailable({ reason: "binding" });
+          return {
+            id: registration.driver.id,
+            revision: registration.driver.revision,
+            generation: saved.binding.generation,
+            bindingRevision: saved.binding.revision,
+          } satisfies NonNullable<InteractiveSession["driver"]>;
+        }
+        return yield* new AccountAcquisitionUnavailable({ reason: "binding" });
+      }
+      const app = yield* storedApp(db, { app: row.target.app, owner: row.target.owner });
+      const version = yield* storedVersion(db, app);
+      if (!version.requirements.accounts[row.target.requirement]?.hostAcquisition?.includes(method))
+        return undefined;
+      const registration = registry.current(row.provider, method);
+      if (registration === undefined)
+        return yield* new AccountAcquisitionUnavailable({ reason: "registration" });
+      return { id: registration.driver.id, revision: registration.driver.revision };
+    });
+  const prepare = (row: ConnectionRow, session: InteractiveSession) =>
+    Effect.gen(function* () {
+      const selected = session.driver;
+      if (selected === undefined) return undefined;
+      const registration = yield* registry.retained({
+        driver: selected.id,
+        driverRevision: selected.revision,
+        provider: row.provider,
+        method: session.method,
+      });
+      return (command: ConnectCommand) =>
+        Effect.gen(function* () {
+          const advancing =
+            command.step === "start" || command.step === "status" || command.step === "submit";
+          const saved =
+            !advancing || row.reconnectAccount === null
+              ? undefined
+              : yield* resolve({ account: row.reconnectAccount, owner: row.owner });
+          if (
+            advancing &&
+            row.reconnectAccount !== null &&
+            (saved === undefined ||
+              saved.binding.generation !== selected.generation ||
+              saved.binding.revision !== selected.bindingRevision)
+          )
+            return yield* new AccountAcquisitionUnavailable({ reason: "changed" });
+          const deadline = (yield* Clock.currentTimeMillis) + 15_000;
+          const statusOutput = (value: unknown) =>
+            acquisitionStatusOutput(
+              value,
+              saved === undefined ? undefined : Redacted.value(saved.reference),
+            );
+          return yield* invokeAcquisitionDriver<unknown, unknown>(
+            registration,
+            {
+              owner: row.owner,
+              provider: row.provider,
+              method: session.method,
+              operation: `${row.id}:${session.running ?? "cancel"}:${command.step}`,
+              deadline,
+            },
+            (context) => {
+              const driver = registration.driver;
+              switch (command.step) {
+                case "start":
+                  return driver.start(
+                    context,
+                    saved === undefined
+                      ? undefined
+                      : {
+                          ...context,
+                          binding: saved.binding,
+                          reference: saved.reference,
+                        },
+                  );
+                case "status":
+                  return driver
+                    .status(context, { session: command.input.session })
+                    .pipe(Effect.flatMap(statusOutput));
+                case "submit":
+                  return driver.submit === undefined
+                    ? Effect.fail(new AccountAcquisitionUnavailable({ reason: "unsupported" }))
+                    : driver
+                        .submit(context, {
+                          session: command.input.session,
+                          value: command.input.value,
+                        })
+                        .pipe(Effect.flatMap(statusOutput));
+                case "cancel":
+                  return driver.cancel(context, { session: command.input.session });
+                case "remove":
+                  // A failed save may release only this attempt, never a saved account by its ref.
+                  return session.session === undefined
+                    ? Effect.void
+                    : driver.cancel(context, { session: session.session });
+                case "check":
+                  return Effect.fail(new AccountAcquisitionUnavailable({ reason: "unsupported" }));
+              }
+            },
+          );
+        });
+    });
+  return { select, prepare };
+};
diff --git a/packages/sdk/src/implementation/account-acquisition-output.ts b/packages/sdk/src/implementation/account-acquisition-output.ts
new file mode 100644
index 0000000..e5dca20
--- /dev/null
+++ b/packages/sdk/src/implementation/account-acquisition-output.ts
@@ -0,0 +1,83 @@
+import { Effect, Option, Schema, Struct } from "effect";
+import {
+  AccountCheckResult,
+  AccountObservationResult,
+  HostOperationFailed,
+  HostOutputInvalid,
+  InteractiveStatus,
+  ProviderError,
+} from "apps/contracts";
+import {
+  privateAccountDisplay,
+  privateObservationStrings,
+} from "@executor-js/utils/account-display-privacy";
+import { privateAccountCheck } from "./account-status-output.ts";
+import type { AccountId } from "../contracts/shared.ts";
+
+/** Unsafe identity text falls back to the host's account name without losing the acquired credential. */
+export const acquisitionStatusOutput = (value: unknown, reference?: string) =>
+  Effect.gen(function* () {
+    const result = yield* Schema.decodeUnknownEffect(InteractiveStatus)(value).pipe(
+      Effect.mapError(() => new HostOutputInvalid()),
+    );
+    if (result.state === "failed" && !privateObservationStrings(result, {}, reference))
+      return { state: "failed" as const, message: "The account sign-in could not finish." };
+    if (result.state !== "connected" || result.accountInfo === undefined) return result;
+    const { accountInfo, ...connected } = result;
+    const acquired = privateAccountDisplay({ accountInfo }, {}, result.ref);
+    const shown =
+      acquired === undefined ? undefined : privateAccountDisplay(acquired, {}, reference);
+    return shown === undefined ? connected : { ...connected, accountInfo: shown.accountInfo };
+  });
+
+/** A malformed optional allowance must not change a valid credential-health verdict. */
+export const acquisitionCheckOutput = (value: unknown, reference: string) =>
+  Effect.gen(function* () {
+    if (value === undefined) return undefined;
+    const health = yield* Schema.decodeUnknownEffect(
+      AccountCheckResult.mapFields(Struct.omit(["observation", "observationInvalid"])),
+    )(value).pipe(Effect.mapError(() => new HostOutputInvalid()));
+    const combined = Schema.decodeUnknownOption(AccountCheckResult)(value);
+    return yield* privateAccountCheck(
+      Option.isSome(combined) ? combined.value : { ...health, observationInvalid: true },
+      {},
+      reference,
+    );
+  });
+
+export const acquisitionObservationOutput = (value: unknown, reference: string) =>
+  Effect.gen(function* () {
+    if (value === undefined) return undefined;
+    const result = yield* Schema.decodeUnknownEffect(AccountObservationResult)(value).pipe(
+      Effect.mapError(() => new HostOutputInvalid()),
+    );
+    if (!privateObservationStrings(result, {}, reference)) return yield* new HostOutputInvalid();
+    return result;
+  });
+
+/** Only bounded public errors cross this boundary; causes and the opaque reference stay private. */
+export const acquisitionCallbackError = (error: unknown, account: AccountId, reference: string) => {
+  if (Schema.is(HostOutputInvalid)(error)) return new HostOutputInvalid();
+  if (Schema.is(ProviderError)(error)) {
+    const shown = {
+      reason: error.reason,
+      status: error.status,
+      phase: error.phase,
+      upstream: error.upstream,
+    };
+    return privateObservationStrings(shown, {}, reference)
+      ? new ProviderError({ ...shown, accountId: account })
+      : new ProviderError({ reason: error.reason, status: error.status, accountId: account });
+  }
+  if (Schema.is(HostOperationFailed)(error)) {
+    const shown = {
+      ...(error.source === undefined ? {} : { source: error.source }),
+      ...(error.errorName === undefined ? {} : { errorName: error.errorName }),
+      ...(error.code === undefined ? {} : { code: error.code }),
+      message: error.message,
+      ...(error.fields === undefined ? {} : { fields: error.fields }),
+    };
+    if (privateObservationStrings(shown, {}, reference)) return new HostOperationFailed(shown);
+  }
+  return new HostOperationFailed({});
+};
diff --git a/packages/sdk/src/implementation/account-acquisition-registry.ts b/packages/sdk/src/implementation/account-acquisition-registry.ts
new file mode 100644
index 0000000..c73db71
--- /dev/null
+++ b/packages/sdk/src/implementation/account-acquisition-registry.ts
@@ -0,0 +1,49 @@
+import { Effect } from "effect";
+import { AccountAcquisitionUnavailable } from "../contracts/account-acquisition-driver.ts";
+import type {
+  AccountAcquisitionBinding,
+  AccountAcquisitionRegistration,
+} from "../contracts/account-acquisition-driver.ts";
+import type { ProviderId } from "../contracts/shared.ts";
+
+const key = (...values: readonly string[]) => JSON.stringify(values);
+
+/** Exact retained revisions resolve saved work; only one revision may accept new work per method. */
+export const makeAcquisitionRegistry = (
+  registrations: readonly AccountAcquisitionRegistration[],
+) => {
+  const retained = new Map<string, AccountAcquisitionRegistration>();
+  const current = new Map<string, AccountAcquisitionRegistration>();
+  for (const registration of registrations) {
+    const { driver, provider, method } = registration;
+    const revisionKey = key(driver.id, driver.revision, provider, method);
+    const methodKey = key(provider, method);
+    if (
+      !driver.id.trim() ||
+      !driver.revision.trim() ||
+      !method.trim() ||
+      driver.id.length > 255 ||
+      driver.revision.length > 255 ||
+      retained.has(revisionKey) ||
+      (registration.current && current.has(methodKey))
+    )
+      return Effect.fail(new AccountAcquisitionUnavailable({ reason: "registration" }));
+    retained.set(revisionKey, registration);
+    if (registration.current) current.set(methodKey, registration);
+  }
+  return Effect.succeed({
+    current: (provider: ProviderId, method: string) => current.get(key(provider, method)),
+    retained: (
+      binding: Pick<AccountAcquisitionBinding, "driver" | "driverRevision" | "provider" | "method">,
+    ) => {
+      const registration = retained.get(
+        key(binding.driver, binding.driverRevision, binding.provider, binding.method),
+      );
+      return registration === undefined
+        ? Effect.fail(new AccountAcquisitionUnavailable({ reason: "registration" }))
+        : Effect.succeed(registration);
+    },
+  });
+};
+
+export type AcquisitionRegistry = Effect.Success<ReturnType<typeof makeAcquisitionRegistry>>;
diff --git a/packages/sdk/src/implementation/account-acquisition-retirement.ts b/packages/sdk/src/implementation/account-acquisition-retirement.ts
new file mode 100644
index 0000000..c46b439
--- /dev/null
+++ b/packages/sdk/src/implementation/account-acquisition-retirement.ts
@@ -0,0 +1,149 @@
+import { Clock, Effect, Schema, type Crypto } from "effect";
+import type { ResourceLifecycle } from "../contracts/executor.ts";
+import {
+  AccountAcquisitionRemoval,
+  AccountAcquisitionUnavailable,
+} from "../contracts/account-acquisition-driver.ts";
+import {
+  InteractiveRetirementBusy,
+  InteractiveRetirementFailed,
+} from "../contracts/interactive-errors.ts";
+import { StorageError, type AccountId, type OwnerId } from "../contracts/shared.ts";
+import { publicAccount } from "./accounts.ts";
+import { query, transaction, type Query } from "./database.ts";
+import {
+  resolveAcquisitionBinding,
+  requireAcquisitionBinding,
+} from "./account-acquisition-bindings.ts";
+import { invokeAcquisitionDriver } from "./account-acquisition-runtime.ts";
+import type { AcquisitionRegistry } from "./account-acquisition-registry.ts";
+import { validateRemovalChange } from "./removal-validation.ts";
+
+const encode = Schema.encodeSync(AccountAcquisitionRemoval);
+
+/** A retained operation ID makes a retry after an uncertain backend response the same removal. */
+export const makeAcquisitionRetirement = (
+  db: Query,
+  credentials: import("../contracts/storage.ts").Credentials,
+  crypto: Crypto.Crypto,
+  registry: AcquisitionRegistry,
+  lifecycle?: ResourceLifecycle,
+) => {
+  const resolve = resolveAcquisitionBinding(db, credentials, true);
+  return <A, E, R>(
+    input: { readonly account: AccountId; readonly owner: OwnerId },
+    removeAccount: Effect.Effect<A, E, R>,
+  ) =>
+    Effect.gen(function* () {
+      yield* validateRemovalChange(db, removeAccount);
+      const claim = yield* transaction(db, (tx) =>
+        Effect.gen(function* () {
+          const saved = yield* resolve(input);
+          if (saved === undefined) return yield* new StorageError();
+          const binding = yield* requireAcquisitionBinding(tx, saved.binding, true);
+          const now = yield* Clock.currentTimeMillis;
+          if (binding.removal?.lease !== undefined && (binding.removal.leaseUntil ?? 0) > now)
+            return yield* new InteractiveRetirementBusy({ account: input.account });
+          yield* lifecycle?.accountRetiring?.(yield* publicAccount(saved.account)) ?? Effect.void;
+          const registration = yield* registry.retained(binding);
+          const token = yield* crypto.randomUUIDv4.pipe(Effect.mapError(() => new StorageError()));
+          const removal = {
+            operation: binding.removal?.operation ?? token,
+            removed: binding.removal?.removed ?? false,
+            lease: token,
+            leaseUntil: now + 20_000,
+          };
+          yield* query(() =>
+            tx.updateMany("accountAcquisitions", {
+              where: (b) => b("account", "=", input.account),
+              set: { removal: encode(removal) },
+            }),
+          );
+          return { ...saved, binding, registration, removal };
+        }),
+      );
+      const held = () =>
+        Effect.gen(function* () {
+          const current = yield* requireAcquisitionBinding(db, claim.binding, true);
+          if (current.removal?.lease !== claim.removal.lease)
+            return yield* new InteractiveRetirementBusy({ account: input.account });
+          return current;
+        });
+      return yield* Effect.gen(function* () {
+        if (!claim.removal.removed) {
+          yield* invokeAcquisitionDriver(
+            claim.registration,
+            {
+              owner: input.owner,
+              provider: claim.binding.provider,
+              method: claim.binding.method,
+              operation: claim.removal.operation,
+              deadline: (yield* Clock.currentTimeMillis) + 15_000,
+            },
+            (context) =>
+              claim.registration.driver.remove({
+                ...context,
+                binding: claim.binding,
+                reference: claim.reference,
+              }),
+          ).pipe(
+            Effect.mapError(
+              () =>
+                new InteractiveRetirementFailed({
+                  account: input.account,
+                  reason: "remove",
+                }),
+            ),
+          );
+          yield* transaction(db, () =>
+            Effect.gen(function* () {
+              yield* held();
+              yield* query(() =>
+                db.updateMany("accountAcquisitions", {
+                  where: (b) => b("account", "=", input.account),
+                  set: { removal: encode({ ...claim.removal, removed: true }) },
+                }),
+              );
+            }),
+          );
+        }
+        return yield* transaction(db, () =>
+          Effect.gen(function* () {
+            yield* held();
+            return yield* removeAccount;
+          }),
+        );
+      }).pipe(
+        Effect.ensuring(
+          transaction(db, () =>
+            Effect.gen(function* () {
+              const saved = yield* resolve(input).pipe(
+                Effect.catchTag("AccountNotFound", () => Effect.succeed(undefined)),
+              );
+              if (saved?.binding.removal?.lease !== claim.removal.lease) return;
+              const current = yield* requireAcquisitionBinding(db, saved.binding, true);
+              const removal = current.removal;
+              if (removal === null) return;
+              yield* query(() =>
+                db.updateMany("accountAcquisitions", {
+                  where: (b) => b("account", "=", input.account),
+                  set: {
+                    removal: encode({
+                      operation: removal.operation,
+                      removed: removal.removed,
+                    }),
+                  },
+                }),
+              );
+            }),
+          ).pipe(Effect.catch(() => Effect.logWarning("Account removal lease will expire"))),
+        ),
+      );
+    }).pipe(
+      Effect.mapError((error) =>
+        Schema.is(AccountAcquisitionUnavailable)(error)
+          ? new InteractiveRetirementFailed({ account: input.account, reason: "remove" })
+          : error,
+      ),
+    );
+};
diff --git a/packages/sdk/src/implementation/account-acquisition-runtime.ts b/packages/sdk/src/implementation/account-acquisition-runtime.ts
new file mode 100644
index 0000000..65c9667
--- /dev/null
+++ b/packages/sdk/src/implementation/account-acquisition-runtime.ts
@@ -0,0 +1,125 @@
+import { Clock, Effect, Redacted, Schema, type Crypto } from "effect";
+import { HostOperationFailed, HostOperationNotFound } from "apps/contracts";
+import type {
+  AccountAcquisitionAccountContext,
+  AccountAcquisitionContext,
+  AccountAcquisitionRegistration,
+} from "../contracts/account-acquisition-driver.ts";
+import type { Credentials } from "../contracts/storage.ts";
+import { StorageError, type AccountId, type OwnerId } from "../contracts/shared.ts";
+import { transaction, type Query } from "./database.ts";
+import {
+  requireAcquisitionBinding,
+  resolveAcquisitionBinding,
+} from "./account-acquisition-bindings.ts";
+import type { AcquisitionRegistry } from "./account-acquisition-registry.ts";
+import {
+  acquisitionCallbackError,
+  acquisitionCheckOutput,
+  acquisitionObservationOutput,
+} from "./account-acquisition-output.ts";
+
+type ContextInput = Omit<AccountAcquisitionContext, "signal" | "fetch">;
+
+/** The enclosing effect owns cancellation, including host-supplied fetches inside Promise adapters. */
+export const invokeAcquisitionDriver = <A, E>(
+  registration: AccountAcquisitionRegistration,
+  input: ContextInput,
+  invoke: (context: AccountAcquisitionContext) => Effect.Effect<A, E>,
+) =>
+  Effect.gen(function* () {
+    const remaining = input.deadline - (yield* Clock.currentTimeMillis);
+    if (remaining <= 0) return yield* Effect.fail(new HostOperationFailed({}));
+    return yield* Effect.acquireUseRelease(
+      Effect.sync(() => new AbortController()),
+      (controller) =>
+        invoke({ ...input, signal: controller.signal, fetch: registration.fetch }).pipe(
+          Effect.mapError((error) =>
+            Schema.is(HostOperationNotFound)(error) ? new HostOperationFailed({}) : error,
+          ),
+        ),
+      (controller) => Effect.sync(() => controller.abort()),
+    ).pipe(Effect.timeout(remaining));
+  });
+
+export const makeAcquisitionRuntime = (
+  db: Query,
+  credentials: Credentials,
+  crypto: Crypto.Crypto,
+  registry: AcquisitionRegistry,
+) => {
+  const resolve = resolveAcquisitionBinding(db, credentials);
+  return {
+    resolve,
+    source: (input: { readonly account: AccountId; readonly owner?: OwnerId }) =>
+      Effect.gen(function* () {
+        const resolved = yield* resolve(input);
+        if (resolved === undefined) return undefined;
+        const registration = yield* registry.retained(resolved.binding);
+        const context = {
+          owner: resolved.binding.owner,
+          provider: resolved.binding.provider,
+          method: resolved.binding.method,
+        };
+        const call = <A>(
+          hook: (context: AccountAcquisitionAccountContext) => Effect.Effect<A, unknown>,
+        ) =>
+          Effect.gen(function* () {
+            yield* transaction(db, (tx) => requireAcquisitionBinding(tx, resolved.binding));
+            const operation = yield* crypto.randomUUIDv4.pipe(
+              Effect.mapError(() => new StorageError()),
+            );
+            return yield* invokeAcquisitionDriver(
+              registration,
+              { ...context, operation, deadline: (yield* Clock.currentTimeMillis) + 15_000 },
+              (current) =>
+                hook({
+                  ...current,
+                  binding: resolved.binding,
+                  reference: resolved.reference,
+                }).pipe(
+                  Effect.mapError((error) =>
+                    acquisitionCallbackError(
+                      error,
+                      resolved.binding.account,
+                      Redacted.value(resolved.reference),
+                    ),
+                  ),
+                ),
+            );
+          });
+        const { driver } = registration;
+        const check = driver.check;
+        const observeAccount = driver.observeAccount;
+        return {
+          binding: resolved.binding,
+          source: {
+            kind: "driver" as const,
+            id: driver.id,
+            version: driver.revision,
+          },
+          current: requireAcquisitionBinding(db, resolved.binding),
+          ...(check === undefined
+            ? {}
+            : {
+                check: () =>
+                  call(check).pipe(
+                    Effect.flatMap((value) =>
+                      acquisitionCheckOutput(value, Redacted.value(resolved.reference)),
+                    ),
+                  ),
+              }),
+          ...(observeAccount === undefined
+            ? {}
+            : {
+                observeAccount: () =>
+                  call(observeAccount).pipe(
+                    Effect.flatMap((value) =>
+                      acquisitionObservationOutput(value, Redacted.value(resolved.reference)),
+                    ),
+                  ),
+              }),
+        };
+      }),
+  };
+};
