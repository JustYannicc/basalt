diff --git a/e2e/tests/account-acquisition-cleanup.spec.ts b/e2e/tests/account-acquisition-cleanup.spec.ts
new file mode 100644
index 0000000..e9bcbb3
--- /dev/null
+++ b/e2e/tests/account-acquisition-cleanup.spec.ts
@@ -0,0 +1,174 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Fiber, Schema } from "effect";
+import { body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { acquisitionFixture } from "../support/account-acquisition-fixture.ts";
+import { linkAccount } from "../support/app-accounts.ts";
+import { Resource } from "../support/contracts.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Connected = Schema.Struct({ state: Schema.Literal("connected"), account: Resource });
+
+layer(HostedLive, { excludeTestServices: true })("Driver acquisition output and cleanup", (it) => {
+  it.effect(scenarios.accountAcquisitionFailurePrivacy.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* acquisitionFixture();
+        const actor = f.actors.member;
+        const { account } = yield* f.create(actor);
+        for (const step of ["submit", "status"] as const) {
+          for (const message of ["opaque-1", Buffer.from("opaque-1").toString("base64")]) {
+            const pending = yield* f.pending(actor, f.manager.app.id, account);
+            expect(pending.status).toBe(200);
+            const connection = (yield* body(Resource, pending)).id;
+            expect((yield* f.start(actor, connection)).status).toBe(200);
+            yield* f.backend.failAcquisition(message);
+            const status = () => f.api.request(actor, "GET", `${f.connectPath(connection)}/status`);
+            const failed = yield* step === "submit" ? f.submit(actor, connection) : status();
+            expect(failed.status).toBe(200);
+            expect(failed.body).toMatchObject({ state: "failed" });
+            const calls = (yield* f.backend.calls).length;
+            const retained = yield* status();
+            expect(retained.body).toEqual(failed.body);
+            expect((yield* f.backend.calls).length).toBe(calls);
+            expect(JSON.stringify(failed.body)).not.toContain("opaque-1");
+            expect(JSON.stringify(failed.body)).not.toContain(
+              Buffer.from("opaque-1").toString("base64"),
+            );
+            expect(
+              (yield* f.api.request(actor, "POST", `${f.connectPath(connection)}/cancel`)).status,
+            ).toBe(200);
+          }
+        }
+        expect(yield* f.backend.removeCalls).toEqual([]);
+        expect((yield* f.api.request(actor, "GET", `${f.prefix}/accounts/${account}`)).status).toBe(
+          200,
+        );
+      }),
+    ),
+  );
+  it.effect(scenarios.accountAcquisitionIdentity.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* acquisitionFixture();
+        let sequence = 0;
+        for (const step of ["submit", "status"] as const) {
+          for (const encoded of [false, true]) {
+            const reference = `opaque-${++sequence}`;
+            const label = encoded ? Buffer.from(reference).toString("base64") : reference;
+            yield* f.backend.setAccountInfo({ displayName: label });
+            const pending = yield* f.pending(f.actors.member);
+            expect(pending.status).toBe(200);
+            const connection = (yield* body(Resource, pending)).id;
+            expect((yield* f.start(f.actors.member, connection)).status).toBe(200);
+            const status = () =>
+              f.api.request(f.actors.member, "GET", `${f.connectPath(connection)}/status`);
+            if (step === "status")
+              expect((yield* status()).body).toMatchObject({ state: "waiting" });
+            const response = yield* step === "submit"
+              ? f.submit(f.actors.member, connection)
+              : status();
+            expect(response.status, JSON.stringify(response.body)).toBe(200);
+            const { account } = yield* body(Connected, response);
+            f.trackAccount(f.actors.member, account.id);
+            const detail = yield* f.api.request(
+              f.actors.member,
+              "GET",
+              `${f.prefix}/accounts/${account.id}`,
+            );
+            expect(detail.status).toBe(200);
+            for (const value of [response.body, detail.body]) {
+              expect(JSON.stringify(value)).not.toContain(reference);
+              expect(JSON.stringify(value)).not.toContain(
+                Buffer.from(reference).toString("base64"),
+              );
+            }
+          }
+        }
+      }),
+    ),
+  );
+
+  it.effect(scenarios.accountAcquisitionCleanup.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* acquisitionFixture();
+        const actor = f.actors.member;
+        const { account } = yield* f.create(actor);
+        const accountPath = `${f.prefix}/accounts/${account}`;
+        const consumer = yield* f.deploy("Reconnect generation consumer");
+        yield* linkAccount(actor, consumer.path, "identity", account);
+        const used = () =>
+          f.api.request(actor, "POST", `${consumer.path}/tools/call`, {
+            tool: "ids",
+            kind: "query",
+            input: {},
+          });
+        const reconnect = () =>
+          Effect.gen(function* () {
+            const pending = yield* f.pending(actor, consumer.app.id, account);
+            expect(pending.status, JSON.stringify(pending.body)).toBe(200);
+            const id = (yield* body(Resource, pending)).id;
+            expect((yield* f.start(actor, id)).status).toBe(200);
+            return id;
+          });
+        const older = yield* reconnect();
+        const hold = yield* f.backend.holdNextSubmit;
+        const finishing = yield* f.submit(actor, older).pipe(Effect.forkChild);
+        yield* hold.started;
+        const newer = yield* reconnect();
+        expect((yield* f.submit(actor, newer)).body).toMatchObject({
+          state: "connected",
+          account: { id: account },
+        });
+        yield* hold.release;
+        expect((yield* Fiber.join(finishing)).status).toBe(422);
+        expect((yield* used()).body).toEqual([
+          { id: account, method: "paste", fields: { ref: "opaque-3" } },
+        ]);
+        const cancellations = () =>
+          f.backend.calls.pipe(
+            Effect.map((calls) =>
+              calls.filter((call) => call.step === "cancel").map((call) => call.session),
+            ),
+          );
+        expect(yield* cancellations()).toEqual(["private-session-2"]);
+        expect(yield* f.backend.removeCalls).toEqual([]);
+
+        const stale = yield* reconnect();
+        const latest = yield* reconnect();
+        expect((yield* f.submit(actor, latest)).body).toMatchObject({
+          state: "connected",
+          account: { id: account },
+        });
+        const cancel = (id: string) => f.api.request(actor, "POST", `${f.connectPath(id)}/cancel`);
+        expect((yield* cancel(stale)).status).toBe(200);
+        expect((yield* cancel(stale)).status).toBe(200);
+        expect(yield* cancellations()).toEqual(["private-session-2", "private-session-4"]);
+        expect((yield* used()).body).toEqual([
+          { id: account, method: "paste", fields: { ref: "opaque-5" } },
+        ]);
+        expect(yield* f.backend.removeCalls).toEqual([]);
+
+        const deleted = yield* reconnect();
+        expect((yield* f.api.request(actor, "DELETE", accountPath)).status).toBe(200);
+        for (const other of [f.actors.owner, f.actors.admin])
+          expect(
+            (yield* f.api.request(other, "POST", `${f.connectPath(deleted)}/cancel`)).status,
+          ).toBe(403);
+        expect(yield* cancellations()).toEqual(["private-session-2", "private-session-4"]);
+        expect((yield* cancel(deleted)).status).toBe(200);
+        expect(yield* cancellations()).toEqual([
+          "private-session-2",
+          "private-session-4",
+          "private-session-6",
+        ]);
+        expect((yield* f.backend.removeCalls).map((call) => call.ref)).toEqual(["opaque-5"]);
+        expect((yield* f.api.request(actor, "GET", accountPath)).status).toBe(403);
+      }),
+    ),
+  );
+});
diff --git a/e2e/tests/account-acquisition-health.spec.ts b/e2e/tests/account-acquisition-health.spec.ts
new file mode 100644
index 0000000..38a4422
--- /dev/null
+++ b/e2e/tests/account-acquisition-health.spec.ts
@@ -0,0 +1,171 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Fiber, Schema } from "effect";
+import { body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { acquisitionFixture } from "../support/account-acquisition-fixture.ts";
+import { allowance, ObservationView } from "../support/account-observation-fixture.ts";
+import { Resource } from "../support/contracts.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+const driver = (view: typeof ObservationView.Type) =>
+  view.reports.find(
+    (report) => report.source.kind === "driver" && report.source.id === "synthetic-account-driver",
+  );
+
+const Health = Schema.Struct({
+  health: Schema.Struct({
+    driver: Schema.Struct({
+      check: Schema.NullOr(
+        Schema.Struct({ status: Schema.String, checkedAt: Schema.String, current: Schema.Boolean }),
+      ),
+    }),
+  }),
+});
+
+layer(HostedLive, { excludeTestServices: true })("Driver health observations", (it) => {
+  it.effect(scenarios.accountAcquisitionHealth.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* acquisitionFixture();
+        const { account } = yield* f.create(f.actors.owner);
+        const path = `${f.prefix}/accounts/${account}`;
+        const read = () =>
+          f.api
+            .request(f.actors.owner, "GET", `${path}/observations`)
+            .pipe(Effect.flatMap((response) => body(ObservationView, response)));
+        const check = () => f.api.request(f.actors.owner, "POST", `${path}/health`);
+        const health = () =>
+          f.api.request(f.actors.owner, "GET", path).pipe(
+            Effect.flatMap((response) => body(Health, response)),
+            Effect.map((detail) => detail.health.driver),
+          );
+        const healthy = (response: { status: number; body: unknown }) => {
+          expect(response.status, JSON.stringify(response.body)).toBe(200);
+          expect(response.body).toMatchObject({
+            driver: { check: { status: "healthy", current: true } },
+          });
+        };
+        const first = allowance();
+        yield* f.backend.driverHealth({
+          accountInfo: { displayName: "Checked identity" },
+          observation: first,
+        });
+        healthy(yield* check());
+        const captured = yield* read();
+        expect(captured.reports).toHaveLength(1);
+        expect(driver(captured)).toMatchObject({
+          source: {
+            kind: "driver",
+            id: "synthetic-account-driver",
+            version: "dpl_fixture_driver_revision",
+          },
+          result: first,
+          lastAttempt: { outcome: "success" },
+          credentialGeneration: 0,
+        });
+        expect((yield* f.backend.calls).filter((call) => call.step === "observe")).toEqual([]);
+        yield* f.backend.driverHealth({
+          accountInfo: { displayName: "Still healthy" },
+          observationInvalid: true,
+        });
+        healthy(yield* check());
+        expect(driver(yield* read())).toMatchObject({
+          result: first,
+          lastAttempt: { outcome: "invalid" },
+        });
+
+        for (const secret of ["opaque-1", Buffer.from("opaque-1").toString("base64")]) {
+          const observed = allowance();
+          yield* f.backend.driverHealth({
+            accountInfo: { displayName: "Safe checked identity" },
+            observation: {
+              ...observed,
+              observation: {
+                ...observed.observation,
+                plan: { label: secret, observedAt: observed.observedAt },
+              },
+            },
+          });
+          const result = yield* check();
+          healthy(result);
+          expect(JSON.stringify(result.body)).not.toContain(secret);
+          const retained = yield* read();
+          expect(driver(retained)).toMatchObject({
+            result: first,
+            lastAttempt: { outcome: "invalid" },
+          });
+          expect(JSON.stringify(retained)).not.toContain(secret);
+        }
+        yield* f.backend.driverHealth({
+          observation: allowance(new Date(Date.now() + 365 * 86_400_000).toISOString()),
+        });
+        healthy(yield* check());
+        expect(driver(yield* read())).toMatchObject({
+          result: first,
+          lastAttempt: { outcome: "invalid" },
+        });
+        const withoutObservation = yield* read();
+        yield* f.backend.driverHealth({});
+        healthy(yield* check());
+        expect(yield* read()).toEqual(withoutObservation);
+
+        yield* serverControl("stop");
+        yield* serverControl("clock/advance", 200, { milliseconds: 6 * 60_000 });
+        yield* f.backend.advanceClock(6 * 60_000);
+        yield* serverControl("start");
+        expect(driver(yield* read()), "restart retains the health-captured reading").toMatchObject({
+          result: first,
+        });
+        const reading = allowance();
+        yield* f.backend.driverObservation(reading);
+        const gate = yield* f.backend.holdObservation;
+        const collecting = yield* f.api
+          .request(f.actors.owner, "POST", `${path}/observations/refresh`)
+          .pipe(Effect.forkChild);
+        yield* gate.started;
+        expect(
+          driver(yield* read()),
+          "claiming collection retains the previous reading",
+        ).toMatchObject({ collecting: true, result: first });
+        yield* f.backend.driverHealth({ observation: allowance() });
+        healthy(yield* check());
+        expect(driver(yield* read())).toMatchObject({ collecting: true, result: first });
+        yield* gate.release;
+        expect((yield* Fiber.join(collecting)).status).toBe(200);
+        expect(driver(yield* read())).toMatchObject({
+          collecting: false,
+          result: reading,
+          lastAttempt: { outcome: "success" },
+        });
+
+        const before = yield* health();
+        const checking = yield* f.backend.holdCheck;
+        const pending = yield* check().pipe(Effect.forkChild);
+        yield* checking.started;
+        const reconnect = yield* f.pending(f.actors.owner, f.manager.app.id, account);
+        expect(reconnect.status, JSON.stringify(reconnect.body)).toBe(200);
+        const connection = (yield* body(Resource, reconnect)).id;
+        expect((yield* f.start(f.actors.owner, connection)).status).toBe(200);
+        expect((yield* f.submit(f.actors.owner, connection)).body).toMatchObject({
+          state: "connected",
+          account: { id: account },
+        });
+        yield* checking.release;
+        expect((yield* Fiber.join(pending)).status).toBe(200);
+        expect((yield* read()).reports).toEqual([]);
+        expect((yield* health()).check).toMatchObject({
+          checkedAt: before.check?.checkedAt,
+          current: false,
+        });
+        yield* f.backend.driverHealth({ observation: allowance() });
+        healthy(yield* check());
+        expect(driver(yield* read())).toMatchObject({
+          credentialGeneration: 1,
+          lastAttempt: { outcome: "success" },
+        });
+      }),
+    ),
+  );
+});
diff --git a/e2e/tests/account-acquisition-local.spec.ts b/e2e/tests/account-acquisition-local.spec.ts
new file mode 100644
index 0000000..e934160
--- /dev/null
+++ b/e2e/tests/account-acquisition-local.spec.ts
@@ -0,0 +1,161 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Fiber, Schema } from "effect";
+import { body } from "../support/api.ts";
+import { TestLive, withCase } from "../support/case.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { acquisitionAppSource, acquisitionProduct } from "../support/acquisition-product.ts";
+import { interactiveAccountBackend } from "../support/interactive-account-backend.ts";
+import { callLocalQuery, linkLocal, localAgent } from "../support/local-links.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Resource = Schema.Struct({ id: Schema.String });
+const App = Schema.Struct({
+  app: Schema.Struct({
+    id: Schema.String,
+    requirements: Schema.Struct({
+      accounts: Schema.Record(Schema.String, Schema.Struct({ provider: Schema.String })),
+    }),
+  }),
+});
+const Connected = Schema.Struct({ state: Schema.Literal("connected"), account: Resource });
+const Observation = Schema.Struct({
+  reports: Schema.Array(
+    Schema.Struct({
+      source: Schema.Struct({ kind: Schema.String, id: Schema.String, version: Schema.String }),
+      result: Schema.NullOr(Schema.Json),
+      checkedAt: Schema.NullOr(Schema.String),
+      freshness: Schema.String,
+    }),
+  ),
+});
+
+layer(TestLive, { excludeTestServices: true })("Reusable local account", (it) => {
+  it.effect(scenarios.accountAcquisitionLocal.title, (context) =>
+    withCase(
+      context,
+      Effect.gen(function* () {
+        const { agent } = yield* localAgent;
+        const backend = yield* interactiveAccountBackend;
+        const apps: string[] = [];
+        const accounts: string[] = [];
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* serverControl("start");
+            for (const app of apps) yield* agent.send("DELETE", `/v1/apps/${app}`);
+            for (const account of accounts) yield* agent.send("DELETE", `/v1/accounts/${account}`);
+          }).pipe(Effect.orDie),
+        );
+        const deploy = (name: string) =>
+          Effect.gen(function* () {
+            const response = yield* agent.send("POST", "/v1/apps/deploy", {
+              owner: "local",
+              name,
+              files: [
+                { path: "index.ts", content: acquisitionAppSource(backend.origin) },
+                appsManifest,
+              ],
+            });
+            expect(response.status, JSON.stringify(response.body)).toBe(200);
+            const { app } = yield* body(App, response);
+            apps.push(app.id);
+            return app;
+          });
+        const manager = yield* deploy("Account management");
+        const first = yield* deploy("First account consumer"),
+          second = yield* deploy("Second account consumer");
+        const provider = manager.requirements.accounts.identity!.provider;
+        expect(first.requirements.accounts.identity?.provider).toBe(provider);
+        expect(second.requirements.accounts.identity?.provider).toBe(provider);
+        yield* acquisitionProduct({ provider, origin: backend.origin });
+        const connect = (app: string, account?: string) =>
+          Effect.gen(function* () {
+            const response = yield* agent.send("POST", "/v1/account-connections", {
+              owner: "local",
+              target: { app, requirement: "identity" },
+              ...(account === undefined ? {} : { account }),
+            });
+            expect(response.status, JSON.stringify(response.body)).toBe(200);
+            return (yield* body(Resource, response)).id;
+          });
+        const start = (connection: string) =>
+          agent.send("POST", "/v1/account-connections/interactive/start", {
+            connection,
+            owner: "local",
+            method: "paste",
+          });
+        const submit = (connection: string) =>
+          agent.send("POST", "/v1/account-connections/interactive/submit", {
+            connection,
+            owner: "local",
+            value: "http://localhost:48765/done?code=synthetic",
+          });
+        const initial = yield* connect(manager.id);
+        expect((yield* start(initial)).status).toBe(200);
+        const completed = yield* submit(initial);
+        expect(completed.status, JSON.stringify(completed.body)).toBe(200);
+        const { account } = yield* body(Connected, completed);
+        accounts.push(account.id);
+        expect(JSON.stringify(completed.body)).not.toContain("opaque-");
+        expect(JSON.stringify(completed.body)).not.toContain("private-session-");
+        yield* linkLocal(agent, first.id, "identity", account.id);
+        yield* linkLocal(agent, second.id, "identity", account.id);
+        const used = (app: string) => callLocalQuery(agent, app, "ids");
+        expect(yield* used(first.id)).toEqual([
+          { id: account.id, method: "paste", fields: { ref: "opaque-1" } },
+        ]);
+        expect(yield* used(second.id)).toEqual(yield* used(first.id));
+        const path = `/v1/accounts/${account.id}`;
+        const observations = () =>
+          agent
+            .send("GET", `${path}/observations?apps=%5B%5D`)
+            .pipe(Effect.flatMap((response) => body(Observation, response)));
+        const checked = yield* agent.send("POST", `${path}/health`, { apps: [] });
+        expect(checked.status, JSON.stringify(checked.body)).toBe(200);
+        const refresh = () => agent.send("POST", `${path}/observations/refresh`, { apps: [] });
+        const refreshed = yield* refresh();
+        expect(refreshed.status, JSON.stringify(refreshed.body)).toBe(200);
+        const saved = yield* body(Observation, refreshed);
+        expect(saved.reports).toHaveLength(1);
+        expect(saved.reports[0]?.source.kind).toBe("driver");
+        expect(saved.reports[0]?.source.id).toBe("synthetic-account-driver");
+        const health = yield* agent.send("GET", `${path}/health?apps=%5B%5D`);
+        expect(health.status, JSON.stringify(health.body)).toBe(200);
+        expect((yield* agent.send("DELETE", `/v1/apps/${manager.id}`)).status).toBe(200);
+        expect(yield* backend.removeCalls).toHaveLength(0);
+        yield* serverControl("restart");
+        expect(yield* observations()).toEqual(saved);
+        expect((yield* agent.send("GET", `${path}/health?apps=%5B%5D`)).body).toEqual(health.body);
+        expect(yield* used(second.id)).toEqual([
+          { id: account.id, method: "paste", fields: { ref: "opaque-1" } },
+        ]);
+
+        const reconnect = yield* connect(first.id, account.id);
+        expect((yield* start(reconnect)).status).toBe(200);
+        const reconnected = yield* submit(reconnect);
+        expect(reconnected.status, JSON.stringify(reconnected.body)).toBe(200);
+        expect((yield* body(Connected, reconnected)).account.id).toBe(account.id);
+        expect((yield* observations()).reports).toEqual([]);
+        expect(yield* used(second.id)).toEqual([
+          { id: account.id, method: "paste", fields: { ref: "opaque-2" } },
+        ]);
+        const hold = yield* backend.holdObservation;
+        const pending = yield* refresh().pipe(Effect.forkChild);
+        yield* hold.started;
+        const newer = yield* connect(first.id, account.id);
+        expect((yield* start(newer)).status).toBe(200);
+        expect((yield* submit(newer)).status).toBe(200);
+        yield* hold.release;
+        expect((yield* Fiber.join(pending)).status).toBe(200);
