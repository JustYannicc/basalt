@@ -0,0 +1,77 @@
+import { Console, Deferred, Effect, FileSystem, Path, Schema, Stream } from "effect";
+import { ChildProcess, ChildProcessSpawner } from "effect/process";
+import { HttpClient, HttpClientRequest } from "effect/http";
+import { accountDefinitionHostSource } from "./account-definition-host.ts";
+import { lockedNpmRegistry } from "./npm-registry.ts";
+
+const Ready = Schema.Struct({ port: Schema.Number });
+
+/** The SDK host owns its workerd, listener and storage for this one HTTP scenario. */
+export const accountDefinitionFixture = Effect.gen(function* () {
+  const fs = yield* FileSystem.FileSystem,
+    path = yield* Path.Path,
+    processes = yield* ChildProcessSpawner.ChildProcessSpawner,
+    http = yield* HttpClient.HttpClient;
+  const directory = yield* fs.makeTempDirectoryScoped({
+    directory: path.resolve(".local"),
+    prefix: "account-definition-",
+  });
+  const entry = path.join(directory, "host.ts");
+  yield* fs.writeFileString(entry, accountDefinitionHostSource);
+  const config = path.join(directory, "tsconfig.json");
+  yield* fs.writeFileString(
+    config,
+    JSON.stringify({
+      extends: path.resolve("tsconfig.json"),
+      compilerOptions: { typeRoots: [path.resolve("node_modules/@types")] },
+      files: [entry],
+      include: [],
+      exclude: [],
+    }),
+  );
+  const checked = yield* processes.exitCode(
+    ChildProcess.make(path.resolve("node_modules/.bin/tsc-rs"), ["--noEmit", "-p", config], {
+      stdout: "inherit",
+      stderr: "inherit",
+    }),
+  );
+  if (checked !== 0) return yield* Effect.die("Account definition SDK host failed its typecheck");
+  const registry = yield* lockedNpmRegistry;
+  const child = yield* processes.spawn(
+    ChildProcess.make("node", [entry], {
+      env: {
+        ...process.env,
+        DEFINITION_FIXTURE_DIRECTORY: directory,
+        DEFINITION_FIXTURE_REGISTRY: registry.url,
+        EXECUTOR_WORKER_BUNDLE: path.resolve(".local/test-runtime/host.json"),
+      },
+      stdout: "pipe",
+      stderr: "inherit",
+    }),
+  );
+  const listening = yield* Deferred.make<typeof Ready.Type, Error>();
+  yield* child.stdout.pipe(
+    Stream.decodeText(),
+    Stream.splitLines,
+    Stream.runForEach((line) =>
+      line.startsWith('{"port":')
+        ? Schema.decodeUnknownEffect(Schema.fromJsonString(Ready))(line).pipe(
+            Effect.flatMap((value) => Deferred.succeed(listening, value)),
+          )
+        : Console.error(line),
+    ),
+    Effect.ensuring(Deferred.fail(listening, new Error("Account definition host exited"))),
+    Effect.forkChild,
+  );
+  const { port } = yield* Deferred.await(listening);
+  const origin = `http://127.0.0.1:${port}`;
+  const post = (route: string, input: unknown) =>
+    Effect.gen(function* () {
+      const request = yield* HttpClientRequest.post(origin + route).pipe(
+        HttpClientRequest.bodyJson(input),
+      );
+      const response = yield* http.execute(request);
+      return { status: response.status, body: yield* response.json };
+    });
+  return { origin, post };
+});
diff --git a/e2e/support/account-definition-host.ts b/e2e/support/account-definition-host.ts
new file mode 100644
index 0000000..e036dbf
--- /dev/null
+++ b/e2e/support/account-definition-host.ts
@@ -0,0 +1,80 @@
+/** A real SDK/workerd host reached over HTTP, with synthetic credentials and a loopback provider. */
+export const accountDefinitionHostSource = `
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import * as Runtime from "@effect/platform-node/NodeRuntime";
+import { filesystemBlobStore, workerdApps } from "@executor-js/sdk/node";
+import { ProviderDefinition, toEffectRuntime, type BuiltApp } from "@executor-js/sdk/core";
+import { HostAccounts } from "apps/contracts";
+import { Console, Effect, Layer, Path, Redacted, Result, Schema } from "effect";
+import { FetchHttpClient, HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { createServer } from "node:http";
+
+Runtime.runMain(Effect.scoped(Effect.gen(function* () {
+  const path = yield* Path.Path;
+  const directory = process.env.DEFINITION_FIXTURE_DIRECTORY!;
+  const blobs = filesystemBlobStore({ directory: path.join(directory, "blobs") });
+  const host = yield* workerdApps({ directory: path.join(directory, "workerd"), blobs,
+    executor: Effect.never, npmRegistry: process.env.DEFINITION_FIXTURE_REGISTRY!,
+    allowPrivateAppFetch: true, encryptionKey: Redacted.make("b".repeat(64)) });
+  const runtime = toEffectRuntime(host.runtime, blobs);
+  const builds = new Map<string, BuiltApp>();
+  let reads = 0;
+  const Input = Schema.Struct({ build: Schema.String, slot: Schema.String,
+    mutation: Schema.optionalKey(Schema.Literals(["scope", "client", "identity", "family"])),
+    call: Schema.optionalKey(Schema.Boolean) });
+  const body = <A, I>(schema: Schema.Codec<A, I>) => HttpServerRequest.schemaBodyJson(schema);
+  const routes = Layer.mergeAll(
+    HttpRouter.add("POST", "/build", Effect.gen(function* () {
+      const input = yield* body(Schema.Struct({ files: Schema.NonEmptyArray(Schema.Struct({ path: Schema.String, content: Schema.String })) }));
+      const built = yield* runtime.build(input);
+      builds.set(built.build, built);
+      return yield* HttpServerResponse.json({ build: built.build });
+    })),
+    HttpRouter.add("POST", "/invoke", Effect.gen(function* () {
+      const input = yield* body(Input);
+      const built = builds.get(input.build);
+      if (built === undefined) return HttpServerResponse.empty({ status: 404 });
+      const selected = Object.fromEntries(Object.entries(built.requirements.accounts.user).map(([slot, required]) => {
+        let provider = Schema.decodeUnknownSync(ProviderDefinition)(required.definition);
+        const method = provider.auth.oauth;
+        if (slot === input.slot && method?.type === "oauth2" && method.grant !== "client_credentials") {
+          if (input.mutation === "scope") provider = { ...provider, auth: { ...provider.auth, oauth: { ...method, scopes: ["foreign-scope"] } } };
+          if (input.mutation === "client") provider = { ...provider, auth: { ...provider.auth, oauth: { ...method, tokenEndpointAuthMethod: "client_secret_basic" } } };
+          if (input.mutation === "identity") provider = { ...provider, auth: { ...provider.auth, oauth: { ...method, identity: { issuer: "https://foreign.example.test", name: "Foreign identity" } } } };
+          if (input.mutation === "family") provider = { ...provider, family: { id: "foreign", name: "Foreign family" } };
+        }
+        return [slot, { id: "acc_synthetic_" + slot, method: "oauth", generation: 7,
+          provider, fields: { access_token: "synthetic-client-a-" + slot, token_type: "Bearer" } }];
+      }));
+      const accounts = Schema.decodeUnknownSync(HostAccounts)({ app: {}, user: input.call ? selected : { [input.slot]: selected[input.slot] } });
+      const before = JSON.stringify(accounts);
+      const context = { app: "definition-fixture", build: built.build, caller: "synthetic-caller", accounts: Redacted.make(accounts) };
+      const result = yield* Effect.result(input.call
+        ? runtime.call({ ...context, database: false, tool: "read", kind: "query", input: {} })
+        : runtime.checkAccount({ ...context, requirement: input.slot }));
+      return yield* HttpServerResponse.json({
+        ok: Result.isSuccess(result),
+        ...(Result.isSuccess(result) ? { value: result.success } : { tag: result.failure._tag }),
+        retained: before === JSON.stringify(accounts),
+        definitions: Object.fromEntries(Object.entries(selected).map(([slot, account]) => [slot, account.provider])),
+        reads,
+      });
+    })),
+    HttpRouter.add("GET", "/provider/:slot", Effect.gen(function* () {
+      const request = yield* HttpServerRequest.HttpServerRequest;
+      const slot = new URL(request.url, "http://fixture").pathname.split("/").at(-1);
+      reads++;
+      return request.headers.authorization === "Bearer synthetic-client-a-" + slot
+        ? yield* HttpServerResponse.json({ subject: "synthetic-person", slot })
+        : HttpServerResponse.empty({ status: 401 });
+    })),
+  );
+  const services = yield* Layer.build(HttpRouter.serve(routes, { disableLogger: true, disableListenLog: true }).pipe(
+    Layer.provideMerge(NodeHttpServer.layer(createServer, { port: 0, host: "127.0.0.1" }))));
+  const listening = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+  if (!("port" in listening.address)) return yield* Effect.die("Expected TCP listener");
+  yield* Console.log(JSON.stringify({ port: listening.address.port }));
+  return yield* Effect.never;
+})).pipe(Effect.provide(NodeServices.layer), Effect.provide(FetchHttpClient.layer)));
+`;
