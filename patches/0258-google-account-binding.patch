diff --git a/e2e/tests/account-definition-projection.spec.ts b/e2e/tests/account-definition-projection.spec.ts
new file mode 100644
index 0000000..c28f7ea
--- /dev/null
+++ b/e2e/tests/account-definition-projection.spec.ts
@@ -0,0 +1,113 @@
+import { expect, it } from "@effect/vitest";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { Effect, Layer, Schema } from "effect";
+import { FetchHttpClient } from "effect/http";
+import { accountDefinitionFixture } from "../support/account-definition-fixture.ts";
+import { protocol26Framework } from "../support/app-package.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import definitions from "../fixtures/google-provider-declarations.json" with { type: "json" };
+
+const Built = Schema.Struct({ build: Schema.String });
+const Reply = Schema.Struct({
+  ok: Schema.Boolean,
+  tag: Schema.optionalKey(Schema.String),
+  value: Schema.optionalKey(Schema.Json),
+  retained: Schema.Boolean,
+  reads: Schema.Number,
+  definitions: Schema.Record(
+    Schema.String,
+    Schema.Struct({
+      family: Schema.Struct({ id: Schema.String, name: Schema.String }),
+      auth: Schema.Struct({
+        oauth: Schema.Struct({
+          identity: Schema.Struct({ issuer: Schema.String, name: Schema.String }),
+        }),
+      }),
+    }),
+  ),
+});
+
+// Credential-free OAuth declarations from the eleven-provider signed snapshot. Tokens and people are synthetic.
+const source = (origin: string, explicit: boolean, family: boolean) => {
+  const providers = definitions.map(
+    (definition, index) => `const service${index} = defineProvider({
+  name: ${JSON.stringify(definition.name)},
+  ${family ? `family: ${JSON.stringify(definition.added.family)},` : ""}
+  auth: { oauth: oauth2(${JSON.stringify({
+    ...definition.config,
+    ...(explicit ? { identity: definition.added.identity } : {}),
+  })}) },
+  async health({ account, fetch, signal }) {
+    const response = await fetch(${JSON.stringify(`${origin}/provider/service${index}`)}, {
+      signal, headers: { authorization: "Bearer " + account.fields.access_token },
+    });
+    if (!response.ok) throw new ProviderError({ reason: "unauthorized", status: response.status });
+    return { accountInfo: { externalId: "service${index}" } };
+  },
+});`,
+  );
+  return `import { defineApp, defineProvider, oauth2, ProviderError, object, query, router } from "apps";
+${providers.join("\n")}
+export default defineApp({ user: { accounts: {
+  ${definitions.map((_, index) => `service${index}`).join(", ")}
+} } }, async ({ user }) => ({ tools: router({
+  read: query({ input: object({}) }, async () => Object.keys(user?.accounts ?? {})),
+}) }));`;
+};
+
+it.live("host-added Google metadata preserves retained and current account-check definitions", () =>
+  Effect.gen(function* () {
+    expect(definitions).toHaveLength(11);
+    const fixture = yield* accountDefinitionFixture;
+    const retained = yield* protocol26Framework;
+    const invoke = (build: string, slot: string, extra: object = {}) =>
+      fixture.post("/invoke", { build, slot, ...extra }).pipe(
+        Effect.tap((response) =>
+          Effect.sync(() => expect(response.status, JSON.stringify(response.body)).toBe(200)),
+        ),
+        Effect.flatMap((response) => Schema.decodeUnknownEffect(Reply)(response.body)),
+      );
+    for (const framework of [retained, undefined]) {
+      for (const explicit of [false, true]) {
+        const manifest =
+          framework === undefined
+            ? appsManifest
+            : {
+                path: "package.json",
+                content: JSON.stringify({ dependencies: { apps: framework } }),
+              };
+        const response = yield* fixture.post("/build", {
+          files: [
+            manifest,
+            {
+              path: "index.ts",
+              content: source(fixture.origin, explicit, framework === undefined && explicit),
+            },
+          ],
+        });
+        expect(response.status, JSON.stringify(response.body)).toBe(200);
+        const { build } = yield* Schema.decodeUnknownEffect(Built)(response.body);
+        for (const [index, definition] of definitions.entries()) {
+          const slot = `service${index}`;
+          const checked = yield* invoke(build, slot);
+          expect(checked.ok, `${definition.name}: ${JSON.stringify(checked)}`).toBe(true);
+          expect(checked.value).toMatchObject({ accountInfo: { externalId: slot } });
+          expect(checked.retained).toBe(true);
+          expect(checked.definitions[slot]?.family).toEqual(definition.added.family);
+          expect(checked.definitions[slot]?.auth.oauth.identity).toEqual(definition.added.identity);
+        }
+        const called = yield* invoke(build, "service0", { call: true });
+        expect(called.ok, JSON.stringify(called)).toBe(true);
+        expect(called.value).toHaveLength(11);
+        for (const mutation of ["scope", "client", "identity", "family"]) {
+          const refused = yield* invoke(build, "service0", { mutation });
+          expect(refused.ok, `${mutation}: ${JSON.stringify(refused)}`).toBe(false);
+          expect(refused.tag).toBe("HostAccountsInvalid");
+          expect(refused.retained).toBe(true);
+          expect(refused.reads).toBe(called.reads);
+        }
