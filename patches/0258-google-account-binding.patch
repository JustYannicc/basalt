+import { Effect } from "effect";
+import type {
+  DeclaredProvider,
+  DeclaredRequirements,
+  HostAccount,
+  HostAccounts,
+  HostAccountSlots,
+} from "apps/contracts";
+import { oauthAccountFamily, oauthIdentityDefaults } from "../contracts/oauth-families.ts";
+
+type Selected = HostAccountSlots[string];
+const isMany = (value: Selected): value is Extract<Selected, ReadonlyArray<unknown>> =>
+  Array.isArray(value);
+
+const inferredFamily = (provider: DeclaredProvider) =>
+  Object.values(provider.auth).flatMap((method) => {
+    const family = oauthAccountFamily(method);
+    return family === undefined ? [] : [family];
+  })[0];
+
+/** Undo only the defaults the host added; every credential-relevant field still reaches binding. */
+const projectProvider = (supplied: DeclaredProvider, declared: DeclaredProvider) => {
+  const inferred = inferredFamily(declared);
+  const family =
+    declared.family === undefined &&
+    inferred !== undefined &&
+    supplied.family?.id === inferred.id &&
+    supplied.family.name === inferred.name &&
+    supplied.family.methods === undefined
+      ? undefined
+      : supplied.family;
+  const { family: _family, ...rest } = supplied;
+  return {
+    ...rest,
+    ...(family === undefined ? {} : { family }),
+    auth: Object.fromEntries(
+      Object.entries(supplied.auth).map(([name, method]) => {
+        const original = Object.hasOwn(declared.auth, name) ? declared.auth[name] : undefined;
+        if (
+          original?.type !== "oauth2" ||
+          original.grant === "client_credentials" ||
+          original.identity !== undefined ||
+          method.type !== "oauth2" ||
+          method.grant === "client_credentials"
+        )
+          return [name, method];
+        const normalized = oauthIdentityDefaults(original);
+        if (
+          normalized.type !== "oauth2" ||
+          normalized.grant === "client_credentials" ||
+          normalized.identity === undefined ||
+          method.identity?.issuer !== normalized.identity.issuer ||
+          method.identity.name !== normalized.identity.name
+        )
+          return [name, method];
+        const { identity: _identity, ...credential } = method;
+        return [name, credential];
+      }),
+    ),
+  };
+};
+
+const accountsOf = (slots: HostAccountSlots) =>
+  Object.values(slots).flatMap((selected) => (isMany(selected) ? selected : [selected]));
+const hasDefaults = (account: HostAccount) => {
+  const provider = account.provider;
+  return (
+    inferredFamily(provider) !== undefined &&
+    (provider.family !== undefined ||
+      Object.values(provider.auth).some(
+        (method) =>
+          method.type === "oauth2" &&
+          method.grant !== "client_credentials" &&
+          method.identity !== undefined,
+      ))
+  );
+};
+
+/** Immutable declarations only, bounded per runner. No credentials or cross-request promises. */
+export const makeBuildAccountProjection = () => {
+  const declarations = new Map<string, DeclaredRequirements>();
+  return <E, R>(
+    build: string,
+    accounts: HostAccounts,
+    read: Effect.Effect<DeclaredRequirements, E, R>,
+  ): Effect.Effect<HostAccounts, E, R> =>
+    Effect.gen(function* () {
+      if (![...accountsOf(accounts.app), ...accountsOf(accounts.user ?? {})].some(hasDefaults))
+        return accounts;
+      let declared = declarations.get(build);
+      if (declared === undefined) {
+        declared = yield* read;
+        declarations.set(build, declared);
+        if (declarations.size > 4096) {
+          const oldest = declarations.keys().next();
+          if (!oldest.done) declarations.delete(oldest.value);
+        }
+      }
+      const requirements = declared.accounts;
+      const projectScope = (scope: "app" | "user", slots: HostAccountSlots) =>
+        Object.fromEntries(
+          Object.entries(slots).map(([slot, selected]) => {
+            const definition = Object.hasOwn(requirements[scope], slot)
+              ? requirements[scope][slot]?.definition
+              : undefined;
+            if (definition === undefined) return [slot, selected];
+            const project = (account: HostAccount): HostAccount => ({
+              ...account,
+              provider: projectProvider(account.provider, definition),
+            });
+            return [slot, isMany(selected) ? selected.map(project) : project(selected)];
+          }),
+        );
+      return {
+        app: projectScope("app", accounts.app),
+        ...(accounts.user === undefined ? {} : { user: projectScope("user", accounts.user) }),
+      };
+    });
+};
