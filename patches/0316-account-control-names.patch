diff --git a/e2e/tests/account-dialog-naming.spec.ts b/e2e/tests/account-dialog-naming.spec.ts
new file mode 100644
index 0000000..4e14353
--- /dev/null
+++ b/e2e/tests/account-dialog-naming.spec.ts
@@ -0,0 +1,109 @@
+/** An unnamed API key's own controls name it as its row does, never by its generated label. */
+import { expect, layer } from "@effect/vitest";
+import { Effect } from "effect";
+import { Browser } from "../support/browser.ts";
+import { Evidence } from "../support/evidence.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { observationFixture } from "../support/account-observation-fixture.ts";
+import { scenarios } from "../test-plan.ts";
+
+const title = "Unnamed key service API key";
+
+layer(HostedLive, { excludeTestServices: true })("Account dialog naming", (it) => {
+  it.effect(scenarios.accountDialogNaming.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const browser = yield* Browser;
+        const evidence = yield* Evidence;
+        // Saved without a name and reporting nothing, as most keys are: its label is "Default".
+        const key = yield* observationFixture({
+          name: "Unnamed key fixture",
+          providerName: "Unnamed key service",
+          observe: false,
+          health: false,
+          family: {
+            id: "dialog-naming-key",
+            name: "Dialog naming key",
+            methods: { key: { mechanism: "api-key" } },
+          },
+        });
+        yield* browser.login(key.actors.owner);
+        const accounts = `/org/${key.actors.organization.slug}/accounts`;
+        const appTab = `/org/${key.actors.organization.slug}/apps/${key.app.id}?view=accounts`;
+        for (const width of [1280, 390]) {
+          // Found by its visible title rather than its menu, whose name is what this reads.
+          const read = yield* browser.use(
+            `Read the key's menu and dialog at ${width}px`,
+            (page) => {
+              const row = page.locator(".inventory-row").filter({ hasText: title });
+              const menu = row.getByRole("button", { name: /^Manage / });
+              const dialog = page.getByRole("dialog", { name: "Delete account?", exact: true });
+              const kind = dialog.getByText(/^Unnamed key service · /);
+              return page
+                .setViewportSize({ width, height: 900 })
+                .then(() => page.goto(accounts))
+                .then(() => menu.waitFor())
+                .then(() =>
+                  Promise.all([
+                    menu.getAttribute("aria-label"),
+                    page.getByRole("button", { name: /^Manage Default( \d+)?$/ }).count(),
+                  ]),
+                )
+                .then(([name, generated]) =>
+                  menu
+                    .click()
+                    .then(() =>
+                      page.getByRole("menuitem", { name: "Delete account", exact: true }).click(),
+                    )
+                    .then(() => kind.waitFor())
+                    .then(() =>
+                      Promise.all([
+                        dialog.evaluate(
+                          (node) =>
+                            document.getElementById(node.getAttribute("aria-describedby") ?? "")
+                              ?.textContent ?? "",
+                        ),
+                        kind.innerText(),
+                      ]),
+                    )
+                    .then(([description, method]) => ({ name, generated, description, method })),
+                );
+            },
+          );
+          // Captured before the check, so a failing run still shows the dialog it read.
+          yield* evidence.attach(
+            `dialog-naming-delete-${width}.png`,
+            "image/png",
+            yield* browser.use("Capture the key's Delete dialog", (page) =>
+              page.screenshot({ fullPage: true }),
+            ),
+          );
+          expect(read).toEqual({
+            name: `Manage ${title}`,
+            generated: 0,
+            description: "Delete this saved account and its credentials.",
+            method: "Unnamed key service · API key",
+          });
+          yield* browser.use("Cancel without deleting", (page) =>
+            page
+              .getByRole("dialog", { name: "Delete account?", exact: true })
+              .getByRole("button", { name: "Cancel", exact: true })
+              .click(),
+          );
+          // The key's app tab names its menu the same way.
+          const tabbed = yield* browser.use(`Read the key's app tab menu at ${width}px`, (page) => {
+            const menu = page
+              .getByRole("region", { name: "Your accounts", exact: true })
+              .getByRole("button", { name: /^Manage / });
+            return page
+              .goto(appTab)
+              .then(() => menu.first().waitFor())
+              .then(() => menu.first().getAttribute("aria-label"));
+          });
+          expect(tabbed).toBe(`Manage ${title}`);
+        }
+      }),
+    ),
+  );
+});
