--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/workflow-diagram-viewport.ts
@@ -0,0 +1,226 @@
+import {
+  useEffect,
+  useRef,
+  useState,
+  type RefObject,
+  type PointerEvent,
+  type KeyboardEvent,
+  type FocusEvent,
+} from "react";
+
+const MIN_ZOOM = 0.25;
+const MAX_ZOOM = 1.75;
+const PADDING = 28;
+const clamp = (value: number, low: number, high: number) => Math.min(high, Math.max(low, value));
+
+/** Keeps zoom anchored at the pointer and lets page scrolling resume at the canvas edges. */
+export function useWorkflowViewport(
+  frame: RefObject<HTMLDivElement | null>,
+  bounds: { readonly width: number; readonly height: number },
+  clear: () => void,
+) {
+  const [view, setView] = useState({ x: 0, y: PADDING, zoom: 1 });
+  const moved = useRef(false);
+  const drag = useRef<{ id: number; x: number; y: number; origin: typeof view } | undefined>(
+    undefined,
+  );
+  const constrain = (current: typeof view) => constrainView(current, frame.current, bounds);
+  const fit = () => {
+    if (!frame.current) return;
+    moved.current = false;
+    setView(fittedView(frame.current, bounds));
+  };
+  useEffect(() => {
+    const element = frame.current;
+    if (!element) return;
+    const resize = new ResizeObserver(() => {
+      if (!moved.current) setView(fittedView(element, bounds));
+      else setView((current) => constrainView(current, element, bounds));
+    });
+    resize.observe(element);
+    return () => resize.disconnect();
+  }, [frame, bounds]);
+  const zoom = (factor: number, clientX?: number, clientY?: number) => {
+    const element = frame.current;
+    if (!element) return;
+    const rect = element.getBoundingClientRect();
+    const x = clientX === undefined ? rect.width / 2 : clientX - rect.left;
+    const y = clientY === undefined ? rect.height / 2 : clientY - rect.top;
+    moved.current = true;
+    setView((current) => zoomedView(current, factor, x, y, element, bounds));
+  };
+  useEffect(() => {
+    const element = frame.current;
+    if (!element) return;
+    const wheel = (event: WheelEvent) => {
+      if (event.ctrlKey || event.metaKey) {
+        event.preventDefault();
+        const rect = element.getBoundingClientRect();
+        moved.current = true;
+        setView((current) =>
+          zoomedView(
+            current,
+            Math.exp(-event.deltaY * 0.0025),
+            event.clientX - rect.left,
+            event.clientY - rect.top,
+            element,
+            bounds,
+          ),
+        );
+        return;
+      }
+      const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? element.clientHeight : 1;
+      const next = constrainView(
+        {
+          ...view,
+          x: view.x - event.deltaX * unit,
+          y: view.y - event.deltaY * unit,
+        },
+        element,
+        bounds,
+      );
+      if (next.x === view.x && next.y === view.y) return;
+      event.preventDefault();
+      moved.current = true;
+      setView(next);
+    };
+    element.addEventListener("wheel", wheel, { passive: false });
+    return () => element.removeEventListener("wheel", wheel);
+  }, [frame, view, bounds]);
+  const end = (event: PointerEvent<HTMLDivElement>) => {
+    if (drag.current?.id !== event.pointerId) return;
+    const finished = drag.current;
+    drag.current = undefined;
+    if (
+      event.type === "pointerup" &&
+      Math.hypot(event.clientX - finished.x, event.clientY - finished.y) < 3
+    )
+      clear();
+    if (event.currentTarget.hasPointerCapture(event.pointerId))
+      event.currentTarget.releasePointerCapture(event.pointerId);
+  };
+  return {
+    view,
+    fit,
+    zoom,
+    handlers: {
+      onFocusCapture: (event: FocusEvent<HTMLDivElement>) => {
+        const target = event.target;
+        if (!target.matches("[data-workflow-node]")) return;
+        const viewport = event.currentTarget.getBoundingClientRect();
+        const card = target.getBoundingClientRect();
+        const shift = (start: number, end: number, low: number, high: number) =>
+          start < low ? low - start : end > high ? high - end : 0;
+        const dx = shift(card.left, card.right, viewport.left + PADDING, viewport.right - PADDING);
+        const dy = shift(
+          card.top,
+          card.bottom,
+          viewport.top + PADDING,
+          viewport.bottom - PADDING - 36,
+        );
+        if (!dx && !dy) return;
+        moved.current = true;
+        setView((current) => constrain({ ...current, x: current.x + dx, y: current.y + dy }));
+      },
+      onPointerDown: (event: PointerEvent<HTMLDivElement>) => {
+        if (
+          event.button !== 0 ||
+          !(event.target instanceof Element) ||
+          event.target.closest("button, a, [data-workflow-node], [data-canvas-control]")
+        )
+          return;
+        event.currentTarget.setPointerCapture(event.pointerId);
+        drag.current = { id: event.pointerId, x: event.clientX, y: event.clientY, origin: view };
+      },
+      onPointerMove: (event: PointerEvent<HTMLDivElement>) => {
+        const current = drag.current;
+        if (current?.id !== event.pointerId) return;
+        const dx = event.clientX - current.x,
+          dy = event.clientY - current.y;
+        if (Math.hypot(dx, dy) < 3) return;
+        moved.current = true;
+        setView(
+          constrain({ ...current.origin, x: current.origin.x + dx, y: current.origin.y + dy }),
+        );
+      },
+      onPointerUp: end,
+      onPointerCancel: end,
+      onKeyDown: (event: KeyboardEvent<HTMLDivElement>) => {
+        if (event.key === "Escape") {
+          clear();
+          event.preventDefault();
+          return;
+        }
+        if (event.target !== event.currentTarget) return;
+        if (event.key === "+" || event.key === "=") zoom(1.2);
+        else if (event.key === "-") zoom(1 / 1.2);
+        else if (event.key === "0") fit();
+        else if (["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(event.key)) {
+          moved.current = true;
+          setView((current) =>
+            constrain({
+              ...current,
+              x:
+                current.x + (event.key === "ArrowLeft" ? 80 : event.key === "ArrowRight" ? -80 : 0),
+              y: current.y + (event.key === "ArrowUp" ? 80 : event.key === "ArrowDown" ? -80 : 0),
+            }),
+          );
+        } else return;
+        event.preventDefault();
+      },
+    },
+  };
+}
+
+interface View {
+  readonly x: number;
+  readonly y: number;
+  readonly zoom: number;
+}
+interface Bounds {
+  readonly width: number;
+  readonly height: number;
+}
+
+function constrainView(current: View, element: HTMLDivElement | null, bounds: Bounds): View {
+  if (!element) return current;
+  const width = bounds.width * current.zoom,
+    height = bounds.height * current.zoom;
+  return {
+    ...current,
+    x:
+      width <= element.clientWidth - PADDING * 2
+        ? (element.clientWidth - width) / 2
+        : clamp(current.x, element.clientWidth - width - PADDING, PADDING),
+    y:
+      height <= element.clientHeight - PADDING * 2
+        ? (element.clientHeight - height) / 2
+        : clamp(current.y, element.clientHeight - height - PADDING, PADDING),
+  };
+}
+
+function fittedView(element: HTMLDivElement, bounds: Bounds): View {
+  const zoom = clamp(Math.min(1, (element.clientWidth - PADDING * 2) / bounds.width), 0.45, 1);
+  return constrainView(
+    { x: (element.clientWidth - bounds.width * zoom) / 2, y: PADDING, zoom },
+    element,
+    bounds,
+  );
+}
+
+function zoomedView(
+  current: View,
+  factor: number,
+  x: number,
+  y: number,
+  element: HTMLDivElement,
+  bounds: Bounds,
+): View {
+  const zoom = clamp(current.zoom * factor, MIN_ZOOM, MAX_ZOOM);
+  const ratio = zoom / current.zoom;
+  return constrainView(
+    { zoom, x: x - (x - current.x) * ratio, y: y - (y - current.y) * ratio },
+    element,
+    bounds,
+  );
+}
