+++ b/apps/hosted/server/src/implementation/workflow-confirmations.ts
@@ -0,0 +1,167 @@
+import { Effect, Schema } from "effect";
+import type { SqlClient } from "effect/sql";
+import {
+  AccountId,
+  AppCallsHost,
+  AppConfirmationView,
+  AppConnection,
+  AppId,
+  StorageError,
+  type AppConfirmationChange,
+} from "@executor-js/sdk/core";
+import { CurrentPrincipal, CurrentUserId } from "../contracts/auth.ts";
+import {
+  CurrentOrganization,
+  OrganizationForbidden,
+  OrganizationId,
+} from "../contracts/organization.ts";
+import { HostedExecutor } from "../contracts/executor.ts";
+import { browserOnly } from "./access.ts";
+import { policyDatabase, requireAccountAccess, requireAppAccess } from "./resource-policy.ts";
+import { recordToolPolicyChange, toolPolicyHistory } from "./tool-policy-store.ts";
+import { ToolPolicyConflict, WorkflowPolicyChange } from "../contracts/tool-policies.ts";
+
+export const confirmationHistoryId = (id: string) => `confirmation:${id}`;
+/** The SDK invokes this inside the transaction that has already written the encrypted payload. */
+export const confirmationChanged = (sql: SqlClient.SqlClient) => (event: AppConfirmationChange) =>
+  Effect.gen(function* () {
+    if (!event.owner.startsWith("organization:")) return yield* new StorageError();
+    const organization = OrganizationId.make(event.owner.slice("organization:".length));
+    yield* recordToolPolicyChange(sql, {
+      organization,
+      id: confirmationHistoryId(event.connection.id),
+      actor: event.actor,
+      action:
+        event.current === undefined
+          ? "cleared"
+          : event.previous === undefined
+            ? "installed"
+            : "replaced",
+      snapshot: {
+        app: event.app,
+        connection: event.connection,
+        ...(event.previous === undefined ? {} : { previous: event.previous }),
+        ...(event.current === undefined ? {} : { current: event.current }),
+      },
+    });
+  });
+
+export const listWorkflowConfirmations = Effect.gen(function* () {
+  const executor = yield* Effect.flatten(HostedExecutor);
+  const { owner } = yield* CurrentOrganization;
+  const apps = yield* executor.apps.list({ owner });
+  const pages = yield* Effect.forEach(apps, (app) =>
+    executor[AppCallsHost].confirmations.list({ app: app.id, owner }).pipe(
+      Effect.map((page) => page.items),
+      Effect.catchTag("AppConnectionRefused", () => Effect.succeed([])),
+    ),
+  );
+  return (yield* Effect.forEach(pages.flat(), (view) =>
+    requireConfirmationHistoryAccess({
+      app: view.app,
+      connection: view.connection,
+      current: view.confirmation,
+    }).pipe(
+      Effect.as([view]),
+      Effect.catchTag("OrganizationForbidden", () => Effect.succeed([])),
+    ),
+  )).flat();
+});
+
+const HistoricalConfirmation = Schema.Struct({
+  app: AppId,
+  connection: AppConnection,
+  previous: Schema.optionalKey(AppConfirmationView.fields.confirmation),
+  current: Schema.optionalKey(AppConfirmationView.fields.confirmation),
+});
+const requireConfirmationHistoryAccess = (snapshot: typeof HistoricalConfirmation.Type) =>
+  Effect.gen(function* () {
+    yield* requireAppAccess(snapshot.app, snapshot.connection.scope === "app" ? "manage" : "use");
+    const confirmation = snapshot.current ?? snapshot.previous;
+    if (confirmation === undefined) return yield* new OrganizationForbidden();
+    for (const version of confirmation.accountVersions)
+      yield* requireAccountAccess(AccountId.make(version.account), "manage");
+  });
+export const listWorkflowConfirmationChanges = Effect.gen(function* () {
+  const { organization } = yield* CurrentOrganization;
+  const sql = yield* policyDatabase;
+  const rows =
+    yield* sql`select distinct on (h.policy_id) h.policy_id as id, h.sequence::text as cursor,
+    h.actor, coalesce(u.name, h.actor) as "actorName", h.action, h.snapshot,
+    extract(epoch from h.changed_at)::double precision * 1000 as at
+    from hosted_tool_policy_history h left join "user" u on u.id = h.actor
+    where h.organization_id = ${organization} and h.policy_id like 'confirmation:%'
+    order by h.policy_id, h.sequence desc`;
+  const changes = yield* Schema.decodeUnknownEffect(Schema.Array(WorkflowPolicyChange))(rows).pipe(
+    Effect.mapError(() => new StorageError()),
+  );
+  return (yield* Effect.forEach(changes, (change) =>
+    Effect.gen(function* () {
+      const snapshot = yield* Schema.decodeUnknownEffect(HistoricalConfirmation)(
+        change.snapshot,
+      ).pipe(Effect.mapError(() => new StorageError()));
+      yield* requireConfirmationHistoryAccess(snapshot);
+      return [change];
+    }).pipe(Effect.catchTag("OrganizationForbidden", () => Effect.succeed([]))),
+  )).flat();
+}).pipe(Effect.catchTag("SqlError", () => new StorageError()));
+export const readWorkflowConfirmationHistory = (id: string, after?: string) =>
+  Effect.gen(function* () {
+    const { organization } = yield* CurrentOrganization;
+    const sql = yield* policyDatabase;
+    const rows = yield* sql`select snapshot from hosted_tool_policy_history
+    where organization_id = ${organization} and policy_id = ${id} order by sequence desc limit 1`;
+    const latest = yield* Schema.decodeUnknownEffect(
+      Schema.Array(Schema.Struct({ snapshot: HistoricalConfirmation })),
+    )(rows).pipe(Effect.mapError(() => new StorageError()));
+    const snapshot = latest[0]?.snapshot;
+    if (snapshot === undefined) return yield* new OrganizationForbidden();
+    yield* requireConfirmationHistoryAccess(snapshot);
+    const page = yield* toolPolicyHistory(sql, organization, id, after);
+    const items = (yield* Effect.forEach(page.items, (entry) =>
+      Effect.gen(function* () {
+        const snapshot = yield* Schema.decodeUnknownEffect(HistoricalConfirmation)(
+          entry.snapshot,
+        ).pipe(Effect.mapError(() => new StorageError()));
+        yield* requireConfirmationHistoryAccess(snapshot);
+        return [entry];
+      }).pipe(Effect.catchTag("OrganizationForbidden", () => Effect.succeed([]))),
+    )).flat();
+    return { ...page, items };
+  }).pipe(Effect.catchTag("SqlError", () => new StorageError()));
+
+export const revokeWorkflowConfirmation = (input: {
+  readonly app: AppId;
+  readonly dependency: string;
+  readonly scope: "app" | "user";
+  readonly revision: number;
+  readonly fingerprint: string;
+}) =>
+  Effect.gen(function* () {
+    yield* browserOnly;
+    const principal = yield* CurrentPrincipal;
+    if (principal.userId !== (yield* CurrentUserId)) return yield* new OrganizationForbidden();
+    const executor = yield* Effect.flatten(HostedExecutor);
+    const { owner } = yield* CurrentOrganization;
+    const listed = yield* executor[AppCallsHost].confirmations
+      .list({ app: input.app, owner })
+      .pipe(Effect.catchTag("AppConnectionRefused", () => new OrganizationForbidden()));
+    const current = listed.items.find(
+      (view) =>
+        view.connection.dependency === input.dependency &&
+        view.connection.scope === input.scope &&
+        view.connection.revision === input.revision &&
+        view.fingerprint === input.fingerprint,
+    );
+    if (current === undefined) return yield* new ToolPolicyConflict();
+    yield* requireConfirmationHistoryAccess({
+      app: current.app,
+      connection: current.connection,
+      current: current.confirmation,
+    });
+    // The SDK locks and compares this same fingerprint again before clearing it.
+    return yield* executor[AppCallsHost].confirmations.revoke({ ...input, owner }).pipe(
+      Effect.catchTag("AppConnectionConflict", () => new ToolPolicyConflict()),
+      Effect.catchTag("AppConnectionRefused", () => new OrganizationForbidden()),
+    );
+  });
diff --git a/apps/hosted/web/src/contracts/tool-policies.ts b/apps/hosted/web/src/contracts/tool-policies.ts
new file mode 100644
index 00000000..fe6037fc
--- /dev/null
+++ b/apps/hosted/web/src/contracts/tool-policies.ts
@@ -0,0 +1,114 @@
+import { hydrated } from "@executor-js/ui/contracts/http";
+import { revalidated } from "@executor-js/ui/contracts/refresh";
+import { acknowledge, acknowledgedQuery } from "@executor-js/ui/contracts/mutations";
+import { Atom } from "effect/reactivity";
+import { Data, Effect } from "effect";
+import type { AppId } from "@executor-js/sdk";
+import type { OrganizationReference } from "@executor-js/hosted-server/organization";
+import type { ToolPolicyValues } from "@executor-js/hosted-server/tool-policies";
+import { HostedClient } from "./api.ts";
+import { protectedQuery } from "./protected-query.ts";
+
+export const toolPoliciesAtom = Atom.family((organization: OrganizationReference) =>
+  HostedClient.query("toolPolicies", "list", hydrated({ params: { organization } })).pipe(
+    revalidated,
+    acknowledgedQuery,
+    protectedQuery,
+  ),
+);
+class HistoryKey extends Data.Class<{
+  readonly organization: OrganizationReference;
+  readonly policy: string;
+  readonly after?: string;
+}> {}
+const history = Atom.family((key: HistoryKey) =>
+  HostedClient.query(
+    "toolPolicies",
+    "history",
+    hydrated({
+      params: { organization: key.organization, policy: key.policy },
+      query: key.after === undefined ? {} : { after: key.after },
+    }),
+  ).pipe(revalidated, protectedQuery),
+);
+export const toolPolicyHistoryAtom = (key: {
+  organization: OrganizationReference;
+  policy: string;
+  after?: string;
+}) => history(new HistoryKey(key));
+
+export const saveToolPolicyAtom = Atom.family((organization: OrganizationReference) =>
+  HostedClient.runtime.fn(
+    (input: ToolPolicyValues & { readonly id?: string; readonly revision?: number }, get) =>
+      Effect.flatMap(HostedClient, (client) =>
+        input.id === undefined
+          ? client.toolPolicies.create({ params: { organization }, payload: input })
+          : client.toolPolicies.update({
+              params: { organization, policy: input.id },
+              payload: { ...input, revision: input.revision ?? 0 },
+            }),
+      ).pipe(
+        Effect.tap((saved) =>
+          Effect.sync(() => {
+            acknowledge(get, toolPoliciesAtom(organization), (current) => ({
+              ...current,
+              policies: [
+                ...current.policies.filter((rule) => rule.id !== saved.id),
+                { ...saved, canEdit: true },
+              ],
+            }));
+            get.refresh(toolPolicyHistoryAtom({ organization, policy: saved.id }));
+          }),
+        ),
+        Effect.tapError(() => Effect.sync(() => get.refresh(toolPoliciesAtom(organization)))),
+      ),
+  ),
+);
+
+export const revokeToolPolicyAtom = Atom.family((organization: OrganizationReference) =>
+  HostedClient.runtime.fn((input: { readonly id: string; readonly revision: number }, get) =>
+    Effect.flatMap(HostedClient, (client) =>
+      client.toolPolicies.revoke({
+        params: { organization, policy: input.id },
+        query: { revision: input.revision },
+      }),
+    ).pipe(
+      Effect.tap((saved) =>
+        Effect.sync(() => {
+          acknowledge(get, toolPoliciesAtom(organization), (current) => ({
+            ...current,
+            policies: current.policies.map((rule) =>
+              rule.id === saved.id ? { ...saved, canEdit: true } : rule,
+            ),
+          }));
+          get.refresh(toolPolicyHistoryAtom({ organization, policy: saved.id }));
+        }),
+      ),
+      Effect.tapError(() => Effect.sync(() => get.refresh(toolPoliciesAtom(organization)))),
+    ),
+  ),
+);
+
+export const revokeWorkflowPolicyAtom = Atom.family((organization: OrganizationReference) =>
+  HostedClient.runtime.fn(
+    (
+      input: {
+        readonly app: AppId;
+        readonly dependency: string;
+        readonly scope: "app" | "user";
+        readonly revision: number;
+        readonly fingerprint: string;
+      },
+      get,
+    ) =>
+      Effect.flatMap(HostedClient, (client) =>
+        client.toolPolicies.revokeConfirmation({
+          params: { organization, app: input.app, dependency: input.dependency },
+          payload: input,
+        }),
+      ).pipe(
+        Effect.tap(() => Effect.sync(() => get.refresh(toolPoliciesAtom(organization)))),
+        Effect.tapError(() => Effect.sync(() => get.refresh(toolPoliciesAtom(organization)))),
+      ),
+  ),
+);
