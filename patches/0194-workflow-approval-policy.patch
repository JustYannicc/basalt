@@ -0,0 +1,37 @@
+import type { Effect } from "effect";
+import type {
+  AccountId,
+  AppId,
+  BuildId,
+  Json,
+  OwnerId,
+  StorageError,
+  VersionId,
+} from "./shared.ts";
+
+export type ToolPolicyDecision = "approved" | "denied" | "user-approval" | "failed";
+/** The normal invocation snapshot supplies identity; the native host supplies decoded input and kind. */
+export interface ToolPolicyEvent {
+  readonly app: AppId;
+  readonly owner: OwnerId;
+  readonly version: VersionId;
+  readonly build: BuildId;
+  readonly actor?: string;
+  readonly accounts: readonly {
+    readonly account: AccountId;
+    readonly owner: OwnerId;
+    readonly credentialGeneration: number;
+  }[];
+  readonly tool: string;
+  readonly kind: "query" | "mutation";
+  readonly input: Json;
+  readonly decision: ToolPolicyDecision;
+}
+/** A matched ask is terminal. No match alone permits evaluation of workflow confirmation. */
+export type ToolPolicyHook = (event: ToolPolicyEvent) => Effect.Effect<
+  {
+    readonly matched: boolean;
+    readonly decision: ToolPolicyDecision;
+  },
+  StorageError
+>;
diff --git a/packages/sdk/src/implementation/tool-policy.ts b/packages/sdk/src/implementation/tool-policy.ts
new file mode 100644
index 00000000..46c71fb1
--- /dev/null
+++ b/packages/sdk/src/implementation/tool-policy.ts
@@ -0,0 +1,104 @@
+import { Effect } from "effect";
+import { AppCallFailed, type AppToolPolicyHost, type WorkflowHostControls } from "apps/contracts";
+import type { ToolPolicyHook } from "../contracts/tool-policy.ts";
+import type { InvocationSnapshot } from "./tools.ts";
+import { Validator } from "@cfworker/json-schema";
+import draft7Schema from "ajv/dist/refs/json-schema-draft-07.json" with { type: "json" };
+import type { Json, JsonObject } from "../contracts/shared.ts";
+
+const metaSchema: JsonObject = draft7Schema;
+const constraintSchema = new Validator(metaSchema, "7", false);
+
+const StandingPolicy = Symbol("executor.StandingToolPolicy");
+type Controls = WorkflowHostControls & { readonly [StandingPolicy]?: AppToolPolicyHost };
+
+/** Bound inside makeTools, before app code, with the actual selected saved accounts. */
+export const bindToolPolicy = (
+  controls: WorkflowHostControls,
+  state: InvocationSnapshot,
+  policy: ToolPolicyHook,
+): Controls => ({
+  ...controls,
+  [StandingPolicy]: (command) =>
+    policy({
+      app: state.app.id,
+      owner: state.app.owner,
+      version: state.version.id,
+      build: state.version.build,
+      ...(state.actor === undefined ? {} : { actor: state.actor }),
+      accounts: [
+        ...new Map(
+          state.selections.flatMap((selection) =>
+            selection.accounts.map(
+              (account) =>
+                [
+                  account.id,
+                  {
+                    account: account.id,
+                    owner: account.owner,
+                    credentialGeneration: account.credentialGeneration,
+                  },
+                ] as const,
+            ),
+          ),
+        ).values(),
+      ],
+      tool: command.tool,
+      kind: command.kind,
+      input: command.input,
+      decision: command.decision,
+    }).pipe(
+      Effect.map((result) => ({ decision: result.decision, matched: result.matched })),
+      Effect.mapError(() => new AppCallFailed({ reason: "denied", retryable: false })),
+    ),
+});
+
+/** Compose once at the existing private native-host callback, before workflow-specific consent. */
+export const composedToolPolicy =
+  (controls: WorkflowHostControls, fallback: AppToolPolicyHost): AppToolPolicyHost =>
+  (command) =>
+    Effect.gen(function* () {
+      if (command.decision === "denied" || command.decision === "failed")
+        return { decision: command.decision };
+      const standing = (controls as Controls)[StandingPolicy];
+      if (standing !== undefined) {
+        // `matched` remains host-local. It is never read from a public command or app response.
+        const result = yield* standing(command);
+        if ("matched" in result && result.matched === true) {
+          if (result.decision !== "approved") return { decision: result.decision };
+          // Approved general policy skips workflow attachment, but the dispatcher still owns
+          // finalization, including its durable receipt fence before any protected effect.
+          return yield* fallback({ ...command, decision: "approved" });
+        }
+      }
+      return yield* fallback(command);
+    });
+
+export const matchesToolPolicyInput = (
+  constraint: JsonObject | undefined,
+  input: Json,
+): boolean => {
+  if (constraint === undefined) return true;
+  try {
+    return new Validator(constraint, "7", false).validate(input).valid;
+  } catch {
+    return false;
+  }
+};
+export const validToolPolicyConstraint = (constraint: JsonObject | undefined): boolean => {
+  if (constraint === undefined) return true;
+  if (JSON.stringify(constraint).length > 65536) return false;
+  if (
+    constraint.$schema !== undefined &&
+    constraint.$schema !== "http://json-schema.org/draft-07/schema#" &&
+    constraint.$schema !== "https://json-schema.org/draft-07/schema#"
+  )
+    return false;
+  try {
+    if (!constraintSchema.validate(constraint).valid) return false;
+    new Validator(constraint, "7", false).validate(null);
+    return true;
+  } catch {
+    return false;
+  }
+};
