+++ b/e2e/support/self-email-sdk-source.ts
@@ -0,0 +1,87 @@
+/** Real public SDK host with a synthetic personal mail account and transactional audit sink. */
+export const selfEmailSdkSource = `import * as NodeCrypto from "@effect/platform-node/NodeCrypto";
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import * as Runtime from "@effect/platform-node/NodeRuntime";
+import { nativeRepositories } from "@executor-js/app-source/node";
+import { createExecutor, makeExecutorStorage, OwnerId, AppId, AppCallsHost, CurrentActor,
+  ToolName, ToolInputs, ToolCallFailed, StorageError, workflowApprovalHooks, type Executor } from "@executor-js/sdk/core";
+import { filesystemBlobStore, workerdApps } from "@executor-js/sdk/node";
+import { memoryRegistry } from "@executor-js/sdk/testing";
+import { Console, Deferred, Effect, Layer, Path, Redacted, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import { FetchHttpClient, HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { pgliteLayer } from "fumadb-effect/pglite";
+import { createServer } from "node:http";
+const input = INPUT;
+Runtime.runMain(Effect.scoped(Effect.gen(function* () {
+  const path = yield* Path.Path;
+  const database = yield* Layer.build(pgliteLayer({dataDir:path.join(input.directory,"postgres")}));
+  const sql = yield* SqlClient.SqlClient.pipe(Effect.provideContext(database));
+  const storage = yield* makeExecutorStorage({provider:"postgresql"}).pipe(Effect.provideContext(database));
+  yield* storage.migrate;
+  yield* sql\`create table if not exists fixture_confirmation_history (sequence bigint generated always as identity, action text not null)\`;
+  const secret = Redacted.make("c".repeat(64));
+  const blobs = filesystemBlobStore({directory:path.join(input.directory,"blobs")});
+  const ready = yield* Deferred.make<Executor>();
+  const runtime = yield* workerdApps({directory:path.join(input.directory,"workerd"),blobs,
+    executor:Deferred.await(ready),npmRegistry:input.npmRegistry,encryptionKey:secret});
+  const owner = OwnerId.make("self-email-owner");
+  // This fixture is the product host. Its verified synthetic identity is separate from app input.
+  const hooks = workflowApprovalHooks({
+    configuration: () => Effect.succeed({revision:"owner-r1",enabled:true}),
+    personalEmailAccount: value => Effect.gen(function* () {
+      const sdk = yield* Deferred.await(ready);
+      const target = yield* sdk.apps.source({app:AppId.make(value.target)});
+      return {owner:"self-email-owner",recipient:"owner@example.test",targetVersion:target.id,inspectedCompose:true};
+    }).pipe(Effect.mapError(()=>new StorageError())),
+  });
+  let failAudit = false;
+  const executor = yield* createExecutor({database:storage,secret,blobs,
+    appCalls:{...hooks,confirmationChanged:event => Effect.gen(function* () {
+      const action = event.current === undefined ? "cleared" : event.previous === undefined ? "installed" : "replaced";
+      yield* sql\`insert into fixture_confirmation_history (action) values (\${action})\`;
+      if (failAudit) return yield* new StorageError();
+    }).pipe(Effect.mapError(()=>new StorageError()))},
+    git:nativeRepositories(path.join(input.directory,"repositories")),runtime:runtime.runtime,
+    workflows:runtime.workflows,registry:memoryRegistry()}).pipe(Effect.provide(NodeCrypto.layer));
+  yield* Deferred.succeed(ready,executor);
+  const setup = Effect.gen(function* () {
+    const target = (yield* executor.apps.deploy({owner,name:"Synthetic personal mail",files:[
+      {path:"index.ts",content:'import {defineApp,defineProvider,secrets,mutation,object,string,json,router} from "apps"; const mail=defineProvider({name:"Synthetic personal mail",auth:{key:secrets({label:"Key",fields:object({token:string()})})}}); const send=mutation({input:json(),approval:()=>"user-approval"},async()=>({sent:true})); export default defineApp({accounts:{mail}},{tools:router({send})});'},input.files[1],
+    ]})).app;
+    const provider = target.requirements.accounts.mail;
+    if (provider === undefined) return yield* Effect.die("Missing synthetic mail provider");
+    const account = yield* executor.managedAccounts.add({owner,provider:provider.provider,method:"key",fields:Redacted.make({token:"synthetic"})});
+    const source = (yield* executor.apps.deploy({owner,name:"Self-email workflow",files:[
+      {path:"index.ts",content:'import {defineApp,query,mutation,object,boolean,string,json,router} from "apps"; const configure=mutation({input:object({deliveryEnabled:boolean(),deliveryScope:string()}),approval:()=>"user-approval"},async(_ctx,input)=>({revision:"owner-r1",...input})); const invoke=query({input:object({target:string(),payload:json()})},async(ctx,input)=>ctx.apps.call({connection:"mail",target:input.target,tool:"send",kind:"mutation",input:input.payload})); export default defineApp({dependencies:{mail:{scope:"user",configuration:{tool:"configure",policy:{envelope:"self-email",workflow:"notify",step:"send"}},tools:{send:{kind:"mutation"}}}}},{tools:router({configure,invoke})});'},input.files[1],
+    ]})).app;
+    const connection = yield* executor.appConnections.save({app:source.id,owner,dependency:"mail",scope:"user",target:target.id,
+      revision:0,accounts:{app:{mail:[account.id]}}});
+    return {source:source.id,target:target.id,account:account.id,connection:connection.id};
+  });
+  const route = <A,I>(name:string,schema:Schema.Codec<A,I>,run:(value:A)=>Effect.Effect<unknown,unknown>) =>
+    HttpRouter.add("POST",\`/_fixture/\${name}\`,Effect.gen(function* () {
+      const req = yield* HttpServerRequest.HttpServerRequest;
+      const value = yield* req.json.pipe(Effect.flatMap(Schema.decodeUnknownEffect(schema)));
+      return yield* run(value).pipe(Effect.provideService(CurrentActor,"self-email-owner"),
+        Effect.flatMap(value=>HttpServerResponse.json(value)),Effect.catch(error=>HttpServerResponse.json(Schema.is(ToolCallFailed)(error)?{failure:error.failure}:{failed:true},{status:409})));
+    }).pipe(Effect.orDie));
+  const routes = Layer.mergeAll(
+    route("setup",Schema.Null,()=>setup),
+    route("configure",Schema.Struct({app:AppId,scope:Schema.String}),value=>executor.tools.call({app:value.app,tool:ToolName.make("configure"),kind:"mutation",input:{deliveryEnabled:true,deliveryScope:value.scope}})),
+    route("resume",ToolInputs.resume,value=>executor.tools.resume(value)),
+    route("list",Schema.Struct({app:AppId}),value=>executor[AppCallsHost].confirmations.list({...value,owner})),
+    route("revoke",Schema.Struct({app:AppId,revision:Schema.Int,fingerprint:Schema.String}),value=>executor[AppCallsHost].confirmations.revoke({...value,owner,dependency:"mail",scope:"user"})),
+    route("call",Schema.Struct({app:AppId,target:AppId,account:Schema.String,to:Schema.String}),value=>executor.tools.call({app:value.app,tool:ToolName.make("invoke"),kind:"query",input:{target:value.target,payload:{account:value.account,to:[value.to],cc:[],bcc:[],subject:"Synthetic",body:"hello"}}})),
+    route("audit",Schema.Null,()=>sql\`select action from fixture_confirmation_history order by sequence\`),
+    route("fail-audit",Schema.Boolean,value=>Effect.sync(()=>{failAudit=value;return null;})),
+  );
+  const services = yield* Layer.build(HttpRouter.serve(routes,{disableLogger:true,disableListenLog:true}).pipe(
+    Layer.provideMerge(NodeHttpServer.layer(createServer,{host:"127.0.0.1",port:0}))));
+  const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+  if (!("port" in server.address)) return yield* Effect.die("Expected TCP");
+  yield* Console.log(JSON.stringify({port:server.address.port}));
+  return yield* Effect.never;
+})).pipe(Effect.provide(Layer.mergeAll(NodeServices.layer,FetchHttpClient.layer))));
+`;
diff --git a/e2e/tests/self-email-approvals.spec.ts b/e2e/tests/self-email-approvals.spec.ts
new file mode 100644
index 00000000..81a8ee14
--- /dev/null
+++ b/e2e/tests/self-email-approvals.spec.ts
@@ -0,0 +1,125 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { appCallSdkHost } from "../support/app-call-sdk.ts";
+import { selfEmailSdkSource } from "../support/self-email-sdk-source.ts";
+import { TestLive, withCase } from "../support/case.ts";
+import { scenarios } from "../test-plan.ts";
+const Confirmation = Schema.Struct({
+  fingerprint: Schema.String,
+  connection: Schema.Struct({ revision: Schema.Int }),
+});
+const List = Schema.Struct({ items: Schema.Array(Confirmation) });
+layer(TestLive, { excludeTestServices: true })("Self-email approvals", (it) => {
+  it.effect(scenarios.selfEmailApprovalScopes.title, (context) =>
+    withCase(
+      context,
+      Effect.gen(function* () {
+        const sdk = yield* appCallSdkHost(selfEmailSdkSource, "self-email-sdk");
+        const setup = yield* sdk.request("setup", null);
+        expect(setup.status, JSON.stringify(setup.body)).toBe(200);
+        const ids = yield* Schema.decodeUnknownEffect(
+          Schema.Struct({ source: Schema.String, target: Schema.String, account: Schema.String }),
+        )(setup.body);
+        const scope = [
+          {
+            workflow: "notify",
+            step: "send",
+            connection: "mail",
+            target: ids.target,
+            tool: "send",
+            account: ids.account,
+            to: ["owner@example.test"],
+            cc: [],
+            bcc: [],
+          },
+        ];
+        const configure = (value: unknown) =>
+          Effect.gen(function* () {
+            const result = yield* sdk.request("configure", {
+              app: ids.source,
+              scope: JSON.stringify(value),
+            });
+            expect(result.status, JSON.stringify(result.body)).toBe(200);
+            const pending = yield* Schema.decodeUnknownEffect(
+              Schema.Struct({
+                status: Schema.Literal("approval-required"),
+                requestId: Schema.String,
+              }),
+            )(result.body);
+            return yield* sdk.request("resume", {
+              requestId: pending.requestId,
+              response: { action: "accept" },
+            });
+          });
+        const list = () =>
+          Effect.flatMap(sdk.request("list", { app: ids.source }), (result) =>
+            Schema.decodeUnknownEffect(List)(result.body),
+          );
+        const mismatch = [{ ...scope[0], to: ["someone-else@example.test"] }];
+        expect((yield* configure(mismatch)).status).toBe(200);
+        expect((yield* list()).items).toHaveLength(0);
+        expect((yield* configure(scope)).status).toBe(200);
+        const first = (yield* list()).items;
+        expect(first).toHaveLength(1);
+        const original = first[0]!;
+        expect((yield* configure(scope)).status).toBe(200);
+        const replaced = (yield* list()).items[0]!;
+        expect(replaced.connection.revision).toBe(original.connection.revision);
+        expect(replaced.fingerprint).not.toBe(original.fingerprint);
+        expect(
+          (yield* sdk.request("revoke", {
+            app: ids.source,
+            revision: original.connection.revision,
+            fingerprint: original.fingerprint,
+          })).status,
+        ).toBe(409);
+        yield* sdk.request("fail-audit", true);
+        expect(
+          (yield* sdk.request("revoke", {
+            app: ids.source,
+            revision: replaced.connection.revision,
+            fingerprint: replaced.fingerprint,
+          })).status,
+        ).toBe(409);
+        expect((yield* list()).items[0]?.fingerprint).toBe(replaced.fingerprint);
+        expect((yield* sdk.request("audit", null)).body).toEqual([
+          { action: "installed" },
+          { action: "replaced" },
+        ]);
+        yield* sdk.request("fail-audit", false);
+        expect((yield* configure(mismatch)).status).toBe(200);
+        expect((yield* list()).items).toHaveLength(0);
+        expect((yield* sdk.request("audit", null)).body).toEqual([
+          { action: "installed" },
+          { action: "replaced" },
+          { action: "cleared" },
+        ]);
+        expect((yield* configure(scope)).status).toBe(200);
+        // Confirmation is saved, but this generic mutation is deliberately still unavailable.
+        for (const to of ["owner@example.test", "someone-else@example.test"]) {
+          const sent = yield* sdk.request("call", {
+            app: ids.source,
+            target: ids.target,
+            account: ids.account,
+            to,
+          });
+          expect(sent.status, JSON.stringify(sent.body)).toBe(409);
+          expect(sent.body).toMatchObject({
+            failure: { errorName: "AppCallFailed", code: "effects_unavailable" },
+          });
+        }
+        yield* sdk.restart;
+        expect((yield* list()).items).toHaveLength(1);
+        const current = (yield* list()).items[0]!;
+        expect(
+          (yield* sdk.request("revoke", {
+            app: ids.source,
+            revision: current.connection.revision,
+            fingerprint: current.fingerprint,
+          })).status,
+        ).toBe(200);
+        expect((yield* list()).items).toHaveLength(0);
+      }),
+    ),
+  );
+});
diff --git a/apps/hosted/web/src/implementation/pages/tool-policy-workflow-permissions.tsx b/apps/hosted/web/src/implementation/pages/tool-policy-workflow-permissions.tsx
new file mode 100644
index 00000000..0b85df5f
--- /dev/null
+++ b/apps/hosted/web/src/implementation/pages/tool-policy-workflow-permissions.tsx
@@ -0,0 +1,160 @@
+import { useState } from "react";
+import { useAtomSet } from "@effect/atom-react";
+import { Exit } from "effect";
+import type { AppConfirmationView } from "@executor-js/sdk/core";
+import type { WorkflowPolicyChange } from "@executor-js/hosted-server/tool-policies";
+import { Button } from "@executor-js/ui/components/button";
+import { useOrganizationRoute } from "../components/organization.tsx";
+import { appError } from "../../contracts/errors.ts";
+import { revokeWorkflowPolicyAtom } from "../../contracts/tool-policies.ts";
+import { ToolPolicyHistory } from "./tool-policy-history.tsx";
+
+const object = (value: unknown): Record<string, unknown> =>
+  typeof value === "object" && value !== null && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : {};
+const text = (value: unknown) => (typeof value === "string" ? value : undefined);
+export function WorkflowPermissions({
+  confirmations,
+  changes,
+  appLabel,
+}: {
+  readonly confirmations: readonly AppConfirmationView[];
+  readonly changes: readonly (typeof WorkflowPolicyChange.Type)[];
+  readonly appLabel: (id: string) => string;
+}) {
+  if (confirmations.length === 0 && changes.length === 0) return null;
+  return (
+    <>
+      <h2 className="mt-2 text-sm font-medium">Workflow permissions</h2>
+      <p className="text-sm text-muted-foreground">
+        These permissions came from an approved workflow configuration. Current delivery settings,
+        versions and accounts are checked again before a send.
+      </p>
+      <ul className="divide-y rounded-md border" aria-label="Workflow permissions">
+        {confirmations.map((view) => (
+          <WorkflowRule key={view.connection.id} view={view} label={appLabel(view.app)} />
+        ))}
+        {changes
+          .filter(
+            (change) =>
+              !confirmations.some((view) => `confirmation:${view.connection.id}` === change.id),
+          )
+          .map((change) => (
+            <ArchivedWorkflowRule
+              key={change.id}
+              id={change.id}
+              label={appLabel(text(change.snapshot.app) ?? "Workflow")}
+              action={change.action}
+            />
+          ))}
+      </ul>
+    </>
+  );
+}
+
+function WorkflowRule({
+  view,
+  label,
+}: {
+  readonly view: AppConfirmationView;
+  readonly label: string;
+}) {
+  const { organization } = useOrganizationRoute();
+  const revoke = useAtomSet(revokeWorkflowPolicyAtom(organization), { mode: "promiseExit" });
+  const [pending, setPending] = useState(false);
+  const [error, setError] = useState<string>();
+  const [history, setHistory] = useState(false);
+  const value = view.confirmation.value;
+  const declaration = object(value.declaration);
+  return (
+    <li className="p-4">
+      <div className="flex flex-wrap items-start justify-between gap-3">
+        <div className="min-w-0">
+          <h3 className="break-words text-sm font-medium">
+            {label}
+            {" · "}
+            {text(declaration.workflow) ?? view.connection.dependency}
+          </h3>
+          <p className="mt-1 break-words text-sm text-muted-foreground">
+            Saved self-email permission
+            {typeof value.recipient === "string" ? ` to ${value.recipient}` : ""}
+          </p>
+          <p className="mt-1 break-words text-xs text-muted-foreground">
+            Step: {text(declaration.step) ?? "Unknown"}
+            {" · Account: "}
+            {text(value.account) ?? "Unknown"}
+          </p>
+        </div>
+        <div className="flex gap-1">
+          <Button
+            size="sm"
+            variant="outline"
+            disabled={pending}
+            onClick={async () => {
+              setPending(true);
+              setError(undefined);
+              const result = await revoke({
+                app: view.app,
+                dependency: view.connection.dependency,
+                scope: view.connection.scope,
+                revision: view.connection.revision,
+                fingerprint: view.fingerprint,
+              });
+              setPending(false);
+              if (Exit.isFailure(result)) setError(appError(result.cause));
+            }}
+          >
+            {pending ? "Revoking…" : "Revoke"}
+          </Button>
+          <Button
+            size="sm"
+            variant="ghost"
+            aria-expanded={history}
+            onClick={() => setHistory(!history)}
+          >
+            History
+          </Button>
+        </div>
+      </div>
+      {error && (
+        <p role="alert" className="mt-2 text-sm text-destructive">
+          {error}
+        </p>
+      )}
+      {history && <ToolPolicyHistory id={`confirmation:${view.connection.id}`} />}
+    </li>
+  );
+}
+function ArchivedWorkflowRule({
+  id,
+  label,
+  action,
+}: {
+  readonly id: string;
+  readonly label: string;
+  readonly action: string;
+}) {
+  const [history, setHistory] = useState(false);
+  return (
+    <li className="p-4">
+      <div className="flex items-center justify-between gap-3">
+        <div className="min-w-0">
+          <h3 className="break-words text-sm font-medium">{label}</h3>
+          <p className="mt-1 text-sm text-muted-foreground">
+            {action === "cleared" ? "Revoked workflow permission" : "Saved workflow permission"}
+          </p>
+        </div>
+        <Button
+          size="sm"
+          variant="ghost"
+          aria-expanded={history}
+          onClick={() => setHistory(!history)}
+        >
+          History
+        </Button>
+      </div>
+      {history && <ToolPolicyHistory id={id} />}
+    </li>
+  );
+}
