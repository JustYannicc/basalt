index 00000000..2b7b3910
--- /dev/null
+++ b/packages/sdk/src/implementation/workflow-approval.ts
@@ -0,0 +1,110 @@
+import { selfEmailEnvelope } from "./workflow-email-envelope.ts";
+
+/** Source-owned declaration. A host must validate it before recording owner confirmation. */
+export interface WorkflowApprovalDeclaration {
+  readonly workflow: string;
+  readonly step: string;
+  readonly connection: string;
+  readonly envelope: "self-email";
+  readonly expiresAt?: number;
+}
+
+/** Exact values captured by the host at owner-approved configuration, never by the app command. */
+export interface WorkflowApprovalBinding {
+  readonly source: string;
+  readonly sourceVersion: string;
+  readonly configurationRevision: string;
+  readonly connectionRevision: number;
+  readonly target: string;
+  readonly targetVersion: string;
+  readonly tool: string;
+  readonly account: string;
+  readonly accountRevision: string;
+  readonly owner: string;
+  readonly recipient: string;
+}
+
+export interface WorkflowApprovalConfirmation {
+  readonly declaration: WorkflowApprovalDeclaration;
+  readonly binding: WorkflowApprovalBinding;
+  readonly approvedBy: string;
+}
+
+export interface WorkflowApprovalEvidence {
+  readonly declaration: WorkflowApprovalDeclaration;
+  readonly binding: WorkflowApprovalBinding;
+  readonly confirmation?: WorkflowApprovalConfirmation;
+  readonly now: number;
+  readonly deliveryEnabled: boolean;
+  readonly accessAllowed: boolean;
+  readonly accountOwner: string;
+  readonly verifiedOwnerRecipient?: string;
+  /** Host registration for the inspected target version's structured compose implementation. */
+  readonly envelope?: "self-email";
+  readonly workflow?: { readonly name: string; readonly step: string; readonly run: string };
+  readonly kind: "query" | "mutation";
+  readonly decodedInput: unknown;
+  readonly appPolicy: "approved" | "denied" | "user-approval" | "failed";
+}
+
+const sameDeclaration = (a: WorkflowApprovalDeclaration, b: WorkflowApprovalDeclaration) =>
+  a.workflow === b.workflow &&
+  a.step === b.step &&
+  a.connection === b.connection &&
+  a.envelope === b.envelope &&
+  a.expiresAt === b.expiresAt;
+
+const bindingKeys = [
+  "source",
+  "sourceVersion",
+  "configurationRevision",
+  "connectionRevision",
+  "target",
+  "targetVersion",
+  "tool",
+  "account",
+  "accountRevision",
+  "owner",
+  "recipient",
+] as const;
+
+/** Evaluate after target decoding and app policy, before receipt reservation or submission.
+ * This pure result is not a trusted approval token. The dispatch host owns granting authority.
+ */
+export const workflowApproval = (
+  evidence: WorkflowApprovalEvidence,
+): "approved" | "denied" | "user-approval" | "failed" => {
+  const { declaration, binding, confirmation, workflow } = evidence;
+  if (!evidence.accessAllowed) return "denied";
+  // A declaration only satisfies an ask. App denial and callback failure remain authoritative.
+  if (evidence.appPolicy !== "user-approval") return evidence.appPolicy;
+  if (!evidence.deliveryEnabled || confirmation === undefined || workflow === undefined)
+    return "user-approval";
+  if (
+    !Number.isFinite(evidence.now) ||
+    (declaration.expiresAt !== undefined &&
+      (!Number.isFinite(declaration.expiresAt) || evidence.now >= declaration.expiresAt)) ||
+    declaration.workflow.length === 0 ||
+    declaration.step.length === 0 ||
+    declaration.connection.length === 0 ||
+    workflow.run.length === 0 ||
+    workflow.name !== declaration.workflow ||
+    workflow.step !== declaration.step ||
+    !sameDeclaration(declaration, confirmation.declaration)
+  )
+    return "user-approval";
+  if (
+    !Number.isSafeInteger(binding.connectionRevision) ||
+    binding.connectionRevision < 1 ||
+    bindingKeys.some((key) => binding[key] !== confirmation.binding[key] || binding[key] === "") ||
+    binding.owner !== evidence.accountOwner ||
+    confirmation.approvedBy !== evidence.accountOwner ||
+    evidence.verifiedOwnerRecipient !== binding.recipient ||
+    evidence.kind !== "mutation" ||
+    declaration.envelope !== "self-email" ||
+    evidence.envelope !== "self-email" ||
+    !selfEmailEnvelope(evidence.decodedInput, binding.account, binding.recipient)
+  )
+    return "user-approval";
+  return "approved";
+};
diff --git a/packages/sdk/src/implementation/workflow-email-envelope.ts b/packages/sdk/src/implementation/workflow-email-envelope.ts
new file mode 100644
index 00000000..f95e870f
--- /dev/null
+++ b/packages/sdk/src/implementation/workflow-email-envelope.ts
@@ -0,0 +1,24 @@
+/** The inspected structured compose operation only. Raw MIME and reply operations never qualify. */
+export const selfEmailEnvelope = (input: unknown, account: string, recipient: string): boolean => {
+  if (input === null || typeof input !== "object" || Array.isArray(input)) return false;
+  const allowed = new Set(["account", "to", "cc", "bcc", "subject", "body", "html", "replyAll"]);
+  if (Object.keys(input).some((key) => !allowed.has(key))) return false;
+  const value = input as Record<string, unknown>;
+  // Only a bare address is eligible. Display names, aliases and header syntax require an ask.
+  if (!/^[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$/.test(recipient))
+    return false;
+  if (account.length === 0 || value.account !== account) return false;
+  if (!Array.isArray(value.to) || value.to.length !== 1 || value.to[0] !== recipient) return false;
+  for (const key of ["cc", "bcc"]) {
+    const recipients = value[key];
+    if (recipients !== undefined && (!Array.isArray(recipients) || recipients.length !== 0))
+      return false;
+  }
+  if (typeof value.body !== "string" || (value.html !== undefined && value.html !== false))
+    return false;
+  if (value.replyAll !== undefined && value.replyAll !== false) return false;
+  return (
+    value.subject === undefined ||
+    (typeof value.subject === "string" && !/[\r\n]/.test(value.subject))
+  );
+};
diff --git a/packages/sdk/src/implementation/workflow-approval-hooks.ts b/packages/sdk/src/implementation/workflow-approval-hooks.ts
new file mode 100644
index 00000000..6d06cf8d
--- /dev/null
+++ b/packages/sdk/src/implementation/workflow-approval-hooks.ts
@@ -0,0 +1,242 @@
+import { Clock, Effect, Schema } from "effect";
+import type {
+  AppCallHooks,
+  AppApprovedConfiguration,
+  AppProtectedDispatch,
+  AppConfigurationAttachment,
+} from "../contracts/app-calls.ts";
+import { StorageError } from "../contracts/shared.ts";
+import { workflowApproval } from "./workflow-approval.ts";
+
+const Declaration = Schema.Struct({
+  envelope: Schema.Literal("self-email"),
+  workflow: Schema.NonEmptyString,
+  step: Schema.NonEmptyString,
+  expiresAt: Schema.optionalKey(Schema.Number),
+});
+const Attachment = Schema.Struct({
+  declaration: Declaration,
+  account: Schema.NonEmptyString,
+  owner: Schema.NonEmptyString,
+  recipient: Schema.NonEmptyString,
+  targetVersion: Schema.NonEmptyString,
+});
+const ConfigureInput = Schema.Struct({
+  deliveryEnabled: Schema.Boolean,
+  deliveryScope: Schema.optionalKey(Schema.String),
+});
+const Scope = Schema.Array(
+  Schema.Struct({
+    workflow: Schema.String,
+    step: Schema.String,
+    connection: Schema.String,
+    target: Schema.String,
+    tool: Schema.String,
+    account: Schema.String,
+    to: Schema.Array(Schema.String),
+    cc: Schema.Array(Schema.String),
+    bcc: Schema.Array(Schema.String),
+  }),
+);
+const approvedScopes = (input: typeof ConfigureInput.Type): typeof Scope.Type => {
+  if (input.deliveryScope === undefined) return [];
+  try {
+    const value: unknown = JSON.parse(input.deliveryScope);
+    return Schema.is(Scope)(value) ? value : [];
+  } catch {
+    return [];
+  }
+};
+
+/** Product-owned facts. Resolve these from current access, verified identity and audited target
+ * code, never from the source app's policy JSON or an account's app-reported health metadata.
+ */
+export interface WorkflowApprovalHost {
+  readonly configuration: (
+    event: AppApprovedConfiguration | AppProtectedDispatch,
+  ) => Effect.Effect<
+    { readonly revision: string; readonly enabled: boolean } | undefined,
+    StorageError
+  >;
+  readonly personalEmailAccount: (input: {
+    readonly account: string;
+    readonly target: string;
+    readonly source: string;
+  }) => Effect.Effect<
+    | {
+        readonly owner: string;
+        readonly recipient: string;
+        readonly targetVersion: string;
+        readonly inspectedCompose: boolean;
+      }
+    | undefined,
+    StorageError
+  >;
+}
+
+/** Adapt only SDK-issued configuration and postdecoded dispatch events. Registration belongs
+ * to the product, which supplies live personal-account authority and inspected target support.
+ */
+export const workflowApprovalHooks = (host: WorkflowApprovalHost): AppCallHooks => ({
+  configurationApproved: (event) =>
+    Effect.gen(function* () {
+      const state = yield* host.configuration(event);
+      const attachments: AppConfigurationAttachment[] = [];
+      if (
+        state === undefined ||
+        !Schema.is(ConfigureInput)(event.input) ||
+        event.input.deliveryEnabled !== state.enabled
+      )
+        return { approvedBy: event.actor, attachments };
+      const scopes = approvedScopes(event.input);
+      for (const connection of event.connections) {
+        const configuration = connection.declaration.configuration;
+        if (
+          configuration?.tool !== event.tool ||
+          !Schema.is(Declaration)(configuration.policy) ||
+          connection.declaration.tools.send?.kind !== "mutation"
+        )
+          continue;
+        const base = {
+          connection: connection.id,
+          revision: connection.revision,
+          configurationRevision: state.revision,
+        };
+        // Each successful configuration replaces its old permission, including a scope
+        // that no longer qualifies. A disable also clears an account that lost eligibility.
+        const index = attachments.push({ ...base, value: null }) - 1;
+        if (!state.enabled) continue;
+        const selected = connection.accountVersions;
+        const account = selected[0];
+        if (!connection.enabled || selected.length !== 1 || account === undefined) continue;
+        const identity = yield* host.personalEmailAccount({
+          account: account.account,
+          target: connection.target,
+          source: event.app,
+        });
+        if (identity === undefined || !identity.inspectedCompose || identity.owner !== event.actor)
+          continue;
+        const scope = scopes.filter((scope) => scope.connection === connection.dependency);
+        if (
+          scope.length !== 1 ||
+          !scope.some(
+            (scope) =>
+              scope.workflow === configuration.policy.workflow &&
+              scope.step === configuration.policy.step &&
+              scope.target === connection.target &&
+              scope.tool === "send" &&
+              scope.account === account.account &&
+              scope.to.length === 1 &&
+              scope.to[0] === identity.recipient &&
+              scope.cc.length === 0 &&
+              scope.bcc.length === 0,
+          )
+        )
+          continue;
+        attachments[index] = {
+          ...base,
+          value: {
+            declaration: configuration.policy,
+            account: account.account,
+            owner: identity.owner,
+            recipient: identity.recipient,
+            targetVersion: identity.targetVersion,
+          },
+        };
+      }
+      return { approvedBy: event.actor, attachments };
+    }),
+  protectedDispatch: (event) =>
+    Effect.gen(function* () {
+      const confirmation = event.confirmation;
+      const workflow = event.source.workflow;
+      const policy = event.declaration.configuration?.policy;
+      if (
+        confirmation === undefined ||
+        workflow === undefined ||
+        workflow.stepId.length === 0 ||
+        event.target.tool !== "send" ||
+        !event.connection.enabled ||
+        !Schema.is(Declaration)(policy) ||
+        !Schema.is(Attachment)(confirmation.value)
+      )
+        return "user-approval";
+      const account = event.target.accountVersions[0];
+      const confirmedAccount = confirmation.accountVersions[0];
+      if (
+        event.target.accountVersions.length !== 1 ||
+        confirmation.accountVersions.length !== 1 ||
+        account === undefined ||
+        confirmedAccount === undefined ||
+        account.account !== confirmedAccount.account ||
+        account.owner !== confirmedAccount.owner ||
+        account.credentialGeneration !== confirmedAccount.credentialGeneration ||
+        !Number.isSafeInteger(account.credentialGeneration) ||
+        account.credentialGeneration < 0 ||
+        confirmation.value.account !== account.account
+      )
+        return "user-approval";
+      const identity = yield* host.personalEmailAccount({
+        account: account.account,
+        target: event.target.app,
+        source: event.source.app,
+      });
+      const state = yield* host.configuration(event);
+      if (
+        identity === undefined ||
+        !identity.inspectedCompose ||
+        state === undefined ||
+        identity.targetVersion !== event.target.version ||
+        confirmation.value.targetVersion !== event.target.version
+      )
+        return "user-approval";
+      const value = confirmation.value;
+      const accountRevision = JSON.stringify([
+        account.account,
+        account.owner,
+        account.credentialGeneration,
+      ]);
+      const binding = {
+        source: event.source.app,
+        sourceVersion: event.source.version,
+        configurationRevision: state.revision,
+        connectionRevision: event.connection.revision,
+        target: event.target.app,
+        targetVersion: event.target.version,
+        tool: event.target.tool,
+        account: account.account,
+        accountRevision,
+        owner: identity.owner,
+        recipient: identity.recipient,
+      };
+      return workflowApproval({
+        declaration: { ...policy, connection: event.connection.dependency },
+        binding,
+        confirmation: {
+          declaration: { ...value.declaration, connection: event.connection.dependency },
+          binding: {
+            ...binding,
+            sourceVersion: confirmation.sourceVersion,
+            targetVersion: confirmation.targetVersion,
+            connectionRevision: confirmation.connectionRevision,
+            configurationRevision: confirmation.configurationRevision,
+            owner: value.owner,
+            recipient: value.recipient,
+          },
+          approvedBy: confirmation.approvedBy,
+        },
+        now: yield* Clock.currentTimeMillis,
+        deliveryEnabled: state.enabled,
+        accessAllowed: true,
+        accountOwner: identity.owner,
+        verifiedOwnerRecipient: identity.recipient,
+        envelope: "self-email",
+        workflow: { name: workflow.name, step: workflow.step, run: workflow.run },
+        kind: event.target.kind,
+        decodedInput: event.decodedInput,
+        appPolicy: event.appPolicy,
+      }) === "approved"
+        ? "approved"
+        : "user-approval";
+    }),
+});
