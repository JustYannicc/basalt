@@ -0,0 +1,69 @@
+import { useState } from "react";
+import { QueryView } from "@executor-js/ui/dashboard/context";
+import { Button } from "@executor-js/ui/components/button";
+import { LocalTime } from "@executor-js/ui/components/local-time";
+import { useOrganizationRoute } from "../components/organization.tsx";
+import { HostedFailure } from "../components/dashboard-bindings.tsx";
+import { toolPolicyHistoryAtom } from "../../contracts/tool-policies.ts";
+
+export function ToolPolicyHistory({ id }: { readonly id: string }) {
+  const { organization } = useOrganizationRoute();
+  const [after, setAfter] = useState<string>();
+  return (
+    <div className="mt-3 border-t pt-3">
+      <h4 className="mb-2 text-sm font-medium">Change history</h4>
+      <QueryView
+        query={toolPolicyHistoryAtom({
+          organization,
+          policy: id,
+          ...(after === undefined ? {} : { after }),
+        })}
+        Failure={HostedFailure}
+      >
+        {(page) => (
+          <>
+            {page.items.length === 0 ? (
+              <p className="text-sm text-muted-foreground">
+                No recorded changes. This permission may predate change history.
+              </p>
+            ) : (
+              <ol className="grid gap-3" aria-label="Rule change history">
+                {page.items.map((change) => (
+                  <li key={change.cursor}>
+                    <p className="text-sm">
+                      <span className="capitalize">{change.action}</span>
+                      {" by "}
+                      {change.actorName}
+                      {" · "}
+                      <LocalTime value={change.at} />
+                    </p>
+                    <details>
+                      <summary className="cursor-pointer text-xs text-muted-foreground">
+                        Saved scope and conditions
+                      </summary>
+                      <pre className="mt-2 max-h-64 overflow-auto whitespace-pre-wrap break-words text-xs">
+                        {JSON.stringify(change.snapshot, null, 2)}
+                      </pre>
+                    </details>
+                  </li>
+                ))}
+              </ol>
+            )}
+            <div className="mt-3 flex gap-2">
+              {after !== undefined && (
+                <Button variant="ghost" size="sm" onClick={() => setAfter(undefined)}>
+                  First changes
+                </Button>
+              )}
+              {page.next !== undefined && (
+                <Button variant="outline" size="sm" onClick={() => setAfter(page.next)}>
+                  Next changes
+                </Button>
+              )}
+            </div>
+          </>
+        )}
+      </QueryView>
+    </div>
+  );
+}
diff --git a/e2e/tests/tool-policies.spec.ts b/e2e/tests/tool-policies.spec.ts
new file mode 100644
index 00000000..bdbdbbb9
--- /dev/null
+++ b/e2e/tests/tool-policies.spec.ts
@@ -0,0 +1,301 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema, Schedule } from "effect";
+import { connectionsPath } from "../support/app-accounts.ts";
+import { Api, body } from "../support/api.ts";
+import { Actors } from "../support/actors.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Policy = Schema.Struct({ id: Schema.String, revision: Schema.Int, revoked: Schema.Boolean });
+const History = Schema.Struct({
+  items: Schema.Array(
+    Schema.Struct({
+      action: Schema.String,
+      actor: Schema.String,
+      actorName: Schema.String,
+      snapshot: Schema.Struct({ revision: Schema.Int }),
+    }),
+  ),
+});
+const source = `import {defineApp,query,mutation,workflow,object,string,router} from "apps";
+const input=object({title:string()});
+const read=query({input},async(_ctx,value)=>({read:value.title}));
+const write=mutation({input,approval:()=>"user-approval"},async(_ctx,value)=>({wrote:value.title}));
+const denied=mutation({input,approval:()=>"denied"},async()=>({ran:true}));
+const failed=mutation({input,approval:()=>{throw new Error("policy failure");}},async()=>({ran:true}));
+const probe=workflow({input},async(ctx,value)=>{try{return {result:await ctx.step.runQuery("read",read,value,{retries:{limit:0,delay:0}})};}catch{return {blocked:true};}});
+export default defineApp({}, {tools:router({read,write,denied,failed}),workflows:{probe}});`;
+
+layer(RuntimeLive, { excludeTestServices: true })("General approval policies", (it) => {
+  it.effect(scenarios.hostedAccountToolPolicies.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: "Account policy target",
+          files: [
+            {
+              path: "index.ts",
+              content: `import {defineApp,defineProvider,secrets,query,mutation,object,string,router} from "apps";
+const service=defineProvider({name:"Account policy fixture",auth:{key:secrets({label:"Key",fields:object({token:string()})})}});
+const read=query({input:object({account:string()})},async()=>({read:true}));
+const write=mutation({input:object({account:string()}),approval:()=>"user-approval"},async()=>({wrote:true}));
+export default defineApp({user:{accounts:{service}}},{tools:router({read,write})});`,
+            },
+            appsManifest,
+          ],
+        });
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const app = yield* body(Resource, deployed),
+          appPath = `${prefix}/apps/${app.id}`;
+        const accounts: string[] = [];
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* api.request(actors.owner, "DELETE", appPath);
+            for (const [index, id] of accounts.entries())
+              yield* api.request(
+                index === 0 ? actors.owner : actors.member,
+                "DELETE",
+                `${prefix}/accounts/${id}`,
+              );
+          }).pipe(Effect.orDie),
+        );
+        const access = yield* body(
+          Schema.Struct({ revision: Schema.String }),
+          yield* api.request(actors.owner, "GET", `${appPath}/access`),
+        );
+        expect(
+          (yield* api.request(actors.owner, "PATCH", `${appPath}/access`, {
+            revision: access.revision,
+            audience: { kind: "everyone" },
+          })).status,
+        ).toBe(200);
+        for (const actor of [actors.owner, actors.member]) {
+          const connectionReply = yield* api.request(
+            actor,
+            "POST",
+            connectionsPath(appPath, "user", "service"),
+            { destination: { kind: "personal" } },
+          );
+          expect(connectionReply.status, JSON.stringify(connectionReply.body)).toBe(200);
+          const connection = yield* body(Resource, connectionReply);
+          const saved = yield* api.request(
+            actor,
+            "POST",
+            `${prefix}/connections/${connection.id}/submit`,
+            { method: "key", fields: { token: "synthetic" } },
+          );
+          expect(saved.status, JSON.stringify(saved.body)).toBe(200);
+          accounts.push((yield* body(Resource, saved)).id);
+        }
+        const ownerAccount = accounts[0]!,
+          memberAccount = accounts[1]!,
+          path = `${prefix}/tool-policies`;
+        expect(
+          (yield* api.request(actors.owner, "POST", path, {
+            target: { kind: "app", app: app.id },
+            mode: "never-ask",
+          })).status,
+        ).toBe(200);
+        const call = (actor: typeof actors.owner, tool: string, account: string) =>
+          api.request(actor, "POST", `${appPath}/tools/call`, {
+            tool,
+            kind: tool === "read" ? "query" : "mutation",
+            input: { account },
+          });
+        expect((yield* call(actors.owner, "write", ownerAccount)).body).toEqual({ wrote: true });
+        // App management cannot waive another person's account; an input ID is not an account selection.
+        expect((yield* call(actors.member, "write", ownerAccount)).status).toBe(409);
+        expect(
+          (yield* api.request(actors.owner, "POST", path, {
+            target: { kind: "account", account: memberAccount },
+            mode: "never-ask",
+          })).status,
+        ).toBe(403);
+        const ownRule = yield* api.request(actors.member, "POST", path, {
+          target: { kind: "account", account: memberAccount },
+          mode: "always-ask",
+        });
+        expect(ownRule.status, JSON.stringify(ownRule.body)).toBe(200);
+        expect((yield* call(actors.member, "read", ownerAccount)).status).toBe(409);
+        expect((yield* call(actors.owner, "read", memberAccount)).body).toEqual({ read: true });
+        const rule = yield* body(Policy, ownRule);
+        expect(
+          (yield* api.request(
+            actors.member,
+            "DELETE",
+            `${path}/${rule.id}?revision=${rule.revision}`,
+          )).status,
+        ).toBe(200);
+        expect((yield* call(actors.member, "read", ownerAccount)).body).toEqual({ read: true });
+      }),
+    ),
+  );
+  it.effect(scenarios.hostedToolPolicies.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: "Policy target",
+          files: [{ path: "index.ts", content: source }, appsManifest],
+        });
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const app = yield* body(Resource, deployed);
+        yield* Effect.addFinalizer(() =>
+          api.request(actors.owner, "DELETE", `${prefix}/apps/${app.id}`).pipe(Effect.orDie),
+        );
+        const path = `${prefix}/tool-policies`;
+        const target = { kind: "app", app: app.id };
+        const call = (tool: string, title = "safe") =>
+          api.request(actors.owner, "POST", `${prefix}/apps/${app.id}/tools/call`, {
+            tool,
+            kind: tool === "read" ? "query" : "mutation",
+            input: { title },
+          });
+        const save = (mode: string, policy?: typeof Policy.Type) =>
+          api.request(
+            actors.owner,
+            policy === undefined ? "POST" : "PUT",
+            policy === undefined ? path : `${path}/${policy.id}`,
+            { target, mode, ...(policy === undefined ? {} : { revision: policy.revision }) },
+          );
+        const workflowProbe = Effect.gen(function* () {
+          const started = yield* api.request(
+            actors.owner,
+            "POST",
+            `${prefix}/apps/${app.id}/workflow-runs`,
+            { workflow: "probe", input: { title: "safe" } },
+          );
+          expect(started.status, JSON.stringify(started.body)).toBe(200);
+          const run = yield* body(Resource, started);
+          const result = yield* Effect.gen(function* () {
+            return yield* body(
+              Schema.Struct({ status: Schema.String, output: Schema.optionalKey(Schema.Json) }),
+              yield* api.request(
+                actors.owner,
+                "GET",
+                `${prefix}/apps/${app.id}/workflow-runs/${run.id}`,
+              ),
+            );
+          }).pipe(
+            Effect.repeat({
+              while: (result) => result.status === "queued" || result.status === "running",
+              schedule: Schedule.spaced("100 millis"),
+            }),
+            Effect.timeout("30 seconds"),
+          );
+          expect(result.status, JSON.stringify(result)).toBe("complete");
+          return result.output;
+        });
+        expect((yield* call("read")).body).toEqual({ read: "safe" });
+        expect((yield* call("write")).status).toBe(409);
+        const first = yield* save("always-ask");
+        expect(first.status, JSON.stringify(first.body)).toBe(200);
+        const always = yield* body(Policy, first);
+        // This query has no app approval callback. The host must still ask.
+        expect((yield* call("read")).status).toBe(409);
+        expect((yield* call("write")).status).toBe(409);
+        expect(
+          (yield* api.request(actors.member, "PUT", `${path}/${always.id}`, {
+            target,
+            mode: "never-ask",
+            revision: always.revision,
+          })).status,
+        ).toBe(403);
+        expect(
+          (yield* api.request(actors.owner, "PUT", `${path}/${always.id}`, {
+            target,
+            mode: "never-ask",
+            revision: 0,
+          })).status,
+        ).toBe(409);
+        const neverReply = yield* save("never-ask", always);
+        expect(neverReply.status, JSON.stringify(neverReply.body)).toBe(200);
+        const never = yield* body(Policy, neverReply);
+        expect((yield* call("read")).body).toEqual({ read: "safe" });
+        expect((yield* call("write")).body).toEqual({ wrote: "safe" });
+        expect(yield* workflowProbe).toEqual({ result: { read: "safe" } });
+        expect((yield* call("denied")).status).not.toBe(200);
