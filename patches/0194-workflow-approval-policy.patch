index 00000000..1edf9bdb
--- /dev/null
+++ b/apps/hosted/server/src/implementation/tool-policy-handlers.ts
@@ -0,0 +1,24 @@
+import { HttpApiBuilder } from "effect/http-api";
+import { HostedApi } from "../contracts/api.ts";
+import {
+  listToolPolicies,
+  saveToolPolicy,
+  revokeToolPolicy,
+  readToolPolicyHistory,
+  revokeWorkflowConfirmation,
+} from "./tool-policies.ts";
+
+export const hostedToolPolicyHandlers = HttpApiBuilder.group(
+  HostedApi,
+  "toolPolicies",
+  (handlers) =>
+    handlers
+      .handle("list", () => listToolPolicies)
+      .handle("create", ({ payload }) => saveToolPolicy(payload))
+      .handle("update", ({ params, payload }) => saveToolPolicy({ ...payload, id: params.policy }))
+      .handle("revoke", ({ params, query }) => revokeToolPolicy(params.policy, query.revision))
+      .handle("history", ({ params, query }) => readToolPolicyHistory(params.policy, query.after))
+      .handle("revokeConfirmation", ({ params, payload }) =>
+        revokeWorkflowConfirmation({ ...params, ...payload }),
+      ),
+);
