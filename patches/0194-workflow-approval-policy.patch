diff --git a/e2e/tests/tool-policy-draft.spec.ts b/e2e/tests/tool-policy-draft.spec.ts
new file mode 100644
index 00000000..5a768abf
--- /dev/null
+++ b/e2e/tests/tool-policy-draft.spec.ts
@@ -0,0 +1,132 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect } from "effect";
+import { Api, body } from "../support/api.ts";
+import { Actors } from "../support/actors.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { Browser } from "../support/browser.ts";
+import { holdQuery, refreshVisiblePage } from "../support/query-transition.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Approval policy drafts", (it) => {
+  it.effect(scenarios.hostedToolPolicyDraft.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const actors = yield* Actors,
+          api = yield* Api,
+          browser = yield* Browser;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: "Draft target",
+          files: [
+            {
+              path: "index.ts",
+              content: 'import {defineApp} from "apps"; export default defineApp({},{});',
+            },
+            appsManifest,
+          ],
+        });
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const app = yield* body(Resource, deployed);
+        yield* Effect.addFinalizer(() =>
+          api.request(actors.owner, "DELETE", `${prefix}/apps/${app.id}`).pipe(Effect.orDie),
+        );
+        yield* browser.login(actors.owner);
+        yield* browser.use("Open Human in the loop", (page) =>
+          page.goto(`/org/${actors.organization.slug}/approvals`),
+        );
+        yield* browser.use("Open Rules", (page) =>
+          page.getByRole("tab", { name: "Rules", exact: true }).click(),
+        );
+        yield* browser.use("Start a rule", (page) =>
+          page.getByRole("button", { name: "New rule", exact: true }).click(),
+        );
+        yield* browser.use("Choose an app", (page) =>
+          page.getByRole("combobox", { name: "App", exact: true }).click(),
+        );
+        yield* browser.use("Select the owned app", (page) =>
+          page.getByRole("option", { name: "Draft target", exact: true }).click(),
+        );
+        yield* browser.use("Open the input constraint", (page) =>
+          page.getByText("Input constraint", { exact: true }).click(),
+        );
+        const draft = '{"type":"object","properties":{"title":{"const":"keep my draft"}}}';
+        yield* browser.use("Write the input constraint", (page) =>
+          page.getByRole("textbox", { name: "Input constraint JSON Schema" }).fill(draft),
+        );
+        const savedPath = new RegExp(`/api/organizations/[^/]+/tool-policies$`);
+        const failed = yield* holdQuery(savedPath, "fail", { method: "POST" });
+        yield* browser.use("Submit the draft", (page) =>
+          page.getByRole("button", { name: "Save rule", exact: true }).click(),
+        );
+        yield* failed.requested;
+        expect(
+          yield* browser.use("Saving disables another submit", (page) =>
+            page.getByRole("button", { name: "Saving…", exact: true }).isDisabled(),
+          ),
+        ).toBe(true);
+        yield* failed.release;
+        yield* browser.use("The failed save remains editable", (page) =>
+          page
+            .getByRole("button", { name: "Save rule", exact: true })
+            .waitFor({ state: "visible" }),
+        );
+        const checkDraft = (phase: string) =>
+          Effect.gen(function* () {
+            expect(
+              yield* browser.use(`${phase}: constraint remains`, (page) =>
+                page.getByRole("textbox", { name: "Input constraint JSON Schema" }).inputValue(),
+              ),
+            ).toBe(draft);
+            expect(
+              yield* browser.use(`${phase}: target remains`, (page) =>
+                page.getByRole("combobox", { name: "App", exact: true }).textContent(),
+              ),
+            ).toContain("Draft target");
+          });
+        yield* checkDraft("After failed save");
+        yield* browser.use("Switch to Requests", (page) =>
+          page.getByRole("tab", { name: "Requests", exact: true }).click(),
+        );
+        yield* browser.use("Return to Rules", (page) =>
+          page.getByRole("tab", { name: "Rules", exact: true }).click(),
+        );
+        yield* checkDraft("After tab navigation");
+        const refresh = yield* holdQuery(savedPath, "continue");
+        yield* refreshVisiblePage;
+        yield* refresh.requested;
+        yield* checkDraft("During refreshed reads");
+        const settled = yield* browser.use("Watch the released policy read", (page) =>
+          Promise.resolve({
+            response: page.waitForResponse(
+              (response) =>
+                savedPath.test(new URL(response.url()).pathname) &&
+                response.request().method() === "GET" &&
+                response.ok(),
+            ),
+          }),
+        );
+        yield* refresh.release;
+        yield* browser.use("The refreshed policy read completed", () => settled.response);
+        yield* checkDraft("After refreshed reads");
+        yield* browser.use("Retry this exact draft", (page) =>
+          page.getByRole("button", { name: "Save rule", exact: true }).click(),
+        );
+        yield* browser.use("The saved draft closes", (page) =>
+          page
+            .getByRole("heading", { name: "New approval rule", exact: true })
+            .waitFor({ state: "hidden" }),
+        );
+        yield* browser.use("The saved rule is listed", (page) =>
+          page
+            .getByRole("list", { name: "Approval rules", exact: true })
+            .getByRole("heading", { name: "Draft target", exact: true })
+            .waitFor({ state: "visible" }),
+        );
+        yield* browser.checkpoint("Saved rule after failed save and tab round trip");
+      }),
+    ),
+  );
+});
