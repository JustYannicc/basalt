@@ -0,0 +1,193 @@
+import { useState } from "react";
+import { useAtomSet } from "@effect/atom-react";
+import { Exit } from "effect";
+import type { ToolPolicy, ToolPolicyView } from "@executor-js/hosted-server/tool-policies";
+import type { ResourceDirectory } from "@executor-js/hosted-server/resource-access";
+import { Button } from "@executor-js/ui/components/button";
+import { QueryView } from "@executor-js/ui/dashboard/context";
+import { useOrganizationRoute } from "../components/organization.tsx";
+import { HostedFailure } from "../components/dashboard-bindings.tsx";
+import { appError } from "../../contracts/errors.ts";
+import { resourceDirectoryAtom } from "../../contracts/resource-access.ts";
+import { toolPoliciesAtom, revokeToolPolicyAtom } from "../../contracts/tool-policies.ts";
+import { ToolPolicyEditor, approvalModes } from "./tool-policy-editor.tsx";
+import { WorkflowPermissions } from "./tool-policy-workflow-permissions.tsx";
+import { ToolPolicyHistory } from "./tool-policy-history.tsx";
+
+type Directory = typeof ResourceDirectory.Type;
+const appLabel = (directory: Directory, id: string) =>
+  directory.apps.find((entry) => entry.app.id === id)?.app.name ?? id;
+const accountLabel = (directory: Directory, id: string) =>
+  directory.accounts.find((entry) => entry.account.id === id)?.account.label ?? id;
+function targetLabel(directory: Directory, rule: ToolPolicy) {
+  const target = rule.target;
+  const app = target.kind === "account" ? undefined : appLabel(directory, target.app);
+  return [
+    app,
+    target.kind === "tool" ? target.tool : undefined,
+    target.account === undefined ? undefined : accountLabel(directory, target.account),
+  ]
+    .filter(Boolean)
+    .join(" · ");
+}
+
+export function ToolPolicies() {
+  const { organization } = useOrganizationRoute();
+  const [editing, setEditing] = useState<ToolPolicy | "new">();
+  const [showRevoked, setShowRevoked] = useState(false);
+  return (
+    <div className="grid gap-4">
+      <div className="flex flex-wrap items-start justify-between gap-3">
+        <p className="max-w-prose text-sm text-muted-foreground">
+          Choose when an app, tool or account needs your approval. With no matching rule, the app's
+          own setting applies.
+        </p>
+        <Button
+          variant="outline"
+          onClick={() => setEditing("new")}
+          disabled={editing !== undefined}
+        >
+          New rule
+        </Button>
+      </div>
+      <QueryView query={toolPoliciesAtom(organization)} Failure={HostedFailure}>
+        {(data) => (
+          <QueryView query={resourceDirectoryAtom(organization)} Failure={HostedFailure}>
+            {(directory) => (
+              <>
+                {editing !== undefined && (
+                  <QueryView
+                    query={resourceDirectoryAtom(organization, "managed")}
+                    Failure={HostedFailure}
+                  >
+                    {(managed) => (
+                      <ToolPolicyEditor
+                        key={editing === "new" ? "new" : editing.id}
+                        {...(editing === "new" ? {} : { policy: editing })}
+                        directory={managed}
+                        onDone={() => setEditing(undefined)}
+                      />
+                    )}
+                  </QueryView>
+                )}
+                <div className="flex items-center justify-between gap-3">
+                  <h2 className="text-sm font-medium">Approval rules</h2>
+                  <Button
+                    variant="ghost"
+                    size="sm"
+                    aria-pressed={showRevoked}
+                    onClick={() => setShowRevoked(!showRevoked)}
+                  >
+                    {showRevoked ? "Hide revoked" : "Show revoked"}
+                  </Button>
+                </div>
+                {data.policies.filter((rule) => showRevoked || !rule.revoked).length === 0 ? (
+                  <p className="text-sm text-muted-foreground">
+                    No rules here. Add one for an app or account you manage.
+                  </p>
+                ) : (
+                  <ul className="divide-y rounded-md border" aria-label="Approval rules">
+                    {data.policies
+                      .filter((rule) => showRevoked || !rule.revoked)
+                      .map((rule) => (
+                        <RuleRow
+                          key={rule.id}
+                          rule={rule}
+                          label={targetLabel(directory, rule)}
+                          onEdit={() => setEditing(rule)}
+                          editing={editing !== undefined}
+                        />
+                      ))}
+                  </ul>
+                )}
+                <WorkflowPermissions
+                  confirmations={data.confirmations}
+                  changes={data.confirmationChanges}
+                  appLabel={(id) => appLabel(directory, id)}
+                />
+              </>
+            )}
+          </QueryView>
+        )}
+      </QueryView>
+    </div>
+  );
+}
+
+function RuleRow({
+  rule,
+  label,
+  onEdit,
+  editing,
+}: {
+  readonly rule: typeof ToolPolicyView.Type;
+  readonly label: string;
+  readonly onEdit: () => void;
+  readonly editing: boolean;
+}) {
+  const { organization } = useOrganizationRoute();
+  const revoke = useAtomSet(revokeToolPolicyAtom(organization), { mode: "promiseExit" });
+  const [pending, setPending] = useState(false);
+  const [error, setError] = useState<string>();
+  const [history, setHistory] = useState(false);
+  return (
+    <li className="p-4">
+      <div className="flex flex-wrap items-start justify-between gap-3">
+        <div className="min-w-0">
+          <h3 className="break-words text-sm font-medium">{label}</h3>
+          <p className="mt-1 text-sm text-muted-foreground">
+            {rule.revoked ? "Revoked" : approvalModes[rule.mode]}
+            {rule.inputSchema === undefined ? "" : " · Matching input only"}
+          </p>
+        </div>
+        <div className="flex flex-wrap gap-1">
+          {rule.canEdit && (
+            <Button size="sm" variant="ghost" disabled={pending || editing} onClick={onEdit}>
+              {rule.revoked ? "Restore" : "Edit"}
+            </Button>
+          )}
+          {rule.canEdit && !rule.revoked && (
+            <Button
+              size="sm"
+              variant="outline"
+              disabled={pending}
+              onClick={async () => {
+                setPending(true);
+                setError(undefined);
+                const result = await revoke({ id: rule.id, revision: rule.revision });
+                setPending(false);
+                if (Exit.isFailure(result)) setError(appError(result.cause));
+              }}
+            >
+              {pending ? "Revoking…" : "Revoke"}
+            </Button>
+          )}
+          <Button
+            size="sm"
+            variant="ghost"
+            aria-expanded={history}
+            onClick={() => setHistory(!history)}
+          >
+            History
+          </Button>
+        </div>
+      </div>
+      {error && (
+        <p role="alert" className="mt-2 text-sm text-destructive">
+          {error}
+        </p>
+      )}
+      {rule.inputSchema !== undefined && (
+        <details className="mt-2">
+          <summary className="cursor-pointer text-xs text-muted-foreground">
+            Input constraint
+          </summary>
+          <pre className="mt-2 overflow-auto whitespace-pre-wrap break-words text-xs">
+            {JSON.stringify(rule.inputSchema, null, 2)}
+          </pre>
+        </details>
+      )}
+      {history && <ToolPolicyHistory id={rule.id} />}
+    </li>
+  );
+}
diff --git a/apps/hosted/web/src/implementation/pages/tool-policy-editor.tsx b/apps/hosted/web/src/implementation/pages/tool-policy-editor.tsx
