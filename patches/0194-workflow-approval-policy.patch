+import {
+  AccountId,
+  AppId,
+  AppConfirmationView,
+  JsonObject,
+  StorageError,
+} from "@executor-js/sdk/core";
+import { ApiError } from "@executor-js/utils/api-error";
+import { Schema } from "effect";
+import { HttpApiEndpoint, HttpApiGroup } from "effect/http-api";
+import { BrowserSessionOnly, Forbidden } from "./auth.ts";
+import {
+  OrganizationForbidden,
+  OrganizationReference,
+  RequireOrganization,
+} from "./organization.ts";
+import { RequiredAction } from "./authorization.ts";
+
+export const ToolPolicyMode = Schema.Literals(["always-ask", "ask-writes", "never-ask"]);
+export const ToolPolicyTarget = Schema.Union([
+  Schema.Struct({
+    kind: Schema.Literal("app"),
+    app: AppId,
+    account: Schema.optionalKey(AccountId),
+  }),
+  Schema.Struct({
+    kind: Schema.Literal("tool"),
+    app: AppId,
+    tool: Schema.NonEmptyString,
+    account: Schema.optionalKey(AccountId),
+  }),
+  Schema.Struct({ kind: Schema.Literal("account"), account: AccountId }),
+]);
+export type ToolPolicyTarget = typeof ToolPolicyTarget.Type;
+export const ToolPolicyValues = Schema.Struct({
+  target: ToolPolicyTarget,
+  mode: ToolPolicyMode,
+  inputSchema: Schema.optionalKey(JsonObject),
+});
+export type ToolPolicyValues = typeof ToolPolicyValues.Type;
+export const ToolPolicy = Schema.Struct({
+  ...ToolPolicyValues.fields,
+  id: Schema.NonEmptyString,
+  revision: Schema.Int,
+  revoked: Schema.Boolean,
+  actor: Schema.NonEmptyString,
+  updatedAt: Schema.Number,
+});
+export type ToolPolicy = typeof ToolPolicy.Type;
+export const ToolPolicyView = Schema.Struct({ ...ToolPolicy.fields, canEdit: Schema.Boolean });
+export const ToolPolicyHistory = Schema.Struct({
+  cursor: Schema.String,
+  at: Schema.Number,
+  actor: Schema.String,
+  actorName: Schema.String,
+  action: Schema.Literals([
+    "created",
+    "updated",
+    "restored",
+    "revoked",
+    "installed",
+    "replaced",
+    "cleared",
+  ]),
+  snapshot: JsonObject,
+});
+export const WorkflowPolicyChange = Schema.Struct({
+  ...ToolPolicyHistory.fields,
+  id: Schema.String,
+});
+export class ToolPolicyConflict extends ApiError.define({
+  tag: "ToolPolicyConflict",
+  status: 409,
+  message: "This rule changed. Read its current state before saving again.",
+}) {}
+export class ToolPolicyInvalid extends ApiError.define({
+  tag: "ToolPolicyInvalid",
+  status: 422,
+  message: "The rule or its input constraint is invalid.",
+}) {}
+const params = { organization: OrganizationReference };
+const item = { ...params, policy: Schema.NonEmptyString };
+const path = "/api/organizations/:organization/tool-policies";
+const error = [
+  StorageError,
+  OrganizationForbidden,
+  Forbidden,
+  ToolPolicyConflict,
+  ToolPolicyInvalid,
+];
+export const HostedToolPolicies = HttpApiGroup.make("toolPolicies")
+  .add(
+    HttpApiEndpoint.get("list", path, {
+      params,
+      success: Schema.Struct({
+        policies: Schema.Array(ToolPolicyView),
+        confirmations: Schema.Array(AppConfirmationView),
+        confirmationChanges: Schema.Array(WorkflowPolicyChange),
+      }),
+      error,
+    }).annotate(RequiredAction, "read"),
+  )
+  .add(
+    HttpApiEndpoint.post("create", path, {
+      params,
+      payload: ToolPolicyValues,
+      success: ToolPolicy,
+      error,
+    })
+      .annotate(RequiredAction, "manage")
+      .annotate(BrowserSessionOnly, true),
+  )
+  .add(
+    HttpApiEndpoint.put("update", `${path}/:policy`, {
+      params: item,
+      payload: Schema.Struct({ ...ToolPolicyValues.fields, revision: Schema.Int }),
+      success: ToolPolicy,
+      error,
+    })
+      .annotate(RequiredAction, "manage")
+      .annotate(BrowserSessionOnly, true),
+  )
+  .add(
+    HttpApiEndpoint.delete("revoke", `${path}/:policy`, {
+      params: item,
+      query: { revision: Schema.Int },
+      success: ToolPolicy,
+      error,
+    })
+      .annotate(RequiredAction, "manage")
+      .annotate(BrowserSessionOnly, true),
+  )
+  .add(
+    HttpApiEndpoint.get("history", `${path}/:policy/history`, {
+      params: item,
+      query: { after: Schema.optional(Schema.String.check(Schema.isPattern(/^\d+$/u))) },
+      success: Schema.Struct({
+        items: Schema.Array(ToolPolicyHistory),
+        next: Schema.optionalKey(Schema.String),
+      }),
+      error,
+    }).annotate(RequiredAction, "read"),
+  )
+  .add(
+    HttpApiEndpoint.post("revokeConfirmation", `${path}/confirmations/:app/:dependency`, {
+      params: { ...params, app: AppId, dependency: Schema.NonEmptyString },
+      payload: Schema.Struct({
+        scope: Schema.Literals(["app", "user"]),
+        revision: Schema.Int,
+        fingerprint: Schema.NonEmptyString,
+      }),
+      success: Schema.Struct({ success: Schema.Literal(true) }),
+      error,
+    })
+      .annotate(RequiredAction, "manage")
+      .annotate(BrowserSessionOnly, true),
+  )
+  .middleware(RequireOrganization);
diff --git a/apps/hosted/server/src/implementation/tool-policy-schema.ts b/apps/hosted/server/src/implementation/tool-policy-schema.ts
new file mode 100644
index 00000000..a08dc70f
--- /dev/null
+++ b/apps/hosted/server/src/implementation/tool-policy-schema.ts
@@ -0,0 +1,19 @@
+import { Effect } from "effect";
+import { SqlClient } from "effect/sql";
+
+/** Additive hosted policy state and immutable change records. No existing table changes. */
+export const migrateToolPolicies = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  yield* sql`create table if not exists hosted_tool_policies (
+    id text primary key, organization_id text not null references organization(id) on delete cascade,
+    revision integer not null check (revision > 0), definition jsonb not null
+  )`;
+  yield* sql`create index if not exists hosted_tool_policies_organization on hosted_tool_policies (organization_id, id)`;
+  yield* sql`create table if not exists hosted_tool_policy_history (
+    sequence bigint generated always as identity primary key,
+    organization_id text not null references organization(id) on delete cascade,
+    policy_id text not null, actor text not null, action text not null,
+    snapshot jsonb not null, changed_at timestamptz not null default now()
+  )`;
+  yield* sql`create index if not exists hosted_tool_policy_history_policy on hosted_tool_policy_history (organization_id, policy_id, sequence)`;
+});
