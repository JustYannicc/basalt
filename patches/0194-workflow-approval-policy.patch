index 00000000..ab1fa475
--- /dev/null
+++ b/apps/hosted/web/src/implementation/pages/tool-policy-editor.tsx
@@ -0,0 +1,259 @@
+import { useState } from "react";
+import { useAtomSet } from "@effect/atom-react";
+import { Exit, Schema } from "effect";
+import { JsonObject, type AppId, type AccountId } from "@executor-js/sdk";
+import type { ResourceDirectory } from "@executor-js/hosted-server/resource-access";
+import type { ToolPolicy, ToolPolicyValues } from "@executor-js/hosted-server/tool-policies";
+import { Button } from "@executor-js/ui/components/button";
+import { Input } from "@executor-js/ui/components/input";
+import { Textarea } from "@executor-js/ui/components/textarea";
+import {
+  Select,
+  SelectContent,
+  SelectItem,
+  SelectTrigger,
+  SelectValue,
+} from "@executor-js/ui/components/select";
+import { useOrganizationRoute } from "../components/organization.tsx";
+import { saveToolPolicyAtom } from "../../contracts/tool-policies.ts";
+import { appError } from "../../contracts/errors.ts";
+
+export const approvalModes = {
+  "always-ask": "Always ask",
+  "ask-writes": "Ask for writes",
+  "never-ask": "Never ask",
+} as const;
+
+/** Its draft and base revision survive failed saves and background list refreshes. */
+export function ToolPolicyEditor({
+  policy,
+  directory,
+  onDone,
+}: {
+  readonly policy?: ToolPolicy;
+  readonly directory: typeof ResourceDirectory.Type;
+  readonly onDone: () => void;
+}) {
+  const { organization } = useOrganizationRoute();
+  const save = useAtomSet(saveToolPolicyAtom(organization), { mode: "promiseExit" });
+  const [base, setBase] = useState(policy);
+  const [scope, setScope] = useState<ToolPolicyValues["target"]["kind"]>(
+    policy?.target.kind ?? "app",
+  );
+  const [app, setApp] = useState<AppId | undefined>(
+    policy?.target.kind === "account" ? undefined : policy?.target.app,
+  );
+  const [account, setAccount] = useState<AccountId | undefined>(policy?.target.account);
+  const [tool, setTool] = useState(policy?.target.kind === "tool" ? policy.target.tool : "");
+  const [mode, setMode] = useState<ToolPolicyValues["mode"]>(policy?.mode ?? "always-ask");
+  const [constraint, setConstraint] = useState(
+    policy?.inputSchema === undefined ? "" : JSON.stringify(policy.inputSchema, null, 2),
+  );
+  const [pending, setPending] = useState(false);
+  const [error, setError] = useState<string>();
+  const reset = () => {
+    setBase(policy);
+    setScope(policy?.target.kind ?? "app");
+    setApp(policy?.target.kind === "account" ? undefined : policy?.target.app);
+    setAccount(policy?.target.account);
+    setTool(policy?.target.kind === "tool" ? policy.target.tool : "");
+    setMode(policy?.mode ?? "always-ask");
+    setConstraint(
+      policy?.inputSchema === undefined ? "" : JSON.stringify(policy.inputSchema, null, 2),
+    );
+    setError(undefined);
+  };
+  const apps = directory.apps.filter((entry) => entry.access.canManage);
+  const accounts = directory.accounts.filter((entry) => entry.access.canManage);
+  return (
+    <form
+      className="grid gap-4 py-4"
+      onSubmit={async (event) => {
+        event.preventDefault();
+        setError(undefined);
+        let inputSchema: typeof JsonObject.Type | undefined;
+        if (constraint.trim()) {
+          try {
+            const value: unknown = JSON.parse(constraint);
+            if (!Schema.is(JsonObject)(value)) throw new Error();
+            inputSchema = value;
+          } catch {
+            setError("Enter an input constraint as a JSON Schema object.");
+            return;
+          }
+        }
+        let target: ToolPolicyValues["target"];
+        if (scope === "account") {
+          if (account === undefined) {
+            setError("Choose an account.");
+            return;
+          }
+          target = { kind: "account", account };
+        } else {
+          if (app === undefined || (scope === "tool" && !tool.trim())) {
+            setError("Choose an app and enter the exact tool name when needed.");
+            return;
+          }
+          const narrowed = account === undefined ? {} : { account };
+          target =
+            scope === "tool"
+              ? { kind: "tool", app, tool: tool.trim(), ...narrowed }
+              : { kind: "app", app, ...narrowed };
+        }
+        setPending(true);
+        const result = await save({
+          target,
+          mode,
+          ...(inputSchema === undefined ? {} : { inputSchema }),
+          ...(base === undefined ? {} : { id: base.id, revision: base.revision }),
+        });
+        setPending(false);
+        if (Exit.isFailure(result)) setError(appError(result.cause));
+        else onDone();
+      }}
+    >
+      <h3 className="text-sm font-medium">
+        {base?.revoked ? "Restore rule" : base ? "Edit rule" : "New approval rule"}
+      </h3>
+      <div className="grid gap-3 sm:grid-cols-2">
+        <label className="grid gap-1 text-sm">
+          Applies to
+          <Select
+            value={scope}
+            disabled={pending}
+            onValueChange={(value) => {
+              if (value === "app" || value === "tool" || value === "account") {
+                setScope(value);
+                setAccount(undefined);
+              }
+            }}
+          >
+            <SelectTrigger aria-label="Applies to">
+              <SelectValue />
+            </SelectTrigger>
+            <SelectContent>
+              <SelectItem value="app">App</SelectItem>
+              <SelectItem value="tool">Tool</SelectItem>
+              <SelectItem value="account">Account</SelectItem>
+            </SelectContent>
+          </Select>
+        </label>
+        <label className="grid gap-1 text-sm">
+          Approval
+          <Select
+            value={mode}
+            disabled={pending}
+            onValueChange={(value) => {
+              if (value === "always-ask" || value === "ask-writes" || value === "never-ask")
+                setMode(value);
+            }}
+          >
+            <SelectTrigger aria-label="Approval">
+              <SelectValue />
+            </SelectTrigger>
+            <SelectContent>
+              {Object.entries(approvalModes).map(([value, label]) => (
+                <SelectItem key={value} value={value}>
+                  {label}
+                </SelectItem>
+              ))}
+            </SelectContent>
+          </Select>
+        </label>
+        {scope !== "account" && (
+          <label className="grid gap-1 text-sm">
+            App
+            <Select
+              value={app ?? ""}
+              disabled={pending}
+              onValueChange={(value) =>
+                setApp(apps.find((entry) => entry.app.id === value)?.app.id)
+              }
+            >
+              <SelectTrigger aria-label="App">
+                <SelectValue placeholder="Choose an app" />
+              </SelectTrigger>
+              <SelectContent>
+                {apps.map((entry) => (
+                  <SelectItem key={entry.app.id} value={entry.app.id}>
+                    {entry.app.name}
+                  </SelectItem>
+                ))}
+              </SelectContent>
+            </Select>
+          </label>
+        )}
+        {scope === "tool" && (
+          <label className="grid gap-1 text-sm">
+            Exact tool name
+            <Input
+              value={tool}
+              onChange={(event) => setTool(event.target.value)}
+              disabled={pending}
+              required
+            />
+          </label>
+        )}
+        <label className="grid gap-1 text-sm">
+          {scope === "account" ? "Account" : "Account restriction"}
+          <Select
+            value={account ?? (scope === "account" ? "" : "all")}
+            disabled={pending}
+            onValueChange={(value) =>
+              setAccount(accounts.find((entry) => entry.account.id === value)?.account.id)
+            }
+          >
+            <SelectTrigger aria-label={scope === "account" ? "Account" : "Account restriction"}>
+              <SelectValue placeholder="Choose an account" />
+            </SelectTrigger>
+            <SelectContent>
+              {scope !== "account" && <SelectItem value="all">All linked accounts</SelectItem>}
+              {accounts.map((entry) => (
+                <SelectItem key={entry.account.id} value={entry.account.id}>
+                  {entry.account.label}
+                </SelectItem>
+              ))}
+            </SelectContent>
+          </Select>
+        </label>
+      </div>
+      <details>
+        <summary className="cursor-pointer text-sm">Input constraint</summary>
+        <div className="mt-2 grid gap-2">
+          <p className="text-xs text-muted-foreground">
+            Optional JSON Schema, draft 7. The rule applies only when the decoded input matches.
+          </p>
+          <Textarea
+            aria-label="Input constraint JSON Schema"
+            value={constraint}
+            onChange={(event) => setConstraint(event.target.value)}
+            disabled={pending}
+            rows={6}
+          />
+        </div>
+      </details>
+      <p className="text-xs text-muted-foreground">
+        App blocks and account access still apply. More specific rules take priority; equally
+        specific rules ask if any asks.
+      </p>
+      {error && (
+        <p role="alert" className="text-sm text-destructive">
+          {error}
+        </p>
+      )}
+      <div className="flex flex-wrap gap-2">
+        <Button type="submit" disabled={pending}>
+          {pending ? "Saving…" : base?.revoked ? "Restore rule" : "Save rule"}
+        </Button>
+        <Button type="button" variant="outline" disabled={pending} onClick={onDone}>
+          Cancel
+        </Button>
+        {base && (
+          <Button type="button" variant="ghost" disabled={pending} onClick={reset}>
+            Reset changes
+          </Button>
+        )}
+      </div>
+    </form>
+  );
+}
