index 00000000..e21c9ee3
--- /dev/null
+++ b/apps/hosted/server/src/implementation/tool-policy-store.ts
@@ -0,0 +1,64 @@
+import { Effect, Schema } from "effect";
+import type { SqlClient } from "effect/sql";
+import { StorageError } from "@executor-js/sdk/core";
+import type { OrganizationId } from "../contracts/organization.ts";
+import { ToolPolicy, ToolPolicyHistory } from "../contracts/tool-policies.ts";
+
+export const readToolPolicies = (sql: SqlClient.SqlClient, organization: OrganizationId) =>
+  sql`select definition from hosted_tool_policies where organization_id = ${organization} order by id`.pipe(
+    Effect.flatMap(
+      Schema.decodeUnknownEffect(Schema.Array(Schema.Struct({ definition: ToolPolicy }))),
+    ),
+    Effect.map((rows) => rows.map((row) => row.definition)),
+    Effect.mapError(() => new StorageError()),
+  );
+
+export const readToolPolicy = (
+  sql: SqlClient.SqlClient,
+  organization: OrganizationId,
+  id: string,
+  lock = false,
+) =>
+  sql`select definition from hosted_tool_policies where organization_id = ${organization} and id = ${id}${lock ? sql` for update` : sql``}`.pipe(
+    Effect.flatMap(
+      Schema.decodeUnknownEffect(Schema.Array(Schema.Struct({ definition: ToolPolicy }))),
+    ),
+    Effect.map((rows) => rows[0]?.definition),
+    Effect.mapError(() => new StorageError()),
+  );
+
+/** Called within the same transaction as the policy or SDK confirmation payload write. */
+export const recordToolPolicyChange = (
+  sql: SqlClient.SqlClient,
+  input: {
+    readonly organization: OrganizationId;
+    readonly id: string;
+    readonly actor: string;
+    readonly action: (typeof ToolPolicyHistory.Type)["action"];
+    readonly snapshot: (typeof ToolPolicyHistory.Type)["snapshot"];
+  },
+) =>
+  sql`insert into hosted_tool_policy_history (organization_id, policy_id, actor, action, snapshot)
+  values (${input.organization}, ${input.id}, ${input.actor}, ${input.action}, ${JSON.stringify(input.snapshot)}::jsonb)`.pipe(
+    Effect.asVoid,
+    Effect.mapError(() => new StorageError()),
+  );
+
+export const toolPolicyHistory = (
+  sql: SqlClient.SqlClient,
+  organization: OrganizationId,
+  id: string,
+  after = "0",
+) =>
+  sql`select h.sequence::text as cursor, h.actor, coalesce(u.name, h.actor) as "actorName", h.action, h.snapshot,
+    extract(epoch from h.changed_at)::double precision * 1000 as at
+    from hosted_tool_policy_history h left join "user" u on u.id = h.actor
+    where h.organization_id = ${organization} and h.policy_id = ${id}
+      and h.sequence > ${after}::bigint order by h.sequence limit 101`.pipe(
+    Effect.flatMap(Schema.decodeUnknownEffect(Schema.Array(ToolPolicyHistory))),
+    Effect.map((rows) => ({
+      items: rows.slice(0, 100),
+      ...(rows.length > 100 ? { next: rows[99]!.cursor } : {}),
+    })),
+    Effect.mapError(() => new StorageError()),
+  );
diff --git a/apps/hosted/server/src/implementation/tool-policy-evaluation.ts b/apps/hosted/server/src/implementation/tool-policy-evaluation.ts
new file mode 100644
index 00000000..2ac5917f
--- /dev/null
+++ b/apps/hosted/server/src/implementation/tool-policy-evaluation.ts
@@ -0,0 +1,79 @@
+import { Effect, Schema } from "effect";
+import type { SqlClient } from "effect/sql";
+import {
+  StorageError,
+  matchesToolPolicyInput,
+  type ToolPolicyHook,
+  type ToolPolicyEvent,
+} from "@executor-js/sdk/core";
+import { OrganizationId } from "../contracts/organization.ts";
+import { GroupDatabase } from "../contracts/groups.ts";
+import type { ToolPolicy } from "../contracts/tool-policies.ts";
+import { resourceAuthority, accountAccesses } from "./resource-policy.ts";
+import { manageToolPolicy } from "./tool-policies.ts";
+import { readToolPolicies } from "./tool-policy-store.ts";
+
+const specificity = (rule: ToolPolicy) =>
+  (rule.target.kind === "tool" ? 4 : 0) +
+  (rule.target.kind !== "account" ? 2 : 0) +
+  (rule.target.account !== undefined ? 1 : 0);
+const matches = (rule: ToolPolicy, event: ToolPolicyEvent) =>
+  !rule.revoked &&
+  (rule.target.kind === "account" || rule.target.app === event.app) &&
+  (rule.target.kind !== "tool" || rule.target.tool === event.tool) &&
+  (rule.target.account === undefined ||
+    event.accounts.some((a) => a.account === rule.target.account)) &&
+  matchesToolPolicyInput(rule.inputSchema, event.input);
+
+/** Specific rules win; equally specific rules ask if any asks. Missing rules retain app defaults. */
+export const hostedToolPolicy =
+  (sql: SqlClient.SqlClient): ToolPolicyHook =>
+  (event) =>
+    Effect.gen(function* () {
+      if (event.decision === "denied" || event.decision === "failed")
+        return { matched: false, decision: event.decision };
+      if (!event.owner.startsWith("organization:"))
+        return { matched: false, decision: event.decision };
+      const organization = yield* Schema.decodeUnknownEffect(OrganizationId)(
+        event.owner.slice("organization:".length),
+      );
+      const rows = (yield* readToolPolicies(sql, organization)).filter((rule) =>
+        matches(rule, event),
+      );
+      const accepted: ToolPolicy[] = [];
+      for (const rule of rows) {
+        const eligible = yield* Effect.gen(function* () {
+          const author = yield* resourceAuthority(organization, rule.actor);
+          yield* manageToolPolicy(rule.target, author);
+          // App ownership alone cannot waive another person's account approval.
+          const accounts = yield* accountAccesses(
+            event.accounts.map((account) => account.account),
+            author,
+          );
+          const asks =
+            rule.mode === "always-ask" || (rule.mode === "ask-writes" && event.kind === "mutation");
+          if (
+            !asks &&
+            accounts.some(
+              (account) =>
+                account.ownership.kind === "personal" && account.ownership.user !== rule.actor,
+            )
+          )
+            return false;
+          return true;
+        }).pipe(Effect.catchTag("OrganizationForbidden", () => Effect.succeed(false)));
+        if (eligible) accepted.push(rule);
+      }
+      if (accepted.length === 0) return { matched: false, decision: event.decision };
+      const rank = Math.max(...accepted.map(specificity));
+      const asks = accepted
+        .filter((rule) => specificity(rule) === rank)
+        .some(
+          (rule) =>
+            rule.mode === "always-ask" || (rule.mode === "ask-writes" && event.kind === "mutation"),
+        );
+      return { matched: true, decision: asks ? ("user-approval" as const) : ("approved" as const) };
+    }).pipe(
+      Effect.provideService(GroupDatabase, Effect.succeed(sql)),
+      Effect.mapError(() => new StorageError()),
+    );
diff --git a/apps/hosted/server/src/implementation/tool-policies.ts b/apps/hosted/server/src/implementation/tool-policies.ts
new file mode 100644
index 00000000..e7d2f97e
--- /dev/null
+++ b/apps/hosted/server/src/implementation/tool-policies.ts
@@ -0,0 +1,176 @@
+import { Clock, Effect, Schema } from "effect";
+import { StorageError, validToolPolicyConstraint } from "@executor-js/sdk/core";
+import { CurrentPrincipal, CurrentUserId } from "../contracts/auth.ts";
+import { OrganizationForbidden } from "../contracts/organization.ts";
+import {
+  ToolPolicyConflict,
+  ToolPolicyInvalid,
+  ToolPolicy,
+  type ToolPolicyTarget,
+  type ToolPolicyValues,
+} from "../contracts/tool-policies.ts";
+import { browserOnly } from "./access.ts";
+import {
+  policyDatabase,
+  lockCurrentActor,
+  currentResourceAuthority,
+  applicationAccess,
+  accountAccess,
+  type ResourceAuthority,
+} from "./resource-policy.ts";
+import {
+  readToolPolicies,
+  readToolPolicy,
+  recordToolPolicyChange,
+  toolPolicyHistory,
+} from "./tool-policy-store.ts";
+import {
+  listWorkflowConfirmations,
+  readWorkflowConfirmationHistory,
+  listWorkflowConfirmationChanges,
+} from "./workflow-confirmations.ts";
+export { revokeWorkflowConfirmation } from "./workflow-confirmations.ts";
+
+/** App management never grants management of somebody else's personal account. */
+export const manageToolPolicy = (target: ToolPolicyTarget, actor: ResourceAuthority) =>
+  Effect.gen(function* () {
+    if (target.kind !== "account" && !(yield* applicationAccess(target.app, actor)).canManage)
+      return yield* new OrganizationForbidden();
+    if (target.account !== undefined && !(yield* accountAccess(target.account, actor)).canManage)
+      return yield* new OrganizationForbidden();
+  });
+export const readToolPolicyAccess = (target: ToolPolicyTarget, actor: ResourceAuthority) =>
+  Effect.gen(function* () {
+    if (target.kind !== "account") {
+      const app = yield* applicationAccess(target.app, actor);
+      if (!app.canManage && !app.canUse) return yield* new OrganizationForbidden();
+    }
+    if (target.account !== undefined) {
+      const account = yield* accountAccess(target.account, actor);
+      if (!account.canManage && !account.canUse) return yield* new OrganizationForbidden();
+    }
+  });
+export const listToolPolicies = Effect.gen(function* () {
+  const actor = yield* currentResourceAuthority;
+  const rows = yield* readToolPolicies(yield* policyDatabase, actor.organization);
+  const policies = (yield* Effect.forEach(rows, (policy) =>
+    Effect.gen(function* () {
+      yield* readToolPolicyAccess(policy.target, actor);
+      const canEdit = yield* manageToolPolicy(policy.target, actor).pipe(
+        Effect.as(true),
+        Effect.catchTag("OrganizationForbidden", () => Effect.succeed(false)),
+      );
+      return [{ ...policy, canEdit }];
+    }).pipe(Effect.catchTag("OrganizationForbidden", () => Effect.succeed([]))),
+  )).flat();
+  return {
+    policies,
+    confirmations: yield* listWorkflowConfirmations,
+    confirmationChanges: yield* listWorkflowConfirmationChanges,
+  };
+});
+
+export const saveToolPolicy = (
+  input: ToolPolicyValues & { readonly id?: string; readonly revision?: number },
+) =>
+  Effect.gen(function* () {
+    yield* browserOnly;
+    const principal = yield* CurrentPrincipal;
+    if (principal.userId !== (yield* CurrentUserId)) return yield* new OrganizationForbidden();
+    if (!validToolPolicyConstraint(input.inputSchema)) return yield* new ToolPolicyInvalid();
+    const sql = yield* policyDatabase;
+    return yield* sql.withTransaction(
+      Effect.gen(function* () {
+        const actor = yield* lockCurrentActor;
+        yield* manageToolPolicy(input.target, actor);
+        const old =
+          input.id === undefined
+            ? undefined
+            : yield* readToolPolicy(sql, actor.organization, input.id, true);
+        if (input.id !== undefined) {
+          if (old === undefined || old.revision !== input.revision)
+            return yield* new ToolPolicyConflict();
+          yield* manageToolPolicy(old.target, actor);
+        }
+        const saved: ToolPolicy = {
+          id: old?.id ?? crypto.randomUUID(),
+          target: input.target,
+          mode: input.mode,
+          ...(input.inputSchema === undefined ? {} : { inputSchema: input.inputSchema }),
+          revision: (old?.revision ?? 0) + 1,
+          revoked: false,
+          actor: actor.user,
+          updatedAt: yield* Clock.currentTimeMillis,
+        };
+        if (old === undefined)
+          yield* sql`insert into hosted_tool_policies (id, organization_id, revision, definition)
+      values (${saved.id}, ${actor.organization}, ${saved.revision}, ${JSON.stringify(saved)}::jsonb)`;
+        else
+          yield* sql`update hosted_tool_policies set revision = ${saved.revision}, definition = ${JSON.stringify(saved)}::jsonb
+      where id = ${saved.id} and organization_id = ${actor.organization}`;
+        yield* recordToolPolicyChange(sql, {
+          organization: actor.organization,
+          id: saved.id,
+          actor: actor.user,
+          action: old === undefined ? "created" : old.revoked ? "restored" : "updated",
+          snapshot: saved,
+        });
+        return saved;
+      }),
+    );
+  }).pipe(Effect.catchTag("SqlError", () => new StorageError()));
+
+export const revokeToolPolicy = (id: string, revision: number) =>
+  Effect.gen(function* () {
+    yield* browserOnly;
+    const principal = yield* CurrentPrincipal;
+    if (principal.userId !== (yield* CurrentUserId)) return yield* new OrganizationForbidden();
+    const sql = yield* policyDatabase;
+    return yield* sql.withTransaction(
+      Effect.gen(function* () {
+        const actor = yield* lockCurrentActor;
+        const old = yield* readToolPolicy(sql, actor.organization, id, true);
+        if (old === undefined || old.revision !== revision || old.revoked)
+          return yield* new ToolPolicyConflict();
+        yield* manageToolPolicy(old.target, actor);
+        const saved = {
+          ...old,
+          revoked: true,
+          revision: old.revision + 1,
+          actor: actor.user,
+          updatedAt: yield* Clock.currentTimeMillis,
+        };
+        yield* sql`update hosted_tool_policies set revision = ${saved.revision}, definition = ${JSON.stringify(saved)}::jsonb
+      where id = ${id} and organization_id = ${actor.organization}`;
+        yield* recordToolPolicyChange(sql, {
+          organization: actor.organization,
+          id,
+          actor: actor.user,
+          action: "revoked",
+          snapshot: saved,
+        });
+        return saved;
+      }),
+    );
+  }).pipe(Effect.catchTag("SqlError", () => new StorageError()));
+
+export const readToolPolicyHistory = (id: string, after?: string) =>
+  Effect.gen(function* () {
+    if (id.startsWith("confirmation:")) return yield* readWorkflowConfirmationHistory(id, after);
+    const actor = yield* currentResourceAuthority;
+    const sql = yield* policyDatabase;
+    const policy = yield* readToolPolicy(sql, actor.organization, id);
+    if (policy === undefined) return yield* new OrganizationForbidden();
+    yield* readToolPolicyAccess(policy.target, actor);
+    const page = yield* toolPolicyHistory(sql, actor.organization, id, after);
+    const items = (yield* Effect.forEach(page.items, (entry) =>
+      Effect.gen(function* () {
+        const snapshot = yield* Schema.decodeUnknownEffect(ToolPolicy)(entry.snapshot).pipe(
+          Effect.mapError(() => new StorageError()),
+        );
+        yield* readToolPolicyAccess(snapshot.target, actor);
+        return [entry];
+      }).pipe(Effect.catchTag("OrganizationForbidden", () => Effect.succeed([]))),
+    )).flat();
+    return { ...page, items };
+  });
diff --git a/apps/hosted/server/src/implementation/tool-policy-handlers.ts b/apps/hosted/server/src/implementation/tool-policy-handlers.ts
