diff --git a/apps/hosted/cloud/src/implementation/repository-step.ts b/apps/hosted/cloud/src/implementation/repository-step.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/cloud/src/implementation/repository-step.ts
@@ -0,0 +1,56 @@
+import { Effect, Predicate } from "effect";
+import { providerFailureCode } from "./provider-failure.ts";
+
+/**
+ * The token coordinator's steps, on both sides of its RPC, that turn their own failure into a
+ * source failure with reason `git`. The Git adapter logs its own failures ("Managed Git operation
+ * failed"), so between them every `git` on the sweep's path names where it came from.
+ */
+export type RepositoryStep =
+  | "credentials"
+  | "decrypt"
+  | "history"
+  | "resolve"
+  | "tree"
+  | "blobs"
+  | "file"
+  | "initialize"
+  | "coordinator-open"
+  | "coordinator-token"
+  | "coordinator-mint"
+  | "coordinator-history"
+  | "coordinator-resolve"
+  | "coordinator-tree"
+  | "coordinator-blobs"
+  | "coordinator-file"
+  | "coordinator-create"
+  | "coordinator-initialize";
+
+/**
+ * Name which repository step failed, and how, before the failure becomes one `git` word: a tagged
+ * error by its tag and code, anything else by the provider failure code. Never its message or
+ * payload.
+ */
+export const repositoryStepFailed = (step: RepositoryStep) => (error: unknown) => {
+  const tagged = Predicate.hasProperty(error, "_tag") && typeof error._tag === "string";
+  return Effect.logWarning("Repository step failed", {
+    step,
+    error: tagged ? error._tag : providerFailureCode(error),
+    // A tag alone hides which kind: a provider's own code (`NOT_FOUND`), or how a transport
+    // failed (`reset`, `timeout`), from the provider failure code of what the tag wraps.
+    ...(tagged ? { code: failureCode(error) } : {}),
+  });
+};
+
+const providerCode = /^[A-Z][A-Z_]{0,39}$/;
+const failureCode = (error: object): string => {
+  const cause = Predicate.hasProperty(error, "cause") ? error.cause : undefined;
+  for (const value of [error, cause])
+    if (
+      Predicate.hasProperty(value, "code") &&
+      typeof value.code === "string" &&
+      providerCode.test(value.code)
+    )
+      return value.code;
+  return providerFailureCode(cause ?? error);
+};
