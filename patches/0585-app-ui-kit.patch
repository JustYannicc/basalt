@@ -0,0 +1,95 @@
+/**
+ * A provider's icon tile, without the dashboard's catalog or favicon lookups, so app pages can draw
+ * the same tile. `ProviderIcon` fills it with a logo when one loads; `ProviderMark` is the tile with
+ * the brand's monogram, the same thing the dashboard shows when no logo loads.
+ */
+import { HugeiconsIcon } from "@hugeicons/react";
+import { PackageIcon } from "@hugeicons/core-free-icons";
+import type { ReactNode } from "react";
+import { cn } from "../lib/utils.ts";
+import { providerBrand, type ProviderBrand } from "../lib/provider-brand.ts";
+
+/** `small` lists apps, `medium` is the compact account row's 24 pixels, `large` heads a page. */
+export type ProviderTileSize = "small" | "medium" | "large";
+
+/** The tinted tile; its ink comes from `brand.css` through `data-provider`. */
+export function ProviderTile({
+  brand,
+  size = "small",
+  children,
+}: {
+  readonly brand: ProviderBrand | undefined;
+  readonly size?: ProviderTileSize;
+  readonly children?: ReactNode;
+}) {
+  return (
+    <span
+      className={cn(
+        "provider-icon w-8.5 h-8.5 border border-border rounded-[7px] inline-flex items-center justify-center bg-background shrink-0 [&_img]:w-4.25 [&_img]:h-4.25 [&_img]:object-contain [&_>_svg]:w-4.25 [&_>_svg]:h-4.25 [&_>_svg]:object-contain max-[740px]:[.catalog-row_>_&]:row-[1_/_3]",
+        size === "large" &&
+          "provider-icon-large w-11 h-11 rounded-[9px] [&_img]:w-6 [&_img]:h-6 [&_>_svg]:w-6 [&_>_svg]:h-6",
+        size === "medium" && "size-6 rounded-md [&_img]:size-4.5 [&_>_svg]:size-4.5",
+      )}
+      data-provider={brand?.key}
+      aria-hidden
+    >
+      {children}
+    </span>
+  );
+}
+
+/** The brand's letters in the tile, for a provider whose logo is missing or failed to load. */
+export function ProviderMonogram({
+  brand,
+  size = "small",
+}: {
+  readonly brand: ProviderBrand;
+  readonly size?: ProviderTileSize;
+}) {
+  return (
+    <span
+      data-icon="monogram"
+      className={cn(
+        "font-semibold leading-none tracking-[-0.02em]",
+        size === "large" ? "text-[15px]" : size === "medium" ? "text-[11px]" : "text-[12px]",
+      )}
+    >
+      {brand.monogram}
+    </span>
+  );
+}
+
+/** The generic package glyph for a name without a brand or logo. */
+export function ProviderFallbackGlyph({ size = "small" }: { readonly size?: ProviderTileSize }) {
+  return (
+    <HugeiconsIcon
+      icon={PackageIcon}
+      aria-hidden
+      size={size === "large" ? 23 : 17}
+      strokeWidth={1.5}
+    />
+  );
+}
+
+/**
+ * A provider or lab by its display name, such as "Claude", "ChatGPT" or "Grok": its tinted tile and
+ * monogram, or the package glyph for a name without a brand. Decorative; name it beside the mark.
+ */
+export function ProviderMark({
+  name,
+  size = "small",
+}: {
+  readonly name: string;
+  readonly size?: ProviderTileSize;
+}) {
+  const brand = providerBrand(name);
+  return (
+    <ProviderTile brand={brand} size={size}>
+      {brand === undefined ? (
+        <ProviderFallbackGlyph size={size} />
+      ) : (
+        <ProviderMonogram brand={brand} size={size} />
+      )}
+    </ProviderTile>
+  );
+}
diff --git a/packages/ui/src/implementation/dashboard/account-name.tsx b/packages/ui/src/implementation/dashboard/account-name.tsx
new file mode 100644
