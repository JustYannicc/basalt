@@ -0,0 +1,79 @@
+/**
+ * An account's two name lines, shared by the dashboard's account rows and app pages. Callers decide
+ * what the lines say; this module only draws them, so it imports no host data or SDK code.
+ */
+import { HugeiconsIcon } from "@hugeicons/react";
+import { Tick02Icon } from "@hugeicons/core-free-icons";
+import type { ReactNode } from "react";
+import { cn } from "../lib/utils.ts";
+
+/** The muted second line: a verified identity, an authored label, or what a check reported. */
+export interface AccountNameSecondary {
+  readonly text: string;
+  /** Only the host's sign-in proof earns the check mark. */
+  readonly verified: boolean;
+  /** The person's own label, shown under a verified identity; never marked as an identity. */
+  readonly authored?: boolean;
+}
+
+/** The name, then the secondary line, each truncating with its full text on hover. */
+export function AccountNameLines({
+  title,
+  titleVerified = false,
+  secondary,
+  tags,
+  secondaryClassName,
+}: {
+  readonly title: string;
+  /** The title is the verified identity itself. */
+  readonly titleVerified?: boolean;
+  readonly secondary?: AccountNameSecondary | undefined;
+  /** Small labels after the name, such as Personal or Shared. */
+  readonly tags?: ReactNode;
+  /** A page's hook on the second line. */
+  readonly secondaryClassName?: string | undefined;
+}) {
+  return (
+    <div className="grid min-w-0 leading-[1.3] @max-[880px]/account-rows:self-start">
+      <span className="flex min-w-0 items-center gap-1.5">
+        <strong
+          className="min-w-0 truncate text-[13px] font-medium"
+          title={title}
+          data-account-name
+          {...(titleVerified ? { "data-account-verified": "" } : {})}
+        >
+          {title}
+        </strong>
+        {titleVerified && <VerifiedMark />}
+        {tags}
+      </span>
+      {secondary !== undefined && (
+        <span
+          className={cn(
+            "flex min-w-0 items-center gap-1 text-[12px] text-muted-foreground",
+            secondaryClassName,
+          )}
+        >
+          <span
+            className="min-w-0 truncate"
+            title={secondary.text}
+            {...(secondary.authored === true ? {} : { "data-account-identity": "" })}
+            {...(secondary.verified ? { "data-account-verified": "" } : {})}
+          >
+            {secondary.text}
+          </span>
+          {secondary.verified && <VerifiedMark />}
+        </span>
+      )}
+    </div>
+  );
+}
+
+function VerifiedMark() {
+  return (
+    <span className="inline-flex shrink-0 text-muted-foreground" title="Verified at sign-in">
+      <HugeiconsIcon icon={Tick02Icon} size={12} strokeWidth={2.5} aria-hidden />
+      <span className="sr-only">, verified</span>
+    </span>
+  );
+}
diff --git a/packages/ui/src/implementation/dashboard/account-check-state.tsx b/packages/ui/src/implementation/dashboard/account-check-state.tsx
new file mode 100644
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/account-check-state.tsx
@@ -0,0 +1,117 @@
+/**
+ * What an account check says and how it reads, shared by the Accounts list's Health column and app
+ * pages that show their selected accounts. It imports no dashboard context, host data or SDK code,
+ * so app pages draw the same words, order and colours as the host.
+ */
+import type { AccountAppHealth, AccountCheckStatus } from "apps/contracts";
+import { Match } from "effect";
+import { renewalFailure, renewalLabel } from "../../contracts/account-check-recovery.ts";
+import { cn } from "../lib/utils.ts";
+
+type Check = NonNullable<AccountAppHealth["check"]>;
+
+/** What one app's latest check means for the reader; tone matches the other status pills. */
+export const describeAccountCheck = (status: AccountCheckStatus) =>
+  Match.value(status).pipe(
+    Match.when("healthy", () => ({ label: "Healthy", tone: "good" as const })),
+    Match.when("credentials_rejected", () => ({ label: "Needs re-auth", tone: "bad" as const })),
+    Match.when("forbidden", () => ({ label: "Missing permission", tone: "warn" as const })),
+    Match.when("upstream_unavailable", () => ({
+      label: "Service unavailable",
+      tone: "warn" as const,
+    })),
+    Match.when("check_failed", () => ({ label: "Check failed", tone: "muted" as const })),
+    Match.when("tools_unavailable", () => ({ label: "Tools unavailable", tone: "bad" as const })),
+    Match.exhaustive,
+  );
+
+/** One result's label: a failed renewal names itself rather than the outage its status reports. */
+export const describeCheckResult = (check: Pick<Check, "status" | "failure">) => {
+  const described = describeAccountCheck(check.status);
+  return renewalFailure(check) === undefined ? described : { ...described, label: renewalLabel };
+};
+
+/** Check results from worst to best. */
+export const checkSeverity: readonly AccountCheckStatus[] = [
+  "credentials_rejected",
+  "tools_unavailable",
+  "forbidden",
+  "upstream_unavailable",
+  "check_failed",
+  "healthy",
+];
+
+/**
+ * The results in the worst state: current results before outdated ones, then by severity. A
+ * current failure is never hidden behind an older one, and an outdated result never outranks a
+ * current one. Empty when there are no results.
+ */
+export const worstChecks = <T extends { readonly check: Pick<Check, "status" | "current"> }>(
+  results: readonly T[],
+): readonly T[] => {
+  for (const current of [true, false])
+    for (const status of checkSeverity) {
+      const matching = results.filter(
+        (result) => result.check.current === current && result.check.status === status,
+      );
+      if (matching.length > 0) return matching;
+    }
+  return [];
+};
+
+export type CheckTone = ReturnType<typeof describeAccountCheck>["tone"];
+
+const dots: Record<CheckTone, string> = {
+  good: "bg-emerald-500",
+  bad: "bg-destructive",
+  warn: "bg-amber-500",
+  muted: "bg-muted-foreground/50",
+};
+const texts: Record<CheckTone, string> = {
+  good: "text-foreground",
+  bad: "text-destructive",
+  warn: "text-amber-700 dark:text-amber-400",
+  muted: "text-muted-foreground",
+};
+
+/** The Health cell's line box. */
+export const checkStateClass =
+  "inline-flex min-w-0 items-center gap-1.5 text-[13px] whitespace-nowrap";
+
+/** The dot before a health state's words; hollow marks a result from before a change. */
+export function CheckDot({
+  tone,
+  hollow = false,
+}: {
+  readonly tone: CheckTone;
+  readonly hollow?: boolean;
+}) {
+  return (
+    <span
+      aria-hidden
+      className={cn(
+        "size-1.5 shrink-0 rounded-full",
+        hollow ? "shadow-[inset_0_0_0_1.5px_var(--color-muted-foreground)]" : dots[tone],
+      )}
+    />
+  );
+}
+
+/** A current check's dot and words. The caller's line carries its title and data attributes. */
+export function CheckLabel({ check }: { readonly check: Pick<Check, "status" | "failure"> }) {
+  const { label, tone } = describeCheckResult(check);
+  return (
+    <>
+      <CheckDot tone={tone} />
+      <span
+        className={cn(
+          "truncate",
+          tone === "good" ? "text-muted-foreground" : texts[tone],
+          tone === "bad" && "font-medium",
+        )}
+      >
+        {label}
+      </span>
+    </>
+  );
+}
diff --git a/packages/apps/src/ui.tsx b/packages/apps/src/ui.tsx
new file mode 100644
--- /dev/null
+++ b/packages/apps/src/ui.tsx
@@ -0,0 +1,236 @@
+/**
+ * The dashboard's own controls for app pages, so an app reads as part of the product. Each export
+ * is the dashboard's implementation; these types are the stable part apps build against. Import
+ * `apps/ui.css` once from the page's stylesheet: it brings Tailwind and the dashboard's tokens.
+ * Declare `react` and `react-dom` in the app's dependencies.
+ */
+import type { ComponentProps, JSX, ReactNode } from "react";
+import type { ButtonProps } from "../../ui/src/contracts/button.ts";
+import { Badge as HostBadge } from "../../ui/src/implementation/components/badge.tsx";
+import { Button as HostButton } from "../../ui/src/implementation/components/button.tsx";
+import * as HostDialog from "../../ui/src/implementation/components/dialog.tsx";
+import { Spinner as HostSpinner } from "../../ui/src/implementation/components/spinner.tsx";
+import * as HostTabs from "../../ui/src/implementation/components/tabs.tsx";
+import { checkExplanation } from "../../ui/src/contracts/account-check-recovery.ts";
+import {
+  CheckDot,
+  CheckLabel,
+  checkStateClass,
+  describeCheckResult,
+  worstChecks,
+} from "../../ui/src/implementation/dashboard/account-check-state.tsx";
+import { AccountNameLines } from "../../ui/src/implementation/dashboard/account-name.tsx";
+import { ProviderMark as HostProviderMark } from "../../ui/src/implementation/dashboard/provider-mark.tsx";
+import { cn } from "../../ui/src/implementation/lib/utils.ts";
+import type { SelectedAccountView } from "./contracts/selected-account-read.ts";
+
+/** Props of `Button`. */
+export type { ButtonProps };
+
+/**
+ * The dashboard's button: `variant` and `size` pick its look, `loading` keeps its width under a
+ * spinner, and `disabledReason` keeps a forbidden action visible with its reason on hover, focus
+ * or tap. On phones it keeps a 44-pixel touch target.
+ */
+export const Button: (props: ButtonProps) => JSX.Element = HostButton;
+
+/** A neutral label such as a plan. Status keeps its own words and colours, never a badge. */
+export const Badge: (props: ComponentProps<"span">) => JSX.Element = HostBadge;
+
+/** The dashboard's loading mark. Show it only while something loads; it stops when removed. */
+export const Spinner: (props: { readonly className?: string }) => JSX.Element = HostSpinner;
+
+/** Props of `Tabs`: the selected value, controlled or not, and keyboard behaviour. */
+export interface TabsProps extends Omit<ComponentProps<"div">, "defaultValue" | "dir"> {
+  readonly value?: string;
+  readonly defaultValue?: string;
+  readonly onValueChange?: (value: string) => void;
+  readonly orientation?: "horizontal" | "vertical";
+  /** `manual`: arrow keys move focus and Enter or Space selects. Default: arrows select. */
+  readonly activationMode?: "automatic" | "manual";
+}
+/** Props of `TabsList`, the row of options. */
+export interface TabsListProps extends ComponentProps<"div"> {
+  /** `default` is a segmented control on a muted track; `line` underlines the selected tab. */
+  readonly variant?: "default" | "line";
+  /** `scroll` keeps a row wider than its column inside itself. */
+  readonly overflow?: "visible" | "scroll";
+}
+/** Props of `TabsTrigger`, one option; `value` names it. */
+export interface TabsTriggerProps extends Omit<ComponentProps<"button">, "value"> {
+  readonly value: string;
+}
+/** Props of `TabsContent`, the panel shown while its `value` is selected. */
+export interface TabsContentProps extends ComponentProps<"div"> {
+  readonly value: string;
+}
+
+/**
+ * Tabs, or a segmented control with `TabsList variant="default"`: one selected value, arrow keys
+ * between options, and the selected option announced to assistive technology.
+ */
+export const Tabs: (props: TabsProps) => JSX.Element = HostTabs.Tabs;
+/** The row of options; its `variant` picks segmented or underlined. */
+export const TabsList: (props: TabsListProps) => JSX.Element = HostTabs.TabsList;
+/** One option of `Tabs`. */
+export const TabsTrigger: (props: TabsTriggerProps) => JSX.Element = HostTabs.TabsTrigger;
+/** The panel for one option of `Tabs`. */
+export const TabsContent: (props: TabsContentProps) => JSX.Element = HostTabs.TabsContent;
+
+/** Props of `Dialog`: open state, controlled or not. */
+export interface DialogProps {
+  readonly open?: boolean;
+  readonly defaultOpen?: boolean;
+  readonly onOpenChange?: (open: boolean) => void;
+  readonly children?: ReactNode;
+}
+/** Props of `DialogTrigger` and `DialogClose`. */
+export interface DialogTriggerProps extends ComponentProps<"button"> {
+  /** Make the single child the trigger instead of a button. */
+  readonly asChild?: boolean;
+}
+/** Props of `DialogContent`, the modal panel. */
+export interface DialogContentProps extends ComponentProps<"div"> {
+  /** The corner Close button; true by default. Escape and the backdrop always close. */
+  readonly showCloseButton?: boolean;
+}
+/** Props of `DialogFooter`, the row of actions. */
+export interface DialogFooterProps extends ComponentProps<"div"> {
+  /** Adds an outline Close button after the footer's actions. */
+  readonly showCloseButton?: boolean;
+}
+
+/**
+ * The dashboard's modal: focus moves in on open (to the first field when there is one), stays
+ * inside, and returns to what opened it on close. Give every dialog a `DialogTitle`.
+ */
+export const Dialog: (props: DialogProps) => JSX.Element = HostDialog.Dialog;
+/** Opens its `Dialog`. */
+export const DialogTrigger: (props: DialogTriggerProps) => JSX.Element = HostDialog.DialogTrigger;
+/** The modal panel, with its backdrop. */
+export const DialogContent: (props: DialogContentProps) => JSX.Element = HostDialog.DialogContent;
+/** The title and description block. */
+export const DialogHeader: (props: ComponentProps<"div">) => JSX.Element = HostDialog.DialogHeader;
+/** The actions row; on phones the actions stack, primary last. */
+export const DialogFooter: (props: DialogFooterProps) => JSX.Element = HostDialog.DialogFooter;
+/** The dialog's accessible name. */
+export const DialogTitle: (props: ComponentProps<"h2">) => JSX.Element = HostDialog.DialogTitle;
+/** The dialog's accessible description. */
+export const DialogDescription: (props: ComponentProps<"p">) => JSX.Element =
+  HostDialog.DialogDescription;
+/** Closes its `Dialog`. */
+export const DialogClose: (props: DialogTriggerProps) => JSX.Element = HostDialog.DialogClose;
+
+/**
+ * A provider or lab by its display name, such as "Claude", "ChatGPT" or "Grok": the dashboard's
+ * tinted tile with its monogram, in the same ink as on the Accounts page. Decorative; show the name
+ * beside it. `medium` is the 24-pixel size of an account row.
+ */
+export const ProviderMark: (props: {
+  readonly name: string;
+  readonly size?: "small" | "medium" | "large";
+}) => JSX.Element = HostProviderMark;
+
+/** The native health of an account the app selected, as `SelectedAccountView` delivers it. */
+export type SelectedAccountHealth = Extract<SelectedAccountView, { state: "available" }>["health"];
+
+/**
+ * An account's name, and on a second muted line who its checks say it is (an email, else a
+ * username) when that differs from the name. `title` is the name the app shows, usually the
+ * account's label.
+ */
+export function AccountName({
+  title,
+  health,
+  tags,
+}: {
+  readonly title: string;
+  readonly health?: Pick<SelectedAccountHealth, "info"> | undefined;
+  /** Small labels after the name. */
+  readonly tags?: ReactNode;
+}) {
+  const reported = [health?.info?.email, health?.info?.username].find(
+    (value) => value !== undefined && value !== title,
+  );
+  return (
+    <AccountNameLines
+      title={title}
+      secondary={reported === undefined ? undefined : { text: reported, verified: false }}
+      tags={tags}
+    />
+  );
+}
+
+const checkedAt = new Intl.DateTimeFormat(undefined, { dateStyle: "medium", timeStyle: "short" });
+
+/**
+ * An account's health in a few words, by the Accounts list's rules: the account's own sign-in
+ * check first, then the worst app check, a current result before an outdated one. An outdated
+ * result reads "Not rechecked"; an account nothing can check shows nothing. `appName` names the
+ * apps behind a result in its tooltip.
+ */
+export function AccountHealth({
+  health,
+  appName,
+}: {
+  readonly health: SelectedAccountHealth;
+  readonly appName?: ((app: string) => string) | undefined;
+}) {
+  const driver = health.driver?.check ?? null;
+  const apps = worstChecks(
+    health.apps.flatMap((entry) =>
+      entry.check === null ? [] : [{ check: entry.check, app: entry.app }],
+    ),
+  );
+  const result =
+    driver === null
+      ? apps[0] === undefined
+        ? undefined
+        : { check: apps[0].check, by: apps.map((entry) => appName?.(entry.app)) }
+      : { check: driver, by: ["sign-in check"] };
+  if (result === undefined) {
+    const checkable =
+      health.driver?.checkable === true || health.apps.some((entry) => entry.checkable);
+    return checkable ? (
+      <span
+        className={cn(checkStateClass, "text-muted-foreground")}
+        data-account-health-cell
+        data-health-state="not-checked"
+      >
+        <CheckDot tone="muted" />
+        Not checked
+      </span>
+    ) : null;
+  }
+  const { check } = result;
+  const { label } = describeCheckResult(check);
+  const { message } = checkExplanation({ ...check, checkedAt: new Date(check.checkedAt) });
+  const by = result.by.filter((name) => name !== undefined);
+  const where = by.length === 0 ? "" : ` by ${by.join(", ")}`;
+  const when = checkedAt.format(new Date(check.checkedAt));
+  const marks = {
+    "data-account-health-cell": "",
+    "data-check-status": check.status,
+    "data-check-current": check.current,
+  };
+  return check.current ? (
+    <span
+      className={checkStateClass}
+      title={`${label}${where} · checked ${when}${message === undefined ? "" : `\n${message}`}`}
+      data-health-state={check.status}
+      {...marks}
+    >
+      <CheckLabel check={check} />
+    </span>
+  ) : (
+    <span
+      className={cn(checkStateClass, "text-muted-foreground")}
+      title={`Last check ${when}${where}, before the credentials or app changed`}
+      data-health-state="not-rechecked"
+      {...marks}
+    >
+      <CheckDot tone="muted" hollow />
+      Not rechecked
+    </span>
+  );
+}
