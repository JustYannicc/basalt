diff --git a/packages/ui/src/implementation/styles/tokens.css b/packages/ui/src/implementation/styles/tokens.css
new file mode 100644
--- /dev/null
+++ b/packages/ui/src/implementation/styles/tokens.css
@@ -0,0 +1,133 @@
+/*
+ * Executor's product tokens and base element styles. The dashboards import them through
+ * globals.css; app pages get the same file through `apps/ui.css`, so both stay one look.
+ * No `@source` or font files here: the app compiler accepts neither.
+ */
+@theme inline {
+  --font-sans: "Geist", ui-sans-serif, system-ui, sans-serif;
+  --font-mono: "Geist Mono", ui-monospace, "SF Mono", Menlo, monospace;
+  --color-background: var(--background);
+  --color-foreground: var(--foreground);
+  --color-card: var(--background);
+  --color-card-foreground: var(--foreground);
+  --color-popover: var(--background);
+  --color-popover-foreground: var(--foreground);
+  --color-primary: var(--primary);
+  --color-primary-foreground: var(--primary-foreground);
+  --color-secondary: var(--muted);
+  --color-secondary-foreground: var(--foreground);
+  --color-muted: var(--muted);
+  --color-muted-foreground: var(--muted-foreground);
+  --color-accent: var(--accent);
+  --color-accent-foreground: var(--foreground);
+  --color-destructive: var(--destructive);
+  --color-border: var(--border);
+  --color-input: var(--input);
+  --color-ring: var(--ring);
+  --color-sign-in-warning: var(--sign-in-warning);
+  --radius-sm: 5px;
+  --radius-md: 6px;
+  --radius-lg: 8px;
+}
+:root {
+  color-scheme: light;
+  --background: #fff;
+  --foreground: #111;
+  --primary: #0a0a0a;
+  --primary-foreground: #fff;
+  --muted: #fafafa;
+  --muted-foreground: #666;
+  --accent: #f5f5f5;
+  --destructive: #b4261a;
+  --border: #eaeaea;
+  --input: #d4d4d4;
+  --ring: #888;
+  --sign-in-warning: #99651a;
+}
+@media (prefers-color-scheme: dark) {
+  :root {
+    color-scheme: dark;
+    --background: #0a0a0a;
+    --foreground: #ededed;
+    --primary: #fff;
+    --primary-foreground: #0a0a0a;
+    --muted: #111;
+    --muted-foreground: #9a9a9a;
+    --accent: #1a1a1a;
+    --destructive: #e0726a;
+    --border: #242424;
+    --input: #333;
+    --ring: #777;
+    --sign-in-warning: #d6aa65;
+  }
+}
+@layer base {
+  * {
+    border-color: var(--border);
+  }
+  html,
+  body,
+  #root {
+    margin: 0;
+    min-height: 100%;
+    height: 100%;
+  }
+  @media (pointer: fine) {
+    html,
+    body {
+      overscroll-behavior-y: none;
+    }
+  }
+  body {
+    font-family: var(--font-sans);
+    background: var(--background);
+    color: var(--foreground);
+    font-size: 14px;
+    line-height: 1.5;
+    letter-spacing: -0.011em;
+    -webkit-font-smoothing: antialiased;
+  }
+  button,
+  a,
+  input {
+    -webkit-tap-highlight-color: transparent;
+  }
+  button,
+  a {
+    touch-action: manipulation;
+  }
+  button:not(:disabled),
+  [role="tab"] {
+    cursor: pointer;
+  }
+  a {
+    color: inherit;
+    text-decoration: none;
+  }
+  h1,
+  h2,
+  h3,
+  p {
+    margin: 0;
+  }
+  code,
+  pre {
+    font-family: var(--font-mono);
+  }
+  ::selection {
+    background: var(--input);
+  }
+  :focus-visible {
+    outline: 2px solid var(--ring);
+    outline-offset: 3px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: 0.01ms !important;
+    transition-duration: 0.01ms !important;
+  }
+}
diff --git a/packages/ui/src/implementation/styles/brand.css b/packages/ui/src/implementation/styles/brand.css
new file mode 100644
--- /dev/null
+++ b/packages/ui/src/implementation/styles/brand.css
@@ -0,0 +1,93 @@
+/*
+ * Lab identity colours (`provider-brand.ts`), one value per lab for icon tiles, healthy usage bars
+ * and pool chart series, plus two lightness steps of the same hue for extra series. Every shade keeps
+ * at least 3:1 against the page, and each lab colour against the usage meter track, on both themes.
+ * Status colours (low, critical, stale) never come from here.
+ */
+:root {
+  --brand-openai: light-dark(#0e9473, #19c37d);
+  --brand-openai-1: light-dark(#0b6e56, #7fe3b8);
+  --brand-openai-2: light-dark(#07463a, #14a86b);
+  --brand-anthropic: light-dark(#c4623f, #d97757);
+  --brand-anthropic-1: light-dark(#8f4129, #f0b59d);
+  --brand-anthropic-2: light-dark(#b5532f, #c4623f);
+  --brand-kimi: light-dark(#1773e6, #5aa7ff);
+  --brand-kimi-1: light-dark(#0d4fa6, #a8d0ff);
+  --brand-kimi-2: light-dark(#2a64c9, #3d8ef0);
+  --brand-google: light-dark(#1a73e8, #8ab4f8);
+  --brand-google-1: light-dark(#0f4fa8, #c3d7fb);
+  --brand-google-2: light-dark(#3367d6, #6b9ff0);
+}
+.brand-fill.brand-openai {
+  --brand-ink: var(--brand-openai);
+  --brand-ink-1: var(--brand-openai-1);
+  --brand-ink-2: var(--brand-openai-2);
+}
+.brand-fill.brand-anthropic {
+  --brand-ink: var(--brand-anthropic);
+  --brand-ink-1: var(--brand-anthropic-1);
+  --brand-ink-2: var(--brand-anthropic-2);
+}
+.brand-fill.brand-kimi {
+  --brand-ink: var(--brand-kimi);
+  --brand-ink-1: var(--brand-kimi-1);
+  --brand-ink-2: var(--brand-kimi-2);
+}
+.brand-fill.brand-google {
+  --brand-ink: var(--brand-google);
+  --brand-ink-1: var(--brand-google-1);
+  --brand-ink-2: var(--brand-google-2);
+}
+.brand-fill {
+  background-color: var(--brand-ink);
+}
+.brand-fill.brand-shade-1 {
+  background-color: var(--brand-ink-1);
+}
+.brand-fill.brand-shade-2 {
+  background-color: var(--brand-ink-2);
+}
+
+/*
+ * Model provider identity on icon tiles (`provider-brand.ts`). The ink tints only the tile behind
+ * the provider's logo and its monogram; account health keeps its own colours. Unlayered so the
+ * tile's utility background and border yield to it. Light and dark follow the page's color-scheme.
+ */
+.provider-icon[data-provider="openai"] {
+  --provider-ink: var(--brand-openai);
+}
+.provider-icon[data-provider="anthropic"] {
+  --provider-ink: var(--brand-anthropic);
+}
+.provider-icon[data-provider="gemini"] {
+  --provider-ink: var(--brand-google);
+}
+.provider-icon[data-provider="vertex"] {
+  --provider-ink: var(--brand-google);
+}
+.provider-icon[data-provider="antigravity"] {
+  --provider-ink: var(--brand-google);
+}
+.provider-icon[data-provider="kimi"] {
+  --provider-ink: var(--brand-kimi);
+}
+.provider-icon[data-provider="xai"] {
+  --provider-ink: var(--foreground);
+}
+.provider-icon[data-provider="devin"] {
+  --provider-ink: light-dark(#2469ad, #83bcf5);
+}
+.provider-icon[data-provider="meta"] {
+  --provider-ink: light-dark(#0866c9, #78b5ff);
+}
+.provider-icon[data-provider="jev"] {
+  --provider-ink: light-dark(#6550a7, #bca9eb);
+}
+.provider-icon[data-provider="cloudflare"] {
+  --provider-ink: light-dark(#a6500a, #ffb467);
+}
+.provider-icon[data-provider] {
+  color: var(--provider-ink);
+  background-color: color-mix(in oklab, var(--provider-ink) 12%, var(--background));
+  border-color: color-mix(in oklab, var(--provider-ink) 30%, var(--border));
+}
