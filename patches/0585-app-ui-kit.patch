+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { openPrivateApp, waitForAppUrl } from "../support/app-pages.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { App } from "../support/contracts.ts";
+import { withApps } from "../support/apps-release.ts";
+
+const Deployed = Schema.Struct({ ...App.fields, activeVersion: Schema.String });
+
+/** Selected-account health as `SelectedAccountView` delivers it to an app page. */
+const check = (status: string, current: boolean) => ({
+  status,
+  current,
+  checkedAt: "2026-11-13T10:00:00.000Z",
+});
+const accounts = [
+  {
+    provider: "Claude",
+    title: "Research",
+    plan: "Max 20x",
+    health: {
+      account: "account-claude",
