+import type * as React from "react";
+
+import { cn } from "../lib/utils.ts";
+
+/**
+ * A short neutral label, such as an account's plan. It truncates in a narrow cell and its full text
+ * stays on hover; status keeps its own coloured words and dots, never a tinted badge.
+ */
+function Badge({ className, title, children, ...props }: React.ComponentProps<"span">) {
+  return (
+    <span
+      data-slot="badge"
+      title={title ?? (typeof children === "string" ? children : undefined)}
+      className={cn(
+        "max-w-full truncate rounded-sm border px-1.5 text-[11px] leading-4.5 text-foreground",
+        className,
+      )}
+      {...props}
+    >
+      {children}
+    </span>
+  );
+}
+
+export { Badge };
diff --git a/packages/ui/src/implementation/dashboard/provider-mark.tsx b/packages/ui/src/implementation/dashboard/provider-mark.tsx
