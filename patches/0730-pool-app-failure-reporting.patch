diff --git a/apps/hosted/cloud/src/implementation/pool-app-incident.ts b/apps/hosted/cloud/src/implementation/pool-app-incident.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/cloud/src/implementation/pool-app-incident.ts
@@ -0,0 +1,34 @@
+/** Only a pool app route's closed failure fields pass the direct error sink's privacy boundary. */
+import type { ErrorEvent } from "@sentry/core";
+import {
+  isPoolAppRoute,
+  isPoolRefusalCode,
+  poolAppRefusalAttribute,
+  poolAppRouteAttribute,
+  reportedType,
+  scrubReportedText,
+} from "@executor-js/hosted-server/pool-app-failure";
+
+export const poolAppIncident = (event: ErrorEvent) => {
+  const route = event.tags?.[poolAppRouteAttribute];
+  const refusal = event.tags?.[poolAppRefusalAttribute];
+  const exception = event.exception?.values?.[0];
+  const failure = reportedType(exception?.type);
+  if (
+    !isPoolAppRoute(route) ||
+    (refusal !== undefined && !isPoolRefusalCode(refusal)) ||
+    failure === undefined
+  )
+    return undefined;
+  // The reporter already scrubbed it; scrubbing again keeps this boundary its own check.
+  const value = typeof exception?.value === "string" ? scrubReportedText(exception.value) : "";
+  return {
+    failure,
+    ...(value === "" ? {} : { value }),
+    tags: {
+      [poolAppRouteAttribute]: route,
+      ...(refusal === undefined ? {} : { [poolAppRefusalAttribute]: refusal }),
+    },
+    fingerprint: ["basalt", failure, route, ...(refusal === undefined ? [] : [refusal])],
+  };
+};
