diff --git a/apps/hosted/server/src/implementation/pool-refusal.ts b/apps/hosted/server/src/implementation/pool-refusal.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-refusal.ts
@@ -0,0 +1,52 @@
+/**
+ * What the pool answered when a usage read failed: its status and closed error code. The pool's
+ * `message` is its own text and is never kept. The refusal is held beside the tagged error, so
+ * the error's fields, wire encoding and what any caller receives stay as they were.
+ */
+import { Predicate } from "effect";
+
+/**
+ * Basalt's pool `ControlErrorCode` values that its usage reads answer. A mirror of the pool's
+ * contract (a TypeScript union only); a Basalt test fails when one is not in that union.
+ */
+export const poolRefusalCodes = [
+  "invalid_query",
+  "unauthorized",
+  "not_found",
+  "backend_unavailable",
+  "history_timeout",
+  "history_too_large",
+] as const;
+export type PoolRefusalCode = (typeof poolRefusalCodes)[number];
+
+const codes: ReadonlySet<string> = new Set(poolRefusalCodes);
+export const isPoolRefusalCode = (value: unknown): value is PoolRefusalCode =>
+  typeof value === "string" && codes.has(value);
+
+export interface PoolRefusal {
+  readonly status: number;
+  /** Absent when the pool's body named no listed code. */
+  readonly code?: PoolRefusalCode;
+  /** The pool the command named; it keys repeated refusals and is never reported. */
+  readonly pool?: string;
+}
+
+const refusals = new WeakMap<object, PoolRefusal>();
+
+/** Record the pool's answer for `error`, keeping only its status and a listed `error` code. */
+export const refusedBy = <E extends object>(
+  error: E,
+  response: { readonly status: number; readonly body: unknown },
+  payload: Readonly<Record<string, unknown>>,
+): E => {
+  const code = Predicate.hasProperty(response.body, "error") ? response.body.error : undefined;
+  refusals.set(error, {
+    status: response.status,
+    ...(isPoolRefusalCode(code) ? { code } : {}),
+    ...(typeof payload.pool === "string" ? { pool: payload.pool } : {}),
+  });
+  return error;
+};
+
+export const poolRefusal = (error: unknown): PoolRefusal | undefined =>
+  typeof error === "object" && error !== null ? refusals.get(error) : undefined;
