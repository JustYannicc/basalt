diff --git a/apps/hosted/server/src/implementation/pool-app-failure.ts b/apps/hosted/server/src/implementation/pool-app-failure.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-app-failure.ts
@@ -0,0 +1,129 @@
+/**
+ * A pool app API route answers its page "unavailable" for every failure it does not name, so the
+ * page never says why. Each such 5xx reaches error reporting here, tagged with its route and the
+ * pool's closed refusal code. The report is the failure as telemetry records it
+ * (`@executor-js/telemetry/recorded-failure`): its type and its message, with the message's values
+ * scrubbed. No field, cause, stack, request content or account data is reported.
+ */
+import { recordedError } from "@executor-js/telemetry/recorded-failure";
+import { Cause, Clock, Effect, ErrorReporter } from "effect";
+import { poolRefusal, type PoolRefusalCode } from "./pool-refusal.ts";
+
+export { isPoolRefusalCode } from "./pool-refusal.ts";
+
+export const poolAppRoutes = [
+  "pool-usage/summary",
+  "pool-usage/series",
+  "pool-usage/overview",
+  "pool-usage/personal-overview",
+  "pool-usage/account-label",
+] as const;
+export type PoolAppRoute = (typeof poolAppRoutes)[number];
+const routes: ReadonlySet<string> = new Set(poolAppRoutes);
+export const isPoolAppRoute = (value: unknown): value is PoolAppRoute =>
+  typeof value === "string" && routes.has(value);
+
+/** Span attributes the cloud error reporter copies to an incident's tags. */
+export const poolAppRouteAttribute = "executor.pool_app.route";
+export const poolAppRefusalAttribute = "executor.pool_app.refusal";
+
+const identifier = /^[A-Za-z][A-Za-z0-9_]{0,79}$/;
+/** A failure's type, when it is a plain identifier. */
+export const reportedType = (value: unknown) =>
+  typeof value === "string" && identifier.test(value) ? value : undefined;
+
+/**
+ * The hosted structured logs' rule for a message: the first kilobyte of its first line, with URLs,
+ * addresses, quoted values and long runs holding a digit (tokens, keys, hashes, IDs) replaced. It
+ * matters for an untagged error, whose message comes from the engine or a library.
+ */
+export const scrubReportedText = (message: string) =>
+  (message.split("\n", 1)[0] ?? "")
+    .slice(0, 1024)
+    .replace(/[a-z][a-z0-9+.-]{0,30}:\/\/\S*/gi, "<url>")
+    .replace(/[^\s"'<>@]{1,64}@[^\s"'<>@]{1,255}/g, "<email>")
+    .replace(/"[^"\n]*"|'[^'\n]*'/g, "<value>")
+    .replace(/[\w.~+/=-]{16,}/g, (run) => (/\d/.test(run) ? "<value>" : run))
+    .slice(0, 180);
+
+const recordedFailure = (error: unknown) => {
+  // A getter that throws or a cause chain that loops must not turn the route's 503 into a defect.
+  try {
+    const recorded = recordedError(error);
+    return recorded instanceof Error
+      ? {
+          name: reportedType(recorded.name) ?? "UnrecognizedFailure",
+          message: scrubReportedText(recorded.message),
+        }
+      : { name: "UnrecognizedFailure", message: "" };
+  } catch {
+    return { name: "UnrecognizedFailure", message: "" };
+  }
+};
+
+/** The error reported in place of `error`: its recorded type and scrubbed message only. */
+export const reportedFailure = (error: unknown): Error => {
+  const { name, message } = recordedFailure(error);
+  const failure = new Error(message);
+  failure.name = name;
+  failure.stack = message === "" ? name : `${name}: ${message}`;
+  return failure;
+};
+
+/**
+ * A summary the pool cannot roll up answers `history_too_large` on every load until a later rollup
+ * lands, so it reports once per pool within a window instead of once per page load. Only these
+ * deliberate refusals are held back: every other 5xx, named or not, reports each time, so a second
+ * outage is never hidden behind the first.
+ */
+const reportedOncePerCause: ReadonlySet<PoolRefusalCode> = new Set(["history_too_large"]);
+/** The pool's named refusals below 500: the request was wrong or not allowed, and nothing failed. */
+const quietRefusals: ReadonlySet<PoolRefusalCode> = new Set([
+  "invalid_query",
+  "unauthorized",
+  "not_found",
+]);
+const causeWindowMs = 60 * 60 * 1000;
+const causeLimit = 512;
+const causesReportedAt = new Map<string, number>();
+
+const firstInWindow = (key: string, now: number) => {
+  const last = causesReportedAt.get(key);
+  if (last !== undefined && now - last < causeWindowMs) return false;
+  causesReportedAt.delete(key);
+  // Insertion order is report order, so the first key is the oldest cause.
+  for (const oldest of causesReportedAt.keys()) {
+    if (causesReportedAt.size < causeLimit) break;
+    causesReportedAt.delete(oldest);
+  }
+  causesReportedAt.set(key, now);
+  return true;
+};
+
+/**
+ * Report a failure a pool app route answers with a 5xx. The pool's named refusals below 500 and
+ * failures marked `ErrorReporter.ignore` never report.
+ */
+export const reportPoolAppFailure = (route: PoolAppRoute, error: unknown) =>
+  Effect.gen(function* () {
+    if (ErrorReporter.isIgnored(error)) return;
+    const refusal = poolRefusal(error);
+    // These still answer the page "unavailable", but nothing failed. Any other answer the route
+    // turns into its 503, an unnamed 409 or 429 included, reports.
+    if (refusal?.code !== undefined && refusal.status < 500 && quietRefusals.has(refusal.code))
+      return;
+    if (
+      refusal?.code !== undefined &&
+      reportedOncePerCause.has(refusal.code) &&
+      !firstInWindow(`${refusal.code}\n${refusal.pool ?? ""}`, yield* Clock.currentTimeMillis)
+    )
+      return;
+    yield* ErrorReporter.report(Cause.fail(reportedFailure(error))).pipe(
+      Effect.withSpan("pool_app.failure", {
+        attributes: {
+          [poolAppRouteAttribute]: route,
+          ...(refusal?.code === undefined ? {} : { [poolAppRefusalAttribute]: refusal.code }),
+        },
+      }),
+    );
+  });
