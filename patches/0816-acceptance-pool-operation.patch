new file mode 100644
index 0000000..f74c51c
--- /dev/null
+++ b/apps/hosted/server/src/contracts/acceptance-pool.ts
@@ -0,0 +1,126 @@
+import { Data, Schema, type Effect } from "effect";
+import type { SqlClient } from "effect/sql";
+
+/**
+ * The one inert identity that holds the acceptance pool. The signed acceptance-pool operation is
+ * the only writer of its rows; every product path that would act for a person refuses or skips it.
+ */
+export const acceptanceIdentity = {
+  user: "acceptance",
+  organization: "acceptance",
+  slug: "acceptance",
+  member: "acceptance-owner",
+  name: "Acceptance",
+  // RFC 6761 reserves .invalid: no code sent here is ever delivered, and no provider verifies it.
+  email: "acceptance@basalt.invalid",
+} as const;
+
+export const isAcceptanceUser = (user: string | null | undefined) =>
+  user === acceptanceIdentity.user;
+export const isAcceptanceOrganization = (organization: string | null | undefined) =>
+  organization === acceptanceIdentity.organization;
+
+/** The pool's own audience and token-rotation jobs are the only lifecycle jobs it keeps. */
+export { poolAccessJobPrefix, poolRotationJobPrefix } from "./pool-defaults.ts";
+
+/** Every pool the operation creates is named so; the server refuses any other name. */
+export const acceptancePoolName = /^acceptance-[a-z0-9][a-z0-9-]{0,47}$/u;
+
+export type Json = typeof Schema.Json.Type;
+
+export const AcceptanceKind = Schema.Literals(["setup", "teardown"]);
+export type AcceptanceKind = typeof AcceptanceKind.Type;
+
+/** Every refusal is one of these words, so a caller and a log learn why and nothing else. */
+export const AcceptanceRefusalReason = Schema.Literals([
+  "request_invalid",
+  "name_pattern",
+  "checksum_mismatch",
+  "go_mismatch",
+  "stale_plan",
+  "replayed",
+  "operation_busy",
+  "receipt_mismatch",
+  "receipt_full",
+  "setup_missing",
+  "upstream_unset",
+  "upstream_differs",
+  "upstream_key_invalid",
+  "identity_conflict",
+  "identity_holds_pool",
+  "unrecorded_app",
+  "unrecorded_link",
+  "unrecorded_account",
+  "pool_state",
+  "verification_failed",
+  "step_failed",
+]);
+export type AcceptanceRefusalReason = typeof AcceptanceRefusalReason.Type;
+
+export class AcceptancePoolRefused extends Data.TaggedError("AcceptancePoolRefused")<{
+  readonly reason: AcceptanceRefusalReason;
+  /** For `step_failed`: the plan's own step name, never anything a caller sent. */
+  readonly step?: string;
+}> {}
+export const refuse = (reason: AcceptanceRefusalReason) => new AcceptancePoolRefused({ reason });
+
+export interface Verification {
+  readonly ok: boolean;
+  readonly checks: Readonly<Record<string, boolean>>;
+}
+
+export interface PlannedWrite {
+  readonly store: "tools" | "pool" | "home" | "cloudflare";
+  readonly table: string;
+  readonly key: string;
+  readonly action: "insert" | "update" | "delete" | "call";
+}
+
+export interface Inspection {
+  /** The sha256 of every precondition row, or "absent". Re-read and compared before a first apply. */
+  readonly observed: Readonly<Record<string, string>>;
+  readonly steps: readonly string[];
+  readonly writes: readonly PlannedWrite[];
+  /** Every id the apply will use, fixed here so a resumed apply reuses them. */
+  readonly data: Json;
+}
+
+/** What a setup recorded, which a teardown and its verification act on and nothing else. */
+export interface RecordedSetup {
+  readonly planSha256: string;
+  readonly data: Json;
+  readonly progress: Readonly<Record<string, Json>>;
+}
+
+export interface StepContext {
+  readonly kind: AcceptanceKind;
+  readonly request: Json;
+  readonly data: Json;
+  readonly progress: Readonly<Record<string, Json>>;
+  readonly setup?: RecordedSetup;
+  /** `https://<host>` from the deploy's own value, or undefined when the deploy set none. */
+  readonly upstreamOrigin: string | undefined;
+  readonly upstreamKey?: string;
+}
+
+/**
+ * The tools-service work behind the signed runner. The runner owns envelopes, plans, receipts,
+ * leases and resumption; steps own the product calls. Every step is idempotent on the ids its
+ * plan fixed, so a resumed apply repeats none of them.
+ */
+export interface AcceptancePoolSteps<R = never> {
+  readonly inspect: (
+    kind: AcceptanceKind,
+    request: Json,
+    setup: RecordedSetup | undefined,
+  ) => Effect.Effect<Inspection, unknown, SqlClient.SqlClient | R>;
+  readonly run: (
+    step: string,
+    context: StepContext,
+  ) => Effect.Effect<Json, unknown, SqlClient.SqlClient | R>;
+  readonly verify: (
+    context: StepContext,
+  ) => Effect.Effect<Verification, unknown, SqlClient.SqlClient | R>;
+  /** What the receipt names beside its kind and status: the pool app and its accounts. */
+  readonly describe: (context: StepContext) => Json;
+}
diff --git a/apps/hosted/server/src/implementation/acceptance-pool.ts b/apps/hosted/server/src/implementation/acceptance-pool.ts
new file mode 100644
index 0000000..5d23132
--- /dev/null
+++ b/apps/hosted/server/src/implementation/acceptance-pool.ts
@@ -0,0 +1,188 @@
+/**
+ * The product paths the signed acceptance-pool operation drives, each run as the acceptance
+ * identity exactly as an owner's own request would run it. Nothing here bypasses a product check:
+ * the pool is created, its provider installed, its accounts created and linked, unlinked and
+ * removed through the same calls the dashboard makes.
+ */
+import { fullAuthority } from "@executor-js/authorization";
+import { AccountId, AppId } from "@executor-js/sdk/core";
+import { Effect, Redacted, Schema } from "effect";
+import { acceptanceIdentity } from "../contracts/acceptance-pool.ts";
+import { AccountTargets } from "../contracts/account-grants.ts";
+import { CurrentUserId } from "../contracts/auth.ts";
+import { CurrentAuthorization } from "../contracts/authorization.ts";
+import { HostedExecutor } from "../contracts/executor.ts";
+import {
+  CurrentOrganization,
+  OrganizationId,
+  organizationOwner,
+} from "../contracts/organization.ts";
+import { disconnectAccount } from "./accounts.ts";
+import { appLinkSelection, unlink } from "./app-account-links.ts";
+import { installApp } from "./apps.ts";
+import { nativePoolMembership } from "./pool-membership.ts";
+import { createPool } from "./pools.ts";
+import { createRequirementAccount } from "./requirement-account-creation.ts";
+import { policyDatabase } from "./resource-policy.ts";
+
+const organization = OrganizationId.make(acceptanceIdentity.organization);
+export const acceptanceOwner = organizationOwner(organization);
+/** The catalog entry and requirement of the custom endpoint provider app. */
+export const customProviderEntry = "provider-custom";
+export const customRequirement = "custom";
+export const customProviderName = "Custom endpoint";
+
+/**
+ * The identity acting in its own organization with the authority its owner's own browser session
+ * would have there; it has no session, so nothing else can act as it.
+ */
+const asAcceptance = <A, E, R>(work: Effect.Effect<A, E, R>) =>
+  work.pipe(
+    Effect.provideService(CurrentAuthorization, fullAuthority),
+    Effect.provideService(CurrentUserId, acceptanceIdentity.user),
+    Effect.provideService(CurrentOrganization, {
+      organization,
+      owner: acceptanceOwner,
+      role: "owner",
+    }),
+  );
+
+const PoolRecord = Schema.Struct({
+  app: Schema.String,
+  request: Schema.NullOr(Schema.String),
+  name: Schema.NullOr(Schema.String),
+  owner: Schema.NullOr(Schema.String),
+  primary: Schema.NullOr(Schema.Boolean),
+  account: Schema.NullOr(Schema.String),
+  live: Schema.Boolean,
+});
+const OwnedApp = Schema.Struct({ id: Schema.String, name: Schema.String });
+const Link = Schema.Struct({
+  app: Schema.String,
+  requirement: Schema.String,
+  account: Schema.String,
+});
+const Access = Schema.Struct({
+  app: Schema.String,
+  audience: Schema.NullOr(Schema.String),
+  creator: Schema.NullOr(Schema.String),
+  groups: Schema.Number,
+});
+
+/** What the acceptance organization holds now: its pool records, its apps and their links. */
+export const acceptanceState = Effect.gen(function* () {
+  const sql = yield* policyDatabase;
+  const pools = yield* sql`select pool.key as app, pool.value ->> 'requestId' as request,
+      pool.value ->> 'requestName' as name, pool.value ->> 'owner' as owner,
+      (pool.value ->> 'primary')::boolean as primary, pool.value ->> 'account' as account,
+      exists (select 1 from executor_apps a where a.id = pool.key) as live
+    from organization o
+    cross join lateral jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) pool
+    where o.id = ${organization} order by pool.key`.pipe(
+    Effect.flatMap(Schema.decodeUnknownEffect(Schema.Array(PoolRecord))),
+  );
+  const apps = yield* sql`select id, name from executor_apps where owner = ${acceptanceOwner}
+    order by id`.pipe(Effect.flatMap(Schema.decodeUnknownEffect(Schema.Array(OwnedApp))));
+  const links = yield* sql`select l.app, l.requirement, l.account from hosted_app_account_links l
+    join executor_apps a on a.id = l.app where a.owner = ${acceptanceOwner}
+    order by l.app, l.requirement, l.account`.pipe(
+    Effect.flatMap(Schema.decodeUnknownEffect(Schema.Array(Link))),
+  );
+  const accounts = yield* sql`select id from executor_accounts where owner = ${acceptanceOwner}
+    order by id`.pipe(
+    Effect.flatMap(Schema.decodeUnknownEffect(Schema.Array(Schema.Struct({ id: Schema.String })))),
+    Effect.map((rows) => rows.map((row) => row.id)),
+  );
+  const access = yield* sql`select a.id as app, x.audience, x.creator_id as creator,
+      (select count(*) from hosted_app_groups g where g.app_id = a.id)::int as groups
+    from executor_apps a left join hosted_app_access x on x.id = a.id
+    where a.owner = ${acceptanceOwner} order by a.id`.pipe(
+    Effect.flatMap(Schema.decodeUnknownEffect(Schema.Array(Access))),
+  );
+  return { pools, apps, links, accounts, access };
+});
+export type AcceptanceState = Effect.Success<typeof acceptanceState>;
+
+/** The product's pool creation; the same request id replays the same pool. */
+export const createAcceptancePool = (name: string, requestId: string) =>
+  asAcceptance(createPool({ name, requestId, newInstance: false })).pipe(
+    Effect.map((app) => app.id as string),
+  );
+
+/** The catalog install; the organization's default instance is reused when it exists. */
+export const installCustomProvider = asAcceptance(
+  installApp(acceptanceOwner, { entry: customProviderEntry, name: customProviderName }),
+).pipe(Effect.map((app) => app.id as string));
+
+/** The provider's own account creation; the same creation id returns the same account. */
+export const createCustomAccount = (input: {
+  readonly app: string;
+  readonly creation: string;
+  readonly method: string;
+  readonly label: string;
+  readonly fields: { readonly baseUrl: string; readonly models: string; readonly token: string };
+}) =>
+  asAcceptance(
+    createRequirementAccount(
+      "app",
+      { app: AppId.make(input.app), requirement: customRequirement },
+      {
+        creation: input.creation,
+        method: input.method,
+        fields: Redacted.make({ ...input.fields }),
+        label: input.label,
+      },
+    ),
+  ).pipe(Effect.map((account) => account.id as string));
+
+/** The pool's own link path, whose hook tells the pool Worker and mirrors the account to Home. */
+export const linkCustomAccount = (pool: string, account: string) =>
+  asAcceptance(
+    appLinkSelection({
+      app: AppId.make(pool),
+      requirement: customRequirement,
+      account: AccountId.make(account),
+    }),
+  ).pipe(Effect.asVoid);
+
+/** The pool's own unlink path, which removes the link and lets Home drop the mirrored account. */
+export const unlinkCustomAccount = (pool: string, account: string) =>
+  asAcceptance(
+    unlink("app", {
+      app: AppId.make(pool),
+      requirement: customRequirement,
+      account: AccountId.make(account),
+    }),
+  ).pipe(Effect.asVoid);
+
+/** The account's own deletion, which refuses an account still linked to an app for everyone. */
+export const disconnectAcceptanceAccount = (account: string) =>
+  asAcceptance(
+    disconnectAccount.pipe(
+      Effect.provideService(AccountTargets.delete, { account: AccountId.make(account) }),
+    ),
+  ).pipe(Effect.asVoid);
+
+/**
+ * The SDK's app removal, which runs the hosted lifecycle: links and the service install go with
+ * the app, and a pool's removal tells the pool Worker inside the same transaction. The dashboard
+ * also forgets MCP connections naming the app; the identity never has a session, so it has none.
+ */
+export const removeAcceptanceApp = (app: string) =>
+  asAcceptance(
+    Effect.gen(function* () {
+      const executor = yield* Effect.flatten(HostedExecutor);
+      yield* executor.apps.remove({ owner: acceptanceOwner, app: AppId.make(app) });
+    }),
+  );
+
+/** The read the pool Worker itself uses to decide a pool's accounts. */
+export const acceptanceMembership = (pool: string) =>
+  Effect.gen(function* () {
+    const executor = yield* Effect.flatten(HostedExecutor);
+    const membership = yield* nativePoolMembership(organization, AppId.make(pool), executor);
+    return {
+      native: membership.native,
+      accounts: membership.accounts.map((account) => String(account.account)).toSorted(),
+    };
+  });
