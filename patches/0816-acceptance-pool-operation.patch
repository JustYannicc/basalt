@@ -0,0 +1,93 @@
+import { refuse, type Json, type StepContext } from "@executor-js/hosted-server/acceptance-pool";
+import { Effect, Schema } from "effect";
+import { canonical, sha256 } from "../production-ops/crypto.ts";
+import { upstreamProfiles } from "./request.ts";
+
+/** The acceptance organization's pools, apps, links and accounts, as the product reads them. */
+export interface AcceptanceState {
+  readonly pools: ReadonlyArray<{
+    readonly app: string;
+    readonly request: string | null;
+    readonly name: string | null;
+    readonly owner: string | null;
+    readonly primary: boolean | null;
+    /** The pool's token account, which its record names. */
+    readonly account: string | null;
+    readonly live: boolean;
+  }>;
+  readonly apps: ReadonlyArray<{ readonly id: string; readonly name: string }>;
+  readonly links: ReadonlyArray<{
+    readonly app: string;
+    readonly requirement: string;
+    readonly account: string;
+  }>;
+  readonly accounts: readonly string[];
+  readonly access: ReadonlyArray<{
+    readonly app: string;
+    readonly audience: string | null;
+    readonly creator: string | null;
+    readonly groups: number;
+  }>;
+}
+
+/** The product calls the steps make, each run by the tools service as the acceptance identity. */
+export interface AcceptanceProduct<R> {
+  readonly state: Effect.Effect<AcceptanceState, unknown, R>;
+  readonly createPool: (name: string, requestId: string) => Effect.Effect<string, unknown, R>;
+  readonly installProvider: Effect.Effect<string, unknown, R>;
+  readonly providerName: string;
+  readonly createAccount: (input: {
+    readonly app: string;
+    readonly creation: string;
+    readonly method: string;
+    readonly label: string;
+    readonly fields: { readonly baseUrl: string; readonly models: string; readonly token: string };
+  }) => Effect.Effect<string, unknown, R>;
+  readonly link: (pool: string, account: string) => Effect.Effect<void, unknown, R>;
+  readonly unlink: (pool: string, account: string) => Effect.Effect<void, unknown, R>;
+  readonly disconnect: (account: string) => Effect.Effect<void, unknown, R>;
+  readonly removeApp: (app: string) => Effect.Effect<void, unknown, R>;
+  readonly membership: (
+    pool: string,
+  ) => Effect.Effect<
+    { readonly native: boolean; readonly accounts: readonly string[] },
+    unknown,
+    R
+  >;
+}
+
+/** The ids a setup plan fixes when it is made, so a resumed apply reuses every one of them. */
+export const SetupData = Schema.Struct({
+  pool: Schema.String,
+  requestId: Schema.String,
+  accounts: Schema.Array(
+    Schema.Struct({
+      profile: Schema.Literals(upstreamProfiles),
+      method: Schema.Literals(["anthropic", "openai"]),
+      models: Schema.String,
+      creation: Schema.String,
+    }),
+  ),
+});
+export type SetupData = typeof SetupData.Type;
+export const setupData = (data: Json) =>
+  Schema.decodeUnknownEffect(SetupData)(data).pipe(Effect.mapError(() => refuse("stale_plan")));
+
+/** The account id the product derives from a creation id. */
+export const accountOf = (creation: string) => `acc_${creation.toLowerCase()}`;
+
+const Recorded = Schema.Struct({ app: Schema.String });
+const RecordedAccount = Schema.Struct({ account: Schema.String });
+export const recorded = (progress: StepContext["progress"], step: string) =>
+  Schema.decodeUnknownOption(Recorded)(progress[step]);
+export const recordedAccount = (progress: StepContext["progress"], step: string) =>
+  Schema.decodeUnknownOption(RecordedAccount)(progress[step]);
+
+/** Every account a setup has recorded so far, in profile order. */
+export const recordedAccounts = (progress: StepContext["progress"]) =>
+  upstreamProfiles.flatMap((profile) => {
+    const value = recordedAccount(progress, `account:${profile}`);
+    return value._tag === "Some" ? [value.value.account] : [];
+  });
+
+export const digest = (value: unknown) => sha256(`${canonical(value)}\n`);
diff --git a/apps/hosted/cloud/src/infrastructure/acceptance-pool/receipt.ts b/apps/hosted/cloud/src/infrastructure/acceptance-pool/receipt.ts
new file mode 100644
index 0000000..d1deb39
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/acceptance-pool/receipt.ts
@@ -0,0 +1,225 @@
+import {
+  acceptanceIdentity,
+  AcceptanceKind,
+  refuse,
+  type Json,
+} from "@executor-js/hosted-server/acceptance-pool";
+import { Effect, Option, Schema } from "effect";
+import { SqlClient, SqlError } from "effect/sql";
+import {
+  acceptanceEnvelopeLimit,
+  acceptanceLeaseMs,
+  acceptanceMigration,
+  acceptancePoolRevision,
+  acceptanceReceiptFormat,
+} from "./contracts.ts";
+
+const Verification = Schema.Struct({
+  ok: Schema.Boolean,
+  checks: Schema.Record(Schema.String, Schema.Boolean),
+});
+
+/** Progress lives in the production-ops receipt's `verification` column; there is no new table. */
+export const ReceiptState = Schema.Struct({
+  format: Schema.Literal(acceptanceReceiptFormat),
+  kind: AcceptanceKind,
+  request: Schema.Json,
+  data: Schema.Json,
+  steps: Schema.Record(Schema.String, Schema.Json),
+  envelopes: Schema.Array(Schema.String),
+  lease: Schema.NullOr(Schema.Struct({ envelope: Schema.String, until: Schema.Number })),
+  completed: Schema.Boolean,
+  verification: Schema.optionalKey(Verification),
+});
+export type ReceiptState = typeof ReceiptState.Type;
+
+const Row = Schema.Struct({
+  organization_id: Schema.String,
+  migration: Schema.String,
+  revision: Schema.String,
+  release: Schema.String,
+  backup_sha256: Schema.String,
+  verification: Schema.Unknown,
+});
+
+const lockedOrMoved = (error: unknown) => {
+  if (!SqlError.isSqlError(error)) return Effect.fail(error);
+  const driver = error.reason.cause;
+  const code =
+    typeof driver === "object" && driver !== null && "code" in driver ? driver.code : undefined;
+  // Another apply holds the row (55P03), or two first applies raced (23505, 40001).
+  return code === "55P03" || code === "23505" || code === "40001"
+    ? Effect.fail(refuse("operation_busy"))
+    : Effect.fail(error);
+};
+
+const bounded = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  yield* sql`set local statement_timeout = '5s'`;
+  yield* sql`set local lock_timeout = '500ms'`;
+  yield* sql`set local idle_in_transaction_session_timeout = '10s'`;
+});
+
+const decodeRow = (row: unknown, kind: AcceptanceKind, release: string, observed: string) =>
+  Effect.gen(function* () {
+    const decoded = yield* Schema.decodeUnknownEffect(Row)(row).pipe(
+      Effect.mapError(() => refuse("receipt_mismatch")),
+    );
+    if (
+      decoded.organization_id !== acceptanceIdentity.organization ||
+      decoded.migration !== acceptanceMigration(kind) ||
+      decoded.revision !== acceptancePoolRevision ||
+      decoded.release !== release ||
+      decoded.backup_sha256 !== observed
+    )
+      return yield* refuse("receipt_mismatch");
+    const state = yield* Schema.decodeUnknownEffect(ReceiptState)(decoded.verification).pipe(
+      Effect.mapError(() => refuse("receipt_mismatch")),
+    );
+    if (state.kind !== kind) return yield* refuse("receipt_mismatch");
+    return state;
+  });
+
+const write = (planSha256: string, state: ReceiptState) =>
+  Effect.flatMap(
+    SqlClient.SqlClient,
+    (sql) => sql`update private_production_ops_receipts
+      set verification = ${JSON.stringify(state)}::jsonb where plan_sha256 = ${planSha256}`,
+  );
+
+export interface Claim {
+  readonly state: ReceiptState;
+  readonly outcome: "fresh" | "resumed" | "completed";
+}
+
+/**
+ * Claims the plan's receipt for one envelope. A first claim runs `fresh` (the precondition re-read)
+ * in the same transaction before the row exists. A repeated envelope id is refused and writes
+ * nothing. A live lease is never taken; an expired one is, and its steps resume.
+ */
+export const claimReceipt = <R>(input: {
+  readonly planSha256: string;
+  readonly kind: AcceptanceKind;
+  readonly release: string;
+  /** The digest of the observed state the plan was made from, in the column named for a backup. */
+  readonly observedSha256: string;
+  readonly request: Json;
+  readonly data: Json;
+  readonly envelope: string;
+  readonly now: number;
+  /** Runs before any claim that will act: the same database, and nothing that forbids the act. */
+  readonly guard: Effect.Effect<void, unknown, SqlClient.SqlClient | R>;
+  readonly fresh: Effect.Effect<void, unknown, SqlClient.SqlClient | R>;
+}) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    return yield* sql
+      .withTransaction(
+        Effect.gen(function* () {
+          yield* sql`set transaction isolation level serializable`;
+          yield* bounded;
+          const rows = yield* sql`select organization_id, migration, revision, release,
+            backup_sha256, verification from private_production_ops_receipts
+            where plan_sha256 = ${input.planSha256} for update nowait`;
+          const lease = { envelope: input.envelope, until: input.now + acceptanceLeaseMs };
+          if (rows.length === 0) {
+            yield* input.guard;
+            yield* input.fresh;
+            const state: ReceiptState = {
+              format: acceptanceReceiptFormat,
+              kind: input.kind,
+              request: input.request,
+              data: input.data,
+              steps: {},
+              envelopes: [input.envelope],
+              lease,
+              completed: false,
+            };
+            yield* sql`insert into private_production_ops_receipts
+              (plan_sha256, organization_id, migration, revision, release, backup_sha256, verification)
+              values (${input.planSha256}, ${acceptanceIdentity.organization},
+                ${acceptanceMigration(input.kind)}, ${acceptancePoolRevision}, ${input.release},
+                ${input.observedSha256}, ${JSON.stringify(state)}::jsonb)`;
+            return { state, outcome: "fresh" } satisfies Claim;
+          }
+          const state = yield* decodeRow(rows[0], input.kind, input.release, input.observedSha256);
+          if (state.envelopes.includes(input.envelope)) return yield* refuse("replayed");
+          if (state.envelopes.length >= acceptanceEnvelopeLimit)
+            return yield* refuse("receipt_full");
+          const envelopes = [...state.envelopes, input.envelope];
+          if (state.completed) {
+            const next = { ...state, envelopes };
+            yield* write(input.planSha256, next);
+            return { state: next, outcome: "completed" } satisfies Claim;
+          }
+          if (state.lease !== null && state.lease.until > input.now)
+            return yield* refuse("operation_busy");
+          yield* input.guard;
+          const next = { ...state, envelopes, lease };
+          yield* write(input.planSha256, next);
+          return { state: next, outcome: "resumed" } satisfies Claim;
+        }),
+      )
+      .pipe(Effect.catch(lockedOrMoved));
+  });
+
+/** Changes the receipt only while this envelope still holds a live lease, and renews it. */
+export const updateReceipt = (input: {
+  readonly planSha256: string;
+  readonly kind: AcceptanceKind;
+  readonly release: string;
+  readonly observedSha256: string;
+  readonly envelope: string;
+  readonly now: number;
+  readonly change: (state: ReceiptState) => ReceiptState;
+}) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    return yield* sql
+      .withTransaction(
+        Effect.gen(function* () {
+          yield* bounded;
+          const rows = yield* sql`select organization_id, migration, revision, release,
+            backup_sha256, verification from private_production_ops_receipts
+            where plan_sha256 = ${input.planSha256} for update`;
+          if (rows.length !== 1) return yield* refuse("receipt_mismatch");
+          const state = yield* decodeRow(rows[0], input.kind, input.release, input.observedSha256);
+          if (
+            state.lease === null ||
+            state.lease.envelope !== input.envelope ||
+            state.lease.until <= input.now
+          )
+            return yield* refuse("operation_busy");
+          const changed = input.change(state);
+          const next = {
+            ...changed,
+            lease:
+              changed.lease === null
+                ? null
+                : { envelope: input.envelope, until: input.now + acceptanceLeaseMs },
+          };
+          yield* write(input.planSha256, next);
+          return next;
+        }),
+      )
+      .pipe(Effect.catch(lockedOrMoved));
+  });
+
+/** A recorded receipt, read without a lock: what verification and a teardown work from. */
+export const readReceipt = (planSha256: string, kind: AcceptanceKind) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const rows = yield* sql`select organization_id, migration, revision, verification
+      from private_production_ops_receipts where plan_sha256 = ${planSha256}`;
+    const row = rows[0];
+    if (rows.length !== 1 || row === undefined) return Option.none();
+    if (
+      row.organization_id !== acceptanceIdentity.organization ||
+      row.migration !== acceptanceMigration(kind) ||
+      row.revision !== acceptancePoolRevision
+    )
+      return Option.none();
+    return Schema.decodeUnknownOption(ReceiptState)(row.verification).pipe(
+      Option.filter((state) => state.kind === kind),
+    );
+  });
diff --git a/apps/hosted/cloud/src/infrastructure/acceptance-pool/request.ts b/apps/hosted/cloud/src/infrastructure/acceptance-pool/request.ts
new file mode 100644
index 0000000..7040eab
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/acceptance-pool/request.ts
@@ -0,0 +1,51 @@
+import {
+  acceptancePoolName,
+  refuse,
+  type AcceptanceKind,
+  type Json,
+} from "@executor-js/hosted-server/acceptance-pool";
+import { Effect, Schema } from "effect";
+
+export const upstreamProfiles = ["a", "b"] as const;
+
+export const SetupRequest = Schema.Struct({
+  pool: Schema.String,
+  accounts: Schema.Array(
+    Schema.Struct({
+      profile: Schema.Literals(upstreamProfiles),
+      method: Schema.Literals(["anthropic", "openai"]),
+      models: Schema.String.check(Schema.isMaxLength(4096)),
+    }),
+  ),
+});
+export type SetupRequest = typeof SetupRequest.Type;
+
+export const TeardownRequest = Schema.Struct({
+  setup: Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/u)),
+});
+export type TeardownRequest = typeof TeardownRequest.Type;
+
+/** The server's own reading of a request; nothing the caller names outside this shape is used. */
+export const setupRequest = (request: Json) =>
+  Effect.gen(function* () {
+    const setup = yield* Schema.decodeUnknownEffect(SetupRequest)(request).pipe(
+      Effect.mapError(() => refuse("request_invalid")),
+    );
+    if (!acceptancePoolName.test(setup.pool)) return yield* refuse("name_pattern");
+    const profiles = new Set(setup.accounts.map((account) => account.profile));
+    // Exactly the two test accounts, one per profile.
+    if (
+      setup.accounts.length !== upstreamProfiles.length ||
+      profiles.size !== setup.accounts.length
+    )
+      return yield* refuse("request_invalid");
+    return setup;
+  });
+
+export const teardownRequest = (request: Json) =>
+  Schema.decodeUnknownEffect(TeardownRequest)(request).pipe(
+    Effect.mapError(() => refuse("request_invalid")),
+  );
+
+export const checkRequest = (kind: AcceptanceKind, request: Json) =>
+  kind === "setup" ? Effect.asVoid(setupRequest(request)) : Effect.asVoid(teardownRequest(request));
diff --git a/apps/hosted/cloud/src/infrastructure/acceptance-pool/runner.ts b/apps/hosted/cloud/src/infrastructure/acceptance-pool/runner.ts
new file mode 100644
index 0000000..17f96c7
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/acceptance-pool/runner.ts
@@ -0,0 +1,322 @@
+import {
+  acceptanceIdentity,
+  AcceptancePoolRefused,
+  refuse,
+  type AcceptanceKind,
+  type AcceptancePoolSteps,
+  type Json,
+  type RecordedSetup,
+  type StepContext,
+  type Verification,
+} from "@executor-js/hosted-server/acceptance-pool";
+import { Cause, Clock, Effect, Option } from "effect";
+import { SqlClient } from "effect/sql";
+import { canonical } from "../production-ops/crypto.ts";
+import { databaseIdentity, type DatabaseOrigin } from "../production-ops/database-identity.ts";
+import { acceptanceMigration, acceptanceStepTimeoutMs, type SignedRequest } from "./contracts.ts";
+import { upstreamOrigin, upstreamOriginSha256 } from "./guard.ts";
+import {
+  makePlan,
+  observedSha256,
+  openPlan,
+  sealPlan,
+  type Plan,
+  type PlanSettings,
+} from "./plan.ts";
+import { claimReceipt, readReceipt, updateReceipt, type ReceiptState } from "./receipt.ts";
+import { checkRequest, teardownRequest } from "./request.ts";
+
+export interface RunnerSettings extends PlanSettings {
+  readonly databaseOrigin: DatabaseOrigin;
+  /** The deploy's value for the emulated upstream's host; undefined when the deploy set none. */
+  readonly upstreamHost: string | undefined;
+}
+
+// The emulated upstream's own key format (scripts/emulated-upstream/settings.ts).
+const upstreamKey = /^[A-Za-z0-9_-]{32,128}$/u;
+
+const now = Clock.currentTimeMillis;
+
+/** production-ops' read-only transaction, for steps that need more than SQL. */
+const readOnly = <A, E, R>(work: Effect.Effect<A, E, SqlClient.SqlClient | R>) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    return yield* sql.withTransaction(
+      Effect.gen(function* () {
+        yield* sql`set transaction isolation level repeatable read read only`;
+        yield* sql`set local statement_timeout = '5s'`;
+        yield* sql`set local lock_timeout = '500ms'`;
+        yield* sql`set local idle_in_transaction_session_timeout = '10s'`;
+        return yield* work;
+      }),
+    );
+  });
+
+/** What a setup recorded. A teardown that will act passes `time`, and waits out a running setup. */
+const recordedSetup = (planSha256: string, time?: number) =>
+  Effect.gen(function* () {
+    const state = yield* readReceipt(planSha256, "setup");
+    if (Option.isNone(state)) return yield* refuse("setup_missing");
+    if (time !== undefined && state.value.lease !== null && state.value.lease.until > time)
+      return yield* refuse("operation_busy");
+    return {
+      planSha256,
+      data: state.value.data,
+      progress: state.value.steps,
+    } satisfies RecordedSetup;
+  });
+
+/** A setup never resumes once a teardown has claimed it. */
+const noTeardownOf = (setup: string) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const rows = yield* sql`select 1 from private_production_ops_receipts
+      where migration = ${acceptanceMigration("teardown")}
+        and verification -> 'request' ->> 'setup' = ${setup}`;
+    if (rows.length > 0) return yield* refuse("pool_state");
+  });
+
+const context = (
+  settings: RunnerSettings,
+  kind: AcceptanceKind,
+  state: Pick<ReceiptState, "request" | "data" | "steps">,
+  setup: RecordedSetup | undefined,
+  key?: string,
+): StepContext => ({
+  kind,
+  request: state.request,
+  data: state.data,
+  progress: state.steps,
+  ...(setup === undefined ? {} : { setup }),
+  upstreamOrigin: upstreamOrigin(settings.upstreamHost),
+  ...(key === undefined ? {} : { upstreamKey: key }),
+});
+
+/**
+ * A step's failure, defects included, becomes `step_failed` naming the step, so the receipt keeps
+ * what was done and the closed word is all that leaves. A refusal keeps its own word.
+ */
+const failedStep =
+  (step: string) =>
+  (cause: Cause.Cause<unknown>): Effect.Effect<never, AcceptancePoolRefused> => {
+    const error = Option.getOrUndefined(Cause.findErrorOption(cause));
+    if (error instanceof AcceptancePoolRefused) return Effect.fail(error);
+    // The error's class tag, a name from code, is the one diagnostic that leaves: never a message.
+    const named =
+      typeof error === "object" && error !== null && "_tag" in error ? error._tag : undefined;
+    const tag =
+      typeof named === "string" && /^[A-Za-z][A-Za-z0-9]{0,63}$/u.test(named)
+        ? named
+        : Cause.hasDies(cause)
+          ? "defect"
+          : "unknown";
+    return Effect.logWarning("acceptance_pool.step_failed", { step, tag }).pipe(
+      Effect.andThen(Effect.fail(new AcceptancePoolRefused({ reason: "step_failed", step }))),
+    );
+  };
+
+/**
+ * The receipt as its readers see it, under names they rely on: the operation, the organization,
+ * whether it was applied, and what the steps name (the pool app and its accounts).
+ */
+const receiptOf = <R>(
+  steps: AcceptancePoolSteps<R>,
+  kind: AcceptanceKind,
+  completed: boolean,
+  stepContext: StepContext,
+) => ({
+  migration: acceptanceMigration(kind),
+  organization: acceptanceIdentity.organization,
+  status: completed ? ("applied" as const) : ("incomplete" as const),
+  ...(steps.describe(stepContext) as Record<string, Json>),
+});
+
+const checksPass = (verification: Verification) =>
+  verification.ok && Object.values(verification.checks).every(Boolean);
+
+/**
+ * Dry run, apply or verify for one signed request. The runner owns plans, receipts, leases and
+ * resumption; steps own the product calls and never see the envelope.
+ */
+export const runAcceptancePool = <R>(
+  settings: RunnerSettings,
+  signed: SignedRequest,
+  steps: AcceptancePoolSteps<R>,
+) =>
+  Effect.gen(function* () {
+    const { operation } = signed;
+    const { kind } = operation;
+    // A verification reads the receipt's own request; the one it was sent is not used.
+    if (operation.action !== "verify") yield* checkRequest(kind, operation.request);
+    const origin = upstreamOrigin(settings.upstreamHost);
+    if (
+      kind === "setup" &&
+      operation.action !== "verify" &&
+      origin !== undefined &&
+      operation.upstreamOriginSha256 !== upstreamOriginSha256(origin)
+    )
+      return yield* refuse("upstream_differs");
+
+    if (operation.action === "verify") {
+      if (operation.planSha256 === undefined || !/^[a-f0-9]{64}$/u.test(operation.planSha256))
+        return yield* refuse("request_invalid");
+      const state = yield* readReceipt(operation.planSha256, kind);
+      if (Option.isNone(state)) return yield* refuse("setup_missing");
+      const setup =
+        kind === "teardown"
+          ? yield* teardownRequest(state.value.request).pipe(
+              Effect.flatMap((request) => recordedSetup(request.setup)),
+            )
+          : undefined;
+      const stepContext = context(settings, kind, state.value, setup);
+      const verification = yield* steps.verify(stepContext);
+      return {
+        action: "verify" as const,
+        kind,
+        planSha256: operation.planSha256,
+        completed: state.value.completed,
+        receipt: receiptOf(steps, kind, state.value.completed, stepContext),
+        verification,
+      };
+    }
+
+    if (operation.action === "dry-run") {
+      if (operation.recipient === undefined) return yield* refuse("request_invalid");
+      const time = yield* now;
+      const setupSha256 =
+        kind === "teardown" ? (yield* teardownRequest(operation.request)).setup : null;
+      const { database, inspection } = yield* readOnly(
+        Effect.gen(function* () {
+          const setup = setupSha256 === null ? undefined : yield* recordedSetup(setupSha256, time);
+          return {
+            database: yield* databaseIdentity(settings.databaseOrigin),
+            inspection: yield* steps.inspect(kind, operation.request, setup),
+          };
+        }),
+      );
+      const plan = makePlan({
+        kind,
+        settings,
+        database,
+        now: time,
+        request: operation.request,
+        setup: setupSha256,
+        inspection,
+      });
+      const artifact = yield* sealPlan(plan, settings, operation.recipient);
+      return {
+        action: "dry-run" as const,
+        kind,
+        planSha256: artifact.sha256,
+        artifact,
+        steps: plan.steps.length,
+        writes: plan.writes.length,
+        upstreamConfigured: kind === "setup" ? (origin === undefined ? "no" : "yes") : undefined,
+      };
+    }
+
+    const opened = yield* openPlan(operation, settings, yield* now);
+    const plan: Plan = opened.plan;
+    const { planSha256 } = opened;
+    if (kind === "setup") {
+      if (origin === undefined) return yield* refuse("upstream_unset");
+      if (operation.upstreamKey === undefined || !upstreamKey.test(operation.upstreamKey))
+        return yield* refuse("upstream_key_invalid");
+    }
+    const sql = yield* SqlClient.SqlClient;
+    const observed = observedSha256(plan.observed);
+    const setupOf = () =>
+      plan.setup === null
+        ? Effect.succeed(undefined)
+        : Effect.flatMap(now, (time) => recordedSetup(plan.setup!, time));
+    const claim = yield* claimReceipt({
+      planSha256,
+      kind,
+      release: settings.release,
+      observedSha256: observed,
+      request: plan.request,
+      data: plan.data,
+      envelope: signed.id,
+      now: yield* now,
+      guard: Effect.gen(function* () {
+        const database = yield* databaseIdentity(settings.databaseOrigin);
+        if (
+          database.name !== plan.database.name ||
+          database.targetSha256 !== plan.database.targetSha256
+        )
+          return yield* refuse("stale_plan");
+        if (kind === "setup") yield* noTeardownOf(planSha256);
+      }),
+      fresh: Effect.gen(function* () {
+        const current = yield* steps.inspect(kind, plan.request, yield* setupOf());
+        if (canonical(current.observed) !== canonical(plan.observed))
+          return yield* refuse("stale_plan");
+      }),
+    }).pipe(Effect.provideService(SqlClient.SqlClient, sql));
+    if (claim.outcome === "completed")
+      return {
+        action: "apply" as const,
+        kind,
+        planSha256,
+        repeated: true,
+        resumed: false,
+        receipt: receiptOf(steps, kind, true, context(settings, kind, claim.state, undefined)),
+        verification: claim.state.verification,
+      };
+
+    const update = (change: (state: ReceiptState) => ReceiptState) =>
+      Effect.flatMap(now, (time) =>
+        updateReceipt({
+          planSha256,
+          kind,
+          release: settings.release,
+          observedSha256: observed,
+          envelope: signed.id,
+          now: time,
+          change,
+        }),
+      );
+    const work = Effect.gen(function* () {
+      const setup = yield* setupOf();
+      let state = claim.state;
+      for (const step of plan.steps) {
+        if (Object.hasOwn(state.steps, step)) continue;
+        const value: Json = yield* steps
+          .run(step, context(settings, kind, state, setup, operation.upstreamKey))
+          .pipe(Effect.timeout(acceptanceStepTimeoutMs), Effect.catchCause(failedStep(step)));
+        state = yield* update((current) => ({
+          ...current,
+          steps: { ...current.steps, [step]: value },
+        }));
+      }
+      const verification = yield* steps
+        .verify(context(settings, kind, state, setup))
+        .pipe(Effect.timeout(acceptanceStepTimeoutMs), Effect.catchCause(failedStep("verify")));
+      const passed = checksPass(verification);
+      yield* update((current) => ({
+        ...current,
+        verification,
+        completed: passed,
+        lease: null,
+      }));
+      if (!passed) return yield* refuse("verification_failed");
+      return {
+        verification,
+        receipt: receiptOf(steps, kind, true, context(settings, kind, state, setup)),
+      };
+    });
+    // A stopped apply gives its lease back, so a retry need not wait for it to run out.
+    const { verification, receipt } = yield* work.pipe(
+      // Defects and interruption included: a holder that stops for any reason lets go.
+      Effect.onError(() => update((current) => ({ ...current, lease: null })).pipe(Effect.ignore)),
+    );
+    return {
+      action: "apply" as const,
+      kind,
+      planSha256,
+      repeated: false,
+      resumed: claim.outcome === "resumed",
+      receipt,
+      verification,
+    };
+  });
diff --git a/apps/hosted/cloud/src/infrastructure/acceptance-pool/setup.ts b/apps/hosted/cloud/src/infrastructure/acceptance-pool/setup.ts
new file mode 100644
index 0000000..9aab4a4
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/acceptance-pool/setup.ts
@@ -0,0 +1,218 @@
+import {
+  refuse,
+  type Json,
+  type PlannedWrite,
+  type StepContext,
+} from "@executor-js/hosted-server/acceptance-pool";
+import { Effect } from "effect";
+import { canonical } from "../production-ops/crypto.ts";
+import { ensureIdentity, inspectIdentity, verifyIdentity } from "./identity.ts";
+import {
+  accountOf,
+  digest,
+  recorded,
+  recordedAccount,
+  recordedAccounts,
+  setupData,
+  type AcceptanceProduct,
+  type AcceptanceState,
+  type SetupData,
+} from "./product.ts";
+import { setupRequest } from "./request.ts";
+
+const uuid = Effect.sync(() => crypto.randomUUID());
+
+const identityWrites = (observed: Readonly<Record<string, string>>): PlannedWrite[] =>
+  (
+    [
+      ["identity.user", "user", "acceptance"],
+      ["identity.organization", "organization", "acceptance"],
+      ["identity.member", "member", "acceptance-owner"],
+    ] as const
+  )
+    .filter(([key]) => observed[key] === "absent")
+    .map(([, table, key]) => ({ store: "tools", table, key, action: "insert" }));
+
+const setupStepNames = (data: Pick<SetupData, "accounts">) => [
+  "identity",
+  "create",
+  "provider",
+  ...data.accounts.flatMap((account) => [`account:${account.profile}`, `link:${account.profile}`]),
+];
+
+/** The pool this setup created, found by the request id its plan fixed. */
+const ourPool = (state: AcceptanceState, data: SetupData) =>
+  state.pools.find((pool) => pool.request === data.requestId)?.app;
+
+export const setupSteps = <R>(product: AcceptanceProduct<R>) => {
+  const inspect = (request: Json) =>
+    Effect.gen(function* () {
+      const parsed = yield* setupRequest(request);
+      const identity = yield* inspectIdentity;
+      const state = yield* product.state;
+      // Exactly one pool: a setup starts only when the identity holds nothing at all, so a
+      // teardown that stopped early is finished before another pool can exist beside its leftovers.
+      if (state.pools.some((pool) => pool.live)) return yield* refuse("identity_holds_pool");
+      if (state.apps.length > 0) return yield* refuse("unrecorded_app");
+      // Links are read only on the organization's own apps, so none can exist without an app.
+      if (state.accounts.length > 0) return yield* refuse("unrecorded_account");
+      const accounts = [];
+      for (const account of parsed.accounts) accounts.push({ ...account, creation: yield* uuid });
+      const data = { pool: parsed.pool, requestId: yield* uuid, accounts };
+      const writes: PlannedWrite[] = [
+        ...identityWrites(identity),
+        { store: "tools", table: "executor_apps", key: parsed.pool, action: "insert" },
+        { store: "tools", table: "executor_apps", key: product.providerName, action: "insert" },
+        ...accounts.flatMap((account): PlannedWrite[] => [
+          {
+            store: "tools",
+            table: "executor_accounts",
+            key: accountOf(account.creation),
+            action: "insert",
+          },
+          {
+            store: "tools",
+            table: "hosted_app_account_links",
+            key: accountOf(account.creation),
+            action: "insert",
+          },
+        ]),
+        { store: "pool", table: "pool-directory-v1", key: parsed.pool, action: "call" },
+        { store: "home", table: "channel-group", key: parsed.pool, action: "call" },
+      ];
+      return {
+        observed: {
+          ...identity,
+          "acceptance.pools": digest(state.pools),
+          "acceptance.apps": digest(state.apps),
+          "acceptance.links": digest(state.links),
+          "acceptance.accounts": digest(state.accounts),
+        },
+        steps: setupStepNames(data),
+        writes,
+        data,
+      };
+    });
+
+  const run = (step: string, context: StepContext) =>
+    Effect.gen(function* () {
+      const data = yield* setupData(context.data);
+      if (step === "identity") return (yield* ensureIdentity) as Json;
+      const state = yield* product.state;
+      if (step === "create") {
+        if (state.pools.some((pool) => pool.live && pool.request !== data.requestId))
+          return yield* refuse("identity_holds_pool");
+        const mine = ourPool(state, data);
+        if (state.apps.some((app) => app.id !== mine)) return yield* refuse("unrecorded_app");
+        const token = state.pools.find((pool) => pool.app === mine)?.account;
+        if (state.accounts.some((account) => account !== token))
+          return yield* refuse("unrecorded_account");
+        return { app: yield* product.createPool(data.pool, data.requestId) };
+      }
+      const pool = recorded(context.progress, "create");
+      if (pool._tag === "None") return yield* refuse("pool_state");
+      if (step === "provider") {
+        // Only this operation writes in the organization; a resumed install finds its own default.
+        const others = state.apps.filter((app) => app.id !== pool.value.app);
+        if (others.length > 1 || others.some((app) => app.name !== product.providerName))
+          return yield* refuse("unrecorded_app");
+        return { app: yield* product.installProvider };
+      }
+      const [kind, profile] = step.split(":");
+      const account = data.accounts.find((entry) => entry.profile === profile);
+      if (account === undefined) return yield* refuse("pool_state");
+      if (kind === "account") {
+        const provider = recorded(context.progress, "provider");
+        if (provider._tag === "None") return yield* refuse("pool_state");
+        if (context.upstreamOrigin === undefined) return yield* refuse("upstream_unset");
+        if (context.upstreamKey === undefined) return yield* refuse("upstream_key_invalid");
+        // The address is the server's own: the deploy's host and the profile, never the request.
+        return {
+          account: yield* product.createAccount({
+            app: provider.value.app,
+            creation: account.creation,
+            method: account.method,
+            label: `Acceptance ${account.profile}`,
+            fields: {
+              baseUrl: `${context.upstreamOrigin}/${account.profile}`,
+              models: account.models,
+              token: context.upstreamKey,
+            },
+          }),
+        };
+      }
+      if (kind === "link") {
+        const created = recordedAccount(context.progress, `account:${profile}`);
+        if (created._tag === "None") return yield* refuse("pool_state");
+        const allowed = new Set(recordedAccounts(context.progress));
+        if (
+          state.links.some(
+            (link) =>
+              link.app === pool.value.app &&
+              link.requirement !== "pool" &&
+              !allowed.has(link.account),
+          )
+        )
+          return yield* refuse("unrecorded_link");
+        yield* product.link(pool.value.app, created.value.account);
+        return { account: created.value.account };
+      }
+      return yield* refuse("pool_state");
+    });
+
+  const verify = (context: StepContext) =>
+    Effect.gen(function* () {
+      const identity = yield* verifyIdentity;
+      const data = yield* setupData(context.data);
+      const state = yield* product.state;
+      const pool = recorded(context.progress, "create");
+      const provider = recorded(context.progress, "provider");
+      const accounts = recordedAccounts(context.progress).toSorted();
+      const app = pool._tag === "Some" ? pool.value.app : undefined;
+      const live = state.pools.filter((entry) => entry.live);
+      const poolLinks = state.links.filter((link) => link.app === app);
+      const membership =
+        app === undefined
+          ? undefined
+          : yield* product.membership(app).pipe(Effect.orElseSucceed(() => undefined));
+      return {
+        ...identity,
+        onePool:
+          live.length === 1 &&
+          live[0]?.app === app &&
+          live[0]?.owner === "acceptance" &&
+          live[0]?.primary === true &&
+          live[0]?.name === data.pool &&
+          live[0]?.request === data.requestId,
+        recordedApps:
+          provider._tag === "Some" &&
+          canonical(state.apps.map((entry) => entry.id).toSorted()) ===
+            canonical([app, provider.value.app].toSorted()),
+        // Exactly two recorded test accounts, and nothing else linked but the pool's token.
+        twoAccounts: accounts.length === 2,
+        poolLinks:
+          poolLinks.filter((link) => link.requirement === "pool").length === 1 &&
+          canonical(
+            poolLinks
+              .filter((link) => link.requirement !== "pool")
+              .map((link) => link.account)
+              .toSorted(),
+          ) === canonical(accounts),
+        membership:
+          membership !== undefined &&
+          membership.native &&
+          canonical([...membership.accounts].toSorted()) === canonical(accounts),
+      };
+    });
+
+  /** What the setup receipt names: the pool app it created and its two accounts. */
+  const describe = (context: StepContext): Json => {
+    const pool = recorded(context.progress, "create");
+    return {
+      app: pool._tag === "Some" ? pool.value.app : null,
+      accounts: recordedAccounts(context.progress),
+    };
+  };
+
+  return { inspect, run, verify, describe };
+};
diff --git a/apps/hosted/cloud/src/infrastructure/acceptance-pool/steps.ts b/apps/hosted/cloud/src/infrastructure/acceptance-pool/steps.ts
new file mode 100644
index 0000000..36d19d8
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/acceptance-pool/steps.ts
@@ -0,0 +1,28 @@
+import { type AcceptancePoolSteps } from "@executor-js/hosted-server/acceptance-pool";
+import { Effect } from "effect";
+import type { AcceptanceProduct } from "./product.ts";
+import { setupSteps } from "./setup.ts";
+import { teardownSteps } from "./teardown.ts";
+
+export type { AcceptanceProduct, AcceptanceState } from "./product.ts";
+
+const checked = <E, R>(checks: Effect.Effect<Readonly<Record<string, boolean>>, E, R>) =>
+  Effect.map(checks, (result) => ({ ok: Object.values(result).every(Boolean), checks: result }));
+
+/** The steps the route runs, one set per plan kind. */
+export const makeAcceptancePoolSteps = <R>(
+  product: AcceptanceProduct<R>,
+): AcceptancePoolSteps<R> => {
+  const setup = setupSteps(product);
+  const teardown = teardownSteps(product);
+  return {
+    inspect: (kind, request, recorded) =>
+      kind === "setup" ? setup.inspect(request) : teardown.inspect(recorded),
+    run: (step, context) =>
+      context.kind === "setup" ? setup.run(step, context) : teardown.run(step, context),
+    verify: (context) =>
+      checked(context.kind === "setup" ? setup.verify(context) : teardown.verify(context)),
+    describe: (context) =>
+      context.kind === "setup" ? setup.describe(context) : teardown.describe(context),
+  };
+};
diff --git a/apps/hosted/cloud/src/infrastructure/acceptance-pool/teardown.ts b/apps/hosted/cloud/src/infrastructure/acceptance-pool/teardown.ts
new file mode 100644
index 0000000..3cb2818
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/acceptance-pool/teardown.ts
@@ -0,0 +1,279 @@
+import {
+  acceptanceIdentity,
+  acceptancePoolName,
+  refuse,
+  type Json,
+  type PlannedWrite,
+  type RecordedSetup,
+  type StepContext,
+} from "@executor-js/hosted-server/acceptance-pool";
+import { Effect, Schema } from "effect";
+import { inspectIdentity, verifyIdentity } from "./identity.ts";
+import {
+  accountOf,
+  digest,
+  recorded,
+  setupData,
+  type AcceptanceProduct,
+  type AcceptanceState,
+  type SetupData,
+} from "./product.ts";
+import { upstreamProfiles } from "./request.ts";
+
+/** A step's record in the receipt. */
+const recordedAs = (value: Json): Json => value;
+
+/** What a teardown removes, fixed when it is planned. Null means it is already gone. */
+const TeardownData = Schema.Struct({
+  pool: Schema.NullOr(Schema.String),
+  provider: Schema.NullOr(Schema.String),
+  token: Schema.NullOr(Schema.String),
+  accounts: Schema.Array(
+    Schema.Struct({ profile: Schema.Literals(upstreamProfiles), id: Schema.String }),
+  ),
+});
+type TeardownData = typeof TeardownData.Type;
+const teardownData = (data: Json) =>
+  Schema.decodeUnknownEffect(TeardownData)(data).pipe(Effect.mapError(() => refuse("stale_plan")));
+
+/**
+ * Everything the setup created, found by the ids its plan fixed rather than only by what it
+ * recorded, so a setup that stopped before recording a step is still cleaned up. Anything in the
+ * organization that this setup did not create refuses the teardown.
+ */
+const targetsOf = (
+  state: AcceptanceState,
+  data: SetupData,
+  progress: StepContext["progress"],
+  providerName: string,
+) =>
+  Effect.gen(function* () {
+    const record = state.pools.find((pool) => pool.request === data.requestId);
+    if (
+      record !== undefined &&
+      (record.owner !== acceptanceIdentity.user ||
+        record.name !== data.pool ||
+        !acceptancePoolName.test(record.name ?? ""))
+    )
+      return yield* refuse("pool_state");
+    if (state.pools.some((pool) => pool.live && pool.request !== data.requestId))
+      return yield* refuse("unrecorded_app");
+    const pool = record?.live === true ? record.app : null;
+    const others = state.apps.filter((app) => app.id !== pool);
+    if (others.length > 1 || others.some((app) => app.name !== providerName))
+      return yield* refuse("unrecorded_app");
+    const provider = others[0]?.id ?? null;
+    const providerRecorded = recorded(progress, "provider");
+    if (
+      provider !== null &&
+      providerRecorded._tag === "Some" &&
+      providerRecorded.value.app !== provider
+    )
+      return yield* refuse("unrecorded_app");
+    const accounts = data.accounts.map((account) => ({
+      profile: account.profile,
+      id: accountOf(account.creation),
+    }));
+    const ids = new Set(accounts.map((account) => account.id));
+    const token = record?.account ?? null;
+    if (state.accounts.some((id) => !ids.has(id) && id !== token))
+      return yield* refuse("unrecorded_account");
+    if (
+      state.links.some(
+        (link) =>
+          !ids.has(link.account) &&
+          !(link.app === pool && link.requirement === "pool" && link.account === token),
+      )
+    )
+      return yield* refuse("unrecorded_link");
+    if (pool !== null) {
+      const access = state.access.find((entry) => entry.app === pool);
+      if (
+        access === undefined ||
+        access.audience !== "private" ||
+        access.creator !== acceptanceIdentity.user ||
+        access.groups !== 0
+      )
+        return yield* refuse("pool_state");
+    }
+    return {
+      pool,
+      provider,
+      token: token !== null && state.accounts.includes(token) ? token : null,
+      accounts,
+    } satisfies TeardownData;
+  });
+
+// An account is retired through the app that acquired it, so the accounts go before their
+// provider app, and they are unlinked from the pool before either.
+const teardownStepNames = (targets: TeardownData) => [
+  ...(targets.pool === null ? [] : targets.accounts.map((account) => `unlink:${account.profile}`)),
+  ...targets.accounts.map((account) => `disconnect:${account.profile}`),
+  ...(targets.provider === null ? [] : ["remove-provider"]),
+  ...(targets.pool === null ? [] : ["remove-pool"]),
+  ...(targets.token === null ? [] : ["disconnect-token"]),
+];
+
+export const teardownSteps = <R>(product: AcceptanceProduct<R>) => {
+  const inspect = (setup: RecordedSetup | undefined) =>
+    Effect.gen(function* () {
+      if (setup === undefined) return yield* refuse("setup_missing");
+      const data = yield* setupData(setup.data);
+      const identity = yield* inspectIdentity;
+      const state = yield* product.state;
+      const targets = yield* targetsOf(state, data, setup.progress, product.providerName);
+      const writes: PlannedWrite[] = [
+        ...(targets.pool === null
+          ? []
+          : targets.accounts.map((account): PlannedWrite => ({
+              store: "tools",
+              table: "hosted_app_account_links",
+              key: account.id,
+              action: "delete",
+            }))),
+        ...(targets.provider === null
+          ? []
+          : [
+              {
+                store: "tools",
+                table: "executor_apps",
+                key: targets.provider,
+                action: "delete",
+              } as const,
+            ]),
+        ...targets.accounts.map((account): PlannedWrite => ({
+          store: "tools",
+          table: "executor_accounts",
+          key: account.id,
+          action: "delete",
+        })),
+        ...(targets.pool === null
+          ? []
+          : [
+              {
+                store: "tools",
+                table: "executor_apps",
+                key: targets.pool,
+                action: "delete",
+              } as const,
+              {
+                store: "pool",
+                table: "pool-directory-v1",
+                key: targets.pool,
+                action: "call",
+              } as const,
+            ]),
+        ...(targets.token === null
+          ? []
+          : [
+              {
+                store: "tools",
+                table: "executor_accounts",
+                key: targets.token,
+                action: "delete",
+              } as const,
+            ]),
+      ];
+      return {
+        observed: {
+          ...identity,
+          "acceptance.pools": digest(state.pools),
+          "acceptance.apps": digest(state.apps),
+          "acceptance.links": digest(state.links),
+          "acceptance.accounts": digest(state.accounts),
+        },
+        steps: teardownStepNames(targets),
+        writes,
+        data: targets,
+      };
+    });
+
+  /** Each step acts only on a target its plan named, and does nothing once that target is gone. */
+  const run = (step: string, context: StepContext) =>
+    Effect.gen(function* () {
+      const targets = yield* teardownData(context.data);
+      const state = yield* product.state;
+      const ids = new Set(targets.accounts.map((account) => account.id));
+      const [kind, profile] = step.split(":");
+      const account = targets.accounts.find((entry) => entry.profile === profile);
+      if (kind === "unlink" && account !== undefined && targets.pool !== null) {
+        if (state.links.some((link) => link.app === targets.pool && link.account === account.id))
+          yield* product.unlink(targets.pool, account.id);
+        return recordedAs({ unlinked: account.id });
+      }
+      if (step === "remove-provider" && targets.provider !== null) {
+        if (state.apps.some((app) => app.id === targets.provider)) {
+          if (state.links.some((link) => link.app === targets.provider && !ids.has(link.account)))
+            return yield* refuse("unrecorded_link");
+          yield* product.removeApp(targets.provider);
+        }
+        return recordedAs({ removed: targets.provider });
+      }
+      if (kind === "disconnect" && account !== undefined) {
+        if (state.accounts.includes(account.id)) yield* product.disconnect(account.id);
+        return recordedAs({ disconnected: account.id });
+      }
+      if (step === "remove-pool" && targets.pool !== null) {
+        if (state.apps.some((app) => app.id === targets.pool)) {
+          // By now only the pool's own token link may remain.
+          if (
+            state.links.some(
+              (link) =>
+                link.app === targets.pool &&
+                !(link.requirement === "pool" && link.account === targets.token),
+            )
+          )
+            return yield* refuse("unrecorded_link");
+          yield* product.removeApp(targets.pool);
+        }
+        return recordedAs({ removed: targets.pool });
+      }
+      if (step === "disconnect-token" && targets.token !== null) {
+        if (state.accounts.includes(targets.token)) yield* product.disconnect(targets.token);
+        return recordedAs({ disconnected: targets.token });
+      }
+      return yield* refuse("pool_state");
+    });
+
+  const verify = (context: StepContext) =>
+    Effect.gen(function* () {
+      const identity = yield* verifyIdentity;
+      const targets = yield* teardownData(context.data);
+      const data = context.setup === undefined ? undefined : yield* setupData(context.setup.data);
+      const state = yield* product.state;
+      const gone = new Set(
+        [
+          targets.pool,
+          targets.provider,
+          targets.token,
+          ...targets.accounts.map((a) => a.id),
+        ].filter((id): id is string => id !== null),
+      );
+      const membership =
+        targets.pool === null
+          ? { native: false, accounts: [] }
+          : yield* product.membership(targets.pool).pipe(Effect.orElseSucceed(() => undefined));
+      return {
+        ...identity,
+        appsGone: !state.apps.some((app) => gone.has(app.id)),
+        noLivePool:
+          data !== undefined &&
+          !state.pools.some((pool) => pool.request === data.requestId && pool.live),
+        accountsGone: !state.accounts.some((id) => gone.has(id)),
+        linksGone: !state.links.some((link) => gone.has(link.app) || gone.has(link.account)),
+        // Nothing at all is left in the organization, which is what the next setup requires.
+        organizationEmpty:
+          state.apps.length === 0 && state.accounts.length === 0 && state.links.length === 0,
+        membershipGone: membership !== undefined && !membership.native,
+      };
+    });
+
+  const describe = (context: StepContext): Json => {
+    const targets = Schema.decodeUnknownOption(TeardownData)(context.data);
+    return targets._tag === "Some"
+      ? { app: targets.value.pool, accounts: targets.value.accounts.map((account) => account.id) }
+      : { app: null, accounts: [] };
+  };
+
+  return { inspect, run, verify, describe };
+};
