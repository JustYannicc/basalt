diff --git a/apps/hosted/cloud/src/infrastructure/acceptance-pool/cloud.ts b/apps/hosted/cloud/src/infrastructure/acceptance-pool/cloud.ts
new file mode 100644
index 0000000..f0a4fa8
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/acceptance-pool/cloud.ts
@@ -0,0 +1,87 @@
+import {
+  acceptanceMembership,
+  acceptanceState,
+  createAcceptancePool,
+  createCustomAccount,
+  customProviderName,
+  disconnectAcceptanceAccount,
+  installCustomProvider,
+  linkCustomAccount,
+  removeAcceptanceApp,
+  unlinkCustomAccount,
+} from "@executor-js/hosted-server/acceptance-pool-product";
+import { Config, Effect, Option, Redacted } from "effect";
+import { productionOpsRelease } from "../../implementation/production-ops-release.ts";
+import { cloudDirectDatabaseConnection } from "../database.ts";
+import { databaseOrigin } from "../production-ops/database-identity.ts";
+import { cloudEncryptionKey } from "../secrets.ts";
+import { cloudHosts } from "../stage.ts";
+import { acceptancePoolHandler } from "./http.ts";
+import { makeAcceptancePoolSteps } from "./steps.ts";
+
+type Needs<T> = T extends (...args: never[]) => Effect.Effect<unknown, unknown, infer R>
+  ? R
+  : T extends Effect.Effect<unknown, unknown, infer R>
+    ? R
+    : never;
+/** Everything the product calls need; the route's request layer provides each of them. */
+type ProductNeeds =
+  | Needs<typeof acceptanceState>
+  | Needs<typeof createAcceptancePool>
+  | Needs<typeof installCustomProvider>
+  | Needs<typeof createCustomAccount>
+  | Needs<typeof linkCustomAccount>
+  | Needs<typeof unlinkCustomAccount>
+  | Needs<typeof disconnectAcceptanceAccount>
+  | Needs<typeof removeAcceptanceApp>
+  | Needs<typeof acceptanceMembership>;
+
+const steps = makeAcceptancePoolSteps<ProductNeeds>({
+  state: acceptanceState,
+  createPool: createAcceptancePool,
+  installProvider: installCustomProvider,
+  providerName: customProviderName,
+  createAccount: createCustomAccount,
+  link: linkCustomAccount,
+  unlink: unlinkCustomAccount,
+  disconnect: disconnectAcceptanceAccount,
+  removeApp: removeAcceptanceApp,
+  membership: acceptanceMembership,
+});
+
+/**
+ * The deploy's input becomes a plain Worker variable, and only when it is set. Without it the
+ * route has no upstream host: a setup plan says so and its accounts refuse.
+ */
+export const acceptanceUpstreamBinding = Effect.map(
+  Config.String("BASALT_ACCEPTANCE_UPSTREAM_HOST").pipe(Config.option),
+  Option.match({
+    onNone: () => ({}),
+    onSome: (host) => ({ BASALT_ACCEPTANCE_UPSTREAM_HOST: host }),
+  }),
+);
+
+/** The deployed route: production-ops' key, hosts, release and database identity. */
+export const cloudAcceptancePool = Effect.gen(function* () {
+  const signingKey = yield* Config.Redacted("POOL_APP_SIGNING_KEY").pipe(Config.option);
+  // Set once by the deploy's input; unset means a setup plan says so and its link refuses.
+  const upstreamHost = yield* Config.String("BASALT_ACCEPTANCE_UPSTREAM_HOST").pipe(Config.option);
+  const encryptionKey = yield* cloudEncryptionKey.pipe(Effect.orDie);
+  const hosts = yield* cloudHosts.pipe(Effect.orDie);
+  const directConnection = yield* cloudDirectDatabaseConnection;
+  return acceptancePoolHandler({
+    signingKey,
+    target: hosts.browser,
+    settings: Effect.gen(function* () {
+      const secret = yield* encryptionKey;
+      return {
+        target: hosts.browser,
+        release: productionOpsRelease,
+        encryptionKey: Redacted.value(secret),
+        databaseOrigin: yield* databaseOrigin(yield* directConnection.connectionString),
+        upstreamHost: Option.getOrUndefined(upstreamHost),
+      };
+    }),
+    steps,
+  });
+});
diff --git a/apps/hosted/cloud/src/infrastructure/acceptance-pool/contracts.ts b/apps/hosted/cloud/src/infrastructure/acceptance-pool/contracts.ts
new file mode 100644
index 0000000..a0d93a8
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/acceptance-pool/contracts.ts
@@ -0,0 +1,55 @@
+import {
+  AcceptanceKind,
+  type AcceptanceRefusalReason,
+} from "@executor-js/hosted-server/acceptance-pool";
+import { Schema } from "effect";
+import { ProtectedArtifact } from "../production-ops/crypto.ts";
+
+export const acceptancePoolPath = "/api/internal/acceptance-pool";
+/** Its own prefix, so a production-ops envelope never opens here and this one never opens there. */
+export const acceptancePoolPrefix = "sbacc1";
+export const acceptancePoolBodyLimit = 64 * 1024;
+export const acceptancePlanFormat = "basalt-acceptance-pool-plan-v1";
+export const acceptanceReceiptFormat = "basalt-acceptance-pool-receipt-v1";
+export const acceptancePoolRevision = "1";
+export const acceptanceMigration = (kind: AcceptanceKind) => `acceptance-pool-${kind}-v1`;
+
+/**
+ * A holder that stops renewing is gone within this time: every step is bounded well below it, and
+ * the request as a whole below the driver's own wait. Only then may another apply take it over.
+ */
+export const acceptanceLeaseMs = 120_000;
+export const acceptanceStepTimeoutMs = 90_000;
+export const acceptanceRequestTimeoutMs = 280_000;
+/** A receipt names every envelope that acted on it; a bounded list keeps the row bounded. */
+export const acceptanceEnvelopeLimit = 64;
+
+const Sha256 = Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/u));
+
+export const Operation = Schema.Struct({
+  kind: AcceptanceKind,
+  action: Schema.Literals(["dry-run", "apply", "verify"]),
+  request: Schema.Json,
+  recipient: Schema.optionalKey(Schema.NonEmptyString),
+  artifact: Schema.optionalKey(ProtectedArtifact),
+  planSha256: Schema.optionalKey(Schema.String),
+  go: Schema.optionalKey(Schema.String),
+  /** The workflow's own digest of the origin it holds; the request never carries an address. */
+  upstreamOriginSha256: Schema.optionalKey(Sha256),
+  /** Present only on a setup apply; stored as the accounts' encrypted token and never echoed. */
+  upstreamKey: Schema.optionalKey(Schema.String),
+});
+export type Operation = typeof Operation.Type;
+
+export const SignedRequest = Schema.Struct({
+  version: Schema.Literal(1),
+  id: Schema.NonEmptyString,
+  target: Schema.NonEmptyString,
+  at: Schema.Number,
+  expiresAt: Schema.Number,
+  operation: Operation,
+});
+export type SignedRequest = typeof SignedRequest.Type;
+
+const retryable: ReadonlySet<AcceptanceRefusalReason> = new Set(["operation_busy"]);
+export const isRetryable = (reason: AcceptanceRefusalReason) => retryable.has(reason);
diff --git a/apps/hosted/cloud/src/infrastructure/acceptance-pool/guard.ts b/apps/hosted/cloud/src/infrastructure/acceptance-pool/guard.ts
new file mode 100644
index 0000000..5f8440d
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/acceptance-pool/guard.ts
@@ -0,0 +1,40 @@
+import { openEnvelope } from "@executor-js/hosted-server/pool-token";
+import { Option, Schema } from "effect";
+import { sha256 } from "../production-ops/crypto.ts";
+import { acceptancePoolPrefix, SignedRequest } from "./contracts.ts";
+
+/**
+ * The signed request, or undefined for anything else. These are production-ops' own bounds:
+ * the current key only, the browser host as target, at most 5 s early, at most 60 s to live.
+ */
+export async function openSignedRequest(
+  key: string,
+  envelope: string,
+  now: number,
+  target: string,
+): Promise<SignedRequest | undefined> {
+  const raw = await openEnvelope(key, acceptancePoolPrefix, envelope);
+  const signed = Schema.decodeUnknownOption(SignedRequest)(raw);
+  if (Option.isNone(signed)) return undefined;
+  const request = signed.value;
+  if (
+    request.target !== target ||
+    request.at > now + 5000 ||
+    request.expiresAt <= now ||
+    request.expiresAt > request.at + 60_000 ||
+    request.id.length > 128
+  )
+    return undefined;
+  return request;
+}
+
+const label = "[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?";
+const hostName = new RegExp(`^(?=.{1,253}$)${label}(?:\\.${label})+$`, "u");
+
+/** The deploy's value is a bare host name; anything else counts as not configured. */
+export const upstreamOrigin = (host: string | undefined) =>
+  host !== undefined && hostName.test(host) ? `https://${host}` : undefined;
+
+/** The workflow sends this digest of the origin it holds, so a mistyped value on either side refuses. */
+export const upstreamOriginSha256 = (origin: string) =>
+  sha256(`basalt-acceptance-upstream-origin-v1\n${origin}`);
diff --git a/apps/hosted/cloud/src/infrastructure/acceptance-pool/http.ts b/apps/hosted/cloud/src/infrastructure/acceptance-pool/http.ts
new file mode 100644
index 0000000..dd4a912
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/acceptance-pool/http.ts
@@ -0,0 +1,121 @@
+import {
+  AcceptancePoolRefused,
+  type AcceptancePoolSteps,
+} from "@executor-js/hosted-server/acceptance-pool";
+import { ProductAnalytics } from "@executor-js/hosted-server";
+import { GroupDatabase } from "@executor-js/hosted-server/groups";
+import { feedbackDisabled } from "@executor-js/telemetry/product-analytics";
+import { Cause, Clock, Effect, Option, Redacted, Schema, Stream } from "effect";
+import { HttpServerRequest, HttpServerResponse } from "effect/http";
+import { SqlClient } from "effect/sql";
+import { acceptancePoolBodyLimit, acceptanceRequestTimeoutMs, isRetryable } from "./contracts.ts";
+import { openSignedRequest } from "./guard.ts";
+import { runAcceptancePool, type RunnerSettings } from "./runner.ts";
+
+export { acceptancePoolPath } from "./contracts.ts";
+
+const noStore = { "cache-control": "no-store" } as const;
+/** The request's sink, forced off: nothing this route runs records a product event. */
+const noAnalytics = {
+  enabled: false,
+  capture: () => {},
+  submitFeedback: () => Effect.fail(feedbackDisabled()),
+};
+const fixed = (status: number, body: Record<string, string | boolean>) =>
+  HttpServerResponse.json(body, { status, headers: noStore });
+
+/** Read with a byte bound before parsing, including requests without Content-Length. */
+const envelopeBody = Effect.gen(function* () {
+  const request = yield* HttpServerRequest.HttpServerRequest;
+  const chunks: Uint8Array[] = [];
+  let length = 0;
+  yield* request.stream.pipe(
+    Stream.runForEach((chunk) =>
+      Effect.gen(function* () {
+        length += chunk.byteLength;
+        if (length > acceptancePoolBodyLimit) return yield* Effect.fail("too-large" as const);
+        chunks.push(chunk);
+      }),
+    ),
+  );
+  const text = yield* Effect.try(() =>
+    new TextDecoder("utf-8", { fatal: true }).decode(Buffer.concat(chunks)),
+  );
+  return yield* Schema.decodeUnknownEffect(
+    Schema.fromJsonString(Schema.Struct({ envelope: Schema.String })),
+  )(text);
+});
+
+export interface AcceptancePoolRoute<R> {
+  readonly signingKey: Option.Option<Redacted.Redacted<string>>;
+  readonly target: string;
+  /** Resolved per request: the runtime secrets and the database it may act on. */
+  readonly settings: Effect.Effect<RunnerSettings, unknown, SqlClient.SqlClient>;
+  readonly steps: AcceptancePoolSteps<R>;
+}
+
+/**
+ * No session, cookie, API key or MCP identity participates: only an envelope signed with the
+ * current pool signing key reaches the runner. Every answer is one of a few fixed bodies.
+ */
+export const acceptancePoolHandler = <R>(route: AcceptancePoolRoute<R>) =>
+  Effect.gen(function* () {
+    const signingKey = route.signingKey;
+    if (Option.isNone(signingKey)) {
+      yield* Effect.logWarning("acceptance_pool.refused", { reason: "signing_key_missing" });
+      return yield* fixed(503, { error: "acceptance_pool_unavailable" });
+    }
+    const body = yield* envelopeBody.pipe(Effect.option);
+    if (Option.isNone(body))
+      return yield* fixed(400, {
+        error: "acceptance_pool_refused",
+        reason: "request_invalid",
+        retryable: false,
+      });
+    const now = yield* Clock.currentTimeMillis;
+    const signed = yield* Effect.promise(() =>
+      openSignedRequest(
+        Redacted.value(signingKey.value),
+        body.value.envelope,
+        now,
+        route.target,
+      ).catch(() => undefined),
+    );
+    if (signed === undefined) {
+      yield* Effect.logWarning("acceptance_pool.refused", { reason: "unauthenticated" });
+      return yield* fixed(401, {
+        error: "acceptance_pool_refused",
+        reason: "unauthenticated",
+        retryable: false,
+      });
+    }
+    const sql = yield* Effect.flatten(GroupDatabase);
+    const result = yield* Effect.gen(function* () {
+      const settings = yield* route.settings;
+      return yield* runAcceptancePool(settings, signed, route.steps);
+    }).pipe(
+      Effect.provideService(SqlClient.SqlClient, sql),
+      Effect.provideService(ProductAnalytics, noAnalytics),
+      Effect.timeout(acceptanceRequestTimeoutMs),
+    );
+    return yield* HttpServerResponse.json(result, { headers: noStore });
+  }).pipe(
+    // Errors from SQL or a product call can quote stored values. Only a closed word crosses.
+    Effect.catchCause((cause) => {
+      const first = Option.getOrUndefined(Cause.findErrorOption(cause));
+      const refused = first instanceof AcceptancePoolRefused ? first : undefined;
+      const body =
+        refused === undefined
+          ? { error: "acceptance_pool_refused", reason: "failed", retryable: false }
+          : {
+              error: "acceptance_pool_refused",
+              reason: refused.reason,
+              retryable: isRetryable(refused.reason),
+              ...(refused.step === undefined ? {} : { step: refused.step }),
+            };
+      return Effect.logWarning("acceptance_pool.refused", { reason: body.reason }).pipe(
+        Effect.andThen(fixed(409, body)),
+      );
+    }),
+    Effect.withTracerEnabled(false),
+  );
diff --git a/apps/hosted/cloud/src/infrastructure/acceptance-pool/identity.ts b/apps/hosted/cloud/src/infrastructure/acceptance-pool/identity.ts
new file mode 100644
index 0000000..e7b85cb
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/acceptance-pool/identity.ts
@@ -0,0 +1,153 @@
+import {
+  acceptanceIdentity,
+  poolAccessJobPrefix,
+  poolRotationJobPrefix,
+  refuse,
+  type Json,
+} from "@executor-js/hosted-server/acceptance-pool";
+import { Effect } from "effect";
+import { SqlClient } from "effect/sql";
+import { canonical, sha256 } from "../production-ops/crypto.ts";
+
+const { user, organization, member, slug, name, email } = acceptanceIdentity;
+const digest = (value: unknown) =>
+  value === undefined ? "absent" : sha256(`${canonical(value)}\n`);
+
+/** The three rows the identity is, exactly as the operation writes them. */
+const expected = {
+  user: { id: user, name, email, verified: true },
+  organization: { id: organization, name, slug },
+  member: { id: member, organization, user, role: "owner" },
+};
+
+const rows = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  const [person] = yield* sql<Record<string, Json>>`select id, name, email,
+    "emailVerified" as verified from "user" where id = ${user}`;
+  const [team] = yield* sql<Record<string, Json>>`select id, name, slug
+    from organization where id = ${organization}`;
+  const [owner] = yield* sql<Record<string, Json>>`select id, "organizationId" as organization,
+    "userId" as user, role from member where id = ${member}`;
+  return { user: person, organization: team, member: owner };
+});
+
+const count = (query: Effect.Effect<ReadonlyArray<{ readonly count: string | number }>, unknown>) =>
+  Effect.map(query, (result) => Number(result[0]?.count ?? 0));
+
+/**
+ * Everything that would make the identity something other than inert: rows that differ from what
+ * the operation writes, a sign-in or credential row, another member or membership, a slug or
+ * email used by another row, a removal in progress, or a lifecycle job still waiting to run.
+ */
+const conflicts = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  const current = yield* rows;
+  const changed = (["user", "organization", "member"] as const).filter(
+    (key) => current[key] !== undefined && canonical(current[key]) !== canonical(expected[key]),
+  );
+  const found = {
+    changed: changed.length,
+    email: yield* count(sql`select count(*) as count from "user"
+      where lower(email) = lower(${email}) and id <> ${user}`),
+    slug: yield* count(sql`select count(*) as count from organization
+      where slug = ${slug} and id <> ${organization}`),
+    accounts: yield* count(sql`select count(*) as count from account where "userId" = ${user}`),
+    sessions: yield* count(sql`select count(*) as count from session where "userId" = ${user}`),
+    keys: yield* count(sql`select count(*) as count from apikey where "referenceId" = ${user}`),
+    passkeys: yield* count(sql`select count(*) as count from passkey where "userId" = ${user}`),
+    invitations: yield* count(sql`select count(*) as count from invitation
+      where "organizationId" = ${organization}`),
+    members: yield* count(sql`select count(*) as count from member
+      where ("organizationId" = ${organization} or "userId" = ${user}) and id <> ${member}`),
+    removing: yield* count(sql`select count(*) as count from hosted_organization_removal
+      where organization_id = ${organization}`),
+    jobs: yield* count(sql`select count(*) as count from hosted_provisioning
+      where (organization_id = ${organization} or user_id = ${user})
+        and status in ('queued', 'running')
+        and not starts_with(id, ${poolAccessJobPrefix})
+        and not starts_with(id, ${poolRotationJobPrefix})`),
+  };
+  return found;
+});
+
+const inert = (found: Effect.Success<typeof conflicts>) =>
+  Object.values(found).every((value) => value === 0);
+
+/** The identity's preconditions for a plan: one digest per row, "absent" for a missing one. */
+export const inspectIdentity = Effect.gen(function* () {
+  const found = yield* conflicts;
+  if (!inert(found)) return yield* refuse("identity_conflict");
+  const current = yield* rows;
+  return {
+    "identity.user": digest(current.user),
+    "identity.organization": digest(current.organization),
+    "identity.member": digest(current.member),
+  };
+});
+
+/**
+ * Writes only the rows that are absent, in one serializable transaction. The inserts fire the
+ * lifecycle triggers (team, billing, domain, member and user jobs, and the welcome email); every
+ * row they queue is deleted before commit, and the transaction proves none remains. The queue's
+ * dispatcher claims only committed rows, so none of them ever runs.
+ */
+export const ensureIdentity = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  return yield* sql.withTransaction(
+    Effect.gen(function* () {
+      yield* sql`set transaction isolation level serializable`;
+      yield* sql`set local statement_timeout = '5s'`;
+      yield* sql`set local lock_timeout = '500ms'`;
+      yield* sql`set local idle_in_transaction_session_timeout = '10s'`;
+      if (!inert(yield* conflicts)) return yield* refuse("identity_conflict");
+      const before = yield* rows;
+      yield* sql`insert into "user" (id, name, email, "emailVerified", image, "createdAt", "updatedAt")
+        values (${user}, ${name}, ${email}, true, null, now(), now()) on conflict (id) do nothing`;
+      yield* sql`insert into organization (id, name, slug, logo, "createdAt")
+        values (${organization}, ${name}, ${slug}, null, now()) on conflict (id) do nothing`;
+      yield* sql`insert into member (id, "organizationId", "userId", role, "createdAt")
+        values (${member}, ${organization}, ${user}, 'owner', now()) on conflict (id) do nothing`;
+      yield* sql`delete from hosted_provisioning
+        where (organization_id = ${organization} or user_id = ${user})
+          and status = 'queued'
+          and not starts_with(id, ${poolAccessJobPrefix})
+          and not starts_with(id, ${poolRotationJobPrefix})`;
+      yield* sql`delete from cloud_welcome_email where user_id = ${user}`;
+      const after = yield* conflicts;
+      const left = yield* count(sql`select count(*) as count from cloud_welcome_email
+        where user_id = ${user}`);
+      if (!inert(after) || left !== 0) return yield* refuse("identity_conflict");
+      const written = yield* rows;
+      if (
+        (["user", "organization", "member"] as const).some(
+          (key) => canonical(written[key]) !== canonical(expected[key]),
+        )
+      )
+        return yield* refuse("identity_conflict");
+      return {
+        inserted: (["user", "organization", "member"] as const).filter(
+          (key) => before[key] === undefined,
+        ),
+      };
+    }),
+  );
+});
+
+/** Read-only: the identity is exactly what the operation wrote, and still inert. */
+export const verifyIdentity = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  const found = yield* conflicts;
+  const current = yield* rows;
+  const welcome = yield* count(sql`select count(*) as count from cloud_welcome_email
+    where user_id = ${user}`);
+  const seats = yield* count(sql`select count(*) as count from cloud_billing_seats
+    where organization_id = ${organization}`);
+  return {
+    identityRows: (["user", "organization", "member"] as const).every(
+      (key) => canonical(current[key]) === canonical(expected[key]),
+    ),
+    identityInert: inert(found),
+    noWelcomeEmail: welcome === 0,
+    noBillingSeats: seats === 0,
+  };
+});
