@@ -0,0 +1,33 @@
+import { acceptancePoolSteps } from "@executor-js/hosted-server/acceptance-pool-steps";
+import { Config, Effect, Option, Redacted } from "effect";
+import { productionOpsRelease } from "../../implementation/production-ops-release.ts";
+import { cloudDirectDatabaseConnection } from "../database.ts";
+import { databaseOrigin } from "../production-ops/database-identity.ts";
+import { cloudEncryptionKey } from "../secrets.ts";
+import { cloudHosts } from "../stage.ts";
+import { acceptancePoolHandler } from "./http.ts";
+
+/** The deployed route: production-ops' key, hosts, release and database identity. */
+export const cloudAcceptancePool = Effect.gen(function* () {
+  const signingKey = yield* Config.Redacted("POOL_APP_SIGNING_KEY").pipe(Config.option);
+  // Set once by the deploy's input; unset means a setup plan says so and its link refuses.
+  const upstreamHost = yield* Config.String("BASALT_ACCEPTANCE_UPSTREAM_HOST").pipe(Config.option);
+  const encryptionKey = yield* cloudEncryptionKey.pipe(Effect.orDie);
+  const hosts = yield* cloudHosts.pipe(Effect.orDie);
+  const directConnection = yield* cloudDirectDatabaseConnection;
+  return acceptancePoolHandler({
+    signingKey,
+    target: hosts.browser,
+    settings: Effect.gen(function* () {
+      const secret = yield* encryptionKey;
+      return {
+        target: hosts.browser,
+        release: productionOpsRelease,
+        encryptionKey: Redacted.value(secret),
+        databaseOrigin: yield* databaseOrigin(yield* directConnection.connectionString),
+        upstreamHost: Option.getOrUndefined(upstreamHost),
+      };
+    }),
+    steps: acceptancePoolSteps,
+  });
+});
diff --git a/apps/hosted/cloud/src/infrastructure/acceptance-pool/contracts.ts b/apps/hosted/cloud/src/infrastructure/acceptance-pool/contracts.ts
