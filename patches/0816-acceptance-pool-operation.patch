diff --git a/apps/hosted/server/src/contracts/acceptance-pool.ts b/apps/hosted/server/src/contracts/acceptance-pool.ts
new file mode 100644
index 0000000..6fae418
--- /dev/null
+++ b/apps/hosted/server/src/contracts/acceptance-pool.ts
@@ -0,0 +1,121 @@
+import { Data, Schema, type Effect } from "effect";
+import type { SqlClient } from "effect/sql";
+
+/**
+ * The one inert identity that holds the acceptance pool. The signed acceptance-pool operation is
+ * the only writer of its rows; every product path that would act for a person refuses or skips it.
+ */
+export const acceptanceIdentity = {
+  user: "acceptance",
+  organization: "acceptance",
+  slug: "acceptance",
+  member: "acceptance-owner",
+  name: "Acceptance",
+  // RFC 6761 reserves .invalid: no code sent here is ever delivered, and no provider verifies it.
+  email: "acceptance@basalt.invalid",
+} as const;
+
+export const isAcceptanceUser = (user: string | null | undefined) =>
+  user === acceptanceIdentity.user;
+export const isAcceptanceOrganization = (organization: string | null | undefined) =>
+  organization === acceptanceIdentity.organization;
+
+/** Every pool the operation creates is named so; the server refuses any other name. */
+export const acceptancePoolName = /^acceptance-[a-z0-9][a-z0-9-]{0,47}$/u;
+
+export type Json = typeof Schema.Json.Type;
+
+export const AcceptanceKind = Schema.Literals(["setup", "teardown"]);
+export type AcceptanceKind = typeof AcceptanceKind.Type;
+
+/** Every refusal is one of these words, so a caller and a log learn why and nothing else. */
+export const AcceptanceRefusalReason = Schema.Literals([
+  "request_invalid",
+  "name_pattern",
+  "checksum_mismatch",
+  "go_mismatch",
+  "stale_plan",
+  "replayed",
+  "operation_busy",
+  "receipt_mismatch",
+  "receipt_full",
+  "setup_missing",
+  "upstream_unset",
+  "upstream_differs",
+  "upstream_key_invalid",
+  "identity_conflict",
+  "identity_holds_pool",
+  "unrecorded_app",
+  "unrecorded_link",
+  "unrecorded_account",
+  "pool_state",
+  "verification_failed",
+  "step_failed",
+]);
+export type AcceptanceRefusalReason = typeof AcceptanceRefusalReason.Type;
+
+export class AcceptancePoolRefused extends Data.TaggedError("AcceptancePoolRefused")<{
+  readonly reason: AcceptanceRefusalReason;
+  /** For `step_failed`: the plan's own step name, never anything a caller sent. */
+  readonly step?: string;
+}> {}
+export const refuse = (reason: AcceptanceRefusalReason) => new AcceptancePoolRefused({ reason });
+
+export interface Verification {
+  readonly ok: boolean;
+  readonly checks: Readonly<Record<string, boolean>>;
+}
+
+export interface PlannedWrite {
+  readonly store: "tools" | "pool" | "home" | "cloudflare";
+  readonly table: string;
+  readonly key: string;
+  readonly action: "insert" | "update" | "delete" | "call";
+}
+
+export interface Inspection {
+  /** The sha256 of every precondition row, or "absent". Re-read and compared before a first apply. */
+  readonly observed: Readonly<Record<string, string>>;
+  readonly steps: readonly string[];
+  readonly writes: readonly PlannedWrite[];
+  /** Every id the apply will use, fixed here so a resumed apply reuses them. */
+  readonly data: Json;
+}
+
+/** What a setup recorded, which a teardown and its verification act on and nothing else. */
+export interface RecordedSetup {
+  readonly planSha256: string;
+  readonly data: Json;
+  readonly progress: Readonly<Record<string, Json>>;
+}
+
+export interface StepContext {
+  readonly kind: AcceptanceKind;
+  readonly request: Json;
+  readonly data: Json;
+  readonly progress: Readonly<Record<string, Json>>;
+  readonly setup?: RecordedSetup;
+  /** `https://<host>` from the deploy's own value, or undefined when the deploy set none. */
+  readonly upstreamOrigin: string | undefined;
+  readonly upstreamKey?: string;
+}
+
+/**
+ * The tools-service work behind the signed runner. The runner owns envelopes, plans, receipts,
+ * leases and resumption; steps own the product calls. Every step is idempotent on the ids its
+ * plan fixed, so a resumed apply repeats none of them.
+ */
+export interface AcceptancePoolSteps<R = never> {
+  readonly inspect: (
+    kind: AcceptanceKind,
+    request: Json,
+    setup: RecordedSetup | undefined,
+  ) => Effect.Effect<Inspection, unknown, SqlClient.SqlClient | R>;
+  readonly run: (
+    step: string,
+    context: StepContext,
+  ) => Effect.Effect<Json, unknown, SqlClient.SqlClient | R>;
+  readonly verify: (
+    context: StepContext,
+  ) => Effect.Effect<Verification, unknown, SqlClient.SqlClient | R>;
+}
diff --git a/apps/hosted/server/src/implementation/acceptance-pool/steps.ts b/apps/hosted/server/src/implementation/acceptance-pool/steps.ts
new file mode 100644
index 0000000..5701735
--- /dev/null
+++ b/apps/hosted/server/src/implementation/acceptance-pool/steps.ts
@@ -0,0 +1,9 @@
+import { Effect } from "effect";
+import { refuse, type AcceptancePoolSteps } from "../../contracts/acceptance-pool.ts";
+
+// Skeleton: the identity, setup and teardown steps replace this. Until then every plan refuses.
+export const acceptancePoolSteps: AcceptancePoolSteps = {
+  inspect: () => Effect.fail(refuse("pool_state")),
+  run: () => Effect.fail(refuse("pool_state")),
+  verify: () => Effect.fail(refuse("pool_state")),
+};
