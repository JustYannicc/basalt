diff --git a/e2e/support/acceptance-pool-client.ts b/e2e/support/acceptance-pool-client.ts
new file mode 100644
index 0000000..dad021c
--- /dev/null
+++ b/e2e/support/acceptance-pool-client.ts
@@ -0,0 +1,79 @@
+import { expect } from "@effect/vitest";
+import { Effect } from "effect";
+import {
+  constants,
+  createDecipheriv,
+  createHash,
+  createHmac,
+  generateKeyPairSync,
+  privateDecrypt,
+  randomUUID,
+} from "node:crypto";
+import { Api } from "./api.ts";
+import { acceptanceUpstreamFixtureHost, poolFixtureSigningKey } from "./cloud-pool-gateway.ts";
+import { Target } from "./platform.ts";
+import { targetHosts } from "./role-hosts.ts";
+
+export const acceptancePoolPath = "/api/internal/acceptance-pool";
+
+/** Sign real acceptance-pool requests as the workflow does, and open the recipient's plan copy. */
+export const acceptancePoolClient = Effect.gen(function* () {
+  const api = yield* Api,
+    target = yield* Target;
+  const origin = targetHosts(target).browser;
+  const anonymous = yield* api.session();
+  const pair = generateKeyPairSync("rsa", { modulusLength: 3072 });
+  const recipient = pair.publicKey.export({ type: "spki", format: "der" }).toString("base64");
+  // The workflow's own digest of the origin it holds; the request never carries the address.
+  const upstreamOriginSha256 = createHash("sha256")
+    .update(`basalt-acceptance-upstream-origin-v1\nhttps://${acceptanceUpstreamFixtureHost}`)
+    .digest("hex");
+  const sign = (operation: unknown, prefix = "sbacc1") => {
+    const at = Date.now();
+    const payload = Buffer.from(
+      JSON.stringify({
+        version: 1,
+        id: randomUUID(),
+        target: origin,
+        at,
+        expiresAt: at + 60_000,
+        operation,
+      }),
+    ).toString("base64url");
+    const signature = createHmac("sha256", Buffer.from(poolFixtureSigningKey, "hex"))
+      .update(`${prefix}.${payload}`)
+      .digest("base64url");
+    return `${prefix}.${payload}.${signature}`;
+  };
+  const post = (envelope: string) =>
+    api.request(anonymous, "POST", acceptancePoolPath, { envelope });
+  const request = (operation: unknown, prefix?: string) => post(sign(operation, prefix));
+  const open = (artifact: {
+    readonly sha256: string;
+    readonly recipient: {
+      readonly wrappedKey: string;
+      readonly iv: string;
+      readonly ciphertext: string;
+    };
+  }) => {
+    const key = privateDecrypt(
+      { key: pair.privateKey, padding: constants.RSA_PKCS1_OAEP_PADDING, oaepHash: "sha256" },
+      Buffer.from(artifact.recipient.wrappedKey, "base64"),
+    );
+    const encrypted = Buffer.from(artifact.recipient.ciphertext, "base64");
+    const decipher = createDecipheriv(
+      "aes-256-gcm",
+      key,
+      Buffer.from(artifact.recipient.iv, "base64"),
+    );
+    decipher.setAAD(Buffer.from(`basalt-production-ops-v1:${origin}`));
+    decipher.setAuthTag(encrypted.subarray(-16));
+    const plaintext = Buffer.concat([
+      decipher.update(encrypted.subarray(0, -16)),
+      decipher.final(),
+    ]);
+    expect(createHash("sha256").update(plaintext).digest("hex")).toBe(artifact.sha256);
+    return JSON.parse(plaintext.toString("utf8")) as unknown;
+  };
+  return { origin, recipient, upstreamOriginSha256, sign, post, request, open };
+});
