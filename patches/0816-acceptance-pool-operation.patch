new file mode 100644
index 0000000..63dd29b
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/acceptance-pool/plan.ts
@@ -0,0 +1,108 @@
+import {
+  AcceptanceKind,
+  refuse,
+  type Inspection,
+  type Json,
+} from "@executor-js/hosted-server/acceptance-pool";
+import { Effect, Schema } from "effect";
+import {
+  canonical,
+  openArtifact,
+  protectArtifact,
+  sha256,
+  type ProtectedArtifact,
+} from "../production-ops/crypto.ts";
+import { acceptancePlanFormat, type Operation } from "./contracts.ts";
+
+export const Plan = Schema.Struct({
+  format: Schema.Literal(acceptancePlanFormat),
+  kind: AcceptanceKind,
+  target: Schema.String,
+  database: Schema.Struct({ name: Schema.String, targetSha256: Schema.String }),
+  release: Schema.String,
+  preparedAt: Schema.Number,
+  request: Schema.Json,
+  /** For a teardown, the setup receipt it acts on. */
+  setup: Schema.NullOr(Schema.String),
+  observed: Schema.Record(Schema.String, Schema.String),
+  steps: Schema.Array(Schema.String),
+  writes: Schema.Array(
+    Schema.Struct({
+      store: Schema.Literals(["tools", "pool", "home", "cloudflare"]),
+      table: Schema.String,
+      key: Schema.String,
+      action: Schema.Literals(["insert", "update", "delete", "call"]),
+    }),
+  ),
+  data: Schema.Json,
+});
+export type Plan = typeof Plan.Type;
+
+export interface PlanSettings {
+  readonly target: string;
+  readonly release: string;
+  readonly encryptionKey: string;
+}
+
+export const observedSha256 = (observed: Plan["observed"]) => sha256(`${canonical(observed)}\n`);
+
+export const makePlan = (input: {
+  readonly kind: AcceptanceKind;
+  readonly settings: PlanSettings;
+  readonly database: Plan["database"];
+  readonly now: number;
+  readonly request: Json;
+  readonly setup: string | null;
+  readonly inspection: Inspection;
+}): Plan => ({
+  format: acceptancePlanFormat,
+  kind: input.kind,
+  target: input.settings.target,
+  database: input.database,
+  release: input.settings.release,
+  preparedAt: input.now,
+  request: input.request,
+  setup: input.setup,
+  observed: input.inspection.observed,
+  steps: input.inspection.steps,
+  writes: input.inspection.writes,
+  data: input.inspection.data,
+});
+
+export const sealPlan = (plan: Plan, settings: PlanSettings, recipient: string) =>
+  Effect.tryPromise(() =>
+    protectArtifact(plan, settings.encryptionKey, recipient, settings.target),
+  ).pipe(Effect.mapError(() => refuse("request_invalid")));
+
+/**
+ * The reviewed plan an apply names: its checksum, the exact GO for it, and production-ops' own
+ * freshness rules (same target, release and kind, at most an hour old, never from the future).
+ */
+export const openPlan = (operation: Operation, settings: PlanSettings, now: number) =>
+  Effect.gen(function* () {
+    const artifact: ProtectedArtifact | undefined = operation.artifact;
+    if (
+      artifact === undefined ||
+      operation.planSha256 === undefined ||
+      !/^[a-f0-9]{64}$/u.test(operation.planSha256) ||
+      artifact.sha256 !== operation.planSha256
+    )
+      return yield* refuse("checksum_mismatch");
+    if (operation.go !== `GO ${operation.planSha256}`) return yield* refuse("go_mismatch");
+    const raw = yield* Effect.tryPromise(() =>
+      openArtifact(artifact, settings.encryptionKey, settings.target),
+    ).pipe(Effect.mapError(() => refuse("checksum_mismatch")));
+    const plan = yield* Schema.decodeUnknownEffect(Plan)(raw).pipe(
+      Effect.mapError(() => refuse("checksum_mismatch")),
+    );
+    if (
+      plan.kind !== operation.kind ||
+      plan.target !== settings.target ||
+      plan.release !== settings.release ||
+      canonical(plan.request) !== canonical(operation.request) ||
+      now - plan.preparedAt > 3_600_000 ||
+      plan.preparedAt > now
+    )
+      return yield* refuse("stale_plan");
+    return { plan, planSha256: operation.planSha256 };
+  });
