diff --git a/e2e/tests/acceptance-pool-operation.spec.ts b/e2e/tests/acceptance-pool-operation.spec.ts
new file mode 100644
index 0000000..b4523f0
--- /dev/null
+++ b/e2e/tests/acceptance-pool-operation.spec.ts
@@ -0,0 +1,243 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { acceptancePoolClient } from "../support/acceptance-pool-client.ts";
+import { Actors } from "../support/actors.ts";
+import { Api } from "../support/api.ts";
+import { providerAccountBackend } from "../support/provider-account-backend.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Artifact = Schema.Struct({
+  sha256: Schema.String,
+  recipient: Schema.Struct({
+    wrappedKey: Schema.String,
+    iv: Schema.String,
+    ciphertext: Schema.String,
+  }),
+});
+const Planned = Schema.Struct({
+  action: Schema.Literal("dry-run"),
+  planSha256: Schema.String,
+  artifact: Artifact,
+  steps: Schema.Number,
+  upstreamConfigured: Schema.optionalKey(Schema.Literals(["yes", "no"])),
+});
+const Receipt = Schema.Struct({
+  migration: Schema.String,
+  organization: Schema.String,
+  status: Schema.String,
+  app: Schema.NullOr(Schema.String),
+  accounts: Schema.Array(Schema.String),
+});
+const Verification = Schema.Struct({
+  ok: Schema.Boolean,
+  checks: Schema.Record(Schema.String, Schema.Boolean),
+});
+const Applied = Schema.Struct({
+  action: Schema.Literal("apply"),
+  repeated: Schema.Boolean,
+  resumed: Schema.Boolean,
+  receipt: Receipt,
+  verification: Verification,
+});
+const Verified = Schema.Struct({
+  action: Schema.Literal("verify"),
+  completed: Schema.Boolean,
+  receipt: Receipt,
+  verification: Verification,
+});
+const Refused = Schema.Struct({
+  error: Schema.String,
+  reason: Schema.String,
+  step: Schema.optionalKey(Schema.String),
+});
+
+const setupRequest = {
+  pool: "acceptance-e2e-run",
+  accounts: [
+    { profile: "a", method: "anthropic", models: "fixture-model-a" },
+    { profile: "b", method: "openai", models: "fixture-model-b" },
+  ],
+};
+const upstreamKey = "fixture-upstream-key-".padEnd(40, "k");
+
+layer(HostedLive, { excludeTestServices: true })("Acceptance pool operation", (it) => {
+  it.effect(scenarios.acceptancePoolOperation.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const client = yield* acceptancePoolClient;
+        const api = yield* Api,
+          actors = yield* Actors;
+        // The pool service's synthetic custodian: it checks each signed mirror and keeps the
+        // references it holds, as Home keeps the accounts a link mirrors.
+        const custodian = yield* providerAccountBackend;
+        const decode = <S extends Schema.Top>(schema: S, value: unknown) =>
+          Schema.decodeUnknownEffect(schema)(value) as Effect.Effect<S["Type"], unknown>;
+        const refused = (response: { readonly status: number; readonly body: unknown }) =>
+          Effect.map(decode(Refused, response.body), (body) => [response.status, body.reason]);
+        const dry = {
+          kind: "setup",
+          action: "dry-run",
+          request: setupRequest,
+          recipient: client.recipient,
+          upstreamOriginSha256: client.upstreamOriginSha256,
+        };
+
+        // Only its own envelope kind opens the route, and a name outside the pattern is refused.
+        expect((yield* client.request(dry, "sbops1")).status).toBe(401);
+        expect(
+          yield* refused(
+            yield* client.request({ ...dry, request: { ...setupRequest, pool: "people-pool" } }),
+          ),
+        ).toEqual([409, "name_pattern"]);
+
+        // Setup: a dry run the coordinator reads, then an apply bound to its checksum and GO.
+        const planned = yield* client.request(dry);
+        expect(planned.status, JSON.stringify(planned.body)).toBe(200);
+        const plan = yield* decode(Planned, planned.body);
+        // The apply names the artifact exactly as the dry run returned it, both copies included.
+        const artifact = (planned.body as { artifact: unknown }).artifact;
+        expect(plan.upstreamConfigured).toBe("yes");
+        const opened = client.open(plan.artifact) as {
+          steps: string[];
+          request: unknown;
+          data: { accounts: { creation: string }[] };
+        };
+        expect(opened.steps).toEqual([
+          "identity",
+          "create",
+          "provider",
+          "account:a",
+          "link:a",
+          "account:b",
+          "link:b",
+        ]);
+        expect(JSON.stringify(opened)).not.toContain(upstreamKey);
+        const apply = {
+          kind: "setup",
+          action: "apply",
+          request: setupRequest,
+          artifact,
+          planSha256: plan.planSha256,
+          go: `GO ${plan.planSha256}`,
+          upstreamOriginSha256: client.upstreamOriginSha256,
+          upstreamKey,
+        };
+        // The first apply creates the identity, the pool, its provider and the first account, then
+        // stops at the first link: the pool service has nowhere to keep the mirrored account yet.
+        const first = yield* client.request(apply);
+        expect(first.status, JSON.stringify(first.body)).toBe(409);
+        const stopped = yield* decode(Refused, first.body);
+        expect([stopped.reason, stopped.step]).toEqual(["step_failed", "link:a"]);
+        const partial = yield* decode(
+          Verified,
+          (yield* client.request({
+            kind: "setup",
+            action: "verify",
+            request: {},
+            planSha256: plan.planSha256,
+          })).body,
+        );
+        expect(partial.receipt.status).toBe("incomplete");
+        expect(partial.receipt.app).toMatch(/^app_/u);
+        expect(partial.verification.ok).toBe(false);
+        const peered = yield* api.request(
+          actors.owner,
+          "POST",
+          "/native-provider-fixture/product-peer",
+          {
+            pool: partial.receipt.app,
+            origin: custodian.origin,
+          },
+        );
+        expect(peered.status, JSON.stringify(peered.body)).toBe(200);
+
+        // A new envelope for the same plan and GO resumes after the last recorded step.
+        const envelope = client.sign(apply);
+        const applied = yield* client.post(envelope);
+        expect(applied.status, JSON.stringify(applied.body)).toBe(200);
+        const setup = yield* decode(Applied, applied.body);
+        expect(setup.resumed).toBe(true);
+        expect(setup.verification.ok, JSON.stringify(setup.verification)).toBe(true);
+        expect(setup.receipt.migration).toBe("acceptance-pool-setup-v1");
+        expect(setup.receipt.organization).toBe("acceptance");
+        expect(setup.receipt.status).toBe("applied");
+        expect(setup.receipt.app).toBe(partial.receipt.app);
+        expect(setup.receipt.accounts).toEqual(
+          opened.data.accounts.map((account) => `acc_${account.creation.toLowerCase()}`),
+        );
+        expect(JSON.stringify(applied.body)).not.toContain(upstreamKey);
+        const mirrored = yield* custodian.calls;
+        expect(mirrored.map((call) => [call.type, call.token])).toEqual([
+          ["config", upstreamKey],
+          ["config", upstreamKey],
+        ]);
+        expect((yield* custodian.references).size).toBe(2);
+
+        // The same envelope again is refused; a lost reply resumes with a new one and adds nothing.
+        expect(yield* refused(yield* client.post(envelope))).toEqual([409, "replayed"]);
+        const again = yield* decode(Applied, (yield* client.request(apply)).body);
+        expect(again.repeated).toBe(true);
+        expect(again.receipt).toEqual(setup.receipt);
+        expect((yield* custodian.calls).length).toBe(2);
+
+        // Verification reads the tools service's own rows, never a file.
+        const verified = yield* decode(
+          Verified,
+          (yield* client.request({
+            kind: "setup",
+            action: "verify",
+            request: {},
+            planSha256: plan.planSha256,
+          })).body,
+        );
+        expect(verified.verification.ok, JSON.stringify(verified.verification)).toBe(true);
+        expect(verified.receipt).toEqual(setup.receipt);
+
+        // Exactly one pool: another setup is refused while this one lives.
+        expect(
+          yield* refused(
+            yield* client.request({
+              ...dry,
+              request: { ...setupRequest, pool: "acceptance-e2e-two" },
+            }),
+          ),
+        ).toEqual([409, "identity_holds_pool"]);
+
+        // Teardown removes it, and its verification reads every target gone.
+        const teardownDry = yield* client.request({
+          kind: "teardown",
+          action: "dry-run",
+          request: { setup: plan.planSha256 },
+          recipient: client.recipient,
+        });
+        expect(teardownDry.status, JSON.stringify(teardownDry.body)).toBe(200);
+        const teardownPlan = yield* decode(Planned, teardownDry.body);
+        const removed = yield* client.request({
+          kind: "teardown",
+          action: "apply",
+          request: { setup: plan.planSha256 },
+          artifact: (teardownDry.body as { artifact: unknown }).artifact,
+          planSha256: teardownPlan.planSha256,
+          go: `GO ${teardownPlan.planSha256}`,
+        });
+        expect(removed.status, JSON.stringify(removed.body)).toBe(200);
+        const teardown = yield* decode(Applied, removed.body);
+        expect(teardown.verification.ok, JSON.stringify(teardown.verification)).toBe(true);
+        expect(teardown.receipt.migration).toBe("acceptance-pool-teardown-v1");
+        expect((yield* custodian.references).size, "Home lets go of both accounts").toBe(0);
+        const stale = yield* decode(
+          Verified,
+          (yield* client.request({
+            kind: "setup",
+            action: "verify",
+            request: {},
+            planSha256: plan.planSha256,
+          })).body,
+        );
+        expect(stale.verification.ok).toBe(false);
+      }),
+    ),
+  );
+});
