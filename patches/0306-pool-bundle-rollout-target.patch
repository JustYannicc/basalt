diff --git a/apps/hosted/server/src/implementation/pool-worker-gate.ts b/apps/hosted/server/src/implementation/pool-worker-gate.ts
new file mode 100644
index 0000000..37601a5
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-worker-gate.ts
@@ -0,0 +1,55 @@
+import { StorageError } from "@executor-js/sdk/core";
+import { Config, Effect, Option, type Redacted, Schema } from "effect";
+import { FetchHttpClient, HttpClient, HttpClientResponse } from "effect/http";
+import { PoolSetupPending } from "../contracts/organization-defaults.ts";
+import { PoolWorkerReport } from "../contracts/pool-defaults.ts";
+import { poolTokenKeyVersion } from "./pool-account.ts";
+import { poolWorkerRevision } from "./pool-worker-revision.ts";
+
+/** Matches `poolReleasePath` in Basalt's src/pool/release.ts. */
+const releasePath = "/pool/v1/release";
+const Release = Schema.Struct({ revision: Schema.String, keyVersion: Schema.String });
+
+const fetchRelease = (origin: string) =>
+  Effect.gen(function* () {
+    const client = yield* HttpClient.HttpClient;
+    const response = yield* client.get(new URL(releasePath, origin).href);
+    if (response.status !== 200) return yield* new StorageError();
+    return yield* HttpClientResponse.schemaBodyJson(Release)(response);
+  }).pipe(
+    Effect.timeout("10 seconds"),
+    Effect.provide(FetchHttpClient.layer),
+    // Before this release's pool Worker is live it may have no release route at all.
+    Effect.catch(() => new PoolSetupPending({ reason: "worker-unreachable" })),
+  );
+
+/**
+ * Fail until the pool Worker runs the code revision this server was prepared with and signs with
+ * this server's key. A host with no pool Worker origin at all has nothing to wait for.
+ */
+export const awaitPoolWorker = (
+  key: Option.Option<Redacted.Redacted<string>>,
+  fallbackOrigin?: string,
+) =>
+  Effect.gen(function* () {
+    const supplied = yield* PoolWorkerReport;
+    let report;
+    if (supplied !== undefined) report = yield* supplied;
+    else {
+      const origin = yield* Config.String("BASALT_POOL_ORIGIN").pipe(
+        Config.option,
+        Effect.mapError(() => new StorageError()),
+      );
+      const target = Option.getOrUndefined(origin) ?? fallbackOrigin;
+      if (target === undefined) return;
+      report = yield* fetchRelease(target);
+    }
+    const revision = report.revision === poolWorkerRevision;
+    const keyVersion = Option.isNone(key)
+      ? true
+      : report.keyVersion === (yield* poolTokenKeyVersion(key.value));
+    if (revision && keyVersion) return;
+    return yield* new PoolSetupPending({
+      reason: revision ? "key-version" : keyVersion ? "worker-revision" : "worker-revision-and-key",
+    });
+  });
