+import { expect, it } from "@effect/vitest";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { Console, Deferred, Effect, FileSystem, Path, Schema, Stream, Fiber } from "effect";
+import { ChildProcess, ChildProcessSpawner } from "effect/process";
+import { FetchHttpClient, HttpClient, HttpClientRequest } from "effect/http";
+import { Layer } from "effect";
+import { accountMirrorHostSource } from "../support/account-mirror-sdk.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { lockedNpmRegistry } from "../support/npm-registry.ts";
+
+const Ready = Schema.Struct({ port: Schema.Number, owner: Schema.String, app: Schema.String });
+const Id = Schema.Struct({ id: Schema.String });
+const Source = Schema.Struct({ homeReference: Schema.String, generation: Schema.Number });
+const Backend = Schema.Struct({
+  references: Schema.Array(Schema.String),
+  removed: Schema.Array(Schema.String),
+  calls: Schema.Array(
+    Schema.Struct({
+      ref: Schema.String,
+      operation: Schema.String,
+      fields: Schema.Array(Schema.String),
+    }),
+  ),
+});
+
+it.live("mirrored token accounts retain tools and expose only current native pool bindings", () =>
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem,
+      path = yield* Path.Path;
+    const directory = yield* fs.makeTempDirectoryScoped({
+      directory: path.resolve(".local"),
+      prefix: "mirror-sdk-",
+    });
+    const registry = yield* lockedNpmRegistry;
+    const entry = path.join(directory, "account-mirror-host.ts");
+    yield* fs.writeFileString(
+      entry,
+      accountMirrorHostSource.replace("APPS_MANIFEST", JSON.stringify(appsManifest)),
+    );
+
+    const processes = yield* ChildProcessSpawner.ChildProcessSpawner;
+    const config = path.join(directory, "tsconfig.json");
+    yield* fs.writeFileString(
+      config,
+      JSON.stringify({
+        extends: path.resolve("tsconfig.json"),
+        compilerOptions: { typeRoots: [path.resolve("node_modules/@types")] },
+        files: [entry],
+        include: [],
+        exclude: [],
+      }),
+    );
+    const checked = yield* processes.exitCode(
+      ChildProcess.make(path.resolve("node_modules/.bin/tsc-rs"), ["--noEmit", "-p", config], {
+        stdout: "inherit",
+        stderr: "inherit",
+      }),
+    );
+    if (checked !== 0)
+      return yield* Effect.die("Account mirror SDK host failed its public API typecheck");
+    const child = yield* processes.spawn(
+      ChildProcess.make("node", [entry], {
+        env: {
+          ...process.env,
+          MIRROR_FIXTURE_DIRECTORY: directory,
+          MIRROR_FIXTURE_REGISTRY: registry.url,
+        },
+        stdout: "pipe",
+        stderr: "inherit",
+      }),
+    );
+    const listening = yield* Deferred.make<typeof Ready.Type, Error>();
+    yield* child.stdout.pipe(
+      Stream.decodeText(),
+      Stream.splitLines,
+      Stream.runForEach((line) =>
+        line.startsWith('{"port":')
+          ? Schema.decodeUnknownEffect(Schema.fromJsonString(Ready))(line).pipe(
+              Effect.flatMap((value) => Deferred.succeed(listening, value)),
+            )
+          : Console.error(line),
+      ),
+      Effect.ensuring(
+        Deferred.fail(listening, new Error("Mirror HTTP host exited before readiness")),
+      ),
+      Effect.forkChild,
+    );
+    const ready = yield* Deferred.await(listening);
+    const http = yield* HttpClient.HttpClient;
+    const request = (method: "GET" | "POST" | "DELETE", route: string, value?: unknown) =>
+      Effect.gen(function* () {
+        const base = HttpClientRequest.make(method)(`http://127.0.0.1:${ready.port}${route}`);
+        const configured =
+          value === undefined ? base : yield* HttpClientRequest.bodyJson(value)(base);
+        const response = yield* http.execute(configured);
+        const text = yield* response.text;
+        return {
+          status: response.status,
+          body: text.length
+            ? Schema.decodeUnknownSync(Schema.fromJsonString(Schema.Unknown))(text)
+            : null,
+        };
+      });
+    const post = (route: string, value?: unknown) => request("POST", route, value);
+    const get = (route: string) => request("GET", route);
+    const connect = (requirement: string, fields: Record<string, string>, account?: string) =>
+      Effect.gen(function* () {
+        const started = yield* post("/v1/account-connections", {
+          owner: ready.owner,
+          target: { app: ready.app, requirement, scope: "app" },
+          ...(account === undefined ? {} : { account }),
+        });
+        expect(started.status, JSON.stringify(started.body)).toBe(200);
+        const connection = yield* Schema.decodeUnknownEffect(Id)(started.body);
+        const saved = yield* post("/v1/account-connections/submit", {
+          owner: ready.owner,
+          connection: connection.id,
+          method: requirement === "jev" ? "apiKey" : "token",
+          fields,
+        });
+        expect(saved.status, JSON.stringify(saved.body)).toBe(200);
+        return (yield* Schema.decodeUnknownEffect(Id)(saved.body)).id;
+      });
+    const jev = yield* connect("jev", { token: "synthetic-first-key" });
+    const mirror = (account: string, expectedGeneration = 0) =>
+      post("/_fixture/mirror", { account, expectedGeneration, operation: "fixture-link" });
+    const source = (account: string) =>
+      post("/_fixture/source", { account }).pipe(
+        Effect.flatMap((r) => Schema.decodeUnknownEffect(Source)(r.body)),
+      );
+    const backend = get("/_fixture/backend").pipe(
+      Effect.flatMap((r) => Schema.decodeUnknownEffect(Backend)(r.body)),
+    );
+    const inspect = () =>
+      post("/v1/tools/call", {
+        app: ready.app,
+        tool: "inspect",
+        kind: "query",
+        input: {},
+        accounts: { app: { jev: [jev], other: [] } },
+      });
+    expect((yield* inspect()).body).toMatchObject({
+      status: "completed",
+      value: { jev: [{ id: jev, method: "apiKey", fields: ["token"], sealed: true }] },
+    });
+    expect(
+      (yield* post("/_fixture/credentials", {
+        account: jev,
+        fields: { token: "synthetic-first-key" },
+      })).body,
+    ).toEqual({ matches: true });
+    expect((yield* mirror(jev)).status).toBe(200);
+    const first = yield* source(jev);
+    expect((yield* get("/_fixture/membership")).body).toMatchObject({
+      native: true,
+      accounts: [{ account: jev, homeReference: first.homeReference }],
+    });
+    expect((yield* inspect()).body).toMatchObject({
+      status: "completed",
+      value: { jev: [{ fields: ["token"], sealed: true }] },
+    });
+    expect(
+      (yield* post("/_fixture/credentials", {
+        account: jev,
+        fields: { token: "synthetic-first-key" },
+      })).body,
+    ).toEqual({ matches: true });
+    expect((yield* mirror(jev)).status).toBe(200);
+    expect((yield* backend).calls).toHaveLength(1);
+    yield* post("/_fixture/restart");
+    expect((yield* source(jev)).homeReference).toBe(first.homeReference);
+
+    expect(yield* connect("jev", { token: "synthetic-second-key" }, jev)).toBe(jev);
+    expect((yield* post("/_fixture/source", { account: jev })).body).toBeNull();
+    expect((yield* get("/_fixture/membership")).body).toMatchObject({ accounts: [] });
+    expect((yield* mirror(jev, 0)).status).toBe(409);
+    yield* post("/_fixture/fail");
+    expect((yield* mirror(jev, 1)).status).toBe(409);
+    expect((yield* post("/_fixture/source", { account: jev })).body).toBeNull();
+    const pending = (yield* backend).calls.at(-1)!;
+    expect((yield* mirror(jev, 1)).status).toBe(200);
+    const second = yield* source(jev);
+    expect(second.homeReference).toBe(pending.ref);
+    expect(second.homeReference).not.toBe(first.homeReference);
+    expect((yield* backend).references).toEqual([second.homeReference]);
+    expect((yield* inspect()).body).toMatchObject({
+      status: "completed",
+      value: { jev: [{ fields: ["token"], sealed: true }] },
+    });
+    expect(
+      (yield* post("/_fixture/credentials", {
+        account: jev,
+        fields: { token: "synthetic-second-key" },
+      })).body,
+    ).toEqual({ matches: true });
+
+    yield* connect("jev", { token: "synthetic-third-key" }, jev);
+    yield* post("/_fixture/hold");
+    const old = yield* mirror(jev, 2).pipe(Effect.forkChild);
+    yield* get("/_fixture/started");
+    yield* connect("jev", { token: "synthetic-fourth-key" }, jev);
+    yield* post("/_fixture/release");
+    expect((yield* Fiber.join(old)).status).toBe(409);
+    expect((yield* mirror(jev, 3)).status).toBe(200);
+    const fourth = yield* source(jev);
+    expect((yield* backend).references).toEqual([fourth.homeReference]);
+    expect((yield* get("/_fixture/membership")).body).toMatchObject({
+      accounts: [{ account: jev, generation: 3, homeReference: fourth.homeReference }],
+    });
+    const other = yield* connect("other", { access: "synthetic-other-token" });
+    expect((yield* mirror(other)).status).toBe(200);
+    expect((yield* backend).calls.at(-1)?.fields).toEqual(["access"]);
+    yield* post("/_fixture/unlink", { account: jev });
+    expect((yield* source(jev)).homeReference).toBe(fourth.homeReference);
+    expect((yield* backend).references).toContain(fourth.homeReference);
+    const deleted = yield* request(
+      "DELETE",
+      `/v1/accounts/${jev}?owner=${encodeURIComponent(ready.owner)}`,
+    );
+    expect(deleted.status, JSON.stringify(deleted.body)).toBe(200);
+    expect((yield* backend).references).not.toContain(fourth.homeReference);
+    expect((yield* backend).removed).toContain(fourth.homeReference);
+    expect((yield* backend).references).toContain((yield* source(other)).homeReference);
+  }).pipe(Effect.scoped, Effect.provide(Layer.mergeAll(NodeServices.layer, FetchHttpClient.layer))),
+);
