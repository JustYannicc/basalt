+        );
+        expect(after.map((row) => row.account.id)).toEqual([shared]);
+        expect((yield* unlink(shared)).status).toBe(200);
+        expect(yield* backend.references).toContain((yield* backend.calls)[0]!.reference);
+        expect(
+          (yield* api.request(actors.owner, "GET", `${prefix}/accounts/${shared}`)).status,
+        ).toBe(200);
+      }),
+    ),
+  );
+});
