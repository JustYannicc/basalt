+/** The canonical registration supplies the provider template and exact secret field mapping. */
+import type {
+  AccountAcquisitionAccountContext,
+  AccountAcquisitionMirrorContext,
+  JsonObject,
+} from "@executor-js/sdk/core";
+import { Redacted } from "effect";
+import { signEnvelope } from "./pool-token.ts";
+
+export const homeAccountKeyMirror = (options: {
+  readonly origin: string;
+  readonly signingKey: Redacted.Redacted<string>;
+  readonly credential: JsonObject;
+  /** Home field name -> existing account field name. */
+  readonly fields: Readonly<Record<string, string>>;
+}) => {
+  if (
+    "uuid" in options.credential ||
+    "id" in options.credential ||
+    Object.keys(options.fields).some((field) => ["uuid", "id", "type"].includes(field))
+  )
+    throw new Error("Account mirror mapping cannot replace its assigned identity");
+  const send = async (
+    context: AccountAcquisitionAccountContext,
+    action: "upsert" | "remove",
+    credential?: JsonObject,
+  ) => {
+    const at = Date.now();
+    const envelope = await signEnvelope(Redacted.value(options.signingKey), "sbam1", {
+      reference: Redacted.value(context.reference),
+      action,
+      at,
+      expiresAt: at + 30_000,
+      ...(credential === undefined ? {} : { credential }),
+    });
+    const response = await context.fetch(new URL("/pool/v1/account-mirrors", options.origin), {
+      method: "POST",
+      signal: context.signal,
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({ envelope }),
+    });
+    if (!response.ok) throw new Error("Account mirror backend unavailable");
+  };
+  return {
+    mirror: async (context: AccountAcquisitionMirrorContext) => {
+      const saved = Redacted.value(context.fields);
+      const credential = { ...options.credential };
+      for (const [target, source] of Object.entries(options.fields)) {
+        const value = saved[source];
+        if (typeof value !== "string" || value.length === 0)
+          throw new Error("Account mirror fields unavailable");
+        credential[target] = value;
+      }
+      await send(context, "upsert", credential);
+    },
+    remove: (context: AccountAcquisitionAccountContext) => send(context, "remove"),
+  };
+};
