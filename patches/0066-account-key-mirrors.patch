+      return HttpServerResponse.empty({ status: 204 });
+    })),
+    HttpRouter.add("POST", "/_fixture/credentials", Effect.gen(function* () {
+      const value = yield* body(Schema.Struct({ account: AccountId, fields: Schema.Record(Schema.String, Schema.String) }));
+      const saved = yield* executor.managedAccounts.readCredentials({ account: value.account, owner });
+      return yield* HttpServerResponse.json({ matches: JSON.stringify(Redacted.value(saved)) === JSON.stringify(value.fields) });
+    })),
+    HttpRouter.add("POST", "/_fixture/mirror", Effect.gen(function* () {
+      const value = yield* body(Schema.Struct({ account: AccountId, expectedGeneration: Schema.Number, operation: Schema.String }));
+      const result = yield* executor[AccountAcquisitionHost].ensureMirror({ ...value, owner });
+      return yield* HttpServerResponse.json(result);
+    }).pipe(Effect.catchTag("AccountAcquisitionUnavailable", (e) => HttpServerResponse.json({ reason: e.reason }, { status: 409 })))),
+    HttpRouter.add("POST", "/_fixture/source", Effect.gen(function* () {
+      const { account } = yield* body(Account);
+      const result = yield* executor[AccountAcquisitionHost].source({ account, owner });
+      if (result === undefined) return yield* HttpServerResponse.json(null);
+      const current = yield* result.current;
+      return yield* HttpServerResponse.json({ ...current, homeReference: result.hostReference === undefined ? null : Redacted.value(result.hostReference) });
+    }).pipe(Effect.catchTag("AccountAcquisitionUnavailable", () => HttpServerResponse.json(null)))),
+    HttpRouter.add("GET", "/_fixture/membership", nativePoolMembership("mirror-fixture", app.id, executor).pipe(
+      Effect.provideService(SqlClient.SqlClient, sql), Effect.flatMap(HttpServerResponse.json))),
+    HttpRouter.add("GET", "/_fixture/backend", HttpServerResponse.json({}).pipe(Effect.flatMap(() =>
+      HttpServerResponse.json({ calls, removed, references: [...backend.keys()] })))),
+    HttpRouter.add("POST", "/_fixture/fail", Effect.sync(() => { fail = true; }).pipe(Effect.as(HttpServerResponse.empty()))),
+    HttpRouter.add("POST", "/_fixture/hold", Effect.gen(function* () { gate = { started: yield* Deferred.make<void>(), release: yield* Deferred.make<void>() }; return HttpServerResponse.empty(); })),
+    HttpRouter.add("GET", "/_fixture/started", Effect.suspend(() => gate === undefined ? Effect.void : Deferred.await(gate.started)).pipe(Effect.as(HttpServerResponse.empty()))),
+    HttpRouter.add("POST", "/_fixture/release", Effect.gen(function* () { if (gate !== undefined) yield* Deferred.succeed(gate.release, undefined); gate = undefined; return HttpServerResponse.empty(); })),
+    HttpRouter.add("POST", "/_fixture/unlink", Effect.gen(function* () { const { account } = yield* body(Account); yield* sql\`delete from hosted_app_account_links where account = \${account}\`; return HttpServerResponse.empty(); })),
+    HttpRouter.add("POST", "/_fixture/restart", Effect.gen(function* () {
+      executor = yield* createExecutor({ ...options, acquisition: { registrations } }).pipe(Effect.provide(NodeCrypto.layer));
+      return HttpServerResponse.empty();
+    })),
+  );
+  const services = yield* Layer.build(HttpRouter.serve(routes, { disableLogger: true, disableListenLog: true }).pipe(
+    Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 }))));
+  const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+  if (!("port" in server.address)) return yield* Effect.die("Expected TCP server");
+  origin = \`http://127.0.0.1:\${server.address.port}\`;
+  yield* Console.log(JSON.stringify({ port: server.address.port, owner, app: app.id }));
+  return yield* Effect.never;
+})).pipe(Effect.provide(Layer.mergeAll(NodeServices.layer, FetchHttpClient.layer))));
+`;
