diff --git a/packages/sdk/src/implementation/account-acquisition-mirror.ts b/packages/sdk/src/implementation/account-acquisition-mirror.ts
new file mode 100644
--- /dev/null
+++ b/packages/sdk/src/implementation/account-acquisition-mirror.ts
@@ -0,0 +1,205 @@
+import { Clock, Effect, Redacted, type Crypto } from "effect";
+import {
+  AccountAcquisitionUnavailable,
+  type AccountAcquisitionHost,
+  type AccountAcquisitionAccountContext,
+  type AccountAcquisitionRegistration,
+} from "../contracts/account-acquisition-driver.ts";
+import type { Credentials } from "../contracts/storage.ts";
+import { StorageError } from "../contracts/shared.ts";
+import { storedAccount } from "./accounts.ts";
+import { query, transaction, type Query } from "./database.ts";
+import {
+  acquisitionRecord,
+  requireAcquisitionBinding,
+  resolveAcquisitionBinding,
+} from "./account-acquisition-bindings.ts";
+import { invokeAcquisitionDriver } from "./account-acquisition-runtime.ts";
+import type { AcquisitionRegistry } from "./account-acquisition-registry.ts";
+
+type Input = Parameters<AccountAcquisitionHost["ensureMirror"]>[0];
+
+/** Publish only current generations. Pending references survive an uncertain backend response. */
+export const makeAccountMirrors = (
+  db: Query,
+  credentials: Credentials,
+  crypto: Crypto.Crypto,
+  registry: AcquisitionRegistry,
+) => {
+  const resolveForRemoval = resolveAcquisitionBinding(db, credentials, true);
+  const read = (input: Input) =>
+    Effect.gen(function* () {
+      yield* query(() =>
+        db.updateMany("accounts", {
+          where: (b) => b.and(b("id", "=", input.account), b("owner", "=", input.owner)),
+          set: { owner: input.owner },
+        }),
+      );
+      const account = yield* storedAccount(db, input.account, input.owner);
+      if (account.credentialGeneration !== input.expectedGeneration)
+        return yield* new AccountAcquisitionUnavailable({ reason: "changed" });
+      const record = yield* acquisitionRecord(db, input);
+      if (
+        record !== null &&
+        (record.mirrorReference === null ||
+          record.removal !== null ||
+          record.provider !== account.provider ||
+          record.method !== account.method ||
+          record.generation > input.expectedGeneration)
+      )
+        return yield* new AccountAcquisitionUnavailable({ reason: "binding" });
+      const previous = record === null ? undefined : yield* resolveForRemoval(input);
+      const registration =
+        previous?.binding.generation === input.expectedGeneration
+          ? yield* registry.retained(previous.binding)
+          : registry.current(account.provider, account.method);
+      if (registration?.driver.mirror === undefined)
+        return yield* new AccountAcquisitionUnavailable({ reason: "unsupported" });
+      return { account, record, previous, registration };
+    });
+  const remove = (
+    registration: AccountAcquisitionRegistration,
+    saved: Pick<AccountAcquisitionAccountContext, "binding" | "reference">,
+  ) =>
+    Effect.gen(function* () {
+      yield* invokeAcquisitionDriver(
+        registration,
+        {
+          owner: saved.binding.owner,
+          provider: saved.binding.provider,
+          method: saved.binding.method,
+          operation: `mirror-retire:${saved.binding.revision}`,
+          deadline: (yield* Clock.currentTimeMillis) + 15_000,
+        },
+        (context) => registration.driver.remove({ ...context, ...saved }),
+      );
+    });
+
+  return (input: Input) =>
+    Effect.gen(function* () {
+      if (
+        !Number.isSafeInteger(input.expectedGeneration) ||
+        input.expectedGeneration < 0 ||
+        input.operation.trim() === "" ||
+        input.operation.length > 255
+      )
+        return yield* new AccountAcquisitionUnavailable({ reason: "binding" });
+      const observed = yield* transaction(db, () => read(input));
+      if (
+        observed.previous !== undefined &&
+        observed.previous.binding.generation !== input.expectedGeneration
+      ) {
+        const retained = yield* registry.retained(observed.previous.binding);
+        // Retire the old generation before replacing its only stored reference.
+        yield* remove(retained, observed.previous).pipe(
+          Effect.mapError(() => new AccountAcquisitionUnavailable({ reason: "binding" })),
+        );
+      }
+      const claim = yield* transaction(db, () =>
+        Effect.gen(function* () {
+          const current = yield* read(input);
+          if (current.previous?.binding.generation === input.expectedGeneration)
+            return {
+              ...current.previous,
+              ready: current.record?.mirrorReady === true,
+              operation: current.record?.mirrorOperation ?? input.operation,
+              registration: current.registration,
+            };
+          if (current.record?.revision !== observed.record?.revision)
+            return yield* new AccountAcquisitionUnavailable({ reason: "changed" });
+          const reference = yield* crypto.randomUUIDv4.pipe(
+            Effect.mapError(() => new StorageError()),
+          );
+          const binding = {
+            account: current.account.id,
+            owner: current.account.owner,
+            provider: current.account.provider,
+            method: current.account.method,
+            driver: current.registration.driver.id,
+            driverRevision: current.registration.driver.revision,
+            generation: current.account.credentialGeneration,
+            revision: yield* crypto.randomUUIDv4.pipe(Effect.mapError(() => new StorageError())),
+            removal: null,
+          };
+          const mirrorReference = yield* credentials
+            .encrypt(input.account, Redacted.make({ ref: reference }))
+            .pipe(Effect.mapError(() => new StorageError()));
+          const record = {
+            ...binding,
+            mirrorReference,
+            mirrorReady: false,
+            mirrorOperation: input.operation,
+          };
+          if (current.record === null) yield* query(() => db.create("accountAcquisitions", record));
+          else {
+            const previousRevision = current.record.revision;
+            yield* query(() =>
+              db.updateMany("accountAcquisitions", {
+                where: (b) =>
+                  b.and(b("account", "=", input.account), b("revision", "=", previousRevision)),
+                set: record,
+              }),
+            );
+          }
+          return {
+            account: current.account,
+            binding,
+            reference: Redacted.make(reference),
+            ready: false,
+            operation: input.operation,
+            registration: current.registration,
+          };
+        }),
+      );
+      if (claim.ready) return claim.binding;
+      const mirror = claim.registration.driver.mirror;
+      if (mirror === undefined)
+        return yield* new AccountAcquisitionUnavailable({ reason: "unsupported" });
+      const cleanIfStale = Effect.gen(function* () {
+        const current = yield* resolveForRemoval(input).pipe(
+          Effect.catchTags({
+            AccountNotFound: () => Effect.succeed(undefined),
+            AccountAcquisitionUnavailable: () => Effect.succeed(undefined),
+          }),
+        );
+        if (
+          current !== undefined &&
+          current.binding.removal === null &&
+          current.account.credentialGeneration === input.expectedGeneration &&
+          Redacted.value(current.reference) === Redacted.value(claim.reference)
+        )
+          return;
+        yield* remove(claim.registration, claim);
+      }).pipe(Effect.catch(() => Effect.logWarning("Stale account mirror cleanup needs retry")));
+      return yield* Effect.gen(function* () {
+        const fields = yield* credentials
+          .decrypt(input.account, claim.account.encryptedCredentials)
+          .pipe(Effect.mapError(() => new StorageError()));
+        yield* invokeAcquisitionDriver(
+          claim.registration,
+          {
+            owner: input.owner,
+            provider: claim.binding.provider,
+            method: claim.binding.method,
+            operation: claim.operation,
+            deadline: (yield* Clock.currentTimeMillis) + 15_000,
+          },
+          (context) =>
+            mirror({ ...context, binding: claim.binding, reference: claim.reference, fields }),
+        ).pipe(Effect.mapError(() => new AccountAcquisitionUnavailable({ reason: "binding" })));
+        return yield* transaction(db, () =>
+          Effect.gen(function* () {
+            const current = yield* requireAcquisitionBinding(db, claim.binding, false, true);
+            yield* query(() =>
+              db.updateMany("accountAcquisitions", {
+                where: (b) =>
+                  b.and(b("account", "=", input.account), b("revision", "=", current.revision)),
+                set: { mirrorReady: true },
+              }),
+            );
+            return current;
+          }),
+        );
+      }).pipe(Effect.ensuring(cleanIfStale));
+    });
+};
