@@ -0,0 +1,177 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Fiber, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body, type Session } from "../support/api.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { connectionsPath, requirementPath } from "../support/app-accounts.ts";
+import { Resource } from "../support/contracts.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { serverControl } from "../support/server-control.ts";
+import { accountMirrorBackend } from "../support/account-mirror-backend.ts";
+import { accountMirrorProduct } from "../support/account-mirror-product.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Deployed = Schema.Struct({
+  id: Schema.String,
+  requirements: Schema.Struct({
+    accounts: Schema.Record(Schema.String, Schema.Struct({ provider: Schema.String })),
+  }),
+});
+const Revision = Schema.Struct({ revision: Schema.String });
+const Links = Schema.Array(Schema.Struct({ account: Resource }));
+const declaration = `import { defineApp, defineProvider, object, query, router, secrets, string } from "apps";
+const jev = defineProvider({ name: "Jev", hosts: ["api.typesafe.ai"], auth: {
+  apiKey: secrets({ label: "TypeSafe API key", fields: object({ token: string({ minLength: 1 }) }) }) } });`;
+const source = (scope: "app" | "user") =>
+  declaration +
+  `
+export default defineApp({ ${scope}: { accounts: { jev: jev.many() } } }, { tools: router({
+  present: query({ input: object({}) }, async (ctx) => ctx.${scope}.accounts.jev.map(a => ({ id: a.id, method: a.method, fields: Object.keys(a.fields) })))
+}) });`;
+
+layer(RuntimeLive, { excludeTestServices: true })("Native pool account mirrors", (it) => {
+  it.effect(scenarios.nativePoolAccountMirrors.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          backend = yield* accountMirrorBackend;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const apps: string[] = [],
+          accounts: { id: string; actor: Session }[] = [];
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* serverControl("start");
+            for (const app of apps)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app}`);
+            for (const account of accounts)
+              yield* api.request(account.actor, "DELETE", `${prefix}/accounts/${account.id}`);
+          }).pipe(Effect.orDie),
+        );
+        const deploy = (scope: "app" | "user") =>
+          Effect.gen(function* () {
+            const response = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+              name: `Mirror ${scope} fixture`,
+              files: [{ path: "index.ts", content: source(scope) }, appsManifest],
+            });
+            expect(response.status, JSON.stringify(response.body)).toBe(200);
+            const app = yield* body(Deployed, response);
+            apps.push(app.id);
+            const path = `${prefix}/apps/${app.id}`;
+            const access = yield* body(
+              Revision,
+              yield* api.request(actors.owner, "GET", `${path}/access`),
+            );
+            expect(
+              (yield* api.request(actors.owner, "PATCH", `${path}/access`, {
+                revision: access.revision,
+                audience: { kind: "everyone" },
+              })).status,
+            ).toBe(200);
+            return { ...app, path };
+          });
+        const manager = yield* deploy("user"),
+          pool = yield* deploy("app");
+        const connect = (actor: Session, token: string, shared: boolean) =>
+          Effect.gen(function* () {
+            const response = yield* api.request(
+              actor,
+              "POST",
+              connectionsPath(manager.path, "user", "jev"),
+              shared ? { destination: { kind: "shared", audience: { kind: "everyone" } } } : {},
+            );
+            expect(response.status, JSON.stringify(response.body)).toBe(200);
+            const pending = yield* body(Resource, response);
+            const saved = yield* api.request(
+              actor,
+              "POST",
+              `${prefix}/connections/${pending.id}/submit`,
+              { method: "apiKey", fields: { token } },
+            );
+            expect(saved.status, JSON.stringify(saved.body)).toBe(200);
+            const account = yield* body(Resource, saved);
+            accounts.push({ id: account.id, actor });
+            return account.id;
+          });
+        const shared = yield* connect(actors.owner, "synthetic-hosted-shared-key", true);
+        const personal = yield* connect(actors.member, "synthetic-hosted-private-key", false);
+        const heldAccount = yield* connect(actors.owner, "synthetic-hosted-held-key", true);
+        yield* accountMirrorProduct(pool.requirements.accounts.jev!.provider, backend.origin);
+        const link = (actor: Session, id: string) =>
+          api.request(actor, "PUT", `${requirementPath(pool.path, "app", "jev")}/${id}`);
+        const unlink = (id: string) =>
+          api.request(actors.owner, "DELETE", `${requirementPath(pool.path, "app", "jev")}/${id}`);
+        expect((yield* link(actors.owner, shared)).status).toBe(200);
+        expect(yield* backend.calls).toHaveLength(0);
+        expect((yield* unlink(shared)).status).toBe(200);
+        yield* serverControl("stop");
+        // Reconstruct the released 4.0.24 acquisition layout over retained real token accounts.
+        // The next full product start must migrate it without replacing those accounts or fields.
+        yield* legacyStorage([
+          {
+            sql: "alter table executor_account_acquisitions drop column mirror_reference, drop column mirror_ready, drop column mirror_operation",
+          },
+          { sql: "update private_executor_settings set value = '4.0.24' where key = 'version'" },
+          {
+            sql: `update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb), '{basaltPools}', $1::jsonb)::text where id = $2`,
+            params: [
+              JSON.stringify({ fixture: { app: pool.id, membership: "executor-links-v1" } }),
+              actors.organization.id,
+            ],
+          },
+        ]);
+        yield* serverControl("start");
+        expect((yield* link(actors.member, shared)).status).toBe(403);
+        expect((yield* link(actors.owner, personal)).status).toBe(403);
+        expect(yield* backend.calls).toHaveLength(0);
+        expect((yield* link(actors.owner, shared)).status).toBe(200);
+        expect(yield* backend.calls).toMatchObject([
+          { account: shared, fields: { token: "synthetic-hosted-shared-key" } },
+        ]);
+        expect((yield* link(actors.owner, shared)).status).toBe(200);
+        expect(yield* backend.calls).toHaveLength(1);
+        const linked = yield* body(
+          Links,
+          yield* api.request(actors.member, "GET", `${pool.path}/accounts/app`),
+        );
+        expect(linked.map((row) => row.account.id)).toEqual([shared]);
+        const used = yield* api.request(actors.member, "POST", `${pool.path}/tools/call`, {
+          tool: "present",
+          kind: "query",
+          input: {},
+        });
+        expect(used.status, JSON.stringify(used.body)).toBe(200);
+        expect(used.body).toEqual([{ id: shared, method: "apiKey", fields: ["token"] }]);
+
+        const held = yield* backend.hold;
+        const linking = yield* link(actors.admin, heldAccount).pipe(Effect.forkChild);
+        yield* held.started;
+        const access = yield* body(
+          Revision,
+          yield* api.request(actors.owner, "GET", `${prefix}/accounts/${heldAccount}/access`),
+        );
+        expect(
+          (yield* api.request(actors.owner, "PATCH", `${prefix}/accounts/${heldAccount}/access`, {
+            revision: access.revision,
+            audience: { kind: "groups", groups: [] },
+          })).status,
+        ).toBe(200);
