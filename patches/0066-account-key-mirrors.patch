+      path = yield* Path.Path;
+    const entry = path.join(target.directory, "account-mirror-product.ts");
+    yield* fs.writeFileString(
+      entry,
+      `
+import * as Runtime from "@effect/platform-bun/BunRuntime";
+import { main } from "@executor-js/hosted-self-host/server";
+import { AccountAcquisitionConfiguration, ProviderId } from "@executor-js/sdk/core";
+import { accountAcquisitionDriver } from "@executor-js/sdk";
