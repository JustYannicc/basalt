+/** External credential custodian with an observable request hold for authorization races. */
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Deferred, Effect, Layer, Ref, Schema } from "effect";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { createServer } from "node:http";
+
+export const accountMirrorBackend = Effect.gen(function* () {
+  const calls = yield* Ref.make<
+    readonly { account: string; reference: string; fields: Readonly<Record<string, string>> }[]
+  >([]);
+  const references = yield* Ref.make<ReadonlySet<string>>(new Set());
+  let gate: { started: Deferred.Deferred<void>; release: Deferred.Deferred<void> } | undefined;
+  const routes = Layer.mergeAll(
+    HttpRouter.add(
+      "POST",
+      "/mirror",
+      Effect.gen(function* () {
+        const value = yield* HttpServerRequest.schemaBodyJson(
+          Schema.Struct({
+            account: Schema.String,
+            reference: Schema.String,
+            fields: Schema.Record(Schema.String, Schema.String),
+          }),
+        );
+        yield* Ref.update(calls, (items) => [...items, value]);
+        yield* Ref.update(references, (items) => new Set([...items, value.reference]));
+        const held = gate;
+        if (held !== undefined) {
+          yield* Deferred.succeed(held.started, undefined);
+          yield* Deferred.await(held.release);
+        }
+        return HttpServerResponse.empty();
+      }),
+    ),
+    HttpRouter.add(
+      "POST",
+      "/remove",
+      Effect.gen(function* () {
+        const value = yield* HttpServerRequest.schemaBodyJson(
+          Schema.Struct({ reference: Schema.String }),
+        );
+        yield* Ref.update(
+          references,
+          (items) => new Set([...items].filter((id) => id !== value.reference)),
+        );
+        return HttpServerResponse.empty();
+      }),
+    ),
+    HttpRouter.add("POST", "/pool/v1/membership", Effect.succeed(HttpServerResponse.empty())),
+    HttpRouter.add("POST", "/pool/v1/access", Effect.succeed(HttpServerResponse.empty())),
+  );
+  const context = yield* Layer.build(
+    HttpRouter.serve(routes, { disableLogger: true, disableListenLog: true }).pipe(
+      Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 })),
+    ),
+  );
+  const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(context));
+  if (!("port" in server.address)) return yield* Effect.die("Expected TCP fixture");
+  return {
+    origin: `http://127.0.0.1:${server.address.port}`,
+    calls: Ref.get(calls),
+    references: Ref.get(references),
+    hold: Effect.gen(function* () {
+      const held = { started: yield* Deferred.make<void>(), release: yield* Deferred.make<void>() };
+      gate = held;
+      yield* Effect.addFinalizer(() => Deferred.succeed(held.release, undefined));
+      return {
+        started: Deferred.await(held.started),
+        release: Deferred.succeed(held.release, undefined).pipe(
+          Effect.tap(() =>
+            Effect.sync(() => {
+              gate = undefined;
+            }),
+          ),
+        ),
+      };
+    }),
+  };
+});
