+/** Mirroring is a host capability, gated by the destination's retained native-pool opt-in. */
+import {
+  AccountAcquisitionHost,
+  AccountId,
+  OwnerId,
+  StorageError,
+  type AccountAcquisitionBinding,
+  type AppId,
+  type Executor,
+} from "@executor-js/sdk/core";
+import { Effect, Schema } from "effect";
+import { lockedChange } from "./app-accounts.ts";
+
+const Candidate = Schema.Struct({ owner: OwnerId, generation: Schema.Int });
+
+/** The authorization transaction ends before any backend request starts. */
+export const prepareNativePoolAccountMirror = (
+  executor: Executor,
+  input: { readonly app: AppId; readonly requirement: string; readonly account: AccountId },
+) =>
+  Effect.gen(function* () {
+    const candidate = yield* lockedChange(
+      executor,
+      { app: input.app, access: "manage", account: input.account },
+      (sql, actor) =>
+        Effect.gen(function* () {
+          const rows = yield* sql`select a.owner, a.credential_generation as generation
+        from organization o
+        cross join lateral jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) entry
+        join executor_apps app on app.id = entry.value ->> 'app' and app.owner = 'organization:' || o.id
+        join executor_deployments d on d.id = app.active_deployment
+        join executor_accounts a on a.id = ${input.account} and a.owner = app.owner
+        where o.id = ${actor.organization} and app.id = ${input.app}
+          and entry.value ->> 'membership' = 'executor-links-v1'
+          and d.requirements::jsonb -> 'accounts' -> ${input.requirement} ->> 'scope' = 'app'
+          and d.requirements::jsonb -> 'accounts' -> ${input.requirement} ->> 'provider' = a.provider
+          and d.requirements::jsonb -> 'accounts' -> ${input.requirement} -> 'definition' -> 'auth' -> a.method ->> 'type' = 'secrets'`;
+          return (yield* Schema.decodeUnknownEffect(Schema.Array(Candidate))(rows))[0];
+        }),
+    );
+    if (candidate === undefined) return undefined;
+    return yield* executor[AccountAcquisitionHost].ensureMirror({
+      account: input.account,
+      owner: candidate.owner,
+      expectedGeneration: candidate.generation,
+      operation: `native-pool-link:${input.app}:${input.account}:${candidate.generation}`,
+    });
+  }).pipe(
+    Effect.catchTags({
+      SqlError: () => new StorageError(),
+      SchemaError: () => new StorageError(),
+      AccountAcquisitionUnavailable: () => new StorageError(),
+    }),
+  );
+
+/** Run inside the final authorized link transaction; reconnect cannot publish an obsolete mirror. */
+export const verifyNativePoolAccountMirror = (
+  executor: Executor,
+  prepared: AccountAcquisitionBinding | undefined,
+) =>
+  Effect.gen(function* () {
+    if (prepared === undefined) return;
+    const source = yield* executor[AccountAcquisitionHost].source({
+      account: prepared.account,
+      owner: prepared.owner,
+    });
+    if (
+      source === undefined ||
+      source.hostReference === undefined ||
+      source.source.id !== "basalt-home"
+    )
+      return yield* new StorageError();
+    const current = yield* source.current;
+    if (current.revision !== prepared.revision || current.generation !== prepared.generation)
+      return yield* new StorageError();
+  }).pipe(Effect.mapError(() => new StorageError()));
