+/** Public SDK host source runs in a checked subprocess, like the account-acquisition SDK fixture. */
+export const accountMirrorHostSource = `/** Full SDK HTTP host; the backend below accepts only synthetic fixture credentials. */
+import * as NodeCrypto from "@effect/platform-node/NodeCrypto";
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import * as Runtime from "@effect/platform-node/NodeRuntime";
+import { nativeRepositories } from "@executor-js/app-source/node";
+import { createExecutor, makeExecutorStorage, executorHandlers, ExecutorApi, OwnerId,
+  AccountId, AccountAcquisitionHost, type Executor,
+  type ExecutorOptions, type ResourceLifecycle } from "@executor-js/sdk/core";
+import { accountAcquisitionDriver } from "@executor-js/sdk";
+import { filesystemBlobStore, workerdApps } from "@executor-js/sdk/node";
+import { memoryRegistry } from "@executor-js/sdk/testing";
+import { nativePoolMembership } from "@executor-js/hosted-server/pool-membership";
+import { Console, Deferred, Effect, Layer, Path, Redacted, Schema } from "effect";
+import { FetchHttpClient, HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { HttpApiBuilder } from "effect/http-api";
+import { SqlClient } from "effect/sql";
+import { pgliteLayer } from "fumadb-effect/pglite";
+import { createServer } from "node:http";
+const appsManifest = APPS_MANIFEST;
+
+Runtime.runMain(Effect.scoped(Effect.gen(function* () {
+  const path = yield* Path.Path;
+  const directory = process.env.MIRROR_FIXTURE_DIRECTORY!;
+  const database = yield* Layer.build(pgliteLayer());
+  const sql = yield* SqlClient.SqlClient.pipe(Effect.provideContext(database));
+  const storage = yield* makeExecutorStorage({ provider: "postgresql" }).pipe(Effect.provideContext(database));
+  yield* storage.migrate;
+  // Synthetic hosted authority rows feed the production PR6 SQL reader, never a replacement reader.
+  yield* sql\`create table organization (id text primary key, metadata text)\`;
+  yield* sql\`create table member (id text primary key, "organizationId" text, "userId" text, role text)\`;
+  yield* sql\`create table hosted_account_access (account_id text primary key, organization_id text, kind text, personal_user_id text, creator_id text, audience text, revision text)\`;
+  yield* sql\`create table hosted_app_account_links (app text, requirement text, account text, subject text, created_at bigint default 0, primary key (app, requirement, account))\`;
+  yield* sql\`create table hosted_app_access (id text, organization_id text, creator_id text, audience text, revision text)\`;
+  yield* sql\`create table hosted_app_groups (app_id text, group_id text)\`;
+  yield* sql\`create table hosted_account_groups (account_id text, group_id text)\`;
+  yield* sql\`create table hosted_group_members (group_id text, member_id text)\`;
+  yield* sql\`insert into member values ('owner-member', 'mirror-fixture', 'fixture-owner', 'owner'), ('ordinary-member', 'mirror-fixture', 'fixture-member', 'member')\`;
+  const owner = OwnerId.make("organization:mirror-fixture");
+  const hooks: ResourceLifecycle = {
+    userLinks: () => Effect.succeed([]),
+    appLinks: (app) => sql\`select account, requirement from hosted_app_account_links where app = \${app.app}\`.pipe(
+      Effect.map((rows) => rows.map((row) => ({ requirement: String(row.requirement), account: AccountId.make(String(row.account)) }))), Effect.orDie),
+    sourceActorLost: () => Effect.void,
+    appResolving: (_app, accounts, appUses) => Effect.succeed(new Set([...accounts.map((a) => a.id), ...appUses.map((a) => a.account.id)])),
+    removalResolving: (_app, accounts, appUses) => Effect.succeed(new Set([...accounts.map((a) => a.id), ...appUses.map((a) => a.account.id)])),
+    accountsResolving: (accounts) => Effect.succeed(new Set(accounts.map((a) => a.id))),
+    connectionCompleting: () => Effect.void, appCreated: () => Effect.void,
+    appRemoving: () => Effect.void, accountRemoving: () => Effect.void,
+    accountCreated: (a) => sql\`insert into hosted_account_access values (\${a.id}, 'mirror-fixture', 'shared', null, 'fixture-owner', 'everyone', 'account-r1')\`.pipe(Effect.asVoid, Effect.orDie),
+    appAccountConnected: (a) => sql\`insert into hosted_app_account_links (app, requirement, account, subject) values (\${a.app}, \${a.requirement}, \${a.account.id}, null) on conflict do nothing\`.pipe(Effect.asVoid, Effect.orDie),
+  };
+  const secret = Redacted.make("a".repeat(64));
+  const blobs = filesystemBlobStore({ directory: path.join(directory, "blobs") });
+  const ready = yield* Deferred.make<Executor>();
+  const host = yield* workerdApps({ directory: path.join(directory, "workerd"), blobs,
+    executor: Deferred.await(ready), npmRegistry: process.env.MIRROR_FIXTURE_REGISTRY!, encryptionKey: secret });
+  const options: ExecutorOptions = { database: storage, secret, blobs,
+    git: nativeRepositories(path.join(directory, "repositories")), runtime: host.runtime,
+    workflows: host.workflows, registry: memoryRegistry(), hooks };
+  const initial = yield* createExecutor(options).pipe(Effect.provide(NodeCrypto.layer));
+  yield* Deferred.succeed(ready, initial);
+  const source = \`import { defineApp, defineProvider, secrets, object, string, query, router } from "apps";
+const jev = defineProvider({ name: "Jev", hosts: ["api.typesafe.ai"], auth: {
+  apiKey: secrets({ label: "TypeSafe API key", fields: object({ token: string({ minLength: 1 }) }) }) } });
+const other = defineProvider({ name: "Synthetic token provider", hosts: ["tokens.example.test"], auth: {
+  token: secrets({ label: "Token", fields: object({ access: string({ minLength: 1 }) }) }) } });
+export default defineApp({ app: { accounts: { jev: jev.many(), other: other.many() } } }, {
+  tools: router({ inspect: query({ input: object({}) }, async (ctx) => ({
+    jev: ctx.app.accounts.jev.map(a => ({ id: a.id, method: a.method, fields: Object.keys(a.fields), sealed: a.fields.token.startsWith("exsec_") })),
+    other: ctx.app.accounts.other.map(a => ({ id: a.id, method: a.method, fields: Object.keys(a.fields), sealed: a.fields.access.startsWith("exsec_") }))
+  })) }) });\`;
+  const { app } = yield* initial.apps.deploy({ owner, name: "Mirror fixture", files: [{ path: "index.ts", content: source }, appsManifest] });
+  yield* sql\`insert into organization values ('mirror-fixture', \${JSON.stringify({ basaltPools: { fixture: { app: app.id, membership: "executor-links-v1" } } })})\`;
+  yield* sql\`insert into hosted_app_access values (\${app.id}, 'mirror-fixture', 'fixture-owner', 'everyone', 'app-r1')\`;
+  const backend = new Map<string, string>();
+  const calls: { ref: string; operation: string; fields: string[] }[] = [];
+  const removed: string[] = [];
+  let fail = false;
+  let gate: { started: Deferred.Deferred<void>; release: Deferred.Deferred<void> } | undefined;
+  let origin = "";
+  const driver = accountAcquisitionDriver({ id: "basalt-home", revision: "mirror-fixture-r1",
+    start: async () => { throw new Error("Mirror-only registration"); },
+    status: async () => { throw new Error("Mirror-only registration"); }, cancel: async () => {},
+    mirror: async (ctx) => {
+      const response = await ctx.fetch(new URL("/_backend/mirror", origin), { method: "POST", signal: ctx.signal,
+        headers: { "content-type": "application/json" }, body: JSON.stringify({ reference: Redacted.value(ctx.reference), fields: Redacted.value(ctx.fields) }) });
+      if (!response.ok) throw new Error("Synthetic mirror backend failure");
+    },
+    remove: async (ctx) => {
+      const response = await ctx.fetch(new URL("/_backend/remove", origin), { method: "POST", signal: ctx.signal,
+        headers: { "content-type": "application/json" }, body: JSON.stringify({ reference: Redacted.value(ctx.reference) }) });
+      if (!response.ok) throw new Error("Synthetic mirror removal failure");
+    },
+  });
+  const registrations = Object.entries(app.requirements.accounts).map(([name, requirement]) => ({
+    provider: requirement.provider, method: name === "jev" ? "apiKey" : "token", current: true,
+    exposeHostReference: true, driver, fetch: globalThis.fetch }));
+  let executor = yield* createExecutor({ ...options, acquisition: { registrations } }).pipe(Effect.provide(NodeCrypto.layer));
+  const body = <A, I>(schema: Schema.Codec<A, I>) => HttpServerRequest.schemaBodyJson(schema);
+  const Account = Schema.Struct({ account: AccountId });
+  const routes = Layer.mergeAll(
+    HttpApiBuilder.layer(ExecutorApi).pipe(Layer.provide(executorHandlers(executor))),
+    HttpRouter.add("POST", "/_backend/mirror", Effect.gen(function* () {
+      const value = yield* body(Schema.Struct({ reference: Schema.String, fields: Schema.Record(Schema.String, Schema.String) }));
+      calls.push({ ref: value.reference, operation: "fixture-link", fields: Object.keys(value.fields) });
+      backend.set(value.reference, JSON.stringify(value.fields));
+      const held = gate;
+      if (held !== undefined) { yield* Deferred.succeed(held.started, undefined); yield* Deferred.await(held.release); }
+      if (fail) { fail = false; return HttpServerResponse.empty({ status: 503 }); }
+      return HttpServerResponse.empty({ status: 204 });
+    })),
+    HttpRouter.add("POST", "/_backend/remove", Effect.gen(function* () {
+      const { reference } = yield* body(Schema.Struct({ reference: Schema.String }));
