+import * as Cloudflare from "alchemy/Cloudflare";
+import { RuntimeContext } from "alchemy";
+import { Effect, Schema } from "effect";
+import type { DurableObjectNamespace } from "@cloudflare/workers-types";
+import { makeChangeJournal, makeChangeRevisionHandler } from "@executor-js/hosted-server";
+import { GroupDatabase } from "@executor-js/hosted-server/groups";
+import { appDataSupervisors } from "./app-data.ts";
+import { scopedDataChanges } from "../implementation/data-changes.ts";
+
+const NativeNamespace = Schema.declare(
+  (value): value is Pick<DurableObjectNamespace, "getByName"> =>
+    typeof value === "object" &&
+    value !== null &&
+    "getByName" in value &&
+    typeof value.getByName === "function",
+);
+
+/** The current namespace already exists. No additional Worker, object class or database binding. */
+export const cloudChangeRevisions = Effect.gen(function* () {
+  const supervisors = yield* appDataSupervisors;
+  const environment = yield* Cloudflare.WorkerEnvironment;
+  const namespace = Schema.decodeUnknownSync(NativeNamespace)(environment.AppDataSupervisor);
+  return {
+    handler: makeChangeRevisionHandler((scope, keys) => scopedDataChanges(namespace, scope, keys)),
+    deliver: Effect.gen(function* () {
+      const sql = yield* Effect.flatten(GroupDatabase);
+      yield* makeChangeJournal(sql).deliver((scope, hint) =>
+        supervisors
+          .getByName(`hosted-changes:${scope}`)
+          .publishChange(hint)
+          .pipe(Effect.provide(RuntimeContext.phantom)),
+      );
+    }),
+  };
+});
