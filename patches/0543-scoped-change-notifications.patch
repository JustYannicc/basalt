+++ b/apps/hosted/server/src/implementation/change-revision-schema.ts
@@ -0,0 +1,58 @@
+import { Effect } from "effect";
+import { SqlClient } from "effect/sql";
+
+/** Only new tables and functions; the deployed server can keep using its existing layout. */
+export const migrateChangeRevisions = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  yield* sql`create table hosted_change_heads (
+    scope text not null,
+    topic text not null,
+    resource text not null,
+    revision bigint not null check (revision > 0),
+    primary key (scope, topic, resource)
+  )`;
+  yield* sql`create table hosted_change_pending (
+    scope text not null,
+    topic text not null,
+    resource text not null,
+    revision bigint not null check (revision > 0),
+    updated_at timestamptz not null default now(),
+    primary key (scope, topic, resource)
+  )`;
+  yield* sql`create index hosted_change_pending_delivery on hosted_change_pending (updated_at)`;
+  yield* sql`create function hosted_record_change(target_scope text, target_topic text, target_resource text)
+    returns bigint language plpgsql as $$
+    declare committed bigint;
+    begin
+      insert into hosted_change_heads (scope, topic, resource, revision)
+        values (target_scope, target_topic, target_resource, 1)
+        on conflict (scope, topic, resource) do update
+        set revision = hosted_change_heads.revision + 1
+        returning revision into committed;
+      insert into hosted_change_pending (scope, topic, resource, revision)
+        values (target_scope, target_topic, target_resource, committed)
+        on conflict (scope, topic, resource) do update
+        set revision = excluded.revision, updated_at = now();
+      return committed;
+    end $$`;
+  yield* sql`create function hosted_deployment_changed() returns trigger language plpgsql as $$
+    begin
+      if TG_OP = 'DELETE' then
+        perform hosted_record_change(OLD.owner, 'deployment', OLD.id);
+        return OLD;
+      end if;
+      if TG_OP = 'INSERT' then
+        if NEW.active_deployment is not null then
+          perform hosted_record_change(NEW.owner, 'deployment', NEW.id);
+        end if;
+      elsif NEW.active_deployment is distinct from OLD.active_deployment or NEW.owner is distinct from OLD.owner then
+        if NEW.owner is distinct from OLD.owner then
+          perform hosted_record_change(OLD.owner, 'deployment', OLD.id);
+        end if;
+        perform hosted_record_change(NEW.owner, 'deployment', NEW.id);
+      end if;
+      return NEW;
+    end $$`;
+  yield* sql`create trigger hosted_deployment_changed after insert or delete or update of active_deployment, owner
+    on executor_apps for each row execute function hosted_deployment_changed()`;
+});
