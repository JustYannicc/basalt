@@ -0,0 +1,49 @@
+import { Effect, Result, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import { RevisionHint, type ChangeKey } from "apps/ui/contracts";
+
+const Pending = Schema.Struct({ scope: Schema.String, ...RevisionHint.fields });
+export class ChangeDispatchFailed extends Schema.TaggedError<ChangeDispatchFailed>()(
+  "ChangeDispatchFailed",
+  {
+    pending: Schema.Int,
+  },
+) {}
+
+/** Captures the request's uncached SQL client, never a rendered answer or authorization verdict. */
+export const makeChangeJournal = (sql: SqlClient.SqlClient) => ({
+  current: (scope: string, keys: readonly ChangeKey[]) =>
+    Effect.forEach(keys, (key) =>
+      sql`select revision::text as revision from hosted_change_heads
+        where scope = ${scope} and topic = ${key.topic} and resource = ${key.resource}`.pipe(
+        Effect.flatMap(
+          Schema.decodeUnknownEffect(
+            Schema.Array(Schema.Struct({ revision: RevisionHint.fields.revision })),
+          ),
+        ),
+        Effect.map((rows) => ({ ...key, revision: rows[0]?.revision ?? "0" })),
+      ),
+    ),
+  /** Network I/O holds no SQL transaction or row lock. A newer pending revision survives its predecessor's ack. */
+  deliver: <E, R>(send: (scope: string, hint: RevisionHint) => Effect.Effect<void, E, R>) =>
+    Effect.gen(function* () {
+      const rows = yield* sql`select scope, topic, resource, revision::text as revision
+        from hosted_change_pending order by updated_at, scope, topic, resource limit 100`;
+      const pending = yield* Schema.decodeUnknownEffect(Schema.Array(Pending))(rows);
+      const results = yield* Effect.forEach(pending, ({ scope, ...hint }) =>
+        send(scope, hint).pipe(
+          Effect.timeout("5 seconds"),
+          Effect.andThen(sql`delete from hosted_change_pending where scope = ${scope}
+            and topic = ${hint.topic} and resource = ${hint.resource} and revision = ${hint.revision}::bigint`),
+          Effect.tapError(
+            () => sql`update hosted_change_pending set updated_at = clock_timestamp()
+            where scope = ${scope} and topic = ${hint.topic} and resource = ${hint.resource}
+              and revision = ${hint.revision}::bigint`,
+          ),
+          Effect.result,
+        ),
+      );
+      const failed = results.filter(Result.isFailure).length;
+      if (failed > 0) return yield* new ChangeDispatchFailed({ pending: failed });
