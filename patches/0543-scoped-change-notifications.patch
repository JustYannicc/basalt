diff --git a/packages/app-data/src/contracts/change-revisions.ts b/packages/app-data/src/contracts/change-revisions.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fdc4545ed67f5b43d1799bb5eed612a88cb46e2f
--- /dev/null
+++ b/packages/app-data/src/contracts/change-revisions.ts
@@ -0,0 +1,34 @@
+import { Schema } from "effect";
+
+/** Decimal counters stay exact through Postgres, JSON and browser boundaries. */
+export const CommittedRevision = Schema.String.check(
+  Schema.isPattern(/^(0|[1-9][0-9]{0,18})$/u),
+  Schema.makeFilter(
+    (value) => /^(0|[1-9][0-9]{0,18})$/u.test(value) && BigInt(value) <= 9_223_372_036_854_775_807n,
+  ),
+);
+export const ChangeKey = Schema.Struct({
+  topic: Schema.NonEmptyString.check(Schema.isMaxLength(80)),
+  resource: Schema.NonEmptyString.check(Schema.isMaxLength(256)),
+});
+export type ChangeKey = typeof ChangeKey.Type;
+export const RevisionHint = Schema.Struct({ ...ChangeKey.fields, revision: CommittedRevision });
+export type RevisionHint = typeof RevisionHint.Type;
+export const RevisionKeys = Schema.Array(ChangeKey).check(
+  Schema.isMinLength(1),
+  Schema.isMaxLength(32),
+  Schema.makeFilter((keys) => new Set(keys.map(revisionKey)).size === keys.length),
+);
+export const revisionKey = (key: ChangeKey) => JSON.stringify([key.topic, key.resource]);
+export const newerRevision = (left: string, right: string) => BigInt(left) > BigInt(right);
+
+/** A transport ordinal is deliberately absent. Reconnect always reads the committed heads. */
+export const RevisionEvent = Schema.Union([
+  Schema.Struct({ kind: Schema.Literal("changed"), hint: RevisionHint }),
+  Schema.Struct({
+    kind: Schema.Literal("current"),
+    revisions: Schema.Array(RevisionHint).check(Schema.isMaxLength(32)),
+    snapshotRequired: Schema.Literal(true),
+  }),
+]);
+export type RevisionEvent = typeof RevisionEvent.Type;
diff --git a/packages/app-data/src/implementation/change-notifications.ts b/packages/app-data/src/implementation/change-notifications.ts
new file mode 100644
index 0000000000000000000000000000000000000000..89de56a97dce9ddcf6a9863bb0344a8d4bd64023
--- /dev/null
+++ b/packages/app-data/src/implementation/change-notifications.ts
@@ -0,0 +1,93 @@
+import type { DurableObjectState, WebSocket } from "@cloudflare/workers-types";
+import { Effect, Schema, Semaphore } from "effect";
+import {
+  CommittedRevision,
+  RevisionHint,
+  RevisionKeys,
+  newerRevision,
+  revisionKey,
+  type ChangeKey,
+  type RevisionEvent,
+} from "../contracts/change-revisions.ts";
+
+export class ChangeNotificationFailed extends Schema.TaggedError<ChangeNotificationFailed>()(
+  "ChangeNotificationFailed",
+  {},
+) {}
+const Attachment = Schema.Struct({ kind: Schema.Literal("hosted-changes"), keys: RevisionKeys });
+const failed = () => new ChangeNotificationFailed();
+
+/** Uses the existing supervisor's hibernatable sockets; SQL owns the transactional outbox. */
+export const makeChangeNotifications = (state: DurableObjectState) => {
+  const gate = Semaphore.makeUnsafe(1);
+  const storedKey = (key: ChangeKey) => `hosted-change:${revisionKey(key)}`;
+  const current = (keys: readonly ChangeKey[]) =>
+    Effect.forEach(keys, (key) =>
+      Effect.tryPromise({ try: () => state.storage.get(storedKey(key)), catch: failed }).pipe(
+        Effect.flatMap((value) => Schema.decodeUnknownEffect(CommittedRevision)(value ?? "0")),
+        Effect.map((revision) => ({ ...key, revision })),
+      ),
+    );
+  const send = (socket: WebSocket, event: RevisionEvent) => socket.send(JSON.stringify(event));
+  return {
+    initial: (socket: WebSocket, input: unknown) =>
+      gate
+        .withPermits(1)(
+          Effect.gen(function* () {
+            const keys = yield* Schema.decodeUnknownEffect(RevisionKeys)(input);
+            const revisions = yield* current(keys);
+            yield* Effect.try({
+              try: () => {
+                socket.serializeAttachment({ kind: "hosted-changes", keys });
+                send(socket, { kind: "current", revisions, snapshotRequired: true });
+              },
+              catch: failed,
+            });
+          }),
+        )
+        .pipe(Effect.mapError(failed)),
+    publish: (input: unknown) =>
+      gate
+        .withPermits(1)(
+          Effect.gen(function* () {
+            const hint = yield* Schema.decodeUnknownEffect(RevisionHint)(input);
+            const revision = yield* Effect.tryPromise({
+              try: () =>
+                state.storage.transaction(async (tx) => {
+                  const key = storedKey(hint);
+                  const known = Schema.decodeUnknownSync(CommittedRevision)(
+                    (await tx.get(key)) ?? "0",
+                  );
+                  const next = newerRevision(hint.revision, known) ? hint.revision : known;
+                  await tx.put(key, next);
+                  return next;
+                }),
+              catch: failed,
+            });
+            // Retrying after persistence must still fan out when the first attempt died before sending.
+            yield* Effect.sync(() => {
+              for (const socket of state.getWebSockets()) {
+                try {
+                  const attachment = Schema.decodeUnknownOption(Attachment)(
+                    socket.deserializeAttachment(),
+                  );
+                  if (
+                    attachment._tag === "None" ||
+                    !attachment.value.keys.some((key) => revisionKey(key) === revisionKey(hint))
+                  )
+                    continue;
+                  send(socket, { kind: "changed", hint: { ...hint, revision } });
+                } catch {
+                  try {
+                    socket.close(1011, "Reconnect");
+                  } catch {
+                    /* The client has already gone. */
+                  }
+                }
+              }
+            });
+          }),
+        )
+        .pipe(Effect.mapError(failed)),
+  };
+};
