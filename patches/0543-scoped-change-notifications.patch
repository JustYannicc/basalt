+++ b/apps/hosted/server/src/implementation/change-revision-http.ts
@@ -0,0 +1,107 @@
+import { permitsAction, permitsApp } from "@executor-js/authorization";
+import { type ChangeKey, type RevisionEvent } from "apps/ui/contracts";
+import { AppId, type RuntimeProtocolFailed } from "@executor-js/sdk/core";
+import { Effect, Schema, Stream } from "effect";
+import { HttpRouter, HttpServerRequest, HttpServerResponse } from "effect/http";
+import {
+  ApiAuthentication,
+  Authentication,
+  CurrentUserId,
+  Unauthorized,
+} from "../contracts/auth.ts";
+import { GroupDatabase } from "../contracts/groups.ts";
+import {
+  CurrentOrganization,
+  OrganizationForbidden,
+  OrganizationId,
+  organizationOwner,
+} from "../contracts/organization.ts";
+import { requireAppAccess } from "./resource-policy.ts";
+import { authorizedChangeEvents } from "./authorized-change-stream.ts";
+import { makeChangeJournal } from "./change-revisions.ts";
+
+export const changeRevisionsPath = "/api/organizations/:organization/apps/:app/changes";
+const Params = Schema.Struct({ organization: OrganizationId, app: AppId });
+const headers = { "cache-control": "private, no-store", "x-accel-buffering": "no" };
+
+/** Hosted sessions and API grants are checked again for each private event, never on a timer. */
+export const authorizeAppChanges = (headers: Headers, organization: OrganizationId, app: AppId) =>
+  Effect.gen(function* () {
+    const identity = yield* Authentication;
+    const principal = yield* Effect.gen(function* () {
+      if (headers.has("authorization")) {
+        const grant = yield* (yield* ApiAuthentication).authenticate(headers, organization);
+        if (!permitsAction(grant.policy, "data") || !permitsApp(grant.policy, app))
+          return yield* new OrganizationForbidden();
+        return { user: grant.userId, access: grant.access };
+      }
+      const principal = yield* identity.current(headers);
+      if (principal === null) return yield* new Unauthorized();
+      const membership = yield* identity.membership(principal, organization);
+      return {
+        user: principal.userId,
+        access: { organization, owner: organizationOwner(organization), role: membership.role },
+      };
+    });
+    if (principal.access.organization !== organization) return yield* new OrganizationForbidden();
+    yield* requireAppAccess(app, "read").pipe(
+      Effect.provideService(CurrentOrganization, principal.access),
+      Effect.provideService(CurrentUserId, principal.user),
+    );
+  });
+
+/** This is opt-in foundation transport. Existing app-version and query streams keep their timers. */
+export const makeChangeRevisionHandler = <R>(
+  subscribe: (
+    scope: string,
+    keys: readonly ChangeKey[],
+  ) => Stream.Stream<RevisionEvent, RuntimeProtocolFailed, R>,
+) =>
+  Effect.gen(function* () {
+    const { organization, app } = yield* Schema.decodeUnknownEffect(Params)(
+      yield* HttpRouter.params,
+    );
+    const request = yield* HttpServerRequest.HttpServerRequest;
+    const url = new URL(request.url, "https://api.internal");
+    // Each added topic needs its own writer coverage and authority rule before it is available here.
+    if (url.searchParams.has("topics") && url.searchParams.get("topics") !== "deployment")
+      return HttpServerResponse.empty({ status: 400, headers });
+    const keys = [{ topic: "deployment", resource: app }];
+    const scope = organizationOwner(organization);
+    const authorize = authorizeAppChanges(new Headers(request.headers), organization, app);
+    yield* authorize;
+    const sql = yield* Effect.flatten(GroupDatabase);
+    const events = authorizedChangeEvents({
+      keys,
+      events: subscribe(scope, keys),
+      current: makeChangeJournal(sql).current(scope, keys),
+      authorize,
+    });
+    const services = yield* Effect.context<Stream.Services<typeof events>>();
+    const stream = events.pipe(
+      Stream.map((event) => `event: ${event.kind}\ndata: ${JSON.stringify(event)}\n\n`),
+      Stream.catchTags({
+        Unauthorized: () => Stream.make("event: revoked\ndata: {}\n\n"),
+        OrganizationForbidden: () => Stream.make("event: revoked\ndata: {}\n\n"),
+      }),
+      Stream.catch(() => Stream.make("event: resync\ndata: {}\n\n")),
+      Stream.merge(
+        Stream.tick("15 seconds").pipe(
+          Stream.drop(1),
+          Stream.map(() => ": heartbeat\n\n"),
+        ),
+        { haltStrategy: "left" },
+      ),
+      Stream.encodeText,
+      Stream.provideContext(services),
+    );
+    return HttpServerResponse.stream(stream, { contentType: "text/event-stream", headers });
+  }).pipe(
+    Effect.catchTags({
+      Unauthorized: () => Effect.succeed(HttpServerResponse.empty({ status: 401, headers })),
+      OrganizationForbidden: () =>
+        Effect.succeed(HttpServerResponse.empty({ status: 403, headers })),
+      SchemaError: () => Effect.succeed(HttpServerResponse.empty({ status: 400, headers })),
+    }),
+    Effect.catch(() => Effect.succeed(HttpServerResponse.empty({ status: 503, headers }))),
+  );
