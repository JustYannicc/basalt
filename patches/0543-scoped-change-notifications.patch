diff --git a/apps/hosted/server/src/implementation/authorized-change-stream.ts b/apps/hosted/server/src/implementation/authorized-change-stream.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d2b04edc9248854372e4fd656fec047eec9432ca
--- /dev/null
+++ b/apps/hosted/server/src/implementation/authorized-change-stream.ts
@@ -0,0 +1,46 @@
+import { Effect, Stream } from "effect";
+import { RuntimeProtocolFailed } from "@executor-js/sdk/core";
+import {
+  newerRevision,
+  revisionKey,
+  type ChangeKey,
+  type RevisionEvent,
+  type RevisionHint,
+} from "apps/ui/contracts";
+
+/** The owner's first message proves registration; only then read the authoritative SQL heads. */
+export const authorizedChangeEvents = <E, R, E2, R2, E3, R3>(input: {
+  readonly keys: readonly ChangeKey[];
+  readonly events: Stream.Stream<RevisionEvent, E, R>;
+  readonly current: Effect.Effect<readonly RevisionHint[], E2, R2>;
+  readonly authorize: Effect.Effect<void, E3, R3>;
+}) =>
+  Stream.unwrap(
+    Effect.sync(() => {
+      const seen = new Map<string, string>();
+      const allowed = new Set(input.keys.map(revisionKey));
+      let initialized = false;
+      return input.events.pipe(
+        Stream.mapEffect((event) =>
+          Effect.gen(function* () {
+            if (!initialized) {
+              if (event.kind !== "current") return yield* new RuntimeProtocolFailed();
+              const revisions = yield* input.current;
+              yield* input.authorize;
+              initialized = true;
+              for (const hint of revisions) seen.set(revisionKey(hint), hint.revision);
+              return { kind: "current", revisions, snapshotRequired: true } satisfies RevisionEvent;
+            }
+            if (event.kind !== "changed") return undefined;
+            const key = revisionKey(event.hint);
+            if (!allowed.has(key) || !newerRevision(event.hint.revision, seen.get(key) ?? "0"))
+              return undefined;
+            yield* input.authorize;
+            seen.set(key, event.hint.revision);
+            return event;
+          }),
+        ),
+        Stream.filter((event) => event !== undefined),
+      );
+    }),
+  );
