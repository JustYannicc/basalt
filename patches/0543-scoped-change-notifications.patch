diff --git a/packages/apps/src/implementation/revision-fence.ts b/packages/apps/src/implementation/revision-fence.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ce6f0b5378e7f4dbaef159b144ada5d81a845718
--- /dev/null
+++ b/packages/apps/src/implementation/revision-fence.ts
@@ -0,0 +1,52 @@
+import {
+  newerRevision,
+  revisionKey,
+  type ChangeKey,
+  type RevisionHint,
+} from "@executor-js/app-data";
+
+/** Scope must include the server, organization, viewer/session generation and app. Holds no cached data. */
+export const makeRevisionFence = (scope: string, keys: readonly ChangeKey[]) => {
+  const required = new Map(keys.map((key) => [revisionKey(key), "0"]));
+  let generation = 0;
+  let synchronized = false;
+  type Connection = { readonly scope: string; readonly generation: number };
+  const matches = (connection: Connection) =>
+    connection.scope === scope && connection.generation === generation;
+  const covers = (revisions: readonly RevisionHint[]) => {
+    const supplied = new Map(revisions.map((hint) => [revisionKey(hint), hint.revision]));
+    return [...required].every(([key, minimum]) => {
+      const revision = supplied.get(key);
+      return revision !== undefined && !newerRevision(minimum, revision);
+    });
+  };
+  const observe = (hint: RevisionHint) => {
+    const key = revisionKey(hint);
+    const known = required.get(key);
+    if (known !== undefined && newerRevision(hint.revision, known))
+      required.set(key, hint.revision);
+  };
+  return {
+    begin: (): Connection => {
+      synchronized = false;
+      return { scope, generation: ++generation };
+    },
+    disconnect: () => {
+      synchronized = false;
+      generation++;
+    },
+    handshake: (connection: Connection, revisions: readonly RevisionHint[]) => {
+      if (!matches(connection) || !covers(revisions)) return false;
+      revisions.forEach(observe);
+      synchronized = true;
+      return true;
+    },
+    observe,
+    acknowledge: observe,
+    accept: (connection: Connection, revisions: readonly RevisionHint[]) => {
+      if (!synchronized || !matches(connection) || !covers(revisions)) return false;
+      revisions.forEach(observe);
+      return true;
+    },
+  };
+};
