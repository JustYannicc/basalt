diff --git a/packages/ui/src/contracts/account-title.ts b/packages/ui/src/contracts/account-title.ts
new file mode 100644
index 0000000..692626d
--- /dev/null
+++ b/packages/ui/src/contracts/account-title.ts
@@ -0,0 +1,31 @@
+import type { AccountSummary } from "./dashboard.ts";
+
+/** The label the SDK gives an account saved without a name: "Default", then "Default 2", … */
+const generated = /^Default( \d+)?$/;
+
+/** A label the person gave the account; a generated or blank one is not a name. */
+export const authoredLabel = (label: string) => {
+  const trimmed = label.trim();
+  return trimmed === "" || generated.test(trimmed) ? undefined : label;
+};
+
+/**
+ * What names an account's row on every account list: its verified identity, else the name the
+ * person gave it, else what its own check reported (an email first), else its generated label
+ * ("Default 2" stays distinct), else `fallback`. A reported value never earns the verified mark and
+ * never groups rows; only `account.identity` does.
+ */
+export const accountTitle = (
+  account: Pick<AccountSummary, "label"> & {
+    readonly identity?: AccountSummary["identity"] | undefined;
+    readonly health?: AccountSummary["health"] | undefined;
+  },
+  fallback = "Unnamed account",
+) =>
+  account.identity?.label ??
+  authoredLabel(account.label) ??
+  (account.health?.info?.email ||
+    account.health?.info?.displayName ||
+    account.health?.info?.username ||
+    account.label.trim() ||
+    fallback);
