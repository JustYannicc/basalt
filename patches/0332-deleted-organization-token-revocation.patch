new file mode 100644
index 0000000..b6065cc
--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-organization.ts
@@ -0,0 +1,39 @@
+import { AppId } from "@executor-js/sdk/core";
+import { Clock, Config, Effect, Option, Redacted, Schema } from "effect";
+import { HttpServerRequest, HttpServerResponse } from "effect/http";
+import { OrganizationId } from "../contracts/organization.ts";
+import { OrganizationTombstones } from "../contracts/organization-removal.ts";
+import { policyDatabase } from "./resource-policy.ts";
+import { openEnvelope } from "./pool-token.ts";
+
+export const poolOrganizationReadPath = "/api/internal/pool-organization";
+const Read = Schema.Struct({
+  pool: AppId,
+  organization: OrganizationId,
+  at: Schema.Finite,
+  expiresAt: Schema.Finite,
+});
+
+/** No positive cache: an unexpired pool credential cannot outlive organization removal. */
+export const readPoolOrganization = Effect.gen(function* () {
+  const key = yield* Config.Redacted("POOL_APP_SIGNING_KEY").pipe(Config.option);
+  if (Option.isNone(key)) return HttpServerResponse.empty({ status: 503 });
+  const body = yield* HttpServerRequest.schemaBodyJson(
+    Schema.Struct({ envelope: Schema.NonEmptyString }),
+  );
+  const raw = yield* Effect.tryPromise(() =>
+    openEnvelope(Redacted.value(key.value), "sbq1", body.envelope),
+  );
+  const value = yield* Schema.decodeUnknownEffect(Read)(raw);
+  const now = yield* Clock.currentTimeMillis;
+  if (value.at > now || value.expiresAt <= now || value.expiresAt > now + 30_000)
+    return HttpServerResponse.empty({ status: 401 });
+  const removed = yield* OrganizationTombstones;
+  if (yield* removed(value.organization)) return HttpServerResponse.empty({ status: 403 });
+  const sql = yield* policyDatabase;
+  const rows = yield* sql`select id from organization where id = ${value.organization}`;
+  return HttpServerResponse.empty({
+    status: rows.length === 1 ? 204 : 403,
+    headers: { "cache-control": "no-store" },
+  });
+}).pipe(Effect.catch(() => Effect.succeed(HttpServerResponse.empty({ status: 503 }))));
