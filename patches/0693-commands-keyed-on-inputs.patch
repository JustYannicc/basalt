diff --git a/apps/hosted/cloud/src/infrastructure/migration-inputs.ts b/apps/hosted/cloud/src/infrastructure/migration-inputs.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/migration-inputs.ts
@@ -0,0 +1,25 @@
+/**
+ * What `src/migrate.ts` reads, as the key for when the migration runs. Its imports reach the
+ * hosted apps and most workspace packages, so the key is their sources and the lockfile.
+ * Resources wait on the migration's outcome, and a plan cannot know the outcome of a command that
+ * runs on every plan, so it runs when these change and carries no attempt identity.
+ */
+export const migrationInputs = {
+  include: [
+    "src/**",
+    "../server/src/**",
+    "../../marketing/src/**",
+    "../../../packages/*/src/**",
+    // Generated apps declare the framework release this manifest names.
+    "../../../packages/apps/package.json",
+  ],
+  // Preparation rewrites these for every revision or pool app change; the migration imports none.
+  // One of them inside the key would run the migration on every release.
+  exclude: [
+    "src/implementation/production-ops-release.ts",
+    "../server/src/implementation/catalog-app-release.ts",
+    "../server/src/implementation/pool-worker-revision.ts",
+    "../server/src/implementation/pool-app-source.ts",
+  ],
+  lockfile: true,
+};
diff --git a/apps/hosted/cloud/src/infrastructure/site-inputs.ts b/apps/hosted/cloud/src/infrastructure/site-inputs.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/site-inputs.ts
@@ -0,0 +1,15 @@
+/**
+ * The site build reads the whole tree, so its key stays every file the tree does not ignore, plus
+ * the lockfile. Three files are rewritten for every release and no page or site script imports
+ * them. With them in the key the site, and every Worker that serves it, changed on every release.
+ * Patterns are relative to the tree's root, the build's working directory.
+ */
+export const siteInputs = {
+  include: [
+    "**/*",
+    "!apps/hosted/cloud/src/implementation/production-ops-release.ts",
+    "!apps/hosted/server/src/implementation/catalog-app-release.ts",
+    "!apps/hosted/server/src/implementation/pool-worker-revision.ts",
+  ],
+  lockfile: true,
+};
