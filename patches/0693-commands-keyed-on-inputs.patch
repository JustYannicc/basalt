+/**
+ * Whether a database and branch are the stage's own. A disposable test stage owns one database,
+ * named after it, and the two branches named after it; every other stage owns only `main`. The
+ * script decides this itself, before any request: it runs as a child process, where nothing
+ * outside it can see or refuse what it sends, and test stages share the organization and its
+ * credentials with production.
+ */
+export function ownPoolBudgetTarget(stage: string, database: string, branch: string): boolean {
+  if (!stage.startsWith("test-")) return branch === "main";
+  const slug = /^test-(pr-[1-9][0-9]*|rehearsal-[1-9][0-9]{0,9})$/.exec(stage)?.[1];
+  return (
+    slug !== undefined &&
+    database === `basalt-preview-${slug}` &&
+    (branch === stage || branch === `${stage}-pool`)
+  );
+}
+
 export const configureDatabasePoolBudget = Effect.gen(function* () {
   const organization = yield* Config.NonEmptyString("PLANETSCALE_ORGANIZATION");
+  const stage = yield* Config.NonEmptyString("POOL_BUDGET_STAGE");
   const database = yield* Config.NonEmptyString("POOL_BUDGET_DATABASE");
   const branch = yield* Config.NonEmptyString("POOL_BUDGET_BRANCH");
   const id = yield* Config.Redacted("PLANETSCALE_API_TOKEN_ID");
   const token = yield* Config.Redacted("PLANETSCALE_API_TOKEN");
-  if (branch !== "main" && !/^test-[a-z0-9-]+$/.test(branch))
+  if (!ownPoolBudgetTarget(stage, database, branch))
     return yield* new PoolBudgetFailed({
-      message: "The database budget requires main or an isolated test branch",
+      message: "The database budget refuses a database or branch that is not its stage's own",
     });
   const client = yield* HttpClient.HttpClient;
   const base = `https://api.planetscale.com/v1/organizations/${encodeURIComponent(organization)}/databases/${encodeURIComponent(database)}/branches/${encodeURIComponent(branch)}`;
