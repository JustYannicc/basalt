diff --git a/apps/hosted/web/src/implementation/pages/claude-desktop-setup.tsx b/apps/hosted/web/src/implementation/pages/claude-desktop-setup.tsx
new file mode 100644
index 0000000..a439227
--- /dev/null
+++ b/apps/hosted/web/src/implementation/pages/claude-desktop-setup.tsx
@@ -0,0 +1,136 @@
+import { useState } from "react";
+import { Button } from "@executor-js/ui/components/button";
+import { AssistantGuideSteps, EndpointField } from "@executor-js/ui/dashboard/connect";
+import { PoolSelect } from "./computer-quick-setup.tsx";
+import { computerName, type PoolKey, type PoolSetup } from "./pool-setup.tsx";
+
+/*
+ * Claude Desktop runs on a pool through its third-party inference mode. That mode has no claude.ai
+ * account, so its connectors come from the same configuration: the deployment's MCP server with
+ * OAuth sign-in, never a stored token. Anthropic documents Import configuration only for files
+ * holding bootstrap keys, so the steps lead and the file is offered as untested.
+ */
+
+/** The fields the in-app configuration window writes, as its exported JSON config names them. */
+const desktopConfig = (issued: PoolKey, server: string, mcpUrl: string) => ({
+  inferenceProvider: "gateway",
+  inferenceGatewayBaseUrl: issued.baseUrl,
+  inferenceGatewayApiKey: issued.key,
+  inferenceGatewayAuthScheme: "bearer",
+  managedMcpServers: [{ name: server, transport: "http", url: mcpUrl, oauth: true }],
+});
+
+function download(name: string, value: unknown) {
+  const url = URL.createObjectURL(
+    new Blob([`${JSON.stringify(value, null, 2)}\n`], { type: "application/json" }),
+  );
+  const link = Object.assign(document.createElement("a"), { href: url, download: name });
+  // Some browsers drop a download from a detached link or an already revoked URL.
+  document.body.append(link);
+  link.click();
+  link.remove();
+  window.setTimeout(() => URL.revokeObjectURL(url), 60_000);
+}
+
+const Ui = ({ children }: { readonly children: string }) => (
+  <span className="font-medium text-foreground">{children}</span>
+);
+
+export function ClaudeDesktopSetup({
+  setup,
+  server,
+  mcpUrl,
+}: {
+  readonly setup: PoolSetup;
+  /** The deployment's MCP server name, as the other guides use it. */
+  readonly server: string;
+  readonly mcpUrl: string;
+}) {
+  const [issued, setIssued] = useState<PoolKey>();
+  const [busy, setBusy] = useState(false);
+  const [problem, setProblem] = useState<string>();
+  const create = async () => {
+    setBusy(true);
+    setProblem(undefined);
+    try {
+      setIssued(await setup.issueKey(`${computerName()} · Claude Desktop`));
+    } catch (error) {
+      setProblem(setup.failure(error));
+    }
+    setBusy(false);
+  };
+  return (
+    <>
+      <div className="flex flex-wrap items-center gap-2">
+        <span className="min-w-0 flex-1 text-[13px] text-muted-foreground">Models from</span>
+        <PoolSelect setup={setup} />
+        <Button size="sm" loading={busy} disabled={busy} onClick={() => void create()}>
+          {issued ? "Create another key" : "Create key"}
+        </Button>
+      </div>
+      {problem ? (
+        <p role="alert" className="mt-3 text-[13px] leading-5 text-destructive">
+          {problem}
+        </p>
+      ) : (
+        <p className="mt-3 text-[13px] leading-5 text-muted-foreground">
+          {issued
+            ? "Your key is shown only now. It's listed under Connected agents, where you can revoke it."
+            : "Creates a key for Claude Desktop on this computer, then shows the steps."}
+        </p>
+      )}
+      {issued && (
+        <>
+          <AssistantGuideSteps
+            className="mt-4"
+            guide={{
+              steps: [
+                <>
+                  In Claude Desktop, open <Ui>Help › Troubleshooting › Enable Developer Mode</Ui>,
+                  then <Ui>Developer › Configure Third-Party Inference</Ui>.
+                </>,
+                <>
+                  Under <Ui>Connection</Ui>, choose <Ui>Gateway</Ui> and paste this base URL.
+                  <EndpointField endpoint={issued.baseUrl} label="Copy base URL" />
+                </>,
+                <>
+                  Keep <Ui>Static API key</Ui> and the <Ui>Bearer</Ui> auth scheme, and paste this
+                  key. Leave model discovery on; your pool&rsquo;s models fill the picker.
+                  <EndpointField endpoint={issued.key} label="Copy key" />
+                </>,
+                <>
+                  Under <Ui>MCP servers</Ui>, add <Ui>{server}</Ui> as a Streamable HTTP server with
+                  this URL and OAuth sign-in.
+                  <EndpointField endpoint={mcpUrl} />
+                </>,
+                <>
+                  Click <Ui>Apply Changes</Ui>, then <Ui>Save & Restart</Ui>, and choose the
+                  third-party option at sign-in.
+                </>,
+              ],
+            }}
+          />
+          <div className="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 border-t pt-3">
+            <Button
+              variant="outline"
+              size="sm"
+              onClick={() =>
+                download("claude-desktop-config.json", desktopConfig(issued, server, mcpUrl))
+              }
+            >
+              Download setup file
+            </Button>
+            <span className="text-xs leading-5 text-muted-foreground">
+              Untested: load it with <Ui>Import configuration</Ui> in the same window instead of
+              steps 2 to 4.
+            </span>
+          </div>
+        </>
+      )}
+      <p className="mt-3 text-xs leading-5 text-muted-foreground">
+        Claude Desktop then runs on your pool in its third-party mode: chats stay on this computer,
+        with no claude.ai or mobile access, sharing or voice.
+      </p>
+    </>
+  );
+}
diff --git a/apps/hosted/web/src/implementation/pages/computer-quick-setup.tsx b/apps/hosted/web/src/implementation/pages/computer-quick-setup.tsx
new file mode 100644
index 0000000..36b483c
--- /dev/null
+++ b/apps/hosted/web/src/implementation/pages/computer-quick-setup.tsx
@@ -0,0 +1,93 @@
+import { Button } from "@executor-js/ui/components/button";
+import {
+  Select,
+  SelectContent,
+  SelectItem,
+  SelectTrigger,
+  SelectValue,
+} from "@executor-js/ui/components/select";
+import { Spinner } from "@executor-js/ui/components/spinner";
+import { poolLabel, type PoolSetup } from "./pool-setup.tsx";
+
+/** Which pool a new computer's models run on. */
+export function PoolSelect({ setup }: { readonly setup: PoolSetup }) {
+  const pools = setup.view?.pools ?? [];
+  return (
+    <Select value={setup.pool ?? ""} onValueChange={setup.setPool} disabled={!pools.length}>
+      <SelectTrigger size="sm" aria-label="Pool for models" className="w-44 text-xs">
+        <SelectValue placeholder="Your pool" />
+      </SelectTrigger>
+      <SelectContent>
+        {pools.map((pool) => (
+          <SelectItem key={pool.id} value={pool.id}>
+            {poolLabel(pool)}
+          </SelectItem>
+        ))}
+      </SelectContent>
+    </Select>
+  );
+}
+
+/** One live region, so screen readers hear every change, errors included. */
+function Status({ setup, hint }: { readonly setup: PoolSetup; readonly hint: string }) {
+  const pending = setup.pending;
+  return (
+    <p
+      aria-live="polite"
+      className={`mt-3 text-[13px] leading-5 ${setup.problem ? "text-destructive" : "text-muted-foreground"}`}
+    >
+      {setup.problem ??
+        (pending?.kind === "waiting" ? (
+          <span className="inline-flex items-center gap-2">
+            <Spinner className="size-3.5" />
+            Waiting for this computer…
+          </span>
+        ) : pending?.kind === "connected" ? (
+          <>
+            <span className="text-foreground">{pending.name}</span> is connected.
+          </>
+        ) : pending?.kind === "expired" ? (
+          "Link expired. Copy it again."
+        ) : (
+          hint
+        ))}
+    </p>
+  );
+}
+
+/** One-click setup for an agent that runs on this computer and reads the pool's model settings. */
+export function ComputerQuickSetup({
+  setup,
+  client,
+  runs = client,
+  note,
+}: {
+  readonly setup: PoolSetup;
+  readonly client: string;
+  /** What runs on the pool, when it reads better than the client's name. */
+  readonly runs?: string;
+  readonly note?: string;
+}) {
+  const minting = setup.pending?.kind === "minting";
+  return (
+    <>
+      <div className="flex flex-wrap items-center gap-2">
+        <span className="min-w-0 flex-1 text-[13px] text-muted-foreground">Models from</span>
+        <PoolSelect setup={setup} />
+        <Button
+          size="sm"
+          loading={minting}
+          disabled={minting}
+          onClick={() => void setup.copyPrompt()}
+        >
+          Copy setup prompt
+        </Button>
+      </div>
+      <Status
+        setup={setup}
+        hint={`Paste it into ${client} on this computer. It adds your tools and runs ${runs} on your pool.`}
+      />
+      {note && <p className="mt-1 text-xs leading-5 text-muted-foreground">{note}</p>}
+    </>
+  );
+}
diff --git a/apps/hosted/web/src/implementation/pages/computer-rows.tsx b/apps/hosted/web/src/implementation/pages/computer-rows.tsx
new file mode 100644
index 0000000..c318096
--- /dev/null
+++ b/apps/hosted/web/src/implementation/pages/computer-rows.tsx
@@ -0,0 +1,210 @@
+import { useState, type ReactNode } from "react";
+import { Button } from "@executor-js/ui/components/button";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@executor-js/ui/components/dialog";
+import {
+  DropdownMenuItem,
+  DropdownMenuRadioGroup,
+  DropdownMenuRadioItem,
+  DropdownMenuSeparator,
+  DropdownMenuSub,
+  DropdownMenuSubContent,
+  DropdownMenuSubTrigger,
+} from "@executor-js/ui/components/dropdown-menu";
+import { Input } from "@executor-js/ui/components/input";
+import { LocalTime, shortMoment } from "@executor-js/ui/components/local-time";
+import { AccountActionsMenu } from "@executor-js/ui/dashboard/account-actions";
+import {
+  type Computer,
+  isConnected,
+  poolLabel,
+  post,
+  remove,
+  type PoolSetup,
+} from "./pool-setup.tsx";
+
+/** The person's computers, as rows in the connected-agents list; none means no rows at all. */
+export const computerRows = (setup: PoolSetup): ReactNode[] =>
+  (setup.view?.computers ?? [])
+    .filter((computer) => !computer.revokedAt && computer.state !== "revoked" && !computer.lapsed)
+    .map((computer) => <ComputerRow key={computer.id} setup={setup} computer={computer} />);
+
+function ComputerRow({
+  setup,
+  computer,
+}: {
+  readonly setup: PoolSetup;
+  readonly computer: Computer;
+}) {
+  const pools = setup.view?.pools ?? [];
+  const [dialog, setDialog] = useState<"rename" | "revoke">();
+  const [name, setName] = useState(computer.name);
+  const [busy, setBusy] = useState(false);
+  const [problem, setProblem] = useState<string>();
+  const id = encodeURIComponent(computer.id);
+  const run = async (work: (intent: string) => Promise<unknown>, closes = true) => {
+    setBusy(true);
+    setProblem(undefined);
+    const error = await setup.act(work);
+    setBusy(false);
+    if (error) setProblem(error);
+    else if (closes) setDialog(undefined);
+  };
+  const copyUndo = () =>
+    navigator.clipboard
+      .writeText(setup.view?.undoPrompt ?? "")
+      .catch(() => setProblem("Couldn't copy the undo prompt."));
+  return (
+    <li className="flex items-center gap-4 px-1 py-3">
+      <div className="min-w-0 flex-1">
+        <p className="truncate text-[13px] font-medium">{computer.name}</p>
+        <p className="mt-0.5 truncate text-xs text-muted-foreground">
+          {poolLabel(pools.find(({ id: pool }) => pool === computer.poolId))}
+          {computer.tools === false ? " · Models" : " · Tools and models"}
+          {computer.state === "removed" || computer.removedAt ? (
+            " · No access to this pool"
+          ) : isConnected(computer) ? (
+            <>
+              {" · Set up "}
+              <LocalTime value={computer.createdAt} options={shortMoment} />
+            </>
+          ) : (
+            " · Waiting for its first request"
+          )}
+        </p>
+        {problem && !dialog && (
+          <p role="alert" className="mt-1 text-xs text-destructive">
+            {problem}
+          </p>
+        )}
+      </div>
+      <AccountActionsMenu account={{ label: computer.name }}>
+        <DropdownMenuItem
+          onSelect={() => {
+            setName(computer.name);
+            setProblem(undefined);
+            setDialog("rename");
+          }}
+        >
+          Rename
+        </DropdownMenuItem>
+        {pools.length > 1 && (
+          <DropdownMenuSub>
+            <DropdownMenuSubTrigger>Pool</DropdownMenuSubTrigger>
+            <DropdownMenuSubContent>
+              <DropdownMenuRadioGroup
+                value={computer.poolId}
+                onValueChange={(pool) =>
+                  void run((intent) => post(`computers/${id}/pool`, { intent, pool }), false)
+                }
+              >
+                {pools.map((pool) => (
+                  <DropdownMenuRadioItem key={pool.id} value={pool.id}>
+                    {poolLabel(pool)}
+                  </DropdownMenuRadioItem>
+                ))}
+              </DropdownMenuRadioGroup>
+            </DropdownMenuSubContent>
+          </DropdownMenuSub>
+        )}
+        {computer.tools !== false && (
+          <DropdownMenuItem onSelect={() => void copyUndo()}>Copy undo prompt</DropdownMenuItem>
+        )}
+        <DropdownMenuSeparator />
+        <DropdownMenuItem
+          variant="destructive"
+          onSelect={() => {
+            setProblem(undefined);
+            setDialog("revoke");
+          }}
+        >
+          Revoke
+        </DropdownMenuItem>
+      </AccountActionsMenu>
+      <Dialog
+        open={dialog !== undefined}
+        onOpenChange={(open) => !open && !busy && setDialog(undefined)}
+      >
+        <DialogContent>
+          {dialog === "rename" ? (
+            <form
+              onSubmit={(event) => {
+                event.preventDefault();
+                void run((intent) => post(`computers/${id}/name`, { intent, name }));
+              }}
+            >
+              <DialogHeader>
+                <DialogTitle>Rename {computer.name}</DialogTitle>
+                <DialogDescription>Only you see this name.</DialogDescription>
+              </DialogHeader>
+              <Input
+                className="mt-4"
+                aria-label="Computer name"
+                value={name}
+                maxLength={60}
+                onChange={(event) => setName(event.target.value)}
+              />
+              {problem && (
+                <p role="alert" className="mt-2 text-xs text-destructive">
+                  {problem}
+                </p>
+              )}
+              <DialogFooter className="mt-4">
+                <Button
+                  type="button"
+                  variant="outline"
+                  disabled={busy}
+                  onClick={() => setDialog(undefined)}
+                >
+                  Cancel
+                </Button>
+                <Button type="submit" loading={busy} disabled={busy || !name.trim()}>
+                  Save
+                </Button>
+              </DialogFooter>
+            </form>
+          ) : (
+            <>
+              <DialogHeader>
+                <DialogTitle>Revoke {computer.name}?</DialogTitle>
+                <DialogDescription>
+                  {computer.tools === false
+                    ? "Its next request fails."
+                    : "Its next request fails. To clean up its files, run the undo prompt on that computer."}
+                </DialogDescription>
+              </DialogHeader>
+              {problem && (
+                <p role="alert" className="text-xs text-destructive">
+                  {problem}
+                </p>
+              )}
+              <DialogFooter>
+                <Button variant="outline" disabled={busy} onClick={() => setDialog(undefined)}>
+                  Cancel
+                </Button>
+                <Button
+                  variant="destructive"
+                  loading={busy}
+                  disabled={busy}
+                  onClick={() =>
+                    void run((intent) =>
+                      remove(`computers/${id}?intent=${encodeURIComponent(intent)}`),
+                    )
+                  }
+                >
+                  Revoke computer
+                </Button>
+              </DialogFooter>
+            </>
+          )}
+        </DialogContent>
+      </Dialog>
+    </li>
+  );
+}
