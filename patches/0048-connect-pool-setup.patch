diff --git a/e2e/tests/pool-setup-connect.spec.ts b/e2e/tests/pool-setup-connect.spec.ts
new file mode 100644
index 0000000..38b7730
--- /dev/null
+++ b/e2e/tests/pool-setup-connect.spec.ts
@@ -0,0 +1,366 @@
+/**
+ * The deployment's pool setup sits on Connect beside the built-in guides: Claude Code and Codex
+ * lead with one click while their steps stay one click away, every other assistant keeps its own
+ * guide, and the person's computers join the connected agents. The setup service is the
+ * deployment's own Worker, so the scenario stands in for it with a small fake.
+ */
+import { expect, layer } from "@effect/vitest";
+import { Effect } from "effect";
+import type { Page, Route } from "playwright";
+import { scenarios } from "../test-plan.ts";
+import { Actors } from "../support/actors.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+
+interface FakeComputer {
+  id: string;
+  name: string;
+  poolId: string;
+  createdAt: string;
+  state: string;
+  firstModelRequestAt: string | null;
+  firstToolCallAt: string | null;
+  revokedAt: string | null;
+  tools: boolean;
+  lapsed?: true;
+}
+
+/** The setup service's routes, enough for the page: one person, two pools and their computers. */
+function setupService() {
+  const computers: FakeComputer[] = [
+    {
+      id: "existing",
+      name: "Work laptop",
+      poolId: "team",
+      createdAt: "2026-10-20T09:00:00.000Z",
+      state: "active",
+      firstModelRequestAt: "2026-10-20T09:01:00.000Z",
+      firstToolCallAt: "2026-10-20T09:02:00.000Z",
+      revokedAt: null,
+      tools: true,
+    },
+    {
+      id: "lapsed",
+      name: "Old Mac",
+      poolId: "own",
+      createdAt: "2026-10-20T08:00:00.000Z",
+      state: "issuing",
+      firstModelRequestAt: null,
+      firstToolCallAt: null,
+      revokedAt: null,
+      tools: true,
+      lapsed: true,
+    },
+  ];
+  const calls: { method: string; path: string; body: Record<string, unknown> }[] = [];
+  let minted = 0;
+  const reply = (route: Route, body: unknown, status = 200) =>
+    route.fulfill({ status, contentType: "application/json", body: JSON.stringify(body) });
+  const handle = (route: Route) => {
+    const request = route.request();
+    const path = new URL(request.url()).pathname.replace("/setup/v1/", "");
+    const body = (request.postDataJSON() ?? {}) as Record<string, unknown>;
+    calls.push({ method: request.method(), path, body });
+    if (path === "context") return reply(route, { intent: "signed-intent" });
+    if (path === "computers")
+      return reply(route, {
+        computers,
+        pools: [
+          { id: "own", name: "", mine: true },
+          { id: "team", name: "Team pool", mine: false },
+        ],
+        undoPrompt: "Undo the setup on this computer.",
+      });
+    if (path === "links") {
+      minted += 1;
+      const computer: FakeComputer = {
+        id: `new-${minted}`,
+        name: String(body.name),
+        poolId: String(body.pool),
+        createdAt: new Date().toISOString(),
+        state: "issuing",
+        firstModelRequestAt: null,
+        firstToolCallAt: null,
+        revokedAt: null,
+        tools: body.tools !== false,
+      };
+      computers.unshift(computer);
+      return reply(route, {
+        computer,
+        computerId: computer.id,
+        prompt: "Set up the deployment for Claude Code and Codex on this computer.",
+        link: `${new URL(request.url()).origin}/setup/claim/fake-${computer.id}`,
+        expiresAt: new Date(Date.now() + 300_000).toISOString(),
+      });
+    }
+    const [, id, action] = /^computers\/([^/]+)(?:\/(\w+))?$/.exec(path) ?? [];
+    const computer = computers.find((item) => item.id === id);
+    if (!computer) return reply(route, { error: "Setup route not found." }, 404);
+    if (action === "name") computer.name = String(body.name);
+    if (action === "pool") computer.poolId = String(body.pool);
+    if (request.method() === "DELETE") {
+      computer.state = "revoked";
+      computer.revokedAt = new Date().toISOString();
+      return reply(route, { success: true });
+    }
+    return reply(route, { computer });
+  };
+  /** The pasted prompt ran on the computer: its first model request and tool call arrive. */
+  const arrive = () => {
+    const computer = computers.find((item) => item.id === `new-${minted}`);
+    if (!computer) return;
+    computer.state = "active";
+    computer.firstModelRequestAt = new Date().toISOString();
+    computer.firstToolCallAt = new Date().toISOString();
+  };
+  /** The one-time link a page claims itself, for a key it shows once. */
+  const claim = (route: Route) =>
+    reply(route, {
+      version: 1,
+      credentials: {
+        modelUrl: new URL(route.request().url()).origin,
+        modelKey: "sk-fake-pool-key",
+      },
+    });
+  /** The deployment's own captures, served from the files it ships. */
+  const capture = (route: Route) =>
+    route.fulfill({
+      path: `../public/brand/assistants/${new URL(route.request().url()).pathname.split("/").pop()}`,
+    });
+  return { handle, claim, capture, arrive, calls };
+}
+
+/** Resolves once the element's own transitions end, so a checkpoint shows it at rest. */
+const settled = (element: Element) =>
+  Promise.all(element.getAnimations({ subtree: true }).map((animation) => animation.finished));
+
+const guide = (page: Page, name: string) => page.getByRole("article", { name: `${name} setup` });
+const rows = (page: Page) =>
+  page.getByRole("region", { name: "Connected agents" }).getByRole("listitem");
+
+layer(HostedLive, { excludeTestServices: true })("Pool setup on Connect", (it) => {
+  it.effect(scenarios.poolSetupConnect.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const actors = yield* Actors,
+          browser = yield* Browser;
+        const service = setupService();
+        yield* browser.login(actors.owner);
+        yield* browser.use("Show the dashboard in dark mode", (page) =>
+          page.emulateMedia({ colorScheme: "dark" }),
+        );
+        yield* browser.use("Allow the clipboard", (page) =>
+          page.context().grantPermissions(["clipboard-read", "clipboard-write"]),
+        );
+        yield* browser.use("Stand in for the setup service", (page) =>
+          page.route("**/setup/v1/**", service.handle),
+        );
+        yield* browser.use("Serve the deployment's captures", (page) =>
+          page.route("**/brand/assistants/**", service.capture),
+        );
+        yield* browser.use("Open Connect", (page) =>
+          page.goto(`/org/${actors.organization.slug}/connect`),
+        );
+        expect(
+          yield* browser.use("Claude's capture shows the deployment's name", (page) =>
+            guide(page, "Claude").getByRole("img").getAttribute("src"),
+          ),
+        ).toBe("/brand/assistants/claude.webp");
+        yield* browser.use("Claude keeps its own guide", (page) =>
+          guide(page, "Claude").getByRole("link", { name: "Open Claude connectors" }).waitFor(),
+        );
+        yield* browser.checkpoint("Claude's guide is unchanged");
+
+        yield* browser.use("Choose Cursor", (page) =>
+          page.getByRole("button", { name: "Cursor", exact: true }).click(),
+        );
+        expect(
+          yield* browser.use("Cursor has no pool setup", (page) =>
+            guide(page, "Cursor").getByRole("button", { name: "Copy setup prompt" }).count(),
+          ),
+        ).toBe(0);
+        yield* browser.use("Choose Claude Code", (page) =>
+          page.getByRole("button", { name: "Claude Code", exact: true }).click(),
+        );
+        yield* browser.use("One click leads", (page) =>
+          guide(page, "Claude Code").getByRole("button", { name: "Copy setup prompt" }).waitFor(),
+        );
+        yield* browser.checkpoint("Claude Code: one-click setup");
+        yield* browser.use("Show the manual steps", (page) =>
+          guide(page, "Claude Code").getByText("Show manual steps").click(),
+        );
+        yield* browser.use("The built-in steps are all there", (page) =>
+          guide(page, "Claude Code").getByText("from your terminal.", { exact: false }).waitFor(),
+        );
+        yield* browser.checkpoint("Claude Code: manual steps");
+
+        yield* browser.use("Open the pool picker", (page) =>
+          guide(page, "Claude Code").getByRole("combobox", { name: "Pool for models" }).click(),
+        );
+        yield* browser.use("Pick the team pool", (page) =>
+          page.getByRole("option", { name: "Team pool" }).click(),
+        );
+        yield* browser.use("Copy the setup prompt", (page) =>
+          guide(page, "Claude Code").getByRole("button", { name: "Copy setup prompt" }).click(),
+        );
+        yield* browser.use("It waits for the computer", (page) =>
+          page.getByText("Waiting for this computer…").waitFor(),
+        );
+        const links = service.calls.filter((call) => call.path === "links");
+        expect(links).toHaveLength(1);
