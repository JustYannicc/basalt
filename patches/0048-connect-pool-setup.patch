diff --git a/apps/hosted/web/src/implementation/pages/pool-endpoint.tsx b/apps/hosted/web/src/implementation/pages/pool-endpoint.tsx
new file mode 100644
index 0000000..3751f56
--- /dev/null
+++ b/apps/hosted/web/src/implementation/pages/pool-endpoint.tsx
@@ -0,0 +1,71 @@
+import { useState } from "react";
+import { Button } from "@executor-js/ui/components/button";
+import { Code } from "@executor-js/ui/dashboard/code";
+import { EndpointField } from "@executor-js/ui/dashboard/connect";
+import { PoolSelect } from "./computer-quick-setup.tsx";
+import type { PoolKey, PoolSetup } from "./pool-setup.tsx";
+
+/** Any app or script reaches the pool's models directly: an OpenAI or Anthropic base URL and a key. */
+export function PoolEndpoint({ setup }: { readonly setup: PoolSetup }) {
+  const [issued, setIssued] = useState<PoolKey>();
+  const [busy, setBusy] = useState(false);
+  const [problem, setProblem] = useState<string>();
+  // The router serves the model gateway on the dashboard's own origin.
+  const baseUrl = issued?.baseUrl ?? window.location.origin;
+  const key = issued?.key ?? "<POOL_KEY>";
+  const create = async () => {
+    setBusy(true);
+    setProblem(undefined);
+    try {
+      setIssued(
+        await setup.issueKey(
+          `Pool key ${new Date().toLocaleDateString(undefined, { dateStyle: "medium" })}`,
+        ),
+      );
+    } catch (error) {
+      setProblem(setup.failure(error));
+    }
+    setBusy(false);
+  };
+  return (
+    <>
+      <p className="text-[13px] leading-5 text-muted-foreground">
+        Any app or script can use your pool&rsquo;s models. Point its OpenAI or Anthropic client at
+        this base URL with a pool key. For tools, use the MCP URL with a personal access token.
+      </p>
+      <div className="mt-3 flex flex-wrap items-center gap-2">
+        <span className="min-w-0 flex-1 text-[13px] text-muted-foreground">Models from</span>
+        <PoolSelect setup={setup} />
+        <Button size="sm" loading={busy} disabled={busy} onClick={() => void create()}>
+          {issued ? "Create another key" : "Create pool key"}
+        </Button>
+      </div>
+      {problem && (
+        <p role="alert" className="mt-2 text-[13px] leading-5 text-destructive">
+          {problem}
+        </p>
+      )}
+      <EndpointField className="mt-3" endpoint={baseUrl} label="Copy base URL" />
+      {issued && <EndpointField endpoint={issued.key} label="Copy pool key" />}
+      <p className="mt-3 text-xs text-muted-foreground">Most SDKs and tools read these:</p>
+      <div className="mt-2 overflow-hidden rounded-lg border">
+        <Code
+          code={[
+            `export OPENAI_BASE_URL=${baseUrl}/v1`,
+            `export OPENAI_API_KEY=${key}`,
+            `export ANTHROPIC_BASE_URL=${baseUrl}`,
+            `export ANTHROPIC_API_KEY=${key}`,
+          ].join("\n")}
+          path="pool.env"
+          lineNumbers={false}
+          copyable
+        />
+      </div>
+      <p className="mt-3 text-xs leading-5 text-muted-foreground">
+        {issued
+          ? "Your key is shown only now. It's listed under Connected agents, where you can revoke it."
+          : "Each key is listed under Connected agents, where you can revoke it."}
+      </p>
+    </>
+  );
+}
diff --git a/apps/hosted/web/src/implementation/pages/pool-setup.tsx b/apps/hosted/web/src/implementation/pages/pool-setup.tsx
new file mode 100644
index 0000000..f9ed88d
--- /dev/null
+++ b/apps/hosted/web/src/implementation/pages/pool-setup.tsx
@@ -0,0 +1,287 @@
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+
+/*
+ * The deployment's pool setup on the Connect page. Everything here talks to the deployment's own
+ * /setup/v1 routes on this origin with the signed-in session; keys reach this page only behind
+ * the one-time link the person pastes into their agent.
+ */
+
+export interface Computer {
+  readonly id: string;
+  readonly name: string;
+  readonly poolId: string;
+  readonly createdAt: string;
+  readonly state?: "issuing" | "active" | "revoking" | "revoked" | "removed";
+  readonly firstModelRequestAt: string | null;
+  readonly firstToolCallAt: string | null;
+  readonly revokedAt: string | null;
+  readonly removedAt?: string | null;
+  readonly tools?: boolean;
+  /** Its setup link lapsed unclaimed, so it can never be set up. */
+  readonly lapsed?: true;
+}
+export interface PoolChoice {
+  readonly id: string;
+  readonly name: string;
+  readonly mine: boolean;
+}
+interface ComputersView {
+  readonly computers: readonly Computer[];
+  readonly pools: readonly PoolChoice[];
+  readonly undoPrompt: string;
+}
+interface SetupLink {
+  readonly computerId: string;
+  readonly prompt: string;
+  readonly link: string;
+  readonly expiresAt: string;
+}
+/** A models-only key this page shows once, for clients the person configures by hand. */
+export interface PoolKey {
+  readonly key: string;
+  readonly baseUrl: string;
+}
+
+class SetupFailure extends Error {}
+
+const failure = (error: unknown) =>
+  error instanceof SetupFailure ? error.message : "Setup failed. Try again.";
+
+/** Intents last five minutes; renew a little early so a click never races the expiry. */
+const intentLife = 4 * 60_000;
+/** How long a setup link lasts, timed from its arrival here so the browser's clock never matters. */
+const linkLife = 5 * 60_000;
+/** A claimed computer may take a while to send its first request; stop watching after this. */
+const watchAfterClaim = 10 * 60_000;
+const pollEvery = 4000;
+
+async function send<T>(path: string, init?: RequestInit): Promise<T> {
+  let response: Response;
+  try {
+    response = await fetch(`/setup/v1/${path}`, { credentials: "same-origin", ...init });
+  } catch {
+    throw new SetupFailure("Setup couldn't be reached. Try again.");
+  }
+  const body: unknown = await response.json().catch(() => ({}));
+  const error =
+    typeof body === "object" && body !== null && "error" in body ? String(body.error) : "";
+  if (!response.ok) throw new SetupFailure(error || "Setup failed. Try again.");
+  return body as T;
+}
+
+export const post = <T,>(path: string, body: object) =>
+  send<T>(path, {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify(body),
+  });
+export const remove = (path: string) => send(path, { method: "DELETE" });
+/** Revokes quietly: only for a computer nobody can claim any more. */
+const revoke = (id: string, intent: string) =>
+  remove(`computers/${encodeURIComponent(id)}?intent=${encodeURIComponent(intent)}`).catch(
+    () => undefined,
+  );
+
+/** The person's platform, as the default name of the computer they set up from this browser. */
+export function computerName(): string {
+  const platform = `${navigator.userAgent} ${navigator.platform}`;
+  if (/Mac/i.test(platform)) return "Mac";
+  if (/Win/i.test(platform)) return "Windows PC";
+  return "Linux computer";
+}
+
+export const poolLabel = (pool: PoolChoice | undefined) =>
+  !pool ? "Pool" : pool.mine ? "Your pool" : pool.name.trim() || "Shared pool";
+
+/** Green needs a model request and, unless the computer is models only, a tool call. */
+export function isConnected(computer: Computer): boolean {
+  if (computer.revokedAt || computer.state === "revoked" || computer.state === "removed")
+    return false;
+  return (
+    computer.firstModelRequestAt !== null &&
+    (computer.tools === false || computer.firstToolCallAt !== null)
+  );
+}
+
+export type Pending =
+  | { readonly kind: "minting" }
+  | { readonly kind: "waiting"; readonly computerId: string; readonly expiresAt: number }
+  | { readonly kind: "connected"; readonly name: string }
+  | { readonly kind: "expired"; readonly computerId: string };
+
+/** Shared state for the Connect page: one list, one pool choice and one setup in flight. */
+export function usePoolSetup() {
+  const intent = useRef<{ value: Promise<string>; at: number } | undefined>(undefined);
+  const [view, setView] = useState<ComputersView>();
+  const [pool, setPool] = useState<string>();
+  const [pending, setPending] = useState<Pending>();
+  const [problem, setProblem] = useState<string>();
+  const minting = useRef(false);
+
+  // One request at a time shares the intent; a failure is never cached.
+  const signed = useCallback(() => {
+    if (intent.current && Date.now() - intent.current.at < intentLife) return intent.current.value;
+    const value = send<{ intent: string }>("context").then((result) => result.intent);
+    intent.current = { value, at: Date.now() };
+    value.catch(() => {
+      if (intent.current?.value === value) intent.current = undefined;
+    });
+    return value;
+  }, []);
+
+  const cleared = useRef(new Set<string>());
+  const refresh = useCallback(async () => {
+    const current = await signed();
+    const next = await send<ComputersView>(`computers?intent=${encodeURIComponent(current)}`);
+    // A computer whose link lapsed unclaimed can never be set up; clear it from the list.
+    for (const computer of next.computers) {
+      if (!computer.lapsed || cleared.current.has(computer.id)) continue;
+      cleared.current.add(computer.id);
+      void revoke(computer.id, current);
+    }
+    setView((current) => (JSON.stringify(current) === JSON.stringify(next) ? current : next));
+    setPool((current) =>
+      current && next.pools.some(({ id }) => id === current)
+        ? current
+        : (next.pools.find((choice) => choice.mine)?.id ?? next.pools[0]?.id),
+    );
+    return next;
+  }, [signed]);
+
+  useEffect(() => {
+    // oxlint-disable-next-line react/set-state-in-effect -- loads the list from the setup service once
+    refresh().catch((error: unknown) => setProblem(failure(error)));
+  }, [refresh]);
+
+  // While a link is out, watch for its computer's first request, then stop. A hidden tab waits.
+  useEffect(() => {
+    if (pending?.kind !== "waiting") return;
+    let timer: number | undefined;
+    let live = true;
+    const tick = async () => {
+      if (!document.hidden) {
+        const next = await refresh().catch(() => undefined);
+        if (!live) return;
+        const computer = next?.computers.find(({ id }) => id === pending.computerId);
+        if (computer && isConnected(computer))
+          return setPending({ kind: "connected", name: computer.name });
+        // The server's word wins: a lapsed link, or a computer cleared before any request.
+        const gone =
+          computer?.lapsed === true ||
+          (computer?.state === "revoked" && computer.firstModelRequestAt === null);
+        const unclaimed = !computer || computer.state === "issuing";
+        if (gone || (Date.now() >= pending.expiresAt && unclaimed))
+          return setPending({ kind: "expired", computerId: pending.computerId });
+        if (Date.now() >= pending.expiresAt + watchAfterClaim) return setPending(undefined);
+      }
+      timer = window.setTimeout(() => void tick(), pollEvery);
+    };
+    timer = window.setTimeout(() => void tick(), pollEvery);
+    return () => {
+      live = false;
+      window.clearTimeout(timer);
+    };
+  }, [pending, refresh]);
+
+  /**
+   * Mints a computer on the chosen pool when the person copies, so the link's five minutes start
+   * then. Copying again mints afresh; an earlier link someone may have pasted stays valid until it
+   * lapses, and the list clears it after that.
+   */
+  const copyPrompt = useCallback(async () => {
+    if (minting.current) return;
+    minting.current = true;
+    setProblem(undefined);
+    const earlier =
+      pending?.kind === "waiting" || pending?.kind === "expired" ? pending : undefined;
+    setPending({ kind: "minting" });
+    const minted = (async () => {
+      const current = await signed();
+      const link = await post<SetupLink>("links", {
+        intent: current,
+        name: computerName(),
+        ...(pool && { pool }),
+      });
+      setPending({
+        kind: "waiting",
+        computerId: link.computerId,
+        expiresAt: Date.now() + linkLife,
+      });
+      void refresh().catch(() => undefined);
+      return link.prompt;
+    })();
+    try {
+      // Safari keeps the click's permission only for a clipboard write that starts right away.
+      await navigator.clipboard.write([
+        new ClipboardItem({
+          "text/plain": minted.then((text) => new Blob([text], { type: "text/plain" })),
+        }),
+      ]);
+    } catch {
+      try {
+        await navigator.clipboard.writeText(await minted);
+      } catch (error) {
+        setPending((current) => (current?.kind === "minting" ? earlier : current));
+        setProblem(
+          error instanceof SetupFailure
+            ? error.message
+            : "Couldn't copy the prompt. Click Copy setup prompt again.",
+        );
+      }
+    } finally {
+      minting.current = false;
+    }
+  }, [pending, pool, refresh, signed]);
+
+  /**
+   * Issues a models-only key on the chosen pool and claims its one-time link right here, for a
+   * client that has no agent to paste a prompt into. The key is listed and revocable like any
+   * computer.
+   */
+  const issueKey = useCallback(
+    async (name: string): Promise<PoolKey> => {
+      const link = await post<SetupLink>("links", {
+        intent: await signed(),
+        name,
+        tools: false,
+        ...(pool && { pool }),
+      });
+      let claimed: Response;
+      try {
+        claimed = await fetch(`${link.link}?format=json`, { credentials: "same-origin" });
+      } catch {
+        throw new SetupFailure("Setup couldn't be reached. Try again.");
+      }
+      const body = (await claimed.json().catch(() => ({}))) as {
+        credentials?: { modelKey?: unknown; modelUrl?: unknown };
+      };
+      const { modelKey, modelUrl } = body.credentials ?? {};
+      void refresh().catch(() => undefined);
+      if (!claimed.ok || typeof modelKey !== "string" || typeof modelUrl !== "string")
+        throw new SetupFailure("Couldn't create the key. Try again.");
+      return { key: modelKey, baseUrl: modelUrl };
+    },
+    [pool, refresh, signed],
+  );
+
+  /** Runs one change against the signed intent, then reloads; returns the error to show, if any. */
+  const act = useCallback(
+    async (work: (intent: string) => Promise<unknown>): Promise<string | undefined> => {
+      try {
+        await work(await signed());
+        await refresh();
+        return undefined;
+      } catch (error) {
+        return failure(error);
+      }
+    },
+    [refresh, signed],
+  );
+
+  // Stable while nothing changed, so a quiet poll re-renders nothing.
+  return useMemo(
+    () => ({ view, pool, setPool, pending, problem, copyPrompt, issueKey, act, failure }),
+    [view, pool, pending, problem, copyPrompt, issueKey, act],
+  );
+}
+export type PoolSetup = ReturnType<typeof usePoolSetup>;
