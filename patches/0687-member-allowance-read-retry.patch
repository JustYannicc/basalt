diff --git a/apps/hosted/cloud/src/implementation/member-allowance.ts b/apps/hosted/cloud/src/implementation/member-allowance.ts
new file mode 100644
index 0000000..fb2dc1f
--- /dev/null
+++ b/apps/hosted/cloud/src/implementation/member-allowance.ts
@@ -0,0 +1,62 @@
+/**
+ * The member allowance invitations and SSO sign-ins are admitted against. An existing customer
+ * is read, never written, so a lost answer can be asked again. Only a customer Autumn says it has
+ * never seen is created, and that write is sent once.
+ */
+import { Effect, Redacted } from "effect";
+import { AutumnRequestFailed, autumnTimeout, type AutumnClient } from "../contracts/autumn.ts";
+import { freeMembers, type BillingCatalog } from "../contracts/billing-catalog.ts";
+import { MemberAllowanceUnavailable } from "../contracts/billing-meter.ts";
+
+type Subscriptions = {
+  readonly subscriptions: ReadonlyArray<{ readonly planId: string; readonly status: string }>;
+};
+/** Whether the customer currently holds one of these plans. */
+export const active = (customer: Subscriptions, plans: ReadonlyArray<string>) =>
+  customer.subscriptions.some(
+    (subscription) =>
+      plans.includes(subscription.planId) && ["active", "trialing"].includes(subscription.status),
+  );
+
+/**
+ * Unlimited on a paid plan, the free allowance otherwise. `autumn` must retry its reads within
+ * the write timeout (`autumnReads.allowance`). Fails closed: an unconfirmed allowance is never
+ * unlimited, and the failure keeps its safe reason and a reference the log shares.
+ */
+export const memberAllowance = (
+  autumn: AutumnClient["Service"],
+  catalog: BillingCatalog,
+  customerId: string,
+) =>
+  Effect.suspend(() => {
+    let operation: AutumnRequestFailed["operation"] = "getCustomer";
+    return Effect.gen(function* () {
+      const existing = yield* autumn.getCustomer({ customerId });
+      if (existing !== null) return existing;
+      operation = "getOrCreateCustomer";
+      return yield* autumn.getOrCreateCustomer({ customerId, autoEnablePlanId: catalog.free });
+    }).pipe(
+      // The read, its retries and any creation share the one budget a write attempt has.
+      Effect.timeout(autumnTimeout),
+      Effect.catchTag("TimeoutError", (cause) =>
+        Effect.fail(
+          new AutumnRequestFailed({ operation, reason: "timeout", cause: Redacted.make(cause) }),
+        ),
+      ),
+    );
+  }).pipe(
+    Effect.map((customer) =>
+      active(customer, [catalog.team, catalog.enterprise]) ? Number.POSITIVE_INFINITY : freeMembers,
+    ),
+    Effect.catchTag("AutumnRequestFailed", ({ operation, reason, status }) =>
+      Effect.gen(function* () {
+        const reference = crypto.randomUUID();
+        const failure = { operation, reason, ...(status === undefined ? {} : { status }) };
+        yield* Effect.logWarning("The member allowance could not be confirmed").pipe(
+          Effect.annotateLogs({ ...failure, reference }),
+        );
+        return yield* new MemberAllowanceUnavailable({ ...failure, reference });
+      }),
+    ),
+    Effect.withSpan("billing.memberAllowance"),
+  );
