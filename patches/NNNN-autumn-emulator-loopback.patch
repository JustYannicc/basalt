diff --git a/e2e/support/autumn-emulator.ts b/e2e/support/autumn-emulator.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/autumn-emulator.ts
@@ -0,0 +1,84 @@
+/**
+ * The Autumn billing emulator a local Cloud runs beside itself when CI provides one, so billing
+ * never waits on a shared outside service. `BASALT_E2E_AUTUMN_EMULATOR` names the `emulate` CLI;
+ * without it, billing uses the hosted emulator exactly as before.
+ */
+import { Deferred, Effect, FileSystem, Stream } from "effect";
+import { ChildProcess, ChildProcessSpawner } from "effect/process";
+import { outputLines } from "./alchemy-dev-output.ts";
+import { CloudStartFailed } from "./cloud-startup-output.ts";
+import { freePort } from "./ports.ts";
+
+/** It starts in about a second; the bound allows for a loaded runner. */
+const startupDeadline = "30 seconds";
+
+/**
+ * Start the emulator for the caller's scope and return its loopback origin, or `undefined` when
+ * this run uses the hosted one. Its output goes to `autumn-emulator.log`; closing the scope stops
+ * the process this started.
+ */
+export const localAutumnEmulator = (directory: string) =>
+  Effect.gen(function* () {
+    const entry = process.env.BASALT_E2E_AUTUMN_EMULATOR;
+    if (entry === undefined || entry === "") return undefined;
+    const fs = yield* FileSystem.FileSystem;
+    const processes = yield* ChildProcessSpawner.ChildProcessSpawner;
+    const origin = `http://127.0.0.1:${yield* freePort}`;
+    const port = new URL(origin).port;
+    // emulate reads any emulate.config.* in its working directory, so it gets an empty one.
+    const cwd = `${directory}/autumn-emulator`;
+    yield* fs.makeDirectory(cwd, { recursive: true, mode: 0o700 });
+    const log = `${directory}/autumn-emulator.log`;
+    const child = yield* processes.spawn(
+      ChildProcess.make(
+        "node",
+        [entry, "--service", "autumn", "--port", port, "--base-url", origin],
+        {
+          cwd,
+          env: { PATH: process.env.PATH ?? "", NO_COLOR: "1" },
+          extendEnv: false,
+          stdout: "pipe",
+          stderr: "pipe",
+          forceKillAfter: "5 seconds",
+        },
+      ),
+    );
+    const announced = yield* Deferred.make<void>();
+    yield* outputLines(child).pipe(
+      Stream.runForEach((line) =>
+        fs
+          .writeFileString(log, `${line}\n`, { flag: "a", mode: 0o600 })
+          .pipe(
+            Effect.andThen(
+              line.includes(origin) ? Deferred.succeed(announced, undefined) : Effect.void,
+            ),
+          ),
+      ),
+      Effect.forkScoped,
+    );
+    // The banner follows the listen call. A connection refused before the bind completes is a
+    // transport failure, which the credential request that follows retries.
+    yield* Effect.raceFirst(
+      Deferred.await(announced),
+      child.exitCode.pipe(
+        Effect.flatMap((code) =>
+          Effect.fail(
+            new CloudStartFailed({
+              operation: `The local Autumn emulator exited with ${code}; see autumn-emulator.log`,
+            }),
+          ),
+        ),
+      ),
+    ).pipe(
+      Effect.timeoutOrElse({
+        duration: startupDeadline,
+        orElse: () =>
+          Effect.fail(
+            new CloudStartFailed({
+              operation: `The local Autumn emulator did not start within ${startupDeadline}; see autumn-emulator.log`,
+            }),
+          ),
+      }),
+    );
+    return origin;
+  });
