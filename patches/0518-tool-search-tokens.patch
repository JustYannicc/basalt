diff --git a/packages/ui/src/implementation/dashboard/tool-search.ts b/packages/ui/src/implementation/dashboard/tool-search.ts
new file mode 100644
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/tool-search.ts
@@ -0,0 +1,28 @@
+import type { ToolSummary } from "@executor-js/sdk";
+
+type SearchableTool = Pick<ToolSummary, "name" | "title" | "description">;
+
+/** Shared by tool browsers and consent pickers so every query word must match. */
+export function toolSearch(query: string) {
+  const terms = query.toLowerCase().trim().split(/\s+/).filter(Boolean);
+  const label = (value: string) =>
+    value
+      .toLowerCase()
+      .replace(/[._-]+/g, " ")
+      .trim();
+  const phrase = label(terms.join(" "));
+  const rank = (tool: SearchableTool) => {
+    if (terms.length === 0) return 0;
+    const labels = [tool.name, tool.name.split(".").at(-1) ?? "", tool.title ?? ""].map(label);
+    if (labels.some((value) => value === phrase)) return 0;
+    return labels.some((value) => value.startsWith(phrase)) ? 1 : 2;
+  };
+  return {
+    active: terms.length > 0,
+    matches: (tool: SearchableTool) => {
+      const text = `${tool.name} ${tool.title ?? ""} ${tool.description}`.toLowerCase();
+      return terms.every((term) => text.includes(term));
+    },
+    compare: (left: SearchableTool, right: SearchableTool) => rank(left) - rank(right),
+  };
+}
