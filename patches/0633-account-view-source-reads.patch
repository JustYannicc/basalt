--- /dev/null
+++ b/e2e/tests/pool-account-view-cloud-read.spec.ts
@@ -0,0 +1,263 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, FileSystem, Schema, Schedule } from "effect";
+import { randomUUID } from "node:crypto";
+import { Browser } from "../support/browser.ts";
+import { Evidence, Telemetry } from "../support/evidence.ts";
+import { openPrivateApp, waitForAppUrl } from "../support/app-pages.ts";
+import { writeRows } from "../support/cloud-rows.ts";
+import { body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { nativeProviderLinkFixture } from "../support/native-provider-link-fixture.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Source = Schema.Struct({
+  files: Schema.Array(Schema.Struct({ path: Schema.String, content: Schema.String })),
+});
+const Icon = Schema.Struct({ src: Schema.String });
+const View = Schema.Struct({
+  accounts: Schema.Array(
+    Schema.Struct({
+      nativeAccountId: Schema.String,
+      nativeView: Schema.Struct({
+        state: Schema.Literal("available"),
+        account: Resource,
+        sourceApp: Schema.Struct({
+          id: Schema.String,
+          name: Schema.String,
+          icons: Schema.Array(Icon),
+        }),
+        canInspect: Schema.Literal(true),
+        observations: Schema.Struct({
+          account: Schema.String,
+          reports: Schema.Array(Schema.Unknown),
+        }),
+      }),
+    }),
+  ),
+  providers: Schema.Array(Schema.Struct({ name: Schema.String, icons: Schema.Array(Icon) })),
+});
+
+layer(HostedLive, { excludeTestServices: true })("Cloud pool account view", (it) => {
+  it.effect(scenarios.poolAccountViewCloudRead.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const p = yield* nativeProviderLinkFixture;
+        const providerPath = `${p.prefix}/apps/${p.target}`;
+        const accounts = [p.account];
+        let consumer: string | undefined;
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            for (const account of accounts) {
+              if (consumer !== undefined)
+                expect(
+                  (yield* p.api.request(
+                    p.actors.owner,
+                    "DELETE",
+                    `${p.prefix}/apps/${consumer}/accounts/app/openai/${account}`,
+                  )).status,
+                ).toBe(200);
+              expect(
+                (yield* p.api.request(
+                  p.actors.owner,
+                  "DELETE",
+                  `${providerPath}/accounts/app/openai/${account}`,
+                )).status,
+              ).toBe(200);
+              if (account !== p.account)
+                expect(
+                  (yield* p.api.request(
+                    p.actors.owner,
+                    "DELETE",
+                    `${p.prefix}/accounts/${account}`,
+                  )).status,
+                ).toBe(200);
+            }
+            if (consumer !== undefined)
+              expect(
+                (yield* p.api.request(p.actors.owner, "DELETE", `${p.prefix}/apps/${consumer}`))
+                  .status,
+              ).toBe(200);
+          }).pipe(Effect.orDie),
+        );
+        expect(
+          (yield* p.api.request(
+            p.actors.owner,
+            "PUT",
+            `${providerPath}/accounts/app/openai/${p.account}`,
+          )).status,
+        ).toBe(200);
+        for (let index = 1; index < 5; index++) {
+          const connection = yield* body(
+            Resource,
+            yield* p.api.request(
+              p.actors.owner,
+              "POST",
+              `${providerPath}/accounts/app/openai/connections`,
+              { destination: { kind: "personal" } },
+            ),
+          );
+          const path = `${p.prefix}/connections/${connection.id}/interactive`;
+          expect(
+            (yield* p.api.request(p.actors.owner, "POST", `${path}/start`, { method: "codex" }))
+              .status,
+          ).toBe(200);
+          const connected = yield* body(
+            Schema.Struct({ account: Resource }),
+            yield* p.api.request(p.actors.owner, "GET", `${path}/status`),
+          );
+          accounts.push(connected.account.id);
+        }
+        const source = yield* body(
+          Source,
+          yield* p.api.request(
+            p.actors.owner,
+            "GET",
+            "/native-provider-fixture/catalog/apps/provider-openai.json",
+          ),
+        );
+        const fs = yield* FileSystem.FileSystem;
+        // Deploy the shipped presentation function, so the proof includes both native and source reads.
+        const presentation = yield* fs.readFileString("../apps/pool/provider-account-view.ts");
+        const deployed = yield* body(
+          Resource,
+          yield* p.api.request(p.actors.owner, "POST", `${p.prefix}/apps/deploy`, {
+            name: "Five selected provider accounts",
+            files: [
+              ...source.files.map((file) =>
+                file.path === "index.ts"
+                  ? {
+                      path: file.path,
+                      content: `import { defineApp, query, object, router } from "apps";
+import { providers } from "./providers.ts";
+import { providerAccountView } from "./provider-account-view.ts";
+const view = query({ input: object({}) }, ctx => providerAccountView(ctx, {
+  isOwner: true, providers: [{id:"codex",name:"OpenAI"}],
+  accounts: ctx.app.accounts.openai.map(account => ({
+    id:account.id,nativeAccountId:account.id,provider:"codex",label:"Fixture",plan:null,state:"active",message:null,
+    windows:[],observedAt:null,freshness:"never",readingFailed:false,nextReadAt:null,earliestResetAt:null,bankedResets:null,
+  })),
+}));
+export default defineApp({
+  dependencies:{accountView:{scope:"app",cardinality:"many",tools:{accountView:{kind:"query"}}}},
+  app:{accounts:{openai:providers.openai.many().contributed()}},
+}, {tools:router({view,viewAgain:view})});`,
+                    }
+                  : file,
+              ),
+              { path: "provider-account-view.ts", content: presentation },
+              {
+                path: "ui/index.html",
+                content:
+                  "<!doctype html><html><head><title>Five selected provider accounts</title></head><body><h1>Five selected provider accounts</h1></body></html>",
+              },
+            ],
+          }),
+        );
+        consumer = deployed.id;
+        const consumerPath = `${p.prefix}/apps/${consumer}`;
+        const viewer = yield* body(
+          Schema.Struct({ userId: Schema.String }),
+          yield* p.api.request(p.actors.owner, "GET", "/api/viewer"),
+        );
+        // Only fixture registration is seeded; acquisition, links and reads use the real public APIs.
+        yield* writeRows("sso-database.json", [
+          {
+            sql: "update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb), '{basaltPools}', coalesce(metadata::jsonb -> 'basaltPools', '{}'::jsonb) || $1::jsonb)::text where id = $2",
+            params: [
+              JSON.stringify({
+                [consumer]: {
+                  app: consumer,
+                  owner: viewer.userId,
+                  membership: "executor-links-v1",
+                  authorization: "executor-app-v1",
+                },
+              }),
+              p.actors.organization.id,
+            ],
+          },
+        ]);
+        for (const account of accounts)
+          expect(
+            (yield* p.api.request(
+              p.actors.owner,
+              "PUT",
+              `${consumerPath}/accounts/app/openai/${account}`,
+            )).status,
+          ).toBe(200);
+        const browser = yield* Browser;
+        const evidence = yield* Evidence;
+        const telemetry = yield* Telemetry;
+        yield* browser.login(p.actors.owner);
+        yield* openPrivateApp(yield* waitForAppUrl(p.actors.owner, `${consumerPath}/ui`));
+        for (const name of ["view", "viewAgain"]) {
+          const trace = randomUUID().replaceAll("-", "");
+          const reply = yield* browser.use("Read five selected provider accounts", (page) =>
+            page.evaluate(
+              ({ trace, name }) => {
+                const context = JSON.parse(
+                  document.getElementById("executor-context")?.textContent ?? "{}",
+                );
+                const start = performance.now();
+                return fetch("/_executor/api/query", {
+                  method: "POST",
+                  headers: {
+                    "content-type": "application/json",
+                    traceparent: `00-${trace}-${trace.slice(0, 16)}-01`,
+                  },
+                  body: JSON.stringify({
+                    version: context.version ?? context.deployment,
+                    name,
+                    input: {},
+                  }),
+                }).then((response) =>
+                  response.json().then((body) => ({
+                    status: response.status,
+                    body,
+                    milliseconds: performance.now() - start,
+                  })),
+                );
+              },
+              { trace, name },
+            ),
+          );
+          yield* evidence.json(`${name}.json`, reply);
+          expect(reply.status).toBe(200);
+          const view = yield* Schema.decodeUnknownEffect(View)(reply.body);
+          expect(view.accounts.map((account) => account.nativeAccountId).sort()).toEqual(
+            [...accounts].sort(),
+          );
+          for (const account of view.accounts) {
+            expect(account.nativeView.account.id).toBe(account.nativeAccountId);
+            expect(account.nativeView.sourceApp.id).toBe(p.target);
+            expect(account.nativeView.sourceApp.icons.length).toBeGreaterThan(0);
+            expect(account.nativeView.observations.account).toBe(account.nativeAccountId);
+            expect(account.nativeView.observations.reports).toEqual([]);
+          }
+          expect(view.providers).toHaveLength(1);
+          expect(view.providers[0]!.name).toBe(view.accounts[0]!.nativeView.sourceApp.name);
+          expect(view.providers[0]!.icons).toEqual(view.accounts[0]!.nativeView.sourceApp.icons);
+          const spans = yield* telemetry.query(trace).pipe(
+            Effect.flatMap((result) =>
+              result.data.filter(({ span }) => span.operationName === "runtime.app.rpc.release")
+                .length === 6 &&
+              result.data.some(({ span }) => span.operationName === "catalog.lookup")
+                ? Effect.succeed(result.data)
+                : Effect.fail(
+                    new Error("The five source queries have not exported their completion spans"),
+                  ),
+            ),
+            Effect.retry({ schedule: Schedule.spaced("250 millis"), times: 40 }),
+          );
+          const lookups = spans.filter(({ span }) => span.operationName === "catalog.lookup");
+          yield* evidence.json(`${name}-catalog-work.json`, { lookups: lookups.length, spans });
+          expect(
+            lookups,
+            "One catalog lookup per view, without sharing it across views",
+          ).toHaveLength(1);
+        }
+      }),
+    ),
+  );
+});
