diff --git a/apps/hosted/web/src/implementation/pages/obsidian-devices.tsx b/apps/hosted/web/src/implementation/pages/obsidian-devices.tsx
new file mode 100644
--- /dev/null
+++ b/apps/hosted/web/src/implementation/pages/obsidian-devices.tsx
@@ -0,0 +1,278 @@
+import { useState, type ReactNode } from "react";
+import { useAtomSet, useAtomValue } from "@effect/atom-react";
+import { Exit, Option } from "effect";
+import { AsyncResult } from "effect/reactivity";
+import { ToolName, type App } from "@executor-js/sdk";
+import { Button } from "@executor-js/ui/components/button";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@executor-js/ui/components/dialog";
+import { LocalTime, RelativeTime, shortMoment } from "@executor-js/ui/components/local-time";
+import { Skeleton } from "@executor-js/ui/components/skeleton";
+import { useQuery } from "@executor-js/ui/dashboard/context";
+import { useProductBrand } from "@executor-js/ui/hooks/product-brand";
+import { connectionToolListAtom } from "../../contracts/apps.ts";
+import {
+  mcpAgentsAtom,
+  mcpConnectionsAtom,
+  revokeMcpAgentAtom,
+} from "../../contracts/mcp-connections.ts";
+import { obsidianTools, supportsObsidian } from "../../contracts/obsidian-connection.ts";
+import {
+  deviceSync,
+  hasSyncTool,
+  obsidianDevices,
+  type ObsidianDevice,
+  type VaultSync,
+} from "../../contracts/obsidian-devices.ts";
+import { vaultSyncAtom } from "../../contracts/obsidian-vault-sync.ts";
+import { HostedFailure } from "../components/dashboard-bindings.tsx";
+import { useOrganizationRoute } from "../components/organization.tsx";
+
+type Vault =
+  | { readonly kind: "pending" }
+  | { readonly kind: "failed"; readonly retry: () => void }
+  | {
+      readonly kind: "ready";
+      readonly devices: readonly ObsidianDevice[];
+      /** The drive's sync records; undefined until read, or where the app can't report them. */
+      readonly sync: VaultSync | undefined;
+    };
+
+/**
+ * Renders `children` with this vault's devices for apps that speak the Obsidian sync protocol,
+ * and `fallback` for every other app. Other apps never read their tool list or grants for this.
+ */
+export function ObsidianVault({
+  app,
+  fallback,
+  children,
+}: {
+  readonly app: App;
+  readonly fallback: ReactNode;
+  readonly children: (vault: Vault) => ReactNode;
+}) {
+  const possible = supportsObsidian(
+    app,
+    obsidianTools.map((name) => ({ name: ToolName.make(name) })),
+  );
+  return possible ? (
+    <WhenSupported key={`${app.id}:${app.activeVersion}`} app={app} fallback={fallback}>
+      {children}
+    </WhenSupported>
+  ) : (
+    fallback
+  );
+}
+
+function WhenSupported({
+  app,
+  fallback,
+  children,
+}: {
+  readonly app: App;
+  readonly fallback: ReactNode;
+  readonly children: (vault: Vault) => ReactNode;
+}) {
+  const { organization } = useOrganizationRoute();
+  const tools = useQuery(
+    connectionToolListAtom({ organization, app: app.id, version: app.activeVersion ?? undefined }),
+  );
+  if (AsyncResult.isFailure(tools.result))
+    return children({ kind: "failed", retry: () => tools.refresh() });
+  if (Option.isNone(tools.data)) return children({ kind: "pending" });
+  if (!supportsObsidian(app, tools.data.value)) return fallback;
+  return hasSyncTool(tools.data.value) ? (
+    <Synced app={app}>
+      {(sync) => (
+        <Devices app={app} sync={sync}>
+          {children}
+        </Devices>
+      )}
+    </Synced>
+  ) : (
+    <Devices app={app} sync={undefined}>
+      {children}
+    </Devices>
+  );
+}
+
+function Synced({
+  app,
+  children,
+}: {
+  readonly app: App;
+  readonly children: (sync: VaultSync | undefined) => ReactNode;
+}) {
+  const { organization } = useOrganizationRoute();
+  const sync = useQuery(
+    vaultSyncAtom({ organization, app: app.id, version: app.activeVersion ?? undefined }),
+  );
+  return children(Option.getOrUndefined(sync.data));
+}
+
+function Devices({
+  app,
+  sync,
+  children,
+}: {
+  readonly app: App;
+  readonly sync: VaultSync | undefined;
+  readonly children: (vault: Vault) => ReactNode;
+}) {
+  const { organization } = useOrganizationRoute();
+  const connections = useQuery(mcpConnectionsAtom(organization));
+  const agents = useQuery(mcpAgentsAtom(organization));
+  if (AsyncResult.isFailure(connections.result) || AsyncResult.isFailure(agents.result))
+    return children({
+      kind: "failed",
+      retry: () => {
+        connections.refresh();
+        agents.refresh();
+      },
+    });
+  if (Option.isNone(connections.data) || Option.isNone(agents.data))
+    return children({ kind: "pending" });
+  return children({
+    kind: "ready",
+    devices: obsidianDevices(app.id, connections.data.value, agents.data.value),
+    sync,
+  });
+}
+
+/**
+ * The vault's devices where the page lists accounts. `manage` adds Disconnect: revoking a
+ * device's grant ends its sync at once; its notes stay on the device and in the vault.
+ */
+export function ObsidianDeviceList({
+  vault,
+  manage,
+}: {
+  readonly vault: Vault;
+  readonly manage: boolean;
+}) {
+  const brand = useProductBrand();
+  const { organization } = useOrganizationRoute();
+  const revoke = revokeMcpAgentAtom(organization);
+  const submit = useAtomSet(revoke, { mode: "promiseExit" });
+  const state = useAtomValue(revoke);
+  const [disconnecting, setDisconnecting] = useState<ObsidianDevice>();
+  if (vault.kind === "pending")
+    return (
+      <div role="status" aria-label="Loading devices" className="flex items-center gap-4 py-2.5">
+        <div className="min-w-0 flex-1 space-y-2">
+          <Skeleton className="h-3 w-32" />
+          <Skeleton className="h-2.5 w-56 max-w-[70%]" />
+        </div>
+      </div>
+    );
+  if (vault.kind === "failed")
+    return (
+      <div className="flex items-center gap-3 py-2.5 text-[13px] text-muted-foreground">
+        Devices couldn't be loaded.
+        <Button variant="outline" size="sm" onClick={vault.retry}>
+          Try again
+        </Button>
+      </div>
+    );
+  if (vault.devices.length === 0)
+    return (
+      <p className="py-2.5 text-[13px] text-muted-foreground">
+        No device is syncing this vault. Choose Connect Obsidian to add one.
+      </p>
+    );
+  return (
+    <>
+      <ul className="divide-y">
+        {vault.devices.map((device) => (
+          <li key={device.agent} className="flex items-center gap-4 py-2.5">
+            <div className="min-w-0 flex-1">
+              <p className="truncate text-[13px] font-medium">{device.label}</p>
+              <p className="mt-0.5 truncate text-xs text-muted-foreground">
+                <SyncState device={device} sync={vault.sync} />
+                {" · Connected "}
+                <LocalTime value={device.connectedAt} options={shortMoment} />
+              </p>
+            </div>
+            {manage && (
+              <Button variant="outline" size="sm" onClick={() => setDisconnecting(device)}>
+                Disconnect<span className="sr-only"> {device.label}</span>
+              </Button>
+            )}
+          </li>
+        ))}
+      </ul>
+      <Dialog
+        open={disconnecting !== undefined}
+        onOpenChange={(open) => {
+          if (!open && !state.waiting) setDisconnecting(undefined);
+        }}
+      >
+        <DialogContent>
+          <DialogHeader>
+            <DialogTitle>Disconnect {disconnecting?.label}?</DialogTitle>
+            <DialogDescription>
+              {disconnecting?.label} stops syncing with {brand.name}. Its notes stay on the device,
+              and the vault stays here
+              {vault.kind === "ready" && vault.devices.length > 1
+                ? " with your other devices. To sync it again, choose Connect another device."
+                : ". To sync a device again, choose Connect Obsidian."}
+            </DialogDescription>
+          </DialogHeader>
+          {AsyncResult.isFailure(state) && <HostedFailure cause={state.cause} />}
+          <DialogFooter>
+            <Button
+              variant="outline"
+              disabled={state.waiting}
+              onClick={() => setDisconnecting(undefined)}
+            >
+              Cancel
+            </Button>
+            <Button
+              variant="destructive"
+              loading={state.waiting}
+              disabled={state.waiting}
+              onClick={async () => {
+                if (disconnecting === undefined) return;
+                if (Exit.isSuccess(await submit(disconnecting.agent))) setDisconnecting(undefined);
+              }}
+            >
+              Disconnect
+            </Button>
+          </DialogFooter>
+        </DialogContent>
+      </Dialog>
+    </>
+  );
+}
+
+function SyncState({
+  device,
+  sync,
+}: {
+  readonly device: ObsidianDevice;
+  readonly sync: VaultSync | undefined;
+}) {
+  const own = sync === undefined ? null : deviceSync(sync, device);
+  if (own !== null)
+    return (
+      <>
+        {own.current ? "Up to date · synced " : "Synced "}
+        <RelativeTime value={own.at} />
+      </>
+    );
+  // Before the drive recorded syncs, the grant's token refresh is the only sign of life.
+  if (device.lastActiveAt !== null)
+    return (
+      <>
+        {"Active "}
+        <RelativeTime value={device.lastActiveAt} />
+      </>
+    );
+  return <>No sync yet</>;
+}
