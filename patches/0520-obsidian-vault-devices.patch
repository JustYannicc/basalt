+import { Schema } from "effect";
+import type { AppId } from "@executor-js/sdk";
+import { obsidianTools } from "./obsidian-connection.ts";
+import type { ConnectedAgent } from "@executor-js/mcp-auth/agents";
+import type { Connection, ConnectionId } from "@executor-js/mcp-auth/connections";
+import type { GrantId } from "@executor-js/mcp-auth/grants";
+
+/** One device's sync access to a vault: the grant Connect Obsidian's scoped connection holds. */
+export interface ObsidianDevice {
+  readonly agent: GrantId;
+  readonly connection: ConnectionId;
+  readonly label: string;
+  readonly connectedAt: string;
+  readonly lastActiveAt: string | null;
+}
+
+/** The plugin's self-declared client name, identical on every device it runs on. */
+const pluginClientNames = new Set(["Signalbox Obsidian Sync", "Basalt Sync"]);
+
+/** The plugin's sync tools, any version; Connect Obsidian scopes each device to a subset. */
+const syncTools = new Set<string>(obsidianTools);
+
+/**
+ * A connection Connect Obsidian made for this vault: this one app, run as the app, limited to
+ * sync tools. A broader connection that happens to include the app belongs to an agent.
+ */
+const isVaultConnection = (app: AppId, connection: Connection) => {
+  const [only, ...rest] = connection.policy.apps;
+  return (
+    only !== undefined &&
+    rest.length === 0 &&
+    only.app === app &&
+    only.runsAs.length === 1 &&
+    only.runsAs[0]?.kind === "app" &&
+    only.tools.kind === "selected" &&
+    only.tools.names.length > 0 &&
+    only.tools.names.every((name) => syncTools.has(name))
+  );
+};
+
+/**
+ * The member's devices syncing this app's vault, oldest first: grants held through a connection
+ * Connect Obsidian made for it. Other grants, and connections for other apps or wider access,
+ * are not this vault's devices.
+ */
+export function obsidianDevices(
+  app: AppId,
+  connections: readonly Connection[],
+  agents: readonly ConnectedAgent[],
+): ObsidianDevice[] {
+  const vault = new Set(
+    connections
+      .filter((connection) => isVaultConnection(app, connection))
+      .map((connection) => connection.id),
+  );
+  const devices = agents
+    .flatMap((agent) =>
+      agent.access.kind === "connection" && vault.has(agent.access.connection)
+        ? [{ agent, connection: agent.access.connection }]
+        : [],
+    )
+    .sort((a, b) => a.agent.connectedAt.localeCompare(b.agent.connectedAt));
+  const generic = (name: string | null) => name === null || pluginClientNames.has(name.trim());
+  const shared = devices.filter(({ agent }) => generic(agent.name)).length;
+  let index = 0;
+  return devices.map(({ agent, connection }) => ({
+    agent: agent.id,
+    connection,
+    // Until devices report their own names, number them in the order they connected.
+    label: generic(agent.name)
+      ? shared > 1
+        ? `Obsidian device ${++index}`
+        : "Obsidian device"
+      : agent.name!.trim(),
+    connectedAt: agent.connectedAt,
+    lastActiveAt: agent.lastActiveAt,
+  }));
+}
+
+/** The header offers another device once one syncs this vault. */
+export const connectLabel = (devices: readonly ObsidianDevice[]) =>
+  devices.length > 0 ? "Connect another device" : "Connect Obsidian";
+
+/** What the vault's drive records from ordinary sync calls: each caller's last sync and head. */
+export const VaultSync = Schema.Struct({
+  head: Schema.NullOr(Schema.String),
+  devices: Schema.Array(
+    Schema.Struct({ agent: Schema.String, lastSyncAt: Schema.String, lastHead: Schema.String }),
+  ),
+});
+export type VaultSync = typeof VaultSync.Type;
+
+export interface DeviceSync {
+  readonly at: string;
+  /** The device holds the vault's current head. */
+  readonly current: boolean;
+}
+
+/** A device's own sync record, matched by grant; null when it hasn't synced since recording began. */
+export const deviceSync = (sync: VaultSync, device: ObsidianDevice): DeviceSync | null => {
+  const entry = sync.devices.find((item) => item.agent === device.agent);
+  return entry === undefined
+    ? null
+    : { at: entry.lastSyncAt, current: sync.head !== null && entry.lastHead === sync.head };
+};
+
+/** The app tool that reports the drive's sync records. */
+export const syncTool = "devices";
+export const hasSyncTool = (tools: readonly { readonly name: string }[]) =>
+  tools.some((tool) => tool.name === syncTool);
