@@ -0,0 +1,40 @@
+import { Effect, Option, Schema } from "effect";
+import { Atom } from "effect/reactivity";
+import { ToolName, type AppId, type VersionId } from "@executor-js/sdk";
+import type { OrganizationReference } from "@executor-js/hosted-server/organization";
+import { browserOnly } from "@executor-js/ui/contracts/http";
+import { HostedClient } from "./api.ts";
+import { syncTool, VaultSync } from "./obsidian-devices.ts";
+
+const decode = Schema.decodeUnknownOption(VaultSync);
+interface Key {
+  readonly organization: OrganizationReference;
+  readonly app: AppId;
+  readonly version?: VersionId | undefined;
+}
+
+/**
+ * The app's sync records, read by running its `devices` query as the signed-in person.
+ * Undefined while unread, and when the read fails or answers another shape: devices then show
+ * without sync times.
+ */
+const vaultSync = Atom.family((key: string) => {
+  const { organization, app, version } = JSON.parse(key) as Key;
+  return browserOnly(
+    HostedClient.runtime.atom(
+      Effect.flatMap(HostedClient, (client) =>
+        client.tools.run({
+          params: { organization, app },
+          payload: { tool: ToolName.make(syncTool), kind: "query", input: {}, version },
+        }),
+      ).pipe(
+        Effect.map((run) =>
+          run.status === "completed" ? Option.getOrUndefined(decode(run.value)) : undefined,
+        ),
+        Effect.catch(() => Effect.succeed(undefined)),
+      ),
+    ),
+  );
+});
+// String keys, so the family reuses one read per app version.
+export const vaultSyncAtom = (key: Key) => vaultSync(JSON.stringify(key));
