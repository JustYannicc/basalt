diff --git a/e2e/support/data-query-batch.ts b/e2e/support/data-query-batch.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/data-query-batch.ts
@@ -0,0 +1,165 @@
+/** Delivered SQL for one public data request, without application implementation imports. */
+import { expect } from "@effect/vitest";
+import { Effect, Layer, Schedule } from "effect";
+import { randomUUID } from "node:crypto";
+import { Actors, provisionSelfHostActors } from "./actors.ts";
+import { Api, SessionClients, type Session } from "./api.ts";
+import { SpanQuery } from "./contracts.ts";
+import { Evidence, Telemetry } from "./evidence.ts";
+import { startControlledSelfHost } from "./managed-server.ts";
+import { Target } from "./platform.ts";
+import { throttlingCollector } from "./throttling-collector.ts";
+
+type QueryTrace = (traceId: string) => Effect.Effect<typeof SpanQuery.Type>;
+
+/** Self-host exports real SQL to its own collector; managed Cloud already exports to Telemetry. */
+export const withDataQueryTelemetry = <A, E, R>(
+  run: (query: QueryTrace) => Effect.Effect<A, E, R>,
+) =>
+  Effect.gen(function* () {
+    const target = yield* Target;
+    if (target.metadata.target !== "self-host") {
+      const telemetry = yield* Telemetry;
+      return yield* run((traceId) => telemetry.query(traceId).pipe(Effect.orDie));
+    }
+    const collector = yield* throttlingCollector;
+    const isolated = yield* startControlledSelfHost(target, {
+      OTEL_EXPORTER_OTLP_TRACES_ENDPOINT: `${collector.endpoint}/v1/traces`,
+    });
+    const runtime = Layer.fresh(SessionClients.layer).pipe(
+      Layer.provideMerge(Layer.succeed(Target, isolated)),
+    );
+    const services = yield* Layer.build(Layer.fresh(Api.layer.pipe(Layer.provideMerge(runtime))));
+    const actors = yield* provisionSelfHostActors.pipe(Effect.provideContext(services));
+    return yield* run((traceId) => collector.query(traceId).pipe(Effect.orDie)).pipe(
+      Effect.provideService(Actors, actors),
+      Effect.provideContext(services),
+    );
+  });
+
+/** Capture the exact request's trace even when sibling requests finish in another order. */
+export const tracedDataQuery = (
+  actor: Session,
+  path: string,
+  payload: { readonly name: string; readonly input: unknown; readonly version?: string },
+) =>
+  Effect.gen(function* () {
+    const api = yield* Api,
+      evidence = yield* Evidence;
+    const traceId = randomUUID().replaceAll("-", "");
+    const response = yield* api.request(actor, "POST", `${path}/data/query`, payload, {
+      traceparent: `00-${traceId}-${randomUUID().replaceAll("-", "").slice(0, 16)}-01`,
+    });
+    const request = (yield* evidence.requests).find((entry) => entry.traceId === traceId);
+    if (request === undefined) return yield* Effect.die("Data request evidence is missing");
+    return { response, request };
+  });
+
+/** Assert the batch only after the completed request and SDK span have actually been delivered. */
+export const assertDataQueryBatch = (
+  query: QueryTrace,
+  made: Effect.Success<ReturnType<typeof tracedDataQuery>>,
+  label: string,
+) =>
+  Effect.gen(function* () {
+    const evidence = yield* Evidence;
+    const delivered = yield* query(made.request.traceId).pipe(
+      Effect.tap((trace) =>
+        evidence.json(
+          `data-query-delivery-${label}.json`,
+          trace.data.map(({ span }) => ({
+            id: span.spanId,
+            parent: span.parentSpanId,
+            name: span.operationName,
+            path: span.tags["url.path"],
+          })),
+        ),
+      ),
+      Effect.flatMap((trace) => {
+        const complete = trace.data.some(
+          ({ span }) =>
+            span.operationName === "http.server POST" &&
+            (span.tags["url.path"] === made.request.path ||
+              span.tags["url.path"] === "/api/organizations/:organization/apps/:app/data/query"),
+        );
+        return complete && trace.data.some(({ span }) => span.operationName === "sdk.data.query")
+          ? Effect.succeed(trace)
+          : Effect.fail(
+              new Error("The completed data request trace has not reached the collector"),
+            );
+      }),
+      Effect.retry({ schedule: Schedule.spaced("100 millis"), times: 50 }),
+    );
+    const byId = new Map(delivered.data.map(({ span }) => [span.spanId, span]));
+    const ancestors = (parent: string | null) => {
+      const found: Array<{ readonly id: string; readonly name: string }> = [];
+      const visited = new Set<string>();
+      while (parent !== null && !visited.has(parent)) {
+        visited.add(parent);
+        const span = byId.get(parent);
+        if (span === undefined) throw new Error("Delivered SQL has an unknown parent");
+        found.push({ id: span.spanId, name: span.operationName });
+        parent = span.parentSpanId;
+      }
+      return found;
+    };
+    const sql = delivered.data.flatMap(({ span }) => {
+      if (span.operationName !== "sql.execute" && span.operationName !== "sql.pipeline") return [];
+      const under = ancestors(span.parentSpanId);
+      if (under.some(({ name }) => name.startsWith("runtime."))) return [];
+      return [
+        {
+          id: span.spanId,
+          operation: span.operationName,
+          tags: span.tags,
+          text: String(span.tags["db.query.text"] ?? "").replace(/\s+/g, " "),
+          under,
+          start: span.startTime,
+          durationMs: span.durationMs,
+        },
+      ];
+    });
+    const pipelines = sql.filter((span) => span.operation === "sql.pipeline");
+    yield* evidence.json(`data-query-${label}.json`, { request: made.request, sql, delivered });
+    // The unoptimized route emits zero pipelines. This is the required RED assertion.
+    expect(
+      pipelines,
+      "One batch for the SDK snapshot, selected accounts and authority",
+    ).toHaveLength(1);
+    const pipeline = pipelines[0];
+    if (pipeline === undefined) return yield* Effect.die("The data query batch is missing");
+    expect(Number(pipeline.tags["db.pipeline.leaves"])).toBe(3);
+    expect(Number(pipeline.tags["db.pipeline.statements"])).toBe(3);
+    // SQL spans open while leaves queue, before the pipeline span opens. They are siblings.
+    const reads = sql.filter((span) => span.operation === "sql.execute");
+    expect(
+      reads.filter(
+        ({ text }) =>
+          text.includes("executor_apps") &&
+          text.includes("executor_deployments") &&
+          text.includes('"deployment:build"'),
+      ),
+      "The batched snapshot reads the app and its active version once",
+    ).toHaveLength(1);
+    expect(
+      reads.filter(({ under }) => under.some(({ name }) => name === "FumaDB.SqlQuery.findMany")),
+      "The selection's account rows are read once",
+    ).toHaveLength(1);
+    expect(
+      reads.filter(
+        ({ text, under }) =>
+          text.includes('as "appLinks"') &&
+          text.includes("as access") &&
+          under.some(({ name }) => name === "sdk.accounts.recheck"),
+      ),
+      "The lifecycle recheck completes before data dispatch",
+    ).toHaveLength(1);
+    expect(
+      sql.filter(
+        (span) =>
+          span.operation === "sql.execute" &&
+          span.under.some(({ name }) => name === "sdk.data.query"),
+      ),
+      "The SDK consumes the prefetched reads instead of reading again",
+    ).toHaveLength(0);
+  });
diff --git a/e2e/tests/data-query-batch.spec.ts b/e2e/tests/data-query-batch.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/data-query-batch.spec.ts
@@ -0,0 +1,177 @@
+/** Public data queries batch independent reads and retain live, scope-specific account selection. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { linkAccount, linkedAccountIds, unlinkAccount } from "../support/app-accounts.ts";
+import { body } from "../support/api.ts";
+import { appLinksFixture } from "../support/app-links.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import {
+  assertDataQueryBatch,
+  tracedDataQuery,
+  withDataQueryTelemetry,
+} from "../support/data-query-batch.ts";
+import { scenarios } from "../test-plan.ts";
+
+const source = `import { defineApp, defineProvider, secrets, object, string, query, router, type QueryContext } from "apps";
+const service = defineProvider({ name: "Data query batch fixture", auth: {
+  key: secrets({ label: "Key", fields: object({ token: string() }) })
+} });
+const requirements = { app: { accounts: { team: service } }, user: { accounts: { personal: service } } };
+const read = query({ input: object({ request: string() }) }, async (ctx: QueryContext<typeof requirements>, input) => ({
+  request: input.request,
+  team: { id: ctx.app.accounts.team.id, token: ctx.app.accounts.team.fields.token },
+  personal: { id: ctx.user.accounts.personal.id, token: ctx.user.accounts.personal.fields.token },
+}));
+export default defineApp(requirements, async () => ({ tools: router({ read }) }));`;
+
+layer(HostedLive, { excludeTestServices: true })("Data query batch", (it) => {
+  it.effect(scenarios.dataQueryBatch.title, (context) =>
+    withHostedCase(
+      context,
+      withDataQueryTelemetry((query) =>
+        Effect.gen(function* () {
+          const { api, actors, prefix, path, connect } = yield* appLinksFixture([
+            { path: "index.ts", content: source },
+          ]);
+          // The member cannot read the owner's personal account directly; the app link authorizes its use.
+          const team = yield* connect(actors.owner, "app", "team", "synthetic-team");
+          const personal = yield* connect(actors.member, "user", "personal", "synthetic-personal");
+          expect(yield* linkedAccountIds(actors.owner, path, "app")).toEqual([team]);
+          expect(yield* linkedAccountIds(actors.member, path)).toEqual([personal]);
+          expect(
+            (yield* api.request(actors.member, "GET", `${prefix}/accounts/${team}`)).status,
+          ).not.toBe(200);
+          const made = yield* tracedDataQuery(actors.member, path, {
+            name: "read",
+            input: { request: "first" },
+          });
+          expect(made.response.status, JSON.stringify(made.response.body)).toBe(200);
+          expect(made.response.body).toEqual({
+            request: "first",
+            team: { id: team, token: "synthetic-team" },
+            personal: { id: personal, token: "synthetic-personal" },
+          });
+          yield* assertDataQueryBatch(query, made, "first");
+        }),
+      ),
+    ),
+  );
+  it.effect(scenarios.dataQueryBatchSelections.title, (context) =>
+    withHostedCase(
+      context,
+      withDataQueryTelemetry((query) =>
+        Effect.gen(function* () {
+          const { actors, path, connect } = yield* appLinksFixture([
+            { path: "index.ts", content: source },
+          ]);
+          const team = yield* connect(actors.owner, "app", "team", "synthetic-team");
+          const first = yield* connect(actors.member, "user", "personal", "synthetic-first");
+          const own = yield* connect(actors.owner, "user", "personal", "synthetic-owner");
+          const read = (actor: typeof actors.member, request: string) =>
+            tracedDataQuery(actor, path, { name: "read", input: { request } });
+          const expected = (request: string, id: string, token: string) => ({
+            request,
+            team: { id: team, token: "synthetic-team" },
+            personal: { id, token },
+          });
+          const before = yield* read(actors.member, "before");
+          expect(before.response.status).toBe(200);
+          expect(before.response.body).toEqual(expected("before", first, "synthetic-first"));
+          const replacement = yield* connect(
+            actors.member,
+            "user",
+            "personal",
+            "synthetic-replacement",
+          );
+          expect(yield* linkedAccountIds(actors.member, path)).toEqual([replacement]);
+          const after = yield* read(actors.member, "replaced");
+          expect(after.response.status).toBe(200);
+          expect(after.response.body).toEqual(
+            expected("replaced", replacement, "synthetic-replacement"),
+          );
+          yield* unlinkAccount(actors.member, path, "personal", replacement);
+          expect(yield* linkedAccountIds(actors.member, path)).toEqual([]);
+          const unlinked = yield* read(actors.member, "unlinked");
+          // Hosted AppDataErrors currently maps its SDK error union to500.
+          expect(unlinked.response.status, JSON.stringify(unlinked.response.body)).toBe(500);
+          expect(unlinked.response.body).toMatchObject({
+            _tag: "AccountRequired",
+            slot: "personal",
+            scope: "user",
+          });
+          yield* linkAccount(actors.member, path, "personal", first);
+          expect(yield* linkedAccountIds(actors.member, path)).toEqual([first]);
+          const [member, owner] = yield* Effect.all(
+            [read(actors.member, "member-concurrent"), read(actors.owner, "owner-concurrent")],
+            { concurrency: 2 },
+          );
+          expect(member.response.status).toBe(200);
+          expect(member.response.body).toEqual(
+            expected("member-concurrent", first, "synthetic-first"),
+          );
+          expect(owner.response.status).toBe(200);
+          expect(owner.response.body).toEqual(expected("owner-concurrent", own, "synthetic-owner"));
+          // The result checks run before collector waits, so one missing trace cannot hide a wrong selection.
+          yield* Effect.all(
+            [
+              assertDataQueryBatch(query, after, "replacement"),
+              assertDataQueryBatch(query, member, "member-concurrent"),
+              assertDataQueryBatch(query, owner, "owner-concurrent"),
+            ],
+            { concurrency: 3, discard: true },
+          );
+        }),
+      ),
+    ),
+  );
+
+  it.effect(scenarios.dataQueryBatchRefusals.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const { api, actors, path, connect } = yield* appLinksFixture([
+          { path: "index.ts", content: source },
+        ]);
+        const team = yield* connect(actors.owner, "app", "team", "synthetic-team");
+        const personal = yield* connect(actors.member, "user", "personal", "synthetic-personal");
+        const current = yield* tracedDataQuery(actors.member, path, {
+          name: "read",
+          input: { request: "allowed" },
+        });
+        expect(current.response.status).toBe(200);
+        expect(current.response.body).toEqual({
+          request: "allowed",
+          team: { id: team, token: "synthetic-team" },
+          personal: { id: personal, token: "synthetic-personal" },
+        });
+        // A missing version is refused by data/query. Retained historical versions remain legal pins.
+        const stale = yield* tracedDataQuery(actors.member, path, {
+          version: "dpl_stale",
+          name: "read",
+          input: { request: "missing-version" },
+        });
+        // Preserve the current hosted union's wire status while requiring its typed refusal.
+        expect(stale.response.status, JSON.stringify(stale.response.body)).toBe(500);
+        expect(stale.response.body).toMatchObject({
+          _tag: "VersionNotFound",
+          version: "dpl_stale",
+        });
+        const access = yield* body(
+          Schema.Struct({ revision: Schema.String }),
+          yield* api.request(actors.owner, "GET", `${path}/access`),
+        );
+        const revoked = yield* api.request(actors.owner, "PATCH", `${path}/access`, {
+          revision: access.revision,
+          audience: { kind: "private" },
+        });
+        expect(revoked.status, JSON.stringify(revoked.body)).toBe(200);
+        const refused = yield* tracedDataQuery(actors.member, path, {
+          name: "read",
+          input: { request: "revoked" },
+        });
+        expect(refused.response.status).toBe(403);
+        expect(refused.response.body).toMatchObject({ _tag: "OrganizationForbidden" });
+      }),
+    ),
+  );
+});
