@@ -0,0 +1,25 @@
+/** Forward the original auth request so cookies, origins and SAML form bodies retain their meaning. */
+import * as Cloudflare from "alchemy/Cloudflare";
+import { Effect } from "effect";
+import { HttpServerRequest, HttpServerResponse } from "effect/http";
+import { Sso } from "./sso-worker.ts";
+
+interface ServiceBinding {
+  readonly fetch: (request: Request) => Promise<Response>;
+}
+
+export const cloudSsoHandler = Effect.gen(function* () {
+  yield* Cloudflare.Workers.bindWorker(Sso);
+  return Effect.gen(function* () {
+    const request = yield* HttpServerRequest.HttpServerRequest;
+    const environment = yield* Cloudflare.WorkerEnvironment;
+    // SAFETY: bindWorker(Sso) above registers the fetch binding in this Worker's environment.
+    const binding = (environment as unknown as Record<string, ServiceBinding | undefined>)[
+      Sso.LogicalId
+    ];
+    if (binding === undefined)
+      return yield* Effect.die(new Error("The API has no SSO Worker binding"));
+    const web = yield* HttpServerRequest.toWeb(request).pipe(Effect.orDie);
+    return HttpServerResponse.fromWeb(yield* Effect.promise(() => binding.fetch(web)));
+  });
+});
