+import { CurrentProductBrand, productBrandConfig } from "@executor-js/utils/product-brand";
+import { cloudSso } from "./implementation/sso.ts";
+import { reportCloudFailure, cloudSentry } from "./implementation/error-reporting.ts";
+import { cloudAuth } from "./infrastructure/auth.ts";
+import { cloudAuthDatabase } from "./infrastructure/auth-database.ts";
+import { billingBindings } from "./infrastructure/billing.ts";
+import { cloudEmail } from "./infrastructure/email.ts";
+import { postHogBindings } from "./infrastructure/posthog.ts";
+import { sentryBindings } from "./infrastructure/sentry.ts";
+import { productBrandBindings } from "./infrastructure/product-brand.ts";
+import { authRateLimitSwitchBindings } from "./infrastructure/stage.ts";
+import { Sso, ssoAuthPath } from "./infrastructure/sso-worker.ts";
+import {
+  cloudObservability,
+  cloudTelemetry,
+  telemetryBindings,
+} from "./infrastructure/telemetry.ts";
+import { workerBuild } from "./infrastructure/worker-build.ts";
+
+export default Sso.make(
+  Effect.gen(function* () {
+    if (globalThis.__ALCHEMY_RUNTIME__) return { main: import.meta.url };
+    return {
+      main: import.meta.url,
+      ...(yield* cloudObservability),
+      workersDev: false,
+      build: workerBuild("sso"),
+      // A service binding runs beside the placed API Worker; it needs no independent placement.
+      compatibility: {
+        date: "2026-09-08",
+        flags: ["nodejs_compat", "global_fetch_strictly_public", "enable_request_signal"],
+      },
+      env: {
+        ...(yield* telemetryBindings),
+        ...(yield* postHogBindings).env,
+        ...(yield* sentryBindings).env,
+        ...(yield* billingBindings),
+        ...(yield* authRateLimitSwitchBindings),
+        ...(yield* productBrandBindings),
+      },
+    };
+  }),
+  Effect.gen(function* () {
+    const email = yield* cloudEmail.pipe(Effect.orDie);
+    // This private service serves only SSO paths; organization creation stays in the API.
+    const auth = yield* cloudAuth(email.send, undefined, cloudSso);
+    const reportErrors = yield* cloudSentry;
+    return {
+      fetch: Effect.gen(function* () {
+        const request = yield* HttpServerRequest.HttpServerRequest;
+        if (!ssoAuthPath(new URL(request.originalUrl).pathname))
+          return HttpServerResponse.empty({ status: 404 });
+        return yield* auth.handler;
+      }).pipe(
+        Effect.tapCause(reportCloudFailure),
+        recordRequestRejections,
+        reportErrors,
+        requestTiming,
+      ),
+    };
+  }).pipe(
+    Effect.provideServiceEffect(CurrentProductBrand, productBrandConfig.pipe(Effect.orDie)),
+    Effect.provide(Layer.mergeAll(cloudAuthDatabase, cloudTelemetry)),
+  ),
+);
