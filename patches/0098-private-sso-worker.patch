index 0000000..944c8ec
--- /dev/null
+++ b/apps/hosted/cloud/src/infrastructure/auth-core.ts
@@ -0,0 +1,288 @@
+import { poolAccessLifecycle } from "@executor-js/hosted-server/pool-access-hook";
+import { authObservability } from "../implementation/auth-observability.ts";
+import { withOrganizationAccessRequest } from "../implementation/organization-access-request.ts";
+import { AsyncLocalStorage } from "node:async_hooks";
+import { APIError } from "better-auth/api";
+import { BillingMeter } from "../contracts/billing-meter.ts";
+import { billingLive } from "../implementation/billing.ts";
+import {
+  clearSiteVisitorOnSignOut,
+  recordCloudSignup,
+  recordCloudLogin,
+} from "../implementation/product-analytics.ts";
+import {
+  cloudAuthOptions,
+  cloudAuthSettings,
+  type CloudSsoPlugin,
+} from "../implementation/auth-options.ts";
+import type { Onboarding } from "../contracts/onboarding.ts";
+import {
+  CurrentUsage,
+  CurrentUserId,
+  recordUsage,
+  authEndpointTemplates,
+  OrganizationId,
+  recordCredential,
+  recordSecurityAudit,
+} from "@executor-js/hosted-server";
+import { routeTemplates } from "@executor-js/telemetry";
+import { betterAuth } from "better-auth/minimal";
+import { cloudSessionCookiePrefix } from "../contracts/browser.ts";
+import { RuntimeContext } from "alchemy";
+import * as Cloudflare from "alchemy/Cloudflare";
+import { Config, Context, Effect, Redacted, Schema, type Scope } from "effect";
+import { SqlClient } from "effect/sql";
+import { HttpBody, HttpServerRequest, HttpServerResponse } from "effect/http";
+import type { SendAuthEmail } from "../contracts/email.ts";
+import { cloudSecrets } from "./secrets.ts";
+import { recordAuthRefusal } from "../implementation/auth-refusals.ts";
+import { cloudAuthRateLimit } from "./stage.ts";
+import { AuthDatabase } from "./auth-database.ts";
+import { invocationSql } from "./invocation-database.ts";
+import { authAudit } from "../implementation/auth-audit.ts";
+
+/** Resolve the settings shared by both auth Workers once per Worker initialization. */
+export const cloudAuthInitialization = Effect.gen(function* () {
+  // Only `alchemy dev` binds the switch; see `authRateLimitSwitchBindings`.
+  const environment = yield* Cloudflare.WorkerEnvironment;
+  const settings = {
+    ...(yield* cloudAuthSettings.pipe(Effect.orDie)),
+    rateLimitEnabled: yield* cloudAuthRateLimit(environment.AUTH_RATE_LIMIT_SWITCH === true).pipe(
+      Effect.orDie,
+    ),
+  };
+  const secrets = yield* cloudSecrets.pipe(Effect.orDie);
+  return { settings, secrets };
+});
+
+/** Shared Better Auth request path. Keep its options and request-scoped hooks identical for both Workers. */
+export const cloudAuthCore = (
+  initialization: Effect.Success<typeof cloudAuthInitialization>,
+  send: SendAuthEmail,
+  onboarding: Pick<typeof Onboarding.Service, "allowsOrganization"> | undefined,
+  sso?: CloudSsoPlugin,
+) =>
+  Effect.gen(function* () {
+    const { settings, secrets } = initialization;
+    const meter = yield* BillingMeter.pipe(Effect.provide(yield* billingLive));
+    // Better Auth invokes Promise callbacks. Carry the calling request's scope,
+    // bindings and cancellation through that boundary, isolated per invocation.
+    const callbacks = new AsyncLocalStorage<{
+      readonly context: Context.Context<
+        RuntimeContext | HttpServerRequest.HttpServerRequest | Scope.Scope
+      >;
+      readonly signal: AbortSignal;
+    }>();
+    const runCallback = <A, E>(
+      effect: Effect.Effect<A, E, HttpServerRequest.HttpServerRequest>,
+    ) => {
+      const current = callbacks.getStore();
+      if (current === undefined)
+        return Promise.reject(
+          new APIError("SERVICE_UNAVAILABLE", {
+            message: "Auth callbacks are unavailable outside an auth request.",
+          }),
+        );
+      return Effect.runPromise(effect.pipe(Effect.provideContext(current.context)), {
+        signal: current.signal,
+      });
+    };
+    const withSql = yield* invocationSql;
+    const access = poolAccessLifecycle(
+      yield* Config.Redacted("POOL_APP_SIGNING_KEY").pipe(Config.option),
+      settings.url,
+    );
+    const observation = authObservability();
+    const options = cloudAuthOptions(
+      settings,
+      ["cf-connecting-ip"],
+      send,
+      {
+        memberLimit: (id) =>
+          runCallback(
+            Schema.decodeUnknownEffect(OrganizationId)(id).pipe(
+              Effect.flatMap(meter.memberLimit),
+              Effect.mapError(
+                () =>
+                  new APIError("SERVICE_UNAVAILABLE", {
+                    message: "We could not check your member allowance. Try again.",
+                  }),
+              ),
+              Effect.scoped,
+            ),
+          ),
+      },
+      (userId) => runCallback(recordCloudSignup(userId, settings.url)),
+      (userId) => {
+        observation.sessionCreated();
+        return runCallback(recordCloudLogin(userId));
+      },
+      (usage) =>
+        runCallback(
+          Effect.gen(function* () {
+            yield* recordUsage("product_operation_completed", {
+              area: "auth",
+              operation: usage.operation,
+              status_code: usage.status,
+              ok: usage.status < 400,
+              outcome: usage.status < 400 ? "success" : "failure",
+            });
+            if (usage.status >= 400) return;
+            if (usage.operation === "organization.invite-member")
+              yield* recordUsage("invitation_sent");
+            else if (usage.operation === "organization.accept-invitation")
+              yield* recordUsage("invitation_accepted");
+          }).pipe(
+            Effect.provideService(CurrentUserId, usage.userId),
+            Effect.provideService(CurrentUsage, { source: "dashboard" }),
+          ),
+        ),
+      // Fails closed: an unanswered v1 check refuses the create instead of allowing it.
+      onboarding === undefined
+        ? undefined
+        : (userId) =>
+            runCallback(
+              onboarding.allowsOrganization(userId).pipe(
+                Effect.mapError(
+                  () =>
+                    new APIError("SERVICE_UNAVAILABLE", {
+                      message: "We could not check your account. Try again.",
+                    }),
+                ),
+              ),
+            ),
+      {
+        onRefreshRejected: observation.refreshRejected,
+        // A person approved a new agent, by consent or by a device's code: the agent can connect.
+        onGrantCreated: (grant) =>
+          runCallback(
+            recordUsage("agent_connected", { grant_kind: grant.kind }).pipe(
+              Effect.provideService(CurrentUserId, grant.userId),
+              Effect.provideService(CurrentUsage, {
+                source: "dashboard",
+                client_id: grant.clientId,
+              }),
+            ),
+          ),
+      },
+      {
+        memberRemoving: (organization, member) =>
+          runCallback(withSql(access.memberRemoving?.({ organization, member }) ?? Effect.void)),
+        memberRoleChanging: (organization, member, role) =>
+          runCallback(
+            withSql(access.memberRoleChanging?.({ organization, member, role }) ?? Effect.void),
+          ),
+        membersAdded: (organization) =>
+          runCallback(
+            withSql(
+              (access.appAccessChanged?.({ organization }) ?? Effect.void).pipe(
+                Effect.catch(() =>
+                  Effect.logWarning("Pool member provisioning failed; key minting will retry."),
+                ),
+              ),
+            ),
+          ),
+        userDeleting: (user) => runCallback(withSql(access.userDeleting?.(user) ?? Effect.void)),
+      },
+      sso,
+    );
+    const database = yield* AuthDatabase;
+    const makeInstance = (secret: string) =>
+      betterAuth({
+        ...options,
+        // After the analytics plugin: Better Auth's endpoint middleware does not leave its
+        // session on the after-hook context, and the analytics hook's read of it does. The audit
+        // reads no session itself. Telemetry never fails a request, so a record that cannot be
+        // written is dropped.
+        plugins: [
+          ...options.plugins,
+          authAudit((event, session) =>
+            runCallback(
+              Effect.andThen(
+                session === undefined
+                  ? Effect.void
+                  : recordCredential({ kind: "session", ...session }),
+                recordSecurityAudit(event),
+              ),
+            ).catch(() => undefined),
+          ),
+          observation.plugin,
+        ],
+        database: database.options,
+        secret,
+        // Cookies use hostnames, not ports; cloud dev must not replace self-host sessions.
+        advanced: {
+          ...options.advanced,
+          cookiePrefix: cloudSessionCookiePrefix(settings.url),
