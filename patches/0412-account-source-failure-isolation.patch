+/** One controlled MCP peer and a REST document, served through their real protocol adapters. */
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Effect, Layer } from "effect";
+import { HttpRouter, HttpServer, HttpServerResponse } from "effect/http";
+import { createServer } from "node:http";
+
+export const accountSourcePeer = (mcpStatus: 403 | 503, restFailed: boolean) =>
+  Effect.gen(function* () {
+    let origin = "";
+    const routes = Layer.mergeAll(
+      HttpRouter.add(
+        "*",
+        "/mcp",
+        HttpServerResponse.empty({
+          status: mcpStatus,
+          headers:
+            mcpStatus === 403 ? { "www-authenticate": 'Bearer error="insufficient_scope"' } : {},
+        }),
+      ),
+      HttpRouter.add(
+        "GET",
+        "/openapi.json",
+        Effect.sync(() =>
+          restFailed
+            ? HttpServerResponse.empty({ status: 503 })
+            : HttpServerResponse.jsonUnsafe({
+                openapi: "3.0.3",
+                info: { title: "Healthy REST", version: "1" },
+                servers: [{ url: origin }],
+                paths: {
+                  "/read": {
+                    get: {
+                      operationId: "read",
+                      responses: {
+                        "200": {
+                          description: "OK",
+                          content: { "application/json": { schema: { type: "object" } } },
+                        },
+                      },
+                    },
+                  },
+                },
+              }),
+        ),
+      ),
+      HttpRouter.add("GET", "/read", HttpServerResponse.jsonUnsafe({ read: "REST OK" })),
+    );
+    const listener = createServer();
+    const services = yield* Layer.build(
+      HttpRouter.serve(routes, { disableLogger: true, disableListenLog: true }).pipe(
+        Layer.provideMerge(NodeHttpServer.layer(() => listener, { host: "127.0.0.1", port: 0 })),
+      ),
+    );
+    yield* Effect.addFinalizer(() => Effect.sync(() => listener.closeAllConnections()));
+    const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+    if (!("port" in server.address)) return yield* Effect.die("Peer needs a TCP listener");
+    origin = `http://127.0.0.1:${server.address.port}`;
+    return origin;
+  });
+
+export const accountSourceApp = (
+  origin: string,
+) => `import { accountRouter, defineApp, defineProvider, object, renameTools, secrets, string, withApprovals } from "apps";
+import { mcpRouter } from "apps/mcp";
+import { liveOpenapiRouter } from "apps/openapi";
+const service = defineProvider({ name: "Mixed source service", hosts: [${JSON.stringify(new URL(origin).host)}], auth: {
+  mcp: secrets({ label: "MCP token", fields: object({ token: string() }) }),
+  api: secrets({ label: "REST token", fields: object({ token: string() }) })
+} });
+export default defineApp({ user: { accounts: { service: service.many() } } }, async ({ user, cache, fetch, signal }) => ({
+  tools: withApprovals(renameTools(await accountRouter(user?.accounts.service ?? [], account => account.method === "mcp"
+    ? mcpRouter({ url: ${JSON.stringify(origin + "/mcp")}, account, headers: { Authorization: "Bearer " + account.fields.token }, cache, signal })
+    : liveOpenapiRouter({ source: { url: ${JSON.stringify(origin + "/openapi.json")} }, allowedOrigin: ${JSON.stringify(origin)}, baseUrl: ${JSON.stringify(origin)}, securitySchemes: { token: { type: "http", scheme: "bearer" } }, fallbackSecurity: [{ token: [] }], methods: { api: [{ scheme: "token", field: "token", part: "value", prefix: "" }] }, oauth: [], account, cache, fetch, signal }), { signal }), name => name), () => undefined)
+}));`;
