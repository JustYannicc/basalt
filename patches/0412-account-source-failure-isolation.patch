+++ b/e2e/tests/account-source-isolation.spec.ts
@@ -0,0 +1,182 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { accountSourceApp, accountSourcePeer } from "../support/account-source-peer.ts";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { connectionsPath } from "../support/app-accounts.ts";
+import { withApps, mcpSdkVersion } from "../support/apps-release.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { Evidence } from "../support/evidence.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Tools = Schema.Struct({
+  items: Schema.Array(Schema.Struct({ name: Schema.String })),
+  routers: Schema.Array(
+    Schema.Struct({
+      path: Schema.String,
+      description: Schema.optional(Schema.String),
+      error: Schema.optional(
+        Schema.Struct({
+          _tag: Schema.String,
+          accountId: Schema.optional(Schema.String),
+          status: Schema.optional(Schema.Number),
+          errorName: Schema.optional(Schema.String),
+          code: Schema.optional(Schema.String),
+        }),
+      ),
+    }),
+  ),
+});
+
+layer(HostedLive, { excludeTestServices: true })("Account source failure isolation", (it) => {
+  for (const [scenario, status, allFail, single] of [
+    [scenarios.accountSource403, 403, false, false],
+    [scenarios.accountSource503, 503, false, false],
+    [scenarios.accountSourceAllFail, 403, true, false],
+    [scenarios.accountSourceSingle, 403, false, true],
+  ] as const)
+    it.effect(scenario.title, (context) =>
+      withHostedCase(
+        context,
+        Effect.gen(function* () {
+          const api = yield* Api,
+            actors = yield* Actors,
+            evidence = yield* Evidence;
+          const origin = yield* accountSourcePeer(status, allFail);
+          const prefix = `/api/organizations/${actors.organization.id}`;
+          const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+            name: "Mixed account sources",
+            files: [
+              { path: "index.ts", content: accountSourceApp(origin) },
+              {
+                path: "package.json",
+                content: JSON.stringify({
+                  dependencies: withApps({ "@modelcontextprotocol/sdk": mcpSdkVersion }),
+                }),
+              },
+            ],
+          });
+          expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+          const app = yield* body(Resource, deployed),
+            path = `${prefix}/apps/${app.id}`,
+            accounts: string[] = [];
+          yield* Effect.addFinalizer(() =>
+            Effect.gen(function* () {
+              expect((yield* api.request(actors.owner, "DELETE", path)).status).toBe(200);
+              for (const account of accounts)
+                expect(
+                  (yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`))
+                    .status,
+                ).toBe(200);
+            }).pipe(Effect.orDie),
+          );
+          const connect = (method: "mcp" | "api") =>
+            Effect.gen(function* () {
+              const connection = yield* body(
+                Resource,
+                yield* api.request(
+                  actors.owner,
+                  "POST",
+                  connectionsPath(path, "user", "service"),
+                  {},
+                ),
+              );
+              const completed = yield* api.request(
+                actors.owner,
+                "POST",
+                `${prefix}/connections/${connection.id}/submit`,
+                { method, fields: { token: `synthetic-${method}-source` } },
+              );
+              expect(completed.status, JSON.stringify(completed.body)).toBe(200);
+              const account = (yield* body(Resource, completed)).id;
+              accounts.push(account);
+              return account;
+            });
+          const mcp = yield* connect("mcp");
+          const call = (tool: string, accountId: string) =>
+            api.request(actors.owner, "POST", `${path}/tools/call`, {
+              tool,
+              kind: "query",
+              input: { accountId, input: {} },
+            });
+          if (single) {
+            const failed = yield* call("remote_read", mcp);
+            expect(failed.status, JSON.stringify(failed.body)).toBe(502);
+            expect(failed.body).toMatchObject({
+              _tag: "AppProviderFailed",
+              status: 403,
+              account: { id: mcp },
+            });
+            expect((yield* api.request(actors.owner, "GET", `${path}/tools/index`)).status).toBe(
+              502,
+            );
+            expect(
+              (yield* api.request(actors.owner, "DELETE", `${path}/accounts/user/service/${mcp}`))
+                .status,
+            ).toBe(200);
+            const rest = yield* connect("api"),
+              read = yield* call("read.getRead", rest);
+            expect(read.status, JSON.stringify(read.body)).toBe(200);
+            expect(read.body).toEqual({ read: "REST OK" });
+            const index = yield* body(
+              Tools,
+              yield* api.request(actors.owner, "GET", `${path}/tools/index`),
+            );
+            expect(index.items.map((tool) => tool.name)).toEqual(["read.getRead"]);
+            expect(index.routers.filter((router) => router.error !== undefined)).toEqual([]);
+            return;
+          }
+          const rest = yield* connect("api");
+          const read = yield* call("read.getRead", rest);
+          if (allFail) {
+            yield* evidence.json("all-sources-failed-call.json", read.body);
+            expect(read.status).toBe(502);
+            expect(read.body).toMatchObject({
+              _tag: "AppEvaluationFailed",
+              failure: { errorName: "OpenapiError", code: "invalid_definition" },
+            });
+            expect(JSON.stringify(read.body)).not.toContain("synthetic-");
+          } else {
+            expect(read.status, JSON.stringify(read.body)).toBe(200);
+            expect(read.body).toEqual({ read: "REST OK" });
+          }
+          const failed = yield* call("remote_read", mcp);
+          expect(failed.status, JSON.stringify(failed.body)).toBe(502);
+          expect(failed.body).toMatchObject({
+            _tag: "AppProviderFailed",
+            status,
+            account: { id: mcp },
+          });
+          const listed = yield* api.request(actors.owner, "GET", `${path}/tools/index`);
+          expect(listed.status, JSON.stringify(listed.body)).toBe(200);
+          const index = yield* body(Tools, listed),
+            errors = index.routers.flatMap((router) =>
+              router.error === undefined ? [] : [router.error],
+            );
+          expect(index.items.map((tool) => tool.name)).toEqual(allFail ? [] : ["read.getRead"]);
+          expect(errors).toHaveLength(allFail ? 2 : 1);
+          expect(errors).toContainEqual(expect.objectContaining({ accountId: mcp, status }));
+          if (allFail)
+            expect(index.routers).toContainEqual(
+              expect.objectContaining({
+                description: `Account ${rest}`,
+                error: expect.objectContaining({
+                  _tag: "HostEvaluationFailed",
+                  errorName: "OpenapiError",
+                  code: "invalid_definition",
+                }),
+              }),
+            );
+          expect(JSON.stringify(errors)).not.toContain("synthetic-");
+          yield* evidence.json("source-isolation.json", {
+            status,
+            allFail,
+            healthyRead: read.status,
+            failedRead: failed.body,
+            errors,
+          });
+        }),
+      ),
+    );
+});
