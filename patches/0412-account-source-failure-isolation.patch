--- /dev/null
+++ b/packages/apps/src/implementation/account-router-dynamic.ts
@@ -0,0 +1,141 @@
+import { Cause, Effect, Option, Result, Schema } from "effect";
+import type { HostedTool, HostedToolSummary } from "../contracts/host.ts";
+import type { AppOperation } from "../contracts/operations.ts";
+import type { DynamicRouter } from "../contracts/router.ts";
+import { accountMcpApps } from "./account-router-mcp-apps.ts";
+import { combineOperation, merge, mergeSummary } from "./account-router-operations.ts";
+import { accountProviderError } from "./provider-error.ts";
+import { mergeMeta } from "./router.ts";
+
+type SourceFailure = { readonly accountId: string; readonly error: unknown };
+
+/** An account's failure is data for discovery; cancellation still cancels the whole request. */
+const readSources = <A>(
+  sources: ReadonlyMap<string, DynamicRouter>,
+  read: (source: DynamicRouter) => Effect.Effect<A, unknown>,
+) =>
+  Effect.gen(function* () {
+    const values = new Map<string, A>();
+    const failures: SourceFailure[] = [];
+    for (const [accountId, source] of sources) {
+      const result = yield* Effect.suspend(() => read(source)).pipe(
+        Effect.catchCause((cause) =>
+          Cause.hasInterrupts(cause)
+            ? Effect.interrupt
+            : Effect.fail(accountProviderError(Cause.squash(cause), accountId)),
+        ),
+        Effect.result,
+      );
+      if (Result.isSuccess(result)) values.set(accountId, result.success);
+      else if (sources.size === 1) return yield* Effect.fail(result.failure);
+      else failures.push({ accountId, error: result.failure });
+    }
+    return { values, failures };
+  });
+
+const grouped = <T extends HostedToolSummary>(values: ReadonlyMap<string, readonly T[]>) => {
+  const groups = new Map<string, [string, T][]>();
+  for (const [accountId, tools] of values)
+    for (const tool of tools) {
+      const variants = groups.get(tool.name) ?? [];
+      if (variants.some(([id]) => id === accountId)) throw new Error("Duplicate source operation");
+      variants.push([accountId, tool]);
+      groups.set(tool.name, variants);
+    }
+  return groups;
+};
+
+const selectedAccount = Schema.decodeUnknownOption(Schema.Struct({ accountId: Schema.String }));
+
+/** Merge healthy variants; source failures remain available to the host's catalog and call path. */
+export const combineDynamic = (sources: ReadonlyMap<string, DynamicRouter>): DynamicRouter => {
+  const first = [...sources.values()][0];
+  const summaries = (source: DynamicRouter) => (source.summaries ?? source.list)();
+  const readMeta = (source: DynamicRouter) =>
+    source.meta === undefined
+      ? Effect.succeed(source.overrides)
+      : source.meta().pipe(Effect.map((meta) => mergeMeta(meta, source.overrides)));
+  const list = <T extends HostedToolSummary>(
+    read: (source: DynamicRouter) => Effect.Effect<readonly T[], unknown>,
+    combine: (name: string, variants: readonly (readonly [string, T])[]) => T,
+  ) =>
+    readSources(sources, read).pipe(
+      Effect.flatMap(({ values, failures }) => {
+        if (values.size === 0 && failures[0] !== undefined) return Effect.fail(failures[0].error);
+        return Effect.sync(() =>
+          [...grouped(values)].map(([name, variants]) => combine(name, variants)),
+        );
+      }),
+    );
+  const catalog = <T extends HostedToolSummary>(
+    read: (source: DynamicRouter) => Effect.Effect<readonly T[], unknown>,
+    combine: (name: string, variants: readonly (readonly [string, T])[]) => T,
+  ) =>
+    Effect.gen(function* () {
+      const { values, failures } = yield* readSources(sources, (source) =>
+        Effect.all({ meta: readMeta(source), tools: read(source) }, { concurrency: "unbounded" }),
+      );
+      const groups = grouped(new Map([...values].map(([id, value]) => [id, value.tools])));
+      const tools = [...groups].map(([name, variants]) => combine(name, variants));
+      const meta = [...values.values()].find((value) => value.meta !== undefined)?.meta;
+      return { tools, failures, ...(meta === undefined ? {} : { meta }) };
+    });
+  return {
+    kind: "dynamic",
+    ...accountMcpApps(sources),
+    ...(first?.overrides === undefined ? {} : { overrides: first.overrides }),
+    meta: () =>
+      readSources(sources, readMeta).pipe(
+        Effect.flatMap(({ values, failures }) => {
+          if (values.size === 0 && failures[0] !== undefined) return Effect.fail(failures[0].error);
+          return Effect.succeed([...values.values()].find((meta) => meta !== undefined) ?? {});
+        }),
+      ),
+    ...(sources.size < 2
+      ? {}
+      : {
+          catalog: (options: { readonly summary: boolean; readonly names?: readonly string[] }) =>
+            options.summary
+              ? catalog(summaries, mergeSummary)
+              : catalog(
+                  (source) =>
+                    options.names !== undefined && source.describe !== undefined
+                      ? Effect.forEach(options.names, (name) => source.describe!(name)).pipe(
+                          Effect.map((tools) => tools.filter((tool) => tool !== undefined)),
+                        )
+                      : source.list(),
+                  merge,
+                ),
+        }),
+    list: () => list((source) => source.list(), merge),
+    summaries: () => list(summaries, mergeSummary),
+    describe: (name) =>
+      Effect.gen(function* () {
+        const { values, failures } = yield* readSources(sources, (source) =>
+          source.describe === undefined
+            ? source.list().pipe(Effect.map((tools) => tools.find((tool) => tool.name === name)))
+            : source.describe(name),
+        );
+        const variants: [string, HostedTool][] = [];
+        for (const [id, tool] of values) if (tool !== undefined) variants.push([id, tool]);
+        if (variants.length === 0 && failures[0] !== undefined)
+          return yield* Effect.fail(failures[0].error);
+        return variants.length === 0 ? undefined : merge(name, variants);
+      }),
+    resolve: (name, input) =>
+      Effect.gen(function* () {
+        const { values, failures } = yield* readSources(sources, (source) => source.resolve(name));
+        const selected = selectedAccount(input);
+        const failed = Option.isSome(selected)
+          ? failures.find(({ accountId }) => accountId === selected.value.accountId)
+          : undefined;
+        if (failed !== undefined) return yield* Effect.fail(failed.error);
+        const operations = new Map<string, AppOperation>();
+        for (const [id, operation] of values)
+          if (operation !== undefined) operations.set(id, operation);
+        if (operations.size === 0 && failures[0] !== undefined && Option.isNone(selected))
+          return yield* Effect.fail(failures[0].error);
+        return operations.size === 0 ? undefined : combineOperation(operations);
+      }),
+  };
+};
