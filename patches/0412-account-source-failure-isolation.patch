+import { Effect, Schema } from "effect";
+import type { AppRouter, DynamicRouter } from "../contracts/router.ts";
+import type { McpAppSource } from "../contracts/mcp-apps.ts";
+import { JsonValue } from "../contracts/schema.ts";
+import { locate } from "./router.ts";
+
+export const accountMcpApps = (
+  sources: ReadonlyMap<string, AppRouter | DynamicRouter>,
+): { readonly mcpApps?: McpAppSource } =>
+  [...sources.values()].some((source) => source.mcpApps !== undefined)
+    ? {
+        mcpApps: {
+          bind: (input, tool) =>
+            Effect.gen(function* () {
+              const selected = yield* Schema.decodeUnknownEffect(
+                Schema.Struct({
+                  accountId: Schema.String,
+                  input: JsonValue,
+                }),
+              )(input);
+              const node = sources.get(selected.accountId);
+              const source = node?.mcpApps;
+              if (source === undefined)
+                return yield* Effect.fail(new Error("App source unavailable"));
+              const bound = yield* source.bind(selected.input, tool);
+              const location = locate(node, tool);
+              const operation =
+                location?.kind === "operation"
+                  ? location.operation
+                  : location?.kind === "dynamic"
+                    ? yield* location.source.resolve(location.name, selected.input)
+                    : undefined;
+              return {
+                ...bound,
+                ...(bound.meta !== undefined || operation?._meta === undefined
+                  ? {}
+                  : { meta: operation._meta }),
+                selection: { accountId: selected.accountId, source: bound.selection },
+                callback: (name: string, input: JsonValue) => {
+                  return bound.callback(name, input).pipe(
+                    Effect.map((mapped) => ({
+                      name: mapped.name,
+                      input: { accountId: selected.accountId, input: mapped.input },
+                    })),
+                  );
+                },
+              };
+            }),
+        },
+      }
+    : {};
