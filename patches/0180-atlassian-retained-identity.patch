@@ -0,0 +1,87 @@
+import { Effect, Schema } from "effect";
+import { ProviderDefinition } from "@executor-js/sdk/core";
+import {
+  RetainedIdentityRefused,
+  type RetainedAccountSnapshot,
+} from "./retained-identity-records.ts";
+
+export const atlassianIssuer = "https://auth.atlassian.com";
+export const atlassianAuthorizationEndpoint = "https://auth.atlassian.com/authorize";
+export const atlassianTokenEndpoint = "https://auth.atlassian.com/oauth/token";
+export const atlassianProfileEndpoint = "https://api.atlassian.com/me";
+
+const Digest = Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/u));
+
+export const AtlassianProof = Schema.Struct({
+  account: Schema.NonEmptyString,
+  owner: Schema.NonEmptyString,
+  provider: Schema.NonEmptyString,
+  method: Schema.NonEmptyString,
+  generation: Schema.Int,
+  placement: Schema.NonEmptyString,
+  site: Schema.NullOr(Schema.String),
+  grantSha256: Digest,
+  credentialsSha256: Digest,
+  linksSha256: Digest,
+  issuer: Schema.Literal(atlassianIssuer),
+  subject: Schema.NonEmptyString,
+  label: Schema.NonEmptyString,
+  observedAt: Schema.String,
+  evidence: Schema.Struct({
+    kind: Schema.Literal("host-pinned-profile"),
+    authorizationEndpoint: Schema.Literal(atlassianAuthorizationEndpoint),
+    tokenEndpoint: Schema.Literal(atlassianTokenEndpoint),
+    profileEndpoint: Schema.Literal(atlassianProfileEndpoint),
+  }),
+});
+
+export const AtlassianMigrationRequest = Schema.Struct({
+  organization: Schema.NonEmptyString,
+  proofs: Schema.Array(AtlassianProof).check(Schema.isMinLength(1), Schema.isMaxLength(50)),
+});
+
+export const requireAtlassianProvider = (row: RetainedAccountSnapshot) =>
+  Effect.gen(function* () {
+    const definition = yield* Schema.decodeUnknownEffect(ProviderDefinition)(row.definition);
+    const method = definition.auth[row.method];
+    if (
+      method?.type !== "oauth2" ||
+      method.grant === "client_credentials" ||
+      method.discover !== undefined ||
+      method.authorizationUrl !== atlassianAuthorizationEndpoint ||
+      method.tokenUrl !== atlassianTokenEndpoint ||
+      (method.issuer !== undefined && method.issuer !== atlassianIssuer) ||
+      (method.identity !== undefined && method.identity.issuer !== atlassianIssuer) ||
+      method.authorizationParams?.audience !== "api.atlassian.com"
+    )
+      return yield* new RetainedIdentityRefused({ reason: "provider-not-atlassian" });
+  });
+
+/** Proof covers the complete retained binding; it grants no new scope, site or consumer access. */
+export const requireAtlassianProof = (
+  row: RetainedAccountSnapshot,
+  proof: typeof AtlassianProof.Type,
+  organization: string,
+) =>
+  Effect.gen(function* () {
+    yield* requireAtlassianProvider(row);
+    const observed = Date.parse(proof.observedAt);
+    if (
+      !(
+        row.organization === organization &&
+        row.owner === `organization:${organization}` &&
+        row.owner === proof.owner &&
+        row.provider === proof.provider &&
+        row.method === proof.method &&
+        row.generation === proof.generation &&
+        row.placement === proof.placement &&
+        row.site === proof.site &&
+        row.grantSha256 === proof.grantSha256 &&
+        row.credentialsSha256 === proof.credentialsSha256 &&
+        row.linksSha256 === proof.linksSha256 &&
+        Number.isFinite(observed) &&
+        new Date(observed).toISOString() === proof.observedAt
+      )
+    )
+      return yield* new RetainedIdentityRefused({ reason: "prepared-proof-changed" });
+  });
