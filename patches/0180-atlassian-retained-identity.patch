+++ b/e2e/tests/atlassian-identity-migration.spec.ts
@@ -0,0 +1,325 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { createHash, randomUUID } from "node:crypto";
+import { Api, body } from "../support/api.ts";
+import { Actors } from "../support/actors.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { cloudLocks } from "../support/cloud-locks.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { scenarios } from "../test-plan.ts";
+import { Artifact, productionOpsClient } from "../support/production-ops-client.ts";
+
+const canonical = (value: unknown): string =>
+  JSON.stringify(value, (_key, item: unknown) =>
+    item !== null && typeof item === "object" && !Array.isArray(item)
+      ? Object.fromEntries(Object.entries(item).sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0)))
+      : item,
+  );
+const hash = (value: unknown) => createHash("sha256").update(canonical(value)).digest("hex");
+
+layer(HostedLive, { excludeTestServices: true })("Atlassian recovery operations", (it) => {
+  it.effect(scenarios.atlassianIdentityMigration.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          database = yield* cloudLocks;
+        const client = yield* productionOpsClient;
+        const organization = actors.organization.id,
+          owner = `organization:${organization}`;
+        const rows = (sql: string, params: readonly (string | number | null)[] = []) =>
+          database.run({ sql, params });
+        const ids = [`acc_${randomUUID()}`, `acc_${randomUUID()}`],
+          provider = `prv_${randomUUID()}`;
+        const session = yield* body(
+          Schema.Struct({ user: Schema.Struct({ id: Schema.String }) }),
+          yield* api.request(actors.owner, "GET", "/api/auth/get-session"),
+        );
+        const person = session.user.id;
+        const deployed = yield* api.request(
+          actors.owner,
+          "POST",
+          `/api/organizations/${organization}/apps/deploy`,
+          {
+            name: `Recovery ${randomUUID()}`,
+            files: [
+              appsManifest,
+              {
+                path: "index.ts",
+                content:
+                  'import { defineApp, router } from "apps"; export default defineApp({}, {tools:router({})});',
+              },
+            ],
+          },
+        );
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const app = (yield* body(Schema.Struct({ id: Schema.String }), deployed)).id;
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            for (const id of ids) {
+              yield* rows("delete from executor_accounts where id = $1", [id]);
+              yield* rows("delete from executor_oauth_grants where id = $1", [id]);
+            }
+            yield* rows(
+              "delete from executor_account_identities where owner = $1 and subject = $2",
+              [owner, `subject-${ids[0]}`],
+            );
+            yield* rows("delete from executor_providers where id = $1", [provider]);
+            yield* api.request(
+              actors.owner,
+              "DELETE",
+              `/api/organizations/${organization}/apps/${app}`,
+            );
+          }).pipe(Effect.orDie),
+        );
+        const authorizationEndpoint = "https://auth.atlassian.com/authorize";
+        const tokenEndpoint = "https://auth.atlassian.com/oauth/token";
+        yield* rows("insert into executor_providers (id,definition) values ($1,$2::jsonb)", [
+          provider,
+          JSON.stringify({
+            name: "Atlassian recovery fixture",
+            auth: {
+              oauth: {
+                type: "oauth2",
+                authorizationUrl: authorizationEndpoint,
+                tokenUrl: tokenEndpoint,
+                scopes: ["read:me"],
+                authorizationParams: { audience: "api.atlassian.com" },
+                tokenEndpointAuthMethod: "none",
+                response: {
+                  type: "object",
+                  properties: { access_token: { type: "string" } },
+                  required: ["access_token"],
+                },
+              },
+            },
+          }),
+        ]);
+        for (const [index, id] of ids.entries()) {
+          yield* rows(
+            `insert into executor_accounts
+        (id,owner,provider,method,label,site,encrypted_credentials,created_at,credential_generation)
+        values ($1,$2,$3,'oauth',$4,$5,decode('123456','hex'),now(),3)`,
+            [
+              id,
+              owner,
+              provider,
+              index === 0 ? "Default" : "My Atlassian",
+              `https://site-${index}.atlassian.net`,
+            ],
+          );
+          yield* rows(
+            `insert into executor_oauth_grants (id,encrypted,status,updated_at,owner)
+        values ($1,decode('abcdef','hex'),'ready_fixture',now(),$2)`,
+            [id, owner],
+          );
+          yield* rows(
+            `insert into hosted_account_access (account_id,organization_id,creator_id,kind,personal_user_id)
+        values ($1,$2,$3,'personal',$3)`,
+            [id, organization, person],
+          );
+          yield* rows(
+            `insert into hosted_app_account_links (app,requirement,subject,account,linked_by)
+        values ($1,'service',$2,$3,$2)`,
+            [app, person, id],
+          );
+        }
+        const operation = (
+          action: string,
+          selection: string,
+          request: unknown,
+          extra: object = {},
+        ) => client.request({ action, selection, request, recipient: client.recipient, ...extra });
+        const open = client.decrypt;
+        const snapshot = () =>
+          rows(
+            `select a.id, a.owner, a.provider, a.method, a.credential_generation as generation,
+      a.oauth_grant_id, a.site, encode(a.encrypted_credentials,'hex') as credentials,
+      encode(g.encrypted,'hex') as encrypted,g.status,g.owner as "grantOwner",
+      to_char(g.updated_at at time zone 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"') as updated,
+      h.revision, h.kind, h.personal_user_id as person,h.audience,
+      (select jsonb_agg(to_jsonb(l) order by l.app,l.requirement) from hosted_app_account_links l where l.account=a.id) as links
+      from executor_accounts a join executor_oauth_grants g on g.id=a.id
+      join hosted_account_access h on h.account_id=a.id where a.id in ($1,$2) order by a.id`,
+            ids,
+          );
+        const before = yield* snapshot();
+        const observedAt = new Date().toISOString();
+        const proofs = before.map((row) => {
+          const placement = JSON.stringify([organization, row.kind, row.person, row.audience, []]);
+          return {
+            account: row.id,
+            owner,
+            provider,
+            method: "oauth",
+            generation: row.generation,
+            placement,
+            grantSha256: hash([
+              row.id,
+              owner,
+              provider,
+              "oauth",
+              row.generation,
+              placement,
+              row.revision,
+              row.id,
+              row.status,
+              row.grantOwner,
+              row.updated,
+              row.encrypted,
+            ]),
+            issuer: "https://auth.atlassian.com",
+            subject: `subject-${ids[0]}`,
+            label: "person@example.test",
+            site: row.site,
+            credentialsSha256: hash(row.credentials),
+            linksSha256: hash([
+              { app, requirement: "service", subject: person, linked_by: person },
+            ]),
+            observedAt,
+            evidence: {
+              kind: "host-pinned-profile",
+              authorizationEndpoint,
+              tokenEndpoint,
+              profileEndpoint: "https://api.atlassian.com/me",
+            },
+          };
+        });
+        const request = { organization, proofs };
+        const prepared = yield* operation("prepare", "atlassian-account-proofs", {
+          organization,
+          accounts: ids,
+        });
+        expect(prepared.status, JSON.stringify(prepared.body)).toBe(200);
+        const preparation = open(
+          (yield* body(Schema.Struct({ artifact: Artifact }), prepared)).artifact,
+        );
+        const result = Schema.decodeUnknownSync(
+          Schema.Struct({
+            result: Schema.Struct({
+              proofs: Schema.Array(Schema.Unknown),
+              insufficientProof: Schema.Array(
+                Schema.Struct({ account: Schema.String, reason: Schema.String }),
+              ),
+            }),
+          }),
+        )(preparation).result;
+        expect(result.proofs).toEqual([]);
+        expect(result.insufficientProof.map((entry) => entry.account).sort()).toEqual(
+          [...ids].sort(),
+        );
+        expect(yield* snapshot()).toEqual(before);
+        const selection = "atlassian-account-identity-v1";
+        for (const invalid of [
+          proofs.map((proof) => ({ ...proof, issuer: "https://example.invalid" })),
+          proofs.map(({ subject: _subject, ...proof }) => proof),
+          [...proofs, ...proofs],
+          proofs.map((proof) => ({ ...proof, placement: "another-placement" })),
+          proofs.map((proof) => ({ ...proof, site: "https://another.atlassian.net" })),
+          proofs.map((proof) => ({ ...proof, credentialsSha256: "0".repeat(64) })),
+          proofs.map((proof) => ({ ...proof, linksSha256: "0".repeat(64) })),
+          proofs.map((proof) => ({
+            ...proof,
+            evidence: { ...proof.evidence, profileEndpoint: "https://example.invalid/me" },
+          })),
+        ]) {
+          expect(
+            (yield* operation("dry-run", selection, { organization, proofs: invalid })).status,
+          ).toBe(409);
+        }
+        const dry = yield* operation("dry-run", selection, request);
+        expect(dry.status, JSON.stringify(dry.body)).toBe(200);
+        const plan = yield* body(
+          Schema.Struct({
+            changes: Schema.Number,
+            artifact: Artifact,
+            backup: Artifact,
+            backupSha256: Schema.String,
+          }),
+          dry,
+        );
+        expect(plan.changes).toBe(3);
+        const decoded = Schema.decodeUnknownSync(
+          Schema.Struct({
+            database: Schema.Struct({ name: Schema.String, targetSha256: Schema.String }),
+            plan: Schema.Struct({
+              changes: Schema.Array(Schema.Struct({ table: Schema.String })),
+            }),
+          }),
+        )(open(plan.artifact));
+        expect(decoded.plan.changes.map((change) => change.table).sort()).toEqual([
+          "executor_account_identities",
+          "executor_accounts",
+          "executor_accounts",
+        ]);
+        open(plan.backup);
+        expect(yield* snapshot()).toEqual(before);
+        const apply = (go = `GO ${plan.artifact.sha256}`) =>
+          operation("apply", selection, request, {
+            artifact: plan.artifact,
+            planSha256: plan.artifact.sha256,
+            backupSha256: plan.backupSha256,
+            go,
+          });
+        expect((yield* apply("GO wrong-plan")).status).toBe(409);
