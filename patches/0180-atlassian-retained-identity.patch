+++ b/apps/hosted/cloud/src/infrastructure/production-ops/migrations/atlassian-account-identity-v1.ts
@@ -0,0 +1,209 @@
+import { Effect, Schema } from "effect";
+import { SqlClient } from "effect/sql";
+import type { Json, ProductionMigration } from "../contracts.ts";
+import {
+  RetainedIdentityRefused,
+  accountHash,
+  identityId,
+  readRetainedAccount,
+  sha256,
+} from "./retained-identity-records.ts";
+import { AtlassianMigrationRequest, requireAtlassianProof } from "./atlassian-identity-records.ts";
+
+const IdentityRow = Schema.Struct({
+  id: Schema.String,
+  owner: Schema.String,
+  placement: Schema.String,
+  issuer: Schema.String,
+  subject: Schema.String,
+  name: Schema.String,
+  label: Schema.String,
+  verifiedAt: Schema.String,
+  createdAt: Schema.String,
+});
+
+const readIdentity = (id: string, lock = false) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const rows = yield* sql.unsafe(
+      `select id, owner, placement, issuer, subject, name, label,
+    to_char(verified_at at time zone 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"') as "verifiedAt",
+    to_char(created_at at time zone 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"') as "createdAt"
+    from executor_account_identities where id = $1${lock ? " for update" : ""}`,
+      [id],
+    );
+    return (yield* Schema.decodeUnknownEffect(Schema.Array(IdentityRow))(rows))[0];
+  });
+
+const prepare = (request: Json, lock = false) =>
+  Effect.gen(function* () {
+    const input = yield* Schema.decodeUnknownEffect(AtlassianMigrationRequest)(request);
+    const proofs = [...input.proofs].sort((a, b) => a.account.localeCompare(b.account));
+    if (new Set(proofs.map((proof) => proof.account)).size !== proofs.length)
+      return yield* new RetainedIdentityRefused({ reason: "duplicate-account-selection" });
+    const accounts = [];
+    const identities = new Map<string, typeof IdentityRow.Type>();
+    const changes = [];
+    for (const proof of proofs) {
+      const row = yield* readRetainedAccount(proof.account, lock);
+      yield* requireAtlassianProof(row, proof, input.organization);
+      const id = yield* identityId(proof);
+      if (row.identity !== null && row.identity !== id)
+        return yield* new RetainedIdentityRefused({ reason: "identity-already-different" });
+      const existing = yield* readIdentity(id, lock);
+      if (
+        existing !== undefined &&
+        (existing.owner !== proof.owner ||
+          existing.placement !== proof.placement ||
+          existing.issuer !== proof.issuer ||
+          existing.subject !== proof.subject)
+      )
+        return yield* new RetainedIdentityRefused({ reason: "identity-provenance-changed" });
+      const identity = {
+        id,
+        owner: proof.owner,
+        placement: proof.placement,
+        issuer: proof.issuer,
+        subject: proof.subject,
+        name: "Atlassian",
+        label: proof.label,
+        verifiedAt: proof.observedAt,
+        createdAt: existing?.createdAt ?? proof.observedAt,
+      };
+      const prior = identities.get(id);
+      if (
+        prior !== undefined &&
+        (prior.label !== identity.label || prior.verifiedAt !== identity.verifiedAt)
+      )
+        return yield* new RetainedIdentityRefused({ reason: "inconsistent-identity-proof" });
+      if (prior === undefined) {
+        identities.set(id, identity);
+        if (
+          existing !== undefined &&
+          Date.parse(existing.verifiedAt) > Date.parse(proof.observedAt)
+        )
+          return yield* new RetainedIdentityRefused({ reason: "newer-identity-proof-exists" });
+        const beforeSha256 = existing === undefined ? null : yield* sha256(existing);
+        const afterSha256 = yield* sha256(identity);
+        if (beforeSha256 !== afterSha256)
+          changes.push({
+            table: "executor_account_identities",
+            key: { id },
+            action: existing === undefined ? ("insert" as const) : ("update" as const),
+            beforeSha256,
+            afterSha256,
+          });
+      }
+      // Authored names survive; generic labels become the verified profile label.
+      const label = /^default(?: account| \d+)?$/iu.test(row.label) ? proof.label : row.label;
+      const beforeSha256 = yield* accountHash(row);
+      const afterSha256 = yield* accountHash(row, id, label);
+      if (beforeSha256 !== afterSha256)
+        changes.push({
+          table: "executor_accounts",
+          key: { id: row.account },
+          action: "update" as const,
+          beforeSha256,
+          afterSha256,
+        });
+      accounts.push({
+        account: row.account,
+        identity: id,
+        label,
+        afterSha256,
+        grantSha256: row.grantSha256,
+        credentialsSha256: row.credentialsSha256,
+        linksSha256: row.linksSha256,
+      });
+    }
+    return { changes, data: { accounts, identities: [...identities.values()] } };
+  });
+
+const PlanData = Schema.Struct({
+  accounts: Schema.Array(
+    Schema.Struct({
+      account: Schema.String,
+      identity: Schema.String,
+      label: Schema.String,
+      afterSha256: Schema.String,
+      grantSha256: Schema.String,
+      credentialsSha256: Schema.String,
+      linksSha256: Schema.String,
+    }),
+  ),
+  identities: Schema.Array(IdentityRow),
+});
+
+/** Only verified display identity changes; bindings, grants and every access/link record stay intact. */
+export const atlassianAccountIdentityV1: ProductionMigration = {
+  name: "atlassian-account-identity-v1",
+  revision: "1",
+  tables: [
+    "executor_accounts",
+    "executor_account_identities",
+    "executor_providers",
+    "executor_oauth_grants",
+    "hosted_account_access",
+    "hosted_account_groups",
+    "hosted_app_account_links",
+  ],
+  inspect: (request) => prepare(request),
+  apply: (request, plan) =>
+    Effect.gen(function* () {
+      const sql = yield* SqlClient.SqlClient;
+      const current = yield* prepare(request, true);
+      if (
+        (yield* sha256(current)) !==
+        (yield* sha256({ changes: plan.changes.map((change) => ({ ...change })), data: plan.data }))
+      )
+        return yield* new RetainedIdentityRefused({ reason: "plan-changed" });
+      for (const identity of current.data.identities) {
+        if (
+          !current.changes.some(
+            (change) =>
+              change.table === "executor_account_identities" && change.key.id === identity.id,
+          )
+        )
+          continue;
+        yield* sql`insert into executor_account_identities
+        (id, owner, placement, issuer, subject, name, label, verified_at, created_at)
+        values (${identity.id}, ${identity.owner}, ${identity.placement}, ${identity.issuer}, ${identity.subject},
+          ${identity.name}, ${identity.label}, ${identity.verifiedAt}::timestamptz, ${identity.createdAt}::timestamptz)
+        on conflict (id) do update set label = excluded.label, verified_at = excluded.verified_at`;
+      }
+      for (const account of current.data.accounts) {
+        if (
+          !current.changes.some(
+            (change) => change.table === "executor_accounts" && change.key.id === account.account,
+          )
+        )
+          continue;
+        yield* sql`update executor_accounts set identity_id = ${account.identity}, label = ${account.label}
+        where id = ${account.account}`;
+      }
+    }),
+  verify: (request, plan) =>
+    Effect.gen(function* () {
+      yield* Schema.decodeUnknownEffect(AtlassianMigrationRequest)(request);
+      const expected = yield* Schema.decodeUnknownEffect(PlanData)(plan.data);
+      let identities = true,
+        accountMetadata = true,
+        credentials = true,
+        appLinks = true;
+      for (const identity of expected.identities) {
+        const actual = yield* readIdentity(identity.id);
+        identities &&=
+          actual !== undefined && (yield* sha256(actual)) === (yield* sha256(identity));
+      }
+      for (const account of expected.accounts) {
+        const actual = yield* readRetainedAccount(account.account);
+        accountMetadata &&= (yield* accountHash(actual)) === account.afterSha256;
+        credentials &&=
+          actual.grantSha256 === account.grantSha256 &&
+          actual.credentialsSha256 === account.credentialsSha256;
+        appLinks &&= actual.linksSha256 === account.linksSha256;
+      }
+      const checks = { identities, accountMetadata, credentials, appLinks };
+      return { ok: Object.values(checks).every(Boolean), checks };
+    }),
+};
