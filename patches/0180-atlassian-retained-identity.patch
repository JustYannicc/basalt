@@ -0,0 +1,149 @@
+import { Clock, Context, Effect, Redacted, Schema } from "effect";
+import {
+  AccountId,
+  OAuthGrant,
+  isFirstPartyGrant,
+  type Credentials,
+  type FirstPartyOAuthClient,
+} from "@executor-js/sdk/core";
+import type { OAuthProtocol } from "@executor-js/sdk/oauth-protocol-contracts";
+import type { Json } from "../contracts.ts";
+import { RetainedIdentityRefused, readRetainedAccount } from "./retained-identity-records.ts";
+import {
+  AtlassianProof,
+  atlassianIssuer,
+  atlassianAuthorizationEndpoint,
+  atlassianTokenEndpoint,
+  atlassianProfileEndpoint,
+  requireAtlassianProvider,
+  requireAtlassianProof,
+} from "./atlassian-identity-records.ts";
+
+export class AtlassianProofRuntime extends Context.Service<
+  AtlassianProofRuntime,
+  {
+    readonly credentials: Pick<Credentials, "decrypt">;
+    readonly identify: OAuthProtocol["identify"];
+    readonly firstPartyClients: readonly FirstPartyOAuthClient[];
+  }
+>()("basalt/production-ops/AtlassianProofRuntime") {}
+
+const Request = Schema.Struct({
+  organization: Schema.NonEmptyString,
+  accounts: Schema.Array(Schema.NonEmptyString).check(
+    Schema.isMinLength(1),
+    Schema.isMaxLength(50),
+  ),
+});
+
+/** Existing tokens go only to the host-pinned profile lookup; preparation never refreshes or writes. */
+export const prepareAtlassianAccountProofs = (request: Json) =>
+  Effect.gen(function* () {
+    const input = yield* Schema.decodeUnknownEffect(Request)(request);
+    const runtime = yield* AtlassianProofRuntime;
+    const now = yield* Clock.currentTimeMillis;
+    const observedAt = new Date(now).toISOString();
+    const proofs: (typeof AtlassianProof.Type)[] = [];
+    const insufficientProof: { account: string; reason: string }[] = [];
+    const selected = [...new Set(input.accounts)].sort();
+    if (selected.length !== input.accounts.length)
+      return yield* new RetainedIdentityRefused({ reason: "duplicate-account-selection" });
+    for (const account of selected) {
+      const result = yield* Effect.gen(function* () {
+        const before = yield* readRetainedAccount(account);
+        if (
+          before.organization !== input.organization ||
+          before.owner !== `organization:${input.organization}`
+        )
+          return yield* new RetainedIdentityRefused({ reason: "account-outside-organization" });
+        yield* requireAtlassianProvider(before);
+        const fields = yield* runtime.credentials.decrypt(
+          AccountId.make(before.grant),
+          Redacted.make(before.encrypted),
+        );
+        const grant = yield* Schema.decodeUnknownEffect(OAuthGrant)(Redacted.value(fields));
+        if (
+          grant.grant === "client_credentials" ||
+          (grant.expiresAt !== undefined && grant.expiresAt <= now) ||
+          (grant.generation !== undefined && grant.generation !== before.generation)
+        )
+          return yield* new RetainedIdentityRefused({ reason: "reconnect-required" });
+        const token = grant.fields.access_token;
+        if (typeof token !== "string" || token.length === 0)
+          return yield* new RetainedIdentityRefused({ reason: "access-token-unavailable" });
+        const operator = isFirstPartyGrant(grant)
+          ? runtime.firstPartyClients.find((client) => client.id === grant.firstParty)
+          : undefined;
+        if (
+          isFirstPartyGrant(grant) &&
+          (operator === undefined || grant.authorizationClient !== operator.clientId)
+        )
+          return yield* new RetainedIdentityRefused({ reason: "client-unavailable" });
+        const server = isFirstPartyGrant(grant)
+          ? {
+              issuer: atlassianIssuer,
+              authorization_endpoint: operator!.server.authorizationUrl,
+              token_endpoint: operator!.server.tokenUrl,
+            }
+          : grant.server;
+        if (
+          server.authorization_endpoint !== atlassianAuthorizationEndpoint ||
+          server.token_endpoint !== atlassianTokenEndpoint ||
+          server.issuer !== atlassianIssuer ||
+          (!isFirstPartyGrant(grant) &&
+            grant.authorizationClient !== undefined &&
+            grant.authorizationClient !== grant.client.client_id)
+        )
+          return yield* new RetainedIdentityRefused({ reason: "grant-not-atlassian" });
+        const verified = yield* runtime.identify(
+          { issuer: atlassianIssuer, name: "Atlassian" },
+          server,
+          token,
+        );
+        if (
+          verified.issuer !== atlassianIssuer ||
+          (grant.identity !== undefined &&
+            (grant.identity.issuer !== verified.issuer ||
+              grant.identity.subject !== verified.subject))
+        )
+          return yield* new RetainedIdentityRefused({ reason: "identity-mismatch" });
+        const proof = yield* Schema.decodeUnknownEffect(AtlassianProof)({
+          account,
+          owner: before.owner,
+          provider: before.provider,
+          method: before.method,
+          generation: before.generation,
+          placement: before.placement,
+          site: before.site,
+          grantSha256: before.grantSha256,
+          credentialsSha256: before.credentialsSha256,
+          linksSha256: before.linksSha256,
+          issuer: verified.issuer,
+          subject: verified.subject,
+          label: verified.label,
+          observedAt,
+          evidence: {
+            kind: "host-pinned-profile",
+            authorizationEndpoint: atlassianAuthorizationEndpoint,
+            tokenEndpoint: atlassianTokenEndpoint,
+            profileEndpoint: atlassianProfileEndpoint,
+          },
+        });
+        yield* requireAtlassianProof(
+          yield* readRetainedAccount(account),
+          proof,
+          input.organization,
+        );
+        return proof;
+      }).pipe(Effect.result);
+      if (result._tag === "Success") proofs.push(result.success);
+      else
+        insufficientProof.push({
+          account,
+          reason: Schema.is(RetainedIdentityRefused)(result.failure)
+            ? result.failure.reason
+            : "insufficient-proof",
+        });
+    }
+    return { organization: input.organization, proofs, insufficientProof };
+  });
