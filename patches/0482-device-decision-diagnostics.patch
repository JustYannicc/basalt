diff --git a/packages/mcp-auth/src/implementation/device-decision-step.ts b/packages/mcp-auth/src/implementation/device-decision-step.ts
--- /dev/null
+++ b/packages/mcp-auth/src/implementation/device-decision-step.ts
@@ -0,0 +1,29 @@
+import { APIError } from "better-auth/api";
+import { Effect, Option, Schema } from "effect";
+import {
+  DeviceDecisionUnavailable,
+  DeviceFailureDetails,
+  deviceDecisionUnavailable,
+} from "../contracts/device.ts";
+
+/** Preserve typed dependency diagnostics; storage boundaries otherwise supply their own stage. */
+export const deviceDecisionStep = <A>(
+  stage: DeviceFailureDetails["stage"],
+  work: Effect.Effect<A, APIError>,
+) =>
+  work.pipe(
+    Effect.catch((error) => {
+      if (error.statusCode !== 503) return Effect.fail(error);
+      if (Schema.is(DeviceDecisionUnavailable)(error.body)) return Effect.fail(error);
+      const details = Option.getOrElse(
+        Schema.decodeUnknownOption(DeviceFailureDetails)(error.body),
+        () => ({ stage, failure: "storage" as const }),
+      );
+      return Effect.logWarning("device.decision.failed").pipe(
+        Effect.annotateLogs({ ...details }),
+        Effect.andThen(
+          Effect.fail(new APIError("SERVICE_UNAVAILABLE", deviceDecisionUnavailable(details))),
+        ),
+      );
+    }),
+  );
