+    "invalid_response",
+  ]),
+  dependencyStatus: Schema.optionalKey(
+    Schema.Int.check(Schema.isBetween({ minimum: 100, maximum: 599 })),
+  ),
+});
+export type DeviceFailureDetails = typeof DeviceFailureDetails.Type;
+
+export const DeviceDecisionUnavailable = Schema.Struct({
+  ...DeviceFailureDetails.fields,
+  code: Schema.Literal("DEVICE_APPROVAL_UNAVAILABLE"),
+  message: Schema.NonEmptyString,
+});
+
+/** Approval can fail after a side effect, so a 503 never promises it is safe to replay. */
+export const deviceDecisionUnavailable = (details: DeviceFailureDetails) =>
+  DeviceDecisionUnavailable.make({
+    ...details,
+    code: "DEVICE_APPROVAL_UNAVAILABLE",
+    message:
+      "We could not confirm this device connection. Check its status on your device before trying again.",
+  });
