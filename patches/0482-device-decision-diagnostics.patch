diff --git a/apps/hosted/server/src/implementation/native-control-error.ts b/apps/hosted/server/src/implementation/native-control-error.ts
--- /dev/null
+++ b/apps/hosted/server/src/implementation/native-control-error.ts
@@ -0,0 +1,45 @@
+import type { DeviceFailureDetails } from "@executor-js/mcp-auth/device";
+import { APIError } from "better-auth/api";
+import { Effect } from "effect";
+
+export const nativeControlFailure = (
+  action: string,
+  details: DeviceFailureDetails,
+  unauthorized = false,
+) =>
+  Effect.logWarning("native.control.failed").pipe(
+    Effect.annotateLogs({ action, ...details }),
+    Effect.andThen(
+      Effect.fail(
+        new APIError(unauthorized ? "UNAUTHORIZED" : "SERVICE_UNAVAILABLE", {
+          code: unauthorized ? "NATIVE_CONTROL_REFUSED" : "NATIVE_CONTROL_UNAVAILABLE",
+          message: unauthorized
+            ? "This device connection is no longer available."
+            : "The device connection service is unavailable. Check your device before trying again.",
+          ...details,
+        }),
+      ),
+    ),
+  );
+
+export const nativeControlCall = <A>(
+  action: string,
+  stage: "native_control_signing" | "native_control_request" | "native_control_response",
+  run: () => Promise<A>,
+) =>
+  Effect.tryPromise({
+    try: run,
+    catch: (error) => {
+      const timeout =
+        error instanceof Error && (error.name === "TimeoutError" || error.name === "AbortError");
+      const failure =
+        stage === "native_control_signing"
+          ? "signing"
+          : stage === "native_control_response"
+            ? "invalid_response"
+            : timeout
+              ? "timeout"
+              : "transport";
+      return { stage, failure } satisfies DeviceFailureDetails;
+    },
+  }).pipe(Effect.catch((details) => nativeControlFailure(action, details)));
