diff --git a/e2e/tests/account-discovery-isolation.spec.ts b/e2e/tests/account-discovery-isolation.spec.ts
new file mode 100644
index 0000000..ceb388f
--- /dev/null
+++ b/e2e/tests/account-discovery-isolation.spec.ts
@@ -0,0 +1,362 @@
+/** A refused account stays visible without taking the app's healthy definitions down. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { FetchHttpClient, HttpClient } from "effect/http";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Resource } from "../support/contracts.ts";
+import { oauthSetupIssuer } from "../support/oauth-setup-issuer.ts";
+import { connectionsPath } from "../support/app-accounts.ts";
+import { settleWebhookSources } from "../support/webhook-sources.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+const SignIn = Schema.Struct({ authorizationUrl: Schema.String });
+const Catalog = Schema.Struct({
+  items: Schema.Array(Schema.Struct({ name: Schema.String })),
+  routers: Schema.Array(
+    Schema.Struct({ path: Schema.String, error: Schema.optional(Schema.Unknown) }),
+  ),
+});
+
+layer(HostedLive, { excludeTestServices: true })("Account discovery isolation", (it) => {
+  it.effect(scenarios.accountDiscoveryIsolation.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api;
+        const actors = yield* Actors;
+        const browser = yield* Browser;
+        const http = yield* HttpClient.HttpClient;
+        const issuer = yield* oauthSetupIssuer;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        // A one-second token exercises expiry; zero means an unspecified lifetime in OAuth.
+        yield* issuer.configure({ refreshTokens: true, expiresIn: 1 });
+        const source = (many: boolean, reverse: boolean) => `
+import { accountRouter, defineApp, defineProvider, oauth2, secrets, plain, query, mutation, dynamicRouter, object, string, router } from "apps";
+import { createAppHandler, hostContext } from "apps/host";
+const failed = defineProvider({ name: "Synthetic OAuth service", auth: { oauth: oauth2({ discover: ${JSON.stringify(`${issuer.origin}/mcp`)} }) } });
+const healthy = defineProvider({ name: "Synthetic healthy service", auth: { key: secrets({ label: "Access key", fields: object({ token: plain(string()) }) }) } });
+export default defineApp({ user: { accounts: { ${reverse ? "healthy: healthy" + (many ? ".many()" : "") + ", failed: failed" + (many ? ".many()" : "") : "failed: failed" + (many ? ".many()" : "") + ", healthy: healthy" + (many ? ".many()" : "")} } } }, async ({ user: { accounts }, signal }) => {
+  const selected = ${many ? "[...accounts.failed, ...accounts.healthy]" : "[accounts.failed, accounts.healthy]"};
+  return { tools: router({
+    nativeBoundary: query({ input: object({}) }, async () => {
+      const results = [];
+      for (const many of [false, true]) {
+        let writes = 0;
+        const inner = defineApp({ app: { accounts: { service: many ? healthy.many() : healthy } } }, {
+          tools: router({ write: mutation({ input: object({}) }, async () => ++writes) }),
+        });
+        const handler = createAppHandler(inner);
+        const request = command => new Request("https://synthetic.invalid/host", { method: "POST", body: JSON.stringify(command) });
+        const declared = await (await handler(request({ operation: "requirements" }), hostContext({ app: {} }))).json();
+        const account = { id: "acc_synthetic-unavailable", method: "key", provider: declared.value.accounts.app.service.definition,
+          unavailable: { _tag: "AccountUnavailable", accountId: "acc_synthetic-unavailable", failure: { kind: "renewal", reason: "client_rejected" } } };
+        const context = hostContext({ app: { service: many ? [account] : account } }, { tool: "write", input: {} });
+        const inspect = await handler(request({ operation: "inspect" }), context);
+        const inspected = await inspect.json();
+        const call = await handler(request({ operation: "call", tool: "write", kind: "mutation", input: {} }), context);
+        results.push({ inspect: inspect.status, inspected, call: call.status, called: await call.json(), writes });
+      }
+      return results;
+    }),
+    status: query({ description: "Static service status", input: object({}) }, async () => "ready"),
+    write: mutation({ input: object({}) }, async () => "must not execute"),
+    sources: await accountRouter(selected, async account => {
+      // Credential access at discovery is isolated to this account's source.
+      const token = account.method === "oauth" ? account.fields.access_token : account.fields.token;
+      return dynamicRouter({
+        list: async () => [{ name: "healthyStatus", description: "Healthy account status", inputSchema: { type: "object", properties: {} }, outputSchema: { type: "string" }, readOnly: true }],
+        resolve: async name => name === "healthyStatus" ? query({ input: object({}) }, async () => token) : undefined,
+      });
+    }, { signal }),
+  }) };
+});`;
+        const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: "Account recovery proof",
+          files: [{ path: "index.ts", content: source(false, false) }, appsManifest],
+        });
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const app = yield* body(Resource, deployed);
+        const path = `${prefix}/apps/${app.id}`;
+        yield* Effect.addFinalizer(() =>
+          api.request(actors.owner, "DELETE", path).pipe(Effect.orDie),
+        );
+        const connect = (slot: string, account?: string) =>
+          Effect.gen(function* () {
+            const response = yield* api.request(
+              actors.owner,
+              "POST",
+              connectionsPath(path, "user", slot),
+              account === undefined ? {} : { account },
+            );
+            expect(response.status, JSON.stringify(response.body)).toBe(200);
+            return yield* body(Resource, response);
+          });
+        const signIn = (account?: string) =>
+          Effect.gen(function* () {
+            const connection = yield* connect("failed", account);
+            const started = yield* body(
+              SignIn,
+              yield* api.request(
+                actors.owner,
+                "POST",
+                `${prefix}/connections/${connection.id}/oauth/start`,
+                { method: "oauth", label: "Unavailable account" },
+              ),
+            );
+            const callbackUrl = yield* Effect.scoped(
+              Effect.gen(function* () {
+                const response = yield* HttpClient.withScope(http).get(started.authorizationUrl);
+                expect(response.status).toBe(302);
+                if (response.headers.location === undefined)
+                  return yield* Effect.die("Synthetic issuer omitted its callback");
+                return response.headers.location;
+              }),
+            ).pipe(Effect.provideService(FetchHttpClient.RequestInit, { redirect: "manual" }));
+            const completed = yield* api.request(
+              actors.owner,
+              "POST",
+              `${prefix}/connections/${connection.id}/oauth/complete`,
+              { callbackUrl },
+            );
+            expect(completed.status, JSON.stringify(completed.body)).toBe(200);
+            return yield* body(Resource, completed);
+          });
+        const failed = yield* signIn();
+        const healthyConnection = yield* connect("healthy");
+        const healthy = yield* body(
+          Resource,
+          yield* api.request(
+            actors.owner,
+            "POST",
+            `${prefix}/connections/${healthyConnection.id}/submit`,
+            {
+              method: "key",
+              label: "Healthy account",
+              fields: { token: "synthetic-healthy-token" },
+            },
+          ),
+        );
+        for (const account of [failed, healthy]) {
+          yield* Effect.addFinalizer(() =>
+            api
+              .request(actors.owner, "DELETE", `${prefix}/accounts/${account.id}`)
+              .pipe(Effect.orDie),
+          );
+          yield* settleWebhookSources(actors.owner, path, (sources) =>
+            sources.some((source) => source.account === account.id && source.status !== "pending"),
+          );
+        }
+        // This waits for the token's specified expiry, not for background work.
+        yield* Effect.sleep("1200 millis");
+        yield* issuer.configure({
+          tokenError: {
+            status: 401,
+            body: { error: "invalid_client" },
+            challenge: 'Basic realm="synthetic"',
+          },
+        });
+        // A newly released build has no healthy discovery result to reuse from account setup.
+        const cold = yield* api.request(actors.owner, "POST", `${path}/deploy`, {
+          files: [
+            { path: "index.ts", content: source(false, false) + "\n// Cold catalog revision.\n" },
+            appsManifest,
+          ],
+        });
+        expect(cold.status, JSON.stringify(cold.body)).toBe(200);
+        const pageUrl = `/org/${actors.organization.slug}/apps/${app.id}?view=tools`;
+        yield* browser.login(actors.owner);
+        yield* browser.use("Open tools with a failed synthetic account", (page) =>
+          page.setViewportSize({ width: 1280, height: 900 }).then(() =>
+            page.goto(pageUrl).then(() =>
+              page
+                .getByRole("alert")
+                .or(page.getByText("Healthy account status", { exact: true }))
+                .first()
+                .waitFor(),
+            ),
+          ),
+        );
+        yield* browser.use("Healthy tools remain beside the rejected client notice", (page) =>
+          page
+            .getByRole("list", { name: "Accounts whose tools could not load" })
+            .waitFor()
+            .then(() => page.getByText("Unavailable account", { exact: true }).first().waitFor())
+            .then(() => page.getByRole("link", { name: "Manage account" }).first().waitFor())
+            .then(() => page.getByText("Healthy status", { exact: true }).first().click())
+            .then(() =>
+              page.getByText("Healthy account status", { exact: true }).first().waitFor(),
+            ),
+        );
+        expect(
+          yield* browser.use("No global account block", (page) =>
+            page.getByText("Review the linked accounts", { exact: false }).count(),
+          ),
+        ).toBe(0);
+        yield* browser.use("Healthy tool detail finishes loading", (page) =>
+          page
+            .getByRole("status", { name: "Loading schema", exact: true })
+            .waitFor({ state: "hidden" }),
+        );
+        yield* browser.checkpoint("account-discovery-desktop");
+        yield* browser.use("Inspect the same account failure on mobile", (page) =>
+          page.setViewportSize({ width: 390, height: 844 }),
+        );
+        yield* browser.use("Failure and recovery stay usable at 390 pixels", (page) =>
+          page
+            .getByRole("list", { name: "Accounts whose tools could not load" })
+            .waitFor()
+            .then(() => page.getByRole("link", { name: "Manage account" }).first().waitFor()),
+        );
+        expect(
+          yield* browser.use("No mobile page overflow", (page) =>
+            page.evaluate(() => document.documentElement.scrollWidth <= innerWidth),
+          ),
+        ).toBe(true);
+        yield* browser.checkpoint("account-discovery-mobile");
+        const listed = yield* api.request(actors.owner, "GET", `${path}/tools`);
+        expect(listed.status, JSON.stringify(listed.body)).toBe(200);
+        // Discovery isolation never grants another actor access to the app or its accounts.
+        const unauthorized = yield* api.request(actors.member, "GET", `${path}/tools`);
+        expect(unauthorized.status, JSON.stringify(unauthorized.body)).toBe(403);
+        const catalog = yield* body(Catalog, listed);
+        expect(catalog.items.map((tool) => tool.name)).toEqual(
+          expect.arrayContaining(["status", "sources.healthyStatus", "write"]),
+        );
+        const failures = catalog.routers.flatMap((router) =>
+          router.error === undefined ? [] : [router.error],
+        );
+        expect(failures).toEqual(
+          expect.arrayContaining([
+            expect.objectContaining({
+              _tag: "AccountUnavailable",
+              accountId: failed.id,
+              failure: expect.objectContaining({
+                kind: "renewal",
+                reason: "client_rejected",
+                cause: expect.objectContaining({ stage: "refresh", status: 401 }),
+              }),
+            }),
+          ]),
+        );
+        expect(JSON.stringify(listed.body)).not.toContain("synthetic-healthy-token");
+        const blocked = yield* api.request(actors.owner, "POST", `${path}/tools/call`, {
+          tool: "write",
+          kind: "mutation",
+          input: {},
+        });
+        expect(blocked.status).toBe(502);
+        expect(blocked.body).toEqual(
+          expect.objectContaining({
+            _tag: "OAuthRenewalFailed",
+            account: failed.id,
+            reason: "client_rejected",
+          }),
+        );
+        const approval = yield* api.request(actors.owner, "POST", `${path}/tools/run`, {
+          tool: "write",
+          kind: "mutation",
+          input: {},
+        });
+        expect(approval.status).toBe(502);
+        expect(approval.body).toEqual(
+          expect.objectContaining({ _tag: "OAuthRenewalFailed", account: failed.id }),
+        );
+        // Redeploy the same saved accounts as many() and reverse the resolution order.
+        const upgraded = yield* api.request(actors.owner, "POST", `${path}/deploy`, {
+          files: [{ path: "index.ts", content: source(true, true) }, appsManifest],
+        });
+        expect(upgraded.status, JSON.stringify(upgraded.body)).toBe(200);
+        const many = yield* api.request(actors.owner, "GET", `${path}/tools/index`);
+        expect(many.status, JSON.stringify(many.body)).toBe(200);
+        expect((yield* body(Catalog, many)).items.map((tool) => tool.name)).toContain(
+          "sources.healthyStatus",
+        );
+        // A confirmed ended grant gets its own reconnect recovery, with healthy tools retained.
+        yield* issuer.configure({ tokenError: { status: 400, body: { error: "invalid_grant" } } });
+        const ended = yield* api.request(actors.owner, "GET", `${path}/tools`);
+        expect(ended.status, JSON.stringify(ended.body)).toBe(200);
+        expect(JSON.stringify(ended.body)).toContain('"kind":"reconnect"');
+        yield* issuer.configure({ tokenError: null, expiresIn: 3600 });
+        const reconnected = yield* signIn(failed.id);
+        expect(reconnected.id).toBe(failed.id);
+        const recovered = yield* api.request(actors.owner, "GET", `${path}/tools`);
+        expect(recovered.status, JSON.stringify(recovered.body)).toBe(200);
+        expect(JSON.stringify(recovered.body)).not.toContain("AccountUnavailable");
+        expect((yield* body(Catalog, recovered)).items.map((tool) => tool.name)).toContain(
+          "status",
+        );
+        const guarded = yield* api.request(actors.owner, "POST", `${path}/tools/call`, {
+          tool: "nativeBoundary",
+          kind: "query",
+          input: {},
+        });
+        expect(guarded.status, JSON.stringify(guarded.body)).toBe(200);
+        expect(guarded.body).toEqual(
+          [false, true].map(() =>
+            expect.objectContaining({
+              inspect: 200,
+              inspected: expect.objectContaining({ ok: true }),
+              call: 422,
+              called: expect.objectContaining({
+                ok: false,
+                error: expect.objectContaining({ _tag: "HostAccountsInvalid" }),
+              }),
+              writes: 0,
+            }),
+          ),
+        );
+        yield* browser.use("Reconnected account removes the notice", (page) =>
+          page
+            .setViewportSize({ width: 1280, height: 900 })
+            .then(() => page.goto(pageUrl))
+            .then(() => page.getByText("Healthy status", { exact: true }).first().waitFor()),
+        );
+        expect(
+          yield* browser.use("No account failure after reconnect", (page) =>
+            page.getByRole("list", { name: "Accounts whose tools could not load" }).count(),
+          ),
+        ).toBe(0);
+        // A broken encrypted store is a global failure, never an unavailable OAuth binding.
+        const [saved] = yield* legacyStorage([
+          {
+            sql: "SELECT encode(encrypted_credentials, 'hex') AS value FROM executor_accounts WHERE id = $1",
+            params: [healthy.id],
+          },
+          {
+            sql: "UPDATE executor_accounts SET encrypted_credentials = decode('00', 'hex') WHERE id = $1",
+            params: [healthy.id],
+          },
+        ]);
+        const original = saved?.[0]?.value;
+        expect(typeof original).toBe("string");
+        if (typeof original !== "string")
+          return yield* Effect.die("Missing synthetic credential envelope");
+        yield* Effect.addFinalizer(() =>
+          legacyStorage([
+            {
+              sql: "UPDATE executor_accounts SET encrypted_credentials = decode($1, 'hex') WHERE id = $2",
+              params: [original, healthy.id],
+            },
+          ]).pipe(Effect.andThen(serverControl("start")), Effect.orDie),
+        );
+        yield* serverControl("start");
+        const corrupt = yield* api.request(actors.owner, "POST", `${path}/deploy`, {
+          files: [
+            { path: "index.ts", content: source(true, true) + "\n// Credential storage fault.\n" },
+            appsManifest,
+          ],
+        });
+        expect(corrupt.status, JSON.stringify(corrupt.body)).toBe(200);
+        const unreadable = yield* api.request(actors.owner, "GET", `${path}/tools`);
+        expect(unreadable.status, JSON.stringify(unreadable.body)).toBe(500);
+        expect(unreadable.body).toEqual(expect.objectContaining({ _tag: "CredentialsError" }));
+      }),
+    ),
+  );
+});
