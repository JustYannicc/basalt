@@ -0,0 +1,124 @@
+import { Schema } from "effect";
+import {
+  AccountUnavailable,
+  accountUnavailableError,
+  type AccountRequirement,
+  type ToolRouter,
+} from "@executor-js/sdk";
+import type { RequirementAccounts } from "../../contracts/app-accounts.ts";
+import type { AccountSummary } from "../../contracts/dashboard.ts";
+import { requirementAccountTitle } from "../../contracts/account-identities.ts";
+import { buttonVariants } from "../components/button.tsx";
+import { useDashboard } from "./context.tsx";
+import { ErrorNotice } from "./error-notice.tsx";
+
+/** A name the host knows for an account; the browser shows the account ID without one. */
+export interface ToolAccountLabel {
+  readonly id: string;
+  readonly label: string;
+}
+
+/** Names for the accounts an app runs with, each once, as its account lists title them. */
+export const toolAccountLabels = <A extends AccountSummary>(
+  requirements: readonly RequirementAccounts<A>[],
+): readonly ToolAccountLabel[] => {
+  const declared: AccountRequirement[] = requirements.map((entry) => entry.requirement);
+  const labels = new Map<string, string>();
+  for (const entry of requirements)
+    for (const account of entry.using)
+      if (!labels.has(account.id))
+        labels.set(account.id, requirementAccountTitle(account, declared));
+  return [...labels].map(([id, label]) => ({ id, label }));
+};
+
+/**
+ * Each account whose credentials kept a router from listing tools, once, in catalog order. Other
+ * routers still list theirs; one account's failure never stands for the whole app.
+ */
+export const unavailableAccounts = (routers: readonly ToolRouter[]) => {
+  const failures = new Map<string, AccountUnavailable>();
+  for (const { error } of routers)
+    if (
+      error !== undefined &&
+      Schema.is(AccountUnavailable)(error) &&
+      !failures.has(error.accountId)
+    )
+      failures.set(error.accountId, error);
+  return [...failures.values()];
+};
+
+/**
+ * Only failures the account's own page can act on link there. An outage, a rate limit or an
+ * incompatible response is fixed by waiting or investigating, not by touching the account.
+ */
+const managedAtAccount = ({ failure }: AccountUnavailable) =>
+  failure.kind === "reconnect" ||
+  failure.reason === "client_rejected" ||
+  failure.reason === "renewal_rejected";
+
+/**
+ * One notice per unavailable account, above the healthy tools. Copy, retry and recovery are the
+ * account's own typed failure: a rejected OAuth client never reads as a revoked grant.
+ */
+export function ToolAccountFailures({
+  failures,
+  accounts,
+  retry,
+  retrying,
+}: {
+  readonly failures: readonly AccountUnavailable[];
+  readonly accounts: readonly ToolAccountLabel[] | undefined;
+  readonly retry: () => void;
+  readonly retrying: boolean;
+}) {
+  if (failures.length === 0) return null;
+  const labels = new Map(accounts?.map((account) => [account.id, account.label]));
+  return (
+    <ul
+      aria-label="Accounts whose tools could not load"
+      className="max-h-72 shrink-0 space-y-3 overflow-y-auto border-b px-4 py-3 max-[740px]:px-3"
+    >
+      {failures.map((failure) => (
+        <li key={failure.accountId} className="max-w-3xl min-w-0">
+          <p className="mb-1.5 text-xs font-medium text-muted-foreground wrap-anywhere">
+            {labels.get(failure.accountId) ?? failure.accountId}
+          </p>
+          <AccountFailureNotice failure={failure} retry={retry} retrying={retrying} />
+        </li>
+      ))}
+    </ul>
+  );
+}
+
+function AccountFailureNotice({
+  failure,
+  retry,
+  retrying,
+}: {
+  readonly failure: AccountUnavailable;
+  readonly retry: () => void;
+  readonly retrying: boolean;
+}) {
+  const { AccountLink } = useDashboard();
+  const error = accountUnavailableError(failure);
+  return (
+    <ErrorNotice
+      layout="compact"
+      error={error}
+      context={`While loading this app's tools for account ${failure.accountId}.`}
+      retry={retry}
+      retrying={retrying}
+      retryStatus="Checking tools"
+      action={
+        managedAtAccount(failure) ? (
+          <AccountLink
+            account={error.account}
+            className={buttonVariants({ size: "xs", variant: "outline" })}
+          >
+            Manage account
+          </AccountLink>
+        ) : undefined
+      }
+    />
+  );
+}
