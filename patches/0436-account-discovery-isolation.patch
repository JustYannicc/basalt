+/** Discovery keeps a failed account's identity, never credential fields or another account. */
+import { AccountUnavailable, type HostAccount } from "apps/contracts";
+import { Schema } from "effect";
+import { OAuthReconnectRequired, OAuthRenewalFailed } from "../contracts/oauth.ts";
+import type { ProviderDefinition } from "../contracts/provider.ts";
+import type { StoredAccount } from "../contracts/storage.ts";
+import type { AccountUses } from "./oauth.ts";
+
+export const unavailableAccount = (
+  account: StoredAccount,
+  definition: ProviderDefinition,
+  error: OAuthReconnectRequired | OAuthRenewalFailed,
+  uses: AccountUses,
+): HostAccount => ({
+  id: account.id,
+  method: account.method,
+  generation: account.credentialGeneration,
+  provider: definition,
+  ...(account.site === null ? {} : { site: account.site }),
+  unavailable: new AccountUnavailable({
+    accountId: account.id,
+    failure: Schema.is(OAuthReconnectRequired)(error)
+      ? {
+          kind: "reconnect",
+          ...(error.reason === undefined ? {} : { reason: error.reason }),
+          ...(error.cause === undefined ? {} : { cause: error.cause }),
+          ...(uses.user || uses.appUses[0] === undefined
+            ? {}
+            : { appRequirement: uses.appUses[0] }),
+        }
+      : {
+          kind: "renewal",
+          reason: error.reason,
+          ...(error.cause === undefined ? {} : { cause: error.cause }),
+          ...(error.retryAfter === undefined ? {} : { retryAt: error.retryAfter.getTime() }),
+        },
+  }),
+});
