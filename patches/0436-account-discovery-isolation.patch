+/** Metadata stays readable during discovery; credential access fails at its own source. */
+import type { ResolvedAccount } from "../contracts/host.ts";
+
+export const bindUnavailableAccount = (
+  account: ResolvedAccount & { readonly unavailable: NonNullable<ResolvedAccount["unavailable"]> },
+) => {
+  const reject = (): never => {
+    throw account.unavailable;
+  };
+  return {
+    id: account.id,
+    method: account.method,
+    ...(account.mcpEndpoint === undefined ? {} : { mcpEndpoint: account.mcpEndpoint }),
+    ...(account.oauthScopes === undefined ? {} : { oauthScopes: [...account.oauthScopes] }),
+    ...(account.site === undefined ? {} : { site: account.site }),
+    ...(account.generation === undefined ? {} : { generation: account.generation }),
+    get fields(): never {
+      return reject();
+    },
+    headers: reject,
+    url: reject,
+  };
+};
