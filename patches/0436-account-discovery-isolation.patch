diff --git a/packages/apps/src/contracts/account-unavailable.ts b/packages/apps/src/contracts/account-unavailable.ts
new file mode 100644
index 0000000..df3a105
--- /dev/null
+++ b/packages/apps/src/contracts/account-unavailable.ts
@@ -0,0 +1,28 @@
+import { Schema } from "effect";
+import { AccountId } from "./schema.ts";
+import { OAuthFailureCause, OAuthRenewalReason } from "./oauth-failure-evidence.ts";
+
+/** Credential failures discovery can report without supplying any credential fields. */
+export const UnavailableAccountFailure = Schema.Union([
+  Schema.Struct({
+    kind: Schema.Literal("reconnect"),
+    reason: Schema.optionalKey(Schema.Literals(["renewal_interrupted", "scope_exceeded"])),
+    cause: Schema.optionalKey(OAuthFailureCause),
+    appRequirement: Schema.optionalKey(Schema.String),
+  }),
+  Schema.Struct({
+    kind: Schema.Literal("renewal"),
+    reason: OAuthRenewalReason,
+    cause: Schema.optionalKey(OAuthFailureCause),
+    retryAt: Schema.optionalKey(Schema.Number),
+  }),
+]);
+
+/** A selected account could not supply credentials for discovery. Calls never accept it. */
+export class AccountUnavailable extends Schema.TaggedError<AccountUnavailable>()(
+  "AccountUnavailable",
+  {
+    accountId: AccountId,
+    failure: UnavailableAccountFailure,
+  },
+) {}
