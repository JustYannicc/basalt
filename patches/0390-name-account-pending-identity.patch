+++ b/e2e/support/name-account-authored.ts
@@ -0,0 +1,59 @@
+import { expect } from "@effect/vitest";
+import { Effect } from "effect";
+import { Actors } from "./actors.ts";
+import { Browser } from "./browser.ts";
+import { pendingSignIn } from "./oauth-link-sign-in.ts";
+import { holdQuery } from "./query-transition.ts";
+import { accountNameField, nameAccountDialog } from "./name-account.ts";
+
+/** An authored name stays usable while optional identity and health arrive. */
+export const nameAccountAuthored = (width: number) =>
+  Effect.gen(function* () {
+    const browser = yield* Browser,
+      actors = yield* Actors;
+    yield* browser.login(actors.owner);
+    const signIn = yield* pendingSignIn("Suggested account", "Work account");
+    const health = yield* holdQuery(/\/accounts\/[^/]+\/health$/, "continue", {
+      method: "POST",
+      allRequests: true,
+    });
+    yield* browser.use("Return to an authored account", (page) =>
+      page
+        .setViewportSize({ width, height: 900 })
+        .then(() => page.goto(signIn.callbackUrl.pathname + signIn.callbackUrl.search))
+        .then(() => nameAccountDialog(page).waitFor()),
+    );
+    yield* health.requested;
+    const completed = yield* signIn.read;
+    const account = completed.state.account;
+    if (!account) return yield* Effect.die("Sign-in did not save its account");
+    yield* signIn.removeAccount(account.id);
+    expect(
+      yield* browser.use("The authored name is not gated by the check", (page) =>
+        Promise.all([
+          accountNameField(page).inputValue(),
+          nameAccountDialog(page)
+            .getByRole("button", { name: "Save name", exact: true })
+            .isEnabled(),
+        ]),
+      ),
+    ).toEqual(["Work account", true]);
+    const response = yield* browser.use("Observe the authored account check", (page) =>
+      Promise.resolve({
+        finished: page.waitForResponse(
+          (reply) =>
+            reply.request().method() === "POST" &&
+            new URL(reply.url()).pathname.endsWith("/accounts/" + account.id + "/health"),
+        ),
+      }),
+    );
+    yield* health.release;
+    yield* browser.use("The check completes without replacing the authored name", () =>
+      response.finished.then((reply) => expect(reply.status()).toBe(200)),
+    );
+    expect(
+      yield* browser.use("Read the authored prefill after the check", (page) =>
+        accountNameField(page).inputValue(),
+      ),
+    ).toBe("Work account");
+  });
diff --git a/e2e/support/name-account-identity.ts b/e2e/support/name-account-identity.ts
new file mode 100644
index 0000000..f83057b
--- /dev/null
+++ b/e2e/support/name-account-identity.ts
@@ -0,0 +1,209 @@
+import { expect } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "./actors.ts";
+import { Api, body } from "./api.ts";
+import { Browser } from "./browser.ts";
+import { Resource } from "./contracts.ts";
+import { Evidence } from "./evidence.ts";
+import { accountNameField, accountNamePrompt, nameAccountDialog } from "./name-account.ts";
+import { providerAccountProduct } from "./provider-account-product.ts";
+import { providerAppsCatalog } from "./provider-apps-catalog.ts";
+import { serverControl } from "./server-control.ts";
+
+const email = "subscriber@example.test";
+const named = { result: { accountInfo: { email } } };
+const generated = /^Default(?: \d+)?$/;
+
+/** Real subscription sign-in and health checks; only the external credential service is held. */
+export const nameAccountIdentityJourney = (width: number) =>
+  Effect.gen(function* () {
+    const api = yield* Api,
+      actors = yield* Actors,
+      browser = yield* Browser,
+      evidence = yield* Evidence,
+      backend = yield* providerAppsCatalog;
+    const prefix = `/api/organizations/${actors.organization.id}`;
+    const accounts: string[] = [];
+    yield* providerAccountProduct(backend.origin, `${backend.origin}/catalog/index.json`);
+    const installed = yield* api.request(actors.owner, "POST", `${prefix}/apps/install`, {
+      entry: "provider-openai",
+      name: "OpenAI",
+    });
+    expect(installed.status, JSON.stringify(installed.body)).toBe(200);
+    const app = (yield* body(Resource, installed)).id;
+    yield* Effect.addFinalizer(() =>
+      Effect.gen(function* () {
+        yield* serverControl("start");
+        yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app}`);
+        for (const id of accounts)
+          yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${id}`);
+      }).pipe(Effect.orDie),
+    );
+    const appUrl = `/org/${actors.organization.slug}/apps/${app}?view=accounts`;
+    const listUrl = `/org/${actors.organization.slug}/accounts`;
+    yield* browser.login(actors.owner);
+    yield* browser.use("Open subscription accounts", (page) =>
+      page.setViewportSize({ width, height: 900 }).then(() => page.goto(appUrl)),
+    );
+    const connect = Effect.gen(function* () {
+      const saved = yield* browser.use("Sign in to the synthetic subscription", (page) =>
+        page
+          .getByRole("button", { name: "Connect new account", exact: true })
+          .click()
+          .then(() =>
+            Promise.all([
+              page.waitForResponse(
+                (response) =>
+                  response.request().method() === "GET" &&
+                  /\/connections\/[^/]+\/interactive\/status$/.test(
+                    new URL(response.url()).pathname,
+                  ),
+              ),
+              page
+                .getByRole("button", { name: "Sign in with ChatGPT subscription", exact: true })
+                .click(),
+            ]),
+          )
+          .then(([response]) => response.json() as Promise<unknown>),
+      );
+      const { account } = yield* Schema.decodeUnknownEffect(Schema.Struct({ account: Resource }))(
+        saved,
+      );
+      accounts.push(account.id);
+      yield* browser.use("The connected subscription asks for a name", accountNamePrompt);
+      return account.id;
+    });
+    const capture = (stage: string) =>
+      Effect.gen(function* () {
+        const image = yield* browser.use(`Capture ${stage} naming at ${width}px`, (page) =>
+          page.screenshot({ fullPage: true, animations: "disabled" }),
+        );
+        yield* evidence.attach(`name-${width}-${stage}.png`, "image/png", image);
+      });
+    const state = browser.use("Read the naming input and status", (page) =>
+      Promise.all([
+        accountNameField(page).inputValue(),
+        accountNameField(page).getAttribute("placeholder"),
+        nameAccountDialog(page)
+          .getByRole("status")
+          .allTextContents()
+          .then((texts) => texts.filter(Boolean)),
+        nameAccountDialog(page)
+          .getByRole("button", { name: "Save name", exact: true })
+          .isDisabled(),
+        page.locator("[data-account-name]").allTextContents(),
+      ]).then(([value, placeholder, statuses, disabled, rows]) => ({
+        value,
+        placeholder,
+        statuses,
+        disabled,
+        rows,
+      })),
+    );
+    const expectRows = (rows: readonly string[]) => {
+      expect(rows.length).toBeGreaterThan(0);
+      expect(rows.some((title) => generated.test(title.trim()))).toBe(false);
+    };
+    const inspectRows = (url: string) =>
+      browser.use("Read saved rows while the naming check is held", (page) =>
+        page
+          .context()
+          .newPage()
+          .then((listed) =>
+            listed
+              .goto(url)
+              .then(() => listed.locator("[data-account-name]").first().waitFor())
+              .then(() => listed.locator("[data-account-name]").allTextContents())
+              .finally(() => listed.close()),
+          ),
+      );
+    const waitForEmail = browser.use("The check fills the email", (page) =>
+      accountNameField(page)
+        .and(page.locator(`input[value="${email}"]`))
+        .waitFor(),
+    );
+    const dismiss = browser.use("Closing keeps the saved account", (page) =>
+      page.keyboard
+        .press("Escape")
+        .then(() => nameAccountDialog(page).waitFor({ state: "hidden" })),
+    );
+
+    yield* backend.answerCheck(named);
+    const first = yield* backend.holdCheck;
+    yield* connect;
+    yield* first.started;
+    yield* browser.use("The saved subscription row arrives", (page) =>
+      page.locator("[data-account-name]").first().waitFor(),
+    );
+    yield* capture("pending");
+    const pending = yield* state;
+    expectRows(pending.rows);
+    expectRows(yield* inspectRows(listUrl));
+    expectRows(yield* inspectRows(appUrl));
+    yield* first.release;
+    yield* waitForEmail;
+    yield* capture("settled");
+    yield* evidence.json("initial-name-states.json", { pending, settled: yield* state });
+    expect(pending.value, "a generated saved label never prefills the pending name").toBe("");
+    expect(pending.placeholder).toBe("OpenAI Subscription");
+    expect(pending.statuses).toEqual(["Checking account…"]);
+    expect(pending.disabled).toBe(true);
+    expect((yield* state).statuses).toEqual([]);
+    yield* dismiss;
+
+    yield* backend.answerCheck({ failure: "unavailable" });
+    const failed = yield* backend.holdCheck;
+    yield* connect;
+    yield* failed.started;
+    yield* failed.release;
+    const failure = browser.use("The unsuccessful check explains recovery", (page) =>
+      nameAccountDialog(page).getByText("Couldn't check this account.", { exact: true }).waitFor(),
+    );
+    yield* failure;
+    yield* capture("failed");
+    expect((yield* state).value).toBe("");
+    expect((yield* state).disabled).toBe(false);
+    expect(
+      yield* browser.use("A failed check leaves the name editable", (page) =>
+        accountNameField(page).isEnabled(),
+      ),
+    ).toBe(true);
+    yield* backend.answerCheck(named);
+    const retry = yield* backend.holdCheck;
+    yield* browser.use("Retry checking this account", (page) =>
+      nameAccountDialog(page).getByRole("button", { name: "Try again", exact: true }).click(),
+    );
+    yield* retry.started;
+    expect((yield* state).statuses).toEqual(["Checking account…"]);
+    expect((yield* state).value).toBe("");
+    yield* retry.release;
+    yield* waitForEmail;
+    yield* capture("retried");
+    expect((yield* state).statuses).toEqual([]);
+    yield* dismiss;
+
+    const typing = yield* backend.holdCheck;
+    const typedAccount = yield* connect;
+    yield* typing.started;
+    yield* browser.use("A person can name the subscription while it is checked", (page) =>
+      accountNameField(page).fill("Work subscription"),
+    );
+    expect((yield* state).disabled).toBe(false);
+    yield* typing.release;
+    yield* browser.use("The check settles without replacing the draft", (page) =>
+      nameAccountDialog(page)
+        .getByText("Checking account…", { exact: true })
+        .waitFor({ state: "hidden" }),
+    );
+    expect((yield* state).value).toBe("Work subscription");
+    yield* browser.use("Save the person's name", (page) =>
+      nameAccountDialog(page)
+        .getByRole("button", { name: "Save name", exact: true })
+        .click()
+        .then(() => nameAccountDialog(page).waitFor({ state: "hidden" })),
+    );
+    const stored = yield* api.request(actors.owner, "GET", `${prefix}/accounts/${typedAccount}`);
+    expect(stored.body).toMatchObject({ account: { label: "Work subscription" } });
+    expectRows(yield* inspectRows(listUrl));
+    expectRows(yield* inspectRows(appUrl));
+  });
diff --git a/e2e/support/name-account-no-email.ts b/e2e/support/name-account-no-email.ts
new file mode 100644
index 0000000..4959dfd
--- /dev/null
+++ b/e2e/support/name-account-no-email.ts
@@ -0,0 +1,207 @@
+import { expect } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "./actors.ts";
+import { Api, body } from "./api.ts";
+import { Browser } from "./browser.ts";
+import { Resource } from "./contracts.ts";
+import { Evidence } from "./evidence.ts";
+import { accountNameField, accountNamePrompt, nameAccountDialog } from "./name-account.ts";
+import { accountRow } from "./account-rows.ts";
+import { providerAccountProduct } from "./provider-account-product.ts";
+import { providerAppsCatalog } from "./provider-apps-catalog.ts";
+
+/** The real connection path with a synthetic check that supplies no email. */
+export const nameAccountNoEmailJourney = (
+  workspace: boolean,
+  width = 1280,
+  descriptionOnly?: "prompt" | "edit",
+) =>
+  Effect.gen(function* () {
+    const actors = yield* Actors,
+      api = yield* Api,
+      browser = yield* Browser;
+    const backend = yield* providerAppsCatalog,
+      evidence = yield* Evidence;
+    const prefix = `/api/organizations/${actors.organization.id}`;
+    yield* providerAccountProduct(backend.origin, `${backend.origin}/catalog/index.json`);
+    const installed = yield* api.request(actors.owner, "POST", `${prefix}/apps/install`, {
+      entry: "provider-openai",
+      name: "OpenAI",
+    });
+    expect(installed.status).toBe(200);
+    const app = (yield* body(Resource, installed)).id;
+    const accounts: string[] = [];
+    yield* Effect.addFinalizer(() =>
+      Effect.gen(function* () {
+        yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app}`);
+        for (const id of accounts)
+          yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${id}`);
+      }).pipe(Effect.orDie),
+    );
+    yield* backend.answerCheck({
+      result: workspace
+        ? { accountInfo: { displayName: "Design workspace", username: "designer" } }
+        : {},
+    });
+    const held = yield* backend.holdCheck;
+    yield* browser.login(actors.owner);
+    yield* browser.use("Set the naming viewport", (page) =>
+      page.setViewportSize({ width, height: 900 }),
+    );
+    yield* browser.use("Open the no-email service", (page) =>
+      page.goto(`/org/${actors.organization.slug}/apps/${app}?view=accounts`),
+    );
+    const submitted = yield* browser.use("Connect the synthetic no-email account", (page) =>
+      page
+        .getByRole("button", { name: "Connect new account", exact: true })
+        .click()
+        .then(() =>
+          Promise.all([
+            page.waitForResponse(
+              (response) =>
+                response.request().method() === "GET" &&
+                /\/connections\/[^/]+\/interactive\/status$/.test(new URL(response.url()).pathname),
+            ),
+            page
+              .getByRole("button", { name: "Sign in with ChatGPT subscription", exact: true })
+              .click(),
+          ]),
+        )
+        .then(([response]) => response.json() as Promise<unknown>),
+    );
+    const { account } = yield* Schema.decodeUnknownEffect(Schema.Struct({ account: Resource }))(
+      submitted,
+    );
+    accounts.push(account.id);
+    yield* browser.use("The no-email account asks for a name", accountNamePrompt);
+    yield* held.started;
+    yield* Effect.all(
+      [
+        browser.use("The account check completes", (page) =>
+          page.waitForResponse(
+            (response) =>
+              new URL(response.url()).pathname === `${prefix}/accounts/${account.id}/health`,
+          ),
+        ),
+        held.release,
+      ],
+      { concurrency: "unbounded" },
+    );
+    if (workspace)
+      yield* browser.use("The workspace name is suggested", (page) =>
+        accountNameField(page).and(page.locator('input[value="Design workspace"]')).waitFor(),
+      );
+    else
+      yield* browser.use("The successful unnamed check settles", (page) =>
+        nameAccountDialog(page)
+          .getByText("Checking account…", { exact: true })
+          .waitFor({ state: "hidden" }),
+      );
+    const naming = yield* browser.use("Read the no-email suggestion", (page) =>
+      Promise.all([
+        accountNameField(page).inputValue(),
+        accountNameField(page).getAttribute("placeholder"),
+        nameAccountDialog(page)
+          .getByRole("status")
+          .allTextContents()
+          .then((texts) => texts.filter(Boolean)),
+        nameAccountDialog(page).getByRole("button", { name: "Try again", exact: true }).count(),
+        nameAccountDialog(page)
+          .getByRole("button", { name: "Save name", exact: true })
+          .isDisabled(),
+      ]),
+    );
+    if (descriptionOnly === "prompt") {
+      yield* browser.use("Save a description without naming", (page) => {
+        const dialog = nameAccountDialog(page);
+        return dialog
+          .getByRole("textbox", { name: "Description for agents", exact: true })
+          .fill("Workspace used for reading.")
+          .then(() => dialog.getByRole("button", { name: "Save name", exact: true }).click())
+          .then(() => dialog.waitFor({ state: "hidden" }));
+      });
+      expect(
+        (yield* api.request(actors.owner, "GET", prefix + "/accounts/" + account.id)).body,
+      ).toMatchObject({
+        account: { label: "Default", description: "Workspace used for reading." },
+      });
+      return;
+    }
+    yield* browser.use("Close without naming", (page) =>
+      page.keyboard
+        .press("Escape")
+        .then(() => nameAccountDialog(page).waitFor({ state: "hidden" }))
+        .then(() => page.goto(`/org/${actors.organization.slug}/accounts`)),
+    );
+    const title = workspace ? "Design workspace" : "OpenAI Subscription";
+    yield* browser.use("Setup uses the account kind and never a generated label", (page) =>
+      page
+        .goto("/org/" + actors.organization.slug + "/setup/accounts")
+        .then(() =>
+          page
+            .getByRole("group", { name: "OpenAI", exact: true })
+            .getByText(title, { exact: true })
+            .waitFor(),
+        )
+        .then(() => page.getByRole("group", { name: "OpenAI", exact: true }).textContent())
+        .then((text) => expect(text).not.toContain("Default"))
+        .then(() => page.goto("/org/" + actors.organization.slug + "/accounts")),
+    );
+    yield* browser.use("The saved row uses its fallback", (page) =>
+      accountRow(page, title).waitFor(),
+    );
+    yield* browser.use("Rename the saved generated label", (page) =>
+      accountRow(page, title)
+        .getByRole("button", { name: `Manage ${title}`, exact: true })
+        .click()
+        .then(() => page.getByRole("menuitem", { name: "Edit details", exact: true }).click())
+        .then(() => page.getByRole("dialog", { name: "Edit account", exact: true }).waitFor()),
+    );
+    yield* browser.use("The saved account is ready to edit", (page) =>
+      page
+        .getByRole("dialog", { name: "Edit account", exact: true })
+        .getByRole("button", { name: "Save", exact: true })
+        .and(page.locator(":enabled"))
+        .waitFor(),
+    );
+    if (descriptionOnly === "edit") {
+      yield* browser.use("Save only the generated account's description", (page) => {
+        const dialog = page.getByRole("dialog", { name: "Edit account", exact: true });
+        return dialog
+          .getByRole("textbox", { name: "Description for agents", exact: true })
+          .fill("Workspace used for reading.")
+          .then(() => dialog.getByRole("button", { name: "Save", exact: true }).click())
+          .then(() => dialog.waitFor({ state: "hidden" }));
+      });
+      expect(
+        (yield* api.request(actors.owner, "GET", prefix + "/accounts/" + account.id)).body,
+      ).toMatchObject({
+        account: { label: "Default", description: "Workspace used for reading." },
+      });
+      return;
+    }
+    const rename = yield* browser.use("Read the rename field", (page) => {
+      const field = page
+        .getByRole("dialog", { name: "Edit account", exact: true })
+        .getByRole("textbox", { name: "Account name", exact: true });
+      return Promise.all([field.inputValue(), field.getAttribute("placeholder")]);
+    });
+    yield* evidence.json("no-email-name-states.json", { workspace, naming, rename });
+    expect(naming[0]).toBe(workspace ? "Design workspace" : "");
+    expect(naming[2]).toEqual([]);
+    expect(naming[3]).toBe(0);
+    expect(naming[4]).toBe(false);
+    expect(rename).toEqual(["", title]);
+    yield* browser.use("Save an authored name", (page) => {
+      const dialog = page.getByRole("dialog", { name: "Edit account", exact: true });
+      return dialog
+        .getByRole("textbox", { name: "Account name", exact: true })
+        .fill("My workspace")
+        .then(() => dialog.getByRole("button", { name: "Save", exact: true }).click())
+        .then(() => dialog.waitFor({ state: "hidden" }))
+        .then(() => accountRow(page, "My workspace").waitFor());
+    });
+    expect(
+      (yield* api.request(actors.owner, "GET", `${prefix}/accounts/${account.id}`)).body,
+    ).toMatchObject({ account: { label: "My workspace" } });
+  });
diff --git a/e2e/support/name-account-reconnect.ts b/e2e/support/name-account-reconnect.ts
new file mode 100644
index 0000000..8746f1e
--- /dev/null
+++ b/e2e/support/name-account-reconnect.ts
@@ -0,0 +1,78 @@
+import { randomUUID } from "node:crypto";
+import { expect } from "@effect/vitest";
+import { Effect } from "effect";
+import { Actors } from "./actors.ts";
+import { Api, body } from "./api.ts";
+import { Browser } from "./browser.ts";
+import { Resource } from "./contracts.ts";
+import { appsManifest } from "./apps-release.ts";
+import { rowMenuName } from "./account-choices.ts";
+
+/** Saved unnamed credentials keep a readable title in the reconnect notice. */
+export const nameAccountReconnect = (width: number) =>
+  Effect.gen(function* () {
+    const actors = yield* Actors,
+      api = yield* Api,
+      browser = yield* Browser;
+    const prefix = "/api/organizations/" + actors.organization.id;
+    const deployed = yield* api.request(actors.owner, "POST", prefix + "/apps/deploy", {
+      name: "Reconnect fixture",
+      files: [
+        {
+          path: "index.ts",
+          content:
+            'import {defineApp,defineProvider,secrets,object,string,router} from "apps"; const service=defineProvider({name:"Reconnect fixture",auth:{key:secrets({label:"API key",fields:object({token:string()})})}}); export default defineApp({user:{accounts:{service}}},{tools:router({})});',
+        },
+        appsManifest,
+      ],
+    });
+    expect(deployed.status).toBe(200);
+    const app = (yield* body(Resource, deployed)).id;
+    const connected = yield* api.request(
+      actors.owner,
+      "POST",
+      prefix + "/apps/" + app + "/accounts/user/service",
+      { creation: randomUUID(), method: "key", fields: { token: "synthetic-reconnect" } },
+    );
+    expect(connected.status).toBe(200);
+    const account = (yield* body(Resource, connected)).id;
+    expect(
+      (yield* api.request(
