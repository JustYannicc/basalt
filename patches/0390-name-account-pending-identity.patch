diff --git a/e2e/support/local-name-account-check.ts b/e2e/support/local-name-account-check.ts
new file mode 100644
index 0000000..0c416e2
--- /dev/null
+++ b/e2e/support/local-name-account-check.ts
@@ -0,0 +1,156 @@
+import { expect } from "@effect/vitest";
+import { Effect, Redacted, Schema } from "effect";
+import { Api, body } from "./api.ts";
+import { Browser } from "./browser.ts";
+import { Target } from "./platform.ts";
+import { appsManifest } from "./apps-release.ts";
+import { providerAppsCatalog } from "./provider-apps-catalog.ts";
+import { accountNameField, accountNamePrompt, nameAccountDialog } from "./name-account.ts";
+
+/** An ordinary local connection whose external check is held, refused and retried. */
+export const localNameAccountCheck = (width: number) =>
+  Effect.gen(function* () {
+    const api = yield* Api,
+      browser = yield* Browser,
+      target = yield* Target;
+    const backend = yield* providerAppsCatalog,
+      session = yield* api.session();
+    const headers = { authorization: "Bearer " + Redacted.value(target.apiKey) };
+    const source = [
+      'import { defineApp, defineProvider, secrets, object, string, router, decodeJson } from "apps";',
+      'const service = defineProvider({ name:"Local check fixture", hosts:[' +
+        JSON.stringify(new URL(backend.origin).host) +
+        '], auth:{ key:secrets({label:"API key",fields:object({token:string()})}) },',
+      "async health({fetch,signal}) { return decodeJson(await fetch(" +
+        JSON.stringify(backend.origin + "/name-check") +
+        ",{signal}),object({accountInfo:object({displayName:string()}).optional()})); }});",
+      "export default defineApp({user:{accounts:{service}}},{tools:router({})});",
+    ].join("\n");
+    const deployed = yield* session.send(
+      "POST",
+      "/v1/apps/deploy",
+      {
+        owner: "local",
+        name: "Local account check",
+        files: [{ path: "index.ts", content: source }, appsManifest],
+      },
+      headers,
+    );
+    expect(deployed.status).toBe(200);
+    const { app } = yield* body(
+      Schema.Struct({ app: Schema.Struct({ id: Schema.String }) }),
+      deployed,
+    );
+    let account: string | undefined;
+    yield* Effect.addFinalizer(() =>
+      Effect.gen(function* () {
+        yield* session.send("DELETE", "/v1/apps/" + app.id, undefined, headers);
+        if (account) yield* session.send("DELETE", "/v1/accounts/" + account, undefined, headers);
+      }).pipe(Effect.orDie),
+    );
+    const pairing = yield* session.send("POST", "/auth/pair", undefined, headers);
+    const { url } = yield* body(Schema.Struct({ url: Schema.String }), pairing);
+    yield* browser.use("Control the account-check deadline", (page) => page.clock.install());
+    yield* browser.use("Pair the local account-check browser", (page) =>
+      page.goto(url).then(() => page.getByRole("heading", { name: /^Apps/ }).waitFor()),
+    );
+    yield* backend.answerCheck({ result: {} });
+    yield* browser.use("Validate the local synthetic credentials", (page) =>
+      page
+        .setViewportSize({ width, height: 900 })
+        .then(() => page.goto("/apps/" + app.id + "?view=accounts"))
+        .then(() => page.getByRole("button", { name: "Connect new account", exact: true }).click())
+        .then(() =>
+          page
+            .getByRole("dialog", { name: "Connect Local check fixture", exact: true })
+            .getByLabel("Token", { exact: true })
+            .fill("synthetic-local-check"),
+        )
+        .then(() =>
+          page
+            .getByRole("dialog", { name: "Connect Local check fixture", exact: true })
+            .getByRole("button", { name: "Validate API key", exact: true })
+            .click(),
+        )
+        .then(() =>
+          page
+            .getByRole("dialog", { name: "Connect Local check fixture", exact: true })
+            .getByRole("button", { name: "Continue", exact: true })
+            .waitFor(),
+        ),
+    );
+    yield* backend.answerCheck({ failure: "unavailable" });
+    const held = yield* backend.holdCheck;
+    const created = yield* browser.use("Save the local synthetic credentials", (page) =>
+      Promise.all([
+        page.waitForResponse(
+          (response) =>
+            response.request().method() === "POST" &&
+            new URL(response.url()).pathname.endsWith("/accounts/user/service/connections"),
+        ),
+        page
+          .getByRole("dialog", { name: "Connect Local check fixture", exact: true })
+          .getByRole("button", { name: "Continue", exact: true })
+          .click(),
+      ]).then(([response]) => response.json() as Promise<unknown>),
+    );
+    account = (yield* Schema.decodeUnknownEffect(Schema.Struct({ id: Schema.String }))(created)).id;
+    yield* browser.use("The local account asks for a name", accountNamePrompt);
+    yield* held.started;
+    const status = yield* browser.use("The pending check is announced", (page) =>
+      nameAccountDialog(page)
+        .getByRole("status")
+        .filter({ hasText: "Checking account…" })
+        .elementHandle(),
+    );
+    expect(
+      yield* browser.use("An unnamed pending account cannot save", (page) =>
+        nameAccountDialog(page)
+          .getByRole("button", { name: "Save name", exact: true })
+          .isDisabled(),
+      ),
+    ).toBe(true);
+    yield* browser.use("The local check reaches its ten-second fallback", (page) =>
+      page.clock.fastForward(10_001),
+    );
+    yield* browser.use("A timed-out check offers recovery", (page) =>
+      nameAccountDialog(page).getByText("Couldn't check this account.", { exact: true }).waitFor(),
+    );
+    yield* held.release;
+    yield* browser.use("The failed local check offers retry", (page) =>
+      nameAccountDialog(page).getByText("Couldn't check this account.", { exact: true }).waitFor(),
+    );
+    expect(
+      yield* browser.use("The same live region announces the failure", (page) =>
+        nameAccountDialog(page)
+          .getByRole("status")
+          .evaluate((node, previous) => node === previous, status),
+      ),
+    ).toBe(true);
+    yield* backend.answerCheck({ result: { accountInfo: { displayName: "Local workspace" } } });
+    const retried = yield* backend.holdCheck;
+    yield* browser.use("Retry the local check", (page) =>
+      nameAccountDialog(page).getByRole("button", { name: "Try again", exact: true }).click(),
+    );
+    yield* retried.started;
+    yield* browser.use("The retry is announced", (page) =>
+      nameAccountDialog(page).getByText("Checking account…", { exact: true }).waitFor(),
+    );
+    yield* retried.release;
+    yield* browser.use("The successful check supplies a workspace", (page) =>
+      accountNameField(page).and(page.locator('input[value="Local workspace"]')).waitFor(),
+    );
+    expect(
+      yield* browser.use("The live region remains after success", (page) =>
+        nameAccountDialog(page)
+          .getByRole("status")
+          .evaluate((node, previous) => node === previous, status),
+      ),
+    ).toBe(true);
+    yield* browser.use("Save the checked local account", (page) =>
+      nameAccountDialog(page)
+        .getByRole("button", { name: "Save name", exact: true })
+        .click()
+        .then(() => nameAccountDialog(page).waitFor({ state: "hidden" })),
+    );
+  });
diff --git a/e2e/support/name-account-authored.ts b/e2e/support/name-account-authored.ts
