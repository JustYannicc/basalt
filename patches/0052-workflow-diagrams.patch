diff --git a/packages/ui/src/implementation/dashboard/workflow-diagram-canvas.tsx b/packages/ui/src/implementation/dashboard/workflow-diagram-canvas.tsx
new file mode 100644
index 0000000..42d46d8
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/workflow-diagram-canvas.tsx
@@ -0,0 +1,193 @@
+import type { App } from "@executor-js/sdk";
+import { roundedPath, type WorkflowLayout } from "@executor-js/workflow-graph/layout";
+import { HugeiconsIcon } from "@hugeicons/react";
+import { MinusSignIcon, PlusSignIcon } from "@hugeicons/core-free-icons";
+import { useEffect, useMemo, useRef, useState } from "react";
+import { Button } from "../components/button.tsx";
+import { cn } from "../lib/utils.ts";
+import { Box, Card } from "./workflow-diagram-cards.tsx";
+
+/**
+ * A laid-out workflow: boxes underneath, then the connecting lines and option labels, then the
+ * cards. It fits the panel's width by default, down to a size that stays readable and scrolls
+ * sideways past that; the zoom controls step from there.
+ */
+
+const ZOOM_STEP = 0.15;
+const MIN_FIT = 0.75;
+const MIN_ZOOM = 0.3;
+const MAX_ZOOM = 1.5;
+
+export function WorkflowCanvas({
+  app,
+  layout,
+  input,
+  selected,
+  onSelect,
+  onOpenWorkflow,
+}: {
+  readonly app: App;
+  readonly layout: WorkflowLayout;
+  readonly input: ReadonlyArray<string>;
+  readonly selected: string;
+  readonly onSelect: (id: string) => void;
+  readonly onOpenWorkflow: (name: string, step: string) => void;
+}) {
+  const frame = useRef<HTMLDivElement>(null);
+  const [available, setAvailable] = useState<number>();
+  const [zoom, setZoom] = useState<number>();
+  useEffect(() => {
+    const element = frame.current;
+    if (!element) return;
+    const observer = new ResizeObserver(([entry]) => setAvailable(entry?.contentRect.width));
+    observer.observe(element);
+    return () => observer.disconnect();
+  }, []);
+  const fit = available ? Math.max(MIN_FIT, Math.min(1, available / layout.width)) : 1;
+  const scale = zoom ?? fit;
+  // Boxes and cards in reading order, so Tab follows the drawing; z-index keeps boxes underneath.
+  const items = useMemo(
+    () =>
+      [
+        ...layout.boxes.map((box) => ({ kind: "box" as const, box, x: box.x, y: box.y })),
+        ...layout.cards.map((card) => ({ kind: "card" as const, card, x: card.x, y: card.y })),
+      ].sort((a, b) => a.y - b.y || a.x - b.x),
+    [layout],
+  );
+  return (
+    <div className="relative min-w-0 bg-muted bg-[radial-gradient(circle_at_1px_1px,var(--border)_1px,transparent_0)] bg-size-[18px_18px]">
+      <div ref={frame} className="max-h-[560px] overflow-auto px-4 py-7 [scrollbar-gutter:stable]">
+        <div
+          className="mx-auto"
+          style={{ width: layout.width * scale, height: layout.height * scale }}
+        >
+          <div
+            className="relative origin-top-left"
+            style={{ width: layout.width, height: layout.height, transform: `scale(${scale})` }}
+          >
+            <Edges layout={layout} />
+            {layout.labels.map((label, index) => (
+              <span
+                // Labels have no identity of their own; their order is fixed for one layout.
+                key={index}
+                className={cn(
+                  "pointer-events-none absolute z-[2] -translate-x-1/2 rounded-full border bg-background px-2 text-[11px] leading-[18px] whitespace-nowrap",
+                  label.failure && "border-transparent bg-transparent font-medium text-destructive",
+                )}
+                style={{ left: label.x, top: label.y }}
+              >
+                {label.text}
+              </span>
+            ))}
+            {items.map((item) =>
+              item.kind === "box" ? (
+                <Box
+                  key={item.box.id}
+                  box={item.box}
+                  selected={selected === item.box.id}
+                  onSelect={onSelect}
+                />
+              ) : (
+                <Card
+                  key={item.card.id}
+                  app={app}
+                  card={item.card}
+                  input={input}
+                  selected={selected === item.card.id}
+                  onSelect={onSelect}
+                  onOpenWorkflow={onOpenWorkflow}
+                />
+              ),
+            )}
+          </div>
+        </div>
+      </div>
+      <div className="absolute bottom-3 left-3 flex overflow-hidden rounded-md border bg-background">
+        <Button
+          variant="ghost"
+          size="xs"
+          className="rounded-none"
+          aria-pressed={zoom === undefined}
+          onClick={() => setZoom(undefined)}
+        >
+          Fit
+        </Button>
+        <Button
+          variant="ghost"
+          size="icon-xs"
+          className="rounded-none border-l"
+          aria-label="Zoom out"
+          disabled={scale <= MIN_ZOOM}
+          onClick={() => setZoom(Math.max(MIN_ZOOM, scale - ZOOM_STEP))}
+        >
+          <HugeiconsIcon icon={MinusSignIcon} strokeWidth={2} aria-hidden />
+        </Button>
+        <Button
+          variant="ghost"
+          size="icon-xs"
+          className="rounded-none border-l"
+          aria-label="Zoom in"
+          disabled={scale >= MAX_ZOOM}
+          onClick={() => setZoom(Math.min(MAX_ZOOM, scale + ZOOM_STEP))}
+        >
+          <HugeiconsIcon icon={PlusSignIcon} strokeWidth={2} aria-hidden />
+        </Button>
+      </div>
+    </div>
+  );
+}
+
+function Edges({ layout }: { readonly layout: WorkflowLayout }) {
+  return (
+    <svg
+      aria-hidden
+      className="pointer-events-none absolute inset-0 z-[1] overflow-visible"
+      width={layout.width}
+      height={layout.height}
+    >
+      <defs>
+        <marker
+          id="workflow-arrow"
+          viewBox="0 0 8 8"
+          refX="7"
+          refY="4"
+          markerWidth="7"
+          markerHeight="7"
+          orient="auto"
+        >
+          <path d="M0 .5L7.5 4 0 7.5z" className="fill-muted-foreground/80" />
+        </marker>
+        <marker
+          id="workflow-arrow-failure"
+          viewBox="0 0 8 8"
+          refX="7"
+          refY="4"
+          markerWidth="7"
+          markerHeight="7"
+          orient="auto"
+        >
+          <path d="M0 .5L7.5 4 0 7.5z" className="fill-destructive/70" />
+        </marker>
+      </defs>
+      {layout.edges.map((edge, index) => (
+        <path
+          // An edge is identified by its ends and option; two can share both, so order breaks ties.
+          key={`${edge.from}:${edge.to}:${edge.arm?.index}:${index}`}
+          d={roundedPath(edge.points, 8)}
+          fill="none"
+          strokeWidth={1.5}
+          strokeLinejoin="round"
+          strokeDasharray={edge.failure ? "4 4" : undefined}
+          className={edge.failure ? "stroke-destructive/70" : "stroke-muted-foreground/80"}
+          markerEnd={
+            edge.to === null
+              ? undefined
+              : edge.failure
+                ? "url(#workflow-arrow-failure)"
+                : "url(#workflow-arrow)"
+          }
+        />
+      ))}
+    </svg>
+  );
+}
diff --git a/packages/ui/src/implementation/dashboard/workflow-diagram-cards.tsx b/packages/ui/src/implementation/dashboard/workflow-diagram-cards.tsx
new file mode 100644
index 0000000..3a992f6
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/workflow-diagram-cards.tsx
@@ -0,0 +1,294 @@
+import { HugeiconsIcon } from "@hugeicons/react";
+import {
+  CodeIcon,
+  LayoutTwoColumnIcon,
+  DatabaseAddIcon,
+  DatabaseIcon,
+  GitForkIcon,
+  HourglassIcon,
+  PlayCircleIcon,
+  RepeatIcon,
+  Shield01Icon,
+  Timer01Icon,
+  WorkflowSquare01Icon,
+  ArrowUpRight01Icon,
+} from "@hugeicons/core-free-icons";
+import type { App } from "@executor-js/sdk";
+import type { StepNode, WorkflowNode } from "@executor-js/workflow-graph/contracts/graph";
+import type { LayoutBox, LayoutCard } from "@executor-js/workflow-graph/layout";
+import type { ReactNode } from "react";
+import { cn } from "../lib/utils.ts";
+import { ProviderIcon } from "./common.tsx";
+import { providerDisplayUrl } from "../../contracts/dashboard.ts";
+
+/** The cards and boxes a workflow is drawn with, and the words and tiles they share with the details panel. */
+
+const frame =
+  "absolute z-[2] flex cursor-pointer items-center gap-3 border bg-background px-3 text-left shadow-[0_1px_2px_#0000000a] outline-none transition-[border-color,box-shadow] duration-150 hover:border-foreground/25 focus-visible:ring-2 focus-visible:ring-ring";
+const selectedFrame =
+  "border-primary shadow-[0_0_0_3px_color-mix(in_srgb,var(--primary)_10%,transparent)] hover:border-primary";
+
+const END_LABEL = { done: "Done", fails: "Fails", next: "Next", exit: "Exit loop" } as const;
+
+export function Card({
+  app,
+  card,
+  input,
+  selected,
+  onSelect,
+  onOpenWorkflow,
+}: {
+  readonly app: App;
+  readonly card: LayoutCard;
+  readonly input: ReadonlyArray<string>;
+  readonly selected: boolean;
+  readonly onSelect: (id: string) => void;
+  readonly onOpenWorkflow: (name: string, step: string) => void;
+}) {
+  const style = { left: card.x, top: card.y, width: card.width, height: card.height };
+  if (card.kind === "start")
+    return (
+      <button
+        type="button"
+        data-workflow-node="start"
+        aria-current={selected ? "true" : undefined}
+        onClick={() => onSelect(card.id)}
+        className={cn(frame, "rounded-[10px]", selected && selectedFrame)}
+        style={style}
+      >
+        <span className="flex size-8.5 shrink-0 items-center justify-center rounded-[8px] bg-primary text-primary-foreground">
+          <HugeiconsIcon icon={PlayCircleIcon} size={17} strokeWidth={1.7} aria-hidden />
+        </span>
+        <CardText
+          kind={input.length > 0 ? "Starts with" : "Start"}
+          label={input.length > 0 ? input.join(", ") : "No input"}
+        />
+      </button>
+    );
+  const node = card.node;
+  if (node.type === "end")
+    return (
+      <span
+        data-workflow-node="end"
+        className={cn(
+          "absolute z-[2] flex items-center justify-center rounded-full border bg-accent text-[11px] font-medium text-muted-foreground",
+          node.outcome === "fails" && "text-destructive",
+        )}
+        style={style}
+      >
+        {END_LABEL[node.outcome]}
+      </span>
+    );
+  if (node.type === "branch")
+    return (
+      <button
+        type="button"
+        data-workflow-node="decision"
+        title={node.label.text}
+        aria-current={selected ? "true" : undefined}
+        aria-label={`Decision: ${node.label.text}`}
+        onClick={() => onSelect(card.id)}
+        className={cn(frame, "rounded-full pr-5", selected && selectedFrame)}
+        style={style}
+      >
+        {/* The diamond is what tells a decision from a step at a glance. */}
+        <span className="mx-0.5 flex size-6.5 shrink-0 rotate-45 items-center justify-center rounded-md bg-primary text-primary-foreground">
+          <HugeiconsIcon
+            icon={GitForkIcon}
+            size={13}
+            strokeWidth={2}
+            className="-rotate-45"
+            aria-hidden
+          />
+        </span>
+        <CardText kind="Decision" label={node.label.text} mono />
+      </button>
+    );
+  if (node.type !== "step") return null;
+  const workflow = node.uses.find((use) => use.kind === "workflow");
+  return (
+    <>
+      <button
+        type="button"
+        data-workflow-node="step"
+        title={node.label.text}
+        aria-current={selected ? "true" : undefined}
+        onClick={() => onSelect(card.id)}
+        className={cn(frame, "rounded-[10px]", selected && selectedFrame)}
+        style={style}
+      >
+        <StepTile app={app} node={node} />
+        <CardText kind={stepKind(node)} label={<StepName node={node} />} />
+      </button>
+      {workflow?.kind === "workflow" && (
+        <button
+          type="button"
+          aria-label={`Open ${workflow.name}`}
+          onClick={() => onOpenWorkflow(workflow.name, node.label.text)}
+          className="absolute z-[3] inline-flex h-6 -translate-x-full items-center gap-1 rounded-full border border-input bg-background px-2 text-[11px] font-medium outline-none hover:border-foreground/40 focus-visible:ring-2 focus-visible:ring-ring"
+          style={{ left: card.x + card.width - 12, top: card.y + card.height - 12 }}
+        >
+          <HugeiconsIcon icon={WorkflowSquare01Icon} size={11} strokeWidth={2} aria-hidden />
+          {workflow.name}
+          <HugeiconsIcon icon={ArrowUpRight01Icon} size={11} strokeWidth={2} aria-hidden />
+        </button>
+      )}
+    </>
+  );
+}
+
+function CardText({
+  kind,
+  label,
+  mono = false,
+}: {
+  readonly kind: ReactNode;
+  readonly label: ReactNode;
+  readonly mono?: boolean;
+}) {
+  return (
+    <span className="flex min-w-0 flex-1 flex-col gap-px">
+      <span className="truncate text-[11px] text-muted-foreground">{kind}</span>
+      <span
+        className={cn(
+          "truncate text-[13.5px] font-medium",
+          mono && "font-mono text-[12.5px] tracking-normal",
+        )}
+      >
+        {label}
+      </span>
+    </span>
+  );
+}
+
+export function StepName({ node }: { readonly node: StepNode }) {
+  if (!node.label.dynamic) return node.label.text;
+  // Templates show `…` for each dynamic part; it reads as a placeholder, not as text.
+  return node.label.text.split("…").map((part, index, parts) => (
+    // The parts of one label never reorder.
+    <span key={index}>
+      {part}
+      {index < parts.length - 1 && <span className="font-normal text-muted-foreground">…</span>}
+    </span>
+  ));
+}
+
+export function stepKind(node: StepNode): ReactNode {
+  const tool = node.uses.find((use) => use.kind === "tool");
+  const host = node.uses.find((use) => use.kind === "host");
+  switch (node.kind) {
+    case "query":
+      return tool?.kind === "tool" ? (
+        <>
+          Query · <span className="font-mono text-[10.5px] text-foreground">{tool.path}</span>
+        </>
+      ) : (
+        "Query"
+      );
+    case "mutation":
+      return tool?.kind === "tool" ? (
+        <>
+          Mutation · <span className="font-mono text-[10.5px] text-foreground">{tool.path}</span>
+        </>
+      ) : (
+        "Mutation"
+      );
+    case "sleep":
+      return "Wait";
+    case "sleepUntil":
+      return "Wait until";
+    case "do":
+      return host?.kind === "host" ? `Step · ${host.host}` : "Step";
+  }
+}
+
+const KIND_ICON = {
+  do: CodeIcon,
+  query: DatabaseIcon,
+  mutation: DatabaseAddIcon,
+  sleep: Timer01Icon,
+  sleepUntil: HourglassIcon,
+} as const;
+
+/** The square at the start of a step: the account's provider, else the host's logo, else the step's kind. */
+export function StepTile({ app, node }: { readonly app: App; readonly node: StepNode }) {
+  const account = node.uses.find((use) => use.kind === "account");
+  const provider =
+    account?.kind === "account" ? app.requirements.accounts[account.slot]?.definition : undefined;
+  if (provider) return <ProviderIcon name={provider.name} url={providerDisplayUrl(provider)} />;
+  const host = node.uses.find((use) => use.kind === "host");
+  if (host?.kind === "host" && declaresHost(app, host.host))
+    return <ProviderIcon name={host.host} url={host.host} />;
+  return (
+    <span className="flex size-8.5 shrink-0 items-center justify-center rounded-[8px] bg-accent text-foreground/80">
+      <HugeiconsIcon icon={KIND_ICON[node.kind]} size={17} strokeWidth={1.7} aria-hidden />
+    </span>
+  );
+}
+
+const BOX_ICON = { loop: RepeatIcon, parallel: LayoutTwoColumnIcon, try: Shield01Icon } as const;
+
+export function Box({
+  box,
+  selected,
+  onSelect,
+}: {
+  readonly box: LayoutBox;
+  readonly selected: boolean;
+  readonly onSelect: (id: string) => void;
+}) {
+  const node = box.node;
+  if (node.type !== "loop" && node.type !== "parallel" && node.type !== "try") return null;
+  return (
+    <div
+      className={cn(
+        "absolute z-0 rounded-[14px] border bg-background/55 transition-[border-color] duration-150",
+        selected ? "border-primary/60" : "border-input/70",
+      )}
+      style={{ left: box.x, top: box.y, width: box.width, height: box.height }}
+    >
+      <button
+        type="button"
+        data-workflow-node={node.type}
+        title={
+          node.type === "loop" && node.detail
+            ? `${boxTitle(node)} · ${node.detail}`
+            : boxTitle(node)
+        }
+        aria-current={selected ? "true" : undefined}
+        onClick={() => onSelect(box.id)}
+        className="flex h-8.5 w-full cursor-pointer items-center gap-1.5 rounded-t-[14px] px-3 text-left text-xs outline-none hover:bg-muted/60 focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring"
+      >
+        <HugeiconsIcon
+          icon={BOX_ICON[node.type]}
+          size={14}
+          strokeWidth={1.7}
+          className="shrink-0 text-muted-foreground"
+          aria-hidden
+        />
+        <span className="truncate font-medium">{boxTitle(node)}</span>
+        {node.type === "loop" && node.detail && (
+          <span className="truncate text-muted-foreground">· {node.detail}</span>
+        )}
+      </button>
+    </div>
+  );
+}
+
+export function boxTitle(node: WorkflowNode): string {
+  if (node.type === "loop") return node.label.text;
+  if (node.type === "parallel") return "At the same time";
+  return "Try";
+}
+
+/**
+ * Logos come from a third-party icon service. Only hosts of providers the app declares are looked
+ * up there, so a private hostname in an app's code is never sent anywhere by drawing it.
+ */
+export function declaresHost(app: App, host: string): boolean {
+  const site = (name: string) => name.split(".").slice(-2).join(".");
+  return Object.values(app.requirements.accounts).some((slot) => {
+    const url = providerDisplayUrl(slot.definition);
+    return url !== null && URL.canParse(url) && site(new URL(url).hostname) === site(host);
+  });
+}
diff --git a/packages/ui/src/implementation/dashboard/workflow-diagram-details.tsx b/packages/ui/src/implementation/dashboard/workflow-diagram-details.tsx
new file mode 100644
index 0000000..0a041a2
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/workflow-diagram-details.tsx
@@ -0,0 +1,325 @@
+import { HugeiconsIcon } from "@hugeicons/react";
+import {
+  GitForkIcon,
+  LayoutTwoColumnIcon,
+  PlayCircleIcon,
+  RepeatIcon,
+  Shield01Icon,
+  WorkflowSquare01Icon,
+} from "@hugeicons/core-free-icons";
+import type { App, SourceFile } from "@executor-js/sdk";
+import type {
+  Reference,
+  WorkflowGraph,
+  WorkflowNode,
+} from "@executor-js/workflow-graph/contracts/graph";
+import type { ComponentProps, ReactNode } from "react";
+import { Code } from "./code.tsx";
+import { useDashboard } from "./context.tsx";
+import { boxTitle, StepName, StepTile, stepKind } from "./workflow-diagram-cards.tsx";
+import {
+  ReferenceRow,
+  Row,
+  StarterRow,
+  UseReference,
+  UseRow,
+} from "./workflow-diagram-references.tsx";
+
+/** What the selected card is, what it uses and the code it came from. */
+
+const MAX_EXCERPT = 16;
+/** The start card shows the declaration through the options and handler signature. */
+const START_EXCERPT = 4;
+
+type IconSvgElement = ComponentProps<typeof HugeiconsIcon>["icon"];
+
+export function WorkflowDetails({
+  app,
+  graph,
+  node,
+  files,
+  onOpenWorkflow,
+  onShowWorkflow,
+}: {
+  readonly app: App;
+  readonly graph: WorkflowGraph;
+  /** `undefined` for the start card. */
+  readonly node: WorkflowNode | undefined;
+  readonly files: ReadonlyArray<SourceFile>;
+  readonly onOpenWorkflow: (name: string, step: string) => void;
+  readonly onShowWorkflow: (name: string) => void;
+}) {
+  if (node === undefined)
+    return <StartDetails app={app} graph={graph} files={files} onShowWorkflow={onShowWorkflow} />;
+  const excerpt = (from: number, to = from) => (
+    <Excerpt app={app} files={files} file={node.file} from={from} to={to} />
+  );
+  switch (node.type) {
+    case "step": {
+      const workflows = node.uses.filter((use) => use.kind === "workflow");
+      return (
+        <Panel
+          tile={<StepTile app={app} node={node} />}
+          kind={stepKind(node)}
+          title={<StepName node={node} />}
+        >
+          <dl className="mb-3.5 grid grid-cols-[82px_minmax(0,1fr)] gap-x-2.5 gap-y-1.5 text-[12.5px]">
+            {node.uses.map((use) => (
+              <UseRow key={JSON.stringify(use)} app={app} use={use} />
+            ))}
+            {node.detail.map((item) => (
+              <Row key={item.name} name={item.name}>
+                {item.value}
+              </Row>
+            ))}
+          </dl>
+          {workflows.length > 0 && (
+            <Section title="Starts">
+              {workflows.map(
+                (use) =>
+                  use.kind === "workflow" && (
+                    <ReferenceRow
+                      key={use.name}
+                      icon={WorkflowSquare01Icon}
+                      title={use.name}
+                      subtitle="Workflow"
+                      onClick={() => onOpenWorkflow(use.name, node.label.text)}
+                    />
+                  ),
+              )}
+            </Section>
+          )}
+          {excerpt(node.line, node.end)}
+        </Panel>
+      );
+    }
+    case "branch":
+      return (
+        <Panel
+          tile={
+            <span className="mx-1 flex size-6.5 shrink-0 rotate-45 items-center justify-center rounded-md bg-primary text-primary-foreground">
+              <HugeiconsIcon
+                icon={GitForkIcon}
+                size={13}
+                strokeWidth={2}
+                className="-rotate-45"
+                aria-hidden
+              />
+            </span>
+          }
+          kind="Decision"
+          title={<span className="font-mono text-[13px] tracking-normal">{node.label.text}</span>}
+        >
+          <dl className="mb-3.5 grid grid-cols-[82px_minmax(0,1fr)] gap-x-2.5 gap-y-1.5 text-[12.5px]">
+            <Row name="Options">{node.arms.map((arm) => arm.label).join(", ")}</Row>
+          </dl>
+          {excerpt(node.line)}
+        </Panel>
+      );
+    case "loop":
+    case "parallel":
+    case "try":
+      return (
+        <Panel
+          tile={
+            <IconTile
+              icon={
+                node.type === "loop"
+                  ? RepeatIcon
+                  : node.type === "parallel"
+                    ? LayoutTwoColumnIcon
+                    : Shield01Icon
+              }
+            />
+          }
+          kind={
+            node.type === "loop"
+              ? "Loop"
+              : node.type === "parallel"
+                ? "Parallel"
+                : "Failure handling"
+          }
+          title={boxTitle(node)}
+        >
+          {node.type === "loop" && node.detail && (
+            <p className="mb-3.5 text-[12.5px] text-muted-foreground">{node.detail}</p>
+          )}
+          {excerpt(node.line)}
+        </Panel>
+      );
+    case "end":
+      return null;
+  }
+}
+
+function StartDetails({
+  app,
+  graph,
+  files,
+  onShowWorkflow,
+}: {
+  readonly app: App;
+  readonly graph: WorkflowGraph;
+  readonly files: ReadonlyArray<SourceFile>;
+  readonly onShowWorkflow: (name: string) => void;
+}) {
+  const uses = new Map<string, Reference>();
+  const collect = (nodes: ReadonlyArray<WorkflowNode>) => {
+    for (const node of nodes) {
+      if (node.type === "step")
+        for (const use of node.uses)
+          if (use.kind === "account" || use.kind === "host") uses.set(JSON.stringify(use), use);
+      if (node.type === "branch") for (const arm of node.arms) collect(arm.body);
+      if (node.type === "loop") collect(node.body);
+      if (node.type === "parallel") for (const branch of node.branches) collect(branch);
+      if (node.type === "try") {
+        collect(node.body);
+        collect(node.failure);
+        collect(node.cleanup);
+      }
+    }
+  };
+  collect(graph.nodes);
+  return (
+    <Panel
+      tile={
+        <span className="flex size-8 shrink-0 items-center justify-center rounded-[8px] bg-primary text-primary-foreground">
+          <HugeiconsIcon icon={PlayCircleIcon} size={17} strokeWidth={1.7} aria-hidden />
+        </span>
+      }
+      kind="Start"
+      title={graph.name}
+    >
+      {graph.input.length > 0 && (
+        <dl className="mb-3.5 grid grid-cols-[82px_minmax(0,1fr)] gap-x-2.5 gap-y-1.5 text-[12.5px]">
+          <Row name="Input">
+            <span className="font-mono text-[11.5px]">{graph.input.join(", ")}</span>
+          </Row>
+        </dl>
+      )}
+      <Section title="Started by">
+        {graph.startedBy.length === 0 ? (
+          <p className="text-[12.5px] text-muted-foreground">
+            Nothing in the app’s code starts it. Start it here or through the API.
+          </p>
+        ) : (
+          graph.startedBy.map((starter) => (
+            <StarterRow
+              key={JSON.stringify(starter)}
+              app={app}
+              starter={starter}
+              onShowWorkflow={onShowWorkflow}
+            />
+          ))
+        )}
+      </Section>
+      {uses.size > 0 && (
+        <Section title="Uses">
+          {[...uses.values()].map((use) => (
+            <UseReference key={JSON.stringify(use)} app={app} use={use} />
+          ))}
+        </Section>
+      )}
+      <Excerpt
+        app={app}
+        files={files}
+        file={graph.file}
+        from={graph.line}
+        to={graph.line + START_EXCERPT - 1}
+      />
+    </Panel>
+  );
+}
+
+function Panel({
+  tile,
+  kind,
+  title,
+  children,
+}: {
+  readonly tile: ReactNode;
+  readonly kind: ReactNode;
+  readonly title: ReactNode;
+  readonly children: ReactNode;
+}) {
+  return (
+    <aside
+      aria-label="Workflow diagram details"
+      className="min-w-0 border-t p-4 @[760px]:border-t-0 @[760px]:border-l"
+    >
+      <div className="mb-3.5 flex items-center gap-3 [&_.provider-icon]:size-8">
+        {tile}
+        <div className="min-w-0">
+          <div className="truncate text-[11px] text-muted-foreground">{kind}</div>
+          <div className="truncate text-sm font-semibold tracking-tight">{title}</div>
+        </div>
+      </div>
+      {children}
+    </aside>
+  );
+}
+
+function Section({ title, children }: { readonly title: string; readonly children: ReactNode }) {
+  return (
+    <section className="mb-4">
+      <h4 className="mb-2 text-[11.5px] font-medium text-muted-foreground">{title}</h4>
+      <div className="grid gap-1.5">{children}</div>
+    </section>
+  );
+}
+
+function IconTile({ icon }: { readonly icon: IconSvgElement }) {
+  return (
+    <span className="flex size-8 shrink-0 items-center justify-center rounded-[8px] bg-accent text-foreground/80">
+      <HugeiconsIcon icon={icon} size={16} strokeWidth={1.7} aria-hidden />
+    </span>
+  );
+}
+
+/** The lines a card was drawn from. */
+function Excerpt({
+  app,
+  files,
+  file,
+  from,
+  to,
+}: {
+  readonly app: App;
+  readonly files: ReadonlyArray<SourceFile>;
+  readonly file: string;
+  readonly from: number;
+  readonly to: number;
+}) {
+  const { AppLink } = useDashboard();
+  const source = files.find((entry) => entry.path === file);
+  if (!source || "encoding" in source || !("content" in source)) return null;
+  const last = Math.min(to, from + MAX_EXCERPT - 1);
+  const lines = source.content.split("\n").slice(from - 1, last);
+  // A call nested in loops starts deep in; the excerpt reads better without the shared indent.
+  const indent = Math.min(
+    ...lines
+      .filter((text) => text.trim() !== "")
+      .map((text) => /^\s*/u.exec(text)?.[0].length ?? 0),
+  );
+  const code = lines.map((text) => text.slice(Number.isFinite(indent) ? indent : 0)).join("\n");
+  return (
+    <section className="mt-1">
+      <h4 className="mb-2 text-[11.5px] font-medium text-muted-foreground">Code</h4>
+      <div className="max-h-72 overflow-hidden rounded-md border [&_.code-view]:max-h-72">
+        <Code code={code} path={file} lineNumbers={false} />
+      </div>
+      <div className="mt-1.5 flex justify-between gap-2 text-[11.5px] text-muted-foreground">
+        <span className="truncate">
+          {file} · {last > from ? `lines ${from}–${last}` : `line ${from}`}
+        </span>
+        <AppLink
+          app={app.id}
+          view="source"
+          className="shrink-0 font-medium text-foreground hover:underline"
+        >
+          Open in Source →
+        </AppLink>
+      </div>
+    </section>
+  );
+}
diff --git a/packages/ui/src/implementation/dashboard/workflow-diagram-references.tsx b/packages/ui/src/implementation/dashboard/workflow-diagram-references.tsx
new file mode 100644
index 0000000..c3efb7f
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/workflow-diagram-references.tsx
@@ -0,0 +1,232 @@
+import { HugeiconsIcon } from "@hugeicons/react";
+import {
+  ArrowRight01Icon,
+  Calendar03Icon,
+  Globe02Icon,
+  ToolsIcon,
+  WebhookIcon,
+  WorkflowSquare01Icon,
+} from "@hugeicons/core-free-icons";
+import type { App } from "@executor-js/sdk";
+import type { Reference, Starter } from "@executor-js/workflow-graph/contracts/graph";
+import type { ComponentProps, ReactNode } from "react";
+import { providerDisplayUrl } from "../../contracts/dashboard.ts";
+import { ProviderIcon } from "./common.tsx";
+import { useDashboard } from "./context.tsx";
+import { declaresHost } from "./workflow-diagram-cards.tsx";
+
+/** Rows that name what a workflow or step uses or is started by, linking to where it lives. */
+
+type IconSvgElement = ComponentProps<typeof HugeiconsIcon>["icon"];
+
+export function Row({ name, children }: { readonly name: string; readonly children: ReactNode }) {
+  return (
+    <>
+      <dt className="text-muted-foreground">{name}</dt>
+      <dd className="m-0 min-w-0 break-words">{children}</dd>
+    </>
+  );
+}
+
+const referenceRow =
+  "flex w-full min-w-0 items-center gap-2.5 rounded-lg border px-2.5 py-1.5 text-left text-[12.5px] hover:bg-muted/60 [&_.provider-icon]:size-6.5 [&_.provider-icon]:rounded-[6px]";
+
+export function ReferenceRow({
+  icon,
+  tile,
+  title,
+  subtitle,
+  onClick,
+}: {
+  readonly icon?: IconSvgElement;
+  readonly tile?: ReactNode;
+  readonly title: ReactNode;
+  readonly subtitle: ReactNode;
+  readonly onClick?: () => void;
+}) {
+  const content = (
+    <>
+      {tile ?? (
+        <span className="flex size-6.5 shrink-0 items-center justify-center rounded-[6px] bg-accent text-foreground/80">
+          {icon && <HugeiconsIcon icon={icon} size={14} strokeWidth={1.7} aria-hidden />}
+        </span>
+      )}
+      <span className="min-w-0 flex-1">
+        <span className="block truncate">{title}</span>
+        <span className="block truncate text-[11px] text-muted-foreground">{subtitle}</span>
+      </span>
+      {onClick && (
+        <HugeiconsIcon
+          icon={ArrowRight01Icon}
+          size={14}
+          className="shrink-0 text-muted-foreground"
+          aria-hidden
+        />
+      )}
+    </>
+  );
+  return onClick ? (
+    <button type="button" className={referenceRow} onClick={onClick}>
+      {content}
+    </button>
+  ) : (
+    <div className={referenceRow}>{content}</div>
+  );
+}
+
+export function StarterRow({
+  app,
+  starter,
+  onShowWorkflow,
+}: {
+  readonly app: App;
+  readonly starter: Starter;
+  readonly onShowWorkflow: (name: string) => void;
+}) {
+  const { AppLink } = useDashboard();
+  switch (starter.kind) {
+    case "workflow":
+      return (
+        <ReferenceRow
+          icon={WorkflowSquare01Icon}
+          title={starter.name}
+          subtitle={`${starter.step} · via ${starter.tool}`}
+          onClick={() => onShowWorkflow(starter.name)}
+        />
+      );
+    case "tool":
+      return (
+        <AppLink app={app.id} view="tools" tool={starter.path} className={referenceRow}>
+          <ReferenceRowContent
+            icon={ToolsIcon}
+            title={<span className="font-mono text-[12px]">{starter.path}</span>}
+            subtitle="Tool"
+          />
+        </AppLink>
+      );
+    case "schedule":
+      return (
+        <AppLink app={app.id} view="schedules" className={referenceRow}>
+          <ReferenceRowContent
+            icon={Calendar03Icon}
+            title={starter.name}
+            subtitle={`Schedule · runs ${starter.tool}`}
+          />
+        </AppLink>
+      );
+    case "webhook":
+      return (
+        <AppLink app={app.id} view="webhooks" className={referenceRow}>
+          <ReferenceRowContent icon={WebhookIcon} title={starter.name} subtitle="Webhook" />
+        </AppLink>
+      );
+  }
+}
+
+function ReferenceRowContent({
+  icon,
+  title,
+  subtitle,
+}: {
+  readonly icon: IconSvgElement;
+  readonly title: ReactNode;
+  readonly subtitle: ReactNode;
+}) {
+  return (
+    <>
+      <span className="flex size-6.5 shrink-0 items-center justify-center rounded-[6px] bg-accent text-foreground/80">
+        <HugeiconsIcon icon={icon} size={14} strokeWidth={1.7} aria-hidden />
+      </span>
+      <span className="min-w-0 flex-1">
+        <span className="block truncate">{title}</span>
+        <span className="block truncate text-[11px] text-muted-foreground">{subtitle}</span>
+      </span>
+      <HugeiconsIcon
+        icon={ArrowRight01Icon}
+        size={14}
+        className="shrink-0 text-muted-foreground"
+        aria-hidden
+      />
+    </>
+  );
+}
+
+/** One thing a step uses, as a row of the step's details. */
+export function UseRow({ app, use }: { readonly app: App; readonly use: Reference }) {
+  const { AppLink } = useDashboard();
+  switch (use.kind) {
+    case "tool":
+      return (
+        <Row name="Tool">
+          <AppLink
+            app={app.id}
+            view="tools"
+            tool={use.path}
+            className="font-mono text-[11.5px] underline decoration-input underline-offset-2"
+          >
+            {use.path}
+          </AppLink>
+        </Row>
+      );
+    case "account":
+      return (
+        <Row name="Account">
+          <AppLink
+            app={app.id}
+            view="accounts"
+            className="underline decoration-input underline-offset-2"
+          >
+            {app.requirements.accounts[use.slot]?.definition.name ?? use.slot}
+          </AppLink>
+          {use.scope && (
+            <span className="text-muted-foreground">
+              {" "}
+              · {use.scope === "app" ? "app account" : "your account"}
+            </span>
+          )}
+        </Row>
+      );
+    case "host":
+      return <Row name="Talks to">{use.host}</Row>;
+    case "workflow":
+      return null;
+  }
+}
+
+/** An account or host in the workflow's summary. */
+export function UseReference({ app, use }: { readonly app: App; readonly use: Reference }) {
+  const { AppLink } = useDashboard();
+  if (use.kind === "host")
+    return (
+      <ReferenceRow
+        {...(declaresHost(app, use.host)
+          ? { tile: <ProviderIcon name={use.host} url={use.host} /> }
+          : { icon: Globe02Icon })}
+        title={use.host}
+        subtitle="Host"
+      />
+    );
+  if (use.kind !== "account") return null;
+  const provider = app.requirements.accounts[use.slot]?.definition;
+  return (
+    <AppLink app={app.id} view="accounts" className={referenceRow}>
+      {provider ? (
+        <ProviderIcon name={provider.name} url={providerDisplayUrl(provider)} />
+      ) : (
+        <span className="flex size-6.5 shrink-0 items-center justify-center rounded-[6px] bg-accent">
+          <HugeiconsIcon icon={Globe02Icon} size={14} strokeWidth={1.7} aria-hidden />
+        </span>
+      )}
+      <span className="min-w-0 flex-1">
+        <span className="block truncate">{provider?.name ?? use.slot}</span>
+        <span className="block truncate text-[11px] text-muted-foreground">Account</span>
+      </span>
+      <HugeiconsIcon
+        icon={ArrowRight01Icon}
+        size={14}
+        className="shrink-0 text-muted-foreground"
+        aria-hidden
+      />
+    </AppLink>
+  );
+}
diff --git a/packages/ui/src/implementation/dashboard/workflow-diagram-section.tsx b/packages/ui/src/implementation/dashboard/workflow-diagram-section.tsx
new file mode 100644
index 0000000..1b777ba
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/workflow-diagram-section.tsx
@@ -0,0 +1,104 @@
+import type { App, Version } from "@executor-js/sdk";
+import { Component, lazy, Suspense, useState, type ComponentType, type ReactNode } from "react";
+import type { FailureProps, Query } from "../../contracts/dashboard.ts";
+import { Button } from "../components/button.tsx";
+import { WorkflowDiagramLoading } from "./app-browser-loading.tsx";
+import { useHydrated } from "../hooks/hydrated.ts";
+import { QueryView } from "./context.tsx";
+import type { Crumb } from "./workflow-diagram.tsx";
+
+/**
+ * The diagram above a workflow's runs. Its code, and the parser in it, load on demand in a browser
+ * after hydration, so a server build drops the import: every module a Worker uploads is compiled
+ * whenever one of its isolates starts. A failed load or a source the diagram trips on stays inside
+ * this frame, so the run history never goes with it.
+ */
+
+/** Starts loading the diagram's code. The module system keeps the loaded module for later calls. */
+export const preloadWorkflowDiagram = () =>
+  import.meta.env.SSR
+    ? Promise.reject(new Error("The workflow diagram renders only in a browser"))
+    : import("./workflow-diagram.tsx");
+
+export function WorkflowDiagramSection<E>({
+  app,
+  source,
+  workflow,
+  trail,
+  onOpenWorkflow,
+  onShowWorkflow,
+  onCrumb,
+  Failure,
+}: {
+  readonly app: App;
+  readonly source: Query<Version, E>;
+  readonly workflow: string;
+  readonly trail: ReadonlyArray<Crumb>;
+  readonly onOpenWorkflow: (name: string, step: string) => void;
+  readonly onShowWorkflow: (name: string) => void;
+  readonly onCrumb: (index: number) => void;
+  readonly Failure: ComponentType<FailureProps<E>>;
+}) {
+  const hydrated = useHydrated();
+  // A new lazy component per attempt: React keeps a failed lazy load and would not ask again.
+  const [attempt, setAttempt] = useState(0);
+  const [Diagram, setDiagram] = useState(() => lazy(preloadWorkflowDiagram));
+  return (
+    <div
+      role="group"
+      aria-label="Workflow diagram"
+      className="@container mb-7 overflow-hidden rounded-lg border"
+    >
+      {!hydrated ? (
+        <WorkflowDiagramLoading />
+      ) : (
+        <QueryView query={source} Failure={Failure} pending={<WorkflowDiagramLoading />}>
+          {(version) => (
+            <DiagramBoundary
+              key={attempt}
+              retry={() => {
+                setDiagram(() => lazy(preloadWorkflowDiagram));
+                setAttempt(attempt + 1);
+              }}
+            >
+              <Suspense fallback={<WorkflowDiagramLoading />}>
+                <Diagram
+                  app={app}
+                  version={version}
+                  workflow={workflow}
+                  trail={trail}
+                  onOpenWorkflow={onOpenWorkflow}
+                  onShowWorkflow={onShowWorkflow}
+                  onCrumb={onCrumb}
+                />
+              </Suspense>
+            </DiagramBoundary>
+          )}
+        </QueryView>
+      )}
+    </div>
+  );
+}
+
+class DiagramBoundary extends Component<
+  { readonly retry: () => void; readonly children: ReactNode },
+  { readonly failed: boolean }
+> {
+  override state = { failed: false };
+
+  static getDerivedStateFromError() {
+    return { failed: true };
+  }
+
+  override render() {
+    if (!this.state.failed) return this.props.children;
+    return (
+      <div className="flex flex-wrap items-center justify-between gap-3 px-4 py-4 text-sm text-muted-foreground">
+        <span>This workflow’s diagram couldn’t be drawn. Its runs below are unaffected.</span>
+        <Button variant="outline" size="sm" onClick={this.props.retry}>
+          Try again
+        </Button>
+      </div>
+    );
+  }
+}
diff --git a/packages/ui/src/implementation/dashboard/workflow-diagram.tsx b/packages/ui/src/implementation/dashboard/workflow-diagram.tsx
new file mode 100644
index 0000000..3a4fe47
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/workflow-diagram.tsx
@@ -0,0 +1,137 @@
+import type { App, Version } from "@executor-js/sdk";
+import type { WorkflowNode } from "@executor-js/workflow-graph/contracts/graph";
+import { deriveAppGraph } from "@executor-js/workflow-graph/derive";
+import { layoutWorkflow } from "@executor-js/workflow-graph/layout";
+import { Fragment, useMemo, useState } from "react";
+import { WorkflowCanvas } from "./workflow-diagram-canvas.tsx";
+import { WorkflowDetails } from "./workflow-diagram-details.tsx";
+
+/**
+ * The selected workflow drawn from the deployed version's own source, above its run history.
+ * Reaching another workflow through a step or a "Started by" entry adds to the breadcrumb trail.
+ * Loaded on demand, so the parser stays out of every other dashboard page. It stays mounted while
+ * the person moves between workflows, so the source is parsed once per version.
+ */
+
+/** A workflow on the way here, and the step that led on when one did. */
+export interface Crumb {
+  readonly workflow: string;
+  readonly step?: string;
+}
+
+export default function WorkflowDiagram({
+  app,
+  version,
+  workflow,
+  trail,
+  onOpenWorkflow,
+  onShowWorkflow,
+  onCrumb,
+}: {
+  readonly app: App;
+  readonly version: Version;
+  readonly workflow: string;
+  readonly trail: ReadonlyArray<Crumb>;
+  readonly onOpenWorkflow: (name: string, step: string) => void;
+  readonly onShowWorkflow: (name: string) => void;
+  readonly onCrumb: (index: number) => void;
+}) {
+  const graphs = useMemo(() => deriveAppGraph(version.files), [version.files]);
+  const graph = graphs.workflows.find((item) => item.name === workflow);
+  const layout = useMemo(() => (graph ? layoutWorkflow(graph) : undefined), [graph]);
+  // A selection belongs to the workflow it was made in; another workflow opens at its start.
+  const [selection, setSelection] = useState({ workflow, id: "start" });
+  const selected = selection.workflow === workflow ? selection.id : "start";
+  const node = useMemo(
+    () => (graph ? findNode(graph.nodes, selected) : undefined),
+    [graph, selected],
+  );
+  return (
+    <>
+      <div className="flex min-h-11 flex-wrap items-center gap-x-2.5 gap-y-1 border-b px-3.5 py-2 text-[13px]">
+        <nav aria-label="Workflow trail" className="flex min-w-0 flex-wrap items-center gap-1.5">
+          {trail.map((crumb, index) => (
+            <Fragment key={`${crumb.workflow}:${index}`}>
+              <button
+                type="button"
+                className="text-muted-foreground hover:text-foreground"
+                onClick={() => onCrumb(index)}
+              >
+                {crumb.workflow}
+              </button>
+              <span className="text-muted-foreground/60" aria-hidden>
+                ›
+              </span>
+              {crumb.step !== undefined && (
+                <>
+                  <span className="text-muted-foreground">{crumb.step}</span>
+                  <span className="text-muted-foreground/60" aria-hidden>
+                    ›
+                  </span>
+                </>
+              )}
+            </Fragment>
+          ))}
+          <span className="font-medium" aria-current="page">
+            {workflow}
+          </span>
+        </nav>
+        {graph && (
+          <span className="text-xs text-muted-foreground">
+            from <span className="font-mono text-[11.5px] text-foreground">{graph.file}</span>
+          </span>
+        )}
+        {graph?.partial && (
+          <span className="text-xs text-muted-foreground">
+            · Only part of this workflow is drawn; the rest is too large or repeats itself
+          </span>
+        )}
+      </div>
+      {graph && layout ? (
+        <div className="grid grid-cols-1 @[760px]:grid-cols-[minmax(0,1fr)_320px]">
+          <WorkflowCanvas
+            app={app}
+            layout={layout}
+            input={graph.input}
+            selected={selected}
+            onSelect={(id) => setSelection({ workflow, id })}
+            onOpenWorkflow={onOpenWorkflow}
+          />
+          <WorkflowDetails
+            app={app}
+            graph={graph}
+            node={node}
+            files={version.files}
+            onOpenWorkflow={onOpenWorkflow}
+            onShowWorkflow={onShowWorkflow}
+          />
+        </div>
+      ) : (
+        <p className="px-4 py-5 text-sm text-muted-foreground">
+          This workflow isn’t declared in the app’s{" "}
+          <code className="font-mono text-xs">defineApp</code> in a way the diagram can read, so it
+          can’t be drawn.
+        </p>
+      )}
+    </>
+  );
+}
+
+function findNode(nodes: ReadonlyArray<WorkflowNode>, id: string): WorkflowNode | undefined {
+  for (const node of nodes) {
+    if (node.id === id) return node;
+    const inner =
+      node.type === "branch"
+        ? node.arms.flatMap((arm) => arm.body)
+        : node.type === "loop"
+          ? node.body
+          : node.type === "parallel"
+            ? node.branches.flat()
+            : node.type === "try"
+              ? [...node.body, ...node.failure, ...node.cleanup]
+              : [];
+    const found = findNode(inner, id);
+    if (found) return found;
+  }
+  return undefined;
+}
