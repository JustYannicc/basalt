+  }
+
+  /** Nodes from an expression: a path through them stops when every way through ends. */
+  private flow(nodes: WorkflowNode[]): Block {
+    return { ...EMPTY, nodes, ends: terminal(nodes) };
+  }
+
+  statement(node: t.Statement, scope: Scope): Block {
