+++ b/apps/hosted/testing/management-provisioning.ts
@@ -0,0 +1,110 @@
+/** Commit notifications for readiness in a runner-owned disposable database. */
+import type { Pool, PoolClient } from "pg";
+import { Schema } from "effect";
+
+const channel = "e2e_management_provisioned";
+const Readiness = Schema.Array(Schema.Struct({ ready: Schema.Boolean }));
+class ManagementProvisioningFailed extends Schema.TaggedError<ManagementProvisioningFailed>()(
+  "ManagementProvisioningFailed",
+  {},
+) {}
+
+export const installManagementNotifications = (database: Pool) =>
+  database.query(`create or replace function e2e_management_provisioned() returns trigger language plpgsql as $$
+    begin perform pg_notify('e2e_management_provisioned', ''); return null; end $$;
+    create or replace trigger e2e_management_metadata after update of metadata on organization
+      for each statement execute function e2e_management_provisioned();
+    create or replace trigger e2e_management_links after insert or update or delete on hosted_app_account_links
+      for each statement execute function e2e_management_provisioned()`);
+
+/** The metadata and link must be visible in the same committed snapshot. */
+const managementReadiness = `select coalesce(
+  (team.metadata::jsonb->'executorDefaults'->>'installed')::boolean, false)
+  and exists (select 1 from executor_accounts account join hosted_app_account_links link
+    on link.account = account.id
+    where account.id = team.metadata::jsonb->'executorKeyAccounts'->>$2
+      and account.owner = 'organization:' || team.id
+      and link.app = team.metadata::jsonb->'executorDefaults'->>'app') as ready
+  from organization team where team.id = $1`;
+
+export const awaitManagementProvisioning = async (
+  database: Pool,
+  organization: string,
+  user: string,
+  signal: AbortSignal,
+) => {
+  let client: PoolClient | undefined;
+  let released = false;
+  let revision = 0;
+  let wake = () => {};
+  let disconnected = false;
+  let interrupt = () => {};
+  const interrupted = new Promise<never>((_, reject) => {
+    interrupt = () => reject(new ManagementProvisioningFailed());
+  });
+  // An already-aborted signal can reject before the first operation subscribes.
+  void interrupted.catch(() => {});
+  const release = (discard: boolean) => {
+    if (client !== undefined && !released) {
+      released = true;
+      client.release(discard);
+    }
+  };
+  const abort = () => {
+    release(true);
+    interrupt();
+  };
+  const changed = () => {
+    revision++;
+    wake();
+  };
+  const failed = () => {
+    disconnected = true;
+    abort();
+  };
+  const until = <A>(work: () => Promise<A>) => {
+    if (signal.aborted || disconnected) throw new ManagementProvisioningFailed();
+    return Promise.race([work(), interrupted]);
+  };
+  signal.addEventListener("abort", abort, { once: true });
+  try {
+    const acquired = await until(() =>
+      database.connect().then((value) => {
+        // pg cannot remove a queued checkout. Dispose it if cancellation won the race.
+        if (signal.aborted) {
+          value.release(true);
+          throw new ManagementProvisioningFailed();
+        }
+        client = value;
+        return value;
+      }),
+    );
+    acquired.on("notification", changed);
+    acquired.on("error", failed);
+    // Subscribe before reading; a completion during the read also advances the revision.
+    await until(() => acquired.query(`listen ${channel}`));
+    for (;;) {
+      const observed = revision;
+      const [state] = Schema.decodeUnknownSync(Readiness)(
+        (await until(() => acquired.query(managementReadiness, [organization, user]))).rows,
+      );
+      if (state === undefined) throw new ManagementProvisioningFailed();
+      if (state.ready) break;
+      if (revision !== observed) continue;
+      await until(
+        () =>
+          new Promise<void>((resolve) => {
+            wake = resolve;
+          }),
+      );
+    }
+    await until(() => acquired.query(`unlisten ${channel}`));
+    if (signal.aborted || disconnected) throw new ManagementProvisioningFailed();
+    release(false);
+  } finally {
+    release(true);
+    client?.off("notification", changed);
+    client?.off("error", failed);
+    signal.removeEventListener("abort", abort);
+  }
+};
