index 000000000..9dc810a88
--- /dev/null
+++ b/apps/hosted/cloud/src/implementation/compiler-request-target.ts
@@ -0,0 +1,43 @@
+/** A request handle stays idle while a separate target runs cancellable compiler work. */
+import { RpcTarget } from "cloudflare:workers";
+import { Effect } from "effect";
+
+class CompilerRun<Value, Error> extends RpcTarget {
+  readonly #controller: AbortController;
+  readonly #run: () => Effect.Effect<Value, Error>;
+
+  constructor(controller: AbortController, run: () => Effect.Effect<Value, Error>) {
+    super();
+    this.#controller = controller;
+    this.#run = run;
+  }
+
+  result() {
+    return Effect.runPromise(this.#run(), { signal: this.#controller.signal });
+  }
+
+  [Symbol.dispose]() {
+    this.#controller.abort();
+  }
+}
+
+export class CompilerRequest<Args extends ReadonlyArray<unknown>, Value, Error> extends RpcTarget {
+  readonly #controller = new AbortController();
+  readonly #run: (signal: AbortSignal, ...args: Args) => Effect.Effect<Value, Error>;
+
+  constructor(run: (signal: AbortSignal, ...args: Args) => Effect.Effect<Value, Error>) {
+    super();
+    this.#run = run;
+  }
+
+  async start(...args: Args) {
+    const controller = this.#controller;
+    const run = this.#run;
+    // A pending call keeps its target alive. Cancellation must live on an idle target.
+    return new CompilerRun(controller, () => run(controller.signal, ...args));
+  }
+
+  [Symbol.dispose]() {
+    this.#controller.abort();
+  }
+}
