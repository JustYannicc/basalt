diff --git a/packages/apps/src/contracts/models.ts b/packages/apps/src/contracts/models.ts
new file mode 100644
--- /dev/null
+++ b/packages/apps/src/contracts/models.ts
@@ -0,0 +1,137 @@
+/** Pure model requirements and one non-streaming Chat Completions exchange. */
+import { Schema, type Effect } from "effect";
+import { JsonObject } from "./schema.ts";
+
+const positive = Schema.Int.check(Schema.isGreaterThan(0));
+export const ModelLimits = Schema.Struct({
+  timeoutMs: Schema.optionalKey(positive),
+  maxInputBytes: Schema.optionalKey(positive),
+  maxOutputTokens: Schema.optionalKey(positive),
+});
+/** Ceilings for one request. The host intersects these with the pool binding's limits. */
+export type ModelLimits = typeof ModelLimits.Type;
+export const defaultModelLimits = {
+  timeoutMs: 30_000,
+  maxInputBytes: 32_768,
+  maxOutputTokens: 800,
+} as const;
+export const ModelRequirement = Schema.Struct({
+  scope: Schema.Literals(["app", "user"]),
+  model: Schema.optionalKey(Schema.NonEmptyString),
+  limits: Schema.optionalKey(ModelLimits),
+});
+/** A pure declaration of an app-wide or personal model slot, bound by the host. */
+export type ModelRequirement = typeof ModelRequirement.Type;
+export const ModelName = Schema.String.check(Schema.isPattern(/^[A-Za-z][A-Za-z0-9_-]{0,47}$/u));
+export const DeclaredModels = Schema.Record(ModelName, ModelRequirement);
+export type DeclaredModels = typeof DeclaredModels.Type;
+export const ModelRequest = Schema.Struct({
+  model: Schema.optionalKey(Schema.NonEmptyString),
+  messages: Schema.Array(
+    Schema.Struct({
+      role: Schema.Literals(["system", "developer", "user", "assistant"]),
+      content: Schema.String,
+    }),
+  ).check(Schema.isMinLength(1)),
+  max_tokens: Schema.optionalKey(positive),
+  temperature: Schema.optionalKey(
+    Schema.Finite.check(Schema.isBetween({ minimum: 0, maximum: 2 })),
+  ),
+  response_format: Schema.optionalKey(
+    Schema.Union([
+      Schema.Struct({ type: Schema.Literals(["text", "json_object"]) }),
+      Schema.Struct({
+        type: Schema.Literal("json_schema"),
+        json_schema: Schema.Struct({
+          name: Schema.NonEmptyString,
+          strict: Schema.optionalKey(Schema.Boolean),
+          schema: JsonObject,
+        }),
+      }),
+    ]),
+  ),
+});
+/** One non-streaming Chat Completions request. Credentials and payer selection stay with the host. */
+export type ModelRequest = typeof ModelRequest.Type;
+export const ModelResponse = Schema.Struct({
+  id: Schema.NonEmptyString,
+  object: Schema.Literal("chat.completion"),
+  created: Schema.Int,
+  model: Schema.NonEmptyString,
+  choices: Schema.Array(
+    Schema.Struct({
+      index: Schema.Int,
+      message: Schema.Struct({
+        role: Schema.Literal("assistant"),
+        content: Schema.NullOr(Schema.String),
+        refusal: Schema.optionalKey(Schema.NullOr(Schema.String)),
+      }),
+      finish_reason: Schema.NullOr(Schema.String),
+    }),
+  ).check(Schema.isMinLength(1), Schema.isMaxLength(1)),
+  usage: Schema.optionalKey(
+    Schema.Struct({
+      prompt_tokens: Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)),
+      completion_tokens: Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)),
+      total_tokens: Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)),
+    }),
+  ),
+});
+/** One completion with the provider's token usage when it supplied it. */
+export type ModelResponse = typeof ModelResponse.Type;
+/** A model refusal or failure with a safe reason. Uncertain requests must not be retried automatically. */
+export class ModelRequestFailed extends Schema.TaggedError<ModelRequestFailed>()(
+  "ModelRequestFailed",
+  {
+    reason: Schema.Literals([
+      "binding_missing",
+      "denied",
+      "pool_unavailable",
+      "cap_exceeded",
+      "invalid_request",
+      "invalid_response",
+      "cancelled",
+      "timeout",
+      "outcome_unknown",
+      "durable_steps_unavailable",
+    ]),
+  },
+) {
+  override get message() {
+    const messages: Record<ModelRequestFailed["reason"], string> = {
+      durable_steps_unavailable:
+        "Model requests are unavailable inside durable workflow steps. Use a mutation outside a durable workflow, a schedule or a webhook.",
+      binding_missing: "Choose a model pool for this app requirement first.",
+      denied: "This app model binding no longer has permission to use its pool.",
+      pool_unavailable: "The bound model pool is unavailable.",
+      cap_exceeded: "You reached the limit this pool set for your usage.",
+      invalid_request: "The model request does not match this requirement or its limits.",
+      invalid_response: "The model returned an invalid compatible response.",
+      cancelled: "The model request was cancelled. It will not be retried automatically.",
+      timeout: "The model request timed out. It will not be retried automatically.",
+      outcome_unknown: "The model request's outcome is unknown. Do not retry it automatically.",
+    };
+    return messages[this.reason];
+  }
+}
+export const ModelCommand = Schema.Struct({ requirement: ModelName, request: ModelRequest });
+export type ModelCommand = typeof ModelCommand.Type;
+export const ModelReply = Schema.Union([
+  Schema.Struct({ ok: Schema.Literal(true), value: ModelResponse }),
+  Schema.Struct({ ok: Schema.Literal(false), error: ModelRequestFailed }),
+]);
+export type ModelRpc = (input: unknown) => Promise<unknown>;
+/** Trusted host authority is captured by the invocation, never supplied by the app. */
+export type ModelHost = (command: ModelCommand) => Effect.Effect<ModelResponse, ModelRequestFailed>;
+/** Durable workflow steps refuse these calls until the host can preserve external dispatch receipts. */
+export type ModelSlots<Requirements> = {
+  readonly models: {
+    readonly [
+      Name in keyof (Requirements extends { readonly models: infer Models }
+        ? Models
+        : Record<never, never>)
+    ]: {
+      readonly request: (request: ModelRequest) => Promise<ModelResponse>;
+    };
+  };
+};
