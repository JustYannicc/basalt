+/** The invocation owns the model callback and cancels its host work when it closes. */
+import { Cause, Effect, Schema } from "effect";
+import { ModelCommand, ModelReply, ModelRequestFailed, type ModelHost } from "apps/contracts";
+export const invocationModels = (host: ModelHost, signal: AbortSignal) =>
+  Effect.gen(function* () {
+    const services = yield* Effect.context<never>();
+    return (input: unknown): Promise<unknown> =>
+      Effect.runPromiseWith(services)(
+        Schema.decodeUnknownEffect(ModelCommand)(input, { onExcessProperty: "error" }).pipe(
+          Effect.mapError(() => new ModelRequestFailed({ reason: "invalid_request" })),
+          Effect.flatMap(host),
+          Effect.matchCause({
+            onSuccess: (value) => ({ ok: true as const, value }),
+            onFailure: (cause) => {
+              const error = Cause.squash(cause);
+              return {
+                ok: false as const,
+                error: Schema.is(ModelRequestFailed)(error)
+                  ? error
+                  : new ModelRequestFailed({
+                      reason: Cause.hasInterrupts(cause) ? "cancelled" : "outcome_unknown",
+                    }),
+              };
+            },
+          }),
+          Effect.flatMap(Schema.encodeUnknownEffect(ModelReply)),
+        ),
+        { signal },
+      );
+  });
