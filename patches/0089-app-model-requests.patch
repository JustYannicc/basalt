--- /dev/null
+++ b/apps/hosted/server/src/implementation/pool-models.ts
@@ -0,0 +1,150 @@
+import { GroupDatabase, GroupsUnavailable } from "../contracts/groups.ts";
+import type { SqlClient } from "effect/sql";
+import type { StorageError } from "@executor-js/sdk/core";
+import { AppId, type ModelBackend } from "@executor-js/sdk/core";
+import { ModelLimits, ModelRequestFailed, ModelResponse, defaultModelLimits } from "apps/contracts";
+import { Clock, Effect, Option, Redacted, Schema } from "effect";
+import { FetchHttpClient, HttpBody, HttpClient, HttpClientResponse } from "effect/http";
+import { OrganizationForbidden, OrganizationId } from "../contracts/organization.ts";
+import { modelPoolOwner } from "./model-bindings.ts";
+import { policyDatabase, resourceAuthority, requireAppAccessAs } from "./resource-policy.ts";
+import { signEnvelope } from "./pool-token.ts";
+import { appModelPath, appModelPrefix } from "./app-model-contract.ts";
+
+const SavedBinding = Schema.Struct({
+  id: Schema.NonEmptyString,
+  organization: OrganizationId,
+  pool: AppId,
+  authorizer: Schema.NonEmptyString,
+  model: Schema.NullOr(Schema.String),
+  limits: ModelLimits,
+  revision: Schema.Number,
+});
+const failure = (reason: ModelRequestFailed["reason"]) => new ModelRequestFailed({ reason });
+/** Product authority is rechecked at dispatch; app bindings delegate the pool to the app's users. */
+export const poolModels = (
+  key: Option.Option<Redacted.Redacted<string>>,
+  origin: string,
+  database: Effect.Effect<SqlClient.SqlClient, StorageError>,
+): ModelBackend => ({
+  request: (input) =>
+    Effect.gen(function* () {
+      if (Option.isNone(key)) return yield* failure("pool_unavailable");
+      const sql = yield* policyDatabase;
+      const subject = input.declaration.scope === "app" ? "" : input.caller;
+      if (subject === undefined) return yield* failure("denied");
+      const app = AppId.make(input.app);
+      const rows = yield* sql`select b.id, p.organization_id as organization, b.pool_id as pool,
+      b.authorizer, b.model, b.limits, b.revision::float8 as revision
+      from hosted_model_bindings b join hosted_app_access p on p.id = b.app_id
+      where b.app_id = ${app} and b.requirement = ${input.requirement} and b.subject = ${subject}`;
+      if (rows.length === 0) return yield* failure("binding_missing");
+      const binding = (yield* Schema.decodeUnknownEffect(Schema.Array(SavedBinding))(rows))[0];
+      if (binding === undefined || rows.length !== 1) return yield* failure("denied");
+      const authorizer = yield* resourceAuthority(binding.organization, binding.authorizer);
+      yield* requireAppAccessAs(
+        authorizer,
+        app,
+        input.declaration.scope === "app" ? "manage" : "use",
+      );
+      yield* requireAppAccessAs(authorizer, binding.pool, "use");
+      if (input.caller !== undefined) {
+        const caller = yield* resourceAuthority(binding.organization, input.caller);
+        yield* requireAppAccessAs(caller, app, "use");
+        if (input.declaration.scope === "user") {
+          if (binding.authorizer !== input.caller) return yield* failure("denied");
+          yield* requireAppAccessAs(caller, binding.pool, "use");
+        }
+      }
+      const owner = yield* modelPoolOwner(binding.pool, binding.organization);
+      const configured = { ...defaultModelLimits, ...binding.limits };
+      const declared = input.declaration.limits;
+      const limits = {
+        timeoutMs: Math.min(configured.timeoutMs, declared?.timeoutMs ?? configured.timeoutMs),
+        maxInputBytes: Math.min(
+          configured.maxInputBytes,
+          declared?.maxInputBytes ?? configured.maxInputBytes,
+        ),
+        maxOutputTokens: Math.min(
+          configured.maxOutputTokens,
+          declared?.maxOutputTokens ?? configured.maxOutputTokens,
+        ),
+      };
+      const model = input.request.model ?? binding.model ?? input.declaration.model;
+      if (
+        !model ||
+        new TextEncoder().encode(JSON.stringify(input.request)).byteLength > limits.maxInputBytes ||
+        (input.request.max_tokens ?? limits.maxOutputTokens) > limits.maxOutputTokens
+      )
+        return yield* failure("invalid_request");
+      const now = yield* Clock.currentTimeMillis;
+      const nonce = yield* Effect.sync(() => crypto.randomUUID());
+      const body = {
+        ...input.request,
+        model,
+        stream: false,
+        n: 1,
+        max_tokens: input.request.max_tokens ?? limits.maxOutputTokens,
+      };
+      const envelope = yield* Effect.tryPromise(() =>
+        signEnvelope(Redacted.value(key.value), appModelPrefix, {
+          nonce,
+          expiresAt: now + 30_000,
+          organization: binding.organization,
+          owner,
+          pool: binding.pool,
+          app: input.app,
+          requirement: input.requirement,
+          binding: binding.id,
+          revision: binding.revision,
+          authorizer: binding.authorizer,
+          person: input.caller ?? binding.authorizer,
+          scope: input.declaration.scope,
+          background: input.caller === undefined,
+          timeoutMs: limits.timeoutMs,
+          body,
+        }),
+      );
+      const client = yield* HttpClient.HttpClient;
+      return yield* client
+        .post(new URL(appModelPath, origin).href, { body: HttpBody.jsonUnsafe({ envelope }) })
+        .pipe(
+          Effect.flatMap((response) =>
+            Effect.gen(function* () {
+              if (response.status === 429) {
+                const body = yield* HttpClientResponse.schemaBodyJson(
+                  Schema.Struct({ error: Schema.Struct({ code: Schema.String }) }),
+                )(response).pipe(Effect.option);
+                return yield* failure(
+                  Option.isSome(body) && body.value.error.code === "user_period_limit_exceeded"
+                    ? "cap_exceeded"
+                    : "pool_unavailable",
+                );
+              }
+              if (response.status === 409 || response.status === 502)
+                return yield* failure("outcome_unknown");
+              if (response.status === 401 || response.status === 403)
+                return yield* failure("denied");
+              if (response.status !== 200) return yield* failure("pool_unavailable");
+              return yield* HttpClientResponse.schemaBodyJson(ModelResponse)(response).pipe(
+                Effect.mapError(() => failure("invalid_response")),
+              );
+            }),
+          ),
+          Effect.catchTag("HttpClientError", () => Effect.fail(failure("outcome_unknown"))),
+          Effect.timeout(limits.timeoutMs),
+          Effect.catchTag("TimeoutError", () => Effect.fail(failure("timeout"))),
+        );
+    }).pipe(
+      Effect.provide(FetchHttpClient.layer),
+      Effect.provideService(
+        GroupDatabase,
+        database.pipe(Effect.mapError(() => new GroupsUnavailable())),
+      ),
+      Effect.mapError((error) =>
+        Schema.is(ModelRequestFailed)(error)
+          ? error
+          : failure(Schema.is(OrganizationForbidden)(error) ? "denied" : "pool_unavailable"),
+      ),
+    ),
+});
