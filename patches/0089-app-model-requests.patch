@@ -0,0 +1,311 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Fiber, Schedule, Schema } from "effect";
+import { body } from "../support/api.ts";
+import { appModelFixture } from "../support/app-model-fixture.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { WorkflowRun } from "../support/workflow-app.ts";
+import { appModelMigration } from "../support/app-model-source.ts";
+
+const Bindings = Schema.Struct({
+  declarations: Schema.Record(Schema.String, Schema.Unknown),
+  canBindApp: Schema.Boolean,
+  pools: Schema.Array(Schema.Struct({ id: Schema.String, name: Schema.String })),
+  bindings: Schema.Array(
+    Schema.Struct({
+      requirement: Schema.String,
+      scope: Schema.String,
+      pool: Schema.String,
+      poolName: Schema.NullOr(Schema.String),
+      authorizerName: Schema.NullOr(Schema.String),
+      status: Schema.String,
+      stale: Schema.Boolean,
+    }),
+  ),
+});
+
+layer(RuntimeLive, { excludeTestServices: true })("App model requests", (it) => {
+  it.effect(scenarios.appModelRequests.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* appModelFixture;
+        yield* serverControl("stop");
+        yield* legacyStorage([
+          {
+            sql: `update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb), '{basaltPools}', $1::jsonb)::text where id = $2`,
+            params: [
+              JSON.stringify({
+                [f.ids.admin]: {
+                  app: f.pool,
+                  version: "retained-version",
+                  authorization: "executor-app-v1",
+                },
+              }),
+              f.actors.organization.id,
+            ],
+          },
+        ]);
+        yield* serverControl("environment", 200, {
+          POOL_APP_SIGNING_KEY: "ab".repeat(32),
+          BASALT_POOL_ORIGIN: f.backend.origin,
+        });
+        yield* serverControl("start");
+        const { api, actors, backend, path, pool, other, ids } = f;
+        const bindings = (actor = actors.member) =>
+          api
+            .request(actor, "GET", `${path}/models`)
+            .pipe(Effect.flatMap((response) => body(Bindings, response)));
+        expect(yield* backend.calls).toHaveLength(0);
+        expect(yield* f.inspect()).toEqual({ models: false, rows: [] });
+        expect(
+          (yield* api.request(actors.member, "GET", `${f.prefix}/apps/${pool}/access`)).status,
+        ).toBe(403);
+        expect((yield* f.call()).body).toMatchObject({
+          _tag: "ToolCallFailed",
+          failure: { source: "service", errorName: "ModelRequestFailed", code: "binding_missing" },
+        });
+        expect(yield* backend.calls).toHaveLength(0);
+        expect((yield* bindings()).pools).toEqual([]);
+        expect((yield* bindings(actors.admin)).pools).toEqual([
+          { id: pool, name: "Private model pool" },
+        ]);
+        expect((yield* f.bind(actors.owner)).status).toBe(403);
+        expect((yield* f.bind(actors.member)).status).toBe(403);
+        expect((yield* f.bind(actors.admin, "email", "app", other)).status).toBe(403);
+        expect((yield* f.bind()).status).toBe(200);
+        const memberView = yield* bindings();
+        expect(memberView.canBindApp).toBe(false);
+        expect(memberView.bindings).toMatchObject([
+          {
+            requirement: "email",
+            scope: "app",
+            poolName: null,
+            status: "hidden",
+            stale: false,
+          },
+        ]);
+        expect(JSON.stringify(memberView)).not.toContain("Private model pool");
