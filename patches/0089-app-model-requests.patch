+import { AppId, StorageError } from "@executor-js/sdk/core";
+import { DeclaredModels, ModelLimits } from "apps/contracts";
+import { Schema } from "effect";
+import { HttpApiEndpoint, HttpApiGroup } from "effect/http-api";
+import { RequiredAction } from "./authorization.ts";
+import {
+  OrganizationForbidden,
+  OrganizationReference,
+  RequireOrganization,
+} from "./organization.ts";
+export const ModelScope = Schema.Literals(["app", "user"]);
+export const ModelBindingInput = Schema.Struct({
+  scope: ModelScope,
+  pool: AppId,
+  model: Schema.optionalKey(Schema.NonEmptyString),
+  limits: Schema.optionalKey(ModelLimits),
+});
+export const ModelBinding = Schema.Struct({
+  requirement: Schema.NonEmptyString,
+  scope: ModelScope,
+  pool: AppId,
+  model: Schema.NullOr(Schema.String),
+  limits: ModelLimits,
+  revision: Schema.Number,
+});
+export const ModelBindingView = Schema.Struct({
+  ...ModelBinding.fields,
+  poolName: Schema.NullOr(Schema.String),
+  authorizerName: Schema.NullOr(Schema.String),
+  status: Schema.Literals(["ready", "unavailable", "hidden"]),
+  stale: Schema.Boolean,
+});
+export const ModelBindings = Schema.Struct({
+  declarations: DeclaredModels,
+  bindings: Schema.Array(ModelBindingView),
+  pools: Schema.Array(Schema.Struct({ id: AppId, name: Schema.String })),
+  canBindApp: Schema.Boolean,
+});
+const params = { organization: OrganizationReference, app: AppId };
+export const HostedModels = HttpApiGroup.make("models")
+  .add(
+    HttpApiEndpoint.get("list", "/api/organizations/:organization/apps/:app/models", {
+      params,
+      success: ModelBindings,
+      error: [OrganizationForbidden, StorageError],
+    }).annotate(RequiredAction, "read"),
+  )
+  .add(
+    HttpApiEndpoint.put("bind", "/api/organizations/:organization/apps/:app/models/:requirement", {
+      params: { ...params, requirement: Schema.NonEmptyString },
+      payload: ModelBindingInput,
+      success: ModelBinding,
+      error: [OrganizationForbidden, StorageError],
+    }).annotate(RequiredAction, "manage"),
+  )
+  .add(
+    HttpApiEndpoint.delete(
+      "unbind",
+      "/api/organizations/:organization/apps/:app/models/:requirement",
+      {
+        params: { ...params, requirement: Schema.NonEmptyString },
+        query: { scope: ModelScope },
+        success: Schema.Struct({ success: Schema.Literal(true) }),
+        error: [OrganizationForbidden, StorageError],
+      },
+    ).annotate(RequiredAction, "manage"),
+  )
+  .middleware(RequireOrganization);
