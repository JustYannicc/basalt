+            enabled: false,
+            scope: "app",
+          })).status,
+        ).toBe(200);
+        yield* f.share({ kind: "private" });
+        expect((yield* f.call()).status).toBe(403);
+        expect(yield* backend.calls).toHaveLength(before + 1);
+      }),
+    ),
+  );
+});
