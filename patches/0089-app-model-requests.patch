+        expect((yield* f.call(actors.member, "invalid", {})).body).toMatchObject({
+          failure: { code: "invalid_request" },
+        });
+        expect(yield* backend.calls).toHaveLength(1);
+        expect((yield* f.bind(actors.member, "personal", "user")).status).toBe(403);
+        expect((yield* f.bind(actors.admin, "personal", "user")).status).toBe(200);
+        expect((yield* f.call(actors.member, "personal", {})).body).toMatchObject({
+          failure: { code: "binding_missing" },
+        });
+        expect((yield* f.call(actors.admin, "personal", {})).body).toBe("fixture-model");
+        expect((yield* backend.calls).at(-1)).toMatchObject({ person: ids.admin, scope: "user" });
+
+        const members = yield* body(
+          Schema.Struct({
+            members: Schema.Array(Schema.Struct({ id: Schema.String, userId: Schema.String })),
+          }),
+          yield* api.request(
+            actors.owner,
+            "GET",
+            `/api/auth/organization/list-members?organizationId=${actors.organization.id}`,
+          ),
+        );
+        const admin = members.members.find((row) => row.userId === ids.admin);
+        expect(admin).toBeDefined();
+        if (admin === undefined) return yield* Effect.die("Missing fixture membership");
+        expect(
+          (yield* api.request(actors.owner, "POST", "/api/auth/organization/update-member-role", {
+            organizationId: actors.organization.id,
+            memberId: admin.id,
+            role: "member",
+          })).status,
+        ).toBe(200);
+        const before = (yield* backend.calls).length;
+        expect((yield* f.call()).body).toMatchObject({ failure: { code: "denied" } });
+        expect((yield* bindings()).bindings.find((row) => row.scope === "app")?.status).toBe(
+          "unavailable",
+        );
+        expect(yield* backend.calls).toHaveLength(before);
+        const redeployed = yield* api.request(actors.owner, "POST", `${path}/deploy`, {
+          files: [
+            {
+              path: "index.ts",
+              content: 'import {defineApp} from "apps"; export default defineApp({}, {});',
