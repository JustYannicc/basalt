+/** Model bindings belong to the product; app databases and SDK storage hold no payer authority. */
+import { Effect } from "effect";
+import { SqlClient } from "effect/sql";
+export const migrateModelBindings = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  yield* sql`create table hosted_model_bindings (
+    id text not null unique,
+    app_id text not null references executor_apps(id) on delete cascade,
+    requirement text not null,
+    subject text not null default '',
+    pool_id text not null references executor_apps(id) on delete cascade,
+    authorizer text not null references "user"(id) on delete cascade,
+    model text,
+    limits jsonb not null default '{}'::jsonb,
+    revision bigint not null default 1,
+    created_at timestamptz not null default now(),
+    primary key (app_id, requirement, subject)
+  )`;
+  yield* sql`create index hosted_model_bindings_pool on hosted_model_bindings (pool_id, app_id)`;
+});
diff --git a/apps/hosted/server/src/implementation/model-bindings.ts b/apps/hosted/server/src/implementation/model-bindings.ts
new file mode 100644
--- /dev/null
+++ b/apps/hosted/server/src/implementation/model-bindings.ts
@@ -0,0 +1,191 @@
+import { AppId, StorageError } from "@executor-js/sdk/core";
+import { DeclaredModels, ModelLimits } from "apps/contracts";
+import { Effect, Option, Schema } from "effect";
+import { HttpApiBuilder } from "effect/http-api";
+import { HostedApi } from "../contracts/api.ts";
+import { ModelBindingInput } from "../contracts/models.ts";
+import { OrganizationForbidden } from "../contracts/organization.ts";
+import {
+  applicationAccess,
+  applicationAccesses,
+  lockCurrentActor,
+  currentResourceAuthority,
+  policyDatabase,
+  requireAppAccessAs,
+  resourceAuthority,
+  type ResourceAuthority,
+} from "./resource-policy.ts";
+
+const declarations = (app: AppId, actor: ResourceAuthority) =>
+  Effect.gen(function* () {
+    const sql = yield* policyDatabase;
+    const rows = yield* sql`select d.requirements::jsonb -> 'models' as models
+    from executor_apps a left join executor_deployments d on d.id = a.active_deployment
+    where a.id = ${app} and a.owner = ${"organization:" + actor.organization}`;
+    if (rows.length !== 1) return yield* new OrganizationForbidden();
+    return yield* Schema.decodeUnknownEffect(DeclaredModels)(rows[0]?.models ?? {});
+  });
+/** A model pool must be a current pool app in the same organization, never an arbitrary app ID. */
+export const modelPoolOwner = (pool: AppId, organization: string) =>
+  Effect.gen(function* () {
+    const sql = yield* policyDatabase;
+    const rows = yield* sql`select entry.key as owner from organization o
+    cross join lateral jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) entry
+    join executor_apps a on a.id = entry.value ->> 'app' and a.owner = 'organization:' || o.id
+    where o.id = ${organization} and a.id = ${pool}`;
+    if (rows.length !== 1) return yield* new OrganizationForbidden();
+    return yield* Schema.decodeUnknownEffect(Schema.NonEmptyString)(rows[0]?.owner);
+  });
+const failures = { SqlError: () => new StorageError(), SchemaError: () => new StorageError() };
+const BindingRow = Schema.Struct({
+  requirement: Schema.String,
+  subject: Schema.String,
+  pool: AppId,
+  model: Schema.NullOr(Schema.String),
+  limits: ModelLimits,
+  revision: Schema.Number,
+});
+const bindingRows = Schema.Array(BindingRow);
+const present = (row: (typeof bindingRows.Type)[number]) => ({
+  requirement: row.requirement,
+  scope: row.subject === "" ? ("app" as const) : ("user" as const),
+  pool: row.pool,
+  model: row.model,
+  limits: row.limits,
+  revision: row.revision,
+});
+const allowed = <A, E, R>(effect: Effect.Effect<A, E, R>) =>
+  effect.pipe(
+    Effect.as(true),
+    Effect.catchIf(
+      (error): error is Extract<E, OrganizationForbidden> =>
+        Schema.is(OrganizationForbidden)(error),
+      () => Effect.succeed(false),
+    ),
+  );
+const PoolChoice = Schema.Struct({ id: AppId, name: Schema.String });
+const usablePools = (actor: ResourceAuthority) =>
+  Effect.gen(function* () {
+    const sql = yield* policyDatabase;
+    const rows = yield* sql`select distinct a.id, a.name from organization o
+    cross join lateral jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) entry
+    join executor_apps a on a.id = entry.value ->> 'app' and a.owner = 'organization:' || o.id
+    where o.id = ${actor.organization} order by a.name, a.id`;
+    const pools = yield* Schema.decodeUnknownEffect(Schema.Array(PoolChoice))(rows);
+    const policies = yield* applicationAccesses(
+      pools.map((pool) => pool.id),
+      actor,
+    );
+    return pools.filter((pool) =>
+      policies.some((policy) => policy.app === pool.id && policy.canUse),
+    );
+  });
+const ViewRow = Schema.Struct({
+  ...BindingRow.fields,
+  authorizer: Schema.String,
+  poolName: Schema.NullOr(Schema.String),
+  authorizerName: Schema.NullOr(Schema.String),
+});
+const bindingView = (
+  row: typeof ViewRow.Type,
+  app: AppId,
+  actor: ResourceAuthority,
+  declared: typeof DeclaredModels.Type,
+) =>
+  Effect.gen(function* () {
+    const binding = present(row);
+    const stale = declared[row.requirement]?.scope !== binding.scope;
+    const authorizer = yield* resourceAuthority(actor.organization, row.authorizer).pipe(
+      Effect.map(Option.some),
+      Effect.catchTag("OrganizationForbidden", () => Effect.succeed(Option.none())),
+    );
+    const ready =
+      !stale &&
+      Option.isSome(authorizer) &&
+      (yield* allowed(
+        requireAppAccessAs(authorizer.value, app, binding.scope === "app" ? "manage" : "use"),
+      )) &&
+      (yield* allowed(requireAppAccessAs(authorizer.value, row.pool, "use"))) &&
+      (yield* allowed(modelPoolOwner(row.pool, actor.organization)));
+    const visible = yield* allowed(requireAppAccessAs(actor, row.pool, "use"));
+    return {
+      ...binding,
+      stale,
+      poolName: visible ? row.poolName : null,
+      authorizerName: row.authorizerName,
+      status: !ready
+        ? ("unavailable" as const)
+        : visible
+          ? ("ready" as const)
+          : ("hidden" as const),
+    };
+  });
+export const listModelBindings = (app: AppId) =>
+  Effect.gen(function* () {
+    const actor = yield* currentResourceAuthority;
+    yield* requireAppAccessAs(actor, app, "use");
+    const sql = yield* policyDatabase;
+    const rows = yield* sql`select b.requirement, b.subject, b.pool_id as pool, b.model, b.limits,
+    b.revision::float8 as revision, b.authorizer, p.name as "poolName", u.name as "authorizerName"
+    from hosted_model_bindings b left join executor_apps p on p.id = b.pool_id
+    left join member m on m."userId" = b.authorizer and m."organizationId" = ${actor.organization}
+    left join "user" u on u.id = m."userId"
+    where b.app_id = ${app} and (b.subject = '' or b.subject = ${actor.user})
+    order by b.requirement, b.subject`;
+    const declared = yield* declarations(app, actor);
+    const bindings = yield* Schema.decodeUnknownEffect(Schema.Array(ViewRow))(rows);
+    return {
+      declarations: declared,
+      bindings: yield* Effect.forEach(bindings, (row) => bindingView(row, app, actor, declared)),
+      pools: yield* usablePools(actor),
+      canBindApp: (yield* applicationAccess(app, actor)).canManage,
+    };
+  }).pipe(Effect.catchTags(failures));
+export const bindModel = (app: AppId, requirement: string, input: typeof ModelBindingInput.Type) =>
+  Effect.gen(function* () {
+    const sql = yield* policyDatabase;
+    return yield* sql.withTransaction(
+      Effect.gen(function* () {
+        const actor = yield* lockCurrentActor;
+        yield* requireAppAccessAs(actor, app, input.scope === "app" ? "manage" : "use");
+        yield* requireAppAccessAs(actor, input.pool, "use");
+        yield* modelPoolOwner(input.pool, actor.organization);
+        const declared = (yield* declarations(app, actor))[requirement];
+        if (declared?.scope !== input.scope) return yield* new OrganizationForbidden();
+        const subject = input.scope === "app" ? "" : actor.user;
+        const id = yield* Effect.sync(() => crypto.randomUUID());
+        const rows = yield* sql`insert into hosted_model_bindings
+      (id, app_id, requirement, subject, pool_id, authorizer, model, limits)
+      values (${id}, ${app}, ${requirement}, ${subject}, ${input.pool}, ${actor.user}, ${input.model ?? null}, ${JSON.stringify(input.limits ?? {})}::jsonb)
+      on conflict (app_id, requirement, subject) do update set
+        pool_id = excluded.pool_id, authorizer = excluded.authorizer, model = excluded.model,
+        limits = excluded.limits, revision = hosted_model_bindings.revision + 1
+      returning requirement, subject, pool_id as pool, model, limits, revision::float8 as revision`;
+        const row = (yield* Schema.decodeUnknownEffect(bindingRows)(rows))[0];
+        if (row === undefined) return yield* new StorageError();
+        return present(row);
+      }),
+    );
+  }).pipe(Effect.catchTags(failures));
+/** Removed requirements retain a visible binding until its manager or subject removes it. */
+export const unbindModel = (app: AppId, requirement: string, scope: "app" | "user") =>
+  Effect.gen(function* () {
+    const sql = yield* policyDatabase;
+    return yield* sql.withTransaction(
+      Effect.gen(function* () {
+        const actor = yield* lockCurrentActor;
+        yield* requireAppAccessAs(actor, app, scope === "app" ? "manage" : "use");
+        yield* sql`delete from hosted_model_bindings where app_id = ${app}
+      and requirement = ${requirement} and subject = ${scope === "app" ? "" : actor.user}`;
+        return { success: true as const };
+      }),
+    );
+  }).pipe(Effect.catchTag("SqlError", () => new StorageError()));
+export const hostedModelHandlers = HttpApiBuilder.group(HostedApi, "models", (handlers) =>
+  handlers
+    .handle("list", ({ params }) => listModelBindings(params.app))
+    .handle("bind", ({ params, payload }) => bindModel(params.app, params.requirement, payload))
+    .handle("unbind", ({ params, query }) =>
+      unbindModel(params.app, params.requirement, query.scope),
+    ),
+);
diff --git a/apps/hosted/server/src/implementation/pool-models.ts b/apps/hosted/server/src/implementation/pool-models.ts
