+++ b/e2e/support/app-model-backend.ts
@@ -0,0 +1,139 @@
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import { Clock, Deferred, Effect, Layer, Ref, Schema } from "effect";
+import { HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { createHmac, timingSafeEqual } from "node:crypto";
+import { createServer } from "node:http";
+import { Socket } from "node:net";
+
+const Assertion = Schema.Struct({
+  nonce: Schema.String,
+  expiresAt: Schema.Number,
+  organization: Schema.String,
+  owner: Schema.String,
+  pool: Schema.String,
+  app: Schema.String,
+  requirement: Schema.String,
+  binding: Schema.String,
+  revision: Schema.Number,
+  authorizer: Schema.String,
+  person: Schema.String,
+  scope: Schema.Literals(["app", "user"]),
+  background: Schema.Boolean,
+  timeoutMs: Schema.Number,
+  body: Schema.Struct({
+    model: Schema.String,
+    stream: Schema.Literal(false),
+    n: Schema.Literal(1),
+    max_tokens: Schema.Number,
+    messages: Schema.Array(Schema.Struct({ role: Schema.String, content: Schema.String })),
+  }),
+});
+type Mode = "ok" | "invalid" | "cap" | "unavailable" | "unknown" | "drop";
+
+/** The real product signs requests to this external pool peer; no SDK or policy is replaced. */
+export const appModelBackend = Effect.gen(function* () {
+  const calls = yield* Ref.make<readonly (typeof Assertion.Type)[]>([]);
+  let mode: Mode = "ok";
+  let gate:
+    | {
+        started: Deferred.Deferred<void>;
+        release: Deferred.Deferred<void>;
+        cancelled: Deferred.Deferred<void>;
+      }
+    | undefined;
+  const handler = Effect.gen(function* () {
+    const request = yield* HttpServerRequest.HttpServerRequest;
+    const payload = yield* request.json.pipe(
+      Effect.flatMap(Schema.decodeUnknownEffect(Schema.Struct({ envelope: Schema.String }))),
+    );
+    const [prefix, encoded, signature, extra] = payload.envelope.split(".");
+    if (prefix !== "sb-app-model1" || !encoded || !signature || extra !== undefined)
+      return HttpServerResponse.empty({ status: 401 });
+    const expected = createHmac("sha256", Buffer.from("ab".repeat(32), "hex"))
+      .update(`${prefix}.${encoded}`)
+      .digest();
+    const actual = Buffer.from(signature, "base64url");
+    if (actual.length !== expected.length || !timingSafeEqual(actual, expected))
+      return HttpServerResponse.empty({ status: 401 });
+    const value = yield* Schema.decodeUnknownEffect(Schema.fromJsonString(Assertion))(
+      Buffer.from(encoded, "base64url").toString(),
+    );
+    const now = yield* Clock.currentTimeMillis;
+    if (value.expiresAt <= now || value.expiresAt > now + 30_000)
+      return HttpServerResponse.empty({ status: 401 });
+    yield* Ref.update(calls, (prior) => [...prior, value]);
+    if (mode === "drop") {
+      const source = request.source;
+      if (!("socket" in source) || !(source.socket instanceof Socket))
+        return yield* Effect.die("Model fixture needs the Node request socket");
+      source.socket.destroy();
+      return HttpServerResponse.empty({ status: 500 });
+    }
+    const held = gate;
+    if (held !== undefined) {
+      yield* Deferred.succeed(held.started, undefined);
+      yield* Deferred.await(held.release).pipe(
+        Effect.onInterrupt(() => Deferred.succeed(held.cancelled, undefined)),
+      );
+    }
+    if (mode === "cap")
+      return HttpServerResponse.jsonUnsafe(
+        { error: { code: "user_period_limit_exceeded" } },
+        { status: 429 },
+      );
+    if (mode === "unavailable") return HttpServerResponse.empty({ status: 503 });
+    if (mode === "unknown") return HttpServerResponse.empty({ status: 502 });
+    if (mode === "invalid")
+      return HttpServerResponse.jsonUnsafe({ private: "synthetic-invalid-response" });
+    return HttpServerResponse.jsonUnsafe({
+      id: `completion-${value.nonce}`,
+      object: "chat.completion",
+      created: 1,
+      model: value.body.model,
+      choices: [
+        {
+          index: 0,
+          message: { role: "assistant", content: '{"category":"finance","action":"reply"}' },
+          finish_reason: "stop",
+        },
+      ],
+      usage: { prompt_tokens: 12, completion_tokens: 8, total_tokens: 20 },
+    });
+  });
+  const services = yield* Layer.build(
+    HttpRouter.serve(HttpRouter.add("POST", "/__models/v1/request", handler), {
+      disableLogger: true,
+      disableListenLog: true,
+    }).pipe(Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 }))),
+  );
+  const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+  if (!("port" in server.address)) return yield* Effect.die("Model fixture requires TCP");
+  return {
+    origin: `http://127.0.0.1:${server.address.port}`,
+    calls: Ref.get(calls),
+    respond: (next: Mode) =>
+      Effect.sync(() => {
+        mode = next;
+      }),
+    hold: Effect.gen(function* () {
+      const held = {
+        started: yield* Deferred.make<void>(),
+        release: yield* Deferred.make<void>(),
+        cancelled: yield* Deferred.make<void>(),
+      };
+      gate = held;
+      yield* Effect.addFinalizer(() => Deferred.succeed(held.release, undefined));
+      return {
+        started: Deferred.await(held.started),
+        cancelled: Deferred.await(held.cancelled),
+        release: Deferred.succeed(held.release, undefined).pipe(
+          Effect.tap(() =>
+            Effect.sync(() => {
+              gate = undefined;
+            }),
+          ),
+        ),
+      };
+    }),
+  };
+});
