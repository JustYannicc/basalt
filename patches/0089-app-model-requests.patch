diff --git a/packages/apps/src/implementation/models.ts b/packages/apps/src/implementation/models.ts
new file mode 100644
--- /dev/null
+++ b/packages/apps/src/implementation/models.ts
@@ -0,0 +1,64 @@
+import { Effect, Schema } from "effect";
+import {
+  DeclaredModels,
+  ModelRequest,
+  ModelRequestFailed,
+  ModelResponse,
+  ModelCommand,
+  ModelReply,
+  type ModelHost,
+  type ModelRpc,
+} from "../contracts/models.ts";
+
+/** A query or factory never receives these callbacks. */
+export const authorModels = (
+  declarations: DeclaredModels | undefined,
+  host: ModelHost | undefined,
+  signal: AbortSignal,
+) => {
+  const run = Effect.runPromise;
+  return Object.fromEntries(
+    Object.keys(declarations ?? {}).map((requirement) => [
+      requirement,
+      {
+        request: (input: ModelRequest): Promise<ModelResponse> =>
+          run(
+            Effect.gen(function* () {
+              if (signal.aborted) return yield* new ModelRequestFailed({ reason: "cancelled" });
+              const request = yield* Schema.decodeUnknownEffect(ModelRequest)(input, {
+                onExcessProperty: "error",
+              }).pipe(Effect.mapError(() => new ModelRequestFailed({ reason: "invalid_request" })));
+              if (host === undefined)
+                return yield* new ModelRequestFailed({ reason: "binding_missing" });
+              return yield* host({ requirement, request }).pipe(
+                Effect.flatMap(Schema.decodeUnknownEffect(ModelResponse)),
+                Effect.catchTag("SchemaError", () =>
+                  Effect.fail(new ModelRequestFailed({ reason: "invalid_response" })),
+                ),
+              );
+            }),
+            { signal },
+          ),
+      },
+    ]),
+  );
+};
+
+/** Only parsed requests and safe errors cross the private Worker callback. */
+export const isolatedModels =
+  (deliver: ModelRpc): ModelHost =>
+  (command) =>
+    // oxlint-disable-next-line executor/authored-code-through-adapter -- the invocation's private model RPC
+    Effect.tryPromise({
+      try: () => deliver(Schema.encodeSync(ModelCommand)(command)),
+      catch: () => new ModelRequestFailed({ reason: "outcome_unknown" }),
+    }).pipe(
+      Effect.flatMap((reply) =>
+        Schema.decodeUnknownEffect(ModelReply)(reply).pipe(
+          Effect.mapError(() => new ModelRequestFailed({ reason: "invalid_response" })),
+        ),
+      ),
+      Effect.flatMap((reply) =>
+        reply.ok ? Effect.succeed(reply.value) : Effect.fail(reply.error),
+      ),
+    );
