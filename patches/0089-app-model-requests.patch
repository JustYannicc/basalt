+import { expect } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Actors } from "./actors.ts";
+import { Api, body, type Session } from "./api.ts";
+import { appsManifest } from "./apps-release.ts";
+import { Resource } from "./contracts.ts";
+import { appModelBackend } from "./app-model-backend.ts";
+import { appModelMigration, appModelSource } from "./app-model-source.ts";
+import { serverControl } from "./server-control.ts";
+
+export const appModelFixture = Effect.gen(function* () {
+  const api = yield* Api,
+    actors = yield* Actors,
+    backend = yield* appModelBackend;
+  const prefix = `/api/organizations/${actors.organization.id}`;
+  const apps: string[] = [];
+  const deploy = (actor: Session, name: string, source: string, database: boolean) =>
+    Effect.gen(function* () {
+      const response = yield* api.request(actor, "POST", `${prefix}/apps/deploy`, {
+        name,
+        files: [
+          { path: "index.ts", content: source },
+          appsManifest,
+          ...(database ? [appModelMigration] : []),
+        ],
+      });
+      expect(response.status, JSON.stringify(response.body)).toBe(200);
+      const app = yield* body(Resource, response);
+      apps.push(app.id);
+      return app.id;
+    });
+  yield* Effect.addFinalizer(() =>
+    Effect.gen(function* () {
+      yield* serverControl("start");
+      for (const id of apps) yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${id}`);
+    }).pipe(Effect.orDie),
+  );
+  const app = yield* deploy(actors.owner, "Email interpretation", appModelSource, true);
+  const ordinary = 'import {defineApp} from "apps"; export default defineApp({}, {});';
+  const pool = yield* deploy(actors.admin, "Private model pool", ordinary, false);
+  const other = yield* deploy(actors.owner, "Ordinary app", ordinary, false);
+  const path = `${prefix}/apps/${app}`;
+  const viewer = Schema.Struct({ userId: Schema.String });
+  const owner = (yield* body(viewer, yield* api.request(actors.owner, "GET", "/api/viewer")))
+    .userId;
+  const admin = (yield* body(viewer, yield* api.request(actors.admin, "GET", "/api/viewer")))
+    .userId;
+  const member = (yield* body(viewer, yield* api.request(actors.member, "GET", "/api/viewer")))
+    .userId;
+  const access = Schema.Struct({ revision: Schema.String });
+  const share = (audience: { kind: "private" | "everyone" }) =>
+    Effect.gen(function* () {
+      const current = yield* body(
+        access,
+        yield* api.request(actors.owner, "GET", `${path}/access`),
+      );
+      expect(
+        (yield* api.request(actors.owner, "PATCH", `${path}/access`, {
+          revision: current.revision,
+          audience,
+        })).status,
+      ).toBe(200);
+    });
+  yield* share({ kind: "everyone" });
+  const bind = (
+    actor: Session = actors.admin,
+    requirement = "email",
+    scope: "app" | "user" = "app",
+    poolId = pool,
+    limits = {},
+  ) => api.request(actor, "PUT", `${path}/models/${requirement}`, { scope, pool: poolId, limits });
+  const unbind = (
+    actor: Session = actors.admin,
+    requirement = "email",
+    scope: "app" | "user" = "app",
+  ) => api.request(actor, "DELETE", `${path}/models/${requirement}?scope=${scope}`);
+  const call = (
+    actor: Session = actors.member,
+    tool = "interpret",
+    input: Schema.Json = { email: "A synthetic invoice needs a reply" },
+  ) =>
+    api.request(actor, "POST", `${path}/tools/call`, {
+      tool,
+      kind: tool === "inspect" ? "query" : "mutation",
+      input,
+    });
+  const inspect = (actor: Session = actors.member) =>
+    call(actor, "inspect", {}).pipe(
+      Effect.flatMap((response) =>
+        body(
+          Schema.Struct({
+            models: Schema.Boolean,
+            rows: Schema.Array(Schema.Struct({ category: Schema.String, actor: Schema.String })),
+          }),
+          response,
+        ),
+      ),
+    );
+  return {
+    api,
+    actors,
+    backend,
+    prefix,
+    path,
+    app,
+    pool,
+    other,
+    ids: { owner, admin, member },
+    bind,
+    unbind,
+    call,
+    inspect,
+    share,
+  };
+});
