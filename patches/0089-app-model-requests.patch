+
+  it.effect(scenarios.appModelLifecycle.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* appModelFixture;
+        yield* serverControl("stop");
+        yield* legacyStorage([
+          {
+            sql: `update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb), '{basaltPools}', $1::jsonb)::text where id = $2`,
+            params: [
+              JSON.stringify({
+                [f.ids.admin]: {
+                  app: f.pool,
+                  version: "retained-version",
+                  authorization: "executor-app-v1",
+                },
+              }),
+              f.actors.organization.id,
+            ],
+          },
+        ]);
+        yield* serverControl("environment", 200, {
+          POOL_APP_SIGNING_KEY: "ab".repeat(32),
+          BASALT_POOL_ORIGIN: f.backend.origin,
+        });
+        yield* serverControl("start");
+        const { api, actors, backend, path, ids } = f;
+        expect((yield* f.bind()).status).toBe(200);
+        for (const [mode, code] of [
+          ["cap", "cap_exceeded"],
+          ["unavailable", "pool_unavailable"],
+          ["unknown", "outcome_unknown"],
+          ["drop", "outcome_unknown"],
+          ["invalid", "invalid_response"],
+        ] as const) {
+          yield* backend.respond(mode);
+          const before = (yield* backend.calls).length;
+          const response = yield* f.call();
+          expect(response.body).toMatchObject({
+            _tag: "ToolCallFailed",
+            failure: { errorName: "ModelRequestFailed", code },
+          });
+          expect(JSON.stringify(response.body)).not.toContain("synthetic-invalid-response");
+          expect(yield* backend.calls).toHaveLength(before + 1);
+        }
+        yield* backend.respond("unknown");
+        for (const workflow of ["modelStep", "mutationStep"]) {
+          const before = (yield* backend.calls).length;
+          const started = yield* body(
+            WorkflowRun,
+            yield* api.request(actors.owner, "POST", `${path}/workflow-runs`, {
+              workflow,
+              input: {},
+            }),
+          );
+          yield* Effect.addFinalizer(() =>
+            api
+              .request(actors.owner, "POST", `${path}/workflow-runs/${started.id}/terminate`)
+              .pipe(Effect.asVoid, Effect.orDie),
+          );
+          const finished = yield* api
+            .request(actors.owner, "GET", `${path}/workflow-runs/${started.id}`)
+            .pipe(
+              Effect.flatMap((response) => body(WorkflowRun, response)),
+              Effect.flatMap((run) =>
+                ["errored", "complete", "terminated"].includes(run.status)
+                  ? Effect.succeed(run)
+                  : Effect.fail("Workflow still running"),
+              ),
+              Effect.retry({ schedule: Schedule.spaced("50 millis"), times: 100 }),
+            );
+          expect(finished.status).toBe("errored");
+          expect(yield* backend.calls).toHaveLength(before);
+          expect(finished.failure).toMatchObject({ errorName: "ModelRequestFailed" });
+          expect(finished.failure?.message).toContain("unavailable inside durable workflow steps");
+        }
+        yield* backend.respond("ok");
+        const held = yield* backend.hold;
+        const request = yield* f.call().pipe(Effect.forkChild);
+        yield* held.started;
+        yield* Fiber.interrupt(request);
+        yield* held.cancelled;
+        yield* held.release;
+        expect((yield* f.inspect()).rows).toEqual([]);
+        const enabled = yield* api.request(actors.owner, "PATCH", `${path}/schedules/digest`, {
+          enabled: true,
+          scope: "app",
+        });
+        expect(enabled.status, JSON.stringify(enabled.body)).toBe(200);
+        const schedule = yield* body(
+          Schema.Struct({ id: Schema.String, actor: Schema.NullOr(Schema.String) }),
+          enabled,
+        );
+        expect(schedule.actor).toBeNull();
+        const before = (yield* backend.calls).length;
+        expect(
+          (yield* api.request(
+            actors.owner,
+            "POST",
+            `${path}/schedules/digest/copies/${schedule.id}/run`,
+          )).status,
+        ).toBe(200);
+        const observed = yield* f.inspect().pipe(
+          Effect.flatMap((value) =>
+            value.rows.length === 1
+              ? Effect.succeed(value)
+              : Effect.fail("Schedule has not committed its interpretation"),
+          ),
+          Effect.retry({ schedule: Schedule.spaced("50 millis"), times: 100 }),
+        );
+        expect(observed).toEqual({
+          models: false,
+          rows: [{ category: "finance", actor: "background" }],
+        });
