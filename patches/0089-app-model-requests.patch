+export const appModelSource = `import { defineApp, mutation, query, workflow, appInterval, object, string, router, type AnyScopeMutationContext } from "apps";
+const requirements = { models: { email: { scope: "app", model: "fixture-model" }, personal: { scope: "user", model: "fixture-model" } } } as const;
+const interpret = mutation({ input: object({ email: string() }) }, async (ctx: AnyScopeMutationContext<typeof requirements>, input) => {
+  const response = await ctx.models.email.request({ messages: [{ role: "user", content: input.email }],
+    response_format: { type: "json_schema", json_schema: { name: "email", strict: true,
+      schema: { type: "object", properties: { category: { type: "string" }, action: { type: "string" } }, required: ["category", "action"], additionalProperties: false } } } });
+  const value = JSON.parse(response.choices[0].message.content ?? "null");
+  if (value?.category !== "finance" || value?.action !== "reply") throw new Error("Invalid email interpretation");
+  ctx.sql.exec("INSERT INTO interpretations (category, actor) VALUES (?, ?)", value.category, ctx.user?.id ?? "background");
+  return value;
+});
+const personal = mutation({ input: object({}) }, async (ctx) =>
+  (await ctx.models.personal.request({ messages: [{ role: "user", content: "Classify my email" }] })).model);
+const invalid = mutation({ input: object({}) }, async (ctx) =>
+  ctx.models.email.request({ messages: [{ role: "user", content: "No streaming" }], ...Object.fromEntries([["stream", true]]) }));
+const inspect = query({ input: object({}) }, async (ctx) => ({ models: "models" in ctx,
+  rows: ctx.sql.exec("SELECT category, actor FROM interpretations ORDER BY seq").toArray() }));
+const modelStep = workflow({ input: object({}) }, async (ctx) =>
+  ctx.step.do("model", { retries: { limit: 2, delay: 10 } }, async (step) =>
+    step.models.email.request({ messages: [{ role: "user", content: "Interpret one email" }] })));
+const mutationStep = workflow({ input: object({}) }, async (ctx) =>
+  ctx.step.runMutation("interpret", interpret, { email: "Interpret one email" }, { retries: { limit: 2, delay: 10 } }));
+export default defineApp(requirements, async () => ({
+  tools: router({ interpret, personal, invalid, inspect }),
+  workflows: { modelStep, mutationStep },
+  schedules: { digest: appInterval({ minutes: 60 }, interpret, { email: "A synthetic invoice needs a reply" }) },
+}));`;
+
+export const appModelMigration = {
+  path: "migrations/0001_interpretations.sql",
+  content:
+    "CREATE TABLE interpretations (seq INTEGER PRIMARY KEY AUTOINCREMENT, category TEXT NOT NULL, actor TEXT NOT NULL);\n",
+};
