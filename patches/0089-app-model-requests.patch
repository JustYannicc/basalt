+import { Effect, Schema } from "effect";
+import { ModelRequestFailed, ModelResponse, type ModelHost } from "apps/contracts";
+import type { ModelBackend } from "../contracts/models.ts";
+import { AppId } from "../contracts/shared.ts";
+import { storedApp, storedVersion } from "./apps.ts";
+import type { Query } from "./database.ts";
+
+/** Check the retained declaration again when the callback runs, before reaching any pool. */
+export const modelsForInvocation = (
+  db: Query,
+  backend: ModelBackend | undefined,
+  identity: {
+    readonly app: string;
+    readonly build: string;
+    readonly caller?: string;
+    readonly durableStep?: boolean;
+  },
+): Effect.Effect<ModelHost> =>
+  Effect.gen(function* () {
+    const services = yield* Effect.context<never>();
+    return (command) =>
+      Effect.gen(function* () {
+        // Engine replay can repeat a charged request until durable dispatch receipts exist.
+        if (identity.durableStep)
+          return yield* new ModelRequestFailed({ reason: "durable_steps_unavailable" });
+        if (backend === undefined)
+          return yield* new ModelRequestFailed({ reason: "binding_missing" });
+        const app = yield* storedApp(db, { app: AppId.make(identity.app) });
+        const version = yield* storedVersion(db, app);
+        if (version.build !== identity.build)
+          return yield* new ModelRequestFailed({ reason: "denied" });
+        const declaration = version.requirements.models?.[command.requirement];
+        if (declaration === undefined)
+          return yield* new ModelRequestFailed({ reason: "invalid_request" });
+        if (declaration.scope === "user" && identity.caller === undefined)
+          return yield* new ModelRequestFailed({ reason: "denied" });
+        const limits = declaration.limits;
+        if (
+          new TextEncoder().encode(JSON.stringify(command.request)).byteLength >
+          (limits?.maxInputBytes ?? 1_048_576)
+        )
+          return yield* new ModelRequestFailed({ reason: "invalid_request" });
+        if (
+          limits?.maxOutputTokens !== undefined &&
+          (command.request.max_tokens ?? 0) > limits.maxOutputTokens
+        )
+          return yield* new ModelRequestFailed({ reason: "invalid_request" });
+        const dispatched = backend.request({ ...identity, ...command, declaration }).pipe(
+          Effect.flatMap(Schema.decodeUnknownEffect(ModelResponse)),
+          Effect.catchTag("SchemaError", () =>
+            Effect.fail(new ModelRequestFailed({ reason: "invalid_response" })),
+          ),
+        );
+        return yield* limits?.timeoutMs === undefined
+          ? dispatched
+          : dispatched.pipe(
+              Effect.timeout(limits.timeoutMs),
+              Effect.catchTag("TimeoutError", () =>
+                Effect.fail(new ModelRequestFailed({ reason: "timeout" })),
+              ),
+            );
+      }).pipe(
+        Effect.mapError((error) =>
+          Schema.is(ModelRequestFailed)(error)
+            ? error
+            : new ModelRequestFailed({ reason: "denied" }),
+        ),
+        Effect.provideContext(services),
+      );
+  });
