diff --git a/e2e/support/hosted-log.ts b/e2e/support/hosted-log.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/hosted-log.ts
@@ -0,0 +1,196 @@
+/**
+ * The product's log, entry by entry, in the order written. Self-host and the Workers' own JSON
+ * writers put one JSON record on a line. A hosted Worker writes each Effect log line as one
+ * structured object, which the local runtime prints as a JavaScript literal: one line, or a block
+ * from `{` to `}`. Alchemy prefixes each line with its Worker's name, and Workers interleave, so a
+ * block is collected per name. Both shapes read as the same record. A record keeps its text as
+ * written, so a reader of lines still sees a record that carries no message, such as a JSON line a
+ * Worker writes with `console.log`.
+ */
+export type HostedLogEntry =
+  | {
+      readonly kind: "record";
+      readonly value: Readonly<Record<string, unknown>>;
+      readonly text: string;
+    }
+  | { readonly kind: "line"; readonly text: string };
+
+const workerName = /^\[[^\]\s]+\] /;
+const escapes: Readonly<Record<string, string>> = {
+  n: "\n",
+  r: "\r",
+  t: "\t",
+  b: "\b",
+  f: "\f",
+  v: "\v",
+  "0": "\0",
+};
+
+const object = (value: unknown): Readonly<Record<string, unknown>> | undefined =>
+  value !== null && typeof value === "object" && !Array.isArray(value)
+    ? (value as Readonly<Record<string, unknown>>)
+    : undefined;
+
+const json = (text: string) => {
+  try {
+    return object(JSON.parse(text));
+  } catch {
+    return undefined;
+  }
+};
+
+/** A quoted literal from `start`, with its escapes read; adjacent pieces joined by `+` included. */
+const quoted = (text: string, start: number) => {
+  let value = "";
+  let at = start;
+  for (;;) {
+    const quote = text[at];
+    let end = at + 1;
+    while (end < text.length && text[end] !== quote) {
+      if (text[end] === "\\" && end + 1 < text.length) {
+        const next = text[end + 1]!;
+        const code = /^x([0-9a-f]{2})|^u\{([0-9a-f]+)\}|^u([0-9a-f]{4})/i.exec(text.slice(end + 1));
+        if (code !== null) {
+          value += String.fromCodePoint(Number.parseInt(code[1] ?? code[2] ?? code[3]!, 16));
+          end += 1 + code[0].length;
+        } else {
+          value += escapes[next] ?? next;
+          end += 2;
+        }
+        continue;
+      }
+      value += text[end];
+      end += 1;
+    }
+    if (end >= text.length) return undefined;
+    at = end + 1;
+    // A long string with line breaks prints as pieces joined by `+`.
+    const joined = /^\s*\+\s*(?=['"`])/.exec(text.slice(at));
+    if (joined === null) return { value, end: at };
+    at += joined[0].length;
+  }
+};
+
+/** The object a printed JavaScript literal shows, or undefined when it is not plain data. */
+const literal = (text: string) => {
+  let out = "";
+  let at = 0;
+  while (at < text.length) {
+    const char = text[at]!;
+    if (char === "'" || char === '"' || char === "`") {
+      const read = quoted(text, at);
+      if (read === undefined) return undefined;
+      out += JSON.stringify(read.value);
+      at = read.end;
+    } else if (/[A-Za-z_$]/.test(char)) {
+      let end = at;
+      while (end < text.length && /[\w$]/.test(text[end]!)) end += 1;
+      const word = text.slice(at, end);
+      out += /^\s*:/.test(text.slice(end))
+        ? JSON.stringify(word)
+        : word === "undefined"
+          ? "null"
+          : word === "true" || word === "false" || word === "null"
+            ? word
+            : JSON.stringify(word);
+      at = end;
+    } else if (
+      char === "[" &&
+      /^\[(?:Object|Array|Function|Circular|Getter|Setter)\b/.test(text.slice(at))
+    ) {
+      const end = text.indexOf("]", at);
+      if (end < 0) return undefined;
+      out += JSON.stringify(text.slice(at, end + 1));
+      at = end + 1;
+    } else {
+      out += char;
+      at += 1;
+    }
+  }
+  return json(out);
+};
+
+/** A JSON record on one line, which may follow other text; only records with a message count. */
+const jsonRecord = (line: string) => {
+  const start = line.indexOf("{");
+  const value = start < 0 ? undefined : json(line.slice(start));
+  return value !== undefined && "message" in value ? value : undefined;
+};
+
+export const readHostedLog = (text: string): ReadonlyArray<HostedLogEntry> => {
+  const entries: HostedLogEntry[] = [];
+  const open = new Map<string, { readonly held: HostedLogEntry; readonly lines: string[] }>();
+  for (const raw of text.split("\n")) {
+    const name = workerName.exec(raw)?.[0] ?? "";
+    const line = raw.slice(name.length);
+    const block = open.get(name);
+    if (block !== undefined) {
+      block.lines.push(raw);
+      if (line === "}") {
+        open.delete(name);
+        const value = literal(block.lines.map((entry) => entry.slice(name.length)).join("\n"));
+        const done: HostedLogEntry[] =
+          value === undefined
+            ? block.lines.map((entry) => ({ kind: "line", text: entry }))
+            : [{ kind: "record", value, text: block.lines.join("\n") }];
+        entries.splice(entries.indexOf(block.held), 1, ...done);
+      }
+      continue;
+    }
+    if (line === "{") {
+      // Held at its first line's place, so the log keeps its order; an unfinished block stays
+      // that one line until a later read sees the rest.
+      const held: HostedLogEntry = { kind: "line", text: raw };
+      open.set(name, { held, lines: [raw] });
+      entries.push(held);
+      continue;
+    }
+    const value = line.startsWith("{") ? (json(line) ?? literal(line)) : jsonRecord(line);
+    entries.push(
+      value === undefined ? { kind: "line", text: raw } : { kind: "record", value, text: raw },
+    );
+  }
+  return entries;
+};
+
+/** A JSON object a plain line carries after other text, such as a prefix the reader doesn't know. */
+const embedded = (line: string) => {
+  for (let at = line.indexOf('{"'); at >= 0; at = line.indexOf('{"', at + 1)) {
+    const value = json(line.slice(at));
+    if (value !== undefined) return [value];
+  }
+  return [];
+};
+
+/** Every structured record in the log, in order: each record, and each JSON object a line holds. */
+export const hostedRecords = (text: string) =>
+  readHostedLog(text).flatMap((entry) =>
+    entry.kind === "record" ? [entry.value] : embedded(entry.text),
+  );
+
+/** The text parts of a record's message: the message itself, or the strings among its parts. */
+export const messageParts = (value: Readonly<Record<string, unknown>>) => {
+  const message = value.message;
+  return typeof message === "string"
+    ? [message]
+    : Array.isArray(message)
+      ? message.filter((part): part is string => typeof part === "string")
+      : [];
+};
+
+/**
+ * Why a reader found no report: how many log lines it read, and how many entries naming its marker
+ * it could not decode. A log shape that changes under a reader fails with this, not a bare timeout.
+ */
+export const noReport = (report: string, text: string, marker: string, decoded: number) => {
+  const marked = readHostedLog(text).filter((entry) => entry.text.includes(marker)).length;
+  const lines = text === "" ? 0 : text.split("\n").length;
+  return `No ${report} in ${lines} hosted log lines; ${Math.max(0, marked - decoded)} of ${marked} lines naming it could not be decoded`;
+};
+
+/** The text a line reader sees in an entry: a record's message parts, or its text as written. */
+export const entryTexts = (entry: HostedLogEntry) => {
+  if (entry.kind === "line") return [entry.text];
+  const parts = messageParts(entry.value);
+  return parts.length > 0 ? parts : [entry.text];
+};
