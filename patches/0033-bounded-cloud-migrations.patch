diff --git a/apps/hosted/cloud/src/implementation/migration-guard.ts b/apps/hosted/cloud/src/implementation/migration-guard.ts
new file mode 100644
index 0000000..ae091f3
--- /dev/null
+++ b/apps/hosted/cloud/src/implementation/migration-guard.ts
@@ -0,0 +1,316 @@
+/**
+ * Limits for every wait in the cloud migration job, so a stuck run fails with the step it stopped
+ * at before the deploy command's own timeout kills it without output. The job's sessions name
+ * themselves, so a failed run can report them and whatever blocks them. It never ends another
+ * session.
+ */
+import { PgClient } from "@effect/sql-pg";
+import { HostedMigrationFailed, MigrationPhase } from "@executor-js/hosted-server/migrations";
+import {
+  Cause,
+  Console,
+  Duration,
+  Effect,
+  Exit,
+  Fiber,
+  Option,
+  Redacted,
+  Ref,
+  Schema,
+} from "effect";
+import { SqlClient } from "effect/sql";
+
+/** How the job's sessions appear in `pg_stat_activity`. */
+export const migrationApplicationName = "executor-deploy-job";
+
+/**
+ * Sent as plain `SET` statements first on every session, so the startup options stay exactly what
+ * the connection URL says. They match the limits the migration transaction already sets locally.
+ */
+export const migrationSessionSettings = [
+  "set lock_timeout = '5s'",
+  "set statement_timeout = '60s'",
+  `set application_name = '${migrationApplicationName}'`,
+] as const;
+
+export interface MigrationLimits {
+  /** Opening one connection: DNS, TCP, TLS and authentication. */
+  readonly connect: Duration.Duration;
+  /**
+   * Waiting for a reply on Better Auth's sessions; above `statement_timeout`. The migration
+   * session's client has no such option, so `attempt` bounds a dead connection there.
+   */
+  readonly read: Duration.Duration;
+  /** One whole run with its own sessions. */
+  readonly attempt: Duration.Duration;
+  /** Closing a run's sessions. */
+  readonly close: Duration.Duration;
+  /** The blocker report after a failed run. */
+  readonly report: Duration.Duration;
+  /** Pause before the one retry after a lock timeout. */
+  readonly retryAfter: Duration.Duration;
+  readonly attempts: number;
+}
+
+export const migrationLimits: MigrationLimits = {
+  connect: Duration.seconds(10),
+  read: Duration.seconds(75),
+  attempt: Duration.seconds(150),
+  close: Duration.seconds(10),
+  report: Duration.seconds(15),
+  retryAfter: Duration.seconds(2),
+  attempts: 2,
+};
+
+/** The longest the job can take; the deploy command's timeout must exceed it. */
+export const migrationWorstCase = Duration.sum(
+  Duration.times(
+    Duration.sum(
+      Duration.sum(migrationLimits.attempt, migrationLimits.close),
+      migrationLimits.report,
+    ),
+    migrationLimits.attempts,
+  ),
+  Duration.times(migrationLimits.retryAfter, migrationLimits.attempts - 1),
+);
+
+/**
+ * When `migrate.ts` exits on its own, outside the Effect runtime, if the job somehow outlives its
+ * worst case. Below the deploy command's timeout, whose error drops the job's stderr: an exit
+ * keeps it in the command's error.
+ */
+export const migrationHardLimit = Duration.sum(migrationWorstCase, Duration.seconds(20));
+
+/** A run failed or ran out of time at `phase`. The message carries no driver text or values. */
+export class CloudMigrationStopped extends Schema.TaggedError<CloudMigrationStopped>()(
+  "CloudMigrationStopped",
+  {
+    phase: Schema.String,
+    attempt: Schema.Number,
+    attempts: Schema.Number,
+    reason: Schema.String,
+  },
+) {
+  override get message() {
+    return `Cloud migration failed at "${this.phase}" (attempt ${this.attempt} of ${this.attempts}): ${this.reason}`;
+  }
+}
+
+class AttemptDeadline extends Schema.TaggedError<AttemptDeadline>()("AttemptDeadline", {}) {}
+
+/** SQLSTATE classes, so a Node error code such as `EPIPE` is not read as one. */
+const sqlState = /^(?:[0-5][0-9A-Z]|F0|HV|P0|XX)[0-9A-Z]{3}$/;
+
+/** The first SQLSTATE along `cause`'s chain, including {@link HostedMigrationFailed}'s own. */
+export const sqlStateOf = (cause: unknown): string | undefined => {
+  let current: unknown = cause;
+  for (let depth = 0; depth < 8 && typeof current === "object" && current !== null; depth++) {
+    for (const key of ["sqlState", "code"]) {
+      const value = Reflect.get(current, key);
+      if (typeof value === "string" && sqlState.test(value)) return value;
+    }
+    current = Reflect.get(current, "cause");
+  }
+  return undefined;
+};
+
+const failureTags = (cause: unknown) => {
+  const tags: Array<string> = [];
+  let current: unknown = cause;
+  for (let depth = 0; depth < 8 && typeof current === "object" && current !== null; depth++) {
+    const tag = Reflect.get(current, "_tag") ?? Reflect.get(current, "name");
+    if (typeof tag === "string") tags.push(tag);
+    current = Reflect.get(current, "cause");
+  }
+  return tags.length > 0 ? tags.join(" > ") : "unknown cause";
+};
+
+const describe = (cause: unknown) => {
+  const state = sqlStateOf(cause);
+  if (state === "55P03") return "lock timeout (55P03)";
+  if (state === "57014") return "statement timeout or cancel (57014)";
+  // Its message holds only cause tags and a SQLSTATE.
+  if (cause instanceof HostedMigrationFailed) return cause.message;
+  return `${failureTags(cause)}${state === undefined ? "" : ` (SQLSTATE ${state})`}`;
+};
+
+/**
+ * Run `attempt` with its phase recorded, within {@link migrationLimits}. A lock timeout (55P03)
+ * gets exactly one more attempt on fresh sessions: the migration transaction rolled back, and
+ * every auth and provisioning step repeats safely. Nothing else is retried. Each step is written
+ * to stderr as it starts, so even a killed job shows where it was, and each failure writes its
+ * phase and `report` there too.
+ */
+export const guardMigration = <E, R, RE>(options: {
+  readonly attempt: Effect.Effect<void, E, R>;
+  readonly report: Effect.Effect<ReadonlyArray<string>, RE>;
+  readonly limits?: Partial<MigrationLimits>;
+}) =>
+  Effect.gen(function* () {
+    const limits = { ...migrationLimits, ...options.limits };
+    const phase = yield* Ref.make("open the database sessions");
+    for (let attempt = 1; ; attempt++) {
+      const enter = (next: string) =>
+        Ref.set(phase, next).pipe(
+          Effect.andThen(Console.error(`Migration step (attempt ${attempt}): ${next}`)),
+        );
+      yield* enter("open the database sessions");
+      // Detached, so closing a stalled run's sessions, which can stall too, gets only `close`.
+      const fiber = yield* options.attempt.pipe(
+        Effect.provideService(MigrationPhase, enter),
+        Effect.exit,
+        Effect.forkDetach,
+      );
+      const stop = Fiber.interrupt(fiber).pipe(Effect.timeoutOption(limits.close));
+      const finished = yield* Fiber.join(fiber).pipe(
+        Effect.timeoutOption(limits.attempt),
+        Effect.onInterrupt(() => stop),
+      );
+      let cause: unknown;
+      if (Option.isNone(finished)) {
+        yield* stop;
+        cause = new AttemptDeadline();
+      } else if (Exit.isSuccess(finished.value)) return;
+      // A defect, such as a pool that failed to close, is reported like a failure.
+      else cause = Cause.squash(finished.value.cause);
+      const stopped = new CloudMigrationStopped({
+        phase: yield* Ref.get(phase),
+        attempt,
+        attempts: limits.attempts,
+        reason:
+          cause instanceof AttemptDeadline
+            ? `no progress within ${Duration.format(limits.attempt)}`
+            : describe(cause),
+      });
+      yield* Console.error(stopped.message);
+      const lines = yield* options.report.pipe(
+        Effect.timeoutOrElse({
+          duration: limits.report,
+          orElse: () => Effect.succeed(["Blocker report: timed out"]),
+        }),
+        Effect.orElseSucceed(() => ["Blocker report: unavailable"]),
+      );
+      for (const line of lines) yield* Console.error(line);
+      const retry = !(cause instanceof AttemptDeadline) && sqlStateOf(cause) === "55P03";
+      if (!retry || attempt >= limits.attempts) return yield* stopped;
+      yield* Console.error(`Retrying in ${Duration.format(limits.retryAfter)} on fresh sessions`);
+      yield* Effect.sleep(limits.retryAfter);
+    }
+  });
+
+/**
+ * A statement's shape without its values: comments, string, dollar-quoted and numeric literals
+ * become `?`; parameter placeholders and identifiers stay.
+ */
+export const queryFingerprint = (text: string | null | undefined) => {
+  if (text === null || text === undefined || text.trim() === "") return "(none)";
+  const shape = text
+    .replace(/--[^\n]*/g, " ")
+    .replace(/\/\*[\s\S]*?\*\//g, " ")
+    .replace(/\$([A-Za-z_][A-Za-z0-9_]*)?\$[\s\S]*?(?:\$\1\$|$)/g, "?")
+    .replace(/\b[eE]'(?:[^'\\]|\\[\s\S]|'')*(?:'|$)/g, "?")
+    .replace(/(?:\b[bBxXnN]|\b[uU]&)?'(?:[^']|'')*(?:'|$)/g, "?")
+    .replace(
+      /(?<![\w$])(?:0[xXoObB][0-9A-Fa-f_]+|(?:\d[\d_]*)?\.?\d[\d_]*(?:[eE][+-]?\d+)?)\b/g,
+      "?",
+    )
+    .replace(/\s+/g, " ")
+    .trim();
+  return shape.length > 160 ? `${shape.slice(0, 157)}...` : shape;
+};
+
+/** One session the report found, as the report query returns it. */
+export interface BlockerRow {
+  readonly kind: "migration" | "blocker" | "open transaction";
+  readonly pid: number;
+  readonly blocks: number | null;
+  readonly state: string | null;
+  readonly wait: string | null;
+  readonly waiting_for: string | null;
+  readonly xact_age: number | null;
+  readonly state_age: number | null;
+  readonly application: string | null;
+  readonly same_login: boolean | null;
+  readonly query: string | null;
+}
+
+const label = (value: string | null, fallback: string) => {
+  const clean = (value ?? "")
+    // No `@`: another client's application name could hold an email address.
+    .replace(/[^\w .:/()-]/g, "")
+    .slice(0, 60)
+    .trim();
+  return clean === "" ? fallback : clean;
+};
+
+/** Report lines for `rows`: no values, addresses or login names. */
+export const formatBlockerRows = (rows: ReadonlyArray<BlockerRow>): ReadonlyArray<string> => {
+  if (rows.length === 0) return ["Blocker report: no deploy-job sessions or open transactions"];
+  return rows.map((row) => {
+    const who =
+      row.kind === "blocker"
+        ? `blocker pid ${row.pid} (blocks ${row.blocks ?? "?"})`
+        : row.kind === "migration"
+          ? `deploy-job session pid ${row.pid}`
+          : `open transaction pid ${row.pid}`;
+    const parts = [
+      label(row.state, "unknown state"),
+      row.wait === null ? "not waiting" : `waiting on ${label(row.wait, "?")}`,
+      ...(row.waiting_for === null ? [] : [`for ${label(row.waiting_for, "?")}`]),
+      ...(row.xact_age === null ? [] : [`transaction open ${row.xact_age}s`]),
+      ...(row.state_age === null ? [] : [`in this state ${row.state_age}s`]),
+      `application ${label(row.application, "(none)")}`,
+      row.same_login === true ? "same login" : "other login",
+    ];
+    return `Blocker report: ${who}: ${parts.join(", ")}: ${queryFingerprint(row.query)}`;
+  });
+};
+
+/**
+ * Read-only: the job's sessions, the sessions blocking them, and this database's five oldest
+ * other open transactions. `pg_blocking_pids` only reads lock state.
+ */
+export const blockerQuery = `
+with ours as (
+  select pid from pg_stat_activity
+  where application_name = $1 and pid <> pg_backend_pid()
+), blockers as (
+  select distinct b.pid, o.pid as blocks
+  from ours o cross join lateral unnest(pg_blocking_pids(o.pid)) as b(pid)
+), oldest as (
+  select pid from pg_stat_activity
+  where datname = current_database() and xact_start is not null
+    and pid <> pg_backend_pid() and pid not in (select pid from ours)
+    and pid not in (select pid from blockers)
+  order by xact_start limit 5
+), picked as (
+  select 'migration' as kind, pid, null::integer as blocks from ours
+  union all select 'blocker', pid, blocks from blockers
+  union all select 'open transaction', pid, null from oldest
+)
+select p.kind, p.pid, p.blocks, a.state,
+  case when a.wait_event is null then null
+    else a.wait_event_type || ':' || a.wait_event end as wait,
+  (select string_agg(l.locktype || ' ' || l.mode ||
+      coalesce(' on ' || l.relation::regclass::text, ''), '; ')
+    from pg_locks l where l.pid = p.pid and not l.granted) as waiting_for,
+  floor(extract(epoch from now() - a.xact_start))::integer as xact_age,
+  floor(extract(epoch from now() - a.state_change))::integer as state_age,
+  a.application_name as application,
+  a.usename = session_user as same_login,
+  a.query
+from picked p join pg_stat_activity a on a.pid = p.pid
+order by p.kind, a.xact_start nulls last`;
+
+/** Run the report on its own short session, with the same URL and limits. */
+export const blockerReport = (url: Redacted.Redacted) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    yield* sql`set lock_timeout = '1s'`;
+    yield* sql`set statement_timeout = '5s'`;
+    const rows = yield* sql.unsafe<BlockerRow>(blockerQuery, [migrationApplicationName]);
+    return formatBlockerRows(rows);
+  }).pipe(
+    Effect.provide(PgClient.layer({ url, maxConnections: 1, connectTimeout: Duration.seconds(5) })),
+    Effect.scoped,
+  );
