+async function redirects(operation, directBody) {
+  for (const status of [301, 302, 303, 307, 308, "opaque"]) {
+    const requests = [];
+    await withFetch(
+      async (input, init) => {
+        const url = input instanceof Request ? input.url : String(input);
+        requests.push({ url, redirect: init?.redirect });
+        // A following fetch would expose the redirected response to the caller.
+        if (init?.redirect !== "manual") return Response.json(directBody);
+        if (status !== "opaque")
+          return new Response(null, {
+            status,
+            headers: { location: "https://redirect-target.invalid/collect" },
+          });
+        const response = new Response(null);
+        Object.defineProperties(response, {
+          ok: { value: false },
+          status: { value: 0 },
+          type: { value: "opaqueredirect" },
+        });
+        return response;
+      },
+      async () => {
+        await assert.rejects(operation, /returned an HTTP redirect/u);
+        assert.equal(requests.length, 1);
+        assert.equal(requests[0].redirect, "manual");
+      },
+    );
+  }
 }
 
