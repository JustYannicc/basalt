diff --git a/e2e/support/frame-deadline.ts b/e2e/support/frame-deadline.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/frame-deadline.ts
@@ -0,0 +1,29 @@
+import type { Page } from "playwright";
+
+/** Observe the real browser timer after the held location has supplied the frame's URL. */
+export const observeFrameDeadline = (page: Page, url: string) =>
+  page.evaluate((url) => {
+    const original = window.setTimeout;
+    const armed = new Promise<void>((resolve) => {
+      Reflect.set(window, "setTimeout", (...args: Parameters<Window["setTimeout"]>) => {
+        const timer = Reflect.apply(original, window, args);
+        if (
+          args[1] === 30000 &&
+          [...document.querySelectorAll("iframe")].some((frame) => frame.src === url)
+        ) {
+          Reflect.set(window, "setTimeout", original);
+          resolve();
+        }
+        return timer;
+      });
+    });
+    Reflect.set(window, "__frameLoadingDeadline", armed);
+  }, url);
+
+export const waitForFrameDeadline = (page: Page) =>
+  page.evaluate(() => {
+    const armed = Reflect.get(window, "__frameLoadingDeadline");
+    if (!(armed instanceof Promise))
+      throw new Error("The frame deadline observer is not installed");
+    return armed;
+  });
