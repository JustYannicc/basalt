diff --git a/e2e/tests/cloud-pool-callbacks.spec.ts b/e2e/tests/cloud-pool-callbacks.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/cloud-pool-callbacks.spec.ts
@@ -0,0 +1,98 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { Api, body } from "../support/api.ts";
+import { Actors } from "../support/actors.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { cloudLocks } from "../support/cloud-locks.ts";
+import { Evidence } from "../support/evidence.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Installed = Schema.Struct({ id: Schema.String });
+const Access = Schema.Struct({ revision: Schema.String });
+
+// The pool commit precedes its external acknowledgment, so refused sync still leaves a real pool.
+const committedPool = Effect.gen(function* () {
+  const api = yield* Api;
+  const actors = yield* Actors;
+  const response = yield* api.request(
+    actors.owner,
+    "POST",
+    `/api/organizations/${actors.organization.id}/pools`,
+    {
+      name: "Callback pool",
+      requestId: crypto.randomUUID(),
+      newInstance: true,
+    },
+  );
+  const database = yield* cloudLocks;
+  const rows = yield* database.run({
+    sql: "select count(*)::int as pools from organization o cross join lateral jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) pool where o.id = $1",
+    params: [actors.organization.id],
+  });
+  const counts = yield* Schema.decodeUnknownEffect(
+    Schema.Array(Schema.Struct({ pools: Schema.Number })),
+  )(rows);
+  expect(counts[0]!.pools).toBeGreaterThan(0);
+  yield* (yield* Evidence).json("pool-callback-creation.json", {
+    status: response.status,
+    body: response.body,
+    pools: counts[0]!.pools,
+  });
+  return response.status;
+});
+
+layer(RuntimeLive, { excludeTestServices: true })("Cloud pool callbacks", (it) => {
+  it.effect(scenarios.cloudPoolCallbackSharing.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api;
+        const actors = yield* Actors;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const poolCreated = yield* committedPool;
+        const response = yield* api.request(actors.owner, "POST", `${prefix}/apps/install`, {
+          entry: "google-maps",
+          name: "Pool callback sharing",
+          newInstance: true,
+        });
+        expect(response.status, JSON.stringify(response.body)).toBe(200);
+        const app = yield* body(Installed, response);
+        const path = `${prefix}/apps/${app.id}`;
+        yield* Effect.addFinalizer(() =>
+          api.request(actors.owner, "DELETE", path).pipe(Effect.orDie),
+        );
+        const current = yield* body(
+          Access,
+          yield* api.request(actors.owner, "GET", `${path}/access`),
+        );
+        const shared = yield* api.request(actors.owner, "PATCH", `${path}/access`, {
+          revision: current.revision,
+          audience: { kind: "everyone" },
+        });
+        yield* (yield* Evidence).json("pool-callback-sharing.json", {
+          status: shared.status,
+          body: shared.body,
+        });
+        expect(shared.status, JSON.stringify(shared.body)).toBe(200);
+        expect(poolCreated).toBe(200);
+      }),
+    ),
+  );
+  it.effect(scenarios.cloudPoolCallbackCleanup.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api;
+        const actors = yield* Actors;
+        yield* committedPool;
+        const access = yield* api.request(
+          actors.owner,
+          "GET",
+          `/api/organizations/${actors.organization.id}/access`,
+        );
+        expect(access.status).toBe(200);
+      }),
+    ),
+  );
+});
