--- /dev/null
+++ b/apps/hosted/web/src/contracts/github-source.ts
@@ -0,0 +1,81 @@
+import { Effect, Layer } from "effect";
+import { FetchHttpClient, HttpClient, HttpClientRequest } from "effect/http";
+
+const githubRepository =
+  /^https:\/\/github\.com\/([A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+?)(?:\.git)?\/?$/u;
+
+/**
+ * The deployment's own public source repository as `owner/name`, when the brand's source link is
+ * on GitHub. Anything else has no releases to read or download from.
+ */
+export const githubSourceRepository = (source: string | undefined): string | null =>
+  source === undefined ? null : (githubRepository.exec(source)?.[1] ?? null);
+
+/**
+ * GitHub answers with Access-Control-Allow-Origin "*", which a browser refuses for a credentialed
+ * request, and its preflight rejects Effect's trace headers. So releases are read as plain
+ * anonymous requests: no credentials, no trace headers, no extra headers, through the page's
+ * current fetch.
+ */
+const anonymousGitHubClient = FetchHttpClient.layer.pipe(
+  Layer.provide(Layer.succeed(FetchHttpClient.RequestInit, { credentials: "omit" })),
+  Layer.provide(
+    Layer.succeed(FetchHttpClient.Fetch, (input, init) => globalThis.fetch(input, init)),
+  ),
+);
+
+/**
+ * Reads one release from GitHub's API in the page. `read` turns the answer into a value; its status
+ * is null when GitHub couldn't be reached or its body couldn't be read. GitHub's anonymous API
+ * allows 60 requests an hour per network address, so `remember` names the values worth keeping
+ * for the browser session, serialized, and `recall` restores one or rejects it.
+ */
+export const githubReleaseRead = <A>(input: {
+  /** The API path below `https://api.github.com/repos/`. */
+  readonly path: string;
+  readonly sessionKey: string;
+  readonly read: (status: number | null, body: unknown) => A;
+  readonly remember: (value: A, body: unknown) => string | null;
+  readonly recall: (stored: string) => A | null;
+}) =>
+  Effect.gen(function* () {
+    const known = recalled(input);
+    if (known !== null) return known;
+    const client = yield* HttpClient.HttpClient;
+    const value = yield* client
+      .execute(HttpClientRequest.get(`https://api.github.com/repos/${input.path}`))
+      .pipe(
+        Effect.flatMap((response) =>
+          response.status === 200
+            ? response.json.pipe(Effect.map((body) => ({ body, value: input.read(200, body) })))
+            : Effect.succeed({ body: null, value: input.read(response.status, null) }),
+        ),
+        Effect.orElseSucceed(() => ({ body: null, value: input.read(null, null) })),
+      );
+    store(input.sessionKey, input.remember(value.value, value.body));
+    return value.value;
+  }).pipe(
+    Effect.provideService(HttpClient.TracerPropagationEnabled, false),
+    Effect.provide(anonymousGitHubClient),
+  );
+
+const recalled = <A>(input: {
+  readonly sessionKey: string;
+  readonly recall: (stored: string) => A | null;
+}) => {
+  try {
+    const stored = globalThis.sessionStorage?.getItem(input.sessionKey);
+    return stored == null ? null : input.recall(stored);
+  } catch {
+    return null;
+  }
+};
+
+const store = (key: string, value: string | null) => {
+  if (value === null) return;
+  try {
+    globalThis.sessionStorage?.setItem(key, value);
+  } catch {
+    // Storage can be full or blocked; the read simply runs again next time.
+  }
+};
