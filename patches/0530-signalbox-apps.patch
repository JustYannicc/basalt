new file mode 100644
--- /dev/null
+++ b/apps/hosted/web/src/contracts/signalbox-apps.ts
@@ -0,0 +1,137 @@
+import { Atom } from "effect/reactivity";
+import { browserOnly } from "@executor-js/ui/contracts/http";
+import { githubReleaseRead } from "./github-source.ts";
+
+/**
+ * The version-free file names every Signalbox apps release publishes. Links use GitHub's
+ * `releases/latest/download/<name>`, which redirects without the API, so they never go stale.
+ */
+export const signalboxAppAssets = {
+  mac: "Signalbox-mac-arm64.dmg",
+  windows: "Signalbox-windows-x64-setup.exe",
+  appImage: "Signalbox-linux-x86_64.AppImage",
+  deb: "Signalbox-linux-amd64.deb",
+  android: "Signalbox-android.apk",
+  cli: "signalbox-cli.tgz",
+} as const;
+export type SignalboxAppAsset = (typeof signalboxAppAssets)[keyof typeof signalboxAppAssets];
+
+export const signalboxAppDownload = (repository: string, asset: SignalboxAppAsset) =>
+  `https://github.com/${repository}/releases/latest/download/${asset}`;
+
+/** The release notes are the only place that explains each system's first-open steps. */
+export const signalboxAppsReleaseNotes = (repository: string) =>
+  `https://github.com/${repository}/releases/latest`;
+
+export const signalboxCliInstall = (repository: string) =>
+  `npm install -g ${signalboxAppDownload(repository, signalboxAppAssets.cli)}\nsignalbox-client login`;
+
+/**
+ * What the page knows about the latest release. "unconfirmed" means GitHub couldn't answer: its
+ * anonymous API allows 60 requests an hour per network address. The download links work without
+ * it, so only the version line depends on this read.
+ */
+export type SignalboxAppsRelease =
+  | { readonly kind: "unconfirmed" }
+  | {
+      readonly kind: "read";
+      /** Only a `signalbox-clients-<version>` tag names a version of the apps. */
+      readonly version: string | null;
+      readonly released: string | null;
+      readonly assets: ReadonlyArray<string>;
+    };
+
+const clientsTag = /^signalbox-clients-(.+)$/u;
+const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
+
+/** "12 Nov", in UTC so every viewer and the release page agree on the day. */
+const releasedOn = (value: unknown) => {
+  if (typeof value !== "string") return null;
+  const date = new Date(value);
+  return Number.isNaN(date.getTime()) ? null : `${date.getUTCDate()} ${months[date.getUTCMonth()]}`;
+};
+
+const isObject = (value: unknown): value is { readonly [name: string]: unknown } =>
+  typeof value === "object" && value !== null;
+const field = (body: unknown, name: string): unknown => (isObject(body) ? body[name] : undefined);
+
+/** GitHub's `releases/latest` answer, as the page shows it. */
+export function signalboxAppsRelease(status: number | null, body: unknown): SignalboxAppsRelease {
+  if (status !== 200 || !isObject(body)) return { kind: "unconfirmed" };
+  const tag = field(body, "tag_name");
+  const assets = field(body, "assets");
+  return {
+    kind: "read",
+    version: typeof tag === "string" ? (clientsTag.exec(tag)?.[1] ?? null) : null,
+    released: releasedOn(field(body, "published_at")),
+    assets: Array.isArray(assets)
+      ? assets.flatMap((asset: unknown) => {
+          const name = field(asset, "name");
+          return typeof name === "string" ? [name] : [];
+        })
+      : [],
+  };
+}
+
+/** "Version 0.2.0 · released 12 Nov", or nothing when the release names no apps version. */
+export const signalboxAppsVersionLine = (release: SignalboxAppsRelease) =>
+  release.kind === "read" && release.version !== null
+    ? `Version ${release.version}${release.released === null ? "" : ` · released ${release.released}`}`
+    : null;
+
+/** A file is "Not in this release" only when GitHub confirmed the release lacks it. */
+export const signalboxAppOffered = (release: SignalboxAppsRelease, asset: SignalboxAppAsset) =>
+  release.kind === "unconfirmed" || release.assets.includes(asset);
+
+/**
+ * Whether this browser runs on a Mac, so the Mac download leads. iPadOS Safari reports a Mac user
+ * agent too, but it has touch points.
+ */
+export const isMacBrowser = (
+  navigator:
+    | {
+        readonly userAgentData?: { readonly platform?: string };
+        readonly userAgent?: string;
+        readonly maxTouchPoints?: number;
+      }
+    | undefined,
+) => {
+  if (navigator === undefined) return false;
+  const platform = navigator.userAgentData?.platform;
+  if (platform) return platform === "macOS";
+  return (
+    /Macintosh|Mac OS X/u.test(navigator.userAgent ?? "") && (navigator.maxTouchPoints ?? 0) <= 1
+  );
+};
+
+/**
+ * The latest release, read from the page. Only a read that names an apps version is kept for the
+ * browser session: anything else is asked again. Unlike a pinned tag, `releases/latest` moves, so
+ * a kept read can show the previous release until the session ends.
+ */
+export const signalboxAppsReleaseCheck = (repository: string) =>
+  githubReleaseRead<SignalboxAppsRelease>({
+    path: `${repository}/releases/latest`,
+    sessionKey: `signalbox-apps-release:${repository}`,
+    read: signalboxAppsRelease,
+    remember: (release, body) =>
+      release.kind === "read" && release.version !== null
+        ? JSON.stringify({
+            tag_name: field(body, "tag_name"),
+            published_at: field(body, "published_at"),
+            assets: release.assets.map((name) => ({ name })),
+          })
+        : null,
+    recall: (stored) => {
+      const release = signalboxAppsRelease(200, JSON.parse(stored));
+      return release.kind === "read" && release.version !== null ? release : null;
+    },
+  });
+
+/**
+ * Read whenever the page mounts the atom; after one kept read the session answers instead of
+ * GitHub.
+ */
