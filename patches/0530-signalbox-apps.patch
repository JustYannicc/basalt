diff --git a/apps/hosted/web/src/implementation/pages/signalbox-apps.tsx b/apps/hosted/web/src/implementation/pages/signalbox-apps.tsx
new file mode 100644
--- /dev/null
+++ b/apps/hosted/web/src/implementation/pages/signalbox-apps.tsx
@@ -0,0 +1,240 @@
+import { useAtomValue } from "@effect/atom-react";
+import { Link, useLocation } from "@tanstack/react-router";
+import { AsyncResult } from "effect/reactivity";
+import { useId, useSyncExternalStore, type ReactNode } from "react";
+import { Button } from "@executor-js/ui/components/button";
+import {
+  Card,
+  CardContent,
+  CardDescription,
+  CardFooter,
+  CardHeader,
+  CardTitle,
+} from "@executor-js/ui/components/card";
+import { Code } from "@executor-js/ui/dashboard/code";
+import { PageFrame, PageHeader } from "@executor-js/ui/dashboard/page";
+import { useDocumentTitle } from "@executor-js/ui/hooks/document-title";
+import { useProductBrand } from "@executor-js/ui/hooks/product-brand";
+import { githubSourceRepository } from "../../contracts/github-source.ts";
+import { parseAccountSearch } from "../../contracts/navigation.ts";
+import {
+  isMacBrowser,
+  signalboxAppAssets,
+  signalboxAppDownload,
+  signalboxAppOffered,
+  signalboxAppsReleaseAtom,
+  signalboxAppsReleaseNotes,
+  signalboxAppsVersionLine,
+  signalboxCliInstall,
+  type SignalboxAppAsset,
+  type SignalboxAppsRelease,
+} from "../../contracts/signalbox-apps.ts";
+import { useAccountOrganization } from "../components/account.tsx";
+import {
+  accountSettingClass,
+  signalboxAppsDescription,
+  signalboxAppsTitle,
+} from "../components/account-pending.tsx";
+
+const linkClass = "font-medium text-foreground underline underline-offset-2";
+const noSubscription = () => () => {};
+
+/** Only the browser knows its platform; the server renders the fixed order. */
+const useMacBrowser = () =>
+  useSyncExternalStore(
+    noSubscription,
+    () => isMacBrowser(globalThis.navigator),
+    () => false,
+  );
+
+/**
+ * Downloads for the Signalbox apps from the deployment's own GitHub releases. The links never
+ * depend on GitHub's API; only the version line and "Not in this release" do.
+ */
+export function SignalboxAppsPage() {
+  useDocumentTitle(signalboxAppsTitle);
+  const repository = githubSourceRepository(useProductBrand().source);
+  return repository === null ? (
+    <PageFrame>
+      <PageHeader title={signalboxAppsTitle} />
+      <p className="text-[13px] text-muted-foreground">
+        This deployment doesn't publish the Signalbox apps.
+      </p>
+    </PageFrame>
+  ) : (
+    <SignalboxApps repository={repository} />
+  );
+}
+
+function SignalboxApps({ repository }: { readonly repository: string }) {
+  const result = useAtomValue(signalboxAppsReleaseAtom(repository));
+  const release: SignalboxAppsRelease = AsyncResult.isSuccess(result)
+    ? result.value
+    : { kind: "unconfirmed" };
+  const version = signalboxAppsVersionLine(release);
+  const mac = useMacBrowser();
+  const notes = signalboxAppsReleaseNotes(repository);
+  const download = (asset: SignalboxAppAsset, label: string, primary = false) =>
+    signalboxAppOffered(release, asset) ? (
+      <Button key={asset} variant={primary ? "default" : "outline"} size="sm" asChild>
+        <a href={signalboxAppDownload(repository, asset)}>{label}</a>
+      </Button>
+    ) : null;
+
+  return (
+    <PageFrame>
+      <PageHeader
+        title={signalboxAppsTitle}
+        description={
+          <>
+            {signalboxAppsDescription}
+            {/* Holds the version line's height while GitHub answers; a failed read drops it. */}
+            {AsyncResult.isInitial(result) ? (
+              <span className="block min-h-[1lh]" aria-hidden />
+            ) : (
+              version !== null && <span className="block">{version}</span>
+            )}
+          </>
+        }
+      />
+      <div className="grid gap-3 md:grid-cols-2">
+        <ClientCard
+          title="Mac"
+          requirement="Apple silicon (M1 or later), macOS 14 or newer"
+          help="macOS asks you to allow it once."
+          notes={notes}
+          downloads={[download(signalboxAppAssets.mac, "Download for Mac", mac)]}
+        />
+        <ClientCard
+          title="Windows"
+          requirement="64-bit Windows"
+          help="Windows may say it protected your PC."
+          notes={notes}
+          downloads={[download(signalboxAppAssets.windows, "Download for Windows")]}
+        />
+        <ClientCard
+          title="Linux"
+          requirement="64-bit x86, as an AppImage or a .deb package"
+          help="The AppImage needs one step before it runs."
+          notes={notes}
+          downloads={[
+            download(signalboxAppAssets.appImage, "Download AppImage"),
+            download(signalboxAppAssets.deb, "Download .deb"),
+          ]}
+        />
+        <ClientCard
+          title="Android"
+          requirement="Download it on your phone"
+          help="Android asks you to allow installs from your browser."
+          notes={notes}
+          downloads={[download(signalboxAppAssets.android, "Download for Android")]}
+        />
+        <ClientCard
+          title="Command line"
+          requirement="For servers and terminals without a desktop. Needs Node.js 24.18 or newer."
+          notes={notes}
+          wide
+          downloads={[
+            signalboxAppOffered(release, signalboxAppAssets.cli) ? (
+              // The install guides' code style wraps long commands instead of scrolling them.
+              <div
+                key="cli"
+                className="mcp-install-code w-full min-w-0 overflow-hidden rounded-lg border"
+              >
+                <Code
+                  code={signalboxCliInstall(repository)}
+                  path="install.sh"
+                  lineNumbers={false}
+                  copyable
+                  copyLabel="Copy commands"
+                />
+              </div>
+            ) : null,
+          ]}
+        />
+      </div>
+      <OtherPlatforms notes={notes} />
+    </PageFrame>
+  );
+}
+
+/** One client: what it runs on, its downloads, and where its first-open steps are. */
+function ClientCard({
+  title,
+  requirement,
+  help,
+  notes,
+  wide = false,
+  downloads,
+}: {
+  readonly title: string;
+  readonly requirement: string;
+  readonly help?: string;
+  readonly notes: string;
+  readonly wide?: boolean;
+  /** One entry per file; a file the release lacks is null. */
+  readonly downloads: ReadonlyArray<ReactNode>;
+}) {
+  const offered = downloads.filter(Boolean);
+  const heading = useId();
+  return (
+    <section aria-labelledby={heading} className={wide ? "md:col-span-2" : undefined}>
+      <Card className={`${accountSettingClass} h-full`}>
+        <CardHeader>
+          <CardTitle>
+            <h2 id={heading}>{title}</h2>
+          </CardTitle>
+          <CardDescription>{requirement}</CardDescription>
+        </CardHeader>
+        <CardContent className="mt-auto">
+          {offered.length > 0 ? (
+            <div className="grid gap-2 sm:flex sm:flex-wrap">{offered}</div>
+          ) : (
+            <p className="text-[12px] text-muted-foreground">Not in this release</p>
+          )}
+        </CardContent>
+        {help !== undefined && offered.length > 0 && (
+          <CardFooter>
+            <p>
+              {help}{" "}
+              <a className={linkClass} href={notes} target="_blank" rel="noreferrer">
+                See the steps
+              </a>
+            </p>
+          </CardFooter>
+        )}
+      </Card>
+    </section>
+  );
+}
+
+/** iPhone, iPad and Obsidian have no download here; say where each one stands. */
+function OtherPlatforms({ notes }: { readonly notes: string }) {
+  const { search } = useLocation();
+  const { selected } = useAccountOrganization(parseAccountSearch(search).organization);
+  return (
+    <ul className="mt-4 space-y-1.5 text-[12px] leading-5 text-muted-foreground">
+      <li>
+        iPhone and iPad: not available yet.{" "}
+        <a className={linkClass} href={notes} target="_blank" rel="noreferrer">
+          Release notes
+        </a>
+      </li>
+      <li>
+        Obsidian: install Signalbox Sync with Connect Obsidian on your notes app.
+        {selected !== undefined && (
+          <>
+            {" "}
+            <Link
+              className={linkClass}
+              to="/org/$organizationSlug/apps"
+              params={{ organizationSlug: selected.slug }}
+            >
+              Open apps
+            </Link>
+          </>
+        )}
+      </li>
+    </ul>
+  );
+}
