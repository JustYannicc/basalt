+import { expect, layer } from "@effect/vitest";
+import { Effect, Fiber, Schedule, Schema } from "effect";
+import { body } from "../support/api.ts";
+import { appModelFixture } from "../support/app-model-fixture.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { WorkflowRun } from "../support/workflow-app.ts";
+import { appModelMigration } from "../support/app-model-source.ts";
+
+const Bindings = Schema.Struct({
+  declarations: Schema.Record(Schema.String, Schema.Unknown),
+  canBindApp: Schema.Boolean,
+  pools: Schema.Array(Schema.Struct({ id: Schema.String, name: Schema.String })),
+  bindings: Schema.Array(
+    Schema.Struct({
+      requirement: Schema.String,
+      scope: Schema.String,
+      pool: Schema.String,
+      poolName: Schema.NullOr(Schema.String),
+      authorizerName: Schema.NullOr(Schema.String),
+      status: Schema.String,
+      stale: Schema.Boolean,
+    }),
+  ),
+});
+
+layer(RuntimeLive, { excludeTestServices: true })("App model requests", (it) => {
+  it.effect(scenarios.appModelRequests.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* appModelFixture;
+        yield* serverControl("stop");
+        yield* legacyStorage([
+          {
+            sql: `update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb), '{basaltPools}', $1::jsonb)::text where id = $2`,
+            params: [
+              JSON.stringify({
+                [f.ids.admin]: {
+                  app: f.pool,
+                  version: "retained-version",
+                  authorization: "executor-app-v1",
+                },
+              }),
+              f.actors.organization.id,
+            ],
+          },
+        ]);
+        yield* serverControl("environment", 200, {
+          POOL_APP_SIGNING_KEY: "ab".repeat(32),
+          BASALT_POOL_ORIGIN: f.backend.origin,
+        });
+        yield* serverControl("start");
+        const { api, actors, backend, path, pool, other, ids } = f;
+        const bindings = (actor = actors.member) =>
+          api
+            .request(actor, "GET", `${path}/models`)
+            .pipe(Effect.flatMap((response) => body(Bindings, response)));
+        expect(yield* backend.calls).toHaveLength(0);
+        expect(yield* f.inspect()).toEqual({ models: false, rows: [] });
+        expect(
+          (yield* api.request(actors.member, "GET", `${f.prefix}/apps/${pool}/access`)).status,
+        ).toBe(403);
+        expect((yield* f.call()).body).toMatchObject({
+          _tag: "ToolCallFailed",
+          failure: { source: "service", errorName: "ModelRequestFailed", code: "binding_missing" },
+        });
+        expect(yield* backend.calls).toHaveLength(0);
+        expect((yield* bindings()).pools).toEqual([]);
+        expect((yield* bindings(actors.admin)).pools).toEqual([
+          { id: pool, name: "Private model pool" },
+        ]);
+        expect((yield* f.bind(actors.owner)).status).toBe(403);
+        expect((yield* f.bind(actors.member)).status).toBe(403);
+        expect((yield* f.bind(actors.admin, "email", "app", other)).status).toBe(403);
+        expect((yield* f.bind()).status).toBe(200);
+        const memberView = yield* bindings();
+        expect(memberView.canBindApp).toBe(false);
+        expect(memberView.bindings).toMatchObject([
+          {
+            requirement: "email",
+            scope: "app",
+            poolName: null,
+            status: "hidden",
+            stale: false,
+          },
+        ]);
+        expect(JSON.stringify(memberView)).not.toContain("Private model pool");
+        expect((yield* bindings(actors.admin)).bindings[0]).toMatchObject({
+          poolName: "Private model pool",
+          status: "ready",
+        });
+        expect(yield* backend.calls).toHaveLength(0);
+        const first = yield* f.call();
+        expect(first.status, JSON.stringify(first.body)).toBe(200);
+        expect(first.body).toEqual({ category: "finance", action: "reply" });
+        expect((yield* backend.calls)[0]).toMatchObject({
+          pool,
+          app: f.app,
+          requirement: "email",
+          person: ids.member,
+          authorizer: ids.admin,
+          owner: ids.admin,
+          background: false,
+          scope: "app",
+          body: { model: "fixture-model", max_tokens: 800, n: 1, stream: false },
+        });
+        expect(yield* f.inspect()).toEqual({
+          models: false,
+          rows: [{ category: "finance", actor: ids.member }],
+        });
+        expect(yield* backend.calls).toHaveLength(1);
+        expect((yield* f.call(actors.member, "invalid", {})).body).toMatchObject({
+          failure: { code: "invalid_request" },
+        });
+        expect(yield* backend.calls).toHaveLength(1);
+        expect((yield* f.bind(actors.member, "personal", "user")).status).toBe(403);
+        expect((yield* f.bind(actors.admin, "personal", "user")).status).toBe(200);
+        expect((yield* f.call(actors.member, "personal", {})).body).toMatchObject({
+          failure: { code: "binding_missing" },
+        });
+        expect((yield* f.call(actors.admin, "personal", {})).body).toBe("fixture-model");
+        expect((yield* backend.calls).at(-1)).toMatchObject({ person: ids.admin, scope: "user" });
+
+        const members = yield* body(
+          Schema.Struct({
+            members: Schema.Array(Schema.Struct({ id: Schema.String, userId: Schema.String })),
+          }),
+          yield* api.request(
+            actors.owner,
+            "GET",
+            `/api/auth/organization/list-members?organizationId=${actors.organization.id}`,
+          ),
+        );
+        const admin = members.members.find((row) => row.userId === ids.admin);
+        expect(admin).toBeDefined();
+        if (admin === undefined) return yield* Effect.die("Missing fixture membership");
+        expect(
+          (yield* api.request(actors.owner, "POST", "/api/auth/organization/update-member-role", {
+            organizationId: actors.organization.id,
+            memberId: admin.id,
+            role: "member",
+          })).status,
+        ).toBe(200);
+        const before = (yield* backend.calls).length;
+        expect((yield* f.call()).body).toMatchObject({ failure: { code: "denied" } });
+        expect((yield* bindings()).bindings.find((row) => row.scope === "app")?.status).toBe(
+          "unavailable",
+        );
+        expect(yield* backend.calls).toHaveLength(before);
+        const redeployed = yield* api.request(actors.owner, "POST", `${path}/deploy`, {
+          files: [
+            {
+              path: "index.ts",
+              content: 'import {defineApp} from "apps"; export default defineApp({}, {});',
+            },
+            appsManifest,
+            appModelMigration,
+          ],
+        });
+        expect(redeployed.status, JSON.stringify(redeployed.body)).toBe(200);
+        expect((yield* bindings()).bindings.find((row) => row.scope === "app")).toMatchObject({
+          stale: true,
+          status: "unavailable",
+        });
+        expect((yield* f.unbind(actors.owner)).status).toBe(200);
+        expect((yield* bindings()).bindings.some((row) => row.requirement === "email")).toBe(false);
+        expect(yield* backend.calls).toHaveLength(before);
+      }),
+    ),
+  );
+
+  it.effect(scenarios.appModelLifecycle.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* appModelFixture;
+        yield* serverControl("stop");
+        yield* legacyStorage([
+          {
+            sql: `update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb), '{basaltPools}', $1::jsonb)::text where id = $2`,
+            params: [
+              JSON.stringify({
+                [f.ids.admin]: {
+                  app: f.pool,
+                  version: "retained-version",
+                  authorization: "executor-app-v1",
+                },
+              }),
+              f.actors.organization.id,
+            ],
+          },
+        ]);
+        yield* serverControl("environment", 200, {
+          POOL_APP_SIGNING_KEY: "ab".repeat(32),
+          BASALT_POOL_ORIGIN: f.backend.origin,
+        });
+        yield* serverControl("start");
+        const { api, actors, backend, path, ids } = f;
+        expect((yield* f.bind()).status).toBe(200);
+        for (const [mode, code] of [
+          ["cap", "cap_exceeded"],
+          ["unavailable", "pool_unavailable"],
+          ["unknown", "outcome_unknown"],
+          ["drop", "outcome_unknown"],
+          ["drop-body", "outcome_unknown"],
+          ["invalid", "invalid_response"],
+        ] as const) {
+          yield* backend.respond(mode);
+          const before = (yield* backend.calls).length;
+          const response = yield* f.call();
+          expect(response.body).toMatchObject({
+            _tag: "ToolCallFailed",
+            failure: { errorName: "ModelRequestFailed", code },
+          });
+          expect(JSON.stringify(response.body)).not.toContain("synthetic-invalid-response");
+          expect(yield* backend.calls).toHaveLength(before + 1);
+        }
+        yield* backend.respond("unknown");
+        for (const workflow of ["modelStep", "mutationStep"]) {
+          const before = (yield* backend.calls).length;
+          const started = yield* body(
+            WorkflowRun,
+            yield* api.request(actors.owner, "POST", `${path}/workflow-runs`, {
+              workflow,
+              input: {},
+            }),
+          );
+          yield* Effect.addFinalizer(() =>
+            api
+              .request(actors.owner, "POST", `${path}/workflow-runs/${started.id}/terminate`)
+              .pipe(Effect.asVoid, Effect.orDie),
+          );
+          const finished = yield* api
+            .request(actors.owner, "GET", `${path}/workflow-runs/${started.id}`)
+            .pipe(
+              Effect.flatMap((response) => body(WorkflowRun, response)),
+              Effect.flatMap((run) =>
+                ["errored", "complete", "terminated"].includes(run.status)
+                  ? Effect.succeed(run)
+                  : Effect.fail("Workflow still running"),
+              ),
+              Effect.retry({ schedule: Schedule.spaced("50 millis"), times: 100 }),
+            );
+          expect(finished.status).toBe("errored");
+          expect(yield* backend.calls).toHaveLength(before);
+          expect(finished.failure).toMatchObject({ errorName: "ModelRequestFailed" });
+          expect(finished.failure?.message).toContain("unavailable inside durable workflow steps");
+        }
+        yield* backend.respond("ok");
+        const held = yield* backend.hold;
+        const request = yield* f.call().pipe(Effect.forkChild);
+        yield* held.started;
+        yield* Fiber.interrupt(request);
+        yield* held.cancelled;
+        yield* held.release;
+        expect((yield* f.inspect()).rows).toEqual([]);
+        const enabled = yield* api.request(actors.owner, "PATCH", `${path}/schedules/digest`, {
+          enabled: true,
+          scope: "app",
+        });
+        expect(enabled.status, JSON.stringify(enabled.body)).toBe(200);
+        const schedule = yield* body(
+          Schema.Struct({ id: Schema.String, actor: Schema.NullOr(Schema.String) }),
+          enabled,
+        );
+        expect(schedule.actor).toBeNull();
+        const before = (yield* backend.calls).length;
+        expect(
+          (yield* api.request(
+            actors.owner,
+            "POST",
+            `${path}/schedules/digest/copies/${schedule.id}/run`,
+          )).status,
+        ).toBe(200);
+        const observed = yield* f.inspect().pipe(
+          Effect.flatMap((value) =>
+            value.rows.length === 1
+              ? Effect.succeed(value)
+              : Effect.fail("Schedule has not committed its interpretation"),
+          ),
+          Effect.retry({ schedule: Schedule.spaced("50 millis"), times: 100 }),
+        );
+        expect(observed).toEqual({
+          models: false,
+          rows: [{ category: "finance", actor: "background" }],
+        });
+        expect(yield* backend.calls).toHaveLength(before + 1);
+        expect((yield* backend.calls).at(-1)).toMatchObject({
+          person: ids.admin,
+          authorizer: ids.admin,
+          background: true,
+          app: f.app,
+          requirement: "email",
+        });
+        expect(
+          (yield* api.request(actors.owner, "PATCH", `${path}/schedules/digest`, {
+            enabled: false,
+            scope: "app",
+          })).status,
+        ).toBe(200);
+        yield* f.share({ kind: "private" });
+        expect((yield* f.call()).status).toBe(403);
+        expect(yield* backend.calls).toHaveLength(before + 1);
+      }),
+    ),
+  );
+});
