+import { hydrated } from "@executor-js/ui/contracts/http";
+import { revalidated } from "@executor-js/ui/contracts/refresh";
+import { Data } from "effect";
+import { Atom, AsyncResult } from "effect/reactivity";
+import type { AppId } from "@executor-js/sdk";
+import type { OrganizationReference } from "@executor-js/hosted-server/organization";
+import { HostedClient } from "./api.ts";
+import { protectedQuery } from "./protected-query.ts";
+
+class OrganizationKey extends Data.Class<{ readonly organization: OrganizationReference }> {}
+class ListKey extends Data.Class<{
+  readonly organization: OrganizationReference;
+  readonly pool?: AppId;
+}> {}
+
+const accounts = Atom.family((key: OrganizationKey) =>
+  HostedClient.query("resourceAccess", "accounts", hydrated({ params: key, query: {} })).pipe(
+    revalidated,
+    protectedQuery,
+  ),
+);
+const lists = Atom.family((key: ListKey) =>
+  Atom.map(
+    accounts(new OrganizationKey({ organization: key.organization })),
+    AsyncResult.map((rows) =>
+      key.pool === undefined
+        ? rows
+        : rows.filter((row) => row.bindings.some((binding) => binding.pool === key.pool)),
+    ),
+  ),
+);
+
+/** One saved-ID projection feeds both Accounts and pool membership views. Usage is queried separately. */
+export const savedAccountRowsAtom = (key: {
+  readonly organization: OrganizationReference;
+  readonly pool?: AppId;
+}) => lists(new ListKey(key));
+
+/** All mounted pool filters share the same source, so a changed binding refreshes them together. */
+export const refreshSavedAccountRows = (get: Atom.FnContext, organization: OrganizationReference) =>
+  get.refresh(accounts(new OrganizationKey({ organization })));
