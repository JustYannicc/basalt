@@ -0,0 +1,98 @@
+import { AppId, AppNotFound, StorageError } from "@executor-js/sdk/core";
+import { Effect, Schema } from "effect";
+import type { ResourceDirectory, SavedAccountBinding } from "../contracts/resource-access.ts";
+import { CurrentOrganization } from "../contracts/organization.ts";
+import { HostedExecutor } from "../contracts/executor.ts";
+import { policyDatabase } from "./resource-policy.ts";
+import { listAppAccountLinks } from "./app-account-links.ts";
+import { linkedAccountSignIn } from "./account-sign-in.ts";
+import {
+  savedAccountRows,
+  savedBindingId,
+  type AccountProjectionInput,
+} from "./account-projection-view.ts";
+
+/** Only recorded pool app IDs name pools; provider names and account labels never do. */
+const recordedPools = Effect.gen(function* () {
+  const { organization } = yield* CurrentOrganization;
+  const sql = yield* policyDatabase;
+  return new Set(
+    (yield* Schema.decodeUnknownEffect(Schema.Array(Schema.Struct({ app: AppId })))(
+      yield* sql`select entry.value ->> 'app' as app from organization o
+      cross join lateral jsonb_each(coalesce(o.metadata::jsonb -> 'basaltPools', '{}'::jsonb)) entry
+      where o.id = ${organization} and entry.value ->> 'app' is not null`,
+    )).map(({ app }) => app),
+  );
+}).pipe(
+  Effect.catchTags({ SqlError: () => new StorageError(), SchemaError: () => new StorageError() }),
+);
+
+/** Reads already-authorized native accounts and links. No Home inventory or credential fields enter it. */
+export const projectSavedAccounts = (directory: typeof ResourceDirectory.Type, pool?: AppId) =>
+  Effect.gen(function* () {
+    const pools = yield* recordedPools;
+    if (
+      pool !== undefined &&
+      (!pools.has(pool) || !directory.apps.some(({ app }) => app.id === pool))
+    )
+      return yield* new AppNotFound({ app: pool });
+    const { owner } = yield* CurrentOrganization;
+    const executor = yield* Effect.flatten(HostedExecutor);
+    // The native link reader still applies each app's policy; only its saved-account lookup is shared.
+    const all = yield* executor.accounts.list({ owner });
+    const saved = yield* Effect.forEach(
+      directory.accounts,
+      ({ account, provider, health }) =>
+        Effect.gen(function* () {
+          const signIn = yield* linkedAccountSignIn(executor, owner, account.id);
+          return {
+            account,
+            definition: provider.definition,
+            signIn,
+            bindings: [],
+            ...(health === undefined ? {} : { health }),
+          };
+        }),
+      { concurrency: 8 },
+    );
+    const links = yield* Effect.forEach(
+      directory.apps,
+      ({ app, access }) =>
+        Effect.gen(function* () {
+          const scopes = access.canUse ? (["app", "user"] as const) : (["app"] as const);
+          return (yield* Effect.forEach(scopes, (scope) =>
+            Effect.map(listAppAccountLinks(app.id, scope, all), (links) =>
+              links.flatMap((link): AccountProjectionInput[] => {
+                if (link.hostManaged === true) return [];
+                const requirement = app.requirements.accounts[link.requirement];
+                if (requirement === undefined || requirement.provider !== link.account.provider)
+                  return [];
+                const binding: SavedAccountBinding = {
+                  id: savedBindingId(app.id, scope, link.requirement, link.account.id),
+                  app: app.id,
+                  ...(pools.has(app.id) ? { pool: app.id } : {}),
+                  scope,
+                  requirement: link.requirement,
+                  access,
+                  linkedBy: link.linkedBy,
+                  canRemove: link.canRemove,
+                  canReconnect: link.canReconnect,
+                  signIn: link.signIn,
+                };
+                return [
+                  {
+                    account: link.account,
+                    definition: requirement.definition,
+                    signIn: link.signIn,
+                    bindings: [binding],
+                    ...(link.health === undefined ? {} : { health: link.health }),
+                  },
+                ];
+              }),
+            ),
+          )).flat();
+        }),
+      { concurrency: 4 },
+    );
+    return savedAccountRows([...saved, ...links.flat()], pool);
+  });
