diff --git a/apps/hosted/server/src/implementation/account-projection-view.ts b/apps/hosted/server/src/implementation/account-projection-view.ts
new file mode 100644
index 000000000..4d6e4783a
--- /dev/null
+++ b/apps/hosted/server/src/implementation/account-projection-view.ts
@@ -0,0 +1,96 @@
+import type {
+  Account,
+  AccountCredentialMechanism,
+  AccountHealth,
+  AppId,
+  ProviderDefinition,
+} from "@executor-js/sdk/core";
+import type { SavedAccountBinding, SavedAccountRow } from "../contracts/resource-access.ts";
+import type { LinkedAccountSignIn } from "../contracts/account-sign-in.ts";
+
+export interface AccountProjectionInput {
+  readonly account: Account;
+  readonly definition: ProviderDefinition;
+  readonly signIn: LinkedAccountSignIn;
+  readonly health?: AccountHealth;
+  readonly bindings: readonly SavedAccountBinding[];
+}
+
+/** Declaration metadata describes acquisition, not plan entitlement or account readiness. */
+const mechanism = (
+  definition: ProviderDefinition,
+  method: string,
+): AccountCredentialMechanism | undefined => {
+  const declared = definition.family?.methods?.[method]?.mechanism;
+  if (declared !== undefined) return declared;
+  const auth = Object.hasOwn(definition.auth, method) ? definition.auth[method] : undefined;
+  return auth === undefined
+    ? undefined
+    : auth.type === "oauth2"
+      ? "oauth"
+      : auth.type === "interactive"
+        ? "interactive"
+        : "other";
+};
+
+/** Legacy app check displayStatus can contain usage; the observation query owns that data. */
+const healthWithoutUsage = (health: AccountHealth): AccountHealth => ({
+  ...health,
+  apps: health.apps.map((entry) => {
+    if (entry.check === null) return entry;
+    const { displayStatus: _display, ...check } = entry.check;
+    return { ...entry, check };
+  }),
+});
+
+/** Native links have a composite key; use it directly rather than a label or backend reference. */
+export const savedBindingId = (
+  app: AppId,
+  scope: SavedAccountBinding["scope"],
+  requirement: string,
+  account: Account["id"],
+) => JSON.stringify([app, scope, requirement, account]);
+
+/** Exact saved IDs are the only join key. Pool filtering keeps each row's other visible bindings. */
+export const savedAccountRows = (
+  inputs: readonly AccountProjectionInput[],
+  pool?: AppId,
+): readonly SavedAccountRow[] => {
+  const rows = new Map<Account["id"], SavedAccountRow>();
+  for (const input of inputs) {
+    const { account, definition } = input;
+    const existing = rows.get(account.id);
+    const bindings = new Map((existing?.bindings ?? []).map((binding) => [binding.id, binding]));
+    for (const binding of input.bindings) bindings.set(binding.id, binding);
+    const credentialMechanism = mechanism(definition, account.method);
+    const health = input.health === undefined ? undefined : healthWithoutUsage(input.health);
+    const apps = new Map((existing?.health?.apps ?? []).map((entry) => [entry.app, entry]));
+    for (const entry of health?.apps ?? []) apps.set(entry.app, entry);
+    rows.set(account.id, {
+      // Earlier inputs carry the directory's account authority; a redacted app link cannot replace it.
+      ...(existing ?? account),
+      providerName: existing?.providerName ?? definition.name,
+      providerUrl: existing?.providerUrl ?? null,
+      ...(existing?.mechanism !== undefined || credentialMechanism === undefined
+        ? {}
+        : { mechanism: credentialMechanism }),
+      bindings: [...bindings.values()],
+      signIn: existing?.signIn ?? input.signIn,
+      ...(health === undefined && existing?.health === undefined
+        ? {}
+        : {
+            health: {
+              ...health,
+              ...existing?.health,
+              account: account.id,
+              info: existing?.health?.info ?? health?.info ?? null,
+              infoCheckedAt: existing?.health?.infoCheckedAt ?? health?.infoCheckedAt ?? null,
+              apps: [...apps.values()],
+            },
+          }),
+    });
+  }
+  return [...rows.values()].filter(
+    (row) => pool === undefined || row.bindings.some((binding) => binding.pool === pool),
+  );
+};
