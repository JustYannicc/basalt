diff --git a/e2e/tests/account-targets.spec.ts b/e2e/tests/account-targets.spec.ts
new file mode 100644
index 0000000..d0c8a8a
--- /dev/null
+++ b/e2e/tests/account-targets.spec.ts
@@ -0,0 +1,79 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import { appCallSdkHost } from "../support/app-call-sdk.ts";
+import { accountTargetSdkSource } from "../support/account-target-sdk-source.ts";
+import { TestLive, withCase } from "../support/case.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(TestLive, { excludeTestServices: true })("Account execution targets", (it) => {
+  it.effect(scenarios.accountTargets.title, (context) =>
+    withCase(
+      context,
+      Effect.gen(function* () {
+        const sdk = yield* appCallSdkHost(accountTargetSdkSource, "account-target-sdk");
+        const setup = yield* sdk.request("setup", null);
+        expect(setup.status, JSON.stringify(setup.body)).toBe(200);
+        const ids = yield* Schema.decodeUnknownEffect(
+          Schema.Struct({ app: Schema.String, local: Schema.String, cloud: Schema.String }),
+        )(setup.body);
+        const call = (account: string, kind = "query") =>
+          sdk.request("call", {
+            app: ids.app,
+            tool: "echo",
+            kind,
+            input: { message: "selected" },
+            accounts: { app: {}, user: { local: [account] } },
+          });
+        expect((yield* call(ids.cloud)).body).toMatchObject({
+          status: "completed",
+          value: { ran: "cloud" },
+        });
+        expect(
+          (yield* sdk.request("bind", { account: ids.local, revision: 0, enabled: true })).status,
+        ).toBe(200);
+        expect(
+          (yield* sdk.request("bind", { account: ids.local, revision: 0, enabled: true })).status,
+        ).toBe(409);
+        expect((yield* sdk.request("read", { account: ids.local })).body).toMatchObject({
+          execution: { kind: "device", device: "fixture-device", status: "online" },
+        });
+        // An online target is metadata, not an installed device execution path.
+        const unavailable = yield* call(ids.local);
+        expect(unavailable.status).toBe(409);
+        expect(unavailable.body).toEqual({ reason: "host_unavailable" });
+        yield* sdk.request("status", "offline");
+        expect((yield* call(ids.local)).status).toBe(503);
+        expect((yield* sdk.request("read", { account: ids.local })).body).toMatchObject({
+          execution: { status: "offline" },
+        });
+        expect((yield* call(ids.cloud)).body).toMatchObject({ value: { ran: "cloud" } });
+        yield* sdk.request("status", "unavailable");
+        expect((yield* call(ids.local)).status).toBe(409);
+        yield* sdk.request("status", "online");
+        expect((yield* call(ids.local, "mutation")).status).toBe(409);
+        yield* sdk.request("allowed", false);
+        expect((yield* call(ids.local)).status).toBe(409);
+        yield* sdk.request("allowed", true);
+        yield* sdk.restart;
+        yield* sdk.request("setup", null);
+        expect((yield* sdk.request("read", { account: ids.local })).body).toMatchObject({
+          execution: { kind: "device", status: "online" },
+        });
+        expect((yield* call(ids.local)).status).toBe(409);
+        expect(
+          (yield* sdk.request("bind", { account: ids.local, revision: 1, enabled: false })).status,
+        ).toBe(200);
+        expect((yield* call(ids.local)).status).toBe(409);
+        expect((yield* sdk.request("clear", { account: ids.local, revision: 1 })).status).toBe(409);
+        expect((yield* sdk.request("clear", { account: ids.local, revision: 2 })).status).toBe(200);
+        expect((yield* call(ids.local)).body).toMatchObject({ value: { ran: "cloud" } });
+        expect(
+          (yield* sdk.request("bind", { account: ids.local, revision: 0, enabled: true })).status,
+        ).toBe(409);
+        expect(
+          (yield* sdk.request("bind", { account: ids.local, revision: 3, enabled: true })).status,
+        ).toBe(200);
+      }),
+    ),
+  );
+});
