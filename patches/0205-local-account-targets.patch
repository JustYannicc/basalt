new file mode 100644
index 0000000..cfc2f5c
--- /dev/null
+++ b/e2e/support/account-target-sdk-source.ts
@@ -0,0 +1,69 @@
+/** Public SDK host for target metadata and refusal. It cannot execute on a device. */
+export const accountTargetSdkSource = `import * as NodeCrypto from "@effect/platform-node/NodeCrypto";
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import * as Runtime from "@effect/platform-node/NodeRuntime";
+import { nativeRepositories } from "@executor-js/app-source/node";
+import { createExecutor, makeExecutorStorage, OwnerId, AccountId, AccountTargetsHost,
+  AccountDeviceOffline, AccountExecutionUnavailable, ToolInputs, type Executor } from "@executor-js/sdk/core";
+import { filesystemBlobStore, workerdApps } from "@executor-js/sdk/node";
+import { memoryRegistry } from "@executor-js/sdk/testing";
+import { Console, Deferred, Effect, Layer, Path, Redacted, Schema } from "effect";
+import { FetchHttpClient, HttpRouter, HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { pgliteLayer } from "fumadb-effect/pglite";
+import { createServer } from "node:http";
+const input = INPUT;
+Runtime.runMain(Effect.scoped(Effect.gen(function* () {
+  const path = yield* Path.Path;
+  const database = yield* Layer.build(pgliteLayer({dataDir:path.join(input.directory,"postgres")}));
+  const storage = yield* makeExecutorStorage({provider:"postgresql"}).pipe(Effect.provideContext(database));
+  yield* storage.migrate;
+  const secret = Redacted.make("d".repeat(64));
+  const blobs = filesystemBlobStore({directory:path.join(input.directory,"blobs")});
+  const ready = yield* Deferred.make<Executor>();
+  const host = yield* workerdApps({directory:path.join(input.directory,"workerd"),blobs,
+    executor:Deferred.await(ready),npmRegistry:input.npmRegistry,encryptionKey:secret});
+  const owner = OwnerId.make("account-target-owner");
+  let status:"online"|"offline"|"unavailable" = "online";
+  let allowed = true;
+  const executor = yield* createExecutor({database:storage,secret,blobs,
+    machineAccounts:{authorize:value=>Effect.succeed(allowed && value.owner === owner),
+      availability:()=>Effect.sync(()=>status)},
+    git:nativeRepositories(path.join(input.directory,"repositories")),runtime:host.runtime,
+    workflows:host.workflows,registry:memoryRegistry()}).pipe(Effect.provide(NodeCrypto.layer));
+  yield* Deferred.succeed(ready,executor);
+  const setup = Effect.gen(function* () {
+    const existing = yield* executor.apps.list({owner});
+    const app = existing[0] ?? (yield* executor.apps.deploy({owner,name:"Account target fixture",files:[
+      {path:"index.ts",content:'import {defineApp,defineProvider,secrets,query,object,string,router} from "apps"; const service=defineProvider({name:"Target fixture",auth:{key:secrets({label:"Key",fields:object({token:string()})})}}); export default defineApp({accounts:{local:service}},{tools:router({echo:query({input:object({message:string()})},async(_ctx,input)=>({ran:"cloud",message:input.message}))})});'},input.files[1],
+    ]})).app;
+    const saved = yield* executor.accounts.list({owner});
+    const accounts = saved.length > 0 ? saved : yield* Effect.forEach(["Local", "Cloud"], label=>executor.managedAccounts.add({owner,provider:app.requirements.accounts.local!.provider,method:"key",label,fields:Redacted.make({token:"synthetic"})}));
+    return {app:app.id,local:accounts.find(a=>a.label === "Local")!.id,cloud:accounts.find(a=>a.label === "Cloud")!.id};
+  });
+  const route = <A,I>(name:string,schema:Schema.Codec<A,I>,run:(value:A)=>Effect.Effect<unknown,unknown>) =>
+    HttpRouter.add("POST",\`/_fixture/\${name}\`,Effect.gen(function* () {
+      const request = yield* HttpServerRequest.HttpServerRequest;
+      const value = yield* request.json.pipe(Effect.flatMap(Schema.decodeUnknownEffect(schema)));
+      return yield* run(value).pipe(Effect.flatMap(HttpServerResponse.json),
+        Effect.catchIf(Schema.is(AccountDeviceOffline),error=>HttpServerResponse.json({code:error.code},{status:503})),
+        Effect.catchIf(Schema.is(AccountExecutionUnavailable),error=>HttpServerResponse.json({reason:error.reason},{status:409})));
+    }).pipe(Effect.orDie));
+  const target = {device:"fixture-device",deviceName:"Fixture Mac",binding:"fixture-binding",manifestRevision:"manifest-r1"};
+  const routes = Layer.mergeAll(
+    route("setup",Schema.Null,()=>setup),
+    route("bind",Schema.Struct({account:AccountId,revision:Schema.Number,enabled:Schema.Boolean}),value=>executor[AccountTargetsHost].save({...value,owner,target})),
+    route("clear",Schema.Struct({account:AccountId,revision:Schema.Number}),value=>executor[AccountTargetsHost].clear({...value,owner}).pipe(Effect.as(null))),
+    route("read",Schema.Struct({account:AccountId}),value=>executor.accounts.get({...value,owner})),
+    route("call",ToolInputs.call,value=>executor.tools.call(value)),
+    route("status",Schema.Literals(["online","offline","unavailable"]),value=>Effect.sync(()=>{status=value;return null;})),
+    route("allowed",Schema.Boolean,value=>Effect.sync(()=>{allowed=value;return null;})),
+  );
+  const services = yield* Layer.build(HttpRouter.serve(routes,{disableLogger:true,disableListenLog:true}).pipe(
+    Layer.provideMerge(NodeHttpServer.layer(createServer,{host:"127.0.0.1",port:0}))));
+  const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(services));
+  if (!("port" in server.address)) return yield* Effect.die("Expected TCP");
+  yield* Console.log(JSON.stringify({port:server.address.port}));
+  return yield* Effect.never;
+})).pipe(Effect.provide(Layer.mergeAll(NodeServices.layer,FetchHttpClient.layer))));
+`;
