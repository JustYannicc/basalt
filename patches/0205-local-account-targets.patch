+import { Schema } from "effect";
+import { column, idColumn, table } from "fumadb-effect/schema";
+import { AccountId, OwnerId } from "../contracts/shared.ts";
+
+/** One execution target per saved account; cloud accounts have no row. */
+export const accountTargets = table("executor_account_targets", {
+  account: idColumn("account", AccountId, { type: "varchar(255)" }),
+  owner: column("owner", OwnerId, { type: "varchar(255)" }),
+  revision: column("revision", Schema.Int),
+  mode: column("mode", Schema.Literals(["cloud", "device"]), { type: "varchar(255)" }),
+  enabled: column("enabled", Schema.Boolean),
+  device: column("device", Schema.String, { type: "varchar(255)" }),
+  deviceName: column("device_name", Schema.String, { type: "varchar(255)" }),
+  binding: column("binding", Schema.String, { type: "varchar(255)" }),
+  manifestRevision: column("manifest_revision", Schema.String, { type: "varchar(255)" }),
+});
diff --git a/packages/sdk/src/implementation/account-targets.ts b/packages/sdk/src/implementation/account-targets.ts
new file mode 100644
index 0000000..696dafd
--- /dev/null
+++ b/packages/sdk/src/implementation/account-targets.ts
@@ -0,0 +1,219 @@
+import { Effect, Schema } from "effect";
+import {
+  AccountDeviceOffline,
+  AccountExecutionUnavailable,
+  AccountTargetBinding,
+  MachineAccountTarget,
+  type AccountExecution,
+  type AccountTargetsHost,
+  type MachineAccounts,
+} from "../contracts/account-target.ts";
+import { StorageError, type AccountId, type OwnerId } from "../contracts/shared.ts";
+import { storedAccount } from "./accounts.ts";
+import { query, transaction, type Query } from "./database.ts";
+
+/** Saves target metadata and refuses bound accounts before any cloud credential resolution. */
+export const makeAccountTargets = (db: Query, host: MachineAccounts | undefined) => {
+  const read = (account: AccountId, owner: OwnerId) =>
+    Effect.gen(function* () {
+      const row = yield* query(() =>
+        db.findFirst("accountTargets", {
+          where: (b) => b.and(b("account", "=", account), b("owner", "=", owner)),
+        }),
+      );
+      if (row === null) return undefined;
+      const { device, deviceName, binding, manifestRevision, ...identity } = row;
+      return yield* Schema.decodeUnknownEffect(AccountTargetBinding)({
+        ...identity,
+        target: { device, deviceName, binding, manifestRevision },
+      }).pipe(Effect.mapError(() => new StorageError()));
+    });
+  const authorize = (binding: AccountTargetBinding, managing: boolean) =>
+    Effect.gen(function* () {
+      if (host === undefined || !(yield* host.authorize({ ...binding, managing })))
+        return yield* new AccountExecutionUnavailable({
+          account: binding.account,
+          reason: "host_unavailable",
+        });
+    });
+  const operations: AccountTargetsHost = {
+    clear: (input) =>
+      transaction(db, (tx) =>
+        Effect.gen(function* () {
+          yield* query(() =>
+            tx.updateMany("accounts", {
+              where: (b) => b.and(b("id", "=", input.account), b("owner", "=", input.owner)),
+              set: { owner: input.owner },
+            }),
+          );
+          yield* storedAccount(tx, input.account, input.owner);
+          const current = yield* read(input.account, input.owner);
+          if (
+            current === undefined ||
+            current.mode === "cloud" ||
+            current.revision !== input.revision ||
+            input.revision >= Number.MAX_SAFE_INTEGER
+          )
+            return yield* new AccountExecutionUnavailable({
+              account: input.account,
+              reason: "changed",
+            });
+          yield* authorize(current, true);
+          yield* query(() =>
+            tx.updateMany("accountTargets", {
+              where: (b) =>
+                b.and(
+                  b("account", "=", input.account),
+                  b("owner", "=", input.owner),
+                  b("revision", "=", input.revision),
+                ),
+              set: { mode: "cloud", revision: input.revision + 1, enabled: false },
+            }),
+          );
+        }),
+      ),
+    get: (input) =>
+      Effect.gen(function* () {
+        yield* storedAccount(db, input.account, input.owner);
+        const binding = yield* read(input.account, input.owner);
+        if (binding !== undefined) yield* authorize(binding, false);
+        return binding;
+      }),
+    save: (input) =>
+      Effect.gen(function* () {
+        const target = yield* Schema.decodeUnknownEffect(MachineAccountTarget)(input.target, {
+          onExcessProperty: "error",
+        }).pipe(
+          Effect.mapError(
+            () => new AccountExecutionUnavailable({ account: input.account, reason: "changed" }),
+          ),
+        );
+        if (
+          !Number.isSafeInteger(input.revision) ||
+          input.revision < 0 ||
+          input.revision >= Number.MAX_SAFE_INTEGER
+        )
+          return yield* new AccountExecutionUnavailable({
+            account: input.account,
+            reason: "changed",
+          });
+        const proposed = {
+          ...input,
+          revision: input.revision + 1,
+          target,
+          mode: "device" as const,
+        };
+        yield* authorize(proposed, true);
+        return yield* transaction(db, (tx) =>
+          Effect.gen(function* () {
+            // Serialize creation and CAS updates with account replacement/removal.
+            yield* query(() =>
+              tx.updateMany("accounts", {
+                where: (b) => b.and(b("id", "=", input.account), b("owner", "=", input.owner)),
+                set: { owner: input.owner },
+              }),
+            );
+            yield* storedAccount(tx, input.account, input.owner);
+            const current = yield* read(input.account, input.owner);
+            if ((current?.revision ?? 0) !== input.revision)
+              return yield* new AccountExecutionUnavailable({
+                account: input.account,
+                reason: "changed",
+              });
+            // Retargeting never skips authorization to manage the previous device binding.
+            if (current !== undefined) yield* authorize(current, true);
+            const record = {
+              account: input.account,
+              owner: input.owner,
+              revision: proposed.revision,
+              enabled: input.enabled,
+              mode: "device" as const,
+              ...target,
+            };
+            if (current === undefined) yield* query(() => tx.create("accountTargets", record));
+            else
+              yield* query(() =>
+                tx.updateMany("accountTargets", {
+                  where: (b) =>
+                    b.and(
+                      b("account", "=", input.account),
+                      b("owner", "=", input.owner),
+                      b("revision", "=", input.revision),
+                    ),
+                  set: record,
+                }),
+              );
+            return proposed;
+          }),
+        );
+      }),
+  };
+  const execution = (input: {
+    readonly id: AccountId;
+    readonly owner: OwnerId;
+  }): Effect.Effect<AccountExecution | undefined, StorageError> =>
+    Effect.gen(function* () {
+      const binding = yield* read(input.id, input.owner);
+      if (binding === undefined || binding.mode === "cloud") return undefined;
+      const allowed =
+        host !== undefined && (yield* host.authorize({ ...binding, managing: false }));
+      const status = !binding.enabled
+        ? "disabled"
+        : !allowed || host === undefined
+          ? "unavailable"
+          : yield* host.availability(binding);
+      return {
+        kind: "device",
+        device: binding.target.device,
+        deviceName: binding.target.deviceName,
+        status,
+      };
+    });
+  const requireCloudCall = (input: {
+    readonly accounts: readonly {
+      readonly id: AccountId;
+      readonly owner: OwnerId;
+      readonly credentialGeneration: number;
+    }[];
+    readonly authorize: Effect.Effect<void, StorageError>;
+  }) =>
+    Effect.gen(function* () {
+      const bindings = yield* Effect.forEach(input.accounts, (account) =>
+        read(account.id, account.owner),
+      );
+      const local = bindings
+        .filter((binding) => binding !== undefined)
+        .filter((binding) => binding.mode === "device");
+      if (local.length === 0) return undefined;
+      yield* input.authorize;
+      for (const binding of local) {
+        yield* authorize(binding, false);
+        if (!binding.enabled)
+          return yield* new AccountExecutionUnavailable({
+            account: binding.account,
+            reason: "disabled",
+          });
+        const status = host === undefined ? "unavailable" : yield* host.availability(binding);
+        if (status === "offline")
+          return yield* new AccountDeviceOffline({ account: binding.account, ...binding.target });
+        if (status !== "online")
+          return yield* new AccountExecutionUnavailable({
+            account: binding.account,
+            reason: "host_unavailable",
+          });
+      }
+      // No reverse transport or device grant check exists yet. No host callback may execute a call.
+      return yield* new AccountExecutionUnavailable({
+        account: local[0]!.account,
+        reason: "host_unavailable",
+      });
+    });
+  const requireCloud = (accounts: readonly { readonly id: AccountId; readonly owner: OwnerId }[]) =>
+    Effect.gen(function* () {
+      for (const account of accounts) {
+        const binding = yield* read(account.id, account.owner);
+        if (binding !== undefined && binding.mode === "device") return yield* new StorageError();
+      }
+    });
+  return { operations, execution, requireCloudCall, requireCloud };
+};
