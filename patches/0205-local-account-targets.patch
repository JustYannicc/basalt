diff --git a/packages/sdk/src/contracts/account-target.ts b/packages/sdk/src/contracts/account-target.ts
new file mode 100644
index 0000000..0a419c7
--- /dev/null
+++ b/packages/sdk/src/contracts/account-target.ts
@@ -0,0 +1,107 @@
+import { Schema, type Effect } from "effect";
+import { UserFacingError } from "@executor-js/utils/user-facing-error";
+import { AccountId, OwnerId, StorageError } from "./shared.ts";
+import type { AccountNotFound } from "./account.ts";
+
+const Identifier = Schema.NonEmptyString.check(Schema.isMaxLength(255));
+/** A machine target contains identifiers only, never a command, address or credential. */
+export const MachineAccountTarget = Schema.Struct({
+  device: Identifier,
+  deviceName: Identifier,
+  binding: Identifier,
+  manifestRevision: Identifier,
+});
+export type MachineAccountTarget = typeof MachineAccountTarget.Type;
+export const AccountTargetBinding = Schema.Struct({
+  account: AccountId,
+  owner: OwnerId,
+  revision: Schema.Int.check(
+    Schema.isGreaterThan(0),
+    Schema.isLessThanOrEqualTo(Number.MAX_SAFE_INTEGER),
+  ),
+  enabled: Schema.Boolean,
+  mode: Schema.Literals(["cloud", "device"]),
+  target: MachineAccountTarget,
+});
+export type AccountTargetBinding = typeof AccountTargetBinding.Type;
+/** Omitted on ordinary cloud accounts. Availability is observed, not stored as authority. */
+export const AccountExecution = Schema.Struct({
+  kind: Schema.Literal("device"),
+  device: Identifier,
+  deviceName: Identifier,
+  status: Schema.Literals(["online", "offline", "unavailable", "disabled"]),
+});
+export type AccountExecution = typeof AccountExecution.Type;
+export const AccountDeviceOffline = UserFacingError.define({
+  tag: "AccountDeviceOffline",
+  status: 503,
+  fields: { account: AccountId, device: Identifier, deviceName: Identifier },
+  presentation: ({ deviceName }) => ({
+    title: "Device offline",
+    description: `${deviceName} is offline. This account was not called.`,
+    retryable: false,
+    recovery: {
+      action: "Inspect the named device connection. Device execution is not available yet.",
+      instructions:
+        "Report the offline device and account. Do not substitute another account, cloud target or machine, or resend automatically.",
+    },
+  }),
+});
+export type AccountDeviceOffline = typeof AccountDeviceOffline.Type;
+export const AccountExecutionUnavailable = UserFacingError.define({
+  tag: "AccountExecutionUnavailable",
+  status: 409,
+  fields: {
+    account: AccountId,
+    reason: Schema.Literals(["disabled", "changed", "host_unavailable"]),
+  },
+  title: "Account execution unavailable",
+  description: "This account's machine connection cannot execute the call. It was not sent.",
+  retryable: false,
+  recovery: {
+    action: "Inspect the account's connection in the browser.",
+    instructions:
+      "Keep the chosen account and inspect its machine connection. Do not silently change accounts, targets or credentials, or resend the call.",
+  },
+});
+export type AccountExecutionUnavailable = typeof AccountExecutionUnavailable.Type;
+/** Trusted products authorize both the saved account and the device on every operation. */
+export interface MachineAccounts {
+  readonly authorize: (input: {
+    readonly account: AccountId;
+    readonly owner: OwnerId;
+    readonly target: MachineAccountTarget;
+    readonly managing: boolean;
+  }) => Effect.Effect<boolean, StorageError>;
+  // Device execution is unavailable until the product supplies authenticated reverse transport.
+  readonly availability: (
+    binding: AccountTargetBinding,
+  ) => Effect.Effect<"online" | "offline" | "unavailable", StorageError>;
+}
+/** Host-only account target operations. App code and public JSON cannot mint device access. */
+export const AccountTargetsHost = Symbol("executor.AccountTargetsHost");
+export interface AccountTargetsHost {
+  /** Explicitly return an account to cloud execution after authorizing its saved device binding. */
+  readonly clear: (input: {
+    readonly account: AccountId;
+    readonly owner: OwnerId;
+    readonly revision: number;
+  }) => Effect.Effect<void, StorageError | AccountNotFound | AccountExecutionUnavailable>;
+  readonly get: (input: {
+    readonly account: AccountId;
+    readonly owner: OwnerId;
+  }) => Effect.Effect<
+    AccountTargetBinding | undefined,
+    StorageError | AccountNotFound | AccountExecutionUnavailable
+  >;
+  readonly save: (input: {
+    readonly account: AccountId;
+    readonly owner: OwnerId;
+    readonly revision: number;
+    readonly enabled: boolean;
+    readonly target: MachineAccountTarget;
+  }) => Effect.Effect<
+    AccountTargetBinding,
+    StorageError | AccountNotFound | AccountExecutionUnavailable
+  >;
+}
