--- /dev/null
+++ b/e2e/support/native-tunnel-model.ts
@@ -0,0 +1,15 @@
+/** Synthetic model peer; network responses expose cancellation at the actual HTTP boundary. */
+export const syntheticTunnelModel = `
+export default { fetch(request, env) {
+  const url = new URL(request.url);
+  if (url.pathname === "/native/v1/session") return env.LIFETIME.fetch(request);
+  if (request.headers.get("upgrade") === "websocket") {
+    const pair = new WebSocketPair();
+    pair[1].binaryType = "arraybuffer";
+    pair[1].accept();
+    pair[1].addEventListener("message", event => pair[1].send(event.data));
+    return new Response(null, { status: 101, webSocket: pair[0] });
+  }
+  return fetch(new Request(new URL(url.pathname, env.MODEL_ORIGIN), request));
+} };
+`;
