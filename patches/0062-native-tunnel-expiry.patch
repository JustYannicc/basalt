+import { expect, layer } from "@effect/vitest";
+import { Clock, Effect, Redacted, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { body } from "../support/api.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Evidence } from "../support/evidence.ts";
+import { App } from "../support/contracts.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { deployMcpApp } from "../support/mcp-app.ts";
+import { approveNative, startNativeProtocol } from "../support/native-grants.ts";
+import { nativeTunnel } from "../support/native-tunnel.ts";
+import { serverControl } from "../support/server-control.ts";
+import { Target } from "../support/platform.ts";
+import { targetHosts } from "../support/role-hosts.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Native tunnel", (it) => {
+  it.effect(scenarios.nativeTunnel.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const actors = yield* Actors,
+          evidence = yield* Evidence;
+        const p = yield* startNativeProtocol(actors.owner);
+        const tokens = yield* approveNative(p);
+        const access = yield* body(
+          Schema.Struct({ expiresAt: Schema.Int }),
+          yield* p.access(tokens),
+        );
+        expect(access.expiresAt).toBeGreaterThan(yield* Clock.currentTimeMillis);
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const { receipt } = yield* deployMcpApp;
+        const deployed = yield* p.api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: "Native tunnel public proof",
+          files: [
+            {
+              path: "index.ts",
+              content: `import { defineApp, object, query, router } from "apps";\nexport default defineApp({}, { tools: router({ echo: query({ input: object({}) }, async () => ({ receipt: ${JSON.stringify(receipt)} })) }) });`,
+            },
+            appsManifest,
+          ],
+        });
+        expect(deployed.status).toBe(200);
+        const app = yield* body(App, deployed);
+        yield* Effect.addFinalizer(() =>
+          p.api.request(actors.owner, "DELETE", `${prefix}/apps/${app.id}`).pipe(Effect.orDie),
+        );
+        const toolsOrigin = targetHosts(yield* Target).browser;
+        const worker = yield* nativeTunnel(toolsOrigin, p.upstream);
+        for (const token of ["ext_not-a-native-grant", "exp_not-a-native-grant", "unknown"]) {
+          expect((yield* worker.connect(token)).status).toBe(401);
+        }
+        const connected = yield* worker.connect(Redacted.value(tokens.access_token));
+        expect(connected.status).toBe(101);
+        const channel = connected.channel!;
+        yield* Effect.addFinalizer(() => Effect.sync(() => channel.close()));
+        const ready = yield* channel.next("ready");
+        expect(Number(ready.expiresAt)).toBeLessThanOrEqual(access.expiresAt);
+        let mcpSession: string | undefined;
+        const open = (
+          id: number,
+          service: "models" | "tools",
+          path: string,
+          method = "POST",
+          transport = "http",
+        ) =>
+          channel.send({
+            type: "open",
+            id,
+            operation: { service, path, method, transport },
+            headers: {
+              "content-type": "application/json",
+              accept: "application/json, text/event-stream",
+              ...(service === "tools"
+                ? {
+                    "mcp-protocol-version": "2025-06-18",
+                    ...(mcpSession ? { "mcp-session-id": mcpSession } : {}),
+                  }
+                : {}),
+            },
+          });
+        const sendBody = (id: number, value: unknown) =>
+          Effect.gen(function* () {
+            yield* channel.next("credit", id);
+            channel.send({
+              type: "data",
+              id,
+              bytes: Buffer.from(JSON.stringify(value)).toString("base64"),
+              text: false,
+            });
+            channel.send({ type: "end", id });
+          });
+        open(1, "models", "/v1/responses");
+        yield* sendBody(1, { model: "synthetic-model", stream: true });
+        expect((yield* channel.next("response", 1)).status).toBe(200);
+        expect(channel.queued("data", 1)).toBe(0);
+        channel.send({ type: "credit", id: 1, bytes: 65536 });
+        const first = yield* channel.next("data", 1);
+        expect(Buffer.from(String(first.bytes), "base64").toString()).toContain("data: first");
+        yield* evidence.json("tunnel-first-chunk.json", { arrivedBeforeCompletion: true });
+        expect(yield* worker.complete()).toBe("completed");
+        const last = yield* channel.next("data", 1);
+        expect(Buffer.from(String(last.bytes), "base64").toString()).toContain("data: complete");
+        yield* channel.next("end", 1);
+        yield* evidence.json("tunnel-stream.json", {
+          firstBeforeCompletion: true,
+          withheldCreditStoppedData: true,
+        });
+
+        open(2, "tools", "/mcp");
+        channel.send({ type: "credit", id: 2, bytes: 65536 });
+        yield* sendBody(2, {
+          jsonrpc: "2.0",
+          id: 49,
+          method: "initialize",
+          params: {
+            protocolVersion: "2025-06-18",
+            capabilities: {},
+            clientInfo: { name: "tunnel-proof", version: "1" },
+          },
+        });
+        const initialized = yield* channel.next("response", 2);
+        expect(initialized.status).toBe(200);
+        const responseHeaders = yield* Schema.decodeUnknownEffect(
+          Schema.Record(Schema.String, Schema.String),
+        )(initialized.headers);
+        mcpSession = responseHeaders["mcp-session-id"];
+        expect(mcpSession).toBeTruthy();
+        yield* channel.next("data", 2);
+        yield* channel.next("end", 2);
+        open(3, "tools", "/mcp");
+        channel.send({ type: "credit", id: 3, bytes: 65536 });
+        yield* sendBody(3, { jsonrpc: "2.0", method: "notifications/initialized" });
+        expect((yield* channel.next("response", 3)).status).toBe(202);
+        yield* channel.next("end", 3);
+
+        open(4, "tools", "/mcp");
+        channel.send({ type: "credit", id: 4, bytes: 65536 });
+        yield* sendBody(4, {
+          jsonrpc: "2.0",
+          id: 50,
+          method: "tools/call",
+          params: {
+            name: "execute",
+            arguments: { code: `return await tools[${JSON.stringify(app.slug)}].echo({})` },
+          },
+        });
+        expect((yield* channel.next("response", 4)).status).toBe(200);
+        const tool = yield* channel.next("data", 4);
+        expect(Buffer.from(String(tool.bytes), "base64").toString()).toContain(receipt);
+        yield* channel.next("end", 4);
+
+        yield* evidence.json("tunnel-tools.json", {
+          realToolReceipt: true,
+          sessionHeaderPreserved: true,
+        });
+
+        open(5, "models", "/v1/responses", "GET", "websocket");
+        channel.send({ type: "credit", id: 5, bytes: 65536 });
+        expect((yield* channel.next("response", 5)).status).toBe(101);
+        yield* channel.next("credit", 5);
+        const echo = JSON.stringify({ type: "response.create", synthetic: true });
+        channel.send({
+          type: "data",
+          id: 5,
+          bytes: Buffer.from(echo).toString("base64"),
+          text: true,
+        });
+        const echoed = yield* channel.next("data", 5);
+        expect(echoed.text).toBe(true);
+        expect(Buffer.from(String(echoed.bytes), "base64").toString()).toBe(echo);
+        const binary = Buffer.alloc(50000, 137);
+        for (let offset = 0; offset < binary.length; offset += 16000) {
+          const part = binary.subarray(offset, offset + 16000);
+          channel.send({
+            type: "data",
+            id: 5,
+            bytes: part.toString("base64"),
+            text: false,
+            more: offset + part.length < binary.length,
+          });
+        }
+        const fragments: Buffer[] = [];
+        for (;;) {
+          const part = yield* channel.next("data", 5);
+          expect(
+            part.text,
+            JSON.stringify({
+              bytes: Buffer.from(String(part.bytes), "base64").length,
+              sample: Buffer.from(String(part.bytes), "base64").subarray(0, 24).toString("hex"),
+            }),
+          ).toBe(false);
+          fragments.push(Buffer.from(String(part.bytes), "base64"));
+          if (part.more !== true) break;
+        }
+        expect(Buffer.concat(fragments).equals(binary)).toBe(true);
+        channel.send({ type: "cancel", id: 5 });
+
+        yield* evidence.json("tunnel-websocket.json", {
+          textMessagePreserved: true,
+          fragmentedBinaryMessagePreserved: true,
+        });
+
+        open(6, "models", "/v1/responses");
+        channel.send({ type: "credit", id: 6, bytes: 65536 });
+        yield* sendBody(6, { stream: true });
+        yield* channel.next("data", 6);
+        const cancelled = worker.nextCancellation();
+        channel.send({ type: "cancel", id: 6 });
+        yield* cancelled;
+        expect(worker.cancelled()).toBeGreaterThan(0);
+
+        for (const bad of [
+          { service: "models", path: "/v0/management/api-keys", method: "POST", transport: "http" },
+          {
+            service: "tools",
+            path: "https://other.example/mcp",
+            method: "POST",
+            transport: "http",
+          },
+        ]) {
+          const attempt = yield* worker.connect(Redacted.value(tokens.access_token));
+          const rejected = attempt.channel!;
+          yield* rejected.next("ready");
+          const before = worker.calls();
+          rejected.send({ type: "open", id: 1, operation: bad, headers: {} });
+          yield* rejected.closed;
+          expect(worker.calls()).toBe(before);
+        }
+        const removed = yield* p.api.request(
+          p.anonymous,
+          "POST",
+          "/api/auth/native/revoke",
+          undefined,
+          p.headers(tokens.access_token),
+        );
+        expect(removed.status).toBe(200);
+        yield* channel.closed;
+        expect((yield* worker.connect(Redacted.value(tokens.access_token))).status).toBe(401);
+
+        for (const permission of [
+          { tools: true, models: false },
