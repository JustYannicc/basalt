diff --git a/e2e/support/native-tunnel.ts b/e2e/support/native-tunnel.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/native-tunnel.ts
@@ -0,0 +1,245 @@
+import { createServer } from "node:http";
+import { expect } from "vitest";
+import { build } from "esbuild";
+import {
+  Miniflare,
+  fetch as runtimeFetch,
+  Response as RuntimeResponse,
+  Request as RuntimeRequest,
+  WebSocketPair,
+} from "miniflare";
+import { Effect, Path } from "effect";
+import { driver } from "./platform.ts";
+import { syntheticTunnelModel } from "./native-tunnel-model.ts";
+import type { nativePool } from "./native-pool.ts";
+
+type Pool = Effect.Success<ReturnType<typeof nativePool>>;
+type Socket = NonNullable<Awaited<ReturnType<Miniflare["dispatchFetch"]>>["webSocket"]>;
+type Frame = { v: number; type: string; id?: number; [key: string]: unknown };
+
+/** Compile the production entry, then address its public HTTP/WebSocket route in real workerd. */
+export const nativeTunnel = (toolsOrigin: string, pool: Pool, offset = 0) =>
+  Effect.gen(function* () {
+    const path = yield* Path.Path;
+    const root = path.resolve("..");
+    const bundle = yield* driver("bundle production tunnel worker", () =>
+      build({
+        stdin: {
+          contents: 'export { default } from "./src/router.ts";',
+          resolveDir: root,
+          sourcefile: "native-tunnel-entry.ts",
+        },
+        absWorkingDir: root,
+        bundle: true,
+        format: "esm",
+        platform: "browser",
+        write: false,
+        target: "es2023",
+        banner: { js: `const actualNow=Date.now.bind(Date); Date.now=()=>actualNow()+${offset};` },
+      }),
+    );
+    const holds = new Set<() => void>();
+    let calls = 0,
+      cancelled = 0;
+    let onCancel = () => {};
+    const model = createServer((request, response) => {
+      expect(request.headers["x-basalt-native-assertion"]).toBeTruthy();
+      expect(request.headers.cookie).toBeUndefined();
+      calls++;
+      if (request.url === "/v1/models") {
+        response
+          .writeHead(200, { "content-type": "application/json" })
+          .end(JSON.stringify({ data: [{ id: "synthetic-model" }] }));
+        return;
+      }
+      request.resume();
+      request.once("end", () => {
+        response.writeHead(200, { "content-type": "text/event-stream" });
+        response.write("data: first\n\n");
+        const complete = () => {
+          holds.delete(complete);
+          response.end("data: complete\n\n");
+        };
+        holds.add(complete);
+        response.once("close", () => {
+          holds.delete(complete);
+          if (!response.writableEnded) {
+            cancelled++;
+            onCancel();
+          }
+        });
+      });
+    });
+    yield* Effect.acquireRelease(
+      driver(
+        "start external model peer",
+        () =>
+          new Promise<void>((resolve, reject) => {
+            model.once("error", reject);
+            model.listen(0, "127.0.0.1", resolve);
+          }),
+      ),
+      () =>
+        driver(
+          "stop external model peer",
+          () =>
+            new Promise<void>((resolve) => {
+              model.closeAllConnections();
+              model.close(() => resolve());
+            }),
+        ).pipe(Effect.orDie),
+    );
+    const address = model.address();
+    if (!address || typeof address === "string")
+      return yield* Effect.die("Model peer requires TCP");
+    const modelOrigin = `http://127.0.0.1:${address.port}`;
+    const runtime = yield* Effect.acquireRelease(
+      Effect.sync(
+        () =>
+          new Miniflare({
+            workers: [
+              {
+                name: "router",
+                modules: true,
+                script: bundle.outputFiles[0]!.text,
+                compatibilityDate: "2026-08-06",
+                compatibilityFlags: ["nodejs_compat"],
+                bindings: { DASHBOARD_HOST: "router.test", POOL_APP_SIGNING_KEY: "ab".repeat(32) },
+                serviceBindings: {
+                  CATALOG_SERVICE: () => new RuntimeResponse(null, { status: 404 }),
+                  TOOLS_SERVICE: (request: RuntimeRequest) => {
+                    const target = new URL(request.url);
+                    return runtimeFetch(new URL(target.pathname + target.search, toolsOrigin), {
+                      method: request.method,
+                      headers: Object.fromEntries(request.headers),
+                      body: request.body,
+                      ...{ duplex: "half" },
+                      redirect: "manual",
+                      signal: request.signal,
+                    }).then(
+                      (response) =>
+                        new RuntimeResponse(response.body, {
+                          status: response.status,
+                          headers: Object.fromEntries(response.headers),
+                        }),
+                    );
+                  },
+                  POOL_SERVICE: "synthetic-model",
+                },
+              },
+              {
+                name: "synthetic-model",
+                modules: true,
+                script: syntheticTunnelModel,
+                bindings: { MODEL_ORIGIN: modelOrigin },
+                compatibilityDate: "2026-08-06",
+                serviceBindings: {
+                  LIFETIME: (request: RuntimeRequest) => {
+                    const url = new URL(request.url);
+                    if (url.pathname === "/native/v1/session") {
+                      const envelope = request.headers.get("x-basalt-native-session")!;
+                      const identity = JSON.parse(
+                        Buffer.from(envelope.split(".")[1]!, "base64url").toString(),
+                      ) as { grant: string };
+                      const pair = new WebSocketPair();
+                      pair[1].accept();
+                      const stop = pool.watch(identity.grant, () => pair[1].close(1000, "Revoked"));
+                      pair[1].addEventListener("close", stop);
+                      return new RuntimeResponse(null, { status: 101, webSocket: pair[0] });
+                    }
+                    return new RuntimeResponse(null, { status: 404 });
+                  },
+                },
+              },
+            ],
+          }),
+      ),
+      (runtime) => {
+        for (const release of holds) release();
+        return driver("dispose tunnel worker", () => runtime.dispose()).pipe(Effect.orDie);
+      },
+    );
+    yield* driver("start tunnel worker", () => runtime.ready);
+    return {
+      runtime,
+      calls: () => calls,
+      cancelled: () => cancelled,
+      complete: () =>
+        Effect.sync(() => {
+          for (const release of holds) release();
+          return "completed";
+        }),
+      nextCancellation: () => {
+        const before = cancelled;
+        return driver("await upstream cancellation", () =>
+          cancelled > before
+            ? Promise.resolve()
+            : new Promise<void>((resolve) => {
+                onCancel = resolve;
+              }),
+        );
+      },
+      connect: (token: string) =>
+        driver("open public tunnel", () =>
+          runtime.dispatchFetch("http://router.test/native/v1/tunnel", {
+            headers: {
+              authorization: `Bearer ${token}`,
+              upgrade: "websocket",
+              "sec-websocket-protocol": "basalt.tunnel.v1",
+            },
+          }),
+        ).pipe(
+          Effect.map((response) => ({
+            status: response.status,
+            channel: response.webSocket ? tunnelChannel(response.webSocket) : undefined,
+          })),
+        ),
+    };
+  });
+
+export function tunnelChannel(socket: Socket) {
+  const frames: Frame[] = [];
+  let notify: (() => void) | undefined;
+  let ended = false;
+  const closed = new Promise<void>((resolve) => {
+    socket.addEventListener("close", () => {
+      ended = true;
+      notify?.();
+      resolve();
+    });
+  });
+  socket.addEventListener("message", (event) => {
+    expect(typeof event.data).toBe("string");
+    frames.push(JSON.parse(String(event.data)) as Frame);
+    notify?.();
+  });
+  socket.accept();
+  const result = {
+    send: (frame: object) => socket.send(JSON.stringify({ v: 1, ...frame })),
+    next: (type: string, id?: number): Effect.Effect<Frame, import("./platform.ts").DriverFailed> =>
+      Effect.suspend(() => {
+        const failure = frames.find(
+          (frame) => frame.type === "error" && (id === undefined || frame.id === id),
+        );
+        if (type !== "error")
+          expect(failure, `Tunnel refused operation ${id ?? "session"}`).toBeUndefined();
+        const index = frames.findIndex(
+          (frame) => frame.type === type && (id === undefined || frame.id === id),
+        );
+        if (index >= 0) return Effect.succeed(frames.splice(index, 1)[0]!);
+        expect(ended, "Tunnel closed before the expected frame").toBe(false);
+        return driver(
+          "await tunnel frame",
+          () =>
+            new Promise<void>((resolve) => {
+              notify = resolve;
+            }),
+        ).pipe(Effect.flatMap(() => result.next(type, id)));
+      }),
+    queued: (type: string, id?: number) =>
+      frames.filter((frame) => frame.type === type && (id === undefined || frame.id === id)).length,
+    closed: driver("await tunnel close", () => closed),
+    close: () => socket.close(),
+  };
+  return result;
+}
