+import { RegistryContext, useAtomValue } from "@effect/atom-react";
+import { Option } from "effect";
+import { AsyncResult, Atom } from "effect/reactivity";
+import { useContext, useEffect, useMemo } from "react";
+import { sessionAtom } from "../../contracts/auth.ts";
+import type { ComputersView } from "./pool-setup.tsx";
+
+/*
+ * What Connect last read from the setup service, kept in the dashboard's registry so returning to
+ * the page shows it at once. One slot holds one organization and person; opening Connect for
+ * anyone or anywhere else clears it, so nobody's computers or pool choice reach another context.
+ * It holds the list and the choice only: intents and keys stay with the page that asked for them.
+ */
+
+/** The organization as the URL names it and the person the session verified. */
+export interface SetupScope {
+  readonly organization: string;
+  readonly person: string;
+}
+
+export const sameScope = (a: SetupScope | undefined, b: SetupScope | undefined) =>
+  a === b || (!!a && !!b && a.organization === b.organization && a.person === b.person);
+
+export interface RetainedSetup {
+  readonly scope: SetupScope;
+  readonly view: ComputersView;
+  readonly pool: string | undefined;
+  /** When the last accepted read started, by this browser's clock. */
+  readonly readAt: number;
+}
+
+/** As long as `revalidated` keeps the dashboard's other reads after their last view closes. */
+export const retainedSetupAtom = Atom.make<RetainedSetup | undefined>(undefined).pipe(
+  Atom.setIdleTTL("30 minutes"),
+);
+
+/** `revalidated`'s freshness: a page reopened within it shows its value without another read. */
+const freshness = 30_000;
+export const isFresh = (retained: RetainedSetup) => Date.now() - retained.readAt < freshness;
+
+// Each field is selected on its own so a read that changes nothing re-renders nothing.
+const selectScope = (retained: RetainedSetup | undefined) => retained?.scope;
+const selectView = (retained: RetainedSetup | undefined) => retained?.view;
+const selectPool = (retained: RetainedSetup | undefined) => retained?.pool;
+
+/** The retained list and choice, only while they belong to this scope. */
+export function useRetainedSetup(scope: SetupScope | undefined) {
+  const owner = useAtomValue(retainedSetupAtom, selectScope);
+  const view = useAtomValue(retainedSetupAtom, selectView);
+  const pool = useAtomValue(retainedSetupAtom, selectPool);
+  const mine = owner !== undefined && scope !== undefined && sameScope(owner, scope);
+  return mine ? { view, pool } : { view: undefined, pool: undefined };
+}
+
+/**
+ * The URL's slug, not the verified ID it resolves to, so that resolution is not a new organization.
+ * A failed session check keeps the person it last confirmed; a confirmed sign-out has none.
+ */
+export function useSetupScope(organization: string): SetupScope | undefined {
+  const session = useAtomValue(sessionAtom);
+  const person = Option.getOrNull(AsyncResult.value(session))?.user.id;
+  return useMemo(() => (person ? { organization, person } : undefined), [organization, person]);
+}
+
+/** The organization layout sees context changes even while Connect is closed. */
+export function useSetupRetentionScope(organization: string, person: string | undefined) {
+  const registry = useContext(RegistryContext);
+  useEffect(() => {
+    const scope = person ? { organization, person } : undefined;
+    const retained = registry.get(retainedSetupAtom);
+    if (retained && !sameScope(retained.scope, scope)) registry.set(retainedSetupAtom, undefined);
+  }, [organization, person, registry]);
+}
