+            yield* browser.use("Rename before leaving Connect", (page) =>
+              page.getByRole("menuitem", { name: "Rename", exact: true }).click(),
+            );
+            yield* browser.use("Name the computer before leaving", (page) =>
+              page.getByRole("textbox", { name: "Computer name" }).fill("Leaving laptop"),
+            );
+            yield* browser.use("Start the held rename", (page) =>
+              page.getByRole("button", { name: "Save", exact: true }).click(),
+            );
+            yield* mutation.requested;
+            yield* leaveConnect;
+            const readsWhileClosed = setupReads;
+            const completed = yield* browser.use("Observe the pending mutation response", (page) =>
+              Promise.resolve({
+                response: page.waitForResponse(
+                  (response) =>
+                    renamePath.test(new URL(response.url()).pathname) && response.status() === 200,
+                ),
+              }),
+            );
+            yield* mutation.release;
+            yield* browser.use("The closed page's mutation completes", (page) =>
+              completed.response
+                .then((response) => response.finished())
+                .then(() =>
+                  page.evaluate(
+                    () =>
+                      new Promise<void>((resolve) =>
+                        requestAnimationFrame(() => requestAnimationFrame(() => resolve())),
+                      ),
+                  ),
+                ),
+            );
+            expect(setupReads, "A closed page cannot start a post-mutation read").toBe(
+              readsWhileClosed,
+            );
+          }),
+        );
+        yield* openInApp("Return after the closed page's mutation", connect);
+        yield* chooseClaudeCode;
+        expect(yield* chosenPool("Return after mutation")).toEqual({
+          label: "Team pool",
+          enabled: true,
+        });
+        yield* refreshVisiblePage;
+        yield* browser.use("The current page reconciles the completed mutation", (page) =>
+          rows(page)
+            .filter({ hasText: "Leaving laptop" })
+            .filter({ hasText: "Team pool" })
+            .waitFor(),
+        );
+
+        // A newer authority refusal must also fence a successful read already on its way back.
+        yield* Effect.scoped(
+          Effect.gen(function* () {
+            const computers = /^\/setup\/v1\/computers$/;
+            const older = yield* holdQuery(computers, "continue");
+            yield* refreshVisiblePage;
+            yield* older.requested;
+            yield* browser.use("Refuse the next computer read", (page) =>
+              page.route(
+                (url) => computers.test(url.pathname),
+                (route) =>
+                  route.fulfill({
+                    status: 403,
+                    contentType: "application/json",
+                    body: JSON.stringify({ error: "Setup access refused." }),
+                  }),
+                { times: 1 },
+              ),
+            );
+            yield* browser.use("Open the computer menu while the earlier read waits", (page) =>
+              page.getByRole("button", { name: "Manage Leaving laptop" }).click(),
+            );
+            yield* browser.use("Choose Rename before the newer read", (page) =>
+              page.getByRole("menuitem", { name: "Rename", exact: true }).click(),
+            );
+            yield* browser.use("Set the name through the ordinary action", (page) =>
+              page.getByRole("textbox", { name: "Computer name" }).fill("Denied laptop"),
+            );
+            yield* browser.use("Save and receive the newer refusal", (page) =>
+              page.getByRole("button", { name: "Save", exact: true }).click(),
+            );
+            yield* browser.use("The refused read clears the computer list", (page) =>
+              rows(page).filter({ hasText: "Leaving laptop" }).waitFor({ state: "detached" }),
+            );
+            expect((yield* chosenPool("Refused read")).enabled).toBe(false);
+            const late = yield* browser.use("Observe the earlier successful response", (page) =>
+              Promise.resolve({
+                response: page.waitForResponse(
+                  (response) =>
+                    computers.test(new URL(response.url()).pathname) && response.status() === 200,
+                ),
+              }),
+            );
+            yield* older.release;
+            yield* browser.use("The earlier response finishes and the browser commits it", (page) =>
+              late.response
+                .then((response) => response.finished())
+                .then(() =>
+                  page.evaluate(
+                    () =>
+                      new Promise<void>((resolve) =>
+                        requestAnimationFrame(() => requestAnimationFrame(() => resolve())),
+                      ),
+                  ),
+                ),
+            );
+            expect((yield* chosenPool("Late response after refusal")).enabled).toBe(false);
+            expect(yield* computerRows("Late response after refusal", "Denied laptop")).toBe(0);
+            yield* browser.checkpoint("A late response cannot restore refused setup data");
+          }),
+        );
+      }),
+    ),
+  );
 });
