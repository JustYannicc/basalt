diff --git a/e2e/tests/mcp-refresh-errors.spec.ts b/e2e/tests/mcp-refresh-errors.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/mcp-refresh-errors.spec.ts
@@ -0,0 +1,162 @@
+/** Force rotation races through the public token endpoint on the scenario's own grant. */
+import { randomUUID } from "node:crypto";
+import { expect, layer } from "@effect/vitest";
+import { Effect, Fiber, Redacted, Schedule, Schema } from "effect";
+import { scenarios } from "../test-plan.ts";
+import { Actors } from "../support/actors.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { cloudLocks } from "../support/cloud-locks.ts";
+import { Evidence } from "../support/evidence.ts";
+import { McpOAuth } from "../support/mcp-oauth.ts";
+
+const Backend = Schema.Array(Schema.Struct({ pid: Schema.Number }));
+
+layer(HostedLive, { excludeTestServices: true })("Refresh error outcomes", (it) => {
+  it.effect(scenarios.mcpRefreshRetryableErrors.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const actors = yield* Actors,
+          browser = yield* Browser,
+          oauth = yield* McpOAuth,
+          evidence = yield* Evidence,
+          database = yield* cloudLocks;
+        yield* browser.login(actors.owner);
+        const stored = yield* oauth.authorize;
+        const suffix = randomUUID().replaceAll("-", "");
+        const trigger = `refresh_race_${suffix}`;
+        const backup = `refresh_backup_${suffix}`;
+        const key = `refresh-race:${suffix}`;
+        const rows = (sql: string, params: readonly (string | number)[] = []) =>
+          database.run({ sql, params });
+        const selected = yield* rows(
+          'select id from "oauthRefreshToken" where "clientId" = $1 and revoked is null',
+          [stored.clientId],
+        ).pipe(
+          Effect.flatMap(
+            Schema.decodeUnknownEffect(Schema.Array(Schema.Struct({ id: Schema.String }))),
+          ),
+        );
+        expect(selected).toHaveLength(1);
+        const id = selected[0]!.id.replaceAll("'", "''");
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* database.release;
+            yield* rows(`drop trigger if exists ${trigger} on "oauthRefreshToken"`);
+            yield* rows(`drop function if exists ${trigger}()`);
+            yield* rows(`drop table if exists ${backup}`);
+          }).pipe(Effect.orDie),
+        );
+        // The first update holds its row lock; a second caller has already read the old token.
+        yield* rows(`create function ${trigger}() returns trigger language plpgsql as $$ begin
+          if old.id = '${id}' and old.revoked is null then
+            perform pg_advisory_xact_lock(hashtextextended('${key}', 0));
+          end if; return new; end $$`);
+        yield* rows(
+          `create trigger ${trigger} before update of revoked on "oauthRefreshToken"
+            for each row execute function ${trigger}()`,
+        );
+        const [holder] = yield* database
+          .hold({
+            sql: "select pg_backend_pid() as pid, pg_advisory_xact_lock(hashtextextended($1, 0))",
+            params: [key],
+          })
+          .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Backend)));
+        expect(holder).toBeDefined();
+        const blockedBy = (pid: number) =>
+          rows("select pid from pg_stat_activity where $1 = any(pg_blocking_pids(pid))", [
+            pid,
+          ]).pipe(
+            Effect.flatMap(Schema.decodeUnknownEffect(Backend)),
+            Effect.filterOrFail((waiting) => waiting.length > 0),
+            Effect.retry({ schedule: Schedule.spaced("20 millis"), times: 250 }),
+            Effect.orDie,
+          );
+        const winner = yield* oauth.refresh(stored).pipe(Effect.forkScoped);
+        const [rotating] = yield* blockedBy(holder!.pid);
+        const loser = yield* oauth.refreshOutcome(stored).pipe(Effect.forkScoped);
+        yield* blockedBy(rotating!.pid);
+        yield* database.release;
+        const first = yield* Fiber.join(winner);
+        const rotationLost = yield* Fiber.join(loser);
+        expect(rotationLost).toEqual({ status: 503, error: "server_error", retryAfter: "1" });
+        const replayed = yield* oauth.refresh(stored);
+        expect(
+          Redacted.value(replayed.tokens).refresh_token ===
+            Redacted.value(first.tokens).refresh_token &&
+            Redacted.value(replayed.tokens).access_token ===
+              Redacted.value(first.tokens).access_token,
+        ).toBe(true);
+
+        // Keep the encrypted replay and original expiry entirely inside the runner-owned database.
+        yield* rows(
+          `create table ${backup} as select id, "expiresAt", "rotationReplayExpiresAt", "rotationReplayResponse"
+            from "oauthRefreshToken" where "clientId" = $1`,
+          [stored.clientId],
+        );
+        yield* rows(
+          'update "oauthRefreshToken" set "rotationReplayResponse" = null where id = $1',
+          [selected[0]!.id],
+        );
+        const replayUnavailable = yield* oauth.refreshOutcome(stored);
+        expect(replayUnavailable).toEqual({ status: 503, error: "server_error", retryAfter: "1" });
+        yield* rows('update "oauthRefreshToken" set "rotationReplayResponse" = $2 where id = $1', [
+          selected[0]!.id,
+          "synthetic-invalid-ciphertext",
+        ]);
+        const unreadableReplay = yield* oauth.refreshOutcome(stored);
+        expect(unreadableReplay).toEqual({ status: 503, error: "server_error", retryAfter: "1" });
+        yield* rows(`update "oauthRefreshToken" token set
+          "rotationReplayResponse" = saved."rotationReplayResponse"
+          from ${backup} saved where token.id = saved.id`);
+        const recovered = yield* oauth.refresh(stored);
+        expect(
+          Redacted.value(recovered.tokens).refresh_token ===
+            Redacted.value(first.tokens).refresh_token,
+        ).toBe(true);
+        const mismatch = yield* oauth.refreshOutcome(stored, { scope: "mcp" });
+        expect(mismatch).toEqual({ status: 400, error: "invalid_grant", retryAfter: undefined });
+        const matchedAfterRefusal = yield* oauth.refresh(stored);
+        expect(
+          Redacted.value(matchedAfterRefusal.tokens).refresh_token ===
+            Redacted.value(first.tokens).refresh_token,
+        ).toBe(true);
+        yield* rows(
+          `update "oauthRefreshToken" set "rotationReplayExpiresAt" = now() - interval '1 second' where id = $1`,
+          [selected[0]!.id],
+        );
+        const outsideWindow = yield* oauth.refreshOutcome(stored);
+        expect(outsideWindow).toEqual({
+          status: 400,
+          error: "invalid_grant",
+          retryAfter: undefined,
+        });
+        yield* rows(`update "oauthRefreshToken" token set
+          "rotationReplayExpiresAt" = saved."rotationReplayExpiresAt"
+          from ${backup} saved where token.id = saved.id`);
+        yield* rows(
+          'update "oauthRefreshToken" set "expiresAt" = now() - interval \'1 second\' where "clientId" = $1 and revoked is null',
+          [stored.clientId],
+        );
+        const expired = yield* oauth.refreshOutcome(first);
+        expect(expired).toEqual({ status: 400, error: "invalid_grant", retryAfter: undefined });
+        yield* rows(`update "oauthRefreshToken" token set "expiresAt" = saved."expiresAt"
+          from ${backup} saved where token.id = saved.id`);
+        yield* oauth.revoke(first);
+        const revoked = yield* oauth.refreshOutcome(first);
+        expect(revoked).toEqual({ status: 400, error: "invalid_grant", retryAfter: undefined });
+        yield* evidence.json("refresh-error-wire.json", {
+          rotationLost,
+          replayUnavailable,
+          unreadableReplay,
+          mismatch,
+          outsideWindow,
+          expired,
+          revoked,
+          replayRetainedSamePair: true,
+        });
+      }).pipe(Effect.provide(McpOAuth.layer)),
+    ),
+  );
+});
