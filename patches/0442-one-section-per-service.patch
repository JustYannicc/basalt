diff --git a/packages/ui/src/implementation/dashboard/service-groups.ts b/packages/ui/src/implementation/dashboard/service-groups.ts
new file mode 100644
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/service-groups.ts
@@ -0,0 +1,127 @@
+/**
+ * Which of one scope's account requirements an app's Accounts tab shows as one service. Apps often
+ * declare a service twice, such as a new sign-in beside a legacy token, or "Neon" beside "Neon
+ * MCP", because a provider's declaration is its saved accounts' identity and can't change. A person
+ * connects the service once, so those requirements share one section and one connect menu.
+ */
+import type { AccountRequirement } from "@executor-js/sdk";
+import type { CatalogToolSection } from "@executor-js/catalog/contracts";
+
+type RequirementEntry = readonly [string, AccountRequirement];
+
+/** The service a requirement names: equal names, or one name opening another ("AWS IAM …"). */
+const sameService = (service: string, name: string) =>
+  name === service || name.startsWith(`${service} `);
+
+/**
+ * The scope's requirements in declaration order, each group one service. Only `mergeable`
+ * requirements join others, and only as a group whose requirements all list many accounts from
+ * different providers. Each account then belongs to exactly one requirement, so a row links and
+ * unlinks its own requirement as before and no account is listed twice. Requirements that share a
+ * provider are roles of one service, such as a primary and a backup mailbox, and stay apart, as do
+ * requirements whose links different people may change.
+ */
+export const serviceGroups = (
+  requirements: readonly RequirementEntry[],
+  mergeable: (entry: RequirementEntry) => boolean,
+): readonly (readonly RequirementEntry[])[] => {
+  const name = ([, requirement]: RequirementEntry) => requirement.definition.name.trim();
+  const candidates = requirements.filter((entry) => name(entry) !== "" && mergeable(entry));
+  // The shortest name that opens this one names the service, so "AWS" gathers "AWS IAM …".
+  const serviceOf = (entry: RequirementEntry) =>
+    candidates
+      .map(name)
+      .filter((service) => sameService(service, name(entry)))
+      .reduce((shortest, service) => (service.length < shortest.length ? service : shortest));
+  const byService = new Map<string, RequirementEntry[]>();
+  for (const entry of candidates) {
+    const service = serviceOf(entry);
+    byService.set(service, [...(byService.get(service) ?? []), entry]);
+  }
+  const valid = (group: readonly RequirementEntry[]) =>
+    group.length > 1 &&
+    group.every(
+      ([, requirement]) =>
+        requirement.cardinality === "many" &&
+        requirement.scope === group[0]![1].scope &&
+        requirement.contributed === group[0]![1].contributed,
+    ) &&
+    new Set(group.map(([, requirement]) => requirement.provider)).size === group.length;
+  const groupOf = new Map<RequirementEntry, readonly RequirementEntry[]>();
+  for (const group of byService.values())
+    if (valid(group)) for (const entry of group) groupOf.set(entry, group);
+  const seen = new Set<readonly RequirementEntry[]>();
+  return requirements.flatMap((entry) => {
+    const group = groupOf.get(entry);
+    if (group === undefined) return [[entry]];
+    if (seen.has(group)) return [];
+    seen.add(group);
+    return [group];
+  });
+};
+
+/** A group's title: the service name every requirement in it opens with. */
+export const serviceTitle = (group: readonly RequirementEntry[]) =>
+  group
+    .map(([, requirement]) => requirement.definition.name.trim())
+    .reduce((shortest, name) => (name.length < shortest.length ? name : shortest));
+
+/** One entry of a service's connect menu: the requirement and method a pick opens. */
+export interface ServiceMethod {
+  readonly slot: string;
+  readonly requirement: AccountRequirement;
+  readonly method: string;
+  readonly label: string;
+}
+
+/**
+ * The service's connect menu, from each requirement's open methods in declaration order. A label
+ * another requirement of the same name already offers is left out, since both open the same kind
+ * of sign-in and the earlier requirement is the one the app declares first. Where requirements of
+ * different names offer the same label, each names its requirement, such as "API key · Neon MCP".
+ */
+export const serviceMethods = (methods: readonly ServiceMethod[]): readonly ServiceMethod[] => {
+  const nameOf = (entry: ServiceMethod) => entry.requirement.definition.name.trim();
+  const kept = methods.filter(
+    (entry, index) =>
+      !methods
+        .slice(0, index)
+        .some((earlier) => earlier.label === entry.label && nameOf(earlier) === nameOf(entry)),
+  );
+  return kept.map((entry) =>
+    kept.some((other) => other !== entry && other.label === entry.label)
+      ? { ...entry, label: `${entry.label} · ${nameOf(entry)}` }
+      : entry,
+  );
+};
+
+/** The fields of a catalog tool section that say which requirement and method run its tools. */
+export type ToolSectionLimit = Pick<CatalogToolSection, "requirement" | "method" | "title">;
+
+/**
+ * What an account of one requirement and method can't run beside the rest of its service: each
+ * declared tool section of the group's requirements that needs another requirement or method.
+ */
+export const toolLimits = (
+  sections: readonly ToolSectionLimit[] | undefined,
+  group: readonly RequirementEntry[],
+  slot: string,
+  method: string,
+) => {
+  const titles = (sections ?? []).flatMap((section) =>
+    group.some(([other]) => other === section.requirement) &&
+    !(section.requirement === slot && section.method === method)
+      ? [section.title]
+      : [],
+  );
+  return titles.length === 0 ? undefined : `Can't run ${[...new Set(titles)].join(" or ")}.`;
+};
+
+/**
+ * Which part of its service an account serves, where the section joins requirements of different
+ * names, such as "For GitLab MCP"; nothing for the part the section is named after.
+ */
+export const servicePart = (group: readonly RequirementEntry[], slot: string) => {
+  const name = group.find(([other]) => other === slot)?.[1].definition.name.trim();
+  return name === undefined || name === serviceTitle(group) ? undefined : `For ${name}`;
+};
