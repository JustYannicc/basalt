+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import type { Page } from "playwright";
+import { randomUUID } from "node:crypto";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { Browser } from "../support/browser.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { accountLinks, connectionsPath } from "../support/app-accounts.ts";
+import { App, Resource } from "../support/contracts.ts";
+import { scenarios } from "../test-plan.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { choiceName, connectName } from "../support/account-choices.ts";
+import { accountNameField, nameAccountDialog } from "../support/name-account.ts";
+
+layer(HostedLive, { excludeTestServices: true })("App accounts", (it) => {
+  it.effect(scenarios.appServiceSection.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const actors = yield* Actors,
+          api = yield* Api,
+          browser = yield* Browser;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        // One service declared twice, as apps do for a new sign-in beside a legacy one or for an
+        // MCP server beside the REST API, plus two roles of another service on one provider.
+        const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: `Service sections ${randomUUID().slice(0, 8)}`,
+          files: [
+            {
+              path: "index.ts",
+              content: `
+import { defineApp, defineProvider, object, secrets, string, router } from "apps";
+const rest = defineProvider({ name: "Service fixture", auth: { key: secrets({ label: "API key", fields: object({ token: string() }) }) } });
+const mcp = defineProvider({ name: "Service fixture MCP", auth: { token: secrets({ label: "Service token", fields: object({ token: string() }) }) } });
+const mail = defineProvider({ name: "Mail fixture", auth: { key: secrets({ label: "API key", fields: object({ token: string() }) }) } });
+export default defineApp({ user: { accounts: { rest: rest.many(), mcp: mcp.many(), inbox: mail.many(), archive: mail.many() } } }, async () => ({ tools: router({}) }));`,
+            },
+            appsManifest,
+          ],
+        });
+        expect(deployed.status).toBe(200);
+        const app = yield* body(App, deployed);
+        const appPath = `${prefix}/apps/${app.id}`;
+        const accounts: string[] = [];
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* api.request(actors.owner, "DELETE", appPath);
+            for (const account of accounts)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`);
+          }).pipe(Effect.orDie),
+        );
+        /** Connect a key account for one requirement from the app, which links it there. */
+        const connect = (requirement: string, method: string, label: string) =>
+          Effect.gen(function* () {
+            const connection = yield* body(
+              Resource,
+              yield* api.request(
+                actors.owner,
+                "POST",
+                connectionsPath(appPath, "user", requirement),
+                {},
+              ),
+            );
+            const saved = yield* api.request(
+              actors.owner,
+              "POST",
+              `${prefix}/connections/${connection.id}/submit`,
+              { method, label, fields: { token: "synthetic-token" } },
+            );
+            expect(saved.status).toBe(200);
+            const id = (yield* body(Resource, saved)).id;
+            accounts.push(id);
+            return id;
+          });
+        const restKey = yield* connect("rest", "key", "Rest key");
+        const mcpToken = yield* connect("mcp", "token", "MCP token");
+        const links = Effect.map(accountLinks(actors.owner, appPath), (pairs) =>
+          pairs.map(([requirement, account]) => `${requirement}:${account}`).sort(),
+        );
+        // Each account stays linked to its own requirement, which is what the app's tools read.
+        expect(yield* links).toEqual([`mcp:${mcpToken}`, `rest:${restKey}`].sort());
+
+        yield* browser.login(actors.owner);
+        const url = `/org/${actors.organization.slug}/apps/${app.id}?view=accounts`;
+        const service = (page: Page) =>
+          page.getByRole("region", { name: "Service fixture", exact: true });
+        // The connect control appears once the host's connection policy has loaded.
+        yield* browser.use("Open the app's Accounts tab", (page) =>
+          page
+            .goto(url)
+            .then(() =>
+              service(page).getByRole("button", { name: connectName(), exact: true }).waitFor(),
+            ),
+        );
+
+        // One section for the service: no section per requirement, one connect control, and each
+        // account listed once.
+        const layout = yield* browser.use("Read the service section", (page) => {
+          const row = (label: string) =>
+            service(page).getByRole("checkbox", { name: choiceName(label), exact: true });
+          return Promise.all([
+            page.getByRole("region", { name: "Service fixture MCP", exact: true }).count(),
+            service(page).getByRole("button", { name: connectName(), exact: true }).count(),
+            row("Rest key").count(),
+            row("MCP token").count(),
+            service(page).getByRole("checkbox", { checked: true }).count(),
+            service(page).getByText("For Service fixture MCP", { exact: true }).count(),
+          ]).then(([mcpSections, connectButtons, restRows, mcpRows, linked, mcpNotes]) => ({
+            mcpSections,
+            connectButtons,
+            restRows,
+            mcpRows,
+            linked,
+            mcpNotes,
+          }));
+        });
+        // The MCP account says which part of the service it serves; the REST one needs no note.
+        expect(layout).toEqual({
+          mcpSections: 0,
+          connectButtons: 1,
+          restRows: 1,
+          mcpRows: 1,
+          linked: 2,
+          mcpNotes: 1,
+        });
+
+        // Two roles of one provider are not one service's methods; they keep their own sections.
+        const roles = yield* browser.use("Read the role sections", (page) =>
+          Promise.all(
+            ["Mail fixture · Inbox", "Mail fixture · Archive"].map((name) =>
+              page.getByRole("region", { name, exact: true }).count(),
+            ),
+          ),
+        );
+        expect(roles).toEqual([1, 1]);
+
+        // The one connect control offers every method of the service, by its own label.
+        const offered = yield* browser.use("Open the service's connect menu", (page) =>
+          service(page)
+            .getByRole("button", { name: connectName(), exact: true })
+            .click()
+            .then(() => page.getByRole("menu").waitFor())
+            .then(() => page.getByRole("menuitem").allTextContents()),
+        );
+        expect(offered).toEqual(["API key", "Service token"]);
+
+        // Picking a method opens that method's form; the name prompt then offers the account's title.
+        const prefilled = yield* browser.use("Connect a service token from the menu", (page) =>
+          page
+            .getByRole("menuitem", { name: "Service token", exact: true })
+            .click()
+            .then(() =>
+              page.getByRole("dialog").getByLabel("Token", { exact: true }).fill("synthetic-token"),
+            )
+            .then(() =>
+              page
+                .getByRole("dialog")
+                .getByRole("button", { name: "Connect account", exact: true })
+                .click(),
+            )
+            .then(() => accountNameField(page).waitFor())
+            .then(() => accountNameField(page).inputValue()),
+        );
+        // A key method without a declared kind is titled "<service> account" on every list.
+        expect(prefilled).toBe("Service fixture MCP account");
+        yield* browser.use("Keep the default name", (page) =>
+          nameAccountDialog(page)
+            .getByRole("button", { name: "Save name", exact: true })
+            .click()
+            .then(() => nameAccountDialog(page).waitFor({ state: "hidden" })),
+        );
+        const after = yield* accountLinks(actors.owner, appPath);
+        const added = after.flatMap(([, account]) => (accounts.includes(account) ? [] : [account]));
+        accounts.push(...added);
+        // Saving the untouched default keeps the generated label, so a later check can still name it.
+        expect(added).toHaveLength(1);
+        const saved = yield* body(
+          Schema.Struct({ account: Schema.Struct({ label: Schema.String }) }),
+          yield* api.request(actors.owner, "GET", `${prefix}/accounts/${added[0]}`),
+        );
+        expect(saved.account.label).toBe("Default");
+        // The new account joined the requirement its method belongs to, beside the earlier one.
+        expect(after.filter(([requirement]) => requirement === "mcp")).toHaveLength(2);
+        expect(after.filter(([requirement]) => requirement === "rest")).toHaveLength(1);
+        const shown = yield* browser.use("Read the new row", (page) =>
+          service(page)
+            .getByRole("checkbox", { name: choiceName("Service fixture MCP account"), exact: true })
+            .waitFor()
+            .then(() => service(page).getByRole("checkbox", { checked: true }).count()),
+        );
+        expect(shown).toBe(3);
+
+        // Unticking a row unlinks only its own requirement; ticking it links it there again.
+        // Unticking leaves the account unused, so the tab offers to delete it; keeping it is the undo.
+        yield* browser.use("Untick and tick the REST account", (page) => {
+          const control = (checked: boolean) =>
+            service(page).getByRole("checkbox", {
+              name: choiceName("Rest key"),
+              exact: true,
+              checked,
+            });
+          const unused = page.getByRole("dialog", { name: "Delete unused account?" });
+          return control(true)
+            .click()
+            .then(() => unused.getByRole("button", { name: "Keep account", exact: true }).click())
+            .then(() => unused.waitFor({ state: "hidden" }))
+            .then(() => control(false).waitFor())
+            .then(() => control(false).click())
+            .then(() => control(true).waitFor());
+        });
+        expect((yield* links).filter((link) => link.startsWith("rest:"))).toEqual([
+          `rest:${restKey}`,
+        ]);
+      }),
+    ),
+  );
+});
