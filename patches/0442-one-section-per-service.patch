+/**
+ * Several requirements of one service as one section: one header, every account once under the
+ * requirement it belongs to, and one connect control offering every method the service has.
+ */
+function ServiceView<E>({
+  group,
+  title,
+  titles,
+  readOnlyNote,
+  ...props
+}: ScopeProps<E> & {
+  readonly group: readonly RequirementEntry[];
+  readonly title: string;
+  /** Each requirement's own title, which names its login-file import. */
+  readonly titles: ReadonlyMap<string, string>;
+  readonly readOnlyNote?: string | undefined;
+}) {
+  const { data } = props;
+  const [, first] = group[0]!;
+  // Grouping requires the same scope and contribution policy, so one requirement's answer holds.
+  const edit = editingFor(data, first);
+  const linkedTo = (slot: string) =>
+    data.links.flatMap((link) => (link.requirement === slot ? [link.account] : []));
+  const linked = group.reduce((count, [slot]) => count + linkedTo(slot).length, 0);
+  const methodsLine = methodsSummary(
+    group.flatMap(([slot, requirement]) => methodStates(props.methods, slot, requirement)),
+  );
+  const note = (slot: string) => (method: string) =>
+    [servicePart(group, slot), toolLimits(props.toolSections, group, slot, method)]
+      .filter((part) => part !== undefined)
+      .join(" · ") || undefined;
+  return (
+    <section
+      aria-label={title}
+      className={cn("min-w-0 space-y-2.5", edit === undefined && "opacity-60")}
+    >
+      <SectionHeader
+        app={props.app}
+        provider={first.definition}
+        title={title}
+        note={requirementNote(first, linked)}
+        methodsLine={methodsLine}
+        readOnlyNote={edit === undefined ? readOnlyNote : undefined}
+      />
+      <div
+        role="group"
+        aria-label={`${title} accounts`}
+        className="divide-y divide-border/50 overflow-hidden rounded-lg border"
+      >
+        {edit === undefined ? (
+          linked === 0 ? (
+            <p className="px-3.5 py-2.5 text-[13px] text-muted-foreground">No account linked</p>
+          ) : (
+            group.map(([slot, requirement]) =>
+              linkedTo(slot).length === 0 ? null : (
+                <ReadOnlyChoices
+                  key={slot}
+                  {...props}
+                  data={readOnlyData(data)}
+                  slot={slot}
+                  requirement={requirement}
+                  title={undefined}
+                  linked={linkedTo(slot)}
+                  note={note(slot)}
+                />
+              ),
+            )
+          )
+        ) : (
+          <>
+            {group.map(([slot, requirement]) => (
+              <EditableChoices
+                key={slot}
+                {...props}
+                edit={edit}
+                slot={slot}
+                requirement={requirement}
+                title={undefined}
+                shared={undefined}
+                importTitle={titles.get(slot)}
+                linked={linkedTo(slot)}
+                connectControl={false}
+                note={note(slot)}
+              />
+            ))}
+            <ServiceConnect {...props} group={group} edit={edit} title={title} />
+          </>
+        )}
+      </div>
+    </section>
+  );
+}
+
+/**
+ * The one "Connect new account" of a service section. With one method it connects at once; with
+ * several it opens a menu of the service's methods, each opening the connect dialog at its own
+ * requirement, so a picked method still links where the app's tools read it.
+ */
+function ServiceConnect<E>({
+  group,
+  edit,
+  title,
+  methods,
+  connections,
+}: ScopeProps<E> & {
+  readonly group: readonly RequirementEntry[];
+  readonly edit: LinkEditing<E>;
+  readonly title: string;
+}) {
+  // While the host's policy loads nothing offers a connection, as in a single requirement.
+  if (group.some(([slot]) => connectionOf(connections, slot) === "pending")) return null;
+  const states = group.flatMap(([slot, requirement]) =>
+    methodStates(methods, slot, requirement).map((state) => ({ ...state, slot, requirement })),
+  );
+  const entries = serviceMethods(
+    states.flatMap((state) =>
+      state.reason === undefined
+        ? [
+            {
+              slot: state.slot,
+              requirement: state.requirement,
+              method: state.name,
+              label: state.label,
+            },
+          ]
+        : [],
+    ),
+  );
+  // With no method the host can connect, the footer says why instead of offering a dead end.
+  if (entries.length === 0)
+    return (
+      <p className="px-3.5 py-2.5 text-[13px] text-muted-foreground" data-connect-unavailable>
+        {[
+          ...new Set(states.flatMap((state) => (state.reason === undefined ? [] : [state.reason]))),
+        ].join(" ")}
+      </p>
+    );
+  const connect = (entry: ServiceMethod) =>
+    edit.connect(entry.slot, entry.requirement, title, entry.method);
+  if (entries.length === 1)
+    return <SingleServiceConnect entry={entries[0]!} edit={edit} onConnect={connect} />;
+  return (
+    <DropdownMenu>
+      <DropdownMenuTrigger asChild>
+        <ConnectNewAccount disabled={edit.connecting === true} menu />
+      </DropdownMenuTrigger>
+      <DropdownMenuContent align="start" className="min-w-56">
+        {entries.map((entry) => (
+          <ServiceMethodItem
+            key={`${entry.slot}:${entry.method}`}
+            entry={entry}
+            edit={edit}
+            onConnect={connect}
+          />
+        ))}
+      </DropdownMenuContent>
+    </DropdownMenu>
+  );
+}
+
+/** The footer button every section ends with; a service's opens its menu of methods. */
+function ConnectNewAccount({
+  menu = false,
+  ...props
+}: ComponentProps<typeof Button> & { readonly menu?: boolean }) {
+  return (
+    <Button
+      variant="ghost"
+      size="sm"
+      className="h-10 w-full justify-start rounded-none px-3.5 text-[13px] text-muted-foreground hover:text-foreground"
+      {...props}
+    >
+      <HugeiconsIcon icon={Add01Icon} size={14} aria-hidden />
+      Connect new account
+      {menu && <HugeiconsIcon icon={ArrowDown01Icon} size={12} strokeWidth={2} aria-hidden />}
+    </Button>
+  );
+}
+
+/** Whether the host lets the caller add accounts to one requirement; refused only once it says so. */
+const useCanAdd = <E,>(edit: LinkEditing<E>, slot: string) => {
+  const { data } = useQuery(edit.choices(slot));
+  return Option.isNone(data) || data.value.canContribute !== false;
+};
+
+function SingleServiceConnect<E>({
+  entry,
+  edit,
+  onConnect,
+}: {
+  readonly entry: ServiceMethod;
+  readonly edit: LinkEditing<E>;
+  readonly onConnect: (entry: ServiceMethod) => void;
+}) {
+  const allowed = useCanAdd(edit, entry.slot);
+  return (
+    <ConnectNewAccount
+      disabled={edit.connecting === true || !allowed}
+      onClick={() => onConnect(entry)}
+    />
+  );
+}
+
+function ServiceMethodItem<E>({
+  entry,
+  edit,
+  onConnect,
+}: {
+  readonly entry: ServiceMethod;
+  readonly edit: LinkEditing<E>;
+  readonly onConnect: (entry: ServiceMethod) => void;
+}) {
+  const allowed = useCanAdd(edit, entry.slot);
+  return (
+    <DropdownMenuItem disabled={!allowed} onSelect={() => onConnect(entry)}>
+      {entry.label}
+    </DropdownMenuItem>
+  );
+}
