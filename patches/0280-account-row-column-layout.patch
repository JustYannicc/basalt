+              returnFocus.current = null;
+              if (target?.isConnected !== true) return;
+              event.preventDefault();
+              target.focus({ preventScroll: true });
+            }}
+          >
+            <DialogTitle>Manage apps</DialogTitle>
+            <DialogDescription>
+              Each saved sign-in for {title} has its own actions. Removing one leaves the others.
+            </DialogDescription>
+            {manage}
+          </DialogContent>
+        </Dialog>
+      )}
+    </>
+  );
+}
