@@ -0,0 +1,77 @@
+import type { Page } from "playwright";
+
+/** Compare the rendered columns and both identity lines with the row's action hit boxes. */
+export const accountRowLayout = (page: Page) =>
+  page.evaluate(() => {
+    const header = document.querySelector<HTMLElement>(".inventory-header");
+    const rows = [...document.querySelectorAll<HTMLElement>(".inventory-row")];
+    const wide = header !== null && getComputedStyle(header).display !== "none";
+    const columns = header === null ? undefined : getComputedStyle(header).gridTemplateColumns;
+    const type = header?.querySelector("[data-account-type-header]")?.getBoundingClientRect();
+    return {
+      rows: rows.length,
+      columnsAligned:
+        !wide ||
+        rows.every((row) => {
+          const cell = row.querySelector("[data-account-type]")?.getBoundingClientRect();
+          return (
+            getComputedStyle(row).gridTemplateColumns === columns &&
+            cell !== undefined &&
+            cell.x === type?.x
+          );
+        }),
+      namesUnobscured: rows.every((row) => {
+        const lines = [
+          ...row.querySelectorAll<HTMLElement>("[data-account-name], [data-account-identity]"),
+        ];
+        return (
+          lines.length > 0 &&
+          lines.every((line) => {
+            const identity = line.getBoundingClientRect();
+            return (
+              identity.width > 0 &&
+              line.scrollWidth <= line.clientWidth &&
+              [...row.querySelectorAll("[data-account-row-menu] button")].every((button) => {
+                const action = button.getBoundingClientRect();
+                return (
+                  action.right <= identity.left ||
+                  action.left >= identity.right ||
+                  action.bottom <= identity.top ||
+                  action.top >= identity.bottom
+                );
+              })
+            );
+          })
+        );
+      }),
+      identityLabelsReadable: rows.every((row) =>
+        [
+          ...row.querySelectorAll<HTMLElement>("[data-account-name], [data-account-identity]"),
+        ].every((line) => line.scrollWidth <= line.clientWidth),
+      ),
+      noHorizontalOverflow: document.documentElement.scrollWidth <= window.innerWidth,
+    };
+  });
+
+/** Observe a stable row from its first complete paint through delayed hydration and setup. */
+export const trackAccountRowHeight = (page: Page, label: string) =>
+  page.addInitScript((label) => {
+    const heights: number[] = [];
+    Object.defineProperty(window, "accountRowHeights", { value: heights });
+    let queued = false;
+    new MutationObserver(() => {
+      if (queued) return;
+      queued = true;
+      requestAnimationFrame(() => {
+        queued = false;
+        const button = [...document.querySelectorAll("[data-account-row-menu] button")].find(
+          (button) => button.getAttribute("aria-label") === `Manage ${label}`,
+        );
+        const row = button?.closest(".inventory-row");
+        if (row?.querySelector("[data-account-name]") && row.querySelector("[data-account-type]")) {
+          const height = row.getBoundingClientRect().height;
+          if (height > 0 && heights.at(-1) !== height) heights.push(height);
+        }
+      });
+    }).observe(document, { subtree: true, childList: true, attributes: true });
+  }, label);
