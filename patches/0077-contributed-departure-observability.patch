+import { AccountId } from "@executor-js/sdk/core";
+import { Schema } from "effect";
+
+/** Stable error kinds only; provider messages and SQL causes never enter the outbox projection. */
+export const DepartureError = Schema.Literals([
+  "lock-unavailable",
+  "storage-error",
+  "unlink-failed",
+  "invalid-snapshot",
+  "interrupted",
+  "execution-failed",
+]);
+export type DepartureError = typeof DepartureError.Type;
+
+/** One remaining link snapshot, visible only to the app's current managers. */
+export const ContributedDeparture = Schema.Struct({
+  job: Schema.String,
+  requirement: Schema.String,
+  account: AccountId,
+  accountLabel: Schema.NullOr(Schema.String),
+  status: Schema.Literals(["queued", "running", "failed"]),
+  attempts: Schema.Number,
+  /** Older jobs have no known enqueue timestamp; updatedAt is only a lower bound on their age. */
+  queuedAt: Schema.NullOr(Schema.Date),
+  updatedAt: Schema.Date,
+  lastError: Schema.NullOr(DepartureError),
+});
+/** A bounded current snapshot; an incomplete page cannot establish that cleanup is healthy. */
+export const ContributedDepartures = Schema.Struct({
+  appName: Schema.String,
+  observedAt: Schema.Date,
+  complete: Schema.Boolean,
+  items: Schema.Array(ContributedDeparture),
+});
