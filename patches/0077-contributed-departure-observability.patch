diff --git a/apps/hosted/server/src/implementation/contributed-departure-reads.ts b/apps/hosted/server/src/implementation/contributed-departure-reads.ts
new file mode 100644
index 0000000..e083121
--- /dev/null
+++ b/apps/hosted/server/src/implementation/contributed-departure-reads.ts
@@ -0,0 +1,36 @@
+import { StorageError, type AppId } from "@executor-js/sdk/core";
+import { Clock, Effect, Schema } from "effect";
+import { ContributedDeparture } from "../contracts/contributed-departures.ts";
+import { CurrentOrganization } from "../contracts/organization.ts";
+import { policyDatabase, requireCurrentAppAccess } from "./resource-policy.ts";
+
+/** App management and organization are rechecked before exposing retained account identities. */
+export const contributedDepartures = (app: AppId) =>
+  Effect.gen(function* () {
+    yield* requireCurrentAppAccess(app, "manage");
+    const { organization, owner } = yield* CurrentOrganization;
+    const sql = yield* policyDatabase;
+    const [row] = yield* sql`select name from executor_apps where id = ${app} and owner = ${owner}`;
+    const appName = yield* Schema.decodeUnknownEffect(Schema.Struct({ name: Schema.String }))(row);
+    const items = yield* sql`select j.id as job, d.requirement, d.account,
+      a.label as "accountLabel", j.status, j.attempts,
+      j.queued_at as "queuedAt", j.updated_at as "updatedAt", j.last_error as "lastError"
+    from hosted_contributed_departure_jobs j
+    join hosted_contributed_departures d on d.job = j.id and d.app = ${app}
+    left join executor_accounts a on a.id = d.account and a.owner = ${owner}
+    where j.organization_id = ${organization} and j.status in ('queued', 'running', 'failed')
+    order by j.updated_at, j.id, d.requirement, d.account limit 101`.pipe(
+      Effect.flatMap(Schema.decodeUnknownEffect(Schema.Array(ContributedDeparture))),
+    );
+    return {
+      appName: appName.name,
+      observedAt: new Date(yield* Clock.currentTimeMillis),
+      complete: items.length <= 100,
+      items: items.slice(0, 100),
+    };
+  }).pipe(
+    Effect.catchTags({
+      SqlError: () => new StorageError(),
+      SchemaError: () => new StorageError(),
+    }),
+  );
