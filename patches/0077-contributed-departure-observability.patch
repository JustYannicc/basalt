diff --git a/e2e/tests/contributed-departure-observability.spec.ts b/e2e/tests/contributed-departure-observability.spec.ts
new file mode 100644
index 0000000..9ffa82a
--- /dev/null
+++ b/e2e/tests/contributed-departure-observability.spec.ts
@@ -0,0 +1,178 @@
+/** Durable cleanup diagnostics stay bounded and obey the app's current management authority. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schedule, Schema } from "effect";
+import { body } from "../support/api.ts";
+import { ok } from "../support/app-links.ts";
+import { withHostedHttpCase } from "../support/case.ts";
+import { cloudLocks } from "../support/cloud-locks.ts";
+import { contributedApp } from "../support/contributed-app.ts";
+import { Evidence } from "../support/evidence.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import { RuntimeLive } from "../support/platform.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Item = Schema.Struct({
+  job: Schema.String,
+  account: Schema.String,
+  accountLabel: Schema.NullOr(Schema.String),
+  attempts: Schema.Number,
+  status: Schema.String,
+  queuedAt: Schema.NullOr(Schema.String),
+  updatedAt: Schema.String,
+  lastError: Schema.NullOr(Schema.String),
+});
+const Page = Schema.Struct({
+  complete: Schema.Boolean,
+  appName: Schema.String,
+  items: Schema.Array(Item),
+});
+
+layer(RuntimeLive, { excludeTestServices: true })("Departure observability", (it) => {
+  it.effect(scenarios.contributedDepartureDiagnostics.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const f = yield* contributedApp;
+        const locks = yield* cloudLocks;
+        const evidence = yield* Evidence;
+        yield* f.role(f.ids.admin, "member");
+        const account = yield* f.connect(
+          f.actors.member,
+          "app",
+          "shared",
+          "Departing pool account",
+        );
+        const path = `${f.prefix}/apps/${f.app.id}/accounts/departures`;
+        const read = f.api
+          .request(f.actors.owner, "GET", path)
+          .pipe(Effect.flatMap((response) => body(Page, response)));
+        expect((yield* f.api.request(f.actors.admin, "GET", path)).status).toBe(403);
+        yield* locks.hold({
+          sql: "SELECT id FROM executor_apps WHERE id = $1 FOR NO KEY UPDATE",
+          params: [f.app.id],
+        });
+        yield* ok(
+          yield* f.api.request(f.actors.owner, "POST", "/api/auth/organization/remove-member", {
+            organizationId: f.actors.organization.id,
+            memberIdOrEmail: f.member.email,
+          }),
+        );
+        const pending = yield* read.pipe(
+          Effect.repeat({
+            schedule: Schedule.spaced("100 millis"),
+            while: (page) => page.items.length !== 1 || page.items[0]?.lastError === null,
+          }),
+          Effect.timeout("15 seconds"),
+        );
+        expect(pending).toMatchObject({
+          complete: true,
+          items: [
+            {
+              account,
+              accountLabel: "Departing pool account",
+              status: "queued",
+              lastError: "lock-unavailable",
+            },
+          ],
+        });
+        expect(pending.items[0]?.queuedAt).not.toBeNull();
+        yield* evidence.json("queued-departure-safe-error.json", pending);
+        // Seven preceding failures are retained state; the next wake must execute the real eighth failure.
+        yield* locks.run({
+          sql: "UPDATE hosted_contributed_departure_jobs SET attempts = 7, available_at = now() - interval '1 second' WHERE organization_id = $1 AND user_id = $2",
