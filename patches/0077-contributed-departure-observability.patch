+++ b/apps/hosted/server/src/implementation/contributed-departure-errors.ts
@@ -0,0 +1,22 @@
+import { StorageError } from "@executor-js/sdk/core";
+import { Schema } from "effect";
+import { isSqlError } from "effect/sql/SqlError";
+import { DepartureError } from "../contracts/contributed-departures.ts";
+
+/** Carries an allowlisted stage or error kind across the queue, never the original cause. */
+export class ContributedDepartureFailed extends Schema.TaggedError<ContributedDepartureFailed>()(
+  "ContributedDepartureFailed",
+  { code: DepartureError },
+) {}
+
+export const departureFailed = (error: unknown) => {
+  if (error instanceof ContributedDepartureFailed) return error;
+  const code = isSqlError(error)
+    ? ["LockTimeoutError", "DeadlockError"].includes(error.reason._tag)
+      ? "lock-unavailable"
+      : "storage-error"
+    : Schema.is(StorageError)(error)
+      ? "storage-error"
+      : "invalid-snapshot";
+  return new ContributedDepartureFailed({ code });
+};
