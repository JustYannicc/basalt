diff --git a/e2e/support/statement-batch-proxy.ts b/e2e/support/statement-batch-proxy.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/statement-batch-proxy.ts
@@ -0,0 +1,180 @@
+import { Deferred, Effect, Exit, Schema } from "effect";
+import { connect, createServer, type Socket } from "node:net";
+
+const Control = Schema.Union([
+  Schema.Struct({ action: Schema.Literal("arm"), app: Schema.NonEmptyString }),
+  Schema.Struct({ action: Schema.Literals(["held", "closed", "state", "release"]) }),
+]);
+
+interface Hold {
+  readonly app: string;
+  readonly reached: Deferred.Deferred<void>;
+  readonly ended: Deferred.Deferred<void>;
+  held: boolean;
+  closed: boolean;
+  later: number;
+}
+
+/** Withhold a chosen app's COMMIT reply in the runner-owned PostgreSQL transport. */
+export const statementBatchProxy = Effect.gen(function* () {
+  let target: number | undefined;
+  let armed: Hold | undefined;
+  let current: Hold | undefined;
+  const sockets = new Set<Socket>();
+  const pending: Array<readonly [Socket, Buffer]> = [];
+  let released = false;
+  const release = () => {
+    released = true;
+    armed = undefined;
+    for (const [socket, bytes] of pending.splice(0)) if (!socket.destroyed) socket.write(bytes);
+  };
+  const server = createServer((incoming) => {
+    if (target === undefined) return incoming.destroy();
+    const outgoing = connect({ host: "127.0.0.1", port: target });
+    sockets.add(incoming);
+    sockets.add(outgoing);
+    let front = Buffer.alloc(0);
+    let back = Buffer.alloc(0);
+    let startup = true;
+    let ready = false;
+    let index = 0;
+    let frozen: Hold | undefined;
+    let transaction: { matches: boolean } | undefined;
+    const queries: Array<{ commit?: Hold }> = [];
+    const close = () => {
+      sockets.delete(incoming);
+      sockets.delete(outgoing);
+      incoming.destroy();
+      outgoing.destroy();
+      if (frozen !== undefined && !frozen.closed) {
+        frozen.closed = true;
+        Deferred.doneUnsafe(frozen.ended, Exit.void);
+      }
+    };
+    incoming.on("error", close);
+    outgoing.on("error", close);
+    incoming.once("close", close);
+    outgoing.once("close", close);
+    incoming.on("data", (chunk) => {
+      front = Buffer.concat([front, chunk]);
+      while (front.length >= (startup ? 4 : 5)) {
+        const length = startup ? front.readInt32BE(0) : front.readInt32BE(1) + 1;
+        if (front.length < length) break;
+        const frame = front.subarray(0, length);
+        front = front.subarray(length);
+        if (startup) {
+          startup = false;
+          outgoing.write(frame);
+          continue;
+        }
+        if (frame[0] === 80) {
+          const offset = frame.indexOf(0, 5) + 1;
+          const sql = frame.toString("utf8", offset, frame.indexOf(0, offset));
+          if (sql === "BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY")
+            transaction = { matches: false };
+          const commit = sql === "COMMIT" && transaction?.matches ? armed : undefined;
+          queries.push(commit === undefined ? {} : { commit });
+          if (sql === "COMMIT") transaction = undefined;
+          if (frozen !== undefined) frozen.later++;
+        } else if (frame[0] === 66 && transaction !== undefined && armed !== undefined) {
+          let offset = frame.indexOf(0, 5) + 1;
+          offset = frame.indexOf(0, offset) + 1;
+          const formats = frame.readInt16BE(offset);
+          offset += 2 + formats * 2;
+          const count = frame.readInt16BE(offset);
+          offset += 2;
+          for (let item = 0; item < count; item++) {
+            const size = frame.readInt32BE(offset);
+            offset += 4;
+            if (size >= 0) {
+              if (frame.toString("utf8", offset, offset + size) === armed.app)
+                transaction.matches = true;
+              offset += size;
+            }
+          }
+        } else if (frame[0] === 81) {
+          queries.push({});
+        }
+        outgoing.write(frame);
+      }
+    });
+    outgoing.on("data", (chunk) => {
+      back = Buffer.concat([back, chunk]);
+      while (back.length >= 5) {
+        const length = back.readInt32BE(1) + 1;
+        if (back.length < length) break;
+        const frame = back.subarray(0, length);
+        back = back.subarray(length);
+        const hold = queries[index]?.commit;
+        if (ready && frozen === undefined && hold !== undefined && hold === armed) {
+          frozen = hold;
+          armed = undefined;
+          hold.held = true;
+          Deferred.doneUnsafe(hold.reached, Exit.void);
+        }
+        if (frozen !== undefined && !released) pending.push([incoming, frame]);
+        else incoming.write(frame);
+        if (frame[0] === 90) {
+          if (ready) index++;
+          else ready = true;
+        }
+      }
+    });
+  });
+  yield* Effect.acquireRelease(
+    Effect.promise(
+      () =>
+        new Promise<void>((resolve, reject) => {
+          server.once("error", reject);
+          server.listen(0, "127.0.0.1", () => {
+            server.off("error", reject);
+            resolve();
+          });
+        }),
+    ),
+    () =>
+      Effect.promise(
+        () =>
+          new Promise<void>((resolve) => {
+            release();
+            for (const socket of sockets) socket.destroy();
+            server.close(() => resolve());
+          }),
+      ),
+  );
+  const address = server.address();
+  if (address === null || typeof address === "string")
+    return yield* Effect.die("No SQL proxy port");
+  return {
+    port: address.port,
+    select: (port: number) =>
+      Effect.sync(() => {
+        target = port;
+      }),
+    control: (input: unknown) =>
+      Effect.gen(function* () {
+        const command = yield* Schema.decodeUnknownEffect(Control)(input);
+        if (command.action === "arm") {
+          release();
+          released = false;
+          armed = current = {
+            app: command.app,
+            reached: yield* Deferred.make<void>(),
+            ended: yield* Deferred.make<void>(),
+            held: false,
+            closed: false,
+            later: 0,
+          };
+        } else if (command.action === "release") release();
+        else if (command.action === "held" && current !== undefined)
+          yield* Deferred.await(current.reached);
+        else if (command.action === "closed" && current !== undefined)
+          yield* Deferred.await(current.ended);
+        return {
+          held: current?.held ?? false,
+          closed: current?.closed ?? false,
+          later: current?.later ?? 0,
+        };
+      }).pipe(Effect.timeout("20 seconds")),
+  };
+});
diff --git a/e2e/tests/statement-batch-deadline.spec.ts b/e2e/tests/statement-batch-deadline.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/tests/statement-batch-deadline.spec.ts
@@ -0,0 +1,100 @@
+import { expect, layer } from "@effect/vitest";
+import { Clock, Effect, Fiber, Schema } from "effect";
+import { appLinksFixture } from "../support/app-links.ts";
+import { appInvocationCounter } from "../support/app-invocation-counter.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { tracedDataQuery, withDataQueryTelemetry } from "../support/data-query-batch.ts";
+import { Evidence } from "../support/evidence.ts";
+import { Target } from "../support/platform.ts";
+import { fixtureRequest } from "../sdk/fixtures.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Statement batch deadline", (it) => {
+  it.effect(scenarios.statementBatchDeadline.title, (context) =>
+    withHostedCase(
+      context,
+      withDataQueryTelemetry(() =>
+        Effect.gen(function* () {
+          const target = yield* Target;
+          const evidence = yield* Evidence;
+          const counter = yield* appInvocationCounter;
+          const source = `import { defineApp, defineProvider, secrets, query, object, string, router } from "apps";
+const service = defineProvider({ name: "Batch deadline fixture", auth: { key: secrets({ label: "Key", fields: object({ token: string() }) }) } });
+export default defineApp({ app: { accounts: { team: service } } }, { tools: router({
+  read: query({ input: object({}) }, async () => { await fetch(${JSON.stringify(counter.origin)}); return "author-ran"; })
+}) });`;
+          const f = yield* appLinksFixture([{ path: "index.ts", content: source }]);
+          yield* f.connect(f.actors.owner, "app", "team", "synthetic-team");
+          const read = () => tracedDataQuery(f.actors.member, f.path, { name: "read", input: {} });
+          expect((yield* read()).response.status).toBe(200);
+          expect(yield* counter.calls).toBe(1);
+          const cloud = target.metadata.target === "cloud";
+          const control = (action: "arm" | "held" | "closed" | "state" | "release") =>
+            Effect.gen(function* () {
+              if (cloud) {
+                if (target.fixtures === undefined)
+                  return yield* Effect.die("Cloud fixture control missing");
+                return yield* fixtureRequest(target.fixtures, "/runtime/statement-batch", {
+                  action,
+                  ...(action === "arm" ? { app: f.app.id } : {}),
+                });
+              }
+              const response = yield* f.api.request(
+                f.actors.owner,
+                action === "arm" ? "POST" : action === "release" ? "DELETE" : "GET",
+                `/api/devtools/statement-hold${action === "held" ? "/reached" : ""}`,
+                action === "arm" ? { prefetch: f.app.id } : undefined,
+              );
+              expect(response.status).toBe(200);
+              return response.body;
+            });
+          yield* Effect.addFinalizer(() => control("release").pipe(Effect.orDie));
+          const before = yield* counter.calls;
+          yield* control("arm");
+          const start = yield* Clock.currentTimeMillis;
+          const waiting = yield* Effect.forkChild(read());
+          yield* control("held");
+          const failed = yield* Fiber.join(waiting).pipe(Effect.timeout("12 seconds"));
+          const elapsed = (yield* Clock.currentTimeMillis) - start;
+          expect(failed.response.status, JSON.stringify(failed.response.body)).toBe(500);
+          expect(failed.response.body).toMatchObject({ _tag: "StorageError" });
+          expect(failed.response.body).not.toMatchObject({ mayHaveWritten: true });
+          expect(elapsed).toBeLessThan(12_000);
+          expect(yield* counter.calls).toBe(before);
+          const state = yield* control(cloud ? "closed" : "state");
+          const guard = cloud
+            ? Schema.Struct({
+                held: Schema.Literal(true),
+                closed: Schema.Literal(true),
+                later: Schema.Number,
+              })
+            : Schema.Struct({ held: Schema.Literal(true), interrupted: Schema.Literal(true) });
+          yield* Schema.decodeUnknownEffect(guard)(state);
+          expect((yield* read()).response.body).toBe("author-ran");
+          expect(yield* counter.calls).toBe(before + 1);
+          yield* evidence.json("statement-batch-deadline.json", {
+            elapsed,
+            failure: failed.response.body,
+            state,
+            authorCallsBefore: before,
+            authorCallsAfter: yield* counter.calls,
+          });
+
+          yield* control("arm");
+          const cancelled = yield* Effect.forkChild(read());
+          yield* control("held");
+          yield* Fiber.interrupt(cancelled);
+          const cancelledState = yield* control(cloud ? "closed" : "state");
+          yield* Schema.decodeUnknownEffect(guard)(cancelledState);
+          expect(yield* counter.calls).toBe(before + 1);
+          expect((yield* read()).response.body).toBe("author-ran");
+          expect(yield* counter.calls).toBe(before + 2);
+          yield* evidence.json("statement-batch-cancellation.json", {
+            state: cancelledState,
+            authorCalls: yield* counter.calls,
+          });
+        }),
+      ),
+    ),
+  );
+});
