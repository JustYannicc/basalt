+import { StorageError } from "@executor-js/sdk/core";
+import { Effect, Option } from "effect";
+import { HttpServerRequest } from "effect/http";
+
+/** Expired prefetch must fail before callers can retry its reads on the stalled client. */
+export const boundedStatementBatch = <A>(batch: Effect.Effect<A>) =>
+  Effect.gen(function* () {
+    const request = yield* Effect.serviceOption(HttpServerRequest.HttpServerRequest);
+    const bounded = batch.pipe(
+      Effect.timeoutOrElse({ duration: "10 seconds", orElse: () => new StorageError() }),
+    );
+    if (Option.isNone(request) || !(request.value.source instanceof Request)) return yield* bounded;
+    const signal = request.value.source.signal;
+    // Alchemy does not interrupt a handler that has not created its response yet.
+    return yield* bounded.pipe(
+      Effect.raceFirst(
+        Effect.callback<never>((resume) => {
+          const abort = () => resume(Effect.interrupt);
+          if (signal.aborted) return abort();
+          signal.addEventListener("abort", abort, { once: true });
+          return Effect.sync(() => signal.removeEventListener("abort", abort));
+        }),
+      ),
+    );
+  });
