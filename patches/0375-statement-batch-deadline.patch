@@ -0,0 +1,27 @@
+import { Effect } from "effect";
+import { createServer } from "node:http";
+
+/** Count author-code calls through a real external HTTP dependency. */
+export const appInvocationCounter = Effect.gen(function* () {
+  let calls = 0;
+  const server = createServer((_request, response) => {
+    calls++;
+    response.end("recorded");
+  });
+  yield* Effect.acquireRelease(
+    Effect.promise(
+      () =>
+        new Promise<void>((resolve, reject) => {
+          server.once("error", reject);
+          server.listen(0, "127.0.0.1", () => {
+            server.off("error", reject);
+            resolve();
+          });
+        }),
+    ),
+    () => Effect.promise(() => new Promise<void>((resolve) => server.close(() => resolve()))),
+  );
+  const address = server.address();
+  if (address === null || typeof address === "string") return yield* Effect.die("No counter port");
+  return { origin: `http://127.0.0.1:${address.port}`, calls: Effect.sync(() => calls) };
+});
