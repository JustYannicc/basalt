+import { expect, layer } from "@effect/vitest";
+import { Clock, Effect, Fiber, Layer, Schedule, Schema } from "effect";
+import { body } from "../support/api.ts";
+import { McpClient } from "../support/mcp-client.ts";
+import { appLinksFixture } from "../support/app-links.ts";
+import { appInvocationCounter } from "../support/app-invocation-counter.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { tracedDataQuery } from "../support/data-query-batch.ts";
+import { withStatementBatchFixture } from "../support/statement-batch-fixture.ts";
+import { Evidence } from "../support/evidence.ts";
+import { Target } from "../support/platform.ts";
+import { fixtureRequest } from "../sdk/fixtures.ts";
+import { scenarios } from "../test-plan.ts";
+
+layer(HostedLive, { excludeTestServices: true })("Statement batch deadline", (it) => {
+  for (const [kind, scenario] of [
+    ["data", scenarios.statementBatchDeadline],
+    ["mcp", scenarios.statementBatchMcpDeadline],
+  ] as const)
+    it.effect(scenario.title, (context) =>
+      withHostedCase(
+        context,
+        withStatementBatchFixture((query) =>
+          Effect.gen(function* () {
+            const target = yield* Target;
+            const evidence = yield* Evidence;
+            const counter = yield* appInvocationCounter;
+            const source = `import { defineApp, defineProvider, secrets, query, object, string, router } from "apps";
+const service = defineProvider({ name: "Batch deadline fixture", auth: { key: secrets({ label: "Key", fields: object({ token: string() }) }) } });
+export default defineApp({ app: { accounts: { team: service } } }, { tools: router({
+  read: query({ input: object({}) }, async () => { await fetch(${JSON.stringify(counter.origin)}); return "author-ran"; })
+}) });`;
+            const f = yield* appLinksFixture([{ path: "index.ts", content: source }]);
+            yield* f.connect(f.actors.owner, "app", "team", "synthetic-team");
+            const dataRead = () =>
+              tracedDataQuery(f.actors.member, f.path, { name: "read", input: {} }).pipe(
+                Effect.map(({ response, request }) => ({
+                  traceId: request.traceId,
+                  success: response.status === 200,
+                  value: response.body,
+                  failure: response.body,
+                  status: response.status,
+                })),
+              );
+            const mcpRead =
+              kind !== "mcp"
+                ? undefined
+                : yield* Effect.gen(function* () {
+                    const mcp = yield* McpClient.pipe(Effect.provide(Layer.fresh(McpClient.layer)));
+                    const key = yield* body(
+                      Schema.Struct({
+                        id: Schema.String,
+                        key: Schema.RedactedFromValue(Schema.String),
+                      }),
+                      yield* f.api.request(f.actors.member, "POST", "/api/auth/api-key/create", {
+                        name: "Batch deadline fixture",
+                      }),
+                    );
+                    yield* Effect.addFinalizer(() =>
+                      f.api
+                        .request(f.actors.member, "POST", "/api/auth/api-key/delete", {
+                          keyId: key.id,
+                        })
+                        .pipe(Effect.orDie),
+                    );
+                    const client = yield* mcp.connect(key.key, "batch-deadline", {
+                      organization: f.actors.organization.id,
+                    });
+                    const Result = Schema.Struct({
+                      status: Schema.Literal("completed"),
+                      execution: Schema.Struct({
+                        ok: Schema.Boolean,
+                        value: Schema.optional(Schema.Unknown),
+                        error: Schema.optional(
+                          Schema.Struct({ response: Schema.optional(Schema.Unknown) }),
+                        ),
+                      }),
+                    });
+                    return () =>
+                      client
+                        .use("Read through MCP", (client, signal) =>
+                          client.callTool(
+                            {
+                              name: "execute",
+                              arguments: {
+                                code: `return await tools[${JSON.stringify(f.app.slug)}].read({})`,
+                              },
+                            },
+                            undefined,
+                            { signal },
+                          ),
+                        )
+                        .pipe(
+                          Effect.flatMap((result) =>
+                            Schema.decodeUnknownEffect(Result)(result.structuredContent),
+                          ),
+                          Effect.flatMap(({ execution }) =>
+                            Effect.gen(function* () {
+                              const request = (yield* evidence.requests)
+                                .filter(
+                                  (request) => request.path === "/mcp" && request.method === "POST",
+                                )
+                                .at(-1);
+                              if (request === undefined)
+                                return yield* Effect.die("MCP request evidence missing");
+                              return {
+                                traceId: request.traceId,
+                                success: execution.ok,
+                                value: execution.value,
+                                failure: execution.error?.response,
+                                status: undefined,
+                              };
+                            }),
+                          ),
+                        );
+                  });
+            const read = mcpRead ?? dataRead;
+            const delivered = (trace: string) =>
+              query(trace).pipe(
+                Effect.flatMap((trace) =>
+                  trace.data.some(
+                    ({ span }) =>
+                      span.operationName.startsWith("http.server") &&
+                      span.tags["http.request.method"] === "POST",
+                  )
+                    ? Effect.succeed(trace)
+                    : Effect.fail(new Error("The completed request trace is not delivered")),
+                ),
+                Effect.retry({ schedule: Schedule.spaced("100 millis"), times: 50 }),
+              );
+            const dispatch = kind === "data" ? "sdk.data.query" : "sdk.tools.call";
+            const warm = yield* read();
+            expect(warm.success).toBe(true);
+            expect(
+              (yield* delivered(warm.traceId)).data.some(
+                ({ span }) => span.operationName === dispatch,
+              ),
+            ).toBe(true);
+            expect(yield* counter.calls).toBe(1);
+            const cloud = target.metadata.target === "cloud";
+            const control = (action: "arm" | "held" | "closed" | "state" | "release") =>
+              Effect.gen(function* () {
+                if (cloud) {
+                  if (target.fixtures === undefined)
+                    return yield* Effect.die("Cloud fixture control missing");
+                  return yield* fixtureRequest(target.fixtures, "/runtime/statement-batch", {
+                    action,
+                    ...(action === "arm" ? { app: f.app.id } : {}),
+                  });
+                }
+                const response = yield* f.api.request(
+                  f.actors.owner,
+                  action === "arm" ? "POST" : action === "release" ? "DELETE" : "GET",
+                  `/api/devtools/statement-hold${action === "held" ? "/reached" : action === "closed" ? "/interrupted" : ""}`,
+                  action === "arm" ? { prefetch: f.app.id } : undefined,
+                );
+                expect(response.status).toBe(200);
+                return response.body;
+              });
+            yield* Effect.addFinalizer(() => control("release").pipe(Effect.orDie));
+            const before = yield* counter.calls;
+            yield* control("arm");
+            const start = yield* Clock.currentTimeMillis;
+            const waiting = yield* Effect.forkChild(read());
+            yield* control("held");
+            const failed = yield* Fiber.join(waiting).pipe(
+              Effect.timeout("12 seconds"),
+              Effect.catchTag("TimeoutError", () =>
+                Effect.die("Stalled batch did not return StorageError before the deadline"),
+              ),
+            );
+            const elapsed = (yield* Clock.currentTimeMillis) - start;
+            expect(failed.success, JSON.stringify(failed)).toBe(false);
+            if (kind === "data") expect(failed.status).toBe(500);
+            expect(failed.failure).toMatchObject(
+              kind === "data"
+                ? { _tag: "StorageError" }
+                : { code: "StorageError", status: 500, retryable: true },
+            );
+            expect(failed.failure).not.toMatchObject({ mayHaveWritten: true });
+            expect(elapsed).toBeLessThan(12_000);
+            expect(yield* counter.calls).toBe(before);
+            const failureTrace = yield* delivered(failed.traceId);
+            expect(failureTrace.data.some(({ span }) => span.operationName === dispatch)).toBe(
+              false,
+            );
+            yield* evidence.json("statement-batch-dispatch.json", {
+              dispatch,
+              spans: failureTrace.data.map(({ span }) => span.operationName),
+            });
+            const state = yield* control("closed");
+            yield* evidence.json("statement-batch-deadline-state.json", state);
+            const guard = cloud
+              ? Schema.Struct({
+                  held: Schema.Literal(true),
+                  closed: Schema.Literal(true),
+                  later: Schema.Literal(1),
+                })
+              : Schema.Struct({ held: Schema.Literal(true), interrupted: Schema.Literal(true) });
+            yield* Schema.decodeUnknownEffect(guard)(state);
+            expect((yield* read()).value).toBe("author-ran");
+            expect(yield* counter.calls).toBe(before + 1);
+            yield* evidence.json("statement-batch-deadline.json", {
+              elapsed,
+              failure: failed.failure,
+              state,
+              authorCallsBefore: before,
+              authorCallsAfter: yield* counter.calls,
+            });
+
+            yield* control("arm");
+            const cancelled = yield* Effect.forkChild(read());
+            yield* control("held");
+            const cancellationStarted = yield* Clock.currentTimeMillis;
+            yield* Fiber.interrupt(cancelled);
+            const cancelledState = yield* control("closed").pipe(Effect.timeout("7 seconds"));
+            yield* evidence.json("statement-batch-cancelled-state.json", cancelledState);
+            const cancellationElapsed = (yield* Clock.currentTimeMillis) - cancellationStarted;
+            yield* Schema.decodeUnknownEffect(guard)(cancelledState);
+            expect(yield* counter.calls).toBe(before + 1);
+            expect((yield* read()).value).toBe("author-ran");
+            expect(yield* counter.calls).toBe(before + 2);
+            yield* evidence.json("statement-batch-cancellation.json", {
+              state: cancelledState,
+              cancellationElapsed,
+              authorCalls: yield* counter.calls,
+            });
+          }),
+        ),
+      ),
+    );
+});
