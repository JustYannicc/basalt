+import { expect } from "@effect/vitest";
+import { Effect, Layer, Schema } from "effect";
+import { Actors } from "./actors.ts";
+import { Api, body, SessionClients } from "./api.ts";
+import { Organization } from "./contracts.ts";
+import { SpanQuery } from "./contracts.ts";
+import { Telemetry } from "./evidence.ts";
+import { throttlingCollector } from "./throttling-collector.ts";
+import { startControlledDevelopmentServer } from "./managed-server.ts";
+import { Target } from "./platform.ts";
+
+/** Only the existing development entry mounts the self-host SQL hold. */
+export const withStatementBatchFixture = <A, E, R>(
+  run: (query: (trace: string) => Effect.Effect<typeof SpanQuery.Type>) => Effect.Effect<A, E, R>,
+) =>
+  Effect.gen(function* () {
+    const target = yield* Target;
+    if (target.metadata.target !== "self-host") {
+      const telemetry = yield* Telemetry;
+      return yield* run((trace) => telemetry.query(trace).pipe(Effect.orDie));
+    }
+    const collector = yield* throttlingCollector;
+    const isolated = yield* startControlledDevelopmentServer(target, {
+      OTEL_EXPORTER_OTLP_TRACES_ENDPOINT: `${collector.endpoint}/v1/traces`,
+    });
+    const runtime = Layer.fresh(SessionClients.layer).pipe(
+      Layer.provideMerge(Layer.succeed(Target, isolated)),
+    );
+    const services = yield* Layer.build(Layer.fresh(Api.layer.pipe(Layer.provideMerge(runtime))));
+    const actors = yield* Effect.gen(function* () {
+      const api = yield* Api;
+      const origin = isolated.metadata.origin;
+      const operator = yield* api.session();
+      expect(
+        (yield* api.request(operator, "POST", "/api/devtools/operator", {}, { origin })).status,
+      ).toBe(200);
+      const users = yield* body(
+        Schema.Struct({
+          users: Schema.Array(Schema.Struct({ id: Schema.String, email: Schema.String })),
+        }),
+        yield* api.request(operator, "GET", "/api/auth/admin/list-users"),
+      );
+      const as = (name: string) =>
+        Effect.gen(function* () {
+          const user = users.users.find((user) => user.email === `agent-${name}@example.test`);
+          if (user === undefined) return yield* Effect.die("Development actor is missing");
+          const session = yield* api.session();
+          expect(
+            (yield* api.request(session, "POST", "/api/devtools/operator", {}, { origin })).status,
+          ).toBe(200);
+          expect(
+            (yield* api.request(
+              session,
+              "POST",
+              "/api/auth/admin/impersonate-user",
+              { userId: user.id },
+              { origin },
+            )).status,
+          ).toBe(200);
+          return session;
+        });
+      const owner = yield* as("agent");
+      const organizations = yield* body(
+        Schema.Array(Organization),
+        yield* api.request(owner, "GET", "/api/auth/organization/list"),
+      );
+      const organization = organizations[0];
+      if (organization === undefined)
+        return yield* Effect.die("Development organization is missing");
+      return { owner, organization, admin: yield* as("admin"), member: yield* as("rhys-member") };
+    }).pipe(Effect.provideContext(services));
+    return yield* run((trace) => collector.query(trace).pipe(Effect.orDie)).pipe(
+      Effect.provideService(Actors, actors),
+      Effect.provideContext(services),
+    );
+  });
diff --git a/e2e/support/statement-batch-proxy.ts b/e2e/support/statement-batch-proxy.ts
new file mode 100644
--- /dev/null
+++ b/e2e/support/statement-batch-proxy.ts
@@ -0,0 +1,209 @@
+import { Deferred, Effect, Exit, Schema } from "effect";
+import { connect, createServer, type Socket } from "node:net";
+
+const Control = Schema.Union([
+  Schema.Struct({ action: Schema.Literal("arm"), app: Schema.NonEmptyString }),
+  Schema.Struct({ action: Schema.Literals(["held", "closed", "state", "release"]) }),
+]);
+
+interface Hold {
+  readonly app: string;
+  readonly reached: Deferred.Deferred<void>;
+  readonly ended: Deferred.Deferred<void>;
+  held: boolean;
+  closed: boolean;
+  later: number;
+}
+
+/** Withhold a chosen app's COMMIT reply in the runner-owned PostgreSQL transport. */
+export const statementBatchProxy = Effect.gen(function* () {
+  let target: number | undefined;
+  let armed: Hold | undefined;
+  let current: Hold | undefined;
+  const sockets = new Set<Socket>();
+  const pending: Array<readonly [Socket, Buffer]> = [];
+  let released = false;
+  const release = () => {
+    released = true;
+    armed = undefined;
+    for (const [socket, bytes] of pending.splice(0)) if (!socket.destroyed) socket.write(bytes);
+  };
+  const server = createServer((incoming) => {
+    if (target === undefined) return incoming.destroy();
+    const outgoing = connect({ host: "127.0.0.1", port: target });
+    sockets.add(incoming);
+    sockets.add(outgoing);
+    let front = Buffer.alloc(0);
+    let back = Buffer.alloc(0);
+    let startup = true;
+    let ready = false;
+    let index = 0;
+    let frozen: Hold | undefined;
+    let transaction: { matches: boolean } | undefined;
+    type StatementKind = "begin" | "commit" | "query";
+    const statements = new Map<string, StatementKind>();
+    const portals = new Map<string, StatementKind>();
+    let postCommit: Hold | undefined;
+    const queries: Array<{ commit?: Hold }> = [];
+    const kindOf = (sql: string): StatementKind =>
+      sql === "BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY"
+        ? "begin"
+        : sql === "COMMIT"
+          ? "commit"
+          : "query";
+    const execute = (kind: StatementKind) => {
+      const commit = kind === "commit" && transaction?.matches ? armed : undefined;
+      if (postCommit !== undefined) postCommit.later++;
+      queries.push(commit === undefined ? {} : { commit });
+      if (kind === "commit") {
+        transaction = undefined;
+        if (commit !== undefined) postCommit = commit;
+      }
+    };
+    const close = () => {
+      sockets.delete(incoming);
+      sockets.delete(outgoing);
+      incoming.destroy();
+      outgoing.destroy();
+      if (frozen !== undefined && !frozen.closed) {
+        frozen.closed = true;
+        Deferred.doneUnsafe(frozen.ended, Exit.void);
+      }
+    };
+    incoming.on("error", close);
+    outgoing.on("error", close);
+    incoming.once("close", close);
+    outgoing.once("close", close);
+    incoming.on("data", (chunk) => {
+      front = Buffer.concat([front, typeof chunk === "string" ? Buffer.from(chunk) : chunk]);
+      while (front.length >= (startup ? 4 : 5)) {
+        const length = startup ? front.readInt32BE(0) : front.readInt32BE(1) + 1;
+        if (front.length < length) break;
+        const frame = front.subarray(0, length);
+        front = front.subarray(length);
+        if (startup) {
+          startup = false;
+          outgoing.write(frame);
+          continue;
+        }
+        if (frame[0] === 80) {
+          const nameEnd = frame.indexOf(0, 5);
+          const name = frame.toString("utf8", 5, nameEnd);
+          const offset = nameEnd + 1;
+          statements.set(name, kindOf(frame.toString("utf8", offset, frame.indexOf(0, offset))));
+        } else if (frame[0] === 66) {
+          const portalEnd = frame.indexOf(0, 5);
+          const portal = frame.toString("utf8", 5, portalEnd);
+          const statementEnd = frame.indexOf(0, portalEnd + 1);
+          const statement = frame.toString("utf8", portalEnd + 1, statementEnd);
+          const kind = statements.get(statement) ?? "query";
+          portals.set(portal, kind);
+          if (kind === "begin") transaction = { matches: false };
+          let offset = statementEnd + 1;
+          const formats = frame.readInt16BE(offset);
+          offset += 2 + formats * 2;
+          const count = frame.readInt16BE(offset);
+          offset += 2;
+          for (let item = 0; item < count; item++) {
+            const size = frame.readInt32BE(offset);
+            offset += 4;
+            if (size >= 0) {
+              if (
+                transaction !== undefined &&
+                armed !== undefined &&
+                frame.toString("utf8", offset, offset + size) === armed.app
+              )
+                transaction.matches = true;
+              offset += size;
+            }
+          }
+        } else if (frame[0] === 69) {
+          execute(portals.get(frame.toString("utf8", 5, frame.indexOf(0, 5))) ?? "query");
+        } else if (frame[0] === 81) {
+          const kind = kindOf(frame.toString("utf8", 5, frame.length - 1));
+          if (kind === "begin") transaction = { matches: false };
+          execute(kind);
+        }
+        outgoing.write(frame);
+      }
+    });
+    outgoing.on("data", (chunk) => {
+      back = Buffer.concat([back, typeof chunk === "string" ? Buffer.from(chunk) : chunk]);
+      while (back.length >= 5) {
+        const length = back.readInt32BE(1) + 1;
+        if (back.length < length) break;
+        const frame = back.subarray(0, length);
+        back = back.subarray(length);
+        const hold = queries[index]?.commit;
+        if (ready && frozen === undefined && hold !== undefined && hold === armed) {
+          frozen = hold;
+          armed = undefined;
+          hold.held = true;
+          Deferred.doneUnsafe(hold.reached, Exit.void);
+        }
+        if (frozen !== undefined && !released) pending.push([incoming, frame]);
+        else incoming.write(frame);
+        if (frame[0] === 90) {
+          if (ready) index++;
+          else ready = true;
+        }
+      }
+    });
+  });
+  yield* Effect.acquireRelease(
+    Effect.promise(
+      () =>
+        new Promise<void>((resolve, reject) => {
+          server.once("error", reject);
+          server.listen(0, "127.0.0.1", () => {
+            server.off("error", reject);
+            resolve();
+          });
+        }),
+    ),
+    () =>
+      Effect.promise(
+        () =>
+          new Promise<void>((resolve) => {
+            release();
+            for (const socket of sockets) socket.destroy();
+            server.close(() => resolve());
+          }),
+      ),
+  );
+  const address = server.address();
+  if (address === null || typeof address === "string")
+    return yield* Effect.die("No SQL proxy port");
+  return {
+    port: address.port,
+    select: (port: number) =>
+      Effect.sync(() => {
+        target = port;
+      }),
+    control: (input: unknown) =>
+      Effect.gen(function* () {
+        const command = yield* Schema.decodeUnknownEffect(Control)(input);
+        if (command.action === "arm") {
+          release();
+          released = false;
+          armed = current = {
+            app: command.app,
+            reached: yield* Deferred.make<void>(),
+            ended: yield* Deferred.make<void>(),
+            held: false,
+            closed: false,
+            later: 0,
+          };
+        } else if (command.action === "release") release();
+        else if (command.action === "held" && current !== undefined)
+          yield* Deferred.await(current.reached);
+        else if (command.action === "closed" && current !== undefined)
+          yield* Deferred.await(current.ended);
+        return {
+          held: current?.held ?? false,
+          closed: current?.closed ?? false,
+          later: current?.later ?? 0,
+        };
+      }).pipe(Effect.timeout("20 seconds")),
+  };
+});
