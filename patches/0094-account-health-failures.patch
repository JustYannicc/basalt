+        yield* f.backend.driverHealth({}, 503);
+        const failed = yield* check();
+        expect(failed.driver.check.failure).toEqual({
+          phase: "invoke",
+          tag: "HostOperationFailed",
+        });
+        const retained = yield* body(
+          Schema.Struct({ health: DriverHealth }),
+          yield* f.api.request(f.actors.owner, "GET", path),
+        );
+        expect(retained.health.driver.check.failure).toEqual(failed.driver.check.failure);
+        expect(JSON.stringify(retained)).not.toContain("opaque-");
+        yield* f.backend.driverHealth({});
+        expect((yield* check()).driver.check.failure).toBeUndefined();
+        const gate = yield* f.backend.holdCheck;
+        const pending = yield* check().pipe(Effect.forkChild);
+        yield* gate.started;
+        const timedOut = yield* Fiber.join(pending);
+        yield* gate.release;
+        expect(timedOut.driver.check.failure).toEqual({ phase: "timeout", tag: "TimeoutError" });
+      }),
+    ),
+  );
+});
