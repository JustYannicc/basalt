+        const gate = HttpRouter.add(
+          "GET",
+          "/release",
+          Deferred.succeed(started, undefined).pipe(
+            Effect.andThen(Deferred.await(release)),
+            Effect.as(HttpServerResponse.empty()),
+          ),
+        );
+        const fixture = yield* Layer.build(
+          HttpRouter.serve(gate).pipe(
+            Layer.provideMerge(NodeHttpServer.layer(createServer, { host: "127.0.0.1", port: 0 })),
+          ),
+        );
+        const server = yield* HttpServer.HttpServer.pipe(Effect.provideContext(fixture));
+        const address = server.address;
+        if (!("port" in address)) return yield* Effect.die("Fixture needs a TCP address");
+        yield* deploy(
+          `await fetch("http://127.0.0.1:${address.port}/release"); return {accountInfo:{displayName:"health-late-nontimeout"}};`,
+          `const json = Response.json;
+Response.json = function(data, init) {
+  if (JSON.stringify(data).includes("health-late-nontimeout"))
