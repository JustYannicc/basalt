+            { source: 'source:"service",', phase: "vendor" },
+            { source: 'source:"storage",', phase: "invoke" },
+          ].map(({ source, phase }) => ({
+            health: `throw new HostOperationFailed({${source}});`,
+            expected: { phase, tag: "HostOperationFailed" },
+          })),
+        ];
+        for (const test of cases) {
