+import { Deferred, Effect, Fiber, Layer, Schedule, Schema } from "effect";
+import { Actors } from "../support/actors.ts";
+import { Api, body } from "../support/api.ts";
+import { Resource } from "../support/contracts.ts";
+import { HostedLive, withHostedHttpCase } from "../support/case.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { Evidence, Telemetry } from "../support/evidence.ts";
+import { acquisitionFixture } from "../support/account-acquisition-fixture.ts";
+import { scenarios } from "../test-plan.ts";
+
+const Failure = Schema.Struct({ phase: Schema.String, tag: Schema.String });
+const Check = Schema.Struct({
+  status: Schema.String,
+  current: Schema.Boolean,
+  failure: Schema.optionalKey(Failure),
+});
+const Health = Schema.Struct({
+  apps: Schema.Array(Schema.Struct({ check: Schema.NullOr(Check) })),
+});
+
+const files = (health: string, prelude = "") => [
+  {
+    path: "index.ts",
+    content: `import { defineApp, defineProvider, ProviderError, secrets, object, string } from "apps";
+import { HostOperationFailed } from "apps/contracts";
+${prelude}
+const service = defineProvider({name: "Failure record fixture", auth: {
+  key: secrets({label: "Key", fields: object({token: string()})})
+}, async health({account}) { ${health} }});
+export default defineApp({app: {accounts: {service}}}, {});`,
+  },
+  appsManifest,
+];
+
+layer(HostedLive, { excludeTestServices: true })("Account health failure records", (it) => {
+  it.effect(scenarios.accountHealthFailures.title, (context) =>
+    withHostedHttpCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          telemetry = yield* Telemetry,
+          evidence = yield* Evidence;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        const app = yield* body(
+          Resource,
+          yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+            name: "Health failure records",
+            files: files("return {};"),
+          }),
+        );
+        let account: string | undefined;
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* api.request(actors.owner, "DELETE", `${prefix}/apps/${app.id}`);
+            if (account !== undefined)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`);
+          }).pipe(Effect.orDie),
+        );
+        const appPath = `${prefix}/apps/${app.id}`;
+        const connection = yield* body(
+          Resource,
+          yield* api.request(
+            actors.owner,
+            "POST",
+            `${appPath}/accounts/app/service/connections`,
+            {},
+          ),
+        );
+        account = (yield* body(
+          Resource,
+          yield* api.request(
+            actors.owner,
+            "POST",
+            `${prefix}/connections/${connection.id}/submit`,
+            {
+              method: "key",
+              label: "Failure account",
+              fields: { token: "synthetic-health-secret" },
+            },
+          ),
+        )).id;
+        const path = `${prefix}/accounts/${account}`;
+        const check = () =>
+          api
+            .request(actors.owner, "POST", `${path}/health`)
+            .pipe(Effect.flatMap((r) => body(Health, r)));
+        const deploy = (health: string, prelude = "") =>
+          api
+            .request(actors.owner, "POST", `${appPath}/deploy`, {
+              files: files(health, prelude),
+            })
+            .pipe(Effect.map((r) => expect(r.status, JSON.stringify(r.body)).toBe(200)));
+        expect((yield* check()).apps[0]?.check?.failure).toBeUndefined();
+        const cases = [
+          {
+            health:
+              'const error = new Error(account.fields.token); error.name = "untrusted-health-tag"; throw error;',
+            expected: { phase: "app-threw", tag: "HostOperationFailed" },
+          },
+          {
+            health:
+              'throw new ProviderError({reason:"forbidden",status:200,upstream:{code:"missing_scope"}});',
+            expected: { phase: "vendor", tag: "ProviderError" },
+          },
+          {
+            health: 'return JSON.parse(\'{"accountInfo":{"displayName":[]}}\');',
