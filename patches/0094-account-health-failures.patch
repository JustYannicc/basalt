+  return json.call(this, data, init);
+};`,
+        );
+        const pending = yield* check().pipe(Effect.forkChild);
+        yield* Deferred.await(started);
+        yield* serverControl("clock/advance", 200, { milliseconds: 14100 });
+        yield* Deferred.succeed(release, undefined);
+        expect((yield* Fiber.join(pending)).apps[0]?.check?.failure).toEqual({
+          phase: "invoke",
+          tag: "WorkflowFailure",
+        });
+        yield* deploy("return {};");
+        expect((yield* check()).apps[0]?.check).toMatchObject({ status: "healthy", current: true });
+        const recovered = yield* body(
+          Schema.Struct({ health: Health }),
