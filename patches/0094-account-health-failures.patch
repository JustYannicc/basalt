@@ -0,0 +1,67 @@
+import { Cause, Effect, Option, Schema } from "effect";
+import { AccountCheckFailure } from "../contracts/account-check-failure.ts";
+import { HostOperationFailed } from "apps/contracts";
+import { RuntimeProtocolFailed } from "../contracts/runtime.ts";
+
+const TaggedFailure = Schema.Struct({ _tag: AccountCheckFailure.fields.tag });
+
+/** Only a deadline failure, rather than any late failure, is classified as a timeout. */
+export const accountCheckFailure = (error: unknown): AccountCheckFailure => {
+  if (Cause.isTimeoutError(error)) return { phase: "timeout", tag: "TimeoutError" };
+  const parsed = Schema.decodeUnknownOption(TaggedFailure)(error);
+  const tag = Option.isSome(parsed) ? parsed.value._tag : "Unknown";
+  switch (tag) {
+    case "RuntimeProtocolFailed":
+      return {
+        phase: Schema.is(RuntimeProtocolFailed)(error)
+          ? error.reason === "timeout"
+            ? "timeout"
+            : error.reason === "invalid-reply"
+              ? "decode"
+              : "invoke"
+          : "invoke",
+        tag,
+      };
+    case "WorkflowFailure":
+      // Older hosts share this tag with non-timeout failures, so it proves no deadline cause.
+      return { phase: "invoke", tag };
+    case "HostOutputInvalid":
+    case "SchemaError":
+      return { phase: "decode", tag };
+    case "HostOperationFailed":
+      return {
+        phase: Schema.is(HostOperationFailed)(error)
+          ? error.source === "app"
+            ? "app-threw"
+            : error.source === "service"
+              ? "vendor"
+              : "invoke"
+          : "invoke",
+        tag,
+      };
+    case "ProviderError":
+    case "OAuthReconnectRequired":
+    case "OAuthRenewalFailed":
+      return { phase: "vendor", tag };
+    case "TimeoutError":
+      return { phase: "timeout", tag };
+    default:
+      return { phase: "invoke", tag };
+  }
+};
+
+/** Console logs and exported spans carry the same two bounded values as stored health. */
+export const recordAccountCheckFailure = (failure: AccountCheckFailure) =>
+  Effect.annotateCurrentSpan({
+    "executor.account.check.failure.phase": failure.phase,
+    "executor.account.check.failure.tag": failure.tag,
+  }).pipe(
+    Effect.andThen(
+      Effect.logWarning("Account health check failed").pipe(
+        Effect.annotateLogs({
+          "executor.account.check.failure.phase": failure.phase,
+          "executor.account.check.failure.tag": failure.tag,
+        }),
+      ),
+    ),
+  );
