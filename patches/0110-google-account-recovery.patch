--- /dev/null
+++ b/packages/ui/src/contracts/oauth-scopes.ts
@@ -0,0 +1,10 @@
+/**
+ * A short name for an OAuth scope. Providers publish scopes as opaque strings, often URLs such as
+ * `https://www.googleapis.com/auth/documents`; the exact value is always shown beside the name.
+ */
+export const scopeName = (scope: string) => {
+  if (!URL.canParse(scope)) return scope;
+  const url = new URL(scope);
+  const path = url.pathname.replace(/^\/auth\//, "").replace(/^\/+|\/+$/g, "");
+  return path === "" ? url.hostname : path;
+};
