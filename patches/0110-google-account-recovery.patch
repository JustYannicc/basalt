diff --git a/packages/ui/src/implementation/dashboard/oauth-scopes.tsx b/packages/ui/src/implementation/dashboard/oauth-scopes.tsx
new file mode 100644
index 0000000..f1546ac
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/oauth-scopes.tsx
@@ -0,0 +1,56 @@
+import { scopeName } from "../../contracts/oauth-scopes.ts";
+import { cn } from "../lib/utils.ts";
+
+/** Each scope's short name with its exact value, which is what the service's consent screen grants. */
+export function ScopeList({
+  scopes,
+  className,
+}: {
+  readonly scopes: readonly string[];
+  readonly className?: string | undefined;
+}) {
+  return (
+    <ul className={cn("flex flex-col gap-1.5 text-left", className)}>
+      {scopes.map((scope) => (
+        <li key={scope} className="min-w-0 text-[12px] leading-5">
+          <span className="font-medium text-foreground">{scopeName(scope)}</span>
+          {scopeName(scope) !== scope && (
+            <span className="block font-mono text-[11px] text-muted-foreground wrap-anywhere">
+              {scope}
+            </span>
+          )}
+        </li>
+      ))}
+    </ul>
+  );
+}
+
+/** Collapsed by default: the row stays one line, and the scopes are one click away. */
+export function RequestedAccess({
+  apps,
+}: {
+  readonly apps: readonly {
+    readonly id: string;
+    readonly name: string;
+    readonly scopes: readonly string[];
+  }[];
+}) {
+  if (apps.length === 0) return null;
+  return (
+    <details className="requested-access col-span-full min-w-0 pl-11.5 text-[12px] text-muted-foreground">
+      <summary className="w-fit cursor-pointer rounded-sm select-none hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-[740px]:flex max-[740px]:min-h-11 max-[740px]:items-center">
+        Requested access
+      </summary>
+      <dl className="mt-2 grid gap-x-6 gap-y-3 sm:grid-cols-2">
+        {apps.map((app) => (
+          <div key={app.id} className="min-w-0">
+            <dt className="mb-1 text-[11px] text-muted-foreground">{app.name}</dt>
+            <dd>
+              <ScopeList scopes={app.scopes} />
+            </dd>
+          </div>
+        ))}
+      </dl>
+    </details>
+  );
+}
