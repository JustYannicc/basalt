+const scopeKey = (issuer: string | undefined, scope: string) =>
+  issuer === "https://accounts.google.com"
+    ? scope === "email"
+      ? "https://www.googleapis.com/auth/userinfo.email"
+      : scope === "profile"
+        ? "https://www.googleapis.com/auth/userinfo.profile"
+        : scope
+    : scope;
+
+export const missingOAuthScopes = (
+  issuer: string | undefined,
+  requested: readonly string[],
+  granted: readonly string[] | undefined,
+) => {
+  const covered = new Set(granted?.map((scope) => scopeKey(issuer, scope)));
+  return requested.filter((scope) => !covered.has(scopeKey(issuer, scope)));
+};
