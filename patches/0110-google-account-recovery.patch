+export const bindingFamily = (inventory: Inventory, binding: AccountSummary) => {
+  const requirements = inventory.apps.flatMap((app) => Object.values(app.requirements.accounts));
+  const exact = requirements.find(
+    (requirement) =>
+      requirement.provider === binding.provider &&
+      requirement.definition.site === undefined &&
+      interactiveOAuth(requirement.definition, binding.method)?.identity !== undefined,
+  );
+  if (exact !== undefined)
+    return interactiveOAuth(exact.definition, binding.method)?.identity ?? undefined;
+  for (const app of bindingApps(inventory, [binding]))
+    for (const requirement of Object.values(app.requirements.accounts)) {
+      if (requirement.definition.site !== undefined) continue;
+      for (const method of Object.keys(requirement.definition.auth)) {
+        const identity = interactiveOAuth(requirement.definition, method)?.identity;
+        if (identity !== undefined) return identity;
+      }
+    }
+  return undefined;
+};
