@@ -0,0 +1,131 @@
+import { Clock, Context, Effect, Redacted, Schema } from "effect";
+import {
+  AccountId,
+  OAuthGrant,
+  isFirstPartyGrant,
+  type Credentials,
+  type FirstPartyOAuthClient,
+} from "@executor-js/sdk/core";
+import type { OAuthProtocol } from "@executor-js/sdk/oauth-protocol-contracts";
+import type { Json } from "../contracts.ts";
+import {
+  GoogleIdentityRefused,
+  GoogleProof,
+  readGoogleAccount,
+  requireGoogleProof,
+} from "./google-identity-records.ts";
+
+/** The fixed operator route lends existing key custody and the issuer-validating OAuth wire client. */
+export class GoogleProofRuntime extends Context.Service<
+  GoogleProofRuntime,
+  {
+    readonly credentials: Pick<Credentials, "decrypt">;
+    readonly identify: OAuthProtocol["identify"];
+    readonly firstPartyClients: readonly FirstPartyOAuthClient[];
+  }
+>()("basalt/production-ops/GoogleProofRuntime") {}
+
+const Request = Schema.Struct({
+  organization: Schema.NonEmptyString,
+  accounts: Schema.Array(Schema.NonEmptyString).check(
+    Schema.isMinLength(1),
+    Schema.isMaxLength(50),
+  ),
+});
+
+/** Read-only proof preparation never renews tokens, records identities, or initializes the SDK. */
+export const prepareGoogleAccountProofs = (request: Json) =>
+  Effect.gen(function* () {
+    const input = yield* Schema.decodeUnknownEffect(Request)(request);
+    const runtime = yield* GoogleProofRuntime;
+    const now = yield* Clock.currentTimeMillis;
+    const observedAt = new Date(now).toISOString();
+    const proofs: (typeof GoogleProof.Type)[] = [];
+    const insufficientProof: { account: string; reason: string }[] = [];
+    const selected = [...new Set(input.accounts)].sort();
+    if (selected.length !== input.accounts.length)
+      return yield* new GoogleIdentityRefused({ reason: "duplicate-account-selection" });
+    for (const account of selected) {
+      const result = yield* Effect.gen(function* () {
+        const before = yield* readGoogleAccount(account);
+        if (before.organization !== input.organization)
+          return yield* new GoogleIdentityRefused({ reason: "account-outside-organization" });
+        const fields = yield* runtime.credentials.decrypt(
+          AccountId.make(before.grant),
+          Redacted.make(before.encrypted),
+        );
+        const grant = yield* Schema.decodeUnknownEffect(OAuthGrant)(Redacted.value(fields));
+        if (
+          grant.grant === "client_credentials" ||
+          (grant.expiresAt !== undefined && grant.expiresAt <= now)
+        )
+          return yield* new GoogleIdentityRefused({ reason: "reconnect-required" });
+        const token = grant.fields.access_token;
+        if (typeof token !== "string" || token.length === 0)
+          return yield* new GoogleIdentityRefused({ reason: "access-token-unavailable" });
+        const operator = isFirstPartyGrant(grant)
+          ? runtime.firstPartyClients.find((client) => client.id === grant.firstParty)
+          : undefined;
+        if (
+          isFirstPartyGrant(grant) &&
+          (operator === undefined || grant.authorizationClient !== operator.clientId)
+        )
+          return yield* new GoogleIdentityRefused({ reason: "client-unavailable" });
+        const server = isFirstPartyGrant(grant)
+          ? {
+              issuer: "https://accounts.google.com",
+              authorization_endpoint: operator!.server.authorizationUrl,
+              token_endpoint: operator!.server.tokenUrl,
+            }
+          : grant.server;
+        const skeleton = {
+          account,
+          owner: before.owner,
+          provider: before.provider,
+          method: before.method,
+          generation: before.generation,
+          placement: before.placement,
+          grantSha256: before.grantSha256,
+          issuer: "https://accounts.google.com" as const,
+          subject: "pending",
+          email: "pending@example.invalid",
+          observedAt,
+          evidence: {
+            kind: "issuer-pinned-userinfo" as const,
+            authorizationEndpoint: server.authorization_endpoint,
+            tokenEndpoint: server.token_endpoint,
+          },
+        };
+        yield* requireGoogleProof(before, skeleton, input.organization);
+        const verified = yield* runtime.identify(
+          { issuer: skeleton.issuer, name: "Google" },
+          server,
+          token,
+        );
+        if (
+          verified.issuer !== skeleton.issuer ||
+          (grant.identity !== undefined &&
+            (grant.identity.issuer !== verified.issuer ||
+              grant.identity.subject !== verified.subject))
+        )
+          return yield* new GoogleIdentityRefused({ reason: "identity-mismatch" });
+        const proof = yield* Schema.decodeUnknownEffect(GoogleProof)({
+          ...skeleton,
+          subject: verified.subject,
+          email: verified.label,
+        });
+        const after = yield* readGoogleAccount(account);
+        yield* requireGoogleProof(after, proof, input.organization);
+        return proof;
+      }).pipe(Effect.result);
+      if (result._tag === "Success") proofs.push(result.success);
+      else
+        insufficientProof.push({
+          account,
+          reason: Schema.is(GoogleIdentityRefused)(result.failure)
+            ? result.failure.reason
+            : "insufficient-proof",
+        });
+    }
+    return { organization: input.organization, proofs, insufficientProof };
+  });
