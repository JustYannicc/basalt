index 0000000..33dede1
--- /dev/null
+++ b/e2e/tests/google-identity-migration.spec.ts
@@ -0,0 +1,391 @@
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import type { TestContext } from "vitest";
+import {
+  createHash,
+  createHmac,
+  generateKeyPairSync,
+  privateDecrypt,
+  createDecipheriv,
+  constants,
+  randomUUID,
+} from "node:crypto";
+import { Api, body } from "../support/api.ts";
+import { Actors } from "../support/actors.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { cloudLocks } from "../support/cloud-locks.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { Target } from "../support/platform.ts";
+import { targetHosts } from "../support/role-hosts.ts";
+import { scenarios } from "../test-plan.ts";
+import { fixtureRequest } from "../sdk/fixtures.ts";
+
+const Artifact = Schema.Struct({
+  version: Schema.Literal(1),
+  sha256: Schema.String,
+  sealed: Schema.Struct({
+    version: Schema.Literal(1),
+    iv: Schema.String,
+    ciphertext: Schema.String,
+  }),
+  recipient: Schema.Struct({
+    version: Schema.Literal(1),
+    recipient: Schema.String,
+    wrappedKey: Schema.String,
+    iv: Schema.String,
+    ciphertext: Schema.String,
+  }),
+});
+const canonical = (value: unknown): string =>
+  JSON.stringify(value, (_key, item: unknown) =>
+    item !== null && typeof item === "object" && !Array.isArray(item)
+      ? Object.fromEntries(Object.entries(item).sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0)))
+      : item,
+  );
+const hash = (value: unknown) => createHash("sha256").update(canonical(value)).digest("hex");
+
+layer(HostedLive, { excludeTestServices: true })("Google recovery operations", (it) => {
+  const recovery = (context: TestContext, changedBinding: boolean) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          database = yield* cloudLocks;
+        const runtime = yield* Target;
+        const target = targetHosts(runtime).browser;
+        const organization = actors.organization.id,
+          owner = `organization:${organization}`;
+        const rows = (sql: string, params: readonly (string | number | null)[] = []) =>
+          database.run({ sql, params });
+        const ids = [`acc_${randomUUID()}`, `acc_${randomUUID()}`],
+          provider = `prv_${randomUUID()}`;
+        const session = yield* body(
+          Schema.Struct({ user: Schema.Struct({ id: Schema.String }) }),
+          yield* api.request(actors.owner, "GET", "/api/auth/get-session"),
+        );
+        const person = session.user.id;
+        const deployed = yield* api.request(
+          actors.owner,
+          "POST",
+          `/api/organizations/${organization}/apps/deploy`,
+          {
+            name: `Recovery ${randomUUID()}`,
+            files: [
+              appsManifest,
+              {
+                path: "index.ts",
+                content:
+                  'import { defineApp, router } from "apps"; export default defineApp({}, {tools:router({})});',
+              },
+            ],
+          },
+        );
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const app = (yield* body(Schema.Struct({ id: Schema.String }), deployed)).id;
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            for (const id of ids) {
+              yield* rows("delete from executor_accounts where id = $1", [id]);
+              yield* rows("delete from executor_oauth_grants where id = $1", [id]);
+            }
+            yield* rows(
+              "delete from executor_account_identities where owner = $1 and subject = $2",
+              [owner, `subject-${ids[0]}`],
+            );
+            yield* rows("delete from executor_providers where id = $1", [provider]);
+            yield* api.request(
+              actors.owner,
+              "DELETE",
+              `/api/organizations/${organization}/apps/${app}`,
+            );
+          }).pipe(Effect.orDie),
+        );
+        const authorizationEndpoint = "https://accounts.google.com/o/oauth2/v2/auth";
+        const tokenEndpoint = "https://oauth2.googleapis.com/token";
+        yield* rows("insert into executor_providers (id,definition) values ($1,$2::jsonb)", [
+          provider,
+          JSON.stringify({
+            name: "Google recovery fixture",
+            auth: {
+              oauth: {
+                type: "oauth2",
+                authorizationUrl: authorizationEndpoint,
+                tokenUrl: tokenEndpoint,
+                scopes: ["openid", "email"],
+                tokenEndpointAuthMethod: "none",
+                response: {
+                  type: "object",
+                  properties: { access_token: { type: "string" } },
+                  required: ["access_token"],
+                },
+              },
+            },
+          }),
+        ]);
+        for (const [index, id] of ids.entries()) {
+          yield* rows(
+            `insert into executor_accounts
+        (id,owner,provider,method,label,encrypted_credentials,created_at,credential_generation)
+        values ($1,$2,$3,'oauth',$4,decode('123456','hex'),now(),3)`,
+            [id, owner, provider, index === 0 ? "Default" : "My Google"],
+          );
+          yield* rows(
+            `insert into executor_oauth_grants (id,encrypted,status,updated_at,owner)
+        values ($1,decode('abcdef','hex'),'ready_fixture',now(),$2)`,
+            [id, owner],
+          );
+          yield* rows(
+            `insert into hosted_account_access (account_id,organization_id,creator_id,kind,personal_user_id)
+        values ($1,$2,$3,'personal',$3)`,
+            [id, organization, person],
+          );
+          yield* rows(
+            `insert into hosted_app_account_links (app,requirement,subject,account,linked_by)
+        values ($1,'service',$2,$3,$2)`,
+            [app, person, id],
+          );
+        }
+        const keypair = generateKeyPairSync("rsa", { modulusLength: 3072 });
+        const recipient = keypair.publicKey
+          .export({ type: "spki", format: "der" })
+          .toString("base64");
+        const operation = (
+          action: string,
+          selection: string,
+          request: unknown,
+          extra: object = {},
+        ) =>
+          Effect.gen(function* () {
+            const at = Date.now();
+            const payload = Buffer.from(
+              JSON.stringify({
+                version: 1,
+                id: randomUUID(),
+                target,
+                at,
+                expiresAt: at + 60000,
+                operation: { action, selection, request, recipient, ...extra },
+              }),
+            ).toString("base64url");
+            const signed = `sbops1.${payload}`;
+            const signature = createHmac("sha256", Buffer.from("ab".repeat(32), "hex"))
+              .update(signed)
+              .digest("base64url");
+            return yield* api.request(actors.owner, "POST", "/api/internal/production-ops", {
+              envelope: `${signed}.${signature}`,
+            });
+          });
+        const open = (artifact: typeof Artifact.Type) => {
+          const copy = artifact.recipient;
+          const key = privateDecrypt(
+            {
+              key: keypair.privateKey,
+              padding: constants.RSA_PKCS1_OAEP_PADDING,
+              oaepHash: "sha256",
+            },
+            Buffer.from(copy.wrappedKey, "base64"),
