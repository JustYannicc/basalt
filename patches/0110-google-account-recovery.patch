@@ -0,0 +1,236 @@
+import { Effect, Schema } from "effect";
+import { ProviderDefinition } from "@executor-js/sdk/core";
+import { SqlClient } from "effect/sql";
+import type { Json } from "../contracts.ts";
+
+export class GoogleIdentityRefused extends Schema.TaggedError<GoogleIdentityRefused>()(
+  "GoogleIdentityRefused",
+  { reason: Schema.String },
+) {}
+
+export const GoogleProof = Schema.Struct({
+  account: Schema.NonEmptyString,
+  owner: Schema.NonEmptyString,
+  provider: Schema.NonEmptyString,
+  method: Schema.NonEmptyString,
+  generation: Schema.Int,
+  placement: Schema.NonEmptyString,
+  grantSha256: Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/u)),
+  issuer: Schema.Literal("https://accounts.google.com"),
+  subject: Schema.NonEmptyString,
+  email: Schema.String.check(Schema.isPattern(/^[^\s@]+@[^\s@]+\.[^\s@]+$/u)),
+  observedAt: Schema.String,
+  evidence: Schema.Struct({
+    kind: Schema.Literal("issuer-pinned-userinfo"),
+    authorizationEndpoint: Schema.String,
+    tokenEndpoint: Schema.String,
+  }),
+});
+
+export const GoogleMigrationRequest = Schema.Struct({
+  organization: Schema.NonEmptyString,
+  proofs: Schema.Array(GoogleProof).check(Schema.isMinLength(1), Schema.isMaxLength(50)),
+});
+
+const AccountRow = Schema.Struct({
+  account: Schema.NonEmptyString,
+  owner: Schema.String,
+  provider: Schema.String,
+  method: Schema.String,
+  label: Schema.String,
+  description: Schema.NullOr(Schema.String),
+  site: Schema.NullOr(Schema.String),
+  createdAt: Schema.String,
+  grantReference: Schema.NullOr(Schema.String),
+  generation: Schema.Int,
+  identity: Schema.NullOr(Schema.String),
+  organization: Schema.String,
+  kind: Schema.String,
+  person: Schema.NullOr(Schema.String),
+  audience: Schema.NullOr(Schema.String),
+  revision: Schema.String,
+  definition: Schema.Unknown,
+  grant: Schema.String,
+  grantStatus: Schema.String,
+  grantOwner: Schema.NullOr(Schema.String),
+  grantUpdatedAt: Schema.String,
+  encrypted: Schema.Uint8Array,
+  credentials: Schema.Uint8Array,
+});
+
+const sortedJson = (value: Json): string => {
+  if (Array.isArray(value)) return `[${value.map(sortedJson).join(",")}]`;
+  if (value !== null && typeof value === "object")
+    return `{${Object.entries(value)
+      .sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0))
+      .map(([key, item]) => `${JSON.stringify(key)}:${sortedJson(item)}`)
+      .join(",")}}`;
+  return JSON.stringify(value);
+};
+
+export const sha256 = (value: Json) =>
+  Effect.promise(async () => {
+    const digest = await crypto.subtle.digest(
+      "SHA-256",
+      new TextEncoder().encode(sortedJson(value)),
+    );
+    return Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, "0")).join(
+      "",
+    );
+  });
+
+const bytes = (value: Uint8Array) =>
+  Array.from(value, (byte) => byte.toString(16).padStart(2, "0")).join("");
+
+/** The grant and access revision are read again after UserInfo; network I/O holds no SQL locks. */
+export const readGoogleAccount = (account: string, lock = false) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    const rows = yield* sql.unsafe(
+      `select a.id as account, a.owner, a.provider, a.method, a.label, a.description, a.site,
+    to_char(a.created_at at time zone 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.US"Z"') as "createdAt",
+    a.oauth_grant_id as "grantReference",
+    a.credential_generation as generation, a.identity_id as identity,
+    h.organization_id as organization, h.kind, h.personal_user_id as person, h.audience,
+    h.revision, p.definition, g.id as grant, g.status as "grantStatus", g.owner as "grantOwner",
+    to_char(g.updated_at at time zone 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.US"Z"') as "grantUpdatedAt", g.encrypted,
+    a.encrypted_credentials as credentials
+    from executor_accounts a join executor_providers p on p.id = a.provider
+    join hosted_account_access h on h.account_id = a.id
+    join executor_oauth_grants g on g.id = coalesce(a.oauth_grant_id, a.id)
+    where a.id = $1${lock ? " for update of a, g for share of h, p" : ""}`,
+      [account],
+    );
+    const decoded = yield* Schema.decodeUnknownEffect(Schema.Array(AccountRow))(rows);
+    const row = decoded[0];
+    if (decoded.length !== 1 || row === undefined || !row.grantStatus.startsWith("ready_"))
+      return yield* new GoogleIdentityRefused({ reason: "account-or-grant-unavailable" });
+    const groups = yield* sql.unsafe(
+      `select group_id from hosted_account_groups
+    where account_id = $1 order by group_id${lock ? " for share" : ""}`,
+      [account],
+    );
+    const memberships = yield* Schema.decodeUnknownEffect(
+      Schema.Array(Schema.Struct({ group_id: Schema.String })),
+    )(groups);
+    const placement = JSON.stringify([
+      row.organization,
+      row.kind,
+      row.person,
+      row.audience,
+      memberships.map((group) => group.group_id),
+    ]);
+    const grantSha256 = yield* sha256([
+      row.account,
+      row.owner,
+      row.provider,
+      row.method,
+      row.generation,
+      placement,
+      row.revision,
+      row.grant,
+      row.grantStatus,
+      row.grantOwner,
+      row.grantUpdatedAt,
+      bytes(row.encrypted),
+    ]);
+    const credentialsSha256 = yield* sha256(bytes(row.credentials));
+    const links =
+      yield* sql`select app, requirement, subject, linked_by from hosted_app_account_links
+    where account = ${account} order by app, requirement, subject nulls first`;
+    const linked = yield* Schema.decodeUnknownEffect(
+      Schema.Array(
+        Schema.Struct({
+          app: Schema.String,
+          requirement: Schema.String,
+          subject: Schema.NullOr(Schema.String),
+          linked_by: Schema.NullOr(Schema.String),
+        }),
+      ),
+    )(links);
+    return {
+      ...row,
+      placement,
+      grantSha256,
+      credentialsSha256,
+      linksSha256: yield* sha256(linked),
+    };
+  });
+
+export type GoogleAccountSnapshot = Effect.Success<ReturnType<typeof readGoogleAccount>>;
+
+export const accountHash = (
+  row: GoogleAccountSnapshot,
+  identity = row.identity,
+  label = row.label,
+) =>
+  sha256([
+    row.account,
+    row.owner,
+    row.provider,
+    row.method,
+    row.generation,
+    identity,
+    label,
+    row.description,
+    row.site,
+    row.createdAt,
+    row.grantReference,
+    row.placement,
+    row.revision,
+    row.grantSha256,
+    row.credentialsSha256,
+    row.linksSha256,
+  ]);
+
+export const googleIdentityId = (proof: typeof GoogleProof.Type) =>
+  sha256([proof.owner, proof.placement, proof.issuer, proof.subject]).pipe(
+    Effect.map((digest) => `aid_${digest}`),
+  );
+
+export const requireGoogleProof = (
+  row: GoogleAccountSnapshot,
+  proof: typeof GoogleProof.Type,
+  organization: string,
+) =>
+  Effect.gen(function* () {
+    const definition = yield* Schema.decodeUnknownEffect(ProviderDefinition)(row.definition);
+    const method = definition.auth[row.method];
+    if (
+      method?.type !== "oauth2" ||
+      method.grant === "client_credentials" ||
+      (method.identity !== undefined && method.identity.issuer !== proof.issuer) ||
+      (method.discover === undefined
+        ? method.authorizationUrl !== proof.evidence.authorizationEndpoint ||
+          method.tokenUrl !== proof.evidence.tokenEndpoint
+        : ![
+            proof.issuer,
+            proof.issuer + "/",
+            proof.issuer + "/.well-known/openid-configuration",
+          ].includes(method.discover))
+    )
+      return yield* new GoogleIdentityRefused({ reason: "provider-not-google" });
+    const observed = Date.parse(proof.observedAt);
+    if (
+      !(
+        row.organization === organization &&
+        row.owner === proof.owner &&
+        row.provider === proof.provider &&
+        row.method === proof.method &&
+        row.generation === proof.generation &&
+        row.placement === proof.placement &&
+        row.grantSha256 === proof.grantSha256 &&
+        Number.isFinite(observed) &&
+        new Date(observed).toISOString() === proof.observedAt &&
+        [
+          "https://accounts.google.com/o/oauth2/v2/auth",
+          "https://accounts.google.com/o/oauth2/auth",
+        ].includes(proof.evidence.authorizationEndpoint) &&
+        [
+          "https://oauth2.googleapis.com/token",
+          "https://accounts.google.com/o/oauth2/token",
+        ].includes(proof.evidence.tokenEndpoint)
+      )
+    )
+      return yield* new GoogleIdentityRefused({ reason: "prepared-proof-changed" });
+  });
