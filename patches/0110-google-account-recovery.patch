+/** Repeat the same identity consent through normal validation; nothing changes until it succeeds. */
+function GrantAccessAgain({
+  saved,
+  consent,
+}: {
+  readonly saved: typeof OAuthReturn.Type;
+  readonly consent: OAuthConsentRetry;
+}) {
+  const navigate = useNavigate();
+  const [atoms] = useState(() =>
+    identityConsentAtoms({
+      app: saved.app,
+      scope: consent.scope,
+      requirement: consent.requirement,
+    }),
+  );
+  const start = useAtomSet(atoms.start, { mode: "promiseExit" });
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<Cause.Cause<Atom.Failure<typeof atoms.start>>>();
+  return (
+    <div className="mt-3 flex flex-col items-start gap-2">
+      <Button
+        size="sm"
+        disabled={busy}
+        loading={busy}
