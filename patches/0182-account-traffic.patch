+        );
+        expect(details).toMatch(
+          /^Requests: 41 in 7 days · 92\.6% succeeded · last success 1[23] min ago · counted by Traffic pool$/,
+        );
+
+        const phone = yield* browser.use("Read the rows at 390px", (page) =>
+          page
+            .setViewportSize({ width: 390, height: 900 })
+            .then(() => page.goto(accounts))
+            .then(() => ready(page))
+            .then(() =>
+              Promise.all([
+                page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth),
+                accountRow(page, "Traffic account")
+                  .locator("[data-account-requests]")
+                  .getAttribute("data-account-requests"),
+                accountRow(page, "Traffic account").locator("[data-requests-unit]").isVisible(),
+              ]),
+            ),
+        );
+        expect(phone[0], "no horizontal scroll at 390px").toBe(true);
+        // The column header is hidden here, so the count says what it counts.
+        expect(phone[1]).toBe("41");
+        expect(phone[2], "the count reads 41 req on a phone").toBe(true);
+
+        // Once the pool can't map any request, no row has numbers: the column and the ticks go,
+        // rather than leaving a column of blank cells. The next 30-second poll reads it.
+        yield* pool.respond(answer(ids, false));
+        const hidden = yield* browser.use("Wait for the Requests column to go", (page) =>
+          page
+            .setViewportSize({ width: 1280, height: 900 })
+            .then(() =>
+              page
+                .locator("[data-requests-header]")
+                .waitFor({ state: "detached", timeout: 45_000 }),
+            )
+            .then(() =>
+              Promise.all([
+                page.locator("[data-account-requests]").count(),
+                page.locator('[data-health-state="traffic"]').count(),
+                accountRow(page, "Traffic account")
+                  .locator('[data-health-state="healthy"]')
+                  .count(),
+              ]),
+            ),
+        );
+        expect(hidden).toEqual([0, 0, 1]);
+      }),
+    ),
+  );
+});
