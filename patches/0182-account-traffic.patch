@@ -0,0 +1,597 @@
+/** Account rows show what the account's pool counted, and nothing it can't attribute. */
+import { expect, layer } from "@effect/vitest";
+import { Effect, Schema } from "effect";
+import type { Page } from "playwright";
+import { body } from "../support/api.ts";
+import { connectionsPath } from "../support/app-accounts.ts";
+import { appsManifest } from "../support/apps-release.ts";
+import { Resource } from "../support/contracts.ts";
+import { Browser } from "../support/browser.ts";
+import { Evidence } from "../support/evidence.ts";
+import { HostedLive, withHostedCase } from "../support/case.ts";
+import { Actors } from "../support/actors.ts";
+import { Api } from "../support/api.ts";
+import {
+  observationBackend,
+  observationFixture,
+  observationSource,
+  observationToken,
+} from "../support/account-observation-fixture.ts";
+import { accountRow, openRowMenu } from "../support/account-rows.ts";
+import { legacyStorage } from "../support/legacy-storage.ts";
+import {
+  poolUsageSeriesBackend,
+  type SeriesAssertion,
+} from "../support/pool-usage-series-backend.ts";
+import { serverControl } from "../support/server-control.ts";
+import { scenarios } from "../test-plan.ts";
+
+const hour = 3_600_000;
+const day = 24 * hour;
+
+/** A full series bucket, as the pool sends one for an account the caller may inspect. */
+const bucket = (
+  at: number,
+  requests: number,
+  failed: number,
+  total = { sum: null as string | null, known: 0, missing: requests },
+) => {
+  const token = { sum: null, known: 0, missing: requests };
+  const none = { amount: null, currency: null, priced: 0, unpriced: requests };
+  return {
+    at: new Date(at).toISOString(),
+    partial: false,
+    requests,
+    failed,
+    unassignedFailures: 0,
+    successRate: requests === 0 ? null : (requests - failed) / requests,
+    lastSuccessAtInRange: null,
+    tokens: {
+      input: token,
+      output: token,
+      cacheRead: token,
+      cacheWrite: token,
+      reasoning: token,
+      total,
+    },
+    tokenQuality: { complete: 0, legacy: 0, unclassified: requests, inconsistent: 0 },
+    cost: {
+      homeCharge: none,
+      importedApiPrice: none,
+      apiEquivalent: { status: "unavailable", reason: "No API price provenance." },
+      unpricedRequests: requests,
+    },
+    attribution: { chargeSnapshot: 0, keyAtCapture: 0, importOwner: 0, unknown: requests },
+  };
+};
+
+const SeriesInput = Schema.Struct({
+  from: Schema.String,
+  to: Schema.String,
+  bucket: Schema.Literals(["hour", "day"]),
+  accounts: Schema.optional(Schema.Array(Schema.String)),
+});
+
+/** The pool accounts by role; the series names each by its saved account ID. */
+interface Ids {
+  readonly traffic: string;
+  readonly steady: string;
+  readonly rejected: string;
+  readonly idle: string;
+}
+
+/**
+ * The traffic account made 41 requests in 7 days, 3 of them failed (92.6%). In the last hours it
+ * succeeded now and three hours ago and failed an hour ago, and its weekly window counted at least
+ * 1.2M tokens, one request without a count. The steady account succeeded 199 of 200 (99.5%), the
+ * rejected one 10 of 10, and the idle one last succeeded 3 days ago. The fifth account's requests
+ * are only other accounts' counts. Without `proven`, the pool can't map any request to an account.
+ */
+const answer =
+  (ids: Ids, proven = true) =>
+  (assertion: SeriesAssertion) => {
+    const unavailable = { status: "unavailable", reason: "Synthetic." };
+    const mapping = {
+      current: true,
+      historicalGenerations: "unknown",
+      proof: proven ? "proven" : "unavailable",
+    };
+    if (assertion.action === "lastSuccessAt") {
+      const { accounts } = Schema.decodeUnknownSync(
+        Schema.Struct({ accounts: Schema.Array(Schema.String) }),
+      )(assertion.input);
+      const ago = {
+        [ids.traffic]: 12 * 60_000,
+        [ids.steady]: 5 * 60_000,
+        [ids.rejected]: 2 * hour,
+        [ids.idle]: 3 * day,
+      };
+      return {
+        asOf: new Date().toISOString(),
+        mapping,
+        accounts: accounts.map((account) => ({
+          account,
+          lastSuccessAt:
+            ago[account] === undefined ? null : new Date(Date.now() - ago[account]).toISOString(),
+        })),
+      };
+    }
+    const input = Schema.decodeUnknownSync(SeriesInput)(assertion.input);
+    const from = Date.parse(input.from);
+    const to = Date.parse(input.to);
+    const current = Math.floor(to / hour) * hour;
+    const week = input.bucket === "day" && to - from > 6 * day;
+    const named = (account: string) =>
+      input.accounts === undefined || input.accounts.includes(account);
+    const all = !proven
+      ? []
+      : input.bucket === "hour"
+        ? [
+            {
+              key: { currency: null, account: ids.traffic },
+              buckets: [
+                bucket(current - 3 * hour, 2, 0),
+                bucket(current - hour, 4, 1),
+                bucket(current, 5, 0),
+              ],
+            },
+            { key: { currency: null, account: ids.steady }, buckets: [bucket(current, 20, 0)] },
+            { key: { currency: null, account: ids.rejected }, buckets: [bucket(current, 1, 0)] },
+          ]
+        : week
+          ? [
+              {
+                key: { currency: null, account: ids.traffic },
+                buckets: [bucket(to - 2 * day, 30, 1), bucket(to - day, 11, 2)],
+              },
+              { key: { currency: null, account: ids.steady }, buckets: [bucket(to - day, 200, 1)] },
+              {
+                key: { currency: null, account: ids.rejected },
+                buckets: [bucket(to - day, 10, 0)],
+              },
+            ]
+          : [
+              {
+                key: { currency: null, account: ids.traffic },
+                buckets: [bucket(from, 41, 3, { sum: "1234567", known: 40, missing: 1 })],
+              },
+            ];
+    // Only an unfiltered read carries other accounts' counts.
+    const others =
+      proven && week && input.accounts === undefined
+        ? [
+            {
+              key: { currency: null, account: "otherAccounts" },
+              buckets: [
+                {
+                  at: new Date(to - day).toISOString(),
+                  partial: false,
+                  requests: 9,
+                  failed: 4,
+                  unassignedFailures: 0,
+                  successRate: 5 / 9,
+                },
+              ],
+            },
+          ]
+        : [];
+    return {
+      from: input.from,
+      to: input.to,
+      bucket: input.bucket,
+      asOf: new Date().toISOString(),
+      coverage: {
+        sources: [],
+        firstAt: null,
+        lastAt: null,
+        capturedThrough: null,
+        mapping: { ...mapping, mapped: 251, unmapped: 0, otherAccounts: 9 },
+        pricing: {
+          homeCharge: 0,
+          importedApiPrice: 0,
+          unpriced: 260,
+          missing: 0,
+          missingSnapshot: 0,
+          missingVersion: 0,
+          apiEquivalent: unavailable,
+        },
+        priceProjection: unavailable,
+        percentiles: unavailable,
+        seasonalTrainingRange: unavailable,
+      },
+      groups: [...all.filter((group) => named(group.key.account)), ...others],
+      next: null,
+    };
+  };
+
+/** A weekly window that started a day ago, so its tokens are read over exactly that day. */
+const weekly = (at = new Date().toISOString()) => ({
+  observedAt: at,
+  observation: {
+    offering: "subscription",
+    plan: { label: "Pro", observedAt: at },
+    windows: [
+      {
+        id: "seven_day",
+        label: "Weekly",
+        observedAt: at,
+        measure: { unit: "percent", used: 11, limit: 100, remainingRatio: 0.89 },
+        period: { mode: "fixed", seconds: 7 * 86_400 },
+        resetsAt: new Date(Date.parse(at) + 6 * day).toISOString(),
+      },
+    ],
+    balances: [],
+  },
+});
+
+const cells = (page: Page, label: string) => {
+  const row = accountRow(page, label);
+  return Promise.all([
+    row.locator("[data-account-requests]").count(),
+    row.locator('[data-health-state="traffic"]').count(),
+    row.locator("[data-window-tokens]").count(),
+  ]);
+};
+
+layer(HostedLive, { excludeTestServices: true })("Account traffic", (it) => {
+  it.effect(scenarios.accountTraffic.title, (context) =>
+    withHostedCase(
+      context,
+      Effect.gen(function* () {
+        const api = yield* Api,
+          actors = yield* Actors,
+          browser = yield* Browser,
+          evidence = yield* Evidence,
+          observed = yield* observationBackend,
+          pool = yield* poolUsageSeriesBackend;
+        const prefix = `/api/organizations/${actors.organization.id}`;
+        // A connector outside any pool keeps its sign-in health and gets no Requests value.
+        const connector = yield* observationFixture({
+          name: "Traffic connector",
+          observe: false,
+          health: true,
+        });
+        expect(
+          (yield* api.request(actors.owner, "PATCH", connector.accountPath, {
+            label: "Connector mail",
+          })).status,
+        ).toBe(200);
+        expect((yield* connector.check()).status).toBe(200);
+
+        // The pool app: two accounts linked for everyone who uses it.
+        const deployed = yield* api.request(actors.owner, "POST", `${prefix}/apps/deploy`, {
+          name: "Traffic pool",
+          files: [
+            {
+              path: "index.ts",
+              content: observationSource(observed.origin, { observe: true, health: true }).replace(
+                "{ user:{accounts:{service}} }",
+                "{ app:{accounts:{service:service.many()}} }",
+              ),
+            },
