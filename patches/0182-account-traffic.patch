+/** The Accounts list's pool traffic: Requests 7d, the Health ticks and usage cell token counts. */
+import { useAtomValue } from "@effect/atom-react";
+import { Option } from "effect";
+import { AsyncResult } from "effect/reactivity";
+import { useMemo, type ReactNode } from "react";
+import type { AccountId, AppId } from "@executor-js/sdk";
+import type { OrganizationReference } from "@executor-js/hosted-server/organization";
+import type { AccountSummary } from "@executor-js/ui/contracts/dashboard";
+import { useDisplayFormat } from "@executor-js/ui/hooks/display-format";
+import {
+  WindowTokensFooter,
+  mergeTokens,
+  mergeTraffic,
+  windowStart,
+  type AccountRowTraffic,
+} from "@executor-js/ui/dashboard/account-traffic";
+import {
+  accountTrafficAtom,
+  windowNeedsAtom,
+  windowTokensAtom,
+  windowTokensKey,
+} from "../../contracts/pool-usage-series.ts";
+
+type Window = Parameters<typeof windowStart>[0];
+
+/** Saved-account rows as the list reads them: only pool links carry traffic. */
+type Rows = readonly {
+  readonly id: AccountId;
+  readonly bindings: readonly { readonly pool?: AppId | undefined }[];
+}[];
+
+/**
+ * One batched, polled read for every visible pool account. App (connector) accounts have no pool
+ * link, so they get no Requests value and keep their sign-in health.
+ */
+export function useAccountTraffic(
+  organization: OrganizationReference,
+  rows: Rows | undefined,
+  poolName: (pool: AppId) => string,
+) {
+  const format = useDisplayFormat();
+  const accountPools = useMemo(() => {
+    const pools = new Map<AccountId, AppId[]>();
+    for (const row of rows ?? [])
+      for (const { pool } of row.bindings)
+        if (pool !== undefined && !(pools.get(row.id) ?? []).includes(pool))
+          pools.set(row.id, [...(pools.get(row.id) ?? []), pool].sort());
+    return pools;
+  }, [rows]);
+  const trafficKey = useMemo(() => {
+    const members = new Map<AppId, AccountId[]>();
+    for (const [account, pools] of accountPools)
+      for (const pool of pools) members.set(pool, [...(members.get(pool) ?? []), account]);
+    return {
+      organization,
+      pools: [...members]
+        .sort(([a], [b]) => a.localeCompare(b))
+        .map(([pool, accounts]) => ({ pool, accounts: accounts.sort() })),
+    };
+  }, [organization, accountPools]);
+  const counted = Option.getOrUndefined(
+    AsyncResult.value(useAtomValue(accountTrafficAtom(trafficKey))),
+  );
+  // Token reads only for accounts the series named, in the pools that named them.
+  const named = useMemo(
+    () => ({
+      organization,
+      accounts: [...accountPools]
+        .map(([account, pools]) => ({
+          account,
+          pools: pools.filter((pool) => counted?.get(pool)?.traffic.has(account) === true),
+        }))
+        .filter((entry) => entry.pools.length > 0)
+        .sort((a, b) => a.account.localeCompare(b.account)),
+    }),
+    [organization, accountPools, counted],
+  );
+  const needs = useAtomValue(windowNeedsAtom(named));
+  const tokens = Option.getOrUndefined(AsyncResult.value(useAtomValue(windowTokensAtom(needs))));
+
+  // Callers who may read no visible pool's series get no Requests column at all, rather than a
+  // column of blank cells; it appears once a read answers.
+  const readable = counted !== undefined && [...counted.values()].some((pool) => pool.readable);
+  const traffic = readable
+    ? (accounts: readonly AccountSummary[]): AccountRowTraffic | undefined =>
+        mergeTraffic(
+          accounts.flatMap((account) =>
+            (accountPools.get(account.id) ?? []).map((pool) => {
+              const entry = counted.get(pool)?.traffic.get(account.id);
+              return entry === undefined ? undefined : { ...entry, gateways: [poolName(pool)] };
+            }),
+          ),
+        )
+    : undefined;
+  const windowTokens =
+    (account: AccountSummary) =>
+    (entry: Window): ReactNode => {
+      const start = windowStart(entry, Date.now());
+      if (start === undefined || tokens === undefined) return undefined;
+      const merged = mergeTokens(
+        (accountPools.get(account.id) ?? []).map((pool) => {
+          const value = tokens.get(windowTokensKey(pool, account.id, start));
+          return value === undefined ? undefined : { ...value, gateways: [poolName(pool)] };
+        }),
+      );
+      // Nothing true to show when no counted request reported tokens.
+      if (merged === undefined || (merged.total === null && merged.missing > 0)) return undefined;
+      return (
+        <WindowTokensFooter
+          tokens={merged}
+          provider={account.providerName ?? account.identity?.name}
+          format={format}
+        />
+      );
+    };
+  return { traffic, windowTokens };
+}
