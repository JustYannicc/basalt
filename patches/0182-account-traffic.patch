diff --git a/packages/ui/src/implementation/dashboard/account-traffic.tsx b/packages/ui/src/implementation/dashboard/account-traffic.tsx
new file mode 100644
index 0000000..0956ae2
--- /dev/null
+++ b/packages/ui/src/implementation/dashboard/account-traffic.tsx
@@ -0,0 +1,285 @@
+/**
+ * What the gateway that carries an account's requests counted: the Requests 7d cell, the Health
+ * column's recent ticks and 7-day success share, and the token count under a usage cell. Hosts
+ * pass only counts their source attributes to the account; an account the caller can't inspect,
+ * or one its source can't map, gets no traffic at all rather than zeros.
+ */
+import type { AccountObservationRecord } from "@executor-js/sdk";
+import type { DisplayFormat } from "../../contracts/display.ts";
+import { cn } from "../lib/utils.ts";
+import { age } from "./account-observation-format.ts";
+
+type Window = NonNullable<AccountObservationRecord["result"]>["observation"]["windows"][number];
+
+/** One recent bucket: any failure is bad, requests without one are good, no requests is none. */
+export type TrafficTick = "good" | "bad" | "none";
+
+/** An account's requests as its gateways counted them. */
+export interface AccountRowTraffic {
+  /** Requests in the last 7 days. */
+  readonly requests: number;
+  readonly failed: number;
+  /** The last hours, oldest first; the newest is the current, partial hour. */
+  readonly ticks: readonly TrafficTick[];
+  /** The latest successful request; null when none is recorded, undefined when unread. */
+  readonly lastSuccessAt: string | null | undefined;
+  /** The gateways that counted, such as the pool's name. */
+  readonly gateways: readonly string[];
+}
+
+/** Tokens a gateway counted in one usage window. `missing` requests reported no token count. */
+export interface WindowTokens {
+  readonly total: number | null;
+  readonly known: number;
+  readonly missing: number;
+  readonly gateways: readonly string[];
+}
+
+/** Several accounts or gateways as one: counts add up, a bad tick wins, the latest success wins. */
+export const mergeTraffic = (
+  entries: readonly (AccountRowTraffic | undefined)[],
+): AccountRowTraffic | undefined => {
+  const present = entries.filter((entry) => entry !== undefined);
+  const [first, ...rest] = present;
+  if (first === undefined) return undefined;
+  return rest.reduce<AccountRowTraffic>(
+    (sum, next) => ({
+      requests: sum.requests + next.requests,
+      failed: sum.failed + next.failed,
+      ticks: sum.ticks.map((tick, index) => {
+        const other = next.ticks[index] ?? "none";
+        return tick === "bad" || other === "bad" ? "bad" : tick === "good" ? tick : other;
+      }),
+      lastSuccessAt: latest(sum.lastSuccessAt, next.lastSuccessAt),
+      gateways: [...new Set([...sum.gateways, ...next.gateways])],
+    }),
+    first,
+  );
+};
+
+const latest = (a: string | null | undefined, b: string | null | undefined) =>
+  a === undefined || b === undefined
+    ? (a ?? b)
+    : a === null || (b !== null && Date.parse(b) > Date.parse(a))
+      ? b
+      : a;
+
+/** Tokens from several gateways as one; a missing count on any side stays missing. */
+export const mergeTokens = (
+  entries: readonly (WindowTokens | undefined)[],
+): WindowTokens | undefined => {
+  const present = entries.filter((entry) => entry !== undefined);
+  if (present.length === 0) return undefined;
+  return {
+    total: present.some((entry) => entry.total !== null)
+      ? present.reduce((sum, entry) => sum + (entry.total ?? 0), 0)
+      : null,
+    known: present.reduce((sum, entry) => sum + entry.known, 0),
+    missing: present.reduce((sum, entry) => sum + entry.missing, 0),
+    gateways: [...new Set(present.flatMap((entry) => entry.gateways))],
+  };
+};
+
+/**
+ * Where a window's current period began, only when the source says so exactly: its stated start,
+ * or a fixed period's reset minus its length. Rolling windows and passed resets have none.
+ */
+export const windowStart = (entry: Window, now: number): string | undefined => {
+  const period = entry.period;
+  const reset = entry.resetsAt === undefined ? undefined : Date.parse(entry.resetsAt);
+  const start =
+    period?.startsAt !== undefined
+      ? Date.parse(period.startsAt)
+      : period?.mode === "fixed" &&
+          period.seconds !== undefined &&
+          reset !== undefined &&
+          reset > now
+        ? reset - period.seconds * 1000
+        : undefined;
+  return start === undefined || !Number.isFinite(start) || start >= now
+    ? undefined
+    : new Date(start).toISOString();
+};
+
+/** The 7-day success share, or null without requests. */
+export const successShare = (traffic: AccountRowTraffic) =>
+  traffic.requests === 0 ? null : (traffic.requests - traffic.failed) / traffic.requests;
+
+/** Below this share the percentage turns amber. */
+const healthyShare = 0.95;
+
+/** Truncated, never rounded up: one failure in thousands never reads as 100%. */
+const percent = (share: number, format: DisplayFormat) =>
+  `${new Intl.NumberFormat(format.locale, { maximumFractionDigits: 1 }).format(
+    Math.floor(share * 1000) / 10,
+  )}%`;
+
+const via = (gateways: readonly string[]) =>
+  gateways.length === 0 ? "" : `, counted by ${gateways.join(" and ")}`;
+
+const lastSuccess = (traffic: AccountRowTraffic, now: number) =>
+  traffic.lastSuccessAt === undefined
+    ? undefined
+    : traffic.lastSuccessAt === null
+      ? "no successful request recorded"
+      : `last success ${age(traffic.lastSuccessAt, now)}`;
+
+/** The Requests 7d cell: the count, muted at zero, with " req" where the column header is hidden. */
+export function AccountRequestsCell({
+  traffic,
+  now,
+  format,
+}: {
+  readonly traffic: AccountRowTraffic;
+  readonly now: number;
+  readonly format: DisplayFormat;
+}) {
+  const count = new Intl.NumberFormat(format.locale).format(traffic.requests);
+  const success = lastSuccess(traffic, now);
+  const title =
+    traffic.requests === 0
+      ? `No requests in the last 7 days${via(traffic.gateways)}${success === undefined ? "" : ` · ${success}`}`
+      : `${count} requests in the last 7 days${via(traffic.gateways)}`;
+  return (
+    <span
+      className={cn(
+        "text-[13px] whitespace-nowrap tabular-nums @max-[640px]/account-rows:text-[12px]",
+        traffic.requests === 0 && "text-muted-foreground",
+      )}
+      title={title}
+      data-account-requests={traffic.requests}
+      suppressHydrationWarning
+    >
+      <span className={traffic.requests === 0 ? undefined : "font-medium"}>{count}</span>
+      <span
+        className="hidden text-muted-foreground @max-[640px]/account-rows:inline"
+        data-requests-unit
+      >
+        {" req"}
+      </span>
+      <span className="sr-only"> requests in the last 7 days</span>
+    </span>
+  );
+}
+
+const tickColors = { good: "bg-emerald-500", bad: "bg-destructive", none: "bg-border" };
+
+/**
+ * The Health column while the account has requests: one tick per recent hour and the 7-day success
+ * share, amber below 95%. `check` adds the sign-in check that traffic took precedence over.
+ */
+export function TrafficHealth({
+  traffic,
+  check,
+  now,
+  format,
+}: {
+  readonly traffic: AccountRowTraffic;
+  readonly check?: string | undefined;
+  readonly now: number;
+  readonly format: DisplayFormat;
+}) {
+  const share = successShare(traffic) ?? 1;
+  const shown = percent(share, format);
+  const success = lastSuccess(traffic, now);
+  const title = [
+    `${new Intl.NumberFormat(format.locale).format(traffic.requests)} requests in 7 days`,
+    `${shown} succeeded`,
+    success,
+  ]
+    .filter((part) => part !== undefined)
+    .join(" · ");
+  return (
+    <span
+      className="inline-flex min-w-0 items-center gap-1.5 text-[13px] whitespace-nowrap text-muted-foreground @max-[640px]/account-rows:text-[12px]"
+      title={`${title}${via(traffic.gateways)}${check === undefined ? "" : `\n${check}`}`}
+      data-account-health-cell
+      data-health-state="traffic"
+      data-ticks={traffic.ticks.map((tick) => tick[0]).join("")}
+      suppressHydrationWarning
+    >
+      <span aria-hidden className="inline-flex h-3 items-center gap-0.5">
+        {traffic.ticks.map((tick, index) => (
+          <span
+            // Position is the identity: each tick is one hour back from now.
+            key={index}
+            className={cn("h-3 w-[3px] rounded-[1px]", tickColors[tick])}
+            data-tick={tick}
+          />
+        ))}
+      </span>
+      <span
+        className={cn(
+          "font-medium tabular-nums",
+          share < healthyShare ? "text-amber-700 dark:text-amber-400" : "text-foreground",
+        )}
+        data-success-share={shown}
+      >
+        {shown}
+      </span>
+      <span className="sr-only"> of requests succeeded in the last 7 days</span>
+    </span>
+  );
+}
+
+/** Details' Requests line, in the same words as the cells' tooltips. */
+export const trafficSummary = (traffic: AccountRowTraffic, now: number, format: DisplayFormat) => {
+  const share = successShare(traffic);
+  const success = lastSuccess(traffic, now);
+  return [
+    traffic.requests === 0
+      ? "None in 7 days"
+      : `${new Intl.NumberFormat(format.locale).format(traffic.requests)} in 7 days`,
+    share === null ? undefined : `${percent(share, format)} succeeded`,
+    success,
+    traffic.gateways.length === 0 ? undefined : `counted by ${traffic.gateways.join(" and ")}`,
+  ]
+    .filter((part) => part !== undefined)
+    .join(" · ");
+};
+
+/**
+ * The left of a usage cell's footer: tokens the gateway counted in that window, never a provider
+ * figure. A total with uncounted requests is a floor, marked "≥"; with no counted request at all
+ * there is nothing true to show. Cost stays out until an API-equivalent price is proven.
+ */
+export function WindowTokensFooter({
+  tokens,
+  provider,
+  format,
+}: {
+  readonly tokens: WindowTokens;
+  readonly provider: string | undefined;
+  readonly format: DisplayFormat;
+}) {
+  if (tokens.total === null && tokens.missing > 0) return null;
+  const total = tokens.total ?? 0;
+  const floor = tokens.missing > 0;
+  const figure = new Intl.NumberFormat(format.locale, {
+    notation: "compact",
+    maximumFractionDigits: 1,
+  }).format(total);
+  const requests = tokens.known + tokens.missing;
+  const title = [
+    `Counted by ${tokens.gateways.join(" and ") || "the gateway"} from its own requests in this window${provider === undefined ? "" : `, not reported by ${provider}`}.`,
+    floor
+      ? `${tokens.missing} of ${requests} requests didn't report tokens, so this is a minimum.`
+      : undefined,
+    "API-equivalent cost isn't available yet.",
+  ]
+    .filter((part) => part !== undefined)
+    .join("\n");
+  return (
+    <span
+      className={cn("min-w-0 truncate", total === 0 && "text-muted-foreground")}
+      title={title}
+      data-window-tokens={total}
+      {...(floor ? { "data-tokens-floor": "" } : {})}
+    >
+      <span className={total === 0 ? undefined : "font-medium text-foreground"}>
+        {floor ? `≥ ${figure}` : figure}
+      </span>{" "}
+      tokens
+    </span>
+  );
+}
