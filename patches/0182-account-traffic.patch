index 0000000..15c66a3
--- /dev/null
+++ b/apps/hosted/web/src/contracts/pool-usage-series.ts
@@ -0,0 +1,330 @@
+/**
+ * What pools counted for the accounts on a page, read through the host's manager-only series
+ * routes. One atom serves every visible row: two series reads and one last-success lookup per pool,
+ * and one token read per distinct window start. Only an account the series names with its own key
+ * gets numbers; other accounts' counts, unmapped requests and failed reads give nothing, never 0.
+ */
+import { browserOnly } from "@executor-js/ui/contracts/http";
+import { pollingQuery } from "@executor-js/ui/contracts/polling";
+import { windowStart, type TrafficTick } from "@executor-js/ui/dashboard/account-traffic";
+import { Clock, Effect } from "effect";
+import { AsyncResult, Atom } from "effect/reactivity";
+import type { AccountId, AppId } from "@executor-js/sdk";
+import type { OrganizationReference } from "@executor-js/hosted-server/organization";
+import { HostedClient } from "./api.ts";
+import { accountObservationsAtom } from "./account-observations.ts";
+
+const hour = 3_600_000;
+const day = 24 * hour;
+/** Ticks cover the current hour and the seven before it. */
+const tickHours = 8;
+/** A page of the series holds 5,000 buckets; past this many pages the counts are not shown. */
+const pageLimit = 20;
+/** The series' `accounts` filter takes at most this many IDs. */
+const maxAccounts = 500;
+const iso = (at: number) => new Date(at).toISOString();
+
+interface Bucket {
+  readonly at: string;
+  readonly requests: number;
+  readonly failed: number;
+  readonly tokens?: {
+    readonly total: {
+      readonly sum: string | null;
+      readonly known: number;
+      readonly missing: number;
+    };
+  };
+}
+
+/** Every page of one read, as each named account's buckets; undefined unless mapping is proven. */
+const accountBuckets = (
+  organization: OrganizationReference,
+  pool: AppId,
+  input: {
+    readonly from: string;
+    readonly to: string;
+    readonly bucket: "hour" | "day";
+    readonly accounts?: readonly AccountId[];
+  },
+) =>
+  Effect.gen(function* () {
+    const client = yield* HostedClient;
+    const accounts = new Map<string, Bucket[]>();
+    let after: string | undefined;
+    for (let page = 0; page < pageLimit; page += 1) {
+      const result = yield* client.poolUsage.poolUsageSeries({
+        params: { organization, app: pool },
+        payload: { ...input, by: ["account"], ...(after === undefined ? {} : { after }) },
+      });
+      if (result === null || result.coverage.mapping.proof !== "proven") return undefined;
+      for (const group of result.groups) {
+        const account = group.key.account;
+        // Other accounts and unmapped requests are counts without an owner the caller may see.
+        if (typeof account !== "string" || account === "otherAccounts" || account === "unmapped")
+          continue;
+        // One account has a group per cost currency; its buckets add up.
+        accounts.set(account, [...(accounts.get(account) ?? []), ...group.buckets]);
+      }
+      if (result.next === null) return accounts;
+      after = result.next;
+    }
+    return undefined;
+  });
+
+const lastSuccess = (
+  organization: OrganizationReference,
+  pool: AppId,
+  accounts: readonly AccountId[],
+) =>
+  accounts.length === 0
+    ? Effect.succeed(undefined)
+    : Effect.flatMap(HostedClient, (client) =>
+        client.poolUsage.lastSuccessAt({
+          params: { organization, app: pool },
+          payload: { accounts },
+        }),
+      ).pipe(
+        Effect.map((result) =>
+          result === null || result.mapping.proof !== "proven"
+            ? undefined
+            : new Map(result.accounts.map((entry) => [entry.account, entry.lastSuccessAt])),
+        ),
+      );
+
+/** One account's requests in one pool. */
+export interface PoolAccountTraffic {
+  readonly requests: number;
+  readonly failed: number;
+  readonly ticks: readonly TrafficTick[];
+  readonly lastSuccessAt: string | null | undefined;
+}
+
+const tick = (bucket: Bucket | undefined): TrafficTick =>
+  bucket === undefined || bucket.requests === 0 ? "none" : bucket.failed > 0 ? "bad" : "good";
+
+const poolTraffic = (
+  organization: OrganizationReference,
+  pool: AppId,
+  accounts: readonly AccountId[],
+) =>
+  Effect.gen(function* () {
+    const now = yield* Clock.currentTimeMillis;
+    const current = Math.floor(now / hour) * hour;
+    const read = (filter: { readonly accounts?: readonly AccountId[] }) =>
+      Effect.all(
+        [
+          accountBuckets(organization, pool, {
+            from: iso(now - 7 * day),
+            to: iso(now),
+            bucket: "day",
+            ...filter,
+          }),
+          accountBuckets(organization, pool, {
+            from: iso(current - (tickHours - 1) * hour),
+            to: iso(now),
+            bucket: "hour",
+            ...filter,
+          }),
+        ],
+        { concurrency: "unbounded" },
+      );
+    // The visible accounts bound the reads, so a large pool never pages past its cap. One account
+    // the caller may not inspect refuses the filtered read, so it falls back to the whole pool,
+    // where such accounts are only other accounts' counts.
+    const [week, hours] = yield* accounts.length > 0 && accounts.length <= maxAccounts
+      ? read({ accounts }).pipe(Effect.catch(() => read({})))
+      : read({});
+    const traffic = new Map<AccountId, PoolAccountTraffic>();
+    if (week === undefined) return { readable: false, traffic };
+    // An account this caller may not inspect fails the lookup for all, so retry with the accounts
+    // the series already named; without an answer, last success stays unread.
+    const named = accounts.filter((account) => week.has(account));
+    const last = yield* lastSuccess(organization, pool, accounts).pipe(
+      Effect.catch(() =>
+        named.length === accounts.length
+          ? Effect.succeed(undefined)
+          : lastSuccess(organization, pool, named),
+      ),
+      Effect.catch(() => Effect.succeed(undefined)),
+    );
+    for (const account of accounts) {
+      const buckets = week.get(account);
+      const at = last?.get(account);
+      // Absent from the series, only a recorded success proves the account is mapped and idle.
+      if (buckets === undefined && typeof at !== "string") continue;
+      const recent = hours?.get(account) ?? [];
+      traffic.set(account, {
+        requests: buckets?.reduce((sum, bucket) => sum + bucket.requests, 0) ?? 0,
+        failed: buckets?.reduce((sum, bucket) => sum + bucket.failed, 0) ?? 0,
+        ticks: Array.from({ length: tickHours }, (_, index) => {
+          const start = current - (tickHours - 1 - index) * hour;
+          const matching = recent.filter((bucket) => Date.parse(bucket.at) === start);
+          return tick(
+            matching.length === 0
+              ? undefined
+              : {
+                  at: iso(start),
+                  requests: matching.reduce((sum, bucket) => sum + bucket.requests, 0),
+                  failed: matching.reduce((sum, bucket) => sum + bucket.failed, 0),
+                },
+          );
+        }),
+        lastSuccessAt: last === undefined ? undefined : (at ?? null),
+      });
+    }
+    return { readable: true, traffic };
+  });
+
+/** A pool's counts: `readable` is false when the caller may not read its series at all. */
+export interface PoolTraffic {
+  readonly readable: boolean;
+  readonly traffic: ReadonlyMap<AccountId, PoolAccountTraffic>;
+}
+
+interface TrafficKey {
+  readonly organization: OrganizationReference;
+  readonly pools: readonly { readonly pool: AppId; readonly accounts: readonly AccountId[] }[];
+}
+
+// String keys: the family reuses the atom, and its polling, while the visible accounts stay put.
+const traffic = Atom.family((key: string) => {
+  const { organization, pools } = JSON.parse(key) as TrafficKey;
+  return pollingQuery(
+    browserOnly(
+      HostedClient.runtime.atom(
+        Effect.forEach(
+          pools,
+          ({ pool, accounts }) =>
+            poolTraffic(organization, pool, accounts).pipe(
+              // Not a manager, not a pool, or unreachable: this pool shows nothing.
+              Effect.catch(() =>
+                Effect.succeed<PoolTraffic>({ readable: false, traffic: new Map() }),
+              ),
+              Effect.map((counted) => [pool, counted] as const),
+            ),
+          { concurrency: "unbounded" },
+        ).pipe(Effect.map((entries) => new Map(entries))),
+      ),
+    ),
+  );
+});
+/** Each pool's counts for its visible accounts, polled while the page is visible. */
+export const accountTrafficAtom = (key: TrafficKey) => traffic(JSON.stringify(key));
+
+/** Tokens counted in one window, keyed `pool|account|start`. */
+export interface PoolWindowTokens {
+  readonly total: number | null;
+  readonly known: number;
+  readonly missing: number;
+}
+export const windowTokensKey = (pool: AppId, account: AccountId, start: string) =>
+  `${pool}|${account}|${start}`;
+
+const sumTokens = (buckets: readonly Bucket[]): PoolWindowTokens => {
+  const totals = buckets.flatMap((bucket) =>
+    bucket.tokens === undefined ? [] : [bucket.tokens.total],
+  );
+  // Display only: a float can round a huge sum, while the contract keeps exact decimal strings.
+  const sums = totals.flatMap((total) => (total.sum === null ? [] : [Number(total.sum)]));
+  return {
+    total: sums.length === 0 ? null : sums.reduce((sum, value) => sum + value, 0),
+    known: totals.reduce((sum, total) => sum + total.known, 0),
+    // Buckets without token fields are counted requests whose tokens nobody may see.
+    missing:
+      totals.reduce((sum, total) => sum + total.missing, 0) +
+      buckets
+        .filter((bucket) => bucket.tokens === undefined)
+        .reduce((sum, bucket) => sum + bucket.requests, 0),
+  };
+};
+
+interface TokensKey {
+  readonly organization: OrganizationReference;
+  readonly reads: readonly {
+    readonly pool: AppId;
+    readonly start: string;
+    readonly accounts: readonly AccountId[];
+  }[];
+}
+
+const tokens = Atom.family((key: string) => {
+  const { organization, reads } = JSON.parse(key) as TokensKey;
+  return pollingQuery(
+    browserOnly(
+      HostedClient.runtime.atom(
+        Effect.gen(function* () {
+          const now = yield* Clock.currentTimeMillis;
+          const entries = yield* Effect.forEach(
+            reads,
+            ({ pool, start, accounts }) =>
+              accountBuckets(organization, pool, {
+                from: start,
+                to: iso(now),
+                bucket: "day",
+                accounts,
+              }).pipe(
+                // Every account here was already named, so an absent one counted no requests.
+                Effect.map((named) =>
+                  named === undefined
+                    ? []
+                    : accounts.map(
+                        (account) =>
+                          [
+                            windowTokensKey(pool, account, start),
+                            sumTokens(named.get(account) ?? []),
+                          ] as const,
+                      ),
+                ),
+                Effect.catch(() => Effect.succeed([])),
+              ),
+            { concurrency: "unbounded" },
+          );
+          return new Map(entries.flat());
+        }),
+      ),
+    ),
+  );
+});
+/** Tokens for the given window starts, one read per pool and start. */
+export const windowTokensAtom = (key: string) => tokens(key);
+
+interface NeedsKey {
+  readonly organization: OrganizationReference;
+  readonly accounts: readonly { readonly account: AccountId; readonly pools: readonly AppId[] }[];
+}
+/**
+ * The token reads the visible usage cells need, as a `windowTokensAtom` key. It follows the rows'
+ * own observation reads, so it adds no request, and its key changes only when a window starts.
+ */
+const needs = Atom.family((key: string) => {
+  const { organization, accounts } = JSON.parse(key) as NeedsKey;
+  return Atom.readable((get) => {
+    const reads = new Map<string, { pool: AppId; start: string; accounts: AccountId[] }>();
+    for (const { account, pools } of accounts) {
+      const result = get(accountObservationsAtom({ organization, account }));
+      if (!AsyncResult.isSuccess(result) || !result.value.canInspect) continue;
+      const windows = result.value.reports.flatMap(
+        (report) => report.result?.observation.windows ?? [],
+      );
+      for (const entry of windows) {
+        if (entry.measure.unlimited === true) continue;
+        const start = windowStart(entry, Date.now());
+        if (start === undefined) continue;
+        for (const pool of pools) {
+          const read = reads.get(`${pool}|${start}`) ?? { pool, start, accounts: [] };
+          if (!read.accounts.includes(account)) read.accounts.push(account);
+          reads.set(`${pool}|${start}`, read);
+        }
+      }
+    }
+    return JSON.stringify({
+      organization,
+      reads: [...reads.values()].sort((a, b) =>
+        `${a.pool}|${a.start}`.localeCompare(`${b.pool}|${b.start}`),
+      ),
+    } satisfies TokensKey);
+  });
+});
+/** The window token reads for these accounts, each with the pools that named it. */
+export const windowNeedsAtom = (key: NeedsKey) => needs(JSON.stringify(key));
