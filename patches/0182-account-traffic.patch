+        const visible = [...saved].sort();
+        const weekReads = load.filter(
+          (call) => call.input.bucket === "day" && span(call.input) > 6 * day,
+        );
+        const hourReads = load.filter((call) => call.input.bucket === "hour");
+        const tokenReads = load.filter(
+          (call) => call.input.bucket === "day" && span(call.input) <= 6 * day,
+        );
+        const lastReads = load.filter((call) => call.action === "lastSuccessAt");
+        expect(
+          [weekReads.length, hourReads.length, tokenReads.length, lastReads.length],
+          "one read per kind for every visible row",
+        ).toEqual([1, 1, 1, 1]);
+        // The visible pool accounts bound the 7-day and hourly reads; tokens name only the
+        // account with a window.
+        expect(weekReads[0]?.input.accounts).toEqual(visible);
+        expect(hourReads[0]?.input.accounts).toEqual(visible);
+        expect([...(lastReads[0]?.input.accounts ?? [])].sort()).toEqual(visible);
+        expect(tokenReads[0]?.input.accounts).toEqual([traffic]);
+
+        const [
+          headerTitle,
+          requests,
+          requestsTitle,
+          ticks,
+          share,
+          shareClass,
+          healthTitle,
+          tokens,
+          tokensTitle,
+          floor,
+          steadyShare,
+          steadyClass,
+          rejectedRequests,
+          rejectedTraffic,
+          idleRequests,
+          idleClass,
+          idleTitle,
+          idleTraffic,
+          countsOnly,
+          connectorCells,
+        ] = wide;
+        // Some rows have no history this viewer may see, so the header says what empty means.
+        expect(headerTitle).toContain("An empty cell means there's no request history you can see");
+        expect(requests).toBe("41");
+        expect(requestsTitle).toBe("41 requests in the last 7 days, counted by Traffic pool");
+        // Oldest first: three hours ago good, an hour ago failed, the current hour good.
+        expect(ticks).toBe("nnnngnbg");
+        // 38 of 41 succeeded: truncated, never rounded up, and amber below 95%.
+        expect(share).toBe("92.6%");
+        expect(shareClass).toContain("amber");
+        expect(healthTitle).toMatch(
+          /^41 requests in 7 days · 92\.6% succeeded · last success 1[23] min ago, counted by Traffic pool\nHealthy by .+ · checked /,
+        );
+        // 199 of 200 is at or above 95%, so it is not amber.
+        expect(steadyShare).toBe("99.5%");
+        expect(steadyClass).not.toContain("amber");
+        // A current rejection beats traffic in Health; the count stays.
+        expect(rejectedRequests).toBe("10");
+        expect(rejectedTraffic).toBe(0);
+        // Mapped and idle: a muted 0, and Health keeps the sign-in check.
+        expect(idleRequests).toBe("0");
+        expect(idleClass).toContain("text-muted-foreground");
+        expect(idleTitle).toBe(
+          "No requests in the last 7 days, counted by Traffic pool · last success 3 days ago",
+        );
+        expect(idleTraffic).toBe(0);
+        expect(tokens).toBe("≥ 1.2M tokens");
+        expect(floor).toBe(1);
+        expect(tokensTitle).toContain(
+          "1 of 41 requests didn't report tokens, so this is a minimum.",
+        );
+        expect(tokensTitle).toContain("API-equivalent cost isn't available yet.");
+        expect(tokens).not.toContain("$");
+        // Counted only as other accounts' requests, and a connector outside the pool: no numbers.
+        expect(countsOnly).toEqual([0, 0, 0]);
+        expect(connectorCells).toEqual([0, 0, 0]);
+
+        const details = yield* browser.use("Open the traffic account's details", (page) =>
+          openRowMenu(page, accountRow(page, "Traffic account"), "Traffic account")
+            .then((menu) => menu.getByRole("menuitem", { name: "Details", exact: true }).click())
+            .then(() =>
