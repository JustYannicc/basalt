+          ],
+        });
+        expect(deployed.status, JSON.stringify(deployed.body)).toBe(200);
+        const app = (yield* body(Resource, deployed)).id;
+        const appPath = `${prefix}/apps/${app}`;
+        const saved: string[] = [];
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* serverControl("start");
+            yield* api.request(actors.owner, "DELETE", appPath);
+            for (const account of saved)
+              yield* api.request(actors.owner, "DELETE", `${prefix}/accounts/${account}`);
+          }).pipe(Effect.orDie),
+        );
+        const labels = [
+          "Traffic account",
+          "Steady account",
+          "Rejected traffic",
+          "Idle account",
+          "Counted elsewhere",
+        ] as const;
+        for (const label of labels) {
+          const pending = yield* body(
+            Resource,
+            yield* api.request(
+              actors.owner,
+              "POST",
+              connectionsPath(appPath, "app", "service"),
+              {},
+            ),
+          );
+          const submitted = yield* api.request(
+            actors.owner,
+            "POST",
+            `${prefix}/connections/${pending.id}/submit`,
+            { method: "key", fields: { token: observationToken } },
+          );
+          expect(submitted.status, JSON.stringify(submitted.body)).toBe(200);
+          const account = (yield* body(Resource, submitted)).id;
+          saved.push(account);
+          expect(
+            (yield* api.request(actors.owner, "PATCH", `${prefix}/accounts/${account}`, { label }))
+              .status,
+          ).toBe(200);
+        }
+        const [traffic, steady, rejected, idle] = saved as [string, string, string, string];
+        const ids = { traffic, steady, rejected, idle };
+        const check = (account: string) =>
+          api
+            .request(actors.owner, "POST", `${prefix}/accounts/${account}/health`)
+            .pipe(Effect.map((response) => response.status));
+        yield* observed.answer({ status: 200, body: weekly() });
+        expect(
+          (yield* api.request(
+            actors.owner,
+            "POST",
+            `${prefix}/accounts/${traffic}/observations/refresh`,
+          )).status,
+        ).toBe(200);
+        for (const account of [traffic, steady, idle]) expect(yield* check(account)).toBe(200);
+        // The service now refuses the credential, so this account's current check is a rejection.
+        yield* observed.health({ status: 401, body: {} });
+        expect(yield* check(rejected)).toBe(200);
+        yield* observed.health({ status: 200, body: { accountInfo: {} } });
+
+        // Opt the app in as the owner's native pool, with the signed loopback usage backend.
+        const viewer = yield* body(
+          Schema.Struct({ userId: Schema.String }),
+          yield* api.request(actors.owner, "GET", "/api/viewer"),
+        );
+        yield* pool.respond(answer(ids));
+        const pools = (value: object) => ({
+          sql: `update organization set metadata = jsonb_set(coalesce(metadata::jsonb, '{}'::jsonb), '{basaltPools}', $1::jsonb)::text where id=$2`,
+          params: [JSON.stringify(value), actors.organization.id],
+        });
+        yield* serverControl("stop");
+        yield* legacyStorage([
+          pools({
+            [viewer.userId]: {
+              app,
+              version: "retained-version",
+              authorization: "executor-app-v1",
+              membership: "executor-links-v1",
+            },
+          }),
+        ]);
+        // Opted out again before the app and accounts are removed: a native pool's link changes
+        // would notify the pool, which this loopback backend does not implement.
+        yield* Effect.addFinalizer(() =>
+          Effect.gen(function* () {
+            yield* serverControl("stop");
+            yield* legacyStorage([pools({})]);
+            yield* serverControl("start");
+          }).pipe(Effect.orDie),
+        );
+        yield* serverControl("environment", 200, {
+          POOL_APP_SIGNING_KEY: "ab".repeat(32),
+          BASALT_POOL_ORIGIN: pool.origin,
+        });
+        yield* serverControl("start");
+
+        const accounts = `/org/${actors.organization.slug}/accounts`;
+        const ready = (page: Page) =>
+          Promise.all([
+            accountRow(page, "Traffic account").locator('[data-health-state="traffic"]').waitFor(),
+            accountRow(page, "Traffic account").locator("[data-window-tokens]").waitFor(),
+            accountRow(page, "Steady account").locator('[data-health-state="traffic"]').waitFor(),
+            accountRow(page, "Idle account").locator("[data-account-requests]").waitFor(),
+            accountRow(page, "Rejected traffic")
+              .locator('[data-health-state="credentials_rejected"]')
+              .waitFor(),
+            accountRow(page, "Connector mail").locator('[data-health-state="healthy"]').waitFor(),
+          ]);
+        yield* browser.login(actors.owner);
+        for (const width of [1280, 390]) {
+          yield* browser.use(`Open accounts at ${width}px`, (page) =>
+            page
+              .setViewportSize({ width, height: 900 })
+              .then(() => page.goto(accounts))
+              .then(() => ready(page)),
+          );
+          yield* evidence.attach(
+            `account-traffic-${width}.png`,
+            "image/png",
+            yield* browser.use("Capture accounts", (page) => page.screenshot({ fullPage: true })),
+          );
+        }
+
+        // One page load: exactly one read of each kind for the whole list, never one per row.
+        const before = (yield* pool.calls).length;
+        const wide = yield* browser.use("Read the rows at 1280px", (page) => {
+          const row = accountRow(page, "Traffic account");
+          return page
+            .setViewportSize({ width: 1280, height: 900 })
+            .then(() => page.goto(accounts))
+            .then(() => ready(page))
+            .then(() =>
+              Promise.all([
+                page.locator("[data-requests-header]").getAttribute("title"),
+                row.locator("[data-account-requests]").getAttribute("data-account-requests"),
+                row.locator("[data-account-requests]").getAttribute("title"),
+                row.locator('[data-health-state="traffic"]').getAttribute("data-ticks"),
+                row.locator("[data-success-share]").innerText(),
+                row.locator("[data-success-share]").getAttribute("class"),
+                row.locator('[data-health-state="traffic"]').getAttribute("title"),
+                row.locator("[data-window-tokens]").innerText(),
+                row.locator("[data-window-tokens]").getAttribute("title"),
+                row.locator("[data-tokens-floor]").count(),
+                accountRow(page, "Steady account").locator("[data-success-share]").innerText(),
+                accountRow(page, "Steady account")
+                  .locator("[data-success-share]")
+                  .getAttribute("class"),
+                accountRow(page, "Rejected traffic")
+                  .locator("[data-account-requests]")
+                  .getAttribute("data-account-requests"),
+                accountRow(page, "Rejected traffic")
+                  .locator('[data-health-state="traffic"]')
+                  .count(),
+                accountRow(page, "Idle account")
+                  .locator("[data-account-requests]")
+                  .getAttribute("data-account-requests"),
+                accountRow(page, "Idle account")
+                  .locator("[data-account-requests]")
+                  .getAttribute("class"),
+                accountRow(page, "Idle account")
+                  .locator("[data-account-requests]")
+                  .getAttribute("title"),
+                accountRow(page, "Idle account").locator('[data-health-state="traffic"]').count(),
+                cells(page, "Counted elsewhere"),
+                cells(page, "Connector mail"),
+              ]),
+            );
+        });
+        const load = (yield* pool.calls).slice(before).map((call) => ({
+          action: call.action,
+          input: Schema.decodeUnknownSync(
+            Schema.Struct({
+              from: Schema.optional(Schema.String),
+              to: Schema.optional(Schema.String),
+              bucket: Schema.optional(Schema.String),
+              accounts: Schema.optional(Schema.Array(Schema.String)),
+            }),
+          )(call.input),
+        }));
+        const span = (input: {
+          readonly from?: string | undefined;
+          readonly to?: string | undefined;
